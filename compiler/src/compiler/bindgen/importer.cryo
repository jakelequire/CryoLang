/// C Header Import pass (libclang engine)
///
/// Processes CImport extern blocks: `extern module name := "C" { #include ... }`.
/// For each `#include`, libclang builds a real translation unit, and a cursor
/// walk emits a FunctionDeclNode per top-level C function declaration into the
/// ExternBlockNode — so downstream passes (name resolution, type resolution,
/// codegen) treat them identically to hand-written extern functions.
///
/// This replaces the former hand-rolled `clang -E -P` + byte-scanning parser
/// (`passes/c_header_import.cryo`).  libclang preprocesses internally, so the
/// `popen`/preprocessor-probe subprocess is gone; clang is now a hard
/// dependency of C-import (the gcc/cc fallback no longer applies).
///
/// `Importer` is a single stateful object: it carries both the static pass
/// entry (`run` / `collect_from_tu` / path resolution) and the per-translation-
/// unit emit state (alias, accumulators) with the emit logic as `mut &this`
/// methods.  The libclang cursor visitors must be bare C function pointers, so
/// they are `static` `visit_*` trampolines (no receiver — they match the C
/// callback signature) that cast their `client: void*` back to the live
/// `Importer` and delegate to an instance method.  The same object is reused
/// as the client data for the nested field/constant walks (the transient
/// `field_cursors` / `cur_enum` / `cur_enum_int` targets), so no separate
/// per-walk state structs are needed — libclang walks synchronously and the
/// nested visitors never overlap.  A record's members are collected into
/// `field_cursors` first (rather than emitted one-by-one) so a run of bitfields
/// can be spanned by a single storage blob with look-ahead.

namespace Compiler::Bindgen::Importer;

import ffi::libc;
import Compiler::Bindgen::Clang;
import Compiler::Bindgen::Clang::{ CXCursor, CXType, CXUnsavedFile, CXSourceRange, CXToken, CXString, CXSourceLocation };
import Compiler::Bindgen::TypeMap;
import Compiler::Bindgen::TypeMap::{ CTypeMapper };
import Compiler::Lex::Lexer;
import Compiler::Codegen::Util;
import Compiler::Passes::PassID;
import Compiler::Diag;
import Compiler::Diag::{ Snapshot, Sink, SourceSpan, Diagnostic };
import Compiler::Artifacts;
import Compiler::CompilationContext;
import Compiler::AST;
import Compiler::AST::{ Node, Declaration };
import Compiler::AST::Expression;
import Compiler::AST::Statement;
import Compiler::Resolver::{ SymbolStr, InternTable };
import Utils;
import Utils::Logger;
import std::fmt;
import std::collections::string;

/// A structured account of what a single translation unit's import could NOT
/// translate faithfully — the honesty channel PLAN.md §3 requires.  Two buckets:
/// `skipped` (a construct that produced NO binding — a function-like macro, a
/// non-literal macro body) and `approximated` (a binding that round-trips by
/// value but loses member access — a union, a bitfield run, an anonymous
/// record member or field, lowered to an opaque storage blob).  Surfaced via
/// `cdebug` today (so it only appears under `--debug`); the eventual `cryo
/// vendor` generator will consume the same lists for its translation report.
type struct ImportReport {
    /// LOST: a construct we *could* bind but don't yet — real API surface the
    /// import failed to translate.  This is the headline number.
    skipped:      string[];
    approximated: string[];
    /// IGNORED: a `#define`/decl that is never bindable API in the first place —
    /// a header guard, a marker macro (`RLAPI`, `extern`), a function-like macro.
    /// Tracked so it doesn't inflate the "not bound" headline; surfaced as a
    /// single count line, with detail only under `--debug`.
    ignored:      string[];

    static new() -> ImportReport {
        return ImportReport { skipped: [], approximated: [], ignored: [] };
    }

    /// Note a construct that yielded no binding at all but COULD be bound (lost
    /// API) — the headline "not bound" bucket.
    skip(mut &this, line: string) -> void { this.skipped.push(line); }

    /// Note a binding emitted at reduced fidelity (layout-only, no field access).
    approx(mut &this, line: string) -> void { this.approximated.push(line); }

    /// Note a construct that is inherently not bindable API (header guard, marker
    /// macro, function-like macro) — expected noise, kept out of the headline.
    ignore(mut &this, line: string) -> void { this.ignored.push(line); }

    /// Emit a per-translation-unit summary (no-op when nothing was lost, and
    /// silent unless `--debug` is set, since it rides `cdebug`).  Used by the
    /// inline `#include` path, where the report is diagnostic noise during a
    /// normal compile; the `cryo vendor` path uses `summary_stdout` instead.
    summary(&this, label: string) -> void {
        if (this.skipped.length == 0 && this.approximated.length == 0
            && this.ignored.length == 0) { return; }
        cdebug("[Bindgen] '%s' translation report: %lld not bound, %lld approximated, %lld ignored\n",
               label, this.skipped.length as i64, this.approximated.length as i64,
               this.ignored.length as i64);
        for (mut i: i64 = 0; i < this.skipped.length; i++) {
            cdebug("  [skip]   %s\n", this.skipped[i]);
        }
        for (mut i: i64 = 0; i < this.approximated.length; i++) {
            cdebug("  [approx] %s\n", this.approximated[i]);
        }
        for (mut i: i64 = 0; i < this.ignored.length; i++) {
            cdebug("  [ignore] %s\n", this.ignored[i]);
        }
    }

    /// Append this report's entries into `dst` (the `cryo vendor` generator's
    /// accumulator).  `string`s are non-owning pointers into leaked `format`
    /// buffers, so copying them out survives this report's own array drop.
    merge_into(&this, dst: ImportReport*) -> void {
        for (mut i: i64 = 0; i < this.skipped.length; i++) {
            dst.skipped.push(this.skipped[i]);
        }
        for (mut i: i64 = 0; i < this.approximated.length; i++) {
            dst.approximated.push(this.approximated[i]);
        }
        for (mut i: i64 = 0; i < this.ignored.length; i++) {
            dst.ignored.push(this.ignored[i]);
        }
    }

    /// Print the user-facing translation report to stdout at `cryo vendor`
    /// time (the honesty channel PLAN.md §3 requires: every unbindable or
    /// approximated construct is listed, never silently dropped).  No-op when
    /// everything bound faithfully.
    summary_stdout(&this, label: string) -> void {
        if (this.skipped.length == 0 && this.approximated.length == 0
            && this.ignored.length == 0) { return; }
        fmt::printf("Translation report for '%s': %lld not bound, %lld approximated (+%lld ignored: header guards / markers / function-like macros).\n",
               label, this.skipped.length as i64, this.approximated.length as i64,
               this.ignored.length as i64);
        // LOST API (the headline): list prominently.
        for (mut i: i64 = 0; i < this.skipped.length; i++) {
            fmt::printf("  [skip]   %s\n", this.skipped[i]);
        }
        // Reduced-fidelity bindings.
        for (mut i: i64 = 0; i < this.approximated.length; i++) {
            fmt::printf("  [approx] %s\n", this.approximated[i]);
        }
        // Inherently-unbindable noise is summarized by the count above only; its
        // detail rides the `--debug` `summary()` path, not this user-facing one.
    }
}

/// The C-header import engine: one object per translation unit, plus the static
/// pass entry and path-resolution helpers.
type struct Importer {
    extern_node:    ExternBlockNode*;
    ctx:            CompilationContext*;
    /// The libclang translation unit, needed by `emit_macro` to tokenize a
    /// macro definition's extent (`clang_tokenize`).
    tu:             void*;
    count:          i32;
    /// The extern module's alias namespace (e.g. `probe`/`llvm`); emitted
    /// types are qualified under it via StructDeclNode.binding_namespace.
    alias:          SymbolStr;
    /// `![functions_only]`: emit prototypes only, no struct/enum/typedef.
    functions_only: boolean;
    /// Names already emitted as a top-level type decl (alias-namespaced),
    /// for dedup across struct/enum/typedef (they share the alias namespace).
    seen_names:     SymbolStr[];
    /// Parallel map (name -> emitted StructDeclNode) so a struct's defining
    /// cursor can populate the empty node left by an earlier forward-decl
    /// cursor (libclang visits `struct Foo;` then `struct Foo {...}`).
    struct_names:   SymbolStr[];
    struct_nodes:   StructDeclNode*[];
    /// CXType -> Cryo annotation mapper, built once per TU (carries ctx+alias).
    types:          CTypeMapper;
    /// Transient targets for the nested walks (set just before the synchronous
    /// `clang_visitChildren`, read by the nested visitors).  `cur_enum_int`
    /// points at a stack-local CXType live for the duration of the walk.
    cur_enum:       EnumDeclNode*;
    cur_enum_int:   CXType*;
    /// Transient: a record's child member cursors (plain fields AND anonymous
    /// struct/union members), collected by `visit_collect_member` and then
    /// processed with look-ahead so a run of bitfields can be spanned by one
    /// storage blob.  Reset at the start of each record.
    field_cursors:  CXCursor[];
    /// Transient: a union/anon-record member's FieldDecl cursors, collected by
    /// `visit_collect_acc_member` to build reinterpret accessors.  Kept separate
    /// from `field_cursors` so an anon-member walk can run mid-iteration of the
    /// parent record's `field_cursors` without clobbering it.
    acc_members:    CXCursor[];
    /// Honesty channel: every construct this import skipped or approximated.
    report:         ImportReport;
    /// W1: macro-definition cursors deferred from the decl walk so they emit
    /// AFTER every type/enum/function is known (cursor order is not guaranteed
    /// with a detailed-preprocessing-record TU).  Processed in two sub-passes:
    /// simple literal macros first (which populate `mac_*`), then
    /// alias/compound/arithmetic macros that resolve against the full tables.
    macro_cursors:  CXCursor[];
    /// Enum-constant table (named-enum VARIANTS + anonymous-enum consts):
    /// name -> (i64 value, owning enum bare tag, or empty tag for an anon-enum
    /// const).  Lets an identifier-alias `#define` resolve to a bound constant.
    ec_names:       SymbolStr[];
    ec_values:      i64[];
    ec_enum_tags:   SymbolStr[];
    /// Object-like `#define` constant table built by the simple-macro pass:
    /// name -> (Cryo type name, literal text, is-float).  Lets a later alias or
    /// arithmetic macro copy / numerically reference an earlier macro const.
    mac_names:      SymbolStr[];
    mac_types:      string[];
    mac_texts:      string[];
    mac_floats:     boolean[];
    /// Bound type names (struct / enum / typedef bare tags) for type-alias
    /// `#define`s (`#define Foo Bar` where Bar is a bound type).
    type_names:     SymbolStr[];
    /// True on the `cryo vendor` path (a generated `namespace <Name>;` file),
    /// false on the inline `extern module := "C"` path.  Function-alias
    /// forwarding wrappers are a bodied top-level function with no
    /// `binding_namespace`, so they are emitted ONLY on the vendor path (where
    /// the file's `namespace` qualifies them); the inline path reports them.
    is_vendor:      boolean;
    /// Vendor-path only: resolved paths of every non-system file this TU pulled
    /// in (entry header + transitive `#include`s), collected via
    /// `clang_getInclusions` after the decl walk.  `collect_from_tu` threads
    /// these out so the generator can write an include-graph `.deps` sidecar for
    /// cache provenance.  Stays empty on the inline `#include` path (which never
    /// calls `clang_getInclusions`).
    inputs:         string[];

    /// Build a per-TU importer.  Alias and `functions_only` are derived from the
    /// extern block; the type mapper is wired with the same (ctx, alias).
    static new(extern_node: ExternBlockNode*, ctx: CompilationContext*, tu: void*) -> Importer {
        const alias: SymbolStr = extern_node.namespace_alias;
        return Importer {
            extern_node:    extern_node,
            ctx:            ctx,
            tu:             tu,
            count:          0,
            alias:          alias,
            functions_only: extern_node.has_directive("functions_only"),
            seen_names:     [],
            struct_names:   [],
            struct_nodes:   [],
            types:          CTypeMapper::new(ctx, alias),
            cur_enum:       null,
            cur_enum_int:   null,
            field_cursors:  [],
            acc_members:    [],
            report:         ImportReport::new(),
            macro_cursors:  [],
            ec_names:       [],
            ec_values:      [],
            ec_enum_tags:   [],
            mac_names:      [],
            mac_types:      [],
            mac_texts:      [],
            mac_floats:     [],
            type_names:     [],
            is_vendor:      false,
            inputs:         [],
        };
    }

    // ---- libclang visitor trampolines ----
    //
    // Handed to `clang_visitChildren` as bare C function pointers, so they are
    // `static` (no `this` receiver — they must match the C callback signature
    // `(CXCursor, CXCursor, void*) -> i32`).  Each casts its `client: void*`
    // back to the live `Importer` and delegates to an instance method.

    /// Top-level visitor.  Emits a FunctionDeclNode per top-level FunctionDecl,
    /// and (unless `functions_only`) typedef/struct/union/enum/macro decls.
    /// System-header decls are filtered out (`is_in_system_header`) so a header's
    /// own `#include <stddef.h>` does not drag glibc's ~100 internal typedefs
    /// into the alias namespace.
    static visit_decl(cursor: CXCursor, parent: CXCursor, client: void*) -> i32 {
        const imp: Importer* = client as Importer*;

        if (cursor.is_in_system_header()) {
            return Clang::VISIT_CONTINUE;
        }

        const k: i32 = Clang::clang_getCursorKind(cursor);
        if (k == Clang::CURSOR_FUNCTION_DECL) {
            imp.emit_function(cursor);
            return Clang::VISIT_CONTINUE;
        }

        if (imp.functions_only) {
            return Clang::VISIT_CONTINUE;
        }

        if (k == Clang::CURSOR_TYPEDEF_DECL) {
            imp.emit_typedef(cursor);
        } else if (k == Clang::CURSOR_STRUCT_DECL) {
            imp.emit_record(cursor, false);
        } else if (k == Clang::CURSOR_UNION_DECL) {
            imp.emit_record(cursor, true);
        } else if (k == Clang::CURSOR_ENUM_DECL) {
            imp.emit_enum(cursor);
        } else if (k == Clang::CURSOR_MACRO_DEFINITION) {
            // W1: defer — a macro can alias an enum constant, struct, or another
            // macro that this walk hasn't reached yet (cursor order is not
            // guaranteed with a detailed-preprocessing-record TU), so it is
            // emitted only after every decl is bound.
            imp.macro_cursors.push(cursor);
        }
        return Clang::VISIT_CONTINUE;
    }

    /// Nested visitor: collect a record's layout-contributing children into
    /// `field_cursors` — every FieldDecl, plus each anonymous struct/union MEMBER
    /// (a nameless `union { ... };`, which carries storage but has no FieldDecl).
    /// A nameless record DEFINITION used by a following named field is NOT a
    /// member (its `is_anonymous_record_decl` is false) and is skipped here; the
    /// named field that references it is collected as a normal FieldDecl.  The
    /// collected list is processed by `populate_record_fields` with look-ahead.
    static visit_collect_member(cursor: CXCursor, parent: CXCursor, client: void*) -> i32 {
        const k: i32 = Clang::clang_getCursorKind(cursor);
        const imp: Importer* = client as Importer*;
        if (k == Clang::CURSOR_FIELD_DECL) {
            imp.field_cursors.push(cursor);
        } else if ((k == Clang::CURSOR_STRUCT_DECL || k == Clang::CURSOR_UNION_DECL)
                   && cursor.is_anonymous_record_decl()) {
            imp.field_cursors.push(cursor);
        }
        return Clang::VISIT_CONTINUE;
    }

    /// Nested visitor: collect a union/anon-record's FieldDecl members into
    /// `acc_members` (for reinterpret-accessor generation).  Anonymous
    /// sub-records are ignored here — accessors only cover named members.
    static visit_collect_acc_member(cursor: CXCursor, parent: CXCursor, client: void*) -> i32 {
        if (Clang::clang_getCursorKind(cursor) == Clang::CURSOR_FIELD_DECL) {
            const imp: Importer* = client as Importer*;
            imp.acc_members.push(cursor);
        }
        return Clang::VISIT_CONTINUE;
    }

    /// Nested visitor: one EnumVariantNode per EnumConstantDecl child of a NAMED
    /// enum.
    static visit_enum_const(cursor: CXCursor, parent: CXCursor, client: void*) -> i32 {
        if (Clang::clang_getCursorKind(cursor) != Clang::CURSOR_ENUM_CONSTANT_DECL) {
            return Clang::VISIT_CONTINUE;
        }
        const imp: Importer* = client as Importer*;
        imp.add_enum_const_from(cursor);
        return Clang::VISIT_CONTINUE;
    }

    /// Nested visitor: emit one alias-namespaced global `const NAME = value` per
    /// EnumConstantDecl child of an ANONYMOUS enum cursor.
    static visit_anon_enum_const(cursor: CXCursor, parent: CXCursor, client: void*) -> i32 {
        if (Clang::clang_getCursorKind(cursor) != Clang::CURSOR_ENUM_CONSTANT_DECL) {
            return Clang::VISIT_CONTINUE;
        }
        const imp: Importer* = client as Importer*;
        imp.add_anon_const_from(cursor);
        return Clang::VISIT_CONTINUE;
    }

    /// True if `name` was already emitted as a top-level type in this import.
    name_seen(&this, name: SymbolStr) -> boolean {
        for (mut i: i64 = 0; i < this.seen_names.length; i++) {
            if (this.seen_names[i].equals(name)) { return true; }
        }
        return false;
    }

    /// The StructDeclNode previously emitted for `name`, or null.
    find_struct(&this, name: SymbolStr) -> StructDeclNode* {
        for (mut i: i64 = 0; i < this.struct_names.length; i++) {
            if (this.struct_names[i].equals(name)) { return this.struct_nodes[i]; }
        }
        return null;
    }

    /// Append a synthesized top-level declaration to the program so it flows
    /// through TypeDeclaration -> TypeResolution -> codegen like any source decl.
    emit_top_level(mut &this, node: ASTNode*) -> void {
        this.ctx.artifacts.ast.root.statements.push(node);
    }

    /// Push an alias-namespaced immutable global `const name = <init>` — the
    /// shape both anonymous-enum constants and object-like `#define` macros
    /// lower to.  `binding_namespace` keeps it reachable only as `alias::name`.
    emit_alias_const(mut &this, name_sym: SymbolStr,
                     type_annotation: TypeAnnotation*, init: ExpressionNode*) -> void {
        mut vnode: VarDeclNode* = new VarDeclNode(name_sym, SourceSpan::none());
        vnode.is_global = true;
        vnode.is_mutable = false;
        vnode.binding_namespace = this.alias;
        vnode.type_annotation = type_annotation;
        vnode.set_initializer(init);
        this.seen_names.push(name_sym);
        this.emit_top_level(vnode as ASTNode*);
    }

    /// Emit one FunctionDeclNode for a C function prototype.
    emit_function(mut &this, cursor: CXCursor) -> void {
        const name_sym: SymbolStr = cursor.intern_spelling(this.ctx);
        mut func: FunctionDeclNode* = new FunctionDeclNode(name_sym, SourceSpan::none());
        func.return_type_annotation = this.types.map(Clang::clang_getCursorResultType(cursor));

        mut params: VarDeclNode*[] = [];
        const nargs: i32 = Clang::clang_Cursor_getNumArguments(cursor);
        for (mut i: i32 = 0; i < nargs; i++) {
            const arg: CXCursor = Clang::clang_Cursor_getArgument(cursor, i as u32);
            const ptype: TypeAnnotation* = this.types.map(Clang::clang_getCursorType(arg));
            const pname: SymbolStr = arg.intern_arg_name(i, this.ctx);
            mut pnode: VarDeclNode* = new VarDeclNode(pname, SourceSpan::none());
            pnode.type_annotation = ptype;
            params.push(pnode);
        }
        func.parameters = params;
        func.is_variadic =
            Clang::clang_isFunctionTypeVariadic(Clang::clang_getCursorType(cursor)) != 0u32;

        this.extern_node.add_function(func);
        this.count = this.count + 1;
    }

    /// Emit a `type struct` for a struct (or a layout-faithful opaque blob for a
    /// union — Cryo has no native union).  Find-or-populate handles libclang's
    /// forward-decl-then-definition double visit and truly-opaque records.
    emit_record(mut &this, cursor: CXCursor, is_union: boolean) -> void {
        const name_sym: SymbolStr = cursor.intern_spelling(this.ctx);
        if (cursor.is_anonymous()) {
            // Anonymous record: not nameable as a top-level type (libclang gives
            // it a synthetic `struct (unnamed at …)` spelling, so test anonymity
            // via clang_Cursor_isAnonymous, NOT an empty-spelling check).
            // Reported, not silently relied upon — references fall back to void*.
            cdebug("[Bindgen] skipped anonymous record (use a typedef to name it)\n");
            return;
        }

        if (is_union) {
            // No native union: emit a `![repr(c)]` struct holding one storage
            // field sized/aligned to the union, so it round-trips by value over
            // FFI (no field access — flagged limitation).
            if (this.name_seen(name_sym)) { return; }
            const ct: CXType = Clang::clang_getCursorType(cursor);
            const size: i64 = Clang::clang_Type_getSizeOf(ct);
            const align: i64 = Clang::clang_Type_getAlignOf(ct);
            if (size <= 0) { return; }
            mut unode: StructDeclNode* = new StructDeclNode(name_sym, SourceSpan::none());
            unode.binding_namespace = this.alias;
            unode.repr_c = true;
            if (align > 0) { unode.min_alignment = align as u64; }
            const blob_sym: SymbolStr = this.ctx.intern_table.intern("_storage");
            mut storage: FieldDeclNode* = new FieldDeclNode(blob_sym, SourceSpan::none());
            storage.type_annotation = this.types.array(this.types.prim("u8"), size);
            unode.add_field(storage);
            // Restore field access: a reinterpret get/set pair per named member.
            const nacc: i32 = this.add_reinterpret_accessors(unode, blob_sym, cursor);
            this.seen_names.push(name_sym);
            this.type_names.push(name_sym);
            this.emit_top_level(unode as ASTNode*);
            const uname: string = this.ctx.intern_table.resolve(name_sym);
            if (nacc > 0) {
                this.report.approx(format("union '%s' -> %lld-byte storage + %d get/set accessors (method access, not native union)",
                                          uname, size, nacc));
            } else {
                this.report.approx(format("union '%s' -> %lld-byte opaque storage (round-trips by value; no field access)",
                                          uname, size));
            }
            return;
        }

        mut node: StructDeclNode* = this.find_struct(name_sym);
        if (node == null) {
            node = new StructDeclNode(name_sym, SourceSpan::none());
            node.binding_namespace = this.alias;
            node.repr_c = true;
            this.seen_names.push(name_sym);
            this.type_names.push(name_sym);
            this.struct_names.push(name_sym);
            this.struct_nodes.push(node);
            this.emit_top_level(node as ASTNode*);
        }
        // Populate fields from this cursor only if not already populated (an
        // earlier forward-decl cursor left it empty; the definition fills it).
        if (node.fields.length == 0) {
            this.field_cursors = [];
            Clang::clang_visitChildren(cursor, Importer::visit_collect_member, this as void*);
            this.populate_record_fields(node, cursor);
        }
    }

    /// Build a struct's fields from its collected member cursors, faithfully
    /// handling the three constructs a one-to-one field map gets wrong:
    ///   - a **bitfield run** (`unsigned a:3; unsigned b:5;`) — adjacent
    ///     bitfields share a storage unit, so a per-field map would inflate the
    ///     layout; the whole run collapses to one opaque `u8[span]` blob spanning
    ///     from its first bit to the next non-bitfield field (or the struct end);
    ///   - an **anonymous record member** (`union { ... };`) — no FieldDecl, so a
    ///     plain field walk drops it and undersizes the struct; emitted as an
    ///     aligned blob in declaration order;
    ///   - a **named field of anonymous type** (`struct {...} pt;`) — mapped to an
    ///     aligned blob by `CTypeMapper::map` rather than `void*`.
    /// Any approximation raises the struct's `min_alignment` to libclang's
    /// authoritative figure, so an opaque blob (alignment 1) can't lower the
    /// record's overall alignment below the C ABI.  Each lossy member is reported.
    populate_record_fields(mut &this, node: StructDeclNode*, record_cursor: CXCursor) -> void {
        const rec_type: CXType = Clang::clang_getCursorType(record_cursor);
        const struct_size: i64 = Clang::clang_Type_getSizeOf(rec_type);
        const sname: string = this.ctx.intern_table.resolve(node.name);
        mut approximated: boolean = false;
        mut anon_n: i32 = 0;
        mut bits_n: i32 = 0;

        mut i: i64 = 0;
        while (i < this.field_cursors.length) {
            const cur: CXCursor = this.field_cursors[i];
            const k: i32 = Clang::clang_getCursorKind(cur);

            // Anonymous struct/union member: an aligned opaque blob in place.
            if (k == Clang::CURSOR_STRUCT_DECL || k == Clang::CURSOR_UNION_DECL) {
                const ct: CXType = Clang::clang_getCursorType(cur);
                const sz: i64 = Clang::clang_Type_getSizeOf(ct);
                const al: i64 = Clang::clang_Type_getAlignOf(ct);
                const fname: SymbolStr =
                    this.ctx.intern_table.intern(format("_anon%d", anon_n));
                mut fnode: FieldDeclNode* = new FieldDeclNode(fname, SourceSpan::none());
                fnode.type_annotation = this.types.aligned_blob(sz, al);
                node.add_field(fnode);
                // Both an anonymous union (members overlay at offset 0) and an
                // anonymous struct (members at their byte offsets) get reinterpret
                // accessors over the blob — `add_reinterpret_accessors` reads each
                // member's offset, so the same path covers both.
                const kindword: string = if (k == Clang::CURSOR_UNION_DECL) { "union" } else { "struct" };
                const nacc: i32 = this.add_reinterpret_accessors(node, fname, cur);
                if (nacc > 0) {
                    this.report.approx(format("anonymous %s in struct '%s' -> field '_anon%d' (%lld-byte) + %d get/set accessors",
                                              kindword, sname, anon_n, sz, nacc));
                } else {
                    this.report.approx(format("anonymous member in struct '%s' -> field '_anon%d': %lld-byte opaque blob (no field access)",
                                              sname, anon_n, sz));
                }
                anon_n = anon_n + 1;
                approximated = true;
                i = i + 1;
                continue;
            }

            // Bitfield run: collapse consecutive bitfields into one storage blob.
            if (cur.is_bitfield()) {
                const start_bits: i64 = Clang::clang_Cursor_getOffsetOfField(cur);
                mut start_byte: i64 = if (start_bits >= 0) { start_bits / 8 } else { 0 };

                mut j: i64 = i + 1;
                while (j < this.field_cursors.length
                       && Clang::clang_getCursorKind(this.field_cursors[j]) == Clang::CURSOR_FIELD_DECL
                       && this.field_cursors[j].is_bitfield()) {
                    j = j + 1;
                }

                // The run ends where the next plain field begins; if the next
                // member is not a plain field (an anonymous member) or the run is
                // the struct's tail, span to the struct end.  `tail` stops the
                // loop so a trailing blob never overlaps a later member.
                mut end_byte: i64 = struct_size;
                mut tail: boolean = true;
                if (j < this.field_cursors.length
                    && Clang::clang_getCursorKind(this.field_cursors[j]) == Clang::CURSOR_FIELD_DECL) {
                    const nb: i64 = Clang::clang_Cursor_getOffsetOfField(this.field_cursors[j]);
                    if (nb >= 0) { end_byte = nb / 8; tail = false; }
                }
                mut span: i64 = end_byte - start_byte;
                if (span <= 0) { span = struct_size - start_byte; tail = true; }

                const fname: SymbolStr =
                    this.ctx.intern_table.intern(format("_bitfield%d", bits_n));
                mut fnode: FieldDeclNode* = new FieldDeclNode(fname, SourceSpan::none());
                fnode.type_annotation = this.types.array(this.types.prim("u8"), span);
                node.add_field(fnode);
                // Restore field access: a shift/mask get/set per UNSIGNED bitfield
                // in the run (only when the blob has a native backing integer
                // width — 1/2/4/8 bytes; signed bitfields stay opaque).
                const nacc: i32 = this.emit_bitfield_accessors(node, fname, span, start_byte, i, j);
                if (nacc > 0) {
                    this.report.approx(format("bitfield run in struct '%s' -> field '_bitfield%d' (%lld-byte) + %d get/set accessors",
                                              sname, bits_n, span, nacc));
                } else {
                    this.report.approx(format("bitfield run in struct '%s' -> field '_bitfield%d': %lld-byte opaque storage (no field access)",
                                              sname, bits_n, span));
                }
                bits_n = bits_n + 1;
                approximated = true;

                if (tail) { i = this.field_cursors.length; } else { i = j; }
                continue;
            }

            // Plain field.  A named field of anonymous record type is mapped to
            // an aligned blob by `map` (not `void*`); flag it as approximated so
            // the struct alignment is corrected and the loss is reported.
            const ftype: CXType = Clang::clang_getCursorType(cur);
            const fname: SymbolStr = cur.intern_spelling(this.ctx);
            mut fnode: FieldDeclNode* = new FieldDeclNode(fname, SourceSpan::none());
            fnode.type_annotation = this.types.map(ftype);
            node.add_field(fnode);
            if (ftype.is_anonymous_record()) {
                this.report.approx(format("field '%s' of anonymous type in struct '%s' -> opaque blob (no field access)",
                                          this.ctx.intern_table.resolve(fname), sname));
                approximated = true;
            }
            i = i + 1;
        }

        if (approximated && struct_size > 0) {
            const al: i64 = Clang::clang_Type_getAlignOf(rec_type);
            if (al > 0) { node.min_alignment = al as u64; }
        }
    }

    /// Add a reinterpret get/set accessor pair for each named member of a record
    /// `record_cursor` (a union, an anonymous-union member, or an anonymous-struct
    /// member), reading/writing `blob_field` reinterpreted as the member's type at
    /// the member's byte offset (0 for every union member; the field offset for an
    /// anon-struct member).  A member of bitfield/anonymous type is skipped (no
    /// faithful scalar reinterpret).  Returns the member count covered.
    add_reinterpret_accessors(mut &this, node: StructDeclNode*, blob_field: SymbolStr,
                              record_cursor: CXCursor) -> i32 {
        this.acc_members = [];
        Clang::clang_visitChildren(record_cursor, Importer::visit_collect_acc_member, this as void*);
        mut n: i32 = 0;
        for (mut i: i64 = 0; i < this.acc_members.length; i++) {
            const m: CXCursor = this.acc_members[i];
            if (m.is_bitfield()) { continue; }
            const mname: SymbolStr = m.intern_spelling(this.ctx);
            if (this.ctx.intern_table.resolve(mname).eq("")) { continue; }
            const mt: CXType = Clang::clang_getCursorType(m);
            if (mt.is_anonymous_record()) { continue; }
            const off_bits: i64 = Clang::clang_Cursor_getOffsetOfField(m);
            const off_bytes: i64 = if (off_bits >= 0) { off_bits / 8 } else { 0 };
            const vt: TypeAnnotation* = this.types.map(mt);
            const set_name: SymbolStr = this.ctx.intern_table.intern(
                "set_" + this.ctx.intern_table.resolve(mname));
            node.add_accessor(BindingAccessor {
                kind: BindingAccessor::KIND_UNION_GET(), name: mname, blob_field: blob_field,
                value_type: vt, byte_offset: off_bytes,
                backing: "", bit_offset: 0, bit_width: 0, is_signed: false
            });
            node.add_accessor(BindingAccessor {
                kind: BindingAccessor::KIND_UNION_SET(), name: set_name, blob_field: blob_field,
                value_type: vt, byte_offset: off_bytes,
                backing: "", bit_offset: 0, bit_width: 0, is_signed: false
            });
            n = n + 1;
        }
        return n;
    }

    /// Add a shift/mask get/set accessor pair for each UNSIGNED bitfield in a run
    /// (`field_cursors[run_lo .. run_hi)`), reading/writing `blob_field`
    /// reinterpreted as a native backing integer.  Returns 0 (no accessors) when
    /// the blob has no native backing width (`span` not in {1,2,4,8}); signed
    /// bitfields are skipped (left opaque) to avoid a sign-extension miscompile.
    emit_bitfield_accessors(mut &this, node: StructDeclNode*, blob_field: SymbolStr,
                            span: i64, start_byte: i64, run_lo: i64, run_hi: i64) -> i32 {
        mut backing: string = "";
        if      (span == 1) { backing = "u8"; }
        else if (span == 2) { backing = "u16"; }
        else if (span == 4) { backing = "u32"; }
        else if (span == 8) { backing = "u64"; }
        if (backing.eq("")) { return 0; }
        const run_start_bit: i64 = start_byte * 8;
        mut n: i32 = 0;
        for (mut p: i64 = run_lo; p < run_hi; p++) {
            const cur: CXCursor = this.field_cursors[p];
            const ct: CXType = Clang::clang_getCursorType(cur);
            // Only integer-typed bitfields (the universe in C); an unsigned field
            // reads with a plain shift/mask, a signed one sign-extends.
            if (!Importer::is_unsigned_int_type(ct) && !Importer::is_signed_int_type(ct)) { continue; }
            const signed: boolean = Importer::is_signed_int_type(ct);
            const off: i64 = Clang::clang_Cursor_getOffsetOfField(cur) - run_start_bit;
            const width: i64 = Clang::clang_getFieldDeclBitWidth(cur) as i64;
            if (off < 0 || width <= 0) { continue; }
            const mname: SymbolStr = cur.intern_spelling(this.ctx);
            if (this.ctx.intern_table.resolve(mname).eq("")) { continue; }
            const vt: TypeAnnotation* = this.types.map(ct);
            const set_name: SymbolStr = this.ctx.intern_table.intern(
                "set_" + this.ctx.intern_table.resolve(mname));
            node.add_accessor(BindingAccessor {
                kind: BindingAccessor::KIND_BITFIELD_GET(), name: mname, blob_field: blob_field,
                value_type: vt, byte_offset: 0,
                backing: backing, bit_offset: off, bit_width: width, is_signed: signed
            });
            node.add_accessor(BindingAccessor {
                kind: BindingAccessor::KIND_BITFIELD_SET(), name: set_name, blob_field: blob_field,
                value_type: vt, byte_offset: 0,
                backing: backing, bit_offset: off, bit_width: width, is_signed: signed
            });
            n = n + 1;
        }
        return n;
    }

    /// True if `t`'s canonical type is a signed integer (so a bitfield of this
    /// type must sign-extend on read).
    static is_signed_int_type(t: CXType) -> boolean {
        const k: i32 = Clang::clang_getCanonicalType(t).kind;
        return k == Clang::TK_Char_S || k == Clang::TK_SChar || k == Clang::TK_Short
            || k == Clang::TK_Int || k == Clang::TK_Long || k == Clang::TK_LongLong;
    }

    /// True if `t`'s canonical type is an unsigned integer (so a bitfield of this
    /// type needs no sign extension and a plain shift/mask accessor is correct).
    static is_unsigned_int_type(t: CXType) -> boolean {
        const k: i32 = Clang::clang_getCanonicalType(t).kind;
        return k == Clang::TK_Bool || k == Clang::TK_Char_U || k == Clang::TK_UChar
            || k == Clang::TK_UShort || k == Clang::TK_UInt
            || k == Clang::TK_ULong || k == Clang::TK_ULongLong;
    }

    /// Emit a `type enum E : <int> { NAME = value; ... }` for a NAMED C enum.
    /// An ANONYMOUS enum has no nameable type; its constants are plain integer
    /// constants in the enclosing scope, so each becomes a global `const`
    /// qualified under the alias.
    emit_enum(mut &this, cursor: CXCursor) -> void {
        const name_sym: SymbolStr = cursor.intern_spelling(this.ctx);
        if (cursor.is_anonymous()) {
            // The anonymous enum's underlying integer type; each constant's
            // global is typed against it.  Kept on the stack for the synchronous
            // walk and pointed at via `cur_enum_int`.
            mut int_type: CXType = Clang::clang_getEnumDeclIntegerType(cursor);
            this.cur_enum_int = &int_type;
            Clang::clang_visitChildren(cursor, Importer::visit_anon_enum_const, this as void*);
            return;
        }
        if (this.name_seen(name_sym)) { return; }

        mut enode: EnumDeclNode* = new EnumDeclNode(name_sym, SourceSpan::none());
        enode.binding_namespace = this.alias;
        enode.repr_c = true;
        enode.discriminant_annotation =
            this.types.map(Clang::clang_getEnumDeclIntegerType(cursor));

        this.cur_enum = enode;
        Clang::clang_visitChildren(cursor, Importer::visit_enum_const, this as void*);

        this.seen_names.push(name_sym);
        this.type_names.push(name_sym);
        this.emit_top_level(enode as ASTNode*);
    }

    /// Nested-walk body: append one EnumVariantNode (from an EnumConstantDecl
    /// cursor) to the named enum currently being populated (`cur_enum`).
    add_enum_const_from(mut &this, cursor: CXCursor) -> void {
        const cname: SymbolStr = cursor.intern_spelling(this.ctx);
        const value: i64 = Clang::clang_getEnumConstantDeclValue(cursor);
        mut vnode: EnumVariantNode* = new EnumVariantNode(cname, SourceSpan::none());
        vnode.set_explicit_value(value);
        this.cur_enum.add_variant(vnode);
        // W2: record so an identifier-alias `#define` can resolve to this
        // constant.  The owning enum's tag types the emitted alias const.
        this.ec_names.push(cname);
        this.ec_values.push(value);
        this.ec_enum_tags.push(this.cur_enum.name);
    }

    /// Nested-walk body: emit one alias-namespaced global `const NAME = value`
    /// for an anonymous enum's constant (typed against `cur_enum_int`).
    add_anon_const_from(mut &this, cursor: CXCursor) -> void {
        const cname: SymbolStr = cursor.intern_spelling(this.ctx);
        if (this.ctx.intern_table.resolve(cname).eq("")) { return; }
        if (this.name_seen(cname)) { return; }

        // Reinterpret the signed discriminant as its u64 bit pattern: a negative
        // value (e.g. -1) emits as the unsigned two's-complement decimal, and
        // LLVMConstInt truncates it to the const's declared width at codegen,
        // reproducing C's value exactly (-1 in an `int` enum -> 0xFFFFFFFF).
        const v: i64 = Clang::clang_getEnumConstantDeclValue(cursor);
        const v_str: string = format("%llu", v as u64);
        mut lit: LiteralNode* = new LiteralNode(v_str, LiteralKind::Integer, SourceSpan::none());
        this.emit_alias_const(cname, this.types.map(*this.cur_enum_int), lit as ExpressionNode*);
        // W2: record (empty owning tag => an alias resolves it as a plain int).
        this.ec_names.push(cname);
        this.ec_values.push(v);
        this.ec_enum_tags.push(SymbolStr::empty());
    }

    /// Emit a `type alias` for a C typedef.  Skips the redundant
    /// `typedef struct Foo Foo;` shape (the struct already supplies `alias::Foo`,
    /// and emitting an alias of the same qualified name would collide / E0207).
    emit_typedef(mut &this, cursor: CXCursor) -> void {
        const name_sym: SymbolStr = cursor.intern_spelling(this.ctx);
        const name_str: string = this.ctx.intern_table.resolve(name_sym);
        if (name_str.eq("")) { return; }

        const underlying: CXType = Clang::clang_getTypedefDeclUnderlyingType(cursor);
        const canon: CXType = Clang::clang_getCanonicalType(underlying);
        if (canon.kind == Clang::TK_Record || canon.kind == Clang::TK_Enum) {
            const tag: SymbolStr = this.types.tag_name(canon);
            if (!tag.is_empty() && this.ctx.intern_table.resolve(tag).eq(name_str)) {
                return; // typedef name == tag name; the record decl covers it.
            }
        }
        if (this.name_seen(name_sym)) { return; }

        mut anode: TypeAliasDeclNode* = new TypeAliasDeclNode(name_sym, SourceSpan::none());
        anode.binding_namespace = this.alias;
        anode.target_annotation = this.types.map(underlying);

        this.seen_names.push(name_sym);
        this.type_names.push(name_sym);
        this.emit_top_level(anode as ASTNode*);
    }

    /// Emit an object-like `#define NAME <literal>` as an alias-namespaced global
    /// `const`.  Per PLAN.md §3, only simple numeric (int/float) literals are
    /// bound; every unbindable form — function-like macro, builtin, valueless
    /// guard, compound/non-literal body, string/char literal — is REPORTED,
    /// never silently dropped.  String/char binding awaits escape-faithful
    /// lowering.
    emit_macro(mut &this, cursor: CXCursor) -> void {
        if (Clang::clang_Cursor_isMacroBuiltin(cursor) != 0u32) { return; }
        // Compiler/target PREDEFINED macros (`__STDC__`, `__GCC_HAVE_*`, …) live
        // in a `<built-in>` pseudo-file and are NOT flagged as system headers, so
        // the system-header filter misses them; restrict import to the header.
        if (!cursor.is_from_main_file()) { return; }
        const name_sym: SymbolStr = cursor.intern_spelling(this.ctx);
        const name_str: string = this.ctx.intern_table.resolve(name_sym);
        if (name_str.eq("")) { return; }
        if (this.name_seen(name_sym)) { return; }

        // SIMPLE-MACRO PASS (W1): bind only an object-like macro whose body is a
        // single numeric/text literal (optionally signed).  Anything else —
        // function-like, valueless, a compound/identifier/arithmetic body — is
        // LEFT for `emit_macro_complex`, which runs after this pass has recorded
        // every simple const, so an alias/arithmetic macro can resolve forward
        // references regardless of cursor order.  No report entries here; the
        // complex pass is the single point that classifies the unbound.
        if (Clang::clang_Cursor_isMacroFunctionLike(cursor) != 0u32) { return; }

        // Tokenize the definition's extent: token[0] is the macro name, the rest
        // are its replacement list.
        const range: CXSourceRange = Clang::clang_getCursorExtent(cursor);
        mut toks: CXToken* = null;
        mut ntok: u32 = 0u32;
        Clang::clang_tokenize(this.tu, range, &toks, &ntok);
        if (toks == null) { return; }
        if (ntok < 2u32) {
            Clang::clang_disposeTokens(this.tu, toks, ntok);
            return;
        }

        // Accept either `<literal>` or `<+|-> <numeric-literal>`.
        const nrepl: u32 = ntok - 1u32;
        mut neg: boolean = false;
        mut lit_idx: u32 = 1u32;
        mut bindable: boolean = true;
        if (nrepl == 2u32) {
            const k0: i32 = Clang::clang_getTokenKind(*(toks + 1));
            const s0: string = (*(toks + 1)).spelling(this.tu, this.ctx);
            if (k0 == Clang::TOKEN_PUNCTUATION && (s0.eq("-") || s0.eq("+"))) {
                neg = s0.eq("-");
                lit_idx = 2u32;
            } else {
                bindable = false;
            }
        } else if (nrepl != 1u32) {
            bindable = false;
        }
        if (!bindable) {
            Clang::clang_disposeTokens(this.tu, toks, ntok);
            return;
        }

        const litk: i32 = Clang::clang_getTokenKind(*(toks + lit_idx));
        const spell: string = (*(toks + lit_idx)).spelling(this.tu, this.ctx);
        if (litk != Clang::TOKEN_LITERAL) {
            Clang::clang_disposeTokens(this.tu, toks, ntok);
            return;
        }
        if (spell.is_text_literal()) {
            this.emit_text_macro(name_sym, name_str, spell, neg);
            Clang::clang_disposeTokens(this.tu, toks, ntok);
            return;
        }

        if (spell.is_float_literal()) {
            // Strip a trailing C float suffix (`f`/`F`/`l`/`L`, e.g. raylib's
            // `#define PI 3.14...f`): codegen's sscanf("%lf") tolerates it, but a
            // Cryo float literal carries no suffix, so a serialized binding would
            // fail to re-parse without this.
            const ftext: string = if (neg) { "-" + Importer::strip_float_suffix(spell) }
                                  else      { Importer::strip_float_suffix(spell) };
            mut flit: LiteralNode* = new LiteralNode(ftext, LiteralKind::Float, SourceSpan::none());
            this.emit_alias_const(name_sym, this.types.prim("f64"), flit as ExpressionNode*);
            this.record_macro_const(name_sym, "f64", ftext, true);
            Clang::clang_disposeTokens(this.tu, toks, ntok);
            return;
        }

        // Integer literal: strtoull(base 0) follows C lexing (0x hex, 0 octal,
        // decimal) and stops at the type suffix.  Pick the narrowest type that
        // holds the value, mirroring C integer-literal typing; emit the value as
        // a u64 decimal (negative -> two's-complement, truncated at codegen).
        const has_u: boolean = spell.is_unsigned_literal();
        const mag: u64 = libc::strtoull(spell as u8*, null, 0);
        mut type_name: string = "i32";
        mut value_u64: u64 = mag;
        if (neg) {
            const sval: i64 = 0i64 - (mag as i64);
            value_u64 = sval as u64;
            type_name = if (sval >= (0i64 - 2147483648i64)) { "i32" } else { "i64" };
        } else if (has_u) {
            type_name = if (mag <= 4294967295u64) { "u32" } else { "u64" };
        } else {
            type_name = if (mag <= 2147483647u64) { "i32" }
                        else { if (mag <= 9223372036854775807u64) { "i64" } else { "u64" } };
        }
        const itext: string = format("%llu", value_u64);
        mut ilit: LiteralNode* =
            new LiteralNode(itext, LiteralKind::Integer, SourceSpan::none());
        this.emit_alias_const(name_sym, this.types.prim(type_name), ilit as ExpressionNode*);
        this.record_macro_const(name_sym, type_name, itext, false);
        Clang::clang_disposeTokens(this.tu, toks, ntok);
    }

    /// Record an object-like macro const (name -> type/text/is-float) so a later
    /// identifier-alias or constant-arithmetic macro in `emit_macro_complex` can
    /// copy it or reference its value numerically.
    record_macro_const(mut &this, name: SymbolStr, type_name: string,
                       text: string, is_float: boolean) -> void {
        this.mac_names.push(name);
        this.mac_types.push(type_name);
        this.mac_texts.push(text);
        this.mac_floats.push(is_float);
    }

    /// COMPLEX-MACRO PASS (W1): runs after `emit_macro` has bound every simple
    /// const and the decl walk has bound every type/enum/function.  Classifies
    /// and (where possible) binds the macros the simple pass left:
    ///   - W2 identifier alias (`#define MOUSE_LEFT_BUTTON MOUSE_BUTTON_LEFT`)
    ///     -> a const aliasing the resolved enum constant / macro const, or a
    ///        `type` alias of a resolved type;
    ///   - W3 compound-literal struct const (`#define RAYWHITE CLITERAL(Color){…}`)
    ///     -> `const RAYWHITE: Color = Color { … }`;
    ///   - W4 constant arithmetic (`#define DEG2RAD (PI/180.0f)`) -> the value
    ///     folded to a single float literal const.
    /// Everything genuinely unbindable is reported: inherently-not-API noise
    /// (function-like, header guards, markers) via `ignore`, and a construct we
    /// *could* bind but don't yet via `skip` (the headline "not bound" bucket).
    emit_macro_complex(mut &this, cursor: CXCursor) -> void {
        if (Clang::clang_Cursor_isMacroBuiltin(cursor) != 0u32) { return; }
        if (!cursor.is_from_main_file()) { return; }
        const name_sym: SymbolStr = cursor.intern_spelling(this.ctx);
        const name_str: string = this.ctx.intern_table.resolve(name_sym);
        if (name_str.eq("")) { return; }
        if (this.name_seen(name_sym)) { return; } // already bound by the simple pass

        if (Clang::clang_Cursor_isMacroFunctionLike(cursor) != 0u32) {
            this.report.ignore(format("function-like macro '%s'", name_str));
            return;
        }

        const range: CXSourceRange = Clang::clang_getCursorExtent(cursor);
        mut toks: CXToken* = null;
        mut ntok: u32 = 0u32;
        Clang::clang_tokenize(this.tu, range, &toks, &ntok);
        if (toks == null) {
            this.report.ignore(format("macro '%s' (no tokens)", name_str));
            return;
        }
        if (ntok < 2u32) {
            Clang::clang_disposeTokens(this.tu, toks, ntok);
            this.report.ignore(format("valueless macro '%s' (header guard / marker)", name_str));
            return;
        }

        // W3: compound-literal struct const, e.g. `CLITERAL(Color){ 245,… }`.
        if (this.try_emit_compound_struct(name_sym, name_str, toks, ntok)) {
            Clang::clang_disposeTokens(this.tu, toks, ntok);
            return;
        }

        // W2: single-identifier alias.  (A single LITERAL token was already
        // bound by the simple pass, so a 2-token body here is non-literal.)
        if (ntok == 2u32) {
            const k1: i32 = Clang::clang_getTokenKind(*(toks + 1));
            const s1: string = (*(toks + 1)).spelling(this.tu, this.ctx);
            Clang::clang_disposeTokens(this.tu, toks, ntok);
            if (k1 == Clang::TOKEN_IDENTIFIER) {
                if (this.try_emit_identifier_alias(name_sym, name_str, s1)) { return; }
                if (this.is_bound_function(s1)) {
                    this.report.skip(format("alias '%s' -> function '%s' (forwarding wrapper unsupported)",
                                            name_str, s1));
                    return;
                }
            }
            // A keyword/punctuation token, or an identifier that resolves to
            // nothing bound, is a marker (`RLAPI`, `extern`), not lost API.
            this.report.ignore(format("marker macro '%s' -> '%s'", name_str, s1));
            return;
        }

        // W4: constant arithmetic over literals / macro consts.
        if (this.try_emit_arith_macro(name_sym, name_str, toks, ntok)) {
            Clang::clang_disposeTokens(this.tu, toks, ntok);
            return;
        }

        Clang::clang_disposeTokens(this.tu, toks, ntok);
        this.report.skip(format("compound macro '%s' (non-trivial replacement)", name_str));
    }

    /// True if a top-level C function `name` was bound in this import (so a
    /// macro aliasing it is recognized as a — currently unsupported — function
    /// alias rather than misclassified as a marker).
    is_bound_function(&this, name: string) -> boolean {
        const sym: SymbolStr = this.ctx.intern_table.intern(name);
        for (mut i: i64 = 0; i < this.extern_node.functions.length; i++) {
            if (this.extern_node.functions[i].name.equals(sym)) { return true; }
        }
        return false;
    }

    /// W2: bind `#define ALIAS TARGET` where TARGET is a bound symbol.
    ///   - enum constant -> `const ALIAS: <EnumType> = <value>;`
    ///   - macro const    -> a copy with the target's type and literal value;
    ///   - type           -> `type ALIAS = TARGET;`.
    /// Returns false (caller decides marker-vs-lost) when TARGET resolves to no
    /// bound symbol, or to a function (handled separately).
    try_emit_identifier_alias(mut &this, name_sym: SymbolStr, name_str: string,
                              target: string) -> boolean {
        const tsym: SymbolStr = this.ctx.intern_table.intern(target);

        // Enum constant (named-enum variant or anonymous-enum const).
        for (mut i: i64 = 0; i < this.ec_names.length; i++) {
            if (!this.ec_names[i].equals(tsym)) { continue; }
            const value: i64 = this.ec_values[i];
            const tag: SymbolStr = this.ec_enum_tags[i];
            const ty: TypeAnnotation* = if (tag.is_empty()) {
                this.types.prim("i32")
            } else {
                this.types.named(this.types.qualify_under_alias(tag))
            };
            mut lit: LiteralNode* =
                new LiteralNode(format("%llu", value as u64), LiteralKind::Integer, SourceSpan::none());
            this.emit_alias_const(name_sym, ty, lit as ExpressionNode*);
            return true;
        }

        // Object-like macro const: copy its type and literal value.
        for (mut i: i64 = 0; i < this.mac_names.length; i++) {
            if (!this.mac_names[i].equals(tsym)) { continue; }
            const kind: LiteralKind =
                if (this.mac_floats[i]) { LiteralKind::Float } else { LiteralKind::Integer };
            mut lit: LiteralNode* =
                new LiteralNode(this.mac_texts[i], kind, SourceSpan::none());
            this.emit_alias_const(name_sym, this.types.prim(this.mac_types[i]), lit as ExpressionNode*);
            this.record_macro_const(name_sym, this.mac_types[i], this.mac_texts[i], this.mac_floats[i]);
            return true;
        }

        // Bound type: a `type` alias.
        for (mut i: i64 = 0; i < this.type_names.length; i++) {
            if (!this.type_names[i].equals(tsym)) { continue; }
            mut anode: TypeAliasDeclNode* = new TypeAliasDeclNode(name_sym, SourceSpan::none());
            anode.binding_namespace = this.alias;
            anode.target_annotation = this.types.named(this.types.qualify_under_alias(tsym));
            this.seen_names.push(name_sym);
            this.type_names.push(name_sym);
            this.emit_top_level(anode as ASTNode*);
            return true;
        }

        // Bound function: a thin forwarding wrapper (vendor path only — see
        // `is_vendor`).  A variadic target can't be forwarded (no way to pass a
        // C `...` through), so it's left for the caller to report.
        if (this.is_vendor) {
            const target_fn: FunctionDeclNode* = this.find_function(tsym);
            if (target_fn != null && !target_fn.is_variadic) {
                this.emit_forwarding_wrapper(name_sym, target_fn);
                return true;
            }
        }

        return false;
    }

    /// The bound extern function named `sym`, or null.
    find_function(&this, sym: SymbolStr) -> FunctionDeclNode* {
        for (mut i: i64 = 0; i < this.extern_node.functions.length; i++) {
            if (this.extern_node.functions[i].name.equals(sym)) {
                return this.extern_node.functions[i];
            }
        }
        return null;
    }

    /// W2 (function alias): emit a bodied top-level wrapper that forwards to a
    /// bound C function, e.g. `#define GetMouseRay GetScreenToWorldRay` ->
    /// `function GetMouseRay(arg0: Vector2, arg1: Camera) -> Ray {
    ///      return GetScreenToWorldRay(arg0, arg1); }`.
    /// Params mirror the target's types (unnamed C params get a synthesized
    /// `argN`); the call forwards them positionally.  A `void` target uses an
    /// expression statement instead of a return.  Top-level decls are public by
    /// default, so the wrapper is visible as `<Ns>::<alias>` with no modifier.
    emit_forwarding_wrapper(mut &this, alias_name: SymbolStr, target_fn: FunctionDeclNode*) -> void {
        mut wrapper: FunctionDeclNode* = new FunctionDeclNode(alias_name, SourceSpan::none());
        wrapper.is_public = true;
        wrapper.return_type_annotation = target_fn.return_type_annotation;

        mut params: VarDeclNode*[] = [];
        mut call_args: ExpressionNode*[] = [];
        for (mut i: i64 = 0; i < target_fn.parameters.length; i++) {
            const tp: VarDeclNode* = target_fn.parameters[i];
            mut pname: SymbolStr = tp.name;
            if (this.ctx.intern_table.resolve(pname).eq("")) {
                pname = this.ctx.intern_table.intern(format("arg%lld", i));
            }
            mut pnode: VarDeclNode* = new VarDeclNode(pname, SourceSpan::none());
            pnode.type_annotation = tp.type_annotation;
            params.push(pnode);
            call_args.push((new IdentifierNode(pname, SourceSpan::none())) as ExpressionNode*);
        }
        wrapper.parameters = params;

        mut callee: IdentifierNode* = new IdentifierNode(target_fn.name, SourceSpan::none());
        mut call: CallExprNode* = new CallExprNode(callee as ExpressionNode*, SourceSpan::none());
        call.arguments = call_args;

        mut block: BlockStmtNode* = new BlockStmtNode(SourceSpan::none());
        if (this.is_void_annotation(target_fn.return_type_annotation)) {
            block.add_statement(
                (new ExprStmtNode(call as ExpressionNode*, SourceSpan::none())) as StatementNode*);
        } else {
            block.add_statement(
                (new ReturnStmtNode(call as ExpressionNode*, SourceSpan::none())) as StatementNode*);
        }
        wrapper.body = block;

        this.seen_names.push(alias_name);
        this.emit_top_level(wrapper as ASTNode*);
    }

    /// True if `ann` denotes `void` (null, or the `void` primitive).
    is_void_annotation(&this, ann: TypeAnnotation*) -> boolean {
        if (ann == null) { return true; }
        match (*ann) {
            TypeAnnotation::Primitive(p) => {
                return this.ctx.intern_table.resolve(p.name).eq("void");
            }
            _ => { return false; }
        }
    }

    /// W3: bind a C compound-literal macro `#define NAME [CLITERAL](Type){ a, b, … }`
    /// as `const NAME: Type = Type { f0: a, f1: b, … }`.  The struct's fields
    /// supply the names (positional C initializer); each value must be a numeric
    /// literal.  Returns false (leaving the macro for another handler) when the
    /// tokens are not this shape, the type isn't a bound struct, or the value
    /// count doesn't match the field count.
    try_emit_compound_struct(mut &this, name_sym: SymbolStr, name_str: string,
                             toks: CXToken*, ntok: u32) -> boolean {
        // Locate the brace group `{ … }`.
        mut bo: i64 = -1;
        mut bc: i64 = -1;
        for (mut i: i64 = 1; i < ntok as i64; i++) {
            const sp: string = (*(toks + i)).spelling(this.tu, this.ctx);
            if (Clang::clang_getTokenKind(*(toks + i)) == Clang::TOKEN_PUNCTUATION) {
                if (sp.eq("{") && bo < 0) { bo = i; }
                if (sp.eq("}"))           { bc = i; }
            }
        }
        if (bo < 0 || bc <= bo) { return false; }

        // The struct type is the last bound-struct identifier before the brace
        // (handles both `(Type){…}` and `CLITERAL(Type){…}`).
        mut struct_node: StructDeclNode* = null;
        for (mut i: i64 = 1; i < bo; i++) {
            if (Clang::clang_getTokenKind(*(toks + i)) != Clang::TOKEN_IDENTIFIER) { continue; }
            const sp: string = (*(toks + i)).spelling(this.tu, this.ctx);
            const cand: StructDeclNode* = this.find_struct(this.ctx.intern_table.intern(sp));
            if (cand != null) { struct_node = cand; }
        }
        if (struct_node == null) { return false; }

        // Collect the literal values inside the braces (commas are punctuation
        // and are skipped); each must be a numeric literal.
        mut vals: string[] = [];
        for (mut i: i64 = bo + 1; i < bc; i++) {
            if (Clang::clang_getTokenKind(*(toks + i)) != Clang::TOKEN_LITERAL) { continue; }
            vals.push((*(toks + i)).spelling(this.tu, this.ctx));
        }
        if (vals.length != struct_node.fields.length || vals.length == 0) { return false; }

        // Build the struct literal in field-declaration order (the codegen
        // const-aggregate path zips positionally, so order must match).
        const qualified: SymbolStr = this.types.qualify_under_alias(struct_node.name);
        mut slit: StructLiteralNode* = new StructLiteralNode(qualified, SourceSpan::none());
        for (mut i: i64 = 0; i < struct_node.fields.length; i++) {
            const raw: string = vals[i];
            mut lk: LiteralKind = LiteralKind::Integer;
            mut text: string = raw;
            if (raw.is_text_literal()) { return false; } // not a numeric color value
            if (raw.is_float_literal()) { lk = LiteralKind::Float; text = Importer::strip_float_suffix(raw); }
            mut vlit: LiteralNode* = new LiteralNode(text, lk, SourceSpan::none());
            slit.add_field_init(FieldInit {
                field_name: struct_node.fields[i].name,
                value:      vlit as ExpressionNode*,
                span:       SourceSpan::none()
            });
        }
        this.emit_alias_const(name_sym, this.types.named(qualified), slit as ExpressionNode*);
        return true;
    }

    /// W4: bind a constant-arithmetic macro whose replacement is a same-operator
    /// chain over numeric literals / bound consts, e.g. `#define DEG2RAD (PI/180.0f)`
    /// or a flag-combine `#define GN_FLAGS (1 | 2 | 4)`.  The value is folded at
    /// import time to a single literal const — sidestepping both the unsupported
    /// global const-references-const init and any serializer change.  An integer
    /// fold is tried first (covers bitwise flag combines + enum-constant operands),
    /// then a float fold.  Mixed operators (`a + b * c`) decline to avoid a
    /// precedence bug; the chain must be a single repeated operator.
    try_emit_arith_macro(mut &this, name_sym: SymbolStr, name_str: string,
                         toks: CXToken*, ntok: u32) -> boolean {
        // Strip balanced outer parens from the replacement (tokens 1..ntok-1).
        mut lo: i64 = 1;
        mut hi: i64 = (ntok as i64) - 1;
        while (lo < hi
               && Clang::clang_getTokenKind(*(toks + lo)) == Clang::TOKEN_PUNCTUATION
               && (*(toks + lo)).spelling(this.tu, this.ctx).eq("(")
               && Clang::clang_getTokenKind(*(toks + hi)) == Clang::TOKEN_PUNCTUATION
               && (*(toks + hi)).spelling(this.tu, this.ctx).eq(")")) {
            lo = lo + 1;
            hi = hi - 1;
        }
        // operand (op operand)* => an odd token count, with one repeated
        // operator (so a left-assoc fold is exact).  A single operand is allowed
        // (a parenthesized literal/const, e.g. `#define X (5)`).
        const count: i64 = hi - lo + 1;
        if (count < 1 || count % 2 == 0) { return false; }
        mut op: string = "";
        mut p: i64 = lo + 1;
        while (p <= hi) {
            if (Clang::clang_getTokenKind(*(toks + p)) != Clang::TOKEN_PUNCTUATION) { return false; }
            const o: string = (*(toks + p)).spelling(this.tu, this.ctx);
            if (op.eq("")) { op = o; } else if (!op.eq(o)) { return false; }
            p = p + 2;
        }

        if (this.fold_int_chain(name_sym, toks, lo, hi, op)) { return true; }
        if (this.fold_float_chain(name_sym, toks, lo, hi, op)) { return true; }
        return false;
    }

    /// Fold an integer operand chain (all operands resolve to an i64 via int
    /// literal / int macro const / enum constant) under a single bitwise or
    /// arithmetic operator.  Emits a narrowest-fitting integer const.  Returns
    /// false if any operand isn't integral or the operator isn't integer-valid.
    fold_int_chain(mut &this, name_sym: SymbolStr, toks: CXToken*,
                   lo: i64, hi: i64, op: string) -> boolean {
        mut acc: i64 = 0;
        mut first: boolean = true;
        mut p: i64 = lo;
        while (p <= hi) {
            mut v: i64 = 0;
            if (!this.arith_operand_int(*(toks + p), &v)) { return false; }
            if (first) { acc = v; first = false; }
            else if (op.eq("|"))  { acc = acc | v; }
            else if (op.eq("&"))  { acc = acc & v; }
            else if (op.eq("^"))  { acc = acc ^ v; }
            else if (op.eq("+"))  { acc = acc + v; }
            else if (op.eq("-"))  { acc = acc - v; }
            else if (op.eq("*"))  { acc = acc * v; }
            else if (op.eq("<<")) { acc = acc << v; }
            else if (op.eq(">>")) { acc = acc >> v; }
            else if (op.eq("/"))  { if (v == 0) { return false; } acc = acc / v; }
            else if (op.eq("%"))  { if (v == 0) { return false; } acc = acc % v; }
            else { return false; }
            p = p + 2;
        }
        const type_name: string =
            if (acc >= (0i64 - 2147483648i64) && acc <= 2147483647i64) { "i32" } else { "i64" };
        const text: string = format("%llu", acc as u64);
        mut ilit: LiteralNode* = new LiteralNode(text, LiteralKind::Integer, SourceSpan::none());
        this.emit_alias_const(name_sym, this.types.prim(type_name), ilit as ExpressionNode*);
        this.record_macro_const(name_sym, type_name, text, false);
        return true;
    }

    /// Fold a float operand chain (operands resolve to f64) under `+ - * /`.
    /// Emits an f64 const.  Returns false if any operand isn't numeric or the
    /// operator isn't float-valid.
    fold_float_chain(mut &this, name_sym: SymbolStr, toks: CXToken*,
                     lo: i64, hi: i64, op: string) -> boolean {
        mut acc: f64 = 0.0;
        mut first: boolean = true;
        mut p: i64 = lo;
        while (p <= hi) {
            mut v: f64 = 0.0;
            if (!this.arith_operand(*(toks + p), &v)) { return false; }
            if (first) { acc = v; first = false; }
            else if (op.eq("+")) { acc = acc + v; }
            else if (op.eq("-")) { acc = acc - v; }
            else if (op.eq("*")) { acc = acc * v; }
            else if (op.eq("/")) { if (v == 0.0) { return false; } acc = acc / v; }
            else { return false; }
            p = p + 2;
        }
        // Full double precision, ensuring a Cryo float literal (a decimal point
        // or exponent) so it doesn't re-lex as an integer.
        mut text: string = format("%.17g", acc);
        if (!Importer::has_float_marker(text)) { text = text + ".0"; }
        mut flit: LiteralNode* = new LiteralNode(text, LiteralKind::Float, SourceSpan::none());
        this.emit_alias_const(name_sym, this.types.prim("f64"), flit as ExpressionNode*);
        this.record_macro_const(name_sym, "f64", text, true);
        return true;
    }

    /// Resolve a single operand token to an i64: an integer literal (base-0 C
    /// lexing), a bound INT macro const, or an enum constant.  Returns false for
    /// a float/text literal or a float macro const (the float path handles those).
    arith_operand_int(&this, tok: CXToken, out: i64*) -> boolean {
        const k: i32 = Clang::clang_getTokenKind(tok);
        const sp: string = tok.spelling(this.tu, this.ctx);
        if (k == Clang::TOKEN_LITERAL) {
            if (sp.is_text_literal() || sp.is_float_literal()) { return false; }
            *out = libc::strtoull(sp as u8*, null, 0) as i64;
            return true;
        }
        if (k == Clang::TOKEN_IDENTIFIER) {
            const tsym: SymbolStr = this.ctx.intern_table.intern(sp);
            for (mut i: i64 = 0; i < this.ec_names.length; i++) {
                if (this.ec_names[i].equals(tsym)) { *out = this.ec_values[i]; return true; }
            }
            for (mut i: i64 = 0; i < this.mac_names.length; i++) {
                if (this.mac_names[i].equals(tsym) && !this.mac_floats[i]) {
                    *out = libc::strtoull(this.mac_texts[i] as u8*, null, 0) as i64;
                    return true;
                }
            }
        }
        return false;
    }

    /// Resolve a single arithmetic operand token to an f64: a numeric literal
    /// (any C float/int suffix stripped) or a bound macro const referenced by
    /// name.  Returns false for anything else.
    arith_operand(&this, tok: CXToken, out: f64*) -> boolean {
        const k: i32 = Clang::clang_getTokenKind(tok);
        const sp: string = tok.spelling(this.tu, this.ctx);
        if (k == Clang::TOKEN_LITERAL) {
            if (sp.is_text_literal()) { return false; }
            mut v: f64 = 0.0;
            intrinsics::sscanf(Importer::strip_float_suffix(sp), "%lf", &v);
            *out = v;
            return true;
        }
        if (k == Clang::TOKEN_IDENTIFIER) {
            const tsym: SymbolStr = this.ctx.intern_table.intern(sp);
            for (mut i: i64 = 0; i < this.mac_names.length; i++) {
                if (!this.mac_names[i].equals(tsym)) { continue; }
                mut v: f64 = 0.0;
                intrinsics::sscanf(Importer::strip_float_suffix(this.mac_texts[i]), "%lf", &v);
                *out = v;
                return true;
            }
        }
        return false;
    }

    /// Strip a trailing C numeric suffix (`f`/`F`/`l`/`L`) from a float literal
    /// spelling, since a Cryo float literal carries no suffix.  Other literals
    /// pass through unchanged.
    static strip_float_suffix(spell: string) -> string {
        const sl: i64 = libc::strlen(spell) as i64;
        if (sl <= 0) { return spell; }
        const last: i8 = spell[sl - 1];
        if (last == 'f' || last == 'F' || last == 'l' || last == 'L') {
            return spell.substr(0, sl - 1);
        }
        return spell;
    }

    /// True if `text` already reads as a Cryo float literal (carries a decimal
    /// point or an exponent), so it won't be re-lexed as an integer.
    static has_float_marker(text: string) -> boolean {
        const n: i64 = libc::strlen(text) as i64;
        for (mut i: i64 = 0; i < n; i++) {
            const c: i8 = text[i];
            if (c == '.' || c == 'e' || c == 'E') { return true; }
        }
        return false;
    }

    /// Lower a string- or char-literal `#define` to an alias-namespaced const.
    /// `spell` is the literal token (quotes and any encoding prefix included).
    ///   - A STRING (`"..."`) becomes a `string` const.  C escapes are decoded
    ///     exactly as the Cryo lexer decodes a source string literal, so the
    ///     stored value is the final byte sequence codegen interns verbatim.
    ///   - A CHAR (`'.'`) becomes a `char` const carrying its integer code point.
    ///     (The global-var emitter has no Char-literal path, but `char` is
    ///     integer-represented, so an Integer literal lowers correctly.)
    /// A signed or otherwise unparseable text literal is reported, not bound.
    emit_text_macro(mut &this, name_sym: SymbolStr, name_str: string,
                    spell: string, neg: boolean) -> void {
        if (neg) {
            this.report.skip(format("macro '%s' (malformed signed text literal)", name_str));
            return;
        }
        // Find the opening quote — it may follow an encoding prefix (`u8`/`L`/
        // `u`/`U`).  A `"` opens a string; a `'` opens a character.
        const slen: i64 = libc::strlen(spell) as i64;
        mut open: i64 = -1;
        mut q: i8 = 0i8;
        for (mut p: i64 = 0; p < slen; p++) {
            const ch: i8 = spell[p];
            if (ch == '"' || ch == '\'') { open = p; q = ch; break; }
        }
        // The closing quote is the last byte equal to the opening quote.
        mut close: i64 = slen - 1;
        while (close > open && spell[close] != q) { close = close - 1; }
        if (open < 0 || close <= open) {
            this.report.skip(format("macro '%s' (unparseable text literal '%s')", name_str, spell));
            return;
        }

        const inner: string = spell.substr(open + 1, close - open - 1);
        if (q == '"') {
            const decoded: string = Lexer::process_escape_sequences(inner);
            mut slit: LiteralNode* =
                new LiteralNode(decoded, LiteralKind::String, SourceSpan::none());
            this.emit_alias_const(name_sym, this.types.prim("string"), slit as ExpressionNode*);
        } else {
            const cp: u64 = CodegenUtil::decode_char_lexeme(inner);
            mut clit: LiteralNode* =
                new LiteralNode(format("%llu", cp), LiteralKind::Integer, SourceSpan::none());
            this.emit_alias_const(name_sym, this.types.prim("char"), clit as ExpressionNode*);
        }
    }

    /// Pass entry: walk top-level statements for CImport ExternBlockNodes, and
    /// for each resolve its includes and import their C function prototypes.
    static run(ctx: CompilationContext*) -> PassResult {
        const snap: DiagnosticSnapshot = ctx.diagnostics.snapshot();
        const root: ProgramNode* = ctx.artifacts.ast.root;

        if (root == null) {
            return PassResult::from_snapshot(ctx.diagnostics, snap);
        }

        mut total_imported: i32 = 0;
        for (mut i: int = 0; i < root.statements.length; i++) {
            const node: ASTNode* = root.statements[i];
            if (node == null) { continue; }
            if (node.kind != NodeKind::ExternBlock) { continue; }

            const extern_node: ExternBlockNode* = node as ExternBlockNode*;
            if (!extern_node.is_c_import()) { continue; }

            const source_dir: string = Importer::get_directory(ctx.source_file);

            for (mut j: int = 0; j < extern_node.include_paths.length; j++) {
                const include_path: string = extern_node.include_paths[j];
                const is_system: boolean =
                    (j < extern_node.include_is_system.length)
                    && extern_node.include_is_system[j];

                if (is_system) {
                    const count: i32 =
                        Importer::import_system_header(include_path, extern_node, ctx);
                    total_imported += count;
                    continue;
                }

                const resolved: string = Importer::resolve_include_path(source_dir, include_path);
                if (resolved == "") {
                    cdebug("[Bindgen] WARNING: header not found: '%s' (relative to '%s')\n",
                           include_path, source_dir);
                    continue;
                }

                const count: i32 = Importer::import_local_header(resolved, extern_node, ctx);
                total_imported += count;
            }

            if (ctx.debug_mode) {
                const alias_str: string = ctx.intern_table.resolve(extern_node.namespace_alias);
                cdebug("[Bindgen] '%s': %d includes, %d functions\n",
                       alias_str, extern_node.include_paths.length, extern_node.functions.length);
            }
        }

        if (ctx.debug_mode && total_imported > 0) {
            cdebug("[Bindgen] Total: %d C functions imported\n", total_imported);
        }

        return PassResult::from_snapshot(ctx.diagnostics, snap);
    }

    /// Parse a local quoted header (`#include "foo.h"`) from its resolved
    /// path and emit its function prototypes.  Returns the count.
    static import_local_header(resolved_path: string, extern_node: ExternBlockNode*,
                               ctx: CompilationContext*) -> i32 {
        mut no_extra: u8*[] = [];
        return Importer::collect_from_tu(resolved_path as u8*, null, 0u32,
                                         &no_extra, resolved_path, extern_node, ctx, null, null);
    }

    /// Parse an angle-bracket system header (`#include <stdio.h>`) by feeding
    /// a one-line `#include <...>` to libclang as an in-memory unsaved file —
    /// libclang resolves it against its own system search path.  The header
    /// name is validated to path-safe characters first.
    static import_system_header(header: string, extern_node: ExternBlockNode*,
                                ctx: CompilationContext*) -> i32 {
        if (!Importer::is_safe_header_name(header)) {
            ctx.diagnostics.emit(Diagnostic::error(
                ErrorCode::E0806_HEADER_PREPROC_FAILED,
                format("invalid system header name '<%s>': only letters, digits, and '. _ / + -' are allowed",
                    header)));
            return 0;
        }
        const content: string = format("#include <%s>\n", header);
        mut uf: CXUnsavedFile = CXUnsavedFile {
            filename: "cryo_syshdr.c" as u8*,
            contents: content as u8*,
            length:   libc::strlen(content)
        };
        mut no_extra: u8*[] = [];
        return Importer::collect_from_tu("cryo_syshdr.c" as u8*, &uf, 1u32,
                                         &no_extra, header, extern_node, ctx, null, null);
    }

    /// `clang_getInclusions` trampoline: records each non-system file the TU
    /// pulled in (entry header + transitive `#include`s) into `imp.inputs`, for
    /// the include-graph `.deps` sidecar.  System headers are dropped — they are
    /// already covered by the libclang-version fold in the provenance key, and
    /// hashing glibc/CRT headers on every cache check would be wasteful.  Matches
    /// the C `CXInclusionVisitor` signature `(CXFile, CXSourceLocation*, unsigned,
    /// CXClientData) -> void`; `inclusion_stack`/`include_len` are unused (the
    /// file's own location, via `clang_getLocationForOffset`, drives the filter).
    static visit_inclusion(included_file: void*, inclusion_stack: CXSourceLocation*,
                           include_len: u32, client: void*) -> void {
        const imp: Importer* = client as Importer*;
        // Recover the path FIRST, before any other libclang call on this cursor:
        // a later by-value (24-byte, sret) `CXSourceLocation` return can disturb
        // the `included_file` argument, so reading the name up front keeps it.
        const fname: CXString = Clang::clang_getFileName(included_file);
        const cstr: u8* = Clang::clang_getCString(fname);
        mut path: string = "";
        if (cstr != null) { path = String::from_cstr(cstr as string).into_raw(); }
        Clang::clang_disposeString(fname);
        if (libc::strlen(path) == 0) { return; }
        // Drop system headers (already covered by the libclang-version fold).
        const loc: CXSourceLocation =
            Clang::clang_getLocationForOffset(imp.tu, included_file, 0u32);
        if (Clang::clang_Location_isInSystemHeader(loc) != 0) { return; }
        imp.inputs.push(path);
    }

    /// Build a libclang TU (forcing C with `-x c`, matching the old
    /// preprocess), walk its top-level cursors, and emit FunctionDeclNodes.
    /// `unsaved`/`num_unsaved` carry an in-memory buffer for system headers
    /// (null/0 for a real file).  Returns the number of functions emitted.
    /// `out_report` (when non-null) accumulates this TU's skipped/approximated
    /// constructs for the caller's consolidated report (the `cryo vendor`
    /// path); when null, the report rides the `--debug`-only `cdebug` summary
    /// (the inline `#include` path).  `out_inputs` (when non-null) is appended
    /// with every non-system file the TU included (via `clang_getInclusions`),
    /// for the generator's include-graph `.deps` sidecar; null on the inline
    /// path skips the inclusion walk entirely.
    static collect_from_tu(source_filename: u8*, unsaved: CXUnsavedFile*, num_unsaved: u32,
                           extra_args: &u8*[], label: string, extern_node: ExternBlockNode*,
                           ctx: CompilationContext*, out_report: ImportReport*,
                           out_inputs: string[]*) -> i32 {
        const index: void* = Clang::clang_createIndex(0, 0);
        // Force C (matches the old `-x c` preprocess).  `CRYO_CLANG_RESOURCE_DIR`,
        // when set, adds `-resource-dir <dir>` so libclang finds its builtin
        // headers (stddef.h / stdint.h / …) — needed on Windows, where the
        // bundled libclang.dll is staged next to cryo.exe and so cannot locate
        // its resource dir by the default `<dll>/../lib/clang/<v>` walk.  Unset
        // on a normal host install (the system libclang resolves its own), so
        // this is a no-op there.  `extra_args` carries the vendor generator's
        // `-I<dir>` / `-D<def>` flags (empty for the inline `#include` path).
        mut args: u8*[] = [];
        args.push("-x" as u8*);
        args.push("c" as u8*);
        const res_dir: i8* = libc::getenv("CRYO_CLANG_RESOURCE_DIR") as i8*;
        if (res_dir != null && libc::strlen(res_dir as string) > 0) {
            args.push("-resource-dir" as u8*);
            args.push(res_dir as u8*);
        }
        for (mut ei: i64 = 0; ei < extra_args.length; ei++) {
            args.push(extra_args[ei]);
        }

        const tu: void* = Clang::clang_parseTranslationUnit(
            index, source_filename, &args[0], args.length as i32, unsaved, num_unsaved,
            Clang::TU_DETAILED_PREPROCESSING_RECORD);
        if ((tu as void*) == null) {
            ctx.diagnostics.emit(Diagnostic::error(
                ErrorCode::E0806_HEADER_PREPROC_FAILED,
                format("libclang failed to parse C header '%s'", label)));
            Clang::clang_disposeIndex(index);
            return 0;
        }

        mut imp: Importer = Importer::new(extern_node, ctx, tu);
        // The vendor generator passes a non-null out_report; the inline
        // `#include` path passes null.  Function-alias wrappers ride this flag.
        imp.is_vendor = out_report != null;
        const cursor: CXCursor = Clang::clang_getTranslationUnitCursor(tu);
        Clang::clang_visitChildren(cursor, Importer::visit_decl, (&imp) as void*);
        // W1 two-pass macro emission (deferred from the decl walk): bind the
        // simple literal consts first so the macro-const table is complete, then
        // resolve the alias/compound/arithmetic macros against the full set of
        // bound types, enum constants, functions, and consts.
        for (mut mi: i64 = 0; mi < imp.macro_cursors.length; mi++) {
            imp.emit_macro(imp.macro_cursors[mi]);
        }
        for (mut mi: i64 = 0; mi < imp.macro_cursors.length; mi++) {
            imp.emit_macro_complex(imp.macro_cursors[mi]);
        }
        if (out_report != null) { imp.report.merge_into(out_report); }
        else                    { imp.report.summary(label); }

        // Vendor path only: enumerate the TU's inclusion set (entry header +
        // transitive `#include`s) for the include-graph provenance sidecar.  The
        // TU is still live here; the visitor appends non-system paths to
        // `imp.inputs`, which we thread out to the caller's accumulator.
        if (out_inputs != null) {
            Clang::clang_getInclusions(tu, Importer::visit_inclusion, (&imp) as void*);
            for (mut ii: i64 = 0; ii < imp.inputs.length; ii++) {
                out_inputs.push(imp.inputs[ii]);
            }
        }

        Clang::clang_disposeTranslationUnit(tu);
        Clang::clang_disposeIndex(index);
        return imp.count;
    }


    // Path Resolution (ported verbatim from the former hand-rolled pass).

    /// Extract directory component from a file path.
    static get_directory(path: string) -> string {
        const len: u64 = libc::strlen(path);
        mut last_sep: i64 = -1;
        for (mut i: u64 = 0; i < len; i++) {
            if (path[i] == '/' || path[i] == '\\') {
                last_sep = i as i64;
            }
        }
        if (last_sep < 0) {
            return ".";
        }
        const dir: i8* = intrinsics::malloc((last_sep + 1) as u64) as i8*;
        intrinsics::memcpy(dir as void*, path as void*, last_sep as u64);
        dir[last_sep] = 0;
        return dir as string;
    }

    /// Resolve an include path relative to a source directory.  Returns the
    /// resolved path if the file exists, empty string otherwise.
    static resolve_include_path(source_dir: string, include_path: string) -> string {
        const src_len: u64 = libc::strlen(source_dir);
        const inc_len: u64 = libc::strlen(include_path);
        const total: u64 = src_len + 1 + inc_len + 1;
        const buf: i8* = intrinsics::malloc(total) as i8*;
        intrinsics::memcpy(buf as void*, source_dir as void*, src_len);
        buf[src_len] = '/';
        intrinsics::memcpy((buf + src_len + 1) as void*, include_path as void*, inc_len);
        buf[src_len + 1 + inc_len] = 0;

        const f: void* = libc::fopen(buf as string, "r");
        if (f != null) {
            libc::fclose(f);
            return buf as string;
        }

        intrinsics::free(buf as void*);
        return "";
    }

    /// True when `name` contains only characters valid in a C header path:
    /// ASCII letters, digits, and '. _ / + -'.  Excludes shell/regex
    /// metacharacters; keeps system header names well-formed.
    static is_safe_header_name(name: string) -> boolean {
        const len: u64 = libc::strlen(name);
        if (len == 0) { return false; }
        for (mut i: u64 = 0; i < len; i++) {
            const c: i8 = name[i];
            const ok: boolean = (c as char).is_c_ident_char()
                || c == '.' || c == '/' || c == '+' || c == '-';
            if (!ok) { return false; }
        }
        return true;
    }
}
