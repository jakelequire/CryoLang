/// libclang FFI surface
///
/// The stable libclang C API that drives C-header binding generation.  All
/// handles (CXIndex, CXTranslationUnit) are opaque `void*`; the three small
/// libclang aggregates (`CXString`, `CXCursor`, `CXType`) are passed and
/// returned BY VALUE — Cryo's SysV x86-64 codegen handles this correctly
/// (proven by the Phase-0 ABI spike: 16B DirectPair, 32B Indirect/SRet/ByVal,
/// including the >16B callee-side ByVal prologue `clang_visitChildren` needs).
///
/// These are hand-written `extern "C"` declarations rather than an
/// `extern module clang := "C" { #include <clang-c/Index.h> }` block: the
/// engine that parses `#include`s is built ON TOP of these, so they cannot
/// themselves come through that path (and a curated surface keeps the
/// bootstrap free of a clang-c header dependency).

namespace Compiler::Bindgen::Clang;

import ffi::libc;
import Compiler::CompilationContext;
import Compiler::Resolver::{ SymbolStr, InternTable };

// ---- By-value aggregates (stable libclang ABI layouts) ----

/// `{ const void *data; unsigned private_flags; }` — 16 bytes (DirectPair).
type struct CXString {
    data:          void*;
    private_flags: u32;
}

/// `{ enum kind; int xdata; const void *data[3]; }` — 32 bytes (Indirect).
type struct CXCursor {
    kind:  i32;
    xdata: i32;
    data:  void*[3];

    /// True when this is a C11 anonymous struct/union MEMBER declaration — the
    /// nameless `union { ... };` that contributes its storage directly to the
    /// enclosing record.  Narrower than a plain anonymity test: it excludes a
    /// nameless record DEFINITION that a following named field references, so it
    /// distinguishes an anonymous member (emitted as a blob in place) from a
    /// nameless type carried by a named field.
    is_anonymous_record_decl(this) -> boolean {
        return clang_Cursor_isAnonymousRecordDecl(this) != 0u32;
    }

    /// True when this cursor is a bitfield field declaration (`unsigned x : 3`).
    is_bitfield(this) -> boolean {
        return clang_Cursor_isBitField(this) != 0u32;
    }

    /// True for an anonymous tag declaration (`struct {...}` / `enum {...}` with
    /// no name).  Use this rather than testing the cursor spelling for emptiness:
    /// libclang reports a synthetic spelling (`enum (unnamed at …)`) for these.
    is_anonymous(this) -> boolean {
        return clang_Cursor_isAnonymous(this) != 0u32;
    }

    /// True when this cursor was declared in a system header (`<stddef.h>` & co.).
    /// THE Phase-2 filter: libclang exposes every transitively-included header's
    /// top-level decls, so type emission must drop the system-header ones (their
    /// `size_t`/`int32_t` typedefs map inline via the canonical type anyway) and
    /// keep only the user/project headers the import names.
    is_in_system_header(this) -> boolean {
        const loc: CXSourceLocation = clang_getCursorLocation(this);
        return clang_Location_isInSystemHeader(loc) != 0;
    }

    /// True when this cursor is in the translation unit's MAIN file (the imported
    /// header itself).  Used to keep object-like `#define` import to the user's
    /// own header — the compiler/target PREDEFINED macros (`__STDC__`,
    /// `__GCC_HAVE_DWARF2_CFI_ASM`, …) live in a `<built-in>` pseudo-file, are NOT
    /// flagged as system headers, and would otherwise leak into the alias.
    is_from_main_file(this) -> boolean {
        const loc: CXSourceLocation = clang_getCursorLocation(this);
        return clang_Location_isFromMainFile(loc) != 0;
    }

    /// Intern this cursor's spelling (e.g. a function/field name) into `ctx`.
    /// The C string is owned by the CXString, so it is copied (interned) before
    /// the string is disposed.
    intern_spelling(this, ctx: CompilationContext*) -> SymbolStr {
        const s: CXString = clang_getCursorSpelling(this);
        const cstr: u8* = clang_getCString(s);
        const sym: SymbolStr = ctx.intern_table.intern(cstr as string);
        clang_disposeString(s);
        return sym;
    }

    /// Intern this parameter cursor's name.  An unnamed parameter (empty
    /// spelling) gets a synthesized `argN`, exactly as the hand-rolled scanner
    /// did, so a `void *` with no name still yields a first-class declaration.
    intern_arg_name(this, index: i32, ctx: CompilationContext*) -> SymbolStr {
        const s: CXString = clang_getCursorSpelling(this);
        const cstr: u8* = clang_getCString(s);
        if (cstr == null || libc::strlen(cstr as string) == 0) {
            clang_disposeString(s);
            const buf: i8* = intrinsics::malloc(16) as i8*;
            intrinsics::sprintf(buf as string, "arg%d", index);
            const sym: SymbolStr = ctx.intern_table.intern(buf as string);
            intrinsics::free(buf as void*);
            return sym;
        }
        const sym: SymbolStr = ctx.intern_table.intern(cstr as string);
        clang_disposeString(s);
        return sym;
    }
}

/// `{ enum kind; void *data[2]; }` — 24 bytes (Indirect).
type struct CXType {
    kind: i32;
    data: void*[2];

    /// True when the canonical type is an anonymous record — a struct/union with
    /// no tag name, so it cannot be referenced by a named Cryo type.  Such a type
    /// maps to a layout-faithful opaque storage blob rather than `void*`.
    is_anonymous_record(this) -> boolean {
        const c: CXType = clang_getCanonicalType(this);
        if (c.kind != TK_Record) { return false; }
        const decl: CXCursor = clang_getTypeDeclaration(c);
        return decl.is_anonymous();
    }
}

/// `{ const char *Filename; const char *Contents; unsigned long Length; }`.
/// Lets a system header (`#include <stdio.h>`) be parsed from an in-memory
/// buffer with a virtual filename — no temp file on disk.
type struct CXUnsavedFile {
    filename: u8*;
    contents: u8*;
    length:   u64;
}

/// `{ const void *ptr_data[2]; unsigned int_data; }` — 24 bytes.  Drives the
/// system-header filter (`is_in_system_header`): libclang walks the WHOLE
/// translation unit, including every transitively-`#include`d system header
/// (`<stddef.h>`/`<stdint.h>` & friends), so without this filter type
/// emission would pull ~100 glibc typedefs (`size_t`, `__off_t`, …) into the
/// alias namespace.  (Phase 1 functions-only never hit this: system headers
/// declare no functions.)
type struct CXSourceLocation {
    ptr_data: void*[2];
    int_data: u32;
}

/// `{ const void *ptr_data[2]; unsigned begin_int_data; unsigned end_int_data; }`
/// — 24 bytes.  A half-open source range; `clang_getCursorExtent` returns one,
/// and `clang_tokenize` consumes it to recover an object-like `#define`'s
/// replacement tokens.
type struct CXSourceRange {
    ptr_data:       void*[2];
    begin_int_data: u32;
    end_int_data:   u32;
}

/// `{ unsigned int_data[4]; void *ptr_data; }` — 24 bytes.  One lexed token
/// from `clang_tokenize`; passed BY VALUE to the token accessors (same 24-byte
/// ABI shape as CXType, handled by the Phase-0 spike).
type struct CXToken {
    int_data: u32[4];
    ptr_data: void*;

    /// Copy this token's spelling into an owned string (backed by the intern
    /// table, so it outlives the CXString disposed here).  `tu` is the owning
    /// translation unit.  Used to read an object-like macro's replacement token.
    spelling(this, tu: void*, ctx: CompilationContext*) -> string {
        const s: CXString = clang_getTokenSpelling(tu, this);
        const cstr: u8* = clang_getCString(s);
        const out: string = ctx.intern_table.resolve(ctx.intern_table.intern(cstr as string));
        clang_disposeString(s);
        return out;
    }
}

// ---- CXCursorKind / CXChildVisitResult constants ----
const CURSOR_STRUCT_DECL: i32        = 2;
const CURSOR_UNION_DECL: i32         = 3;
const CURSOR_ENUM_DECL: i32          = 5;
const CURSOR_FIELD_DECL: i32         = 6;
const CURSOR_ENUM_CONSTANT_DECL: i32 = 7;
const CURSOR_FUNCTION_DECL: i32      = 8;
const CURSOR_TYPEDEF_DECL: i32       = 20;
const CURSOR_MACRO_DEFINITION: i32   = 501;
const VISIT_CONTINUE: i32 = 1;

// ---- CXTokenKind constants ----
const TOKEN_PUNCTUATION: i32 = 0;
const TOKEN_KEYWORD: i32     = 1;
const TOKEN_IDENTIFIER: i32  = 2;
const TOKEN_LITERAL: i32     = 3;
const TOKEN_COMMENT: i32     = 4;

// ---- CXTranslationUnit_Flags ----
/// Keep a detailed preprocessing record so `#define` / `#include` /
/// macro-expansion cursors appear in the TU walk (needed to import
/// object-like macro constants).
const TU_DETAILED_PREPROCESSING_RECORD: u32 = 0x01u32;

// ---- CXTypeKind constants (stable libclang ABI) ----
const TK_Void: i32       = 2;
const TK_Bool: i32       = 3;
const TK_Char_U: i32     = 4;
const TK_UChar: i32      = 5;
const TK_UShort: i32     = 8;
const TK_UInt: i32       = 9;
const TK_ULong: i32      = 10;
const TK_ULongLong: i32  = 11;
const TK_Char_S: i32     = 13;
const TK_SChar: i32      = 14;
const TK_Short: i32      = 16;
const TK_Int: i32        = 17;
const TK_Long: i32       = 18;
const TK_LongLong: i32   = 19;
const TK_Float: i32      = 21;
const TK_Double: i32     = 22;
const TK_LongDouble: i32 = 23;
const TK_Pointer: i32    = 101;
const TK_Record: i32     = 105;
const TK_Enum: i32       = 106;
const TK_FunctionNoProto: i32 = 110;
const TK_FunctionProto: i32   = 111;
const TK_ConstantArray: i32   = 112;
const TK_IncompleteArray: i32 = 114;

extern "C" {
    // Index / translation-unit lifecycle.
    function clang_createIndex(exclude_pch: i32, display_diags: i32) -> void*;
    function clang_parseTranslationUnit(idx: void*, source_filename: u8*,
        command_line_args: u8**, num_args: i32,
        unsaved_files: CXUnsavedFile*, num_unsaved: u32, options: u32) -> void*;
    function clang_disposeTranslationUnit(tu: void*) -> void;
    function clang_disposeIndex(idx: void*) -> void;

    // Cursor walk.
    function clang_getTranslationUnitCursor(tu: void*) -> CXCursor;
    function clang_visitChildren(parent: CXCursor,
        visitor: (CXCursor, CXCursor, void*) -> i32, client: void*) -> u32;
    function clang_getCursorKind(c: CXCursor) -> i32;
    function clang_getCursorSpelling(c: CXCursor) -> CXString;
    /// True for an anonymous tag (`struct {...}`, `enum {...}`).  Needed
    /// because libclang gives such a cursor a SYNTHETIC spelling
    /// (`enum (unnamed at foo.h:1:1)`), so an empty-spelling test does NOT
    /// detect anonymity.
    function clang_Cursor_isAnonymous(c: CXCursor) -> u32;

    // Function-decl introspection.
    function clang_getCursorResultType(c: CXCursor) -> CXType;
    function clang_getCursorType(c: CXCursor) -> CXType;
    function clang_Cursor_getNumArguments(c: CXCursor) -> i32;
    function clang_Cursor_getArgument(c: CXCursor, i: u32) -> CXCursor;
    function clang_isFunctionTypeVariadic(t: CXType) -> u32;

    // Type introspection (drives the CXType -> Cryo annotation mapper).
    function clang_getCanonicalType(t: CXType) -> CXType;
    function clang_getPointeeType(t: CXType) -> CXType;
    function clang_isConstQualifiedType(t: CXType) -> u32;
    function clang_getTypeSpelling(t: CXType) -> CXString;
    /// Cursor declaring a record/enum type — used to recover the bare tag
    /// name of a `struct Foo`/`enum E` reference so it can be qualified under
    /// the import's alias namespace.
    function clang_getTypeDeclaration(t: CXType) -> CXCursor;

    // Phase 2: record / enum / typedef / array / function-pointer introspection.
    function clang_getTypedefDeclUnderlyingType(c: CXCursor) -> CXType;
    function clang_getEnumConstantDeclValue(c: CXCursor) -> i64;
    function clang_getEnumDeclIntegerType(c: CXCursor) -> CXType;
    function clang_Type_getSizeOf(t: CXType) -> i64;
    function clang_Type_getAlignOf(t: CXType) -> i64;
    /// Bit offset of a named field within `t` (a record type).  Used to span a
    /// run of bitfields with one opaque storage blob (Phase 3 reuses it to
    /// assert per-field offsets).  Returns a negative CXTypeLayoutError on a
    /// dependent/invalid field.
    function clang_Type_getOffsetOf(t: CXType, field: u8*) -> i64;
    /// Bit offset of a field FROM ITS CURSOR (no name lookup) — the per-cursor
    /// form of `clang_Type_getOffsetOf`, used while walking a record's children
    /// to locate where a bitfield run begins and ends.
    function clang_Cursor_getOffsetOfField(c: CXCursor) -> i64;
    /// True when the field cursor is a bitfield (`unsigned x : 3`).  Such fields
    /// share a storage unit and have no addressable Cryo equivalent, so a run of
    /// them is replaced by an opaque storage blob.
    function clang_Cursor_isBitField(c: CXCursor) -> u32;
    /// The declared bit width of a bitfield field (`: 3` -> 3), or -1 for a
    /// non-bitfield.  Reported in the translation summary.
    function clang_getFieldDeclBitWidth(c: CXCursor) -> i32;
    /// True ONLY for a C11 anonymous struct/union MEMBER — the nameless
    /// `union { ... };` that injects its fields into the enclosing record.  This
    /// is narrower than `clang_Cursor_isAnonymous` (which is also true for a
    /// nameless record DEFINITION that a following named field references), so it
    /// distinguishes an anonymous member (contributes layout directly, emitted as
    /// a blob) from a nameless type used by a named field (the field carries it).
    function clang_Cursor_isAnonymousRecordDecl(c: CXCursor) -> u32;
    function clang_getArrayElementType(t: CXType) -> CXType;
    function clang_getArraySize(t: CXType) -> i64;
    function clang_getNumArgTypes(t: CXType) -> i32;
    function clang_getArgType(t: CXType, i: u32) -> CXType;
    function clang_getResultType(t: CXType) -> CXType;

    // Source-location queries (system-header filter).
    function clang_getCursorLocation(c: CXCursor) -> CXSourceLocation;
    function clang_Location_isInSystemHeader(loc: CXSourceLocation) -> i32;
    function clang_Location_isFromMainFile(loc: CXSourceLocation) -> i32;

    // Preprocessor / macro introspection (object-like #define import).
    function clang_Cursor_isMacroFunctionLike(c: CXCursor) -> u32;
    function clang_Cursor_isMacroBuiltin(c: CXCursor) -> u32;
    function clang_getCursorExtent(c: CXCursor) -> CXSourceRange;
    function clang_tokenize(tu: void*, range: CXSourceRange,
        tokens: CXToken**, num_tokens: u32*) -> void;
    function clang_getTokenKind(t: CXToken) -> i32;
    function clang_getTokenSpelling(tu: void*, t: CXToken) -> CXString;
    function clang_disposeTokens(tu: void*, tokens: CXToken*, num_tokens: u32) -> void;

    // CXString access.
    function clang_getCString(s: CXString) -> u8*;
    function clang_disposeString(s: CXString) -> void;

    // Toolchain identity (cache-provenance key, Stage 3): a human-readable
    // libclang version banner, e.g. "clang version 20.1.0".  Folded into the
    // vendor cache key so a libclang upgrade invalidates stale bindings.
    function clang_getClangVersion() -> CXString;

    // Inclusion graph (Stage-3 follow-up: transitive `#include` provenance).
    // `clang_getInclusions` invokes `visitor` once per file pulled into the TU;
    // the vendor generator records the non-system ones into a `.deps` sidecar so
    // editing a transitively-included header invalidates the cache (the entry
    // header alone used to be hashed).  `clang_getFileName` recovers a CXFile's
    // path (CXFile is an opaque pointer); `clang_getLocationForOffset` yields a
    // location inside the file so `clang_Location_isInSystemHeader` can drop
    // system headers (covered already by the libclang-version fold).  The
    // visitor's params are all register-sized (CXFile/ptr/u32/ptr) — no by-value
    // struct — so its callback ABI is strictly simpler than clang_visitChildren.
    function clang_getInclusions(tu: void*,
        visitor: (void*, CXSourceLocation*, u32, void*) -> void, client: void*) -> void;
    function clang_getFileName(file: void*) -> CXString;
    function clang_getLocationForOffset(tu: void*, file: void*, offset: u32) -> CXSourceLocation;
}

