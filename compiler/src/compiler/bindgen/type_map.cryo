/// CXType -> Cryo type-annotation mapper
///
/// Maps a libclang CANONICAL type (typedefs/elaborated forms resolved) to a
/// Cryo TypeAnnotation.  Driving off the canonical type means `size_t` -> `u64`
/// and `LLVMModuleRef` (typedef void*) -> `void*` fall out of the real type,
/// not a name table.
///
/// Emits real aggregate types: a record/enum reference maps to the
/// NAMED Cryo type the importer emits, qualified under the import's alias
/// namespace (`probe::Point`); a function-pointer pointee maps to a Cryo
/// `(Args) -> Ret` type; fixed C arrays map to Cryo fixed-array fields.  A
/// record the bindings do not emit (a system-header or nested record) maps to
/// a layout-faithful blob or an opaque `void*`.
///
/// State (the compilation context + the import's alias namespace) lives on the
/// `CTypeMapper` object rather than being threaded through every call: build one
/// per translation unit (`CTypeMapper::new(ctx, alias)`) and call `map(t)`.
/// Every importer has an alias module - the inline `extern module` path and
/// the vendor generator both register one before importing - so a named
/// record or enum is always spelled under it.

namespace compiler::bindgen::type_map;

import compiler::bindgen::clang::{ CXType, CXCursor, CXString };
import compiler::compilation_context::{ CompilationContext, CRecordRef };
import compiler::module_graph::{ ModulePath };
import compiler::resolver::{ symbol_str, intern_table };
import compiler::resolver::res::{ DefId, Res, ResSlot };
import compiler::diag::{ source_span };
import compiler::ast::{
    ArrayAnnotation, declaration, FunctionAnnotation, NamedAnnotation, node,
    PointerAnnotation, PrimitiveAnnotation, TypeAnnotation
};
import compiler::types::type_ref::{ TypeRef };
import std::ffi::libc;
import compiler::diag::source_span::{ SourceSpan };
import compiler::resolver::symbol_str::{ SymbolStr };

/// CXTypeKind -> Cryo primitive name.  Returns "" for non-scalar kinds.  Pure
/// (no ctx/alias), so it stays a free helper of the mapper.
function scalar_name(k: i32) -> string {
    if (k == clang::TK_Void)       { return "void"; }
    if (k == clang::TK_Bool)       { return "boolean"; }
    if (k == clang::TK_Char_U)     { return "u8"; }
    if (k == clang::TK_UChar)      { return "u8"; }
    if (k == clang::TK_Char_S)     { return "i8"; }
    if (k == clang::TK_SChar)      { return "i8"; }
    if (k == clang::TK_UShort)     { return "u16"; }
    if (k == clang::TK_Short)      { return "i16"; }
    if (k == clang::TK_UInt)       { return "u32"; }
    if (k == clang::TK_Int)        { return "i32"; }
    // TK_Long / TK_ULong are handled in `map()` via clang_Type_getSizeOf:
    // their width is target-dependent (LP64 vs LLP64), not a fixed name.
    if (k == clang::TK_ULongLong)  { return "u64"; }
    if (k == clang::TK_LongLong)   { return "i64"; }
    if (k == clang::TK_Float)      { return "f32"; }
    if (k == clang::TK_Double)     { return "f64"; }
    if (k == clang::TK_LongDouble) { return "f64"; }
    return "";
}

/// CXType -> Cryo TypeAnnotation mapper.  Holds the compilation context and the
/// import's alias namespace so neither has to be threaded through the recursion.
type struct CTypeMapper {
    ctx:   mut CompilationContext*;
    /// The import's extern-module alias's module (`<mod>::alias`).
    alias: ModulePath;
    /// The system header an angle-bracket import names (`<math.h>`), as its
    /// CXFile; null for every other import.  Its declarations are bound, while
    /// the system headers it includes stay filtered.
    named_system_header: void*;

    static new(ctx: mut CompilationContext*, alias: ModulePath) -> CTypeMapper {
        return CTypeMapper { ctx: ctx, alias: alias, named_system_header: null };
    }

    /// True when `declaration` is in a header this import binds: any header
    /// outside the system include path, or the system header the import
    /// names.  A declaration anywhere else is not emitted, so a reference to
    /// it cannot be spelled by name.
    is_bound_declaration(&this, declaration: CXCursor) -> boolean {
        if (!declaration.is_in_system_header()) { return true; }
        return this.named_system_header != null && declaration.file() == this.named_system_header;
    }

    /// Heap-allocate a PrimitiveAnnotation wrapped in a TypeAnnotation.
    prim(&this, name: string) -> mut TypeAnnotation* {
        const sym: SymbolStr = this.ctx.intern_table.intern(name);
        const p: PrimitiveAnnotation* = new PrimitiveAnnotation { name: sym, span: SourceSpan::none() };
        const ann: mut TypeAnnotation* = libc::malloc(sizeof(TypeAnnotation)) as mut TypeAnnotation*;
        *ann = TypeAnnotation::Primitive(p);
        return ann;
    }

    /// Heap-allocate a PointerAnnotation wrapped in a TypeAnnotation.  `is_const`
    /// marks `const T*` (the pointee is const - frontend-only flag).
    ptr(&this, inner: mut TypeAnnotation*, is_const: boolean) -> mut TypeAnnotation* {
        const p: PointerAnnotation* = new PointerAnnotation { inner: inner, is_const: is_const, span: SourceSpan::none() };
        const ann: mut TypeAnnotation* = libc::malloc(sizeof(TypeAnnotation)) as mut TypeAnnotation*;
        *ann = TypeAnnotation::Pointer(p);
        return ann;
    }

    /// Heap-allocate a NamedAnnotation naming the record or enum this
    /// import emits for the C tag `tag`, spelled `<alias>::<tag>` - the name
    /// every index holds it under, since it is declared in the alias's module.
    ///
    /// The reference is built before the name layer has declared anything, so
    /// it cannot carry the declaration's id yet, and the name layer cannot
    /// answer it by looking the spelling up (it has no span, so no writing
    /// module).  It is listed on the context instead: the importer pins it to
    /// the declaration it emitted for `tag`, and the name layer answers it
    /// with that declaration's id once it is declared.
    named(&this, tag: SymbolStr) -> mut TypeAnnotation* {
        const n: mut NamedAnnotation* = new NamedAnnotation {
            name: this.qualify_under_alias(tag), span: SourceSpan::none(), pre_resolved: TypeRef::invalid(),
            res: ResSlot::Pending,
        };
        const ann: mut TypeAnnotation* = libc::malloc(sizeof(TypeAnnotation)) as mut TypeAnnotation*;
        *ann = TypeAnnotation::Named(n);
        this.ctx.c_refs.push(CRecordRef { ann: n, alias: this.alias, tag: tag, decl: null });
        return ann;
    }

    /// Heap-allocate a fixed-size ArrayAnnotation (`[T; N]`).
    array(&this, element: mut TypeAnnotation*, size: i64) -> mut TypeAnnotation* {
        const arr: mut ArrayAnnotation* = new ArrayAnnotation { element: element, size: size,
                                                            size_expr: null, span: SourceSpan::none() };
        const ann: mut TypeAnnotation* = libc::malloc(sizeof(TypeAnnotation)) as mut TypeAnnotation*;
        *ann = TypeAnnotation::Array(arr);
        return ann;
    }

    /// Heap-allocate a FunctionAnnotation (`(params) -> ret`) - a Cryo function
    /// pointer type.
    fnptr(&this, params: [mut TypeAnnotation*], ret: mut TypeAnnotation*) -> mut TypeAnnotation* {
        const f: FunctionAnnotation* = new FunctionAnnotation {
            parameters: params, return_type: ret, span: SourceSpan::none()
        };
        const ann: mut TypeAnnotation* = libc::malloc(sizeof(TypeAnnotation)) as mut TypeAnnotation*;
        *ann = TypeAnnotation::Function(f);
        return ann;
    }

    /// A layout-faithful opaque storage blob for a type that has no first-class
    /// Cryo representation (an anonymous record member, a union, a bitfield run):
    /// `[E; N]` where `E` is the largest unsigned integer whose width divides the
    /// alignment (so the array's natural alignment matches C's) and `N` spans the
    /// byte size.  C records have `size % align == 0`, so the division is exact.
    /// A field of this type round-trips by value but offers no member access.
    aligned_blob(&this, size: i64, align: i64) -> mut TypeAnnotation* {
        mut elem_bytes: i64 = align;
        if (elem_bytes != 1 && elem_bytes != 2 && elem_bytes != 4 && elem_bytes != 8) {
            // Non-power-of-two or >8 (e.g. 16-byte `long double`): the widest
            // primitive is u64; rely on the enclosing struct's min_alignment for
            // overall alignment, and a static_assert to catch a mismatch.
            elem_bytes = if (size % 8 == 0) { 8 } else { 1 };
        }
        const count: i64 = size / elem_bytes;
        mut elem_name: string = "u8";
        if (elem_bytes == 2)      { elem_name = "u16"; }
        else if (elem_bytes == 4) { elem_name = "u32"; }
        else if (elem_bytes == 8) { elem_name = "u64"; }
        return this.array(this.prim(elem_name), count);
    }

    /// The bare tag name of a record/enum CXType (e.g. `Point` for
    /// `struct Point`), interned into `ctx`.  Empty SymbolStr for anonymous types.
    tag_name(&this, t: CXType) -> SymbolStr {
        const decl: CXCursor = clang::clang_getTypeDeclaration(t);
        const s: CXString = clang::clang_getCursorSpelling(decl);
        const cstr: u8* = clang::clang_getCString(s);
        if (cstr == null || (cstr as string).length() == 0) {
            clang::clang_disposeString(s);
            return SymbolStr::empty();
        }
        const sym: SymbolStr = this.ctx.intern_table.intern(cstr as string);
        clang::clang_disposeString(s);
        return sym;
    }

    /// Qualify a record/enum tag name under the import's alias namespace.
    qualify_under_alias(&this, tag: SymbolStr) -> SymbolStr {
        return this.alias.qualified(tag, this.ctx.intern_table);
    }

    /// True when `t` is a C `va_list`.  Checks the declared spelling (the
    /// typedef `va_list` / `__builtin_va_list`) and the canonical spelling
    /// (which on x86-64 / aarch64 expands to `struct __va_list_tag [1]`), so it
    /// catches va_list however a platform's headers spell it.
    static type_is_va_list(t: CXType) -> boolean {
        if (CTypeMapper::type_spelling_contains(t, "va_list")) { return true; }
        const canon: CXType = clang::clang_getCanonicalType(t);
        return CTypeMapper::type_spelling_contains(canon, "__va_list_tag");
    }

    /// True when the libclang spelling of `t` contains `needle`.
    static type_spelling_contains(t: CXType, needle: string) -> boolean {
        const s: CXString = clang::clang_getTypeSpelling(t);
        const cstr: u8* = clang::clang_getCString(s);
        mut found: boolean = false;
        if (cstr != null) {
            found = (cstr as string).contains(needle);
        }
        clang::clang_disposeString(s);
        return found;
    }

    /// Map a libclang type to a Cryo TypeAnnotation.
    map(&this, t: CXType) -> mut TypeAnnotation* {
        // C `va_list` (canonicalizes to the unnameable platform
        // `__va_list_tag[1]`) maps to the first-class `va_list` type - checked
        // BEFORE canonicalization, which would otherwise lose the va_list
        // identity and emit a dangling `__va_list_tag` array.
        if (CTypeMapper::type_is_va_list(t)) {
            return this.prim("va_list");
        }
        const c: CXType = clang::clang_getCanonicalType(t);
        const k: i32 = c.kind;

        if (k == clang::TK_Pointer) {
            const pointee: CXType = clang::clang_getPointeeType(c);
            const pc: CXType = clang::clang_getCanonicalType(pointee);
            // Function-pointer pointee -> a Cryo `(Args) -> Ret` type (already a
            // pointer-shaped value in Cryo, so no extra Pointer wrapper).
            if (pc.kind == clang::TK_FunctionProto || pc.kind == clang::TK_FunctionNoProto) {
                mut params: [mut TypeAnnotation*] = [];
                const nargs: i32 = clang::clang_getNumArgTypes(pc);
                for (mut i: i32 = 0; i < nargs; i++) {
                    params.push(this.map(clang::clang_getArgType(pc, i as u32)));
                }
                const ret: mut TypeAnnotation* = this.map(clang::clang_getResultType(pc));
                return this.fnptr(params, ret);
            }
            const is_const: boolean = clang::clang_isConstQualifiedType(pointee) != 0;
            // A pointer to a system-header record (e.g. `FILE` == `struct _iobuf`
            // on mingw) -> opaque `void*`.  That record is filtered out of the
            // bindings, so a named `_iobuf*` reference would dangle (E0203);
            // `void*` is also the usable shape for an opaque C handle.
            if (pc.kind == clang::TK_Record) {
                const pdecl: CXCursor = clang::clang_getTypeDeclaration(pc);
                // A pointer to a record that won't be emitted top-level - one in
                // a system header the import does not bind (`FILE`) or one
                // nested inside another record (sqlite3's
                // `sqlite3_index_constraint_usage`) - would name a dangling
                // type, so use opaque `void*` (the right shape for an opaque C
                // handle anyway).
                if (!this.is_bound_declaration(pdecl) || pdecl.is_nested_in_record()) {
                    return this.ptr(this.prim("void"), is_const);
                }
            }
            const inner: mut TypeAnnotation* = this.map(pointee);
            return this.ptr(inner, is_const);
        }

        // A C++ reference (`T&` / `T&&`) is a pointer at the ABI level, so it maps
        // to a Cryo pointer to the referent (mirrors the `this`-as-pointer
        // receiver).  `const T&` lowers as `T*` like any const pointer.
        if (k == clang::TK_LValueReference || k == clang::TK_RValueReference) {
            const referent: CXType = clang::clang_getPointeeType(c);
            const is_const_ref: boolean = clang::clang_isConstQualifiedType(referent) != 0;
            return this.ptr(this.map(referent), is_const_ref);
        }

        if (k == clang::TK_ConstantArray) {
            const elem: mut TypeAnnotation* = this.map(clang::clang_getArrayElementType(c));
            return this.array(elem, clang::clang_getArraySize(c));
        }

        if (k == clang::TK_Record) {
            // Anonymous record (a nameless `struct {...}` used as a field type):
            // a layout-faithful opaque blob, not `void*`, so the enclosing
            // struct's size/alignment stay correct.  Detected via the type's
            // declaration anonymity - libclang gives an anonymous tag a SYNTHETIC
            // spelling (`struct (unnamed at ...)`), so `tag_name` is non-empty and
            // an emptiness test would miss it.  An incomplete record (size
            // unknown) keeps the opaque-pointer fallback.
            if (c.is_anonymous_record()) {
                const sz: i64 = clang::clang_Type_getSizeOf(c);
                const al: i64 = clang::clang_Type_getAlignOf(c);
                if (sz > 0) { return this.aligned_blob(sz, al); }
                return this.ptr(this.prim("void"), false);
            }
            // A named record declared in a system header the import does not
            // bind is filtered out (like `FILE`), so a named reference would
            // dangle.  Treat
            // it as opaque: a layout-faithful blob when sized (keeps an enclosing
            // struct's size right), else an opaque pointer.  (The common
            // pointer-to-system-record case is handled as `void*` above.)
            const rdecl: CXCursor = clang::clang_getTypeDeclaration(c);
            if (!this.is_bound_declaration(rdecl) || rdecl.is_nested_in_record()) {
                const sz: i64 = clang::clang_Type_getSizeOf(c);
                const al: i64 = clang::clang_Type_getAlignOf(c);
                if (sz > 0) { return this.aligned_blob(sz, al); }
                return this.ptr(this.prim("void"), false);
            }
            // Reference to an emitted record: name it, qualified under the alias.
            const tag: SymbolStr = this.tag_name(c);
            if (!tag.is_empty()) {
                return this.named(tag);
            }
            return this.ptr(this.prim("void"), false);
        }

        if (k == clang::TK_Enum) {
            const tag: SymbolStr = this.tag_name(c);
            if (!tag.is_empty()) {
                return this.named(tag);
            }
            // An enum with no name still round-trips as its integer width.
            return this.prim("i32");
        }

        // C `long` / `unsigned long` width is TARGET-DEPENDENT: 8 bytes on
        // LP64 (Linux/macOS), 4 on LLP64 (Windows).  Ask libclang for the
        // canonical type's actual size in this TU's target instead of
        // assuming LP64 - a hardcoded i64/u64 gives every bare-`long` C API
        // wrong-width fields and params on Windows.
        if (k == clang::TK_Long || k == clang::TK_ULong) {
            const long_size: i64 = clang::clang_Type_getSizeOf(c);
            if (long_size == 4) {
                return this.prim(if (k == clang::TK_Long) { "i32" } else { "u32" });
            }
            return this.prim(if (k == clang::TK_Long) { "i64" } else { "u64" });
        }

        const name: string = scalar_name(k);
        if (!name.eq("")) {
            return this.prim(name);
        }

        // Unexposed / incomplete-array / unknown -> opaque `void*`.
        return this.ptr(this.prim("void"), false);
    }
}
