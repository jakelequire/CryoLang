/// Vendor binding generator (libclang -> `.cryo` source text)
///
/// Drives the
/// existing libclang cursor-walk engine (`Importer`) to build the same decl
/// nodes the inline `extern module := "C"` path produces, then SERIALIZES them
/// back to `.cryo` SOURCE TEXT (approach A, generated source) under a
/// real `namespace <Name>;`.  `cryo vendor` writes that text to the per-triple
/// cache; it then flows through the unmodified parser -> sema -> codegen -> LSP
/// pipeline like any other module.
///
/// Two pieces:
///   - BindingSerializer - renders the struct / enum / typedef / global-const /
///     extern-function nodes (and their TypeAnnotation trees) to Cryo source.
///     The importer qualifies emitted type references under its alias namespace
///     (we pass the vendor namespace as that alias), so a `Color` field types as
///     `<Name>::Color`; the serializer strips the namespace prefix since every
///     emitted type already lives under the file's `namespace <Name>;`.
///   - VendorGenerator - builds one libclang TU per manifest header (with the
///     manifest's `-I<include_dir>` / `-D<define>` args), accumulates the decls
///     into a throwaway context, and returns the serialized source.

namespace compiler::bindgen::generator;

import compiler::bindgen::importer::{ Importer, ImportReport };
import compiler::lex::{ TokenType };
import compiler::bindgen::clang::{ CXString };
import compiler::build_manifest::{ Manifest };
import compiler::compilation_context::{ BuildOptions, CompilationContext };
import compiler::compile_mode::{ CompileMode };
import compiler::ast::{ declaration, LiteralKind, node, TypeAnnotation };
import compiler::ast::expression::{
    CallExpr, CastExpr, ExpressionNode, FieldInit,LiteralExpr,
    StructExpr
};
import compiler::ast::statement::{ Stmt, StmtKind };
import compiler::resolver::{ symbol_str, intern_table };
import compiler::diag::{ source_span };
import std::fs::file::{ File };
import std::fs::path::{ Path };
import std::fs::file;
import std::fmt;
import std::core::primitives;
import std::core::hash::{ Fnv128Hasher };
import std::collections::string::{ String };
import std::collections::str::{ Str };
import std::core::mem;
import compiler::ast::declaration::{
    BindingAccessor, DeclarationNode, EnumDecl, EnumVariant, ExternBlock, FieldDecl,
    FunctionDecl, ImplBlock, MethodDecl, StructDecl, TypeAliasDecl,
    UnionDecl, VarDecl
};
import compiler::ast::node::{ ProgramNode };
import compiler::diag::source_span::{ SourceSpan };
import compiler::resolver::symbol_str::{ SymbolStr };
import compiler::resolver::qualified_name::{ QualifiedName };
import utils::keyword::{ Keyword };

/// Bump whenever the emitted binding format changes (a new field shape, a
/// different type mapping, ...).  It participates in the cache key, so an
/// increment invalidates every previously cached binding after a compiler
/// upgrade - old caches no longer match and regenerate on next `cryo vendor`.
///
/// 5 -> 6: provenance now folds the full transitive `#include` graph (recorded
/// in a `<bindings>.cryo.deps` sidecar) instead of the entry header alone.  The
/// bump forces one regeneration per cached lib so every existing cache gains a
/// depfile and the transitive-edit protection takes effect immediately rather
/// than only after the next unrelated change.
/// 6 -> 7: two robustness fixes surfaced by SDL2 - (a) duplicate-valued C enum
/// constants (deliberate aliases, e.g. SDL's `KMOD_RESERVED == KMOD_SCROLL`) are
/// diverted from clashing enum variants to namespaced alias `const`s (a Cryo
/// `type enum` requires unique discriminants); (b) a pointer to a system-header
/// record (e.g. `FILE` == `struct _iobuf`) maps to opaque `void*` instead of a
/// dangling named reference to the filtered-out tag.
/// 7 -> 8: a top-level named C `union` now emits a native `type union` (one field
/// per member, direct `v.field` access) instead of a `![repr(C)]` struct with a
/// `_storage` blob and synthesized reinterpret get/set accessors.  ABI is
/// unchanged; the field-access surface changes, so cached bindings regenerate.
/// 8 -> 9: two fixes surfaced by SQLite, both ways a generated module could
/// reference an unnameable type and fail to compile. (a) A function taking a C
/// `va_list` (canonicalized to the builtin `__va_list_tag[1]`, e.g. sqlite3's
/// `*_vappendf`) is dropped with a report entry. (b) A field whose type is a
/// (pointer to a) record declared NESTED inside another record (e.g.
/// `sqlite3_index_constraint_usage` inside `sqlite3_index_info`) - never emitted
/// top-level - now falls back to opaque `void*`/blob like a system-header record.
/// 9 -> 10: a C `va_list` parameter now maps to the first-class `va_list` type
/// (which lowers to a pointer) instead of being skipped - so `*_vappendf`-style
/// functions BIND and are callable by forwarding a Cryo variadic function's
/// `args`.  The earlier skip+report is gone.
/// 15 -> 16: a tag declared but never defined in the translation unit (an
/// `typedef union _XEvent XEvent;` whose union is completed only on another
/// platform) now binds as a zero-field opaque record instead of being dropped.
/// Dropping it emitted a typedef, parameter and return type naming a record that
/// was never declared, so the generated module did not compile.
/// 16 -> 17: object-like macro constants are recovered two ways they were lost.
/// (a) The macro filter now accepts any header the library included, not the
/// entry file alone - an umbrella entry header (`#include <SDL3/SDL.h>`) defines
/// almost nothing itself, so every constant one level down was invisible AND
/// unreported.  (b) A body no token walk can fold - a macro invocation such as
/// `SDL_UINT32_C(0x20)`, the portable way to pin a constant's width - is folded
/// by clang and bound to its value.
/// 17 -> 18: `extern` C globals bind.  A header's file-scope variables produced
/// nothing at all before - not even a report line - which rules out every
/// loader-shaped C API (volk and its kind expose each entry point as a global
/// function pointer, not a prototype).
/// 18 -> 19: a `static const` global binds as a VALUE const.  It is not a
/// symbol - each translation unit gets its own copy - but it is how a C API
/// states a constant too wide for an enum, which is what Vulkan's 64-bit flag
/// bits are; 309 of them were reported unbound in a vulkan_core.h run.
/// 19 -> 20: a C pointer to `const` binds as a read-only pointer at that
/// level, a read-only level above another pointer grouped: `const char*
/// const*` is `const (const i8*)*`.
/// 20 -> 21: every other C pointer level binds as a writable pointer spelled
/// `mut`: `char**` is `mut (mut i8*)*`.
const GENERATOR_VERSION: i64 = 21;

/// Renders bindgen-emitted AST decls to `.cryo` source under `namespace ns`.
type struct BindingSerializer {
    ctx:   CompilationContext*;
    /// Borrowed output buffer (owned by `render`'s caller frame), so the
    /// serializer struct owns no droppable field and can be discarded freely.
    out:   mut String*;
    /// Borrowed honesty-report accumulator, or null when the caller wants no
    /// report.  A decl the importer bound and this serializer then failed to
    /// write has no later trace at all - the use site fails with `cannot find
    /// value` and nothing connects that to generation - so the drop is counted
    /// here rather than being taken in silence.
    report: mut ImportReport*;

    /// Render the full binding file for `root` (top-level type decls) plus
    /// `extern_node` (the C functions) under `namespace ns`.
    static render(ctx: CompilationContext*, ns: string,
                  root: ProgramNode*, extern_node: ExternBlock*,
                  report: mut ImportReport*) -> String {
        mut text: String = String::new();
        mut s: BindingSerializer = BindingSerializer {
            ctx: ctx, out: &text, report: report,
        };
        s.out.push("/// Auto-generated by `cryo vendor` from C headers. DO NOT EDIT.\n");
        s.out.push(f"/// Regenerate with: cryo vendor rebuild {ns}\n\n");
        s.out.push(f"namespace {ns};\n\n");

        // Type declarations, in emission order, deduped by name (a type can be
        // visited once per header across a multi-header library).
        mut seen: [String] = [];
        mut ext_globals: [VarDecl*] = [];
        for (mut i: i64 = 0; i < root.statements.length(); i++) {
            const node: DeclarationNode* = root.statements[i].as_decl();
            if (node == null) { continue; }
            const name: String = BindingSerializer::decl_name(s.ctx, node);
            if (name.length() == 0 || BindingSerializer::contains(&seen, name.as_str())) { continue; }
            seen.push(name);
            // An imported global is a MEMBER of the `extern "C"` block rendered
            // below, not a standalone declaration.  Gathering it here rather
            // than in a second sweep lets it inherit this loop's dedup.
            if (DeclarationNode::var_of(node) != null
                    && (DeclarationNode::var_of(node)).is_extern_import) {
                ext_globals.push(DeclarationNode::var_of(node));
                continue;
            }
            s.render_decl(node);
        }

        // Extern functions, deduped by name.  A Cryo binding namespaces every
        // function under one flat `namespace`, and a single Cryo name binds a
        // single linker symbol - so a C++ OVERLOAD (`add(int)` + `add(double)`)
        // or a cross-namespace leaf-name COLLISION (`demo::twice` +
        // `demo::math::twice`) can only keep ONE.  Keep the first; for any later
        // same-name function whose linker symbol DIFFERS (a genuine distinct
        // function being lost, not a benign re-declaration of the same symbol),
        // record it in the honesty report instead of dropping it silently.
        if (extern_node.functions.length() > 0 || ext_globals.length() > 0) {
            mut seen_functions: [String] = [];
            mut seen_symbols:   [String] = [];   // parallel: kept symbol per seen name
            s.out.push("extern \"C\" {\n");
            for (mut gi: i64 = 0; gi < ext_globals.length(); gi++) {
                s.render_extern_global(ext_globals[gi]);
            }
            for (mut i: i64 = 0; i < extern_node.functions.length(); i++) {
                const fnode_decl: DeclarationNode* = extern_node.functions[i];
                const fnode: FunctionDecl* = DeclarationNode::fn_of(fnode_decl);
                const function_name: string = s.ctx.intern_table.resolve(fnode.name);
                const symbol: string = if (fnode.has_link_name) { fnode.link_name } else { function_name };
                mut duplicate_at: i64 = -1;
                for (mut k: i64 = 0; k < seen_functions.length(); k++) {
                    if (seen_functions[k].as_str() == Str::new(function_name)) { duplicate_at = k; break; }
                }
                if (duplicate_at >= 0) {
                    if (seen_symbols[duplicate_at].as_str() != Str::new(symbol)) {
                        // A genuinely distinct function under a colliding leaf name
                        // (a C++ overload, or a cross-namespace leaf clash): bind it
                        // under a numeric-suffixed alias with its true linker symbol
                        // pinned, rather than dropping it.  The alias is chosen to
                        // not shadow a name already emitted; a third+ collider gets
                        // the next free suffix.  Reported as reduced-fidelity so the
                        // caller learns the name to call.
                        mut suffix: i64 = 2;
                        mut alias: String = f"{function_name}_{suffix}";
                        while (BindingSerializer::contains(&seen_functions, alias.as_str())) {
                            suffix += 1;
                            alias = f"{function_name}_{suffix}";
                        }
                        s.render_function_named(fnode_decl, alias.as_str(), Str::new(symbol));
                        if (report != null) {
                            report.approx(f"function `{function_name}` renamed to `{alias}` (C++ overload or cross-namespace leaf collision; binds `{symbol}`)");
                        }
                        seen_functions.push(alias);
                        seen_symbols.push(String::from_string(symbol));
                    }
                    continue;
                }
                seen_functions.push(String::from_string(function_name));
                seen_symbols.push(String::from_string(symbol));
                s.render_function(fnode_decl);
            }
            s.out.push("}\n");
        }
        return text;
    }

    /// The declared name of a top-level decl node (for dedup), or empty.
    static decl_name(ctx: CompilationContext*, node: DeclarationNode*) -> String {
        if (DeclarationNode::struct_of(node) != null) {
            return String::from_string(ctx.intern_table.resolve((DeclarationNode::struct_of(node)).name));
        } else if (DeclarationNode::union_of(node) != null) {
            return String::from_string(ctx.intern_table.resolve(DeclarationNode::union_of(node).name));
        } else if (DeclarationNode::enum_of(node) != null) {
            return String::from_string(ctx.intern_table.resolve(DeclarationNode::enum_of(node).name));
        } else if (DeclarationNode::alias_of(node) != null) {
            return String::from_string(ctx.intern_table.resolve(DeclarationNode::alias_of(node).alias_name));
        } else if (DeclarationNode::var_of(node) != null) {
            return String::from_string(ctx.intern_table.resolve((DeclarationNode::var_of(node)).name));
        } else if (DeclarationNode::fn_of(node) != null) {
            return String::from_string(ctx.intern_table.resolve(DeclarationNode::fn_of(node).name));
        } else if (DeclarationNode::impl_of(node) != null) {
            // A synthetic key so an impl block isn't dropped by the empty-name
            // skip, and so a class re-visited across headers dedups by target.
            return f"impl:{ctx.intern_table.resolve((DeclarationNode::impl_of(node)).target_type)}";
        }
        return String::new();
    }

    render_decl(mut &this, node: DeclarationNode*) -> void {
        if (DeclarationNode::struct_of(node) != null) {
            this.render_struct(DeclarationNode::struct_of(node));
        } else if (DeclarationNode::union_of(node) != null) {
            this.render_union(DeclarationNode::union_of(node));
        } else if (DeclarationNode::enum_of(node) != null) {
            this.render_enum(DeclarationNode::enum_of(node));
        } else if (DeclarationNode::alias_of(node) != null) {
            this.render_alias(DeclarationNode::alias_of(node));
        } else if (DeclarationNode::var_of(node) != null) {
            this.render_const(DeclarationNode::var_of(node));
        } else if (DeclarationNode::fn_of(node) != null) {
            // A bodied top-level function in `root.statements` is a function-alias
            // forwarding wrapper (the extern prototypes live in `extern_node`).
            this.render_wrapper_function(node);
        } else if (DeclarationNode::impl_of(node) != null) {
            // A C++ class's bound methods (direct mangled binding).
            this.render_impl(DeclarationNode::impl_of(node));
        }
    }

    render_struct(mut &this, node: StructDecl*) -> void {
        if (node.repr_c) { this.out.push("![repr(C)]\n"); }
        if (node.min_alignment > 0) {
            this.out.push(f"![align({node.min_alignment})]\n");
        }
        this.out.push(f"type struct {BindingSerializer::ident(this.ctx.intern_table.resolve(node.name))} {{\n");
        this.render_fields(&node.fields);
        // Synthesized blob accessors (union reinterpret / bitfield shift-mask)
        // restore the field access the opaque-blob lowering drops.
        for (mut i: i64 = 0; i < node.binding_accessors.length(); i++) {
            this.render_accessor(node.binding_accessors[i]);
        }
        this.out.push("}\n\n");
    }

    /// Render a native `type union` (untagged C union): one field per member, all
    /// overlaid at offset 0.  No synthesized accessors - members are accessed
    /// directly (`v.field`); a literal initializes exactly one member.
    render_union(mut &this, node: UnionDecl*) -> void {
        if (node.repr_c) { this.out.push("![repr(C)]\n"); }
        if (node.min_alignment > 0) {
            this.out.push(f"![align({node.min_alignment})]\n");
        }
        this.out.push(f"type union {BindingSerializer::ident(this.ctx.intern_table.resolve(node.name))} {{\n");
        this.render_fields(&node.fields);
        this.out.push("}\n\n");
    }

    /// Render a struct's or union's fields, one `    name: Type;` line each.
    render_fields(mut &this, fields: &[DeclarationNode*]) -> void {
        for (mut i: i64 = 0; i < fields.length(); i++) {
            const field: FieldDecl* = DeclarationNode::field_of(fields[i]);
            this.out.push(f"    {BindingSerializer::ident(this.ctx.intern_table.resolve(field.name))}: {this.render_type(field.type_annotation)};\n");
        }
    }

    /// Render one synthesized blob accessor method.  Union accessors reinterpret
    /// the blob's address as the member type; bitfield accessors shift/mask over
    /// the blob's backing integer.  Bit offsets/masks/shifts carry the backing
    /// suffix so the literals type-check against the reinterpreted integer.
    render_accessor(mut &this, acc: BindingAccessor) -> void {
        const name: String = BindingSerializer::ident(this.ctx.intern_table.resolve(acc.name));
        const blob: String = BindingSerializer::ident(this.ctx.intern_table.resolve(acc.blob_field));
        const value_type: String = this.render_type(acc.value_type);
        const k: i32 = acc.kind;

        if (k == BindingAccessor::KIND_UNION_GET() || k == BindingAccessor::KIND_UNION_SET()) {
            // The reinterpreted lvalue: at offset 0 a direct cast of the blob's
            // address; at a non-zero (anon-struct) offset, a byte-pointer add.
            const lvalue: String = if (acc.byte_offset == 0) {
                f"*((&this.{blob}) as {value_type}*)"
            } else {
                f"*((((&this.{blob}) as u8*) + {acc.byte_offset}) as {value_type}*)"
            };
            if (k == BindingAccessor::KIND_UNION_GET()) {
                this.out.push(f"    {name}(&this) -> {value_type} {{ return {lvalue}; }}\n");
            } else {
                this.out.push(f"    {name}(mut &this, v: {value_type}) -> void {{ {lvalue} = v; }}\n");
            }
        } else if (k == BindingAccessor::KIND_BITFIELD_GET()) {
            const backing: string = acc.backing;
            // The backing-typed read of the blob.
            const read: String = f"*((&this.{blob}) as {backing}*)";
            if (acc.is_signed) {
                // Sign-extend via shifts: move the field's MSB to the backing's
                // top bit, then arithmetic-right-shift back down.
                const signed_type: string = BindingSerializer::signed_backing(backing);
                const bits: i64 = BindingSerializer::backing_bits(backing);
                const left: i64 = bits - acc.bit_offset - acc.bit_width;
                const right: i64 = bits - acc.bit_width;
                this.out.push(f"    {name}(&this) -> {value_type} {{ return ((({read} as {signed_type}) << {left}{backing}) >> {right}{backing}) as {value_type}; }}\n");
            } else {
                const mask: u64 = BindingSerializer::bit_mask(acc.bit_width);
                this.out.push(f"    {name}(&this) -> {value_type} {{ return (({read} >> {acc.bit_offset}{backing}) & {mask}{backing}) as {value_type}; }}\n");
            }
        } else if (k == BindingAccessor::KIND_BITFIELD_SET()) {
            const backing: string = acc.backing;
            const mask: u64 = BindingSerializer::bit_mask(acc.bit_width);
            // *ptr = (*ptr & ~(mask << off)) | ((v as B & mask) << off)
            this.out.push(f"    {name}(mut &this, v: {value_type}) -> void {{ mut p: {backing}* = (&this.{blob}) as {backing}*; *p = (*p & ~({mask}{backing} << {acc.bit_offset}{backing})) | (((v as {backing}) & {mask}{backing}) << {acc.bit_offset}{backing}); }}\n");
        }
    }

    /// `(1 << width) - 1` as a u64 mask (width is 1..64; clamps a full-width
    /// 64-bit field to avoid an undefined `1 << 64`).
    static bit_mask(width: i64) -> u64 {
        if (width >= 64) { return 0xFFFFFFFFFFFFFFFF; }
        return (1 << (width as u64)) - 1;
    }

    /// The signed sibling of an unsigned backing type name (`u32` -> `i32`),
    /// for the signed-bitfield sign-extension read.
    static signed_backing(b: string) -> string {
        if (b.eq("u8"))  { return "i8"; }
        if (b.eq("u16")) { return "i16"; }
        if (b.eq("u32")) { return "i32"; }
        return "i64";
    }

    /// The bit width of a backing type name (`u32` -> 32).
    static backing_bits(b: string) -> i64 {
        if (b.eq("u8"))  { return 8; }
        if (b.eq("u16")) { return 16; }
        if (b.eq("u32")) { return 32; }
        return 64;
    }

    render_enum(mut &this, node: EnumDecl*) -> void {
        if (node.repr_c) { this.out.push("![repr(C)]\n"); }
        // `render_type` writes `void` for a null annotation, so the default
        // discriminant is spelled here.
        const discriminant: String = if (node.discriminant_annotation != null) {
            this.render_type(node.discriminant_annotation)
        } else {
            String::from_string("i32")
        };
        this.out.push(f"type enum {BindingSerializer::ident(this.ctx.intern_table.resolve(node.name))} : {discriminant} {{\n");
        for (mut i: i64 = 0; i < node.variants.length(); i++) {
            const v: EnumVariant* = DeclarationNode::variant_of(node.variants[i]);
            const variant_name: String = BindingSerializer::ident(this.ctx.intern_table.resolve(v.name));
            if (v.has_value) {
                this.out.push(f"    {variant_name} = {v.explicit_value};\n");
            } else {
                this.out.push(f"    {variant_name};\n");
            }
        }
        this.out.push("}\n\n");
    }

    render_alias(mut &this, node: TypeAliasDecl*) -> void {
        this.out.push(f"type {BindingSerializer::ident(this.ctx.intern_table.resolve(node.alias_name))} = {this.render_type(node.target_annotation)};\n\n");
    }

    /// Render an imported global as a member of the `extern "C"` block:
    /// `    mut vkCreateInstance: (void*) -> i32;`.  A C name that collides with
    /// a Cryo keyword is escaped by `ident()`, which would otherwise silently
    /// change the symbol bound - so whenever escaping changed the spelling, the
    /// original C name is pinned with `![symbol("...")]`.  `link_name` (set on
    /// the C++ path, where every symbol is mangled) takes precedence.
    render_extern_global(mut &this, node: VarDecl*) -> void {
        const raw: string = this.ctx.intern_table.resolve(node.name);
        const name: String = BindingSerializer::ident(raw);
        const symbol: string = if (node.link_name.length() > 0) { node.link_name } else { raw };
        if (name.as_str() != Str::new(symbol)) {
            this.out.push(f"    ![symbol(\"{BindingSerializer::escape(symbol)}\")]\n");
        }
        const keyword: string = if (node.is_mutable) { "mut" } else { "const" };
        this.out.push(f"    {keyword} {name}: {this.render_type(node.type_annotation)};\n");
    }

    render_const(mut &this, node: VarDecl*) -> void {
        const type_text: String = this.render_type(node.type_annotation);
        const name: String =
            BindingSerializer::ident(this.ctx.intern_table.resolve(node.name));
        mut init: ExpressionNode* = node.initializer;
        if (init == null) {
            this.skip_const(name.as_str(), "no initializer");
            return;
        }
        // A struct-literal initializer (a C compound-literal macro the importer
        // lowered, e.g. `#define RAYWHITE CLITERAL(Color){...}`): render
        // `const NAME: Type = Type { field: value, ... };`.
        const init_struct: StructExpr* = ExpressionNode::struct_of(init);
        if (init_struct != null) {
            this.render_struct_const(node, type_text.as_str(), init_struct);
            return;
        }
        // An INTEGER initializer arrives wrapped in a cast to the const's own
        // declared type, because the importer carries a negative C value as its
        // unsigned two's-complement decimal and that is out of range for the
        // declaration as a bare literal.  Source text needs the same cast, and
        // the integer branch below writes one - so read through the wrapper to
        // the literal it holds rather than treating the shape as unrenderable.
        const init_cast: CastExpr* = ExpressionNode::cast_of(init);
        if (init_cast != null) {
            init = init_cast.expression;
            if (init == null) {
                this.skip_const(name.as_str(), "cast over an empty initializer");
                return;
            }
        }
        const lit: LiteralExpr* = ExpressionNode::literal_of(init);
        if (lit == null) {
            this.skip_const(name.as_str(), "initializer is not a literal");
            return;
        }
        if (lit.literal_kind == LiteralKind::String) {
            this.out.push(f"const {name}: {type_text} = \"{BindingSerializer::escape(lit.value)}\";\n");
        } else if (lit.literal_kind == LiteralKind::Float) {
            this.out.push(f"const {name}: {type_text} = {lit.value};\n");
        } else {
            // Integer (and char, stored as its integer code point): an explicit
            // cast keeps the source in range - the importer stores a negative C
            // value as its unsigned two's-complement decimal, which would
            // overflow the declared signed type as a bare literal.
            this.out.push(f"const {name}: {type_text} = {lit.value} as {type_text};\n");
        }
    }

    /// Record a const that bound during import but could not be written as
    /// source.  Nothing downstream can observe the difference between a
    /// constant the header never had and one dropped here, so it belongs in
    /// the same honesty channel as a construct the importer refused.
    skip_const(mut &this, name: Str, why: string) -> void {
        if (this.report == null) { return; }
        this.report.skip(f"const '{name}' ({why})");
    }

    /// Render a struct-literal global const (`const NAME: Type = Type { ... };`).
    /// Field initializers are numeric literals in struct-declaration order (the
    /// importer emits them that way); names are keyword-escaped like every other
    /// emitted identifier.
    render_struct_const(mut &this, node: VarDecl*, type_text: Str, literal: StructExpr*) -> void {
        this.out.push(f"const {BindingSerializer::ident(this.ctx.intern_table.resolve(node.name))}: {type_text} = {type_text} {{");
        for (mut i: i64 = 0; i < literal.field_inits.length(); i++) {
            const field: FieldInit = literal.field_inits[i];
            if (i > 0) { this.out.push(","); }
            this.out.push(f" {BindingSerializer::ident(this.ctx.intern_table.resolve(field.field_name))}: {BindingSerializer::render_const_scalar(field.value)}");
        }
        this.out.push(" };\n\n");
    }

    /// Render a numeric-literal field/operand value to Cryo source (the bare
    /// literal text; non-literals fall back to `0`, which the importer never
    /// emits here).
    static render_const_scalar(expr: ExpressionNode*) -> string {
        const lit: LiteralExpr* = ExpressionNode::literal_of(expr);
        if (lit == null) { return "0"; }
        return lit.value;
    }

    render_function(mut &this, node_decl: DeclarationNode*) -> void {
        const node: FunctionDecl* = DeclarationNode::fn_of(node_decl);
        // C++ free/namespace function: pin its mangled linker symbol.  C
        // functions have no link override, so `sym` is empty for them.
        const name: string = this.ctx.intern_table.resolve(node.name);
        const symbol: string = if (node.has_link_name) { node.link_name } else { "" };
        this.render_function_named(node_decl, Str::new(name), Str::new(symbol));
    }

    /// Emit an extern `function` prototype for `node` under `display_name`,
    /// pinning `symbol` as its linker name when non-empty.  Shared by the 1:1
    /// emit and the collision disambiguator, which renders a distinct same-leaf
    /// overload under a suffixed alias with its true (mangled or bare-C) symbol
    /// pinned.
    render_function_named(mut &this, node_decl: DeclarationNode*,
                          display_name: Str, symbol: Str) -> void {
        const node: FunctionDecl* = DeclarationNode::fn_of(node_decl);
        if (symbol.length() > 0) {
            this.out.push(f"    ![symbol(\"{symbol}\")]\n");
        }
        this.out.push(f"    function {display_name}(");
        for (mut i: i64 = 0; i < node.parameters.length(); i++) {
            if (i > 0) { this.out.push(", "); }
            const p: VarDecl* = DeclarationNode::var_of(node.parameters[i]);
            this.out.push(f"{BindingSerializer::parameter_name(this.ctx.intern_table.resolve(p.name), i)}: {this.render_type(p.type_annotation)}");
        }
        if (node.is_variadic) {
            if (node.parameters.length() > 0) { this.out.push(", ..."); }
            else { this.out.push("..."); }
        }
        this.out.push(f") -> {this.render_type(node.return_type_annotation)};\n");
    }

    /// Render a function-alias forwarding wrapper (a bodied top-level function):
    /// `function NAME(p0: T0, ...) -> Ret { return TARGET(p0, ...); }`.  The body is
    /// a single statement the importer built - a `return TARGET(args)` (or, for a
    /// `void` target, a bare `TARGET(args)`).  Top-level functions are public by
    /// default, so no modifier is emitted; the file's `namespace` qualifies it.
    render_wrapper_function(mut &this, node_decl: DeclarationNode*) -> void {
        const node: FunctionDecl* = DeclarationNode::fn_of(node_decl);
        // Signature (param names keyword-escaped, matching the call args below).
        this.out.push(f"function {this.ctx.intern_table.resolve(node.name)}(");
        for (mut i: i64 = 0; i < node.parameters.length(); i++) {
            if (i > 0) { this.out.push(", "); }
            const p: VarDecl* = DeclarationNode::var_of(node.parameters[i]);
            this.out.push(f"{BindingSerializer::ident(this.ctx.intern_table.resolve(p.name))}: {this.render_type(p.type_annotation)}");
        }
        this.out.push(f") -> {this.render_type(node.return_type_annotation)} {{\n");

        // Body: extract the forwarded call (return-of-call, or a void call);
        // the importer builds a forwarding body as nothing else.
        const st: Stmt* = node.body.as_block().statements[0];
        mut is_ret: boolean = false;
        const call: CallExpr* = match (st.kind) {
            StmtKind::Return(r) => {
                is_ret = true;
                ExpressionNode::call_of(r.expression)
            }
            StmtKind::Expr(e) => { ExpressionNode::call_of(e.expression) }
            _ => { unreachable() }
        };
        const target: string =
            this.ctx.intern_table.resolve(ExpressionNode::identifier_of(call.callee).name);

        this.out.push(if (is_ret) { "    return " } else { "    " });
        this.out.push(f"{target}(");
        for (mut i: i64 = 0; i < node.parameters.length(); i++) {
            if (i > 0) { this.out.push(", "); }
            this.out.push(BindingSerializer::ident(this.ctx.intern_table.resolve(
                DeclarationNode::var_of(node.parameters[i]).name)));
        }
        this.out.push(");\n}\n\n");
    }

    /// Render a C++ class's `implement` block: each bound method as a body-less
    /// declaration pinned to its mangled symbol with `![symbol]`.  The receiver
    /// (`&this` / `mut &this`) is the method's first parameter for an instance
    /// method (encoded by the importer); a static method has none.
    render_impl(mut &this, node: ImplBlock*) -> void {
        this.out.push(f"implement {BindingSerializer::ident(this.ctx.intern_table.resolve(node.target_type))} {{\n");
        for (mut i: i64 = 0; i < node.methods.length(); i++) {
            this.render_method(node.methods[i]);
        }
        this.out.push("}\n\n");
    }

    /// Render one bound C++ method: `![symbol("sym")] public [static] name(recv, params) -> Ret;`.
    render_method(mut &this, m_decl: DeclarationNode*) -> void {
        const m: MethodDecl* = DeclarationNode::method_of(m_decl);
        const func_decl: DeclarationNode* = m.func;
        const func: FunctionDecl* = DeclarationNode::fn_of(func_decl);
        if (func.has_link_name) {
            this.out.push(f"    ![symbol(\"{func.link_name}\")]\n");
        }
        this.out.push("    public ");
        if (m.is_static) { this.out.push("static "); }
        this.out.push(f"{BindingSerializer::ident(this.ctx.intern_table.resolve(func.name))}(");
        // For an instance method the first parameter is the synthetic receiver
        // (its NAME is the literal `&this`/`mut &this` token, type_annotation
        // null) - rendered verbatim, not as `name: type`.
        mut first: boolean = true;
        for (mut i: i64 = 0; i < func.parameters.length(); i++) {
            const p: VarDecl* = DeclarationNode::var_of(func.parameters[i]);
            if (!first) { this.out.push(", "); }
            first = false;
            if (i == 0 && !m.is_static && p.type_annotation == null) {
                this.out.push(this.ctx.intern_table.resolve(p.name));   // `&this` / `mut &this`
            } else {
                this.out.push(f"{BindingSerializer::parameter_name(this.ctx.intern_table.resolve(p.name), i)}: {this.render_type(p.type_annotation)}");
            }
        }
        if (func.is_variadic) {
            if (!first) { this.out.push(", "); }
            this.out.push("...");
        }
        this.out.push(f") -> {this.render_type(func.return_type_annotation)};\n");
    }

    /// Render a TypeAnnotation tree to Cryo type syntax.
    render_type(&this, ann: TypeAnnotation*) -> String {
        if (ann == null) { return String::from_string("void"); }
        match (*ann) {
            TypeAnnotation::Primitive(p) => {
                return String::from_string(this.ctx.intern_table.resolve(p.name));
            }
            TypeAnnotation::Pointer(p) => {
                // A C pointer to `const` is a read-only pointer at that level,
                // and any other a writable one.  An ungrouped mark binds to
                // the innermost pointer of a run, so a level above another
                // pointer groups it: `char**` is `mut (mut i8*)*`, and
                // `const char* const*` is `const (const i8*)*`.
                const pointee: String = this.render_type(p.inner);
                const mark: string = if (p.is_const) { "const " } else { "mut " };
                const grouped: boolean = p.inner != null && match (*p.inner) {
                    TypeAnnotation::Pointer(_) => { true }
                    _                          => { false }
                };
                if (grouped) { return f"{mark}({pointee})*"; }
                return f"{mark}{pointee}*";
            }
            TypeAnnotation::Named(n) => {
                // The importer qualified this as `<ns>::Tag`; strip back to the
                // bare tag since it lives under this file's namespace.  Apply the
                // same keyword-escape as the decl site so a reference to a
                // keyword-named type stays consistent.
                return BindingSerializer::ident(QualifiedName::leaf_of(
                    this.ctx.intern_table.resolve(n.name)));
            }
            TypeAnnotation::Array(a) => {
                return f"[{this.render_type(a.element)}; {a.size}]";
            }
            TypeAnnotation::Function(function_annotation) => {
                mut text: String = String::from_string("(");
                for (mut i: i64 = 0; i < function_annotation.parameters.length(); i++) {
                    if (i > 0) { text.push(", "); }
                    text.push(this.render_type(function_annotation.parameters[i]));
                }
                text.push(") -> ");
                text.push(this.render_type(function_annotation.return_type));
                return text;
            }
            _ => { return String::from_string("void*"); }
        }
    }

    // ---- helpers ----

    /// Make a C identifier safe to emit as a Cryo identifier: a C name that is
    /// a Cryo keyword (`type`, `in`, `new`, `string`, ...) is suffixed with `_`
    /// so the binding parses (raylib's `AutomationEvent.type`, for instance).
    /// Layout/ABI is positional, so renaming a field/param/variant is harmless;
    /// the consumer simply uses the suffixed name.  Reuses the lexer's own
    /// keyword table (single source of truth) so it can never drift.
    static ident(name: string) -> String {
        if (TokenType::from_keyword(Keyword::new(name)) != TokenType::Unknown) {
            return f"{name}_";
        }
        return String::from_string(name);
    }

    /// A parameter's emitted name: the keyword-escaped C name, or `arg<index>`
    /// for a parameter the header left unnamed.
    static parameter_name(name: string, index: i64) -> String {
        if (name.length() == 0) { return f"arg{index}"; }
        return BindingSerializer::ident(name);
    }

    static contains(list: &[String], text: Str) -> boolean {
        for (mut i: i64 = 0; i < list.length(); i++) {
            if (list[i].as_str() == text) { return true; }
        }
        return false;
    }

    /// Escape a decoded byte string for embedding in a Cryo `"..."` literal.
    static escape(text: string) -> String {
        const length: i64 = text.length();
        mut out: String = String::new();
        for (mut i: i64 = 0; i < length; i++) {
            const c: char = text[i];
            if (c == '"')       { out.push("\\\""); }
            else if (c == '\\') { out.push("\\\\"); }
            else if (c == '\n') { out.push("\\n"); }
            else if (c == '\r') { out.push("\\r"); }
            else if (c == '\t') { out.push("\\t"); }
            else                { out.push_byte(c as u8); }
        }
        return out;
    }
}

/// Drives binding generation for a vendored library.
type struct VendorGenerator {
    /// Generate `.cryo` binding source for the library namespaced `ns`, parsing
    /// each `headers` entry (resolved against `source_path` and `include_dirs`)
    /// with the manifest's include dirs and defines on the clang command line.
    /// Returns the source text, or an empty `String` if no header could be
    /// parsed.
    ///
    /// `out_inputs` (when non-null) is filled with the de-duplicated set of files
    /// that fed the bindings - each resolved entry header plus every non-system
    /// file reached transitively via `#include` - so the caller can write a
    /// `<bindings>.cryo.deps` sidecar that `provenance_key` folds on the next
    /// cache check (catching edits to transitively-included headers).
    static generate(ns: string, source_path: string, headers: &[string],
                    include_dirs: &[string], defines: &[string],
                    out_inputs: mut [string]*, language: string, cpp_std: string) -> String {
        mut ctx: CompilationContext = CompilationContext::new(
            BuildOptions::defaults(CompileMode::SingleFile), "<vendor-bindgen>", null);
        // The importer pushes top-level type decls into the AST root; give it a
        // fresh program node to collect into.
        mut root: mut ProgramNode* = ProgramNode::new(SourceSpan::none());
        ctx.artifacts.ast.root = root;

        // One shared extern block carries the C functions; its module is the
        // vendor namespace, so emitted type references qualify under it.  The
        // type mapper names a record or enum only under a module: without one
        // every by-value record would be written `void*`, a different type
        // and a different calling convention from the C declaration's.
        const alias_sym: SymbolStr = ctx.intern_table.intern(ns);
        const extern_node: mut ExternBlock* = ExternBlock::new("C");
        extern_node.set_namespace_alias(alias_sym);
        extern_node.binding_namespace = ctx.module_graph.register_c_import_module(alias_sym);

        // Build the shared clang args: `-I<abs include dir>` and `-D<define>`.
        // libclang reads them as C strings during every parse below, so the
        // Strings are held for the whole function and lent to `extra` only
        // once the list is complete.
        mut arguments: [String] = [];
        for (mut i: i64 = 0; i < include_dirs.length(); i++) {
            arguments.push(f"-I{Path::from(source_path).join(include_dirs[i]).as_path().as_str()}");
        }
        for (mut i: i64 = 0; i < defines.length(); i++) {
            arguments.push(f"-D{defines[i]}");
        }
        mut extra: [u8*] = [];
        for (mut i: i64 = 0; i < arguments.length(); i++) {
            extra.push(arguments[i].as_cstr());
        }

        // Accumulate every header's skipped/approximated constructs so the
        // honesty report is printed once, to stdout, after generation.
        mut report: ImportReport = ImportReport::new();
        mut parsed: i32 = 0;
        for (mut i: i64 = 0; i < headers.length(); i++) {
            const hp: string = VendorGenerator::resolve_header(
                source_path, include_dirs, headers[i]);
            if (hp.length() == 0) {
                fmt::eprintf("warning: vendor header '%s' not found under %s\n",
                    headers[i], source_path);
                continue;
            }
            // `collect_from_tu` records the entry header and its transitive
            // non-system includes on `ctx`, each once.
            Importer::collect_from_tu(hp as u8*, null, 0, &extra, hp,
                                      extern_node, false, &ctx, &report,
                                      language, cpp_std);
            parsed = parsed + 1;
        }
        if (parsed == 0) { return String::new(); }
        if (out_inputs != null) {
            for (mut i: i64 = 0; i < ctx.imported_headers.length(); i++) { out_inputs.push(ctx.imported_headers[i]); }
        }

        // `render` reports any C++ overload / cross-namespace leaf-name
        // collision it has to drop (one Cryo name can bind only one symbol),
        // so the summary must print AFTER it, not before.
        const out: String = BindingSerializer::render(&ctx, ns, root, extern_node, &report);
        report.summary_stdout(ns);
        return out;
    }

    /// The libclang version banner (e.g. "clang version 20.1.0"), or "" when
    /// unavailable.  Folded into the provenance key so a toolchain upgrade
    /// invalidates the cache.  The CXString's C buffer is interned (copied) so
    /// the returned `string` outlives the disposed CXString.
    static clang_version() -> string {
        const s: CXString = clang::clang_getClangVersion();
        const cstr: u8* = clang::clang_getCString(s);
        mut out: string = "";
        if (cstr != null) { out = String::from_string(cstr as string).into_raw(); }
        clang::clang_disposeString(s);
        return out;
    }

    /// The cache provenance key: a hex FNV-1a digest folding the bytes
    /// of the binding's input files, the manifest's `include_dirs` and `defines`
    /// (the `-I`/`-D` parse args - same headers under different args bind
    /// differently), the (already-normalized) target `triple`, the libclang
    /// version, and `GENERATOR_VERSION`.  A change in any of these regenerates;
    /// an unchanged set is a cache hit.  Reuses the build manifest's FNV-1a
    /// folding so the whole compiler hashes one way.
    ///
    /// `cache_file` is the path of the PREVIOUSLY generated `.cryo` (or "" on a
    /// fresh registration).  When its `<cache_file>.deps` include-graph sidecar
    /// exists, the key folds every file listed there - the entry headers AND
    /// their transitive `#include`s - so editing a deeply-included header
    /// invalidates the cache.  When no sidecar exists yet (a fresh register, or a
    /// cache written before this mechanism), it falls back to folding the entry
    /// headers alone; that fallback is byte-identical to the pre-sidecar key, so
    /// upgrading does not spuriously invalidate a cache whose `GENERATOR_VERSION`
    /// already matched (the version bump to 6 is what forces the one-time
    /// regeneration that installs the sidecar).
    static provenance_key(source_path_text: string, headers: &[string],
                          include_dirs: &[string], defines: &[string],
                          triple_text: string, cache_file_text: string, lang_text: string) -> string {
        const cache_file: string = cache_file_text;
        const lang: string = lang_text;
        const triple: string = triple_text;
        mut h: Fnv128Hasher = Fnv128Hasher::new();
        const depfile: String = if (cache_file.length() > 0) {
            f"{cache_file}.deps"
        } else {
            String::new()
        };
        if (depfile.length() > 0
                && Path::from(depfile.as_str()).exists()) {
            VendorGenerator::fold_depfile(&h, depfile.as_str());
        } else {
            // Fallback (fresh register / pre-sidecar cache): entry headers only.
            for (mut i: i64 = 0; i < headers.length(); i++) {
                const hp: string = VendorGenerator::resolve_header(
                    source_path_text, include_dirs, headers[i]);
                if (hp.length() == 0) {
                    // A missing header still perturbs the key (distinct marker +
                    // the requested name) so it can't masquerade as unchanged.
                    h.fold("<missing-header>");
                    h.fold(headers[i]);
                } else {
                    Manifest::fold_file(&h, Path::from(hp));
                }
            }
        }
        // Fold the manifest's own knobs, not just header *bytes*: the same
        // headers parsed under different `-I<dir>` / `-D<define>` args produce
        // different bindings, so editing `include_dirs` or `defines` (without
        // touching any header) MUST invalidate the cache.  Distinct markers
        // keep the two lists from aliasing each other, and the per-element
        // order is the manifest order (stable across regenerations).
        //
        // The entry-header LIST is one of those knobs, and folding the include
        // graph does not cover it: a header added to the manifest whose bytes
        // the graph never reached leaves the digest untouched, so the addition
        // reads as a cache hit and its declarations silently never appear.  It
        // decides which file is the MAIN file too, which is what governs macro
        // import.  The length is folded so that removing a header - or moving a
        // name boundary, `["a","b"]` against `["ab"]` - also misses.
        h.fold("<headers>");
        h.fold(headers.length() as u64);
        for (mut i: i64 = 0; i < headers.length(); i++) {
            h.fold(headers[i]);
        }
        h.fold("<include_dirs>");
        for (mut i: i64 = 0; i < include_dirs.length(); i++) {
            h.fold(include_dirs[i]);
        }
        h.fold("<defines>");
        for (mut i: i64 = 0; i < defines.length(); i++) {
            h.fold(defines[i]);
        }
        // The source language ("c" vs "c++") changes what libclang parses and
        // what the generator emits, so flipping it (without touching headers)
        // MUST invalidate the cache.  An empty/"c" lang folds the same marker so
        // existing C entries keep a stable key relative to each other.
        h.fold("<lang>");
        h.fold(if ((lang as string) == "c++") { "c++" } else { "c" });
        h.fold(triple);
        h.fold(VendorGenerator::clang_version());
        h.fold(GENERATOR_VERSION as u64);
        return Manifest::hex128(h.finish128());
    }

    /// Fold the bytes of every file listed in an include-graph depfile (one path
    /// per line, written by `write_depfile`) into the running digest `h`.  A
    /// listed file that has since been deleted perturbs the key with a distinct
    /// marker (so it can't masquerade as unchanged -> forces a regeneration that
    /// rebuilds the graph).  Blank lines are skipped.
    static fold_depfile(h: mut Fnv128Hasher*, depfile: Str) -> void {
        mut content: string = "";
        match (File::read_text(Path::from(depfile))) {
            Result::Ok(s)  => { content = s.into_raw(); }
            Result::Err(_) => { return; }
        }
        const len: i64 = content.length() as i64;
        mut i: i64 = 0;
        while (i < len) {
            const start: i64 = i;
            while (i < len && content[i] != 10) { i += 1; }   // 10 = '\n'
            mut end: i64 = i;
            // Trim a trailing '\r' (depfiles written on Windows / read on Unix).
            if (end > start && content[end - 1] == 13) { end -= 1; }   // 13 = '\r'
            if (end > start) {
                const path: string = content.substr(start, end - start);
                if (Path::from(path).exists()) {
                    Manifest::fold_file(h, Path::from(path));
                } else {
                    h.fold("<missing-include>");
                    h.fold(path);
                }
            }
            if (i < len) { i += 1; }   // skip '\n'
        }
        return;
    }

    /// Write the include-graph sidecar `<cryo_path>.deps`: one input file path
    /// per line, in the order `generate` accumulated them.  Best-effort - a
    /// write failure just means the next cache check falls back to the
    /// entry-header key (a possible spurious regeneration, never a stale cache).
    static write_depfile(cryo_path_text: string, inputs: &[string]) -> void {
        const depfile: String = f"{cryo_path_text}.deps";
        mut text: String = String::new();
        for (mut i: i64 = 0; i < inputs.length(); i++) {
            text.push(Str::new(inputs[i]));
            text.push_byte(10 as u8);    // LF
        }
        // Best-effort (see doc): a write failure just triggers a later
        // fallback cache key, never a stale cache.
        match (File::write_bytes(Path::from(depfile.as_str()), text.as_bytes())) {
            Result::Ok(_)  => {}
            Result::Err(_) => {}
        }
        mem::drop(text);
    }

    /// Resolve a manifest header name to an existing file: try each include dir
    /// under source_path, then source_path itself, then the name verbatim.
    static resolve_header(source_path_text: string, include_dirs: &[string],
                          header_text: string) -> string {
        const header: string = header_text;
        const source_path: string = source_path_text;
        for (mut i: i64 = 0; i < include_dirs.length(); i++) {
            const cand: string = Path::from(source_path).join(include_dirs[i]).join(header).into_raw();
            if (Path::from(cand).exists()) { return cand; }
        }
        const direct: string = Path::from(source_path).join(header).into_raw();
        if (Path::from(direct).exists()) { return direct; }
        if (Path::from(header).exists()) { return header; }
        return "";
    }
}
