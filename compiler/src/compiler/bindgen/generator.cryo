/// Vendor binding generator (libclang -> `.cryo` source text)
///
/// Stage 2 of the vendor library system (.todo/VENDOR_PLAN.md).  Drives the
/// existing libclang cursor-walk engine (`Importer`) to build the same decl
/// nodes the inline `extern module := "C"` path produces, then SERIALIZES them
/// back to `.cryo` SOURCE TEXT (approach A, the rust-bindgen model) under a
/// real `namespace <Name>;`.  `cryo vendor` writes that text to the per-triple
/// cache; it then flows through the unmodified parser -> sema -> codegen -> LSP
/// pipeline like any other module.
///
/// Two pieces:
///   • BindingSerializer — renders the struct / enum / typedef / global-const /
///     extern-function nodes (and their TypeAnnotation trees) to Cryo source.
///     The importer qualifies emitted type references under its alias namespace
///     (we pass the vendor namespace as that alias), so a `Color` field types as
///     `<Name>::Color`; the serializer strips the namespace prefix since every
///     emitted type already lives under the file's `namespace <Name>;`.
///   • VendorGenerator — builds one libclang TU per manifest header (with the
///     manifest's `-I<include_dir>` / `-D<define>` args), accumulates the decls
///     into a throwaway context, and returns the serialized source.

namespace Compiler::Bindgen::Generator;

import ffi::libc;
import Compiler::Bindgen::Importer;
import Compiler::Bindgen::Importer::{ ImportReport };
import Compiler::Bindgen::Clang;
import Compiler::Lex::{ TokenType };
import Compiler::Bindgen::Clang::{ CXString };
import Compiler::BuildManifest;
import Compiler::CompilationContext;
import Compiler::CompileMode;
import Compiler::AST;
import Compiler::AST::{ Node, Declaration };
import Compiler::AST::Expression;
import Compiler::AST::Statement;
import Compiler::Resolver::{ SymbolStr, InternTable };
import Compiler::Diag::{ SourceSpan };
import Utils::Logger;
import std::fs::metadata;
import std::fs::path;
import std::fs::file;
import std::fmt;
import std::core::primitives;
import std::collections::string;
import std::collections::str;

/// Bump whenever the emitted binding format changes (a new field shape, a
/// different type mapping, …).  It participates in the Stage-3 cache key, so an
/// increment invalidates every previously cached binding after a compiler
/// upgrade — old caches no longer match and regenerate on next `cryo vendor`.
///
/// 5 -> 6: provenance now folds the full transitive `#include` graph (recorded
/// in a `<bindings>.cryo.deps` sidecar) instead of the entry header alone.  The
/// bump forces one regeneration per cached lib so every existing cache gains a
/// depfile and the transitive-edit protection takes effect immediately rather
/// than only after the next unrelated change.
/// 6 -> 7: two robustness fixes surfaced by SDL2 — (a) duplicate-valued C enum
/// constants (deliberate aliases, e.g. SDL's `KMOD_RESERVED == KMOD_SCROLL`) are
/// diverted from clashing enum variants to namespaced alias `const`s (a Cryo
/// `type enum` requires unique discriminants); (b) a pointer to a system-header
/// record (e.g. `FILE` == `struct _iobuf`) maps to opaque `void*` instead of a
/// dangling named reference to the filtered-out tag.
/// 7 -> 8: a top-level named C `union` now emits a native `type union` (one field
/// per member, direct `v.field` access) instead of a `![repr(C)]` struct with a
/// `_storage` blob and synthesized reinterpret get/set accessors.  ABI is
/// unchanged; the field-access surface changes, so cached bindings regenerate.
const GENERATOR_VERSION: i64 = 8;

/// Renders bindgen-emitted AST decls to `.cryo` source under `namespace ns`.
type struct BindingSerializer {
    ctx:   CompilationContext*;
    /// The namespace the bindings live under (e.g. "RayLib"); also the alias
    /// the importer qualified type references with, so it is the prefix the
    /// serializer strips off Named annotations.
    ns:    string;
    /// Borrowed output buffer (owned by `render`'s caller frame), so the
    /// serializer struct owns no droppable field and can be discarded freely.
    out:   String*;

    /// Render the full binding file for `root` (top-level type decls) plus
    /// `extern_node` (the C functions) under `namespace ns`.
    static render(ctx: CompilationContext*, ns: string,
                  root: ProgramNode*, extern_node: ExternBlockNode*) -> string {
        mut buf: String = String::new();
        mut s: BindingSerializer = BindingSerializer {
            ctx: ctx, ns: ns, out: &buf,
        };
        s.out.push_cstr("/// Auto-generated by `cryo vendor` from C headers. DO NOT EDIT.\n");
        s.out.push_cstr(format("/// Regenerate with: cryo vendor rebuild %s\n\n", ns));
        s.out.push_cstr(format("namespace %s;\n\n", ns));

        // Type declarations, in emission order, deduped by name (a type can be
        // visited once per header across a multi-header library).
        mut seen: string[] = [];
        for (mut i: i64 = 0; i < root.statements.length; i++) {
            const node: ASTNode* = root.statements[i];
            if (node == null) { continue; }
            const nm: string = BindingSerializer::decl_name(s.ctx, node);
            if (libc::strlen(nm) == 0 || BindingSerializer::contains(&seen, nm)) { continue; }
            seen.push(nm);
            s.render_decl(node);
        }

        // Extern functions, deduped by name.
        if (extern_node.functions.length > 0) {
            mut seen_fn: string[] = [];
            s.out.push_cstr("extern \"C\" {\n");
            for (mut i: i64 = 0; i < extern_node.functions.length; i++) {
                const fnode: FunctionDeclNode* = extern_node.functions[i];
                const fnm: string = s.ctx.intern_table.resolve(fnode.name);
                if (BindingSerializer::contains(&seen_fn, fnm)) { continue; }
                seen_fn.push(fnm);
                s.render_function(fnode);
            }
            s.out.push_cstr("}\n");
        }
        return buf.into_raw();
    }

    /// The declared name of a top-level decl node (for dedup), or "".
    static decl_name(ctx: CompilationContext*, node: ASTNode*) -> string {
        const k: NodeKind = node.kind;
        if (k == NodeKind::StructDeclaration) {
            return ctx.intern_table.resolve((node as StructDeclNode*).name);
        } else if (k == NodeKind::UnionDeclaration) {
            return ctx.intern_table.resolve((node as UnionDeclNode*).name);
        } else if (k == NodeKind::EnumDeclaration) {
            return ctx.intern_table.resolve((node as EnumDeclNode*).name);
        } else if (k == NodeKind::TypeAliasDeclaration) {
            return ctx.intern_table.resolve((node as TypeAliasDeclNode*).alias_name);
        } else if (k == NodeKind::VariableDeclaration) {
            return ctx.intern_table.resolve((node as VarDeclNode*).name);
        } else if (k == NodeKind::FunctionDeclaration) {
            return ctx.intern_table.resolve((node as FunctionDeclNode*).name);
        }
        return "";
    }

    render_decl(mut &this, node: ASTNode*) -> void {
        const k: NodeKind = node.kind;
        if (k == NodeKind::StructDeclaration) {
            this.render_struct(node as StructDeclNode*);
        } else if (k == NodeKind::UnionDeclaration) {
            this.render_union(node as UnionDeclNode*);
        } else if (k == NodeKind::EnumDeclaration) {
            this.render_enum(node as EnumDeclNode*);
        } else if (k == NodeKind::TypeAliasDeclaration) {
            this.render_alias(node as TypeAliasDeclNode*);
        } else if (k == NodeKind::VariableDeclaration) {
            this.render_const(node as VarDeclNode*);
        } else if (k == NodeKind::FunctionDeclaration) {
            // A bodied top-level function in `root.statements` is a function-alias
            // forwarding wrapper (the extern prototypes live in `extern_node`).
            this.render_wrapper_function(node as FunctionDeclNode*);
        }
    }

    render_struct(mut &this, node: StructDeclNode*) -> void {
        if (node.repr_c) { this.out.push_cstr("![repr(C)]\n"); }
        if (node.min_alignment > 0) {
            this.out.push_cstr(format("![align(%llu)]\n", node.min_alignment));
        }
        this.out.push_cstr(format("type struct %s {\n",
            BindingSerializer::ident(this.ctx.intern_table.resolve(node.name))));
        for (mut i: i64 = 0; i < node.fields.length; i++) {
            const f: FieldDeclNode* = node.fields[i];
            this.out.push_cstr(format("    %s: %s;\n",
                BindingSerializer::ident(this.ctx.intern_table.resolve(f.name)),
                this.render_type(f.type_annotation)));
        }
        // Synthesized blob accessors (union reinterpret / bitfield shift-mask)
        // restore the field access the opaque-blob lowering drops.
        for (mut i: i64 = 0; i < node.binding_accessors.length; i++) {
            this.render_accessor(node.binding_accessors[i]);
        }
        this.out.push_cstr("}\n\n");
    }

    /// Render a native `type union` (untagged C union): one field per member, all
    /// overlaid at offset 0.  No synthesized accessors — members are accessed
    /// directly (`v.field`); a literal initializes exactly one member.
    render_union(mut &this, node: UnionDeclNode*) -> void {
        if (node.repr_c) { this.out.push_cstr("![repr(C)]\n"); }
        if (node.min_alignment > 0) {
            this.out.push_cstr(format("![align(%llu)]\n", node.min_alignment));
        }
        this.out.push_cstr(format("type union %s {\n",
            BindingSerializer::ident(this.ctx.intern_table.resolve(node.name))));
        for (mut i: i64 = 0; i < node.fields.length; i++) {
            const f: FieldDeclNode* = node.fields[i];
            this.out.push_cstr(format("    %s: %s;\n",
                BindingSerializer::ident(this.ctx.intern_table.resolve(f.name)),
                this.render_type(f.type_annotation)));
        }
        this.out.push_cstr("}\n\n");
    }

    /// Render one synthesized blob accessor method.  Union accessors reinterpret
    /// the blob's address as the member type; bitfield accessors shift/mask over
    /// the blob's backing integer.  Bit offsets/masks/shifts carry the backing
    /// suffix so the literals type-check against the reinterpreted integer.
    render_accessor(mut &this, acc: BindingAccessor) -> void {
        const name: string = BindingSerializer::ident(this.ctx.intern_table.resolve(acc.name));
        const blob: string = BindingSerializer::ident(this.ctx.intern_table.resolve(acc.blob_field));
        const vt: string = this.render_type(acc.value_type);
        const k: i32 = acc.kind;

        if (k == BindingAccessor::KIND_UNION_GET()) {
            // The reinterpreted lvalue: at offset 0 a direct cast of the blob's
            // address; at a non-zero (anon-struct) offset, a byte-pointer add.
            const lv: string = if (acc.byte_offset == 0) {
                format("*((&this.%s) as %s*)", blob, vt)
            } else {
                format("*((((&this.%s) as u8*) + %lld) as %s*)", blob, acc.byte_offset, vt)
            };
            this.out.push_cstr(format("    %s(&this) -> %s { return %s; }\n", name, vt, lv));
        } else if (k == BindingAccessor::KIND_UNION_SET()) {
            const lv: string = if (acc.byte_offset == 0) {
                format("*((&this.%s) as %s*)", blob, vt)
            } else {
                format("*((((&this.%s) as u8*) + %lld) as %s*)", blob, acc.byte_offset, vt)
            };
            this.out.push_cstr(format(
                "    %s(mut &this, v: %s) -> void { %s = v; }\n", name, vt, lv));
        } else if (k == BindingAccessor::KIND_BITFIELD_GET()) {
            const b: string = acc.backing;
            // The backing-typed read of the blob.
            const rd: string = format("*((&this.%s) as %s*)", blob, b);
            if (acc.is_signed) {
                // Sign-extend via shifts: move the field's MSB to the backing's
                // top bit, then arithmetic-right-shift back down.
                const sb: string = BindingSerializer::signed_backing(b);
                const nbits: i64 = BindingSerializer::backing_bits(b);
                const left: i64 = nbits - acc.bit_offset - acc.bit_width;
                const right: i64 = nbits - acc.bit_width;
                this.out.push_cstr(format(
                    "    %s(&this) -> %s { return (((%s as %s) << %lld%s) >> %lld%s) as %s; }\n",
                    name, vt, rd, sb, left, b, right, b, vt));
            } else {
                const mask: u64 = BindingSerializer::bit_mask(acc.bit_width);
                this.out.push_cstr(format(
                    "    %s(&this) -> %s { return ((%s >> %lld%s) & %llu%s) as %s; }\n",
                    name, vt, rd, acc.bit_offset, b, mask, b, vt));
            }
        } else if (k == BindingAccessor::KIND_BITFIELD_SET()) {
            const b: string = acc.backing;
            const mask: u64 = BindingSerializer::bit_mask(acc.bit_width);
            // *ptr = (*ptr & ~(mask << off)) | ((v as B & mask) << off)
            this.out.push_cstr(format(
                "    %s(mut &this, v: %s) -> void { mut p: %s* = (&this.%s) as %s*; *p = (*p & ~(%llu%s << %lld%s)) | (((v as %s) & %llu%s) << %lld%s); }\n",
                name, vt, b, blob, b, mask, b, acc.bit_offset, b, b, mask, b, acc.bit_offset, b));
        }
    }

    /// `(1 << width) - 1` as a u64 mask (width is 1..64; clamps a full-width
    /// 64-bit field to avoid an undefined `1 << 64`).
    static bit_mask(width: i64) -> u64 {
        if (width >= 64) { return 0xFFFFFFFFFFFFFFFFu64; }
        return (1u64 << (width as u64)) - 1u64;
    }

    /// The signed sibling of an unsigned backing type name (`u32` -> `i32`),
    /// for the signed-bitfield sign-extension read.
    static signed_backing(b: string) -> string {
        if (b.eq("u8"))  { return "i8"; }
        if (b.eq("u16")) { return "i16"; }
        if (b.eq("u32")) { return "i32"; }
        return "i64";
    }

    /// The bit width of a backing type name (`u32` -> 32).
    static backing_bits(b: string) -> i64 {
        if (b.eq("u8"))  { return 8; }
        if (b.eq("u16")) { return 16; }
        if (b.eq("u32")) { return 32; }
        return 64;
    }

    render_enum(mut &this, node: EnumDeclNode*) -> void {
        if (node.repr_c) { this.out.push_cstr("![repr(C)]\n"); }
        mut disc: string = "i32";
        if (node.discriminant_annotation != null) {
            disc = this.render_type(node.discriminant_annotation);
        }
        this.out.push_cstr(format("type enum %s : %s {\n",
            BindingSerializer::ident(this.ctx.intern_table.resolve(node.name)), disc));
        for (mut i: i64 = 0; i < node.variants.length; i++) {
            const v: EnumVariantNode* = node.variants[i];
            const vn: string = BindingSerializer::ident(this.ctx.intern_table.resolve(v.name));
            if (v.has_value) {
                this.out.push_cstr(format("    %s = %lld;\n", vn, v.explicit_value));
            } else {
                this.out.push_cstr(format("    %s;\n", vn));
            }
        }
        this.out.push_cstr("}\n\n");
    }

    render_alias(mut &this, node: TypeAliasDeclNode*) -> void {
        this.out.push_cstr(format("type %s = %s;\n\n",
            BindingSerializer::ident(this.ctx.intern_table.resolve(node.alias_name)),
            this.render_type(node.target_annotation)));
    }

    render_const(mut &this, node: VarDeclNode*) -> void {
        const ty: string = this.render_type(node.type_annotation);
        const init: ExpressionNode* = node.initializer;
        if (init == null) { return; }
        // A struct-literal initializer (a C compound-literal macro the importer
        // lowered, e.g. `#define RAYWHITE CLITERAL(Color){…}`): render
        // `const NAME: Type = Type { field: value, … };`.
        if (init.kind == NodeKind::StructLiteral) {
            this.render_struct_const(node, ty, init as StructLiteralNode*);
            return;
        }
        if (init.kind != NodeKind::Literal) { return; }
        const lit: LiteralNode* = init as LiteralNode*;
        mut val: string = "";
        if (lit.literal_kind == LiteralKind::String) {
            val = format("\"%s\"", BindingSerializer::escape(lit.value));
        } else if (lit.literal_kind == LiteralKind::Float) {
            val = lit.value;
        } else {
            // Integer (and char, stored as its integer code point): an explicit
            // cast keeps the source in range — the importer stores a negative C
            // value as its unsigned two's-complement decimal, which would
            // overflow the declared signed type as a bare literal.
            val = format("%s as %s", lit.value, ty);
        }
        this.out.push_cstr(format("const %s: %s = %s;\n",
            BindingSerializer::ident(this.ctx.intern_table.resolve(node.name)), ty, val));
    }

    /// Render a struct-literal global const (`const NAME: Type = Type { … };`).
    /// Field initializers are numeric literals in struct-declaration order (the
    /// importer emits them that way); names are keyword-escaped like every other
    /// emitted identifier.
    render_struct_const(mut &this, node: VarDeclNode*, ty: string, sl: StructLiteralNode*) -> void {
        mut s: string = format("const %s: %s = %s {",
            BindingSerializer::ident(this.ctx.intern_table.resolve(node.name)), ty, ty);
        for (mut i: i64 = 0; i < sl.field_inits.length; i++) {
            const fi: FieldInit = sl.field_inits[i];
            if (i > 0) { s = s + ","; }
            const fname: string = BindingSerializer::ident(this.ctx.intern_table.resolve(fi.field_name));
            s = s + format(" %s: %s", fname, BindingSerializer::render_const_scalar(fi.value));
        }
        this.out.push_cstr(s + " };\n\n");
    }

    /// Render a numeric-literal field/operand value to Cryo source (the bare
    /// literal text; non-literals fall back to `0`, which the importer never
    /// emits here).
    static render_const_scalar(expr: ExpressionNode*) -> string {
        if (expr == null || expr.kind != NodeKind::Literal) { return "0"; }
        const lit: LiteralNode* = expr as LiteralNode*;
        return lit.value;
    }

    render_function(mut &this, node: FunctionDeclNode*) -> void {
        this.out.push_cstr(format("    function %s(",
            this.ctx.intern_table.resolve(node.name)));
        for (mut i: i64 = 0; i < node.parameters.length; i++) {
            if (i > 0) { this.out.push_cstr(", "); }
            const p: VarDeclNode* = node.parameters[i];
            mut pn: string = this.ctx.intern_table.resolve(p.name);
            if (libc::strlen(pn) == 0) { pn = format("arg%lld", i); }
            else                       { pn = BindingSerializer::ident(pn); }
            this.out.push_cstr(format("%s: %s", pn, this.render_type(p.type_annotation)));
        }
        if (node.is_variadic) {
            if (node.parameters.length > 0) { this.out.push_cstr(", ..."); }
            else { this.out.push_cstr("..."); }
        }
        this.out.push_cstr(format(") -> %s;\n",
            this.render_type(node.return_type_annotation)));
    }

    /// Render a function-alias forwarding wrapper (a bodied top-level function):
    /// `function NAME(p0: T0, …) -> Ret { return TARGET(p0, …); }`.  The body is
    /// a single statement the importer built — a `return TARGET(args)` (or, for a
    /// `void` target, a bare `TARGET(args)`).  Top-level functions are public by
    /// default, so no modifier is emitted; the file's `namespace` qualifies it.
    render_wrapper_function(mut &this, node: FunctionDeclNode*) -> void {
        // Signature (param names keyword-escaped, matching the call args below).
        mut s: string = format("function %s(", this.ctx.intern_table.resolve(node.name));
        for (mut i: i64 = 0; i < node.parameters.length; i++) {
            if (i > 0) { s = s + ", "; }
            const p: VarDeclNode* = node.parameters[i];
            const pn: string = BindingSerializer::ident(this.ctx.intern_table.resolve(p.name));
            s = s + format("%s: %s", pn, this.render_type(p.type_annotation));
        }
        s = s + format(") -> %s {\n", this.render_type(node.return_type_annotation));

        // Body: extract the forwarded call (return-of-call, or a void call).
        const st: StatementNode* = node.body.statements[0];
        mut is_ret: boolean = st.kind == NodeKind::ReturnStatement;
        const call: CallExprNode* = if (is_ret) {
            (st as ReturnStmtNode*).expression as CallExprNode*
        } else {
            (st as ExprStmtNode*).expression as CallExprNode*
        };
        const target: string =
            this.ctx.intern_table.resolve((call.callee as IdentifierNode*).name);

        s = s + (if (is_ret) { "    return " } else { "    " });
        s = s + format("%s(", target);
        for (mut i: i64 = 0; i < node.parameters.length; i++) {
            if (i > 0) { s = s + ", "; }
            s = s + BindingSerializer::ident(this.ctx.intern_table.resolve(node.parameters[i].name));
        }
        s = s + ");\n}\n\n";
        this.out.push_cstr(s);
    }

    /// Render a TypeAnnotation tree to Cryo type syntax.
    render_type(&this, ann: TypeAnnotation*) -> string {
        if (ann == null) { return "void"; }
        match (*ann) {
            TypeAnnotation::Primitive(p) => {
                return this.ctx.intern_table.resolve(p.name);
            }
            TypeAnnotation::Pointer(p) => {
                // C const is frontend-only; Cryo FFI lowers `const T*` as `T*`.
                return this.render_type(p.inner) + "*";
            }
            TypeAnnotation::Named(n) => {
                // The importer qualified this as `<ns>::Tag`; strip back to the
                // bare tag since it lives under this file's namespace.  Apply the
                // same keyword-escape as the decl site so a reference to a
                // keyword-named type stays consistent.
                return BindingSerializer::ident(BindingSerializer::last_segment(
                    this.ctx.intern_table.resolve(n.name)));
            }
            TypeAnnotation::Array(a) => {
                return format("%s[%lld]", this.render_type(a.element), a.size);
            }
            TypeAnnotation::Function(f) => {
                mut s: string = "(";
                for (mut i: i64 = 0; i < f.parameters.length; i++) {
                    if (i > 0) { s = s + ", "; }
                    s = s + this.render_type(f.parameters[i]);
                }
                return s + ") -> " + this.render_type(f.return_type);
            }
            _ => { return "void*"; }
        }
    }

    // ---- helpers ----

    /// Make a C identifier safe to emit as a Cryo identifier: a C name that is
    /// a Cryo keyword (`type`, `in`, `new`, `string`, …) is suffixed with `_`
    /// so the binding parses (raylib's `AutomationEvent.type`, for instance).
    /// Layout/ABI is positional, so renaming a field/param/variant is harmless;
    /// the consumer simply uses the suffixed name.  Reuses the lexer's own
    /// keyword table (single source of truth) so it can never drift.
    static ident(name: string) -> string {
        if (TokenType::from_keyword(name) != TokenType::Unknown) {
            return name + "_";
        }
        return name;
    }

    /// The segment after the final `::` (e.g. `RayLib::Color` -> `Color`).
    static last_segment(s: string) -> string {
        const n: i64 = libc::strlen(s) as i64;
        mut after: i64 = 0;
        for (mut i: i64 = 0; i + 1 < n; i++) {
            if (s[i] == ':' && s[i + 1] == ':') { after = i + 2; }
        }
        return s + after;
    }

    static contains(list: &string[], s: string) -> boolean {
        for (mut i: i64 = 0; i < list.length; i++) {
            if (strcmp(list[i], s) == 0) { return true; }
        }
        return false;
    }

    /// Escape a decoded byte string for embedding in a Cryo `"..."` literal.
    static escape(s: string) -> string {
        const n: u64 = libc::strlen(s);
        mut out: String = String::new();
        for (mut i: u64 = 0; i < n; i++) {
            const c: i8 = s[i];
            if (c == '"')       { out.push_cstr("\\\""); }
            else if (c == '\\') { out.push_cstr("\\\\"); }
            else if (c == 10i8) { out.push_cstr("\\n"); }
            else if (c == 13i8) { out.push_cstr("\\r"); }
            else if (c == 9i8)  { out.push_cstr("\\t"); }
            else {
                mut one: i8[2];
                one[0] = c;
                one[1] = 0i8;
                out.push_cstr(&one[0] as string);
            }
        }
        return out.into_raw();
    }
}

/// Drives binding generation for a vendored library.
type struct VendorGenerator {
    /// Generate `.cryo` binding source for the library namespaced `ns`, parsing
    /// each `headers` entry (resolved against `source_path` and `include_dirs`)
    /// with the manifest's include dirs and defines on the clang command line.
    /// Returns the source text, or "" if no header could be parsed.
    ///
    /// `out_inputs` (when non-null) is filled with the de-duplicated set of files
    /// that fed the bindings — each resolved entry header plus every non-system
    /// file reached transitively via `#include` — so the caller can write a
    /// `<bindings>.cryo.deps` sidecar that `provenance_key` folds on the next
    /// cache check (catching edits to transitively-included headers).
    static generate(ns: string, source_path: string, headers: &string[],
                    include_dirs: &string[], defines: &string[],
                    out_inputs: string[]*) -> string {
        mut ctx: CompilationContext = CompilationContext::new(
            CompileMode::SingleFile, "<vendor-bindgen>");
        // The importer pushes top-level type decls into the AST root; give it a
        // fresh program node to collect into.
        mut root: ProgramNode* = new ProgramNode(SourceSpan::none());
        ctx.artifacts.ast.root = root;

        // One shared extern block carries the C functions; its alias namespace
        // is the vendor namespace, so emitted type references qualify under it.
        const alias_sym: SymbolStr = ctx.intern_table.intern(ns);
        mut extern_node: ExternBlockNode* = new ExternBlockNode("C", SourceSpan::none());
        extern_node.set_namespace_alias(alias_sym);

        // Build the shared clang args: `-I<abs include dir>` and `-D<define>`.
        mut extra: u8*[] = [];
        for (mut i: i64 = 0; i < include_dirs.length; i++) {
            const inc: string = VendorGenerator::join(source_path, include_dirs[i]);
            extra.push(format("-I%s", inc) as u8*);
        }
        for (mut i: i64 = 0; i < defines.length; i++) {
            extra.push(format("-D%s", defines[i]) as u8*);
        }

        // Accumulate every header's skipped/approximated constructs so the
        // honesty report is printed once, to stdout, after generation.
        mut report: ImportReport = ImportReport::new();
        mut parsed: i32 = 0;
        for (mut i: i64 = 0; i < headers.length; i++) {
            const hp: string = VendorGenerator::resolve_header(
                source_path, include_dirs, headers[i]);
            if (libc::strlen(hp) == 0) {
                fmt::eprintf("warning: vendor header '%s' not found under %s\n",
                    headers[i], source_path);
                continue;
            }
            // Always record the entry header itself (clang_getInclusions may or
            // may not report the TU's main file); `collect_from_tu` then appends
            // the transitive non-system includes.  Final de-dup happens below.
            if (out_inputs != null) { out_inputs.push(hp); }
            Importer::collect_from_tu(hp as u8*, null, 0u32, &extra, hp,
                                      extern_node, &ctx, &report, out_inputs);
            parsed = parsed + 1;
        }
        if (parsed == 0) { return ""; }
        if (out_inputs != null) { VendorGenerator::dedup_in_place(out_inputs); }

        report.summary_stdout(ns);
        return BindingSerializer::render(&ctx, ns, root, extern_node);
    }

    /// The libclang version banner (e.g. "clang version 20.1.0"), or "" when
    /// unavailable.  Folded into the provenance key so a toolchain upgrade
    /// invalidates the cache.  The CXString's C buffer is interned (copied) so
    /// the returned `string` outlives the disposed CXString.
    static clang_version() -> string {
        const s: CXString = Clang::clang_getClangVersion();
        const cstr: u8* = Clang::clang_getCString(s);
        mut out: string = "";
        if (cstr != null) { out = String::from_cstr(cstr as string).into_raw(); }
        Clang::clang_disposeString(s);
        return out;
    }

    /// The Stage-3 cache provenance key: a hex FNV-1a digest folding the bytes
    /// of the binding's input files, the (already-normalized) target `triple`,
    /// the libclang version, and `GENERATOR_VERSION`.  A change in any of these
    /// regenerates; an unchanged set is a cache hit.  Reuses the build manifest's
    /// FNV-1a folding so the whole compiler hashes one way.
    ///
    /// `cache_file` is the path of the PREVIOUSLY generated `.cryo` (or "" on a
    /// fresh registration).  When its `<cache_file>.deps` include-graph sidecar
    /// exists, the key folds every file listed there — the entry headers AND
    /// their transitive `#include`s — so editing a deeply-included header
    /// invalidates the cache.  When no sidecar exists yet (a fresh register, or a
    /// cache written before this mechanism), it falls back to folding the entry
    /// headers alone; that fallback is byte-identical to the pre-sidecar key, so
    /// upgrading does not spuriously invalidate a cache whose `GENERATOR_VERSION`
    /// already matched (the version bump to 6 is what forces the one-time
    /// regeneration that installs the sidecar).
    static provenance_key(source_path: string, headers: &string[],
                          include_dirs: &string[], triple: string,
                          cache_file: string) -> string {
        mut h: u64 = Manifest::fnv_seed();
        const depfile: string = if (libc::strlen(cache_file) > 0) {
            format("%s.deps", cache_file)
        } else {
            ""
        };
        if (libc::strlen(depfile) > 0
                && metadata::exists(Path::from_cstr(depfile))) {
            h = VendorGenerator::fold_depfile(h, depfile);
        } else {
            // Fallback (fresh register / pre-sidecar cache): entry headers only.
            for (mut i: i64 = 0; i < headers.length; i++) {
                const hp: string = VendorGenerator::resolve_header(
                    source_path, include_dirs, headers[i]);
                if (libc::strlen(hp) == 0) {
                    // A missing header still perturbs the key (distinct marker +
                    // the requested name) so it can't masquerade as unchanged.
                    h = Manifest::fnv_str(h, "<missing-header>");
                    h = Manifest::fnv_str(h, headers[i]);
                } else {
                    h = Manifest::fnv_file(h, hp);
                }
            }
        }
        h = Manifest::fnv_str(h, triple);
        h = Manifest::fnv_str(h, VendorGenerator::clang_version());
        h = Manifest::fnv_u64(h, GENERATOR_VERSION as u64);
        return h.to_hex_padded_str(16);
    }

    /// Fold the bytes of every file listed in an include-graph depfile (one path
    /// per line, written by `write_depfile`) into the running hash `seed`.  A
    /// listed file that has since been deleted perturbs the key with a distinct
    /// marker (so it can't masquerade as unchanged → forces a regeneration that
    /// rebuilds the graph).  Blank lines are skipped.  Returns the updated hash.
    static fold_depfile(seed: u64, depfile: string) -> u64 {
        mut h: u64 = seed;
        mut content: string = "";
        match (file::read_to_string(Path::from_cstr(depfile))) {
            Result::Ok(s)  => { content = s.into_raw(); }
            Result::Err(_) => { return h; }
        }
        const len: i64 = libc::strlen(content) as i64;
        mut i: i64 = 0;
        while (i < len) {
            const start: i64 = i;
            while (i < len && content[i] != 10) { i += 1; }   // 10 = '\n'
            mut end: i64 = i;
            // Trim a trailing '\r' (depfiles written on Windows / read on Unix).
            if (end > start && content[end - 1] == 13) { end -= 1; }   // 13 = '\r'
            if (end > start) {
                const path: string = content.substr(start, end - start);
                if (metadata::exists(Path::from_cstr(path))) {
                    h = Manifest::fnv_file(h, path);
                } else {
                    h = Manifest::fnv_str(h, "<missing-include>");
                    h = Manifest::fnv_str(h, path);
                }
            }
            if (i < len) { i += 1; }   // skip '\n'
        }
        return h;
    }

    /// Write the include-graph sidecar `<cryo_path>.deps`: one input file path
    /// per line, in the order `generate` accumulated them.  Best-effort — a
    /// write failure just means the next cache check falls back to the
    /// entry-header key (a possible spurious regeneration, never a stale cache).
    static write_depfile(cryo_path: string, inputs: &string[]) -> void {
        const dpath: string = format("%s.deps", cryo_path);
        const f: void* = libc::fopen(dpath, "w");
        if (f == null) { return; }
        for (mut i: i64 = 0; i < inputs.length; i++) {
            libc::fputs(inputs[i], f);
            libc::fputs("\n", f);
        }
        libc::fclose(f);
    }

    /// De-duplicate a path list in place, preserving first-seen order (so the
    /// depfile and thus the fold order are stable across regenerations).
    static dedup_in_place(arr: string[]*) -> void {
        mut out: string[] = [];
        for (mut i: i64 = 0; i < (*arr).length; i++) {
            const item: string = (*arr)[i];
            mut dup: boolean = false;
            for (mut j: i64 = 0; j < out.length; j++) {
                if (libc::strcmp(item, out[j]) == 0) { dup = true; break; }
            }
            if (!dup) { out.push(item); }
        }
        *arr = out;
    }

    /// `<base>/<rel>` (or `rel` when already absolute-ish).
    static join(base: string, rel: string) -> string {
        if (libc::strlen(rel) == 0) { return base; }
        if (rel[0] == '/' || rel[0] == '\\'
            || (libc::strlen(rel) > 1 && rel[1] == ':')) {
            return rel;   // already absolute (POSIX or Windows drive)
        }
        return format("%s/%s", base, rel);
    }

    /// Resolve a manifest header name to an existing file: try each include dir
    /// under source_path, then source_path itself, then the name verbatim.
    static resolve_header(source_path: string, include_dirs: &string[],
                          header: string) -> string {
        for (mut i: i64 = 0; i < include_dirs.length; i++) {
            const cand: string = format("%s/%s/%s",
                source_path, include_dirs[i], header);
            if (metadata::exists(Path::from_cstr(cand))) { return cand; }
        }
        const direct: string = format("%s/%s", source_path, header);
        if (metadata::exists(Path::from_cstr(direct))) { return direct; }
        if (metadata::exists(Path::from_cstr(header))) { return header; }
        return "";
    }
}
