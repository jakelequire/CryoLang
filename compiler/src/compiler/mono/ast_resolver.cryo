/// Mono AST Resolver  (compiler::mono::ast_resolver)
///
/// Post-clone re-resolution of a specialized AST: after `ASTSpecializer` clones a
/// template and `ASTTypeSubstituter` rewrites its annotations to concrete names,
/// every `resolved_type` field is invalid.  This collaborator fills them -
/// resolving fields, method signatures, and body locals - and performs compile-time
/// `static match` arm pruning (selecting the single live arm for the concrete
/// substitution).
///
/// Sema already typed the bodies and stashed every generic call's bindings;
/// `MonoCallSpecializer` consumes those.  Body re-resolution here is purely
/// "fill resolved_type on local decls".
///
/// Holds a `MonoState*` (to discover nested instantiations from method return
/// types + report static-match errors) and a `MonoTraitSpecializer*` (for
/// where-bound derivation + associated-type projection reduction).

namespace compiler::mono::ast_resolver;

import compiler::ast;
import compiler::ast::{
    declaration, expression, node, pattern, statement, TypeAnnotation
};
import compiler::types::{
    generic, user_defined, compound, type_base, arena, type_ref, substitution, resolver, TypeKind
};
import compiler::diag;
import compiler::diag::{ diagnostic, ErrorCode, sink, source_span };
import compiler::resolver::{ intern_table, symbol_str };
import compiler::mono::{ state, trait_specializer };
import compiler::types::generic_registry;
import compiler::types::generic_registry::{ TemplateKind };
import std::fmt;
import compiler::ast::declaration::{
    DeclarationNode, FunctionDecl, GenericParamDecl, ImplBlock,
    MethodDecl, StructDecl, UnionDecl, VarDecl
};
import compiler::ast::expression::{
    CallExpr, ExprKind, ExpressionNode,
    MemberAccessExpr
};
import compiler::ast::pattern::{ MatchArmNode, StaticMatchArmNode };
import compiler::ast::statement::{ BlockStmt, Stmt, StmtKind };
import compiler::diag::diagnostic::{ Diagnostic };
import compiler::diag::sink::{ DiagnosticSink };
import compiler::diag::source_span::{ SourceSpan };
import compiler::mono::state::{ MonoState };
import compiler::mono::trait_specializer::{ MonoTraitSpecializer };
import compiler::resolver::intern_table::{ InternTable };
import compiler::resolver::symbol_str::{ SymbolStr };
import compiler::types::arena::{ TypeArena };
import compiler::types::resolver::{ ResolutionContext, TypeResolver };
import compiler::types::substitution::{ TypeSubstitution };
import compiler::types::type_base::{ Type };
import compiler::types::type_ref::{ TypeRef };


type struct MonoAstResolver {
    arena:         TypeArena*;
    intern_table:  InternTable*;
    diagnostics:   DiagnosticSink*;
    type_resolver: TypeResolver*;
    state:         MonoState*;
    trait_spec:    MonoTraitSpecializer*;

    static null() -> MonoAstResolver {
        return MonoAstResolver {
            arena:         null,
            intern_table:  null,
            diagnostics:   null,
            type_resolver: null,
            state:         null,
            trait_spec:    null,
        };
    }

    wire(mut &this, arena: TypeArena*, intern_table: InternTable*,
                    diagnostics: DiagnosticSink*, type_resolver: TypeResolver*,
                    state: MonoState*, trait_spec: MonoTraitSpecializer*) -> void {
        this.arena         = arena;
        this.intern_table  = intern_table;
        this.diagnostics   = diagnostics;
        this.type_resolver = type_resolver;
        this.state         = state;
        this.trait_spec    = trait_spec;
    }


    /// Walk the specialized AST and resolve all type annotations into concrete
    /// TypeRefs.
    ///
    /// A bare leaf in this clone carries the stamp it was given in the file
    /// that WROTE it, and the MANGLED SPEC NAMES the substituter writes into
    /// the clone carry a `pre_resolved` TypeRef that `TypeResolver::resolve`
    /// returns before it consults the context, so the context holds only the
    /// bindings and `This`.
    resolve_specialized_ast(mut &this, ast_node: DeclarationNode*, kind: TemplateKind,
                            this_type: TypeRef) -> void {
        if (ast_node == null || this.type_resolver == null) { return; }
        mut res_ctx: ResolutionContext = ResolutionContext::new("");

        match (kind) {
            TemplateKind::Struct => {
                const decl: StructDecl* = DeclarationNode::struct_of(ast_node);
                this.type_resolver.resolve_fields(decl.fields, &res_ctx);
                this.resolve_methods(decl.methods, &res_ctx, this_type);
            }
            TemplateKind::Union => {
                const decl: UnionDecl* = DeclarationNode::union_of(ast_node);
                this.type_resolver.resolve_fields(decl.fields, &res_ctx);
                this.resolve_methods(decl.methods, &res_ctx, this_type);
            }
            TemplateKind::Enum => {
                // Enum variants use SymbolStr names; resolution handled in
                // populate_enum_variants via name lookup.
            }
            TemplateKind::Function => {
                // Free functions have no `this`.
                this.resolve_func_and_body(ast_node, &res_ctx, TypeRef::invalid());
            }
            TemplateKind::Trait => {}
            TemplateKind::TypeAlias => {}
        }
    }

    /// Resolve a specialization's `implement` block under `subst`, the
    /// block's own parameters bound through its head.
    resolve_specialized_impl(mut &this, decl: ImplBlock*, subst: TypeSubstitution*,
                             this_type: TypeRef) -> void {
        if (decl == null || this.type_resolver == null) { return; }
        mut res_ctx: ResolutionContext = ResolutionContext::new("");
        // Bounds-violating impls/methods were already stripped pre-clone
        // by filter_bounds_violating_* in specialize_with_entry.
        //
        // First derive any impl-introduced generic the Self type doesn't
        // determine (e.g. `A` in `implement<I, A> Iterator<A> for TakeN<I>
        // where I: Iterator<A>`) from the where-bounds, then bind the trait's
        // outer generic params to the impl's concrete trait args, so cloned
        // default-method bodies resolve their inner element names concretely.
        this.trait_spec.derive_impl_where_generics(decl, subst, &res_ctx);
        this.trait_spec.bind_trait_args_for_spec_impl(decl, &res_ctx);
        // Persist the concrete trait-element bindings onto the spec'd impl
        // (self-returning defaults are instantiated lazily and re-seed these).
        this.trait_spec.cache_derived_trait_params(decl, &res_ctx);
        // Drop conditionally-bounded trait defaults (`min`/`max` with
        // `where This::Item: Ord`) whose concrete Item does not satisfy
        // the bound for THIS monomorphization (e.g. `EnumerateIter`'s
        // `Pair` Item is not `Ord`) - before their bodies are resolved,
        // so `.compare()` on a non-`Ord` element never reaches type check.
        this.trait_spec.filter_projection_bound_methods(decl, this_type);
        // Rewrite where-bound-derived generics (`A`) inside the impl's method
        // BODIES so a struct literal `Pair<A, A>{..}` becomes concrete before
        // body resolution.  Run before resolve_methods.
        this.trait_spec.substitute_derived_params_in_method_bodies(decl);
        this.resolve_methods(decl.methods, &res_ctx, this_type);
    }

    // ---- static match arm pruning (compile-time type dispatch) -----------

    /// Entry point: prune `static match` arms throughout a freshly-substituted
    /// specialized AST.  Reduces each static match to its single live arm.
    ///
    /// Scoped per body, not per template.  Both kinds of name a `static
    /// match` resolves - the arm patterns the author wrote and the scrutinee
    /// the substituter rewrote to the concrete binding - were written
    /// wherever the BODY was, and a cloned trait default's body lives in the
    /// trait's file while the template names the implementing type's module.
    /// The same walk reached through `prune_static_match_in_stmt` from the
    /// call specializer is scoped that way too.
    prune_static_match_arms(mut &this, ast_node: DeclarationNode*, kind: TemplateKind) -> void {
        if (ast_node == null || this.type_resolver == null) { return; }
        mut res_ctx: ResolutionContext = ResolutionContext::new("");
        match (kind) {
            TemplateKind::Struct => {
                this.prune_static_match_in_methods((DeclarationNode::struct_of(ast_node)).methods, &res_ctx);
            }
            TemplateKind::Union => {
                this.prune_static_match_in_methods((DeclarationNode::union_of(ast_node)).methods, &res_ctx);
            }
            TemplateKind::Function => {
                const decl_decl: DeclarationNode* = ast_node;
                const decl: FunctionDecl* = DeclarationNode::fn_of(decl_decl);
                if (decl.body == null) { return; }
                this.prune_static_match_in_stmt(decl.body, &res_ctx);
            }
            TemplateKind::Enum => {}
            TemplateKind::Trait => {}
            TemplateKind::TypeAlias => {}
        }
    }

    /// `prune_static_match_arms` for a specialization's `implement` block.
    prune_static_match_arms_in_impl(mut &this, decl: ImplBlock*) -> void {
        if (decl == null || this.type_resolver == null) { return; }
        mut res_ctx: ResolutionContext = ResolutionContext::new("");
        this.prune_static_match_in_methods(decl.methods, &res_ctx);
    }

    prune_static_match_in_methods(mut &this, methods: &[DeclarationNode*],
                                  res_ctx: ResolutionContext*) -> void {
        for (mut i: i64 = 0; i < methods.length; i++) {
            const method_decl: DeclarationNode* = methods[i];
            const method: MethodDecl* = DeclarationNode::method_of(method_decl);
            if (method == null || method.func == null) { continue; }
            // A method with its OWN generic params (`try_push<T>`, `parse_int<T>`)
            // is pruned per-call by the CallSpecializer, which substitutes the
            // concrete method type-args into each `static match (T)` scrutinee
            // first.  Here - struct/impl specialization - only the owner's type
            // params are bound (`String<A>` -> `A = GlobalAlloc`); the method's
            // own `T` is still unbound, so resolving a method-level scrutinee
            // would fail (E0900).  Skip them; the per-call path handles them.
            if (DeclarationNode::fn_of(method.func).is_generic()) { continue; }
            if (DeclarationNode::fn_of(method.func).body != null) {
                this.prune_static_match_in_stmt(DeclarationNode::fn_of(method.func).body, res_ctx);
            }
        }
    }

    prune_static_match_in_stmt(mut &this, stmt: Stmt*,
                               res_ctx: ResolutionContext*) -> void {
        if (stmt == null) { return; }
        match (stmt.kind) {
            StmtKind::Block(b) => {
                for (mut i: i64 = 0; i < b.statements.length; i++) {
                    this.prune_static_match_in_stmt(b.statements[i], res_ctx);
                }
            }
            StmtKind::UnsafeBlock(ub) => {
                this.prune_static_match_in_stmt(ub.block, res_ctx);
            }
            StmtKind::Expr(es) => {
                this.prune_static_match_in_expr(es.expression, res_ctx);
            }
            StmtKind::Return(rs) => {
                this.prune_static_match_in_expr(rs.expression, res_ctx);
            }
            StmtKind::Decl(ds) => {
                if (ds.declaration != null &&
                    DeclarationNode::var_of(ds.declaration) != null) {
                    const vd: VarDecl* = DeclarationNode::var_of(ds.declaration);
                    this.prune_static_match_in_expr(vd.initializer, res_ctx);
                }
            }
            StmtKind::If(ifs) => {
                this.prune_static_match_in_expr(ifs.condition, res_ctx);
                this.prune_static_match_in_stmt(ifs.then_stmt, res_ctx);
                this.prune_static_match_in_stmt(ifs.else_stmt, res_ctx);
            }
            StmtKind::While(ws) => {
                this.prune_static_match_in_expr(ws.condition, res_ctx);
                this.prune_static_match_in_stmt(ws.body, res_ctx);
            }
            StmtKind::DoWhile(dw) => {
                this.prune_static_match_in_stmt(dw.body, res_ctx);
                this.prune_static_match_in_expr(dw.condition, res_ctx);
            }
            StmtKind::For(fs) => {
                // A variable declaration initializer is pruned; an expression
                // one is not.
                const init_var: VarDecl* = DeclarationNode::var_of(fs.init.as_decl());
                if (init_var != null) {
                    this.prune_static_match_in_expr(init_var.initializer, res_ctx);
                } else if (fs.init.as_stmt() != null) {
                    this.prune_static_match_in_stmt(fs.init.as_stmt(), res_ctx);
                }
                this.prune_static_match_in_expr(fs.condition, res_ctx);
                this.prune_static_match_in_expr(fs.update, res_ctx);
                this.prune_static_match_in_stmt(fs.body, res_ctx);
            }
            StmtKind::Loop(ls) => {
                this.prune_static_match_in_stmt(ls.body, res_ctx);
            }
            StmtKind::Match(ms) => {
                this.prune_static_match_in_expr(ms.subject, res_ctx);
                for (mut i: i64 = 0; i < ms.arms.length; i++) {
                    const arm: MatchArmNode* = ms.arms[i];
                    if (arm != null) {
                        this.prune_static_match_in_stmt(arm.body, res_ctx);
                    }
                }
            }
            StmtKind::StaticMatch(sms) => {
                const idx: i64 = this.select_static_match_arm(
                    sms.scrutinee, sms.arms, stmt.span, res_ctx);
                if (idx >= 0) {
                    mut reduced: [StaticMatchArmNode*] = [];
                    reduced.push(sms.arms[idx]);
                    sms.arms = reduced;
                }
                // Recurse into the surviving arm for nested static matches.
                for (mut i: i64 = 0; i < sms.arms.length; i++) {
                    const arm: StaticMatchArmNode* = sms.arms[i];
                    if (arm != null) {
                        this.prune_static_match_in_stmt(arm.body, res_ctx);
                    }
                }
            }
            StmtKind::Asm(_) | StmtKind::Break | StmtKind::Continue => {}
        }
    }

    prune_static_match_in_expr(mut &this, expr: ExpressionNode*,
                               res_ctx: ResolutionContext*) -> void {
        if (expr == null) { return; }
        match (expr.kind) {
            ExprKind::StaticMatch(sme) => {
                const idx: i64 = this.select_static_match_arm(
                    sme.scrutinee, sme.arms, expr.span, res_ctx);
                if (idx >= 0) {
                    mut reduced: [StaticMatchArmNode*] = [];
                    reduced.push(sme.arms[idx]);
                    sme.arms = reduced;
                }
                for (mut i: i64 = 0; i < sme.arms.length; i++) {
                    const arm: StaticMatchArmNode* = sme.arms[i];
                    if (arm != null && arm.body != null) {
                        this.prune_static_match_in_stmt(arm.body, res_ctx);
                    }
                }
            }
            ExprKind::Cast(ce) => { this.prune_static_match_in_expr(ce.expression, res_ctx); }
            ExprKind::ObjectConversion(oc) => { this.prune_static_match_in_expr(oc.operand, res_ctx); }
            ExprKind::MemberAccess(ma) => { this.prune_static_match_in_expr(ma.object, res_ctx); }
            ExprKind::Unary(u) => { this.prune_static_match_in_expr(u.operand, res_ctx); }
            ExprKind::Binary(b) => {
                this.prune_static_match_in_expr(b.left, res_ctx);
                this.prune_static_match_in_expr(b.right, res_ctx);
            }
            ExprKind::ArrayAccess(aa) => {
                this.prune_static_match_in_expr(aa.array, res_ctx);
                this.prune_static_match_in_expr(aa.index, res_ctx);
            }
            ExprKind::Match(me) => {
                this.prune_static_match_in_expr(me.subject, res_ctx);
                for (mut i: i64 = 0; i < me.arms.length; i++) {
                    const arm: MatchArmNode* = me.arms[i];
                    if (arm != null && arm.body != null) {
                        this.prune_static_match_in_stmt(arm.body, res_ctx);
                    }
                }
            }
            ExprKind::Ternary(t) => {
                this.prune_static_match_in_expr(t.condition, res_ctx);
                this.prune_static_match_in_expr(t.true_expr, res_ctx);
                this.prune_static_match_in_expr(t.false_expr, res_ctx);
            }
            ExprKind::If(ie) => {
                this.prune_static_match_in_expr(ie.condition, res_ctx);
                this.prune_static_match_in_expr(ie.then_expr, res_ctx);
                this.prune_static_match_in_expr(ie.else_expr, res_ctx);
            }
            // As the default below: not descended into.
            ExprKind::Sizeof(_) | ExprKind::Alignof(_) | ExprKind::Typeof(_)
            | ExprKind::Delete(_) | ExprKind::Yield(_) | ExprKind::Try(_)
            | ExprKind::New(_) | ExprKind::Tuple(_) | ExprKind::Array(_)
            | ExprKind::Struct(_) | ExprKind::Literal(_) | ExprKind::Lambda(_)
            | ExprKind::Await(_) | ExprKind::Identifier(_) | ExprKind::ScopeResolution(_) => { }
            ExprKind::Call(c) => {
                this.prune_static_match_in_expr(c.callee, res_ctx);
                for (mut i: i64 = 0; i < c.arguments.length; i++) {
                    this.prune_static_match_in_expr(c.arguments[i], res_ctx);
                }
            }
        }
    
    }

    /// Resolve the scrutinee and each arm's type pattern, returning the index of
    /// the single matching arm (first arm whose type equals the scrutinee, else
    /// the `_` wildcard).  Returns -1 when nothing matches.  Emits E0645 on a hard
    /// no-match and an internal error on an unresolved scrutinee.
    select_static_match_arm(mut &this, scrutinee: TypeAnnotation*,
                            arms: &[StaticMatchArmNode*], span: SourceSpan,
                            res_ctx: ResolutionContext*) -> i64 {
        if (arms.length == 0) { return -1; }
        const scrut: TypeRef = this.type_resolver.resolve(scrutinee, res_ctx);
        if (!scrut.is_valid()) {
            this.diagnostics.emit(Diagnostic::error(
                ErrorCode::E0900_INTERNAL_COMPILER_ERROR,
                "static match scrutinee did not resolve to a concrete type after substitution").at(span));
            this.state.error_count += 1;
            return -1;
        }

        if (arms.length == 1) {
            // A single arm: a `_` default always applies; otherwise the scrutinee
            // must equal one of the arm's `|`-separated types.  A lone matching arm
            // needs no pruning (return -1); a non-match is a genuine no-match
            // sema's net never catches.
            const only: StaticMatchArmNode* = arms[0];
            if (only == null || only.type_patterns.length == 0) { return -1; }
            if (this.arm_matches_scrutinee(only, scrut, res_ctx)) { return -1; }
            const tn0: string = this.arena.format_display(this.arena.lookup(scrut));
            this.diagnostics.emit(Diagnostic::error(
                ErrorCode::E0645_NO_STATIC_MATCH_ARM,
                fmt::format("no `static match` arm matches type `%s`", tn0))
                .at(span)
                .with_note("add an arm for this type or a `_` default arm"));
            this.state.error_count += 1;
            return -1;
        }

        mut wildcard_idx: i64 = -1;
        mut match_idx: i64 = -1;
        for (mut i: i64 = 0; i < arms.length; i++) {
            const arm: StaticMatchArmNode* = arms[i];
            if (arm == null) { continue; }
            if (arm.type_patterns.length == 0) {
                if (wildcard_idx < 0) { wildcard_idx = i; }
                continue;
            }
            if (this.arm_matches_scrutinee(arm, scrut, res_ctx)) {
                if (match_idx < 0) {
                    match_idx = i;
                } else {
                    // A second arm matching the same TypeID: ambiguous.  Keep the
                    // deterministic first-wins selection but surface the ambiguity.
                    const dn: string = this.arena.format_display(this.arena.lookup(scrut));
                    this.diagnostics.emit(Diagnostic::error(
                        ErrorCode::E0645_NO_STATIC_MATCH_ARM,
                        fmt::format("ambiguous `static match`: multiple arms match type `%s`", dn))
                        .at(span)
                        .with_note("remove the duplicate arm"));
                    this.state.error_count += 1;
                    return match_idx;
                }
            }
        }
        if (match_idx >= 0) { return match_idx; }
        if (wildcard_idx >= 0) { return wildcard_idx; }

        const ty_name: string = this.arena.format_display(this.arena.lookup(scrut));
        this.diagnostics.emit(Diagnostic::error(
            ErrorCode::E0645_NO_STATIC_MATCH_ARM,
            fmt::format("no `static match` arm matches type `%s`", ty_name))
            .at(span)
            .with_note("add an arm for this type or a `_` default arm"));
        this.state.error_count += 1;
        return -1;
    }

    /// True if the scrutinee's TypeID equals any of `arm`'s `|`-separated type
    /// patterns.  A `static match` arm may list several types that share one body
    /// (`u8 | u16 | u32 => ...`); the arm is live if the scrutinee matches any.
    /// Plain id equality is sufficient: the arena hash-conses types, so one
    /// semantic type has exactly one id, and aliases and resolved instantiations
    /// are already collapsed to their underlying entry before mono runs.
    arm_matches_scrutinee(mut &this, arm: StaticMatchArmNode*, scrut: TypeRef,
                          res_ctx: ResolutionContext*) -> boolean {
        for (mut p: i64 = 0; p < arm.type_patterns.length; p++) {
            const arm_ty: TypeRef = this.type_resolver.resolve(arm.type_patterns[p], res_ctx);
            if (arm_ty.is_valid() && arm_ty.equals(scrut)) { return true; }
        }
        return false;
    }

    /// Resolve signatures on an array of methods; delegates core signature
    /// resolution to TypeResolver, then resolves body locals.
    resolve_methods(mut &this, methods: &[DeclarationNode*], res_ctx: ResolutionContext*,
                    this_type: TypeRef) -> void {
        // Share `nested_visited` across all methods in this impl block so repeated
        // return types only produce a single monomorphization request per impl.
        this.state.nested_visited = [];
        for (mut i: i64 = 0; i < methods.length; i++) {
            const method_decl: DeclarationNode* = methods[i];
            const method: MethodDecl* = DeclarationNode::method_of(method_decl);
            if (method == null || method.func == null) { continue; }
            // Self-returning trait defaults (combinators returning an adapter over
            // `This`) AND self-growing inherent methods (`as_ref -> Option<T*>`)
            // are instantiated lazily at call sites, never eagerly - eager
            // resolution here would fire the return-type tower discovery below.
            if (DeclarationNode::fn_of(method.func).is_self_returning_default
                    || DeclarationNode::fn_of(method.func).is_lazy_self_growing) { continue; }
            // If the method has its own generic params (e.g. `hash<H>`), bind them
            // in a per-method resolution context before signature resolution so the
            // Reference branch builds `Reference(GenericParam_H)` not `Reference(invalid)`.
            if (DeclarationNode::fn_of(method.func).is_generic()) {
                mut method_ctx: ResolutionContext = res_ctx.clone();
                for (mut j: i64 = 0; j < DeclarationNode::fn_of(method.func).generic_params.length; j++) {
                    const gp_decl: DeclarationNode* = DeclarationNode::fn_of(method.func).generic_params[j];
                    const gp: GenericParamDecl* = DeclarationNode::generic_param_of(gp_decl);
                    if (gp == null) { continue; }
                    const gp_ref: TypeRef = this.arena.create_generic_param(
                        gp.sym_id, gp.name, j as u64);
                    method_ctx.add_binding(gp.sym_id, gp.name, gp_ref);
                }
                this.resolve_func_and_body(method.func, &method_ctx, this_type);
            } else {
                this.resolve_func_and_body(method.func, res_ctx, this_type);
            }
        }
    }

    /// Resolve a function's signature (via TypeResolver) and then resolve local
    /// variable types in its body (cloned AST bodies have cleared resolved_type).
    ///
    /// Sema typed the body and stashed every generic call; MonoCallSpecializer
    /// consumes the stash.  Only local-decl resolution + return-type nested
    /// discovery remain here.  The signature's annotations were rewritten by
    /// the substituter before this runs, so a parameter left in one names a
    /// declaration the clone cannot see, and there is no second context to
    /// try it under.
    resolve_func_and_body(mut &this, func_decl: DeclarationNode*, res_ctx: ResolutionContext*,
                          this_type: TypeRef) -> void {
        const func: FunctionDecl* = DeclarationNode::fn_of(func_decl);
        // Spec'd method clones have their `&this` parameter annotated as
        // `Reference(ThisType)`; thread `this_type` onto a per-call copy of the
        // context so `&this` resolves to `Reference(<spec'd_owner>)`.
        mut sig_ctx: ResolutionContext = res_ctx.clone();
        if (this_type.is_valid()) {
            sig_ctx.set_this_type(this_type);
        }
        this.type_resolver.resolve_func_signature(func_decl, &sig_ctx);

        // Back-fill `&this` / `this` parameters when they have no explicit
        // annotation (the parser leaves `type_annotation` null on the implicit
        // receiver).  `&this` -> `Pointer(this_type)`; bare `this` -> the owner type.
        if (this_type.is_valid()) {
            for (mut bp: i64 = 0; bp < func.parameters.length; bp++) {
                const param_decl: DeclarationNode* = func.parameters[bp];
                const param: VarDecl* = DeclarationNode::var_of(param_decl);
                if (param == null || param.resolved_type.is_valid()) { continue; }
                if (param.is_ref_receiver()) {
                    param.resolved_type = this.arena.get_pointer_to(this_type);
                } else if (param.is_value_receiver()) {
                    param.resolved_type = this_type;
                }
            }
        }
        // Reduce concrete-base associated-type projections in the spec signature
        // (`P::Item` under `P := IntSeq` -> `i32`) so the signature is fully
        // concrete before it is registered/mangled.
        if (func.resolved_return_type.is_valid()) {
            func.resolved_return_type =
                this.trait_spec.reduce_projections(func.resolved_return_type);
        }
        for (mut rpi: i64 = 0; rpi < func.parameters.length; rpi++) {
            const rpp_decl: DeclarationNode* = func.parameters[rpi];
            const rpp: VarDecl* = DeclarationNode::var_of(rpp_decl);
            if (rpp != null && rpp.resolved_type.is_valid()) {
                rpp.resolved_type = this.trait_spec.reduce_projections(rpp.resolved_type);
            }
        }

        if (func.body != null) {
            this.resolve_body_locals(func.body, res_ctx);
        }

        // Discover transitive instantiations from the method's return type, so
        // methods that return another generic type (e.g. `IoResult<T>::ok() ->
        // Option<T>`) trigger monomorphization of the referenced generic.  The
        // caller (resolve_methods) owns `nested_visited` lifecycle so repeated
        // return types across methods in the same impl block dedupe.
        if (func.has_resolved_return_type()) {
            this.state.request_nested_instantiations(func.resolved_return_type);
        }
    }

    /// Walk a block statement and resolve type annotations on all local variable
    /// declarations.  Recurses into the nested bodies that are blocks; a
    /// statement that is not a block is not walked.
    resolve_body_locals(mut &this, block_stmt: Stmt*, res_ctx: ResolutionContext*) -> void {
        if (block_stmt == null) { return; }
        const block: BlockStmt* = match (block_stmt.kind) {
            StmtKind::Block(b) => { b }
            _                  => { null }
        };
        if (block == null) { return; }
        for (mut i: i64 = 0; i < block.statements.length; i++) {
            const stmt: Stmt* = block.statements[i];
            if (stmt == null) { continue; }
            match (stmt.kind) {
                StmtKind::Decl(decl_stmt) => {
                    const inner_decl: DeclarationNode* = decl_stmt.declaration;
                    if (inner_decl != null) {
                        const inner_node: DeclarationNode* = inner_decl as DeclarationNode*;
                        if (DeclarationNode::var_of(inner_node) != null) {
                            const var_decl: VarDecl* = DeclarationNode::var_of(inner_decl);
                            if (var_decl.type_annotation != null && !var_decl.resolved_type.is_valid()) {
                                const vtype: TypeRef = this.type_resolver.resolve(
                                    var_decl.type_annotation, res_ctx);
                                if (vtype.is_valid()) {
                                    var_decl.resolved_type = vtype;
                                }
                            }
                        }
                    }
                }
                StmtKind::Block(_) => {
                    this.resolve_body_locals(stmt, res_ctx);
                }
                StmtKind::If(if_stmt) => {
                    this.resolve_body_locals(if_stmt.then_stmt, res_ctx);
                    this.resolve_body_locals(if_stmt.else_stmt, res_ctx);
                }
                StmtKind::While(while_stmt) => {
                    this.resolve_body_locals(while_stmt.body, res_ctx);
                }
                StmtKind::For(for_stmt) => {
                    // Resolve the loop's init VarDecl (e.g. `mut i: int = 0`).  The init
                    // can be a bare variable declaration or a declaration statement.
                    if (!for_stmt.init.is_null()) {
                        mut for_var: VarDecl* = null;
                        if (DeclarationNode::var_of(for_stmt.init.as_decl()) != null) {
                            for_var = DeclarationNode::var_of(for_stmt.init.as_decl());
                        } else if (for_stmt.init.as_stmt() != null) {
                            match (for_stmt.init.as_stmt().kind) {
                                StmtKind::Decl(init_decl) => {
                                    const inner_decl: DeclarationNode* = init_decl.declaration;
                                    if (inner_decl != null
                                            && DeclarationNode::var_of(inner_decl) != null) {
                                        for_var = DeclarationNode::var_of(inner_decl);
                                    }
                                }
                                _ => {}
                            }
                        }
                        if (for_var != null && for_var.type_annotation != null
                                && !for_var.resolved_type.is_valid()) {
                            const vtype: TypeRef = this.type_resolver.resolve(
                                for_var.type_annotation, res_ctx);
                            if (vtype.is_valid()) {
                                for_var.resolved_type = vtype;
                            }
                        }
                    }
                    this.resolve_body_locals(for_stmt.body, res_ctx);
                }
                StmtKind::Match(match_stmt) => {
                    for (mut mi: i64 = 0; mi < match_stmt.arms.length; mi++) {
                        const arm: MatchArmNode* = match_stmt.arms[mi];
                        if (arm != null) {
                            this.resolve_body_locals(arm.body, res_ctx);
                        }
                    }
                }
                StmtKind::StaticMatch(sm_stmt) => {
                    for (mut mi: i64 = 0; mi < sm_stmt.arms.length; mi++) {
                        const arm: StaticMatchArmNode* = sm_stmt.arms[mi];
                        if (arm != null) {
                            this.resolve_body_locals(arm.body, res_ctx);
                        }
                    }
                }
                StmtKind::Loop(loop_stmt) => {
                    this.resolve_body_locals(loop_stmt.body, res_ctx);
                }
                // Neither an `unsafe` block's nor a `do`-`while` body's
                // locals are resolved here.
                StmtKind::UnsafeBlock(_) | StmtKind::DoWhile(_) | StmtKind::Asm(_)
                | StmtKind::Return(_) | StmtKind::Break | StmtKind::Continue
                | StmtKind::Expr(_) => {}
            }
        }
    }
}
