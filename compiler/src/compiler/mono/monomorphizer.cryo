///! Monomorphizer  (compiler::mono::monomorphizer)
///!
///! Worklist-driven engine that processes all generic instantiations to completion.
///! Repeatedly dequeues InstantiatedTypes, specializes them via ASTSpecializer,
///! creates concrete types in the TypeArena, and discovers transitive dependencies.
///!
///! After process_all() completes, every InstantiatedType has a resolved_type
///! pointing to a concrete Struct/Enum/Class, and the finished specializations
///! are exposed to `passes/specialization.cryo` through `spec_entry_at()` + the
///! injection cursor for placement into the program AST.
///!
///! Semantic analysis is authoritative and runs FIRST.  It pins generic type
///! arguments onto `CallExprNode.resolved_type_args` and types every
///! expression/literal.  This monomorphizer CONSUMES those pinned bindings (via
///! `MonoCallSpecializer`); it does NOT re-derive them.  Mono's job: materialize
///! concrete arena types, discover nested instantiations, consume sema's stash to
///! mint per-call free/method specializations, and handle cross-module naming.
///!
///! Thin orchestrator: it owns the specialization cache + the four AST/type
///! collaborators + the shared `MonoState` (worklist/discovery/error) by value,
///! wiring their back-pointers via `wire()` AFTER it reaches a stable heap address.

namespace compiler::mono::monomorphizer;

import compiler::ast;
import compiler::ast::{ node, declaration, statement, expression, pattern };
import compiler::types::{
    generic, user_defined, compound, type_base, arena, type_ref, substitution,
    checker, resolver, generic_registry, ownership, trait_checker, TypeKind
};
import compiler::diag;
import compiler::diag::{ sink, diagnostic, source_span };
import compiler::decl_index;
import compiler::lex;
import compiler::resolver::{
    intern_table, symbol_str, resolver, qualified_name, mangled_name
};
import compiler::module_graph;
import compiler::mono::{
    state, specializer, dispatch_annotator, trait_specializer,
    type_populator, ast_resolver, call_specializer
};
import std::collections::hashmap;
import utils::logger;


// `SpecializationEntry` + `MonomorphRequest` live in `compiler::mono::state` so
// the collaborators can see them without a cycle.


// Monomorphizer: worklist engine

type struct Monomorphizer {
    // -- Shared environment (held by pointer/value; lent to collaborators) --
    arena:             TypeArena*;
    generic_registry:  GenericRegistry*;
    intern_table:      InternTable*;
    diagnostics:       DiagnosticSink*;
    type_resolver:     TypeResolver*;
    decl_index:        DeclarationIndex*;
    specializer:       ASTSpecializer;

    // Standalone trait-satisfaction query engine.  Read-only over the
    // arena/registry/intern-table/diagnostics; lives here so semantic analysis
    // can use it without depending on the monomorphizer having run.
    trait_checker:     TraitChecker;

    // -- Shared mutable state (worklist + discovery + error) --
    state:             MonoState;

    // -- Collaborators (owned by value; wired after the orchestrator is stable) --
    dispatch_annotator: MonoDispatchAnnotator;  // bound-directed fmt dispatch (pre-mono AST pass)
    trait_spec:         MonoTraitSpecializer;    // trait-impl conditional inst + bounds + assoc-proj
    type_populator:     MonoTypePopulator;       // spec'd AST -> concrete arena types
    ast_resolver:       MonoAstResolver;         // post-clone re-resolution + static-match arm pruning
    call_specializer:   MonoCallSpecializer;     // sema-stash consumer: free/method per-call specialization

    // -- Specialization cache (orchestrator-private; spec_entries live on state) --
    // Keyed by the CANONICAL INSTANTIATION ID for (base, args) - see `make_key`.
    // (`spec_keys: string[]` used to sit here too; it was write-only and is gone.)
    spec_index:        HashMap<u64, i64>;      // key -> index in state.spec_entries

    // -- Incremental injection tracking (for batch compilation) --
    injection_cursor:  i64;

    // Current module being processed (set by pass before calling process_all)
    current_module:    SymbolStr;


    /// Construct the orchestrator with its environment.  Collaborators + state are
    /// `null()`-initialized here; their back-pointers are set later by `wire()`
    /// once the Monomorphizer is at a stable heap address (the Box::leak dance).
    /// The owning pass constructs this, leaks it, then wires.
    static new(arena: TypeArena*, generic_registry: GenericRegistry*,
               intern_table: InternTable*, diagnostics: DiagnosticSink*,
               type_resolver: TypeResolver*,
               decl_index: DeclarationIndex*) -> Monomorphizer {
        return Monomorphizer {
            arena:                 arena,
            generic_registry:      generic_registry,
            intern_table:          intern_table,
            diagnostics:           diagnostics,
            type_resolver:         type_resolver,
            decl_index:            decl_index,
            specializer:           ASTSpecializer::new(arena, intern_table),
            trait_checker:         TraitChecker::new(arena, generic_registry,
                                                     intern_table, diagnostics),
            state:                 MonoState::null(),
            dispatch_annotator:    MonoDispatchAnnotator::null(),
            trait_spec:            MonoTraitSpecializer::null(),
            type_populator:        MonoTypePopulator::null(),
            ast_resolver:          MonoAstResolver::null(),
            call_specializer:      MonoCallSpecializer::null(),
            spec_index:            HashMap<u64, i64>::new(),
            injection_cursor:      0,
            current_module:        SymbolStr::empty(),
        };
    }

    /// Wire collaborator + state back-pointers.  MUST be called after the
    /// orchestrator reaches a stable heap address (e.g.
    /// `Box::new(Monomorphizer::new(..)).leak()`) because each collaborator
    /// stores raw pointers into this struct's own by-value fields.
    wire(mut &this) -> void {
        this.state.wire(this.arena, this.generic_registry, this.intern_table,
                        this.type_resolver);
        this.dispatch_annotator.wire(this.arena, this.intern_table);
        this.trait_spec.wire(this.arena, this.generic_registry, this.intern_table,
                             this.diagnostics, this.type_resolver, &this.trait_checker);
        this.type_populator.wire(this.arena, this.intern_table);
        this.ast_resolver.wire(this.arena, this.intern_table, this.diagnostics,
                               this.type_resolver, &this.state, &this.trait_spec);
        this.call_specializer.wire(this.arena, this.generic_registry, this.intern_table,
                                   this.diagnostics, this.type_resolver, this.decl_index,
                                   &this.state, &this.trait_spec, &this.ast_resolver);
    }


    // Public per-pass API (called by passes/specialization.cryo)

    /// Set the current module context for origin tracking.
    set_current_module(mut &this, module: SymbolStr) -> void {
        this.current_module = module;
        this.call_specializer.set_current_module(module);
    }

    /// Set the current module NAMESPACE for import-scoped generic scope
    /// resolution in the call specializer (distinct from `current_module`, the
    /// source-file origin identity).  Cascaded to the call specializer.
    set_current_ns(mut &this, ns: SymbolStr) -> void {
        this.call_specializer.set_current_ns(ns);
    }

    /// Supply the file -> namespace map used to derive a resolution context's
    /// HOME module from the span of the syntax being resolved.  Cascaded to
    /// every collaborator that builds a context.
    ///
    /// This is the ambient-cursor-free counterpart to `set_current_ns`: the
    /// cursor names the module being compiled, which in mono is the module that
    /// DEMANDED a specialization rather than the one that wrote the template
    /// body being re-walked.
    set_module_graph(mut &this, graph: ModuleGraph*) -> void {
        this.call_specializer.set_module_graph(graph);
        this.ast_resolver.set_module_graph(graph);
        this.trait_spec.set_module_graph(graph);
    }

    /// True if every queued specialization request has been drained.
    worklist_empty(&this) -> boolean {
        return this.state.worklist_empty();
    }

    /// Number of requests still queued (for diagnostic messages).
    pending_count(&this) -> i64 {
        return this.state.pending_count();
    }

    /// Total number of completed specialization entries.
    spec_count(&this) -> i64 {
        return this.state.spec_entries.length;
    }

    /// The resolved owner-module source path of spec entry `i`.
    spec_owner_source_at(&this, i: i64) -> SymbolStr {
        if (i < 0 || i >= this.state.spec_entries.length) {
            return SymbolStr::empty();
        }
        return this.state.spec_entries[i].owner_source;
    }

    /// Number of recorded generic-METHOD spec owner modules (see
    /// MonoState::spec_owner_modules).  Parallel to `spec_count` for the
    /// `spec_entries` type/free-function specs.
    spec_owner_module_count(&this) -> i64 {
        return this.state.spec_owner_modules.length;
    }

    /// The owner-module key (namespace or source path) of method-spec record `i`,
    /// resolvable via `ModuleGraph::source_file_for_owner_key`.
    spec_owner_module_at(&this, i: i64) -> SymbolStr {
        if (i < 0 || i >= this.state.spec_owner_modules.length) {
            return SymbolStr::empty();
        }
        return this.state.spec_owner_modules[i];
    }

    /// Bound-directed dispatch annotation (Display::fmt vs Debug::fmt).  Runs over
    /// EVERY decl before mono clones any template.  See MonoDispatchAnnotator.
    annotate_bound_dispatch_in_module(mut &this, root: ProgramNode*) -> void {
        this.dispatch_annotator.annotate_bound_dispatch_in_module(root);
    }

    /// Consume sema's `resolved_type_args` stash across a module's call sites,
    /// minting per-call free/method specializations.  New instantiations it
    /// queues are drained by `drain_pending_worklist` (caller's responsibility).
    specialize_calls_in_module(mut &this, root: ProgramNode*) -> void {
        this.call_specializer.specialize_calls_in_module(root);
    }


    /// Process all pending monomorphization requests.
    /// Returns true if all succeeded, false if any errors occurred.
    process_all(mut &this) -> boolean {
        // Flag same-leaf free functions in different modules before any
        // specialization so their spec symbols don't collide (idempotent).
        this.generic_registry.finalize_disambiguation(this.intern_table);

        // Import all unmonomorphized instantiations from the generic registry
        const unprocessed: TypeRef[] = this.generic_registry.collect_unmonomorphized();

        // Nothing new to process; skip the worklist entirely.
        if (unprocessed.length == 0) {
            return true;
        }

        LOG_DEBUG(LogComponent::TypeChecker, "[Monomorphizer::process_all] %lld unmonomorphized instantiations",
            unprocessed.length);

        for (mut i: i64 = 0; i < unprocessed.length; i++) {
            this.state.enqueue_from_type_ref(unprocessed[i]);
        }

        // Worklist-iteration ceiling.  A genuine instantiation cycle is
        // collapsed by the `is_cached` check below (a re-requested key resolves
        // to its cached concrete type).  What that does NOT bound is a
        // *type-growing* template - one whose field/arg type gains a level of
        // nesting at each instantiation (`Wrap<T> { f: Wrap<Wrap<T>> }`) - which
        // mints a fresh, ever-larger key every level and would loop until the
        // process exhausts memory.  Bound the loop to a generous multiple of the
        // program's type count (far above any legitimate instantiation set) and
        // report E0900 on exceed instead of hanging / OOMing with no diagnostic.
        const max_iterations: i64 = 100000 + this.arena.type_count() * 100;
        mut iterations: i64 = 0;

        // Process worklist until empty
        while (this.state.pending_cursor < this.state.pending.length) {
            iterations += 1;
            if (iterations > max_iterations) {
                this.diagnostics.emit(Diagnostic::error(ErrorCode::E0900_INTERNAL_COMPILER_ERROR,
                    format("monomorphization exceeded %lld instantiations - a generic type that grows its type arguments at each level (e.g. `Wrap<T> { f: Wrap<Wrap<T>> }`) instantiates without bound",
                        max_iterations)));
                this.state.error_count += 1;
                break;
            }
            const request: MonomorphRequest = this.state.pending[this.state.pending_cursor].clone();
            this.state.pending_cursor += 1;

            const key: u64 = this.make_key(request);

            // Already cached; mark monomorphized + propagate the cached concrete
            // type to this module's fresh InstantiatedType.
            if (this.is_cached(key)) {
                this.propagate_cached_resolution(key, request);
                this.generic_registry.mark_monomorphized(request.base_type, request.type_args);
                continue;
            }

            const success: boolean = this.specialize_request(request, key);

            if (!success) {
                this.state.error_count += 1;
            }
        }

        // Second pass: discover Array<T> for standalone T[] usages.  The nested
        // discovery above only catches arrays that appear as fields of other
        // monomorphized types.  Standalone T[] creates ArrayType without
        // InstantiatedType.  Scan the arena once for dynamic ArrayTypes with
        // concrete elements and enqueue any missing Array<T> instantiations.
        const array_sym: SymbolStr = this.intern_table.intern("std::collections::array::Array");
        const array_entry: TemplateEntry* = this.generic_registry.get_template(array_sym);
        if (array_entry != null) {
            const array_base: TypeRef = array_entry.base_type;
            const type_count: i64 = this.arena.type_count();
            for (mut tid: u64 = 1; tid <= type_count as u64; tid++) {
                const at: Type* = this.arena.lookup(tid);
                if (at == null || at.kind != TypeKind::Array) { continue; }
                const arr: ArrayType* = at as ArrayType*;
                if (!arr.is_dynamic() || !arr.element.is_valid()) { continue; }
                const elem_t: Type* = this.arena.lookup(arr.element.id);
                if (elem_t == null) { continue; }
                if (elem_t.kind == TypeKind::GenericParam ||
                    elem_t.kind == TypeKind::BoundedParam) { continue; }
                mut arr_args: TypeRef[] = [];
                arr_args.push(arr.element);
                const _mod_dummy: string = "";
                mut arr_ctx: ResolutionContext = ResolutionContext::new(FILE, LINE, _mod_dummy, _mod_dummy, SymbolStr::empty(), HomeOrigin::Unset);
                arr_args = this.type_resolver.expand_default_type_args(array_entry, arr_args, &arr_ctx);
                const inst_ref: TypeRef = this.generic_registry.instantiate(array_base, arr_args);
                this.state.enqueue_from_type_ref(inst_ref);
            }
            // Process any newly enqueued Array<T> instantiations.
            while (this.state.pending_cursor < this.state.pending.length) {
                const req: MonomorphRequest = this.state.pending[this.state.pending_cursor].clone();
                this.state.pending_cursor += 1;
                const rkey: u64 = this.make_key(req);
                if (this.is_cached(rkey)) {
                    this.propagate_cached_resolution(rkey, req);
                    this.generic_registry.mark_monomorphized(req.base_type, req.type_args);
                    continue;
                }
                const rsuccess: boolean = this.specialize_request(req, rkey);
                if (!rsuccess) { this.state.error_count += 1; }
            }
        }

        // Mark ALL collected items as monomorphized, including those that
        // enqueue_from_type_ref() filtered out, so collect_unmonomorphized()
        // doesn't keep returning them on every subsequent module in a batch build.
        for (mut i: i64 = 0; i < unprocessed.length; i++) {
            const t: Type* = this.arena.lookup(unprocessed[i].id);
            if (t != null && t.kind == TypeKind::InstantiatedType) {
                const inst: InstantiatedType* = t as InstantiatedType*;
                this.generic_registry.mark_monomorphized(inst.generic_base, inst.type_args);
            }
        }

        return this.state.error_count == 0;
    }


    /// Drain the pending instantiation worklist without the
    /// `collect_unmonomorphized()` pre-pass that `process_all` runs.  Used after
    /// `specialize_calls_in_module` queues new instantiations.  Returns true on success.
    drain_pending_worklist(mut &this) -> boolean {
        mut errors: i64 = 0;
        // Same type-growing-instantiation ceiling as `process_all` (without a cap
        // on this drain path an unbounded tower hangs hard here).
        const max_iterations: i64 = 100000 + this.arena.type_count() * 100;
        mut drain_iters: i64 = 0;
        while (this.state.pending_cursor < this.state.pending.length) {
            drain_iters += 1;
            if (drain_iters > max_iterations) {
                this.diagnostics.emit(Diagnostic::error(ErrorCode::E0900_INTERNAL_COMPILER_ERROR,
                    format("monomorphization exceeded %lld instantiations (type-growing generic that grows its type arguments at each level)",
                        max_iterations)));
                this.state.error_count += 1;
                break;
            }
            const request: MonomorphRequest = this.state.pending[this.state.pending_cursor].clone();
            this.state.pending_cursor += 1;
            const key: u64 = this.make_key(request);
            if (this.is_cached(key)) {
                this.propagate_cached_resolution(key, request);
                this.generic_registry.mark_monomorphized(request.base_type, request.type_args);
                continue;
            }
            const ok: boolean = this.specialize_request(request, key);
            if (!ok) { errors += 1; }
        }
        if (errors > 0) {
            this.state.error_count += errors;
        }
        return errors == 0;
    }


    // Single request specialization

    specialize_request(mut &this, request: &MonomorphRequest, key: u64) -> boolean {
        cdebug("[Monomorphizer::specialize_request] key=%llu base_type.id=%llu\n", key, request.base_type.id);
        const _base_dbg: Type* = this.arena.lookup(request.base_type.id);
        if (_base_dbg != null) {
            cdebug("  base type: kind=%s display='%s'\n", _base_dbg.kind.to_string(), _base_dbg.display_name());
        } else {
            cdebug("  base type: LOOKUP FAILED for id=%llu\n", request.base_type.id);
        }
        cdebug("  registered templates: %lld\n", this.generic_registry.template_count());
        const entry: TemplateEntry* = this.generic_registry.get_template_by_type_id(request.base_type.id);
        if (entry == null) {
            this.diagnostics.emit(Diagnostic::error(ErrorCode::E0900_INTERNAL_COMPILER_ERROR,
                format("no template found for type ID %llu", request.base_type.id)));
            return false;
        }

        return this.specialize_with_entry(request, key, entry);
    }

    // `request` is BORROWED, not taken by value: it carries an owning
    // `type_args: TypeRef[]`; a by-value parameter would bitwise-copy the struct
    // (aliasing the caller's buffer) and the copy's drop would double-free.
    specialize_with_entry(mut &this, request: &MonomorphRequest, key: u64,
                          entry: TemplateEntry*) -> boolean {
        // Validate arg count
        if (request.type_args.length != entry.param_count) {
            const qn_str: string = this.intern_table.resolve(entry.qualified_name);
            this.diagnostics.emit(Diagnostic::error(ErrorCode::E0900_INTERNAL_COMPILER_ERROR,
                format("arg count mismatch for %s: expected %lld, got %lld",
                        qn_str, entry.param_count, request.type_args.length)));
            return false;
        }

        // Build display names for type args.  Use the qualified name for
        // user-defined types so cross-module resolution works.
        mut type_arg_displays: string[] = [];
        for (mut i: i64 = 0; i < request.type_args.length; i++) {
            const arg_t: Type* = this.arena.lookup(request.type_args[i].id);
            if (arg_t != null) {
                const qname: SymbolStr = this.arena.get_qualified_name(request.type_args[i]);
                if (qname.is_valid()) {
                    type_arg_displays.push(this.intern_table.resolve(qname));
                } else {
                    type_arg_displays.push(this.arena.format_display(arg_t));
                }
            } else {
                type_arg_displays.push(format("unknown_%llu", request.type_args[i].id));
            }
        }

        // Call AST specializer
        // The wrapper's id IS the concrete's id on the swap-relocate path, and
        // `reserve_spec_names` below publishes the spec name against it, so
        // handing it to the substituter now attaches the same id the by-name
        // lookup would have found later.  Invalid for a function template (not
        // `is_named`, no wrapper), which keeps the by-name route there.
        const result: SpecializationResult = this.specializer.specialize(
            entry, request.type_args, type_arg_displays, request.generic_type
        );
        if (!result.success) {
            const qn_str: string = this.intern_table.resolve(entry.qualified_name);
            mut args_str: string = "";
            for (mut ai: i64 = 0; ai < type_arg_displays.length; ai++) {
                if (ai > 0) { args_str = format("%s,%s", args_str, type_arg_displays[ai]); }
                else        { args_str = type_arg_displays[ai]; }
            }
            this.diagnostics.emit(Diagnostic::error(ErrorCode::E0900_INTERNAL_COMPILER_ERROR,
                format("specialization failed for %s<%s>: %s",
                        qn_str, args_str, result.error_message)));
            return false;
        }

        // Intern the specialized name for type system use
        const spec_name_sym: SymbolStr = this.intern_table.intern(result.spec_name);

        // Build the *qualified* specialized name for the arena.
        const qualified_spec_sym: SymbolStr = this.qualify_spec_name(entry, result.spec_name);

        // Create concrete type in arena based on node kind
        const subst: TypeSubstitution = TypeSubstitution::from_params(
            entry.param_type_ids, request.type_args
        );

        // Drop impls and methods whose where-bounds aren't satisfied for this
        // substitution.  Removing them here means resolve_specialized_ast never
        // sees an uncompilable body and DI never indexes a junk signature.
        this.trait_spec.filter_bounds_violating_methods(result.specialized_ast, &subst);
        const kept_impl_asts: ASTNode*[] = this.trait_spec.filter_bounds_violating_impls(
            result.impl_asts, &subst);

        // Determine the concrete aggregate kind for this template.  Function
        // templates (`is_named == false`) produce no arena type.
        mut target_kind: TypeKind = TypeKind::Struct;
        mut is_named: boolean = true;
        mut is_union_kind: boolean = false;
        match (entry.node_kind) {
            NodeKind::StructDeclaration   => { target_kind = TypeKind::Struct; }
            NodeKind::UnionDeclaration    => { target_kind = TypeKind::Struct; is_union_kind = true; }
            NodeKind::EnumDeclaration     => { target_kind = TypeKind::Enum; }
            NodeKind::ClassDeclaration    => { target_kind = TypeKind::Class; }
            NodeKind::FunctionDeclaration => { is_named = false; }
            _                             => { target_kind = TypeKind::Struct; }
        }

        // Human-readable display name ("Pair<i32, string>"), computed from the
        // still-unresolved InstantiatedType wrapper (valid whether or not we take
        // the swap path below).
        mut display_name: string = "";
        if (request.generic_type.is_valid()) {
            const inst_for_name: Type* = this.arena.lookup(request.generic_type.id);
            if (inst_for_name != null) { display_name = this.arena.format_display(inst_for_name); }
        }

        // SWAP-RELOCATE identity path: a named generic whose request carries a
        // valid, still-unresolved InstantiatedType wrapper reuses THAT wrapper's
        // arena id for the concrete, so `wrapper.id == concrete.id` (one id per
        // semantic type).  Reserve the spec names against the wrapper NOW - a spec
        // body can reference itself by its bare/qualified spec name, and that must
        // resolve to the concrete's eventual id during resolve_specialized_ast.
        // The slot is flipped from wrapper to concrete at populate time (below).
        // For a named generic this is the ONLY construction route for a concrete;
        // the missing-wrapper case is an internal error (see the else branch).
        // Function templates are not `is_named` and never reach here - they get a
        // FunctionType bridged via `resolved_type` at the end of this function,
        // which stays a two-id representation (see the bridge below for why).
        mut concrete_type: TypeRef = TypeRef::invalid();
        mut swap_path: boolean = false;
        if (is_named) {
            const w_t: Type* = this.arena.lookup(request.generic_type.id);
            if (request.generic_type.is_valid() && w_t != null
                    && w_t.kind == TypeKind::InstantiatedType) {
                concrete_type = request.generic_type;
                swap_path = true;
                this.arena.reserve_spec_names(concrete_type, qualified_spec_sym, spec_name_sym, target_kind);
            } else {
                // INVARIANT (one id per semantic type): a named generic reaches
                // here only via the swap path above, so `wrapper.id == concrete.id`.
                // This branch is the older two-id fallback and is believed
                // unreachable - a probe over the compiler's own 232 modules, the
                // stdlib, and the full test suite recorded ZERO fires.  It is kept
                // (rather than deleted) so that a reachable case fails LOUDLY here
                // instead of silently minting a second id for one semantic type:
                // the wrapper's `resolved_type` is only set at the end of this
                // function, so any nested-call walk in between would see the two ids
                // disagree, leave its call unpinned, and let codegen's name+arity
                // fallback bind an arbitrary sibling spec.
                //
                // If you are reading this because it fired: the fix is to give the
                // request a valid unresolved InstantiatedType wrapper upstream, not
                // to relax this check.
                // Name the generic, don't just print its id: this ICE's stated fix
                // is "give the request a valid unresolved InstantiatedType wrapper
                // UPSTREAM", which is only actionable if you know WHICH generic to
                // go and look at.  Rendered as `Template<Arg, Arg>` to match the
                // sibling "specialization failed for %s<%s>" diagnostic above.
                //
                // Two things are deliberately NOT used here.  `qualified_spec_sym`
                // is the MANGLED spec symbol (`6Option$LN$L3std...$G$G`) - precise
                // but unreadable.  `arena.resolve_display_name(request.generic_type)`
                // is useless BY CONSTRUCTION: this branch is reached exactly when
                // that ref is not a valid InstantiatedType, so it renders "?".
                // `entry.qualified_name` + the already-built `type_arg_displays`
                // are always populated.  Bound to a const first, matching this
                // file's other `intern_table.resolve` sites - formatter results
                // live in a shared static buffer, so sibling display calls inside
                // one `format()` can clobber each other.
                const tmpl_name: string = this.intern_table.resolve(entry.qualified_name);
                mut ice_args: string = "";
                for (mut ii: i64 = 0; ii < type_arg_displays.length; ii++) {
                    if (ii > 0) { ice_args = format("%s, %s", ice_args, type_arg_displays[ii]); }
                    else        { ice_args = type_arg_displays[ii]; }
                }
                this.diagnostics.emit(Diagnostic::error(ErrorCode::E0900_INTERNAL_COMPILER_ERROR,
                    format("named generic `%s<%s>` (instantiation id %llu) reached monomorphization without an unresolved InstantiatedType wrapper, so its concrete type cannot reuse the wrapper's arena id (one id per semantic type)",
                        tmpl_name, ice_args, key)));
                this.state.error_count += 1;
                concrete_type = this.create_concrete_type(entry, qualified_spec_sym, &subst);
                // Register the bare spec name as an alias so resolve_body_locals()
                // can find the type (the substituter rewrites to bare names).
                if (concrete_type.is_valid() && !spec_name_sym.equals(qualified_spec_sym)) {
                    this.arena.add_name_alias(spec_name_sym, concrete_type);
                }
                if (concrete_type.is_valid() && display_name.length() > 0) {
                    const ct: Type* = this.arena.lookup(concrete_type.id);
                    if (ct != null) {
                        if (ct.kind == TypeKind::Struct)     { (ct as StructType*).set_display_name(display_name); }
                        else if (ct.kind == TypeKind::Enum)  { (ct as EnumType*).set_display_name(display_name); }
                        else if (ct.kind == TypeKind::Class) { (ct as ClassType*).set_display_name(display_name); }
                    }
                }
            }
        }

        // SCOPE-SWITCHED REGION (see matching restore at end of region).
        //
        // Temporarily switch the Resolver to the template's module scope so that
        // names imported by the template's module can be resolved.  !!! DO NOT add
        // early returns or `panic` between this line and the matching restore: the
        // resolver's scope state is process-global; bailing leaves the wrong scope
        // active for every subsequent specialization.
        mut saved_scope: u64 = 0;
        if (this.type_resolver.name_resolver != null && entry.module_name.is_valid()) {
            saved_scope = this.type_resolver.name_resolver.get_current_scope_id();
            const template_scope: u64 =
                this.type_resolver.name_resolver.find_module_scope(entry.module_name);
            if (template_scope > 0) {
                this.type_resolver.name_resolver.set_module_with_scope(
                    entry.module_name, template_scope);
            }
        }

        // Re-resolve type annotations on the specialized AST.  The InstantiatedType
        // wrapper (request.generic_type) is passed as `this_type` for method bodies.
        const this_type_for_methods: TypeRef = if (request.generic_type.is_valid()) {
            request.generic_type
        } else {
            concrete_type
        };
        // Compile-time `static match` arm pruning.  Runs AFTER substitution but
        // BEFORE resolve_specialized_ast, so dead arms are removed first.
        this.ast_resolver.prune_static_match_arms(result.specialized_ast, entry.node_kind, entry, &subst);
        for (mut ri: i64 = 0; ri < kept_impl_asts.length; ri++) {
            this.ast_resolver.prune_static_match_arms(kept_impl_asts[ri], NodeKind::ImplementationBlock, entry, &subst);
        }
        this.ast_resolver.resolve_specialized_ast(result.specialized_ast, entry.node_kind, entry, &subst, this_type_for_methods);
        for (mut ri: i64 = 0; ri < kept_impl_asts.length; ri++) {
            this.ast_resolver.resolve_specialized_ast(kept_impl_asts[ri], NodeKind::ImplementationBlock, entry, &subst, this_type_for_methods);
        }

        // Register the spec entry into `state.spec_entries` BEFORE specializing the
        // nested calls in its own bodies.  A spec's method body can make a generic
        // call on a receiver that resolves to the SAME spec being materialized - e.g.
        // `String<GlobalAlloc>`'s `FmtWrite::write_str` calls `this.try_push(source)`
        // on a `this: String` (bare, all-defaulted) receiver that
        // `canonicalize_default_template_recv` must map to `String<GlobalAlloc>` by
        // asking whether that instantiation has a registered spec.  Registering after
        // the walk would make that answer "no", so the receiver would stay bare, the
        // `try_push` lookup would fail, and the call would be left entirely
        // unpinned.  `kept_impl_asts` is MOVED into the
        // entry, so capture the impl-node pointers into a walk list first (they alias
        // the same nodes the entry now owns).
        mut walk_impls: ASTNode*[] = [];
        for (mut ri: i64 = 0; ri < kept_impl_asts.length; ri++) {
            walk_impls.push(kept_impl_asts[ri]);
        }
        const origin: SymbolStr = this.current_module;
        const spec_entry: SpecializationEntry = SpecializationEntry {
            specialized_type:  concrete_type,
            specialized_name:  spec_name_sym,
            ast_node:          result.specialized_ast,
            impl_nodes:        kept_impl_asts,
            origin_module:     origin,
            template_module:   entry.module_name,
            instantiated_type: request.generic_type,
            injected:          false,
            owner_source:      SymbolStr::empty(),
        };
        const idx: i64 = this.state.spec_entries.length;
        this.state.spec_entries.push(spec_entry);
        this.spec_index.insert(key, idx);
        this.state.mark_materialized_spec(request.generic_type);

        // Specialize the generic CALLS inside the freshly-resolved spec'd bodies
        // (e.g. `mem::offset<T>` inside `NonNull<i32>`'s methods, or a nested
        // generic free call inside a spec'd function).  These bodies are never in
        // the module root that `specialize_calls_in_module` traverses, and AST
        // re-resolution does not consume their call stashes - so this is the one
        // place a spec'd body's inner generic calls get pinned + enqueued.  The
        // `subst` concretizes any template-param binding the ASTTypeSubstituter
        // didn't reach in the clone (no-op on an already-concrete stash).  Each
        // queued function/type spec is itself drained + walked by the worklist
        // loop, so this is fully transitive.  (Walk via `walk_impls`, which aliases
        // the impl nodes now owned by the registered entry.)
        this.call_specializer.specialize_calls_in_spec_decl(result.specialized_ast, &subst);
        for (mut ri: i64 = 0; ri < walk_impls.length; ri++) {
            this.call_specializer.specialize_calls_in_spec_decl(walk_impls[ri], &subst);
        }

        // Populate the concrete type.  On the swap path, flip the wrapper slot to
        // the concrete IN PLACE first (one id per semantic type); the wrapper node
        // identity is copied onto the concrete so `inst_generic_base` recovers base +
        // type_args.  On the fallback path, bridge the wrapper to the freshly
        // allocated concrete via `resolved_type` (the pre-A2a mechanism).
        if (concrete_type.is_valid()) {
            if (swap_path) {
                this.arena.swap_wrapper_to_concrete(concrete_type, qualified_spec_sym,
                    entry.module_name, target_kind, is_union_kind, display_name);
            }
            this.type_populator.populate_concrete_type(concrete_type, result.specialized_ast, entry.node_kind, &subst, entry);

            if (!swap_path) {
                const inst_t: Type* = this.arena.lookup(request.generic_type.id);
                if (inst_t != null && inst_t.kind == TypeKind::InstantiatedType) {
                    (inst_t as InstantiatedType*).set_resolved_type(concrete_type);
                    // Record the concrete's intrinsic generic-instantiation identity:
                    // the instantiation it was built from (the `inst_*` views read this).
                    this.arena.set_type_generic_origin(concrete_type, request.generic_type);
                }
            }
        } else if (entry.node_kind == NodeKind::FunctionDeclaration) {
            // Function templates don't create named arena types, but still get a
            // concrete FunctionType so the InstantiatedType has a valid resolved_type.
            // (No generic origin: a FunctionType is not an aggregate and carries
            // no intrinsic instantiation identity.)
            //
            // Function specs are out of scope for single-id identity BY
            // CONSTRUCTION.  The aggregate swap (`swap_wrapper_to_concrete`)
            // installs the concrete at the wrapper's id so
            // `wrapper.id == concrete.id`.  That is impossible here, and the
            // reason is not a missing branch:
            //
            //   `get_function` interns a FunctionType on its SIGNATURE ALONE -
            //   `(kind, is_variadic, [ret, params...])`.  Nothing about WHICH
            //   function it came from is in the key.  So `identity<i32>` and
            //   `negate<i32>` - two distinct templates, two distinct wrappers, two
            //   distinct spec_entries - share ONE FunctionType id for `(i32)->i32`.
            //   One id cannot be assigned to two wrappers, so id-unification is
            //   arithmetically unavailable here.  Doing the swap for whichever spec
            //   arrives first and not the other would be strictly worse than this
            //   bridge.
            //
            // The two ids are also not two names for one thing: the WRAPPER is the
            // INSTANTIATION identity (FunctionTemplate base + type args, uniquely
            // keyed), the FunctionType is the SIGNATURE identity (structurally
            // keyed, deliberately SHARED across functions).  The one-id-per-type
            // invariant applies to TYPES - a function specialization is a code
            // artifact, not a type; its type is its signature, and that already has
            // canonical single-id identity through the interner.  `reserve_spec_names`
            // reinforces this: it writes only the struct/class/enum caches, so a
            // function spec has nothing to reserve.  Function specs are bound
            // downstream by MANGLED NAME, not by arena id, and
            // `SpecializationEntry.specialized_type` is deliberately invalid for
            // them - every consumer guards on `is_valid()`.
            const func_type: TypeRef = this.type_populator.build_function_type_from_ast(result.specialized_ast);
            if (func_type.is_valid()) {
                const inst_t: Type* = this.arena.lookup(request.generic_type.id);
                if (inst_t != null) {
                    // `set_signature`, NOT `set_resolved_type`: this records the
                    // spec's SIGNATURE, it does not claim the wrapper collapsed
                    // into it.  Same storage, different assertion.
                    (inst_t as InstantiatedType*).set_signature(func_type);
                }
            }
        }

        // Restore the Resolver's scope.  END SCOPE-SWITCHED REGION.
        if (saved_scope > 0 && this.type_resolver.name_resolver != null) {
            this.type_resolver.name_resolver.set_module_with_scope(
                this.current_module, saved_scope);
        }

        // Mark as monomorphized
        this.generic_registry.mark_monomorphized(request.base_type, request.type_args);
        // (The spec entry was registered ABOVE, before the nested-call walk, so the
        // walk could canonicalize self-referential generic calls to this spec.)

        // Discover nested instantiations from the concrete type's fields, or the
        // function type's param/return types (function templates).
        if (concrete_type.is_valid()) {
            this.state.nested_visited = [];
            this.state.request_nested_instantiations(concrete_type);
        } else if (entry.node_kind == NodeKind::FunctionDeclaration) {
            // Walk the SIGNATURE's param/return types for nested instantiations.
            // The checked accessor is deliberate: this path is only meaningful
            // for a FunctionType, and reading `resolved_type` raw would happily
            // hand back a collapsed aggregate concrete if the kinds ever drifted.
            const sig: TypeRef = this.arena.instantiation_signature(request.generic_type);
            if (sig.is_valid()) {
                this.state.nested_visited = [];
                this.state.request_nested_instantiations(sig);
            }
        }
        return true;
    }


    // Concrete type creation

    create_concrete_type(mut &this, entry: TemplateEntry*, spec_name: SymbolStr,
                         subst: TypeSubstitution*) -> TypeRef {
        return match (entry.node_kind) {
            NodeKind::StructDeclaration => {
                this.arena.create_struct(spec_name, entry.module_name)
            }
            NodeKind::UnionDeclaration => {
                this.arena.create_union(spec_name, entry.module_name)
            }
            NodeKind::EnumDeclaration => {
                this.arena.create_enum(spec_name, entry.module_name)
            }
            NodeKind::ClassDeclaration => {
                this.arena.create_class(spec_name, entry.module_name)
            }
            NodeKind::FunctionDeclaration => {
                // Generic functions don't create arena types; they just produce
                // specialized AST declarations.  Return invalid so
                // specialize_with_entry skips type population.
                TypeRef::invalid()
            }
            _ => {
                this.arena.create_struct(spec_name, entry.module_name)
            }
        };
    }


    // Name qualification

    /// Build a qualified specialized name from the template's qualified name and
    /// the bare specialized name.  E.g. "BattleTest::Pair" + "Pair_string" ->
    /// "BattleTest::Pair_string".  Bare spec name when the template has no namespace.
    qualify_spec_name(&this, entry: TemplateEntry*, spec_name: string) -> SymbolStr {
        const qualified_str: string = this.intern_table.resolve(entry.qualified_name);
        const bare_str: string = this.intern_table.resolve(entry.name);

        const q_len: i64 = qualified_str.length() as i64;
        const b_len: i64 = bare_str.length() as i64;
        if (q_len <= b_len) {
            return this.intern_table.intern(spec_name);
        }

        const prefix_len: i64 = q_len - b_len;
        const prefix: string = qualified_str.substr(0, prefix_len);
        return this.intern_table.intern(prefix + spec_name);
    }


    // Batch compilation support

    /// Reset transient per-module state while preserving the specialization cache
    /// and injection cursor.  Called between modules in StdlibBatch mode.
    reset_for_next_module(mut &this) -> void {
        this.state.reset_worklist();
    }

    /// Number of specializations completed.
    specialization_count(&this) -> i64 {
        return this.state.spec_entries.length;
    }

    /// Count specializations not yet routed into an owner module by Phase 6a-iii.
    uninjected_spec_count(&this) -> i64 {
        mut n: i64 = 0;
        for (mut i: i64 = 0; i < this.state.spec_entries.length; i++) {
            if (!this.state.spec_entries[i].injected) { n = n + 1; }
        }
        return n;
    }

    // -- Accessors for passes/specialization.cryo (SpecInjector + routing) --
    // Used by the pass instead of poking `spec_entries` / `injection_cursor` directly.

    /// Borrow spec entry `i` for inspection/mutation.  Null for out-of-range.
    spec_entry_at(mut &this, i: i64) -> SpecializationEntry* {
        if (i < 0 || i >= this.state.spec_entries.length) { return null; }
        return &this.state.spec_entries[i];
    }

    /// Current incremental injection cursor (first not-yet-emitted spec index).
    get_injection_cursor(&this) -> i64 {
        return this.injection_cursor;
    }

    /// Advance the injection cursor to the current spec count.
    advance_injection_cursor(mut &this) -> void {
        this.injection_cursor = this.state.spec_entries.length;
    }


    // Cache helpers (orchestrator-private)

    /// Build a cache key from a request: the CANONICAL INSTANTIATION ID for
    /// (base, args).
    ///
    /// The arena's structural interner already decides whether two instantiations
    /// are the same type, and answers with a single id - so ask it, rather than
    /// keeping a parallel `base<a,b>` string key that has to agree.  The id form
    /// also avoids a `format()` and an allocation on every probe of this cache,
    /// which sits in the worklist loop.
    ///
    /// Uses `create_instantiation`, NOT the pure `find_instantiation` lookup, for
    /// the same reason `GenericRegistry::mark_monomorphized` does: a lookup that
    /// can MISS would mint a different key for a request whose instantiation has
    /// not been interned yet, and two requests for one type would then not share
    /// a cache entry.  Interning makes the call idempotent - after the first, it
    /// is a hash probe that returns the existing id.
    ///
    /// Stable across the wrapper->concrete swap: the intern table stores an
    /// immutable COPY of each key and never re-derives it from the (mutated)
    /// node, so `(base, args)` still resolves to the same id after
    /// `swap_wrapper_to_concrete` installs the concrete in that slot.
    make_key(&this, request: &MonomorphRequest) -> u64 {
        return this.make_key_for(request.base_type, request.type_args);
    }

    make_key_for(&this, base: TypeRef, type_args: &TypeRef[]) -> u64 {
        return this.arena.create_instantiation(base, type_args).id;
    }

    /// Check if a key is already in the specialization cache.
    is_cached(&this, key: u64) -> boolean {
        return this.spec_index.get(&key).is_some();
    }

    /// Link a cache-hit request's InstantiatedType(s) to the previously computed
    /// concrete type.  Sema creates a fresh InstantiatedType per call site, so a
    /// later module revisiting an already-specialized pair stays unresolved unless
    /// we explicitly propagate.
    propagate_cached_resolution(mut &this, key: u64, request: &MonomorphRequest) -> void {
        const idx_opt: Option<i64> = this.spec_index.get(&key);
        if (!idx_opt.is_some()) { return; }
        const idx: i64 = idx_opt.unwrap();
        if (idx < 0 || idx >= this.state.spec_entries.length) { return; }
        const entry: SpecializationEntry* = &this.state.spec_entries[idx];
        if (!entry.specialized_type.is_valid()) { return; }
        // Resolve the request's OWN instantiation directly, mirroring the
        // first-time specialize path (which sets `resolved_type` on
        // `request.generic_type`).  This matters for a LOWER-arity form - e.g.
        // the 1-arg receiver `HashSet<String>` of a wrapper-type method, whose
        // request carries the default-expanded 2-arg `type_args` but references
        // the original 1-arg `generic_type`.  Without this, that receiver stays
        // unresolved after mono (E0900).
        const inst_t: Type* = this.arena.lookup(request.generic_type.id);
        if (inst_t != null && inst_t.kind == TypeKind::InstantiatedType) {
            (inst_t as InstantiatedType*).set_resolved_type(entry.specialized_type);
            this.arena.set_type_generic_origin(entry.specialized_type, request.generic_type);
        }
    }

}
