/// AST Specializer
///
/// Thin orchestrator for generic AST specialization: clone -> substitute -> return.
/// Used by the Monomorphizer to produce concrete AST declarations from generic
/// template entries.
///
/// Moved from `AST/specializer.cryo` into the `mono/` subsystem (namespace
/// `compiler::mono::specializer`): only the Monomorphizer calls it, so it is a
/// mono-exclusive collaborator, not a general AST utility.  Content is otherwise a
/// faithful port (it drives the still-shared `ASTCloner` + `ASTTypeSubstituter`,
/// which stay in `AST/`).

namespace compiler::mono::specializer;

import compiler::diag;
import compiler::ast;
import compiler::ast::{ cloner, declaration, node, substituter, TypeAnnotation };
import compiler::types;
import compiler::types::{ arena, type_ref, substitution, generic_registry };
import compiler::resolver::{ intern_table, symbol_str, qualified_name, mangled_name };
import std::alloc::allocator;
import std::core::mem::{ swap };
import std::fmt;
import compiler::ast::cloner::{ ASTCloner };
import compiler::ast::declaration::{ FunctionDeclNode, ImplBlockNode, MethodNode, VarDeclNode };
import compiler::ast::node::{ ASTNode };
import compiler::ast::substituter::{ ASTTypeSubstituter };
import compiler::resolver::intern_table::{ InternTable };
import compiler::resolver::mangled_name::{ MangledName };
import compiler::resolver::qualified_name::{ QualifiedName };
import compiler::resolver::symbol_str::{ SymbolStr };
import compiler::resolver::symbol_id;
import compiler::resolver::symbol_id::{ SymbolID };
import compiler::types::arena::{ TypeArena };
import compiler::types::generic_registry::{ GenericRegistry, TemplateEntry };
import compiler::types::substitution::{ TypeSubstitution };
import compiler::types::type_ref::{ TypeRef };
import compiler::types::resolver::{ ResolutionContext, TypeResolver };
import utils::text::{ Text };


// SpecializationResult: Output of a single specialization

type struct SpecializationResult {
    specialized_ast: ASTNode*;
    impl_asts:       ASTNode*[];
    spec_name:       string;
    success:         boolean;
    error_message:   string;

    static ok(ast: ASTNode*, impls: &ASTNode*[], name: string) -> SpecializationResult {
        // Own an INDEPENDENT copy of the impl-node pointer array.  `impls` is
        // borrowed (the caller's local buffer); taking it by value would alias
        // that buffer, which the caller frees on return - leaving this struct's
        // `impl_asts` dangling.  The elements are heap-stable node pointers; only
        // the array buffer is duplicated.
        mut impls_owned: ASTNode*[] = [];
        for (mut i: i64 = 0; i < impls.length; i++) { impls_owned.push(impls[i]); }
        return SpecializationResult {
            specialized_ast: ast,
            impl_asts:       impls_owned,
            spec_name:       name,
            success:         true,
            error_message:   "",
        };
    }

    static fail(message: Text) -> SpecializationResult {
        return SpecializationResult {
            specialized_ast: null,
            impl_asts:       [],
            spec_name:       "",
            success:         false,
            error_message:   message.as_string(),
        };
    }
}

type struct ASTSpecializer {
    arena:         TypeArena*;
    intern_table:  InternTable*;
    /// What a receiver's written type denotes: the filter below compares
    /// types, never spellings.
    type_resolver: TypeResolver*;


    static new(arena: TypeArena*, intern_table: InternTable*,
               type_resolver: TypeResolver*) -> ASTSpecializer {
        return ASTSpecializer {
            arena:         arena,
            intern_table:  intern_table,
            type_resolver: type_resolver,
        };
    }


    /// Specialize a generic template entry with the given concrete type arguments.
    ///
    /// Steps:
    ///   1. Build TypeSubstitution from entry's param IDs -> concrete type args
    ///   2. Generate the specialized identifier name (codegen produces the
    ///      LLVM linker symbol later via `MangledName::for_struct_type`)
    ///   3. Clone the generic AST
    ///   4. Run ASTTypeSubstituter on the clone
    ///   5. Clone + substitute each impl block
    ///   6. Return result
    /// `spec_typeref` is the arena id the specialization will occupy, passed
    /// through to the substituter so an annotation rewritten to the spec name
    /// carries its own answer.  `TypeRef::invalid()` is legal and means the
    /// caller has no id yet; see `ASTTypeSubstituter.spec_typeref`.
    specialize(&this, entry: TemplateEntry*, type_args: &TypeRef[],
               spec_typeref: TypeRef) -> SpecializationResult {
        // Validate
        if (entry == null) {
            return SpecializationResult::fail(Text::new("null template entry"));
        }
        if (type_args.length != entry.param_count) {
            return SpecializationResult::fail(
                Text::new(fmt::format("type argument count mismatch: expected %lld, got %lld",
                        entry.param_count, type_args.length)
)            );
        }

        // 1. Generate the specialized identifier through the central mangler
        //    so the encoding stays the single source of truth across
        //    specializer / sema / codegen.  For static method templates,
        //    `spec_base_name` folds the owner type's leaf into the bare
        //    name so two methods with the same leaf (e.g. `Request::parse`,
        //    `Response::parse`) don't collapse to identical symbols.
        const base_sym: SymbolStr = entry.spec_base_name(this.intern_table);
        const base_qname: QualifiedName = QualifiedName::from_symbol(base_sym);
        const spec_sym: SymbolStr = MangledName::specialized_identifier(
            this.intern_table, this.arena, base_qname, type_args);
        const spec_name: string = this.intern_table.resolve(spec_sym);

        // 2. Build substitution (borrows + copies `type_args`).
        const subst: TypeSubstitution = TypeSubstitution::from_params(
            entry.param_types, type_args
        );
        const subst_ptr: TypeSubstitution* =
            allocator::alloc(sizeof(TypeSubstitution), 16) as TypeSubstitution*;
        *subst_ptr = subst;

        // 3. Clone AST: using for_specialization() so the clone is created
        //    with the specialized name and empty generic_params from the
        //    start.  Post-clone field writes (set_name, generic_params = [])
        //    on class hierarchies with vtables are a known source of subtle
        //    codegen bugs; setting up the clone in one shot avoids the
        //    post-construction-mutation path entirely.
        mut cloner: ASTCloner = ASTCloner::for_specialization(spec_sym);
        const cloned_ast: ASTNode* = cloner.clone_node(entry.ast_node);
        if (cloned_ast == null) {
            return SpecializationResult::fail(Text::new("AST clone returned null"));
        }

        // 4. An independent copy of the parameter list (its element type is
        //    Copy): the substituter stores and owns its array, so handing it
        //    the template entry's own buffer would double-free it.
        mut ps_copy: SymbolID[] = [];
        for (mut pi: i64 = 0; pi < entry.param_syms.length; pi++) {
            ps_copy.push(entry.param_syms[pi]);
        }
        mut substituter: ASTTypeSubstituter* = new ASTTypeSubstituter(
            subst_ptr, this.arena, this.intern_table,
            entry.name, spec_sym,
            ps_copy, spec_typeref
        );
        cloned_ast.accept(substituter);

        // 5. Renaming is already done by the cloner (step 3).
        //    No post-clone set_name() needed.

        // 6. Clone + substitute each impl block, under the IMPL's own
        //    parameters.  An `implement` block declares its own parameters
        //    and writes the owner's arguments in them - `implement<X> trait
        //    Show for struct Holder<X>` - so its body is stamped with the
        //    impl's declarations, not the owner's, and only a substituter
        //    keyed by those rewrites it.  Each parameter the head writes at
        //    a position is bound to the specialization's argument at that
        //    position; an argument the head writes as a type (`Box<T,
        //    GlobalAlloc>`) binds nothing here, because the head was already
        //    selected against the arguments, and a parameter the head does
        //    not write (one the where-clause derives) is bound from the
        //    bounds once the clone is placed.
        mut impl_asts: ASTNode*[] = [];
        for (mut i: i64 = 0; i < entry.impl_blocks.length; i++) {
            const cloned_impl: ASTNode* = cloner.clone_node(entry.impl_blocks[i]);
            if (cloned_impl != null) {
                const impl_node: ImplBlockNode* = cloned_impl as ImplBlockNode*;
                mut impl_substituter: ASTTypeSubstituter* =
                    this.impl_substituter(impl_node, entry, spec_sym, type_args, spec_typeref);
                // Each parameter the head writes, bound to the argument at
                // its position: a receiver annotation in this block is
                // written in the head's parameters, and resolved under these
                // bindings it denotes a type of this specialization.
                mut head_ctx: ResolutionContext = ResolutionContext::new("");
                for (mut hi: i64 = 0; hi < impl_node.target_args.length && hi < type_args.length; hi++) {
                    const head_arg: TypeAnnotation* = impl_node.target_args[hi];
                    const head_sym: SymbolID = GenericRegistry::head_param_of(head_arg);
                    if (!head_sym.is_valid()) { continue; }
                    match (*head_arg) {
                        TypeAnnotation::Named(hn) => { head_ctx.add_binding(head_sym, hn.name, type_args[hi]); }
                        _ => {}
                    }
                }

                // Filter out methods whose `this` parameter is a Generic
                // instantiation of the outer template with other arguments
                // (e.g. `this: Result<T*, E>` on `implement Result<T, E>`).
                // Such methods apply only to specific outer T; monomorphizing
                // them for arbitrary T produces invalid code, since the body
                // uses the other shape (`*ptr` where ptr is actually T, not
                // T*).  Our pipeline monomorphizes eagerly, so we skip them
                // at specialization time.
                mut kept: MethodNode*[] = [];
                for (mut mi: i64 = 0; mi < impl_node.methods.length; mi++) {
                    const mthd: MethodNode* = impl_node.methods[mi];
                    const is_modified: boolean = this.method_has_modified_self_type(
                        mthd, entry, type_args, &head_ctx);
                    if (is_modified) {
                        continue;
                    }
                    kept.push(mthd);
                }
                // Reassign the owning-array field by SWAP, not `=`: a plain
                // assignment shallow-copies, leaving `impl_node.methods` aliasing
                // the local `kept` buffer, which is freed when `kept` drops at
                // scope exit - so the placed impl node would later read a freed
                // methods array (garbage MethodNode* -> a bare-scope / template-
                // shaped body leaking into codegen).  Swap hands the field `kept`'s
                // buffer and lets `kept` drop the old (pre-filter) one.
                swap(&impl_node.methods, &kept);

                cloned_impl.accept(impl_substituter);
                // Rename impl block target to specialized name and
                // clear generic params; the specialization is concrete.
                impl_node.set_target_type(spec_sym);
                impl_node.generic_params = [];
                impl_asts.push(cloned_impl);
            }
        }

        // 7. Return
        return SpecializationResult::ok(cloned_ast, &impl_asts, spec_name);
    }

    /// The substituter for one impl block of a specialization: the impl's
    /// parameters, each bound to the specialization's argument at the
    /// position the head writes it, in the order the head writes them.  A
    /// head that writes one parameter twice (`Pair<T, T>`) binds it once, at
    /// its first position; the head was selected against the arguments, so
    /// the second position holds the same type.  The arena's parameter type
    /// for each is minted at its head position, which is the identity every
    /// other consumer of the impl's parameters mints it under.
    ![allow(lookup_by_spelling, reason = "pending: this took a spelling before the lint existed, and why is not written yet")]
    impl_substituter(&this, impl_node: ImplBlockNode*, entry: TemplateEntry*,
                     spec_sym: SymbolStr, type_args: &TypeRef[],
                     spec_typeref: TypeRef) -> ASTTypeSubstituter* {
        mut syms: SymbolID[] = [];
        mut arena_ids: TypeRef[] = [];
        mut replacements: TypeRef[] = [];
        const n: i64 = if (impl_node.target_args.length < type_args.length) {
            impl_node.target_args.length
        } else {
            type_args.length
        };
        for (mut ti: i64 = 0; ti < n; ti++) {
            const ta: TypeAnnotation* = impl_node.target_args[ti];
            if (ta == null) { continue; }
            match (*ta) {
                TypeAnnotation::Named(named) => {
                    const sym: SymbolID = named.param_sym();
                    if (!sym.is_valid()) { continue; }
                    mut seen: boolean = false;
                    for (mut k: i64 = 0; k < syms.length; k++) {
                        if (syms[k].equals(sym)) { seen = true; break; }
                    }
                    if (seen) { continue; }
                    syms.push(sym);
                    arena_ids.push(this.arena.create_generic_param(sym, named.name, ti as u64));
                    replacements.push(type_args[ti]);
                }
                _ => {}
            }
        }
        const subst_ptr: TypeSubstitution* =
            allocator::alloc(sizeof(TypeSubstitution), 16) as TypeSubstitution*;
        *subst_ptr = TypeSubstitution::from_params(&arena_ids, &replacements);
        return new ASTTypeSubstituter(
            subst_ptr, this.arena, this.intern_table,
            entry.name, spec_sym,
            syms, spec_typeref);
    }


    /// Whether `method`'s receiver is typed as this template instantiated
    /// with arguments other than the specialization's.  Example on
    /// `implement Result<T, E>` specialized as `Result<i32, string>`:
    ///   `this: Result<T*, E>` denotes `Result<i32*, string>` -> drop it;
    ///   `this: Result<T, E>` denotes `Result<i32, string>`   -> keep it;
    ///   `this: Result<i32, E>` denotes `Result<i32, string>` -> keep it.
    /// `head_ctx` binds each parameter the impl's head writes to the
    /// specialization's argument at its position.
    method_has_modified_self_type(&this, method: MethodNode*, entry: TemplateEntry*,
                                   type_args: &TypeRef[],
                                   head_ctx: ResolutionContext*) -> boolean {
        if (method == null || method.func == null) { return false; }
        const func: FunctionDeclNode* = method.func;

        for (mut i: i64 = 0; i < func.parameters.length; i++) {
            const param: VarDeclNode* = func.parameters[i];
            if (param == null) { continue; }
            if (!param.is_receiver()) { continue; }
            if (param.type_annotation == null) { continue; }
            if (this.annotation_is_modified_outer(
                param.type_annotation, entry, type_args, head_ctx)) {
                return true;
            }
        }
        return false;
    }

    /// Through references and pointers, whether `ann` is a use of the
    /// template `entry` instantiated with arguments other than the
    /// specialization's.  The written type is compared as the type it
    /// denotes, resolved under `head_ctx`: one spelling can name two types
    /// (`Point` from two modules), and two spellings one type (`T` and the
    /// argument it is bound to; an alias and the template it names).
    /// Only a written instantiation is asked: a bare name is the receiver
    /// the parser gives a method that wrote none, and it names the owner.
    annotation_is_modified_outer(&this, ann: TypeAnnotation*, entry: TemplateEntry*,
                                  type_args: &TypeRef[],
                                  head_ctx: ResolutionContext*) -> boolean {
        if (ann == null) { return false; }
        match (*ann) {
            TypeAnnotation::Reference(ref) => {
                return this.annotation_is_modified_outer(ref.inner, entry, type_args, head_ctx);
            }
            TypeAnnotation::Pointer(ptr) => {
                return this.annotation_is_modified_outer(ptr.inner, entry, type_args, head_ctx);
            }
            TypeAnnotation::Generic(_) => {
                const denoted: TypeRef = this.type_resolver.resolve(ann, head_ctx);
                if (!this.arena.inst_generic_base(denoted).equals(entry.base_type)) { return false; }
                if (this.arena.inst_type_arg_count(denoted) != type_args.length) { return false; }
                for (mut i: i64 = 0; i < type_args.length; i++) {
                    if (!this.arena.inst_type_arg_at(denoted, i).equals(type_args[i])) { return true; }
                }
                return false;
            }
            _ => { return false; }
        }
    }
}
