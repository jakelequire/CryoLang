/// Mono Dispatch Annotator  (compiler::mono::dispatch_annotator)
///
/// Bound-directed dispatch annotation, a pre-mono AST pass.
///
/// Annotates method calls with a disambiguating trait so the monomorphizer's
/// trait-impl method lookups pick the right impl when a type implements two
/// traits that declare a same-named method (the canonical case: `Display::fmt`
/// vs `Debug::fmt`).  The information that disambiguates them - a `where T: Debug`
/// bound, or the enclosing trait-impl's trait - is only available
/// PRE-monomorphization (once a generic is substituted to a concrete type the
/// bound is gone), so this runs over EVERY decl (generic templates included)
/// before mono clones anything; the cloner copies `resolved_trait` onto every
/// spec.
///
/// Three rules:
///   1. Param receiver: `recv.m()` where `recv` is a parameter whose annotation
///      head is a generic param bounded by exactly ONE trait -> that trait.
///   2. Trait-impl recursion: a call to the enclosing method's own name inside a
///      trait-impl method -> the impl's trait.
///   3. Static path: `T::m(..)` where `T` is a generic param bounded by exactly
///      ONE trait -> that trait (the same bound, read at the scope segment).
///
/// Plain `type struct` collaborator: back-pointers set by `wire()`, no recursion
/// seam (it walks the AST directly).

namespace compiler::mono::dispatch_annotator;

import compiler::ast;
import compiler::ast::{
    declaration, expression, node, NodeKind, pattern, statement, TraitBound, TraitRef,
    TypeAnnotation
};
import compiler::types::{ arena, type_ref, generic };
import compiler::resolver::{ symbol_str, intern_table };
import compiler::ast::declaration::{
    ClassDeclNode, DeclarationNode, FunctionDeclNode, ImplBlockNode, MethodNode,
    StructDeclNode, UnionDeclNode, VarDeclNode
};
import compiler::ast::expression::{
    ArrayAccessNode, ArrayLiteralNode, BinaryExprNode, CallExprNode, CastExprNode,
    ExpressionNode, IdentifierNode, MemberAccessNode, ScopeResolutionNode, StructLiteralNode, TryExprNode,
    UnaryExprNode
};
import compiler::ast::node::{ ASTNode, ProgramNode };
import compiler::ast::pattern::{ MatchArmNode, StaticMatchArmNode };
import compiler::ast::statement::{
    BlockStmtNode, DeclStmtNode, ExprStmtNode, ForStmtNode, IfStmtNode, LoopStmtNode,
    MatchStmtNode, ReturnStmtNode, StatementNode, StaticMatchStmtNode, UnsafeBlockStmtNode,
    WhileStmtNode
};
import compiler::resolver::intern_table::{ InternTable };
import compiler::resolver::symbol_str::{ SymbolStr };
import compiler::resolver::res::{ DefId };
import compiler::resolver::symbol_id;
import compiler::resolver::symbol_id::{ SymbolID };
import compiler::types::arena::{ TypeArena };


type struct MonoDispatchAnnotator {
    arena:  TypeArena*;
    intern: InternTable*;

    static null() -> MonoDispatchAnnotator {
        return MonoDispatchAnnotator {
            arena:  null,
            intern: null,
        };
    }

    wire(mut &this, arena: TypeArena*, intern: InternTable*) -> void {
        this.arena  = arena;
        this.intern = intern;
    }


    annotate_bound_dispatch_in_module(mut &this, root: ProgramNode*) -> void {
        if (root == null) { return; }
        mut no_bounds: TraitBound[] = [];
        const no_trait: DefId = DefId::invalid();
        for (mut i: i64 = 0; i < root.statements.length; i++) {
            const stmt: ASTNode* = root.statements[i];
            if (stmt == null) { continue; }
            match (stmt.kind) {
                NodeKind::FunctionDeclaration => {
                    const f: FunctionDeclNode* = stmt as FunctionDeclNode*;
                    this.annotate_dispatch_in_func(f, f.trait_bounds, no_trait);
                }
                NodeKind::StructDeclaration => {
                    const sn: StructDeclNode* = stmt as StructDeclNode*;
                    this.annotate_dispatch_in_methods(sn.methods, no_bounds, no_trait);
                }
                NodeKind::UnionDeclaration => {
                    const un: UnionDeclNode* = stmt as UnionDeclNode*;
                    this.annotate_dispatch_in_methods(un.methods, no_bounds, no_trait);
                }
                NodeKind::ClassDeclaration => {
                    const cn: ClassDeclNode* = stmt as ClassDeclNode*;
                    this.annotate_dispatch_in_methods(cn.methods, no_bounds, no_trait);
                }
                NodeKind::ImplementationBlock => {
                    const ib: ImplBlockNode* = stmt as ImplBlockNode*;
                    // The trait's identity as the head was stamped, not the
                    // annotation's leaf: the stamp on the call is compared
                    // against a method's `origin_trait`, which is this same
                    // canonical name.
                    mut trait_id: DefId = DefId::invalid();
                    if (ib.is_trait_impl()) { trait_id = ib.trait_def; }
                    this.annotate_dispatch_in_methods(ib.methods, ib.where_bounds, trait_id);
                }
                _ => {}
            }
        }
    }

    annotate_dispatch_in_methods(mut &this, methods: &MethodNode*[],
                                 impl_bounds: &TraitBound[],
                                 trait_id: DefId) -> void {
        for (mut k: i64 = 0; k < methods.length; k++) {
            const m: MethodNode* = methods[k];
            if (m == null || m.func == null) { continue; }
            // Rule 1 needs the param's bound, which may be impl-level
            // (`implement<T> ... where T: Debug`) or method-level; merge both.
            mut bounds: TraitBound[] = [];
            for (mut a: i64 = 0; a < impl_bounds.length; a++) {
                bounds.push(impl_bounds[a].clone());
            }
            for (mut b: i64 = 0; b < m.func.trait_bounds.length; b++) {
                bounds.push(m.func.trait_bounds[b].clone());
            }
            this.annotate_dispatch_in_func(m.func, bounds, trait_id);
        }
    }

    annotate_dispatch_in_func(mut &this, func: FunctionDeclNode*,
                              bounds: &TraitBound[],
                              enclosing_trait: DefId) -> void {
        if (func == null || func.body == null) { return; }
        this.annotate_dispatch_stmt(func.body as StatementNode*, func, bounds,
                                    enclosing_trait);
    }

    /// Apply the two annotation rules to a single method-call's MemberAccess.
    annotate_dispatch_member(mut &this, ma: MemberAccessNode*,
                             func: FunctionDeclNode*, bounds: &TraitBound[],
                             enclosing_trait: DefId) -> void {
        if (ma == null) { return; }
        if (ma.resolved_trait.is_valid()) { return; }
        // Rule 1: receiver is a parameter typed as a single-bounded generic.
        const obj_node: ASTNode* = ma.object as ASTNode*;
        if (obj_node != null && obj_node.kind == NodeKind::Identifier) {
            const id: IdentifierNode* = ma.object as IdentifierNode*;
            for (mut p: i64 = 0; p < func.parameters.length; p++) {
                const param: VarDeclNode* = func.parameters[p];
                if (param == null) { continue; }
                if (!param.name.equals(id.name)) { continue; }
                const head: SymbolID = this.param_head_of_ann(param.type_annotation);
                if (head.is_valid()) {
                    const tr: DefId = this.single_bound_trait_for(head, bounds);
                    if (tr.is_valid()) {
                        ma.set_resolved_trait(tr);
                        return;
                    }
                }
                break;
            }
        }
        // Rule 2: recursive same-named call inside a trait-impl method.
        if (enclosing_trait.is_valid() && ma.member.equals(func.name)) {
            ma.set_resolved_trait(enclosing_trait);
        }
    }

    /// Rule 3, the static path: `T::m(..)` where `T` is a generic parameter
    /// of the enclosing function bounded by exactly ONE trait names that
    /// trait's `m` - `T` has no inherent methods where the call is written,
    /// and the bound is the only thing that says what `m` is, exactly as a
    /// parameter receiver's bound does in rule 1.  Once `T` is substituted
    /// the bound is gone and the concrete type may implement two traits
    /// providing `m`; the stamp is what keeps the written meaning.  A path
    /// the writer qualified with a head (`(Beta for T)::m`) is already
    /// directed and is left alone; a parameter with two bounds is left to
    /// the tie the concrete instantiation reports.  The scope segment is a
    /// parameter exactly when a bound names it - a where-clause bounds the
    /// function's or the impl's parameters and nothing else - so the bound
    /// list is the one question, as it is for rule 1's receiver.
    annotate_dispatch_path(mut &this, sr: ScopeResolutionNode*, bounds: &TraitBound[]) -> void {
        if (sr == null || sr.impl_trait != null || sr.resolved_trait.is_valid()) { return; }
        const tr: DefId = this.single_bound_trait_for(
            sr.scope_res.relative_param_sym(), bounds);
        if (tr.is_valid()) { sr.set_resolved_trait(tr); }
    }

    /// Return the identity of the single trait bounding the parameter `param`,
    /// or empty when the param has zero or more-than-one bound trait
    /// (ambiguous - leave the dispatch to its default), or when `param` names
    /// no parameter.  The bound's stamped identity, not its written leaf: two
    /// traits may share a leaf, and the stamp on the call is compared against
    /// a method's `origin_trait`.
    single_bound_trait_for(&this, param: SymbolID,
                           bounds: &TraitBound[]) -> DefId {
        mut found: DefId = DefId::invalid();
        mut count: i64 = 0;
        if (!param.is_valid()) { return found; }
        for (mut i: i64 = 0; i < bounds.length; i++) {
            const b: TraitBound* = &bounds[i];
            if (!b.subject_sym.equals(param)) { continue; }
            for (mut j: i64 = 0; j < b.trait_refs.length; j++) {
                const tr: TraitRef* = &b.trait_refs[j];
                if (tr.path.length == 0) { continue; }
                found = tr.definition();
                count += 1;
            }
        }
        if (count == 1) { return found; }
        return DefId::invalid();
    }

    annotate_dispatch_stmt(mut &this, stmt: StatementNode*,
                           func: FunctionDeclNode*, bounds: &TraitBound[],
                           enclosing_trait: DefId) -> void {
        if (stmt == null) { return; }
        const node: ASTNode* = stmt as ASTNode*;
        match (node.kind) {
            NodeKind::ExpressionStatement => {
                const es: ExprStmtNode* = stmt as ExprStmtNode*;
                this.annotate_dispatch_expr(es.expression, func, bounds, enclosing_trait);
            }
            NodeKind::DeclarationStatement => {
                const ds: DeclStmtNode* = stmt as DeclStmtNode*;
                const inner: DeclarationNode* = ds.declaration;
                if (inner != null && (inner as ASTNode*).kind == NodeKind::VariableDeclaration) {
                    const vd: VarDeclNode* = inner as VarDeclNode*;
                    if (vd.initializer != null) {
                        this.annotate_dispatch_expr(vd.initializer, func, bounds, enclosing_trait);
                    }
                }
            }
            NodeKind::ReturnStatement => {
                const rs: ReturnStmtNode* = stmt as ReturnStmtNode*;
                if (rs.expression != null) {
                    this.annotate_dispatch_expr(rs.expression, func, bounds, enclosing_trait);
                }
            }
            NodeKind::BlockStatement => {
                const bs: BlockStmtNode* = stmt as BlockStmtNode*;
                for (mut i: i64 = 0; i < bs.statements.length; i++) {
                    this.annotate_dispatch_stmt(bs.statements[i], func, bounds, enclosing_trait);
                }
            }
            NodeKind::UnsafeBlockStatement => {
                // Annotated like any other block: `unsafe` governs raw-pointer
                // ownership, not how a call dispatches.  Mirrors the same case
                // in `call_specializer`, which walks bodies for the identical
                // reason and was missing it too.
                const ub: BlockStmtNode* = (stmt as UnsafeBlockStmtNode*).block;
                for (mut i: i64 = 0; i < ub.statements.length; i++) {
                    this.annotate_dispatch_stmt(ub.statements[i], func, bounds, enclosing_trait);
                }
            }
            NodeKind::IfStatement => {
                const ifs: IfStmtNode* = stmt as IfStmtNode*;
                this.annotate_dispatch_expr(ifs.condition, func, bounds, enclosing_trait);
                if (ifs.then_stmt != null) {
                    this.annotate_dispatch_stmt(ifs.then_stmt, func, bounds, enclosing_trait);
                }
                if (ifs.has_else() && ifs.else_stmt != null) {
                    this.annotate_dispatch_stmt(ifs.else_stmt, func, bounds, enclosing_trait);
                }
            }
            NodeKind::WhileStatement => {
                const ws: WhileStmtNode* = stmt as WhileStmtNode*;
                this.annotate_dispatch_expr(ws.condition, func, bounds, enclosing_trait);
                if (ws.body != null) {
                    this.annotate_dispatch_stmt(ws.body, func, bounds, enclosing_trait);
                }
            }
            NodeKind::ForStatement => {
                const fs: ForStmtNode* = stmt as ForStmtNode*;
                if (fs.condition != null) {
                    this.annotate_dispatch_expr(fs.condition, func, bounds, enclosing_trait);
                }
                if (fs.body != null) {
                    this.annotate_dispatch_stmt(fs.body, func, bounds, enclosing_trait);
                }
            }
            NodeKind::LoopStatement => {
                const ls: LoopStmtNode* = stmt as LoopStmtNode*;
                if (ls.body != null) {
                    this.annotate_dispatch_stmt(ls.body, func, bounds, enclosing_trait);
                }
            }
            NodeKind::MatchStatement => {
                const ms: MatchStmtNode* = stmt as MatchStmtNode*;
                this.annotate_dispatch_expr(ms.subject, func, bounds, enclosing_trait);
                for (mut i: i64 = 0; i < ms.arms.length; i++) {
                    const arm: MatchArmNode* = ms.arms[i];
                    if (arm == null) { continue; }
                    if (arm.guard != null) {
                        this.annotate_dispatch_expr(arm.guard, func, bounds, enclosing_trait);
                    }
                    if (arm.body != null) {
                        this.annotate_dispatch_stmt(arm.body, func, bounds, enclosing_trait);
                    }
                }
            }
            NodeKind::StaticMatchStatement => {
                const sm: StaticMatchStmtNode* = stmt as StaticMatchStmtNode*;
                for (mut i: i64 = 0; i < sm.arms.length; i++) {
                    const arm: StaticMatchArmNode* = sm.arms[i];
                    if (arm != null && arm.body != null) {
                        this.annotate_dispatch_stmt(arm.body, func, bounds, enclosing_trait);
                    }
                }
            }
            _ => {}
        }
    }

    annotate_dispatch_expr(mut &this, expr: ExpressionNode*,
                           func: FunctionDeclNode*, bounds: &TraitBound[],
                           enclosing_trait: DefId) -> void {
        if (expr == null) { return; }
        const node: ASTNode* = expr as ASTNode*;
        match (node.kind) {
            NodeKind::CallExpression => {
                const call: CallExprNode* = expr as CallExprNode*;
                if (call.callee != null
                        && (call.callee as ASTNode*).kind == NodeKind::MemberAccess) {
                    this.annotate_dispatch_member(
                        call.callee as MemberAccessNode*, func, bounds, enclosing_trait);
                }
                for (mut i: i64 = 0; i < call.arguments.length; i++) {
                    this.annotate_dispatch_expr(call.arguments[i], func, bounds, enclosing_trait);
                }
                if (call.callee != null) {
                    this.annotate_dispatch_expr(call.callee, func, bounds, enclosing_trait);
                }
            }
            NodeKind::MemberAccess => {
                const ma: MemberAccessNode* = expr as MemberAccessNode*;
                this.annotate_dispatch_expr(ma.object, func, bounds, enclosing_trait);
            }
            // Rule 3, wherever the path stands: a call's callee, or the
            // method taken as a value.
            NodeKind::ScopeResolution => {
                this.annotate_dispatch_path(expr as ScopeResolutionNode*, bounds);
            }
            NodeKind::BinaryExpression => {
                const be: BinaryExprNode* = expr as BinaryExprNode*;
                this.annotate_dispatch_expr(be.left, func, bounds, enclosing_trait);
                this.annotate_dispatch_expr(be.right, func, bounds, enclosing_trait);
            }
            NodeKind::UnaryExpression => {
                const ue: UnaryExprNode* = expr as UnaryExprNode*;
                this.annotate_dispatch_expr(ue.operand, func, bounds, enclosing_trait);
            }
            NodeKind::TryExpression => {
                const te: TryExprNode* = expr as TryExprNode*;
                this.annotate_dispatch_expr(te.operand, func, bounds, enclosing_trait);
            }
            NodeKind::ArrayAccess => {
                const aa: ArrayAccessNode* = expr as ArrayAccessNode*;
                this.annotate_dispatch_expr(aa.array, func, bounds, enclosing_trait);
                this.annotate_dispatch_expr(aa.index, func, bounds, enclosing_trait);
            }
            NodeKind::CastExpression => {
                const ce: CastExprNode* = expr as CastExprNode*;
                this.annotate_dispatch_expr(ce.expression, func, bounds, enclosing_trait);
            }
            NodeKind::StructLiteral => {
                const sl: StructLiteralNode* = expr as StructLiteralNode*;
                for (mut i: i64 = 0; i < sl.field_inits.length; i++) {
                    this.annotate_dispatch_expr(sl.field_inits[i].value, func, bounds, enclosing_trait);
                }
            }
            NodeKind::ArrayLiteral => {
                const al: ArrayLiteralNode* = expr as ArrayLiteralNode*;
                for (mut i: i64 = 0; i < al.elements.length; i++) {
                    this.annotate_dispatch_expr(al.elements[i], func, bounds, enclosing_trait);
                }
            }
            _ => {}
        }
    }

    /// Recursively unwrap a parameter's annotation to its `Named` head - the
    /// generic parameter a `&T` / `T*` / `Box<T>` is written over - which is
    /// the name a `where` bound is keyed by.
    param_head_of_ann(&this, ann: TypeAnnotation*) -> SymbolID {
        if (ann == null) { return SymbolID::invalid(); }
        return match (*ann) {
            TypeAnnotation::Named(na)     => { na.param_sym() }
            TypeAnnotation::Generic(ga)   => { this.param_head_of_ann(ga.base) }
            TypeAnnotation::Reference(ra) => { this.param_head_of_ann(ra.inner) }
            TypeAnnotation::Pointer(pa)   => { this.param_head_of_ann(pa.inner) }
            _                             => { SymbolID::invalid() }
        };
    }
}
