/// Mono Call Specializer  (compiler::mono::call_specializer)
///
/// The sema-stash CONSUMER.  Walks a module's call sites and, for each generic
/// free-function / method / static call that sema already resolved, mints the
/// per-call specialization: pins the specialized callee symbol on the call,
/// queues the function-template instantiation, and (for generic methods) clones +
/// re-resolves a concrete method sibling and registers it in the DeclarationIndex.
///
/// Semantic analysis ran FIRST and stashed every generic call's concrete type
/// arguments on `CallExpr.resolved_type_args`, and typed every
/// receiver/argument expression.  This collaborator READS those - it NEVER
/// re-derives them.  Bindings come from the stash, the receiver type from
/// `ma.object.resolved_type`.  What remains is template/method LOOKUP,
/// where-bound checking, and the clone+substitute+register mechanics - none of
/// which is inference.

namespace compiler::mono::call_specializer;

import compiler::ast;
import compiler::ast::{
    ArgBinding, declaration, expression, MemberPin, node, pattern, statement, TraitBound,
    TraitRef, TypeAnnotation
};
import compiler::types::{
    generic, user_defined, compound, type_base, arena, type_ref, substitution, resolver, generic_registry, ownership, TypeKind, RefMutability
};
import compiler::diag;
import compiler::diag::{ diagnostic, ErrorCode, sink, source_span };
import compiler::decl_index;
import compiler::decl_index::{ DeclarationIndex };
import compiler::resolver::{ intern_table, symbol_str, qualified_name, mangled_name };
import compiler::resolver::{ res };
import compiler::resolver::lang_item;
import compiler::resolver::lang_item::{ LangItem };
import compiler::mono::{ state, trait_specializer, ast_resolver };
import std::alloc::allocator;
import compiler::ast::cloner;
import compiler::ast::cloner::{ ASTCloner };
import compiler::ast::substituter;
import compiler::ast::substituter::{ ASTTypeSubstituter };
import compiler::ast::walk;
import compiler::ast::walk::{ Walk };
import std::fmt;
import compiler::ast::declaration::{
    DeclarationNode, DeclKind, DestructureDecl, FunctionDecl, GenericParamDecl,
    ImplBlock, MethodDecl, StructDecl, UnionDecl, VarDecl
};
import compiler::ast::expression::{
    CalleePin,
    CallExpr,
    ExprKind, ExpressionNode, IdentifierExpr,
    MemberAccessExpr, ScopeResolutionExpr
};
import compiler::ast::node::{ ProgramNode };
import compiler::ast::pattern::{ MatchArmNode, StaticMatchArmNode };
import compiler::ast::statement::{ Stmt, StmtKind };
import compiler::diag::diagnostic::{ Diagnostic };
import compiler::diag::sink::{ DiagnosticSink };
import compiler::mono::ast_resolver::{ MonoAstResolver };
import compiler::mono::state::{ MonoState, SpecializationEntry };
import compiler::mono::trait_specializer::{ MonoTraitSpecializer };
import compiler::resolver::intern_table::{ InternTable };
import compiler::resolver::res::{ FamilyOwner, Res, ResBase, ResSlot };
import compiler::decl_index::{ OverloadId };
import compiler::resolver::symbol_str::{ SymbolStr };
import compiler::resolver::res::{ DefId, DefKey };
import compiler::resolver::symbol_id;
import compiler::resolver::symbol_id::{ SymbolID };
import compiler::types::arena::{ TypeArena };
import compiler::types::compound::{
    ArrayType, FunctionType, OptionalType, PointerType, ReferenceType, TupleType
};
import compiler::types::generic::{ InstantiatedType };
import compiler::types::generic_registry::{ GenericRegistry, TemplateEntry, TemplateKind };
import compiler::types::resolver::{ ResolutionContext, TypeResolver };
import compiler::types::substitution::{ TypeSubstitution };
import compiler::types::type_base::{ Type };
import compiler::types::type_ref::{ TypeRef };
import compiler::types::user_defined::{ FieldInfo, StructType };


/// A walked call with no pin, and the function whose body holds it.
type struct UnpinnedCall {
    call: ExpressionNode*;
    func: DeclarationNode*;
}

type struct MonoCallSpecializer {
    arena:            TypeArena*;
    generic_registry: GenericRegistry*;
    intern_table:     InternTable*;
    diagnostics:      DiagnosticSink*;
    type_resolver:    TypeResolver*;
    decl_index:       DeclarationIndex*;
    state:            MonoState*;
    trait_spec:       MonoTraitSpecializer*;
    ast_resolver:     MonoAstResolver*;
    current_source_file: SymbolStr;
    /// Calls bound by identity to a method of a receiver or owner whose
    /// instantiation was not minted when the call was walked: a copy's body
    /// is walked once, when it is made, often before the instantiations it
    /// names are.  Each is bound once the instantiation is registered
    /// (`bind_queued_calls`).
    queued_binds:     [CallExpr*];
    /// A generic owner's methods taken as values (`Wrap::get`) whose owner
    /// instance was not minted when the value was walked; each is bound to
    /// that instance's method once it is (`bind_queued_calls`).
    queued_path_values: [ExpressionNode*];
    /// The function whose body the walk is in, for the report of a call
    /// left unbound.
    current_fn:       DeclarationNode*;
    /// Every walked call that had no pin when the walk left it, with the
    /// function holding it.  A call is bound by a pin, or by what it calls
    /// through (a local of function type, a variant, a function-typed field,
    /// a release); one bound by nothing is reported once monomorphization
    /// has bound everything it will (`report_unbound_calls`).
    unpinned_calls:   [UnpinnedCall];

    static null() -> MonoCallSpecializer {
        return MonoCallSpecializer {
            arena:            null,
            generic_registry: null,
            intern_table:     null,
            diagnostics:      null,
            type_resolver:    null,
            decl_index:       null,
            state:            null,
            trait_spec:       null,
            ast_resolver:     null,
            current_source_file: SymbolStr::empty(),
            queued_binds:     [],
            queued_path_values: [],
            current_fn:       null,
            unpinned_calls:   [],
        };
    }

    wire(mut &this, arena: TypeArena*, generic_registry: GenericRegistry*,
                    intern_table: InternTable*, diagnostics: DiagnosticSink*,
                    type_resolver: TypeResolver*, decl_index: DeclarationIndex*,
                    state: MonoState*, trait_spec: MonoTraitSpecializer*,
                    ast_resolver: MonoAstResolver*) -> void {
        this.arena            = arena;
        this.generic_registry = generic_registry;
        this.intern_table     = intern_table;
        this.diagnostics      = diagnostics;
        this.type_resolver    = type_resolver;
        this.decl_index       = decl_index;
        this.state            = state;
        this.trait_spec       = trait_spec;
        this.ast_resolver     = ast_resolver;
    }

    set_current_source_file(mut &this, file: SymbolStr) -> void {
        this.current_source_file = file;
    }


    // -- Module walk (replaces discover_inferred_calls_in_module) --

    /// Walk every non-generic top-level declaration's body and specialize each
    /// generic free/method/static call from sema's stash.  Generic carriers are
    /// skipped: their bodies are walked per-instantiation when their own spec is
    /// materialized (the body-rewalk inside specialize_method).
    specialize_calls_in_module(mut &this, root: ProgramNode*) -> void {
        if (root == null) { return; }
        mut res_ctx: ResolutionContext = ResolutionContext::new("");
        for (mut i: i64 = 0; i < root.statements.length; i++) {
            const stmt: DeclarationNode* = root.statements[i].as_decl();
            if (stmt == null) { continue; }
            match (stmt.kind) {
                DeclKind::Function(func) => {
                    const func_decl: DeclarationNode* = stmt;
                    if (func.is_generic()) { continue; }
                    this.walk_func_body(func_decl, &res_ctx);
                }
                DeclKind::Struct(sn) => {
                    if (sn.is_generic()) { continue; }
                    this.walk_methods(sn.methods, &res_ctx);
                }
                DeclKind::Impl(ib) => {
                    if (ib.generic_params.length > 0) { continue; }
                    this.walk_methods(ib.methods, &res_ctx);
                }
                DeclKind::Union(un) => {
                    if (un.is_generic()) { continue; }
                    this.walk_methods(un.methods, &res_ctx);
                }
                DeclKind::Variable(vd) => {
                    // A module's global: its initializer is code like a
                    // body's, computed at program start when no fold
                    // answers it, so its calls and values are specialized
                    // as a body's are.
                    if (vd.initializer != null) { this.walk_expr(vd.initializer, &res_ctx, null); }
                }
                DeclKind::Destructure(_) | DeclKind::Enum(_) | DeclKind::Extern(_)
                | DeclKind::Field(_) | DeclKind::GenericParam(_) | DeclKind::Import(_)
                | DeclKind::Intrinsic(_) | DeclKind::Module(_) | DeclKind::Trait(_)
                | DeclKind::TypeAlias(_) | DeclKind::Variant(_) | DeclKind::Method(_) => {}
            }
        }
    }

    walk_methods(mut &this, methods: &[DeclarationNode*], res_ctx: ResolutionContext*) -> void {
        for (mut k: i64 = 0; k < methods.length; k++) {
            const m_decl: DeclarationNode* = methods[k];
            const m: MethodDecl* = DeclarationNode::method_of(m_decl);
            if (m == null || m.func == null) { continue; }
            if (DeclarationNode::fn_of(m.func).is_generic()) { continue; }
            if (MonoCallSpecializer::body_is_lazy(m.func)) { continue; }
            this.walk_func_body(m.func, res_ctx);
        }
    }

    /// A body instantiated only at a call site (a self-returning trait default,
    /// a self-growing inherent method) is never emitted from the declaration it
    /// sits in, and is not walked from there either: its calls name adapters
    /// over the owner (`TakeIter<This>::new`), and specializing them eagerly
    /// demands the adapter, whose impl carries the same default, without end.
    /// The lazy clone made for a call site is walked when it is made.
    static body_is_lazy(func_decl: DeclarationNode*) -> boolean {
        const func: FunctionDecl* = DeclarationNode::fn_of(func_decl);
        return func.is_self_returning_default || func.is_lazy_self_growing;
    }

    walk_func_body(mut &this, func_decl: DeclarationNode*, res_ctx: ResolutionContext*) -> void {
        // No local-variable table is built: sema typed every expression, so the
        // receiver/argument types come from `resolved_type`, not a mono mini-sema.
        this.walk_body(func_decl, res_ctx, null);
    }

    /// Walk `func`'s body under `subst`, as the function the calls in it
    /// are reported in.
    walk_body(mut &this, func_decl: DeclarationNode*, res_ctx: ResolutionContext*,
              subst: TypeSubstitution*) -> void {
        const func: FunctionDecl* = DeclarationNode::fn_of(func_decl);
        if (func == null || func.body == null) { return; }
        const outer_decl: DeclarationNode* = this.current_fn;
        this.current_fn = func_decl;
        this.walk_stmt(func.body, res_ctx, subst);
        this.current_fn = outer_decl;
    }

    /// Walk a freshly-specialized declaration's bodies and specialize the generic
    /// calls inside them, threading the active `subst`.  The orchestrator calls
    /// this right after `resolve_specialized_ast`: a spec'd type's / function's
    /// body is NOT in the module root the `specialize_calls_in_module` walk
    /// traverses, and `resolve_func_and_body` does not re-derive its inner calls
    /// via inference, so the only place a spec'd body's `mem::offset<T>`-style
    /// generic calls get consumed (and the resulting fn/type specializations
    /// enqueued) is here.  `subst` concretizes any template-param binding the
    /// ASTTypeSubstituter didn't reach in the clone (no-op on an already-concrete
    /// stash).  Generic instance/static methods are handled per-call by the
    /// method-call path, so only non-generic carrier bodies are walked.
    specialize_calls_in_spec_decl(mut &this, decl: DeclarationNode*,
                                  subst: TypeSubstitution*) -> void {
        if (decl == null) { return; }
        mut res_ctx: ResolutionContext = ResolutionContext::new("");
        match ((decl as DeclarationNode*).kind) {
            DeclKind::Function(_) => {
                const f_decl: DeclarationNode* = decl;
                this.walk_body(f_decl, &res_ctx, subst);
            }
            DeclKind::Struct(sn) => { this.walk_spec_methods(sn.methods, &res_ctx, subst); }
            DeclKind::Impl(ib) => { this.walk_spec_methods(ib.methods, &res_ctx, subst); }
            DeclKind::Union(un) => { this.walk_spec_methods(un.methods, &res_ctx, subst); }
            DeclKind::Destructure(_) | DeclKind::Enum(_) | DeclKind::Extern(_)
            | DeclKind::Field(_) | DeclKind::GenericParam(_) | DeclKind::Import(_)
            | DeclKind::Intrinsic(_) | DeclKind::Module(_) | DeclKind::Trait(_)
            | DeclKind::TypeAlias(_) | DeclKind::Variable(_) | DeclKind::Variant(_)
            | DeclKind::Method(_) => {}
        }
    }

    walk_spec_methods(mut &this, methods: &[DeclarationNode*], res_ctx: ResolutionContext*,
                      subst: TypeSubstitution*) -> void {
        for (mut k: i64 = 0; k < methods.length; k++) {
            const m_decl: DeclarationNode* = methods[k];
            const m: MethodDecl* = DeclarationNode::method_of(m_decl);
            if (m == null || m.func == null) { continue; }
            if (DeclarationNode::fn_of(m.func).is_generic()) { continue; }
            if (MonoCallSpecializer::body_is_lazy(m.func)) { continue; }
            this.walk_body(m.func, res_ctx, subst);
        }
    }


    // -- Body walk: find generic calls, dispatch to the per-call consumers --

    walk_stmt(mut &this, stmt: Stmt*, res_ctx: ResolutionContext*,
              subst: TypeSubstitution*) -> void {
        if (stmt == null) { return; }
        match (stmt.kind) {
            StmtKind::Expr(es) => {
                this.walk_expr(es.expression, res_ctx, subst);
            }
            StmtKind::Decl(ds) => {
                const inner: DeclarationNode* = ds.declaration;
                const dd: DestructureDecl* = DeclarationNode::destructure_of(inner);
                if (dd != null) {
                    this.walk_expr(dd.initializer, res_ctx, subst);
                }
                const vd: VarDecl* = DeclarationNode::var_of(inner);
                if (vd != null) {
                    if (vd.initializer != null) {
                        this.walk_expr(vd.initializer, res_ctx, subst);
                        // Sema already typed this binding to a concrete
                        // instantiation (e.g. an adapter CHAIN result
                        // `CopiedIter<RefIter<i32>>` whose receiver is a
                        // method-call temporary mono can't reconstruct).  Treat
                        // sema's binding type as the demand and enqueue it
                        // directly; enqueue_from_type_ref is a guarded no-op unless
                        // it is a registered template with fully concrete args.
                        if (vd.resolved_type.is_valid()) {
                            mut bind_ty: TypeRef = vd.resolved_type;
                            if (subst != null) { bind_ty = subst.apply(bind_ty, this.arena); }
                            this.state.enqueue_from_type_ref(bind_ty);
                        }
                    }
                }
            }
            StmtKind::Return(rs) => {
                if (rs.expression != null) {
                    this.walk_expr(rs.expression, res_ctx, subst);
                }
            }
            StmtKind::Block(b) => {
                for (mut i: i64 = 0; i < b.statements.length; i++) {
                    this.walk_stmt(b.statements[i], res_ctx, subst);
                }
            }
            StmtKind::UnsafeBlock(ub) => {
                // `unsafe` marks who is responsible for raw-pointer ownership;
                // it says nothing about instantiation, so the body specializes
                // exactly like any other block.  Missing this case left a
                // generic call reachable ONLY from inside an `unsafe` block
                // with no specialization enqueued, and codegen then failed to
                // resolve the bare template name (E0636).
                this.walk_stmt(ub.block, res_ctx, subst);
            }
            StmtKind::If(ifs) => {
                this.walk_expr(ifs.condition, res_ctx, subst);
                this.walk_stmt(ifs.then_stmt, res_ctx, subst);
                this.walk_stmt(ifs.else_stmt, res_ctx, subst);
            }
            StmtKind::While(ws) => {
                this.walk_expr(ws.condition, res_ctx, subst);
                this.walk_stmt(ws.body, res_ctx, subst);
            }
            StmtKind::DoWhile(dw) => {
                this.walk_stmt(dw.body, res_ctx, subst);
                this.walk_expr(dw.condition, res_ctx, subst);
            }
            StmtKind::For(fs) => {
                // The initializer is a declaration or an expression.
                const init_var: VarDecl* = DeclarationNode::var_of(fs.init.as_decl());
                if (init_var != null) {
                    this.walk_expr(init_var.initializer, res_ctx, subst);
                } else if (fs.init.as_expr() != null) {
                    this.walk_expr(fs.init.as_expr(), res_ctx, subst);
                }
                if (fs.condition != null) { this.walk_expr(fs.condition, res_ctx, subst); }
                if (fs.update != null) { this.walk_expr(fs.update, res_ctx, subst); }
                this.walk_stmt(fs.body, res_ctx, subst);
            }
            StmtKind::Loop(ls) => {
                this.walk_stmt(ls.body, res_ctx, subst);
            }
            StmtKind::Match(ms) => {
                this.walk_expr(ms.subject, res_ctx, subst);
                for (mut i: i64 = 0; i < ms.arms.length; i++) {
                    const arm: MatchArmNode* = ms.arms[i];
                    if (arm == null) { continue; }
                    if (arm.guard != null) { this.walk_expr(arm.guard, res_ctx, subst); }
                    this.walk_stmt(arm.body, res_ctx, subst);
                }
            }
            StmtKind::StaticMatch(sm) => {
                for (mut i: i64 = 0; i < sm.arms.length; i++) {
                    const arm: StaticMatchArmNode* = sm.arms[i];
                    if (arm != null) {
                        this.walk_stmt(arm.body, res_ctx, subst);
                    }
                }
            }
            StmtKind::Asm(_) | StmtKind::Break | StmtKind::Continue => {}
        }
    }

    walk_expr(mut &this, expr: ExpressionNode*, res_ctx: ResolutionContext*,
              subst: TypeSubstitution*) -> void {
        if (expr == null) { return; }
        match (expr.kind) {
            ExprKind::Call(call) => {
                for (mut i: i64 = 0; i < call.arguments.length; i++) {
                    this.walk_expr(call.arguments[i], res_ctx, subst);
                }
                if (call.callee != null) {
                    this.walk_expr(call.callee, res_ctx, subst);
                }
                // A path the type check refused names nothing to bind; it was
                // reported where the generic body was written.
                const callee_path: ScopeResolutionExpr* = if (call.callee != null) {
                    ExpressionNode::scope_resolution_of(call.callee)
                } else { null };
                if (callee_path != null && callee_path.refused) { return; }
                this.specialize_free_call(expr, call, res_ctx, subst);
                this.specialize_method_call(call, subst);
                this.bind_call_arguments(call);
                if (!call.resolved_callee.is_some()) {
                    this.unpinned_calls.push(UnpinnedCall { call: expr, func: this.current_fn });
                }
            }
            ExprKind::MemberAccess(ma) => { this.walk_expr(ma.object, res_ctx, subst); }
            ExprKind::ScopeResolution(sr) => {
                // The body is a copy of one whose type check refused this path.
                if (sr.refused) { return; }
                this.specialize_path_fn_value(sr, subst);
                this.bind_path_value(expr, sr, subst);
            }
            // A bare identifier carrying turbofish args is a generic
            // function-reference VALUE (`tramp<i32>` passed/cast/assigned).
            ExprKind::Identifier(id) => { this.specialize_fn_value_ref(id, subst); }
            ExprKind::Ternary(te) => {
                this.walk_expr(te.condition, res_ctx, subst);
                this.walk_expr(te.true_expr, res_ctx, subst);
                this.walk_expr(te.false_expr, res_ctx, subst);
            }
            ExprKind::Cast(ce) => { this.walk_expr(ce.expression, res_ctx, subst); }
            ExprKind::ArrayAccess(aa) => {
                this.walk_expr(aa.array, res_ctx, subst);
                this.walk_expr(aa.index, res_ctx, subst);
                // An index-operator-overload desugar (`*(a.index(i))`)
                // is a method call that may need specialization (e.g.
                // `Vec<i32>::index`); walk it so nested/generic
                // instantiations are discovered.
                if (aa.desugared_call != null) {
                    this.walk_expr(aa.desugared_call, res_ctx, subst);
                }
            }
            ExprKind::Binary(be) => {
                this.walk_expr(be.left, res_ctx, subst);
                this.walk_expr(be.right, res_ctx, subst);
                if (be.desugar_by_bound && be.desugared_call != null
                        && this.operand_takes_primitive_operator(be.left, subst, true)) {
                    be.desugared_call = null;
                }
                // An operator-overload desugar (`a.add(&b)`) is a method
                // call that may need specialization (e.g. `Vec<i32>::add`);
                // walk it so nested/generic instantiations are discovered.
                if (be.desugared_call != null) {
                    this.walk_expr(be.desugared_call, res_ctx, subst);
                }
            }
            ExprKind::Unary(ue) => {
                this.walk_expr(ue.operand, res_ctx, subst);
                if (ue.desugar_by_bound && ue.desugared_call != null
                        && this.operand_takes_primitive_operator(ue.operand, subst, false)) {
                    ue.desugared_call = null;
                }
                if (ue.desugared_call != null) {
                    this.walk_expr(ue.desugared_call, res_ctx, subst);
                }
            }
            ExprKind::Match(me) => {
                this.walk_expr(me.subject, res_ctx, subst);
                for (mut i: i64 = 0; i < me.arms.length; i++) {
                    const arm: MatchArmNode* = me.arms[i];
                    if (arm == null) { continue; }
                    if (arm.guard != null) { this.walk_expr(arm.guard, res_ctx, subst); }
                    if (arm.body != null) { this.walk_stmt(arm.body, res_ctx, subst); }
                }
            }
            ExprKind::StaticMatch(sme) => {
                for (mut i: i64 = 0; i < sme.arms.length; i++) {
                    const arm: StaticMatchArmNode* = sme.arms[i];
                    if (arm != null && arm.body != null) {
                        this.walk_stmt(arm.body, res_ctx, subst);
                    }
                }
            }
            ExprKind::If(ie) => {
                this.walk_expr(ie.condition, res_ctx, subst);
                this.walk_expr(ie.then_expr, res_ctx, subst);
                this.walk_expr(ie.else_expr, res_ctx, subst);
            }
            ExprKind::Delete(d) => { this.walk_expr(d.operand, res_ctx, subst); }
            ExprKind::Struct(sl) => {
                for (mut i: i64 = 0; i < sl.field_inits.length; i++) {
                    this.walk_expr(sl.field_inits[i].value, res_ctx, subst);
                }
            }
            ExprKind::Array(al) => {
                for (mut i: i64 = 0; i < al.elements.length; i++) {
                    this.walk_expr(al.elements[i], res_ctx, subst);
                }
            }
            ExprKind::Tuple(tl) => {
                for (mut i: i64 = 0; i < tl.elements.length; i++) {
                    this.walk_expr(tl.elements[i], res_ctx, subst);
                }
            }
            ExprKind::New(ne) => {
                for (mut i: i64 = 0; i < ne.arguments.length; i++) {
                    this.walk_expr(ne.arguments[i], res_ctx, subst);
                }
                if (ne.array_size != null) { this.walk_expr(ne.array_size, res_ctx, subst); }
                if (ne.struct_init != null) {
                    this.walk_expr(ne.struct_init, res_ctx, subst);
                }
            }
            // The desugared `match` is what is emitted - its subject
            // is the operand, and its error arm builds the early return.
            ExprKind::Try(te) => {
                if (te.desugared != null) {
                    this.walk_expr(te.desugared, res_ctx, subst);
                } else {
                    this.walk_expr(te.operand, res_ctx, subst);
                }
            }
            // Not walked: a type operand, a literal, and the operands
            // of `typeof` and `yield`, which hold no call this pass binds.
            ExprKind::Sizeof(_) | ExprKind::Alignof(_) | ExprKind::Typeof(_)
            | ExprKind::Yield(_) | ExprKind::Literal(_) => { }
            // Not walked here either: this walk does not enter an
            // `await`'s operand.
            ExprKind::Await(_) => { }
            ExprKind::Lambda(le) => {
                // A non-capturing lambda compiles to a function of its
                // own body, which nothing else walks.  A capturing one's
                // body is its closure struct's `__call__`, walked as
                // that struct's method; walking it here as well would
                // bind it twice.
                if (!le.is_capturing() && le.body != null) {
                    this.walk_stmt(le.body, res_ctx, subst);
                }
            }
        }
    
    }


    /// Whether an operand a bound gave an operator's trait is, in this copy,
    /// a type the primitive operator applies to: anything but a user type,
    /// once no type parameter is left in it.  A user type overloads through
    /// its implementation of the trait, which the bound guarantees.  For a
    /// binary operator (`keep_on_reference`), a reference operand keeps the
    /// bound's method whatever it refers to: the method compares or combines
    /// the referents, as `Eq` on a reference does, where the primitive
    /// operator would compare the addresses - `&i64 == &i64` included.
    operand_takes_primitive_operator(&this, operand: ExpressionNode*, subst: TypeSubstitution*,
                                     keep_on_reference: boolean) -> boolean {
        if (operand == null) { return false; }
        mut ty: TypeRef = operand.resolved_type;
        if (subst != null) { ty = subst.apply(ty, this.arena); }
        if (this.arena.contains_generic_param(ty)) { return false; }
        const t: Type* = this.arena.lookup(ty);
        if (t == null) { return false; }
        if (keep_on_reference && t.kind == TypeKind::Reference) { return false; }
        return t.kind != TypeKind::Struct
            && t.kind != TypeKind::Enum && t.kind != TypeKind::InstantiatedType;
    }

    /// Concretize one stashed type-arg: apply the active specialization, then
    /// reduce any associated-type projection the substitution left standing.
    ///
    /// Substitution rewrites a projection's BASE (`S::ReadFut` ->
    /// `Ticker::ReadFut`) but never the projection itself, and a projection is
    /// free of generic params once its base is concrete - so it survives the
    /// `contains_generic_param` guards and gets MANGLED into the specialized
    /// callee name, which names a specialization nothing ever emits (E0636).
    /// Reducing it here yields the impl's bound member (`ReadyN`).
    concretize_stashed_arg(mut &this, b_in: TypeRef, subst: TypeSubstitution*) -> TypeRef {
        mut b: TypeRef = b_in;
        if (subst != null) { b = subst.apply(b, this.arena); }
        return this.trait_spec.reduce_projections(b);
    }

    // -- Free-function call specialization (consumes call.resolved_type_args) --

    /// Pin a specialized callee on a generic free-function call so codegen can
    /// resolve it, and queue the instantiation.  Bindings come from sema's stash
    /// (`call.resolved_type_args`); a call without a stash is outside sema's
    /// visibility and is left unspecialized.
    specialize_free_call(mut &this, call_e: ExpressionNode*, call: CallExpr*,
                         res_ctx: ResolutionContext*, subst: TypeSubstitution*) -> void {
        if (call == null) { return; }
        if (call.resolved_callee.is_some()) { return; }
        if (call.callee == null) { return; }
        const callee_node: ExpressionNode* = call.callee;

        // A path's scope segment's own answer, which says whether it names a
        // type or a module.
        mut callee_scope_slot: ResSlot* = null;
        const sr: ScopeResolutionExpr* = ExpressionNode::scope_resolution_of(callee_node);
        if (sr != null) {
            callee_scope_slot = &sr.scope_res;
            this.bind_on_substituted_owner(call, sr);
        } else if (ExpressionNode::identifier_of(callee_node) == null) {
            return;
        }

        mut entry: TemplateEntry* = null;
        // Sema's pin wins outright when present: it was decided with the
        // caller's import scope in hand, which is not reconstructible here.
        if (call.resolved_template.is_valid()) {
            const pinned: TemplateEntry* =
                this.generic_registry.template_of_type(call.resolved_template);
            if (pinned != null && pinned.kind == TemplateKind::Function) {
                entry = pinned;
            }
        }
        if (entry == null && callee_scope_slot != null) {
            // Whether the scope names a TYPE or a MODULE is what the segment's
            // stamp records: `TypeRelative` is the claim that a type owns the
            // member, and a `Def` names the module by its own namespace.  The
            // written spelling is any whole-segment suffix of the real name and
            // several modules can share one, so it is not asked.
            if (this.decl_index != null) {
                const scope_names_type: boolean =
                    match (callee_scope_slot.require("specialize_free_call scope")) {
                        Res::TypeRelative(_, _) => { true }
                        _                       => { false }
                    };
                // A module-qualified call names the template sema recorded
                // (`resolved_template`, read above); one that recorded none
                // names no template, and nothing here looks it up again.
                if (scope_names_type) {
                    // Scope resolves to a TYPE: this may be a non-generic static
                    // method on a GENERIC owner (`Slice<T>::from_raw`,
                    // `String<GA>::from_string`).  Sema stashed the owner's type args;
                    // consume them.  When handled (callee pinned + owner enqueued),
                    // stop - there is no free-function template to instantiate.
                    const sr2: ScopeResolutionExpr* = ExpressionNode::scope_resolution_of(call.callee);
                    if (this.specialize_static_method_on_generic_owner(call, sr2, subst)) {
                        return;
                    }
                }
            }
        }
        // A bare call names the template sema recorded for it
        // (`resolved_template`, read above); one that recorded none names no
        // template, and nothing here looks it up again.
        if (entry == null) { return; }
        const tmpl_func_decl: DeclarationNode* = entry.ast_node;
        const tmpl_func: FunctionDecl* = DeclarationNode::fn_of(tmpl_func_decl);
        if (tmpl_func == null) { return; }

        // Seed bindings from sema's stash (the source of truth).  Apply the active
        // specialization `subst`: a stash on a template body holds the enclosing
        // template's params; this spec concretizes them (no-op on a concrete stash).
        if (entry.param_types.length == 0) { return; }
        if (call.resolved_type_args.length != entry.param_types.length) {
            // No (or partial) stash: outside sema's visibility; leave unspecialized.
            // (Candidate to HARDEN to an ICE; left as a soft return for now.)
            return;
        }
        mut bindings: [TypeRef] = [];
        mut all_bound: boolean = true;
        for (mut i: i64 = 0; i < call.resolved_type_args.length; i++) {
            const b: TypeRef = this.concretize_stashed_arg(call.resolved_type_args[i], subst);
            if (!b.is_valid()) { all_bound = false; break; }
            bindings.push(b);
        }
        if (!all_bound) { return; }

        // Where-clause bound check at the call site.  If the bindings don't satisfy
        // the function's `where T: Trait` clauses, emit a diagnostic and skip
        // pin + queue (which suppresses the cascade from the rejected body).
        if (!this.check_function_bounds_at_call(call_e, call, tmpl_func_decl, entry, &bindings)) {
            return;
        }

        // Pin the instance + queue it.  The instance is the template's
        // placeholder instantiated with the arguments, the one its copy is
        // registered under.
        const new_inst: TypeRef = this.generic_registry.instantiate(
            entry.base_type, bindings);
        if (!new_inst.is_valid()) { return; }
        call.set_resolved_callee(CalleePin::Instance(new_inst));
        // Seed mono's pending worklist directly: the registry only tracks
        // cache_keys, and drain_pending_worklist iterates `pending`.
        this.state.enqueue_from_type_ref(new_inst);
    }

    /// A generic function used as a first-class value: pin the instance of
    /// it sema chose - the template applied to the type arguments sema kept
    /// on the node (`value_template` applied to `value_type_args`),
    /// concretized by the active specialization - and queue the
    /// instantiation.  No-op for an identifier with none.
    specialize_fn_value_ref(mut &this, ident: IdentifierExpr*, subst: TypeSubstitution*) -> void {
        if (ident == null) { return; }
        if (ident.value_type_args.length == 0 || ident.resolved_callee.is_some()) { return; }
        if (this.generic_registry == null) { return; }
        const inst: TypeRef = this.value_instance(
            this.generic_registry.template_of_type(ident.value_template), &ident.value_type_args, subst);
        if (inst.is_valid()) { ident.set_resolved_callee(CalleePin::Instance(inst)); }
    }

    /// The path form of `specialize_fn_value_ref`: a module's generic
    /// function taken as a value, `m::idf`.
    specialize_path_fn_value(mut &this, scope: ScopeResolutionExpr*, subst: TypeSubstitution*) -> void {
        if (!scope.value_template.is_valid() || scope.resolved_callee.is_some()) { return; }
        if (this.generic_registry == null) { return; }
        const inst: TypeRef = this.value_instance(
            this.generic_registry.template_of_type(scope.value_template), &scope.value_type_args, subst);
        if (inst.is_valid()) { scope.set_resolved_callee(CalleePin::Instance(inst)); }
    }

    /// The instance of the function template `entry` a value names: the
    /// template applied to `args`, concretized by the active
    /// specialization, and queued.  Invalid when an argument stays abstract.
    value_instance(mut &this, entry: TemplateEntry*, args: &[TypeRef], subst: TypeSubstitution*) -> TypeRef {
        if (entry == null || this.generic_registry == null) { return TypeRef::invalid(); }
        if (entry.kind != TemplateKind::Function) { return TypeRef::invalid(); }
        if (args.length != entry.param_types.length) { return TypeRef::invalid(); }
        mut seeded: [TypeRef] = [];
        for (mut i: i64 = 0; i < args.length; i++) {
            const tr: TypeRef = this.concretize_stashed_arg(args[i], subst);
            if (!tr.is_valid() || this.arena.contains_generic_param(tr)) { return TypeRef::invalid(); }
            seeded.push(tr);
        }
        const new_inst: TypeRef = this.generic_registry.instantiate(entry.base_type, seeded);
        if (new_inst.is_valid()) { this.state.enqueue_from_type_ref(new_inst); }
        return new_inst;
    }


    // -- Method-call specialization (consumes call.resolved_type_args) --

    /// Where the method `m` is held for the receiver `recv_type`: a
    /// declaration (`out_owner`) - the receiver's specialization's, or a
    /// non-generic owner's own - or an impl block (`out_impl`) - one placed
    /// under the receiver's specialization, an inherent block, or a trait
    /// impl selected for the receiver.  Found by the node's identity, among
    /// the stores the receiver's method sets are read from; false when none
    /// holds it.  This is where an instance of `m` is added.
    method_placement(&this, m_decl: DeclarationNode*, recv_type: TypeRef,
                     out_impl: DeclarationNode**, out_owner: DeclarationNode**) -> boolean {
        for (mut i: i64 = 0; i < this.state.spec_entries.length; i++) {
            const entry: SpecializationEntry* = &this.state.spec_entries[i];
            if (!entry.specialized_type.equals(recv_type)) { continue; }
            if (MethodDecl::is_method_of(m_decl,entry.ast_node)) { *out_owner = entry.ast_node; return true; }
            for (mut j: i64 = 0; j < entry.impl_nodes.length; j++) {
                if (MethodDecl::is_method_of(m_decl,entry.impl_nodes[j])) {
                    *out_impl = entry.impl_nodes[j];
                    return true;
                }
            }
        }
        if (this.generic_registry == null) { return false; }
        const owner_ast: DeclarationNode* = this.generic_registry.lookup_inherent_owner(recv_type);
        if (MethodDecl::is_method_of(m_decl,owner_ast)) { *out_owner = owner_ast; return true; }
        const inherent: [DeclarationNode*] = this.generic_registry.inherent_impl_blocks(recv_type);
        for (mut bi: i64 = 0; bi < inherent.length; bi++) {
            if (MethodDecl::is_method_of(m_decl,inherent[bi])) { *out_impl = inherent[bi]; return true; }
        }
        const traits: [DeclarationNode*] = this.generic_registry.trait_impls_of(recv_type, this.intern_table);
        for (mut bi: i64 = 0; bi < traits.length; bi++) {
            if (MethodDecl::is_method_of(m_decl,traits[bi])) { *out_impl = traits[bi]; return true; }
        }
        return false;
    }

    /// The type of `m`'s receiver parameter (`&this` of `S` is `&S`);
    /// invalid for a method with none.
    static receiver_param_type(m_decl: DeclarationNode*) -> TypeRef {
        const m: MethodDecl* = DeclarationNode::method_of(m_decl);
        if (m.func == null || DeclarationNode::fn_of(m.func).parameters.length == 0) { return TypeRef::invalid(); }
        const recv_decl: DeclarationNode* = DeclarationNode::fn_of(m.func).parameters[0];
        const recv: VarDecl* = DeclarationNode::var_of(recv_decl);
        if (recv == null || !recv.is_receiver()) { return TypeRef::invalid(); }
        return recv.resolved_type;
    }

    /// Specialize a generic method call from sema's method-level binding stash.
    ///   * RECEIVER: `ma.object.resolved_type` (sema-pinned).
    ///   * BINDINGS: the method's own generics come from `call.resolved_type_args`
    ///     (sema's stash).
    ///   * ADAPTER RECEIVERS: there is no synchronous `ensure_receiver_inst_resolved`
    ///     (it would need the orchestrator's spec cache).  Instead the unwrap loop leaves
    ///     an unresolved adapter inst alone, and
    ///     the run_monomorphization walk/drain FIXPOINT resolves the chained call on a
    ///     later iteration (sema pre-types adapter returns as concrete InstantiatedTypes).
    specialize_method_call(mut &this, call: CallExpr*, subst: TypeSubstitution*) -> void {
        if (call == null) { return; }
        // A call naming its method by definition is bound by that identity
        // once its receiver is minted, to the receiver's own method.  What
        // this specializes is a method's own type parameters, and no method
        // language item has any.
        if (call.named_method.is_valid()) {
            this.bind_named_call(call, subst);
            return;
        }
        // A call pinned to a method with nothing left to instantiate - one
        // with no type parameters of its own, or an instance minted for an
        // earlier walk of this call - needs no work, so a re-walk over the
        // same call (fixpoint) lands here and short-circuits.  A default
        // instantiated per call (`take`/`filter`/`map`/...) has no type
        // parameters of its own and is still a template: it falls through to
        // the binding by identity below, which instantiates it
        // (`instantiate_deferred`).
        const pinned: OverloadId = call.resolved_callee.decl_entry();
        if (pinned.is_valid()) {
            const rm_decl: DeclarationNode* = this.decl_index.entry_method(pinned);
            const rm: MethodDecl* = DeclarationNode::method_of(rm_decl);
            if (rm != null && rm.func != null
                    && DeclarationNode::fn_of(rm.func).generic_params.length == 0
                    && !DeclarationNode::fn_of(rm.func).is_self_returning_default
                    && !DeclarationNode::fn_of(rm.func).is_lazy_self_growing) {
                return;
            }
        }
        if (call.callee == null) { return; }
        const callee_node: ExpressionNode* = call.callee;
        // The receiver.  `recv.m(args)` writes it before the member.  A path
        // call `Owner::m(recv, args)` passes it first, and sema recorded the
        // generic method's definition the path names (`path_method`): the
        // method is that declaration, not one found again by name here.
        mut ma: MemberAccessExpr* = null;
        mut recv_expr: ExpressionNode* = null;
        mut path_method: DeclarationNode* = null;
        if (ExpressionNode::member_access_of(callee_node) != null) {
            ma = ExpressionNode::member_access_of(call.callee);
            recv_expr = ma.object;
        } else if (ExpressionNode::scope_resolution_of(callee_node) != null) {
            const recorded: DeclarationNode* = this.decl_index.method_decl_of(call.template_method);
            if (recorded == null || DeclarationNode::method_of(recorded) == null) { return; }
            path_method = recorded;
            if (DeclarationNode::method_of(path_method).func == null) { return; }
            if (DeclarationNode::fn_of(DeclarationNode::method_of(path_method).func).generic_params.length == 0 || call.arguments.length == 0) { return; }
            recv_expr = call.arguments[0];
        } else {
            return;
        }

        // RECEIVER from sema (invariant #1): sema typed every receiver.  Apply the
        // active spec subst (the call may be walked inside a still-generic spec body).
        // In a specialized body the cloner reset the receiver expression's
        // `resolved_type`; for the member-access shape (`this.h.relay(w)`) the type
        // is reconstructed structurally from the (carried) object type + the named
        // field, which is spec-local and authoritative - no re-inference.
        //
        // A path call's receiver is the owner of the declaration the path
        // names, read off that method's own receiver parameter: the argument
        // is only what is passed to it, and a clone's argument carries no
        // type.  An owner that still mentions a type parameter is a generic
        // owner's template method, which no specialization here answers.
        //
        // A call carrying a template pin carries the receiver it was
        // selected on, substituted for this copy of the body: that is the
        // receiver, and nothing is reconstructed for it.  So does a call a
        // bound answered, on the bounded receiver.
        mut recv_type: TypeRef = recv_expr.resolved_type;
        if (path_method != null) {
            recv_type = MonoCallSpecializer::receiver_param_type(path_method);
            if (!recv_type.is_valid() || this.arena.contains_generic_param(recv_type)) { return; }
        } else if (call.template_method.is_valid()) {
            recv_type = call.template_recv;
            if (!recv_type.is_valid()) { return; }
        } else if (ma != null && ma.resolved_trait.is_valid() && ma.resolved_trait_slot >= 0
                && call.template_recv.is_valid()) {
            recv_type = call.template_recv;
        }
        if (!recv_type.is_valid()) { return; }
        if (subst != null) { recv_type = subst.apply(recv_type, this.arena); }
        recv_type = this.receiver_owner(recv_type);
        mut t: Type* = this.arena.lookup(recv_type);
        if (t == null) { return; }
        // A bare generic-template struct used directly as a receiver (`this` in
        // `implement FmtWrite for struct String`, or `mut s: String` with all params
        // defaulted) is NOT a materialized spec, so a generic method on it (`try_push<T>`)
        // resolves to nothing in the lookup ladder and the call is left unpinned - 
        // codegen's name+arity fallback then picks an arbitrary sibling spec once more
        // than one exists (e.g. try_push<Str> -> try_push<i32>, corrupting all
        // formatting).  Canonicalize to the DEFAULT instantiation's emitted spec
        // (String<GlobalAlloc>) so the call pins a symbol that is actually emitted.
        if (t.kind == TypeKind::Struct) {
            const canon: TypeRef = this.canonicalize_default_template_recv(recv_type);
            if (canon.is_valid() && !canon.equals(recv_type)) {
                recv_type = canon;
                t = this.arena.lookup(recv_type);
                if (t == null) { return; }
            }
        }
        const tk: TypeKind = t.kind;
        const is_user_kind: boolean = tk == TypeKind::Struct
                                   || tk == TypeKind::Enum;
        const is_primitive_kind: boolean = tk == TypeKind::Int
                                        || tk == TypeKind::Float
                                        || tk == TypeKind::Bool
                                        || tk == TypeKind::Char
                                        || tk == TypeKind::String;
        const is_unresolved_inst: boolean = tk == TypeKind::InstantiatedType;
        if (!is_user_kind && !is_primitive_kind && !is_unresolved_inst) { return; }

        // A call sema answered where it is written names that method by its
        // definition in every copy of the body; a call a bound answered
        // names the trait's method by its position.  Either is bound to the
        // receiver's method for it, found by identity.  Nothing is found by
        // the member's name.
        if (path_method == null && call.template_method.is_valid()) {
            mut id_impl: DeclarationNode* = null;
            mut id_owner: DeclarationNode* = null;
            const id_m_decl: DeclarationNode* = this.receiver_method_of(call.template_method, recv_type, &id_impl, &id_owner);
            this.bind_receiver_method(call, id_m_decl, id_impl, id_owner, recv_type, subst);
            if (is_unresolved_inst) { this.queue_bind(call); }
            return;
        }
        if (ma != null && ma.resolved_trait.is_valid() && ma.resolved_trait_slot >= 0) {
            mut item_impl: DeclarationNode* = null;
            const item_m_decl: DeclarationNode* = this.trait_item_on(call, ma, recv_type, &item_impl);
            const item_m: MethodDecl* = DeclarationNode::method_of(item_m_decl);
            if (item_m != null) {
                this.bind_receiver_method(call, item_m_decl, item_impl, null, recv_type, subst);
            }
            if (is_unresolved_inst && call.template_recv.is_valid()) { this.queue_bind(call); }
            if (item_m != null) { return; }
        }

        // A path call names the generic method's definition, which is bound
        // where it is placed for the receiver.  A member call that reached
        // here carries neither a template pin nor a trait item and names
        // nothing: it is left unbound, and `report_unbound_calls` refuses it
        // once monomorphization ends.  Nothing is found by the member's name.
        if (path_method == null) { return; }
        mut impl_node: DeclarationNode* = null;
        mut inherent_owner_ast: DeclarationNode* = null;
        if (!this.method_placement(path_method, recv_type, &impl_node, &inherent_owner_ast)) { return; }
        this.instantiate_generic_method(call, path_method, impl_node, inherent_owner_ast, recv_type, subst);
    }

    /// Bind `call` to the instance of `orig_method` - the receiver's method,
    /// held by `impl_node` or declared on `inherent_owner_ast` - at the
    /// type arguments sema stashed on the call (`method_instance_entry`).
    instantiate_generic_method(mut &this, call: CallExpr*, orig_method_decl: DeclarationNode*,
                               impl_node: DeclarationNode*, inherent_owner_ast: DeclarationNode*,
                               recv_type: TypeRef, subst: TypeSubstitution*) -> void {
        this.pin_spec_entry(call, this.method_instance_entry(orig_method_decl, impl_node, inherent_owner_ast,
            recv_type, &call.resolved_type_args, subst));
    }

    /// The instance of `orig_method` - the receiver's method, held by
    /// `impl_node` or declared on `inherent_owner_ast` - at the type
    /// arguments `stashed` (sema's, in declaration order, concretized by
    /// `subst`), minted on the first request.  Invalid for a method with no
    /// type parameters of its own, arguments not one per parameter, and
    /// arguments that are still a generic body's parameters.
    method_instance_entry(mut &this, orig_method_decl: DeclarationNode*,
                          impl_node: DeclarationNode*, inherent_owner_ast: DeclarationNode*,
                          recv_type: TypeRef, stashed: &[TypeRef], subst: TypeSubstitution*) -> OverloadId {
        const orig_method: MethodDecl* = DeclarationNode::method_of(orig_method_decl);
        if (impl_node == null && inherent_owner_ast == null) { return OverloadId::invalid(); }
        const orig_func_decl: DeclarationNode* = orig_method.func;
        const orig_func: FunctionDecl* = DeclarationNode::fn_of(orig_func_decl);
        if (orig_func == null) { return OverloadId::invalid(); }

        // The method's OWN generic params (e.g. <H> on hash<H>), bound SOLELY
        // from sema's stash: a use without one stashed per parameter is
        // outside sema's visibility and is left unspecialized.
        const n_method_params: i64 = orig_func.generic_params.length;
        if (n_method_params == 0 || stashed.length != n_method_params) { return OverloadId::invalid(); }
        mut bindings: [TypeRef] = [];
        for (mut i: i64 = 0; i < n_method_params; i++) {
            const sv: TypeRef = this.concretize_stashed_arg(stashed[i], subst);
            if (!sv.is_valid()) { return OverloadId::invalid(); }
            bindings.push(sv);
        }

        // Defer when a binding isn't concrete: this use is being walked inside a
        // still-generic context (e.g. `value.fmt(f)` in a template body binds W to
        // the enclosing W).  Minting now would emit a bogus still-generic spec
        // (E0636); the concrete spec is minted when the enclosing method is itself
        // specialized with a concrete binding and its body re-walked.
        for (mut bi: i64 = 0; bi < bindings.length; bi++) {
            if (this.arena.contains_generic_param(bindings[bi])) {
                return OverloadId::invalid();
            }
        }

        // An instance is minted once per (receiver, method definition, type
        // arguments).  The same instance is asked for again by every copy
        // of a call in a body specialized more than once, and by the
        // written call those copies came from; minting it twice would push
        // the method onto its owner twice and register it twice, corrupting
        // the owner's method set.  Asked by identity: the definition is the
        // template's whether the receiver's method is the template's own
        // declaration or a specialization's copy of it.
        const def_of: DefId = if (orig_func.def.is_valid()) { orig_func.def } else { orig_func.copy_of };
        if (!def_of.is_valid()) { return OverloadId::invalid(); }
        const def_slot: DefKey = this.decl_index.defs.table_key(def_of);
        const made: OverloadId = this.state.method_instance(recv_type, def_slot, &bindings);
        if (made.is_valid()) { return made; }

        mut copy_subst: TypeSubstitution* = null;
        const spec_method_decl: DeclarationNode* = this.specialize_method(
            orig_method_decl, &orig_func.generic_params, &bindings, recv_type,
            DeclarationNode::impl_of(impl_node), &copy_subst);
        const spec_method: MethodDecl* = DeclarationNode::method_of(spec_method_decl);
        if (spec_method == null) { return OverloadId::invalid(); }
        // Whether this spec is resolved through a PINNED `resolved_callee` (the
        // precise mangled symbol) rather than the trait-impl/combinator DI path.
        // Only the pinned (inherent) regime gets the `$MG...` method-spec-args
        // disambiguator: there the call pin, the codegen definition, and the DI
        // registration all fold `func.spec_type_args` in and so agree.  Trait-impl
        // specs stay unpinned and are disambiguated by their existing machinery
        // (owner-spec name / where-bound element); stamping them would make their
        // suffixed definition diverge from their unsuffixed combined-key
        // resolution (collapsing coexisting combinator specs onto the first).
        const inherent_pin: boolean = inherent_owner_ast != null
            || (impl_node != null && !DeclarationNode::impl_of(impl_node).is_trait_impl());

        // A trait-impl generic method whose type params appear ONLY in the
        // return / where-bound - no VALUE parameter mentions them - can't be
        // told apart by its parameter-shaped mangle, and its owner-spec name is
        // the SAME across instantiations (the owner is one concrete type), so
        // two specs collapse onto the first emitted symbol.  Concretely
        // `JsonExtract::as<T>() -> Option<T> where T: TryFrom<&JsonValue>`
        // mangled to `...as...Option<boolean>` for EVERY `T`, and every
        // `as<i64>` / `as<Str>` call linked to the `as<boolean>` body.  Stamp
        // the `$MG...` method-spec args in that case too.  Iterator combinators
        // are structurally excluded: their method type param is always carried
        // by a value parameter (`chain<I>(other: I)`, `zip<U>(other: U)`,
        // `map<F>(f: F)`), so `method_generic_in_value_param` is true and this
        // branch never fires for them - their owner-spec disambiguation (a
        // distinct `ChainIter<...>` owner per spec) is preserved.
        mut method_generic_in_value_param: boolean = false;
        if (orig_func != null) {
            for (mut pi: i64 = 0; pi < orig_func.parameters.length; pi++) {
                const pp_decl: DeclarationNode* = orig_func.parameters[pi];
                const pp: VarDecl* = DeclarationNode::var_of(pp_decl);
                if (pp == null) { continue; }
                if (pp.is_receiver()) { continue; }
                if (this.arena.contains_generic_param(pp.resolved_type)) {
                    method_generic_in_value_param = true;
                    break;
                }
            }
        }

        if (inherent_pin || !method_generic_in_value_param) {
            // Stamp the concrete method type args so the spec's mangled symbol
            // carries the `$MG...` disambiguator (MangledName::with_method_spec_args).
            // Two specs of one method whose signature doesn't mention the
            // method param (`name<T>() -> string`) would otherwise mangle
            // identically and collapse onto the first emitted spec.
            mut spec_args_owned: [TypeRef] = [];
            for (mut ai: i64 = 0; ai < bindings.length; ai++) {
                spec_args_owned.push(bindings[ai]);
            }
            DeclarationNode::fn_of(spec_method.func).set_spec_type_args(spec_args_owned);
        }


        // Route the spec'd sibling onto the right AST array.
        if (inherent_owner_ast != null) {
            mut target_ast: DeclarationNode* = inherent_owner_ast;
            mut from_template: boolean = false;
            if (this.generic_registry != null) {
                const recv_t: Type* = this.arena.lookup(recv_type);
                if (recv_t != null && recv_t.kind == TypeKind::InstantiatedType) {
                    const inst_recv: InstantiatedType* = recv_t.as_instantiated();
                    const tmpl_recv: TemplateEntry* =
                        this.generic_registry.template_of_type(inst_recv.generic_base);
                    if (tmpl_recv != null && tmpl_recv.ast_node == inherent_owner_ast) {
                        from_template = true;
                    }
                }
            }
            if (from_template) {
                // The method is placed on the template AST; route to the
                // receiver's spec entry instead so the sibling doesn't leak across
                // every instantiation.
                for (mut si: i64 = 0; si < this.state.spec_entries.length; si++) {
                    const e: SpecializationEntry* = &this.state.spec_entries[si];
                    if (e.specialized_type.equals(recv_type) && e.ast_node != null) {
                        target_ast = e.ast_node;
                        break;
                    }
                }
            }
            if (DeclarationNode::struct_of(target_ast) != null) {
                (DeclarationNode::struct_of(target_ast)).methods.push(spec_method_decl);
            } else if (DeclarationNode::union_of(target_ast) != null) {
                (DeclarationNode::union_of(target_ast)).methods.push(spec_method_decl);
            }
        } else {
            DeclarationNode::impl_of(impl_node).methods.push(spec_method_decl);
        }

        // DI registration + symbol pin.  Inherent generic methods on a fixed
        // receiver get the precise mangle pinned (disambiguates Inner::relay<A> vs
        // <B>); trait-impl / combinator specs stay unpinned (their DI mangle can
        // diverge from the emitted definition symbol).
        if (inherent_owner_ast != null) {
            this.register_spec_method_in_di_inherent(spec_method_decl, recv_type, inherent_owner_ast);
        } else {
            this.register_spec_method_in_di(spec_method_decl, recv_type, impl_node);
        }
        // Pin the registered entry for EVERY generic-method spec, trait-impl
        // included.  Codegen's fallback key is the unmangled `Type::method`,
        // which cannot tell two instantiations of one method on one owner
        // apart, so an unpinned call silently resolves to whichever spec was
        // emitted first - `CGen<i32>::put<u64>` running the `put<u32>` body
        // and returning its answer.  The entry is the one registration just
        // wrote for this spec (its `$MG` disambiguator included), and the
        // definition is emitted under the same entry's symbol.
        mut inst_args: [TypeRef] = [];
        for (mut ai: i64 = 0; ai < bindings.length; ai++) { inst_args.push(bindings[ai]); }
        this.state.add_method_instance(recv_type, def_slot, inst_args, DeclarationNode::fn_of(spec_method.func).overload_entry);

        // Compile-time `static match` arm pruning on the freshly-minted spec body.
        // A method-level `static match (T)` (e.g. `string::parse_int<T>`) was cloned
        // with all arms intact; the substituter rewrote each scrutinee to the
        // concrete binding (`T` -> `i64`).  Reduce every static match to its single
        // live arm now - exactly as the owner-template path does
        // (monomorphizer.cryo:480).  Without this the spec'd clone keeps >1 arm and a
        // later normal-mode walk of the concrete body reports E0645 ("static match
        // outside a generic context").  Done before the call re-walk so it only
        // descends the live arm.  Method-level params bind from the call's turbofish
        // stash, so the bindings are concrete here (the still-generic case returned
        // at the contains_generic_param guard above).
        if (spec_method.func != null && DeclarationNode::fn_of(spec_method.func).body != null
                && this.ast_resolver != null) {
            mut prune_ctx: ResolutionContext = ResolutionContext::new("");
            if (recv_type.is_valid()) { prune_ctx.set_this_type(recv_type); }
            this.ast_resolver.prune_static_match_in_stmt(
                DeclarationNode::fn_of(spec_method.func).body, &prune_ctx);
        }

        // Re-walk the copy's body for its own generic calls.  The substituter
        // rewrites the clone's type-argument stashes but NOT the `resolved_type`
        // an identifier carries from the template (`this` typed `Box<A>`, a local
        // typed `A*`), so the walk applies the substitution the body was copied
        // under: the method's parameters (`W` in `fmt<W>`), the owner's (`A` in
        // `Box<A>`), and the ones the impl block names in its head (`A` in
        // `implement<A, B> .. for Pair<A, B>`), which are not the owner's.
        if (spec_method.func != null && DeclarationNode::fn_of(spec_method.func).body != null) {
            mut rw_ctx: ResolutionContext = ResolutionContext::new("");
            this.walk_body(spec_method.func, &rw_ctx, copy_subst);
        }
        return DeclarationNode::fn_of(spec_method.func).overload_entry;
    }

    /// The receiver's method for the definition `d`, and where it is held:
    /// the type declaration (`out_owner_ast`) or the impl block
    /// (`out_impl`) its instances are added to.  A default the receiver
    /// instantiates per call (`take`, `map`, `Option<T>::as_ref`) is held
    /// deferred in an impl block and has no index entry until a call
    /// instantiates it, so it is found where it is held, by the definition
    /// it is a copy of; every other method is the receiver's index entry for
    /// `d` - the declaration itself, or the receiver's copy of it - placed
    /// by its identity.  Null when the receiver has neither.
    receiver_method_of(&this, d: DefId, recv_type: TypeRef, out_impl: DeclarationNode**,
                       out_owner_ast: DeclarationNode**) -> DeclarationNode* {
        const deferred_decl: DeclarationNode* = this.deferred_copy_of(d, recv_type, out_impl);
        const deferred: MethodDecl* = DeclarationNode::method_of(deferred_decl);
        if (deferred != null) { return deferred_decl; }
        const m_decl: DeclarationNode* = this.decl_index.entry_method(this.decl_index.method_entry_on(recv_type, d));
        const m: MethodDecl* = DeclarationNode::method_of(m_decl);
        if (m == null || !this.method_placement(m_decl, recv_type, out_impl, out_owner_ast)) { return null; }
        return m_decl;
    }

    /// The deferred copy of the definition `d` among the impl blocks the
    /// receiver's methods are read from - those placed under its
    /// specialization, then the trait impls selected for it - and the block
    /// holding it (`out_impl`); null when none holds one.
    deferred_copy_of(&this, d: DefId, recv_type: TypeRef, out_impl: DeclarationNode**) -> DeclarationNode* {
        for (mut i: i64 = 0; i < this.state.spec_entries.length; i++) {
            const entry: SpecializationEntry* = &this.state.spec_entries[i];
            if (!entry.specialized_type.equals(recv_type)) { continue; }
            for (mut j: i64 = 0; j < entry.impl_nodes.length; j++) {
                const block: DeclarationNode* = entry.impl_nodes[j];
                const m_decl: DeclarationNode* = MonoCallSpecializer::deferred_in(DeclarationNode::impl_of(block), d);
                const m: MethodDecl* = DeclarationNode::method_of(m_decl);
                if (m != null) { *out_impl = block; return m_decl; }
            }
        }
        if (this.generic_registry == null) { return null; }
        const traits: [DeclarationNode*] = this.generic_registry.trait_impls_of(recv_type, this.intern_table);
        for (mut i: i64 = 0; i < traits.length; i++) {
            const m_decl: DeclarationNode* = MonoCallSpecializer::deferred_in(DeclarationNode::impl_of(traits[i]), d);
            const m: MethodDecl* = DeclarationNode::method_of(m_decl);
            if (m != null) { *out_impl = traits[i]; return m_decl; }
        }
        return null;
    }

    /// The method of `block` that is a deferred copy of the definition `d`.
    static deferred_in(block: ImplBlock*, d: DefId) -> DeclarationNode* {
        if (block == null) { return null; }
        for (mut k: i64 = 0; k < block.methods.length; k++) {
            const m_decl: DeclarationNode* = block.methods[k];
            const m: MethodDecl* = DeclarationNode::method_of(m_decl);
            if (m == null || m.func == null || !DeclarationNode::fn_of(m.func).copy_of.equals(d)) { continue; }
            if (DeclarationNode::fn_of(m.func).is_self_returning_default || DeclarationNode::fn_of(m.func).is_lazy_self_growing) { return m_decl; }
        }
        return null;
    }

    /// The method a call a bound answered names on the receiver: the method
    /// the receiver's implementation of the bound's trait provides at the
    /// position the call recorded, with that implementation (`out_impl`).
    /// A trait implemented at several trait arguments (`Conv<i32>` and
    /// `Conv<i64>`) is answered by the one implementation whose head writes
    /// the arguments the bound gave the call (`bound_trait_args`).  Null
    /// when the receiver has no implementation of the trait, or several the
    /// bound's arguments do not tell apart.  A receiver that is a generic
    /// type's specialization holds its implementations in the blocks placed
    /// under it, where the instances its calls ask for are added and
    /// emitted; any other receiver's are the registry's heads selected for
    /// it.
    trait_item_on(&this, call: CallExpr*, ma: MemberAccessExpr*, recv_type: TypeRef,
                  out_impl: DeclarationNode**) -> DeclarationNode* {
        if (this.generic_registry == null) { return null; }
        const heads: [DeclarationNode*] = this.trait_heads_on(ma.resolved_trait, recv_type);
        mut head: DeclarationNode* = null;
        if (heads.length == 1) {
            head = heads[0];
        } else if (call.bound_trait_args.length > 0) {
            for (mut h: i64 = 0; h < heads.length; h++) {
                if (!this.generic_registry.trait_args_unify(DeclarationNode::impl_of(heads[h]),
                        &call.bound_trait_args, this.intern_table)) {
                    continue;
                }
                if (head != null) { return null; }
                head = heads[h];
            }
        }
        if (head == null) { return null; }
        const m_decl: DeclarationNode* = this.generic_registry.trait_item_method(DeclarationNode::impl_of(head), ma.resolved_trait_slot);
        const m: MethodDecl* = DeclarationNode::method_of(m_decl);
        if (m != null) { *out_impl = head; }
        return m_decl;
    }

    /// The receiver's implementations of the trait `trait_def`: for a
    /// generic type's specialization, the blocks placed under it, where the
    /// instances its calls ask for are added and emitted; for any other
    /// receiver, the registry's heads selected for it.
    trait_heads_on(&this, trait_def: DefId, recv_type: TypeRef) -> [DeclarationNode*] {
        mut heads: [DeclarationNode*] = [];
        mut specialized: boolean = false;
        for (mut i: i64 = 0; i < this.state.spec_entries.length; i++) {
            const entry: SpecializationEntry* = &this.state.spec_entries[i];
            if (!entry.specialized_type.equals(recv_type)) { continue; }
            specialized = true;
            for (mut j: i64 = 0; j < entry.impl_nodes.length; j++) {
                const block: ImplBlock* = DeclarationNode::impl_of(entry.impl_nodes[j]);
                if (block != null && block.is_trait_impl() && block.trait_def.equals(trait_def)) {
                    heads.push(entry.impl_nodes[j]);
                }
            }
        }
        if (!specialized) {
            heads = this.generic_registry.heads_for(trait_def, recv_type, this.intern_table);
        }
        return heads;
    }

    /// Bind `call` to the receiver's method `m`, held by `impl_node` or
    /// declared on `owner_ast`: a default instantiated per call is bound to
    /// the instance an earlier call made of it, else one minted now; a
    /// method with type parameters of its own, to its instance at the call's
    /// type arguments; any other method, to itself.  A receiver whose
    /// instantiation is not minted yet, or that is still written in a
    /// generic body's parameters, has no method of its own to bind to: the
    /// call is bound once it is minted (`bind_queued_calls`), or in each
    /// copy that substitutes the parameters.
    bind_receiver_method(mut &this, call: CallExpr*, m_decl: DeclarationNode*, impl_node: DeclarationNode*,
                         owner_ast: DeclarationNode*, recv_type: TypeRef,
                         subst: TypeSubstitution*) -> void {
        const m: MethodDecl* = DeclarationNode::method_of(m_decl);
        if (m == null || m.func == null) { return; }
        if (DeclarationNode::fn_of(m.func).generic_params.length > 0) {
            this.instantiate_generic_method(call, m_decl, impl_node, owner_ast, recv_type, subst);
            return;
        }
        if (!DeclarationNode::fn_of(m.func).is_self_returning_default && !DeclarationNode::fn_of(m.func).is_lazy_self_growing) {
            const rt: Type* = this.arena.lookup(recv_type);
            if (rt != null && rt.kind != TypeKind::InstantiatedType
                    && !this.arena.contains_generic_param(recv_type)) {
                this.pin_plain(call, m_decl);
            }
            return;
        }
        const block: ImplBlock* = DeclarationNode::impl_of(impl_node);
        if (block == null) { return; }
        mut made: DeclarationNode* = null;
        for (mut k: i64 = 0; k < block.methods.length && made == null; k++) {
            const c_decl: DeclarationNode* = block.methods[k];
            const c: MethodDecl* = DeclarationNode::method_of(c_decl);
            if (c != null && c != m && c.func != null && DeclarationNode::fn_of(c.func).copy_of.equals(DeclarationNode::fn_of(m.func).copy_of)
                    && !DeclarationNode::fn_of(c.func).is_self_returning_default && !DeclarationNode::fn_of(c.func).is_lazy_self_growing
                    && DeclarationNode::fn_of(c.func).generic_params.length == 0) {
                made = c_decl;
            }
        }
        this.instantiate_deferred(call, m_decl, impl_node, recv_type, made);
    }

    /// The type a receiver's methods are read from: `recv` behind any
    /// pointer or reference, an instantiation as the specialization minted
    /// for it.  An instantiation not minted yet is answered as itself.
    receiver_owner(&this, recv: TypeRef) -> TypeRef {
        mut out: TypeRef = recv;
        mut t: Type* = this.arena.lookup(out);
        mut depth: i32 = 0;
        while (t != null && depth < 8) {
            if (t.kind == TypeKind::Pointer) {
                out = t.as_pointer().pointee;
            } else if (t.kind == TypeKind::Reference) {
                out = t.as_reference().referent;
            } else if (t.kind == TypeKind::InstantiatedType && t.as_instantiated().has_resolved_type()) {
                out = t.as_instantiated().resolved_type;
            } else {
                break;
            }
            t = this.arena.lookup(out);
            depth += 1;
        }
        return out;
    }

    queue_bind(mut &this, call: CallExpr*) -> void {
        if (!call.resolved_callee.is_some()) { this.queued_binds.push(call); }
    }

    /// Bind a call the compiler generated, which names its method by
    /// definition, to the receiver's own method for it.  A receiver still
    /// written in a generic body's parameters is bound in each copy that
    /// substitutes them; one not minted yet, once it is.
    bind_named_call(mut &this, call: CallExpr*, subst: TypeSubstitution*) -> void {
        if (call.resolved_callee.is_some() || !call.template_recv.is_valid()) { return; }
        mut recv: TypeRef = call.template_recv;
        if (subst != null) { recv = subst.apply(recv, this.arena); }
        if (this.arena.contains_generic_param(recv)) { return; }
        const owner: TypeRef = this.receiver_owner(recv);
        const ot: Type* = this.arena.lookup(owner);
        if (ot == null) { return; }
        if (ot.kind == TypeKind::InstantiatedType) {
            this.queue_bind(call);
            return;
        }
        this.pin_plain(call, this.named_method_on(call.named_method, owner));
    }

    /// A static call through a path whose owner the copy's substitution
    /// wrote (`scope.spec_owner`): the owner's own name inside its body, which
    /// names the specialization being made, or a type parameter's
    /// (`T::default()`), which names the type bound to it.  The call is
    /// bound on that owner, by the method it recorded where it is written,
    /// once the owner is minted.  A method with type parameters of its own,
    /// or a call carrying the owner's arguments, is specialized as written.
    /// A bound-directed path taken as a VALUE in a copy (`const f = T::make;`
    /// with `T` bound to `P`): the function is the method the path recorded
    /// where it is written, on the owner the copy's substitution wrote, by
    /// identity.  A method with type parameters of its own is not a value
    /// bound as written, and an owner not yet minted has no entries; both
    /// are left unpinned.
    bind_path_value(mut &this, scope_e: ExpressionNode*, scope: ScopeResolutionExpr*, subst: TypeSubstitution*) -> void {
        if (!scope.template_method.is_valid() || !scope.spec_owner.is_valid()
                || scope.resolved_callee.is_some()) { return; }
        if (this.arena.contains_generic_param(scope.spec_owner)) {
            if (subst == null) { return; }
            const concrete: TypeRef = this.concretize_stashed_arg(scope.spec_owner, subst);
            if (!concrete.is_valid() || this.arena.contains_generic_param(concrete)) { return; }
            const ct: Type* = this.arena.lookup(concrete);
            if (ct != null && ct.kind == TypeKind::InstantiatedType) {
                const ci: InstantiatedType* = ct.as_instantiated();
                scope.spec_owner = this.generic_registry.instantiate(ci.generic_base, &ci.type_args);
            } else {
                scope.spec_owner = concrete;
            }
        }
        const owner: TypeRef = this.receiver_owner(scope.spec_owner);
        const ot: Type* = this.arena.lookup(owner);
        if (ot == null) { return; }
        // An owner instance not minted yet is queued for the drain, which
        // materializes its methods, and the value is bound once it is.
        if (ot.kind == TypeKind::InstantiatedType) {
            this.state.enqueue_from_type_ref(scope.spec_owner);
            this.queued_path_values.push(scope_e);
            return;
        }
        const m_decl: DeclarationNode* = this.recorded_method_on(scope.template_method, owner);
        const m: MethodDecl* = DeclarationNode::method_of(m_decl);
        if (m == null || m.func == null) { return; }
        // A method with type parameters of its own is the instance at the
        // arguments the type check kept on the path.
        if (DeclarationNode::fn_of(m.func).generic_params.length > 0) {
            mut impl_node: DeclarationNode* = null;
            mut owner_ast: DeclarationNode* = null;
            if (!this.method_placement(m_decl, owner, &impl_node, &owner_ast)) { return; }
            const inst: OverloadId = this.method_instance_entry(m_decl, impl_node, owner_ast, owner,
                &scope.value_type_args, subst);
            if (inst.is_valid()) { scope.set_resolved_callee(CalleePin::Decl(inst)); }
            return;
        }
        if (!DeclarationNode::fn_of(m.func).overload_entry.is_valid()) { return; }
        scope.set_resolved_callee(CalleePin::Decl(DeclarationNode::fn_of(m.func).overload_entry));
    }

    bind_on_substituted_owner(mut &this, call: CallExpr*, scope: ScopeResolutionExpr*) -> void {
        if (!scope.spec_owner.is_valid() || !call.template_method.is_valid()
                || call.template_recv.is_valid() || call.resolved_type_args.length > 0) { return; }
        const f_decl: DeclarationNode* = this.decl_index.method_func_of(call.template_method);
        const f: FunctionDecl* = DeclarationNode::fn_of(f_decl);
        if (f == null || f.generic_params.length > 0) { return; }
        call.template_recv = scope.spec_owner;
        this.queue_bind(call);
    }

    /// The method of `owner` the static path call `call` recorded: a trait's
    /// declared method, answered by `owner`'s implementation of the trait
    /// at that method's position - its one implementation, or among several
    /// the one the directing bound names (`bound_params`), null when that
    /// leaves no single one; any other, `owner`'s entry for the definition.
    path_method_on(&this, call: CallExpr*, owner: TypeRef) -> DeclarationNode* {
        const d: DefId = call.template_method;
        const slot: i64 = this.generic_registry.trait_item_position(d);
        if (slot < 0) { return this.recorded_method_on(d, owner); }
        const heads: [DeclarationNode*] = this.trait_heads_on(this.decl_index.defs.parent_of(d), owner);
        if (heads.length == 1) {
            return this.generic_registry.trait_item_method(DeclarationNode::impl_of(heads[0]), slot);
        }
        // Several implementations of one generic trait (`TryFrom<&JsonValue>`
        // beside `TryFrom<i64>` for `u64`): the one the bound directing the
        // call names, whose method takes the parameters the bound gives it.
        mut found: DeclarationNode* = null;
        for (mut h: i64 = 0; h < heads.length; h++) {
            const m_decl: DeclarationNode* = this.generic_registry.trait_item_method(DeclarationNode::impl_of(heads[h]), slot);
            const m: MethodDecl* = DeclarationNode::method_of(m_decl);
            if (m == null || !this.takes_bound_params(m_decl, call)) { continue; }
            if (found != null) { return null; }
            found = m_decl;
        }
        return found;
    }

    /// Whether `m`'s parameters after its receiver are exactly the call's
    /// `bound_params`, in order.  A call no bound directs takes nothing.
    takes_bound_params(&this, m_decl: DeclarationNode*, call: CallExpr*) -> boolean {
        const m: MethodDecl* = DeclarationNode::method_of(m_decl);
        if (m.func == null || call.bound_params.length == 0) { return false; }
        mut k: i64 = 0;
        for (mut i: i64 = 0; i < DeclarationNode::fn_of(m.func).parameters.length; i++) {
            const p_decl: DeclarationNode* = DeclarationNode::fn_of(m.func).parameters[i];
            const p: VarDecl* = DeclarationNode::var_of(p_decl);
            if (p == null) { return false; }
            if (p.is_receiver()) { continue; }
            if (k >= call.bound_params.length || !p.resolved_type.equals(call.bound_params[k])) { return false; }
            k += 1;
        }
        return k == call.bound_params.length;
    }

    /// The method of `owner` the definition `d` a path recorded names: a
    /// trait's declared method at its position in `owner`'s one
    /// implementation of the trait, null when it has several; any other,
    /// `owner`'s entry for `d`.
    recorded_method_on(&this, d: DefId, owner: TypeRef) -> DeclarationNode* {
        const slot: i64 = this.generic_registry.trait_item_position(d);
        if (slot >= 0) {
            const heads: [DeclarationNode*] = this.trait_heads_on(this.decl_index.defs.parent_of(d), owner);
            if (heads.length != 1) { return null; }
            return this.generic_registry.trait_item_method(DeclarationNode::impl_of(heads[0]), slot);
        }
        return this.decl_index.entry_method(this.decl_index.method_entry_on(owner, d));
    }

    /// The method of `owner` the method definition `d` names: a trait's
    /// declared method at its position in `owner`'s first implementation of
    /// that trait; any other, `owner`'s entry for `d`.
    named_method_on(&this, d: DefId, owner: TypeRef) -> DeclarationNode* {
        const slot: i64 = this.generic_registry.trait_item_position(d);
        if (slot >= 0) {
            const heads: [DeclarationNode*] = this.trait_heads_on(this.decl_index.defs.parent_of(d), owner);
            if (heads.length == 0) { return null; }
            return this.generic_registry.trait_item_method(DeclarationNode::impl_of(heads[0]), slot);
        }
        return this.decl_index.entry_method(this.decl_index.method_entry_on(owner, d));
    }

    /// Pin `call` to `m` when `m` is bound as it is written: one with type
    /// parameters of its own, or a default instantiated per call, is bound
    /// to an instance instead.
    pin_plain(mut &this, call: CallExpr*, m_decl: DeclarationNode*) -> void {
        const m: MethodDecl* = DeclarationNode::method_of(m_decl);
        if (m == null || m.func == null || DeclarationNode::fn_of(m.func).generic_params.length > 0
                || DeclarationNode::fn_of(m.func).is_self_returning_default || DeclarationNode::fn_of(m.func).is_lazy_self_growing) { return; }
        this.pin_spec_entry(call, DeclarationNode::fn_of(m.func).overload_entry);
        this.bind_call_arguments(call);
    }

    /// Bind the arguments of a call to the parameters of what it calls
    /// (`CallExpr::bind_arguments`): for a call pinned to a declaration,
    /// a method's own parameters after its receiver for a call written on a
    /// receiver, every parameter for a call through a path or a name; for a
    /// call through a function value, the parameters of the value's function
    /// type as this copy sees it - a reference parameter there is borrowed
    /// and its argument auto-referenced, which an unclassified argument,
    /// read as a move, is not.  A call whose arguments are bound already -
    /// where it is written, outside a copy - is left as it is.
    bind_call_arguments(&this, call: CallExpr*) -> void {
        if (call.arguments.length == 0) { return; }
        for (mut i: i64 = 0; i < call.arguments.length; i++) {
            const a: ExpressionNode* = call.arguments[i];
            if (a != null && a.arg_binding != ArgBinding::Unclassified) { return; }
        }
        const e: OverloadId = call.resolved_callee.decl_entry();
        match (call.resolved_callee) {
            CalleePin::None => {
                if (this.callee_is_value(call.callee)) {
                    const vt: Type* = this.arena.lookup(call.callee.resolved_type);
                    if (vt != null && vt.kind == TypeKind::Function) {
                        mut vparams: [TypeRef] = [];
                        const vfn: FunctionType* = vt.as_function();
                        for (mut i: i64 = 0; i < vfn.param_types.length; i++) { vparams.push(vfn.param_types[i]); }
                        call.bind_arguments(this.arena, &vparams);
                    }
                }
                return;
            }
            _ => { }
        }
        if (!e.is_valid()) { return; }
        const m_decl: DeclarationNode* = this.decl_index.entry_method(e);
        const m: MethodDecl* = DeclarationNode::method_of(m_decl);
        mut params: [TypeRef] = [];
        if (m != null && m.func != null) {
            const on_receiver: boolean = ExpressionNode::member_access_of(call.callee) != null;
            for (mut i: i64 = 0; i < DeclarationNode::fn_of(m.func).parameters.length; i++) {
                const p_decl: DeclarationNode* = DeclarationNode::fn_of(m.func).parameters[i];
                const p: VarDecl* = DeclarationNode::var_of(p_decl);
                if (p == null) { return; }
                if (on_receiver && p.is_receiver()) { continue; }
                params.push(p.resolved_type);
            }
        } else {
            const ft: Type* = this.arena.lookup(this.decl_index.entry_signature(e));
            if (ft == null || ft.kind != TypeKind::Function) { return; }
            const fn_t: FunctionType* = ft.as_function();
            for (mut i: i64 = 0; i < fn_t.param_types.length; i++) { params.push(fn_t.param_types[i]); }
        }
        call.bind_arguments(this.arena, &params);
    }

    /// Whether a call's callee is a value of function type rather than a
    /// name of something declared: a local, or a field.
    callee_is_value(&this, callee: ExpressionNode*) -> boolean {
        if (callee == null) { return false; }
        const id: IdentifierExpr* = ExpressionNode::identifier_of(callee);
        if (id != null) {
            return match (id.res) {
                ResSlot::Answered(r) => {
                    match (r) {
                        Res::Local(_) => { true }
                        _             => { false }
                    }
                }
                _ => { false }
            };
        }
        const ma: MemberAccessExpr* = ExpressionNode::member_access_of(callee);
        if (ma != null) {
            return match (ma.resolved_member) {
                MemberPin::Field(_) => { true }
                _                      => { false }
            };
        }
        return false;
    }

    /// Bind each queued call whose receiver or owner is now minted, by the
    /// identity it recorded: the method a generated call names, the method
    /// `template_method` names on `template_recv`, or the trait's method at
    /// the position the call's member recorded.  A method with type
    /// parameters of its own is bound to its instance at the call's
    /// stashed arguments, minted here when no earlier call made it; its
    /// body's own instantiations are drained by the caller's next round.
    /// Any other is bound only as written.  A call whose receiver is still
    /// not minted stays queued.
    bind_queued_calls(mut &this) -> void {
        mut still: [CallExpr*] = [];
        for (mut i: i64 = 0; i < this.queued_binds.length; i++) {
            const call: CallExpr* = this.queued_binds[i];
            if (call.resolved_callee.is_some()) { continue; }
            const owner: TypeRef = this.receiver_owner(call.template_recv);
            const ot: Type* = this.arena.lookup(owner);
            if (ot == null) { continue; }
            if (ot.kind == TypeKind::InstantiatedType) {
                still.push(call);
                continue;
            }
            const own_params: FunctionDecl* = if (call.template_method.is_valid()) {
                DeclarationNode::fn_of(this.decl_index.method_func_of(call.template_method))
            } else { null };
            if (call.named_method.is_valid()) {
                this.pin_plain(call, this.named_method_on(call.named_method, owner));
            } else if (own_params != null && own_params.generic_params.length > 0) {
                mut gm_impl: DeclarationNode* = null;
                mut gm_owner: DeclarationNode* = null;
                const gm_decl: DeclarationNode* = this.receiver_method_of(call.template_method, owner, &gm_impl, &gm_owner);
                const gm: MethodDecl* = DeclarationNode::method_of(gm_decl);
                if (gm != null) { this.instantiate_generic_method(call, gm_decl, gm_impl, gm_owner, owner, null); }
            } else if (ExpressionNode::scope_resolution_of(call.callee) != null) {
                this.pin_plain(call, this.path_method_on(call, owner));
            } else if (call.template_method.is_valid()) {
                mut id_impl: DeclarationNode* = null;
                mut id_owner: DeclarationNode* = null;
                this.pin_plain(call, this.receiver_method_of(call.template_method, owner, &id_impl, &id_owner));
            } else {
                mut item_impl: DeclarationNode* = null;
                this.pin_plain(call, this.trait_item_on(call, ExpressionNode::member_access_of(call.callee), owner, &item_impl));
            }
        }
        this.queued_binds = still;
        mut values: [ExpressionNode*] = [];
        for (mut i: i64 = 0; i < this.queued_path_values.length; i++) { values.push(this.queued_path_values[i]); }
        this.queued_path_values = [];
        for (mut i: i64 = 0; i < values.length; i++) {
            this.bind_path_value(values[i], ExpressionNode::scope_resolution_of(values[i]), null);
        }
    }

    /// Report every walked call nothing binds: E0900, an internal error,
    /// since the type check binds or refuses each call it accepts and
    /// monomorphization binds each copy's.  Run once the last module's
    /// queued binds are drained; code generation emits only bound calls.
    report_unbound_calls(mut &this) -> void {
        for (mut i: i64 = 0; i < this.unpinned_calls.length; i++) {
            const u: UnpinnedCall = this.unpinned_calls[i];
            if (this.call_is_bound(u.call)) { continue; }
            this.report_unbound_call(u.call, u.func);
        }
        this.unpinned_calls = [];
        for (mut i: i64 = 0; i < this.queued_path_values.length; i++) {
            const v_e: ExpressionNode* = this.queued_path_values[i];
            const v: ScopeResolutionExpr* = ExpressionNode::scope_resolution_of(v_e);
            if (v.resolved_callee.is_some()) { continue; }
            const vfile: string = v_e.span.file;
            mut d: Diagnostic = Diagnostic::error(ErrorCode::E0900_INTERNAL_COMPILER_ERROR,
                fmt::format("internal: the method `%s` taken as a value reached codegen with no instance (written at %s:%u)",
                    this.intern_table.resolve(v.member_name), vfile.basename(), v_e.span.start_line));
            d = d.at(v_e.span);
            this.diagnostics.emit(d);
        }
        this.queued_path_values = [];
    }

    /// Whether code generation has something to call for `call`: its pin,
    /// or - for a call with none - the value it calls through: a local or a
    /// module's global of function type, an enum variant, a
    /// function-typed field, a release of the `Drop` language item, or a
    /// computed function value.
    call_is_bound(&this, e: ExpressionNode*) -> boolean {
        const call: CallExpr* = ExpressionNode::call_of(e);
        if (call.resolved_callee.is_some()) { return true; }
        const callee: ExpressionNode* = call.callee;
        const id: IdentifierExpr* = ExpressionNode::identifier_of(callee);
        if (id != null) {
            const id_ty: TypeRef = call.callee.resolved_type;
            if (id.res.local_sym().is_valid() && this.is_function_value(id_ty)) { return true; }
            // A module's global of function type is called through its
            // storage, as a local is.
            match (id.res) {
                ResSlot::Answered(r) => {
                    if (this.decl_index.global_entry_of_def(r.def_id()).valid
                        && this.is_function_value(id_ty)) { return true; }
                }
                _ => { }
            }
            const rt: Type* = this.arena.lookup(e.resolved_type);
            return rt != null && rt.kind == TypeKind::Struct;
        }
        const sr: ScopeResolutionExpr* = ExpressionNode::scope_resolution_of(callee);
        if (sr != null) {
            match (sr.resolved_member) {
                MemberPin::Variant(_) => {}
                _                     => { return false; }
            }
            mut t: Type* = this.arena.lookup(e.resolved_type);
            mut depth: i32 = 0;
            while (t != null && t.kind == TypeKind::InstantiatedType && depth < 5) {
                const inst: InstantiatedType* = t.as_instantiated();
                if (!inst.has_resolved_type()) { break; }
                t = this.arena.lookup(inst.resolved_type);
                depth += 1;
            }
            return t != null && t.kind == TypeKind::Enum;
        }
        const ma: MemberAccessExpr* = ExpressionNode::member_access_of(callee);
        if (ma != null) {
            if (ma.resolved_member.is_some() && this.is_function_value(call.callee.resolved_type)) { return true; }
            return call.named_method.is_valid()
                && call.named_method.equals(this.generic_registry.wellknown(LangItem::DropDrop));
        }
        return this.is_function_value(call.callee.resolved_type);
    }

    /// Whether `ty` is a function, through one pointer or reference.
    is_function_value(&this, ty: TypeRef) -> boolean {
        mut t: Type* = this.arena.lookup(ty);
        if (t != null && t.kind == TypeKind::Pointer) {
            t = this.arena.lookup(t.as_pointer().pointee);
        } else if (t != null && t.kind == TypeKind::Reference) {
            t = this.arena.lookup(t.as_reference().referent);
        }
        return t != null && t.kind == TypeKind::Function;
    }

    /// The internal error for a call nothing binds: the callee's leaf, the
    /// function whose body holds the call, and where the call is written,
    /// which for a copied body is its template's.
    report_unbound_call(mut &this, e: ExpressionNode*, func_decl: DeclarationNode*) -> void {
        const call: CallExpr* = ExpressionNode::call_of(e);
        const func: FunctionDecl* = DeclarationNode::fn_of(func_decl);
        const callee: ExpressionNode* = call.callee;
        mut leaf: string = "<value>";
        mut what: string = "function";
        const id: IdentifierExpr* = ExpressionNode::identifier_of(callee);
        if (id != null) { leaf = this.intern_table.resolve(id.name); }
        const sr: ScopeResolutionExpr* = ExpressionNode::scope_resolution_of(callee);
        if (sr != null) { leaf = this.intern_table.resolve(sr.member_name); }
        const ma: MemberAccessExpr* = ExpressionNode::member_access_of(callee);
        if (ma != null) {
            leaf = this.intern_table.resolve(ma.member);
            what = "method";
        }
        const where_fn: string = if (func != null) { this.intern_table.resolve(func.name) } else { "<no function>" };
        const file: string = e.span.file;
        mut d: Diagnostic = Diagnostic::error(ErrorCode::E0900_INTERNAL_COMPILER_ERROR,
            fmt::format("internal: call to `%s` in `%s` reached codegen with no resolved %s (written at %s:%u)",
                leaf, where_fn, what, file.basename(), e.span.start_line));
        d = d.at(e.span);
        this.diagnostics.emit(d);
    }

    /// Bind `call` to the receiver's instance of the deferred method `orig`
    /// of `impl_node`: `made` when an earlier call instantiated it, else an
    /// instance minted now, registered, and walked for the calls its body
    /// makes.  The pin is the instance's registered entry.
    instantiate_deferred(mut &this, call: CallExpr*, orig_decl: DeclarationNode*, impl_node: DeclarationNode*,
                         recv_type: TypeRef, made_decl: DeclarationNode*) -> boolean {
        const made: MethodDecl* = DeclarationNode::method_of(made_decl);
        if (made != null) {
            this.pin_spec_entry(call, DeclarationNode::fn_of(made.func).overload_entry);
            return true;
        }
        const block: ImplBlock* = DeclarationNode::impl_of(impl_node);
        mut empty_params: [DeclarationNode*] = [];
        mut empty_args: [TypeRef] = [];
        mut copy_subst: TypeSubstitution* = null;
        const spec_method_decl: DeclarationNode* = this.specialize_method(
            orig_decl, &empty_params, &empty_args, recv_type, block, &copy_subst);
        const spec_method: MethodDecl* = DeclarationNode::method_of(spec_method_decl);
        if (spec_method == null || spec_method.func == null) { return false; }
        block.methods.push(spec_method_decl);
        this.register_spec_method_in_di(spec_method_decl, recv_type, impl_node);
        this.pin_spec_entry(call, DeclarationNode::fn_of(spec_method.func).overload_entry);
        if (DeclarationNode::fn_of(spec_method.func).body != null) {
            mut rw_ctx: ResolutionContext = ResolutionContext::new("");
            this.walk_body(spec_method.func, &rw_ctx, copy_subst);
        }
        return true;
    }


    // -- Static method on a GENERIC owner (Slice<T>::from_raw, String<GA>::from_string) --

    /// Whether one of the template's impl blocks, inherent or trait, holds `m`.
    template_holds(&this, entry: TemplateEntry*, m_decl: DeclarationNode*) -> boolean {
        for (mut i: i64 = 0; i < entry.impl_blocks.length; i++) {
            if (MethodDecl::is_method_of(m_decl,entry.impl_blocks[i])) { return true; }
        }
        return false;
    }

    /// Specialize a call through a path to a non-generic method of a generic
    /// owner (static, or taking its receiver as the first argument) from
    /// sema's owner stash.  Sema stashes the
    /// owner's concrete type args on the call (resolve_static_method_return_via_template
    /// -> stash_static_owner_bindings), so this just instantiates the owner, enqueues
    /// it (the worklist drain materializes + DI-registers its methods), and pins the
    /// combined `<spec-owner>::<method>` callee.  Returns true when handled.
    specialize_static_method_on_generic_owner(mut &this, call: CallExpr*,
                                              scope: ScopeResolutionExpr*,
                                              subst: TypeSubstitution*) -> boolean {
        if (call == null || scope == null) { return false; }
        if (call.resolved_callee.is_some()) { return false; }
        const registry: GenericRegistry* = this.generic_registry;
        if (registry == null) { return false; }
        // The owner is the declaration the scope segment's stamp names, under
        // the canonical name the registry is keyed by.  The spelling is any
        // whole-segment suffix of that name, and reaches the registry only when
        // it happens to be the whole of it.
        const entry: TemplateEntry* = this.scope_owner_template_from_stamp(scope);
        if (entry == null) { return false; }
        if (entry.kind != TemplateKind::Struct
                && entry.kind != TemplateKind::Union) { return false; }
        if (entry.param_count == 0 || entry.ast_node == null) { return false; }

        // The method is the one sema recorded where the call is written.  A
        // non-generic one, static or taking its receiver as the path's first
        // argument (`Box2::<i32>::get(&b)`), needs only its owner
        // instantiated: its stash is the OWNER's type args, the owner drain
        // materializes its body, and the call is bound to the owner's copy by
        // identity once the owner is minted, wherever the owner's method is
        // written - its declaration, an impl block of the template, or a
        // trait's declaration (`HashSet::<i32>::default()`,
        // `(Beta for Wrap<i32>)::make()`).  A generic one (`Wrap<A>::make<T>`,
        // `Wrap<A>::keep<T>(&w, t)`), wherever it is written, needs its OWN
        // `<T>` specialized on the owner's specialization - the stash is the
        // METHOD's `<T>`; owner args come from the scope turbofish or
        // template defaults.
        const func_decl: DeclarationNode* = this.decl_index.method_func_of(call.template_method);
        const func: FunctionDecl* = DeclarationNode::fn_of(func_decl);
        if (func == null) { return false; }
        const recorded: DeclarationNode* = this.decl_index.method_decl_of(call.template_method);
        const m_decl: DeclarationNode* = if (DeclarationNode::method_of(recorded) != null) { recorded } else { null };
        const m: MethodDecl* = DeclarationNode::method_of(m_decl);
        const trait_item: boolean = this.generic_registry.trait_item_position(call.template_method) >= 0;
        const held: boolean = trait_item
            || (m != null && (MethodDecl::is_method_of(m_decl,entry.ast_node) || this.template_holds(entry, m_decl)));
        if (!held) { return false; }

        // --- Non-generic method on a generic owner ---
        if (func.generic_params.length == 0) {
            // The owner's type args come from sema's stash (declaration order).
            if (call.resolved_type_args.length != entry.param_types.length) { return false; }
            mut binds: [TypeRef] = [];
            for (mut i: i64 = 0; i < call.resolved_type_args.length; i++) {
                const b: TypeRef = this.concretize_stashed_arg(call.resolved_type_args[i], subst);
                if (!b.is_valid() || this.arena.contains_generic_param(b)) { return false; }
                binds.push(b);
            }

            // Instantiate the owner + enqueue (the drain materializes its methods).
            const inst_ref: TypeRef = registry.instantiate(
                entry.base_type, binds);
            if (!inst_ref.is_valid()) { return false; }
            this.state.enqueue_from_type_ref(inst_ref);
            // The owner the recorded method is bound on: an owner whose
            // arguments the call's arguments inferred is written bare.
            call.template_recv = inst_ref;
            this.queue_bind(call);
            return true;
        }

        // --- Generic method on a generic owner (`Wrap<A>::make<T>`) ---
        return this.specialize_generic_path_method(call, scope, entry, subst);
    }

    /// Specialize a call through a path to a GENERIC method of a GENERIC
    /// owner (`Wrap<A>::make<T>(item)`, `Wrap<A>::keep<T>(&w, t)`).  The owner
    /// spec is materialized (via the scope turbofish / template defaults) and
    /// the owner's method for the recorded definition is instantiated at
    /// sema's stash of the method's OWN `<T>` - exactly as a member call
    /// (`w.keep::<T>(t)`) is, with the owner's specialization as the
    /// receiver.  Returns true when the call is claimed.  On the first walk
    /// the owner spec entry does not exist yet: the owner is enqueued and the
    /// call is left UNPINNED so the walk/drain fixpoint (specialization.cryo)
    /// re-visits it once the entry materializes.
    specialize_generic_path_method(mut &this, call: CallExpr*, scope: ScopeResolutionExpr*,
                                   entry: TemplateEntry*, subst: TypeSubstitution*) -> boolean {
        const registry: GenericRegistry* = this.generic_registry;
        if (registry == null) { return false; }

        // Owner binds: scope turbofish, else template defaults.
        mut owner_binds: [TypeRef] = this.compute_owner_default_binds(scope, entry, subst);
        if (owner_binds.length != entry.param_types.length) { return false; }

        // Materialize the owner instantiation.
        const inst_ref: TypeRef = registry.instantiate(
            entry.base_type, owner_binds);
        if (!inst_ref.is_valid()) { return false; }

        // Find the owner spec entry.  On the first walk it does not exist yet:
        // enqueue it and leave the call unpinned for the next fixpoint iteration.
        mut spec_entry: SpecializationEntry* = this.find_owner_spec_entry(inst_ref);
        if (spec_entry == null) {
            this.state.enqueue_from_type_ref(inst_ref);
            if (!call.template_recv.equals(inst_ref)) {
                call.template_recv = inst_ref;
                this.queue_bind(call);
            }
            return true;
        }
        const recv_type: TypeRef = spec_entry.specialized_type;
        mut impl_node: DeclarationNode* = null;
        mut owner_ast: DeclarationNode* = null;
        const m_decl: DeclarationNode* = this.receiver_method_of(call.template_method, recv_type, &impl_node, &owner_ast);
        const m: MethodDecl* = DeclarationNode::method_of(m_decl);
        if (m != null) { this.instantiate_generic_method(call, m_decl, impl_node, owner_ast, recv_type, subst); }
        return true;
    }

    /// Owner type args for a generic-owner static call in mono: explicit scope
    /// turbofish (`Wrap<u8>::make`) if present, else all-default (`Wrap` ->
    /// `Wrap<i32>`).  Mirrors sema's `compute_generic_static_owner_binds`.
    compute_owner_default_binds(mut &this, scope: ScopeResolutionExpr*,
                                entry: TemplateEntry*, subst: TypeSubstitution*) -> [TypeRef] {
        const want: i64 = entry.param_types.length;
        if (want == 0) { return []; }
        if (this.type_resolver == null) { return []; }
        mut rc: ResolutionContext = ResolutionContext::new("");
        mut binds: [TypeRef] = [];
        for (mut i: i64 = 0; i < scope.scope_generic_args.length; i++) {
            mut tr: TypeRef = this.type_resolver.resolve(scope.scope_generic_args[i], &rc);
            if (subst != null) { tr = subst.apply(tr, this.arena); }
            if (!tr.is_valid()) { return []; }
            binds.push(tr);
        }
        if (binds.length < want) {
            binds = this.type_resolver.expand_default_type_args(entry, binds, &rc);
        }
        if (binds.length != want) { return []; }
        for (mut i: i64 = 0; i < binds.length; i++) {
            if (!binds[i].is_valid() || this.arena.contains_generic_param(binds[i])) { return []; }
        }
        return binds;
    }

    /// Find the materialized owner spec entry for an owner instantiation
    /// (display-equal on `instantiated_type`, matching the instance-method path).
    find_owner_spec_entry(&this, owner_inst: TypeRef) -> SpecializationEntry* {
        for (mut i: i64 = 0; i < this.state.spec_entries.length; i++) {
            const e: SpecializationEntry* = &this.state.spec_entries[i];
            if (!e.instantiated_type.is_valid() || !e.specialized_type.is_valid()) { continue; }
            if (e.instantiated_type.equals(owner_inst)
                    || e.instantiated_type.equals(owner_inst)) {
                return e;
            }
        }
        return null;
    }

    // -- A generic method's receiver --

    /// Add owner-param -> concrete-arg bindings to `subst` for a generic method
    /// specialized on a generic-struct receiver.  The AST substituter is built only
    /// from the METHOD params (`<T>`), so without this the cloned body's owner-typed
    /// receivers (`this: Box<A>` in `Box<A>::add<T>`) keep the abstract owner param
    /// `A` and a nested `this.<m>(...)` call can't resolve its concrete receiver.
    /// `owner_type` may be the resolved spec struct or the instantiation itself;
    /// either way recover the `(generic_base, type_args)` and bind each template
    /// param (reconstructed by name+index, matching the body's interned ref) to the
    /// receiver's concrete arg.  No-op when the owner isn't a generic instantiation.
    add_owner_param_bindings(&this, subst: TypeSubstitution*, owner_type: TypeRef) -> void {
        if (this.generic_registry == null) { return; }
        // The owner's `(generic_base, type_args)` read directly: a pre-mono wrapper
        // answers from its own node, a post-mono concrete from its intrinsic
        // identity.  Without these bindings the cloned body's owner-typed
        // constructions (`Option<T>::Some(..)`, `NonNull<T> { .. }`) stay abstract
        // and codegen ICEs (E0600/E0638).
        mut owner_src: TypeRef = owner_type;
        mut owner_base: TypeRef = this.arena.inst_generic_base(owner_type);
        if (!owner_base.is_valid()) {
            // Legacy fallback: an owner minted without generic identity (the
            // substituter can mint an instantiation with fresh arg ids) - match the
            // concrete against a materialized spec entry's instantiated type.
            for (mut i: i64 = 0; i < this.state.spec_entries.length; i++) {
                const e: SpecializationEntry* = &this.state.spec_entries[i];
                if (!e.specialized_type.is_valid() || !e.instantiated_type.is_valid()) { continue; }
                if (e.specialized_type.equals(owner_type)) {
                    const cand: TypeRef = this.arena.inst_generic_base(e.instantiated_type);
                    if (cand.is_valid()) {
                        owner_src = e.instantiated_type;
                        owner_base = cand;
                        break;
                    }
                }
            }
        }
        if (!owner_base.is_valid()) { return; }
        const owner_nargs: i64 = this.arena.inst_type_arg_count(owner_src);
        const tmpl: TemplateEntry* =
            this.generic_registry.template_of_type(owner_base);
        if (tmpl == null || tmpl.ast_node == null) { return; }
        const empty_params: [DeclarationNode*] = [];
        mut owner_params: &[DeclarationNode*] = &empty_params;
        if (DeclarationNode::struct_of(tmpl.ast_node) != null) {
            owner_params = &(DeclarationNode::struct_of(tmpl.ast_node)).generic_params;
        } else if (DeclarationNode::union_of(tmpl.ast_node) != null) {
            owner_params = &(DeclarationNode::union_of(tmpl.ast_node)).generic_params;
        } else {
            return;
        }
        const n: i64 = if (owner_params.length < owner_nargs) {
            owner_params.length
        } else {
            owner_nargs
        };
        for (mut i: i64 = 0; i < n; i++) {
            const gp_decl: DeclarationNode* = owner_params[i];
            const gp: GenericParamDecl* = DeclarationNode::generic_param_of(gp_decl);
            if (gp == null) { continue; }
            const arg_i: TypeRef = this.arena.inst_type_arg_at(owner_src, i);
            if (this.arena.contains_generic_param(arg_i)) { continue; }
            const pref: TypeRef = this.arena.create_generic_param(gp.sym_id, gp.name, i as u64);
            subst.add(pref, arg_i);
        }
    }

    /// If `recv_type` is a bare generic-template struct (every type param has a
    /// default), build its DEFAULT instantiation and return the materialized spec's
    /// concrete type - so a generic-method call on the bare template pins/emits under
    /// the same spec as in-source `String<GlobalAlloc>` receivers.  Returns
    /// `recv_type` unchanged when it isn't a defaultable template or no spec for the
    /// default instantiation has been materialized.
    canonicalize_default_template_recv(mut &this, recv_type: TypeRef) -> TypeRef {
        if (this.generic_registry == null || this.type_resolver == null) { return recv_type; }
        const tmpl: TemplateEntry* =
            this.generic_registry.template_of_type(recv_type);
        if (tmpl == null || tmpl.ast_node == null) { return recv_type; }
        const empty_gp: [DeclarationNode*] = [];
        mut params: &[DeclarationNode*] = &empty_gp;
        if (DeclarationNode::struct_of(tmpl.ast_node) != null) {
            params = &(DeclarationNode::struct_of(tmpl.ast_node)).generic_params;
        } else {
            return recv_type;
        }
        if (params.length == 0) { return recv_type; }
        mut default_args: [TypeRef] = [];
        mut rc: ResolutionContext = ResolutionContext::new("");
        for (mut i: i64 = 0; i < params.length; i++) {
            const gp_decl: DeclarationNode* = params[i];
            const gp: GenericParamDecl* = DeclarationNode::generic_param_of(gp_decl);
            if (gp == null || !gp.has_default_annotation()) { return recv_type; }
            const da: TypeRef = this.type_resolver.resolve(gp.default_annotation, &rc);
            if (!da.is_valid() || this.arena.contains_generic_param(da)) { return recv_type; }
            default_args.push(da);
        }
        // `create_instantiation` interns by (base.id, arg ids), so this IS the id
        // the spec was materialized against - if one was.  Only the membership
        // question remains; the type needs no recovery.
        const default_inst: TypeRef = this.arena.create_instantiation(recv_type, &default_args);
        if (this.state.has_materialized_spec(default_inst)) { return default_inst; }
        return recv_type;
    }


    // -- The spec CORE: clone + substitute + re-resolve --

    /// Clone a generic method's func, substitute its own generic params
    /// (`params`, the method's declared parameter nodes) with `args`, clear
    /// generic_params, and re-resolve the signature against the owner type.
    /// Returns the spec'd MethodDecl, or null if the signature didn't fully resolve.
    /// `out_subst` receives the substitution the body was copied under - the
    /// method's parameters, the owner's, and the ones its impl names - which
    /// is the one the copy's body is walked with.
    specialize_method(mut &this, original_decl: DeclarationNode*,
                      params: &[DeclarationNode*], args: &[TypeRef],
                      owner_type: TypeRef, owner_impl: ImplBlock*,
                      out_subst: TypeSubstitution**) -> DeclarationNode* {
        const original: MethodDecl* = DeclarationNode::method_of(original_decl);
        if (original == null || original.func == null) { return null; }
        if (params.length != args.length) { return null; }
        mut param_names: [SymbolStr] = [];
        mut param_syms: [SymbolID] = [];
        for (mut i: i64 = 0; i < params.length; i++) {
            const p: GenericParamDecl* = DeclarationNode::generic_param_of(params[i]);
            if (p == null) { return null; }
            param_names.push(p.name);
            param_syms.push(p.sym_id);
        }

        mut param_ids: [TypeRef] = [];
        for (mut i: i64 = 0; i < param_names.length; i++) {
            const gp_ref: TypeRef = this.arena.create_generic_param(param_syms[i], param_names[i], i as u64);
            param_ids.push(gp_ref);
        }
        mut subst_val: TypeSubstitution = TypeSubstitution::from_params(param_ids, args);
        // Also concretize the owner's generic params (`A` in `Box<A>::add<T>`) from
        // the concrete receiver, so the cloned body's owner-typed receivers
        // (`this.try_add(item)` on `Box<A>`) resolve their spec instead of staying
        // abstract -> codegen E0636 on the nested call.
        if (owner_type.is_valid()) {
            this.add_owner_param_bindings(&subst_val, owner_type);
        }
        // A parameter the impl's where-clause derives (`A` in `implement<I, A>
        // Iterator<A> for TakeIter<I> where I: Iterator<A>`) is no parameter of
        // the owner, so the receiver's arguments cannot bind it; the spec'd
        // impl caches it.  The signature below is resolved with the same
        // binding, and a body stash naming it (`TakeIter<I, A>`) needs it here.
        if (owner_impl != null) {
            for (mut di: i64 = 0; di < owner_impl.derived_param_names.length; di++) {
                if (!owner_impl.derived_param_types[di].is_valid()) { continue; }
                const dp_ref: TypeRef = this.arena.create_generic_param(
                    owner_impl.derived_param_syms[di], owner_impl.derived_param_names[di], di as u64);
                subst_val.add(dp_ref, owner_impl.derived_param_types[di]);
            }
            // The impl's target is written in the impl's OWN parameter names
            // (`implement<X> Iterator for Range<X>`), which need not be the
            // owner's; a body typed under that impl names them, so each is
            // bound to the receiver's argument in that position.
            if (owner_type.is_valid()
                    && owner_impl.target_args.length == this.arena.inst_type_arg_count(owner_type)) {
                for (mut ti: i64 = 0; ti < owner_impl.target_args.length; ti++) {
                    const ta: TypeAnnotation* = owner_impl.target_args[ti];
                    if (ta == null) { continue; }
                    match (*ta) {
                        TypeAnnotation::Named(n) => {
                            const arg_t: TypeRef = this.arena.inst_type_arg_at(owner_type, ti);
                            if (!arg_t.is_valid() || this.arena.contains_generic_param(arg_t)) { continue; }
                            // A concrete argument written in the head is no parameter.
                            if (!n.param_sym().is_valid()) { continue; }
                            const tp_ref: TypeRef = this.arena.create_generic_param(n.param_sym(), n.name, ti as u64);
                            subst_val.add(tp_ref, arg_t);
                        }
                        _ => {}
                    }
                }
            }
        }
        const subst_ptr: TypeSubstitution* =
            allocator::alloc(sizeof(TypeSubstitution), 16) as TypeSubstitution*;
        *subst_ptr = subst_val;
        *out_subst = subst_ptr;

        mut cloner: ASTCloner = ASTCloner::for_monomorphization();
        const spec_method_decl: DeclarationNode* = cloner.copy_decl(original_decl);
        mut spec_method: MethodDecl* = DeclarationNode::method_of(spec_method_decl);
        if (spec_method == null || spec_method.func == null) { return null; }
        spec_method.spec_of = original_decl;
        // The clone is a concrete specialization, not a deferred template:
        // cleared BEFORE the substituter runs, which skips a flagged body.
        // The skip guards the base->spec rename in a spec'd impl; there is no
        // rename here, and the body's stashes (an adapter over the owner,
        // `TakeIter<I>`) are exactly what the owner bindings must reach.
        DeclarationNode::fn_of(spec_method.func).set_self_returning_default(false);
        DeclarationNode::fn_of(spec_method.func).set_lazy_self_growing(false);
        DeclarationNode::fn_of(spec_method.func).generic_params = [];
        DeclarationNode::fn_of(spec_method.func).set_resolved_return_type(TypeRef::invalid());
        for (mut i: i64 = 0; i < DeclarationNode::fn_of(spec_method.func).parameters.length; i++) {
            const p_decl: DeclarationNode* = DeclarationNode::fn_of(spec_method.func).parameters[i];
            const p: VarDecl* = DeclarationNode::var_of(p_decl);
            if (p != null) { p.set_resolved_type(TypeRef::invalid()); }
        }

        // The substituter takes ownership of its parameter lists, so it is
        // handed INDEPENDENT copies rather than the buffers this frame still
        // owns (a by-value pass would shallow-copy them and both would free
        // them -> the double-free heap-corruption wall).
        mut ps_owned: [SymbolID] = [];
        for (mut i: i64 = 0; i < param_syms.length; i++) {
            ps_owned.push(param_syms[i]);
        }
        const empty_sym: SymbolStr = SymbolStr::empty();
        // No template and no spec id: this rewrites a method's parameters
        // only, so no name in it denotes a specialization being built.
        mut substituter: ASTTypeSubstituter* = ASTTypeSubstituter::create(
            subst_ptr, this.arena, this.intern_table,
            DefId::invalid(), empty_sym, ps_owned,
            TypeRef::invalid());
        substituter.types = this.type_resolver;
        substituter.walk_decl(spec_method_decl);

        if (this.type_resolver != null) {
            // The signature being re-resolved was WRITTEN in the module the
            // method's declaration lives in, while the ambient scope chain is
            // still the module that triggered this specialization.  A bare leaf
            // in the return / parameter annotations must bind as the DECLARING
            // module sees it, or a same-leaf type visible at the call site
            // silently wins.
            //
            mut res_ctx: ResolutionContext = ResolutionContext::new("");
            if (owner_type.is_valid()) { res_ctx.set_this_type(owner_type); }
            if (owner_impl != null) {
                for (mut di: i64 = 0; di < owner_impl.derived_param_names.length; di++) {
                    res_ctx.add_binding(owner_impl.derived_param_syms[di],
                                        owner_impl.derived_param_names[di],
                                        owner_impl.derived_param_types[di]);
                }
            }
            this.type_resolver.resolve_func_signature(spec_method.func, &res_ctx);
            for (mut i: i64 = 0; i < DeclarationNode::fn_of(spec_method.func).parameters.length; i++) {
                const p_decl: DeclarationNode* = DeclarationNode::fn_of(spec_method.func).parameters[i];
                const p: VarDecl* = DeclarationNode::var_of(p_decl);
                if (p == null) { continue; }
                if (p.resolved_type.is_valid()) { continue; }
                if (p.is_ref_receiver()) {
                    if (owner_type.is_valid()) {
                        p.set_resolved_type(this.arena.get_reference_to(
                            owner_type, RefMutability::Immutable));
                    }
                } else if (p.is_value_receiver()) {
                    if (owner_type.is_valid()) { p.set_resolved_type(owner_type); }
                }
            }
        }

        // Fallback: re-derive an unresolved slot from `original`'s resolved signature
        // (which already carries the concrete where-clause element binding).
        if (this.type_has_unresolved(DeclarationNode::fn_of(spec_method.func).resolved_return_type, 0)
                && DeclarationNode::fn_of(original.func).resolved_return_type.is_valid()) {
            const cand: TypeRef = subst_ptr.apply(DeclarationNode::fn_of(original.func).resolved_return_type, this.arena);
            if (!this.type_has_unresolved(cand, 0)) {
                DeclarationNode::fn_of(spec_method.func).set_resolved_return_type(cand);
            }
        }
        const n_clone_params: i64 = DeclarationNode::fn_of(spec_method.func).parameters.length;
        const n_orig_params: i64 = DeclarationNode::fn_of(original.func).parameters.length;
        if (n_clone_params == n_orig_params) {
            for (mut i: i64 = 0; i < n_clone_params; i++) {
                const p_decl: DeclarationNode* = DeclarationNode::fn_of(spec_method.func).parameters[i];
                const p: VarDecl* = DeclarationNode::var_of(p_decl);
                const op_decl: DeclarationNode* = DeclarationNode::fn_of(original.func).parameters[i];
                const op: VarDecl* = DeclarationNode::var_of(op_decl);
                if (p == null || op == null) { continue; }
                if (!this.type_has_unresolved(p.resolved_type, 0)) { continue; }
                if (!op.resolved_type.is_valid()) { continue; }
                const cand: TypeRef = subst_ptr.apply(op.resolved_type, this.arena);
                if (!this.type_has_unresolved(cand, 0)) { p.set_resolved_type(cand); }
            }
        }

        // Substitution sweep: reach a method generic NESTED in an instantiated
        // annotation (the W in `f: mut &Formatter<W>`) that the AST substituter left.
        if (DeclarationNode::fn_of(spec_method.func).resolved_return_type.is_valid()) {
            DeclarationNode::fn_of(spec_method.func).set_resolved_return_type(
                subst_ptr.apply(DeclarationNode::fn_of(spec_method.func).resolved_return_type, this.arena));
        }
        for (mut i: i64 = 0; i < DeclarationNode::fn_of(spec_method.func).parameters.length; i++) {
            const sp_decl: DeclarationNode* = DeclarationNode::fn_of(spec_method.func).parameters[i];
            const sp: VarDecl* = DeclarationNode::var_of(sp_decl);
            if (sp != null && sp.resolved_type.is_valid()) {
                sp.set_resolved_type(subst_ptr.apply(sp.resolved_type, this.arena));
            }
        }

        // Reduce concrete-base associated-type projections (`IntSeq::Item` -> i32).
        if (DeclarationNode::fn_of(spec_method.func).resolved_return_type.is_valid()) {
            DeclarationNode::fn_of(spec_method.func).set_resolved_return_type(
                this.trait_spec.reduce_projections(DeclarationNode::fn_of(spec_method.func).resolved_return_type));
        }
        for (mut i: i64 = 0; i < DeclarationNode::fn_of(spec_method.func).parameters.length; i++) {
            const sp2_decl: DeclarationNode* = DeclarationNode::fn_of(spec_method.func).parameters[i];
            const sp2: VarDecl* = DeclarationNode::var_of(sp2_decl);
            if (sp2 != null && sp2.resolved_type.is_valid()) {
                sp2.set_resolved_type(this.trait_spec.reduce_projections(sp2.resolved_type));
            }
        }

        // Refuse a half-resolved spec (the mangler aborts on an invalid TypeRef).
        if (this.type_has_unresolved(DeclarationNode::fn_of(spec_method.func).resolved_return_type, 0)) {
            return null;
        }
        for (mut i: i64 = 0; i < DeclarationNode::fn_of(spec_method.func).parameters.length; i++) {
            const p_decl: DeclarationNode* = DeclarationNode::fn_of(spec_method.func).parameters[i];
            const p: VarDecl* = DeclarationNode::var_of(p_decl);
            if (p != null && this.type_has_unresolved(p.resolved_type, 0)) {
                return null;
            }
        }

        // Discover nested instantiations from the spec'd signature so a method
        // that returns or takes another generic type (e.g. `NonNull<T>::cast<U>`
        // -> `NonNull<U>`) triggers monomorphization of the referenced generic.
        // The type-spec path does this in `resolve_func_and_body`; the method-call
        // path is the equivalent producer for generic instance/static methods, so
        // it must request the same discovery - otherwise the return-type
        // instantiation is created (by sema/substitution) but never resolved.
        //
        // Reset `nested_visited` first: it is a shared cycle-detection set whose
        // contract (see `state.request_nested_instantiations`) requires the
        // caller to clear it before each top-level traversal. Without this, stale
        // TypeIDs left over from an earlier drain step cause this method's return/
        // param instantiations to be silently skipped (order-dependent miscompile
        // -> unresolved InstantiatedType -> E0636/null-operand). One reset for the
        // whole signature is intentional: it dedupes a type referenced by both the
        // return type and a parameter to a single request.
        this.state.nested_visited = [];
        if (DeclarationNode::fn_of(spec_method.func).resolved_return_type.is_valid()) {
            this.state.request_nested_instantiations(DeclarationNode::fn_of(spec_method.func).resolved_return_type);
        }
        for (mut i: i64 = 0; i < DeclarationNode::fn_of(spec_method.func).parameters.length; i++) {
            const sp_decl: DeclarationNode* = DeclarationNode::fn_of(spec_method.func).parameters[i];
            const sp: VarDecl* = DeclarationNode::var_of(sp_decl);
            if (sp != null && sp.resolved_type.is_valid()) {
                this.state.request_nested_instantiations(sp.resolved_type);
            }
        }
        return spec_method_decl;
    }

    /// True when `ty` is invalid or contains an invalid TypeRef at any depth.
    type_has_unresolved(&this, ty: TypeRef, depth: i32) -> boolean {
        if (!ty.is_valid()) { return true; }
        if (depth > 16) { return false; }
        const t: Type* = this.arena.lookup(ty);
        if (t == null) { return true; }
        if (t.kind == TypeKind::Function) {
            const f: FunctionType* = t.as_function();
            if (this.type_has_unresolved(f.return_type, depth + 1)) { return true; }
            for (mut i: i64 = 0; i < f.param_types.length; i++) {
                if (this.type_has_unresolved(f.param_types[i], depth + 1)) { return true; }
            }
            return false;
        }
        if (t.kind == TypeKind::Pointer) {
            return this.type_has_unresolved(t.as_pointer().pointee, depth + 1);
        }
        if (t.kind == TypeKind::Reference) {
            return this.type_has_unresolved(t.as_reference().referent, depth + 1);
        }
        if (t.kind == TypeKind::Array) {
            return this.type_has_unresolved(t.as_array().element, depth + 1);
        }
        if (t.kind == TypeKind::Optional) {
            return this.type_has_unresolved(t.as_optional().wrapped, depth + 1);
        }
        if (t.kind == TypeKind::Tuple) {
            const tup: TupleType* = t.as_tuple();
            for (mut i: i64 = 0; i < tup.elements.length; i++) {
                if (this.type_has_unresolved(tup.elements[i], depth + 1)) { return true; }
            }
            return false;
        }
        if (t.kind == TypeKind::InstantiatedType) {
            const inst: InstantiatedType* = t.as_instantiated();
            for (mut i: i64 = 0; i < inst.type_args.length; i++) {
                if (this.type_has_unresolved(inst.type_args[i], depth + 1)) { return true; }
            }
            return false;
        }
        return false;
    }


    // -- DI registration + symbol pinning --


    /// Whether a receiver is an instantiation the worklist has not
    /// materialized yet.  A generic method requested on one has nothing to
    /// be registered under yet: the spec sits on the template's block, and
    /// the call is pinned to the entry the spec carries, the one the owner
    /// registers it under when it is materialized.  Every other receiver is a type
    /// the index holds - a declaration, a primitive, a specialization
    /// registered at its placement, flipped to its concrete or not - so one
    /// it cannot name is a missing registration, recorded by
    /// `register_methods`, never keyed around.
    receiver_unmaterialized(&this, recv_type: TypeRef) -> boolean {
        const t: Type* = this.arena.lookup(recv_type);
        if (t == null || t.kind != TypeKind::InstantiatedType) { return false; }
        return !this.state.has_materialized_spec(recv_type);
    }

    /// Register an impl-block-owned spec method in the DeclarationIndex under the
    /// receiver's type so codegen/linker find the right func_type/mangle.
    register_spec_method_in_di(mut &this, spec_method_decl: DeclarationNode*,
                               recv_type: TypeRef, impl_node: DeclarationNode*) -> void {
        const spec_method: MethodDecl* = DeclarationNode::method_of(spec_method_decl);
        if (this.decl_index == null) { return; }
        if (spec_method == null || impl_node == null) { return; }
        mut owning_file: SymbolStr = SymbolStr::empty();
        if (impl_node.source_file != "") {
            owning_file = this.intern_table.intern(impl_node.source_file);
        } else {
            owning_file = this.current_source_file;
        }
        // The spec's definition is emitted into the unit of `owning_file`; flag
        // it as a spec owner so the per-module incremental cache does not reuse
        // a stale object (see MonoState::record_spec_owner_file).
        this.state.record_spec_owner_file(owning_file);
        if (this.receiver_unmaterialized(recv_type)) { return; }
        mut spec_methods: [DeclarationNode*] = [];
        spec_methods.push(spec_method_decl);
        this.decl_index.register_methods(
            recv_type, spec_methods, this.intern_table, this.arena, "mono/spec impl method");
    }

    /// Register a spec method whose owner is a non-generic struct (no impl
    /// block) under the receiver's type.  The spec's definition is emitted with
    /// the owner's declaration, so the module that owns it is the one whose
    /// file declares the owner - not the module whose call asked for it: a
    /// `scope.spawn::<Job>(..)` written in `main` defines `Scope::spawn<Job>`
    /// in `std::thread`'s object.
    register_spec_method_in_di_inherent(mut &this, spec_method_decl: DeclarationNode*,
                                        recv_type: TypeRef, owner_ast: DeclarationNode*) -> void {
        const spec_method: MethodDecl* = DeclarationNode::method_of(spec_method_decl);
        if (this.decl_index == null) { return; }
        if (spec_method == null || owner_ast == null) { return; }
        if (this.receiver_unmaterialized(recv_type)) { return; }
        // Flag the emitting module as a spec owner for the incremental cache
        // (see MonoState::record_spec_owner_file): an owner not flagged is
        // served from its cached object, which predates the spec.
        this.state.record_spec_owner_file(this.intern_table.intern(owner_ast.span.file));
        mut spec_methods: [DeclarationNode*] = [];
        spec_methods.push(spec_method_decl);
        this.decl_index.register_methods(
            recv_type, spec_methods, this.intern_table, this.arena, "mono/spec inherent method");
    }

    /// Pin `call` to the spec's entry: the call's final answer, which every
    /// pass after monomorphization reads.
    pin_spec_entry(mut &this, call: CallExpr*, entry: OverloadId) -> void {
        if (!entry.is_valid()) { return; }
        call.set_resolved_callee(CalleePin::Decl(entry));
    }

    // -- Small pure helpers (re-homed copies) --


    // -- Template lookup helpers (LOOKUP, not inference) --

    /// The generic OWNER template a scope segment's stamp names, or null when
    /// the segment names no type declaration (a module, a primitive, a type
    /// parameter) or the declaration is not a template.
    ///
    /// A segment already spelled as a specialization
    /// carries its template's stamp, so it names the template here too; the
    /// registry holds no template under a specialization's name, which is
    /// the answer a lookup by that spelling gave.
    scope_owner_template_from_stamp(&this, scope: ScopeResolutionExpr*) -> TemplateEntry* {
        const registry: GenericRegistry* = this.generic_registry;
        if (registry == null || scope == null) { return null; }
        return match (scope.require_scope_res("scope_owner_template_from_stamp")) {
            Res::TypeRelative(b, _) => {
                match (b) {
                    ResBase::Def(d) => { registry.template_of(d) }
                    _               => { null }
                }
            }
            _ => { null }
        };
    }


    // -- Where-clause bound checking at the call site --

    /// Verify the function template's `where`-clause bounds hold for the stashed
    /// type args in `bindings`.  On the first failing bound, emits a rich
    /// diagnostic and returns false so the caller skips pin + enqueue.
    check_function_bounds_at_call(mut &this, call_e: ExpressionNode*, call: CallExpr*,
                                  tmpl_func_decl: DeclarationNode*,
                                  entry: TemplateEntry*,
                                  bindings: &[TypeRef]) -> boolean {
        const tmpl_func: FunctionDecl* = DeclarationNode::fn_of(tmpl_func_decl);
        if (tmpl_func == null || entry == null) { return true; }
        if (tmpl_func.trait_bounds.length == 0) { return true; }
        for (mut bi: i64 = 0; bi < tmpl_func.trait_bounds.length; bi++) {
            const bound: TraitBound* = &tmpl_func.trait_bounds[bi];
            // Position of this bound's type parameter = index into `bindings`.
            mut idx: i64 = -1;
            for (mut pi: i64 = 0; pi < entry.param_syms.length; pi++) {
                if (entry.param_syms[pi].equals(bound.subject_sym)) {
                    idx = pi;
                    break;
                }
            }
            if (idx < 0 || idx >= bindings.length) { continue; }
            const concrete: TypeRef = bindings[idx];
            if (!concrete.is_valid()) { continue; }
            // Defer when the binding is still abstract (re-checked when a concrete
            // spec pins it).  Mirrors sema's check_generic_free_call guard.
            if (this.arena.contains_generic_param(concrete)) { continue; }
            for (mut ri: i64 = 0; ri < bound.trait_refs.length; ri++) {
                const tref: TraitRef* = &bound.trait_refs[ri];
                // A bound refused where it is written is reported there.
                if (tref.path.length == 0 || tref.refused) { continue; }
                // Identity for the check; the diagnostic keeps the spelling.
                const trait_name: SymbolStr = tref.path[tref.path.length - 1];
                if (!this.trait_spec.type_implements_trait(concrete, tref.definition(), 0)) {
                    this.emit_call_bound_failure(call_e, tmpl_func_decl, tref, concrete, trait_name);
                    return false;
                }
            }
        }
        return true;
    }

    /// Emit a "the trait bound `X: Y` is not satisfied" diagnostic at the call site.
    emit_call_bound_failure(mut &this, call_e: ExpressionNode*,
                            tmpl_func_decl: DeclarationNode*,
                            tref: TraitRef*, concrete: TypeRef,
                            trait_name: SymbolStr) -> void {
        const tmpl_func: FunctionDecl* = DeclarationNode::fn_of(tmpl_func_decl);
        const trait_str: string = this.intern_table.resolve(trait_name);
        const fn_str: string = this.intern_table.resolve(tmpl_func.name);
        const concrete_t: Type* = this.arena.lookup(concrete);
        const concrete_str: string = if (concrete_t != null) {
            this.arena.format_display(concrete_t)
        } else {
            "?"
        };
        mut diag: Diagnostic = Diagnostic::error(
            ErrorCode::E0306_TRAIT_BOUND_NOT_SATISFIED,
            fmt::format("the trait bound `%s: %s` is not satisfied",
                concrete_str, trait_str));
        diag = diag.at(call_e.span);
        diag = diag.also_at(tref.span, fmt::format(
            "required by this bound in `%s`", fn_str));
        diag = diag.with_note(fmt::format(
            "the trait `%s` is not implemented for `%s`",
            trait_str, concrete_str));
        diag = diag.help(fmt::format(
            "implement `%s` for `%s`, or pass an argument of a type that already does",
            trait_str, concrete_str));
        this.diagnostics.emit(diag);
    }
}
