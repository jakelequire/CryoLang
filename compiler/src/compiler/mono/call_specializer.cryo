/// Mono Call Specializer  (Compiler::Mono::CallSpecializer)
///
/// The sema-stash CONSUMER.  Walks a module's call sites and, for each generic
/// free-function / method / static call that sema already resolved, mints the
/// per-call specialization: pins the specialized callee symbol on the call,
/// queues the function-template instantiation, and (for generic methods) clones +
/// re-resolves a concrete method sibling and registers it in the DeclarationIndex.
///
/// POST-REORDER (mono-after-sema): semantic analysis ran FIRST and stashed every
/// generic call's concrete type arguments on `CallExprNode.resolved_type_args`,
/// and typed every receiver/argument expression.  This collaborator READS those —
/// it NEVER re-derives them.  The old argument/receiver/literal inference engine
/// (`unify_for_inference`, `resolve_arg_type_for_inference`, the literal-default
/// guess, the local-variable mini-sema tables) is GONE: bindings come from the
/// stash, the receiver type from `ma.object.resolved_type`.  What remains is
/// template/method LOOKUP, where-bound checking, and the clone+substitute+register
/// mechanics — none of which is inference.
///
/// This replaces the monolith's `discover_inferred_calls_in_module` +
/// `try_infer_function_call` + `try_infer_method_call` +
/// `try_infer_static_method_on_generic_template`.

namespace Compiler::Mono::CallSpecializer;

import Compiler::AST;
import Compiler::AST::{ Node, Declaration, Statement, Expression, Pattern };
import Compiler::Types::{ Generic, UserDefined, Compound, Type, Arena, TypeRef, Substitution, Resolver, GenericRegistry, Ownership };
import Compiler::Diag;
import Compiler::Diag::{ Sink, Diagnostic, SourceSpan };
import Compiler::DeclIndex;
import Compiler::Resolver::{ InternTable, SymbolStr, QualifiedName, MangledName };
import Compiler::Mono::{ State, TraitSpecializer, AstResolver };
import std::alloc::allocator;


type struct MonoCallSpecializer {
    arena:            TypeArena*;
    generic_registry: GenericRegistry*;
    intern_table:     InternTable*;
    diagnostics:      DiagnosticSink*;
    type_resolver:    TypeResolver*;
    decl_index:       DeclarationIndex*;
    state:            MonoState*;
    trait_spec:       MonoTraitSpecializer*;
    ast_resolver:     MonoAstResolver*;
    current_module:   SymbolStr;
    // The current module's NAMESPACE (distinct from `current_module`, which is
    // the source-file identity used for origin tracking).  Import-scoped generic
    // scope resolution keys on the namespace space, so it needs this, not the
    // file path.  Set by the specialization pass alongside `current_module`.
    current_ns:       SymbolStr;
    // Transient owner context, set only while re-walking a generic static
    // method's specialized body (finish_generic_static_method_spec): an
    // owner-constructing struct literal (`Wrap { v: item }`) whose type the
    // symbolic template walk left invalid is stamped with `gsm_owner_recv` (the
    // concrete owner spec).  This runs after the whole-spec type-resolution pass
    // that types a sibling like `Wrap::base`'s literal, which the late-added
    // method spec misses.  Cleared (recv invalid) outside that re-walk.
    gsm_owner_leaf:   SymbolStr;
    gsm_owner_recv:   TypeRef;
    gsm_owner_spec:   SymbolStr;

    static null() -> MonoCallSpecializer {
        return MonoCallSpecializer {
            arena:            null,
            generic_registry: null,
            intern_table:     null,
            diagnostics:      null,
            type_resolver:    null,
            decl_index:       null,
            state:            null,
            trait_spec:       null,
            ast_resolver:     null,
            current_module:   SymbolStr::empty(),
            current_ns:       SymbolStr::empty(),
            gsm_owner_leaf:   SymbolStr::empty(),
            gsm_owner_recv:   TypeRef::invalid(),
            gsm_owner_spec:   SymbolStr::empty(),
        };
    }

    wire(mut &this, arena: TypeArena*, generic_registry: GenericRegistry*,
                    intern_table: InternTable*, diagnostics: DiagnosticSink*,
                    type_resolver: TypeResolver*, decl_index: DeclarationIndex*,
                    state: MonoState*, trait_spec: MonoTraitSpecializer*,
                    ast_resolver: MonoAstResolver*) -> void {
        this.arena            = arena;
        this.generic_registry = generic_registry;
        this.intern_table     = intern_table;
        this.diagnostics      = diagnostics;
        this.type_resolver    = type_resolver;
        this.decl_index       = decl_index;
        this.state            = state;
        this.trait_spec       = trait_spec;
        this.ast_resolver     = ast_resolver;
    }

    set_current_module(mut &this, module: SymbolStr) -> void {
        this.current_module = module;
    }

    set_current_ns(mut &this, ns: SymbolStr) -> void {
        this.current_ns = ns;
    }


    // -- Module walk (replaces discover_inferred_calls_in_module) --

    /// Walk every non-generic top-level declaration's body and specialize each
    /// generic free/method/static call from sema's stash.  Generic carriers are
    /// skipped: their bodies are walked per-instantiation when their own spec is
    /// materialized (the body-rewalk inside specialize_method).
    specialize_calls_in_module(mut &this, root: ProgramNode*) -> void {
        if (root == null) { return; }
        const _empty: string = "";
        mut res_ctx: ResolutionContext = ResolutionContext::new(_empty, _empty);
        for (mut i: i64 = 0; i < root.statements.length; i++) {
            const stmt: ASTNode* = root.statements[i];
            if (stmt == null) { continue; }
            match (stmt.kind) {
                NodeKind::FunctionDeclaration => {
                    const func: FunctionDeclNode* = stmt as FunctionDeclNode*;
                    if (func.is_generic()) { continue; }
                    this.walk_func_body(func, &res_ctx);
                }
                NodeKind::StructDeclaration => {
                    const sn: StructDeclNode* = stmt as StructDeclNode*;
                    if (sn.is_generic()) { continue; }
                    this.walk_methods(sn.methods, &res_ctx);
                }
                NodeKind::UnionDeclaration => {
                    const un: UnionDeclNode* = stmt as UnionDeclNode*;
                    if (un.is_generic()) { continue; }
                    this.walk_methods(un.methods, &res_ctx);
                }
                NodeKind::ClassDeclaration => {
                    const cn: ClassDeclNode* = stmt as ClassDeclNode*;
                    if (cn.is_generic()) { continue; }
                    this.walk_methods(cn.methods, &res_ctx);
                }
                NodeKind::ImplementationBlock => {
                    const ib: ImplBlockNode* = stmt as ImplBlockNode*;
                    if (ib.generic_params.length > 0) { continue; }
                    this.walk_methods(ib.methods, &res_ctx);
                }
                _ => {}
            }
        }
    }

    walk_methods(mut &this, methods: &MethodNode*[], res_ctx: ResolutionContext*) -> void {
        for (mut k: i64 = 0; k < methods.length; k++) {
            const m: MethodNode* = methods[k];
            if (m == null || m.func == null) { continue; }
            if (m.func.is_generic()) { continue; }
            this.walk_func_body(m.func, res_ctx);
        }
    }

    walk_func_body(mut &this, func: FunctionDeclNode*, res_ctx: ResolutionContext*) -> void {
        if (func == null || func.body == null) { return; }
        // No local-variable table is built: sema typed every expression, so the
        // receiver/argument types come from `resolved_type`, not a mono mini-sema.
        this.walk_block(func.body, res_ctx, null);
    }

    /// Walk a freshly-specialized declaration's bodies and specialize the generic
    /// calls inside them, threading the active `subst`.  The orchestrator calls
    /// this right after `resolve_specialized_ast`: a spec'd type's / function's
    /// body is NOT in the module root the `specialize_calls_in_module` walk
    /// traverses, and `resolve_func_and_body` no longer re-derives its inner calls
    /// via inference, so the only place a spec'd body's `mem::offset<T>`-style
    /// generic calls get consumed (and the resulting fn/type specializations
    /// enqueued) is here.  `subst` concretizes any template-param binding the
    /// ASTTypeSubstituter didn't reach in the clone (no-op on an already-concrete
    /// stash).  Generic instance/static methods are handled per-call by the
    /// method-call path, so only non-generic carrier bodies are walked.
    specialize_calls_in_spec_decl(mut &this, decl: ASTNode*,
                                  subst: TypeSubstitution*) -> void {
        if (decl == null) { return; }
        const _empty: string = "";
        mut res_ctx: ResolutionContext = ResolutionContext::new(_empty, _empty);
        match (decl.kind) {
            NodeKind::FunctionDeclaration => {
                const f: FunctionDeclNode* = decl as FunctionDeclNode*;
                if (f.body != null) { this.walk_block(f.body, &res_ctx, subst); }
            }
            NodeKind::StructDeclaration => {
                this.walk_spec_methods((decl as StructDeclNode*).methods, &res_ctx, subst);
            }
            NodeKind::UnionDeclaration => {
                this.walk_spec_methods((decl as UnionDeclNode*).methods, &res_ctx, subst);
            }
            NodeKind::ClassDeclaration => {
                this.walk_spec_methods((decl as ClassDeclNode*).methods, &res_ctx, subst);
            }
            NodeKind::ImplementationBlock => {
                this.walk_spec_methods((decl as ImplBlockNode*).methods, &res_ctx, subst);
            }
            _ => {}
        }
    }

    walk_spec_methods(mut &this, methods: &MethodNode*[], res_ctx: ResolutionContext*,
                      subst: TypeSubstitution*) -> void {
        for (mut k: i64 = 0; k < methods.length; k++) {
            const m: MethodNode* = methods[k];
            if (m == null || m.func == null) { continue; }
            if (m.func.is_generic()) { continue; }
            if (m.func.body != null) { this.walk_block(m.func.body, res_ctx, subst); }
        }
    }


    // -- Body walk: find generic calls, dispatch to the per-call consumers --

    walk_block(mut &this, block: BlockStmtNode*, res_ctx: ResolutionContext*,
               subst: TypeSubstitution*) -> void {
        if (block == null) { return; }
        for (mut i: i64 = 0; i < block.statements.length; i++) {
            this.walk_stmt(block.statements[i], res_ctx, subst);
        }
    }

    walk_stmt(mut &this, stmt: StatementNode*, res_ctx: ResolutionContext*,
              subst: TypeSubstitution*) -> void {
        if (stmt == null) { return; }
        const node: ASTNode* = stmt as ASTNode*;
        match (node.kind) {
            NodeKind::ExpressionStatement => {
                const es: ExprStmtNode* = stmt as ExprStmtNode*;
                this.walk_expr(es.expression, res_ctx, subst);
            }
            NodeKind::DeclarationStatement => {
                const ds: DeclStmtNode* = stmt as DeclStmtNode*;
                const inner: DeclarationNode* = ds.declaration;
                if (inner != null && (inner as ASTNode*).kind == NodeKind::VariableDeclaration) {
                    mut vd: VarDeclNode* = inner as VarDeclNode*;
                    // Inside a generic-static-method body re-walk: a local typed with
                    // the bare owner name (`mut s: String`) keeps the bare template
                    // type; point it at the concrete owner spec (by name + type) so
                    // it agrees with the concretized return and the post-mono sema
                    // pass, exactly as owner materialization types a non-generic
                    // sibling's local.
                    if (this.gsm_owner_recv.is_valid()) {
                        this.concretize_owner_local(vd);
                    }
                    if (vd.initializer != null) {
                        this.walk_expr(vd.initializer, res_ctx, subst);
                        // Sema already typed this binding to a concrete
                        // instantiation (e.g. an adapter CHAIN result
                        // `CopiedIter<RefIter<i32>>` whose receiver is a
                        // method-call temporary mono can't reconstruct).  Treat
                        // sema's binding type as the demand and enqueue it
                        // directly; enqueue_from_type_ref is a guarded no-op unless
                        // it is a registered template with fully concrete args.
                        if (vd.resolved_type.is_valid()) {
                            mut bind_ty: TypeRef = vd.resolved_type;
                            if (subst != null) { bind_ty = subst.apply(bind_ty, this.arena); }
                            this.state.enqueue_from_type_ref(bind_ty);
                        }
                    }
                }
            }
            NodeKind::ReturnStatement => {
                const rs: ReturnStmtNode* = stmt as ReturnStmtNode*;
                if (rs.expression != null) {
                    this.walk_expr(rs.expression, res_ctx, subst);
                }
            }
            NodeKind::BlockStatement => {
                this.walk_block(stmt as BlockStmtNode*, res_ctx, subst);
            }
            NodeKind::IfStatement => {
                const ifs: IfStmtNode* = stmt as IfStmtNode*;
                this.walk_expr(ifs.condition, res_ctx, subst);
                if (ifs.then_stmt != null) { this.walk_stmt(ifs.then_stmt, res_ctx, subst); }
                if (ifs.has_else() && ifs.else_stmt != null) {
                    this.walk_stmt(ifs.else_stmt, res_ctx, subst);
                }
            }
            NodeKind::WhileStatement => {
                const ws: WhileStmtNode* = stmt as WhileStmtNode*;
                this.walk_expr(ws.condition, res_ctx, subst);
                if (ws.body != null) { this.walk_stmt(ws.body, res_ctx, subst); }
            }
            NodeKind::ForStatement => {
                const fs: ForStmtNode* = stmt as ForStmtNode*;
                if (fs.condition != null) { this.walk_expr(fs.condition, res_ctx, subst); }
                if (fs.body != null) { this.walk_stmt(fs.body, res_ctx, subst); }
            }
            NodeKind::LoopStatement => {
                const ls: LoopStmtNode* = stmt as LoopStmtNode*;
                if (ls.body != null) { this.walk_stmt(ls.body, res_ctx, subst); }
            }
            NodeKind::MatchStatement => {
                const ms: MatchStmtNode* = stmt as MatchStmtNode*;
                this.walk_expr(ms.subject, res_ctx, subst);
                for (mut i: i64 = 0; i < ms.arms.length; i++) {
                    const arm: MatchArmNode* = ms.arms[i];
                    if (arm == null) { continue; }
                    if (arm.guard != null) { this.walk_expr(arm.guard, res_ctx, subst); }
                    if (arm.body != null) { this.walk_stmt(arm.body, res_ctx, subst); }
                }
            }
            NodeKind::StaticMatchStatement => {
                const sm: StaticMatchStmtNode* = stmt as StaticMatchStmtNode*;
                for (mut i: i64 = 0; i < sm.arms.length; i++) {
                    const arm: StaticMatchArmNode* = sm.arms[i];
                    if (arm != null && arm.body != null) {
                        this.walk_stmt(arm.body, res_ctx, subst);
                    }
                }
            }
            _ => {}
        }
    }

    walk_expr(mut &this, expr: ExpressionNode*, res_ctx: ResolutionContext*,
              subst: TypeSubstitution*) -> void {
        if (expr == null) { return; }
        const node: ASTNode* = expr as ASTNode*;
        match (node.kind) {
            NodeKind::CallExpression => {
                const call: CallExprNode* = expr as CallExprNode*;
                for (mut i: i64 = 0; i < call.arguments.length; i++) {
                    this.walk_expr(call.arguments[i], res_ctx, subst);
                }
                if (call.callee != null) {
                    this.walk_expr(call.callee, res_ctx, subst);
                }
                this.specialize_free_call(call, res_ctx, subst);
                this.specialize_method_call(call, subst);
            }
            NodeKind::BinaryExpression => {
                const be: BinaryExprNode* = expr as BinaryExprNode*;
                this.walk_expr(be.left, res_ctx, subst);
                this.walk_expr(be.right, res_ctx, subst);
                // An operator-overload desugar (`a.add(&b)`) is a method call
                // that may need specialization (e.g. `Vec<i32>::add`); walk it
                // so nested/generic instantiations are discovered.
                if (be.desugared_call != null) {
                    this.walk_expr(be.desugared_call, res_ctx, subst);
                }
            }
            NodeKind::UnaryExpression => {
                const ue: UnaryExprNode* = expr as UnaryExprNode*;
                this.walk_expr(ue.operand, res_ctx, subst);
                if (ue.desugared_call != null) {
                    this.walk_expr(ue.desugared_call, res_ctx, subst);
                }
            }

            NodeKind::TryExpression => {
                const te: TryExprNode* = expr as TryExprNode*;
                this.walk_expr(te.operand, res_ctx, subst);
            }
            NodeKind::IfExpression => {
                const ie: IfExprNode* = expr as IfExprNode*;
                this.walk_expr(ie.condition, res_ctx, subst);
                this.walk_expr(ie.then_expr, res_ctx, subst);
                this.walk_expr(ie.else_expr, res_ctx, subst);
            }
            NodeKind::MatchExpression => {
                const me: MatchExprNode* = expr as MatchExprNode*;
                this.walk_expr(me.subject, res_ctx, subst);
                for (mut i: i64 = 0; i < me.arms.length; i++) {
                    const arm: MatchArmNode* = me.arms[i];
                    if (arm == null) { continue; }
                    if (arm.guard != null) { this.walk_expr(arm.guard, res_ctx, subst); }
                    if (arm.body != null) { this.walk_stmt(arm.body, res_ctx, subst); }
                }
            }
            NodeKind::StaticMatchExpression => {
                const sme: StaticMatchExprNode* = expr as StaticMatchExprNode*;
                for (mut i: i64 = 0; i < sme.arms.length; i++) {
                    const arm: StaticMatchArmNode* = sme.arms[i];
                    if (arm != null && arm.body != null) {
                        this.walk_stmt(arm.body, res_ctx, subst);
                    }
                }
            }
            NodeKind::MemberAccess => {
                const ma: MemberAccessNode* = expr as MemberAccessNode*;
                this.walk_expr(ma.object, res_ctx, subst);
            }
            NodeKind::ArrayAccess => {
                const aa: ArrayAccessNode* = expr as ArrayAccessNode*;
                this.walk_expr(aa.array, res_ctx, subst);
                this.walk_expr(aa.index, res_ctx, subst);
                // An index-operator-overload desugar (`*(a.index(i))`) is a
                // method call that may need specialization (e.g.
                // `Vec<i32>::index`); walk it so nested/generic instantiations
                // are discovered.
                if (aa.desugared_call != null) {
                    this.walk_expr(aa.desugared_call, res_ctx, subst);
                }
            }
            NodeKind::CastExpression => {
                const ce: CastExprNode* = expr as CastExprNode*;
                this.walk_expr(ce.expression, res_ctx, subst);
            }
            NodeKind::StructLiteral => {
                const sl: StructLiteralNode* = expr as StructLiteralNode*;
                // Only while re-walking a generic-static-method's specialized body
                // (gsm_owner_* set): concretize an owner-typed struct literal
                // (`Wrap { v: item }`) whose type the symbolic template walk left
                // bare/invalid.  Gated on `gsm_owner_recv` so the ordinary walk path
                // is byte-identical to before.
                if (this.gsm_owner_recv.is_valid()) {
                    if (sl.struct_type.equals(this.gsm_owner_leaf)) {
                        // Point the literal at the concrete owner spec by NAME and
                        // type so the post-mono sema pass (Phase 6b) re-resolves it to
                        // the spec (not the bare template), regardless of context.
                        sl.set_resolved_type(this.gsm_owner_recv);
                        if (this.gsm_owner_spec.is_valid()) {
                            sl.struct_type = this.gsm_owner_spec;
                        }
                    } else if (subst != null && sl.resolved_type.is_valid()) {
                        // A different generic type built in the body (`Pair<T>{..}`):
                        // concretize via the active owner/method subst.
                        const concrete: TypeRef = subst.apply(sl.resolved_type, this.arena);
                        if (concrete.is_valid() && concrete.id != sl.resolved_type.id
                                && !this.arena.contains_generic_param(concrete)) {
                            sl.set_resolved_type(concrete);
                        }
                    }
                }
                for (mut i: i64 = 0; i < sl.field_inits.length; i++) {
                    this.walk_expr(sl.field_inits[i].value, res_ctx, subst);
                }
            }
            NodeKind::ArrayLiteral => {
                const al: ArrayLiteralNode* = expr as ArrayLiteralNode*;
                for (mut i: i64 = 0; i < al.elements.length; i++) {
                    this.walk_expr(al.elements[i], res_ctx, subst);
                }
            }
            NodeKind::Identifier => {
                // A bare identifier carrying turbofish args is a generic
                // function-reference VALUE (`tramp<i32>` passed/cast/assigned).
                this.specialize_fn_value_ref(expr as IdentifierNode*, res_ctx, subst);
            }
            _ => {}
        }
    }


    // -- Free-function call specialization (consumes call.resolved_type_args) --

    /// Pin a specialized callee on a generic free-function call so codegen can
    /// resolve it, and queue the instantiation.  Bindings come from sema's stash
    /// (`call.resolved_type_args`); a call without a stash is outside sema's
    /// visibility and is left unspecialized.
    specialize_free_call(mut &this, call: CallExprNode*, res_ctx: ResolutionContext*,
                         subst: TypeSubstitution*) -> void {
        if (call == null) { return; }
        if (call.resolved_callee.is_valid()) { return; }
        if (call.callee == null) { return; }
        const callee_node: ASTNode* = call.callee as ASTNode*;

        // Extract the bare callee name and any qualifying scope.
        mut callee_name:  SymbolStr = SymbolStr::empty();
        mut callee_scope: SymbolStr = SymbolStr::empty();
        if (callee_node.kind == NodeKind::Identifier) {
            const ident: IdentifierNode* = call.callee as IdentifierNode*;
            callee_name = ident.name;
        } else if (callee_node.kind == NodeKind::ScopeResolution) {
            const sr: ScopeResolutionNode* = call.callee as ScopeResolutionNode*;
            callee_name  = sr.member_name;
            callee_scope = sr.scope_name;
        } else {
            return;
        }

        // Look up the function template (same precedence ladder sema uses, so the
        // instantiated spec and the call's resolved callee agree).
        mut entry: TemplateEntry* = null;
        if (callee_scope.is_valid()) {
            const member_str: string = this.intern_table.resolve(callee_name);
            const qualified_scope: SymbolStr = if (this.decl_index != null) {
                this.decl_index.resolve_qualified_scoped_or(
                    callee_scope, this.current_ns, this.intern_table)
            } else {
                callee_scope
            };
            const qscope_str: string = this.intern_table.resolve(qualified_scope);
            const qualified_str: string = qscope_str + "::" + member_str;
            const qsym: SymbolStr = this.intern_table.intern(qualified_str);
            const call_arity_di: i64 = call.arguments.length;
            const qe: TemplateEntry* = this.generic_registry.get_template(qsym);
            if (qe != null && qe.node_kind == NodeKind::FunctionDeclaration
                    && this.fn_template_arity_compatible(qe, call_arity_di)) {
                entry = qe;
            }
            if (entry == null && !qualified_scope.equals(callee_scope)) {
                const bscope_str: string = this.intern_table.resolve(callee_scope);
                const bare_str: string = bscope_str + "::" + member_str;
                const bsym: SymbolStr = this.intern_table.intern(bare_str);
                const be: TemplateEntry* = this.generic_registry.get_template(bsym);
                if (be != null && be.node_kind == NodeKind::FunctionDeclaration
                        && this.fn_template_arity_compatible(be, call_arity_di)) {
                    entry = be;
                }
            }
            if (entry == null && this.decl_index != null) {
                const scope_as_type: TypeRef = this.decl_index.lookup_type(callee_scope);
                const qscope_as_type: TypeRef =
                    if (qualified_scope.equals(callee_scope)) {
                        scope_as_type
                    } else {
                        this.decl_index.lookup_type(qualified_scope)
                    };
                if (!scope_as_type.is_valid() && !qscope_as_type.is_valid()) {
                    // Scope-qualified call to a non-type (module-alias) scope:
                    // only accept a free-function template that lives in that module.
                    entry = this.find_scoped_function_template(
                        callee_name, callee_scope, call.arguments.length);
                } else {
                    // Scope resolves to a TYPE: this may be a non-generic static
                    // method on a GENERIC owner (`Slice<T>::from_raw`,
                    // `String<GA>::from_string`).  Sema stashed the owner's type args;
                    // consume them.  When handled (callee pinned + owner enqueued),
                    // stop — there is no free-function template to instantiate.
                    const sr2: ScopeResolutionNode* = call.callee as ScopeResolutionNode*;
                    if (this.specialize_static_method_on_generic_owner(call, sr2, subst)) {
                        return;
                    }
                }
            }
        } else {
            entry = this.find_function_template_for_call(callee_name, call.arguments.length);
        }
        if (entry == null) { return; }
        const tmpl_func: FunctionDeclNode* = entry.ast_node as FunctionDeclNode*;
        if (tmpl_func == null) { return; }

        // Seed bindings from sema's stash (the source of truth).  Apply the active
        // specialization `subst`: a stash on a template body holds the enclosing
        // template's params; this spec concretizes them (no-op on a concrete stash).
        if (entry.param_type_ids.length == 0) { return; }
        if (call.resolved_type_args.length != entry.param_type_ids.length) {
            // No (or partial) stash: outside sema's visibility; leave unspecialized.
            // (Invariant #2 candidate to HARDEN to an ICE once the reorder is
            // validated end-to-end — left as a soft return during bring-up.)
            return;
        }
        mut bindings: TypeRef[] = [];
        mut all_bound: boolean = true;
        for (mut i: i64 = 0; i < call.resolved_type_args.length; i++) {
            mut b: TypeRef = call.resolved_type_args[i];
            if (subst != null) { b = subst.apply(b, this.arena); }
            if (!b.is_valid()) { all_bound = false; break; }
            bindings.push(b);
        }
        if (!all_bound) { return; }

        // Where-clause bound check at the call site.  If the bindings don't satisfy
        // the function's `where T: Trait` clauses, emit a diagnostic and skip
        // pin + queue (which suppresses the cascade from the rejected body).
        if (!this.check_function_bounds_at_call(call, tmpl_func, entry, &bindings)) {
            return;
        }

        // Pin the specialized callee symbol + queue the instantiation.
        const base_sym: SymbolStr = entry.spec_base_name(this.intern_table);
        const base_qname: QualifiedName = QualifiedName::from_symbol(base_sym);
        const spec_sym: SymbolStr = MangledName::specialized_identifier(
            this.intern_table, this.arena, base_qname, bindings);
        if (!spec_sym.is_valid()) { return; }
        call.set_resolved_callee(spec_sym);
        const new_inst: TypeRef = this.generic_registry.instantiate_for_module(
            entry.base_type, bindings, this.current_module);
        // Seed mono's pending worklist directly: the registry only tracks
        // cache_keys, and drain_pending_worklist iterates `pending`.
        this.state.enqueue_from_type_ref(new_inst);
    }

    /// Resolve a generic function-reference value `name<Args>` used as a
    /// first-class value: resolve the explicit turbofish args, pin the specialized
    /// callee symbol on the identifier, and queue the instantiation.  No-op for
    /// ordinary identifiers (no turbofish).  This reads explicit turbofish args
    /// directly (not a stash) — it is not inference.
    specialize_fn_value_ref(mut &this, ident: IdentifierNode*,
                            res_ctx: ResolutionContext*,
                            subst: TypeSubstitution*) -> void {
        if (ident == null) { return; }
        if (ident.generic_args.length == 0) { return; }
        if (ident.resolved_callee.is_valid()) { return; }
        if (this.type_resolver == null || res_ctx == null) { return; }
        if (this.generic_registry == null) { return; }

        // A first-class function-reference value (`f<i32>` not invoked) has no
        // call arity; -1 leaves the lookup to disambiguate by module prefix.
        const entry: TemplateEntry* = this.find_function_template_for_call(ident.name, -1);
        if (entry == null) { return; }
        if (entry.node_kind != NodeKind::FunctionDeclaration) { return; }

        mut seeded: TypeRef[] = [];
        for (mut i: i64 = 0; i < ident.generic_args.length; i++) {
            mut tr: TypeRef = this.type_resolver.resolve(ident.generic_args[i], res_ctx);
            if (!tr.is_valid()) { return; }
            if (subst != null) { tr = subst.apply(tr, this.arena); }
            seeded.push(tr);
        }
        seeded = this.type_resolver.expand_default_type_args(entry, seeded, res_ctx);
        if (seeded.length != entry.param_type_ids.length) { return; }

        const base_sym: SymbolStr = entry.spec_base_name(this.intern_table);
        const base_qname: QualifiedName = QualifiedName::from_symbol(base_sym);
        const spec_sym: SymbolStr = MangledName::specialized_identifier(
            this.intern_table, this.arena, base_qname, seeded);
        if (!spec_sym.is_valid()) { return; }
        ident.set_resolved_callee(spec_sym);
        const new_inst: TypeRef = this.generic_registry.instantiate_for_module(
            entry.base_type, seeded, this.current_module);
        this.state.enqueue_from_type_ref(new_inst);
    }


    // -- Method-call specialization (consumes call.resolved_type_args) --

    /// Specialize a generic method call from sema's method-level binding stash.
    /// Ported from the monolith `try_infer_method_call` (5500-5909), DEINFERENCED:
    ///   * RECEIVER: `ma.object.resolved_type` (sema-pinned) replaces the deleted
    ///     resolve_arg_type_for_inference + static-call / fluent-builder recovery.
    ///   * BINDINGS: the method's own generics come from `call.resolved_type_args`
    ///     (sema's stash); the formal/actual unify engine is gone.
    ///   * ADAPTER RECEIVERS: there is no synchronous `ensure_receiver_inst_resolved`
    ///     (it needed the orchestrator's spec cache).  Instead the unwrap loop leaves
    ///     an unresolved adapter inst alone; `find_spec_inline_method` enqueues it, and
    ///     the run_monomorphization walk/drain FIXPOINT resolves the chained call on a
    ///     later iteration (sema pre-types adapter returns as concrete InstantiatedTypes).
    /// Reconstruct a method-call receiver's type in a specialized body when the
    /// cloner has reset the receiver expression's `resolved_type`.  A pure
    /// structural READ over sema-given types: any expression sema typed returns
    /// that type as-is; a member access resolves its object's type, unwraps to the
    /// underlying struct/class, and reads the named field's DECLARED type.  This is
    /// not inference and it does NOT concretize via the substitution — applying
    /// the subst would mint untracked arena instantiations as a side effect, even
    /// on calls that later bail.  Concretization isn't needed for the cases this
    /// serves (a non-generic-owner receiver like the field `this.h : Inner`, whose
    /// declared field type is already concrete); a still-generic reconstruction is
    /// harmless because such a (generic-type-spec) receiver is gated out of the
    /// derived path by its caller.  Returns invalid when the shape isn't
    /// reconstructible (caller then bails).
    derive_receiver_type(&this, expr: ExpressionNode*) -> TypeRef {
        if (expr == null) { return TypeRef::invalid(); }
        if (expr.resolved_type.is_valid()) { return expr.resolved_type; }
        const node: ASTNode* = expr as ASTNode*;
        if (node.kind != NodeKind::MemberAccess) { return TypeRef::invalid(); }
        const ma: MemberAccessNode* = expr as MemberAccessNode*;
        const base: TypeRef = this.derive_receiver_type(ma.object);
        if (!base.is_valid()) { return TypeRef::invalid(); }
        // Unwrap Pointer/Reference/resolved-InstantiatedType to the struct/class.
        mut bt: Type* = this.arena.lookup(base.id);
        mut depth: i32 = 0;
        while (bt != null && depth < 8) {
            if (bt.kind == TypeKind::Pointer) {
                bt = this.arena.lookup((bt as PointerType*).pointee.id);
            } else if (bt.kind == TypeKind::Reference) {
                bt = this.arena.lookup((bt as ReferenceType*).referent.id);
            } else if (bt.kind == TypeKind::InstantiatedType) {
                const inst: InstantiatedType* = bt as InstantiatedType*;
                if (!inst.has_resolved_type()) { return TypeRef::invalid(); }
                bt = this.arena.lookup(inst.resolved_type.id);
            } else {
                break;
            }
            depth += 1;
        }
        if (bt == null) { return TypeRef::invalid(); }
        if (bt.kind == TypeKind::Struct) {
            const fi: FieldInfo* = (bt as StructType*).get_field(ma.member);
            if (fi != null) { return fi.field_type; }
        } else if (bt.kind == TypeKind::Class) {
            const fi: FieldInfo* = (bt as ClassType*).get_field(ma.member);
            if (fi != null) { return fi.field_type; }
        }
        return TypeRef::invalid();
    }

    specialize_method_call(mut &this, call: CallExprNode*, subst: TypeSubstitution*) -> void {
        if (call == null) { return; }
        // An already-concrete (non-generic, or already-minted spec) resolved method
        // needs no work; mono pins the spec back into resolved_method at the end, so
        // a re-walk over the same call (fixpoint) lands here and short-circuits.
        //
        // EXCEPTION: a self-returning / lazy-self-growing adapter default
        // (`take`/`filter`/`map`/...) is pinned by sema by NAME (it has 0 own
        // generics) but is still an un-instantiated template. On a CONCRETE
        // user-iterator receiver (`it: UpTo; it.take(n)`) sema resolves and pins
        // the unspecialized default; short-circuiting here would leave it never
        // instantiated and codegen would find no emitted `take` (E0636). Let these
        // fall through to `try_instantiate_self_returning_default` below. (Once
        // instantiated, the spec carries `is_self_returning_default = false`, so the
        // fixpoint re-walk short-circuits correctly.)
        if (call.resolved_method != null) {
            const rm: MethodNode* = call.resolved_method as MethodNode*;
            if (rm == null || rm.func == null) { return; }
            if (rm.func.generic_params.length == 0
                    && !rm.func.is_self_returning_default
                    && !rm.func.is_lazy_self_growing) {
                return;
            }
        }
        if (call.callee == null) { return; }
        const callee_node: ASTNode* = call.callee as ASTNode*;
        if (callee_node.kind != NodeKind::MemberAccess) { return; }
        const ma: MemberAccessNode* = call.callee as MemberAccessNode*;

        // RECEIVER from sema (invariant #1): sema typed every receiver.  Apply the
        // active spec subst (the call may be walked inside a still-generic spec body).
        // In a specialized body the cloner reset the receiver expression's
        // `resolved_type`; for the member-access shape (`this.h.relay(w)`) the type
        // is reconstructed structurally from the (carried) object type + the named
        // field, which is spec-local and authoritative — no re-inference.
        mut recv_type: TypeRef = ma.object.resolved_type;
        mut recv_derived: boolean = false;
        if (recv_type.is_valid()) {
            if (subst != null) { recv_type = subst.apply(recv_type, this.arena); }
        } else {
            recv_type = this.derive_receiver_type(ma.object);
            recv_derived = true;
        }
        if (!recv_type.is_valid()) { return; }

        // Unwrap Reference/Pointer/InstantiatedType to a concrete Struct/Class/Enum
        // (what spec_entries.specialized_type points at).  An unresolved adapter inst
        // is left as-is for the is_unresolved_inst path + fixpoint re-walk.
        mut t: Type* = this.arena.lookup(recv_type.id);
        mut depth: i32 = 0;
        while (t != null && depth < 8) {
            if (t.kind == TypeKind::Pointer) {
                recv_type = (t as PointerType*).pointee;
                t = this.arena.lookup(recv_type.id);
            } else if (t.kind == TypeKind::Reference) {
                recv_type = (t as ReferenceType*).referent;
                t = this.arena.lookup(recv_type.id);
            } else if (t.kind == TypeKind::InstantiatedType) {
                const inst: InstantiatedType* = t as InstantiatedType*;
                if (inst.has_resolved_type()) {
                    recv_type = inst.resolved_type;
                    t = this.arena.lookup(recv_type.id);
                } else {
                    // A substituter-minted nested receiver (`this.try_push(item)`
                    // cloned into `String<Str>::push`) carries fresh arg TypeIDs and
                    // so missed `instantiated_cache`/`resolved_type`, even though its
                    // logical spec is already materialized.  Recover the spec by
                    // structural equality so the lookup ladder + qualified-name keying
                    // match the in-source path; else leave it for the fixpoint re-walk.
                    const spec_ty: TypeRef = this.resolve_unresolved_inst_via_spec(recv_type);
                    if (!spec_ty.is_valid()) { break; }
                    recv_type = spec_ty;
                    t = this.arena.lookup(recv_type.id);
                }
            } else {
                break;
            }
            depth += 1;
        }
        if (t == null) { return; }
        // A bare generic-template struct used directly as a receiver (`this` in
        // `implement FmtWrite for struct String`, or `mut s: String` with all params
        // defaulted) is NOT a materialized spec, so a generic method on it (`try_push<T>`)
        // resolves to nothing in the lookup ladder and the call is left unpinned —
        // codegen's name+arity fallback then picks an arbitrary sibling spec once more
        // than one exists (e.g. try_push<Str> -> try_push<i32>, corrupting all
        // formatting).  Canonicalize to the DEFAULT instantiation's emitted spec
        // (String<GlobalAlloc>) so the call pins a symbol that is actually emitted.
        if (t.kind == TypeKind::Struct || t.kind == TypeKind::Class) {
            const canon: TypeRef = this.canonicalize_default_template_recv(recv_type);
            if (canon.is_valid() && canon.id != recv_type.id) {
                recv_type = canon;
                t = this.arena.lookup(recv_type.id);
                if (t == null) { return; }
            }
        }
        const tk: TypeKind = t.kind;
        const is_user_kind: boolean = tk == TypeKind::Struct
                                   || tk == TypeKind::Class
                                   || tk == TypeKind::Enum;
        const is_primitive_kind: boolean = tk == TypeKind::Int
                                        || tk == TypeKind::Float
                                        || tk == TypeKind::Bool
                                        || tk == TypeKind::Char
                                        || tk == TypeKind::String;
        const is_unresolved_inst: boolean = tk == TypeKind::InstantiatedType;
        if (!is_user_kind && !is_primitive_kind && !is_unresolved_inst) { return; }

        // Zero-own-generic self-returning combinator defaults (take/filter) are
        // instantiated lazily here; own-generic ones (map<B>) fall through.
        if (this.try_instantiate_self_returning_default(call, ma, recv_type)) {
            return;
        }

        // Method-lookup ladder (LOOKUP, not inference; precedence is load-bearing).
        mut impl_node: ImplBlockNode* = null;
        mut inherent_owner_ast: ASTNode* = null;
        mut orig_method: MethodNode* = null;
        if (is_user_kind || is_unresolved_inst) {
            orig_method = this.find_spec_impl_method(recv_type, ma.member, ma.resolved_trait, &impl_node);
            if (orig_method == null) {
                orig_method = this.find_inherent_method(recv_type, ma.member, &inherent_owner_ast);
            }
            if (orig_method == null) {
                orig_method = this.find_spec_inline_method(recv_type, ma.member, &inherent_owner_ast);
            }
            if (orig_method == null) {
                // Synthesized/hand-written generic trait method on a non-generic
                // user type (e.g. a `Display::fmt<W>` keyed by the bare target).
                const bare: SymbolStr = this.trait_spec.bare_name_of(recv_type);
                const recv_q: SymbolStr = this.arena.get_qualified_name(recv_type);
                mut cand_impl: ImplBlockNode* = null;
                const cand: MethodNode* = this.find_trait_impl_method_for_target(
                    bare, ma.member, ma.resolved_trait, recv_q, &cand_impl);
                if (cand != null && cand.func != null
                        && (cand.func.is_synth_default || cand.func.is_generic())) {
                    orig_method = cand;
                    impl_node = cand_impl;
                }
            }
        } else {
            const bare: SymbolStr = this.trait_spec.bare_name_of(recv_type);
            const recv_q: SymbolStr = this.arena.get_qualified_name(recv_type);
            orig_method = this.find_trait_impl_method_for_target(
                bare, ma.member, ma.resolved_trait, recv_q, &impl_node);
            // Inherent (non-trait) generic method on a primitive receiver
            // (`"42".parse_int<u64>()` on `implement string`).  Not in the
            // trait-impl registry; consult the inherent-impl registry, keyed by
            // the receiver's bare name, and route the spec through the impl_node
            // path below (push onto impl_node.methods + DI-register).
            if (orig_method == null && this.generic_registry != null) {
                orig_method = this.generic_registry.find_inherent_impl_generic_method(
                    bare, ma.member, &impl_node);
                if (orig_method == null) {
                    const qbare: SymbolStr = this.arena.get_qualified_name(recv_type);
                    if (qbare.is_valid() && !qbare.equals(bare)) {
                        orig_method = this.generic_registry.find_inherent_impl_generic_method(
                            qbare, ma.member, &impl_node);
                    }
                }
            }
        }
        if (orig_method == null) { return; }
        if (impl_node == null && inherent_owner_ast == null) { return; }

        // Two specialization regimes for a generic method `m<W>` on receiver `R`:
        //   * R is a NON-generic owner (`Inner`): there is NO monomorphization of
        //     R, so `m<W>` specs exist ONLY because a call site demands them.  A
        //     spec'd-body call (whose receiver type we reconstructed above) is a
        //     real, possibly sole, demand — it MUST be specialized here.  This is
        //     the inherent path (`inherent_owner_ast != null`).
        //   * R is a generic-type SPEC (`Array<i32>`): `m<W>` is materialized and
        //     placed by the canonical in-source / struct-spec machinery, driven by
        //     in-source demand.  Re-driving it from a reconstructed receiver in a
        //     specialized body races that machinery's cross-module placement and
        //     corrupts R's spec (a sibling static like `Array::try_with_capacity_in`
        //     then fails to resolve).  Reconstruction therefore serves ONLY the
        //     non-generic-owner regime; for a generic-type-spec receiver we leave
        //     the call to the established path.
        // An inherent (non-trait) impl on a NON-generic / primitive receiver
        // (e.g. `string::parse_int<T>`) is the same non-generic-owner regime as
        // `inherent_owner_ast`: reconstruction is safe and, crucially, this is
        // the path that PINS `resolved_callee` to the return-distinct spec
        // symbol.  Without allowing it, a reconstructed receiver (string-literal
        // calls reset `resolved_type`) skips the pin and codegen collapses every
        // instantiation onto the first via the unmangled `Type::method` fallback.
        const inherent_primitive_owner: boolean =
            impl_node != null && !impl_node.is_trait_impl();
        if (recv_derived && inherent_owner_ast == null && !inherent_primitive_owner) { return; }

        const orig_func: FunctionDeclNode* = orig_method.func;
        if (orig_func == null) { return; }

        // The method's OWN generic params (e.g. <H> on hash<H>).
        const n_method_params: i64 = orig_func.generic_params.length;
        if (n_method_params == 0) { return; }
        mut bindings: TypeRef[] = [];
        mut method_param_names: SymbolStr[] = [];
        for (mut i: i64 = 0; i < n_method_params; i++) {
            const gp: GenericParamNode* = orig_func.generic_params[i];
            if (gp == null) { return; }
            bindings.push(TypeRef::invalid());
            method_param_names.push(gp.name);
        }

        // Method-level bindings come SOLELY from sema's stash (declaration order).
        // A call without a length-matched stash is outside sema's visibility and is
        // left unspecialized (it was deferred pre-flip too).
        mut m_from_stash: boolean = false;
        if (call.resolved_type_args.length == n_method_params && n_method_params > 0) {
            m_from_stash = true;
            for (mut i: i64 = 0; i < n_method_params; i++) {
                mut sv: TypeRef = call.resolved_type_args[i];
                if (subst != null) { sv = subst.apply(sv, this.arena); }
                if (!sv.is_valid()) { m_from_stash = false; break; }
                bindings[i] = sv;
            }
        }
        if (!m_from_stash) { return; }

        // Defer when a binding isn't concrete: this call is being walked inside a
        // still-generic context (e.g. `value.fmt(f)` in a template body binds W to
        // the enclosing W).  Minting now would emit a bogus still-generic spec
        // (E0636); the concrete spec is minted when the enclosing method is itself
        // specialized with a concrete binding and its body re-walked (Shape-4 guard).
        for (mut bi: i64 = 0; bi < bindings.length; bi++) {
            if (this.arena.contains_generic_param(bindings[bi])) {
                return;
            }
        }

        const recv_qname: SymbolStr = this.arena.get_qualified_name(recv_type);
        const spec_method: MethodNode* = this.specialize_method(
            orig_method, &method_param_names, &bindings, recv_type, impl_node);
        if (spec_method == null) { return; }
        // The clone is a concrete specialization, not a deferred template.
        spec_method.func.set_self_returning_default(false);

        // Whether this spec is resolved through a PINNED `resolved_callee` (the
        // precise mangled symbol) rather than the trait-impl/combinator DI path.
        // Only the pinned (inherent) regime gets the `$MG…` method-spec-args
        // disambiguator: there the call pin, the codegen definition, and the DI
        // registration all fold `func.spec_type_args` in and so agree.  Trait-impl
        // specs stay unpinned and are disambiguated by their existing machinery
        // (owner-spec name / where-bound element); stamping them would make their
        // suffixed definition diverge from their unsuffixed combined-key
        // resolution (collapsing coexisting combinator specs onto the first).
        const inherent_pin: boolean = inherent_owner_ast != null
            || (impl_node != null && !impl_node.is_trait_impl());

        // A trait-impl generic method whose type params appear ONLY in the
        // return / where-bound - no VALUE parameter mentions them - can't be
        // told apart by its parameter-shaped mangle, and its owner-spec name is
        // the SAME across instantiations (the owner is one concrete type), so
        // two specs collapse onto the first emitted symbol.  Concretely
        // `JsonExtract::as<T>() -> Option<T> where T: TryFrom<&JsonValue>`
        // mangled to `...as...Option<boolean>` for EVERY `T`, and every
        // `as<i64>` / `as<Str>` call linked to the `as<boolean>` body.  Stamp
        // the `$MG…` method-spec args in that case too.  Iterator combinators
        // are structurally excluded: their method type param is always carried
        // by a value parameter (`chain<I>(other: I)`, `zip<U>(other: U)`,
        // `map<F>(f: F)`), so `method_generic_in_value_param` is true and this
        // branch never fires for them - their owner-spec disambiguation (a
        // distinct `ChainIter<...>` owner per spec) is preserved.
        mut method_generic_in_value_param: boolean = false;
        if (orig_func != null) {
            const this_amp_p: SymbolStr = this.intern_table.intern("&this");
            const this_val_p: SymbolStr = this.intern_table.intern("this");
            for (mut pi: i64 = 0; pi < orig_func.parameters.length; pi++) {
                const pp: VarDeclNode* = orig_func.parameters[pi];
                if (pp == null) { continue; }
                if (pp.name.equals(this_amp_p) || pp.name.equals(this_val_p)) { continue; }
                if (this.arena.contains_generic_param(pp.resolved_type)) {
                    method_generic_in_value_param = true;
                    break;
                }
            }
        }

        if (inherent_pin || !method_generic_in_value_param) {
            // Stamp the concrete method type args so the spec's mangled symbol
            // carries the `$MG…` disambiguator (MangledName::with_method_spec_args).
            // Two specs of one method whose signature doesn't mention the
            // method param (`name<T>() -> string`) would otherwise mangle
            // identically and collapse onto the first emitted spec.
            mut spec_args_owned: TypeRef[] = [];
            for (mut ai: i64 = 0; ai < bindings.length; ai++) {
                spec_args_owned.push(bindings[ai]);
            }
            spec_method.func.set_spec_type_args(spec_args_owned);
        }

        // Dedup: a generic-method spec is materialized once per (owner, method,
        // bindings).  The same logical call can arrive from more than one site —
        // an in-source `arr.fmt(f)` AND a clone of that call in a specialized body
        // (whose `resolved_callee`/`resolved_method` the substituter cleared,
        // forcing re-resolution).  Re-materializing would double-push the spec
        // method onto its owner and double-register it in the DI, corrupting the
        // owner spec's method set (the symptom: a sibling static method like
        // `Array::try_with_capacity_in` then fails to resolve at codegen).  If this
        // exact spec was already emitted, reuse it: pin the call the same way the
        // first materialization did and stop.
        // The pin symbol must match the symbol the spec is REGISTERED + EMITTED
        // under, or `resolve_function_by_mangled` misses it and codegen falls
        // back to the unmangled `Type::method` lookup (collapsing every spec
        // onto the first).  For an inherent (non-trait) impl the registration
        // target is `impl_node.qualified_target_name` (e.g. bare `string`),
        // which can differ from `recv_qname` for a primitive receiver; use it.
        mut pin_target: SymbolStr = recv_qname;
        if (impl_node != null && !impl_node.is_trait_impl()
                && impl_node.qualified_target_name.is_valid()) {
            pin_target = impl_node.qualified_target_name;
        }
        const spec_sym: SymbolStr = this.mangled_symbol_for_spec_method(
            spec_method, pin_target);
        if (this.state.method_spec_seen(spec_sym)) {
            call.set_resolved_method(spec_method as ASTNode*);
            // Inherent specs pin the precise symbol; trait-impl specs normally
            // rely on the already-present DI entry (their mangle can diverge from
            // the emitted symbol), exactly as the first materialization did below.
            // EXCEPTION: a trait-impl method whose type param is return-only
            // (`!method_generic_in_value_param`) MUST pin its `$MG` symbol - its
            // unmangled DI key is identical across instantiations and would
            // otherwise collapse every spec onto the first (see the stamping
            // comment above and the matching pin below).
            if ((inherent_pin || !method_generic_in_value_param) && spec_sym.is_valid()) {
                call.set_resolved_callee(spec_sym);
            }
            return;
        }
        this.state.mark_method_spec(spec_sym);

        // Route the spec'd sibling onto the right AST array.
        if (inherent_owner_ast != null) {
            mut target_ast: ASTNode* = inherent_owner_ast;
            mut from_template: boolean = false;
            if (this.generic_registry != null) {
                const recv_t: Type* = this.arena.lookup(recv_type.id);
                if (recv_t != null && recv_t.kind == TypeKind::InstantiatedType) {
                    const inst_recv: InstantiatedType* = recv_t as InstantiatedType*;
                    const tmpl_recv: TemplateEntry* =
                        this.generic_registry.get_template_by_type_id(inst_recv.generic_base.id);
                    if (tmpl_recv != null && tmpl_recv.ast_node == inherent_owner_ast) {
                        from_template = true;
                    }
                }
            }
            if (from_template) {
                // find_spec_inline_method fell back to the template AST; route to the
                // receiver's spec entry instead so the sibling doesn't leak across
                // every instantiation.
                for (mut si: i64 = 0; si < this.state.spec_entries.length; si++) {
                    const e: SpecializationEntry* = &this.state.spec_entries[si];
                    if (e.specialized_type.id == recv_type.id && e.ast_node != null) {
                        target_ast = e.ast_node;
                        break;
                    }
                }
            }
            if (target_ast.kind == NodeKind::StructDeclaration) {
                (target_ast as StructDeclNode*).methods.push(spec_method);
            } else if (target_ast.kind == NodeKind::UnionDeclaration) {
                (target_ast as UnionDeclNode*).methods.push(spec_method);
            } else if (target_ast.kind == NodeKind::ClassDeclaration) {
                (target_ast as ClassDeclNode*).methods.push(spec_method);
            }
        } else {
            impl_node.methods.push(spec_method);
        }
        call.set_resolved_method(spec_method as ASTNode*);

        // DI registration + symbol pin.  Inherent generic methods on a fixed
        // receiver get the precise mangle pinned (disambiguates Inner::relay<A> vs
        // <B>); trait-impl / combinator specs stay unpinned (their DI mangle can
        // diverge from the emitted definition symbol).
        if (inherent_owner_ast != null) {
            this.register_spec_method_in_di_inherent(spec_method, recv_type, inherent_owner_ast);
            if (spec_sym.is_valid()) {
                call.set_resolved_callee(spec_sym);
            }
        } else {
            this.register_spec_method_in_di(spec_method, recv_type, impl_node);
            // Inherent (non-trait) generic method on a primitive/fixed receiver
            // (`string::parse_int<u64>` vs `<i64>`): like the inherent-owner case
            // above, pin the precise return-distinct mangle.  Without this,
            // codegen falls back to the unmangled `Type::method` key and every
            // instantiation collapses onto whichever spec was emitted first.
            // Trait-impl / combinator specs stay unpinned (their DI mangle can
            // diverge from the emitted definition symbol) - EXCEPT a trait-impl
            // method with a return-only type param, which shares one unmangled DI
            // key across all instantiations and so must pin its distinct `$MG`
            // symbol (matching the stamped `spec_type_args` + the emitted def).
            if ((!impl_node.is_trait_impl() || !method_generic_in_value_param)
                    && spec_sym.is_valid()) {
                call.set_resolved_callee(spec_sym);
            }
        }

        // Compile-time `static match` arm pruning on the freshly-minted spec body.
        // A method-level `static match (T)` (e.g. `string::parse_int<T>`) was cloned
        // with all arms intact; the substituter rewrote each scrutinee to the
        // concrete binding (`T` -> `i64`).  Reduce every static match to its single
        // live arm now — exactly as the owner-template path does
        // (monomorphizer.cryo:480).  Without this the spec'd clone keeps >1 arm and a
        // later normal-mode walk of the concrete body reports E0645 ("static match
        // outside a generic context").  Done before the call re-walk so it only
        // descends the live arm.  Method-level params bind from the call's turbofish
        // stash, so the bindings are concrete here (the still-generic case returned
        // at the contains_generic_param guard above).
        if (spec_method.func != null && spec_method.func.body != null
                && this.ast_resolver != null) {
            const _pm: string = "";
            mut prune_ctx: ResolutionContext = ResolutionContext::new(_pm, _pm);
            if (recv_type.is_valid()) { prune_ctx.set_this_type(recv_type); }
            this.ast_resolver.prune_static_match_in_block(
                spec_method.func.body, &prune_ctx);
        }

        // Re-walk the spec'd body for its own generic calls.  specialize_method ran
        // ASTTypeSubstituter over the clone, which rewrites nested resolved_type_args
        // stashes but NOT identifier `resolved_type`s (substituter.cryo:552).  So a
        // nested call's owner-typed receiver (`this.try_add(item)`, typed `Box<A>` by
        // the template's symbolic walk) is still abstract.  Pass an owner-param subst
        // (`A` -> the receiver's concrete arg) so the re-walk concretizes the receiver
        // and the nested generic call specializes against the right spec.
        if (spec_method.func != null && spec_method.func.body != null) {
            const _empty: string = "";
            mut rw_ctx: ResolutionContext = ResolutionContext::new(_empty, _empty);
            mut owner_subst: TypeSubstitution = TypeSubstitution::empty();
            this.add_owner_param_bindings(&owner_subst, recv_type);
            // Also bind THIS method's own generic params (`m<W>`) to their concrete
            // args, so a nested call whose receiver is typed by a method generic
            // (`s: W; s.put(bytes)`) concretizes during the re-walk instead of keeping
            // an abstract method-level `T` (codegen then reports "Incorrect number of
            // arguments" against the still-generic `m<T>` symbol).  Owner-param
            // bindings alone miss these when the owner is NON-generic
            // (`Emitter.write_to<W>`): `W` is a method param, not an owner param.
            // Same 0-based method-position index the substituter + resolve_func_and_body
            // path use (see ~line 1400).
            for (mut mbi: i64 = 0; mbi < method_param_names.length && mbi < bindings.length; mbi++) {
                const mpref: TypeRef = this.arena.create_generic_param(method_param_names[mbi], mbi as u64);
                owner_subst.add(mpref.id, bindings[mbi]);
            }
            if (owner_subst.is_empty()) {
                this.walk_block(spec_method.func.body, &rw_ctx, null);
            } else {
                this.walk_block(spec_method.func.body, &rw_ctx, &owner_subst);
            }
        }
    }

    /// Lazily instantiate a zero-own-generic self-returning trait default
    /// (take/filter) for the concrete receiver.  Own-generic defaults (map<B>)
    /// return false and fall through to specialize_method_call's main path.
    /// DEINFERENCED: the receiver type is passed in (read from resolved_type by the
    /// caller); the old ensure_receiver_inst_resolved re-find is gone (the fixpoint
    /// re-walk resolves an adapter receiver on a later iteration).
    try_instantiate_self_returning_default(mut &this, call: CallExprNode*,
                                           ma: MemberAccessNode*,
                                           recv_type: TypeRef) -> boolean {
        mut impl_node: ImplBlockNode* = null;
        const orig: MethodNode* = this.find_self_returning_default(
            recv_type, ma.member, &impl_node);
        if (orig == null || orig.func == null || impl_node == null) { return false; }
        if (orig.func.generic_params.length > 0) { return false; }
        // Reuse an already-instantiated sibling rather than minting a duplicate.
        for (mut k: i64 = 0; k < impl_node.methods.length; k++) {
            const m: MethodNode* = impl_node.methods[k];
            if (m == null || m.func == null) { continue; }
            if (m == orig) { continue; }
            if (m.func.name.equals(ma.member)
                    && !m.func.is_self_returning_default
                    && !m.func.is_lazy_self_growing
                    && m.func.generic_params.length == 0) {
                call.set_resolved_method(m as ASTNode*);
                return true;
            }
        }
        mut empty_names: SymbolStr[] = [];
        mut empty_args: TypeRef[] = [];
        const spec_method: MethodNode* = this.specialize_method(
            orig, &empty_names, &empty_args, recv_type, impl_node);
        if (spec_method == null || spec_method.func == null) { return false; }
        spec_method.func.set_self_returning_default(false);
        spec_method.func.set_lazy_self_growing(false);
        impl_node.methods.push(spec_method);
        call.set_resolved_method(spec_method as ASTNode*);
        this.register_spec_method_in_di(spec_method, recv_type, impl_node);
        if (spec_method.func.body != null) {
            const _empty: string = "";
            mut rw_ctx: ResolutionContext = ResolutionContext::new(_empty, _empty);
            this.walk_block(spec_method.func.body, &rw_ctx, null);
        }
        return true;
    }


    // -- Static method on a GENERIC owner (Slice<T>::from_raw, String<GA>::from_string) --

    /// Specialize a non-generic static method on a generic owner from sema's owner
    /// stash.  Replaces the monolith's inference-driven
    /// `try_infer_static_method_on_generic_template` (4710-5007): sema now stashes the
    /// owner's concrete type args on the call (resolve_static_method_return_via_template
    /// -> stash_static_owner_bindings), so this just instantiates the owner, enqueues
    /// it (the worklist drain materializes + DI-registers its methods), and pins the
    /// combined `<spec-owner>::<method>` callee.  Returns true when handled.
    specialize_static_method_on_generic_owner(mut &this, call: CallExprNode*,
                                              scope: ScopeResolutionNode*,
                                              subst: TypeSubstitution*) -> boolean {
        if (call == null || scope == null) { return false; }
        if (call.resolved_callee.is_valid()) { return false; }
        const registry: GenericRegistry* = this.generic_registry;
        if (registry == null) { return false; }
        mut entry: TemplateEntry* = registry.get_template(scope.scope_name);
        if (entry == null && this.decl_index != null) {
            const q: SymbolStr = this.decl_index.resolve_qualified_scoped_or(
                scope.scope_name, this.current_ns, this.intern_table);
            if (q.is_valid() && !q.equals(scope.scope_name)) {
                entry = registry.get_template(q);
            }
        }
        if (entry == null) { return false; }
        if (entry.node_kind != NodeKind::StructDeclaration
                && entry.node_kind != NodeKind::UnionDeclaration
                && entry.node_kind != NodeKind::ClassDeclaration) { return false; }
        if (entry.param_count == 0 || entry.ast_node == null) { return false; }

        // Locate the matching static method(s) on the owner (instance methods
        // route through specialize_method_call instead).  A non-generic method is
        // handled by the owner-only path below (its stash is the OWNER's type args,
        // and the owner drain materializes its body).  A generic method
        // (`Wrap<A>::make<T>`) needs its OWN `<T>` specialized within the owner
        // spec — the stash is the METHOD's `<T>`; owner args come from the scope
        // turbofish or template defaults.
        const empty_methods: MethodNode*[] = [];
        mut methods: &MethodNode*[] = &empty_methods;
        if (entry.node_kind == NodeKind::StructDeclaration) { methods = &(entry.ast_node as StructDeclNode*).methods; }
        else if (entry.node_kind == NodeKind::UnionDeclaration) { methods = &(entry.ast_node as UnionDeclNode*).methods; }
        else if (entry.node_kind == NodeKind::ClassDeclaration) { methods = &(entry.ast_node as ClassDeclNode*).methods; }
        else { return false; }
        mut matched_nongeneric: MethodNode* = null;
        mut matched_generic: MethodNode* = null;
        for (mut i: i64 = 0; i < methods.length; i++) {
            const m: MethodNode* = methods[i];
            if (m == null || m.func == null || !m.is_static) { continue; }
            if (!m.func.name.equals(scope.member_name)) { continue; }
            if (m.func.generic_params.length == 0) {
                if (matched_nongeneric == null) { matched_nongeneric = m; }
            } else {
                if (matched_generic == null) { matched_generic = m; }
            }
        }

        // --- Non-generic static method on a generic owner (existing path) ---
        if (matched_nongeneric != null) {
            // The owner's type args come from sema's stash (declaration order).
            if (call.resolved_type_args.length != entry.param_type_ids.length) { return false; }
            mut binds: TypeRef[] = [];
            for (mut i: i64 = 0; i < call.resolved_type_args.length; i++) {
                mut b: TypeRef = call.resolved_type_args[i];
                if (subst != null) { b = subst.apply(b, this.arena); }
                if (!b.is_valid() || this.arena.contains_generic_param(b)) { return false; }
                binds.push(b);
            }

            // Build the spec'd owner name (bare entry.name so it matches how
            // ASTSpecializer registers the spec'd struct) + the combined callee key.
            const base_qname: QualifiedName = QualifiedName::from_symbol(entry.name);
            const spec_name_sym: SymbolStr = MangledName::specialized_identifier(
                this.intern_table, this.arena, base_qname, binds);
            if (!spec_name_sym.is_valid()) { return false; }
            const spec_name_str: string = this.intern_table.resolve(spec_name_sym);
            const qualified_owner: SymbolStr = this.qualify_spec_name(entry, spec_name_str);
            const owner_str: string = this.intern_table.resolve(qualified_owner);
            const member_str: string = this.intern_table.resolve(scope.member_name);
            const combined_sym: SymbolStr = this.intern_table.intern(
                format("%s::%s", owner_str, member_str));

            // Instantiate the owner + enqueue (the drain materializes its methods).
            const inst_ref: TypeRef = registry.instantiate_for_module(
                entry.base_type, binds, this.current_module);
            if (!inst_ref.is_valid()) { return false; }
            this.state.enqueue_from_type_ref(inst_ref);
            call.set_resolved_callee(combined_sym);
            return true;
        }

        // --- Generic static method on a generic owner (`Wrap<A>::make<T>`) ---
        if (matched_generic != null) {
            return this.specialize_generic_static_method(call, scope, entry, matched_generic, subst);
        }
        return false;
    }

    /// Specialize a call to a GENERIC static method on a GENERIC owner
    /// (`Wrap<A>::make<T>(item)`).  The owner spec is materialized (via the
    /// scope turbofish / template defaults) and the method's OWN `<T>` (sema's
    /// stash) is specialized WITHIN that owner spec — exactly how an instance
    /// generic method (`push<T>`) is handled, with the owner-default instantiation
    /// standing in for the receiver.  Returns true when the call is claimed.  On
    /// the first walk the owner spec entry does not exist yet: the owner is
    /// enqueued and the call is left UNPINNED so the walk/drain fixpoint
    /// (specialization.cryo) re-visits it once the entry materializes.
    specialize_generic_static_method(mut &this, call: CallExprNode*, scope: ScopeResolutionNode*,
                                     entry: TemplateEntry*, orig_method: MethodNode*,
                                     subst: TypeSubstitution*) -> boolean {
        const registry: GenericRegistry* = this.generic_registry;
        if (registry == null) { return false; }

        // Method binds: sema stashed the method's OWN `<T>` (declaration order).
        const n_method: i64 = orig_method.func.generic_params.length;
        if (n_method == 0) { return false; }
        if (call.resolved_type_args.length != n_method) { return false; }
        mut method_binds: TypeRef[] = [];
        for (mut i: i64 = 0; i < n_method; i++) {
            mut b: TypeRef = call.resolved_type_args[i];
            if (subst != null) { b = subst.apply(b, this.arena); }
            if (!b.is_valid() || this.arena.contains_generic_param(b)) { return false; }
            method_binds.push(b);
        }

        // Owner binds: scope turbofish, else template defaults.
        mut owner_binds: TypeRef[] = this.compute_owner_default_binds(scope, entry, subst);
        if (owner_binds.length != entry.param_type_ids.length) { return false; }

        // Materialize the owner instantiation.
        const inst_ref: TypeRef = registry.instantiate_for_module(
            entry.base_type, owner_binds, this.current_module);
        if (!inst_ref.is_valid()) { return false; }

        // Find the owner spec entry.  On the first walk it does not exist yet:
        // enqueue it and leave the call unpinned for the next fixpoint iteration.
        mut spec_entry: SpecializationEntry* = this.find_owner_spec_entry(inst_ref);
        if (spec_entry == null) {
            this.state.enqueue_from_type_ref(inst_ref);
            return true;
        }
        return this.finish_generic_static_method_spec(
            call, spec_entry, entry, orig_method, &method_binds);
    }

    /// Owner type args for a generic-owner static call in mono: explicit scope
    /// turbofish (`Wrap<u8>::make`) if present, else all-default (`Wrap` ->
    /// `Wrap<i32>`).  Mirrors sema's `compute_generic_static_owner_binds`.
    compute_owner_default_binds(mut &this, scope: ScopeResolutionNode*,
                                entry: TemplateEntry*, subst: TypeSubstitution*) -> TypeRef[] {
        const want: i64 = entry.param_type_ids.length;
        if (want == 0) { return []; }
        if (this.type_resolver == null) { return []; }
        const _m: string = "";
        mut rc: ResolutionContext = ResolutionContext::new(_m, _m);
        mut binds: TypeRef[] = [];
        for (mut i: i64 = 0; i < scope.scope_generic_args.length; i++) {
            mut tr: TypeRef = this.type_resolver.resolve(scope.scope_generic_args[i], &rc);
            if (subst != null) { tr = subst.apply(tr, this.arena); }
            if (!tr.is_valid()) { return []; }
            binds.push(tr);
        }
        if (binds.length < want) {
            binds = this.type_resolver.expand_default_type_args(entry, binds, &rc);
        }
        if (binds.length != want) { return []; }
        for (mut i: i64 = 0; i < binds.length; i++) {
            if (!binds[i].is_valid() || this.arena.contains_generic_param(binds[i])) { return []; }
        }
        return binds;
    }

    /// Re-point a local whose annotation is the BARE owner name (`mut s: String`
    /// in a generic-static-method body) at the concrete owner spec — both the
    /// annotation NAME (so the post-mono sema pass resolves it to the spec, not the
    /// bare template) and the cached `resolved_type`.  Only fires inside the
    /// generic-static-method body re-walk (`gsm_owner_*` set).  Mirrors the
    /// struct-literal `struct_type` rewrite; together they make every bare
    /// owner-name reference in the spec body resolve to the concrete owner, so a
    /// `new()+push()+return-local` constructor body is internally consistent.
    concretize_owner_local(mut &this, vd: VarDeclNode*) -> void {
        if (vd == null || vd.type_annotation == null) { return; }
        if (!this.gsm_owner_spec.is_valid()) { return; }
        match (*vd.type_annotation) {
            TypeAnnotation::Named(named) => {
                if (named != null && named.name.equals(this.gsm_owner_leaf)) {
                    named.name = this.gsm_owner_spec;
                    vd.resolved_type = this.gsm_owner_recv;
                }
            }
            _ => {}
        }
    }

    /// Find the materialized owner spec entry for an owner instantiation
    /// (display-equal on `instantiated_type`, matching the instance-method path).
    find_owner_spec_entry(&this, owner_inst: TypeRef) -> SpecializationEntry* {
        for (mut i: i64 = 0; i < this.state.spec_entries.length; i++) {
            const e: SpecializationEntry* = &this.state.spec_entries[i];
            if (!e.instantiated_type.is_valid() || !e.specialized_type.is_valid()) { continue; }
            if (e.instantiated_type.id == owner_inst.id
                    || this.arena.display_equal(e.instantiated_type.id, owner_inst.id)) {
                return e;
            }
        }
        return null;
    }

    /// Specialize `orig_method`'s own `<T>` into the already-materialized owner
    /// spec entry and pin the `$MG`-disambiguated callee.  This is the static
    /// analogue of the inherent tail of `specialize_method_call`: the owner spec's
    /// concrete type stands in for the receiver, binding the owner's `A` in the
    /// body (add_owner_param_bindings), and the method's `<T>` is substituted +
    /// its `static match` reduced to the live arm.
    finish_generic_static_method_spec(mut &this, call: CallExprNode*,
                                      spec_entry: SpecializationEntry*, owner_entry: TemplateEntry*,
                                      orig_method: MethodNode*,
                                      method_binds: &TypeRef[]) -> boolean {
        const recv_type: TypeRef = spec_entry.specialized_type;
        mut owner_ast: ASTNode* = spec_entry.ast_node;
        if (!recv_type.is_valid() || owner_ast == null) { return false; }
        if (orig_method.func == null) { return false; }

        mut method_param_names: SymbolStr[] = [];
        for (mut i: i64 = 0; i < orig_method.func.generic_params.length; i++) {
            const gp: GenericParamNode* = orig_method.func.generic_params[i];
            if (gp == null) { return false; }
            method_param_names.push(gp.name);
        }
        if (method_param_names.length != method_binds.length) { return false; }

        const spec_method: MethodNode* = this.specialize_method(
            orig_method, &method_param_names, method_binds, recv_type, null);
        if (spec_method == null || spec_method.func == null) { return false; }
        spec_method.func.set_self_returning_default(false);

        // A `-> Owner` (bare-template) return substitutes to the still-bare owner
        // template (0-field layout), while the body constructs the concrete owner
        // spec — an ABI mismatch that returns garbage (and trips E0200 in the
        // post-mono sema pass).  Remap a bare-owner return to the concrete owner
        // spec, matching how a NON-generic sibling (`Wrap::base`) resolves.  Done
        // BEFORE the `$MG`/mangle step so the emitted symbol carries the right
        // return type.  (Nested owner returns like `Result<Owner, E>` are
        // concretized by the substituter and are unaffected.)
        if (owner_entry != null
                && spec_method.func.resolved_return_type.id == owner_entry.base_type.id) {
            spec_method.func.set_resolved_return_type(recv_type);
        }

        // Stamp the concrete method type args so the spec's mangled symbol carries
        // the `$MG…` disambiguator (two specs whose signature doesn't mention the
        // method param — `make<i32>` vs `make<boolean>` returning the owner — would
        // otherwise mangle identically and collapse onto the first emitted spec).
        mut spec_args_owned: TypeRef[] = [];
        for (mut i: i64 = 0; i < method_binds.length; i++) { spec_args_owned.push(method_binds[i]); }
        spec_method.func.set_spec_type_args(spec_args_owned);

        // Reduce the freshly-minted body's `static match (T)` to the live arm
        // (T is concrete now), then re-resolve the body's type annotations against
        // the CONCRETE owner + method binds.  Without this, an owner-typed struct
        // literal in the body (`Wrap { v: item }`) keeps the bare template type the
        // symbolic template walk gave it and codegen reports E0638 ("no slot").
        // This mirrors owner materialization (resolve_specialized_ast), which is
        // why a NON-generic sibling like `Wrap::base` concretizes but this fresh
        // method spec would not.
        if (spec_method.func.body != null && this.ast_resolver != null) {
            const _pm: string = "";
            mut prune_ctx: ResolutionContext = ResolutionContext::new(_pm, _pm);
            if (recv_type.is_valid()) { prune_ctx.set_this_type(recv_type); }
            this.ast_resolver.prune_static_match_in_block(spec_method.func.body, &prune_ctx);

            mut full_subst: TypeSubstitution = TypeSubstitution::empty();
            this.add_owner_param_bindings(&full_subst, recv_type);
            for (mut i: i64 = 0; i < method_param_names.length; i++) {
                const pref: TypeRef = this.arena.create_generic_param(method_param_names[i], i as u64);
                full_subst.add(pref.id, method_binds[i]);
            }
            mut body_mod: string = "";
            if (owner_entry != null && owner_entry.module_name.is_valid()) {
                body_mod = this.intern_table.resolve(owner_entry.module_name);
            }
            mut body_ctx: ResolutionContext = ResolutionContext::new(body_mod, "");
            this.ast_resolver.resolve_func_and_body(spec_method.func, &body_ctx, &full_subst, recv_type);
        }

        // Dedup: materialize once per (owner spec, method, bindings).
        const pin_target: SymbolStr = this.arena.get_qualified_name(recv_type);
        const spec_sym: SymbolStr = this.mangled_symbol_for_spec_method(spec_method, pin_target);
        if (this.state.method_spec_seen(spec_sym)) {
            call.set_resolved_method(spec_method as ASTNode*);
            if (spec_sym.is_valid()) { call.set_resolved_callee(spec_sym); }
            return true;
        }
        this.state.mark_method_spec(spec_sym);

        // Route the spec'd method onto the owner spec entry's AST so codegen emits
        // it (the generic template AST is skipped by codegen — generic_params > 0).
        if (owner_ast.kind == NodeKind::StructDeclaration) {
            (owner_ast as StructDeclNode*).methods.push(spec_method);
        } else if (owner_ast.kind == NodeKind::UnionDeclaration) {
            (owner_ast as UnionDeclNode*).methods.push(spec_method);
        } else if (owner_ast.kind == NodeKind::ClassDeclaration) {
            (owner_ast as ClassDeclNode*).methods.push(spec_method);
        } else {
            return false;
        }
        call.set_resolved_method(spec_method as ASTNode*);
        this.register_spec_method_in_di_inherent(spec_method, recv_type, owner_ast);
        if (spec_sym.is_valid()) { call.set_resolved_callee(spec_sym); }

        // Re-walk the body for its own generic calls with the owner param bound
        // (`A` -> concrete) so nested owner-typed calls (`Wrap::base(item)`)
        // resolve against the owner spec.
        if (spec_method.func.body != null) {
            const _empty: string = "";
            mut rw_ctx: ResolutionContext = ResolutionContext::new(_empty, _empty);
            mut owner_subst: TypeSubstitution = TypeSubstitution::empty();
            this.add_owner_param_bindings(&owner_subst, recv_type);
            // Publish the owner context so walk_expr can stamp owner-constructing
            // struct literals whose type the symbolic walk left invalid.
            const saved_leaf: SymbolStr = this.gsm_owner_leaf;
            const saved_recv: TypeRef = this.gsm_owner_recv;
            const saved_spec: SymbolStr = this.gsm_owner_spec;
            this.gsm_owner_leaf = if (owner_entry != null) { owner_entry.name } else { SymbolStr::empty() };
            this.gsm_owner_recv = recv_type;
            this.gsm_owner_spec = this.arena.get_qualified_name(recv_type);
            if (owner_subst.is_empty()) {
                this.walk_block(spec_method.func.body, &rw_ctx, null);
            } else {
                this.walk_block(spec_method.func.body, &rw_ctx, &owner_subst);
            }
            this.gsm_owner_leaf = saved_leaf;
            this.gsm_owner_recv = saved_recv;
            this.gsm_owner_spec = saved_spec;
        }
        return true;
    }


    // -- Method-lookup ladder (LOOKUP, not inference; ported verbatim) --

    /// Spec'd struct/class own `methods[]` lookup for an inline generic method
    /// (e.g. `NonNull<u8>::cast<U>`).  Two-step fallback when no spec entry exists:
    /// enqueue the receiver and return the TEMPLATE's method (caller detects this by
    /// `*out_owner_ast == tmpl.ast_node` and routes the spec to the receiver's entry).
    find_spec_inline_method(mut &this, target_type: TypeRef, method_name: SymbolStr,
                            out_owner_ast: ASTNode**) -> MethodNode* {
        const empty_methods: MethodNode*[] = [];
        for (mut i: i64 = 0; i < this.state.spec_entries.length; i++) {
            const entry: SpecializationEntry* = &this.state.spec_entries[i];
            if (entry.specialized_type.id != target_type.id) { continue; }
            if (entry.ast_node == null) { continue; }
            mut owner_methods: &MethodNode*[] = &empty_methods;
            if (entry.ast_node.kind == NodeKind::StructDeclaration) {
                owner_methods = &(entry.ast_node as StructDeclNode*).methods;
            } else if (entry.ast_node.kind == NodeKind::UnionDeclaration) {
                owner_methods = &(entry.ast_node as UnionDeclNode*).methods;
            } else if (entry.ast_node.kind == NodeKind::ClassDeclaration) {
                owner_methods = &(entry.ast_node as ClassDeclNode*).methods;
            } else {
                continue;
            }
            for (mut k: i64 = 0; k < owner_methods.length; k++) {
                const m: MethodNode* = owner_methods[k];
                if (m == null || m.func == null) { continue; }
                if (!m.func.name.equals(method_name)) { continue; }
                if (m.func.generic_params.length == 0) { continue; }
                *out_owner_ast = entry.ast_node;
                return m;
            }
        }
        if (this.generic_registry == null) { return null; }
        const recv_t: Type* = this.arena.lookup(target_type.id);
        if (recv_t == null || recv_t.kind != TypeKind::InstantiatedType) { return null; }
        this.state.enqueue_from_type_ref(target_type);
        const inst: InstantiatedType* = recv_t as InstantiatedType*;
        const tmpl: TemplateEntry* =
            this.generic_registry.get_template_by_type_id(inst.generic_base.id);
        if (tmpl == null || tmpl.ast_node == null) { return null; }
        mut tmpl_methods: &MethodNode*[] = &empty_methods;
        if (tmpl.ast_node.kind == NodeKind::StructDeclaration) {
            tmpl_methods = &(tmpl.ast_node as StructDeclNode*).methods;
        } else if (tmpl.ast_node.kind == NodeKind::UnionDeclaration) {
            tmpl_methods = &(tmpl.ast_node as UnionDeclNode*).methods;
        } else if (tmpl.ast_node.kind == NodeKind::ClassDeclaration) {
            tmpl_methods = &(tmpl.ast_node as ClassDeclNode*).methods;
        } else {
            return null;
        }
        for (mut k: i64 = 0; k < tmpl_methods.length; k++) {
            const m: MethodNode* = tmpl_methods[k];
            if (m == null || m.func == null) { continue; }
            if (!m.func.name.equals(method_name)) { continue; }
            if (m.func.generic_params.length == 0) { continue; }
            *out_owner_ast = tmpl.ast_node;
            return m;
        }
        return null;
    }

    /// Add owner-param -> concrete-arg bindings to `subst` for a generic method
    /// specialized on a generic-struct receiver.  The AST substituter is built only
    /// from the METHOD params (`<T>`), so without this the cloned body's owner-typed
    /// receivers (`this: Box<A>` in `Box<A>::add<T>`) keep the abstract owner param
    /// `A` and a nested `this.<m>(...)` call can't resolve its concrete receiver.
    /// `owner_type` may be the resolved spec struct or the instantiation itself;
    /// either way recover the `(generic_base, type_args)` and bind each template
    /// param (reconstructed by name+index, matching the body's interned ref) to the
    /// receiver's concrete arg.  No-op when the owner isn't a generic instantiation.
    add_owner_param_bindings(&this, subst: TypeSubstitution*, owner_type: TypeRef) -> void {
        if (this.generic_registry == null) { return; }
        mut inst: InstantiatedType* = null;
        const ot: Type* = this.arena.lookup(owner_type.id);
        if (ot != null && ot.kind == TypeKind::InstantiatedType) {
            inst = ot as InstantiatedType*;
        } else {
            for (mut i: i64 = 0; i < this.state.spec_entries.length; i++) {
                const e: SpecializationEntry* = &this.state.spec_entries[i];
                if (!e.specialized_type.is_valid() || !e.instantiated_type.is_valid()) { continue; }
                if (e.specialized_type.id == owner_type.id
                        || this.arena.display_equal(e.specialized_type.id, owner_type.id)) {
                    const it: Type* = this.arena.lookup(e.instantiated_type.id);
                    if (it != null && it.kind == TypeKind::InstantiatedType) {
                        inst = it as InstantiatedType*;
                        break;
                    }
                }
            }
        }
        if (inst == null) { return; }
        const tmpl: TemplateEntry* =
            this.generic_registry.get_template_by_type_id(inst.generic_base.id);
        if (tmpl == null || tmpl.ast_node == null) { return; }
        const empty_params: GenericParamNode*[] = [];
        mut owner_params: &GenericParamNode*[] = &empty_params;
        if (tmpl.ast_node.kind == NodeKind::StructDeclaration) {
            owner_params = &(tmpl.ast_node as StructDeclNode*).generic_params;
        } else if (tmpl.ast_node.kind == NodeKind::UnionDeclaration) {
            owner_params = &(tmpl.ast_node as UnionDeclNode*).generic_params;
        } else if (tmpl.ast_node.kind == NodeKind::ClassDeclaration) {
            owner_params = &(tmpl.ast_node as ClassDeclNode*).generic_params;
        } else {
            return;
        }
        const n: i64 = if (owner_params.length < inst.type_args.length) {
            owner_params.length
        } else {
            inst.type_args.length
        };
        for (mut i: i64 = 0; i < n; i++) {
            const gp: GenericParamNode* = owner_params[i];
            if (gp == null) { continue; }
            if (this.arena.contains_generic_param(inst.type_args[i])) { continue; }
            const pref: TypeRef = this.arena.create_generic_param(gp.name, i as u64);
            subst.add(pref.id, inst.type_args[i]);
        }
    }

    /// Recover the concrete specialized type for an InstantiatedType that the
    /// substituter minted with fresh arg TypeIDs (so it missed
    /// `instantiated_cache`/`resolved_type`) by matching it STRUCTURALLY against a
    /// materialized spec entry's instantiated type.  TypeID identity is not logical
    /// identity across the pre-/post-mono boundary (see
    /// `TypeArena::propagate_instantiated_resolution`), so display-equality — not id
    /// equality — is the correct key.  Invalid when no materialized spec matches.
    /// If `recv_type` is a bare generic-template struct/class (every type param has a
    /// default), build its DEFAULT instantiation and return the materialized spec's
    /// concrete type — so a generic-method call on the bare template pins/emits under
    /// the same spec as in-source `String<GlobalAlloc>` receivers.  Returns
    /// `recv_type` unchanged when it isn't a defaultable template or no spec for the
    /// default instantiation has been materialized.
    canonicalize_default_template_recv(mut &this, recv_type: TypeRef) -> TypeRef {
        if (this.generic_registry == null || this.type_resolver == null) { return recv_type; }
        const tmpl: TemplateEntry* =
            this.generic_registry.get_template_by_type_id(recv_type.id);
        if (tmpl == null || tmpl.ast_node == null) { return recv_type; }
        const empty_gp: GenericParamNode*[] = [];
        mut params: &GenericParamNode*[] = &empty_gp;
        if (tmpl.ast_node.kind == NodeKind::StructDeclaration) {
            params = &(tmpl.ast_node as StructDeclNode*).generic_params;
        } else if (tmpl.ast_node.kind == NodeKind::ClassDeclaration) {
            params = &(tmpl.ast_node as ClassDeclNode*).generic_params;
        } else {
            return recv_type;
        }
        if (params.length == 0) { return recv_type; }
        mut default_args: TypeRef[] = [];
        const _pm: string = "";
        mut rc: ResolutionContext = ResolutionContext::new(_pm, _pm);
        for (mut i: i64 = 0; i < params.length; i++) {
            const gp: GenericParamNode* = params[i];
            if (gp == null || !gp.has_default_annotation()) { return recv_type; }
            const da: TypeRef = this.type_resolver.resolve(gp.default_annotation, &rc);
            if (!da.is_valid() || this.arena.contains_generic_param(da)) { return recv_type; }
            default_args.push(da);
        }
        const default_inst: TypeRef = this.arena.create_instantiation(recv_type, &default_args);
        const spec_ty: TypeRef = this.resolve_unresolved_inst_via_spec(default_inst);
        if (spec_ty.is_valid()) { return spec_ty; }
        return recv_type;
    }

    resolve_unresolved_inst_via_spec(&this, recv_type: TypeRef) -> TypeRef {
        for (mut i: i64 = 0; i < this.state.spec_entries.length; i++) {
            const e: SpecializationEntry* = &this.state.spec_entries[i];
            if (!e.instantiated_type.is_valid() || !e.specialized_type.is_valid()) { continue; }
            if (this.arena.display_equal(e.instantiated_type.id, recv_type.id)) {
                return e.specialized_type;
            }
        }
        return TypeRef::invalid();
    }

    /// Spec'd impl-block method lookup, with bound-directed dispatch (prefer the
    /// impl of `preferred_trait`; else first match).
    find_spec_impl_method(&this, target_type: TypeRef, method_name: SymbolStr,
                          preferred_trait: SymbolStr,
                          out_impl: ImplBlockNode**) -> MethodNode* {
        mut first_m: MethodNode* = null;
        mut first_impl: ImplBlockNode* = null;
        for (mut i: i64 = 0; i < this.state.spec_entries.length; i++) {
            const entry: SpecializationEntry* = &this.state.spec_entries[i];
            if (entry.specialized_type.id != target_type.id) { continue; }
            for (mut j: i64 = 0; j < entry.impl_nodes.length; j++) {
                const impl_node: ImplBlockNode* = entry.impl_nodes[j] as ImplBlockNode*;
                if (impl_node == null) { continue; }
                for (mut k: i64 = 0; k < impl_node.methods.length; k++) {
                    const m: MethodNode* = impl_node.methods[k];
                    if (m == null || m.func == null) { continue; }
                    if (!m.func.name.equals(method_name)) { continue; }
                    if (m.func.generic_params.length == 0) { continue; }
                    if (preferred_trait.is_valid() && impl_node.is_trait_impl()) {
                        const tl: SymbolStr = this.trait_leaf_of_ann(impl_node.trait_annotation);
                        if (tl.is_valid() && tl.equals(preferred_trait)) {
                            *out_impl = impl_node;
                            return m;
                        }
                    }
                    if (first_m == null) { first_m = m; first_impl = impl_node; }
                }
            }
        }
        if (first_m != null) { *out_impl = first_impl; }
        return first_m;
    }

    /// Inline generic method on a NON-generic struct/class, via the registry's
    /// inherent-owner index (qualified name first, then bare).
    find_inherent_method(&this, recv_type: TypeRef, method_name: SymbolStr,
                         out_owner_ast: ASTNode**) -> MethodNode* {
        if (!recv_type.is_valid()) { return null; }
        const registry: GenericRegistry* = this.generic_registry;
        if (registry == null) { return null; }
        mut owner_ast: ASTNode* = null;
        const qname: SymbolStr = this.arena.get_qualified_name(recv_type);
        if (qname.is_valid()) { owner_ast = registry.lookup_inherent_owner(qname); }
        if (owner_ast == null) {
            const bare: SymbolStr = this.trait_spec.bare_name_of(recv_type);
            if (bare.is_valid()) { owner_ast = registry.lookup_inherent_owner(bare); }
        }
        if (owner_ast == null) { return null; }
        const empty_methods: MethodNode*[] = [];
        mut owner_methods: &MethodNode*[] = &empty_methods;
        if (owner_ast.kind == NodeKind::StructDeclaration) {
            owner_methods = &(owner_ast as StructDeclNode*).methods;
        } else if (owner_ast.kind == NodeKind::UnionDeclaration) {
            owner_methods = &(owner_ast as UnionDeclNode*).methods;
        } else if (owner_ast.kind == NodeKind::ClassDeclaration) {
            owner_methods = &(owner_ast as ClassDeclNode*).methods;
        } else {
            return null;
        }
        for (mut k: i64 = 0; k < owner_methods.length; k++) {
            const m: MethodNode* = owner_methods[k];
            if (m == null || m.func == null) { continue; }
            if (!m.func.name.equals(method_name)) { continue; }
            if (m.func.generic_params.length == 0) { continue; }
            *out_owner_ast = owner_ast;
            return m;
        }
        return null;
    }

    /// Trait-impl-registry method lookup keyed by the bare target name (primitive
    /// receivers + the synthesized-default fourth path).  Bound-directed dispatch.
    find_trait_impl_method_for_target(&this, bare_target_name: SymbolStr,
                                      method_name: SymbolStr,
                                      preferred_trait: SymbolStr,
                                      qualified_target: SymbolStr,
                                      out_impl: ImplBlockNode**) -> MethodNode* {
        if (!bare_target_name.is_valid()) { return null; }
        const registry: GenericRegistry* = this.generic_registry;
        if (registry == null) { return null; }
        // Pass 1: QUALIFIED-name match. Two modules can each define a same-leaf
        // `struct UpTo` implementing the same trait; matching only the bare leaf
        // returns whichever impl registered first and specializes a generic trait
        // method (`map<B>` / `fold<Acc>`) against the WRONG type -> codegen E0636.
        // Prefer the impl whose qualified target matches this receiver.
        if (qualified_target.is_valid()) {
            mut q_first_m: MethodNode* = null;
            mut q_first_impl: ImplBlockNode* = null;
            for (mut i: i64 = 0; i < registry.trait_impls.length; i++) {
                const impl_node: ImplBlockNode* = registry.trait_impls[i].second;
                if (impl_node == null) { continue; }
                if (!impl_node.qualified_target_name.equals(qualified_target)
                        && !impl_node.target_type.equals(qualified_target)) { continue; }
                for (mut k: i64 = 0; k < impl_node.methods.length; k++) {
                    const m: MethodNode* = impl_node.methods[k];
                    if (m == null || m.func == null) { continue; }
                    if (!m.func.name.equals(method_name)) { continue; }
                    if (m.func.generic_params.length == 0) { continue; }
                    if (preferred_trait.is_valid() && impl_node.is_trait_impl()) {
                        const tl: SymbolStr = this.trait_leaf_of_ann(impl_node.trait_annotation);
                        if (tl.is_valid() && tl.equals(preferred_trait)) {
                            *out_impl = impl_node;
                            return m;
                        }
                    }
                    if (q_first_m == null) { q_first_m = m; q_first_impl = impl_node; }
                }
            }
            if (q_first_m != null) { *out_impl = q_first_impl; return q_first_m; }
        }
        // Pass 2: bare-name fallback (original behavior — single-impl programs,
        // and impls whose qualified target is unavailable).
        mut first_m: MethodNode* = null;
        mut first_impl: ImplBlockNode* = null;
        for (mut i: i64 = 0; i < registry.trait_impls.length; i++) {
            const impl_node: ImplBlockNode* = registry.trait_impls[i].second;
            if (impl_node == null) { continue; }
            if (!impl_node.target_type.equals(bare_target_name)) { continue; }
            for (mut k: i64 = 0; k < impl_node.methods.length; k++) {
                const m: MethodNode* = impl_node.methods[k];
                if (m == null || m.func == null) { continue; }
                if (!m.func.name.equals(method_name)) { continue; }
                if (m.func.generic_params.length == 0) { continue; }
                if (preferred_trait.is_valid() && impl_node.is_trait_impl()) {
                    const tl: SymbolStr = this.trait_leaf_of_ann(impl_node.trait_annotation);
                    if (tl.is_valid() && tl.equals(preferred_trait)) {
                        *out_impl = impl_node;
                        return m;
                    }
                }
                if (first_m == null) { first_m = m; first_impl = impl_node; }
            }
        }
        if (first_m != null) { *out_impl = first_impl; }
        return first_m;
    }

    /// Find a self-returning trait default (combinator) regardless of own-generic
    /// count: receiver's spec'd impls first, then the bare-name trait-impl registry.
    find_self_returning_default(&this, recv_type: TypeRef, method_name: SymbolStr,
                                out_impl: ImplBlockNode**) -> MethodNode* {
        for (mut i: i64 = 0; i < this.state.spec_entries.length; i++) {
            const entry: SpecializationEntry* = &this.state.spec_entries[i];
            if (entry.specialized_type.id != recv_type.id) { continue; }
            for (mut j: i64 = 0; j < entry.impl_nodes.length; j++) {
                const impl_node: ImplBlockNode* = entry.impl_nodes[j] as ImplBlockNode*;
                if (impl_node == null) { continue; }
                for (mut k: i64 = 0; k < impl_node.methods.length; k++) {
                    const m: MethodNode* = impl_node.methods[k];
                    if (m == null || m.func == null) { continue; }
                    if (!m.func.name.equals(method_name)) { continue; }
                    if (!m.func.is_self_returning_default
                            && !m.func.is_lazy_self_growing) { continue; }
                    *out_impl = impl_node;
                    return m;
                }
            }
        }
        if (this.generic_registry == null) { return null; }
        const bare: SymbolStr = this.trait_spec.bare_name_of(recv_type);
        if (!bare.is_valid()) { return null; }
        // Pass 1: precise QUALIFIED-name match. Two modules can each define a
        // `struct UpTo` implementing the same trait; keying only on the bare leaf
        // would return whichever impl is registered first and specialize the
        // adapter against the WRONG type (codegen then can't find the method on
        // the actual receiver -> E0636). Prefer the impl whose qualified target
        // matches this receiver's qualified name.
        const recv_qname: SymbolStr = this.arena.get_qualified_name(recv_type);
        if (recv_qname.is_valid()) {
            for (mut i: i64 = 0; i < this.generic_registry.trait_impls.length; i++) {
                const impl_node: ImplBlockNode* = this.generic_registry.trait_impls[i].second;
                if (impl_node == null) { continue; }
                if (!impl_node.qualified_target_name.equals(recv_qname)
                        && !impl_node.target_type.equals(recv_qname)) { continue; }
                const m: MethodNode* = this.find_self_ret_method_in_impl(impl_node, method_name);
                if (m != null) { *out_impl = impl_node; return m; }
            }
        }
        // Pass 2: bare-name fallback for impls without a qualified target (or a
        // primitive receiver whose qualified name is unavailable).
        for (mut i: i64 = 0; i < this.generic_registry.trait_impls.length; i++) {
            const impl_node: ImplBlockNode* = this.generic_registry.trait_impls[i].second;
            if (impl_node == null) { continue; }
            if (!impl_node.target_type.equals(bare)) { continue; }
            const m: MethodNode* = this.find_self_ret_method_in_impl(impl_node, method_name);
            if (m != null) { *out_impl = impl_node; return m; }
        }
        return null;
    }

    /// First method named `method_name` in `impl_node` that is an
    /// un-instantiated self-returning / lazy-self-growing adapter default.
    find_self_ret_method_in_impl(&this, impl_node: ImplBlockNode*,
                                 method_name: SymbolStr) -> MethodNode* {
        for (mut k: i64 = 0; k < impl_node.methods.length; k++) {
            const m: MethodNode* = impl_node.methods[k];
            if (m == null || m.func == null) { continue; }
            if (!m.func.name.equals(method_name)) { continue; }
            if (!m.func.is_self_returning_default
                    && !m.func.is_lazy_self_growing) { continue; }
            return m;
        }
        return null;
    }


    // -- The spec CORE: clone + substitute + re-resolve (deinferenced) --

    /// Clone a generic method's func, substitute its own generic params with `args`,
    /// clear generic_params, and re-resolve the signature against the owner type.
    /// Returns the spec'd MethodNode, or null if the signature didn't fully resolve.
    specialize_method(mut &this, original: MethodNode*,
                      param_names: &SymbolStr[], args: &TypeRef[],
                      owner_type: TypeRef, owner_impl: ImplBlockNode*) -> MethodNode* {
        if (original == null || original.func == null) { return null; }
        if (param_names.length != args.length) { return null; }

        mut arg_displays: SymbolStr[] = [];
        for (mut i: i64 = 0; i < args.length; i++) {
            const arg_t: Type* = this.arena.lookup(args[i].id);
            mut display: string = "";
            if (arg_t != null) {
                const qname: SymbolStr = this.arena.get_qualified_name(args[i]);
                if (qname.is_valid()) {
                    display = this.intern_table.resolve(qname);
                } else {
                    display = this.arena.format_display(arg_t);
                }
            } else {
                display = format("unknown_%llu", args[i].id);
            }
            arg_displays.push(this.intern_table.intern(display));
        }

        mut param_ids: u64[] = [];
        for (mut i: i64 = 0; i < param_names.length; i++) {
            const gp_ref: TypeRef = this.arena.create_generic_param(param_names[i], i as u64);
            param_ids.push(gp_ref.id);
        }
        mut subst_val: TypeSubstitution = TypeSubstitution::from_params(param_ids, args);
        // Also concretize the owner's generic params (`A` in `Box<A>::add<T>`) from
        // the concrete receiver, so the cloned body's owner-typed receivers
        // (`this.try_add(item)` on `Box<A>`) resolve their spec instead of staying
        // abstract -> codegen E0636 on the nested call.
        if (owner_type.is_valid()) {
            this.add_owner_param_bindings(&subst_val, owner_type);
        }
        const subst_ptr: TypeSubstitution* =
            allocator::alloc(sizeof(TypeSubstitution), 16u64) as TypeSubstitution*;
        *subst_ptr = subst_val;

        mut cloner: ASTCloner = ASTCloner();
        (original as ASTNode*).accept(cloner);
        mut spec_method: MethodNode* = cloner.result as MethodNode*;
        if (spec_method == null || spec_method.func == null) { return null; }
        const cloned_node: ASTNode* = spec_method as ASTNode*;
        spec_method.func.generic_params = [];
        spec_method.func.set_resolved_return_type(TypeRef::invalid());
        for (mut i: i64 = 0; i < spec_method.func.parameters.length; i++) {
            const p: VarDeclNode* = spec_method.func.parameters[i];
            if (p != null) { p.set_resolved_type(TypeRef::invalid()); }
        }

        // The substituter takes ownership of its `param_names`; `param_names` is
        // borrowed here (by ref) so the caller stays its sole owner, so hand the
        // substituter an INDEPENDENT copy rather than aliasing the caller's buffer
        // (a by-value pass would shallow-copy it and both would free it -> the
        // double-free heap-corruption wall).
        mut pn_owned: SymbolStr[] = [];
        for (mut i: i64 = 0; i < param_names.length; i++) { pn_owned.push(param_names[i]); }
        const empty_sym: SymbolStr = SymbolStr::empty();
        mut substituter: ASTTypeSubstituter* = new ASTTypeSubstituter(
            subst_ptr, this.arena, this.intern_table,
            empty_sym, empty_sym, pn_owned, arg_displays);
        cloned_node.accept(substituter);

        if (this.type_resolver != null) {
            mut module_name: string = "";
            mut res_ctx: ResolutionContext = ResolutionContext::new(module_name, "");
            if (owner_type.is_valid()) { res_ctx.set_this_type(owner_type); }
            if (owner_impl != null) {
                for (mut di: i64 = 0; di < owner_impl.derived_param_names.length; di++) {
                    res_ctx.add_binding(owner_impl.derived_param_names[di],
                                        owner_impl.derived_param_types[di]);
                }
            }
            this.type_resolver.resolve_func_signature(spec_method.func, &res_ctx);
            for (mut i: i64 = 0; i < spec_method.func.parameters.length; i++) {
                const p: VarDeclNode* = spec_method.func.parameters[i];
                if (p == null) { continue; }
                if (p.resolved_type.is_valid()) { continue; }
                const this_amp: SymbolStr = this.intern_table.intern("&this");
                const this_val: SymbolStr = this.intern_table.intern("this");
                if (p.name.equals(this_amp)) {
                    if (owner_type.is_valid()) {
                        p.set_resolved_type(this.arena.get_reference_to(
                            owner_type, RefMutability::Immutable));
                    }
                } else if (p.name.equals(this_val)) {
                    if (owner_type.is_valid()) { p.set_resolved_type(owner_type); }
                }
            }
        }

        // Fallback: re-derive an unresolved slot from `original`'s resolved signature
        // (which already carries the concrete where-clause element binding).
        if (this.type_has_unresolved(spec_method.func.resolved_return_type, 0)
                && original.func.resolved_return_type.is_valid()) {
            const cand: TypeRef = subst_ptr.apply(original.func.resolved_return_type, this.arena);
            if (!this.type_has_unresolved(cand, 0)) {
                spec_method.func.set_resolved_return_type(cand);
            }
        }
        const n_clone_params: i64 = spec_method.func.parameters.length;
        const n_orig_params: i64 = original.func.parameters.length;
        if (n_clone_params == n_orig_params) {
            for (mut i: i64 = 0; i < n_clone_params; i++) {
                const p: VarDeclNode* = spec_method.func.parameters[i];
                const op: VarDeclNode* = original.func.parameters[i];
                if (p == null || op == null) { continue; }
                if (!this.type_has_unresolved(p.resolved_type, 0)) { continue; }
                if (!op.resolved_type.is_valid()) { continue; }
                const cand: TypeRef = subst_ptr.apply(op.resolved_type, this.arena);
                if (!this.type_has_unresolved(cand, 0)) { p.set_resolved_type(cand); }
            }
        }

        // Substitution sweep: reach a method generic NESTED in an instantiated
        // annotation (the W in `f: mut &Formatter<W>`) that the AST substituter left.
        if (spec_method.func.resolved_return_type.is_valid()) {
            spec_method.func.set_resolved_return_type(
                subst_ptr.apply(spec_method.func.resolved_return_type, this.arena));
        }
        for (mut i: i64 = 0; i < spec_method.func.parameters.length; i++) {
            const sp: VarDeclNode* = spec_method.func.parameters[i];
            if (sp != null && sp.resolved_type.is_valid()) {
                sp.set_resolved_type(subst_ptr.apply(sp.resolved_type, this.arena));
            }
        }

        // Reduce concrete-base associated-type projections (`IntSeq::Item` -> i32).
        if (spec_method.func.resolved_return_type.is_valid()) {
            spec_method.func.set_resolved_return_type(
                this.trait_spec.reduce_projections(spec_method.func.resolved_return_type));
        }
        for (mut i: i64 = 0; i < spec_method.func.parameters.length; i++) {
            const sp2: VarDeclNode* = spec_method.func.parameters[i];
            if (sp2 != null && sp2.resolved_type.is_valid()) {
                sp2.set_resolved_type(this.trait_spec.reduce_projections(sp2.resolved_type));
            }
        }

        // Refuse a half-resolved spec (the mangler aborts on an invalid TypeRef).
        if (this.type_has_unresolved(spec_method.func.resolved_return_type, 0)) {
            return null;
        }
        for (mut i: i64 = 0; i < spec_method.func.parameters.length; i++) {
            const p: VarDeclNode* = spec_method.func.parameters[i];
            if (p != null && this.type_has_unresolved(p.resolved_type, 0)) {
                return null;
            }
        }

        // Discover nested instantiations from the spec'd signature so a method
        // that returns or takes another generic type (e.g. `NonNull<T>::cast<U>`
        // -> `NonNull<U>`) triggers monomorphization of the referenced generic.
        // The type-spec path does this in `resolve_func_and_body`; the method-call
        // path is the equivalent producer for generic instance/static methods, so
        // it must request the same discovery — otherwise the return-type
        // instantiation is created (by sema/substitution) but never resolved.
        //
        // Reset `nested_visited` first: it is a shared cycle-detection set whose
        // contract (see `state.request_nested_instantiations`) requires the
        // caller to clear it before each top-level traversal. Without this, stale
        // TypeIDs left over from an earlier drain step cause this method's return/
        // param instantiations to be silently skipped (order-dependent miscompile
        // → unresolved InstantiatedType → E0636/null-operand). One reset for the
        // whole signature is intentional: it dedupes a type referenced by both the
        // return type and a parameter to a single request.
        this.state.nested_visited = [];
        if (spec_method.func.resolved_return_type.is_valid()) {
            this.state.request_nested_instantiations(spec_method.func.resolved_return_type);
        }
        for (mut i: i64 = 0; i < spec_method.func.parameters.length; i++) {
            const sp: VarDeclNode* = spec_method.func.parameters[i];
            if (sp != null && sp.resolved_type.is_valid()) {
                this.state.request_nested_instantiations(sp.resolved_type);
            }
        }
        return spec_method;
    }

    /// True when `ty` is invalid or contains an invalid TypeRef at any depth.
    type_has_unresolved(&this, ty: TypeRef, depth: i32) -> boolean {
        if (!ty.is_valid()) { return true; }
        if (depth > 16) { return false; }
        const t: Type* = this.arena.lookup(ty.id);
        if (t == null) { return true; }
        if (t.kind == TypeKind::Function) {
            const f: FunctionType* = t as FunctionType*;
            if (this.type_has_unresolved(f.return_type, depth + 1)) { return true; }
            for (mut i: i64 = 0; i < f.param_types.length; i++) {
                if (this.type_has_unresolved(f.param_types[i], depth + 1)) { return true; }
            }
            return false;
        }
        if (t.kind == TypeKind::Pointer) {
            return this.type_has_unresolved((t as PointerType*).pointee, depth + 1);
        }
        if (t.kind == TypeKind::Reference) {
            return this.type_has_unresolved((t as ReferenceType*).referent, depth + 1);
        }
        if (t.kind == TypeKind::Array) {
            return this.type_has_unresolved((t as ArrayType*).element, depth + 1);
        }
        if (t.kind == TypeKind::Optional) {
            return this.type_has_unresolved((t as OptionalType*).wrapped, depth + 1);
        }
        if (t.kind == TypeKind::Tuple) {
            const tup: TupleType* = t as TupleType*;
            for (mut i: i64 = 0; i < tup.elements.length; i++) {
                if (this.type_has_unresolved(tup.elements[i], depth + 1)) { return true; }
            }
            return false;
        }
        if (t.kind == TypeKind::InstantiatedType) {
            const inst: InstantiatedType* = t as InstantiatedType*;
            for (mut i: i64 = 0; i < inst.type_args.length; i++) {
                if (this.type_has_unresolved(inst.type_args[i], depth + 1)) { return true; }
            }
            return false;
        }
        return false;
    }


    // -- DI registration + symbol pinning (re-homed; Phase-0 keystone) --

    /// Register an impl-block-owned spec method in the DeclarationIndex under the
    /// receiver's canonical name so codegen/linker find the right func_type/mangle.
    register_spec_method_in_di(mut &this, spec_method: MethodNode*,
                               recv_type: TypeRef, impl_node: ImplBlockNode*) -> void {
        if (this.decl_index == null) { return; }
        if (spec_method == null || impl_node == null) { return; }
        mut qualified_target: SymbolStr = impl_node.qualified_target_name;
        if (!qualified_target.is_valid()) { qualified_target = impl_node.target_type; }
        mut bare_alias: SymbolStr = SymbolStr::empty();
        if (!qualified_target.equals(impl_node.target_type)) {
            bare_alias = impl_node.target_type;
        }
        mut owning_module: SymbolStr = SymbolStr::empty();
        if (impl_node.source_module != "") {
            owning_module = this.intern_table.intern(impl_node.source_module);
        } else {
            owning_module = this.current_module;
        }
        // The spec's definition is emitted into `owning_module`; flag it as a spec
        // owner so the per-module incremental cache does not reuse a stale object
        // (see MonoState::record_spec_owner_module).
        this.state.record_spec_owner_module(owning_module);
        mut spec_methods: MethodNode*[] = [];
        spec_methods.push(spec_method);
        if (bare_alias.is_valid()) {
            this.decl_index.register_methods_with_module_aliased(
                qualified_target, bare_alias, spec_methods, owning_module,
                this.intern_table, this.arena);
        } else {
            this.decl_index.register_methods_with_module(
                qualified_target, spec_methods, owning_module,
                this.intern_table, this.arena);
        }
    }

    /// Register a spec method whose owner is a non-generic struct/class (no impl
    /// block): key off the receiver's arena qualified name + the owner's source module.
    register_spec_method_in_di_inherent(mut &this, spec_method: MethodNode*,
                                        recv_type: TypeRef, owner_ast: ASTNode*) -> void {
        if (this.decl_index == null) { return; }
        if (spec_method == null || owner_ast == null) { return; }
        mut qualified_target: SymbolStr = this.arena.get_qualified_name(recv_type);
        if (!qualified_target.is_valid()) { return; }
        mut source_module_str: string = "";
        if (owner_ast.kind == NodeKind::StructDeclaration) {
            source_module_str = (owner_ast as StructDeclNode*).source_module;
        } else if (owner_ast.kind == NodeKind::UnionDeclaration) {
            source_module_str = (owner_ast as UnionDeclNode*).source_module;
        } else if (owner_ast.kind == NodeKind::ClassDeclaration) {
            source_module_str = (owner_ast as ClassDeclNode*).source_module;
        }
        mut owning_module: SymbolStr = SymbolStr::empty();
        if (source_module_str != "") {
            owning_module = this.intern_table.intern(source_module_str);
        } else {
            owning_module = this.current_module;
        }
        // Flag the emitting module as a spec owner for the incremental cache (see
        // MonoState::record_spec_owner_module).
        this.state.record_spec_owner_module(owning_module);
        mut spec_methods: MethodNode*[] = [];
        spec_methods.push(spec_method);
        this.decl_index.register_methods_with_module(
            qualified_target, spec_methods, owning_module,
            this.intern_table, this.arena);
    }

    /// Compute the exact LLVM-mangled symbol a spec'd method will be emitted under,
    /// so the call can pin `resolved_callee` straight to it (disambiguates
    /// same-receiver/different-method-generic specs that share a fallback key).
    mangled_symbol_for_spec_method(mut &this, spec_method: MethodNode*,
                                   qualified_target: SymbolStr) -> SymbolStr {
        if (spec_method == null || spec_method.func == null) { return SymbolStr::empty(); }
        if (!qualified_target.is_valid()) { return SymbolStr::empty(); }
        const func: FunctionDeclNode* = spec_method.func;
        const type_qname: QualifiedName = QualifiedName::from_symbol(qualified_target);
        const method_param_refs: TypeRef[] = DeclarationIndex::method_non_receiver_params(func, this.intern_table);
        const mangled: MangledName = MangledName::for_method_or_trait_impl(
            this.intern_table, this.arena, type_qname, func.origin_trait, func.name,
            DeclarationIndex::method_receiver_kind(func, spec_method.is_static, this.intern_table),
            method_param_refs, func.resolved_return_type, func.is_variadic);
        // Disambiguate generic-method specs whose signature doesn't depend on the
        // method param (must match the codegen definition site, which folds the
        // same `func.spec_type_args` in).
        const disambig: MangledName = mangled.with_method_spec_args(
            this.intern_table, this.arena, func.spec_type_args);
        return disambig.value;
    }


    // -- Small pure helpers (re-homed copies) --

    /// Peel a type annotation to its head Named name (for bound-directed dispatch).
    trait_leaf_of_ann(&this, ann: TypeAnnotation*) -> SymbolStr {
        if (ann == null) { return SymbolStr::empty(); }
        return match (*ann) {
            TypeAnnotation::Named(na)     => { na.name }
            TypeAnnotation::Generic(ga)   => { this.trait_leaf_of_ann(ga.base) }
            TypeAnnotation::Reference(ra) => { this.trait_leaf_of_ann(ra.inner) }
            TypeAnnotation::Pointer(pa)   => { this.trait_leaf_of_ann(pa.inner) }
            TypeAnnotation::Optional(oa)  => { this.trait_leaf_of_ann(oa.inner) }
            _                             => { SymbolStr::empty() }
        };
    }

    /// Build a qualified specialized name from the template's qualified name + the
    /// bare spec name (copy of the orchestrator's helper; pure, no shared state).
    qualify_spec_name(&this, entry: TemplateEntry*, spec_name: string) -> SymbolStr {
        const qualified_str: string = this.intern_table.resolve(entry.qualified_name);
        const bare_str: string = this.intern_table.resolve(entry.name);
        const q_len: i64 = qualified_str.length() as i64;
        const b_len: i64 = bare_str.length() as i64;
        if (q_len <= b_len) { return this.intern_table.intern(spec_name); }
        const prefix_len: i64 = q_len - b_len;
        const prefix: string = qualified_str.substr(0, prefix_len);
        return this.intern_table.intern(prefix + spec_name);
    }


    // -- Template lookup helpers (LOOKUP, not inference) --

    fn_template_arity_compatible(&this, entry: TemplateEntry*, call_arity: i64) -> boolean {
        if (call_arity < 0) { return true; }
        if (entry == null || entry.ast_node == null) { return true; }
        if (entry.node_kind != NodeKind::FunctionDeclaration) { return true; }
        const fd: FunctionDeclNode* = entry.ast_node as FunctionDeclNode*;
        if (fd.is_variadic) { return true; }
        return fd.parameters.length == call_arity;
    }

    /// Find a scoped free-function template by qualified-name suffix against the
    /// scope as written, disambiguating same-leaf modules by call arity then by
    /// the namespace prefix shared with the calling module (matches sema's
    /// `resolve_module_qualified_function`).
    find_scoped_function_template(mut &this, name: SymbolStr,
                                  scope: SymbolStr, call_arity: i64) -> TemplateEntry* {
        const registry: GenericRegistry* = this.generic_registry;
        if (registry == null || !scope.is_valid()) { return null; }
        const scope_str: string = this.intern_table.resolve(scope);
        const name_str: string  = this.intern_table.resolve(name);
        const tail: string      = format("%s::%s", scope_str, name_str);
        const sep_tail: string  = format("::%s", tail);
        const tail_len: i64     = tail.length() as i64;
        const cur_ns: string    = this.intern_table.resolve(this.current_module);
        const total: i64 = registry.template_count();

        mut first: TemplateEntry* = null;
        mut arity_match: TemplateEntry* = null;
        mut arity_count: i64 = 0;
        mut prefix_match: TemplateEntry* = null;
        mut prefix_best: i64 = -1;
        mut prefix_ties: i64 = 0;

        for (mut i: i64 = 0; i < total; i++) {
            const cand: TemplateEntry* = &registry.entries[i];
            if (cand == null) { continue; }
            if (cand.node_kind != NodeKind::FunctionDeclaration) { continue; }
            if (!cand.name.equals(name)) { continue; }
            const qn: string = this.intern_table.resolve(cand.qualified_name);
            mut is_match: boolean = qn.ends_with(sep_tail);
            if (!is_match && qn.length() as i64 == tail_len && qn.ends_with(tail)) {
                is_match = true;
            }
            if (!is_match) { continue; }

            if (first == null) { first = cand; }
            if (call_arity >= 0 && cand.ast_node != null) {
                const fd: FunctionDeclNode* = cand.ast_node as FunctionDeclNode*;
                if (fd.parameters.length == call_arity) {
                    arity_match = cand;
                    arity_count = arity_count + 1;
                }
            }
            const shared: i64 = cur_ns.common_prefix_len(qn);
            if (shared > prefix_best) {
                prefix_best = shared; prefix_match = cand; prefix_ties = 1;
            } else if (shared == prefix_best) {
                prefix_ties = prefix_ties + 1;
            }
        }

        mut chosen: TemplateEntry* = first;
        if (arity_count == 1) { chosen = arity_match; }
        else if (prefix_ties == 1 && prefix_match != null) { chosen = prefix_match; }
        return chosen;
    }

    /// Look up a free-function template for an unqualified call.  `call_arity`
    /// is the call's argument count, or -1 when the arity is unknown (a
    /// first-class function-reference value, which is never invoked here).
    find_function_template_for_call(mut &this, name: SymbolStr,
                                    call_arity: i64) -> TemplateEntry* {
        const registry: GenericRegistry* = this.generic_registry;
        if (registry == null) { return null; }
        // Try current module's qualified form first.
        const name_str: string = this.intern_table.resolve(name);
        const cur_mod_str: string = this.intern_table.resolve(this.current_module);
        if (cur_mod_str.length() > 0) {
            const q1_str: string = cur_mod_str + "::" + name_str;
            const q1: SymbolStr = this.intern_table.intern(q1_str);
            const e1: TemplateEntry* = registry.get_template(q1);
            if (e1 != null && e1.node_kind == NodeKind::FunctionDeclaration) { return e1; }
        }
        const e2: TemplateEntry* = registry.get_template(name);
        if (e2 != null && e2.node_kind == NodeKind::FunctionDeclaration) { return e2; }
        // Linear scan by bare name: the call site's current_module is the consuming
        // module, not where the function was defined.  Multiple modules can define a
        // same-leaf generic free function (e.g. `net::ws::frame::read_frame` vs
        // `net::http2::frame::read_frame`); a blind first-match ignores arity and
        // module and can bind the call to the wrong body.  Disambiguate the same
        // way the scoped path does (`find_scoped_function_template`, matching sema's
        // `resolve_module_qualified_function`): prefer a unique call-arity match,
        // then the candidate whose namespace shares the longest prefix with the
        // calling module.  A SINGLE same-leaf candidate is returned unchanged.
        const total: i64 = registry.template_count();
        mut first: TemplateEntry* = null;
        mut match_count: i64 = 0;
        mut arity_match: TemplateEntry* = null;
        mut arity_count: i64 = 0;
        mut prefix_match: TemplateEntry* = null;
        mut prefix_best: i64 = -1;
        mut prefix_ties: i64 = 0;
        for (mut i: i64 = 0; i < total; i++) {
            const cand: TemplateEntry* = &registry.entries[i];
            if (cand == null) { continue; }
            if (cand.node_kind != NodeKind::FunctionDeclaration) { continue; }
            if (!cand.name.equals(name)) { continue; }
            if (first == null) { first = cand; }
            match_count = match_count + 1;
            if (call_arity >= 0 && cand.ast_node != null) {
                const fd: FunctionDeclNode* = cand.ast_node as FunctionDeclNode*;
                if (fd.parameters.length == call_arity) {
                    arity_match = cand;
                    arity_count = arity_count + 1;
                }
            }
            const qn: string = this.intern_table.resolve(cand.qualified_name);
            const shared: i64 = cur_mod_str.common_prefix_len(qn);
            if (shared > prefix_best) {
                prefix_best = shared; prefix_match = cand; prefix_ties = 1;
            } else if (shared == prefix_best) {
                prefix_ties = prefix_ties + 1;
            }
        }
        if (match_count <= 1) { return first; }
        if (arity_count == 1) { return arity_match; }
        if (prefix_ties == 1 && prefix_match != null) { return prefix_match; }
        return first;
    }


    // -- Where-clause bound checking at the call site --

    /// Verify the function template's `where`-clause bounds hold for the stashed
    /// type args in `bindings`.  On the first failing bound, emits a rich
    /// diagnostic and returns false so the caller skips pin + enqueue.
    check_function_bounds_at_call(mut &this, call: CallExprNode*,
                                  tmpl_func: FunctionDeclNode*,
                                  entry: TemplateEntry*,
                                  bindings: &TypeRef[]) -> boolean {
        if (tmpl_func == null || entry == null) { return true; }
        if (tmpl_func.trait_bounds.length == 0) { return true; }
        for (mut bi: i64 = 0; bi < tmpl_func.trait_bounds.length; bi++) {
            const bound: TraitBound* = &tmpl_func.trait_bounds[bi];
            // Position of this bound's type parameter = index into `bindings`.
            mut idx: i64 = -1;
            for (mut pi: i64 = 0; pi < entry.param_names.length; pi++) {
                if (entry.param_names[pi].equals(bound.type_parameter)) {
                    idx = pi;
                    break;
                }
            }
            if (idx < 0 || idx >= bindings.length) { continue; }
            const concrete: TypeRef = bindings[idx];
            if (!concrete.is_valid()) { continue; }
            // Defer when the binding is still abstract (re-checked when a concrete
            // spec pins it).  Mirrors sema's check_generic_free_call guard.
            if (this.arena.contains_generic_param(concrete)) { continue; }
            for (mut ri: i64 = 0; ri < bound.trait_refs.length; ri++) {
                const tref: TraitRef* = &bound.trait_refs[ri];
                if (tref.path.length == 0) { continue; }
                const trait_name: SymbolStr = tref.path[tref.path.length - 1];
                if (!this.trait_spec.type_implements_trait(concrete, trait_name, 0)) {
                    this.emit_call_bound_failure(call, tmpl_func, tref, concrete, trait_name);
                    return false;
                }
            }
        }
        return true;
    }

    /// Emit a "the trait bound `X: Y` is not satisfied" diagnostic at the call site.
    emit_call_bound_failure(mut &this, call: CallExprNode*,
                            tmpl_func: FunctionDeclNode*,
                            tref: TraitRef*, concrete: TypeRef,
                            trait_name: SymbolStr) -> void {
        const trait_str: string = this.intern_table.resolve(trait_name);
        const fn_str: string = this.intern_table.resolve(tmpl_func.name);
        const concrete_t: Type* = this.arena.lookup(concrete.id);
        const concrete_str: string = if (concrete_t != null) {
            this.arena.format_display(concrete_t)
        } else {
            "?"
        };
        mut diag: Diagnostic = Diagnostic::error(
            ErrorCode::E0306_TRAIT_BOUND_NOT_SATISFIED,
            format("the trait bound `%s: %s` is not satisfied",
                concrete_str, trait_str));
        diag = diag.at(call.span);
        diag = diag.also_at(tref.span, format(
            "required by this bound in `%s`", fn_str));
        diag = diag.with_note(format(
            "the trait `%s` is not implemented for `%s`",
            trait_str, concrete_str));
        diag = diag.help(format(
            "implement `%s` for `%s`, or pass an argument of a type that already does",
            trait_str, concrete_str));
        this.diagnostics.emit(diag);
    }
}
