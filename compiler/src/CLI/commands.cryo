namespace CLI::Commands;

import std::fmt;
import std::env;
import Compiler::{ Instance, CompilationContext, ProjectConfig };
import Compiler::Deps::DepResolver;
import Compiler::Resolver::Demangler;
import Utils;
import Utils::{ File, Logger };
import std::collections::string;

// Test-output framing (ASCII only). 80-column rules; kept in sync with the
// unit runner's framing in stdlib/test/runner.cryo so the two suites read
// as one report.

const TEST_RULE_HEAVY: string = "================================================================================";
const TEST_RULE_THIN:  string = "--------------------------------------------------------------------------------";

// ANSI SGR escape sequences for the compile-fail suite's chip output.
// Mirrors stdlib/test/runner.cryo so the two suites paint identically.
const NEG_ANSI_GREEN: string = "\x1B[32m";
const NEG_ANSI_RED:   string = "\x1B[31m";
const NEG_ANSI_RESET: string = "\x1B[0m";

/// Tally returned by the compile-fail suite so `cmd_test`'s unified
/// OVERALL footer can quote it alongside the unit-suite outcome.
type struct NegSuiteResult {
    ran:      i32;
    failures: i32;
}

// Host-shell-aware binary launch
//
// `cryo run` / `cryo test` execute the freshly-built binary through libc
// `system(3)`, which runs `sh -c` on a POSIX-hosted compiler and `cmd /c`
// on a native Windows one.  Two things differ by host and so are gated on
// the COMPILER's OWN target (ConfigGating strips one side at build time),
// mirroring the link/hoist helpers in `Compiler::Codegen` (`passes.cryo`):
//
//   * Path form: a built binary path like `build/app.exe` carries forward
//     slashes.  `cmd` will not execute a forward-slash relative path - it
//     parses the leading `/`-bearing token as a switch and reports
//     `'build' is not recognized` - so the leading binary path must be
//     rewritten to backslashes.  `sh` runs the path as-is.
//   * Exit status: POSIX `system` returns a wait-status whose exit code
//     lives in bits 8-15 (`(s >> 8) & 0xff`); Windows msvcrt `system`
//     returns the child's exit code directly.  Decoding the Windows value
//     with the POSIX shift turns every small exit code into 0.

/// Rewrite a path's `/` to `\` so a `cmd`-executed command resolves it.
/// Windows-host only; never referenced on the POSIX side.
![target(windows)]
function exec_path(path: string) -> string {
    const len: u64 = strlen(path);
    const buf: i8* = malloc(len + 1) as i8*;
    const pb: i8* = path as i8*;
    for (mut i: u64 = 0; i < len; i++) {
        const ch: i8 = pb[i];
        if (ch == '/') { buf[i] = '\\' as i8; } else { buf[i] = ch; }
    }
    buf[len] = 0;
    return buf as string;
}

/// POSIX shells execute forward-slash paths fine; pass through unchanged.
![target(unix)]
function exec_path(path: string) -> string {
    return path;
}

/// Decode a libc `system(3)` return value into a process exit code.
/// Windows: msvcrt returns the child exit code directly.
![target(windows)]
function exit_code_of(status: i32) -> int {
    return (status & 0xff) as int;
}

/// POSIX: the exit code lives in bits 8-15 of the wait-status.
![target(unix)]
function exit_code_of(status: i32) -> int {
    return ((status >> 8) & 0xff) as int;
}

/// Per-process scratch path for capturing a negative test's compiler
/// output.  Windows has no `/tmp`, so use `%TEMP%`/`%TMP%` and fall back
/// to the current directory; the negative suite ran Linux-only before this.
![target(windows)]
function neg_tmp_path() -> string {
    mut dir: i8* = getenv("TEMP") as i8*;
    if (dir == null) { dir = getenv("TMP") as i8*; }
    if (dir == null) { return format("cryo_negtest_%d.out", getpid()); }
    return format("%s\\cryo_negtest_%d.out", dir as string, getpid());
}

/// POSIX: honor `$TMPDIR`, else `/tmp`.
![target(unix)]
function neg_tmp_path() -> string {
    const dir: i8* = getenv("TMPDIR") as i8*;
    if (dir == null) { return format("/tmp/cryo_negtest_%d.out", getpid()); }
    return format("%s/cryo_negtest_%d.out", dir as string, getpid());
}

type enum CommandKind {
    Help;
    Version;
    Init;
    Build;
    Run;
    Test;
    Check;
    Raw;
    Demangle;
    Fetch;
    Update;
    Unknown;
}

implement enum CommandKind {
    name(&this) -> string {
        return match (this) {
            CommandKind::Help    => { "help"    }
            CommandKind::Version => { "version" }
            CommandKind::Init    => { "init"    }
            CommandKind::Build   => { "build"   }
            CommandKind::Run     => { "run"     }
            CommandKind::Test    => { "test"    }
            CommandKind::Check   => { "check"   }
            CommandKind::Raw     => { "raw"     }
            CommandKind::Demangle => { "demangle" }
            CommandKind::Fetch    => { "fetch"    }
            CommandKind::Update   => { "update"   }
            _ => { "" }
        };
    }

    description(&this) -> string {
        return match (this) {
            CommandKind::Help     => { "Display help information"                      }
            CommandKind::Version  => { "Display version information"                   }
            CommandKind::Init     => { "Scaffold a new Cryo project (cryoconfig + main.cryo)" }
            CommandKind::Build    => { "Build a file or cryoconfig project"                    }
            CommandKind::Run      => { "Build the project and run the resulting binary" }
            CommandKind::Test     => { "Build and run the project's tests"             }
            CommandKind::Check    => { "Check a file for errors (no codegen)"         }
            CommandKind::Raw      => { "Compile without stdlib or prelude"            }
            CommandKind::Demangle => { "Decode a mangled symbol to its source form"   }
            CommandKind::Fetch    => { "Fetch dependencies and write cryoconfig.lock" }
            CommandKind::Update   => { "Re-resolve every dependency, ignoring the lockfile" }
            _ => { "" }
        };
    }

    usage(&this) -> string {
        return match (this) {
            CommandKind::Help     => { "cryo help [command|flag]"         }
            CommandKind::Version  => { "cryo version"                     }
            CommandKind::Init     => { "cryo init [dir]"                  }
            CommandKind::Build    => { "cryo build [file|dir] [flags]"  }
            CommandKind::Run      => { "cryo run [flags]"                 }
            CommandKind::Test     => { "cryo test [pattern] [flags]"       }
            CommandKind::Check    => { "cryo check <file> [flags]"       }
            CommandKind::Raw      => { "cryo raw <file> [flags]"         }
            CommandKind::Demangle => { "cryo demangle <mangled-symbol>"  }
            CommandKind::Fetch    => { "cryo fetch"                        }
            CommandKind::Update   => { "cryo update"                       }
            _ => { "" }
        };
    }

    /// Long-form help for `cryo help <command>`: an expanded description,
    /// the usage forms, and the flags the command honours.  Mirrors the
    /// `printf`-driven layout of `Runner::print_help`.
    print_details(&this) -> void {
        fmt::printf("%s - %s\n\n", this.name(), this.description());
        fmt::printf("Usage: %s\n\n", this.usage());
        match (this) {
            CommandKind::Help => {
                fmt::printf("With no argument, prints a command overview.  With a topic, command,\n");
                fmt::printf("or flag name, prints this detailed view.\n\n");
                fmt::printf("Topics: stdlib (lookup order), config (cryoconfig), flags (build flags).\n\n");
                fmt::printf("Examples:\n");
                fmt::printf("  cryo help              Overview of commands\n");
                fmt::printf("  cryo help config       The cryoconfig file format\n");
                fmt::printf("  cryo help build        Detailed help for the `build` command\n");
                fmt::printf("  cryo help --emit-llvm  Detailed help for the `--emit-llvm` flag\n");
            }
            CommandKind::Version => {
                fmt::printf("Prints the compiler's name and version string, then exits.\n");
                fmt::printf("Equivalent to the global `--version` / `-v` flag.\n");
            }
            CommandKind::Init => {
                fmt::printf("Interactively scaffolds a new Cryo project.  Prompts for the\n");
                fmt::printf("project name, source directory (default: src), output directory\n");
                fmt::printf("(default: build) and target type (executable/library/stdlib),\n");
                fmt::printf("then writes a `cryoconfig` and a starter `main.cryo`.\n\n");
                fmt::printf("With a [dir] argument the directory is created if needed and its\n");
                fmt::printf("name is offered as the default project name.  Pressing Enter at\n");
                fmt::printf("every prompt accepts the bracketed default.\n");
            }
            CommandKind::Build => {
                fmt::printf("  cryo build <file.cryo>   Compile a single source file directly.\n");
                fmt::printf("  cryo build [dir]         Build the project whose cryoconfig lives\n");
                fmt::printf("                           in [dir] (default: the current directory).\n\n");
                fmt::printf("Flags:\n");
                fmt::printf("  --debug            Enable debug logging and verbose output\n");
                fmt::printf("  --ast              Dump the AST after parsing\n");
                fmt::printf("  --emit-llvm        Emit LLVM IR (.ll) alongside the object output\n");
                fmt::printf("  --build-dir=PATH   Override cryoconfig's output_dir\n");
                fmt::printf("  --stdlib=PATH      Standard library root for this run\n");
                fmt::printf("  --target=TRIPLE    Cross-compile for the given LLVM target triple\n");
                fmt::printf("  --no-std           Build without the standard library / prelude\n");
                fmt::printf("  -o, --output PATH  Redirect output (single-file builds only)\n");
            }
            CommandKind::Run => {
                fmt::printf("Builds the project in the current directory (or [dir]) and then\n");
                fmt::printf("executes the resulting binary, forwarding its exit code.  Only\n");
                fmt::printf("works for executable targets - library and stdlib targets produce\n");
                fmt::printf("no binary to run.\n\n");
                fmt::printf("Flags:\n");
                fmt::printf("  --debug            Enable debug logging and verbose output\n");
                fmt::printf("  --ast              Dump the AST after parsing\n");
                fmt::printf("  --emit-llvm        Emit LLVM IR (.ll) alongside the object output\n");
                fmt::printf("  --build-dir=PATH   Override cryoconfig's output_dir\n");
                fmt::printf("  --stdlib=PATH      Standard library root for this run\n");
                fmt::printf("  --target=TRIPLE    Cross-compile for the given LLVM target triple\n");
            }
            CommandKind::Test => {
                fmt::printf("Builds the project's tests and runs them.  Behaves like `run`\n");
                fmt::printf("but suppresses the user's `main` and drives every `![test]`\n");
                fmt::printf("function from a synthesized test main.\n\n");
                fmt::printf("An optional [pattern] positional filters which tests run.\n\n");
                fmt::printf("Flags:\n");
                fmt::printf("  --debug            Enable debug logging and verbose output\n");
                fmt::printf("  --build-dir=PATH   Override cryoconfig's output_dir\n");
                fmt::printf("  --stdlib=PATH      Standard library root for this run\n");
                fmt::printf("  --target=TRIPLE    Cross-compile for the given LLVM target triple\n");
                fmt::printf("  --ignored          Run only tests marked ignored\n");
                fmt::printf("  --list             List matching tests without running them\n");
                fmt::printf("  --exact            Match [pattern] exactly instead of by substring\n");
                fmt::printf("  -q, --quiet        Reduce test-runner output\n");
                fmt::printf("  --jobs=N           Worker threads (0/auto = CPU count; 1 = sequential)\n");
                fmt::printf("  --timeout=N        Per-test wall-clock limit in seconds (0 disables)\n");
                fmt::printf("  --nocapture        Stream each test's output live instead of\n");
                fmt::printf("                     capturing it and replaying under failures\n");
                fmt::printf("  --show-output      Print captured output for passing tests too\n");
            }
            CommandKind::Check => {
                fmt::printf("Runs the frontend and semantic analysis on <file> and reports\n");
                fmt::printf("errors and warnings, but emits no code.  Faster than a full\n");
                fmt::printf("build when you only want to validate a source file.\n\n");
                fmt::printf("Flags:\n");
                fmt::printf("  --debug          Enable debug logging and verbose output\n");
                fmt::printf("  --ast            Dump the AST after parsing\n");
                fmt::printf("  --stdlib=PATH    Standard library root for this run\n");
                fmt::printf("  --target=TRIPLE  Cross-compile for the given LLVM target triple\n");
            }
            CommandKind::Raw => {
                fmt::printf("Compiles <file> without the standard library or the auto-imported\n");
                fmt::printf("prelude.  Intended for low-level tests and bootstrapping work that\n");
                fmt::printf("must not pull in stdlib symbols.\n\n");
                fmt::printf("Flags:\n");
                fmt::printf("  --debug   Enable debug logging and verbose output\n");
                fmt::printf("  --ast     Dump the AST after parsing\n");
            }
            CommandKind::Demangle => {
                fmt::printf("Decodes a mangled symbol back to its source-level form.\n");
                fmt::printf("With a <mangled-symbol> argument, decodes that symbol; with no\n");
                fmt::printf("argument, reads newline-separated symbols from stdin.\n\n");
                fmt::printf("Note: wrap mangled names in SINGLE quotes so the shell does not\n");
                fmt::printf("expand `$`-segments (`$F`, `$L`, ...) into empty strings.\n");
            }
            CommandKind::Fetch => {
                fmt::printf("Resolves every dependency declared in cryoconfig against its\n");
                fmt::printf("remote, materializes missing checkouts, and writes\n");
                fmt::printf("`cryoconfig.lock`.  Reuses existing lockfile entries when the\n");
                fmt::printf("cryoconfig spec is unchanged.\n");
            }
            CommandKind::Update => {
                fmt::printf("Like `fetch`, but ignores the existing lockfile and re-resolves\n");
                fmt::printf("every dependency from scratch - use it to bump pinned git SHAs\n");
                fmt::printf("to the latest tag or branch tip.\n");
            }
            _ => {}
        }
        fmt::printf("\nSee 'cryo help' for all commands, or 'cryo help <flag>' for flag details.\n");
    }
}

/// Enumerates the documented command-line flags so `cryo help <flag>` can
/// print detailed, per-flag help.  Mirrors the `CommandKind` design.
type enum FlagKind {
    Help;
    Version;
    Debug;
    Ast;
    EmitLlvm;
    Stdlib;
    BuildDir;
    Target;
    Output;
    Ignored;
    List;
    Exact;
    Quiet;
    Unknown;
}

implement enum FlagKind {
    /// Resolves a user-typed topic to a FlagKind.  Accepts the flag with or
    /// without leading dashes and honours the short aliases (`-h`, `-v`,
    /// `-q`, `-o`), so `cryo help --debug`, `cryo help debug` and
    /// `cryo help -h` all land on the right entry.
    static resolve(topic: string) -> FlagKind {
        const name: string = ArgumentParser::normalize_flag_name(topic);
        return match (name) {
            "help"      | "h" => { FlagKind::Help }
            "version"   | "v" => { FlagKind::Version }
            "debug"           => { FlagKind::Debug }
            "ast"             => { FlagKind::Ast }
            "emit-llvm"       => { FlagKind::EmitLlvm }
            "stdlib"          => { FlagKind::Stdlib }
            "build-dir"       => { FlagKind::BuildDir }
            "target"          => { FlagKind::Target }
            "output"    | "o" => { FlagKind::Output }
            "ignored"         => { FlagKind::Ignored }
            "list"            => { FlagKind::List }
            "exact"           => { FlagKind::Exact }
            "quiet"     | "q" => { FlagKind::Quiet }
            _                 => { FlagKind::Unknown }
        };
    }

    /// Long-form help for `cryo help <flag>`.
    print_details(&this) -> void {
        match (this) {
            FlagKind::Help => {
                fmt::printf("--help, -h - Display help information\n\n");
                fmt::printf("  cryo --help            Overview of every command and global flag.\n");
                fmt::printf("  cryo <command> --help  Brief usage for a single command.\n");
                fmt::printf("  cryo help <topic>      Detailed help for a command or flag.\n");
            }
            FlagKind::Version => {
                fmt::printf("--version, -v - Display version information\n\n");
                fmt::printf("Prints the compiler's name and version string, then exits.\n");
                fmt::printf("Equivalent to the `version` command.\n");
            }
            FlagKind::Debug => {
                fmt::printf("--debug - Enable debug logging and verbose output\n\n");
                fmt::printf("Flips the compiler debug gate before any pass runs, so the\n");
                fmt::printf("verbose trace output sprinkled across the lexer, parser, resolver\n");
                fmt::printf("and codegen passes is printed.  Off by default.\n\n");
                fmt::printf("Accepted by: build, run, test, check, raw\n");
            }
            FlagKind::Ast => {
                fmt::printf("--ast - Dump the AST after parsing\n\n");
                fmt::printf("Prints the parsed abstract syntax tree before semantic analysis.\n");
                fmt::printf("Useful for debugging parser behaviour.\n\n");
                fmt::printf("Accepted by: build, run, check, raw\n");
            }
            FlagKind::EmitLlvm => {
                fmt::printf("--emit-llvm - Emit LLVM IR (.ll) alongside the object output\n\n");
                fmt::printf("Writes a human-readable LLVM IR file next to the normal object\n");
                fmt::printf("or executable output, for inspecting codegen.\n\n");
                fmt::printf("Accepted by: build, run\n");
            }
            FlagKind::Stdlib => {
                fmt::printf("--stdlib=PATH - Standard library root for this run\n\n");
                fmt::printf("Uses PATH as the standard library root, overriding every other\n");
                fmt::printf("source.  This is the highest-priority entry in the stdlib lookup\n");
                fmt::printf("order, ahead of $CRYO_STDLIB, $CRYO_HOME/stdlib, the\n");
                fmt::printf("binary-relative path and any cryoconfig setting.\n\n");
                fmt::printf("Accepted by: build, run, test, check\n");
            }
            FlagKind::BuildDir => {
                fmt::printf("--build-dir=PATH - Override cryoconfig's output_dir\n\n");
                fmt::printf("Writes build artifacts to PATH instead of the output_dir declared\n");
                fmt::printf("in cryoconfig.\n\n");
                fmt::printf("Accepted by: build, run, test\n");
            }
            FlagKind::Target => {
                fmt::printf("--target=TRIPLE - Cross-compile for an LLVM target triple\n\n");
                fmt::printf("Cross-compiles for the given LLVM target triple (for example\n");
                fmt::printf("x86_64-pc-windows-gnu), overriding cryoconfig's `target` setting.\n");
                fmt::printf("Produces object files only - link them manually.\n\n");
                fmt::printf("Accepted by: build, run, test, check\n");
            }
            FlagKind::Output => {
                fmt::printf("-o, --output PATH - Redirect single-file build output\n\n");
                fmt::printf("Writes the output of a single-file build to PATH.  The file\n");
                fmt::printf("extension selects the emission kind:\n");
                fmt::printf("  .o          object file\n");
                fmt::printf("  .asm, .s    assembly\n");
                fmt::printf("  .ll         LLVM IR text\n");
                fmt::printf("  other/none  linked executable\n\n");
                fmt::printf("Paths starting with '-' must use the `-o=PATH` form.\n");
                fmt::printf("Single-file builds only - not used for project builds.\n");
            }
            FlagKind::Ignored => {
                fmt::printf("--ignored - Run only ignored tests\n\n");
                fmt::printf("Test-runner flag: runs only the tests marked ignored.\n\n");
                fmt::printf("Accepted by: test\n");
            }
            FlagKind::List => {
                fmt::printf("--list - List tests without running them\n\n");
                fmt::printf("Test-runner flag: prints the matching tests instead of running\n");
                fmt::printf("them.\n\n");
                fmt::printf("Accepted by: test\n");
            }
            FlagKind::Exact => {
                fmt::printf("--exact - Match the test pattern exactly\n\n");
                fmt::printf("Test-runner flag: treats the [pattern] positional as an exact\n");
                fmt::printf("match instead of a substring match.\n\n");
                fmt::printf("Accepted by: test\n");
            }
            FlagKind::Quiet => {
                fmt::printf("-q, --quiet - Reduce test-runner output\n\n");
                fmt::printf("Test-runner flag: prints a more compact test report.\n\n");
                fmt::printf("Accepted by: test\n");
            }
            _ => {}
        }
    }
}

type struct Executor {
    /// Registers all built-in commands with the Runner.
    static register_commands(runner: Runner*) -> void {
        const help: CommandKind = CommandKind::Help;
        runner.add_command(Command::new(help.name(), help.description(), help.usage()));

        const version: CommandKind = CommandKind::Version;
        runner.add_command(Command::new(version.name(), version.description(), version.usage()));

        const init: CommandKind = CommandKind::Init;
        runner.add_command(Command::new(init.name(), init.description(), init.usage()));

        const build: CommandKind = CommandKind::Build;
        runner.add_command(Command::new(build.name(), build.description(), build.usage()));

        const run: CommandKind = CommandKind::Run;
        runner.add_command(Command::new(run.name(), run.description(), run.usage()));

        const test_cmd: CommandKind = CommandKind::Test;
        runner.add_command(Command::new(test_cmd.name(), test_cmd.description(), test_cmd.usage()));

        const check: CommandKind = CommandKind::Check;
        runner.add_command(Command::new(check.name(), check.description(), check.usage()));

        const raw: CommandKind = CommandKind::Raw;
        runner.add_command(Command::new(raw.name(), raw.description(), raw.usage()));

        const demangle: CommandKind = CommandKind::Demangle;
        runner.add_command(Command::new(demangle.name(), demangle.description(), demangle.usage()));

        const fetch: CommandKind = CommandKind::Fetch;
        runner.add_command(Command::new(fetch.name(), fetch.description(), fetch.usage()));

        const update: CommandKind = CommandKind::Update;
        runner.add_command(Command::new(update.name(), update.description(), update.usage()));
    }

    /// Apply the build-profile and incremental flags shared by
    /// `build` / `run` / `test` onto `config`:
    ///   --release           select the `release` profile (O2, no debug info)
    ///   --dev               select the `debug` profile (O0 + DWARF)
    ///   --profile=NAME      select an arbitrary named profile
    ///   --no-incremental    force a full build (no up-to-date short-circuit,
    ///                       no manifest/fingerprint write)
    ///   --release-static    static-link libLLVM + the C++ runtime into a
    ///                       distributable binary (Linux host only); implies
    ///                       the release profile when none is given
    /// `--release` wins over `--dev` wins over `--profile=` when several are
    /// passed. Leaving all unset keeps the cryoconfig `[profile] default`.
    static apply_profile_flags(config: CompilerConfig*, args: &ParsedArgs) -> void {
        if (args.has_flag("release")) {
            config.profile_override = "release";
        } else if (args.has_flag("dev")) {
            config.profile_override = "debug";
        } else if (args.has_arg("profile")) {
            config.profile_override = args.get_value("profile");
        }
        if (args.has_flag("no-incremental")) {
            config.incremental = false;
        }
        // Distribution-only: link a self-contained binary (no libLLVM-20.so
        // runtime dep).  Consumed at link time in run_linking; a static
        // release is inherently an optimized build, so default to the release
        // profile unless the user explicitly picked one above.
        if (args.has_flag("release-static")) {
            config.release_static = true;
            if (config.profile_override == "") {
                config.profile_override = "release";
            }
        }
    }

    /// Resolves a command name string to a CommandKind.
    static resolve(name: string) -> CommandKind {
        return match (name) {
            "help"     => { CommandKind::Help }
            "version"  => { CommandKind::Version }
            "init"     => { CommandKind::Init }
            "build"    => { CommandKind::Build }
            "run"      => { CommandKind::Run }
            "test"     => { CommandKind::Test }
            "check"    => { CommandKind::Check }
            "raw"      => { CommandKind::Raw }
            "demangle" => { CommandKind::Demangle }
            "fetch"    => { CommandKind::Fetch }
            "update"   => { CommandKind::Update }
            _          => { CommandKind::Unknown }
        };
    }

    /// Entry point from Runner: resolves the name and dispatches.
    static dispatch(cmd_name: string, runner: Runner*, args: ParsedArgs) -> int {
        const kind: CommandKind = Executor::resolve(cmd_name);
        return Executor::execute(kind, runner, args);
    }

    /// Executes a command by its kind.
    static execute(kind: CommandKind, runner: Runner*, args: ParsedArgs) -> int {
        match (kind) {
            CommandKind::Help    => { runner.print_help();    return 0; }
            CommandKind::Version => { runner.print_version(); return 0; }
            CommandKind::Init    => { return Executor::cmd_init(args); }
            CommandKind::Build   => { return Executor::cmd_build(args); }
            CommandKind::Run     => { return Executor::cmd_run(args); }
            CommandKind::Test    => { return Executor::cmd_test(args); }
            CommandKind::Check   => { return Executor::cmd_check(args); }
            CommandKind::Raw     => { return Executor::cmd_raw(args); }
            CommandKind::Demangle => { return Executor::cmd_demangle(args); }
            CommandKind::Fetch    => { return Executor::cmd_fetch(args); }
            CommandKind::Update   => { return Executor::cmd_update(args); }
            CommandKind::Unknown => {
                fmt::eprintf("Error: Unknown command. Run 'cryo help' for usage.\n");
                return 1;
            }
        }
        return 1;
    }

    /// `cryo help <topic>`: detailed help for a named topic, a command, or
    /// a flag.  Resolution order: named topics (stdlib / config / flags)
    /// first, then commands, then flags (with or without leading dashes).
    /// Returns 0 when the topic resolved, 1 for an unrecognized topic.
    static help_topic(topic: string) -> int {
        if (strcmp(topic, "stdlib") == 0) { Executor::print_topic_stdlib(); return 0; }
        if (strcmp(topic, "config") == 0) { Executor::print_topic_config(); return 0; }
        if (strcmp(topic, "flags")  == 0) { Executor::print_topic_flags();  return 0; }
        const cmd: CommandKind = Executor::resolve(topic);
        if (cmd != CommandKind::Unknown) {
            cmd.print_details();
            return 0;
        }
        const flag: FlagKind = FlagKind::resolve(topic);
        if (flag != FlagKind::Unknown) {
            flag.print_details();
            return 0;
        }
        fmt::eprintf("Error: no help topic for '%s'.\n", topic);
        fmt::eprintf("Run 'cryo help' for commands; 'cryo help <topic>' for: stdlib, config, flags.\n");
        return 1;
    }

    /// `cryo help stdlib`: how the standard-library root is resolved.
    /// Mirrors the priority chain in `resolve_stdlib_root` (instance.cryo).
    static print_topic_stdlib() -> void {
        fmt::printf("Standard-library lookup\n\n");
        fmt::printf("The compiler resolves the stdlib root from the first source that\n");
        fmt::printf("matches, in this order:\n\n");
        fmt::printf("  1. --stdlib=PATH                     one-off override (this run only)\n");
        fmt::printf("  2. $CRYO_STDLIB                       explicit stdlib pointer (env)\n");
        fmt::printf("  3. $CRYO_HOME/stdlib                  install-root pointer (env;\n");
        fmt::printf("                                        set by install.sh on install)\n");
        fmt::printf("  4. <bindir>/../stdlib                 binary-relative auto-detection\n");
        fmt::printf("  5. [project] stdlib_root             project-pinned in cryoconfig\n");
        fmt::printf("                                        (relative to the project root\n");
        fmt::printf("                                        when not absolute)\n");
        fmt::printf("  6. <project_root>/../stdlib           in-tree fallback\n\n");
        fmt::printf("Most installs need none of these: the binary-relative default (4)\n");
        fmt::printf("finds the stdlib shipped alongside `cryo`.  Pin a project to a\n");
        fmt::printf("specific stdlib with `[project] stdlib_root` in its cryoconfig.\n");
    }

    /// `cryo help config`: the cryoconfig schema, one source of truth.
    static print_topic_config() -> void {
        fmt::printf("Project configuration (cryoconfig)\n\n");
        fmt::printf("A `cryoconfig` file at the project root drives `cryo build/run/test`.\n");
        fmt::printf("It is an INI-like file with these sections:\n\n");
        fmt::printf("[project]\n");
        fmt::printf("  project_name  = \"my-app\"            display name\n");
        fmt::printf("  target_type   = \"executable\"        executable | library | stdlib\n");
        fmt::printf("  entry_point   = \"src/main.cryo\"     main file (executables)\n");
        fmt::printf("  source_dir    = \"src\"               source root (libraries/stdlib)\n");
        fmt::printf("  output_dir    = \"build\"             where build artifacts go\n");
        fmt::printf("  source_paths  = [\"../shared/src\"]   extra source roots to scan\n");
        fmt::printf("  target_triple = \"\"                  cross-compile triple (host if empty)\n");
        fmt::printf("  stdlib_root   = \"\"                  project-pinned stdlib (see `help stdlib`)\n\n");
        fmt::printf("[compiler]\n");
        fmt::printf("  debug     = false                   verbose compiler logging\n");
        fmt::printf("  optimize  = \"O2\"                    O0 | O1 | O2 | O3\n");
        fmt::printf("  emit_llvm = false                   also write LLVM IR (.ll)\n");
        fmt::printf("  no_std    = false                   build without the standard library\n\n");
        fmt::printf("[profile]\n");
        fmt::printf("  default = \"release\"                 release (O2) | debug (O0 + DWARF)\n");
        fmt::printf("                                      override per-build with --release/--dev\n\n");
        fmt::printf("[link]                                 native libraries to link\n");
        fmt::printf("  system = [\"ssl\", \"crypto\"]          system libs   -> -l<name>\n");
        fmt::printf("  search = [\"/opt/lib\"]               extra -L dirs for `system` libs\n");
        fmt::printf("  static = [\"helpers/libfoo.a\"]       local archives linked by path\n\n");
        fmt::printf("[lib] / [[bin]]                         multi-target outputs\n");
        fmt::printf("[dependencies]                          path/git deps (see `help fetch`)\n");
        fmt::printf("[test]                                  format = \"...\", color = \"...\"\n\n");
        fmt::printf("Build layout: the final executable / library is hoisted to the build\n");
        fmt::printf("root (`build/<name>`); intermediates live under `build/target/<profile>/`,\n");
        fmt::printf("grouped per package (`std/`, `local/`, `<depname>/`), and each profile's\n");
        fmt::printf("`build/target/<profile>/build-manifest.json` records its metadata.\n\n");
        fmt::printf("Run `cryo init` to scaffold a starter cryoconfig.\n");
    }

    /// `cryo help flags`: the full set of global build flags.  The concise
    /// top-level `cryo --help` lists only --help / --version and points here.
    static print_topic_flags() -> void {
        fmt::printf("Build flags (accepted by build / run / test / check as noted)\n\n");
        fmt::printf("  --debug             Enable debug logging and verbose output\n");
        fmt::printf("  --ast               Dump the AST after parsing\n");
        fmt::printf("  --emit-llvm         Emit LLVM IR (.ll) alongside the object output\n");
        fmt::printf("  --build-dir=PATH    Override cryoconfig's output_dir\n");
        fmt::printf("  --stdlib=PATH       Standard-library root for this run (highest priority;\n");
        fmt::printf("                      see `cryo help stdlib`)\n");
        fmt::printf("  --target=TRIPLE     Cross-compile for an LLVM target triple\n");
        fmt::printf("                      (e.g. x86_64-pc-windows-gnu); object files only\n");
        fmt::printf("  --opt-level=N       Optimization level 0..3 (overrides profile/cryoconfig)\n");
        fmt::printf("  -g, --debug-info    Emit DWARF debug info\n");
        fmt::printf("  --release           Build with the `release` profile (O2, no debug info)\n");
        fmt::printf("  --release-static    Static-link libLLVM + C++ runtime into a self-contained\n");
        fmt::printf("                      binary for distribution (Linux host only; implies --release)\n");
        fmt::printf("  --dev               Build with the `debug` profile (O0 + DWARF)\n");
        fmt::printf("  --profile=NAME      Build with a named profile (cache: build/target/NAME/)\n");
        fmt::printf("  --no-incremental    Force a full build (skip the up-to-date short-circuit\n");
        fmt::printf("                      and the manifest/fingerprint write)\n");
        fmt::printf("  -o, --output PATH   Redirect output (single-file builds; kind inferred\n");
        fmt::printf("                      from the extension: .o .s .ll or an executable)\n\n");
        fmt::printf("Test-only flags: --ignored, --list, --exact, -q/--quiet.\n");
        fmt::printf("Run `cryo help <flag>` for detail on any one flag.\n");
    }

    // Command Implementations

    /// `cryo init [dir]`: scaffold a new Cryo project.
    ///
    /// Interactively prompts for project_name (required) and three values
    /// with defaults (source_dir = "src", output_dir = "build",
    /// target_type = "executable"), then writes:
    ///   <dir>/cryoconfig
    ///   <dir>/<source_dir>/main.cryo  (Hello-world boilerplate)
    ///
    /// With no positional arg, scaffolds in CWD.  When `cryo init <dir>` is
    /// passed, the directory is created and offered as the default for the
    /// project-name prompt; pressing Enter at any prompt accepts the
    /// default in brackets, so `cryo init hello && (echo; echo; echo)` is
    /// effectively non-interactive.
    static cmd_init(args: ParsedArgs) -> int {
        const has_positional: boolean = args.positional_count() > 0;
        const target_dir: string = if (has_positional) {
            args.input_file()
        } else {
            "."
        };

        // Create the target dir if it doesn't already exist.  493 = 0755.
        // mkdir(2) returns -1 with errno=EEXIST when the dir is already
        // there; we don't have errno-aware bindings yet, so just attempt
        // and let the file writes below fail loudly if the dir is bogus.
        if (strcmp(target_dir, ".") != 0) {
            mkdir(target_dir, 493);
        }

        // Open stdin once so multiple fgets calls share the same FILE*
        // (re-fdopen'ing fd 0 each time mixes buffered/unbuffered reads).
        const in_stream: void* = fdopen(0, "r");
        if (in_stream == null) {
            fmt::eprintf("Error: cannot read from stdin\n");
            return 1;
        }

        fmt::printf("Initializing Cryo project in %s\n\n", target_dir);

        // When the user passed `cryo init <dir>`, offer the directory name
        // as the default project name; `cryo init hello` + Enter at every
        // prompt is the documented shortcut path.
        const name: string = if (has_positional) {
            Executor::prompt_default(in_stream, "Project name", target_dir)
        } else {
            Executor::prompt_required(in_stream, "Project name")
        };
        if (strlen(name) == 0) {
            fmt::eprintf("Error: project name is required\n");
            return 1;
        }
        const src_dir: string  = Executor::prompt_default(in_stream, "Source directory", "src");
        const out_dir: string  = Executor::prompt_default(in_stream, "Output directory", "build");
        const ttype:   string  = Executor::prompt_default(in_stream, "Target type (executable/library/stdlib)", "executable");

        // Validate target_type; silently accepting "exe" or typos would
        // produce a cryoconfig the parser can't load.
        if (strcmp(ttype, "executable") != 0
                && strcmp(ttype, "library") != 0
                && strcmp(ttype, "stdlib") != 0) {
            fmt::eprintf("Error: target type must be one of: executable, library, stdlib (got '%s')\n", ttype);
            return 1;
        }

        // Create the source directory.  When src_dir is "." we skip the
        // mkdir (target_dir already exists).
        mut src_path: string = "";
        if (strcmp(src_dir, ".") == 0 || strlen(src_dir) == 0) {
            src_path = target_dir;
        } else {
            src_path = format("%s/%s", target_dir, src_dir);
            mkdir(src_path, 493);
        }

        const main_path: string = format("%s/main.cryo", src_path);
        const ns_name: string = Executor::derive_namespace(name);
        if (!Executor::write_main_cryo(main_path, ns_name)) { return 1; }

        const config_path: string = format("%s/cryoconfig", target_dir);
        if (!Executor::write_cryoconfig(config_path, name, src_dir, out_dir, ttype)) { return 1; }

        fmt::printf("\n  Created %s\n", config_path);
        fmt::printf("  Created %s\n", main_path);
        fmt::printf("\nNext steps:\n");
        if (strcmp(target_dir, ".") != 0) {
            fmt::printf("  cd %s\n", target_dir);
        }
        fmt::printf("  cryo run\n");
        return 0;
    }

    /// Read a line from `in_stream`, returning `def` when the user
    /// presses Enter (empty input) or stdin closes.
    static prompt_default(in_stream: void*, label: string, def: string) -> string {
        fmt::printf("%s [%s]: ", label, def);
        fflush(null);
        return Executor::read_line_or(in_stream, def);
    }

    /// Like `prompt_default` but with no default: returns the empty
    /// string on EOF / blank input so the caller can reject it.
    static prompt_required(in_stream: void*, label: string) -> string {
        fmt::printf("%s: ", label);
        fflush(null);
        return Executor::read_line_or(in_stream, "");
    }

    static read_line_or(in_stream: void*, def: string) -> string {
        mut buf: i8[1024];
        if (fgets(&buf[0], 1024, in_stream) == null) {
            return def;
        }
        // Strip trailing CR/LF.
        mut len: i64 = strlen(&buf[0] as string) as i64;
        while (len > 0
                && (buf[len - 1] as i32 == 10 || buf[len - 1] as i32 == 13)) {
            len -= 1;
        }
        buf[len] = 0;
        if (len == 0) { return def; }
        // Heap-copy so the buf-on-stack doesn't dangle after return.
        return strdup(&buf[0] as string) as string;
    }

    static write_main_cryo(path: string, ns_name: string) -> boolean {
        const f: void* = fopen(path, "w");
        if (f == null) {
            fmt::eprintf("Error: cannot open %s for writing\n", path);
            return false;
        }
        const header: string = format("namespace %s;\n\nimport std::fmt;\n\n", ns_name);
        fputs(header, f);
        fputs("function main() -> int {\n", f);
        fputs("    fmt::printf(\"Hello, world!\\n\");\n", f);
        fputs("    return 0;\n", f);
        fputs("}\n", f);
        fclose(f);
        return true;
    }

    /// Derive a PascalCase namespace identifier from a project name.
    ///
    /// Examples:  `hello` -> `Hello`, `my-app` -> `My_app`,
    /// `123foo` -> `Foo` (leading non-letters dropped),
    /// `--` -> `Main` (no usable chars -> fallback).
    ///
    /// The first emitted byte is always an ASCII letter; subsequent bytes
    /// keep letters/digits/underscores and rewrite `-` / space to `_`.
    /// Anything else is dropped.  The output compiles as-is even when the
    /// input contains characters the Cryo parser would reject in an
    /// identifier.
    static derive_namespace(name: string) -> string {
        const n: u64 = strlen(name);
        if (n == 0) { return "Main"; }

        const buf: i8* = malloc(n + 1);
        mut j: u64 = 0;
        for (mut i: u64 = 0; i < n; i++) {
            const ch: i8 = name[i];
            const is_upper: boolean = ch >= 65 && ch <= 90;
            const is_lower: boolean = ch >= 97 && ch <= 122;
            const is_digit: boolean = ch >= 48 && ch <= 57;

            if (j == 0) {
                // First byte: only letters allowed; lowercase gets upcased.
                if (is_upper) {
                    const p: i8* = ptr_add(buf as void*, j as i64) as i8*;
                    *p = ch;
                    j += 1;
                } else if (is_lower) {
                    const p: i8* = ptr_add(buf as void*, j as i64) as i8*;
                    *p = (ch - 32) as i8;
                    j += 1;
                }
                // Digits / symbols / hyphens at the start are skipped.
            } else {
                const p: i8* = ptr_add(buf as void*, j as i64) as i8*;
                if (is_upper || is_lower || is_digit || ch == 95) {
                    *p = ch;
                    j += 1;
                } else if (ch == 45 || ch == 32) {
                    // '-' or ' ' becomes '_'.
                    *p = 95 as i8;
                    j += 1;
                }
                // Other bytes dropped.
            }
        }

        if (j == 0) {
            free(buf as void*);
            return "Main";
        }
        const term: i8* = ptr_add(buf as void*, j as i64) as i8*;
        *term = 0 as i8;
        return buf as string;
    }

    static write_cryoconfig(path: string, name: string, src_dir: string,
                            out_dir: string, target_type: string) -> boolean {
        const f: void* = fopen(path, "w");
        if (f == null) {
            fmt::eprintf("Error: cannot open %s for writing\n", path);
            return false;
        }
        // Build the entry_point as "<src_dir>/main.cryo" (or just
        // "main.cryo" when source_dir is "." / empty).  Only emit the
        // entry_point key for executables; libraries discover via
        // <source_dir>/lib.cryo instead.
        fputs("[project]\n", f);
        fprintf(f, "project_name = \"%s\"\n", name);
        fprintf(f, "output_dir = \"%s\"\n", out_dir);
        fprintf(f, "target_type = \"%s\"\n", target_type);
        fprintf(f, "source_dir = \"%s\"\n", src_dir);
        if (strcmp(target_type, "executable") == 0) {
            if (strcmp(src_dir, ".") == 0 || strlen(src_dir) == 0) {
                fputs("entry_point = \"main.cryo\"\n", f);
            } else {
                fprintf(f, "entry_point = \"%s/main.cryo\"\n", src_dir);
            }
        }
        fputs("\n[compiler]\n", f);
        fputs("\n[dependencies]\n", f);
        fclose(f);
        return true;
    }

    /// `cryo build [file|dir]`: single-file or project compilation.
    ///
    /// - `cryo build <file.cryo>`: compile a single source file.
    /// - `cryo build [dir]`:       find the cryoconfig in `dir` (default: `.`)
    ///                              and run a full project build.
    /// - `cryo build`:             same as above with dir = `.`.
    static cmd_build(args: ParsedArgs) -> int {
        if (args.has_flag("debug")) {
            Logger::enable_debug();
        }

        cdebug("[Build] Starting build process.\n");

        const file: string = args.input_file();

        // If the positional arg looks like a .cryo source file, compile it
        // directly as a single-file build.
        if (strlen(file) > 0) {
            const flen: i64 = strlen(file) as i64;
            // Check for a .cryo extension: last five chars are ".cryo".
            if (flen > 5) {
                const ext_start: i64 = flen - 5;
                const ext: string = ptr_add(file as void*, ext_start) as string;
                if (strcmp(ext, ".cryo") == 0) {
                    return Executor::compile_file(file, args);
                }
            }
            // Positional arg is not a .cryo file; treat it as a directory.
        }

        // Project build: find cryoconfig in the given dir (or ".").
        const dir: string = if (strlen(file) > 0) { file } else { "." };
        const config_path: string = find_cryoconfig(dir);
        if (strlen(config_path) == 0) {
            if (strlen(file) > 0) {
                fmt::eprintf("Error: '%s' is not a .cryo file and no cryoconfig was found in that directory.\n", file);
            } else {
                fmt::eprintf("Error: No input file specified and no cryoconfig found in '.'.\n");
            }
            fmt::eprintf("Usage: cryo build <file.cryo> [flags]\n");
            fmt::eprintf("   or: cryo build [dir]         (dir must contain a cryoconfig)\n");
            return 1;
        }

        cdebug("[Build] Found cryoconfig: %s\n", config_path);

        mut config: CompilerConfig = CompilerConfig::default();
        if (args.has_flag("debug")) {
            config = CompilerConfig::debug_config();
        }
        if (args.has_flag("ast")) {
            config.show_ast = true;
        }
        if (args.has_flag("emit-llvm")) {
            config.emit_llvm = true;
        }
        if (args.has_arg("build-dir")) {
            config.output_dir_override = args.get_value("build-dir");
        }
        if (args.has_arg("stdlib")) {
            config.stdlib_path_override = args.get_value("stdlib");
        }
        if (args.has_arg("target")) {
            config.target_triple_override = args.get_value("target");
        }
        // `--opt-level=N` (0..3) overrides cryoconfig `[compiler] optimize`.
        // 0 produces an unoptimized, debuggable binary; 2 is the default.
        if (args.has_arg("opt-level")) {
            const ov: string = args.get_value("opt-level");
            if (strcmp(ov, "0") == 0)      { config.opt_level_override = 0; }
            else if (strcmp(ov, "1") == 0) { config.opt_level_override = 1; }
            else if (strcmp(ov, "2") == 0) { config.opt_level_override = 2; }
            else if (strcmp(ov, "3") == 0) { config.opt_level_override = 3; }
            else {
                fmt::eprintf("Error: --opt-level must be 0, 1, 2, or 3 (got '%s').\n", ov);
                return 1;
            }
        }
        // `-g` / `--debug-info`: emit DWARF source-line debug info.
        if (args.has_flag("g") || args.has_flag("debug-info")) {
            config.emit_debug_info = true;
        }
        // `--no-std`: force a freestanding build (OR'd with the
        // cryoconfig `no_std` key; see compile_project).
        if (args.has_flag("no-std")) {
            config.no_std = true;
        }
        Executor::apply_profile_flags(&config, &args);

        mut compiler: CompilerInstance = CompilerInstance::new(config);
        cdebug("[Build] Compiling project from config: %s\n", config_path);
        const result: CompilationResult = compiler.compile_project(config_path);

        if (result.success) {
            if (strlen(result.output_path) > 0) {
                fmt::printf("Compiled -> %s\n", result.output_path);
            } else {
                fmt::printf("Project compilation succeeded.\n");
            }
            return 0;
        }

        fmt::printf("Project compilation failed (%u errors, %u warnings)\n",
            result.error_count, result.warning_count);
        return 1;
    }

    /// `cryo run`: build the project in CWD, then execute the produced
    /// binary.  Returns the binary's exit code.  Library / stdlib targets
    /// have no entry point and produce no executable, so `run` rejects
    /// them with a clear error rather than silently doing nothing.
    static cmd_run(args: ParsedArgs) -> int {
        if (args.has_flag("debug")) {
            Logger::enable_debug();
        }

        cdebug("[Run] Building project before execution.\n");

        // Find cryoconfig in CWD (or explicit positional dir).
        const dir: string = if (args.positional_count() > 0) {
            args.input_file()
        } else {
            "."
        };
        const config_path: string = find_cryoconfig(dir);
        if (strcmp(config_path, "") == 0) {
            fmt::eprintf("Error: No cryoconfig found in '%s' or parent directories.\n", dir);
            fmt::eprintf("Usage: cryo run [flags]   (run from a directory containing a cryoconfig)\n");
            return 1;
        }

        mut config: CompilerConfig = CompilerConfig::default();
        if (args.has_flag("debug")) {
            config = CompilerConfig::debug_config();
        }
        if (args.has_flag("ast")) {
            config.show_ast = true;
        }
        if (args.has_flag("emit-llvm")) {
            config.emit_llvm = true;
        }
        if (args.has_arg("build-dir")) {
            config.output_dir_override = args.get_value("build-dir");
        }
        if (args.has_arg("stdlib")) {
            config.stdlib_path_override = args.get_value("stdlib");
        }
        if (args.has_arg("target")) {
            config.target_triple_override = args.get_value("target");
        }
        Executor::apply_profile_flags(&config, &args);

        mut compiler: CompilerInstance = CompilerInstance::new(config);
        const result: CompilationResult = compiler.compile_project(config_path);

        if (!result.success) {
            fmt::printf("Project compilation failed (%u errors, %u warnings)\n",
                result.error_count, result.warning_count);
            return 1;
        }

        // compile_project leaves output_path empty for non-executable
        // targets (libraries, stdlib batches).  Nothing to run there.
        if (strlen(result.output_path) == 0) {
            fmt::eprintf("Error: target produced no executable; `cryo run` only works for executable projects.\n");
            return 1;
        }

        cdebug("[Run] %s\n", result.output_path);
        // Flush so the [Run] header appears before the child binary's
        // output (under --debug); otherwise the libc line buffer can
        // interleave them.
        fflush(null);
        // system(3) returns the wait status: low byte holds the signal,
        // bits 8-15 hold the exit code on a normal exit.  Surface the
        // exit code so the caller's $? matches what the inner binary
        // returned.
        const status: i32 = system(exec_path(result.output_path));
        if (status < 0) {
            fmt::eprintf("Error: failed to spawn '%s'\n", result.output_path);
            return 1;
        }
        return exit_code_of(status);
    }

    /// `cryo test [pattern] [flags]`: build the project's tests and
    /// run them.  Behaves like `cryo run` but forces `CompileMode::Test`
    /// so the user's `main` is suppressed and a synthesized test main
    /// drives every `![test]` function.  Accepts the same surface flags
    /// as `cryo run` (`--debug`, `--build-dir=...`, `--stdlib=...`)
    /// plus the test-runner flags forwarded to the produced binary:
    /// optional positional pattern, `--ignored`, `--list`, `--exact`,
    /// `-q` / `--quiet`.
    static cmd_test(args: ParsedArgs) -> int {
        if (args.has_flag("debug")) {
            Logger::enable_debug();
        }

        cdebug("[Test] Building test binary.\n");

        const config_path: string = find_cryoconfig(".");
        if (strcmp(config_path, "") == 0) {
            fmt::eprintf("Error: No cryoconfig found in '.' or parent directories.\n");
            fmt::eprintf("Usage: cryo test [pattern] [flags]   (run from a Cryo project)\n");
            return 1;
        }

        mut config: CompilerConfig = CompilerConfig::default();
        if (args.has_flag("debug")) {
            config = CompilerConfig::debug_config();
        }
        if (args.has_arg("build-dir")) {
            config.output_dir_override = args.get_value("build-dir");
        }
        if (args.has_arg("stdlib")) {
            config.stdlib_path_override = args.get_value("stdlib");
        }
        if (args.has_arg("target")) {
            config.target_triple_override = args.get_value("target");
        }
        Executor::apply_profile_flags(&config, &args);
        config.test_mode = true;

        mut compiler: CompilerInstance = CompilerInstance::new(config);
        const result: CompilationResult = compiler.compile_project(config_path);

        if (!result.success) {
            fmt::printf("Test build failed (%u errors, %u warnings)\n",
                result.error_count, result.warning_count);
            return 1;
        }
        if (strlen(result.output_path) == 0) {
            fmt::eprintf("Error: target produced no test executable; `cryo test` requires an executable project.\n");
            return 1;
        }

        // Build the command for the produced test binary, forwarding the
        // pattern (first positional) and the runner-side flags.  The leading
        // binary path is host-normalized (`/`->`\` on Windows) so `cmd` can
        // execute it; the appended flags carry no path separators.
        mut cmd: string = exec_path(result.output_path);
        if (args.positional_count() > 0) {
            cmd = format("%s %s", cmd, args.input_file());
        }
        if (args.has_flag("ignored")) { cmd = format("%s --ignored", cmd); }
        if (args.has_flag("list"))    { cmd = format("%s --list",    cmd); }
        if (args.has_flag("exact"))   { cmd = format("%s --exact",   cmd); }
        if (args.has_flag("quiet"))   { cmd = format("%s --quiet",   cmd); }
        if (args.has_flag("q"))       { cmd = format("%s -q",        cmd); }
        // Worker count and per-test timeout (value-bearing); capture controls
        // (boolean). Forwarded so `cryo test --jobs=1 --nocapture` reaches the
        // runner; each also has a `CRYO_TEST_*` env fallback.
        if (args.has_arg("jobs"))        { cmd = format("%s --jobs=%s", cmd, args.get_value("jobs")); }
        if (args.has_arg("timeout"))     { cmd = format("%s --timeout=%s", cmd, args.get_value("timeout")); }
        if (args.has_flag("nocapture"))  { cmd = format("%s --nocapture",  cmd); }
        if (args.has_flag("show-output")) { cmd = format("%s --show-output", cmd); }

        // Resolve --format and --color once. CLI wins over cryoconfig; the
        // resolved values are forwarded to the unit-test binary AND drive the
        // compile-fail suite's framing below so the two halves look identical.
        mut fmt_choice: string = "";
        mut col_choice: string = "";
        if (args.has_arg("format")) {
            fmt_choice = args.get_value("format");
        }
        if (args.has_arg("color")) {
            col_choice = args.get_value("color");
        }
        if (strlen(fmt_choice) == 0 || strlen(col_choice) == 0) {
            const proj_cfg: ProjectConfig = ProjectConfig::parse(config_path);
            if (strlen(fmt_choice) == 0 && strlen(proj_cfg.test_format) > 0) {
                fmt_choice = proj_cfg.test_format;
            }
            if (strlen(col_choice) == 0 && strlen(proj_cfg.test_color) > 0) {
                col_choice = proj_cfg.test_color;
            }
        }
        if (strlen(fmt_choice) > 0) {
            cmd = format("%s --format=%s", cmd, fmt_choice);
        }
        if (strlen(col_choice) > 0) {
            cmd = format("%s --color=%s", cmd, col_choice);
        }

        // Resolve this compiler's own path (via /proc/self/exe) and the
        // absolute stdlib root this build used. Both are needed to drive the
        // compile-fail cases under tests/negative/ - `cmd_test` runs this
        // very compiler on each of those files.
        mut self_exe: string = "";
        match (env::current_exe()) {
            Option::Some(s) => { self_exe = s.into_raw(); }
            Option::None    => {}
        }
        mut stdlib_abs: string = "";
        if (strlen(result.stdlib_root) > 0) {
            mut std_abs: i8* = malloc(4096) as i8*;
            const resolved: i8* = intrinsics::realpath(result.stdlib_root, std_abs);
            if (resolved != null) {
                stdlib_abs = format("%s", std_abs as string);
            } else {
                stdlib_abs = result.stdlib_root;
            }
            free(std_abs as void*);
        }

        cdebug("[Test] %s\n", cmd);
        // Flush parent stdio before spawning so the [Test] header lands
        // before the child's output under --debug.  Same precaution as
        // `cmd_run`.
        fflush(null);
        const status: i32 = system(cmd);
        if (status < 0) {
            fmt::eprintf("Error: failed to spawn '%s'\n", result.output_path);
            return 1;
        }
        mut exit_code: int = exit_code_of(status);
        const unit_ok: boolean = exit_code == 0;

        // Compile-fail suite: run each tests/negative/*.cryo file through
        // `cryo check` and assert it fails with its declared error code.
        // Skipped under --list (which only enumerates the runtime tests).
        mut neg_ran: i32 = 0;
        mut neg_failures: i32 = 0;
        if (!args.has_flag("list")) {
            const proj_root: string = Executor::dir_of(config_path);
            const neg_dir: string = format("%s/tests/negative", proj_root);
            mut pattern: string = "";
            if (args.positional_count() > 0) { pattern = args.input_file(); }
            const neg_res: NegSuiteResult =
                Executor::run_negative_suite(self_exe, stdlib_abs, neg_dir,
                                             pattern, fmt_choice, col_choice);
            neg_ran      = neg_res.ran;
            neg_failures = neg_res.failures;
            if (neg_failures > 0 && exit_code == 0) {
                exit_code = 1;
            }
        }

        // Unified OVERALL footer: a single verdict line that quotes both
        // suites at once, sitting beneath the per-suite summary blocks the
        // unit runner and `run_negative_suite` already printed. Skipped
        // under --list (no real run happened).
        if (!args.has_flag("list")) {
            const overall_pass: boolean = unit_ok && (neg_failures == 0);
            const overall_active: boolean = Executor::neg_color_active(col_choice);
            fmt::printf("\n%s\n", TEST_RULE_HEAVY);
            if (overall_active && overall_pass) {
                fmt::printf("  OVERALL  %sPASS%s", NEG_ANSI_GREEN, NEG_ANSI_RESET);
            } else if (overall_active) {
                fmt::printf("  OVERALL  %sFAIL%s", NEG_ANSI_RED, NEG_ANSI_RESET);
            } else {
                fmt::printf("  OVERALL  %s", if (overall_pass) { "PASS" } else { "FAIL" });
            }
            const unit_label: string = if (unit_ok) { "ok" } else { "failed" };
            if (neg_ran > 0) {
                fmt::printf("  (unit: %s; compile-fail: %d passed",
                    unit_label, neg_ran - neg_failures);
                if (neg_failures > 0) {
                    fmt::printf(", %d failed", neg_failures);
                }
                fmt::printf(")\n");
            } else {
                fmt::printf("  (unit: %s)\n", unit_label);
            }
            fmt::printf("%s\n", TEST_RULE_HEAVY);
        }
        return exit_code;
    }

    /// Directory portion of `path` (everything before the last `/`), or
    /// "." when there is no slash. Used to locate tests/negative relative
    /// to the resolved cryoconfig.
    static dir_of(path: string) -> string {
        const n: u64 = strlen(path);
        if (n == 0) { return "."; }
        mut i: i64 = (n - 1) as i64;
        while (i >= 0) {
            const c: i8 = *(ptr_add(path as void*, i as u64) as i8*);
            if (c == 47 || c == 92) {            // '/' or '\' (Windows)
                if (i == 0) { return "/"; }
                const buf: i8* = malloc((i as u64) + 1) as i8*;
                mut k: u64 = 0;
                while (k < i as u64) {
                    buf[k] = *(ptr_add(path as void*, k) as i8*);
                    k = k + 1;
                }
                buf[i as u64] = 0;
                return buf as string;
            }
            i = i - 1;
        }
        return ".";
    }

    /// Read a file's full contents, or "" if it can't be opened.
    static read_file_or_empty(path: string) -> string {
        if (!File::exists(path)) { return ""; }
        mut f: File = File::new(path);
        match (f.load()) {
            Result::Ok(_)  => { return f.content(); }
            Result::Err(_) => { return ""; }
        }
    }

    /// Pull the expected error code out of a `![config(negative, <code>)]`
    /// directive in `content`. Returns "" if absent.
    static neg_code_from(content: string) -> string {
        const marker: i8* = strstr(content, "config(negative");
        if (marker == null) { return ""; }
        mut p: i8* = ptr_add(marker as void*,
            strlen("config(negative") as u64) as i8*;
        // Skip the separator: comma and any spaces.
        loop {
            const c: i8 = *p;
            if (c == 44 || c == 32) {            // ',' or ' '
                p = ptr_add(p as void*, 1) as i8*;
            } else {
                break;
            }
        }
        // Capture the code token up to ')' / ',' / ' ' / ']' / NUL.
        mut buf: i8[24];
        mut i: u64 = 0;
        loop {
            const c: i8 = *p;
            if (c == 41 || c == 44 || c == 32 || c == 93 || c == 0) { break; }
            if (i >= 23) { break; }
            buf[i] = c;
            i = i + 1;
            p = ptr_add(p as void*, 1) as i8*;
        }
        buf[i] = 0;
        return format("%s", &buf[0] as string);
    }

    /// Resolve `col_choice` ("auto"/"always"/"never"/"") into an
    /// on/off decision for ANSI color emission. Auto checks `NO_COLOR`
    /// (presence forces off, per https://no-color.org/) and `isatty(1)`.
    /// Mirrors `resolve_color_active` in `stdlib/test/runner.cryo`.
    static neg_color_active(col_choice: string) -> boolean {
        if (strcmp(col_choice, "always") == 0) { return true;  }
        if (strcmp(col_choice, "never")  == 0) { return false; }
        // "auto" or "" (default): NO_COLOR > isatty.
        const nc: i8* = getenv("NO_COLOR") as i8*;
        if (nc != null) { return false; }
        return intrinsics::isatty(1) == 1;
    }

    /// Emit a green `[PASS]` chip when color is active, plain otherwise.
    static neg_chip_pass(active: boolean) -> void {
        if (active) {
            fmt::printf("%s[PASS]%s", NEG_ANSI_GREEN, NEG_ANSI_RESET);
        } else {
            fmt::printf("[PASS]");
        }
    }

    /// Emit a red `[FAIL]` chip when color is active, plain otherwise.
    static neg_chip_fail(active: boolean) -> void {
        if (active) {
            fmt::printf("%s[FAIL]%s", NEG_ANSI_RED, NEG_ANSI_RESET);
        } else {
            fmt::printf("[FAIL]");
        }
    }

    /// Run every compile-fail case under `neg_dir`. Each file is compiled
    /// on its own with `cryo check`; it must fail AND emit the code named by
    /// its `![config(negative, <code>)]` directive. A case that compiles
    /// cleanly, or emits a different code, is a real failure. `pattern`,
    /// when non-empty, filters by filename substring (mirrors the runtime
    /// runner's positional filter). `fmt_choice` / `col_choice` mirror the
    /// unit runner's `--format=` / `--color=` surface so the two halves of
    /// `cryo test` paint identically.
    static run_negative_suite(self_exe: string, stdlib_abs: string,
                              neg_dir: string, pattern: string,
                              fmt_choice: string, col_choice: string)
            -> NegSuiteResult {
        // Pre-pass: count how many entries actually survive the filter.
        // Suppresses the entire compile-fail section (header + body + summary)
        // when a `cryo test <pattern>` invocation matches nothing here, so
        // unit-only runs don't leave an empty stub block behind. We close
        // and reopen the dir between passes because there's no `rewinddir`
        // intrinsic in core::intrinsics.
        const pre_dp: void* = opendir(neg_dir);
        if (pre_dp == null) {
            // No tests/negative -> nothing to do.
            return NegSuiteResult { ran: 0, failures: 0 };
        }
        mut to_run: i32 = 0;
        mut pre_entry: void* = readdir(pre_dp);
        while (pre_entry != null) {
            const pn: string = dirent_name(pre_entry);
            const pnl: u64 = strlen(pn);
            // We deliberately do NOT filter on `dirent_type` here: mingw-w64's
            // `struct dirent` has no `d_type` field, so the `dirent_type`
            // intrinsic returns garbage on Windows and would reject every
            // entry (suppressing the whole suite). The ".cryo" extension check
            // is the real filter and is sufficient — entries here are files.
            if (strcmp(pn, ".") != 0 && strcmp(pn, "..") != 0
                && pnl > 5
                && strcmp(ptr_add(pn as void*, (pnl - 5) as u64) as string, ".cryo") == 0
                && (strlen(pattern) == 0 || strstr(pn, pattern) != null)) {
                to_run += 1;
            }
            pre_entry = readdir(pre_dp);
        }
        closedir(pre_dp);
        if (to_run == 0) {
            return NegSuiteResult { ran: 0, failures: 0 };
        }
        const dp: void* = opendir(neg_dir);
        if (dp == null) {
            return NegSuiteResult { ran: 0, failures: 0 };
        }

        const is_pretty:  boolean = strcmp(fmt_choice, "pretty")  == 0;
        const is_compact: boolean = strcmp(fmt_choice, "compact") == 0;
        const color_on:   boolean = Executor::neg_color_active(col_choice);

        fmt::printf("\n%s\n", TEST_RULE_HEAVY);
        fmt::printf("  CRYO TESTS  /  compile-fail\n");
        fmt::printf("%s\n\n", TEST_RULE_HEAVY);

        // Pretty: print the group header once; each test is an indented
        // line with a `[PASS]` / `[FAIL]` chip. Compact: stream a dot per
        // test under a single padded group label; flushed at end.
        if (is_pretty) {
            fmt::printf("compile-fail\n");
        } else if (is_compact) {
            fmt::printf("compile-fail                                      ");
        }

        const tmp: string = neg_tmp_path();
        mut failures: i32 = 0;
        mut ran: i32 = 0;
        mut entry: void* = readdir(dp);
        while (entry != null) {
            const name: string = dirent_name(entry);
            if (strcmp(name, ".") == 0 || strcmp(name, "..") == 0) {
                entry = readdir(dp); continue;
            }
            // No `dirent_type` filter — see the pre-pass note above (mingw has
            // no d_type); the ".cryo" extension check below is the real filter.
            const nlen: u64 = strlen(name);
            if (nlen <= 5) { entry = readdir(dp); continue; }
            const ext: string = ptr_add(name as void*, (nlen - 5) as u64) as string;
            if (strcmp(ext, ".cryo") != 0) { entry = readdir(dp); continue; }
            if (strlen(pattern) > 0 && strstr(name, pattern) == null) {
                entry = readdir(dp); continue;
            }

            const full: string = format("%s/%s", neg_dir, name);
            const content: string = Executor::read_file_or_empty(full);
            const expected: string = Executor::neg_code_from(content);

            // Per-test prefix: Plain emits `test (negative) NAME ... ` up
            // front so a hang is visible; Pretty emits `  NAME ... ` with
            // the same intent; Compact stays silent until the result lands.
            if (is_pretty) {
                fmt::printf("  %s ... ", name);
            } else if (!is_compact) {
                fmt::printf("test (negative) %s ... ", name);
            }
            fflush(null);

            if (strlen(expected) == 0) {
                if (is_compact) {
                    fmt::printf("F");
                } else if (is_pretty) {
                    Executor::neg_chip_fail(color_on);
                    fmt::printf("  (no ![config(negative, <code>)] directive)\n");
                } else {
                    fmt::printf("FAILED (no ![config(negative, <code>)] directive)\n");
                }
                failures += 1; ran += 1; entry = readdir(dp); continue;
            }

            mut runcmd: string;
            if (strlen(stdlib_abs) > 0) {
                runcmd = format("%s check %s --stdlib=%s > %s 2>&1",
                    self_exe, full, stdlib_abs, tmp);
            } else {
                runcmd = format("%s check %s > %s 2>&1", self_exe, full, tmp);
            }
            fflush(null);
            system(runcmd);
            const out: string = Executor::read_file_or_empty(tmp);
            const want: string = format("error[%s]", expected);
            const passed: boolean = strstr(out, want) != null;
            if (passed) {
                if (is_compact) {
                    fmt::printf(".");
                } else if (is_pretty) {
                    Executor::neg_chip_pass(color_on);
                    fmt::printf("\n");
                } else {
                    fmt::printf("ok\n");
                }
            } else {
                if (is_compact) {
                    fmt::printf("F");
                } else if (is_pretty) {
                    Executor::neg_chip_fail(color_on);
                    fmt::printf("  (expected %s)\n", expected);
                } else {
                    fmt::printf("FAILED (expected %s)\n", expected);
                }
                failures += 1;
            }
            ran += 1;
            entry = readdir(dp);
        }
        closedir(dp);
        unlink(tmp);

        // Compact: close out the single in-flight line with the tally.
        if (is_compact && ran > 0) {
            fmt::printf("   %d ok", ran - failures);
            if (failures > 0) { fmt::printf(", %d fail", failures); }
            fmt::printf("\n");
        }

        if (ran > 0) {
            const verdict: string = if (failures == 0) { "PASS" } else { "FAIL" };
            fmt::printf("\n%s\n", TEST_RULE_HEAVY);
            fmt::printf("  compile-fail summary\n");
            fmt::printf("%s\n", TEST_RULE_THIN);
            fmt::printf("    %-9s%6d\n", "passed", ran - failures);
            fmt::printf("    %-9s%6d\n", "failed", failures);
            fmt::printf("%s\n", TEST_RULE_THIN);
            if (color_on && failures == 0) {
                fmt::printf("    result   %s%s%s\n", NEG_ANSI_GREEN, verdict, NEG_ANSI_RESET);
            } else if (color_on) {
                fmt::printf("    result   %s%s%s\n", NEG_ANSI_RED,   verdict, NEG_ANSI_RESET);
            } else {
                fmt::printf("    result   %s\n", verdict);
            }
            fmt::printf("%s\n", TEST_RULE_HEAVY);
        }
        return NegSuiteResult { ran: ran, failures: failures };
    }

    /// `cryo check <file>`: frontend + semantic analysis, no codegen.
    static cmd_check(args: ParsedArgs) -> int {
        if (args.has_flag("debug")) {
            Logger::enable_debug();
        }

        const file: string = args.input_file();
        if (file == "") {
            fmt::eprintf("Error: No input file specified.\nUsage: cryo check <file> [flags]\n");
            return 1;
        }

        mut config: CompilerConfig = CompilerConfig::default();
        if (args.has_flag("debug")) {
            config = CompilerConfig::debug_config();
        }
        if (args.has_flag("ast")) {
            config.show_ast = true;
        }
        if (args.has_arg("stdlib")) {
            config.stdlib_path_override = args.get_value("stdlib");
        }
        if (args.has_arg("target")) {
            config.target_triple_override = args.get_value("target");
        }

        mut compiler: CompilerInstance = CompilerInstance::new(config);
        const result: CompilationResult = compiler.compile_for_check(file);

        if (result.success) {
            if (result.warning_count > 0) {
                fmt::printf("Check passed with %u warning%s.\n",
                    result.warning_count,
                    if (result.warning_count == 1) { "" } else { "s" });
            } else {
                fmt::printf("No errors found.\n");
            }
            return 0;
        }

        fmt::printf("Check failed (%u errors, %u warnings)\n",
            result.error_count, result.warning_count);
        return 1;
    }

    /// `cryo raw <file>`: compile without stdlib or prelude.
    static cmd_raw(args: ParsedArgs) -> int {
        if (args.has_flag("debug")) {
            Logger::enable_debug();
        }

        const file: string = args.input_file();
        if (file == "") {
            fmt::eprintf("Error: No input file specified.\nUsage: cryo raw <file> [flags]\n");
            return 1;
        }

        mut config: CompilerConfig = CompilerConfig::default();
        if (args.has_flag("debug")) {
            config = CompilerConfig::debug_config();
        }
        if (args.has_flag("ast")) {
            config.show_ast = true;
        }

        mut compiler: CompilerInstance = CompilerInstance::new(config);
        const result: CompilationResult = compiler.compile_raw(file);

        if (result.success) {
            fmt::printf("Compilation succeeded.\n");
            return 0;
        }

        fmt::printf("Compilation failed (%u errors, %u warnings)\n",
            result.error_count, result.warning_count);
        return 1;
    }

    /// Removed: `cryo project` has been unified into `cryo build`.
    /// `cryo build [dir]` detects a cryoconfig and runs a project build;
    /// `cryo build <file.cryo>` runs a single-file build.
    /// This stub is intentionally absent; dispatch routing no longer
    /// references cmd_project.

    /// `cryo demangle <symbol>`: decode a mangled symbol to its
    /// source-level form (per docs/cryo-mangling-spec.md).  With no
    /// argument, reads newline-separated symbols from stdin.
    ///
    /// Shell-expansion gotcha: bash treats `$8`, `$F`, `$L`, etc. as
    /// variable expansions even inside double quotes; by the time argv
    /// reaches us, every `$<letter>` segment is gone.  Use single quotes
    /// (`'C$...$Rv'`) or pipe the symbol on stdin to avoid it.
    static cmd_demangle(args: ParsedArgs) -> int {
        // Positional form: demangle the single argument.
        if (args.positional_count() > 0) {
            const sym: string = args.input_file();
            Executor::print_demangled(sym);
            return 0;
        }

        // No arg -> read from stdin, one symbol per line.  Use fdopen(0)
        // because Cryo doesn't expose libc's `stdin` global; the returned
        // FILE* aliases fd 0 and works fine with fgets.
        const in_stream: void* = fdopen(0, "r");
        if (in_stream == null) {
            fmt::eprintf("Error: No symbol provided.\n");
            fmt::eprintf("Usage: cryo demangle <mangled-symbol>\n");
            return 1;
        }
        mut buf: i8[8192];
        mut saw_input: boolean = false;
        while (fgets(&buf[0], 8192, in_stream) != null) {
            mut end: i64 = strlen(&buf[0] as string) as i64;
            while (end > 0
                && (buf[end - 1] as i32 == 10 || buf[end - 1] as i32 == 13)) {
                end -= 1;
            }
            buf[end] = 0;
            if (end == 0) { continue; }
            saw_input = true;
            Executor::print_demangled(&buf[0] as string);
        }

        if (!saw_input) {
            fmt::eprintf("Error: No symbol provided.\n");
            fmt::eprintf("Usage: cryo demangle <mangled-symbol>\n");
            fmt::eprintf("       echo 'C$...' | cryo demangle\n");
            fmt::eprintf("Tip: wrap mangled names in SINGLE quotes ('...') so the shell does not\n");
            fmt::eprintf("     expand $-segments like $F, $L, $s, $V, $G, $R into empty strings.\n");
            return 1;
        }
        return 0;
    }

    /// Prints the demangled form of a single symbol, with a quoting hint
    /// when the input looks like a shell-expanded mangled name (starts
    /// with `C` but no `$` follows (typical when bash ate the `$` tokens).
    static print_demangled(sym: string) -> void {
        const pretty: string = Demangler::demangle(sym);
        fmt::printf("\n%s\n", pretty);
        if (Executor::looks_shell_expanded(sym)) {
            fmt::printf("(hint: input has no `$` tokens; looks like the shell expanded them.\n");
            fmt::printf(" Re-run with single quotes:  cryo demangle '%s'\n", sym);
        }
    }

    /// Heuristic: starts with `C`, has no `$` saw_inputwhere, and contains at
    /// least one digit-prefixed segment (`.<digit>` or leading digit
    /// after `C`).  That's the fingerprint of a Cryo-mangled symbol whose `$X`
    /// markers were eaten by bash variable expansion.
    static looks_shell_expanded(sym: string) -> boolean {
        const len: i64 = strlen(sym) as i64;
        if (len < 2) { return false; }
        if (sym[0] != 'C') { return false; }
        // Already correctly prefixed; definitely not shell-expanded.
        if (sym[1] == '$') { return false; }
        // Scan: reject if saw_input '$' present, accept if a digit-prefixed
        // segment is present (ASCII digit immediately after '.' or
        // immediately after the leading 'C').
        mut saw_digit_seg: boolean = (sym[1] >= '0' && sym[1] <= '9');
        for (mut i: i64 = 1; i < len; i++) {
            const c: char = sym[i];
            if (c == '$') { return false; }
            if (c == '.' && i + 1 < len) {
                const n: char = sym[i + 1];
                if (n >= '0' && n <= '9') { saw_digit_seg = true; }
            }
        }
        return saw_digit_seg;
    }

    // Direct File Compilation

    /// Result type for `infer_output_kind`.  Cryo enums can't carry
    /// payloads here, so the rejection reason rides alongside the kind.
    /// `is_rejected = true` means the extension is one we explicitly
    /// refuse (e.g. `.a` archive); the caller should print an error.
    static infer_output_kind(path: string, mut rejected: boolean*) -> OutputKind {
        *rejected = false;
        const len: i64 = strlen(path) as i64;
        if (len == 0) { return OutputKind::Exe; }
        // Find last '/' and last '.' so we only look at the basename's
        // extension.
        mut last_slash: i64 = -1;
        mut last_dot:   i64 = -1;
        for (mut i: i64 = 0; i < len; i++) {
            const c: char = path[i];
            if (c == '/') { last_slash = i; last_dot = -1; continue; }
            if (c == '.') { last_dot = i; }
        }
        if (last_dot < 0 || last_dot == last_slash + 1) {
            // No extension, or hidden file like `.foo` with no real ext
            return OutputKind::Exe;
        }
        const ext: string = ptr_add(path as void*, (last_dot + 1) as i64) as string;
        if (strcmp(ext, "o")   == 0) { return OutputKind::Object; }
        if (strcmp(ext, "asm") == 0) { return OutputKind::Asm; }
        if (strcmp(ext, "s")   == 0) { return OutputKind::Asm; }
        if (strcmp(ext, "ll")  == 0) { return OutputKind::IRText; }
        if (strcmp(ext, "a")   == 0) { *rejected = true; return OutputKind::None; }
        // Unknown extension: caller may want an executable named like
        // `foo.bin` or `tool.exe`.  Treat as Exe; the link step writes
        // the bytes regardless of suffix.
        return OutputKind::Exe;
    }

    /// Compiles a single file directly from a path.
    /// Routes through CompilerInstance for proper phase management.
    static compile_file(file_path: string, args: ParsedArgs) -> int {
        if (args.has_flag("debug")) {
            Logger::enable_debug();
        }

        cdebug("[Compile] Compiling file: %s\n", file_path);

        mut config: CompilerConfig = CompilerConfig::default();

        if (args.has_flag("debug")) {
            config = CompilerConfig::debug_config();
        }
        if (args.has_flag("ast")) {
            config.show_ast = true;
        }
        if (args.has_flag("emit-llvm")) {
            config.emit_llvm = true;
        }
        if (args.has_arg("stdlib")) {
            config.stdlib_path_override = args.get_value("stdlib");
        }
        if (args.has_arg("target")) {
            config.target_triple_override = args.get_value("target");
        }
        // `--opt-level=N` (0..3): 0 keeps the build unoptimized/debuggable.
        if (args.has_arg("opt-level")) {
            const ov: string = args.get_value("opt-level");
            if (strcmp(ov, "0") == 0)      { config.opt_level_override = 0; }
            else if (strcmp(ov, "1") == 0) { config.opt_level_override = 1; }
            else if (strcmp(ov, "2") == 0) { config.opt_level_override = 2; }
            else if (strcmp(ov, "3") == 0) { config.opt_level_override = 3; }
            else {
                fmt::eprintf("Error: --opt-level must be 0, 1, 2, or 3 (got '%s').\n", ov);
                return 1;
            }
        }
        // `-g` / `--debug-info`: emit DWARF source-line debug info.
        if (args.has_flag("g") || args.has_flag("debug-info")) {
            config.emit_debug_info = true;
        }
        // `--no-std`: freestanding build, no prelude / stdlib modules.
        if (args.has_flag("no-std")) {
            config.no_std = true;
        }

        // `-o PATH` / `--output PATH`: single-file output redirect.
        // Path extension picks the emission kind:
        //   .o            -> Object (1)
        //   .asm | .s     -> Asm    (2)
        //   .ll           -> IRText (3)
        //   anything else -> Exe    (4) (link via `cc`)
        // .a (static archive) is rejected up-front: single-file builds
        // emit one TU, so producing an archive would require either
        // wrapping a lone .o (`ar rcs`, fine) or cross-linking other
        // sources we don't have.  Defer until cmd_project grows a
        // library output path.
        mut out_path: string = "";
        if (args.has_arg("o"))      { out_path = args.get_value("o"); }
        if (args.has_arg("output")) { out_path = args.get_value("output"); }
        if (strlen(out_path) > 0) {
            mut rejected: boolean = false;
            const kind: OutputKind = Executor::infer_output_kind(out_path, &rejected);
            if (rejected) {
                fmt::eprintf("Error: unsupported output extension for '%s'\n", out_path);
                fmt::printf("  supported: .o (object), .asm/.s (assembly), .ll (LLVM IR text), no-extension (executable)\n");
                return 1;
            }
            config.output_path_override = out_path;
            config.output_kind          = kind;
        }

        mut compiler: CompilerInstance = CompilerInstance::new(config);
        const result: CompilationResult = compiler.compile_file(file_path);

        if (result.success) {
            if (strlen(result.output_path) > 0) {
                fmt::printf("Compiled -> %s\n", result.output_path);
            } else {
                fmt::printf("Compilation succeeded.\n");
            }
            return 0;
        }

        fmt::printf("Compilation failed (%u errors, %u warnings)\n",
            result.error_count, result.warning_count);
        return 1;
    }

    /// `cryo fetch`: resolve every dep against its remote, materialize
    /// missing checkouts, and write `cryoconfig.lock`.  Reuses existing
    /// lockfile entries when the cryoconfig spec is unchanged.
    static cmd_fetch(args: ParsedArgs) -> int {
        return Executor::run_dep_resolve(args, ResolveMode::Fetch);
    }

    /// `cryo update`: like `fetch`, but ignores the existing lockfile
    /// and re-resolves every git dep from scratch.  Used to bump pinned
    /// SHAs to the latest tag/branch tip.
    static cmd_update(args: ParsedArgs) -> int {
        return Executor::run_dep_resolve(args, ResolveMode::Update);
    }

    /// Shared implementation for `cryo fetch` and `cryo update`.
    static run_dep_resolve(args: ParsedArgs, mode: ResolveMode) -> int {
        if (args.has_flag("debug")) {
            Logger::enable_debug();
        }

        const config_path: string = find_cryoconfig(".");
        if (strlen(config_path) == 0) {
            fmt::eprintf("Error: no cryoconfig found in this directory.\n");
            fmt::eprintf("       run `cryo init` first to scaffold a project.\n");
            return 1;
        }

        mut config: ProjectConfig = ProjectConfig::parse(config_path);
        if (config.error_count > 0) {
            fmt::eprintf("cryoconfig has %lld schema error(s); fix them before fetching.\n",
                config.error_count);
            return 1;
        }

        if (config.dependencies.length == 0) {
            fmt::printf("No dependencies declared in %s; nothing to do.\n", config_path);
            return 0;
        }

        const lock_path: string = format("%s/cryoconfig.lock",
            config.project_root);
        const outcome: ResolveOutcome = DepResolver::resolve(
            &config, mode, lock_path);
        if (outcome.failed) {
            fmt::printf("Dependency resolution failed.\n");
            return 1;
        }

        const verb: string = match (mode) {
            ResolveMode::Update => { "Updated" }
            _                   => { "Fetched" }
        };
        fmt::printf("%s %lld dependency entr%s; lockfile written to %s\n",
            verb,
            outcome.lock.packages.length as i64,
            if (outcome.lock.packages.length == 1) { "y" } else { "ies" },
            lock_path);
        return 0;
    }
}
