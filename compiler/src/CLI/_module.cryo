namespace CLI;

public module Commands;

import Compiler;
import Compiler::Lex;
import std::fmt;
import Utils;
import std::fs::metadata;
import std::fs::path;
import CLI::Commands;
import std::core::cmp;
import std::collections::{ hashmap, pair };

type struct Argument {
    name:          string;
    description:   string;
    default_value: string;
    aliases:       string[];
    required:      boolean;
    is_flag:       boolean;
}

type struct ParsedArgs {
private:
    // Small associative lists backed by `Pair<string, Argument>[]`.
    // Argument counts are in the low single digits for any realistic
    // CLI invocation, so the linear scan is fine and the cache-locality
    // wins over a `HashMap`.  Equality on the key goes through the
    // `string` `Eq` impl (byte-level compare).
    args:        Pair<string, Argument>[];
    flags:       Pair<string, Argument>[];
    defines:     Pair<string, Argument>[];
    positionals: Argument[];

public:
    /// Fresh `ParsedArgs` with empty argument lists.  Construction lives here,
    /// inside the declaring type, because the four lists are `private` - only
    /// `ParsedArgs`' own methods may name them in a literal (E0353).  Callers
    /// like `ArgumentParser::parse` populate the result through the public
    /// `set_*` / `add_*` methods below.
    static new() -> ParsedArgs {
        return ParsedArgs {
            args:        [],
            flags:       [],
            defines:     [],
            positionals: [],
        };
    }

    set_arg(mut &this, key: string, arg: Argument) -> void {
        for (mut i: int = 0; i < this.args.length; i++) {
            if (this.args[i].first.equals(&key)) {
                this.args[i].second = arg;
                return;
            }
        }
        this.args.push(Pair<string, Argument>::new(key, arg));
    }

    get_arg(&this, key: string) -> Argument* {
        for (mut i: int = 0; i < this.args.length; i++) {
            if (this.args[i].first.equals(&key)) {
                return &this.args[i].second;
            }
        }
        return null;
    }

    has_arg(&this, key: string) -> boolean {
        for (mut i: int = 0; i < this.args.length; i++) {
            if (this.args[i].first.equals(&key)) { return true; }
        }
        return false;
    }

    /// Returns the string value of a `--key=value` arg, or empty
    /// string if the key wasn't provided.
    get_value(&this, key: string) -> string {
        for (mut i: int = 0; i < this.args.length; i++) {
            if (this.args[i].first.equals(&key)) {
                return this.args[i].second.default_value;
            }
        }
        return "";
    }

    /// Upsert a `-DKEY=value` define.  Mirrors `set_arg`/`set_flag` so callers
    /// don't need to reach into the private `defines` array directly.
    set_define(mut &this, key: string, arg: Argument) -> void {
        for (mut i: int = 0; i < this.defines.length; i++) {
            if (this.defines[i].first.equals(&key)) {
                this.defines[i].second = arg;
                return;
            }
        }
        this.defines.push(Pair<string, Argument>::new(key, arg));
    }

    set_flag(mut &this, key: string, value: string) -> void {
        const flag: Argument = Argument {
            name:          key,
            description:   "",
            default_value: value,
            aliases:       [],
            required:      false,
            is_flag:       true,
        };
        for (mut i: int = 0; i < this.flags.length; i++) {
            if (this.flags[i].first.equals(&key)) {
                this.flags[i].second = flag;
                return;
            }
        }
        this.flags.push(Pair<string, Argument>::new(key, flag));
    }

    has_flag(&this, key: string) -> boolean {
        for (mut i: int = 0; i < this.flags.length; i++) {
            if (this.flags[i].first.equals(&key)) { return true; }
        }
        return false;
    }

    add_positional(mut &this, value: string) -> void {
        const arg: Argument = Argument {
            name:          value,
            description:   "",
            default_value: "",
            aliases:       [],
            required:      false,
            is_flag:       false,
        };
        this.positionals.push(arg);
    }

    positional_count(&this) -> int {
        return this.positionals.length as int;
    }

    input_file(&this) -> string {
        if (this.positionals.length > 0) {
            return this.positionals[0].name;
        }
        return "";
    }

    /// The i-th positional argument (0-based), or "" when out of range.
    /// Used by multi-positional commands such as `cryo vendor <sub> <arg>`.
    positional_at(&this, i: int) -> string {
        if (i >= 0 && i < this.positionals.length as int) {
            return this.positionals[i].name;
        }
        return "";
    }

    /// Reject malformed flags before dispatch.  Returns true when the parsed
    /// flags are acceptable; on the first problem it prints a diagnostic to
    /// stderr (matching the CLI's plain `Error:` style) and returns false, so
    /// the caller exits non-zero.  Two checks:
    ///   1. every flag must be in the known union (`is_known_flag`) - catches
    ///      typos like `--relese` that would otherwise be silently ignored;
    ///   2. `--output=`/`--target=` must carry a non-empty value - an empty
    ///      value would otherwise be silently accepted (dropping `-o`, etc.).
    /// `-D` defines live in a separate list and are intentionally not checked.
    validate(&this) -> boolean {
        for (mut i: int = 0; i < this.flags.length; i++) {
            const key: string = this.flags[i].first;
            if (!ArgumentParser::is_known_flag(key)) {
                fmt::eprintf("Error: unknown flag '--%s'. Run 'cryo help flags' for the list.\n", key);
                return false;
            }
        }
        for (mut i: int = 0; i < this.args.length; i++) {
            const key: string = this.args[i].first;
            if (!ArgumentParser::is_known_flag(key)) {
                fmt::eprintf("Error: unknown flag '--%s'. Run 'cryo help flags' for the list.\n", key);
                return false;
            }
            const value: string = this.args[i].second.default_value;
            const is_empty: boolean = value == "";
            const is_target_or_output: boolean =
                key == "output" || key == "o" || key == "target";
            if (is_empty && is_target_or_output) {
                fmt::eprintf("Error: flag '--%s' requires a non-empty value.\n", key);
                return false;
            }
        }
        return true;
    }
}

type struct Command {
    name:        string;
    description: string;
    usage:       string;
    arguments:   Argument[];

    static new(name: string, description: string, usage: string) -> Command {
        return Command {
            name:        name,
            description: description,
            usage:       usage,
            arguments:   [],
        };
    }

    add_argument(&this, arg: Argument) -> void {
        const l: int = this.arguments.length as int;
        this.arguments[l] = arg;
    }
}



type struct ArgumentParser {
    /// Parses command-line arguments starting from the given index in argv.
    /// Flags (starting with '-') go into the flags map, `-D` prefixed args
    /// go into defines, and everything else is collected as a positional.
    static parse(argc: int, argv: string*, start: int) -> ParsedArgs {
        mut result: ParsedArgs = ParsedArgs::new();

        for (mut i: int = start; i < argc; i++) {
            const arg: string = argv[i];
            const len: int = arg.length() as int;

            // -D defines: -DFOO=bar or -DFOO (defaults to "true")
            if (len > 2 && arg.starts_with("-D")) {
                const define_str: string = arg + 2;
                const define_arg: Argument = Argument {
                    name:          define_str,
                    description:   "",
                    default_value: "true",
                    aliases:       [],
                    required:      false,
                    is_flag:       false,
                };
                result.set_define(define_str, define_arg);
                continue;
            }

            // Flags: anything starting with '-'
            if (len >= 2 && arg.starts_with("-")) {
                // Detect `--key=value` form: split on '=' and store
                // as a value-bearing arg in the `args` map.  The bare
                // `--key` form (no '=') stays as a boolean flag.
                mut eq_idx: int = -1;
                for (mut k: int = 0; k < len; k++) {
                    if (arg[k] == '=') { eq_idx = k; break; }
                }
                if (eq_idx > 0) {
                    const key_buf: void* = malloc((eq_idx + 1) as u64);
                    memcpy(key_buf, arg as void*, eq_idx as u64);
                    const key_term: u8* = (key_buf as u8*) + (eq_idx as i64);
                    *key_term = 0;
                    const raw_key: string = key_buf as string;
                    const name: string = ArgumentParser::normalize_flag_name(raw_key);
                    const value: string = arg + ((eq_idx + 1) as i64);
                    result.set_arg(name, Argument {
                        name:          name,
                        description:   "",
                        default_value: value,
                        aliases:       [],
                        required:      false,
                        is_flag:       false,
                    });
                    continue;
                }
                const name: string = ArgumentParser::normalize_flag_name(arg);
                // Two-token form for value-bearing flags (e.g. `-o foo.o`,
                // `--output foo.o`).  When the next argv token exists and
                // doesn't itself look like a flag, consume it as the value.
                // Paths starting with '-' must use the `=` form instead.
                if (ArgumentParser::flag_takes_value(name) && (i + 1) < argc) {
                    const peek: string = argv[i + 1];
                    const peek_len: int = peek.length() as int;
                    const peek_is_flag: boolean = peek_len >= 1 && peek[0] == '-';
                    if (!peek_is_flag) {
                        result.set_arg(name, Argument {
                            name:          name,
                            description:   "",
                            default_value: peek,
                            aliases:       [],
                            required:      false,
                            is_flag:       false,
                        });
                        i++;
                        continue;
                    }
                }
                result.set_flag(name, "true");
                continue;
            }

            // Positional argument
            result.add_positional(arg);
        }

        return result;
    }

    /// Returns true for flags that take a value, so the parser can
    /// consume the next argv token as the value (`-o foo.o`).  The
    /// `=` form (`-o=foo.o`) works for any flag and goes through a
    /// different code path above.
    static flag_takes_value(name: string) -> boolean {
        return name == "o" || name == "output" || name == "codegen-threads"
            || name == "panic";
    }

    /// True for every flag any command, the test runner, or the build
    /// scripts accept - the UNION across all commands (names are already
    /// dash-stripped by `normalize_flag_name`).  `ParsedArgs::validate`
    /// hard-rejects anything not here, so this list MUST stay in sync with
    /// the flags commands actually read via `has_flag`/`has_arg` (see
    /// `CLI/commands.cryo`): a missing entry would reject a VALID flag and
    /// break real invocations (incl. CI / the selfhost scripts).  It is a
    /// single union rather than a per-command list, so a valid flag used on
    /// the wrong command is tolerated; a typo (`--relese`) is not.
    static is_known_flag(name: string) -> boolean {
        return match (name) {
            "help" | "h" | "version" | "v" | "debug" | "quiet" | "q"
            | "ast" | "emit-llvm" | "stdlib" | "build-dir" | "target"
            | "output" | "o" | "opt-level" | "debug-info" | "g"
            | "no-std" | "no-runtime" | "no-incremental" | "locked" | "release" | "dev" | "profile"
            | "release-static" | "ignored" | "list" | "exact" | "nocapture"
            | "show-output" | "jobs" | "timeout" | "format" | "color"
            | "codegen-threads" | "panic" => { true }
            _ => { false }
        };
    }

    /// Strips leading '--' or '-' from a flag string.
    static normalize_flag_name(name: string) -> string {
        if (name.starts_with("--")) {
            return name + 2;
        }
        if (name.starts_with("-")) {
            return name + 1;
        }
        return name;
    }
}


type struct Runner {
private:
    commands:       HashMap<string, Command>;
    command_order:  string[];   // insertion order for print_help
    program_name:   string;
    version:        string;

public:
    static new(program_name: string, version: string) -> Runner {
        return Runner {
            commands:       HashMap<string, Command>::new(),
            command_order:  [],
            program_name:   program_name,
            version:        version,
        };
    }

    /// Main entry point. Parses argv and dispatches to the appropriate
    /// command or falls back to direct file compilation.
    run(&this, argc: int, argv: string*) -> int {
        // Early --debug scan: flips the compiler debug gate before any
        // pass runs, so the [Tag]-style trace printfs sprinkled across
        // the codegen/sema/resolver passes can fire.  Off by default.
        for (mut i: int = 1; i < argc; i++) {
            if (argv[i] == "--debug") {
                set_compiler_debug(true);
                break;
            }
        }

        // No arguments: show help
        if (argc < 2) {
            this.print_help();
            return 0;
        }

        const first_arg: string = argv[1];

        // Global flags: --help / -h
        if (first_arg == "--help" || first_arg == "-h") {
            this.print_help();
            return 0;
        }

        // Global flags: --version / -v
        if (first_arg == "--version" || first_arg == "-v") {
            this.print_version();
            return 0;
        }

        // Internal, unlisted subcommand: the multi-process object emitter's
        // child entry (`cryo __emit-obj <manifest> <worker_idx> <worker_count>`).
        // The parent build spawns it; it never appears in help/resolve.
        if (first_arg == "__emit-obj") {
            const eo_args: ParsedArgs = ArgumentParser::parse(argc, argv, 2);
            return CLI::Commands::Executor::cmd_emit_obj(eo_args);
        }

        // Try command dispatch first (build, check, raw, project, help, version)
        const resolved: CommandKind = CLI::Commands::Executor::resolve(first_arg);
        if (resolved != CommandKind::Unknown) {
            // `help` takes a raw topic token (a command or flag name), not
            // parsed flags; `cryo help --debug` must treat `--debug` as the
            // topic, not as a boolean flag.  Resolve it here, before the
            // generic argument parse eats the leading dashes.
            if (resolved == CommandKind::Help) {
                if (argc >= 3) {
                    return CLI::Commands::Executor::help_topic(argv[2]);
                }
                this.print_help();
                return 0;
            }
            // Per-subcommand `--help`/`-h` intercept.  Without this, each
            // command's `args.has_flag("help")` boolean was set but no command
            // body checked it; `cryo build --help` returned "No input file",
            // `cryo init --help` started the interactive prompt.
            for (mut hi: int = 2; hi < argc; hi++) {
                const t: string = argv[hi];
                if (t == "--help" || t == "-h") {
                    this.print_command_help(first_arg);
                    return 0;
                }
            }
            const args: ParsedArgs = ArgumentParser::parse(argc, argv, 2);
            if (!args.validate()) { return 1; }
            return this.dispatch(first_arg, args);
        }

        // Not a known command; treat as a file for direct compilation
        if (metadata::exists(Path::from(first_arg))) {
            const args: ParsedArgs = ArgumentParser::parse(argc, argv, 2);
            if (!args.validate()) { return 1; }
            return CLI::Commands::Executor::compile_file(first_arg, args);
        }

        fmt::eprintf("Error: '%s' is not a known command or file.\n", first_arg);
        fmt::eprintf("Run 'cryo help' for usage.\n");
        return 1;
    }

    /// Registers the built-in commands via Executor.
    init_commands(&this) -> Runner {
        CLI::Commands::Executor::register_commands(this);
        return this;
    }

    add_command(&this, cmd: Command) -> void {
        const name: string = cmd.name;
        match (this.commands.insert(cmd.name, cmd)) {
            Option::Some(_) => {} // overwrite: name was already registered
            Option::None    => { this.command_order.push(name); }
        }
    }

    print_help(&this) -> void {
        fmt::printf("%s %s\n", this.program_name, this.version);
        fmt::printf("The Cryo compiler and build tool\n\n");
        fmt::printf("Usage: %s <command> [options]\n", this.program_name);
        fmt::printf("       %s <file.cryo> [options]\n\n", this.program_name);
        fmt::printf("Commands:\n");
        const order_len: u64 = this.command_order.length();
        for (mut i: u64 = 0; i < order_len; i++) {
            const cmd_name: string = this.command_order[i];
            // Borrow the stored Command; it owns an `Argument[]`, so a
            // by-value `get` would alias map storage. Read-only here.
            match (this.commands.get_ref(&cmd_name)) {
                Option::Some(cmd) => {
                    fmt::printf("  %-12s %s\n", cmd_name, cmd.description);
                }
                Option::None => {}
            }
        }
        fmt::printf("\nOptions:\n");
        fmt::printf("  -h, --help        Print help (use `cryo help <command>` for details)\n");
        fmt::printf("  -v, --version     Print version information\n");
        fmt::printf("\nTopics (cryo help <topic>):\n");
        fmt::printf("  flags             All build flags (--emit-llvm, --target, -o, ...)\n");
        fmt::printf("  config            The cryoconfig project-file format\n");
        fmt::printf("  stdlib            How the standard-library root is resolved\n");
        fmt::printf("\nRun `cryo help <command>` for command-specific help.\n");
    }

    print_version(&this) -> void {
        fmt::printf("%s version %s\n", this.program_name, this.version);
    }

    /// Per-subcommand help: usage line, one-line description, and a
    /// pointer to the global flag list.  Called when the user types
    /// `cryo <subcmd> --help` (or `-h`).
    print_command_help(&this, cmd_name: string) -> void {
        // Borrow rather than copy out: Command owns an `Argument[]`.
        match (this.commands.get_ref(&cmd_name)) {
            Option::Some(cmd) => {
                fmt::printf("%s\n\n", cmd.description);
                fmt::printf("Usage: %s\n\n", cmd.usage);
                fmt::printf("Run `%s help %s` for detailed help on this command.\n",
                    this.program_name, cmd_name);
            }
            Option::None => {
                fmt::printf("Unknown command '%s'.\n\n", cmd_name);
            }
        }
        fmt::printf("Run `%s help flags` for the full flag list, or `%s help <flag>` for one flag.\n",
            this.program_name, this.program_name);
    }

private:
    /// Delegates command execution to Executor.
    dispatch(&this, cmd_name: string, args: ParsedArgs) -> int {
        return CLI::Commands::Executor::dispatch(cmd_name, this, args);
    }
}

