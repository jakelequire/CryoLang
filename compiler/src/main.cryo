namespace main;

import cli;
import utils::build_stamp::{ BuildStamp };

const VERSION: string = "1.0.0";

/// The pre-release label printed after VERSION (`1.0.0-alpha`); "" for a
/// release.  VERSION stays the bare release number the release scripts read.
const PRERELEASE: string = "alpha";

function main(argc: int, argv: string*) -> int {
    const version: string = BuildStamp::running().version(VERSION, PRERELEASE);
    const runner: cli::Runner = cli::Runner::new("cryo", version)
                                .init_commands();
    return runner.run(argc, argv);
}
