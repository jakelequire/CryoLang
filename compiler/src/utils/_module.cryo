/// This module contains utility types and functions that are used across the project.
namespace Utils;

public module Logger;
public module SyntaxHighlighter;

mut g_logger: Logger*;

const STDOUT_FD: i64 = 1;
mut g_stderr: void*;

/// Compiler debug-output gate. Off by default; only flipped on by
/// `--debug` (CLI) or `debug = true` in cryoconfig. When false the
/// compiler is silent except for diagnostics, panics, and explicit CLI
/// command output. Read via `Utils::Logger::compiler_debug_enabled()`.
mut g_compiler_debug: boolean = false;
