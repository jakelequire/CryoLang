///! Keyword
///!
///! A spelling matched against a table the language or its configuration
///! format fixes: a keyword (`if`, `function`), a numeric literal's suffix
///! (`u32` in `42u32`), a primitive numeric type's spelling, a project
///! setting's value (`library`, `unwind`).  The table is written into the
///! compiler; no declaration in a program is ever found through one.  A name
///! is a `SymbolStr`, so a function taking a `Keyword` has nothing to find a
///! declaration with, and is outside the set of functions that take a
///! spelling.
///!
///! The bytes are one NUL-terminated `string`, so wrapping and unwrapping
///! cost nothing.  `as_string` is written where the bytes are compared.
namespace utils::keyword;

type struct Keyword {
private:
    raw: string;

public:
    /// Mark `s` as a spelling to be matched against a fixed table.
    static new(s: string) -> Keyword {
        return Keyword { raw: s };
    }

    /// The raw NUL-terminated bytes.
    as_string(&this) -> string {
        return this.raw;
    }
}
