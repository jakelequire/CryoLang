///! Text
///!
///! A string the compiler reads or writes and never looks anything up by:
///! a diagnostic's message, a log line, a file path, a command line, a label
///! handed to the backend.  A name is a `SymbolStr` (or a `QualifiedName`
///! of them); a parameter typed `Text` cannot be handed one, and a function
///! taking `Text` has nothing to find a declaration with, so it is outside
///! the set of functions that take a spelling.
///!
///! The bytes are the same NUL-terminated `string` either way - `Text` is one
///! pointer, `Copy`, passed in one register - so wrapping and unwrapping cost
///! nothing.  Crossing back to a raw `string` is `as_string`, written where a
///! C function or a `string`-typed store needs the bytes.
namespace utils::text;

import std::core::result;
import std::core::result::{ Result };
import std::collections::str;
import std::collections::str::{ Str };
import std::fmt::error;
import std::fmt::error::{ FmtError };
import std::fmt::display;
import std::fmt::display::{ Display, Formatter };
import std::fmt::write;
import std::fmt::write::{ FmtWrite };

type struct Text {
private:
    raw: string;

public:
    /// Mark `s` as text.  Where a name's spelling is rendered into a message,
    /// the caller has already decided it is being shown, not looked up.
    static new(s: string) -> Text {
        return Text { raw: s };
    }

    /// The raw NUL-terminated bytes.
    as_string(&this) -> string {
        return this.raw;
    }
}

/// `f"{t}"` writes the text, as it would the raw `string`.
implement trait Display for Text {
    fmt<W>(&this, f: mut &Formatter<W>) -> Result<(), FmtError>
    where W: FmtWrite {
        return f.write_str(Str::new(this.raw));
    }
}
