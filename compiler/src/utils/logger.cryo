///! Logger Module
///!
///! Console-only logger for the Cryo compiler.
///! Supports log levels, component filtering, timestamps, and ANSI colors.
namespace utils::logger;
// `g_logger`, `g_stderr` and `g_compiler_debug` are declared by `Utils`; a
// child namespace is a separate module and does not inherit its parent's
// scope, so the names have to be imported to be bound here.
import utils;
import std::ffi::libc;
import std::env;
import std::io::stdio;
import std::io::traits;
import std::core::result;
import std::collections::str;
import std::collections::string;


type enum LogLevel {
    Trace;   // Most verbose - internal state tracking
    Debug;   // Debug information for development
    Info;    // General informational messages
    Warn;    // Warning messages (potential issues)
    Error;   // Error messages (recoverable errors)
    Fatal;   // Fatal errors (unrecoverable)
    None;    // Disable all logging
}

implement enum LogLevel {
    label(&this) -> string {
        return match (this) {
            LogLevel::Trace => { "TRACE" }
            LogLevel::Debug => { "DEBUG" }
            LogLevel::Info  => { "INFO " }
            LogLevel::Warn  => { "WARN " }
            LogLevel::Error => { "ERROR" }
            LogLevel::Fatal => { "FATAL" }
            LogLevel::None  => { "NONE " }
        };
    }

    color(&this) -> string {
        return match (this) {
            LogLevel::Trace => { "\033[0;37m" }  // White
            LogLevel::Debug => { "\033[0;36m" }  // Cyan
            LogLevel::Info  => { "\033[0;32m" }  // Green
            LogLevel::Warn  => { "\033[0;33m" }  // Yellow
            LogLevel::Error => { "\033[0;31m" }  // Red
            LogLevel::Fatal => { "\033[1;31m" }  // Bold Red
            LogLevel::None  => { "\033[0m" }     // Reset
        };
    }

    reset(&this) -> string {
        return "\033[0m";
    }

    to_int(&this) -> int {
        return match (this) {
            LogLevel::Trace => { 0 } 
            LogLevel::Debug => { 1 } 
            LogLevel::Info  => { 2 } 
            LogLevel::Warn  => { 3 } 
            LogLevel::Error => { 4 } 
            LogLevel::Fatal => { 5 } 
            LogLevel::None  => { 6 } 
        };
    }

    // Returns true if `candidate` meets or exceeds the `threshold`
    meets_threshold(&this, threshold: LogLevel) -> boolean {
        const c: int = this.to_int();
        const t: int = threshold.to_int();
        return c >= t;
    }
}

type enum LogComponent {
    General;
    Lexer;
    Parser;
    AST;
    TypeChecker;
    Resolver;
    CodeGen;
    Linker;
    Optimizer;
    Diagnostic;
    Runtime;
    StdLib;
    CLI;
    LSP;
}

implement enum LogComponent {
    label(&this) -> string {
        return match (this) {
            LogComponent::General     => { "GENERAL" }
            LogComponent::Lexer       => { "LEXER" }
            LogComponent::Parser      => { "PARSER" }
            LogComponent::AST         => { "AST" }
            LogComponent::TypeChecker => { "TYPECHECKER" }
            LogComponent::Resolver    => { "RESOLVER" }
            LogComponent::CodeGen     => { "CODEGEN" }
            LogComponent::Linker      => { "LINKER" }
            LogComponent::Optimizer   => { "OPTIMIZER" }
            LogComponent::Diagnostic  => { "DIAGNOSTIC" }
            LogComponent::Runtime     => { "RUNTIME" }
            LogComponent::StdLib      => { "STDLIB" }
            LogComponent::CLI         => { "CLI" }
            LogComponent::LSP         => { "LSP" }
        };
    }
}

type struct LoggerConfig {
    min_level:              LogLevel;
    enable_colors:          boolean;
    enable_timestamps:      boolean;
    enable_component_tags:  boolean;

    static default() -> LoggerConfig {
        return LoggerConfig {
            min_level:             LogLevel::None,
            enable_colors:         true,
            enable_timestamps:     true,
            enable_component_tags: true,
        };
    }

    static debug_config() -> LoggerConfig {
        return LoggerConfig {
            min_level:             LogLevel::Debug,
            enable_colors:         true,
            enable_timestamps:     true,
            enable_component_tags: true,
        };
    }
}

type struct Logger {
private:
    config: LoggerConfig;

public:
    static new(config: LoggerConfig) -> Logger {
        return Logger { config: config };
    }

    static default() -> Logger {
        return Logger { config: LoggerConfig::default() };
    }

    static instance() -> Logger* {
        return g_logger;
    }

    static init() -> void {
        g_stderr = libc::fdopen(2, "w");
        const logger: Logger* = intrinsics::malloc(sizeof(Logger)) as Logger*;
        *logger = Logger::default();
        g_logger = logger;
    }

    /// Activate debug-level logging.  Called when --debug is passed.
    static enable_debug() -> void {
        Logger::instance().set_level(LogLevel::Debug);
    }

    set_level(&this, level: LogLevel) -> void {
        this.config.min_level = level;
    }


    trace(&this, component: LogComponent, msg: string) -> void {
        this.write_log(LogLevel::Trace, component, msg);
    }

    debug(&this, component: LogComponent, msg: string) -> void {
        this.write_log(LogLevel::Debug, component, msg);
    }

    info(&this, component: LogComponent, msg: string) -> void {
        this.write_log(LogLevel::Info, component, msg);
    }

    warn(&this, component: LogComponent, msg: string) -> void {
        this.write_log(LogLevel::Warn, component, msg);
    }

    error(&this, component: LogComponent, msg: string) -> void {
        this.write_log(LogLevel::Error, component, msg);
    }

    fatal(&this, component: LogComponent, msg: string) -> void {
        this.write_log(LogLevel::Fatal, component, msg);
        // Fatal is unrecoverable; abort (env::process_exit -> libc exit,
        // which flushes stdio on the way out).
        env::process_exit(1);
    }

private:
    // Core write - always writes to stderr (fd 2) so stdout stays
    // clean for any LSP/JSON-RPC usage
    write_log(&this, level: LogLevel, component: LogComponent, msg: string) -> void {
        if (!level.meets_threshold(this.config.min_level)) {
            return;
        }

        // Assemble the whole line - [LEVEL][COMPONENT] message - into one
        // buffer, then hand it to stderr in a single write.  `io::stdio::Stderr`
        // writes straight through `write(2)` (fd 2, unbuffered), so the message
        // appears immediately with no explicit flush, and stdout stays clean for
        // any LSP/JSON-RPC channel.
        mut line: String = String::new();

        if (this.config.enable_colors) {
            line.push(level.color());
        }

        line.push("[");
        line.push(level.label());
        line.push("]");

        if (this.config.enable_component_tags) {
            line.push("[");
            line.push(component.label());
            line.push("]");
        }

        line.push(" ");
        line.push(msg);

        if (this.config.enable_colors) {
            line.push(level.reset());
        }

        line.push("\n");

        mut e: Stderr = stdio::stderr();
        match (e.write(line.as_str())) {
            Result::Ok(_)  => {}
            Result::Err(_) => {}
        }
    }
}


function LOG_DEBUG(component: LogComponent, msg: string, args...) -> void {
    // DEBUG log level is off by default (LogLevel::None in
    // LoggerConfig::default), so no-op in production builds.  Avoids
    // running format() over potentially-uninitialized %s args from
    // ad-hoc diagnostic call sites.  The Logger::instance().config
    // chain walked here is sensitive to early-init ordering, so this
    // unconditional early-return is the safe form.
    return;
}


// Compiler debug gate
//
// The compiler historically used `printf(...)` everywhere for ad-hoc trace
// output.  Production users don't want to see any of it.  This module
// provides:
//
//   - `set_compiler_debug(true)`:   flipped by `--debug` (CLI) and by
//                                    `debug = true` in cryoconfig.
//   - `compiler_debug_enabled()`:   predicate, exposed for sites that
//                                    do something more elaborate than
//                                    print a single line.
//   - `cdebug(fmt, args...)`:       printf-shaped wrapper.  No-op when
//                                    debug is off.  Writes to stderr so
//                                    the user's program output (and
//                                    LSP/JSON-RPC channels) stay clean
//                                    on stdout.
//
// `cdebug` works by forwarding the variadic bucket to libc's `vfprintf`
// (declared in `core::intrinsics`); Cryo's variadic prologue allocates a
// va_list and binds the `args` identifier to the va_list pointer, which
// `vfprintf` accepts directly.  This is the only legal way in C to forward
// `...` to another variadic callee, and Cryo inherits it through the
// compiler's existing va_start/va_end emission.

function set_compiler_debug(enabled: boolean) -> void {
    g_compiler_debug = enabled;
}

function compiler_debug_enabled() -> boolean {
    return g_compiler_debug;
}

function cdebug(fmt: string, args...) -> i32 {
    if (!g_compiler_debug) { return 0; }
    return intrinsics::vfprintf(g_stderr, fmt, args);
}
