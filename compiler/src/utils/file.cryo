namespace Utils::File;

/// The `File` struct represents a file in the filesystem or an in-memory file with content. 
/// It provides methods to load, access, and manage file content.
/// This struct is designed to be flexible, allowing for both file-based and in-memory content management. 
/// It includes methods for loading content from a file path, creating a file from in-memory content, 
/// and accessing various properties of the file.
type struct File {
private:
    path:         string;
    file_name:    string;
    extension:    string;
    content:      string;
    content_size: u64;
    fd:           i64;
    loaded:       boolean;

public:
    /// Factory method to create a `File` instance from a file path. It extracts the file name and extension from the path.
    static new(path: string) -> File {
        const file_name: string = File::extract_file_name(path);
        const extension: string = File::extract_extension(file_name);
        const fd_result: i64 = match (File::get_fd(path)) {
            Result::Ok(fd) => { fd }
            Result::Err(_) => { -1 }
        };

        return File {
            path:         path,
            file_name:    file_name,
            extension:    extension,
            content:      "",
            content_size: 0,
            fd:           fd_result,
            loaded:       false,
        };
    }

    /// Factory method to create a `File` instance from in-memory content. 
    /// This is useful for testing or when you want to work with content that doesn't come from an actual file.
    static from_content(name: string, extension: string, content: string) -> File {
        return File {
            path:         "",
            file_name:    name,
            extension:    extension,
            content:      content,
            content_size: intrinsics::strlen(content),
            fd:           -1,
            loaded:       true,
        };
    }


    /// Checks if a file exists at the given path. 
    /// This is a static method that can be used without creating an instance of `File`.
    static exists(path: string) -> boolean {
        if (path == "" || path == null) {
            return false;
        }
        const handle: void* = intrinsics::fopen(path, "r");
        if (handle == null) {
            return false;
        }
        intrinsics::fclose(handle);
        return true;
    }

    // --- File operations ---
    load(this: File*) -> Result<boolean, string> {
        if (this.loaded) {
            return Result::Ok(true);
        }

        const handle: void* = intrinsics::fopen(this.path, "r");
        if (handle == null) {
            const err_msg: string = format("Failed to open file at path: %s", this.path);
            return Result::Err(err_msg);
        }

        intrinsics::fseek(handle, 0 as i64, 2);
        const file_size: i64 = intrinsics::ftell(handle);
        intrinsics::fseek(handle, 0 as i64, 0);

        if (file_size < 0 as i64) {
            intrinsics::fclose(handle);
            const err_msg: string = format("Failed to determine file size for file at path: %s", this.path);
            return Result::Err(err_msg);
        }

        const size: u64 = file_size as u64;

        const buffer: i8* = intrinsics::malloc(size + 1) as i8*;
        if (buffer == null) {
            intrinsics::fclose(handle);
            const err_msg: string = format("Failed to allocate memory for file content for file at path: %s", this.path);
            return Result::Err(err_msg);
        }

        const bytes_read: u64 = intrinsics::fread(buffer as void*, 1, size, handle);
        intrinsics::fclose(handle);

        const term_ptr: i8* = intrinsics::ptr_add(buffer as void*, bytes_read as i64) as i8*;
        intrinsics::memset(term_ptr as void*, 0, 1);

        this.content = buffer as string;
        this.content_size = bytes_read;
        this.loaded = true;

        return Result::Ok(true);
    }

    close(this: File*) -> boolean {
        this.loaded = false;
        this.content = "";
        this.content_size = 0;
        this.fd = -1;
        return true;
    }

    // --- Getters ---
    path(this: File*) -> string {
        return this.path;
    }

    name(this: File*) -> string {
        return this.file_name;
    }

    extension(this: File*) -> string {
        return this.extension;
    }

    content(this: File*) -> string {
        return this.content;
    }

    is_loaded(this: File*) -> boolean {
        return this.loaded;
    }

    size(this: File*) -> u64 {
        return this.content_size;
    }

    data(this: File*) -> i8* {
        return this.content as i8*;
    }

private:
    // --- Internal helpers ---
    static extract_file_name(path: string) -> string {
        const slash: i8* = intrinsics::strrchr(path, 47) as i8*;
        if (slash == null) {
            return path;
        }
        const name_ptr: i8* = intrinsics::ptr_add(slash as void*, 1) as i8*;
        return intrinsics::strdup(name_ptr as string) as string;
    }

    static extract_extension(file_name: string) -> string {
        const dot: i8* = intrinsics::strrchr(file_name, 46) as i8*;
        if (dot == null) {
            return "";
        }
        const ext_ptr: i8* = intrinsics::ptr_add(dot as void*, 1) as i8*;
        return intrinsics::strdup(ext_ptr as string) as string;
    }

    static get_fd(path: string) -> Result<i32, string> {
        const handle: void* = intrinsics::fopen(path, "r");
        if (handle == null) {
            const err_msg: string = format("Failed to open file at path: %s", path);
            return Result::Err(err_msg);
        }
        const fd: i32 = fileno(handle);
        intrinsics::fclose(handle);
        return Result::Ok(fd);
    }
}

