/// G6 — `This` as a type annotation.
///
/// Smoke test for parse_base_type accepting `This` and emitting a
/// TypeAnnotation::ThisType variant. Sema resolution to the implementing
/// type lands in Phase B.1; this commit verifies the parser captures the
/// new variant and the AST visitors (cloner, substituter, dumper, resolver)
/// thread it through without crashing.

namespace bridge::g6;

/// Trait declaration shapes that use `This` as the parser sees them.
/// Until G1 lands the `implement trait` syntax, This-bearing decls only
/// appear in standalone trait declarations and free functions.

type trait CmpLike {
    /// `&This` as a parameter annotation.
    equals(&this, other: &This) -> boolean;

    /// `This` as a return type.
    clone_self(&this) -> This;

    /// Mixed: `&This` in, `This*` out.
    copy(&this) -> This*;
}

function main() -> i32 {
    return 0;
}
