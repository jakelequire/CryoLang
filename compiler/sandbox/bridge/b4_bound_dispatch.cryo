/// B.4 — Bound-aware method dispatch.
///
/// `same()` calls `equals` on a generic `T: Eq` receiver. Without B.4,
/// sema cannot find `equals` on the symbolic `T`. With B.4, dispatch
/// walks the bound traits, locates `equals` on `Eq`, and uses its
/// signature.

namespace bridge::b4;

type trait Eq {
    function equals(&this, other: &This) -> boolean;
}

implement trait Eq for i32 {
    equals(&this, other: &i32) -> boolean { return this == *other; }
}

function same<T: Eq>(a: T, b: T) -> boolean {
    return a.equals(&b);
}

function main() -> i32 {
    // Note: actually instantiating `same<i32>(1, 1)` requires B.6
    // (rewriting the symbolic trait call to the concrete impl during
    // monomorphization). This sandbox only verifies that B.4 lets the
    // generic body itself type-check — `a.equals(&b)` resolves through
    // the `T: Eq` bound instead of erroring with E0358.
    return 0;
}
