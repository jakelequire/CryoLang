/// G4 + G5 — Multi-bound and qualified-name trait bounds.
///
/// Smoke test for parse_trait_bounds accepting `+`-separated trait refs
/// and `::`-qualified paths. Sema resolution and dispatch are not yet wired
/// (lands in Phase B); this file exists only to verify the parser captures
/// the new shapes into TraitBound.trait_refs and TraitRef.path.

namespace bridge::g4_g5;

/// Single bound (existing form, must keep parsing).
function single<T>(x: T) -> i32 where T: Eq {
    return 0;
}

/// Multi-bound (G4): `T: A + B`.
function multi<T>(x: T) -> i32 where T: Hash + Eq {
    return 0;
}

/// Qualified bound (G5): `W: io::Write`.
function qualified<W>(w: W) -> i32 where W: io::Write {
    return 0;
}

/// Multiple type params with mixed shapes — the comma-separated outer loop
/// must still terminate cleanly with `+` and `::` inside each bound.
function combined<T, K, W>(a: T, k: K, w: W) -> i32
        where T: Hash + Eq, K: core::cmp::Ord, W: io::Write {
    return 0;
}

function main() -> i32 {
    return 0;
}
