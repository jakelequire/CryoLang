/// G3 — Default type parameters: <T, A = i32>
///
/// Smoke test for parse_generic_params accepting `= DefaultType` after the
/// optional constraint list. Sema substitution is not yet wired (Phase B.2),
/// so this file exists only to verify the parser accepts the new syntax and
/// the AST dump round-trips the default annotation.

namespace bridge::g3;

type struct Box<T, A = i32> {
    value:     T;
    allocator: A;
}

type struct WithConstraint<T: Eq, A = i32> {
    value:     T;
    allocator: A;
}

type struct NestedDefault<T, M = HashMap<T, i32>> {
    payload: M;
    seed:    T;
}

function main() -> i32 {
    return 0;
}
