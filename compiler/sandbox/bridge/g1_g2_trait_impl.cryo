/// G1 + G2 — `implement trait Foo for Bar` syntax.
///
/// Smoke test for parse_implementation_block accepting the trait-impl
/// shape, with optional leading <T, ...> generic params, optional generic
/// args on the trait reference and target, and optional `where` clause.
///
/// Sema dispatch (Phase B) doesn't run here, so the trait names referenced
/// below don't need to exist in scope — the parser only captures the
/// annotation; it does not resolve.

namespace bridge::g1_g2;

// G1 — Bare trait impl on a primitive: `implement trait Foo for i32`.
implement trait Eq for i32 {
    equals(&this, other: &i32) -> boolean { return this == *other; }
}

// G1 — Trait impl on a user-defined struct.
type struct Box {
    value: i32;
}

implement trait Eq for struct Box {
    equals(&this, other: &Box) -> boolean { return this.value == other.value; }
}

// G2 — Generic trait impl with where clause.
type struct Range<T> {
    start: T;
    end:   T;
}

implement<T> trait Iterator<T> for struct Range<T> where T: Step {
    next(mut &this) -> T { return this.start; }
}

// G2 — Generic trait impl with multi-bound where clause.
implement<T> trait Hashable<T> for struct Range<T> where T: Hash + Eq {
    hash_value(&this) -> u64 { return 0; }
}

function main() -> i32 {
    return 0;
}
