///! Default — a canonical "zero value" for a type.
///!
///! `Default` lets generic code construct a value without knowing the
///! concrete type. Collections use it for `Array::resize` and similar
///! APIs that grow with filler elements.

namespace std::core::default;

type trait Default {
    static default() -> This;
}

implement trait Default for i8      { static default() -> i8      { return 0; } }
implement trait Default for i16     { static default() -> i16     { return 0; } }
implement trait Default for i32     { static default() -> i32     { return 0; } }
implement trait Default for i64     { static default() -> i64     { return 0; } }
implement trait Default for u8      { static default() -> u8      { return 0; } }
implement trait Default for u16     { static default() -> u16     { return 0; } }
implement trait Default for u32     { static default() -> u32     { return 0; } }
implement trait Default for u64     { static default() -> u64     { return 0; } }
implement trait Default for f32     { static default() -> f32     { return 0.0f32; } }
implement trait Default for f64     { static default() -> f64     { return 0.0; } }
implement trait Default for boolean { static default() -> boolean { return false; } }
implement trait Default for char    { static default() -> char    { return '\0'; } }
