/// Placeholder main.
///
/// `cryo test` (which is how this project is meant to be built and run)
/// suppresses this function and synthesises a test-runner main from
/// every `![test]` in the `tests/` directory.  Running `cryo run`
/// against this project would invoke the body below; that path exists
/// only to keep the cryoconfig honest about being an executable target.
///
/// We call the libc-passthrough `intrinsics::printf` rather than the
/// bare prelude `println(...)` because the latter is ambiguous between
/// the variadic intrinsic and `std::fmt::display::println<T>` once the
/// fmt module is in the build (which it is — `std::test::assert`
/// pulls it in transitively).

namespace CryoTests::Main;

import std::core::intrinsics;

function main(argc: int, argv: string*) -> int {
    intrinsics::printf("This is the cryo-tests project. Run with `cryo test` to execute the test suite.\n");
    return 0;
}
