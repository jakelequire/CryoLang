/// Declared at the path `scripts/spelling-flow.py` knows the compiler's
/// definition table by: `path_of` is text a definition hands back.
namespace compiler::resolver::res;

import compiler::resolver::symbol_str;

type struct DefTable {
    n: u32;
    path_of(&this, d: u32) -> symbol_str::SymbolStr { return symbol_str::SymbolStr { id: d }; }
}
