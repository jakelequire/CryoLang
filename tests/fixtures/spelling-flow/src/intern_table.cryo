/// Declared at the paths `scripts/spelling-flow.py` knows the compiler's
/// intern table and definition table by: `resolve` hands back the text a
/// spelling stands for, `path_of` the text a definition hands back.
namespace compiler::resolver::intern_table;

import compiler::resolver::symbol_str;

type struct InternTable {
    n: u32;
    ![allow(lookup_by_spelling, reason = "the fixture's stand-in for the intern table: it takes spellings on purpose")]
    resolve(&this, s: symbol_str::SymbolStr) -> string { return "Option"; }
}
