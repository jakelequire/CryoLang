/// Declared at the path the facts writer knows the compiler's `SymbolStr` by.
namespace compiler::resolver::symbol_str;

type struct SymbolStr {
    id: u32;
    ![allow(lookup_by_spelling, reason = "the facts probe compares two spellings on purpose")]
    equals(&this, other: SymbolStr) -> boolean { return this.id == other.id; }
    /// The text an identity hands back, as the intern table's `resolve` does.
    text_of(&this) -> string { return "Option"; }
}
