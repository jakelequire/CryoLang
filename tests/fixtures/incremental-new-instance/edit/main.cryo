namespace IncrementalNewInstance::Main;

import std::thread;
import std::collections::str::{ Str };
import std::collections::string::{ String };
import std::fmt::write::{ FmtWrite };
import IncrementalNewInstance::Meters::{ Gauge, Meter };

type struct JobA { n: i32; }
type struct JobB { m: i64; }

function run_a(j: JobA) -> void { }
function run_b(j: JobB) -> void { }

function main() -> i32 {
    {
        mut scope: thread::Scope = thread::Scope::new();
        scope.spawn::<JobA>(JobA { n: 1 }, run_a);
        scope.spawn::<JobB>(JobB { m: 2 }, run_b);
    }
    const wide: Gauge<i64> = Gauge::<i64> { level: 0, fill: 0 };
    const narrow: Gauge<i16> = Gauge::<i16> { level: 0, fill: 0 };
    const m: virtual &Meter = &wide;
    const n: virtual &Meter = &narrow;
    mut text: String = String::new();
    const w: virtual mut &FmtWrite = &text;
    w.write_str(Str::from("ab"));
    return (m.read() + n.read() + text.length() - 8) as i32;
}
