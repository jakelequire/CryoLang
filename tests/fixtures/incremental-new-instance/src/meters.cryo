namespace IncrementalNewInstance::Meters;

// Unchanged by the edit: a generic implementation whose table for each
// instantiation a conversion names is emitted with the instantiation.

type trait Meter {
    read(&this) -> i64;
}

type struct Gauge<T> {
    level: i64;
    fill:  T;
}

implement<T> trait Meter for struct Gauge<T> {
    read(&this) -> i64 { return this.level + sizeof(T) as i64; }
}
