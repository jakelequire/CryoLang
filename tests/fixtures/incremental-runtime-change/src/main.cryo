namespace IncrementalRuntimeChange::Main;

import std::env;

// The divisor is the count of arguments after the program's name, 0 when
// the check runs it, so no build can fold the division away: it reaches
// the runtime's divide-by-zero panic, whose message the check reads.
function main() -> i32 {
    const divisor: i64 = env::args().length() - 1;
    return (7 / divisor) as i32;
}
