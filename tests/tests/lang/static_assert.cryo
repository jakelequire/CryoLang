///! Compile-time `static_assert(cond)` / `static_assert(cond, "msg")` at module
///! scope. Evaluated during TypeLowering once layouts are known; a false or
///! non-constant condition is E0237 (see negative/E0237_static_assert.cryo).
///! Supports integer/boolean literals, sizeof/alignof, and arithmetic /
///! comparison / logical / bitwise operators. Verifies IMPROVEMENT.md §4.
///!
///! These module-scope assertions are checked at COMPILE time; this file
///! compiling at all means every one of them held.

![config(testing)]
namespace CryoTests::Tests::Lang::StaticAssert;

import std::core::result;
import std::test::error;
import std::test::assert;

type struct SAPair { a: i32; b: i32; }

static_assert(sizeof(i32) == 4);
static_assert(sizeof(i64) == 8);
static_assert(sizeof(u8) == 1);
static_assert(alignof(i64) == 8);
static_assert(sizeof(SAPair) == 8);
static_assert(alignof(SAPair) == 4);
static_assert(sizeof(SAPair) == 2 * sizeof(i32));
static_assert(sizeof(u8) == 1 && alignof(u8) == 1);
static_assert(sizeof(i32) < sizeof(i64));
static_assert(sizeof(SAPair) >= 8, "SAPair must be at least 8 bytes");

![test]
function static_asserts_hold_at_compile_time() -> Result<(), TestError> {
    // Reaching here means all module-scope static_asserts above compiled.
    return expect_eq(sizeof(SAPair) as i64, 8);
}
