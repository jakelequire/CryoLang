// A take of ownership reached through a raw pointer is written as one:
// `pointer::read(p)` takes the value out by its bits, and the program keeps
// the storage from releasing it again - `pointer::write` refills it, or it is
// freed unreleased.
//
// A by-value read of `*p` is refused, inside `unsafe` as outside it (E0453:
// the pointee is duplicated into an independently-dropped place while
// whoever owns that storage keeps its own claim, so the destructor runs
// twice - see negative/E0453_deref_move_out.cryo and
// negative/E0453_unsafe_does_not_permit_a_take.cryo). Every case here PROVES
// a take by counting destructor runs: a take leaves exactly one, a
// duplication would leave two.
![config(testing)]
namespace CryoTests::Tests::Lang::DerefTakeInUnsafe;

import std::test;
import std::core::result::{ Result };
import std::core::mem;
import std::core::pointer;
import std::test::assert::{ expect_equal };
import std::test::error::{ TestError };

mut g_drops: i64 = 0;

type struct Res {
    id: i64;

    static new(id: i64) -> Res { return Res { id: id }; }
}

implement trait Drop for struct Res {
    drop(mut &this) -> void { g_drops = g_drops + 1; }
}

// A take balanced by an overwrite: the slot is refilled before anything can
// drop it, so exactly one owner exists at every moment.
function take_and_refill(slot: mut Res*, replacement: Res) -> Res {
    mut previous: Res;
    unsafe { previous = pointer::read(slot); }
    pointer::write(slot, replacement);
    return previous;
}

type struct Cell {
    item: Res;

    // The member is taken out from behind the receiver and a new one stored
    // through it: the store releases nothing, since the storage holds the
    // bits of the value the take's temporary owns and releases.
    renumber(mut &this, offset: i64) -> void {
        unsafe { this.item = Res::new(pointer::read(&this.item).id + offset); }
    }
}

![test]
function a_store_after_a_take_through_a_reference_releases_nothing() -> Result<(), TestError> {
    g_drops = 0;
    mut seen: i64 = 0;
    if (true) {
        mut cell: Cell = Cell { item: Res::new(7) };
        cell.renumber(100);
        seen = cell.item.id;
        // The taken value was released when its statement ended.
        if (g_drops != 1) { return expect_equal(g_drops, 1 as i64); }
    }
    if (seen != 107) { return expect_equal(seen, 107 as i64); }
    return expect_equal(g_drops, 2 as i64);
}

![test]
function a_value_is_written_over_storage_holding_nothing() -> Result<(), TestError> {
    g_drops = 0;
    if (true) {
        mut held: Res = Res::new(1);
        const taken: Res = take_and_refill(&held, Res::new(2));
        const fresh: Res = Res::new(3);
        // `held`'s storage is emptied again and refilled: the take's value
        // is released by its new owner, the refill by `held`.
        const second: Res = take_and_refill(&held, fresh);
        if (taken.id + second.id + held.id != 6) {
            return expect_equal(taken.id + second.id + held.id, 6 as i64);
        }
    }
    return expect_equal(g_drops, 3 as i64);
}

![test]
function take_through_pointer_drops_once() -> Result<(), TestError> {
    g_drops = 0;
    if (true) {
        mut held: Res = Res::new(1);
        const taken: Res = take_and_refill(&held, Res::new(2));
        // `taken` owns the original, `held` owns the replacement: two live
        // values, so two drops at the end of this scope and not one more.
        const seen: i64 = taken.id;
        if (seen != 1) { return expect_equal(seen, 1 as i64); }
    }
    return expect_equal(g_drops, 2 as i64);
}

![test]
function swap_permutes_without_duplicating() -> Result<(), TestError> {
    g_drops = 0;
    if (true) {
        mut a: Res = Res::new(10);
        mut b: Res = Res::new(20);
        mem::swap::<Res>(&a, &b);
        if (a.id != 20) { return expect_equal(a.id, 20 as i64); }
        if (b.id != 10) { return expect_equal(b.id, 10 as i64); }
    }
    // Two values in, two values out: a duplicating swap would report four.
    return expect_equal(g_drops, 2 as i64);
}

// A pointer parameter is a BORROW: handing the same owning binding to one
// twice is not a move, so neither call may mark it moved. Deciding that from
// `autoref` classified every `T*` argument as a by-value transfer, because
// `autoref` is a codegen directive that only ever fires for `&T`.
function peek(p: Res*) -> i64 { return p.id; }

![test]
function pointer_parameter_is_a_borrow_not_a_move() -> Result<(), TestError> {
    g_drops = 0;
    if (true) {
        mut a: Res = Res::new(5);
        const first: i64 = peek(&a);
        const second: i64 = peek(&a);
        // Still live after both borrows, and still owned by this frame.
        const third: i64 = a.id;
        if (first + second + third != 15) {
            return expect_equal(first + second + third, 15 as i64);
        }
    }
    return expect_equal(g_drops, 1 as i64);
}

![test]
function borrowing_in_a_loop_is_not_loop_carried() -> Result<(), TestError> {
    g_drops = 0;
    if (true) {
        mut a: Res = Res::new(0);
        mut total: i64 = 0;
        for (mut i: i64 = 0; i < 3; i++) {
            // A move here would be loop-carried and a hard error; a borrow is
            // fine every iteration.
            total = total + peek(&a);
        }
        if (total != 0) { return expect_equal(total, 0 as i64); }
    }
    return expect_equal(g_drops, 1 as i64);
}
