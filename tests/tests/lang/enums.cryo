///! Enums — unit variants, payload variants, methods via `implement enum`,
///! and generic enums.

![config(testing)]
namespace CryoTests::Tests::Lang::Enums;

import std::core::result;
import std::test::error;
import std::test::assert;

// Unit-variant enum (C-style).
type enum Direction {
    North;
    South;
    East;
    West;
}

implement enum Direction {
    /// Returns the axis: 0 = vertical (N/S), 1 = horizontal (E/W).
    axis(&this) -> i32 {
        match (&this) {
            Direction::North => { return 0; }
            Direction::South => { return 0; }
            Direction::East  => { return 1; }
            Direction::West  => { return 1; }
        }
    }

    opposite(&this) -> Direction {
        match (&this) {
            Direction::North => { return Direction::South; }
            Direction::South => { return Direction::North; }
            Direction::East  => { return Direction::West;  }
            Direction::West  => { return Direction::East;  }
        }
    }
}

![test]
function unit_variant_axis_vertical() -> Result<(), TestError> {
    const d: Direction = Direction::North;
    match (expect_eq(d.axis(), 0)) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

![test]
function unit_variant_axis_horizontal() -> Result<(), TestError> {
    const d: Direction = Direction::East;
    match (expect_eq(d.axis(), 1)) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

![test]
function unit_variant_opposite_round_trip() -> Result<(), TestError> {
    const d: Direction = Direction::North;
    const opp: Direction = d.opposite();
    const back: Direction = opp.opposite();
    // Map back to a tag and compare via int.
    const back_tag: i32 = match (back) {
        Direction::North => { 0 }
        Direction::South => { 1 }
        Direction::East  => { 2 }
        Direction::West  => { 3 }
    };
    match (expect_eq(back_tag, 0)) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

// Payload-carrying enum (algebraic data type).
type enum Shape {
    Circle(i32);             // radius
    Rectangle(i32, i32);     // width, height
    Square(i32);
    Empty;
}

implement enum Shape {
    /// Compute area. Approximate circle area as 3 * r * r so the math
    /// stays integer-valued and asserts can compare exactly.
    area(&this) -> i32 {
        match (&this) {
            Shape::Circle(r)        => { return 3 * r * r; }
            Shape::Rectangle(w, h)  => { return w * h; }
            Shape::Square(s)        => { return s * s; }
            Shape::Empty            => { return 0; }
        }
    }
}

![test]
function payload_circle_area() -> Result<(), TestError> {
    const s: Shape = Shape::Circle(4);
    match (expect_eq(s.area(), 48)) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

![test]
function payload_rectangle_area() -> Result<(), TestError> {
    const s: Shape = Shape::Rectangle(5, 6);
    match (expect_eq(s.area(), 30)) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

![test]
function payload_square_area() -> Result<(), TestError> {
    const s: Shape = Shape::Square(7);
    match (expect_eq(s.area(), 49)) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

![test]
function payload_empty_area() -> Result<(), TestError> {
    const s: Shape = Shape::Empty;
    match (expect_eq(s.area(), 0)) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

// User-defined generic enum (parallel to stdlib's Option<T>).
type enum Maybe<T> {
    Just(T);
    Nothing;
}

implement enum Maybe<T> {
    is_just(&this) -> boolean {
        match (&this) {
            Maybe::Just(_)  => { return true;  }
            Maybe::Nothing  => { return false; }
        }
    }

    or_default(&this, default_value: T) -> T {
        match (&this) {
            Maybe::Just(value)  => { return value; }
            Maybe::Nothing      => { return default_value; }
        }
    }
}

![test]
function generic_enum_just() -> Result<(), TestError> {
    const m: Maybe<i32> = Maybe::Just(42);
    match (expect(m.is_just(),
        Str::new("Just should report is_just"))) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    match (expect_eq(m.or_default(0), 42)) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

![test]
function generic_enum_nothing() -> Result<(), TestError> {
    const m: Maybe<i32> = Maybe::Nothing;
    match (expect(!m.is_just(),
        Str::new("Nothing should not report is_just"))) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    match (expect_eq(m.or_default(99), 99)) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

![test]
function generic_enum_distinct_instantiations() -> Result<(), TestError> {
    // Maybe<i32> and Maybe<u64> are wholly independent monomorphizations.
    const a: Maybe<i32> = Maybe::Just(10);
    const b: Maybe<u64> = Maybe::Just(1000 as u64);
    match (expect_eq(a.or_default(-1), 10)) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    const default_u64: u64 = 0;
    match (expect_eq(b.or_default(default_u64), 1000 as u64)) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}
