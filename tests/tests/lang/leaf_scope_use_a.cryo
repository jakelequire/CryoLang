///! Regression: bare-leaf name resolution is IMPORT-SCOPED.
///!
///! This module imports only `LeafScopeDefnA`, so bare `Beacon` - both as a
///! type annotation and as the scope of the static call `Beacon::make()` - must
///! resolve to `LeafScopeDefnA::Beacon` (signal 100), even though a same-leaf
///! `LeafScopeDefnB::Beacon` (signal 200) exists in the same build.
///!
///! Before import-scoped resolution the static-call scope bound to the
///! last-registered same-leaf type via the context-free `resolve_qualified`
///! map, so `Beacon::make()` returned whichever `Beacon` registered last - 
///! yielding an `E0200` type mismatch against the (correctly import-resolved)
///! `Beacon` annotation.  `leaf_scope_use_b` is the mirror image: whichever
///! type won last-write-wins, exactly one of the two modules failed to compile.
///! Both pass only when the static-call scope resolves against THIS module's
///! imports.

![config(testing)]
namespace CryoTests::Tests::Lang::LeafScopeUseA;

import std::core::result;
import std::test::error;
import std::test::assert;

import CryoTests::Tests::Lang::LeafScopeDefnA;

![test]
function bare_beacon_resolves_to_imported_module_a() -> Result<(), TestError> {
    const b: Beacon = Beacon::make();
    return expect_eq(b.signal(), 100);
}
