///! Operators that the language exposes — bitwise, shifts, logical,
///! comparison, unary.
///!
///! `arithmetic.cryo` covers `+` `-` `*` `/` `%`.  This file rounds out
///! the rest: bit-level operators every parser/sema layer touches, the
///! short-circuit semantics of `&&` and `||`, and the comparison
///! operators (which feed every `if`, `while`, and `match` guard).
///!
///! Where a test depends on a specific bit pattern, it uses explicit
///! `0xNN`-style literals rather than chained arithmetic — the digits
///! are easier to verify against by eye when a regression bisects in.

![config(testing)]
namespace CryoTests::Tests::Lang::Operators;

import std::core::result;
import std::core::cmp;
import std::collections::str;
import std::test::error;
import std::test::assert;

// ============================================================================
// Bitwise AND / OR / XOR
// ============================================================================

![test]
function bitwise_and_masks_off_high_bits() -> Result<(), TestError> {
    const x: u32 = 0xDEADBEEF;
    const mask: u32 = 0x000000FF;
    const got: u32 = x & mask;
    return expect_eq(got, 0xEF as u32);
}

![test]
function bitwise_or_sets_bits() -> Result<(), TestError> {
    const x: u32 = 0x12000000;
    const y: u32 = 0x000034FF;
    const got: u32 = x | y;
    return expect_eq(got, 0x120034FF as u32);
}

![test]
function bitwise_xor_flips_overlapping_bits() -> Result<(), TestError> {
    const x: u32 = 0xFF00FF00;
    const y: u32 = 0x00FF00FF;
    const got: u32 = x ^ y;
    return expect_eq(got, 0xFFFFFFFF as u32);
}

![test]
function bitwise_xor_self_is_zero() -> Result<(), TestError> {
    const x: u64 = 0xCAFEBABE12345678;
    const got: u64 = x ^ x;
    return expect_eq(got, 0 as u64);
}

// ============================================================================
// Bitwise NOT (unary `~`)
// ============================================================================

![test]
function bitwise_not_inverts_zero_to_all_ones() -> Result<(), TestError> {
    const x: u32 = 0;
    const got: u32 = ~x;
    return expect_eq(got, 0xFFFFFFFF as u32);
}

![test]
function bitwise_not_inverts_all_ones_to_zero() -> Result<(), TestError> {
    const x: u32 = 0xFFFFFFFF;
    const got: u32 = ~x;
    return expect_eq(got, 0 as u32);
}

![test]
function bitwise_not_u64_high_bit() -> Result<(), TestError> {
    // ~0 on a u64 should produce u64::MAX (every bit set).
    const x: u64 = 0;
    const got: u64 = ~x;
    const want: u64 = 18446744073709551615;
    return expect_eq(got, want);
}

// ============================================================================
// Shifts
// ============================================================================

![test]
function shift_left_doubles_each_position() -> Result<(), TestError> {
    const x: u32 = 1;
    const got: u32 = x << 8;
    return expect_eq(got, 0x100 as u32);
}

![test]
function shift_right_halves_each_position() -> Result<(), TestError> {
    const x: u32 = 0x10000000;
    const got: u32 = x >> 16;
    return expect_eq(got, 0x1000 as u32);
}

![test]
function shift_combination_extracts_byte() -> Result<(), TestError> {
    // Classic byte-extract idiom: (x >> n) & 0xFF.
    const x: u32 = 0xDEADBEEF;
    const second_byte: u32 = (x >> 8) & 0xFF;
    return expect_eq(second_byte, 0xBE as u32);
}

![test]
function shift_left_u64_high_bit() -> Result<(), TestError> {
    // 1 << 63 — exactly i64::MAX + 1 — exercises the wide path.
    const one: u64 = 1;
    const got: u64 = one << 63;
    const want: u64 = 9223372036854775808;
    return expect_eq(got, want);
}

// ============================================================================
// Logical AND / OR — short-circuit semantics
// ============================================================================

mut g_side_effect_count: i32 = 0;

function bump_and_return(value: boolean) -> boolean {
    g_side_effect_count = g_side_effect_count + 1;
    return value;
}

![test]
function logical_and_short_circuits_when_lhs_false() -> Result<(), TestError> {
    // false && bump() — the RHS must not execute.  Counter stays 0.
    g_side_effect_count = 0;
    const _v: boolean = false && bump_and_return(true);
    return expect_eq(g_side_effect_count, 0);
}

![test]
function logical_and_evaluates_rhs_when_lhs_true() -> Result<(), TestError> {
    g_side_effect_count = 0;
    const _v: boolean = true && bump_and_return(true);
    return expect_eq(g_side_effect_count, 1);
}

![test]
function logical_or_short_circuits_when_lhs_true() -> Result<(), TestError> {
    g_side_effect_count = 0;
    const _v: boolean = true || bump_and_return(true);
    return expect_eq(g_side_effect_count, 0);
}

![test]
function logical_or_evaluates_rhs_when_lhs_false() -> Result<(), TestError> {
    g_side_effect_count = 0;
    const _v: boolean = false || bump_and_return(true);
    return expect_eq(g_side_effect_count, 1);
}

// ============================================================================
// Unary `!` — boolean negation
// ============================================================================

![test]
function not_true_is_false() -> Result<(), TestError> {
    const x: boolean = true;
    return expect_false(!x, Str::new("!true should be false"));
}

![test]
function not_false_is_true() -> Result<(), TestError> {
    const x: boolean = false;
    return expect_true(!x, Str::new("!false should be true"));
}

![test]
function double_not_returns_original() -> Result<(), TestError> {
    const a: boolean = true;
    const b: boolean = false;
    match (expect_true(!!a, Str::new("!!true should be true"))) {
        Result::Ok(_) => { } Result::Err(e) => { return Result::Err(e); }
    }
    return expect_false(!!b, Str::new("!!false should be false"));
}

// ============================================================================
// Comparison operators — full six-way
// ============================================================================

![test]
function comparison_lt_strict() -> Result<(), TestError> {
    match (expect_true(3 < 5, Str::new("3 < 5"))) {
        Result::Ok(_) => { } Result::Err(e) => { return Result::Err(e); }
    }
    return expect_false(5 < 5, Str::new("5 < 5 is strict"));
}

![test]
function comparison_le_inclusive() -> Result<(), TestError> {
    match (expect_true(3 <= 5, Str::new("3 <= 5"))) {
        Result::Ok(_) => { } Result::Err(e) => { return Result::Err(e); }
    }
    match (expect_true(5 <= 5, Str::new("5 <= 5"))) {
        Result::Ok(_) => { } Result::Err(e) => { return Result::Err(e); }
    }
    return expect_false(6 <= 5, Str::new("6 <= 5 is false"));
}

![test]
function comparison_gt_strict() -> Result<(), TestError> {
    match (expect_true(7 > 3, Str::new("7 > 3"))) {
        Result::Ok(_) => { } Result::Err(e) => { return Result::Err(e); }
    }
    return expect_false(3 > 3, Str::new("3 > 3 is strict"));
}

![test]
function comparison_ge_inclusive() -> Result<(), TestError> {
    match (expect_true(7 >= 3, Str::new("7 >= 3"))) {
        Result::Ok(_) => { } Result::Err(e) => { return Result::Err(e); }
    }
    return expect_true(3 >= 3, Str::new("3 >= 3"));
}

![test]
function comparison_eq_and_ne_complementary() -> Result<(), TestError> {
    match (expect_true(4 == 4, Str::new("4 == 4"))) {
        Result::Ok(_) => { } Result::Err(e) => { return Result::Err(e); }
    }
    match (expect_false(4 == 5, Str::new("4 == 5 should be false"))) {
        Result::Ok(_) => { } Result::Err(e) => { return Result::Err(e); }
    }
    match (expect_true(4 != 5, Str::new("4 != 5"))) {
        Result::Ok(_) => { } Result::Err(e) => { return Result::Err(e); }
    }
    return expect_false(4 != 4, Str::new("4 != 4 should be false"));
}

// ============================================================================
// Float casts — bridges between numeric domains
// ============================================================================

![test]
function cast_i32_to_f64_preserves_value() -> Result<(), TestError> {
    const x: i32 = 42;
    const f: f64 = x as f64;
    return expect_close_f64(f, 42.0, 0.0001);
}

![test]
function cast_negative_i32_to_f64_preserves_sign() -> Result<(), TestError> {
    const x: i32 = -7;
    const f: f64 = x as f64;
    return expect_close_f64(f, -7.0, 0.0001);
}

![test]
function cast_f64_to_i32_truncates_toward_zero() -> Result<(), TestError> {
    // Positive: 3.7 → 3 (toward zero).
    const x: f64 = 3.7;
    const i: i32 = x as i32;
    return expect_eq(i, 3);
}

![test]
function cast_negative_f64_to_i32_truncates_toward_zero() -> Result<(), TestError> {
    // Negative: -3.7 → -3 (toward zero, NOT toward minus infinity).
    const x: f64 = -3.7;
    const i: i32 = x as i32;
    return expect_eq(i, -3);
}

![test]
function cast_f64_round_trip_through_i64() -> Result<(), TestError> {
    const x: f64 = 1234.5;
    const i: i64 = x as i64;
    // 1234.5 → 1234 (truncate), back to 1234.0
    const back: f64 = i as f64;
    return expect_close_f64(back, 1234.0, 0.0001);
}

// ============================================================================
// Regression pins for fixed sema bugs
// ============================================================================

// Free function that takes an f64 and returns u64.  Lives at module scope
// so call sites read as `Operators::buf_writer(...)`.  Used by the
// regression below.
function buf_writer(_buf: u8*, _value: f64) -> u64 {
    return 7;
}

![test]
function const_init_from_call_with_f64_arg() -> Result<(), TestError> {
    // Regression: sema used to interpret `Operators::buf_writer(...)` as
    // a constructor call on the type `Operators` (or worse, on a
    // primitive-keyword alias like `float` resolving to `f64`), and
    // returned the receiver type as the call's type.  The const-init
    // path then complained `cannot initialize 'X' of type 'u64' with
    // value of type 'f64'`.  Fixed by gating the enum-variant fallback
    // in `try_resolve_type_or_variant` on TypeKind::Enum and letting
    // `try_resolve_module_function` run regardless of whether the scope
    // name also resolves to a type alias.
    mut b: u8[8];
    const n: u64 = Operators::buf_writer(&b[0], 3.14);
    return expect_eq(n, 7 as u64);
}

// ============================================================================
// Prefix / postfix `++` and `--`
// ============================================================================
//
// Both forms mutate the variable; the difference is what the expression
// evaluates to.  Pre-fix to round-3 audit, both forms returned the
// pre-update value because UnaryExprNode had no prefix/postfix
// discriminator — `const x: int = ++a;` bound x to a's old value.

![test]
function postfix_inc_returns_old_value() -> Result<(), TestError> {
    mut a: i32 = 5;
    const v: i32 = a++;
    match (expect_eq(a, 6)) { Result::Ok(_) => {} Result::Err(e) => { return Result::Err(e); } }
    return expect_eq(v, 5);
}

![test]
function prefix_inc_returns_new_value() -> Result<(), TestError> {
    mut a: i32 = 5;
    const v: i32 = ++a;
    match (expect_eq(a, 6)) { Result::Ok(_) => {} Result::Err(e) => { return Result::Err(e); } }
    return expect_eq(v, 6);
}

![test]
function postfix_dec_returns_old_value() -> Result<(), TestError> {
    mut a: i32 = 5;
    const v: i32 = a--;
    match (expect_eq(a, 4)) { Result::Ok(_) => {} Result::Err(e) => { return Result::Err(e); } }
    return expect_eq(v, 5);
}

![test]
function prefix_dec_returns_new_value() -> Result<(), TestError> {
    mut a: i32 = 5;
    const v: i32 = --a;
    match (expect_eq(a, 4)) { Result::Ok(_) => {} Result::Err(e) => { return Result::Err(e); } }
    return expect_eq(v, 4);
}

![test]
function inc_dec_in_for_loop_iterates_full_range() -> Result<(), TestError> {
    // `i++` in the for-loop step is the most common use site.  If it
    // ever regresses to "no-op" the loop hangs forever — pin it.
    mut sum: i32 = 0;
    for (mut i: i32 = 1; i <= 10; i++) {
        sum = sum + i;
    }
    return expect_eq(sum, 55);
}

// ============================================================================
// Unary `-` (negation)
// ============================================================================

![test]
function unary_minus_negates_positive_int() -> Result<(), TestError> {
    const x: i32 = 7;
    return expect_eq(-x, -7);
}

![test]
function unary_minus_negates_negative_int_back_to_positive() -> Result<(), TestError> {
    const x: i32 = -42;
    return expect_eq(-x, 42);
}

![test]
function unary_minus_on_zero_is_zero() -> Result<(), TestError> {
    const x: i32 = 0;
    return expect_eq(-x, 0);
}

![test]
function unary_minus_on_f64() -> Result<(), TestError> {
    const x: f64 = 3.5;
    return expect_close_f64(-x, -3.5, 0.0001);
}

![test]
function unary_minus_on_i64_large_magnitude() -> Result<(), TestError> {
    // 10^15 is well inside i64 range but outside i32 — pins the wider
    // path that codegen_unary takes when the source operand is i64.
    const x: i64 = 1000000000000000;
    const want: i64 = -1000000000000000;
    return expect_eq(-x, want);
}

// ============================================================================
// Conditional expressions — `if` as rvalue and C-style ternary
// ============================================================================

![test]
function if_expression_picks_then_branch() -> Result<(), TestError> {
    const x: i32 = if (true) { 100 } else { 200 };
    return expect_eq(x, 100);
}

![test]
function if_expression_picks_else_branch() -> Result<(), TestError> {
    const x: i32 = if (false) { 100 } else { 200 };
    return expect_eq(x, 200);
}

![test]
function nested_if_expression() -> Result<(), TestError> {
    const n: i32 = 0;
    const sign: i32 = if (n > 0) { 1 } else { if (n < 0) { -1 } else { 0 } };
    return expect_eq(sign, 0);
}

![test]
function ternary_picks_then_branch() -> Result<(), TestError> {
    const x: i32 = true ? 100 : 200;
    return expect_eq(x, 100);
}

![test]
function ternary_picks_else_branch() -> Result<(), TestError> {
    const x: i32 = false ? 100 : 200;
    return expect_eq(x, 200);
}

![test]
function ternary_nests_right_associative() -> Result<(), TestError> {
    // `a ? b : c ? d : e` parses as `a ? b : (c ? d : e)`.
    const n: i32 = -3;
    const sign: i32 = n > 0 ? 1 : n < 0 ? -1 : 0;
    return expect_eq(sign, -1);
}

mut g_ternary_side_effect: i32 = 0;

function ternary_bump_and_return(value: i32) -> i32 {
    g_ternary_side_effect = g_ternary_side_effect + 1;
    return value;
}

![test]
function ternary_evaluates_only_chosen_branch() -> Result<(), TestError> {
    g_ternary_side_effect = 0;
    const _x: i32 = true ? ternary_bump_and_return(1) : ternary_bump_and_return(2);
    return expect_eq(g_ternary_side_effect, 1);
}

// ============================================================================
// Operator precedence — bitwise vs shift vs comparison
// ============================================================================

![test]
function shift_binds_tighter_than_bitwise_or() -> Result<(), TestError> {
    // `1 << 4 | 1` parses as `(1 << 4) | 1` = 0x10 | 0x01 = 0x11.
    const got: u32 = 1 << 4 | 1;
    return expect_eq(got, 0x11 as u32);
}

![test]
function comparison_lower_precedence_than_arithmetic() -> Result<(), TestError> {
    // `2 + 3 < 6` parses as `(2 + 3) < 6` = 5 < 6 = true.  If
    // comparison bound tighter than `+`, we'd get `2 + (3 < 6)` which
    // wouldn't type-check.
    return expect_true(2 + 3 < 6, Str::new("2 + 3 < 6 should be true"));
}

// ============================================================================
// Three-way comparison `<=>`
// ============================================================================
//
// `a <=> b` desugars in the parser to `a.compare(&b)` — sugar for the
// `Ord` trait method — and yields an `Ordering`.  Collapsed to an i32
// here so the assertion helper can compare it.

function ord_to_int(o: Ordering) -> i32 {
    match (o) {
        Ordering::Less    => { return -1; }
        Ordering::Equal   => { return 0; }
        Ordering::Greater => { return 1; }
    }
}

![test]
function spaceship_less() -> Result<(), TestError> {
    const o: Ordering = 3 <=> 7;
    return expect_eq(ord_to_int(o), -1);
}

![test]
function spaceship_equal() -> Result<(), TestError> {
    const o: Ordering = 42 <=> 42;
    return expect_eq(ord_to_int(o), 0);
}

![test]
function spaceship_greater() -> Result<(), TestError> {
    const o: Ordering = 9 <=> 2;
    return expect_eq(ord_to_int(o), 1);
}

![test]
function spaceship_on_chars() -> Result<(), TestError> {
    const o: Ordering = 'a' <=> 'b';
    return expect_eq(ord_to_int(o), -1);
}

![test]
function spaceship_binds_tighter_than_equality() -> Result<(), TestError> {
    // `(1 <=> 2)` is `Ordering::Less`; pinning that `<=>` is its own
    // expression and doesn't get tangled with a neighbouring `==`.
    const o: Ordering = 1 <=> 2;
    match (o) {
        Ordering::Less    => { return Result::Ok(()); }
        Ordering::Equal   => { return bail(Str::new("1 <=> 2 should be Less")); }
        Ordering::Greater => { return bail(Str::new("1 <=> 2 should be Less")); }
    }
}

// ============================================================================
// Null-coalescing `??`
// ============================================================================
//
// `a ?? b` desugars to `match (a) { Option::Some(v) => { v }
// Option::None => { b } }` — `a` is evaluated exactly once (as the match
// scrutinee) and `b` only when `a` is `None`.

mut g_coalesce_lhs_evals: i32 = 0;
mut g_coalesce_rhs_evals: i32 = 0;

function coalesce_tracked_some() -> Option<i32> {
    g_coalesce_lhs_evals = g_coalesce_lhs_evals + 1;
    return Option::Some(7);
}

function coalesce_tracked_none() -> Option<i32> {
    g_coalesce_lhs_evals = g_coalesce_lhs_evals + 1;
    return Option::None;
}

function coalesce_tracked_default() -> i32 {
    g_coalesce_rhs_evals = g_coalesce_rhs_evals + 1;
    return -1;
}

![test]
function null_coalesce_some_yields_inner() -> Result<(), TestError> {
    const a: Option<i32> = Option::Some(42);
    return expect_eq(a ?? 0, 42);
}

![test]
function null_coalesce_none_yields_default() -> Result<(), TestError> {
    const a: Option<i32> = Option::None;
    return expect_eq(a ?? 99, 99);
}

![test]
function null_coalesce_evaluates_lhs_once() -> Result<(), TestError> {
    g_coalesce_lhs_evals = 0;
    g_coalesce_rhs_evals = 0;
    const v: i32 = coalesce_tracked_some() ?? coalesce_tracked_default();
    match (expect_eq(v, 7)) {
        Result::Ok(_) => { } Result::Err(e) => { return Result::Err(e); }
    }
    // LHS ran once, RHS not at all (Some short-circuits the default).
    match (expect_eq(g_coalesce_lhs_evals, 1)) {
        Result::Ok(_) => { } Result::Err(e) => { return Result::Err(e); }
    }
    return expect_eq(g_coalesce_rhs_evals, 0);
}

![test]
function null_coalesce_evaluates_rhs_only_on_none() -> Result<(), TestError> {
    g_coalesce_lhs_evals = 0;
    g_coalesce_rhs_evals = 0;
    const v: i32 = coalesce_tracked_none() ?? coalesce_tracked_default();
    match (expect_eq(v, -1)) {
        Result::Ok(_) => { } Result::Err(e) => { return Result::Err(e); }
    }
    match (expect_eq(g_coalesce_lhs_evals, 1)) {
        Result::Ok(_) => { } Result::Err(e) => { return Result::Err(e); }
    }
    return expect_eq(g_coalesce_rhs_evals, 1);
}

![test]
function null_coalesce_chains_right_associative() -> Result<(), TestError> {
    // `a ?? b ?? c` is `a ?? (b ?? c)`: each `??` is `Option<T> ?? T -> T`,
    // so only the rightmost operand is the bare fallback.
    const a: Option<i32> = Option::None;
    const b: Option<i32> = Option::None;
    match (expect_eq(a ?? b ?? 555, 555)) {
        Result::Ok(_) => { } Result::Err(e) => { return Result::Err(e); }
    }
    const c: Option<i32> = Option::None;
    const d: Option<i32> = Option::Some(13);
    return expect_eq(c ?? d ?? 555, 13);
}

// ============================================================================
// Pipe operators `|>` and `<|`
// ============================================================================
//
// `x |> f` desugars to `f(x)` (piped value prepended to f's args);
// `f <| x` desugars to `f(x)` (piped value appended).  Pure parser sugar.

function pipe_double(x: i32) -> i32 { return x * 2; }
function pipe_add(a: i32, b: i32) -> i32 { return a + b; }
function pipe_triple_sum(a: i32, b: i32, c: i32) -> i32 { return a + b + c; }

![test]
function pipe_forward_bare_callable() -> Result<(), TestError> {
    return expect_eq(5 |> pipe_double, 10);
}

![test]
function pipe_forward_prepends_to_call_args() -> Result<(), TestError> {
    // `7 |> pipe_add(100)` => `pipe_add(7, 100)`.
    return expect_eq(7 |> pipe_add(100), 107);
}

![test]
function pipe_forward_chains_left_associative() -> Result<(), TestError> {
    // `3 |> pipe_double |> pipe_double` => `pipe_double(pipe_double(3))`.
    return expect_eq(3 |> pipe_double |> pipe_double, 12);
}

![test]
function pipe_backward_bare_callable() -> Result<(), TestError> {
    return expect_eq(pipe_double <| 8, 16);
}

![test]
function pipe_backward_appends_to_call_args() -> Result<(), TestError> {
    // `pipe_add(100) <| 5` => `pipe_add(100, 5)`.
    return expect_eq(pipe_add(100) <| 5, 105);
}

![test]
function pipe_forward_into_multi_arg_call() -> Result<(), TestError> {
    // `10 |> pipe_triple_sum(20, 30)` => `pipe_triple_sum(10, 20, 30)`.
    return expect_eq(10 |> pipe_triple_sum(20, 30), 60);
}
