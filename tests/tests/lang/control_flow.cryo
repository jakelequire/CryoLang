///! Control-flow tests - if/else, match, while, for, loop, break, continue.

![config(testing)]
namespace CryoTests::Tests::Lang::ControlFlow;

import std::core::result;
import std::test::error;
import std::test::assert;

![test]
function if_else_branches() -> Result<(), TestError> {
    const x: i32 = 5;
    const got: i32 = if (x > 0) { 1 } else { -1 };
    match (expect_eq(got, 1)) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

![test]
function if_else_else_branch() -> Result<(), TestError> {
    const x: i32 = -3;
    const got: i32 = if (x > 0) { 1 } else { -1 };
    match (expect_eq(got, -1)) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

![test]
function if_else_zero_branch() -> Result<(), TestError> {
    // Sign of zero through nested if-else expressions.
    const x: i32 = 0;
    const got: i32 = if (x > 0) {
        1
    } else {
        if (x < 0) { -1 } else { 0 }
    };
    match (expect_eq(got, 0)) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

![test]
function while_counts_to_ten() -> Result<(), TestError> {
    mut count: i32 = 0;
    mut i: i32 = 0;
    while (i < 10) {
        count = count + 1;
        i = i + 1;
    }
    match (expect_eq(count, 10)) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

![test]
function while_break_exits_early() -> Result<(), TestError> {
    mut i: i32 = 0;
    while (i < 100) {
        if (i == 5) { break; }
        i = i + 1;
    }
    match (expect_eq(i, 5)) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

![test]
function while_continue_skips_body() -> Result<(), TestError> {
    mut sum: i32 = 0;
    mut i: i32 = 0;
    while (i < 10) {
        i = i + 1;
        if (i % 2 == 0) { continue; }
        sum = sum + i;
    }
    // 1 + 3 + 5 + 7 + 9 = 25
    match (expect_eq(sum, 25)) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

![test]
function for_loop_sums() -> Result<(), TestError> {
    mut sum: i32 = 0;
    for (mut i: i32 = 1; i <= 10; i++) {
        sum = sum + i;
    }
    // 1+2+...+10 = 55
    match (expect_eq(sum, 55)) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

![test]
function loop_with_break() -> Result<(), TestError> {
    mut i: i32 = 0;
    loop {
        if (i >= 7) { break; }
        i = i + 1;
    }
    match (expect_eq(i, 7)) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

![test]
function nested_loops_break_inner() -> Result<(), TestError> {
    mut total: i32 = 0;
    mut i: i32 = 0;
    while (i < 3) {
        mut j: i32 = 0;
        while (j < 5) {
            if (j == 2) { break; }
            total = total + 1;
            j = j + 1;
        }
        i = i + 1;
    }
    // 3 outer * 2 inner = 6
    match (expect_eq(total, 6)) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

// Integer-literal match-arm patterns currently fall through to the
// wildcard arm (sema/codegen quirk - separate from this test suite's
// scope).  The default-arm test still runs because reaching the
// wildcard arm IS the expected behaviour for unmatched values.

![test]
![ignore]
function match_on_int() -> Result<(), TestError> {
    const x: i32 = 2;
    const label: i32 = match (x) {
        1 => { 100 }
        2 => { 200 }
        3 => { 300 }
        _ => { -1 }
    };
    match (expect_eq(label, 200)) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

![test]
function match_default_arm() -> Result<(), TestError> {
    const x: i32 = 99;
    const label: i32 = match (x) {
        1 => { 1 }
        2 => { 2 }
        _ => { -1 }
    };
    match (expect_eq(label, -1)) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

// ---------------------------------------------------------------------------
// do { } while - the body runs at least once, then the condition is tested.
// ---------------------------------------------------------------------------

![test]
function do_while_runs_body_once() -> Result<(), TestError> {
    // Condition is false from the start, yet the body must run exactly once.
    mut ran: i32 = 0;
    do {
        ran = ran + 1;
    } while (ran < 0);
    return expect_eq(ran, 1);
}

![test]
function do_while_loops_while_true() -> Result<(), TestError> {
    mut sum: i32 = 0;
    mut i: i32 = 1;
    do {
        sum = sum + i;
        i = i + 1;
    } while (i <= 5);
    return expect_eq(sum, 15);
}

![test]
function do_while_break_exits() -> Result<(), TestError> {
    mut k: i32 = 0;
    do {
        k = k + 1;
        if (k == 3) { break; }
    } while (k < 100);
    return expect_eq(k, 3);
}

![test]
function do_while_continue_retests_condition() -> Result<(), TestError> {
    // `continue` jumps to the condition test; odd values are summed.
    mut acc: i32 = 0;
    mut j: i32 = 0;
    do {
        j = j + 1;
        if (j % 2 == 0) { continue; }
        acc = acc + j;
    } while (j < 6);
    return expect_eq(acc, 9);   // 1 + 3 + 5
}

// ---------------------------------------------------------------------------
// switch / case - integer + enum dispatch, no implicit fallthrough.
// ---------------------------------------------------------------------------

type enum Suit { Hearts; Spades; Clubs; Diamonds; }

function switch_classify(n: i32) -> i32 {
    mut out: i32 = -1;
    switch (n) {
        case 1: { out = 10; }
        case 2: { out = 20; }
        case 3: { out = 30; }
        default: { out = 99; }
    }
    return out;
}

![test]
function switch_int_cases_and_default() -> Result<(), TestError> {
    expect_eq(switch_classify(1), 10)?;
    expect_eq(switch_classify(2), 20)?;
    expect_eq(switch_classify(3), 30)?;
    return expect_eq(switch_classify(42), 99);   // default
}

// All cases return; with a `default` this is a complete function body (the
// control-flow checker must accept it without a trailing `return`).
function suit_rank(s: Suit) -> i32 {
    switch (s) {
        case Suit::Hearts:   { return 1; }
        case Suit::Spades:   { return 2; }
        case Suit::Clubs:    { return 3; }
        default:             { return 4; }
    }
}

![test]
function switch_on_enum() -> Result<(), TestError> {
    expect_eq(suit_rank(Suit::Hearts), 1)?;
    expect_eq(suit_rank(Suit::Clubs), 3)?;
    return expect_eq(suit_rank(Suit::Diamonds), 4);   // default
}

![test]
function switch_no_fallthrough() -> Result<(), TestError> {
    // Matching case 1 must NOT run case 2's body.
    mut hits: i32 = 0;
    switch (1) {
        case 1: { hits = hits + 1; }
        case 2: { hits = hits + 100; }
        default: { hits = hits + 1000; }
    }
    return expect_eq(hits, 1);
}

![test]
function switch_no_match_no_default() -> Result<(), TestError> {
    // No case matches and there is no default: nothing runs.
    mut hits: i32 = 0;
    switch (7) {
        case 1: { hits = 1; }
        case 2: { hits = 2; }
    }
    return expect_eq(hits, 0);
}

![test]
function switch_break_and_loop_continue() -> Result<(), TestError> {
    // `break` exits the switch only; `continue` is forwarded to the for loop.
    mut total: i32 = 0;
    for (mut x: i32 = 0; x < 5; x++) {
        switch (x) {
            case 2: { continue; }   // continue the for loop (skips the +100)
            case 4: { break; }      // break leaves the switch, not the loop
            default: { total = total + x; }
        }
        total = total + 100;
    }
    // x=0: +0,+100=100; x=1: +1,+100=201; x=2: continue→201;
    // x=3: +3,+100=304; x=4: break switch then +100=404.
    return expect_eq(total, 404);
}
