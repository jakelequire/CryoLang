///! `![sink]` - method-level attribute that marks a method as
///! consuming its receiver, regardless of receiver syntax.  Tells the
///! move-check + drop-insertion analyzers to treat the call site as a
///! move of the receiver, the same way `mut this` / `this` already do.
///!
///! Move-check is warn-only today, so we can't assert "this fails to
///! compile" from inside the runner.  These tests pin the compile +
///! runtime contract: marked methods on every receiver flavor (`&this`,
///! `mut &this`, `mut this`) parse, validate, and execute.  Move-check
///! coverage of the `![sink]` path is exercised every build -
///! a regression that broke consume-tracking would surface as a behavior
///! change in tests/tests/stdlib/box.cryo (Box::into_raw consumes via
///! `mut this`, the same plumbing path).

![config(testing)]
namespace CryoTests::Tests::Lang::Sink;

import std::core::result;
import std::collections::str;
import std::test::error;
import std::test::assert;

// A small Copy-able receipt - exercises the directive on a value type
// that doesn't need an explicit drop (so we can call a consumes-self
// method without bringing a Drop implementation along).
type struct Receipt {
    amount: i32;

    static new(amount: i32) -> Receipt {
        return Receipt { amount: amount };
    }

    /// Borrow-shaped call ergonomics, consume-shaped semantics.
    ![sink]
    cash(&this) -> i32 {
        return this.amount;
    }
}

// Same trick on `mut &this` - the receiver is a mutable borrow but the
// directive promotes it to a consume.
type struct Token {
    kind: i32;

    static new(kind: i32) -> Token {
        return Token { kind: kind };
    }

    ![sink]
    redeem(mut &this) -> i32 {
        const k: i32 = this.kind;
        this.kind = 0;
        return k;
    }
}

// `mut this` - the directive is redundant here (the receiver is already
// by-value), but it should still compile cleanly and not double-mark.
type struct Counter {
    n: i32;

    static new(n: i32) -> Counter {
        return Counter { n: n };
    }

    ![sink]
    take(mut this) -> i32 {
        return this.n;
    }
}

![test]
function sink_on_immutable_borrow_runs() -> Result<(), TestError> {
    const r: Receipt = Receipt::new(42);
    const got: i32 = r.cash();
    match (expect_eq(got, 42)) {
        Result::Ok(_) => { } Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

![test]
function sink_on_mutable_borrow_runs() -> Result<(), TestError> {
    mut t: Token = Token::new(7);
    const got: i32 = t.redeem();
    match (expect_eq(got, 7)) {
        Result::Ok(_) => { } Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

![test]
function sink_on_value_receiver_runs() -> Result<(), TestError> {
    const c: Counter = Counter::new(99);
    const got: i32 = c.take();
    match (expect_eq(got, 99)) {
        Result::Ok(_) => { } Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

![test]
function ordinary_borrow_method_still_works() -> Result<(), TestError> {
    // Sanity: a non-marked `&this` method is unaffected by the new
    // path - neither receiver flavor classification nor double-consume
    // detection should disturb it.  Calling the same method twice is
    // fine on a borrow.
    const r: Receipt = Receipt::new(3);
    const a: i32 = r.amount;
    const b: i32 = r.amount;
    match (expect_eq(a + b, 6)) {
        Result::Ok(_) => { } Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}
