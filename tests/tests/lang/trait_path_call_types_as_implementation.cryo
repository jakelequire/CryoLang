// A call through a trait's path, `Trait::method(&receiver)`, has the
// selected implementation's return type.  The trait declaration's return
// names `This` or `This::Out`, which stand for no type at the call site:
// `Dup::dup(&r)` on a `Pt` is a `Pt`, and `Peek::peek(&r)` is the
// `Option<i32>` that `Pt`'s implementation returns.  The call site is walked
// more than once, and every walk has to give it the same type.
![config(testing)]
namespace CryoTests::Tests::Lang::TraitPathCallTypesAsImplementation;

import std::test;
import std::core::result;
import std::core::result::{ Result };
import std::core::option;
import std::core::option::{ Option };
import std::test::assert::{ expect_eq };
import std::test::error::{ TestError };

type struct Pt {
    n: i32;
}

type trait Dup {
    dup(&this) -> This;
}

type trait Peek {
    type Out;
    peek(&this) -> Option<This::Out>;
}

implement trait Dup for struct Pt {
    dup(&this) -> Pt { return Pt { n: this.n + 100 }; }
}

implement trait Peek for struct Pt {
    type Out = i32;
    peek(&this) -> Option<i32> { return Option::Some(this.n + 7); }
}

![test]
function this_return_is_the_receiver_type() -> Result<(), TestError> {
    const r: Pt = Pt { n: 1 };
    const d: Pt = Dup::dup(&r);
    return expect_eq(d.n + 1, 102);
}

![test]
function projection_return_is_the_implementation_type() -> Result<(), TestError> {
    const r: Pt = Pt { n: 1 };
    mut t: i32 = 0;
    match (Peek::peek(&r)) {
        Option::Some(v) => { t = t + v; }
        Option::None => { }
    }
    return expect_eq(t, 8);
}
