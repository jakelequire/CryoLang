///! A reference to a slice is the slice's own two words, its address and its
///! length, rather than the address of a slice: it is passed, returned,
///! stored and read as those two words, and a slice given where one is
///! expected is passed as itself.  Each way a slice reference is made, read
///! and handed on is checked against the elements it views.

![config(testing)]
namespace CryoTests::Tests::Lang::SliceReferenceTwoWords;

import std::core::result::{ Result };
import std::core::slice::{ Slice };
import std::collections::str::{ Str };
import std::test::error::{ TestError };
import std::test::assert::{ expect_eq, expect_true };

type struct View {
    tag: i64;
    items: &Slice<i32>;
}

type trait Measure {
    size(&this) -> i64;
}

implement trait Measure for struct Slice<i32> {
    size(&this) -> i64 { return this.length() * 10 + this.as_const_ptr()[0] as i64; }
}

function measured<T>(item: &T) -> i64 where T: Measure {
    return item.size();
}

function total(items: &Slice<i32>) -> i64 {
    mut sum: i64 = 0;
    for (mut i: i64 = 0; i < items.length(); i++) {
        sum += items[i] as i64;
    }
    return sum;
}

function pass_on(items: &Slice<i32>) -> &Slice<i32> {
    return items;
}

function double_each(items: mut &Slice<i32>) -> void {
    for (mut i: i64 = 0; i < items.length(); i++) {
        items[i] = items[i] * 2;
    }
}

![test]
function slice_reference_is_two_words() -> Result<(), TestError> {
    expect_eq(sizeof(&Slice<i32>) as i64, 16)?;
    expect_eq(sizeof(mut &Slice<u8>) as i64, 16)?;
    return expect_eq(sizeof(View) as i64, 24);
}

![test]
function borrowed_slice_reaches_the_callee() -> Result<(), TestError> {
    const values: [i32; 4] = [1, 2, 3, 4];
    const s: Slice<i32> = Slice::<i32>::from_raw(&values[0], 4);
    return expect_eq(total(&s), 10);
}

![test]
function slice_given_for_a_slice_reference_is_passed_as_itself() -> Result<(), TestError> {
    const values: [i32; 3] = [5, 6, 7];
    const s: Slice<i32> = Slice::<i32>::from_raw(&values[0], 3);
    return expect_eq(total(s), 18);
}

![test]
function slice_reference_returned_views_the_same_elements() -> Result<(), TestError> {
    const values: [i32; 3] = [9, 8, 7];
    const s: Slice<i32> = Slice::<i32>::from_raw(&values[0], 3);
    const back: &Slice<i32> = pass_on(&s);
    expect_eq(back.length(), 3)?;
    expect_eq(back[0] as i64, 9)?;
    return expect_eq(total(pass_on(back)), 24);
}

![test]
function slice_reference_read_through_a_field() -> Result<(), TestError> {
    const values: [i32; 2] = [20, 22];
    const s: Slice<i32> = Slice::<i32>::from_raw(&values[0], 2);
    const view: View = View { tag: 3, items: &s };
    expect_eq(view.tag, 3)?;
    expect_eq(view.items.length(), 2)?;
    return expect_eq(total(view.items), 42);
}

![test]
function dereferenced_slice_reference_is_the_slice() -> Result<(), TestError> {
    const values: [i32; 3] = [1, 1, 2];
    const s: Slice<i32> = Slice::<i32>::from_raw(&values[0], 3);
    const r: &Slice<i32> = &s;
    const copy: Slice<i32> = *r;
    expect_eq(copy.length(), 3)?;
    return expect_true(copy.equals(r), Str::new("the copy equals the slice it was read from"));
}

/// A method with a `&this` receiver on a slice receives the slice's two
/// words, from a slice, a slice reference, a call's result and a generic
/// body alike.
![test]
function slice_receiver_takes_the_two_words() -> Result<(), TestError> {
    const values: [i32; 3] = [7, 8, 9];
    const s: Slice<i32> = Slice::<i32>::from_raw(&values[0], 3);
    const r: &Slice<i32> = &s;
    expect_eq(s.size(), 37)?;
    expect_eq(r.size(), 37)?;
    expect_eq(pass_on(r).size(), 37)?;
    return expect_eq(measured(&s), 37);
}

![test]
function writable_slice_reference_writes_the_elements() -> Result<(), TestError> {
    mut values: [i32; 3] = [1, 2, 3];
    mut s: Slice<i32> = Slice::<i32>::from_raw(&values[0], 3);
    double_each(&s);
    expect_eq(values[0] as i64, 2)?;
    return expect_eq(values[2] as i64, 6);
}
