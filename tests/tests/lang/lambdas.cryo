///! Lambda expressions: `(params) -> Ret { body }` (or `(params) -> Ret expr`).
///! Lambdas are non-capturing function literals — they compile to anonymous
///! functions and evaluate to a function pointer assignable to a matching
///! `(T, ...) -> R` type. They can be bound to a local, called directly, and
///! passed as a function-pointer argument.
///!
///! Note on generic higher-order methods: inferring a method's own type
///! parameter from a function argument's return type is a separate, pre-
///! existing limitation (it affects named functions identically), so generic
///! combinators like `Option::map<U>` need the type argument written out —
///! `opt.map<i32>(lambda)`. See `lambda_with_explicit_generic_map` below.

![config(testing)]
namespace CryoTests::Tests::Lang::Lambdas;

import std::core::result;
import std::core::option;
import std::test::error;
import std::test::assert;

function apply(f: (i32) -> i32, x: i32) -> i32 {
    return f(x);
}

function apply2(f: (i32, i32) -> i32, a: i32, b: i32) -> i32 {
    return f(a, b);
}

function twice(f: (i32) -> i32, x: i32) -> i32 {
    return f(f(x));
}

![test]
function lambda_assign_and_call() -> Result<(), TestError> {
    const dbl: (i32) -> i32 = (n: i32) -> i32 { return n * 2; };
    return expect_eq(dbl(21), 42);
}

![test]
function lambda_inline_argument() -> Result<(), TestError> {
    return expect_eq(apply((n: i32) -> i32 { return n + 1; }, 41), 42);
}

![test]
function lambda_passed_as_named_local() -> Result<(), TestError> {
    const dbl: (i32) -> i32 = (n: i32) -> i32 { return n * 2; };
    return expect_eq(twice(dbl, 3), 12);
}

![test]
function lambda_multi_statement_body() -> Result<(), TestError> {
    const sq: (i32) -> i32 = (n: i32) -> i32 {
        const r: i32 = n * n;
        return r;
    };
    return expect_eq(sq(9), 81);
}

![test]
function lambda_two_params() -> Result<(), TestError> {
    return expect_eq(apply2((a: i32, b: i32) -> i32 { return a + b; }, 20, 22), 42);
}

![test]
function lambda_zero_params_unwrap_or_else() -> Result<(), TestError> {
    const none: Option<i32> = Option::None;
    return expect_eq(none.unwrap_or_else(() -> i32 { return 77; }), 77);
}

![test]
function lambda_with_explicit_generic_map() -> Result<(), TestError> {
    const some: Option<i32> = Option::Some(5);
    const mapped: Option<i32> = some.map<i32>((n: i32) -> i32 { return n * 10; });
    return expect_eq(mapped.unwrap_or(0), 50);
}
