///! Lambda expressions: `(params) -> Ret { body }` (or `(params) -> Ret expr`).
///! Lambdas are non-capturing function literals — they compile to anonymous
///! functions and evaluate to a function pointer assignable to a matching
///! `(T, ...) -> R` type. They can be bound to a local, called directly, and
///! passed as a function-pointer argument.
///!
///! Generic higher-order inference: a generic type parameter that appears
///! ONLY in the return position of a function-typed argument (`(T) -> U`) is
///! inferred from the callback, so generic combinators like `Option::map<U>`
///! work without an explicit type argument — `opt.map(lambda)` and
///! `opt.map(named_fn)` both infer `U`. Named functions and lambdas behave
///! identically here (it was never a lambda-only limitation). The explicit
///! form still works (`opt.map<i32>(lambda)`); see
///! `lambda_with_explicit_generic_map` below.

![config(testing)]
namespace CryoTests::Tests::Lang::Lambdas;

import std::core::result;
import std::core::option;
import std::test::error;
import std::test::assert;

function apply(f: (i32) -> i32, x: i32) -> i32 {
    return f(x);
}

function apply2(f: (i32, i32) -> i32, a: i32, b: i32) -> i32 {
    return f(a, b);
}

function twice(f: (i32) -> i32, x: i32) -> i32 {
    return f(f(x));
}

// Named functions usable as function-typed arguments below.
function tentimes(n: i32) -> i32 { return n * 10; }
function add2(a: i32, b: i32) -> i32 { return a + b; }

// Free generic combinators whose own type parameter `U` appears ONLY in the
// return position of the function-typed argument — the case that previously
// required an explicit `<U>`.  `U` is now inferred from the callback's return
// type for both named-function and lambda arguments.
function applymap<U>(f: (i32) -> U, x: i32) -> U {
    return f(x);
}

function combine<U>(f: (i32, i32) -> U, a: i32, b: i32) -> U {
    return f(a, b);
}

![test]
function lambda_assign_and_call() -> Result<(), TestError> {
    const dbl: (i32) -> i32 = (n: i32) -> i32 { return n * 2; };
    return expect_eq(dbl(21), 42);
}

// Untyped-binding form: `const f = lambda;` lets the binding adopt the
// lambda's own signature, sparing the user from spelling the redundant
// `(Args) -> Ret` annotation on both sides of the `=`.  Allowed only
// when the initializer is a lambda expression - any other shape still
// requires `: T`.
![test]
function lambda_untyped_binding_inference() -> Result<(), TestError> {
    const dbl = (n: i32) -> i32 { return n * 2; };
    return expect_eq(dbl(21), 42);
}

// Capturing closures: a lambda that references an outer-scope Copy
// binding (here `bias: i32`) compiles to a synthesised closure struct
// whose `__call__` method receives the captures via `this`.  The
// lambda expression materialises the struct in-place; the call site
// dispatches through the struct's `__call__` method.
![test]
function lambda_captures_single_copy() -> Result<(), TestError> {
    const bias: i32 = 10;
    const add_bias = (x: i32) -> i32 { return x + bias; };
    return expect_eq(add_bias(32), 42);
}

// Multiple Copy captures of mixed primitive types - each becomes a
// separate field on the synthesised closure struct.
![test]
function lambda_captures_multiple_copy() -> Result<(), TestError> {
    const a: i32 = 7;
    const b: i32 = 5;
    const sign: boolean = true;
    const combine = (x: i32) -> i32 {
        return if (sign) { x + a + b } else { x - a - b };
    };
    return expect_eq(combine(30), 42);
}

// Calling the same closure multiple times: the closure value is the
// struct instance; each call re-reads the captured fields.
![test]
function lambda_capture_invoked_repeatedly() -> Result<(), TestError> {
    const step: i32 = 3;
    const inc = (x: i32) -> i32 { return x + step; };
    return expect_eq(inc(inc(inc(33))), 42);
}

// Nested lambdas: an inner lambda captures both its outer lambda's
// param AND the enclosing function's local.  The outer lambda
// transitively captures `base` too so its `__call__` body can supply
// the value when constructing the inner closure struct.
![test]
function lambda_capture_nested() -> Result<(), TestError> {
    const base: i32 = 30;
    const make_adder = (offset: i32) -> i32 {
        const adder = (x: i32) -> i32 { return x + base + offset; };
        return adder(7);
    };
    return expect_eq(make_adder(5), 42);
}

// Phase 5: pass a capturing closure to a `(Args) -> Ret`-typed parameter.
// Sema synthesises a specialised clone of the receiver function whose
// fn-typed parameter is re-typed as the closure-struct, so the body's
// `f(x)` dispatches through `__call__` instead of an indirect fn-pointer
// call.  Zero-cost direct method dispatch; the LLVM optimiser folds
// through it.
![test]
function lambda_closure_passed_as_fn_arg() -> Result<(), TestError> {
    const bias: i32 = 10;
    return expect_eq(apply((x: i32) -> i32 { return x + bias; }, 32), 42);
}

// Same `apply` accepts a named function too: the closure-arg
// specialisation only fires when the arg actually IS a closure-struct,
// so this call site falls through to the unchanged fn-pointer path.
![test]
function lambda_named_fn_still_works_after_closure_spec() -> Result<(), TestError> {
    return expect_eq(apply(tentimes, 4), 40);
}

// Closure with two captures passed to a fn-typed parameter.  The
// specialisation substitutes the lone fn-typed param with the
// closure-struct's TypeRef and routes through __call__, which sees
// both captures via `this`.
![test]
function lambda_multi_capture_closure_as_fn_arg() -> Result<(), TestError> {
    const a: i32 = 7;
    const b: i32 = 5;
    return expect_eq(apply((x: i32) -> i32 { return x + a + b; }, 30), 42);
}

// Two call sites of the same receiver with closures of DIFFERENT
// closure-struct types: each gets its own spec'd clone (different
// captures = different closure structs = different specialisations).
![test]
function lambda_two_distinct_closures_through_same_fn() -> Result<(), TestError> {
    const base: i32 = 30;
    const r1: i32 = apply((x: i32) -> i32 { return x + base; }, 2);
    const step: i32 = 5;
    const r2: i32 = apply((x: i32) -> i32 { return x * step; }, 2);
    return expect_eq(r1 + r2, 42);
}

// Multi-parameter fn-typed slot: substitute the (i32, i32) -> i32 slot
// with a capturing closure-struct.  Exercises the multi-arg arity of
// the cloned param's `__call__` method.
![test]
function lambda_multi_arg_closure_as_fn_arg() -> Result<(), TestError> {
    const bias: i32 = 2;
    return expect_eq(apply2((p: i32, q: i32) -> i32 { return p + q + bias; }, 20, 20), 42);
}

// Phase 6: closure construction inside a conditional branch.  Each
// branch produces its OWN closure-struct value (different __Closure_N
// types because the bodies differ), so move-check / drop-insertion must
// see them as separate Copy values without synthesising spurious drops.
![test]
function lambda_closure_in_if_branches() -> Result<(), TestError> {
    const offset: i32 = 10;
    const use_add: boolean = true;
    mut r: i32 = 0;
    if (use_add) {
        const f = (x: i32) -> i32 { return x + offset; };
        r = f(32);
    } else {
        const f = (x: i32) -> i32 { return x - offset; };
        r = f(52);
    }
    return expect_eq(r, 42);
}

// Phase 6: closure constructed inline and immediately consumed by a
// fn-arg call - no named binding, no scope-exit drop needed.  Two
// inline closures back-to-back, both captures from the same outer.
![test]
function lambda_inline_closure_consumed_by_call() -> Result<(), TestError> {
    const k: i32 = 6;
    const a: i32 = apply((x: i32) -> i32 { return x * k; }, 4);
    const b: i32 = apply((x: i32) -> i32 { return x + k; }, 12);
    return expect_eq(a + b, 42);
}


![test]
function lambda_inline_argument() -> Result<(), TestError> {
    return expect_eq(apply((n: i32) -> i32 { return n + 1; }, 41), 42);
}

![test]
function lambda_passed_as_named_local() -> Result<(), TestError> {
    const dbl: (i32) -> i32 = (n: i32) -> i32 { return n * 2; };
    return expect_eq(twice(dbl, 3), 12);
}

![test]
function lambda_multi_statement_body() -> Result<(), TestError> {
    const sq: (i32) -> i32 = (n: i32) -> i32 {
        const r: i32 = n * n;
        return r;
    };
    return expect_eq(sq(9), 81);
}

![test]
function lambda_two_params() -> Result<(), TestError> {
    return expect_eq(apply2((a: i32, b: i32) -> i32 { return a + b; }, 20, 22), 42);
}

![test]
function lambda_zero_params_unwrap_or_else() -> Result<(), TestError> {
    const none: Option<i32> = Option::None;
    return expect_eq(none.unwrap_or_else(() -> i32 { return 77; }), 77);
}

![test]
function lambda_with_explicit_generic_map() -> Result<(), TestError> {
    const some: Option<i32> = Option::Some(5);
    const mapped: Option<i32> = some.map<i32>((n: i32) -> i32 { return n * 10; });
    return expect_eq(mapped.unwrap_or(0), 50);
}

// --- Generic inference from a function-typed argument (no explicit `<U>`) ---

// Method combinator `Option::map<U>` with `U` inferred from a NAMED function.
![test]
function map_infers_generic_from_named_fn() -> Result<(), TestError> {
    const some: Option<i32> = Option::Some(5);
    const mapped: Option<i32> = some.map(tentimes);
    return expect_eq(mapped.unwrap_or(0), 50);
}

// Same method combinator with `U` inferred from a LAMBDA (no explicit `<U>`).
![test]
function map_infers_generic_from_lambda() -> Result<(), TestError> {
    const some: Option<i32> = Option::Some(5);
    const mapped: Option<i32> = some.map((n: i32) -> i32 { return n * 10; });
    return expect_eq(mapped.unwrap_or(0), 50);
}

// Free-function combinator: `U` inferred from a named-function argument.
![test]
function free_fn_infers_generic_from_named_fn() -> Result<(), TestError> {
    return expect_eq(applymap(tentimes, 5), 50);
}

// Free-function combinator: `U` inferred from a lambda argument.
![test]
function free_fn_infers_generic_from_lambda() -> Result<(), TestError> {
    return expect_eq(applymap((n: i32) -> i32 { return n + 1; }, 41), 42);
}

// Multi-parameter function-typed argument: arity-2 callback, `U` inferred.
![test]
function infer_generic_from_multi_param_fn_arg() -> Result<(), TestError> {
    const from_named: i32 = combine(add2, 20, 22);
    const from_lambda: i32 = combine((p: i32, q: i32) -> i32 { return p * q; }, 6, 7);
    return expect_eq(from_named + from_lambda, 84);
}
