///! Float literal codegen - digit-separator (`_`) handling.
///!
///! Pinning the codegen contract for `LiteralKind::Float`: the lexer
///! accepts `_` digit separators in the integer part, fraction, and
///! exponent of a float literal (e.g. `1_000.5`, `1_0e1_0`), but the
///! value was parsed from the raw lexeme via `sscanf("%lf", ...)`, which
///! STOPS at the first `_`. So `1_000.5` silently compiled to `1.0` - a
///! wrong value with no diagnostic. (Integer literals were unaffected
///! because they strip via `int_literal_clean`.)
///!
///! The fix adds `CodegenUtil::float_literal_clean`, which strips `_`
///! before `sscanf`, mirroring the integer path. These tests would all
///! fail (parsing to a truncated prefix) under the old codegen.

![config(testing)]
namespace CryoTests::Tests::Lang::FloatLiterals;

import std::core::result;
import std::test::error;
import std::test::assert;

![test]
function thousands_separator_integer_part() -> Result<(), TestError> {
    // Old bug: sscanf stopped at the `_`, yielding 1.0.
    const x: f64 = 1_000.5;
    return expect_close_f64(x, 1000.5, 0.0000001);
}

![test]
function multiple_separators_integer_part() -> Result<(), TestError> {
    const x: f64 = 1_234_567.89;
    return expect_close_f64(x, 1234567.89, 0.001);
}

![test]
function separator_in_fraction() -> Result<(), TestError> {
    const x: f64 = 3.1_4159;
    return expect_close_f64(x, 3.14159, 0.0000001);
}

![test]
function separator_in_exponent() -> Result<(), TestError> {
    // 1_0.0e1_0 == 10.0e10 == 1e11.
    const x: f64 = 1_0.0e1_0;
    return expect_close_f64(x, 100000000000.0, 1.0);
}

![test]
function no_separator_unaffected() -> Result<(), TestError> {
    // Regression guard: plain floats must still parse correctly.
    const x: f64 = 2.5;
    return expect_close_f64(x, 2.5, 0.0000001);
}
