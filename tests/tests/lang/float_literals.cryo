///! Float literal codegen - digit-separator (`_`) handling.
///!
///! Pinning the codegen contract for `LiteralKind::Float`: the lexer
///! accepts `_` digit separators in the integer part, fraction, and
///! exponent of a float literal (e.g. `1_000.5`, `1_0e1_0`). Parsing the
///! value from the raw lexeme via `sscanf("%lf", ...)` without stripping
///! separators first STOPS at the first `_`, so `1_000.5` would silently
///! compile to `1.0` - a wrong value with no diagnostic. (Integer literals
///! are unaffected because they strip via `int_literal_clean`.)
///!
///! `Lexer::float_literal_value` drops `_` before converting, for every
///! reader of a float literal's value. These tests would all fail (parsing
///! to a truncated prefix) without that.

![config(testing)]
namespace CryoTests::Tests::Lang::FloatLiterals;

import std::core::option::{ Option };
import std::core::result::{ Result };
import std::test::error::{ TestError };
import std::test::assert::{ expect_close_f64 };

![test]
function thousands_separator_integer_part() -> Result<(), TestError> {
    // Old bug: sscanf stopped at the `_`, yielding 1.0.
    const x: f64 = 1_000.5;
    return expect_close_f64(x, 1000.5, 0.0000001);
}

![test]
function multiple_separators_integer_part() -> Result<(), TestError> {
    const x: f64 = 1_234_567.89;
    return expect_close_f64(x, 1234567.89, 0.001);
}

![test]
function separator_in_fraction() -> Result<(), TestError> {
    const x: f64 = 3.1_4159;
    return expect_close_f64(x, 3.14159, 0.0000001);
}

![test]
function separator_in_exponent() -> Result<(), TestError> {
    // 1_0.0e1_0 == 10.0e10 == 1e11.
    const x: f64 = 1_0.0e1_0;
    return expect_close_f64(x, 100000000000.0, 1.0);
}

![test]
function no_separator_unaffected() -> Result<(), TestError> {
    // Regression guard: plain floats must still parse correctly.
    const x: f64 = 2.5;
    return expect_close_f64(x, 2.5, 0.0000001);
}

// A float literal's value is read as one whole number, so every shape the
// lexer forms - a suffix, an exponent of either case and sign, separators
// beside a suffix - must read; one that did not would stop the compiler
// rather than compile to 0.0.

/// Read by the global-constant emitter; the suffix is the only thing that
/// types it.
const SUFFIXED_CONSTANT = 1_2.5e-1f32;

![test]
function suffixed_literals_keep_their_value() -> Result<(), TestError> {
    const narrow = 2.5f32;
    const hundred = 1.0e2f32;
    const separated = 1_0.5f32;
    expect_close_f64(narrow as f64, 2.5, 0.0000001)?;
    expect_close_f64(hundred as f64, 100.0, 0.0000001)?;
    expect_close_f64(separated as f64, 10.5, 0.0000001)?;
    expect_close_f64(4E+1, 40.0, 0.0000001)?;
    expect_close_f64(5e-1f32 as f64, 0.5, 0.0000001)?;
    return expect_close_f64(SUFFIXED_CONSTANT as f64, 1.25, 0.0000001);
}

![test]
function float_pattern_in_a_variant() -> Result<(), TestError> {
    // Read by the parser, for the pattern's bound.
    const value: Option<f64> = Option::Some(1.5);
    const matched: f64 = match (value) {
        Option::Some(1.5f64) => { 1.0 }
        Option::Some(-0.25) => { 2.0 }
        _ => { 3.0 }
    };
    return expect_close_f64(matched, 1.0, 0.0000001);
}
