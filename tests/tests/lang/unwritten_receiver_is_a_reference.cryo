// A method that writes no receiver takes one by reference, exactly as if it
// had written `&this`: the parser gives it that parameter.  So what the
// written form allows, the unwritten one allows too - `this` is the caller's
// object, not a copy in this frame.
![config(testing)]
namespace CryoTests::Tests::Lang::UnwrittenReceiverIsAReference;

import std::test;
import std::core::result;
import std::core::result::{ Result };
import std::test::assert::{ expect_eq };
import std::test::error::{ TestError };

type struct Cell {
    n: i32;
}

implement struct Cell {
    // The receiver's address is the caller's object's address.
    address() -> u64 { return (this as void*) as u64; }
}

type enum Slot {
    Full(i32);
    Empty;
}

implement enum Slot {
    // A payload reached through the receiver lives in the caller's storage,
    // so its address outlives this call.
    payload() -> i32* {
        match (this) {
            Slot::Full(x) => { return &x; }
            Slot::Empty   => { return null; }
        }
    }
}

![test]
function unwritten_receiver_is_the_callers_object() -> Result<(), TestError> {
    mut c: Cell = Cell { n: 1 };
    const same: i32 = if (c.address() == (&c as void*) as u64) { 1 } else { 0 };
    return expect_eq(same, 1);
}

![test]
function payload_address_through_unwritten_receiver() -> Result<(), TestError> {
    mut s: Slot = Slot::Full(7);
    const p: i32* = s.payload();
    return expect_eq(*p, 7);
}
