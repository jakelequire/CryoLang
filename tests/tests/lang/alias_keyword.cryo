///! The alias keywords `int` / `uint` / `float` / `double` are spellings of
///! `i32` / `u32` / `f32` / `f64` and nothing more: a name written with one
///! is stamped to the primitive it spells, after every scope has declined
///! it, so a module that owns the same name (`std::fmt::float`) wins while
///! it is in scope and the primitive answers otherwise.

![config(testing)]
namespace CryoTests::Tests::Lang::AliasKeyword;

import std::core::convert;
import std::core::convert::{ TryFrom, ConversionError };
import std::core::option;
import std::core::option::{ Option };
import std::core::result;
import std::core::result::{ Result };
import std::fmt::float;
import std::test::error;
import std::test::error::{ TestError };
import std::test::assert;
import std::test::assert::{ expect_eq };

type trait Doubled { doubled(&this) -> i32; }

// An impl head on the alias keyword is an impl on `i32`: reachable from a
// receiver declared either way, with `this` bound in the body.  Refused
// three times over while the head was keyed by the spelling `int` (the
// body's `this` unbound, and neither receiver finding the method).
implement trait Doubled for int { doubled(&this) -> i32 { return *this * 2; } }

![test]
function impl_on_alias_keyword_is_reachable_from_i32() -> Result<(), TestError> {
    const a: i32 = 21;
    const b: int = 4;
    expect_eq(a.doubled(), 42)?;
    expect_eq(b.doubled(), 8)?;
    return Result::Ok(());
}

// A scope segment on the alias keyword names the primitive's own members:
// `int::try_from` is `i32::try_from`.  Reached codegen unresolved before
// (E0636 `cannot resolve 'int::try_from'`).
![test]
function alias_keyword_scope_segment_names_the_primitive() -> Result<(), TestError> {
    const big: i64 = 40;
    const r: Result<i32, ConversionError> = int::try_from(big);
    expect_eq(r.unwrap_or(0), 40)?;
    const over: i64 = 3000000000;
    const o: Result<i32, ConversionError> = int::try_from(over);
    expect_eq(o.is_err(), true)?;
    return Result::Ok(());
}

// The fold is asked only after every scope has declined the name: with
// `std::fmt::float` imported, `float::` is that module, never `f32::`.
![test]
function module_named_like_an_alias_keyword_wins_in_scope() -> Result<(), TestError> {
    const f: Option<f64> = float::parse_f64("2.5");
    expect_eq((f.unwrap_or(0.0) * 4.0) as i32, 10)?;
    return Result::Ok(());
}
