///! Helper module A for the same-leaf-name cross-module dispatch test
///! (see `leaf_dispatch.cryo`). Declares a `Cell` type and a `Pulse`
///! trait, with `Pulse::pulse` returning a value distinct from module B's
///! same-leaf `Cell`. Not a test module itself; it only provides types.

![config(testing)]
namespace CryoTests::Tests::Lang::LeafDispatchA;

type trait Pulse {
    pulse(&this) -> i32;
}

type struct Cell {
    a: i32;
}

implement Cell {
    get_a(&this) -> i32 { return this.a; }
}

implement trait Pulse for struct Cell {
    pulse(&this) -> i32 { return 100; }
}
