///! A `for` loop and `??` are defined over the language's `Iterator` and
///! `Option`, never over whatever the writing module's scope holds under those
///! names.  The desugaring used to write `Option::Some(x)` as a spelling the
///! name layer then looked up here, where it found this module's own `Option`
///! and refused every loop and every `??` in the file: "pattern names enum
///! `...::Option`, but the value matched is `std::core::option::Option`".

![config(testing)]
namespace CryoTests::Tests::Lang::ForInIsIteratorByIdentity;

import std::core::result;
import std::core::result::{ Result };
import std::core::iter::{ Iterator };
import std::test::error;
import std::test::error::{ TestError };
import std::test::assert;
import std::test::assert::{ expect_eq };

// This module's own enum under the language's leaf.  Nothing below means it
// except `mine`.
type enum Option<T> {
    Some(T);
    None;
}

// A user iterator: a loop over it goes through its `Iterator` impl.
type struct Countdown { n: i32; }

implement trait Iterator<i32> for struct Countdown {
    next(mut &this) -> std::core::option::Option<i32> {
        if (this.n <= 0) { return std::core::option::Option::None; }
        this.n = this.n - 1;
        return std::core::option::Option::Some(this.n + 1);
    }
}

function first_or(o: std::core::option::Option<i32>, d: i32) -> i32 {
    return o ?? d;
}

![test]
function for_over_range_beside_a_module_option() -> Result<(), TestError> {
    mut total: i32 = 0;
    for (i in Range::new(0, 5)) { total = total + i; }
    match (expect_eq(total, 10)) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

![test]
function for_over_a_user_iterator_beside_a_module_option() -> Result<(), TestError> {
    mut total: i32 = 0;
    for (v in Countdown { n: 4 }) { total = total * 10 + v; }
    match (expect_eq(total, 4321)) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

![test]
function coalesce_beside_a_module_option() -> Result<(), TestError> {
    const got: i32 = first_or(std::core::option::Option::None, 7)
                   + first_or(std::core::option::Option::Some(30), 7);
    match (expect_eq(got, 37)) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

![test]
function the_module_option_is_still_its_own() -> Result<(), TestError> {
    const mine: Option<i32> = Option::Some(5);
    const got: i32 = match (mine) {
        Option::Some(v) => { v }
        Option::None    => { 0 }
    };
    match (expect_eq(got, 5)) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}
