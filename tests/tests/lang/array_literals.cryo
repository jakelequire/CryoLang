///! Raw array-literal codegen for `T[]` (the language-level dynamic
///! array, not the stdlib `Array<T>` wrapper).
///!
///! Captures a 2026-05-08 reproducer: `const xs: i64[] = [3,2,1,4,5]`
///! was reported to store garbage in some slots. The control case here
///! is the `mut + .push()` form, which has always worked. If the
///! literal-form tests pass on the current compiler, the original bug
///! has been fixed and the failure mode is regression-pinned. If they
///! fail, this file is the reproducer.

![config(testing)]
namespace CryoTests::Tests::Lang::ArrayLiterals;

import std::core::result;
import std::collections::str;
import std::test::error;
import std::test::assert;

![test]
function const_i64_array_literal_preserves_values() -> Result<(), TestError> {
    const xs: i64[] = [3, 2, 1, 4, 5];
    match (expect_eq(xs[0], 3)) {
        Result::Ok(_) => { } Result::Err(e) => { return Result::Err(e); }
    }
    match (expect_eq(xs[1], 2)) {
        Result::Ok(_) => { } Result::Err(e) => { return Result::Err(e); }
    }
    match (expect_eq(xs[2], 1)) {
        Result::Ok(_) => { } Result::Err(e) => { return Result::Err(e); }
    }
    match (expect_eq(xs[3], 4)) {
        Result::Ok(_) => { } Result::Err(e) => { return Result::Err(e); }
    }
    match (expect_eq(xs[4], 5)) {
        Result::Ok(_) => { } Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

![test]
function mut_i64_array_literal_preserves_values() -> Result<(), TestError> {
    mut xs: i64[] = [10, 20, 30, 40, 50];
    match (expect_eq(xs[0], 10)) {
        Result::Ok(_) => { } Result::Err(e) => { return Result::Err(e); }
    }
    match (expect_eq(xs[1], 20)) {
        Result::Ok(_) => { } Result::Err(e) => { return Result::Err(e); }
    }
    match (expect_eq(xs[2], 30)) {
        Result::Ok(_) => { } Result::Err(e) => { return Result::Err(e); }
    }
    match (expect_eq(xs[3], 40)) {
        Result::Ok(_) => { } Result::Err(e) => { return Result::Err(e); }
    }
    match (expect_eq(xs[4], 50)) {
        Result::Ok(_) => { } Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

![test]
function i32_array_literal_preserves_values() -> Result<(), TestError> {
    const xs: i32[] = [3, 2, 1, 4, 5];
    match (expect_eq(xs[0], 3)) {
        Result::Ok(_) => { } Result::Err(e) => { return Result::Err(e); }
    }
    match (expect_eq(xs[4], 5)) {
        Result::Ok(_) => { } Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

![test]
function push_form_control() -> Result<(), TestError> {
    // The "known-good" form - pin it so any regression here would
    // surface independently of the literal codegen path.
    mut xs: i64[] = [];
    xs.push(3);
    xs.push(2);
    xs.push(1);
    xs.push(4);
    xs.push(5);
    match (expect_eq(xs[0], 3)) {
        Result::Ok(_) => { } Result::Err(e) => { return Result::Err(e); }
    }
    match (expect_eq(xs[4], 5)) {
        Result::Ok(_) => { } Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

![test]
function array_literal_length_is_correct() -> Result<(), TestError> {
    const xs: i64[] = [3, 2, 1, 4, 5];
    const got: i64 = xs.length;
    const want: i64 = 5;
    match (expect_eq(got, want)) {
        Result::Ok(_) => { } Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

![test]
function single_element_array_literal() -> Result<(), TestError> {
    const xs: i64[] = [42];
    match (expect_eq(xs[0], 42)) {
        Result::Ok(_) => { } Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}
