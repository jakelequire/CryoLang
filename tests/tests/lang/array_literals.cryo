///! Raw array-literal codegen for `T[]` (the language-level dynamic
///! array, not the stdlib `Array<T>` wrapper).
///!
///! Captures a 2026-05-08 reproducer: `const xs: i64[] = [3,2,1,4,5]`
///! was reported to store garbage in some slots. The control case here
///! is the `mut + .push()` form, which has always worked. If the
///! literal-form tests pass on the current compiler, the original bug
///! has been fixed and the failure mode is regression-pinned. If they
///! fail, this file is the reproducer.

![config(testing)]
namespace CryoTests::Tests::Lang::ArrayLiterals;

import std::core::result;
import std::collections::str;
import std::test::error;
import std::test::assert;

![test]
function const_i64_array_literal_preserves_values() -> Result<(), TestError> {
    const xs: i64[] = [3, 2, 1, 4, 5];
    match (expect_eq(xs[0], 3)) {
        Result::Ok(_) => { } Result::Err(e) => { return Result::Err(e); }
    }
    match (expect_eq(xs[1], 2)) {
        Result::Ok(_) => { } Result::Err(e) => { return Result::Err(e); }
    }
    match (expect_eq(xs[2], 1)) {
        Result::Ok(_) => { } Result::Err(e) => { return Result::Err(e); }
    }
    match (expect_eq(xs[3], 4)) {
        Result::Ok(_) => { } Result::Err(e) => { return Result::Err(e); }
    }
    match (expect_eq(xs[4], 5)) {
        Result::Ok(_) => { } Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

![test]
function mut_i64_array_literal_preserves_values() -> Result<(), TestError> {
    mut xs: i64[] = [10, 20, 30, 40, 50];
    match (expect_eq(xs[0], 10)) {
        Result::Ok(_) => { } Result::Err(e) => { return Result::Err(e); }
    }
    match (expect_eq(xs[1], 20)) {
        Result::Ok(_) => { } Result::Err(e) => { return Result::Err(e); }
    }
    match (expect_eq(xs[2], 30)) {
        Result::Ok(_) => { } Result::Err(e) => { return Result::Err(e); }
    }
    match (expect_eq(xs[3], 40)) {
        Result::Ok(_) => { } Result::Err(e) => { return Result::Err(e); }
    }
    match (expect_eq(xs[4], 50)) {
        Result::Ok(_) => { } Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

![test]
function i32_array_literal_preserves_values() -> Result<(), TestError> {
    const xs: i32[] = [3, 2, 1, 4, 5];
    match (expect_eq(xs[0], 3)) {
        Result::Ok(_) => { } Result::Err(e) => { return Result::Err(e); }
    }
    match (expect_eq(xs[4], 5)) {
        Result::Ok(_) => { } Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

![test]
function push_form_control() -> Result<(), TestError> {
    // The "known-good" form - pin it so any regression here would
    // surface independently of the literal codegen path.
    mut xs: i64[] = [];
    xs.push(3);
    xs.push(2);
    xs.push(1);
    xs.push(4);
    xs.push(5);
    match (expect_eq(xs[0], 3)) {
        Result::Ok(_) => { } Result::Err(e) => { return Result::Err(e); }
    }
    match (expect_eq(xs[4], 5)) {
        Result::Ok(_) => { } Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

![test]
function array_literal_length_is_correct() -> Result<(), TestError> {
    const xs: i64[] = [3, 2, 1, 4, 5];
    const got: i64 = xs.length;
    const want: i64 = 5;
    match (expect_eq(got, want)) {
        Result::Ok(_) => { } Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

![test]
function single_element_array_literal() -> Result<(), TestError> {
    const xs: i64[] = [42];
    match (expect_eq(xs[0], 42)) {
        Result::Ok(_) => { } Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

// Fill-form `[value; N]` bound to a FIXED `[T; N]` slot. Guards against the
// parser recording the count as `repeat_count_expr` (never the static
// `repeat_count`), which would make sema resolve every fill literal to
// a DYNAMIC `T[]` fat pointer: bound to a fixed `[N x T]` local, the store
// would be incompatible and the array would read back uninitialised garbage. A
// compile-time-constant fill count resolves to a fixed `[T; N]`.
![test]
function fixed_fill_array_literal_i32() -> Result<(), TestError> {
    const b: i32[4] = [9; 4];
    match (expect_eq(b[0] as i64, 9)) { Result::Ok(_) => {} Result::Err(e) => { return Result::Err(e); } }
    match (expect_eq(b[1] as i64, 9)) { Result::Ok(_) => {} Result::Err(e) => { return Result::Err(e); } }
    match (expect_eq(b[2] as i64, 9)) { Result::Ok(_) => {} Result::Err(e) => { return Result::Err(e); } }
    match (expect_eq(b[3] as i64, 9)) { Result::Ok(_) => {} Result::Err(e) => { return Result::Err(e); } }
    return Result::Ok(());
}

// Same fill form at a wider element type, to catch a per-slot width/store
// regression (an i64 fill must write all 8 bytes of each slot).
![test]
function fixed_fill_array_literal_i64() -> Result<(), TestError> {
    const b: i64[3] = [123456789012; 3];
    match (expect_eq(b[0], 123456789012)) { Result::Ok(_) => {} Result::Err(e) => { return Result::Err(e); } }
    match (expect_eq(b[2], 123456789012)) { Result::Ok(_) => {} Result::Err(e) => { return Result::Err(e); } }
    return Result::Ok(());
}

// The dynamic-target fill form must still produce a working `T[]`.
![test]
function dynamic_fill_array_literal() -> Result<(), TestError> {
    mut c: i32[] = [7; 4];
    match (expect_eq(c[0] as i64, 7)) { Result::Ok(_) => {} Result::Err(e) => { return Result::Err(e); } }
    match (expect_eq(c[3] as i64, 7)) { Result::Ok(_) => {} Result::Err(e) => { return Result::Err(e); } }
    return Result::Ok(());
}

// `null` is the null pointer literal and is valid in ANY pointer context, so a
// slot of a pointer-typed array literal is one too. The element resolves to
// `void*`; if the literal keeps that as its element type, the literal is a
// `void*[N]` and the enclosing assignment fails on a difference that does not
// exist at runtime -- the workaround being a cast per literal
// (`[null as T*; 8]`). Both the repeat form and the list form are covered:
// the property belongs to array literals, not to the repeat syntax.
type struct Slot { x: i32; }

![test]
function fill_of_null_takes_the_annotated_pointer_type() -> Result<(), TestError> {
    mut slots: Slot*[8] = [null; 8];
    match (expect_eq((slots[0] as u64) as i64, 0)) { Result::Ok(_) => {} Result::Err(e) => { return Result::Err(e); } }
    match (expect_eq((slots[7] as u64) as i64, 0)) { Result::Ok(_) => {} Result::Err(e) => { return Result::Err(e); } }
    return Result::Ok(());
}

![test]
function list_of_null_takes_the_annotated_pointer_type() -> Result<(), TestError> {
    mut slots: Slot*[2] = [null, null];
    match (expect_eq((slots[1] as u64) as i64, 0)) { Result::Ok(_) => {} Result::Err(e) => { return Result::Err(e); } }
    return Result::Ok(());
}

// `string` is pointer-shaped, and a dynamic target takes the same path as a
// fixed one; both must accept `null` without a cast.
![test]
function null_elements_reach_string_and_dynamic_targets() -> Result<(), TestError> {
    mut names: string[2] = [null, null];
    mut dyn: Slot*[] = [null, null];
    match (expect_eq((names[0] as u64) as i64, 0)) { Result::Ok(_) => {} Result::Err(e) => { return Result::Err(e); } }
    match (expect_eq((dyn[1] as u64) as i64, 0)) { Result::Ok(_) => {} Result::Err(e) => { return Result::Err(e); } }
    return Result::Ok(());
}
