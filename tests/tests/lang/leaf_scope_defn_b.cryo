///! Helper B for the import-scoped bare-leaf resolution regression
///! (see `leaf_scope_use_b.cryo`).  Same-leaf `Beacon` as module A, but
///! `signal()` returns 200, so a consumer that resolves bare `Beacon` to the
///! wrong module observes the wrong value (or an E0200 type mismatch).
///! Not a test module itself; it only provides a type.

![config(testing)]
namespace CryoTests::Tests::Lang::LeafScopeDefnB;

type struct Beacon {
    v: i32;
}

implement Beacon {
    static make() -> Beacon { return Beacon { v: 200 }; }
    signal(&this) -> i32 { return this.v; }
}
