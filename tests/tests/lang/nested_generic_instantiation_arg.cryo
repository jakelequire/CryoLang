///! Regression: a NESTED generic instantiation passed as the argument to a
///! generic function — e.g. `f<T>(x: Option<Option<T>>)` called with a
///! concrete nested value `Option::Some(Option::Some(5))`.
///!
///! Root cause was in sema (`call_resolver.resolve_call`): expected-type
///! propagation pushed the callee's UN-substituted template parameter type
///! `Option<Option<T>>` (with `T` unbound) onto the argument, so the enum
///! constructor adopted the template type. Its layout is size 0, so codegen
///! built a tag-only value and the DirectPair ABI marshaller left the `hi`
///! register a null operand (LLVM "Operand is null" verifier failure).
///!
///! Fix: substitute the call's explicit type args into the param types before
///! pushing them as expected types, and never push an expected type that still
///! carries a generic param. Also fixes the parser `>>`-before-comma bug so the
///! natural two-parameter form `f<T>(x: Option<Option<T>>, y: T)` parses.

![config(testing)]
namespace CryoTests::Tests::Lang::NestedGenericInstantiationArg;

import std::core::option;
import std::test::error;
import std::test::assert;

// Bare passthrough: the nested instantiation is the only argument.
function ngi_passthru<T>(x: Option<Option<T>>) -> i32 {
    return 7;
}

// Nested pattern match on the passed-in nested instantiation.
function ngi_classify<T>(x: Option<Option<T>>) -> i32 {
    match (x) {
        Option::Some(Option::Some(_)) => { return 2; }
        Option::Some(Option::None)    => { return 1; }
        Option::None                  => { return 0; }
    }
}

// Two parameters in the natural order — exercises the `>>`-before-comma
// parser fix — and binds the ngi_inner value through two enum levels.
function ngi_inner<T>(x: Option<Option<T>>, dflt: T) -> T where T: Copy {
    match (x) {
        Option::Some(Option::Some(v)) => { return v; }
        Option::Some(Option::None)    => { return dflt; }
        Option::None                  => { return dflt; }
    }
}

![test]
function passes_nested_instantiation_as_generic_arg() -> Result<(), TestError> {
    const got: i32 = ngi_passthru<i32>(Option::Some(Option::Some(5)));
    expect_eq(got, 7i32)?;
    return Result::Ok(());
}

![test]
function nested_pattern_match_on_passed_arg() -> Result<(), TestError> {
    expect_eq(ngi_classify<i32>(Option::Some(Option::Some(5))), 2i32)?;
    expect_eq(ngi_classify<i32>(Option::Some(Option::None)),    1i32)?;
    expect_eq(ngi_classify<i32>(Option::None),                  0i32)?;
    return Result::Ok(());
}

![test]
function nested_arg_at_distinct_type_args() -> Result<(), TestError> {
    // Two distinct `T` (i32 and boolean) exercise per-spec layout.
    expect_eq(ngi_classify<i32>(Option::Some(Option::Some(9))),         2i32)?;
    expect_eq(ngi_classify<boolean>(Option::Some(Option::Some(true))),  2i32)?;
    expect_eq(ngi_classify<boolean>(Option::Some(Option::None)),        1i32)?;
    expect_eq(ngi_classify<boolean>(Option::None),                      0i32)?;
    return Result::Ok(());
}

![test]
function binds_inner_value_through_two_levels() -> Result<(), TestError> {
    expect_eq(ngi_inner<i32>(Option::Some(Option::Some(42)), -1), 42i32)?;
    expect_eq(ngi_inner<i32>(Option::Some(Option::None),     -1), -1i32)?;
    expect_eq(ngi_inner<i32>(Option::None,                   -7), -7i32)?;
    return Result::Ok(());
}
