// Visibility: a `private` top-level type is fully usable WITHIN its own
// module — construction, methods, and as a field/return type all work.
// Cross-module rejection (E0503) is inherently a two-module scenario and
// can't be expressed in the single-file negative-test harness; it is
// covered by a standalone manual test (see the visibility memory note).
//
// This test pins the *no-false-positive* half: enforcement must never fire
// for a same-module reference.

![config(testing)]
namespace CryoTests::Tests::Lang::VisibilityPrivateType;

import std::core::result;
import std::test::error;
import std::test::assert;

// Private engine type — the pattern we want for hidden iterator cursors.
private type struct Cursor {
    pos: i32;
    end: i32;
}

implement struct Cursor {
    static start(end: i32) -> Cursor { return Cursor { pos: 0, end: end }; }
    remaining(&this) -> i32 { return this.end - this.pos; }
    step(mut &this) -> void { this.pos = this.pos + 1; }
}

// Public API that constructs and returns the private type within the module.
public function walk(n: i32) -> i32 {
    mut c: Cursor = Cursor::start(n);   // same-module construction: legal
    mut steps: i32 = 0;
    while (c.remaining() > 0) {
        c.step();
        steps = steps + 1;
    }
    return steps;
}

![test]
function private_type_usable_in_its_module() -> Result<(), TestError> {
    // Direct same-module construction + methods.
    mut c: Cursor = Cursor { pos: 2, end: 5 };
    match (expect_eq(c.remaining(), 3)) {
        Result::Ok(_) => { } Result::Err(e) => { return Result::Err(e); }
    }
    c.step();
    return expect_eq(c.remaining(), 2);
}

![test]
function private_type_through_public_api() -> Result<(), TestError> {
    return expect_eq(walk(4), 4);
}
