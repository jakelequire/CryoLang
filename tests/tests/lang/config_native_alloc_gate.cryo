///! `![config(native_alloc)]` compile-time backend gate (Low-Level Plan
///! Stage 3).  Two same-named `backend` functions are gated on opposite
///! polarities of the `native_alloc` build flag.  ConfigGating strips
///! exactly one before name resolution — so the mere fact that this file
///! COMPILES proves the gate removed the other (two live `backend`s would be a
///! duplicate-definition error).  Under `cryo test` the flag is OFF (its
///! default; nothing sets cryoconfig `[low_level] native_alloc`), so the
///! `not(native_alloc)` arm is the one that survives.
///!
///! The ON polarity (native arm surviving) is covered by the
///! `native_alloc_gate` test project, whose cryoconfig sets the flag.

![config(testing)]
namespace CryoTests::Tests::Lang::ConfigNativeAllocGate;

import std::core::result;
import std::test::error;
import std::test::assert;

// Native backend: stripped unless `native_alloc` is ON.  Returns a value
// distinct from the libc arm so the surviving arm is identifiable at runtime.
![config(native_alloc)]
function backend() -> i32 { return 1; }

// libc backend: active whenever `native_alloc` is OFF (the default).
![config(not(native_alloc))]
function backend() -> i32 { return 0; }

![test]
function default_build_selects_libc_arm() -> Result<(), TestError> {
    // Off by default => the `not(native_alloc)` (libc) arm is the survivor.
    const got: i32 = backend();
    const want: i32 = 0;
    match (expect_eq(got, want)) {
        Result::Ok(_)  => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}
