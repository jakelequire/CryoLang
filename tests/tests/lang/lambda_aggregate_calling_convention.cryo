///! A lambda is called through a function value, whose call site passes each
///! argument and takes the result the way the calling convention places a
///! value of that size: an aggregate of more than 16 bytes through a hidden
///! pointer (returned) or a pointer to a copy (passed), one of 9 to 16 bytes
///! in two registers, and one of at most 8 bytes in one.  The lambda's own
///! body receives and returns them the same way, or the call reads a result
///! the body never wrote.  Each lambda below is reached only through a
///! function value, and each shape is checked on both sides of the call.

![config(testing)]
namespace CryoTests::Tests::Lang::LambdaAggregateCallingConvention;

import std::core::result::{ Result };
import std::core::slice::{ Slice };
import std::test::error::{ TestError };
import std::test::assert::{ expect_eq };

type struct Wide { a: i64; b: i64; c: i64; }
type struct Middle { a: i64; b: i32; }
type struct Narrow { a: i32; b: i32; }

type trait Weigh { weight(&this) -> i64; }

implement trait Weigh for struct Wide {
    weight(&this) -> i64 { return this.a * 100 + this.b * 10 + this.c; }
}

![test]
function wide_result_reaches_the_caller() -> Result<(), TestError> {
    const make: () -> Wide = () -> Wide { return Wide { a: 1, b: 2, c: 3 }; };
    const w: Wide = make();
    expect_eq(w.a, 1)?;
    expect_eq(w.b, 2)?;
    return expect_eq(w.c, 3);
}

![test]
function wide_argument_reaches_the_body() -> Result<(), TestError> {
    const weigh: (Wide) -> i64 = (w: Wide) -> i64 { return w.a * 100 + w.b * 10 + w.c; };
    return expect_eq(weigh(Wide { a: 4, b: 5, c: 6 }), 456);
}

![test]
function middle_argument_and_result_cross_in_registers() -> Result<(), TestError> {
    const bump: (Middle, i64) -> Middle = (m: Middle, by: i64) -> Middle {
        return Middle { a: m.a + by, b: m.b + 1 };
    };
    const m: Middle = bump(Middle { a: 40, b: 7 }, 2);
    expect_eq(m.a, 42)?;
    return expect_eq(m.b as i64, 8);
}

![test]
function narrow_argument_and_result_cross_in_one_register() -> Result<(), TestError> {
    const swap: (Narrow) -> Narrow = (n: Narrow) -> Narrow { return Narrow { a: n.b, b: n.a }; };
    const n: Narrow = swap(Narrow { a: 3, b: 9 });
    expect_eq(n.a as i64, 9)?;
    return expect_eq(n.b as i64, 3);
}

/// A trait object is two words, the value's address and its table's, so it
/// crosses the call as an aggregate of 16 bytes.
![test]
function trait_object_argument_reaches_the_body() -> Result<(), TestError> {
    const w: Wide = Wide { a: 4, b: 5, c: 6 };
    const read: (virtual &Weigh) -> i64 = (o: virtual &Weigh) -> i64 { return o.weight(); };
    return expect_eq(read(&w), 456);
}

/// A slice reference is two words, the elements' address and their count,
/// so it crosses the call as an aggregate of 16 bytes, both ways.
![test]
function slice_reference_argument_and_result_reach_the_body() -> Result<(), TestError> {
    const values: [i64; 3] = [4, 5, 6];
    const s: &Slice<i64> = Slice::<i64>::from_raw(&values[0], 3);
    const sum: (&Slice<i64>) -> i64 = (items: &Slice<i64>) -> i64 {
        return items[0] * 100 + items[1] * 10 + items[2];
    };
    const same: (&Slice<i64>) -> &Slice<i64> = (items: &Slice<i64>) -> &Slice<i64> { return items; };
    expect_eq(sum(s), 456)?;
    return expect_eq(sum(same(s)), 456);
}
