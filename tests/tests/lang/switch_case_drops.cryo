///! Switch-case drop synthesis - pin the rule that owned locals declared
///! inside a `switch` case body are dropped when the case ends (normally or
///! via `break`), exactly like an `if`-block local.
///!
///! The drop-insertion pass must walk `switch` case bodies, not just pass
///! `switch` straight through; otherwise any owned local declared in a case
///! body would leak (its `Drop` would never run). Cryo's switch has no
///! fallthrough, so each case is an independent block scope.
///!
///! Observable side-effect: each `SwProbe::drop()` bumps a module-level
///! counter; we assert the delta matches the contract on each path. (The
///! complementary use-after-move-in-a-case rule is pinned by
///! tests/negative/E0452_use_after_move_in_switch_case.cryo.)

![config(testing)]
namespace CryoTests::Tests::Lang::SwitchCaseDrops;

import std::core::result;
import std::core::drop;
import std::test::error;
import std::test::assert;

mut g_sw_drop_count: i32 = 0;

function sw_reset() -> void { g_sw_drop_count = 0; }
function sw_count() -> i32  { return g_sw_drop_count; }

type struct SwProbe {
    tag: i32;

    static new(tag: i32) -> SwProbe {
        return SwProbe { tag: tag };
    }
}

implement trait Drop for struct SwProbe {
    drop(mut &this) -> void {
        g_sw_drop_count = g_sw_drop_count + 1;
    }
}

// A local declared in the taken case body is dropped when the case ends.
![test]
function case_local_dropped_at_case_exit() -> Result<(), TestError> {
    sw_reset();
    mut sel: i32 = 0;
    switch (sel) {
        case 0: {
            const p: SwProbe = SwProbe::new(1);
        }
        default: { }
    }
    return expect_eq(sw_count(), 1);
}

// A local declared before a `break` in a case body is still dropped.
![test]
function case_local_dropped_before_break() -> Result<(), TestError> {
    sw_reset();
    mut sel: i32 = 1;
    switch (sel) {
        case 1: {
            const p: SwProbe = SwProbe::new(2);
            break;
        }
        default: { }
    }
    return expect_eq(sw_count(), 1);
}

// Only the taken case's body runs, so only its local drops (the other case's
// body is never entered).
![test]
function only_taken_case_local_drops() -> Result<(), TestError> {
    sw_reset();
    mut sel: i32 = 9;
    switch (sel) {
        case 0: {
            const a: SwProbe = SwProbe::new(3);
        }
        default: {
            const b: SwProbe = SwProbe::new(4);
        }
    }
    return expect_eq(sw_count(), 1);   // only the default body's local
}
