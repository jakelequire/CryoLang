// In a generic body a type parameter is one opaque type: `T` takes a `T`.
// The element an `Array<T>` holds is reached by matching the `Option<T>`
// that `get` answers, and inside a `static match (T)` arm both the locals
// typed `T` and the declared return type read as the arm's type, so a value
// of that type is returned there.
![config(testing)]
namespace CryoTests::Tests::Lang::GenericBodyParamIsOneType;

import std::core::result;
import std::core::result::{ Result };
import std::test::error;
import std::test::error::{ TestError };
import std::test::assert;
import std::test::assert::{ expect_eq };

function first_or<T>(xs: &Array<T>, fallback: T) -> T where T: Copy {
    match (xs.get(0)) {
        Option::Some(v) => { return v; }
        Option::None    => { return fallback; }
    }
}

function last_or<T>(xs: &Array<T>, fallback: T) -> T where T: Copy {
    if (xs.length() == 0) { return fallback; }
    mut out: T = fallback;
    out = xs.get(xs.length() - 1).unwrap();
    return out;
}

function halve<T>(x: T) -> T {
    static match (T) {
        f64 => { const h: f64 = x / 2.0; return h; }
        _   => { return x; }
    }
}

![test]
function first_reads_the_element() -> Result<(), TestError> {
    mut xs: Array<i32> = Array::<i32>::new();
    xs.push(5);
    xs.push(7);
    return expect_eq(first_or::<i32>(&xs, 0), 5);
}

![test]
function first_of_empty_is_the_fallback() -> Result<(), TestError> {
    const xs: Array<i64> = Array::<i64>::new();
    return expect_eq(first_or::<i64>(&xs, 9), 9);
}

![test]
function last_reads_the_element() -> Result<(), TestError> {
    mut xs: Array<u8> = Array::<u8>::new();
    xs.push(3);
    xs.push(4);
    return expect_eq(last_or::<u8>(&xs, 0) as i64, 4);
}

![test]
function static_match_arm_returns_its_type() -> Result<(), TestError> {
    return expect_eq((halve::<f64>(5.0) * 10.0) as i64, 25);
}

![test]
function static_match_default_arm_returns_the_param() -> Result<(), TestError> {
    return expect_eq(halve::<i32>(5) as i64, 5);
}
