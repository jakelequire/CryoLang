///! Variadic methods: an `implement`-block method (instance or static) whose
///! last parameter is a `name...` variadic must be callable with a variable
///! number of trailing arguments. The method-call arity checker used to ignore
///! `is_variadic` (only the free-function path honored it), so any variadic
///! method call was rejected with a spurious E0215 "takes N argument(s) but M
///! were supplied". These cases exercise the fixed prefix plus 0..N extra args
///! on both the instance and static paths.

![config(testing)]
namespace CryoTests::Tests::Lang::VariadicMethods;

import std::core::result;
import std::test::error;
import std::test::assert;

type struct Logger {
    id: i32;
}

implement Logger {
    // Instance variadic method: returns the fixed receiver field, ignoring
    // the variadic tail. We only need the call to type-check at any arity.
    log(&this, fmt: string, args...) -> i32 {
        return this.id;
    }

    // Static variadic method on the same type (separate sema path).
    static tag(prefix: string, args...) -> i32 {
        return 42;
    }
}

![test]
function instance_variadic_accepts_extra_args() -> Result<(), TestError> {
    const l: Logger = Logger { id: 7 };
    // fixed prefix only, then +1, then +2 trailing args
    match (expect_eq(l.log("a"), 7)) {
        Result::Ok(_) => { } Result::Err(e) => { return Result::Err(e); }
    }
    match (expect_eq(l.log("a=%d", 1), 7)) {
        Result::Ok(_) => { } Result::Err(e) => { return Result::Err(e); }
    }
    match (expect_eq(l.log("a=%d b=%d", 1, 2), 7)) {
        Result::Ok(_) => { } Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

![test]
function static_variadic_accepts_extra_args() -> Result<(), TestError> {
    match (expect_eq(Logger::tag("p"), 42)) {
        Result::Ok(_) => { } Result::Err(e) => { return Result::Err(e); }
    }
    match (expect_eq(Logger::tag("p", 1, 2, 3), 42)) {
        Result::Ok(_) => { } Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}
