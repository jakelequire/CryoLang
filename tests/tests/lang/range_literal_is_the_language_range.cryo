///! `a..b` and `a..=b` build the language's `std::core::ops::Range` and
///! `RangeInclusive`, never whatever the writing module's scope holds under
///! those names.  The desugaring used to write `Range::new(a, b)` as a
///! spelling looked up here, where it found this module's own `Range` and
///! refused every range literal in the file: "cannot find `Range::new`".

![config(testing)]
namespace CryoTests::Tests::Lang::RangeLiteralIsTheLanguageRange;

import std::core::result;
import std::core::result::{ Result };
import std::test::error;
import std::test::error::{ TestError };
import std::test::assert;
import std::test::assert::{ expect_eq };

// This module's own types under the language's leaves.
type struct Range { lo: i32; hi: i32; }
type struct RangeInclusive { lo: i32; }

![test]
function half_open_literal_beside_a_module_range() -> Result<(), TestError> {
    mut total: i32 = 0;
    for (i in 0..5) { total = total + i; }
    return expect_eq(total, 10);
}

![test]
function inclusive_literal_beside_a_module_range() -> Result<(), TestError> {
    mut total: i32 = 0;
    for (i in 2..=4) { total = total + i; }
    return expect_eq(total, 9);
}

![test]
function the_module_range_is_still_its_own() -> Result<(), TestError> {
    const mine: Range = Range { lo: 3, hi: 7 };
    return expect_eq(mine.hi - mine.lo, 4);
}
