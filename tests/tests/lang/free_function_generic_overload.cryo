///! A free function overloaded with a generic and a non-generic signature of
///! one arity. A call both accept is ambiguous (E0154,
///! negative/E0154_free_function_generic_tie.cryo); these calls are not:
///!
///!  - a written type argument names the generic function;
///!  - an argument only the generic function accepts calls it, through a
///!    module path;
///!  - a generic whose where-clause the argument fails does not accept it, so
///!    the non-generic function is the only candidate.

![config(testing)]
namespace CryoTests::Tests::Lang::FreeFunctionGenericOverload;

import std::core::result;
import std::core::result::{ Result };
import std::test::error;
import std::test::error::{ TestError };
import std::test::assert;
import std::test::assert::{ expect_eq };

function same<U>(u: U) -> i32 { return 1; }
function same(u: i32) -> i32 { return 2; }

type trait Shout { shout(&this) -> i32; }
type struct Loud { n: i32; }
implement trait Shout for struct Loud { shout(&this) -> i32 { return this.n; } }

function loud<U>(u: U) -> i32 where U: Shout { return 1; }
function loud(u: i32) -> i32 { return 2; }

![test]
function type_argument_calls_the_generic() -> Result<(), TestError> {
    const x: i32 = 7;
    return expect_eq(same::<i32>(x), 1);
}

![test]
function qualified_call_only_the_generic_accepts() -> Result<(), TestError> {
    return expect_eq(FreeFunctionGenericOverload::same("s"), 1);
}

![test]
function generic_whose_bound_fails_is_no_candidate() -> Result<(), TestError> {
    const x: i32 = 7;
    return expect_eq(loud(x), 2);
}
