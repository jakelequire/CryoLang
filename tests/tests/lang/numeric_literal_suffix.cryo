// A numeric type suffix NAMES the literal's type: `7u64` is a u64 wherever it
// appears. It is therefore not width-polymorphic - it neither adopts a
// surrounding expected type nor falls back to the magnitude default - and
// generic inference binds a type parameter from it like any other typed
// argument.
//
// The suffix used to be validated by the lexer and then discarded, so it was
// purely decorative: `mut x = 7u64` gave an i32, a contradictory annotation was
// silently resolved in the annotation's favour, and - the case with no context
// at all to fall back on - a generic parameter reachable only from the argument
// bound to the default width instead of the written one, returning a wrong
// answer with no diagnostic.
//
// Every assertion here is `sizeof(T)`, a NUMBER THAT DEPENDS ON THE INFERRED
// TYPE, because the failure mode is a silent wrong answer rather than a missing
// symbol: a test that merely called these would have passed throughout.
![config(testing)]
namespace CryoTests::Tests::Lang::NumericLiteralSuffix;

import std::core::result;
import std::test::error;
import std::test::assert;

// `T` is reachable ONLY from the argument: no turbofish, no expected type, no
// second parameter. The suffix is the sole signal.
function nls_ident<T>(x: T) -> u64 { return sizeof(T) as u64; }

type struct NlsBox<S> {
    seed: S;
    static new(s: S) -> NlsBox<S> { return NlsBox<S> { seed: s }; }

    // The method-path mirror of `nls_ident`.
    take<T>(&this, v: T) -> u64 { return sizeof(T) as u64; }

    // A suffixed literal INSIDE a generic template body. The body is cloned
    // once per specialization, so a cloner that dropped the suffix would
    // re-type this to the default width and return 4 - and would do so only
    // for the specialized copies, never for the template itself.
    inner_suffixed(&this) -> u64 { return nls_ident(7u64); }
}

![test]
function suffix_binds_a_generic_arg() -> Result<(), TestError> {
    match (expect_eq(nls_ident(7u64) as i64, 8)) {
        Result::Ok(_)  => {}
        Result::Err(e) => { return Result::Err(e); }
    }
    match (expect_eq(nls_ident(7i8) as i64, 1)) {
        Result::Ok(_)  => {}
        Result::Err(e) => { return Result::Err(e); }
    }
    return expect_eq(nls_ident(7u16) as i64, 2);
}

// The control that keeps the fix honest: a BARE literal must stay polymorphic
// and fall back to the i32 default. Pinning every literal to a written type
// would break far more than it fixed.
![test]
function bare_literal_stays_polymorphic() -> Result<(), TestError> {
    return expect_eq(nls_ident(7) as i64, 4);
}

![test]
function suffix_binds_a_method_type_arg() -> Result<(), TestError> {
    mut b: NlsBox<i32> = NlsBox<i32>::new(1);
    match (expect_eq(b.take(7u64) as i64, 8)) {
        Result::Ok(_)  => {}
        Result::Err(e) => { return Result::Err(e); }
    }
    return expect_eq(b.take(7) as i64, 4);
}

// Two specializations of the owner, so the template body is cloned twice. Both
// must still see `7u64` as a u64.
![test]
function suffix_survives_template_specialization() -> Result<(), TestError> {
    mut a: NlsBox<i32> = NlsBox<i32>::new(1);
    mut c: NlsBox<u64> = NlsBox<u64>::new(1);
    match (expect_eq(a.inner_suffixed() as i64, 8)) {
        Result::Ok(_)  => {}
        Result::Err(e) => { return Result::Err(e); }
    }
    return expect_eq(c.inner_suffixed() as i64, 8);
}

// With no annotation, the suffix is the only thing that can type the local.
![test]
function suffix_types_an_inferred_local() -> Result<(), TestError> {
    mut x = 7u64;
    match (expect_eq(nls_ident(x) as i64, 8)) {
        Result::Ok(_)  => {}
        Result::Err(e) => { return Result::Err(e); }
    }
    mut y = 7i8;
    return expect_eq(nls_ident(y) as i64, 1);
}

// A sign prefix parses as a unary expression wrapping the literal, so the
// suffix has to be found through it.
![test]
function suffix_through_a_sign_prefix() -> Result<(), TestError> {
    return expect_eq(nls_ident(-7i8) as i64, 1);
}

// An arithmetic constant is suffix-typed when either operand names a type;
// a shift past 31 is meaningless if the expression falls back to i32.
![test]
function suffix_through_arithmetic() -> Result<(), TestError> {
    match (expect_eq(nls_ident(1u64 << 40) as i64, 8)) {
        Result::Ok(_)  => {}
        Result::Err(e) => { return Result::Err(e); }
    }
    return expect_eq((1u64 << 40) as i64, 1099511627776);
}

// THE LEXING HAZARD: `0x1f64` is entirely hex digits, so it is the integer
// 8036 with NO suffix - not `0x1` carrying an `f64` suffix. The boundary is
// only knowable while lexing, which is why the suffix is captured there rather
// than recovered from the finished lexeme. A misread here is silent: the value
// would become 1 and the type f64.
![test]
function hex_digits_are_not_a_suffix() -> Result<(), TestError> {
    match (expect_eq(0x1f64 as i64, 8036)) {
        Result::Ok(_)  => {}
        Result::Err(e) => { return Result::Err(e); }
    }
    // Untyped by any suffix, so it stays polymorphic and takes the i32 default.
    return expect_eq(nls_ident(0x1f64) as i64, 4);
}

// A hex literal CAN carry a suffix when the digit run stops short of it.
![test]
function hex_with_a_real_suffix() -> Result<(), TestError> {
    match (expect_eq(nls_ident(0x1u8) as i64, 1)) {
        Result::Ok(_)  => {}
        Result::Err(e) => { return Result::Err(e); }
    }
    return expect_eq(0x1u8 as i64, 1);
}

![test]
function float_suffix_binds_a_generic_arg() -> Result<(), TestError> {
    match (expect_eq(nls_ident(1.5f32) as i64, 4)) {
        Result::Ok(_)  => {}
        Result::Err(e) => { return Result::Err(e); }
    }
    // Bare float still defaults to f64.
    return expect_eq(nls_ident(1.5) as i64, 8);
}
