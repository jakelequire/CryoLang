///! Helper module B for the same-leaf-name cross-module dispatch test
///! (see `leaf_dispatch.cryo`). Declares a *second* `Cell` — same leaf
///! name as module A's, different fields — and implements module A's
///! `Pulse` trait with a distinct return value. Exercises the case where
///! trait/inherent dispatch must pick the impl belonging to the correct
///! module rather than the first-registered same-leaf type.

![config(testing)]
namespace CryoTests::Tests::Lang::LeafDispatchB;

import CryoTests::Tests::Lang::LeafDispatchA;

type struct Cell {
    b1:     i32;
    b2:     i32;
    only_b: i32;
}

implement Cell {
    get_only(&this) -> i32 { return this.only_b; }
}

implement trait CryoTests::Tests::Lang::LeafDispatchA::Pulse for struct Cell {
    pulse(&this) -> i32 { return 200; }
}
