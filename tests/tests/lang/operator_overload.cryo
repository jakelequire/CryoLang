///! Operator traits (`core::ops`): user `Deref` / `Index` impls.
///!
///! v1.0 ships the `Deref<Target>` trait with its explicit `.deref()`
///! method (`*` sugar is a documented post-1.0 follow-up), so the `Deref`
///! tests call the method directly. Every other operator has full sugar over
///! user types: arithmetic (`+ - * / %`), unary `-`, equality/relational
///! (`== != < > <= >=`), bitwise/shift (`& | ^ << >>` + their `&=`-style
///! compound forms), unary complement (`!` / `~`), and indexing (`[]` as
///! read/write/compound, incl. generic and bounded-param dispatch). Operands
///! passed by reference (`&T`) overload exactly like values. The tests pin
///! that sugar alongside the direct-method contract that an `Index`/`Deref`
///! pointer aliases the receiver's storage in place.

![config(testing)]
namespace CryoTests::Tests::Lang::OperatorOverload;

import std::core::result;
import std::core::ops;
import std::test::error;
import std::test::assert;

// A minimal smart-pointer-like wrapper implementing Deref.
type struct Boxed { value: i32; }

implement trait Deref<i32> for Boxed {
    deref(&this) -> i32* {
        return &this.value;
    }
}

// Resolve `.deref()` through the `Deref` bound rather than the bare global
// method name: bound-directed resolution is unambiguous and also dodges
// the unrelated struct also named `Deref` in another test module.
function deref_ptr<T, U>(x: &T) -> U* where T: Deref<U> {
    return x.deref();
}

// A fixed 3-slot container implementing Index.
type struct Triple {
    a: i32;
    b: i32;
    c: i32;
}

implement trait Index<u64, i32> for Triple {
    index(&this, idx: u64) -> i32* {
        if (idx == 0u64) { return &this.a; }
        if (idx == 1u64) { return &this.b; }
        return &this.c;
    }
}

![test]
function deref_returns_pointer_to_value() -> Result<(), TestError> {
    const b: Boxed = Boxed { value: 41 };
    const p: i32* = deref_ptr(&b);
    return expect_eq(*p, 41);
}

// The Deref pointer aliases the receiver in place: writing through it
// mutates the original `Boxed`.
![test]
function deref_pointer_aliases_in_place() -> Result<(), TestError> {
    mut b: Boxed = Boxed { value: 1 };
    const p: i32* = deref_ptr(&b);
    *p = 100;
    return expect_eq(b.value, 100);
}

![test]
function index_reads_each_slot() -> Result<(), TestError> {
    const t: Triple = Triple { a: 10, b: 20, c: 30 };
    const p0: i32* = t.index(0u64);
    const p1: i32* = t.index(1u64);
    const p2: i32* = t.index(2u64);
    match (expect_eq(*p0, 10)) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    match (expect_eq(*p1, 20)) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return expect_eq(*p2, 30);
}

// The Index pointer aliases the receiver in place.
![test]
function index_pointer_aliases_in_place() -> Result<(), TestError> {
    mut t: Triple = Triple { a: 1, b: 2, c: 3 };
    const p: i32* = t.index(1u64);
    *p = 99;
    return expect_eq(t.b, 99);
}

// A container whose `index` bumps a counter, so a compound assignment that
// evaluated the LHS place twice would show `calls == 2`.
type struct Counted {
    slot:  i32;
    calls: i32;
}

implement trait Index<i64, i32> for Counted {
    index(mut &this, idx: i64) -> i32* {
        this.calls = this.calls + 1;
        return &this.slot;
    }
}

// A generic container: exercises the mono/cloner/substituter descent into the
// index desugar so `Wrap<i32>::index` gets specialized.
type struct Wrap<T> {
    x: T;
    y: T;
}

implement<T> trait Index<i64, T> for struct Wrap<T> {
    index(&this, idx: i64) -> T* {
        if (idx == 0) { return &this.x; }
        return &this.y;
    }
}

// `c[i]` on a generic param bounded by `Index` (Phase 2). Triple is all-scalar,
// so passing it by value is a plain copy.
function get_at<T>(c: T, i: u64) -> i32 where T: Index<u64, i32> {
    return c[i];
}

// `[]` sugar as a read: `t[i]` desugars to `*(t.index(i))`.
![test]
function index_sugar_reads() -> Result<(), TestError> {
    const t: Triple = Triple { a: 10, b: 20, c: 30 };
    match (expect_eq(t[0u64], 10)) {
        Result::Ok(_)  => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    match (expect_eq(t[1u64], 20)) {
        Result::Ok(_)  => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return expect_eq(t[2u64], 30);
}

// `[]` sugar as a write target: the desugar `*(t.index(i))` is a place.
![test]
function index_sugar_writes() -> Result<(), TestError> {
    mut t: Triple = Triple { a: 1, b: 2, c: 3 };
    t[1u64] = 99;
    return expect_eq(t.b, 99);
}

// Compound assignment through `[]` calls `index` exactly once.
![test]
function index_sugar_compound_once() -> Result<(), TestError> {
    mut c: Counted = Counted { slot: 5, calls: 0 };
    c[0] += 7;
    match (expect_eq(c.slot, 12)) {
        Result::Ok(_)  => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return expect_eq(c.calls, 1);
}

// Generic container: `[]` sugar reads and writes through a specialized
// `Wrap<i32>::index`.
![test]
function index_sugar_generic() -> Result<(), TestError> {
    mut w: Wrap<i32> = Wrap<i32> { x: 100, y: 200 };
    match (expect_eq(w[0], 100)) {
        Result::Ok(_)  => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    w[1] = 250;
    return expect_eq(w.y, 250);
}

// `[]` on a generic param bounded by `Index`.
![test]
function index_sugar_bounded_param() -> Result<(), TestError> {
    const t: Triple = Triple { a: 7, b: 8, c: 9 };
    return expect_eq(get_at(t, 2u64), 9);
}

// -- Reference-operand overloading: `&T` operands overload just like values. --

// Index / arithmetic / negation through a by-reference parameter (the common
// container-by-reference case). The desugar auto-derefs the reference receiver.
function idx_via_ref(v: &Triple, i: u64) -> i32 { return v[i]; }

type struct V2 { x: i32; y: i32; }
implement trait Add<V2, V2> for V2 {
    add(&this, rhs: &V2) -> V2 { return V2 { x: this.x + rhs.x, y: this.y + rhs.y }; }
}
implement trait Neg<V2> for V2 {
    neg(&this) -> V2 { return V2 { x: 0 - this.x, y: 0 - this.y }; }
}
// Both operands references: exercises the `&&Rhs` guard in build_operator_call.
function add_via_refs(a: &V2, b: &V2) -> V2 { return a + b; }
function neg_via_ref(a: &V2) -> V2 { return -a; }

![test]
function index_through_reference() -> Result<(), TestError> {
    const t: Triple = Triple { a: 11, b: 22, c: 33 };
    return expect_eq(idx_via_ref(&t, 1u64), 22);
}

![test]
function arithmetic_through_reference() -> Result<(), TestError> {
    const p: V2 = V2 { x: 1, y: 2 };
    const q: V2 = V2 { x: 10, y: 20 };
    const s: V2 = add_via_refs(&p, &q);
    match (expect_eq(s.x, 11)) {
        Result::Ok(_)  => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return expect_eq(s.y, 22);
}

![test]
function negation_through_reference() -> Result<(), TestError> {
    const p: V2 = V2 { x: 3, y: 4 };
    const n: V2 = neg_via_ref(&p);
    match (expect_eq(n.x, -3)) {
        Result::Ok(_)  => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return expect_eq(n.y, -4);
}

// -- Bitwise / shift / complement operator overloading. --

type struct Bits { v: i32; }
implement trait BitAnd<Bits, Bits> for Bits { bitand(&this, rhs: &Bits) -> Bits { return Bits { v: this.v & rhs.v }; } }
implement trait BitOr<Bits, Bits>  for Bits { bitor(&this, rhs: &Bits)  -> Bits { return Bits { v: this.v | rhs.v }; } }
implement trait BitXor<Bits, Bits> for Bits { bitxor(&this, rhs: &Bits) -> Bits { return Bits { v: this.v ^ rhs.v }; } }
implement trait Shl<i32, Bits>     for Bits { shl(&this, rhs: &i32) -> Bits { return Bits { v: this.v << *rhs }; } }
implement trait Shr<i32, Bits>     for Bits { shr(&this, rhs: &i32) -> Bits { return Bits { v: this.v >> *rhs }; } }
implement trait Not<Bits>          for Bits { not(&this) -> Bits { return Bits { v: if (this.v == 0) { 1 } else { 0 } }; } }
implement trait BitNot<Bits>       for Bits { bitnot(&this) -> Bits { return Bits { v: ~this.v }; } }

![test]
function bitwise_binary_ops() -> Result<(), TestError> {
    const a: Bits = Bits { v: 12 };   // 0b1100
    const b: Bits = Bits { v: 10 };   // 0b1010
    match (expect_eq((a & b).v, 8)) {
        Result::Ok(_)  => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    match (expect_eq((a | b).v, 14)) {
        Result::Ok(_)  => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return expect_eq((a ^ b).v, 6);
}

![test]
function shift_ops() -> Result<(), TestError> {
    match (expect_eq((Bits { v: 1 } << 3).v, 8)) {
        Result::Ok(_)  => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return expect_eq((Bits { v: 16 } >> 2).v, 4);
}

// Compound bitwise/shift route through the same traits and store back.
![test]
function bitwise_shift_compound() -> Result<(), TestError> {
    mut x: Bits = Bits { v: 12 };
    x &= Bits { v: 10 };
    match (expect_eq(x.v, 8)) {
        Result::Ok(_)  => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    mut y: Bits = Bits { v: 1 };
    y <<= 4;
    return expect_eq(y.v, 16);
}

![test]
function unary_complement_ops() -> Result<(), TestError> {
    match (expect_eq((!Bits { v: 0 }).v, 1)) {
        Result::Ok(_)  => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    match (expect_eq((!Bits { v: 5 }).v, 0)) {
        Result::Ok(_)  => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return expect_eq((~Bits { v: 0 }).v, -1);
}

// -- Reflected overloading: PRIMITIVE left operand, user-type right operand. --
// `2 * v` dispatches on the primitive `i32`; LHS-driven dispatch consults an
// operator trait implemented ON the primitive, but only on the failure path
// (primitive OP primitive stays native).  `V2` (defined above) gets a scalar
// pre-multiply this way without any `Mul` on `V2` itself.
implement trait Mul<V2, V2> for i32 {
    mul(&this, rhs: &V2) -> V2 { return V2 { x: this * rhs.x, y: this * rhs.y }; }
}

![test]
function reflected_scalar_times_vector() -> Result<(), TestError> {
    const p: V2 = V2 { x: 3, y: 4 };
    const a: V2 = 2 * p;          // literal primitive on the left
    match (expect_eq(a.x, 6)) {
        Result::Ok(_)  => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    match (expect_eq(a.y, 8)) {
        Result::Ok(_)  => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    const s: i32 = 10;
    const b: V2 = s * p;          // variable primitive on the left
    match (expect_eq(b.x, 30)) {
        Result::Ok(_)  => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return expect_eq(b.y, 40);
}
