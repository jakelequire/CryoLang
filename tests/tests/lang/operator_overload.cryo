///! Operator traits (`core::ops`): user `Deref` / `Index` impls.
///!
///! v1.0 ships the `Deref<Target>` trait with its explicit `.deref()`
///! method (`*` sugar is a documented post-1.0 follow-up), so the `Deref`
///! tests call the method directly. The `Index<Idx, Output>` trait now has
///! full `[]` operator sugar: `a[i]` desugars to `*(a.index(i))`, which is a
///! place, so it works as a read, a write target, and a compound-assignment
///! target. The tests pin the sugar (read/write/compound, generic and
///! bounded-param dispatch) alongside the direct-method contract that the
///! returned pointer aliases the receiver's storage in place.

![config(testing)]
namespace CryoTests::Tests::Lang::OperatorOverload;

import std::core::result;
import std::core::ops;
import std::test::error;
import std::test::assert;

// A minimal smart-pointer-like wrapper implementing Deref.
type struct Boxed { value: i32; }

implement trait Deref<i32> for Boxed {
    deref(&this) -> i32* {
        return &this.value;
    }
}

// Resolve `.deref()` through the `Deref` bound rather than the bare global
// method name: bound-directed resolution is unambiguous and also dodges
// the unrelated struct also named `Deref` in another test module.
function deref_ptr<T, U>(x: &T) -> U* where T: Deref<U> {
    return x.deref();
}

// A fixed 3-slot container implementing Index.
type struct Triple {
    a: i32;
    b: i32;
    c: i32;
}

implement trait Index<u64, i32> for Triple {
    index(&this, idx: u64) -> i32* {
        if (idx == 0u64) { return &this.a; }
        if (idx == 1u64) { return &this.b; }
        return &this.c;
    }
}

![test]
function deref_returns_pointer_to_value() -> Result<(), TestError> {
    const b: Boxed = Boxed { value: 41 };
    const p: i32* = deref_ptr(&b);
    return expect_eq(*p, 41);
}

// The Deref pointer aliases the receiver in place: writing through it
// mutates the original `Boxed`.
![test]
function deref_pointer_aliases_in_place() -> Result<(), TestError> {
    mut b: Boxed = Boxed { value: 1 };
    const p: i32* = deref_ptr(&b);
    *p = 100;
    return expect_eq(b.value, 100);
}

![test]
function index_reads_each_slot() -> Result<(), TestError> {
    const t: Triple = Triple { a: 10, b: 20, c: 30 };
    const p0: i32* = t.index(0u64);
    const p1: i32* = t.index(1u64);
    const p2: i32* = t.index(2u64);
    match (expect_eq(*p0, 10)) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    match (expect_eq(*p1, 20)) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return expect_eq(*p2, 30);
}

// The Index pointer aliases the receiver in place.
![test]
function index_pointer_aliases_in_place() -> Result<(), TestError> {
    mut t: Triple = Triple { a: 1, b: 2, c: 3 };
    const p: i32* = t.index(1u64);
    *p = 99;
    return expect_eq(t.b, 99);
}

// A container whose `index` bumps a counter, so a compound assignment that
// evaluated the LHS place twice would show `calls == 2`.
type struct Counted {
    slot:  i32;
    calls: i32;
}

implement trait Index<i64, i32> for Counted {
    index(mut &this, idx: i64) -> i32* {
        this.calls = this.calls + 1;
        return &this.slot;
    }
}

// A generic container: exercises the mono/cloner/substituter descent into the
// index desugar so `Wrap<i32>::index` gets specialized.
type struct Wrap<T> {
    x: T;
    y: T;
}

implement<T> trait Index<i64, T> for struct Wrap<T> {
    index(&this, idx: i64) -> T* {
        if (idx == 0) { return &this.x; }
        return &this.y;
    }
}

// `c[i]` on a generic param bounded by `Index` (Phase 2). Triple is all-scalar,
// so passing it by value is a plain copy.
function get_at<T>(c: T, i: u64) -> i32 where T: Index<u64, i32> {
    return c[i];
}

// `[]` sugar as a read: `t[i]` desugars to `*(t.index(i))`.
![test]
function index_sugar_reads() -> Result<(), TestError> {
    const t: Triple = Triple { a: 10, b: 20, c: 30 };
    match (expect_eq(t[0u64], 10)) {
        Result::Ok(_)  => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    match (expect_eq(t[1u64], 20)) {
        Result::Ok(_)  => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return expect_eq(t[2u64], 30);
}

// `[]` sugar as a write target: the desugar `*(t.index(i))` is a place.
![test]
function index_sugar_writes() -> Result<(), TestError> {
    mut t: Triple = Triple { a: 1, b: 2, c: 3 };
    t[1u64] = 99;
    return expect_eq(t.b, 99);
}

// Compound assignment through `[]` calls `index` exactly once.
![test]
function index_sugar_compound_once() -> Result<(), TestError> {
    mut c: Counted = Counted { slot: 5, calls: 0 };
    c[0] += 7;
    match (expect_eq(c.slot, 12)) {
        Result::Ok(_)  => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return expect_eq(c.calls, 1);
}

// Generic container: `[]` sugar reads and writes through a specialized
// `Wrap<i32>::index`.
![test]
function index_sugar_generic() -> Result<(), TestError> {
    mut w: Wrap<i32> = Wrap<i32> { x: 100, y: 200 };
    match (expect_eq(w[0], 100)) {
        Result::Ok(_)  => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    w[1] = 250;
    return expect_eq(w.y, 250);
}

// `[]` on a generic param bounded by `Index`.
![test]
function index_sugar_bounded_param() -> Result<(), TestError> {
    const t: Triple = Triple { a: 7, b: 8, c: 9 };
    return expect_eq(get_at(t, 2u64), 9);
}
