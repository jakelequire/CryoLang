///! `static match` - compile-time type dispatch inside a generic body.
///!
///! Each `static match (T) { <type> => <body> ... }` is resolved at
///! monomorphization time: the arm whose type equals the concrete `T` is
///! kept and every other arm is pruned before type-checking, so an arm only
///! has to type-check for the `T` it serves.  These tests confirm the right
///! arm is selected for several concrete instantiations, in both expression
///! and statement position, and that a `_` default arm catches the rest.

![config(testing)]
namespace CryoTests::Tests::Lang::StaticMatch;

import std::core::result;
import std::test::error;
import std::test::assert;

/// Dispatches a per-type integer code via a `static match` expression, plus a
/// `static match` STATEMENT that writes a per-type byte into a field.
type struct Tag<T> {
    value: T;
    mark:  u8;

    static new(v: T) -> Tag<T> {
        return Tag<T> { value: v, mark: 0 };
    }

    /// Expression-position static match: yields the arm's value as the return.
    kind_code(&this) -> i32 {
        return static match (T) {
            u8      => { 8 }
            u32     => { 32 }
            i64     => { 64 }
            boolean => { 1 }
            _       => { 0 }
        };
    }

    /// Statement-position static match: no value, just a side effect.
    set_mark(mut &this) -> void {
        static match (T) {
            u8      => { this.mark = 1; }
            u32     => { this.mark = 2; }
            i64     => { this.mark = 3; }
            boolean => { this.mark = 4; }
            _       => { this.mark = 9; }
        }
    }
}

![test]
function static_match_expr_u32() -> Result<(), TestError> {
    mut t: Tag<u32> = Tag<u32>::new(5);
    const c: i32 = t.kind_code();
    match (expect_eq(c, 32)) {
        Result::Ok(_)  => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

![test]
function static_match_expr_u8() -> Result<(), TestError> {
    mut t: Tag<u8> = Tag<u8>::new(3);
    match (expect_eq(t.kind_code(), 8)) {
        Result::Ok(_)  => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

![test]
function static_match_expr_i64() -> Result<(), TestError> {
    mut t: Tag<i64> = Tag<i64>::new(9);
    match (expect_eq(t.kind_code(), 64)) {
        Result::Ok(_)  => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

![test]
function static_match_expr_boolean() -> Result<(), TestError> {
    mut t: Tag<boolean> = Tag<boolean>::new(true);
    match (expect_eq(t.kind_code(), 1)) {
        Result::Ok(_)  => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

![test]
function static_match_wildcard_default() -> Result<(), TestError> {
    // f32 matches no explicit arm, so the `_` default (0) is selected.
    mut t: Tag<f32> = Tag<f32>::new(1.5 as f32);
    match (expect_eq(t.kind_code(), 0)) {
        Result::Ok(_)  => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

![test]
function static_match_statement_side_effect() -> Result<(), TestError> {
    mut a: Tag<u32> = Tag<u32>::new(0);
    a.set_mark();
    mut b: Tag<i64> = Tag<i64>::new(0);
    b.set_mark();
    match (expect_eq(a.mark as i32, 2)) {
        Result::Ok(_)  => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    match (expect_eq(b.mark as i32, 3)) {
        Result::Ok(_)  => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}


/// `static match` over a METHOD's OWN generic param (not the owner's). The
/// owner is non-generic, so each `m<T>` spec exists only because a call site
/// demands it; the monomorphizer prunes each spec body to its live arm and
/// gives it a distinct mangled symbol even when the method's SIGNATURE doesn't
/// mention `T` (`code<T>() -> i32`), so coexisting instantiations don't collapse
/// onto the first.
type struct MethodTag {
    marker: u8;

    static new() -> MethodTag {
        return MethodTag { marker: 0 };
    }

    /// Return type (`i32`) does NOT depend on `T`: every spec shares a
    /// signature, so only the method type args disambiguate the symbols.
    code<T>(&this) -> i32 {
        return static match (T) {
            u8      => { 8 }
            u32     => { 32 }
            i64     => { 64 }
            boolean => { 1 }
            _       => { 0 }
        };
    }

    /// Return type IS `T`: exercises a method-level static match whose live arm
    /// yields a `T`-typed value.
    zero<T>(&this) -> T {
        return static match (T) {
            i64 => { 0 }
            u32 => { 0 }
            _   => { 0 as T }
        };
    }
}

![test]
function method_static_match_coexisting_codes() -> Result<(), TestError> {
    // All four instantiations coexist in one program: the regression guard for
    // the spec-mangle collision (each `code<T>` must keep its own body).
    const d: MethodTag = MethodTag::new();
    match (expect_eq(d.code<u8>(), 8)) {
        Result::Ok(_)  => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    match (expect_eq(d.code<u32>(), 32)) {
        Result::Ok(_)  => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    match (expect_eq(d.code<i64>(), 64)) {
        Result::Ok(_)  => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    match (expect_eq(d.code<boolean>(), 1)) {
        Result::Ok(_)  => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

![test]
function method_static_match_wildcard_default() -> Result<(), TestError> {
    // f32 hits no explicit arm -> the `_` default (0).
    const d: MethodTag = MethodTag::new();
    match (expect_eq(d.code<f32>(), 0)) {
        Result::Ok(_)  => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

![test]
function method_static_match_return_is_t() -> Result<(), TestError> {
    const d: MethodTag = MethodTag::new();
    const a: i64 = d.zero<i64>();
    const b: u32 = d.zero<u32>();
    match (expect_eq(a, 0i64)) {
        Result::Ok(_)  => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    match (expect_eq(b, 0u32)) {
        Result::Ok(_)  => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}


/// Multi-pattern arms: several `|`-separated types share one body. An arm is
/// live if the concrete `T` equals ANY of its listed types (same `|` alternation
/// as a regular match arm). Groups here overlap none, and a `_` catches the rest.
type struct GroupTag {
    static new() -> GroupTag { return GroupTag { }; }

    /// One body per group of types. `u16`, `u64` (etc.) all land on the unsigned
    /// arm; `i32` on the signed arm; `f32`/`f64` on the float arm; anything else
    /// (e.g. `boolean`) falls through to the wildcard.
    group<T>(&this) -> i32 {
        return static match (T) {
            u8 | u16 | u32 | u64 => { 1 }
            i8 | i16 | i32 | i64 => { 2 }
            f32 | f64            => { 3 }
            _                    => { 0 }
        };
    }
}

![test]
function static_match_multi_pattern_arm() -> Result<(), TestError> {
    const g: GroupTag = GroupTag::new();
    // Different members of the SAME arm all select that arm's body.
    match (expect_eq(g.group<u16>(), 1)) { Result::Ok(_) => { } Result::Err(e) => { return Result::Err(e); } }
    match (expect_eq(g.group<u64>(), 1)) { Result::Ok(_) => { } Result::Err(e) => { return Result::Err(e); } }
    match (expect_eq(g.group<i32>(), 2)) { Result::Ok(_) => { } Result::Err(e) => { return Result::Err(e); } }
    match (expect_eq(g.group<f32>(), 3)) { Result::Ok(_) => { } Result::Err(e) => { return Result::Err(e); } }
    match (expect_eq(g.group<f64>(), 3)) { Result::Ok(_) => { } Result::Err(e) => { return Result::Err(e); } }
    // A type in NO group falls to the wildcard.
    match (expect_eq(g.group<boolean>(), 0)) { Result::Ok(_) => { } Result::Err(e) => { return Result::Err(e); } }
    return Result::Ok(());
}
