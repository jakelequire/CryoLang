///! Struct-related tests - value types, fields, methods (`&this`/`mut &this`).

![config(testing)]
namespace CryoTests::Tests::Lang::Structs;

import std::core::result;
import std::test::error;
import std::test::assert;

type struct Point {
    x: i32;
    y: i32;

    static origin() -> Point {
        return Point { x: 0, y: 0 };
    }

    static at(x: i32, y: i32) -> Point {
        return Point { x: x, y: y };
    }

    /// Borrowed-immutable receiver.
    sum_of_axes(&this) -> i32 {
        return this.x + this.y;
    }

    /// Borrowed-mutable receiver.
    translate(mut &this, dx: i32, dy: i32) -> void {
        this.x = this.x + dx;
        this.y = this.y + dy;
    }
}

![test]
function struct_construction() -> Result<(), TestError> {
    const p: Point = Point { x: 3, y: 4 };
    match (expect_eq(p.x, 3)) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    match (expect_eq(p.y, 4)) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

![test]
function static_factory() -> Result<(), TestError> {
    const origin: Point = Point::origin();
    match (expect_eq(origin.x, 0)) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    match (expect_eq(origin.y, 0)) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

![test]
function static_factory_with_args() -> Result<(), TestError> {
    const p: Point = Point::at(7, 11);
    match (expect_eq(p.x, 7)) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    match (expect_eq(p.y, 11)) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

![test]
function immutable_method_call() -> Result<(), TestError> {
    const p: Point = Point::at(3, 4);
    match (expect_eq(p.sum_of_axes(), 7)) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

![test]
function mutable_method_modifies_state() -> Result<(), TestError> {
    mut p: Point = Point::at(1, 2);
    p.translate(10, 20);
    match (expect_eq(p.x, 11)) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    match (expect_eq(p.y, 22)) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

![test]
function nested_method_chain() -> Result<(), TestError> {
    mut p: Point = Point::at(5, 5);
    p.translate(-2, 3);
    // After translate: x=3, y=8 -> sum=11
    match (expect_eq(p.sum_of_axes(), 11)) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}
