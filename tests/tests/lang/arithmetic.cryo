///! Language tests - integer arithmetic, widening, mixed-precision ops.
///!
///! Covers the operators every other module quietly depends on. If
///! these break, every other test in the suite is suspect.

![config(testing)]
namespace CryoTests::Tests::Lang::Arithmetic;

import std::core::result;
import std::collections::str;
import std::test::error;
import std::test::assert;

![test]
function add_basic() -> Result<(), TestError> {
    match (expect_eq(2 + 2, 4)) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

![test]
function sub_basic() -> Result<(), TestError> {
    match (expect_eq(10 - 7, 3)) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

![test]
function mul_basic() -> Result<(), TestError> {
    match (expect_eq(6 * 7, 42)) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

![test]
function div_truncates() -> Result<(), TestError> {
    // Integer division truncates toward zero.
    match (expect_eq(7 / 2, 3)) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

![test]
function mod_basic() -> Result<(), TestError> {
    match (expect_eq(17 % 5, 2)) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

![test]
function negative_arithmetic() -> Result<(), TestError> {
    const x: i32 = -5;
    const y: i32 = 3;
    match (expect_eq(x + y, -2)) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

![test]
function precedence_holds() -> Result<(), TestError> {
    // Multiplication binds tighter than addition.
    match (expect_eq(2 + 3 * 4, 14)) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

![test]
function parens_override_precedence() -> Result<(), TestError> {
    match (expect_eq((2 + 3) * 4, 20)) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

![test]
function u64_arithmetic() -> Result<(), TestError> {
    const a: u64 = 1000;
    const b: u64 = 2500;
    const got: u64 = a + b;
    const want: u64 = 3500;
    match (expect_eq(got, want)) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

![test]
function compound_increment() -> Result<(), TestError> {
    mut counter: i32 = 0;
    counter = counter + 1;
    counter = counter + 1;
    counter = counter + 1;
    match (expect_eq(counter, 3)) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

// Compound assignment operators (`+=`, `-=`, `*=`, `/=`, `%=`, `&=`, `|=`,
// `^=`, `<<=`, `>>=`).  Pins the codegen path: the bitwise and shift forms
// must not fall through to the regular-binary path (which produces an
// expression result with no store, making `x &= 5` a no-op), and `^=` must
// parse (the lexer must produce CaretEqual).
![test]
function compound_arith_ops() -> Result<(), TestError> {
    mut a: i32 = 12;
    a += 5;
    match (expect_eq(a, 17)) { Result::Ok(_) => {} Result::Err(e) => { return Result::Err(e); } }

    mut b: i32 = 12;
    b -= 5;
    match (expect_eq(b, 7)) { Result::Ok(_) => {} Result::Err(e) => { return Result::Err(e); } }

    mut c: i32 = 12;
    c *= 5;
    match (expect_eq(c, 60)) { Result::Ok(_) => {} Result::Err(e) => { return Result::Err(e); } }

    mut d: i32 = 12;
    d /= 5;
    match (expect_eq(d, 2)) { Result::Ok(_) => {} Result::Err(e) => { return Result::Err(e); } }

    mut e: i32 = 12;
    e %= 5;
    match (expect_eq(e, 2)) { Result::Ok(_) => {} Result::Err(e) => { return Result::Err(e); } }

    return Result::Ok(());
}

![test]
function compound_bitwise_ops() -> Result<(), TestError> {
    mut a: i32 = 12;
    a &= 10;
    match (expect_eq(a, 8)) { Result::Ok(_) => {} Result::Err(e) => { return Result::Err(e); } }

    mut b: i32 = 12;
    b |= 5;
    match (expect_eq(b, 13)) { Result::Ok(_) => {} Result::Err(e) => { return Result::Err(e); } }

    mut c: i32 = 12;
    c ^= 10;
    match (expect_eq(c, 6)) { Result::Ok(_) => {} Result::Err(e) => { return Result::Err(e); } }

    return Result::Ok(());
}

![test]
function compound_shift_ops() -> Result<(), TestError> {
    mut a: i32 = 1;
    a <<= 4;
    match (expect_eq(a, 16)) { Result::Ok(_) => {} Result::Err(e) => { return Result::Err(e); } }

    mut b: i32 = 64;
    b >>= 3;
    match (expect_eq(b, 8)) { Result::Ok(_) => {} Result::Err(e) => { return Result::Err(e); } }

    return Result::Ok(());
}

// Compound assigns must work against field and index targets, not just
// plain locals.  The field/index lvalue path goes through codegen_lvalue
// rather than the direct identifier addr, so it exercises a different
// branch of the compound-assign codegen.
![test]
function compound_field_and_index_targets() -> Result<(), TestError> {
    mut buf: i32[] = [1, 2, 4];
    buf[0] += 10;
    buf[1] *= 3;
    buf[2] <<= 2;
    match (expect_eq(buf[0], 11)) { Result::Ok(_) => {} Result::Err(e) => { return Result::Err(e); } }
    match (expect_eq(buf[1], 6))  { Result::Ok(_) => {} Result::Err(e) => { return Result::Err(e); } }
    match (expect_eq(buf[2], 16)) { Result::Ok(_) => {} Result::Err(e) => { return Result::Err(e); } }
    return Result::Ok(());
}

// -- Mixed-type numeric operands -------------------------------------------
//
// Two operands of DIFFERENT numeric types: the narrower converts up to the
// wider. These all reached LLVM unconverted and failed module verification
// outright - `fadd float, double`, `add i32, float` - naming no user construct,
// so the whole class read as a compiler crash rather than a type error.
// Widening warns (W0005) that it will one day require an explicit `as`;
// narrowing is already an error and is not exercised here.

![test]
function mixed_float_widths_add() -> Result<(), TestError> {
    mut a: f32 = 1.5;
    mut b: f64 = 2.25;
    const sum: f64 = a + b;
    return expect_close_f64(sum, 3.75, 0.0000001);
}

// The result type is `bool` for a comparison, so it cannot say whether this is
// float arithmetic; only the operands can.
![test]
function mixed_float_widths_compare() -> Result<(), TestError> {
    mut a: f32 = 1.5;
    mut b: f64 = 2.25;
    return expect(a <= b, Str::new("f32 <= f64"));
}

// Int-FIRST ordering is the case that exposed the cause: codegen read the
// operation's type off the LEFT operand, so this selected the integer `add`
// with a float operand.
![test]
function int_then_float_uses_float_opcode() -> Result<(), TestError> {
    mut n: i32 = 3;
    mut f: f32 = 0.5;
    const r: f32 = n + f;
    return expect_close_f64(r as f64, 3.5, 0.0001);
}

![test]
function float_then_int_widens() -> Result<(), TestError> {
    mut f: f32 = 0.5;
    mut n: i32 = 3;
    const r: f32 = f + n;
    return expect_close_f64(r as f64, 3.5, 0.0001);
}

// An unsigned operand converts by its OWN signedness. Reading this u8 as signed
// would make 200 into -56 - a changed value, not a changed representation.
![test]
function unsigned_operand_converts_unsigned() -> Result<(), TestError> {
    mut u: u8 = 200;
    mut f: f32 = 0.5;
    const r: f32 = u + f;
    return expect_close_f64(r as f64, 200.5, 0.0001);
}

// An integer literal against a float operand converts the same way.
![test]
function integer_literal_against_float_operand() -> Result<(), TestError> {
    mut f: f32 = 1.5;
    const r: f32 = f + 2;
    return expect_close_f64(r as f64, 3.5, 0.0001);
}
