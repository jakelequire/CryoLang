///! Classes — heap allocation, single inheritance, virtual dispatch.

![config(testing)]
namespace CryoTests::Tests::Lang::Classes;

import std::core::result;
import std::test::error;
import std::test::assert;

type class Counter {
public:
    value: i32;

    Counter(start: i32) {
        this.value = start;
    }

    get(&this) -> i32 { return this.value; }

    bump(mut &this) -> void {
        this.value = this.value + 1;
    }
}

![test]
function class_constructs_on_heap() -> Result<(), TestError> {
    const c: Counter* = new Counter(10);
    match (expect_eq(c.get(), 10)) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

![test]
function class_mutating_method() -> Result<(), TestError> {
    mut c: Counter* = new Counter(0);
    c.bump();
    c.bump();
    c.bump();
    match (expect_eq(c.get(), 3)) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

// Inheritance + virtual dispatch.
type class Shape {
public:
    Shape() {}

    virtual area(&this) -> i32 {
        return 0;
    }

    virtual kind(&this) -> i32 {
        // 0 = generic shape
        return 0;
    }
}

type class Square : Shape {
public:
    side: i32;

    Square(s: i32) : Shape() {
        this.side = s;
    }

    override area(&this) -> i32 {
        return this.side * this.side;
    }

    override kind(&this) -> i32 {
        return 1;
    }
}

type class Rectangle : Shape {
public:
    w: i32;
    h: i32;

    Rectangle(w: i32, h: i32) : Shape() {
        this.w = w;
        this.h = h;
    }

    override area(&this) -> i32 {
        return this.w * this.h;
    }

    override kind(&this) -> i32 {
        return 2;
    }
}

/// Dispatch through a base-class pointer — runs the most-derived
/// `area`/`kind` overrides.
function area_through_base(s: Shape*) -> i32 {
    return s.area();
}

function kind_through_base(s: Shape*) -> i32 {
    return s.kind();
}

![test]
function virtual_area_square() -> Result<(), TestError> {
    const sq: Square* = new Square(5);
    match (expect_eq(area_through_base(sq), 25)) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

![test]
function virtual_area_rectangle() -> Result<(), TestError> {
    const r: Rectangle* = new Rectangle(3, 7);
    match (expect_eq(area_through_base(r), 21)) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

![test]
function virtual_kind_dispatch() -> Result<(), TestError> {
    const sq: Square* = new Square(2);
    const r: Rectangle* = new Rectangle(2, 4);
    match (expect_eq(kind_through_base(sq), 1)) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    match (expect_eq(kind_through_base(r), 2)) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

![test]
function direct_dispatch_on_subclass() -> Result<(), TestError> {
    // Calling on the concrete pointer directly — also goes through
    // the virtual table, same answer.
    const sq: Square* = new Square(4);
    match (expect_eq(sq.area(), 16)) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

// Inherited (non-virtual) field access.
type class Named {
public:
    id: i32;

    Named(id: i32) {
        this.id = id;
    }
}

type class WithExtra : Named {
public:
    extra: i32;

    WithExtra(id: i32, extra: i32) : Named(id) {
        this.extra = extra;
    }
}

![test]
function inherited_field_visible() -> Result<(), TestError> {
    const w: WithExtra* = new WithExtra(7, 100);
    match (expect_eq(w.id, 7)) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    match (expect_eq(w.extra, 100)) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

// Regression for a silent miscompile (audit 2026-05-26): a class
// literal whose field list named an INHERITED field used to silently
// drop the corresponding store, leaving the field uninitialised.
// Root cause: codegen_struct_literal scanned only the leaf class's
// own fields and `continue`d on misses for ancestor field names.
// Fix: walk the inheritance chain when building the field/slot map.
type class LitBase {
public:
    a: i32;
}

type class LitDerived : LitBase {
public:
    b: i32;
}

function make_lit_derived() -> LitDerived {
    return LitDerived { a: 100, b: 200 };
}

![test]
function class_literal_inits_inherited_field() -> Result<(), TestError> {
    const d: LitDerived = make_lit_derived();
    match (expect_eq(d.a, 100)) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    match (expect_eq(d.b, 200)) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

// Regression for a silent miscompile (audit 2026-05-26): a value
// instantiation of a class with virtual methods used to leave slot 0
// (the vtable pointer) uninitialised, so the first virtual call read
// poison and crashed.  Fix: codegen_struct_literal stores the vtable
// global into slot 0 when the class's chain has virtual methods,
// mirroring the heap-`new` path in new_delete_emitter.
type class LitVBase {
public:
    a: i32;

    LitVBase() { this.a = 0; }

    virtual report(&this) -> i32 { return this.a; }
}

function make_lit_vbase() -> LitVBase {
    return LitVBase { a: 99 };
}

![test]
function class_literal_inits_vtable_for_value_construction() -> Result<(), TestError> {
    const b: LitVBase = make_lit_vbase();
    // If the vtable slot were poison this call would SIGSEGV.
    match (expect_eq(b.report(), 99)) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}
