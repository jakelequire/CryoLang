///! `null` coerces to `string`.  `string` is pointer-shaped (i8* at the
///! LLVM level), so the C-style universal-pointer rule applies to it
///! exactly as to any `T*`: the `null` literal (typed `void*`) assigns
///! to, initializes, returns as, and compares with a `string` without a
///! cast.  Before this rule landed, every such site needed the
///! `null as string` idiom.

![config(testing)]
namespace CryoTests::Tests::Lang::NullStringCoercion;

import std::core::result;
import std::collections::str;
import std::test::error;
import std::test::assert;

type struct NscHolder {
    label: string;
}

function nsc_returns_null() -> string {
    return null;
}

![test]
function null_assigns_to_string_local() -> Result<(), TestError> {
    const s: string = null;
    return expect_true(s == null, Str::new("null-initialized string should compare == null"));
}

![test]
function null_initializes_string_field() -> Result<(), TestError> {
    const h: NscHolder = NscHolder { label: null };
    return expect_true(h.label == null, Str::new("null struct-literal string field should compare == null"));
}

![test]
function null_returned_as_string() -> Result<(), TestError> {
    const s: string = nsc_returns_null();
    return expect_true(s == null, Str::new("string function returning null should yield null"));
}

![test]
function null_string_reassignment_and_flow() -> Result<(), TestError> {
    mut s: string = "live";
    s = null;
    if (s != null) {
        return expect_true(false, Str::new("string reassigned to null should be null"));
    }
    s = "again";
    return expect_true(s != null, Str::new("string reassigned from null should be non-null"));
}
