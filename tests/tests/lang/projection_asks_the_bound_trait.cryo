///! `S::Item` under `where S: Source` is `Source`'s `Item`, whatever else the
///! type implements.  Both types here also implement `Iterator`, whose
///! associated type is spelled `Item` too; a projection that took the first
///! trait declaring something spelled `Item` read `Iterator`'s (`i32`) and
///! refused `s.get()` (`i64`).  One impl binds `Item` positionally, the other
///! in its body - both are the bound trait's.

![config(testing)]
namespace CryoTests::Tests::Lang::ProjectionAsksTheBoundTrait;

import std::core::result;
import std::core::result::{ Result };
import std::core::option;
import std::core::option::{ Option };
import std::core::iter;
import std::core::iter::{ Iterator };
import std::test::error;
import std::test::error::{ TestError };
import std::test::assert;
import std::test::assert::{ expect_eq };

type trait Source {
    type Item;
    get(&this) -> This::Item;
}

type struct Positional {
    v: i64;
}

implement trait Iterator<i32> for struct Positional {
    next(mut &this) -> Option<i32> { return Option::None; }
}

implement trait Source<i64> for struct Positional {
    get(&this) -> i64 { return this.v; }
}

type struct InBody {
    v: i64;
}

implement trait Iterator<i32> for struct InBody {
    next(mut &this) -> Option<i32> { return Option::None; }
}

implement trait Source for struct InBody {
    type Item = i64;
    get(&this) -> i64 { return this.v; }
}

function take<S>(s: &S) -> i64 where S: Source {
    const v: S::Item = s.get();
    return v;
}

![test]
function positional_binding_is_the_bound_traits() -> Result<(), TestError> {
    const p: Positional = Positional { v: 5000000000 };
    return expect_eq(take::<Positional>(&p), 5000000000);
}

![test]
function body_binding_is_the_bound_traits() -> Result<(), TestError> {
    const b: InBody = InBody { v: 6000000000 };
    return expect_eq(take::<InBody>(&b), 6000000000);
}
