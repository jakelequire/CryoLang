///! Regression mirror of `leaf_scope_use_a.cryo`: imports only `LeafScopeDefnB`,
///! so bare `Beacon` (type annotation + `Beacon::make()` static-call scope) must
///! resolve to `LeafScopeDefnB::Beacon` (signal 200) despite the same-leaf
///! `LeafScopeDefnA::Beacon` (signal 100) in the same build.  Paired with
///! `leaf_scope_use_a`, this guarantees a pre-fix failure regardless of which
///! same-leaf type the old last-write-wins map happened to pick.

![config(testing)]
namespace CryoTests::Tests::Lang::LeafScopeUseB;

import std::core::result;
import std::test::error;
import std::test::assert;

import CryoTests::Tests::Lang::LeafScopeDefnB;

![test]
function bare_beacon_resolves_to_imported_module_b() -> Result<(), TestError> {
    const b: Beacon = Beacon::make();
    return expect_eq(b.signal(), 200);
}
