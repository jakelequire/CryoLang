// Inside a generic body a call's arguments are checked with each type
// parameter one type: a `T` passed where a callee instantiated at `T`
// takes a `T`, and a `T` pushed onto the body's `Array<T>` through `get`,
// whose `where T: Copy` the body's bounds give.
![config(testing)]
namespace CryoTests::Tests::Lang::GenericBodyCallArgs;

import std::core::result;
import std::core::result::{ Result };
import std::test::error;
import std::test::error::{ TestError };
import std::test::assert;
import std::test::assert::{ expect_eq };

function id<U>(x: U) -> U { return x; }

function first_through_id<T>(xs: &Array<T>, fallback: T) -> T where T: Copy {
    return id::<T>(xs.get(0).unwrap_or(fallback));
}

function dup_first<T>(xs: mut &Array<T>) -> void where T: Copy {
    match (xs.get(0)) {
        Option::Some(v) => { xs.push(v); }
        Option::None    => { }
    }
}

![test]
function turbofish_call_takes_the_param() -> Result<(), TestError> {
    mut xs: Array<i32> = Array::<i32>::new();
    xs.push(5);
    return expect_eq(first_through_id::<i32>(&xs, 0) as i64, 5);
}

![test]
function push_takes_the_element() -> Result<(), TestError> {
    mut xs: Array<i64> = Array::<i64>::new();
    xs.push(7);
    dup_first::<i64>(&xs);
    return expect_eq(xs.get(1).unwrap_or(0), 7);
}
