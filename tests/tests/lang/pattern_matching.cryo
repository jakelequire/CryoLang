///! Pattern matching - variant binding, wildcard, nested match, payload
///! destructuring.

![config(testing)]
namespace CryoTests::Tests::Lang::PatternMatching;

import std::core::result;
import std::core::option;
import std::test::error;
import std::test::assert;

type enum Token {
    Number(i32);
    Plus;
    Minus;
    EndOfInput;
}

implement enum Token {
    /// Encode the variant as an integer for cross-checking the match.
    /// Number → its payload; Plus → -1; Minus → -2; EndOfInput → -99.
    encode(&this) -> i32 {
        match (&this) {
            Token::Number(n)   => { return n; }
            Token::Plus        => { return -1; }
            Token::Minus       => { return -2; }
            Token::EndOfInput  => { return -99; }
        }
    }
}

![test]
function match_binds_payload() -> Result<(), TestError> {
    const t: Token = Token::Number(42);
    match (expect_eq(t.encode(), 42)) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

![test]
function match_unit_variant() -> Result<(), TestError> {
    const t: Token = Token::Plus;
    match (expect_eq(t.encode(), -1)) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

![test]
function match_eof_variant() -> Result<(), TestError> {
    const t: Token = Token::EndOfInput;
    match (expect_eq(t.encode(), -99)) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

// Match on a value with multiple-payload variants.
type enum BinOp {
    Add(i32, i32);
    Sub(i32, i32);
    Mul(i32, i32);
    Const(i32);
}

implement enum BinOp {
    eval(&this) -> i32 {
        match (&this) {
            BinOp::Add(a, b) => { return a + b; }
            BinOp::Sub(a, b) => { return a - b; }
            BinOp::Mul(a, b) => { return a * b; }
            BinOp::Const(v)  => { return v;     }
        }
    }
}

![test]
function multi_payload_add() -> Result<(), TestError> {
    const op: BinOp = BinOp::Add(3, 4);
    match (expect_eq(op.eval(), 7)) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

![test]
function multi_payload_sub() -> Result<(), TestError> {
    const op: BinOp = BinOp::Sub(10, 3);
    match (expect_eq(op.eval(), 7)) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

![test]
function multi_payload_mul() -> Result<(), TestError> {
    const op: BinOp = BinOp::Mul(6, 7);
    match (expect_eq(op.eval(), 42)) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

![test]
function single_payload_const() -> Result<(), TestError> {
    const op: BinOp = BinOp::Const(99);
    match (expect_eq(op.eval(), 99)) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

// Nested match - outer Option<Inner>, inner enum.
type enum Sign {
    Pos;
    Neg;
    Zero;
}

function classify(value: Option<i32>) -> Sign {
    match (&value) {
        Option::None => { return Sign::Zero; }
        Option::Some(n) => {
            if (n > 0) { return Sign::Pos; }
            if (n < 0) { return Sign::Neg; }
            return Sign::Zero;
        }
    }
}

![test]
function nested_match_pos() -> Result<(), TestError> {
    const r: Sign = classify(Option::Some(7));
    const code: i32 = match (r) {
        Sign::Pos  => { 1 }
        Sign::Neg  => { -1 }
        Sign::Zero => { 0 }
    };
    match (expect_eq(code, 1)) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

![test]
function nested_match_neg() -> Result<(), TestError> {
    const r: Sign = classify(Option::Some(-3));
    const code: i32 = match (r) {
        Sign::Pos  => { 1 }
        Sign::Neg  => { -1 }
        Sign::Zero => { 0 }
    };
    match (expect_eq(code, -1)) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

![test]
function nested_match_none() -> Result<(), TestError> {
    const r: Sign = classify(Option::None);
    const code: i32 = match (r) {
        Sign::Pos  => { 1 }
        Sign::Neg  => { -1 }
        Sign::Zero => { 0 }
    };
    match (expect_eq(code, 0)) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

// Discard payload with `_`.
![test]
function wildcard_in_payload() -> Result<(), TestError> {
    const t: Token = Token::Number(123);
    const tag: i32 = match (&t) {
        Token::Number(_)  => { 1 }
        Token::Plus       => { 2 }
        Token::Minus      => { 3 }
        Token::EndOfInput => { 4 }
    };
    match (expect_eq(tag, 1)) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

// Match used as a statement (each arm is a block).
![test]
function match_as_statement_runs_arm() -> Result<(), TestError> {
    mut counter: i32 = 0;
    const t: Token = Token::Plus;
    match (&t) {
        Token::Plus  => { counter = counter + 10; }
        Token::Minus => { counter = counter + 100; }
        _            => { counter = counter + 1000; }
    }
    match (expect_eq(counter, 10)) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

// ============================================================================
// Literal patterns - integer, boolean, char
// ============================================================================
//
// A literal pattern records its kind (Integer / Boolean / Char) on the
// PatternNode.  Codegen cannot recover that from the interned text - `0`
// and `'0'` both intern to "0", `true`/`false` to "true"/"false" - so
// without the kind it mis-selects arms: single-digit integer patterns get
// compared as chars (`0` as `'0'` == 48), and every boolean pattern is
// compared against 0.  These tests pin the correct behavior for match
// expressions and statements alike.

function int_lit_expr(n: i32) -> i32 {
    return match (n) {
        0  => { 1000 }
        5  => { 5000 }
        42 => { 4242 }
        _  => { 9999 }
    };
}

![test]
function int_literal_pattern_expr() -> Result<(), TestError> {
    expect_eq(int_lit_expr(0), 1000)?;
    expect_eq(int_lit_expr(5), 5000)?;
    expect_eq(int_lit_expr(42), 4242)?;
    return expect_eq(int_lit_expr(1), 9999);
}

![test]
function int_literal_pattern_stmt() -> Result<(), TestError> {
    const n: i32 = 7;
    mut out: i32 = -1;
    match (n) {
        0 => { out = 1000; }
        7 => { out = 7000; }
        _ => { out = 9999; }
    }
    return expect_eq(out, 7000);
}

function bool_lit_expr(b: boolean) -> i32 {
    return match (b) {
        true  => { 111 }
        false => { 222 }
    };
}

![test]
function bool_literal_pattern() -> Result<(), TestError> {
    expect_eq(bool_lit_expr(true), 111)?;
    return expect_eq(bool_lit_expr(false), 222);
}

function char_lit_expr(c: char) -> i32 {
    return match (c) {
        'a'  => { 1 }
        '0'  => { 2 }
        '\n' => { 3 }
        _    => { 0 }
    };
}

![test]
function char_literal_pattern() -> Result<(), TestError> {
    // `'0'` (the char) must stay distinct from `0` (the integer): both
    // intern to "0", so the pattern's literal kind is what tells them
    // apart.  `'\n'` also exercises escape decoding.
    expect_eq(char_lit_expr('a'), 1)?;
    expect_eq(char_lit_expr('0'), 2)?;
    expect_eq(char_lit_expr('\n'), 3)?;
    return expect_eq(char_lit_expr('z'), 0);
}

// ============================================================================
// String literal patterns
// ============================================================================
//
// A string subject can't be compared with `icmp` - that would compare the
// i8* pointer bits, not the content.  Codegen detects a string-typed subject
// and lowers each string-literal pattern to a `strcmp`-based equality test.
// This is what lets a flag-name dispatch be a `match` instead of a chain of
// `strcmp(name, "...") == 0` ifs.

function str_class_expr(name: string) -> int {
    return match (name) {
        "help"    => { 1 }
        "version" => { 2 }
        "debug"   => { 3 }
        _         => { 99 }
    };
}

![test]
function string_literal_pattern_expr() -> Result<(), TestError> {
    expect_eq(str_class_expr("help"), 1)?;
    expect_eq(str_class_expr("version"), 2)?;
    expect_eq(str_class_expr("debug"), 3)?;
    // A string equal in content but not in identity must still match -
    // confirms content comparison, not pointer comparison.
    const built: string = strcat_two("hel", "p");
    expect_eq(str_class_expr(built), 1)?;
    return expect_eq(str_class_expr("missing"), 99);
}

![test]
function string_literal_pattern_stmt() -> Result<(), TestError> {
    mut out: int = -1;
    const name: string = "beta";
    match (name) {
        "alpha" => { out = 10; }
        "beta"  => { out = 20; }
        _       => { out = 0; }
    }
    return expect_eq(out, 20);
}

// Build a fresh heap string so the subject is not pointer-identical to any
// pattern literal - `str_class_expr` must still match it by content.
function strcat_two(a: string, b: string) -> string {
    const la: u64 = intrinsics::strlen(a);
    const lb: u64 = intrinsics::strlen(b);
    const buf: void* = intrinsics::malloc(la + lb + 1);
    intrinsics::memcpy(buf, a as void*, la);
    intrinsics::memcpy(intrinsics::ptr_add(buf, la), b as void*, lb);
    const tail: i8* = intrinsics::ptr_add(buf, la + lb) as i8*;
    tail[0] = 0 as i8;
    return buf as string;
}

// ============================================================================
// OR-patterns - `a | b => ...`
// ============================================================================
//
// Every alternative in an arm is tested in turn; a hit on any one runs the
// arm.  Each non-final alternative gets its own comparison block so a miss on
// the first still reaches the test for the rest.  Exercised here for string,
// integer, and enum subjects, and for the 3-way `a | b | c` form.

// The motivating case: flag-name dispatch, short and long names in one arm.
function flag_kind(name: string) -> int {
    return match (name) {
        "help" | "h"    => { 1 }
        "version" | "v" => { 2 }
        "output" | "o"  => { 3 }
        "debug"         => { 4 }
        _               => { 99 }
    };
}

![test]
function or_pattern_string() -> Result<(), TestError> {
    expect_eq(flag_kind("help"), 1)?;
    expect_eq(flag_kind("h"), 1)?;        // second alternative must match
    expect_eq(flag_kind("version"), 2)?;
    expect_eq(flag_kind("v"), 2)?;
    expect_eq(flag_kind("o"), 3)?;
    expect_eq(flag_kind("debug"), 4)?;    // single-pattern arm still works
    return expect_eq(flag_kind("zzz"), 99);
}

function int_or_expr(n: i32) -> i32 {
    return match (n) {
        0 | 1 | 2 => { 100 }              // 3-way OR
        7 | 9     => { 200 }
        _         => { 0 }
    };
}

![test]
function or_pattern_int() -> Result<(), TestError> {
    expect_eq(int_or_expr(0), 100)?;
    expect_eq(int_or_expr(1), 100)?;
    expect_eq(int_or_expr(2), 100)?;      // last alternative of a 3-way arm
    expect_eq(int_or_expr(7), 200)?;
    expect_eq(int_or_expr(9), 200)?;
    return expect_eq(int_or_expr(5), 0);
}

![test]
function or_pattern_enum() -> Result<(), TestError> {
    mut out: i32 = -1;
    match (Token::Plus) {
        Token::Plus | Token::Minus => { out = 1; }
        Token::Number(_)           => { out = 2; }
        Token::EndOfInput          => { out = 3; }
    }
    expect_eq(out, 1)?;

    // The second alternative of the OR arm must fire too.
    match (Token::Minus) {
        Token::Plus | Token::Minus => { out = 11; }
        Token::Number(_)           => { out = 12; }
        Token::EndOfInput          => { out = 13; }
    }
    return expect_eq(out, 11);
}


// ============================================================================
// Range patterns: `lo..hi` matches lo <= x <= hi (inclusive), on char and
// integer subjects.  Boundary values (lo and hi themselves) must match; the
// values just outside must not.
// ============================================================================

function char_range_class(c: char) -> i32 {
    return match (c) {
        '0'..'9'                  => { 1 }   // digit
        'a'..'z' | 'A'..'Z' | '_' => { 2 }   // ident-start (range in OR-arm)
        _                         => { 0 }
    };
}

![test]
function char_range_pattern() -> Result<(), TestError> {
    // Inclusive low/high boundaries of '0'..'9'.
    expect_eq(char_range_class('0'), 1)?;
    expect_eq(char_range_class('9'), 1)?;
    expect_eq(char_range_class('5'), 1)?;
    // '/' is 0x2F (just below '0'); ':' is 0x3A (just above '9').
    expect_eq(char_range_class('/'), 0)?;
    expect_eq(char_range_class(':'), 0)?;
    // Range alternatives inside an OR-arm, plus the bare-char alternative.
    expect_eq(char_range_class('a'), 2)?;
    expect_eq(char_range_class('z'), 2)?;
    expect_eq(char_range_class('A'), 2)?;
    expect_eq(char_range_class('Z'), 2)?;
    expect_eq(char_range_class('_'), 2)?;
    return expect_eq(char_range_class('+'), 0);
}

function int_range_bucket(n: i32) -> i32 {
    return match (n) {
        -5..-1 => { 10 }   // negative band (signed compare)
        0      => { 20 }   // bare literal between two ranges
        1..10  => { 30 }
        _      => { 99 }
    };
}

![test]
function int_range_pattern() -> Result<(), TestError> {
    // Negative range, inclusive boundaries.
    expect_eq(int_range_bucket(-5), 10)?;
    expect_eq(int_range_bucket(-1), 10)?;
    expect_eq(int_range_bucket(-6), 99)?;   // just below low bound
    // Bare literal arm wedged between the two ranges.
    expect_eq(int_range_bucket(0), 20)?;
    // Positive range, inclusive boundaries.
    expect_eq(int_range_bucket(1), 30)?;
    expect_eq(int_range_bucket(10), 30)?;
    return expect_eq(int_range_bucket(11), 99); // just above high bound
}

![test]
function range_pattern_as_statement() -> Result<(), TestError> {
    const c: char = 'q';
    mut out: i32 = -1;
    match (c) {
        '0'..'9' => { out = 1; }
        'a'..'z' => { out = 2; }
        _        => { out = 0; }
    }
    return expect_eq(out, 2);
}

function inclusive_range_bucket(n: i32) -> i32 {
    return match (n) {
        0..=9   => { 1 }
        10..=99 => { 2 }
        _       => { 3 }
    };
}

![test]
function inclusive_range_pattern() -> Result<(), TestError> {
    // `..=` is the explicit inclusive range-pattern spelling; both bounds
    // are included, matching the inclusive `..` form.
    expect_eq(inclusive_range_bucket(0), 1)?;
    expect_eq(inclusive_range_bucket(9), 1)?;    // high bound included
    expect_eq(inclusive_range_bucket(10), 2)?;
    expect_eq(inclusive_range_bucket(99), 2)?;   // high bound included
    expect_eq(inclusive_range_bucket(100), 3)?;
    // char inclusive range with `..=`
    mut g: i32 = 0;
    match ('9') {
        '0'..='9' => { g = 1; }
        _         => { g = 0; }
    }
    return expect_eq(g, 1);
}

// Named-constant patterns. A bare identifier in a `match` arm that resolves
// to a `const` is a VALUE pattern (compare the subject against the constant),
// not a catch-all binding. Regression for the bug where every const arm was
// treated as an irrefutable binding, so only the first arm ever ran (e.g.
// `IoError::from_errno` folding every errno to `NotFound`).

const KCODE_A: i32 = 10;
const KCODE_B: i32 = 20;
const KCODE_C: i32 = 30;

function classify_code(code: i32) -> i32 {
    return match (code) {
        KCODE_A => { 1 }
        KCODE_B => { 2 }
        KCODE_C => { 3 }
        _       => { 0 }
    };
}

![test]
function match_named_constants() -> Result<(), TestError> {
    expect_eq(classify_code(10), 1)?;
    expect_eq(classify_code(20), 2)?;   // 2nd arm, not the 1st
    expect_eq(classify_code(30), 3)?;   // 3rd arm
    expect_eq(classify_code(99), 0)?;   // wildcard fall-through
    return Result::Ok(());
}

// A bare identifier that does NOT name a const stays a fresh binding
// (catch-all that captures the subject), not a value comparison.
function bind_or_const(code: i32) -> i32 {
    return match (code) {
        KCODE_A => { 100 }
        other   => { other + 1 }
    };
}

![test]
function match_binding_still_binds() -> Result<(), TestError> {
    expect_eq(bind_or_const(10), 100)?;   // const arm matches
    expect_eq(bind_or_const(41), 42)?;    // binding arm: captures 41, +1
    return Result::Ok(());
}
