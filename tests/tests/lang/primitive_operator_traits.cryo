///! Every primitive type implements the trait of each operator that applies
///! to it natively, with itself as operand and result, so a generic function
///! or method bounded by the trait takes it: the arithmetic traits and `Neg`
///! on the integer and floating-point types, the bitwise and shift traits and
///! `BitNot` on the integer types, `Not` on `boolean`.  The trait methods
///! are callable directly and agree with the operator.

![config(testing)]
namespace CryoTests::Tests::Lang::PrimitiveOperatorTraits;

import std::core::result::{ Result };
import std::core::ops::{
    Add, BitAnd, BitNot, BitOr, BitXor, Div, Mul, Neg, Not, Rem, Shl, Shr, Sub
};
import std::test::error::{ TestError };
import std::test::assert::{ expect_eq };

function sum<T>(xs: &[T], zero: T) -> T where T: Add<T, T> {
    mut total: T = zero;
    for (mut i: i64 = 0; i < xs.length(); i++) {
        total = total + xs[i];
    }
    return total;
}

function arithmetic<T>(a: T, b: T) -> T where T: Sub<T, T>, T: Mul<T, T>, T: Div<T, T>, T: Rem<T, T> {
    return (a - b) * b / b - a % b;
}

function negate<T>(x: T) -> T where T: Neg<T> { return -x; }

function bits<T>(a: T, b: T) -> T where T: BitAnd<T, T>, T: BitOr<T, T>, T: BitXor<T, T> {
    return (a & b) | (a ^ b);
}

function shifted<T>(x: T, by: T) -> T where T: Shl<T, T>, T: Shr<T, T> {
    return (x << by) >> by;
}

function complement<T>(x: T) -> T where T: BitNot<T> { return ~x; }

function invert<T>(x: T) -> T where T: Not<T> { return !x; }

type struct Accumulator {
    count: i64;

    doubled<U>(&this, n: U) -> U where U: Add<U, U> { return n + n; }
}

![test]
function generic_arithmetic_takes_primitives() -> Result<(), TestError> {
    const ints: [i32] = [1, 2, 3, 4];
    const floats: [f64] = [0.5, 1.25];
    expect_eq(sum(&ints, 0), 10)?;
    expect_eq(sum(&floats, 0.0), 1.75)?;
    expect_eq(arithmetic(17 as u64, 5 as u64), 10 as u64)?;
    expect_eq(arithmetic(-7 as i8, 2 as i8), -8 as i8)?;
    expect_eq(arithmetic(7.5 as f32, 2.5 as f32), 5.0 as f32)?;
    expect_eq(negate(4 as i64), -4 as i64)?;
    return expect_eq(negate(1.5), -1.5);
}

![test]
function generic_bitwise_takes_integers() -> Result<(), TestError> {
    expect_eq(bits(12 as u8, 10 as u8), 14 as u8)?;
    expect_eq(shifted(3 as u32, 4 as u32), 3 as u32)?;
    expect_eq(shifted(1 as i128, 100 as i128), 1 as i128)?;
    expect_eq(complement(0 as u16), 65535 as u16)?;
    expect_eq(complement(0 as isize), -1 as isize)?;
    return expect_eq(invert(false), true);
}

![test]
function generic_method_takes_primitives() -> Result<(), TestError> {
    const acc: Accumulator = Accumulator { count: 0 };
    expect_eq(acc.doubled(21), 42)?;
    expect_eq(acc.doubled(0.25), 0.5)?;
    return expect_eq(acc.doubled::<usize>(4), 8 as usize);
}

![test]
function trait_methods_agree_with_operators() -> Result<(), TestError> {
    const a: i32 = 7;
    const b: i32 = 3;
    expect_eq(a.add(&b), a + b)?;
    expect_eq(a.sub(&b), a - b)?;
    expect_eq(a.mul(&b), a * b)?;
    expect_eq(a.div(&b), a / b)?;
    expect_eq(a.rem(&b), a % b)?;
    expect_eq(a.neg(), -a)?;
    expect_eq(a.bitand(&b), a & b)?;
    expect_eq(a.bitor(&b), a | b)?;
    expect_eq(a.bitxor(&b), a ^ b)?;
    expect_eq(a.shl(&b), a << b)?;
    expect_eq(a.shr(&b), a >> b)?;
    expect_eq(a.bitnot(), ~a)?;
    const yes: boolean = true;
    return expect_eq(yes.not(), false);
}
