///! Helper A for the import-scoped bare-leaf resolution regression
///! (see `leaf_scope_use_a.cryo`).  Defines a `Beacon` whose `signal()`
///! returns 100.  Module B defines a same-leaf `Beacon` returning 200; a
///! consumer importing ONLY this module must resolve bare `Beacon` - both as a
///! type and as the `Beacon::make()` static-call scope - to THIS one, a
///! distinction a last-write-wins `resolve_qualified` cannot make.
///! Not a test module itself; it only provides a type.

![config(testing)]
namespace CryoTests::Tests::Lang::LeafScopeDefnA;

type struct Beacon {
    v: i32;
}

implement Beacon {
    static make() -> Beacon { return Beacon { v: 100 }; }
    signal(&this) -> i32 { return this.v; }
}
