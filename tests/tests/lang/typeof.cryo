///! `typeof(expr)` in type position (decltype-style) - resolves to the static
///! type of the operand.  See docs/cryo.md § 5.6.  Usable anywhere a type is
///! expected: variable annotations, pointer/array/optional wrappers, generic
///! arguments, and cast targets.  Value-position `typeof` is rejected
///! (negative test E0209_typeof_value_position).

![config(testing)]
namespace CryoTests::Tests::Lang::Typeof;

import std::core::result;
import std::test::error;
import std::test::assert;

type struct Point { x: i32; y: i32; }

// typeof of a local: the declared type is whatever the operand's type is.
![test]
function typeof_basic() -> Result<(), TestError> {
    const x: i32 = 42;
    const y: typeof(x) = 7;
    return expect_eq(y, 7);
}

// Width fidelity: typeof(b) must be exactly u8, not a widened int.  Adding
// 100 + 100 in a u8 stays 200; if the binding were i32 the test below would
// still pass on value but the point is the type is preserved - exercise the
// wrap boundary to be sure it's a narrow type.
![test]
function typeof_preserves_width() -> Result<(), TestError> {
    const b: u8 = 1;
    mut z: typeof(b) = 250;
    z = z + 10;                 // 260 mod 256 = 4 in a real u8
    return expect_eq(z as i32, 4);
}

// typeof of a user-defined struct value.
![test]
function typeof_user_struct() -> Result<(), TestError> {
    const p: Point = Point { x: 1, y: 2 };
    const q: typeof(p) = Point { x: 9, y: 8 };
    expect_eq(q.x, 9)?;
    return expect_eq(q.y, 8);
}

// typeof under a pointer wrapper: `typeof(x)*` is `i32*`.
![test]
function typeof_pointer_wrapper() -> Result<(), TestError> {
    mut x: i32 = 42;
    const p: typeof(x)* = &x;
    *p = 99;
    return expect_eq(x, 99);
}

// typeof of a compound expression as a cast target.
![test]
function typeof_cast_target() -> Result<(), TestError> {
    const a: i32 = 3;
    const b: i32 = 4;
    const w: i64 = 5;
    const back: i32 = (w as typeof(a + b));   // typeof(a + b) == i32
    return expect_eq(back, 5);
}
