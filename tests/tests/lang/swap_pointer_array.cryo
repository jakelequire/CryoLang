///! Regression: monomorphizing `mem::swap<Array<T*>>` - a swap of an array
///! whose element is a POINTER - must not ICE the name mangler. The AST type
///! substituter (`rewrite_to_array`) must build the array's element
///! annotation from the element's pre-resolved TypeRef; a bare-name
///! `Named("i32*")` with no pre-resolved TypeRef resolves to
///! `Array<invalid>`, and `encode_type_ref` then hits `mangler_ice` at
///! `Array.element` while registering the spec, aborting the compiler.
///! Value-element arrays (`[i32]`) and plain pointers (`i32*`) are
///! unaffected - only `Array<ptr>` is at risk.
///! Compiling this file at all is the regression; the asserts also check that
///! the swap is semantically correct.

![config(testing)]
namespace CryoTests::Tests::Lang::SwapPointerArray;

import std::core::result::{ Result };
import std::core::mem;
import std::test::error::{ TestError };
import std::test::assert::{ expect_eq };

// swap arrays of pointer-to-scalar (`[i32*]`) - the minimal trigger.
![test]
function swap_scalar_pointer_arrays() -> Result<(), TestError> {
    mut x: i32 = 10;
    mut y: i32 = 20;
    mut z: i32 = 30;
    mut a: [i32*] = [];
    a.push(&x);
    a.push(&y);
    mut b: [i32*] = [];
    b.push(&z);
    mem::swap(&a, &b);
    // Lengths swap (1<->2), proving the swap moved the array bodies; compiling
    // `swap<Array<i32*>>` at all is the core regression.
    expect_eq(a.length() as i32, 1)?;
    expect_eq(b.length() as i32, 2)?;
    return Result::Ok(());
}
