///! Pointers, references, dereference, address-of, and pointer index.

![config(testing)]
namespace CryoTests::Tests::Lang::Pointers;

import std::core::result;
import std::test::error;
import std::test::assert;

![test]
function address_of_then_deref() -> Result<(), TestError> {
    const x: i32 = 42;
    const p: i32* = &x;
    const got: i32 = *p;
    match (expect_eq(got, 42)) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

![test]
function pointer_writes_visible_through_origin() -> Result<(), TestError> {
    mut x: i32 = 1;
    const p: i32* = &x;
    *p = 99;
    match (expect_eq(x, 99)) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

![test]
function pointer_index_array_first() -> Result<(), TestError> {
    mut buf: i32[3];
    buf[0] = 10;
    buf[1] = 20;
    buf[2] = 30;
    const p: i32* = &buf[0];
    match (expect_eq(p[0], 10)) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

![test]
function pointer_index_array_middle() -> Result<(), TestError> {
    mut buf: i32[3];
    buf[0] = 10;
    buf[1] = 20;
    buf[2] = 30;
    const p: i32* = &buf[0];
    match (expect_eq(p[1], 20)) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

![test]
function pointer_index_array_last() -> Result<(), TestError> {
    mut buf: i32[3];
    buf[0] = 10;
    buf[1] = 20;
    buf[2] = 30;
    const p: i32* = &buf[0];
    match (expect_eq(p[2], 30)) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

// `const T*` FFI pointer-to-const. ABI-identical to `T*`; the type checker
// allows the safe direction (`T*` -> `const T*`) implicitly and requires an
// explicit cast to drop const (`const T*` -> `T*`). See IMPROVEMENT.md §1.
function read_const(p: const i32*) -> i32 {
    return *p;
}

![test]
function const_pointer_deref() -> Result<(), TestError> {
    mut x: i32 = 7;
    const cp: const i32* = &x;          // T* -> const T* (safe, implicit)
    match (expect_eq(*cp, 7)) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

![test]
function const_pointer_safe_arg() -> Result<(), TestError> {
    mut x: i32 = 21;
    const p: i32* = &x;
    // passing a plain `i32*` where `const i32*` is expected is implicit
    match (expect_eq(read_const(p), 21)) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

![test]
function const_pointer_explicit_cast_away() -> Result<(), TestError> {
    mut x: i32 = 5;
    const cp: const i32* = &x;
    const mp: i32* = cp as i32*;        // dropping const requires explicit cast
    *mp = 9;
    match (expect_eq(x, 9)) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

// Reference receivers - &this/mut &this distinction.
type struct Vec2 {
    x: i32;
    y: i32;

    /// Borrowed-immutable: must NOT mutate.
    sum(&this) -> i32 {
        return this.x + this.y;
    }

    /// Borrowed-mutable: may mutate.
    scale(mut &this, factor: i32) -> void {
        this.x = this.x * factor;
        this.y = this.y * factor;
    }
}

![test]
function immutable_receiver_reads_fields() -> Result<(), TestError> {
    const v: Vec2 = Vec2 { x: 3, y: 4 };
    match (expect_eq(v.sum(), 7)) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

![test]
function mutable_receiver_writes_fields() -> Result<(), TestError> {
    mut v: Vec2 = Vec2 { x: 3, y: 4 };
    v.scale(10);
    match (expect_eq(v.x, 30)) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    match (expect_eq(v.y, 40)) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

// Pointer-to-pointer indirection.
![test]
function double_indirection() -> Result<(), TestError> {
    mut x: i32 = 5;
    const p: i32* = &x;
    const pp: i32** = &p;
    const got: i32 = **pp;
    match (expect_eq(got, 5)) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

// Function param taking a pointer.
function bump_in_place(p: i32*) -> void {
    *p = *p + 1;
}

![test]
function function_modifies_through_pointer() -> Result<(), TestError> {
    mut counter: i32 = 0;
    bump_in_place(&counter);
    bump_in_place(&counter);
    bump_in_place(&counter);
    match (expect_eq(counter, 3)) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}
