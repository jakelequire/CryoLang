///! `T?` optional-type sugar. `T?` is parsed as sugar for `Option<T>` (the
///! parser rewrites it to `Option<T>` directly), so the two are the *same*
///! type: a `T?` value is assignable to/from `Option<T>`, `Option`'s methods
///! resolve on it, and it works in every type position (variable, parameter,
///! return, struct field, generic argument).

![config(testing)]
namespace CryoTests::Tests::Lang::OptionalSugar;

import std::core::result;
import std::core::option;
import std::test::error;
import std::test::assert;
import std::collections::str;

// `T?` in parameter and return position.
function pass_through(x: i32?) -> i32? {
    return x;
}

// `T?` as a struct field.
type struct Slot {
    value: i32?;
}

// `T?` nested in a generic argument: Option<i32?> == Option<Option<i32>>.
function wrap(x: i32?) -> Option<i32?> {
    return Option::Some(x);
}

![test]
function optional_sugar_unifies_with_option() -> Result<(), TestError> {
    const a: i32? = Option::Some(7);
    const b: Option<i32> = a;       // i32? assignable to Option<i32>
    const c: i32? = b;              // Option<i32> assignable to i32?
    return expect_eq(c.unwrap_or(0), 7);
}

![test]
function optional_sugar_param_and_return() -> Result<(), TestError> {
    const r: i32? = pass_through(Option::Some(42));
    return expect_eq(r.unwrap_or(0), 42);
}

![test]
function optional_sugar_none() -> Result<(), TestError> {
    const e: i32? = Option::None;
    return expect_true(e.is_none(), Str::new("`i32?` None must report is_none"));
}

![test]
function optional_sugar_struct_field() -> Result<(), TestError> {
    const s: Slot = Slot { value: Option::Some(99) };
    return expect_eq(s.value.unwrap_or(0), 99);
}

![test]
function optional_sugar_nested_generic_arg() -> Result<(), TestError> {
    const w: Option<i32?> = wrap(Option::Some(3));
    const inner: i32? = w.unwrap_or(Option::None);
    return expect_eq(inner.unwrap_or(0), 3);
}
