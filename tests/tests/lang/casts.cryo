///! Numeric and pointer casts via `as`.  No implicit conversions in
///! Cryo - every conversion is explicit.

![config(testing)]
namespace CryoTests::Tests::Lang::Casts;

import std::core::result;
import std::test::error;
import std::test::assert;

![test]
function widen_i32_to_i64() -> Result<(), TestError> {
    const a: i32 = 100;
    const b: i64 = a as i64;
    const want: i64 = 100;
    match (expect_eq(b, want)) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

![test]
function widen_i32_to_u64() -> Result<(), TestError> {
    const a: i32 = 65535;
    const b: u64 = a as u64;
    const want: u64 = 65535;
    match (expect_eq(b, want)) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

![test]
function narrow_u64_to_u32_keeps_low_bits() -> Result<(), TestError> {
    const a: u64 = 100;
    const b: u32 = a as u32;
    const want: u32 = 100;
    match (expect_eq(b, want)) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

![test]
function narrow_u32_to_u8_keeps_low_byte() -> Result<(), TestError> {
    // 0x12_34 narrowed to u8 keeps 0x34.
    const a: u32 = 0x1234;
    const b: u8 = a as u8;
    const want: u8 = 0x34 as u8;
    match (expect_eq(b, want)) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

![test]
function signed_unsigned_round_trip() -> Result<(), TestError> {
    const a: i32 = 1234;
    const b: u32 = a as u32;
    const c: i32 = b as i32;
    match (expect_eq(c, a)) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

![test]
function char_to_u8_ascii() -> Result<(), TestError> {
    const c: char = 'A';
    const b: u8 = c as u8;
    const want: u8 = 0x41 as u8;
    match (expect_eq(b, want)) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

![test]
function u8_to_char_round_trip() -> Result<(), TestError> {
    const c: char = 'z';
    const b: u8 = c as u8;
    const back: char = b as char;
    // Compare via its u8 image so we don't need char Eq.
    match (expect_eq(back as u8, c as u8)) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

![test]
function u32_to_u64_widens_zero_extend() -> Result<(), TestError> {
    const a: u32 = 0xFFFFFFFF;
    const b: u64 = a as u64;
    const want: u64 = 4294967295;
    match (expect_eq(b, want)) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

![test]
function negative_i32_to_i64_sign_extends() -> Result<(), TestError> {
    const a: i32 = -7;
    const b: i64 = a as i64;
    const want: i64 = -7;
    match (expect_eq(b, want)) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

// Pointer reinterpretation.  `string` is a NUL-terminated u8 view, so
// `string as u8*` is the standard idiom for byte-level access used
// throughout the stdlib.
![test]
function string_to_u8_ptr() -> Result<(), TestError> {
    const s: string = "hi";
    const p: u8* = s as u8*;
    const first: u8 = p[0];
    const second: u8 = p[1];
    const nul: u8 = p[2];
    match (expect_eq(first, 0x68 as u8)) { // 'h'
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    match (expect_eq(second, 0x69 as u8)) { // 'i'
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    match (expect_eq(nul, 0 as u8)) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

// Cast target used to exercise the function-type spelling below.
function add_one(v: i32) -> i32 {
    return v + 1;
}

// A parenthesized cast target - function `(T) -> R`, tuple `(T, U)`, or
// grouping `(T)` - is reached through the paren type parser.  The cast path
// otherwise parses its target with the narrow base-type entry, which has no
// `(` branch, so these spellings were a parse error even though the very same
// types are legal in an annotation, a field, and a parameter.
![test]
function cast_to_function_type() -> Result<(), TestError> {
    const f: (i32) -> i32 = add_one as (i32) -> i32;
    match (expect_eq(f(41), 42)) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

![test]
function cast_to_tuple_type() -> Result<(), TestError> {
    const t: (i32, i32) = (7, 9);
    const u: (i32, i32) = t as (i32, i32);
    match (expect_eq(u.0, 7)) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    match (expect_eq(u.1, 9)) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

// The base-type cast entry treats a trailing `*` as multiplication rather
// than a pointer suffix when an expression follows it, so `x as u64 * 8` is
// `(x as u64) * 8`.  Parenthesising the target must not disturb that.
![test]
function cast_target_does_not_swallow_multiply() -> Result<(), TestError> {
    const x: i64 = 4;
    const bare: u64 = x as u64 * 8;
    const grouped: u64 = x as (u64) * 8;
    match (expect_eq(bare, 32 as u64)) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    match (expect_eq(grouped, 32 as u64)) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}
