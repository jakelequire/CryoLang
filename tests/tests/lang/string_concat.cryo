///! `string + string` concatenates: the binary operator lowers to the
///! `append` method the stdlib's `implement string` block provides, so the
///! operator is only as sound as codegen's lookup of that method.  Nothing
///! else in the suite or the examples concatenates two `string` values,
///! and the operator once lowered to a null operand - a binary that
///! segfaulted on `"a" + s` - while every gate stayed green.

![config(testing)]
namespace CryoTests::Tests::Lang::StringConcat;

import std::core::result;
import std::core::result::{ Result };
import std::collections::str;
import std::collections::str::{ Str };
import std::test::error;
import std::test::error::{ TestError };
import std::test::assert;
import std::test::assert::{ expect_true };

function sc_suffix(base: string, tail: string) -> string {
    return base + tail;
}

![test]
function string_plus_string_concatenates() -> Result<(), TestError> {
    const world: string = "world";
    const s: string = "hello, " + world;
    return expect_true(s.eq("hello, world"), Str::new("\"hello, \" + world should read hello, world"));
}

![test]
function string_plus_string_in_a_function() -> Result<(), TestError> {
    const s: string = sc_suffix("C$vt$", "path");
    return expect_true(s.eq("C$vt$path") && s.length() == 9,
        Str::new("concatenation through a call should keep both halves"));
}

![test]
function string_plus_string_chains() -> Result<(), TestError> {
    const a: string = "a";
    const s: string = a + "b" + "c";
    return expect_true(s.eq("abc"), Str::new("a + b + c should read abc"));
}
