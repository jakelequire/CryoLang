///! Companion module for `module_qualified_fn_value`: the function referenced
///! as a value has to be declared somewhere other than the file that names it.

![config(testing)]
namespace CryoTests::Tests::Lang::ModuleQualifiedFnValueDefn;

mut g_calls: i64 = 0;

function record(tag: i64) -> void { g_calls = g_calls + tag; }

function calls() -> i64 { return g_calls; }

function reset() -> void { g_calls = 0; }
