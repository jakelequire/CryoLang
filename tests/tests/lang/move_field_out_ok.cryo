///! The partial-move double-free guard (E0453) must reject ONLY the unsound
///! case - moving a non-Copy field out of an owned, drop-glued value. The
///! safe shapes below must keep compiling AND dropping exactly once:
///!
///!  - the "replace" idiom through a borrowed `&this` receiver
///!    (`mut old = this.f; this.f = new;`), as the stdlib's `set_body` uses;
///!  - moving a `Copy` field out (bitwise-independent of the source).
///!
///! Each `Probe::drop()` bumps a module counter (same harness as
///! drop_glue.cryo); tests assert the exact drop count - too few means a
///! leak, too many means the double free we set out to prevent.

![config(testing)]
namespace CryoTests::Tests::Lang::MoveFieldOutOk;

import std::core::result;
import std::core::drop;
import std::test::error;
import std::test::assert;

mut g_drop_count: i32 = 0;
function reset() -> void { g_drop_count = 0; }
function count() -> i32  { return g_drop_count; }

type struct Probe { tag: i32; }
implement trait Drop for struct Probe {
    drop(mut &this) -> void { g_drop_count = g_drop_count + 1; }
}

type struct Cell { p: Probe; }
implement Cell {
    // Replace idiom: the receiver is borrowed (`mut &this`), so moving the
    // old field value into a local is the caller's value to manage, not a
    // glue-dropped place - allowed, and drops the old value exactly once.
    replace(mut &this, np: Probe) -> Probe {
        mut old: Probe = this.p;
        this.p = np;
        return old;
    }
}

type struct Mixed { p: Probe; id: i32; }

// A non-`Drop` owner (no `implement trait Drop`) whose fields are droppable:
// the compiler synthesizes per-field drop glue, so a field moved out of a
// straight-line local is tracked and skipped at scope exit (the Rust
// partial-move model).  Contrast `Cell`/`Mixed` above (borrow/Copy paths).
type struct ProbePair { a: Probe; b: Probe; }

// Regression: a user type whose LEAF NAME collides with a stdlib `Drop` type
// (`Pair<A,B>` in std::collections::pair) must NOT inherit that Drop by
// bare-name collision.  The trait-impl registry keys Drop precisely by the
// target's canonical base arena type id, so this local `Pair` - which has no
// `Drop` and is never imported alongside the stdlib one - is correctly a
// non-`Drop` owner: its field move is allowed and its live field drops once.
type struct Pair { a: Probe; b: Probe; }

// Consumes its by-value owning argument (drops it exactly once).
function sink(p: Probe) -> void {
    mut y: Probe = p;
    y.drop();
}

// ---- leaf-name collision with a stdlib Drop type is not inherited ---------

![test]
function colliding_leaf_name_is_not_drop() -> Result<(), TestError> {
    reset();
    {
        mut pr: Pair = Pair { a: Probe { tag: 1 }, b: Probe { tag: 2 } };
        sink(pr.a);   // a moved out (count -> 1); pr is a NON-Drop owner
        // pr.b still live -> dropped once by per-field glue (count -> 2)
    }
    return expect_eq(count(), 2);
}

// ---- partial move out of a non-`Drop` owner: move one field --------------

![test]
function partial_move_nondrop_owner_one_field() -> Result<(), TestError> {
    reset();
    {
        mut pr: ProbePair = ProbePair { a: Probe { tag: 1 }, b: Probe { tag: 2 } };
        sink(pr.a);   // a moved out and dropped inside sink (count -> 1)
        // pr.a is skipped at scope exit; pr.b is still live and dropped by
        // per-field glue exactly once (count -> 2).
    }
    return expect_eq(count(), 2);
}

// ---- partial move out of a non-`Drop` owner: move ALL fields -------------

![test]
function partial_move_nondrop_owner_all_fields() -> Result<(), TestError> {
    reset();
    {
        mut pr: ProbePair = ProbePair { a: Probe { tag: 1 }, b: Probe { tag: 2 } };
        sink(pr.a);   // count -> 1
        sink(pr.b);   // count -> 2
        // BOTH fields moved: the owner's scope-exit drop must be a no-op
        // (skipping both), so the total stays 2 - a double free would push
        // it to 4 (and trip valgrind under `make valgrind-check`).
    }
    return expect_eq(count(), 2);
}

// ---- replace idiom through a borrowed receiver ---------------------------

![test]
function replace_idiom_drops_old_once() -> Result<(), TestError> {
    reset();
    {
        mut c: Cell = Cell { p: Probe { tag: 1 } };
        mut old: Probe = c.replace(Probe { tag: 2 });
        old.drop();           // old (tag 1) dropped here, exactly once
        // c.p (tag 2) dropped by glue at scope exit, exactly once
    }
    return expect_eq(count(), 2);
}

// ---- Copy field move-out is bitwise-independent (no double free) ---------

![test]
function copy_field_move_out_is_fine() -> Result<(), TestError> {
    reset();
    mut kept: i32 = 0;
    {
        mut m: Mixed = Mixed { p: Probe { tag: 7 }, id: 42 };
        kept = m.id;          // Copy field: allowed, no drop, no aliasing
        // m.p dropped by glue exactly once at scope exit
    }
    match (expect_eq(kept, 42)) {
        Result::Ok(_)  => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return expect_eq(count(), 1);
}
