///! `![align(N)]`: the boundary AND the width.
///!
///! An LLVM struct has no alignment of its own - its size and alignment come
///! from its members alone - so an over-aligned type needs both halves supplied
///! separately. The BOUNDARY: an alloca and a global take the ABI alignment of
///! the mapped type, so both are raised to the declared alignment and never
///! lowered. The WIDTH: the mapped body carries tail padding to the declared
///! size, because otherwise `sizeof` reports a number larger than the object
///! and an array stride or a `mem::zero` sized from it runs past the end.
///!
///! Deliberately untested here, because it does not hold: a field of an
///! over-aligned type does not start on its own boundary inside a containing
///! struct. Inter-field padding is not emitted, so `offsetof` a 64-aligned
///! member can be 8. Reproducing it renumbers LLVM element indices, which
///! every GEP site reads.

![config(testing)]
namespace CryoTests::Tests::Lang::AlignAttributeLayout;

import std::core::result;

import std::test::error;
import std::test::assert;

![align(64)]
type struct CacheLine { a: u64; b: u64; }

// No attribute of its own: it inherits 64-byte alignment through the member.
type struct Holder { slots: CacheLine[8]; n: u32; }

![test]
function attribute_sets_size_and_alignment() -> Result<(), TestError> {
    expect_eq(sizeof(CacheLine) as i64, 64)?;
    return expect_eq(alignof(CacheLine) as i64, 64);
}

![test]
function alignment_is_inherited_by_a_containing_struct() -> Result<(), TestError> {
    expect_eq(alignof(Holder) as i64, 64)?;
    // 8 slots of 64, plus `n` rounded up to the inherited 64.
    return expect_eq(sizeof(Holder) as i64, 576);
}

// A global is an object placement too, and gets its boundary from the same
// attribute; it is emitted by a different path from a local's stack slot.
mut g_line: CacheLine;

![test]
function a_global_lands_on_the_declared_boundary() -> Result<(), TestError> {
    g_line.a = 1;
    return expect_eq(((&g_line as u64) % 64) as i64, 0);
}

![test]
function a_local_lands_on_the_declared_boundary() -> Result<(), TestError> {
    mut line: CacheLine;
    line.a = 1;
    return expect_eq(((&line as u64) % 64) as i64, 0);
}

// The WIDTH, measured on the emitted object rather than reported by the front
// end: the distance between two adjacent elements is the size the type claims.
// This is the quantity a `mem::zero`, a `memcpy`, or an index computation
// uses, and it is what an unpadded body gets wrong.
![test]
function the_object_is_as_wide_as_sizeof_says() -> Result<(), TestError> {
    mut lines: CacheLine[2];
    lines[0].a = 1;
    const stride: u64 = (&lines[1] as u64) - (&lines[0] as u64);
    return expect_eq(stride as i64, sizeof(CacheLine) as i64);
}

// Same check one level out: the container inherited the alignment through a
// member, so its own size was rounded up too and its stride must match.
![test]
function an_inherited_alignment_widens_the_container_too() -> Result<(), TestError> {
    mut holders: Holder[2];
    holders[0].n = 1;
    const stride: u64 = (&holders[1] as u64) - (&holders[0] as u64);
    return expect_eq(stride as i64, sizeof(Holder) as i64);
}
