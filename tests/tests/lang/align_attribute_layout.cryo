///! `![align(N)]`: the boundary AND the width.
///!
///! An LLVM struct has no alignment of its own - its size and alignment come
///! from its members alone - so an over-aligned type needs both halves supplied
///! separately. The BOUNDARY: an alloca and a global take the ABI alignment of
///! the mapped type, so both are raised to the declared alignment and never
///! lowered. The WIDTH: the mapped body carries tail padding to the declared
///! size, because otherwise `sizeof` reports a number larger than the object
///! and an array stride or a `mem::zero` sized from it runs past the end.
///!
///! Both halves are supplied through one routine: `TypeMapper` decides which
///! element of a body holds field N, and the body builder, every field GEP and
///! every constant aggregate read their answer from it - so a filler inserted
///! for alignment cannot shift a field out from under the index used to
///! address it.

![config(testing)]
namespace CryoTests::Tests::Lang::AlignAttributeLayout;

import std::core::result;

import std::test::error;
import std::test::assert;

![align(64)]
type struct CacheLine { a: u64; b: u64; }

// No attribute of its own: it inherits 64-byte alignment through the member.
type struct Holder { slots: CacheLine[8]; n: u32; }

![test]
function attribute_sets_size_and_alignment() -> Result<(), TestError> {
    expect_eq(sizeof(CacheLine) as i64, 64)?;
    return expect_eq(alignof(CacheLine) as i64, 64);
}

![test]
function alignment_is_inherited_by_a_containing_struct() -> Result<(), TestError> {
    expect_eq(alignof(Holder) as i64, 64)?;
    // 8 slots of 64, plus `n` rounded up to the inherited 64.
    return expect_eq(sizeof(Holder) as i64, 576);
}

// A global is an object placement too, and gets its boundary from the same
// attribute; it is emitted by a different path from a local's stack slot.
mut g_line: CacheLine;

![test]
function a_global_lands_on_the_declared_boundary() -> Result<(), TestError> {
    g_line.a = 1;
    return expect_eq(((&g_line as u64) % 64) as i64, 0);
}

![test]
function a_local_lands_on_the_declared_boundary() -> Result<(), TestError> {
    mut line: CacheLine;
    line.a = 1;
    return expect_eq(((&line as u64) % 64) as i64, 0);
}

// The WIDTH, measured on the emitted object rather than reported by the front
// end: the distance between two adjacent elements is the size the type claims.
// This is the quantity a `mem::zero`, a `memcpy`, or an index computation
// uses, and it is what an unpadded body gets wrong.
![test]
function the_object_is_as_wide_as_sizeof_says() -> Result<(), TestError> {
    mut lines: CacheLine[2];
    lines[0].a = 1;
    const stride: u64 = (&lines[1] as u64) - (&lines[0] as u64);
    return expect_eq(stride as i64, sizeof(CacheLine) as i64);
}

// Same check one level out: the container inherited the alignment through a
// member, so its own size was rounded up too and its stride must match.
![test]
function an_inherited_alignment_widens_the_container_too() -> Result<(), TestError> {
    mut holders: Holder[2];
    holders[0].n = 1;
    const stride: u64 = (&holders[1] as u64) - (&holders[0] as u64);
    return expect_eq(stride as i64, sizeof(Holder) as i64);
}

// An over-aligned type keeps its alignment wherever it appears, including as a
// member placed after another field: the body carries an explicit padding
// element so the member starts on its declared boundary, which is what the
// front end already computed the offset to be and what every other compiler
// produces for the same declaration. Without the padding the member sits at
// its natural offset and `![align(N)]` silently means "assume, but do not
// arrange" for exactly this placement.
type struct TrailingLine { tag: u8; line: CacheLine; }

![test]
function an_over_aligned_member_starts_on_its_boundary() -> Result<(), TestError> {
    mut t: TrailingLine;
    t.tag = 1;
    const off: u64 = (&t.line as u64) - (&t as u64);
    expect_eq(off as i64, 64)?;
    return expect_eq((((&t.line as u64) % 64) == 0) as i64, 1);
}

// The padding shifts every later field to a new element of the body. A GEP
// that still counted fields instead of elements would land on the padding and
// write through it, so this is the check that the index and the layout agree.
![test]
function writing_across_the_padding_hits_the_right_fields() -> Result<(), TestError> {
    mut t: TrailingLine;
    t.tag = 0x5A;
    t.line.a = 0xDEADBEEF;
    t.line.b = 0xC0FFEE;
    expect_eq(t.tag as i64, 0x5A)?;
    expect_eq(t.line.a as i64, 0xDEADBEEF)?;
    return expect_eq(t.line.b as i64, 0xC0FFEE);
}

// Same layout reached through a literal rather than field-by-field stores:
// the literal emitter resolves each field to a body slot through the same
// mapping the body was built from.
![test]
function a_literal_initialises_every_field_across_the_padding() -> Result<(), TestError> {
    const t: TrailingLine = TrailingLine { tag: 9, line: CacheLine { a: 11, b: 22 } };
    expect_eq(t.tag as i64, 9)?;
    expect_eq(t.line.a as i64, 11)?;
    return expect_eq(t.line.b as i64, 22);
}

// sizeof must still describe the whole object: the member's boundary is paid
// for out of inter-field padding, and the tail is rounded to the alignment.
![test]
function the_container_is_sized_and_strided_to_match() -> Result<(), TestError> {
    mut pair: TrailingLine[2];
    pair[0].tag = 1;
    const stride: u64 = (&pair[1] as u64) - (&pair[0] as u64);
    expect_eq(sizeof(TrailingLine) as i64, 128)?;
    return expect_eq(stride as i64, sizeof(TrailingLine) as i64);
}
