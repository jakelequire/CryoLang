///! A `where` clause on a type declaration constrains the declaration's own
///! parameters, and a body written against the bound reaches the trait's
///! method through it.  The bound is the only way to constrain a type's
///! parameter: the inline `<T: Bound>` form is not syntax.
///!
///! `E0306_type_where_bound` and `E0306_enum_where_bound` hold the refusals.

![config(testing)]
namespace CryoTests::Tests::Lang::TypeWhereBound;

import std::core::result;
import std::core::result::{ Result };
import std::test::error;
import std::test::error::{ TestError };
import std::test::assert;
import std::test::assert::{ expect_eq };

type trait Tagged {
    tag(&this) -> i64;
}

type struct Mark { v: i64; }

implement trait Tagged for Mark {
    tag(&this) -> i64 { return this.v * 10; }
}

type struct Holder<T> where T: Tagged {
    inner: T;

    label(&this) -> i64 { return this.inner.tag(); }
}

type enum Slot<T> where T: Tagged {
    Empty;
    Full(T);
}

implement<T> enum Slot<T> where T: Tagged {
    weight(&this) -> i64 {
        match (this) {
            Slot::Empty   => { return 0; }
            Slot::Full(t) => { return t.tag(); }
        }
    }
}

![test]
function struct_bound_reaches_the_trait_method() -> Result<(), TestError> {
    const h: Holder<Mark> = Holder::<Mark> { inner: Mark { v: 4 } };
    return expect_eq(h.label(), 40);
}

![test]
function enum_bound_reaches_the_trait_method() -> Result<(), TestError> {
    const s: Slot<Mark> = Slot::Full(Mark { v: 3 });
    const e: Slot<Mark> = Slot::Empty;
    match (expect_eq(s.weight(), 30)) {
        Result::Ok(_)  => { }
        Result::Err(x) => { return Result::Err(x); }
    }
    return expect_eq(e.weight(), 0);
}
