///! Autoref'd call arguments are borrows, not moves — the caller keeps
///! ownership and drops the value at scope exit.
///!
///! drop_insertion's read_call used to walk EVERY call argument in move
///! context, marking even a bare-ident value passed to a `&T` parameter as
///! moved.  That suppressed the caller's scope-exit drop, leaking the value
///! — directly contradicting the documented borrow model (cryo.md §16.4:
///! "passing a value to a function is a borrow ... a value stays usable
///! after a call").  The pass now honors the `autoref` flag sema sets:
///! autoref'd borrows are read, only genuine by-value (`T`) arguments move.
///!
///! Each `Probe::drop()` bumps a module-level counter, mirroring the harness
///! used by discarded_temp_drops.cryo.

![config(testing)]
namespace CryoTests::Tests::Lang::AutorefArgDrops;

import std::core::result;
import std::core::drop;
import std::test::error;
import std::test::assert;

mut g_drop_count: i32 = 0;
function reset_drop_count() -> void { g_drop_count = 0; }
function drop_count()       -> i32  { return g_drop_count; }

type struct Probe {
    tag: i32;
    static make(tag: i32) -> Probe { return Probe { tag: tag }; }
}

implement trait Drop for struct Probe {
    drop(mut &this) -> void { g_drop_count = g_drop_count + 1; }
}

function borrow(x: &Probe) -> i32 { return x.tag; }
function consume(x: Probe) -> void { x.drop(); }

// Bare-ident value passed to a `&T` param (auto-ref): the caller still owns
// it and must drop it once at scope exit.
![test]
function autoref_borrow_drops_at_caller() -> Result<(), TestError> {
    reset_drop_count();
    {
        const p: Probe = Probe::make(1);
        borrow(p);
    }
    return expect_eq(drop_count(), 1);
}

// Explicit `&p` is the same borrow and drops identically.
![test]
function explicit_ref_borrow_drops_at_caller() -> Result<(), TestError> {
    reset_drop_count();
    {
        const p: Probe = Probe::make(1);
        borrow(&p);
    }
    return expect_eq(drop_count(), 1);
}

// Borrowing the same value twice is still a single owner: it drops exactly
// once, never twice (no double-free) and never zero (no leak).
![test]
function repeated_borrow_drops_once() -> Result<(), TestError> {
    reset_drop_count();
    {
        const p: Probe = Probe::make(1);
        borrow(p);
        borrow(p);
    }
    return expect_eq(drop_count(), 1);
}

// A genuine by-value (`T`) argument still moves: ownership transfers to the
// callee (which drops it here), and the caller must NOT drop it again.
![test]
function by_value_arg_moves_no_double_drop() -> Result<(), TestError> {
    reset_drop_count();
    {
        const p: Probe = Probe::make(1);
        consume(p);
    }
    return expect_eq(drop_count(), 1);
}
