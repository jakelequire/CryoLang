///! How an array type groups with the type forms around it.
///!
///! `&` takes everything to its right, so `&Node*[]` is a reference to an
///! array of pointers.  Array suffixes apply innermost first, so `u64[2][3]`
///! is three rows of `u64[2]`.  Parentheses group a type so a suffix can
///! apply to the whole of it: `(&Node)[]` is an array of references.
///!
///! Each test reads values back through the type, so a spelling that grouped
///! differently would either be refused or read the wrong numbers.

![config(testing)]
namespace CryoTests::Tests::Lang::ArrayTypeGrouping;

import std::core::result;
import std::core::result::{ Result };
import std::test::error;
import std::test::error::{ TestError };
import std::test::assert;
import std::test::assert::{ expect_eq };

type struct Node { v: i64; }

function sum_through_pointers(xs: &Node*[]) -> i64 {
    mut total: i64 = 0;
    for (mut i: i64 = 0; i < xs.length as i64; i++) { total += xs[i].v; }
    return total;
}

function sum_through_references(xs: &(&Node)[]) -> i64 {
    mut total: i64 = 0;
    for (mut i: i64 = 0; i < xs.length as i64; i++) { total += xs[i].v; }
    return total;
}

const GRID: u64[2][3] = [[1, 2], [3, 4], [5, 6]];

![test]
function reference_takes_the_whole_array_of_pointers() -> Result<(), TestError> {
    mut a: Node = Node { v: 3 };
    mut b: Node = Node { v: 4 };
    mut ptrs: Node*[] = [];
    ptrs.push(&a as Node*);
    ptrs.push(&b as Node*);
    expect_eq(sum_through_pointers(&ptrs), 7)?;
    return Result::Ok(());
}

![test]
function parentheses_make_an_array_of_references() -> Result<(), TestError> {
    const a: Node = Node { v: 5 };
    const b: Node = Node { v: 6 };
    mut refs: (&Node)[] = [];
    refs.push(&a);
    refs.push(&b);
    expect_eq(refs.length as i64, 2)?;
    expect_eq(sum_through_references(&refs), 11)?;
    return Result::Ok(());
}

![test]
function fixed_suffixes_apply_innermost_first() -> Result<(), TestError> {
    expect_eq(GRID.length as i64, 3)?;
    expect_eq(GRID[0].length as i64, 2)?;
    expect_eq(GRID[2][1] as i64, 6)?;
    return Result::Ok(());
}

![test]
function optional_suffix_after_an_array_wraps_the_array() -> Result<(), TestError> {
    mut maybe: i64[]? = Option::None;
    expect_eq(maybe.is_none(), true)?;
    const xs: i64[] = [1, 2, 3];
    maybe = Option::Some(xs);
    expect_eq(maybe.unwrap().length as i64, 3)?;
    return Result::Ok(());
}

![test]
function optional_suffix_inside_an_array_wraps_each_element() -> Result<(), TestError> {
    const some: i64? = Option::Some(9);
    const none: i64? = Option::None;
    mut slots: i64?[] = [];
    slots.push(some);
    slots.push(none);
    expect_eq(slots.length as i64, 2)?;
    expect_eq(slots[0].unwrap(), 9)?;
    expect_eq(slots[1].is_none(), true)?;
    return Result::Ok(());
}
