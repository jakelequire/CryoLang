///! Regression test for the libclang-driven C-header import engine
///! (Compiler::Bindgen).  Imports a local header via `#include` and CALLS the
///! imported function, validating the full
///!     parse header -> emit FunctionDecl -> name/type resolve -> link -> run
///! path.  Self-host proves IR byte-identity when re-parsing llvm_bindings.h
///! (236 prototypes) but never RUNS an imported function — this does.
///!
///! `bindgen_probe_add3` is declared in helpers/bindgen_probe.h and defined in
///! helpers/abi_helpers.c (linked via libabihelpers.a, see tests/cryoconfig).

![config(testing)]
namespace CryoTests::Tests::Lang::CImportLibclang;

import std::core::result;
import std::test::error;
import std::test::assert;

extern module probe := "C" {
    #include "../../helpers/bindgen_probe.h"
}

// The imported prototype `int bindgen_probe_add3(int, int, int)` must map to
// `(i32, i32, i32) -> i32` and link to the C definition; 10+20+12 == 42.
![test]
function c_import_local_header_call() -> Result<(), TestError> {
    return expect_eq(probe::bindgen_probe_add3(10 as i32, 20 as i32, 12 as i32), 42 as i32);
}
