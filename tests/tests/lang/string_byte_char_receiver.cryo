/// A `char` method called straight on a byte of a `string` - an index
/// `s[i]` or a dereference `*s` - sees that one byte as its `char`.  The
/// byte has no `char`-sized storage of its own: taking its address as the
/// receiver would read it and the three bytes after it.

![config(testing)]
namespace CryoTests::Tests::Lang::StringByteCharReceiver;

import std::core::result::{ Result };
import std::collections::str::{ Str };
import std::test::error::{ TestError };
import std::test::assert::{ expect_eq, expect_true };

![test]
function index_receiver_reads_one_byte() -> Result<(), TestError> {
    const lexeme: string = "0x30";
    expect_eq(lexeme[1].to_ascii_lowercase() as u32, 'x' as u32)?;
    expect_eq(lexeme[1].to_ascii_uppercase() as u32, 'X' as u32)?;
    expect_true(lexeme[1].is_lowercase(), Str::new("`x` is lowercase"))?;
    expect_true(lexeme[2].is_hex_digit(), Str::new("`3` is a hex digit"))?;
    return Result::Ok(());
}

![test]
function dereference_receiver_reads_one_byte() -> Result<(), TestError> {
    const text: string = "aBCD";
    expect_eq((*text).to_ascii_uppercase() as u32, 'A' as u32)?;
    expect_true((*text).is_lowercase(), Str::new("`a` is lowercase"))?;
    return Result::Ok(());
}

![test]
function receiver_is_a_copy_of_the_byte() -> Result<(), TestError> {
    const word: string = "Qa";
    const upper: char = word[1].to_ascii_uppercase();
    expect_eq(upper as u32, 'A' as u32)?;
    expect_eq(word[1] as u32, 'a' as u32)?;
    return Result::Ok(());
}
