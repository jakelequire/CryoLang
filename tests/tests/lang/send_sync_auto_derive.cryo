///! Send/Sync auto-derive - verify generic functions bounded by `T: Send`
///! and `T: Sync` accept the types the compiler's auto-derive considers
///! thread-safe.  The dispatcher routes the trait queries to
///! OwnershipQuery::is_send / is_sync (see compiler/types/ownership.cryo);
///! these tests exercise that path through the user-facing trait-bound
///! grammar.
///!
///! Deny-list rejections (Rc, MutexGuard, RwLockReadGuard,
///! RwLockWriteGuard) live in the negative test directory.

![config(testing)]
namespace CryoTests::Tests::Lang::SendSyncAutoDerive;

import std::core::result;
import std::core::option;
import std::core::drop;
import std::sync::atomic;
import std::alloc::arc;
import std::test::error;
import std::test::assert;

type struct PlainStruct {
    a: i32;
    b: u64;
}

type enum PlainEnum {
    Foo;
    Bar(i32);
}

// `T: Send` accepts a value; we don't use it for anything except to
// instantiate the bound. The compiler resolves the bound at the call
// site by routing Send to OwnershipQuery::is_send.
function require_send<T>(v: T) -> i32 where T: Send {
    return 1;
}

function require_sync<T>(v: T) -> i32 where T: Sync {
    return 2;
}

function require_send_and_sync<T>(v: T) -> i32
where T: Send, T: Sync {
    return 3;
}

![test]
function send_accepts_primitives() -> Result<(), TestError> {
    const a: i32 = require_send<i32>(42);
    const b: i32 = require_send<u64>(99u64);
    const c: i32 = require_send<boolean>(true);
    const d: i32 = require_send<char>('x');
    match (expect_eq(a + b + c + d, 4)) {
        Result::Ok(_)  => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

![test]
function sync_accepts_primitives() -> Result<(), TestError> {
    const a: i32 = require_sync<i32>(7);
    const b: i32 = require_sync<u64>(11u64);
    match (expect_eq(a + b, 4)) {
        Result::Ok(_)  => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

![test]
function send_accepts_plain_struct() -> Result<(), TestError> {
    const s: PlainStruct = PlainStruct { a: 1, b: 2u64 };
    const r: i32 = require_send<PlainStruct>(s);
    match (expect_eq(r, 1)) {
        Result::Ok(_)  => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

![test]
function send_accepts_plain_enum() -> Result<(), TestError> {
    const e: PlainEnum = PlainEnum::Bar(7);
    const r: i32 = require_send<PlainEnum>(e);
    match (expect_eq(r, 1)) {
        Result::Ok(_)  => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

![test]
function send_accepts_atomic_types() -> Result<(), TestError> {
    // Atomic types are non-Copy but their underlying storage is Send + Sync.
    // We pass a value (which moves it in), so the bound must hold.
    mut a: Atomic<u32> = Atomic<u32>::new(0u32);
    const r: i32 = require_send<Atomic<u32>>(a);
    // `a` was consumed into require_send; nothing to drop here.
    match (expect_eq(r, 1)) {
        Result::Ok(_)  => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

// Regression: a USER type must NOT be denied Send/Sync by a bare-leaf collision
// with stdlib `std::alloc::rc::Rc`.  The deny-list keys on canonical
// qualified-name identity, so this local `UserRc` (all-Copy fields) is Send +
// Sync even though the stdlib `Rc` on the deny-list is not.  The type is named
// `UserRc`, not `Rc`, because `Rc` is a prelude re-export: import-scoped name
// resolution treats a LOCAL type whose leaf collides with a prelude name as a
// hard conflict (it must be renamed or qualified), so `type struct Rc` here is
// not legal.  The same-leaf deny-list behaviour is exercised directly by
// the collision regression tests in `leaf_collision_*`.
type struct UserRc {
    strong: i32;
    weak:   u64;
}

![test]
function user_named_rc_is_send_and_sync() -> Result<(), TestError> {
    const r: UserRc = UserRc { strong: 1, weak: 2u64 };
    const got: i32 = require_send_and_sync<UserRc>(r);
    return expect_eq(got, 3);
}

![test]
function send_and_sync_accepts_arc_of_atomic() -> Result<(), TestError> {
    // Arc<AtomicU32> is the canonical "shared across threads" type;
    // it satisfies both Send and Sync via auto-derive (Arc itself is
    // not on the deny-list, unlike Rc).
    mut a: Arc<Atomic<u32>> = Arc::new(Atomic<u32>::new(0u32));
    const r: i32 = require_send_and_sync<Arc<Atomic<u32>>>(a);
    // `a` was consumed.
    match (expect_eq(r, 3)) {
        Result::Ok(_)  => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}
