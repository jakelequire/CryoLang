///! Integer literal codegen - signedness and bit-pattern preservation.
///!
///! Pinning the codegen contract for `LiteralKind::Integer`: a u64 (or
///! any unsigned-typed) literal whose bit pattern crosses i64::MAX must
///! still compare correctly as unsigned. Sign-extending every integer
///! literal regardless of the source-level type's signedness would make
///! inline comparisons against u64 literals exceeding i64::MAX silently
///! flip to signed semantics, so `sign_extend` gates on
///! `IntType::is_unsigned()`.

![config(testing)]
namespace CryoTests::Tests::Lang::IntegerLiterals;

import std::core::result;
import std::collections::str;
import std::test::error;
import std::test::assert;

// 2^63 - one past i64::MAX. Smallest positive u64 whose top bit is set,
// so it would sign-extend to a negative APInt without the `is_unsigned()` gate.
const I64_MAX_PLUS_ONE: u64 = 9223372036854775808;

// u64::MAX - every bit set. Without the `is_unsigned()` gate this becomes -1
// in any signed comparison.
const U64_ALL_ONES: u64 = 18446744073709551615;

![test]
function u64_above_i64_max_compares_positive() -> Result<(), TestError> {
    const big: u64 = I64_MAX_PLUS_ONE;
    match (expect(big > 0,
        Str::new("u64 2^63 should be > 0"))) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

![test]
function u64_max_compares_positive() -> Result<(), TestError> {
    const m: u64 = U64_ALL_ONES;
    match (expect(m > 0,
        Str::new("u64::MAX should be > 0"))) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

![test]
function u64_above_i64_max_greater_than_small() -> Result<(), TestError> {
    const big: u64 = I64_MAX_PLUS_ONE;
    const small: u64 = 5;
    match (expect(big > small,
        Str::new("u64 2^63 should be > 5"))) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

![test]
function u64_high_bit_eq_self() -> Result<(), TestError> {
    const a: u64 = I64_MAX_PLUS_ONE;
    const b: u64 = I64_MAX_PLUS_ONE;
    match (expect_eq(a, b)) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

![test]
function u64_high_bit_round_trips_as_value() -> Result<(), TestError> {
    // Storing through a parameter (rvalue copy) and reading back must
    // preserve the high bit. If the literal codegen sign-extended, the
    // copy back to a u64 slot would still hold the post-extension bits;
    // the resulting integer should still compare equal to the literal.
    const expected: u64 = I64_MAX_PLUS_ONE;
    mut copy: u64 = expected;
    match (expect_eq(copy, expected)) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

![test]
function u32_high_bit_compares_positive() -> Result<(), TestError> {
    // Same hazard, narrower type. 2^31 is i32::MAX + 1; a sign-extend-
    // everywhere path would flip a u32 literal at the high bit negative
    // too.
    const big: u32 = 2147483648;
    match (expect(big > 0,
        Str::new("u32 2^31 should be > 0"))) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

// Inline-literal-vs-u64 sema coverage.
//
// Shape: a u64 variable compared against an inline integer literal that
// exceeds i64::MAX.  If sema typed such literals as the default int (i32),
// it would truncate the bit pattern to its low 32 bits before codegen ever
// ran.  For 9_223_372_036_854_775_808 (2^63), the low 32 bits are
// 0x00000000 - so `acc > 9223372036854775808` would lower as `acc > 0`,
// true for every non-zero u64.  For non-assignment binary ops, sema pushes
// the non-literal operand's type as expected_type while resolving the
// literal, so resolve_integer_literal adopts u64 instead of defaulting to
// i32.
![test]
function u64_var_vs_inline_literal_above_i64_max_greater_than() -> Result<(), TestError> {
    const acc: u64 = 7;
    match (expect(!(acc > 9223372036854775808),
        Str::new("u64 7 should not be > 2^63 inline literal"))) {
        Result::Ok(_) => { } Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

![test]
function i64_negative_literal_still_negative() -> Result<(), TestError> {
    // Sanity: the unsigned-adopt rule applies to unsigned types only;
    // signed types must keep working. -1 must still be < 0.
    const neg: i64 = -1;
    match (expect(neg < 0,
        Str::new("i64 -1 should be < 0"))) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

// i64::MIN in argument / payload position.
//
// `-9223372036854775808` parses as `-(9223372036854775808)`, a
// UnaryExpression over the 2^63 magnitude.  In const-init position the
// declared i64 type flowed onto the magnitude, but in a call-argument or
// enum-payload position resolve_call cleared expected_type for non-
// call/scope/array args, so the magnitude defaulted to i32 and truncated
// to its low 32 bits (0), negating to 0.  This silently corrupted JSON
// parsing of i64::MIN (json/parser.cryo).
//
// Fix: resolve_call now pushes the param/payload type for negative
// numeric literals, and resolve_integer_literal widens its default to
// the narrowest type that holds the magnitude when no hint is in scope.
![test]
function i64_min_via_call_arg() -> Result<(), TestError> {
    const got:  i64 = ilit_identity(-9223372036854775808);
    const want: i64 = i64::min_value();
    return expect_eq(got, want);
}

![test]
function i64_min_via_enum_payload() -> Result<(), TestError> {
    const n: ILitWrap = ILitWrap::Val(-9223372036854775808);
    const want: i64 = i64::min_value();
    match (n) {
        ILitWrap::Val(v) => { return expect_eq(v, want); }
    }
}

![test]
function i64_max_via_call_arg() -> Result<(), TestError> {
    const got:  i64 = ilit_identity(9223372036854775807);
    const want: i64 = i64::max_value();
    return expect_eq(got, want);
}

![test]
function small_negative_arg_unaffected() -> Result<(), TestError> {
    const got:  i64 = ilit_identity(-7);
    const want: i64 = -7;
    return expect_eq(got, want);
}

function ilit_identity(x: i64) -> i64 { return x; }

type enum ILitWrap { Val(i64); }

// Octal literals. The `0o` / `0O` prefix is the language's only octal
// spelling (docs section 1.4). Guards against the value parsers ignoring the
// prefix (`0o755` decoding to 0) and instead treating a bare leading zero as
// C-style octal (`077` decoding to 63). Both would be silent miscompiles.
![test]
function octal_prefix_decodes_value() -> Result<(), TestError> {
    const a: i32 = 0o755;
    return expect_eq(a, 493);
}

![test]
function octal_prefix_small() -> Result<(), TestError> {
    const a: i32 = 0o17;
    return expect_eq(a, 15);
}

![test]
function octal_prefix_uppercase_o() -> Result<(), TestError> {
    const a: i32 = 0O777;
    return expect_eq(a, 511);
}

![test]
function leading_zero_is_decimal_not_octal() -> Result<(), TestError> {
    // `077` is decimal 77, NOT C-style octal 63.
    const a: i32 = 077;
    return expect_eq(a, 77);
}

![test]
function octal_in_u64_const() -> Result<(), TestError> {
    // The codegen-side parser (parse_int_lexeme) must agree with the
    // parser-side one; exercise a u64-typed octal const through it.
    const mode: u64 = 0o644;
    return expect_eq(mode, 420);
}

// Negative / folded module-level integer const globals.
//
// A module-level `const X: iN = -V` parses as a UnaryExpression, not a bare
// Literal.  The global-variable codegen handled bare integer literals and
// folded constant *float* initializers, but no integer const-expression, so
// a negative integer global fell through to `zeroinitializer` - every
// negative module-level constant (EOF, AT_FDCWD, the EAI_* family,
// INVALID_HANDLE_VALUE, ...) silently emitted as 0.  Fixed by folding
// integer const-expression initializers (unary -/+/~ and the
// sign-independent binary ops +/-/*/<</&/|/^) before the zero fallback in
// declaration_emitter.cryo.  These globals are referenced, not inlined
// (codegen does no const-propagation of globals), so the test loads the
// emitted initializer.
const NEG_I32_G:   i32 = -5;
const NEG_I64_G:   i64 = -100;
const EOF_G:       i32 = -1;            // the EOF / SOCKET_ERROR shape
const NEG_EXPR_G:  i32 = 0 - 42;
const FLAG_BITS_G: u32 = (1 << 4) | (1 << 2);   // 20
const POS_GUARD_G: i32 = 7;

![test]
function neg_i32_global_keeps_value() -> Result<(), TestError> {
    const x: i32 = NEG_I32_G;
    return expect_eq(x, -5);
}

![test]
function neg_i64_global_keeps_value() -> Result<(), TestError> {
    const x: i64 = NEG_I64_G;
    return expect_eq(x, -100);
}

![test]
function neg_one_global_keeps_value() -> Result<(), TestError> {
    const x: i32 = EOF_G;
    return expect_eq(x, -1);
}

![test]
function neg_const_expr_global_folds() -> Result<(), TestError> {
    const x: i32 = NEG_EXPR_G;
    return expect_eq(x, -42);
}

![test]
function bitwise_const_expr_global_folds() -> Result<(), TestError> {
    const x: u32 = FLAG_BITS_G;
    return expect_eq(x, 20);
}

![test]
function positive_global_unaffected() -> Result<(), TestError> {
    // Guard: the integer-fold path must not disturb a plain positive literal.
    const x: i32 = POS_GUARD_G;
    return expect_eq(x, 7);
}
