///! Compiler diagnostics — regression coverage that the compiler REJECTS
///! bad code with the right error, and does NOT over-reject good code.
///!
///! These are ordinary `![test]` functions: they pass the offending (or
///! valid) source to `expect_compile_error` / `expect_compiles` from
///! `std::test::compile`, which type-checks it in a child compiler. No
///! separate harness, no separate command — they run inside `cryo test`
///! like everything else.  Snippets use `cf_`-prefixed names so they can't
///! collide with stdlib-internal symbols.

![config(testing)]
namespace CryoTests::Tests::Lang::Diagnostics;

import std::core::result;
import std::collections::str;
import std::test::error;
import std::test::compile;

// ============================================================================
// E0214 — argument type mismatch (the recently-added check)
// ============================================================================

![test]
function e0214_free_function_arg() -> Result<(), TestError> {
    return expect_compile_error(
        Str::new("namespace S; function cf_takes_int(x: i32) -> void {} function main() -> int { cf_takes_int(\"bad\"); return 0; }"),
        Str::new("E0214"));
}

![test]
function e0214_instance_method_arg() -> Result<(), TestError> {
    return expect_compile_error(
        Str::new("namespace S; type struct CfCounter { v: i32; static cf_new() -> CfCounter { return CfCounter { v: 0 }; } cf_bump(mut &this, by: i32) -> void { this.v = this.v + by; } } function main() -> int { mut c: CfCounter = CfCounter::cf_new(); c.cf_bump(\"bad\"); return 0; }"),
        Str::new("E0214"));
}

![test]
function e0214_trait_method_arg() -> Result<(), TestError> {
    return expect_compile_error(
        Str::new("namespace S; type trait CfSink { cf_absorb(mut &this, x: i32) -> void; } type struct CfS { v: i32; static cf_new() -> CfS { return CfS { v: 0 }; } } implement trait CfSink for struct CfS { cf_absorb(mut &this, x: i32) -> void { this.v = x; } } function main() -> int { mut s: CfS = CfS::cf_new(); s.cf_absorb(\"bad\"); return 0; }"),
        Str::new("E0214"));
}

![test]
function e0214_wrong_struct_arg() -> Result<(), TestError> {
    return expect_compile_error(
        Str::new("namespace S; type struct CfA { v: i32; } type struct CfB { v: i32; } function cf_take_a(a: CfA) -> void {} function main() -> int { const b: CfB = CfB { v: 1 }; cf_take_a(b); return 0; }"),
        Str::new("E0214"));
}

// Static-method calls (Type::method(args)) currently bypass E0214: the
// `Type::method` symbol isn't registered as a single function-typed
// overload, so check_scope_call_arg_types() skips it (sema.cryo ~3330).
// This test pins the CORRECT expectation and is marked `![xfail]`: it runs
// in the normal suite, reports `xfail` while the gap exists, and turns into
// a hard XPASS failure the moment static-call checking starts working — at
// which point the `![xfail]` marker should be removed.
![test]
![xfail]
function e0214_static_method_arg_KNOWN_GAP() -> Result<(), TestError> {
    return expect_compile_error(
        Str::new("namespace S; type struct CfMake { v: i32; static cf_of(x: i32) -> CfMake { return CfMake { v: x }; } } function main() -> int { const m: CfMake = CfMake::cf_of(\"bad\"); return 0; }"),
        Str::new("E0214"));
}

// ============================================================================
// Over-rejection guards — these MUST compile (coercions the checker must
// not flag as category mismatches)
// ============================================================================

![test]
function pass_u64_literal() -> Result<(), TestError> {
    return expect_compiles(
        Str::new("namespace S; function cf_take_u64(x: u64) -> void {} function main() -> int { cf_take_u64(16); return 0; }"));
}

![test]
function pass_int_narrowing() -> Result<(), TestError> {
    return expect_compiles(
        Str::new("namespace S; function cf_take_i32(x: i32) -> void {} function main() -> int { const v: i64 = 5; cf_take_i32(v); return 0; }"));
}

![test]
function pass_ref_to_ptr() -> Result<(), TestError> {
    return expect_compiles(
        Str::new("namespace S; function cf_take_ptr(p: i32*) -> void {} function main() -> int { mut x: i32 = 7; cf_take_ptr(&x); return 0; }"));
}

![test]
function pass_enum_to_int() -> Result<(), TestError> {
    return expect_compiles(
        Str::new("namespace S; type enum CfColor : i32 { Red; Green; Blue; } function cf_take_int(x: i32) -> void {} function main() -> int { cf_take_int(CfColor::Green); return 0; }"));
}

![test]
function pass_generic_call() -> Result<(), TestError> {
    return expect_compiles(
        Str::new("namespace S; function cf_identity<T>(x: T) -> T { return x; } function main() -> int { const v: i32 = cf_identity<i32>(5); return 0; }"));
}

// ============================================================================
// Older diagnostics that already fire — guard them too
// ============================================================================

![test]
function e0200_const_type_mismatch() -> Result<(), TestError> {
    return expect_compile_error(
        Str::new("namespace S; function main() -> int { const x: i32 = \"not an int\"; return 0; }"),
        Str::new("E0200"));
}

![test]
function e0201_undefined_variable() -> Result<(), TestError> {
    return expect_compile_error(
        Str::new("namespace S; function main() -> int { const y: i32 = cf_undefined_name; return y; }"),
        Str::new("E0201"));
}

![test]
function e0202_undefined_function() -> Result<(), TestError> {
    return expect_compile_error(
        Str::new("namespace S; function main() -> int { cf_no_such_function(); return 0; }"),
        Str::new("E0202"));
}

![test]
function e0215_too_many_args() -> Result<(), TestError> {
    return expect_compile_error(
        Str::new("namespace S; function cf_one(x: i32) -> void {} function main() -> int { cf_one(1, 2); return 0; }"),
        Str::new("E0215"));
}

![test]
function e0216_too_few_args() -> Result<(), TestError> {
    return expect_compile_error(
        Str::new("namespace S; function cf_two(x: i32, y: i32) -> void {} function main() -> int { cf_two(1); return 0; }"),
        Str::new("E0216"));
}

// ============================================================================
// Lexer / parser errors
// ============================================================================

![test]
function e0002_unterminated_string() -> Result<(), TestError> {
    // The inner `\"` opens a string that never closes inside the snippet.
    return expect_compile_error(
        Str::new("namespace S; function main() -> int { const s: string = \"unterminated; return 0; }"),
        Str::new("E0002"));
}

![test]
function e0100_missing_semicolon() -> Result<(), TestError> {
    return expect_compile_error(
        Str::new("namespace S; function main() -> int { const x: i32 = 1 return 0; }"),
        Str::new("E0100"));
}

![test]
function e0102_expected_expression() -> Result<(), TestError> {
    return expect_compile_error(
        Str::new("namespace S; function main() -> int { const x: i32 = ; return 0; }"),
        Str::new("E0102"));
}

![test]
function e0104_expected_type() -> Result<(), TestError> {
    return expect_compile_error(
        Str::new("namespace S; function cf_f(x: ) -> void {} function main() -> int { return 0; }"),
        Str::new("E0104"));
}

// ============================================================================
// Declaration / directive errors
// ============================================================================

![test]
function e0064_duplicate_enum_discriminant() -> Result<(), TestError> {
    return expect_compile_error(
        Str::new("namespace S; type enum CfE { A = 1; B = 1; } function main() -> int { return 0; }"),
        Str::new("E0064"));
}

![test]
function e0150_directive_bad_arity() -> Result<(), TestError> {
    // `![inline]` takes no arguments.
    return expect_compile_error(
        Str::new("namespace S; ![inline(3)] function cf_f() -> void {} function main() -> int { return 0; }"),
        Str::new("E0150"));
}

// ============================================================================
// Type & semantic errors
// ============================================================================

![test]
function e0203_undefined_type() -> Result<(), TestError> {
    return expect_compile_error(
        Str::new("namespace S; function cf_f(x: CfNoType) -> void {} function main() -> int { return 0; }"),
        Str::new("E0203"));
}

![test]
function e0204_undefined_field() -> Result<(), TestError> {
    return expect_compile_error(
        Str::new("namespace S; type struct CfP { x: i32; } function main() -> int { const p: CfP = CfP { x: 1 }; return p.y; }"),
        Str::new("E0204"));
}

![test]
function e0218_assign_to_const() -> Result<(), TestError> {
    return expect_compile_error(
        Str::new("namespace S; function main() -> int { const x: i32 = 1; x = 2; return 0; }"),
        Str::new("E0218"));
}

![test]
function e0229_invalid_binary_op() -> Result<(), TestError> {
    // Adding two structs with no operator overload is a category error.
    return expect_compile_error(
        Str::new("namespace S; type struct CfA { v: i32; } function main() -> int { const a: CfA = CfA { v: 1 }; const b: CfA = CfA { v: 2 }; const c: CfA = a + b; return 0; }"),
        Str::new("E0229"));
}

![test]
function e0230_deref_non_pointer() -> Result<(), TestError> {
    return expect_compile_error(
        Str::new("namespace S; function main() -> int { const x: i32 = 5; const y: i32 = *x; return y; }"),
        Str::new("E0230"));
}

![test]
function e0306_trait_bound_not_satisfied() -> Result<(), TestError> {
    // `i32` does not implement `CfShow`, so the bounded call is rejected.
    return expect_compile_error(
        Str::new("namespace S; type trait CfShow { cf_show(&this) -> i32; } function cf_need<T>(x: T) -> i32 where T: CfShow { return x.cf_show(); } function main() -> int { return cf_need<i32>(5); }"),
        Str::new("E0306"));
}

![test]
function e0403_missing_return() -> Result<(), TestError> {
    return expect_compile_error(
        Str::new("namespace S; function cf_needs() -> i32 { } function main() -> int { return 0; }"),
        Str::new("E0403"));
}

![test]
function e0405_non_exhaustive_match() -> Result<(), TestError> {
    // The match omits `CfC::Blue`.
    return expect_compile_error(
        Str::new("namespace S; type enum CfC { Red; Green; Blue; } function main() -> int { const c: CfC = CfC::Red; match (c) { CfC::Red => {} CfC::Green => {} } return 0; }"),
        Str::new("E0405"));
}

![test]
function e0233_undefined_static() -> Result<(), TestError> {
    // Calling a static that the type doesn't define.
    return expect_compile_error(
        Str::new("namespace S; type struct CfX { v: i32; } function main() -> int { const x: CfX = CfX::cf_make(); return 0; }"),
        Str::new("E0233"));
}

![test]
function e0353_private_field_access() -> Result<(), TestError> {
    return expect_compile_error(
        Str::new("namespace S; type struct CfS { private: secret: i32; public: static cf_new() -> CfS { return CfS { secret: 0 }; } } function main() -> int { const s: CfS = CfS::cf_new(); return s.secret; }"),
        Str::new("E0353"));
}

![test]
function e0355_missing_field_init() -> Result<(), TestError> {
    return expect_compile_error(
        Str::new("namespace S; type struct CfP { x: i32; y: i32; } function main() -> int { const p: CfP = CfP { x: 1 }; return p.x; }"),
        Str::new("E0355"));
}

// ============================================================================
// Diagnostics the compiler SHOULD emit but doesn't yet.
//
// Each of these is a bug-or-gap: the snippet is malformed in a way that
// ought to be rejected, but today it compiles cleanly (or reports a less
// precise code). They are `![xfail]`, so they run in the normal suite as
// `xfail` and act as a living spec of intended diagnostics. The moment the
// compiler starts emitting the expected code, the test flips to XPASS and
// fails the build — prompting whoever fixed it to drop the `![xfail]`.
// ============================================================================

![test]
![xfail]
function gap_e0400_break_outside_loop() -> Result<(), TestError> {
    // `break` with no enclosing loop should be rejected.
    return expect_compile_error(
        Str::new("namespace S; function main() -> int { break; return 0; }"),
        Str::new("E0400"));
}

![test]
![xfail]
function gap_e0401_continue_outside_loop() -> Result<(), TestError> {
    return expect_compile_error(
        Str::new("namespace S; function main() -> int { continue; return 0; }"),
        Str::new("E0401"));
}

![test]
![xfail]
function gap_e0114_duplicate_default_arm() -> Result<(), TestError> {
    // Two `_` arms in one match.
    return expect_compile_error(
        Str::new("namespace S; function main() -> int { const x: i32 = 1; match (x) { _ => {} _ => {} } return 0; }"),
        Str::new("E0114"));
}

![test]
![xfail]
function gap_e0226_division_by_zero() -> Result<(), TestError> {
    return expect_compile_error(
        Str::new("namespace S; function main() -> int { const x: i32 = 1 / 0; return x; }"),
        Str::new("E0226"));
}

![test]
![xfail]
function gap_e0232_invalid_assignment_target() -> Result<(), TestError> {
    // Assigning to a literal is not an lvalue.
    return expect_compile_error(
        Str::new("namespace S; function main() -> int { 5 = 3; return 0; }"),
        Str::new("E0232"));
}

![test]
![xfail]
function gap_e0223_address_of_literal() -> Result<(), TestError> {
    // `&5` should be E0223 (invalid address-of); today it surfaces as a
    // generic E0200 type mismatch instead.
    return expect_compile_error(
        Str::new("namespace S; function main() -> int { const p: i32* = &5; return p; }"),
        Str::new("E0223"));
}

![test]
![xfail]
function gap_e0500_module_not_found() -> Result<(), TestError> {
    // Importing a nonexistent module is silently accepted today.
    return expect_compile_error(
        Str::new("namespace S; import std::nonexistent::thing; function main() -> int { return 0; }"),
        Str::new("E0500"));
}

![test]
![xfail]
function gap_e0356_duplicate_field() -> Result<(), TestError> {
    return expect_compile_error(
        Str::new("namespace S; type struct CfDup { a: i32; a: i32; } function main() -> int { return 0; }"),
        Str::new("E0356"));
}

![test]
![xfail]
function gap_e0206_redefined_function() -> Result<(), TestError> {
    return expect_compile_error(
        Str::new("namespace S; function cf_g() -> void {} function cf_g() -> void {} function main() -> int { return 0; }"),
        Str::new("E0206"));
}

![test]
![xfail]
function gap_e0207_redefined_type() -> Result<(), TestError> {
    return expect_compile_error(
        Str::new("namespace S; type struct CfD { x: i32; } type struct CfD { y: i32; } function main() -> int { return 0; }"),
        Str::new("E0207"));
}

![test]
![xfail]
function gap_e0010_number_too_large() -> Result<(), TestError> {
    // A literal far beyond u8 range should be rejected.
    return expect_compile_error(
        Str::new("namespace S; function main() -> int { const x: u8 = 99999999999999999999999999; return 0; }"),
        Str::new("E0010"));
}
