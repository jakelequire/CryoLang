///! Same-width sign-reinterpretation policy for call arguments.
///!
///! Sub-64-bit runtime sign flips are rejected (E0214, see
///! tests/negative/E0214_runtime_sign_reinterpret.cryo). This pins the
///! COMPLEMENTARY leniency so the runtime check can't regress into
///! over-rejecting the benign cases:
///!   - 64-bit i64<->u64 runtime passing (pervasive for lengths/offsets)
///!   - a literal whose value fits the unsigned target
///! Both must keep compiling without an `as` cast.

![config(testing)]
namespace CryoTests::Tests::Lang::SignReinterpretPolicy;

import std::core::result;
import std::test::error;
import std::test::assert;

function takes_u64(u: u64) -> u64 { return u; }
function takes_u32(u: u32) -> u32 { return u; }

![test]
function i64_to_u64_runtime_is_allowed() -> Result<(), TestError> {
    mut n: i64 = 42;
    const got: u64 = takes_u64(n);   // 64-bit reinterpret: lenient by design
    return expect_eq(got, 42);
}

![test]
function fitting_literal_to_u32_is_allowed() -> Result<(), TestError> {
    const got: u32 = takes_u32(7);   // literal fits the target: exempt
    return expect_eq(got, 7);
}
