///! Sign changes at call arguments.
///!
///! An integer argument converts to its parameter implicitly only where the
///! parameter holds every value of it, so a runtime value of the other sign
///! at the same width is refused (E0214, see
///! tests/negative/E0214_argument_would_change_value.cryo) and is converted
///! with `as`.  This pins what still compiles without one: an unsigned value
///! into a wider signed parameter, and a literal whose value fits.

![config(testing)]
namespace CryoTests::Tests::Lang::SignReinterpretPolicy;

import std::core::result::{ Result };
import std::test::error::{ TestError };
import std::test::assert::{ expect_eq };

function takes_u64(u: u64) -> u64 { return u; }
function takes_u32(u: u32) -> u32 { return u; }
function takes_i64(i: i64) -> i64 { return i; }

![test]
function i64_to_u64_runtime_converts_with_as() -> Result<(), TestError> {
    mut n: i64 = 42;
    const got: u64 = takes_u64(n as u64);
    return expect_eq(got, 42);
}

![test]
function u32_to_i64_runtime_widens_unsigned() -> Result<(), TestError> {
    mut n: u32 = 4294967295;
    const got: i64 = takes_i64(n);
    return expect_eq(got, 4294967295);
}

![test]
function fitting_literal_to_u32_is_allowed() -> Result<(), TestError> {
    const got: u32 = takes_u32(7);   // literal fits the target: exempt
    return expect_eq(got, 7);
}
