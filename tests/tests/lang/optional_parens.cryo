///! The `()` around an `if` / `while` / `for` / `match` condition is OPTIONAL.
///! `if cond { .. }` is equivalent to `if (cond) { .. }`.  A paren-less
///! condition suppresses a *bare* struct literal at its own bracketing depth so
///! the following `{` reads as the body; a struct literal wrapped in `()` (or
///! nested inside a call's parens) is still parsed as a value.  The fully
///! parenthesized forms must keep working unchanged.

![config(testing)]
namespace CryoTests::Tests::Lang::OptionalParens;

import std::core::result;
import std::test::error;
import std::test::assert;

type struct Pt { x: i32; y: i32; }

function pt_x(p: Pt) -> i32 { return p.x; }

![test]
function optional_parens_all_forms() -> Result<(), TestError> {
    mut sum: i32 = 0;

    // if without parens
    const flag: boolean = true;
    if flag { sum = sum + 1; }

    // while without parens
    mut i: i32 = 0;
    while i < 3 { sum = sum + 10; i++; }

    // C-style for without parens (update runs up to the body `{`)
    for mut j: i32 = 0; j < 2; j++ { sum = sum + 100; }

    // for-in without parens
    for v in 0..3 { sum = sum + v; }

    // match without parens
    const label: i32 = match sum {
        234 => { 7 }
        _   => { 0 }
    };

    // A struct literal nested inside `()` within a paren-less condition still
    // parses as a value (the `(` re-enables struct literals).
    if sum > pt_x(Pt { x: 0, y: 0 }) { sum = sum + 1000; }

    match (expect_eq(sum, 1234)) {
        Result::Ok(_)  => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    match (expect_eq(label, 7)) {
        Result::Ok(_)  => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

![test]
function parenthesized_forms_still_work() -> Result<(), TestError> {
    // The original parenthesized forms are unchanged.
    mut n: i32 = 0;
    if (n == 0) { n = n + 1; }
    while (n < 2) { n = n + 1; }
    for (mut k: i32 = 0; k < 2; k++) { n = n + 10; }
    // A parenthesized struct-literal condition is allowed.
    if (Pt { x: 1, y: 0 }.x == 1) { n = n + 100; }
    match (expect_eq(n, 122)) {
        Result::Ok(_)  => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}
