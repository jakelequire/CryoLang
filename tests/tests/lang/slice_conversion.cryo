///! A container's reference converts to a slice reference where one is
///! wanted: a `&Array<T>` or `mut &Array<T>` is given as its `as_slice()`
///! where a `&Slice<T>` is wanted, and a `mut &Array<T>` as its
///! `as_mutable_slice()` where a `mut &Slice<T>` is.  Each place a value
///! meets a declared type converts it: an argument, a declared binding's
///! initializer, an assignment, a struct literal's field and a `return`,
///! and in a generic body a type parameter converts by a bound naming the
///! trait.

![config(testing)]
namespace CryoTests::Tests::Lang::SliceConversion;

import std::core::result::{ Result };
import std::core::slice::{ AsSlice, Slice };
import std::collections::array::{ Array };
import std::test::error::{ TestError };
import std::test::assert::{ expect_eq };

function total(items: &Slice<i32>) -> i64 {
    mut sum: i64 = 0;
    for (mut i: i64 = 0; i < items.length(); i++) {
        sum += items[i] as i64;
    }
    return sum;
}

function double_each(items: mut &Slice<i32>) -> void {
    for (mut i: i64 = 0; i < items.length(); i++) {
        items[i] = items[i] * 2;
    }
}

function total_of<C>(container: &C) -> i64 where C: AsSlice<i32> {
    return total(container);
}

function as_view(values: &Array<i32>) -> &Slice<i32> {
    return values;
}

type struct Window {
    items: &Slice<i32>;
}

function three() -> Array<i32> {
    mut values: Array<i32> = Array::<i32>::new();
    values.push(1);
    values.push(2);
    values.push(3);
    return values;
}

![test]
function array_converts_for_an_argument() -> Result<(), TestError> {
    const values: Array<i32> = three();
    return expect_eq(total(&values), 6);
}

![test]
function writable_array_converts_for_a_writable_argument() -> Result<(), TestError> {
    mut values: Array<i32> = three();
    double_each(&values);
    expect_eq(values[0], 2)?;
    return expect_eq(values[2], 6);
}

![test]
function array_converts_for_a_declared_binding() -> Result<(), TestError> {
    const values: Array<i32> = three();
    const view: &Slice<i32> = &values;
    return expect_eq(view.length(), 3);
}

![test]
function array_converts_for_an_assignment() -> Result<(), TestError> {
    const first: Array<i32> = three();
    mut second: Array<i32> = three();
    second.push(4);
    mut view: &Slice<i32> = &first;
    view = &second;
    return expect_eq(total(view), 10);
}

![test]
function array_converts_for_a_struct_field() -> Result<(), TestError> {
    const values: Array<i32> = three();
    const window: Window = Window { items: &values };
    return expect_eq(total(window.items), 6);
}

![test]
function array_converts_for_a_return() -> Result<(), TestError> {
    const values: Array<i32> = three();
    return expect_eq(total(as_view(&values)), 6);
}

![test]
function type_parameter_converts_by_its_bound() -> Result<(), TestError> {
    const values: Array<i32> = three();
    return expect_eq(total_of(&values), 6);
}
