///! An impl head names every parameter of the template it is written for.
///! `Cell<T, A = Tag>` defaults its second parameter; the two accepted
///! spellings are the parameter form (`implement<T, A> ... for Cell<T, A>`)
///! and a concrete instantiation (`implement<T> ... for Cell<T, Tag>`).  Both
///! compile and both dispatch on the default instantiation, which is what a
///! use that writes `Cell<i32>` means.  The elided forms are refused by
///! `E0302_impl_head_elides_all_params` and `E0302_impl_head_elides_trailing_param`.
///! An inherent block declares its parameters in the list that names them.

![config(testing)]
namespace CryoTests::Tests::Lang::ImplHeadFullParams;

import std::core::result;
import std::core::result::{ Result };
import std::collections::str;
import std::collections::str::{ Str };
import std::test::error;
import std::test::error::{ TestError };
import std::test::assert;
import std::test::assert::{ expect_eq };

type struct Tag { n: i32; }

type struct Cell<T, A = Tag> {
    value: T;
    tag:   A;
}

type trait Twice { twice(&this) -> i32; }
type trait Thrice { thrice(&this) -> i32; }

implement<T, A> trait Twice for Cell<T, A> {
    twice(&this) -> i32 { return 2; }
}

implement<T> trait Thrice for Cell<T, Tag> {
    thrice(&this) -> i32 { return 3; }
}

// The tag's field is read where its type is known: a bound gives `A`
// methods, never fields, so `this.tag.n` here would be E0204.
implement struct Cell<T, A> {
    tag_ref(&this) -> &A { return &this.tag; }
}

type trait Tagged { tagged(&this) -> i32; }

implement<T> trait Tagged for Cell<T, Tag> {
    tagged(&this) -> i32 { return this.tag.n; }
}

![test]
function parameter_form_dispatches() -> Result<(), TestError> {
    const c: Cell<i32> = Cell::<i32> { value: 1, tag: Tag { n: 7 } };
    return expect_eq(c.twice(), 2);
}

![test]
function concrete_form_dispatches() -> Result<(), TestError> {
    const c: Cell<i32> = Cell::<i32> { value: 1, tag: Tag { n: 7 } };
    return expect_eq(c.thrice(), 3);
}

![test]
function inherent_block_names_its_parameters() -> Result<(), TestError> {
    const c: Cell<i32> = Cell::<i32> { value: 1, tag: Tag { n: 7 } };
    return expect_eq(c.tag_ref().n, 7);
}

![test]
function concrete_form_reads_the_tag() -> Result<(), TestError> {
    const c: Cell<i32> = Cell::<i32> { value: 1, tag: Tag { n: 7 } };
    return expect_eq(c.tagged(), 7);
}
