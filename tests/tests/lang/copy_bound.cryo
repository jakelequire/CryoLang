///! `where T: Copy` bound - structural marker, no impl blocks.
///!
///! `Copy` is declared in `core/marker` as an empty marker trait. The
///! compiler treats the bound specially: satisfaction is decided by
///! walking the substituted type, not by searching the trait-impl
///! registry. Primitives, pointers, references and aggregates of all-
///! Copy fields qualify; types that carry an explicit `Drop` impl do
///! not.

![config(testing)]
namespace CryoTests::Tests::Lang::CopyBound;

import std::core::result;
import std::core::marker;
import std::test::error;
import std::test::assert;
import std::collections::str;

/// Generic function gated on `T: Copy`.  If the bound machinery is
/// wired correctly, instantiation with primitives links cleanly;
/// instantiation with a non-Copy type would fail bound-checking and
/// the call site would not compile.
function take_copy<T>(value: T) -> T where T: Copy {
    return value;
}

type struct PodPair {
    a: i32;
    b: i32;
}

![test]
function primitives_are_copy() -> Result<(), TestError> {
    const x: i32 = 42;
    const y: i32 = take_copy(x);
    return expect_eq(y, 42);
}

![test]
function pod_aggregate_is_copy() -> Result<(), TestError> {
    const p: PodPair = PodPair { a: 3, b: 4 };
    const q: PodPair = take_copy(p);
    match (expect_eq(q.a, 3)) {
        Result::Ok(_)  => {}
        Result::Err(e) => { return Result::Err(e); }
    }
    return expect_eq(q.b, 4);
}

![test]
function f64_is_copy() -> Result<(), TestError> {
    const v: f64 = 1.5;
    const w: f64 = take_copy(v);
    if (w != 1.5) {
        return Result::Err(TestError::failed(Str::new("f64 round-trip via Copy bound failed")));
    }
    return Result::Ok(());
}

// A user-defined Copy type can live in an `Array` (which is `where T: Drop`)
// AND be read out by value with `.get()` (which is `where T: Copy`).  This
// is the parity-with-primitives behaviour: a Copy type trivially satisfies
// `Drop` (its drop is a no-op) so the container instantiates, while staying
// Copy so `get` is available.  The array drops at scope end with no error
// and no leak (its element-drops are no-ops, then it frees the buffer).

type enum PodTag { Num(i64); Flag; }      // all-primitive payloads -> Copy

![test]
function copy_pod_struct_in_array_get() -> Result<(), TestError> {
    mut xs: Array<PodPair> = Array<PodPair>::new();
    xs.push(PodPair { a: 1, b: 2 });
    xs.push(PodPair { a: 3, b: 4 });
    match (xs.get(1)) {
        Option::Some(p) => {
            expect_eq(p.a, 3)?;
            expect_eq(p.b, 4)?;
        }
        Option::None => {
            return Result::Err(TestError::failed(
                Str::new("expected Some from Array<PodPair>::get")));
        }
    }
    return expect_eq(xs.length() as i32, 2);
}

![test]
function copy_pod_enum_in_array_get() -> Result<(), TestError> {
    mut ts: Array<PodTag> = Array<PodTag>::new();
    ts.push(PodTag::Num(42));
    ts.push(PodTag::Flag);
    mut sum: i64 = 0;
    for (mut i: u64 = 0; i < ts.length(); i++) {
        match (ts.get(i)) {
            Option::Some(t) => {
                match (t) {
                    PodTag::Num(n) => { sum = sum + n; }
                    PodTag::Flag   => { sum = sum + 1; }
                }
            }
            Option::None => { }
        }
    }
    return expect_eq(sum as i32, 43);   // 42 + 1
}
