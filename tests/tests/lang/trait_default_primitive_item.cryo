///! A trait default bounded on a projection (`where This::Item: Zap`) is
///! synthesized into an impl only when the impl's concrete `Item` implements
///! the bound.  A primitive written by its keyword (`u32`) is as concrete as
///! a declared type: an impl with `Item = u32` and no `Zap` for `u32` keeps
///! the rest of the trait and drops the default, so the program compiles.
///! `E0358_primitive_item_default` holds the call on the dropped default.

![config(testing)]
namespace CryoTests::Tests::Lang::TraitDefaultPrimitiveItem;

import std::core::result;
import std::core::result::{ Result };
import std::test::error;
import std::test::error::{ TestError };
import std::test::assert;
import std::test::assert::{ expect_eq };

type trait Zap {
    zap(&this) -> i32;
}

type trait Source {
    type Item;
    get(&this) -> This::Item;
    /// Available only where the element type is `Zap`.
    total(&this) -> i32 where This::Item: Zap {
        return this.get().zap();
    }
}

type struct Nums {
    v: u32;
}

implement trait Source<u32> for Nums {
    get(&this) -> u32 { return this.v; }
}

type struct Word {
    n: i32;
}

implement trait Zap for Word {
    zap(&this) -> i32 { return this.n * 2; }
}

type struct Words {
    w: Word;
}

implement trait Source<Word> for Words {
    get(&this) -> Word { return Word { n: this.w.n }; }
}

![test]
function primitive_item_without_the_bound_compiles() -> Result<(), TestError> {
    const n: Nums = Nums { v: 3 };
    return expect_eq(n.get() as i64, 3);
}

![test]
function declared_item_with_the_bound_reaches_the_default() -> Result<(), TestError> {
    const w: Words = Words { w: Word { n: 4 } };
    return expect_eq(w.total() as i64, 8);
}
