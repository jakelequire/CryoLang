///! Shadowing a binding in a NESTED block is legal (a distinct child scope).
///! Same-scope redeclaration is rejected separately (E0205, see
///! tests/negative/E0205_duplicate_local.cryo); this pins the complementary
///! rule so the duplicate-binding check can't regress into over-rejecting
///! ordinary block shadowing.

![config(testing)]
namespace CryoTests::Tests::Lang::ScopeShadowing;

import std::core::result;
import std::test::error;
import std::test::assert;

![test]
function nested_block_shadowing_is_allowed() -> Result<(), TestError> {
    const x: i32 = 1;
    mut inner_seen: i32 = 0;
    if (x > 0) {
        const x: i32 = 2;   // child scope - shadows, does not redeclare
        inner_seen = x;
    }
    expect_eq(inner_seen, 2)?;   // inner binding observed
    expect_eq(x, 1)?;            // outer binding intact after the block
    return Result::Ok(());
}

![test]
function loop_body_rebinding_each_iteration_is_allowed() -> Result<(), TestError> {
    mut sum: i32 = 0;
    mut i: i32 = 0;
    while (i < 3) {
        const step: i32 = i + 1;   // fresh binding per iteration's block scope
        sum = sum + step;
        i = i + 1;
    }
    expect_eq(sum, 6)?;   // 1 + 2 + 3
    return Result::Ok(());
}
