///! `![config(native_syscalls)]` compile-time backend gate (Low-Level Plan
///! Stage 0).  Two same-named `backend` functions are gated on opposite
///! polarities of the `native_syscalls` build flag.  ConfigGating strips
///! exactly one before name resolution — so the mere fact that this file
///! COMPILES proves the gate removed the other (two live `backend`s would be a
///! duplicate-definition error).  Under `cryo test` the flag is OFF (its
///! default; nothing sets cryoconfig `[low_level] native_syscalls`), so the
///! `not(native_syscalls)` arm is the one that survives.
///!
///! The ON polarity (native arm surviving) is covered where a project can set
///! the flag; it is proven end-to-end once the native backend lands in Stage 2.

![config(testing)]
namespace CryoTests::Tests::Lang::ConfigNativeSyscallsGate;

import std::core::result;
import std::test::error;
import std::test::assert;

// Native backend: stripped unless `native_syscalls` is ON.  Returns a value
// distinct from the libc arm so the surviving arm is identifiable at runtime.
![config(native_syscalls)]
function backend() -> i32 { return 1; }

// libc backend: active whenever `native_syscalls` is OFF (the default).
![config(not(native_syscalls))]
function backend() -> i32 { return 0; }

![test]
function default_build_selects_libc_arm() -> Result<(), TestError> {
    // Off by default => the `not(native_syscalls)` (libc) arm is the survivor.
    const got: i32 = backend();
    const want: i32 = 0;
    match (expect_eq(got, want)) {
        Result::Ok(_)  => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}
