///! Mixed-sign integer comparison must compare TRUE integer values, not the
///! bit pattern under one operand's signedness.  A negative signed value is
///! mathematically less than EVERY unsigned value; a non-negative one
///! compares as unsigned.  Regression for the order-dependent bug where the
///! icmp predicate was chosen from the left operand alone, so `(1_u32 > -1_i32)`
///! returned false while `(-1_i32 < 1_u32)` returned true.
///!
///! Covers both operand orders, the 32- and 64-bit width pairings (the latter
///! is the pervasive `i64` index vs `u64` length idiom), and value-equality.

![config(testing)]
namespace CryoTests::Tests::Lang::MixedSignCompare;

import std::core::result;
import std::test::error;
import std::test::assert;

![test]
function i32_u32_both_orders() -> Result<(), TestError> {
    const a: i32 = -1;
    const b: u32 = 1;
    match (expect_eq((a < b)  as i32, 1)) { Result::Ok(_) => {} Result::Err(e) => { return Result::Err(e); } }
    match (expect_eq((b > a)  as i32, 1)) { Result::Ok(_) => {} Result::Err(e) => { return Result::Err(e); } }
    match (expect_eq((a <= b) as i32, 1)) { Result::Ok(_) => {} Result::Err(e) => { return Result::Err(e); } }
    match (expect_eq((b >= a) as i32, 1)) { Result::Ok(_) => {} Result::Err(e) => { return Result::Err(e); } }
    return expect_eq((a > b) as i32, 0);
}

![test]
function i64_u64_both_orders() -> Result<(), TestError> {
    const i: i64 = -1;
    const n: u64 = 5;
    match (expect_eq((i < n) as i32, 1)) { Result::Ok(_) => {} Result::Err(e) => { return Result::Err(e); } }
    match (expect_eq((n > i) as i32, 1)) { Result::Ok(_) => {} Result::Err(e) => { return Result::Err(e); } }
    match (expect_eq((i > n) as i32, 0)) { Result::Ok(_) => {} Result::Err(e) => { return Result::Err(e); } }
    return expect_eq((n < i) as i32, 0);
}

![test]
function mixed_sign_value_equality() -> Result<(), TestError> {
    // -1 and 4294967295 share a bit pattern but are DIFFERENT integers.
    const neg: i32 = -1;
    const big: u32 = 4294967295;
    match (expect_eq((neg == big) as i32, 0)) { Result::Ok(_) => {} Result::Err(e) => { return Result::Err(e); } }
    return expect_eq((neg != big) as i32, 1);
}

![test]
function non_negative_unaffected() -> Result<(), TestError> {
    // The common, value-safe case still works in both orders.
    const p: i32 = 5;
    const q: u32 = 3;
    match (expect_eq((p > q) as i32, 1)) { Result::Ok(_) => {} Result::Err(e) => { return Result::Err(e); } }
    return expect_eq((q < p) as i32, 1);
}
