///! `![implicit]` conversions driven by a static constructor.
///!
///! Marking a single-parameter, non-generic static method `![implicit]`
///! registers it as the constructor the compiler reaches for when a value
///! of the parameter type must become the owning type.  The stdlib marks
///! `Str::new(string)` and `String::from_cstr(string)`, so a string
///! literal flows into a `Str` / `String` slot — a call argument
///! (`println("text")`) or a typed binding (`mut s: Str = "text"`).  User
///! code registers its own converters the same way, proving the mechanism
///! is attribute-driven, not built into the string types.

![config(testing)]
namespace CryoTests::Tests::Lang::ImplicitArgConversion;

import std::core::result;
import std::collections::string;
import std::collections::str;
import std::test::error;
import std::test::assert;

// -- Free-function argument conversion (via static constructors) ---------

/// Takes an owned `String` by value (the converter materializes one via
/// `String::from_cstr` and moves it in; the callee drops it at return).
function string_len(s: String) -> i32 {
    return s.length() as i32;
}

/// Takes a borrowed `Str` view (built by `Str::new`).
function str_len(s: Str) -> i32 {
    return s.length() as i32;
}

![test]
function string_literal_converts_to_owned_string() -> Result<(), TestError> {
    return expect_eq(string_len("hello"), 5);
}

![test]
function string_literal_converts_to_str_view() -> Result<(), TestError> {
    return expect_eq(str_len("abcd"), 4);
}

/// An exact `Str` argument resolves WITHOUT a converter (the coercion only
/// fires on an incompatible argument).
![test]
function exact_str_argument_needs_no_conversion() -> Result<(), TestError> {
    const view: Str = Str::from_cstr("exact");
    return expect_eq(str_len(view), 5);
}

// -- Typed-binding conversion (`mut foo: Str = "..."`) -------------------

![test]
function typed_binding_converts_to_str() -> Result<(), TestError> {
    const greeting: Str = "Hello, world";
    return expect_eq(greeting.length() as i32, 12);
}

![test]
function typed_binding_converts_to_owned_string() -> Result<(), TestError> {
    const owned: String = "owned";
    return expect_eq(owned.length() as i32, 5);
}

// -- User-defined converter for a custom type ----------------------------

type struct Celsius {
    degrees: i32;

    /// User-registered converter `i32 -> Celsius`, driven by the same
    /// `![implicit]` static-constructor mechanism the stdlib uses.
    ![implicit]
    static from_int(value: i32) -> Celsius {
        return Celsius { degrees: value };
    }
}

function read_celsius(c: Celsius) -> i32 {
    return c.degrees;
}

![test]
function user_converter_bridges_int_to_struct() -> Result<(), TestError> {
    // `42` is `i32`; `read_celsius` wants `Celsius`; `Celsius::from_int`
    // bridges it.
    return expect_eq(read_celsius(42), 42);
}

![test]
function user_converter_bridges_typed_binding() -> Result<(), TestError> {
    const temp: Celsius = 21;
    return expect_eq(read_celsius(temp), 21);
}

// -- Method-argument conversion ------------------------------------------

type struct Tally {
    total: i32;

    static new() -> Tally {
        return Tally { total: 0 };
    }

    /// Method parameter is `Str`; a `string`-literal argument at the call
    /// site is bridged by `Str::new`.
    add(mut &this, label: Str) -> void {
        this.total = this.total + (label.length() as i32);
    }
}

![test]
function method_argument_converts_from_literal() -> Result<(), TestError> {
    mut t: Tally = Tally::new();
    t.add("abc");     // string -> Str
    t.add("de");      // string -> Str
    return expect_eq(t.total, 5);
}

// -- Overloaded method-argument conversion (regression) ------------------
// When a method is OVERLOADED, overload selection still has to insert the
// `![implicit]` converter on the *chosen* overload's argument.  Previously
// the selector accepted the `Str` overload on the strength of the
// `string -> Str` converter but left the argument node untouched, so the
// raw `string` pointer was dropped into the `Str` slot and the callee read
// a garbage length (runtime abort / spurious result).

type struct Sink {
    chars: i32;
    bytes: i32;

    static new() -> Sink {
        return Sink { chars: 0, bytes: 0 };
    }

    /// Overload A: a `string` literal reaches this via `Str::new`.
    feed(mut &this, text: Str) -> void {
        this.chars = this.chars + (text.length() as i32);
    }

    /// Overload B: an exact `u8`.  Its mere presence makes `feed`
    /// overloaded, which is what previously suppressed the converter
    /// insertion on overload A.
    feed(mut &this, b: u8) -> void {
        this.bytes = this.bytes + 1;
    }
}

![test]
function overloaded_method_converts_string_literal_arg() -> Result<(), TestError> {
    mut s: Sink = Sink::new();
    s.feed("hello");        // string -> Str (Str overload), 5 chars
    s.feed("world!");       // string -> Str (Str overload), 6 chars
    s.feed(0x21 as u8);     // exact u8 overload
    expect_eq(s.chars, 11)?;
    return expect_eq(s.bytes, 1);
}
