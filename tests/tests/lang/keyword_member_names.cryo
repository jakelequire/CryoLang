///! A keyword may name a FIELD, in every position a field name appears:
///! declaration, struct literal, read and assignment.
///!
///! The member positions after `.` and `::` already accepted a keyword, and a
///! keyword could already name a method, so only field position rejected one -
///! which made a bound C struct's field unreachable rather than awkward. A
///! binding generator cannot rename such a field without breaking the ABI it
///! exists to preserve, and `type` is an ordinary member name in C.
///!
///! What follows the name is what distinguishes the member kinds: `(` or `<`
///! means method, `:` means field.

![config(testing)]
namespace CryoTests::Tests::Lang::KeywordMemberNames;

import std::core::result;
import std::test::error;
import std::test::assert;

![repr(C)]
type struct KmPoolSize {
    type:  u32;
    count: u32;
}

// One keyword per member, drawn from the set a C header is most likely to use.
type struct KmReserved {
    match:  i32;
    const:  i32;
    struct: i32;
    import: i32;
    return: i32;
}

// A keyword field and a keyword METHOD coexist on one type: the disambiguation
// is per-member and does not depend on the name being unique.
type struct KmBoth {
    type: i32;

    type_of(&this) -> i32 { return this.type; }
}

![test]
function keyword_field_in_struct_literal() -> Result<(), TestError> {
    const p: KmPoolSize = KmPoolSize { type: 3, count: 9 };
    expect_eq(p.type as i64, 3)?;
    return expect_eq(p.count as i64, 9);
}

![test]
function keyword_field_assignment() -> Result<(), TestError> {
    mut p: KmPoolSize = KmPoolSize { type: 1, count: 1 };
    p.type = 42;
    return expect_eq(p.type as i64, 42);
}

![test]
function every_reserved_word_names_a_field() -> Result<(), TestError> {
    const r: KmReserved = KmReserved {
        match:  1,
        const:  2,
        struct: 3,
        import: 4,
        return: 5,
    };
    expect_eq(r.match as i64, 1)?;
    expect_eq(r.const as i64, 2)?;
    expect_eq(r.struct as i64, 3)?;
    expect_eq(r.import as i64, 4)?;
    return expect_eq(r.return as i64, 5);
}

// A keyword field must not disturb layout: the two `u32`s stay adjacent, which
// is the property the whole feature exists to preserve for a bound C struct.
![test]
function keyword_field_does_not_change_layout() -> Result<(), TestError> {
    return expect_eq(sizeof(KmPoolSize) as i64, 8);
}

![test]
function keyword_field_and_method_on_one_type() -> Result<(), TestError> {
    const b: KmBoth = KmBoth { type: 11 };
    return expect_eq(b.type_of() as i64, 11);
}
