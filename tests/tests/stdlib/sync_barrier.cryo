///! Barrier - single-threaded coverage of the N-thread rendezvous.
///!
///! A count-1 barrier is satisfied by the sole calling thread, so `wait()`
///! returns immediately and that thread is the leader.  Multi-thread
///! rendezvous semantics depend on std::thread and are covered there;
///! these tests pin down construction, the leader result, reuse across
///! cycles, and drop.

![config(testing)]
namespace CryoTests::Tests::Stdlib::SyncBarrier;

import std::core::result;
import std::core::drop;
import std::collections::str;
import std::sync::barrier;
import std::test::error;
import std::test::assert;

![test]
function barrier_single_party_is_leader() -> Result<(), TestError> {
    mut b: Barrier = Barrier::new(1u32);
    const r: BarrierWaitResult = b.wait();
    const leader: boolean = r.is_leader();
    b.drop();
    return expect_true(leader, Str::new(
        "the sole party at a count-1 barrier must be the leader"));
}

![test]
function barrier_reusable_across_cycles() -> Result<(), TestError> {
    // A barrier is reusable: each wait() opens a fresh cycle.  With one
    // party every cycle completes immediately and reports leader.
    mut b: Barrier = Barrier::new(1u32);
    const r1: BarrierWaitResult = b.wait();
    const r2: BarrierWaitResult = b.wait();
    const r3: BarrierWaitResult = b.wait();
    const all_leader: boolean = r1.is_leader() && r2.is_leader() && r3.is_leader();
    b.drop();
    return expect_true(all_leader, Str::new(
        "every cycle of a count-1 barrier must report leader"));
}
