///! std::random: the `RandomSource` trait (determinism, bounded draws,
///! floats, byte fill), generic collection ops (shuffle, choose),
///! polymorphism over `Rng` and `SecureRng`, and the distribution layer.

![config(testing)]
namespace CryoTests::Tests::Stdlib::Random;

import std::core::result::{ Result };
import std::core::option::{ Option };
import std::core::slice::{ Slice };
import std::collections::str::{ Str };
import std::random::rng::{ Rng };
import std::random::source::{ RandomSource };
import std::random::secure;
import std::random::secure::{ SecureRng };
import std::random::distribution::{
    Bernoulli, Exponential, Normal, UniformF64, UniformU64, WeightedIndex
};
import std::random::error::{ RandomError };
import std::random;
import std::collections::array::{ Array };
import std::thread;
import std::test::error::{ TestError };
import std::test::assert::{ expect_eq, expect_true };

// A function generic over any RandomSource - proving the same code runs
// against both Rng and SecureRng.
function all_below<R>(r: mut &R, bound: i64, n: i32) -> boolean
where R: RandomSource {
    mut ok: boolean = true;
    mut i: i32 = 0;
    while (i < n) {
        if (r.next_below(bound) >= bound) { ok = false; }
        i = i + 1;
    }
    return ok;
}

![test]
function from_seed_is_deterministic() -> Result<(), TestError> {
    mut a: Rng = Rng::from_seed(12345);
    mut b: Rng = Rng::from_seed(12345);
    expect_eq(a.next_64(), b.next_64())?;
    expect_eq(a.next_64(), b.next_64())?;
    expect_eq(a.next_64(), b.next_64())?;

    mut c: Rng = Rng::from_seed(1);
    mut d: Rng = Rng::from_seed(2);
    expect_true(c.next_64() != d.next_64(),
                Str::new("distinct seeds produce distinct streams"))?;
    return Result::Ok(());
}

![test]
function next_below_is_in_range_and_spreads() -> Result<(), TestError> {
    mut r: Rng = Rng::from_seed(777);
    mut in_range: boolean = true;
    mut saw_low:  boolean = false;
    mut saw_high: boolean = false;
    mut i: i32 = 0;
    while (i < 2000) {
        const v: i64 = r.next_below(10);
        if (v >= 10) { in_range = false; }
        if (v < 5) { saw_low = true; } else { saw_high = true; }
        i = i + 1;
    }
    expect_true(in_range, Str::new("next_below(10) always yields < 10"))?;
    expect_true(saw_low && saw_high, Str::new("next_below(10) spans its range"))?;
    return Result::Ok(());
}

![test]
function next_range_respects_bounds() -> Result<(), TestError> {
    mut r: Rng = Rng::from_seed(424242);
    mut ok: boolean = true;
    mut i: i32 = 0;
    while (i < 2000) {
        const v: u64 = r.next_range(100u64, 110u64);
        if (v < 100 || v >= 110) { ok = false; }
        i = i + 1;
    }
    expect_true(ok, Str::new("next_range(100,110) stays within [100,110)"))?;
    return Result::Ok(());
}

![test]
function next_range_signed_respects_bounds() -> Result<(), TestError> {
    // Instantiates `next_range<i64>` alongside the `next_range<u64>` above in the
    // same binary - the mixed-instantiation case that regressed generic-method
    // return resolution (a `next_range<u64>` call reading `next_range<i64>`'s
    // return). Both bare-literal forms must stay pinned to their own type.
    mut r: Rng = Rng::from_seed(909090);
    mut ok: boolean = true;
    mut i: i32 = 0;
    while (i < 2000) {
        const v: i64 = r.next_range(-5, 5);
        if (v < -5 || v >= 5) { ok = false; }
        i = i + 1;
    }
    expect_true(ok, Str::new("next_range(-5,5) stays within [-5,5)"))?;
    return Result::Ok(());
}

![test]
function next_range_narrow_span_wider_than_type() -> Result<(), TestError> {
    // -100..100 spans 200, more than `i8` holds; every draw must still land
    // in the range, and both ends of it must be reachable.
    mut r: Rng = Rng::from_seed(42);
    mut outside: i64 = 0;
    mut lowest: i8 = 0;
    mut highest: i8 = 0;
    for (mut i: i64 = 0; i < 10000; i++) {
        const v: i8 = r.next_range::<i8>(-100, 100);
        if (v < -100 || v >= 100) { outside = outside + 1; }
        if (v < lowest) { lowest = v; }
        if (v > highest) { highest = v; }
    }
    expect_eq(outside, 0)?;
    expect_true(lowest < -90 && highest > 90, Str::new("draws cover both ends of -100..100"))?;
    mut wide_outside: i64 = 0;
    for (mut i: i64 = 0; i < 10000; i++) {
        const w: i16 = r.next_range::<i16>(-30000, 30000);
        if (w < -30000 || w >= 30000) { wide_outside = wide_outside + 1; }
    }
    expect_eq(wide_outside, 0)?;
    return Result::Ok(());
}

![test]
function next_all_widths_draw() -> Result<(), TestError> {
    // Exercise codegen for the wider next<T> / next_range<T> arms (u8/u128/i128/
    // char and a 128-bit range) in one binary.
    mut r: Rng = Rng::from_seed(777);
    const _a: u8   = r.next::<u8>();
    const _b: u128 = r.next::<u128>();
    const _c: i128 = r.next::<i128>();
    const ch: char = r.next::<char>();
    const cu: u32  = ch as u32;
    expect_true(cu <= 0x10FFFF && !(cu >= 0xD800 && cu < 0xE000),
                Str::new("next<char> is a valid Unicode scalar"))?;
    const r8: u8 = r.next_range(10 as u8, 20 as u8);
    expect_true(r8 >= 10 && r8 < 20, Str::new("next_range<u8> in [10,20)"))?;
    const rw: u128 = r.next_range(0 as u128, 1000000 as u128);
    expect_true(rw < 1000000 as u128, Str::new("next_range<u128> in [0,1_000_000)"))?;
    return Result::Ok(());
}

![test]
function next_f64_is_unit_interval() -> Result<(), TestError> {
    mut r: Rng = Rng::from_seed(2024);
    mut ok: boolean = true;
    mut i: i32 = 0;
    while (i < 2000) {
        const f: f64 = r.next::<f64>();
        if (f < 0.0 || f >= 1.0) { ok = false; }
        i = i + 1;
    }
    expect_true(ok, Str::new("next_f64 stays in [0.0, 1.0)"))?;
    return Result::Ok(());
}

![test]
function fill_writes_exact_length() -> Result<(), TestError> {
    mut r: Rng = Rng::from_seed(9);
    mut buf: [u8; 8];
    mut j: u64 = 0;
    while (j < 8) { buf[j] = 0xAA; j = j + 1; }

    // Fill only the first 5 bytes; the tail must be untouched.
    r.fill(Slice::from_raw_mutable(&buf[0], 5));
    expect_eq(buf[5], 0xAAu8)?;
    expect_eq(buf[6], 0xAAu8)?;
    expect_eq(buf[7], 0xAAu8)?;
    return Result::Ok(());
}

![test]
function shuffle_is_a_permutation() -> Result<(), TestError> {
    mut r: Rng = Rng::from_seed(31337);
    mut data: [i32; 10];
    mut i: i32 = 0;
    while (i < 10) { data[i] = i; i = i + 1; }

    const view: mut &Slice<i32> = Slice::from_raw_mutable(&data[0], 10);
    r.shuffle(view);

    // Every value 0..9 appears exactly once.
    mut seen: [i32; 10];
    i = 0;
    while (i < 10) { seen[i] = 0; i = i + 1; }
    i = 0;
    while (i < 10) {
        const v: i32 = data[i];
        if (v >= 0 && v < 10) { seen[v] = seen[v] + 1; }
        i = i + 1;
    }
    mut ok: boolean = true;
    i = 0;
    while (i < 10) { if (seen[i] != 1) { ok = false; } i = i + 1; }
    expect_true(ok, Str::new("shuffle yields a permutation"))?;
    return Result::Ok(());
}

![test]
function choose_returns_an_element() -> Result<(), TestError> {
    mut r: Rng = Rng::from_seed(55);
    mut data: [i32; 5];
    data[0] = 10; data[1] = 20; data[2] = 30; data[3] = 40; data[4] = 50;
    const view: &Slice<i32> = Slice::from_raw(&data[0], 5);

    mut all_member: boolean = true;
    mut k: i32 = 0;
    while (k < 200) {
        match (r.choose(view)) {
            Option::Some(p) => {
                const v: i32 = *p;
                if (v != 10 && v != 20 && v != 30 && v != 40 && v != 50) {
                    all_member = false;
                }
            }
            Option::None => { all_member = false; }
        }
        k = k + 1;
    }
    expect_true(all_member, Str::new("choose returns a member of the slice"))?;
    return Result::Ok(());
}

![test]
function source_trait_is_polymorphic() -> Result<(), TestError> {
    // The same generic function drives both generators.
    mut fast: Rng = Rng::from_seed(8);
    expect_true(all_below(&fast, 100, 500),
                Str::new("Rng satisfies RandomSource"))?;

    mut sec: SecureRng = SecureRng::new();
    expect_true(all_below(&sec, 100, 500),
                Str::new("SecureRng satisfies RandomSource"))?;
    return Result::Ok(());
}

![test]
function secure_try_fill_fills_buffer() -> Result<(), TestError> {
    mut buf: [u8; 32];
    mut j: u64 = 0;
    while (j < 32) { buf[j] = 0; j = j + 1; }

    const sec: SecureRng = SecureRng::new();
    match (sec.try_fill(Slice::from_raw_mutable(&buf[0], 32))) {
        Result::Ok(_)  => { }
        Result::Err(_) => {
            return Result::Err(TestError::failed(Str::new("try_fill reported entropy failure")));
        }
    }

    mut nonzero: boolean = false;
    j = 0;
    while (j < 32) { if (buf[j] != 0) { nonzero = true; } j = j + 1; }
    expect_true(nonzero, Str::new("try_fill wrote entropy"))?;
    return Result::Ok(());
}

![test]
function uniform_distributions_respect_bounds() -> Result<(), TestError> {
    mut r: Rng = Rng::from_seed(101);
    const ui: UniformU64 = UniformU64::new(50, 60);
    const uf: UniformF64 = UniformF64::new(-1.0, 1.0);

    mut ok: boolean = true;
    mut i: i32 = 0;
    while (i < 1000) {
        const a: u64 = ui.sample(&r);
        if (a < 50 || a >= 60) { ok = false; }
        const b: f64 = uf.sample(&r);
        if (b < -1.0 || b >= 1.0) { ok = false; }
        i = i + 1;
    }
    expect_true(ok, Str::new("Uniform samplers stay within their ranges"))?;
    return Result::Ok(());
}

![test]
function bernoulli_matches_probability() -> Result<(), TestError> {
    mut r: Rng = Rng::from_seed(2718);
    const coin: Bernoulli = Bernoulli::new(0.25);
    mut heads: i32 = 0;
    mut i: i32 = 0;
    while (i < 4000) {
        if (coin.sample(&r)) { heads = heads + 1; }
        i = i + 1;
    }
    // Expect ~1000 heads; allow a generous band.
    expect_true(heads > 800 && heads < 1200,
                Str::new("Bernoulli(0.25) yields ~25% true"))?;
    return Result::Ok(());
}

![test]
function normal_mean_is_sane() -> Result<(), TestError> {
    mut r: Rng = Rng::from_seed(161803);
    const g: Normal = Normal::new(5.0, 2.0);
    mut sum: f64 = 0.0;
    mut i: i32 = 0;
    while (i < 4000) { sum = sum + g.sample(&r); i = i + 1; }
    const mean: f64 = sum / 4000.0;
    expect_true(mean > 4.5 && mean < 5.5,
                Str::new("Normal(5,2) sample mean is near 5"))?;
    return Result::Ok(());
}

![test]
function exponential_is_positive() -> Result<(), TestError> {
    mut r: Rng = Rng::from_seed(99);
    const e: Exponential = Exponential::new(2.0);
    mut ok: boolean = true;
    mut i: i32 = 0;
    while (i < 1000) { if (e.sample(&r) < 0.0) { ok = false; } i = i + 1; }
    expect_true(ok, Str::new("Exponential samples are non-negative"))?;
    return Result::Ok(());
}

![test]
function weighted_index_skips_zero_weight() -> Result<(), TestError> {
    mut r: Rng = Rng::from_seed(13);
    mut weights: [f64; 3];
    weights[0] = 1.0; weights[1] = 0.0; weights[2] = 3.0;

    mut wi: WeightedIndex = match (WeightedIndex::try_new(Slice::from_raw(&weights[0], 3))) {
        Result::Ok(w)  => { w }
        Result::Err(_) => {
            return Result::Err(TestError::failed(Str::new("WeightedIndex::try_new failed")));
        }
    };

    mut never_one: boolean = true;
    mut saw_zero:  boolean = false;
    mut saw_two:   boolean = false;
    mut i: i32 = 0;
    while (i < 2000) {
        const idx: u64 = wi.sample(&r);
        if (idx == 1) { never_one = false; }
        if (idx == 0) { saw_zero = true; }
        if (idx == 2) { saw_two = true; }
        i = i + 1;
    }
    expect_true(never_one, Str::new("zero-weight index is never chosen"))?;
    expect_true(saw_zero && saw_two, Str::new("both nonzero indices appear"))?;
    return Result::Ok(());
}

![test]
function weighted_index_rejects_bad_weights() -> Result<(), TestError> {
    mut empty: [f64; 1];
    empty[0] = 0.0;
    match (WeightedIndex::try_new(Slice::from_raw(&empty[0], 1))) {
        Result::Ok(wi) => {
            return Result::Err(TestError::failed(Str::new("all-zero weights should be rejected")));
        }
        Result::Err(e) => {
            const want: RandomError = RandomError::InvalidWeights;
            expect_true(e.equals(&want),
                        Str::new("all-zero weights -> InvalidWeights"))?;
            return Result::Ok(());
        }
    }
}

![test]
function fill_secure_bytes_writes_only_its_slice() -> Result<(), TestError> {
    mut bytes: [u8; 48];
    mut i: i64 = 0;
    while (i < 48) { bytes[i] = 0; i = i + 1; }
    mut whole: mut &Slice<u8> = bytes.as_mutable_slice();
    const written: i64 = secure::fill_secure_bytes(whole.subslice_mutable(8, 40));
    expect_true(written >= 1 && written <= 32, Str::new("fill_secure_bytes writes 1 to 32 bytes"))?;
    mut outside_zero: boolean = true;
    i = 0;
    while (i < 8) { if (bytes[i] != 0) { outside_zero = false; } i = i + 1; }
    i = 8 + written;
    while (i < 48) { if (bytes[i] != 0) { outside_zero = false; } i = i + 1; }
    expect_true(outside_zero, Str::new("no byte outside the slice is written"))?;
    return Result::Ok(());
}

![test]
function secure_fill_writes_every_byte() -> Result<(), TestError> {
    // 4096 random bytes hold about 16 zeros; a fill that left a stretch
    // unwritten leaves hundreds.
    mut bytes: [u8; 4096];
    mut i: i64 = 0;
    while (i < 4096) { bytes[i] = 0; i = i + 1; }
    mut source: SecureRng = SecureRng::new();
    source.fill(&bytes);
    mut zeros: i64 = 0;
    i = 0;
    while (i < 4096) { if (bytes[i] == 0) { zeros = zeros + 1; } i = i + 1; }
    expect_true(zeros < 64, Str::new("SecureRng.fill writes every byte"))?;
    return Result::Ok(());
}

// A source that draws all ones, then zeros: the largest draw a generator
// can make, followed by the smallest.
type struct LargestThenSmallest {
    drawn: i32;
}

implement trait RandomSource for struct LargestThenSmallest {
    next_64(mut &this) -> u64 {
        this.drawn = this.drawn + 1;
        if (this.drawn == 1) { return u64::MAX; }
        return 0;
    }
}

![test]
function largest_draw_of_a_float_is_below_one() -> Result<(), TestError> {
    mut wide: LargestThenSmallest = LargestThenSmallest { drawn: 0 };
    expect_true(wide.next::<f64>() < 1.0, Str::new("next::<f64>() of all ones is below 1.0"))?;
    mut narrow: LargestThenSmallest = LargestThenSmallest { drawn: 0 };
    expect_true(narrow.next::<f32>() < (1.0 as f32), Str::new("next::<f32>() of all ones is below 1.0"))?;
    return Result::Ok(());
}

![test]
function float_range_draws_again_when_rounding_reaches_high() -> Result<(), TestError> {
    // 1 + (1 - 2^-53) is halfway between the last f64 below 2 and 2, and
    // rounds to 2; the range takes the next draw, 0, and gives 1.
    mut wide: LargestThenSmallest = LargestThenSmallest { drawn: 0 };
    expect_eq(wide.next_range(1.0, 2.0), 1.0)?;
    mut narrow: LargestThenSmallest = LargestThenSmallest { drawn: 0 };
    expect_eq(narrow.next_range(1.0 as f32, 2.0 as f32), 1.0 as f32)?;
    return Result::Ok(());
}

// The free functions draw from the calling thread's generator, which is
// seeded from the OS, so their tests assert bounds and distributions
// loose enough that a correct generator fails them with negligible
// probability; the seeded `Rng` is what repeats exactly.

![test]
function free_range_rolls_every_face_evenly() -> Result<(), TestError> {
    mut faces: [i32; 6];
    mut i: i32 = 0;
    while (i < 6) { faces[i] = 0; i = i + 1; }
    mut in_bounds: boolean = true;
    i = 0;
    while (i < 12000) {
        const roll: i32 = random::range(1, 7);
        if (roll < 1 || roll >= 7) { in_bounds = false; } else { faces[roll - 1] = faces[roll - 1] + 1; }
        i = i + 1;
    }
    expect_true(in_bounds, Str::new("range(1, 7) stays in [1, 7)"))?;
    // 2000 expected per face, standard deviation about 41.
    mut even: boolean = true;
    i = 0;
    while (i < 6) { if (faces[i] < 1700 || faces[i] > 2300) { even = false; } i = i + 1; }
    expect_true(even, Str::new("every face of range(1, 7) comes up about equally"))?;
    return Result::Ok(());
}

![test]
function free_range_takes_every_integer_width() -> Result<(), TestError> {
    mut ok: boolean = true;
    mut i: i32 = 0;
    while (i < 2000) {
        const small: u8 = random::range(250 as u8, 255 as u8);
        if (small < 250 || small >= 255) { ok = false; }
        const negative: i64 = random::range(-10 as i64, -5 as i64);
        if (negative < -10 || negative >= -5) { ok = false; }
        const wide: u128 = random::range(0 as u128, 3 as u128);
        if (wide >= 3) { ok = false; }
        const whole: i8 = random::range(i8::MIN, i8::MAX);
        if (whole == i8::MAX) { ok = false; }
        i = i + 1;
    }
    expect_true(ok, Str::new("range stays in bounds for u8, i64, u128 and i8"))?;
    return Result::Ok(());
}

![test]
function free_range_of_floats_stays_below_high() -> Result<(), TestError> {
    mut ok: boolean = true;
    mut sum: f64 = 0.0;
    mut i: i32 = 0;
    while (i < 10000) {
        const x: f64 = random::range(-2.5, 2.5);
        if (x < -2.5 || x >= 2.5) { ok = false; }
        sum = sum + x;
        const y: f32 = random::range(1.0 as f32, 1.5 as f32);
        if (y < (1.0 as f32) || y >= (1.5 as f32)) { ok = false; }
        i = i + 1;
    }
    expect_true(ok, Str::new("float ranges stay in [low, high)"))?;
    // Mean 0, standard deviation of the mean about 0.014.
    const mean: f64 = sum / 10000.0;
    expect_true(mean > -0.1 && mean < 0.1, Str::new("range(-2.5, 2.5) centres on 0"))?;
    return Result::Ok(());
}

![test]
function free_float_and_boolean_are_even() -> Result<(), TestError> {
    mut ok: boolean = true;
    mut sum: f64 = 0.0;
    mut heads: i32 = 0;
    mut i: i32 = 0;
    while (i < 10000) {
        const x: f64 = random::float();
        if (x < 0.0 || x >= 1.0) { ok = false; }
        sum = sum + x;
        if (random::boolean()) { heads = heads + 1; }
        i = i + 1;
    }
    expect_true(ok, Str::new("float() stays in [0, 1)"))?;
    const mean: f64 = sum / 10000.0;
    expect_true(mean > 0.47 && mean < 0.53, Str::new("float() averages one half"))?;
    // 5000 expected, standard deviation 50.
    expect_true(heads > 4700 && heads < 5300, Str::new("boolean() is true about half the time"))?;
    return Result::Ok(());
}

![test]
function free_value_reaches_every_byte() -> Result<(), TestError> {
    mut seen: [boolean; 256];
    mut i: i32 = 0;
    while (i < 256) { seen[i] = false; i = i + 1; }
    i = 0;
    while (i < 8000) {
        const byte: u8 = random::value::<u8>();
        seen[byte as i32] = true;
        i = i + 1;
    }
    mut all: boolean = true;
    i = 0;
    while (i < 256) { if (!seen[i]) { all = false; } i = i + 1; }
    expect_true(all, Str::new("value::<u8>() reaches all 256 values"))?;

    mut ok: boolean = true;
    i = 0;
    while (i < 1000) {
        const unit: f32 = random::value::<f32>();
        if (unit < (0.0 as f32) || unit >= (1.0 as f32)) { ok = false; }
        const scalar: u32 = random::value::<char>() as u32;
        if (scalar > 0x10FFFF || (scalar >= 0xD800 && scalar < 0xE000)) { ok = false; }
        i = i + 1;
    }
    expect_true(ok, Str::new("value::<f32>() is in [0, 1) and value::<char>() is a scalar value"))?;
    return Result::Ok(());
}

![test]
function free_shuffle_reaches_every_order() -> Result<(), TestError> {
    // An order of four elements is named by where 0, 1 and 2 land
    // (`16 * p0 + 4 * p1 + p2`); 2400 shuffles expect each of the 24
    // orders 100 times, standard deviation about 10.
    mut orders: [i32; 64];
    mut i: i32 = 0;
    while (i < 64) { orders[i] = 0; i = i + 1; }
    mut permutation: boolean = true;
    mut round: i32 = 0;
    while (round < 2400) {
        mut items: [i32; 4];
        i = 0;
        while (i < 4) { items[i] = i; i = i + 1; }
        random::shuffle(&items);
        mut position: [i32; 4];
        mut count: [i32; 4];
        i = 0;
        while (i < 4) { count[i] = 0; i = i + 1; }
        i = 0;
        while (i < 4) {
            const v: i32 = items[i];
            if (v < 0 || v >= 4) { permutation = false; } else { position[v] = i; count[v] = count[v] + 1; }
            i = i + 1;
        }
        i = 0;
        while (i < 4) { if (count[i] != 1) { permutation = false; } i = i + 1; }
        if (permutation) {
            const order: i32 = 16 * position[0] + 4 * position[1] + position[2];
            orders[order] = orders[order] + 1;
        }
        round = round + 1;
    }
    expect_true(permutation, Str::new("shuffle yields a permutation"))?;
    mut distinct: i32 = 0;
    mut even: boolean = true;
    i = 0;
    while (i < 64) {
        if (orders[i] > 0) {
            distinct = distinct + 1;
            if (orders[i] < 60 || orders[i] > 140) { even = false; }
        }
        i = i + 1;
    }
    expect_eq(distinct, 24)?;
    expect_true(even, Str::new("every order of shuffle comes up about equally"))?;
    return Result::Ok(());
}

![test]
function free_choose_reaches_every_element() -> Result<(), TestError> {
    mut items: Array<i32> = Array::new();
    items.push(10); items.push(20); items.push(30); items.push(40); items.push(50);
    mut counts: [i32; 5];
    mut i: i32 = 0;
    while (i < 5) { counts[i] = 0; i = i + 1; }
    mut member: boolean = true;
    i = 0;
    while (i < 5000) {
        match (random::choose(&items)) {
            Option::Some(chosen) => {
                const v: i32 = *chosen;
                if (v % 10 != 0 || v < 10 || v > 50) { member = false; } else { counts[v / 10 - 1] = counts[v / 10 - 1] + 1; }
            }
            Option::None => { member = false; }
        }
        i = i + 1;
    }
    expect_true(member, Str::new("choose returns an element of the array"))?;
    // 1000 expected per element, standard deviation about 28.
    mut even: boolean = true;
    i = 0;
    while (i < 5) { if (counts[i] < 850 || counts[i] > 1150) { even = false; } i = i + 1; }
    expect_true(even, Str::new("every element is chosen about equally"))?;

    const empty: Array<i32> = Array::new();
    expect_true(random::choose(&empty).is_none(), Str::new("choose of nothing is None"))?;
    return Result::Ok(());
}

![test]
function seeded_rng_repeats_the_free_functions_draws() -> Result<(), TestError> {
    mut a: Rng = Rng::from_seed(42);
    mut b: Rng = Rng::from_seed(42);
    mut same: boolean = true;
    mut i: i32 = 0;
    while (i < 100) {
        if (a.next_range(1, 7) != b.next_range(1, 7)) { same = false; }
        if (a.next_range(-1.0, 1.0) != b.next_range(-1.0, 1.0)) { same = false; }
        if (a.next::<boolean>() != b.next::<boolean>()) { same = false; }
        i = i + 1;
    }
    mut first: [i32; 8];
    mut second: [i32; 8];
    i = 0;
    while (i < 8) { first[i] = i; second[i] = i; i = i + 1; }
    a.shuffle(&first);
    b.shuffle(&second);
    i = 0;
    while (i < 8) { if (first[i] != second[i]) { same = false; } i = i + 1; }
    expect_true(same, Str::new("two generators from one seed draw the same values"))?;
    return Result::Ok(());
}

![test]
function each_thread_has_its_own_generator() -> Result<(), TestError> {
    const here: u64 = random::value::<u64>();
    const there: u64 = thread::spawn(() -> u64 { return random::value::<u64>(); }).join();
    expect_true(here != there, Str::new("two threads draw different values"))?;
    const next: u64 = random::value::<u64>();
    expect_true(next != here, Str::new("the thread's generator advances"))?;
    return Result::Ok(());
}
