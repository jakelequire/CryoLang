///! UdpSocket - loopback datagram round-trip over 127.0.0.1, driven by a real
///! `Executor` (worker pool + reactor).
///!
///! Both sockets bind to port 0 and read their kernel-assigned port
///! back with `local_address()`, so concurrent test runs never collide and
///! the test needs no hard-coded ports. A datagram is sent each way and
///! the payload plus the reported peer address are checked.
///!
///! Every send and receive is awaited, so these also cover what async bought:
///! the receive parks on the reactor until the datagram lands rather than
///! sleeping the calling thread inside `recvfrom`.

![config(testing)]
namespace CryoTests::Tests::Stdlib::NetUdp;

import std::core::result::{ Result };
import std::core::option::{ Option };
import std::core::slice;
import std::collections::str::{ Str };
import std::collections::array::{ Array };
import std::future;
import std::io::error::{ IoErrorKind };
import std::net::address::ip;
import std::net::address::socket_address::{ SocketAddress };
import std::net::socket::udp::{ UdpSocket };
import std::test::error::{ TestError };
import std::test::assert::{ bail, expect, expect_equal };
import std::future::executor::{ Executor };

// Every failure is a distinct negative number so a red test names its own step
// instead of just reporting "not 0".

/// "ping" as bytes. Built by hand because a send takes an owned `Array<u8>`,
/// and a `Str`'s bytes are borrowed from the literal.
function ping_bytes() -> Array<u8> {
    mut a: Array<u8> = Array::<u8>::new();
    a.push(112); a.push(105); a.push(110); a.push(103);
    return a;
}

/// "pong" as bytes.
function pong_bytes() -> Array<u8> {
    mut a: Array<u8> = Array::<u8>::new();
    a.push(112); a.push(111); a.push(110); a.push(103);
    return a;
}

/// The first byte of `a`, or 0 if it is empty.
function first_byte(a: &Array<u8>) -> u8 {
    match (a.get(0)) {
        Option::Some(v) => { return v; }
        Option::None    => { return 0; }
    }
}

/// client -> server "ping", server -> the peer it saw "pong". Returns 0 on a
/// clean round trip.
async function ping_pong(server: UdpSocket, client: UdpSocket, server_addr: SocketAddress) -> i64 {
    mut srv: UdpSocket = server;
    mut cl: UdpSocket = client;

    match (await cl.send_to(ping_bytes(), server_addr)) {
        Result::Ok(k)  => { if (k != 4) { return -1; } }
        Result::Err(_) => { return -2; }
    }

    // A receive hands back only the datagram that arrived, so its length is
    // the byte count - "ping" comes back at 4 though 64 were allowed.
    const received: (Array<u8>, SocketAddress) = match (await srv.receive_from(64)) {
        Result::Ok(pair) => { pair }
        Result::Err(_)   => { return -3; }
    };
    const peer: SocketAddress = received.1;
    const n: u64   = received.0.length() as u64;
    const f: u8    = first_byte(&received.0);
    if (n != 4)        { return -4; }
    if (f != 112)      { return -5; }
    if (!peer.ip.is_ipv4()) { return -6; }

    // Reply to the peer the datagram came from.
    match (await srv.send_to(pong_bytes(), peer)) {
        Result::Ok(k)  => { if (k != 4) { return -7; } }
        Result::Err(_) => { return -8; }
    }

    const back: (Array<u8>, SocketAddress) = match (await cl.receive_from(64)) {
        Result::Ok(pair) => { pair }
        Result::Err(_)   => { return -9; }
    };
    const bn: u64 = back.0.length() as u64;
    const bf: u8  = first_byte(&back.0);
    if (bn != 4)  { return -10; }
    if (bf != 112) { return -11; }
    return 0;
}

![test]
function loopback_datagram_round_trip() -> Result<(), TestError> {
    mut server: UdpSocket = match (UdpSocket::bind(SocketAddress::localhost_v4(0))) {
        Result::Ok(s)  => { s }
        Result::Err(_) => { return bail(Str::new("server bind failed")); }
    };
    mut client: UdpSocket = match (UdpSocket::bind(SocketAddress::localhost_v4(0))) {
        Result::Ok(s)  => { s }
        Result::Err(_) => { return bail(Str::new("client bind failed")); }
    };
    const server_addr: SocketAddress = match (server.local_address()) {
        Result::Ok(a)  => { a }
        Result::Err(_) => { 
                            return bail(Str::new("server local_address failed")); }
    };

    mut ex: Executor = Executor::new();
    const r: i64 = ex.block_on(ping_pong(server, client, server_addr));
    return expect_equal(r, 0 as i64);
}

/// `connect` pins a default peer so the address-less `send` works.
async function connected_exchange(server: UdpSocket, client: UdpSocket) -> i64 {
    mut hello: Array<u8> = Array::<u8>::new();
    hello.push(104); hello.push(101); hello.push(108); hello.push(108); hello.push(111);

    mut cl: UdpSocket = client;
    mut srv: UdpSocket = server;
    match (await cl.send(hello)) {
        Result::Ok(k)  => { if (k != 5) { return -20; } }
        Result::Err(_) => { return -21; }
    }

    const got: (Array<u8>, SocketAddress) = match (await srv.receive_from(64)) {
        Result::Ok(pair) => { pair }
        Result::Err(_)   => { return -22; }
    };
    const n: u64 = got.0.length() as u64;
    const f: u8  = first_byte(&got.0);
    if (n != 5)   { return -23; }
    if (f != 104) { return -24; }
    return 0;
}

![test]
function connected_socket_send_recv() -> Result<(), TestError> {
    mut server: UdpSocket = match (UdpSocket::bind(SocketAddress::localhost_v4(0))) {
        Result::Ok(s)  => { s }
        Result::Err(_) => { return bail(Str::new("server bind failed")); }
    };
    const server_addr: SocketAddress = match (server.local_address()) {
        Result::Ok(a)  => { a }
        Result::Err(_) => { return bail(Str::new("server local_address failed")); }
    };
    mut client: UdpSocket = match (UdpSocket::unbound()) {
        Result::Ok(s)  => { s }
        Result::Err(_) => { return bail(Str::new("client unbound failed")); }
    };
    match (client.connect(server_addr)) {
        Result::Ok(_)  => { }
        Result::Err(_) => { 
                            return bail(Str::new("client connect failed")); }
    }

    mut ex: Executor = Executor::new();
    const r: i64 = ex.block_on(connected_exchange(server, client));
    return expect_equal(r, 0 as i64);
}

/// A `send_to` aimed at an IPv6 destination must report `Unsupported` rather
/// than pack a 28-byte `sockaddr_in6` into the v4-sized buffer behind it.
async function v6_send_rejected(client: UdpSocket) -> i64 {
    mut one: Array<u8> = Array::<u8>::new();
    one.push(120);
    mut cl: UdpSocket = client;
    match (await cl.send_to(one, SocketAddress::any_v6(9))) {
        Result::Ok(_)  => { return -30; }
        Result::Err(e) => {
            if (e.kind == IoErrorKind::Unsupported) { return 0; }
            return -31;
        }
    }
}

// Guards against the UDP entry points taking a
// 16-byte `sockaddr_buf` while `pack_sockaddr_in` writes 28 bytes for an
// IPv6 address - a 12-byte stack overflow - despite a doc comment claiming
// IPv6 was rejected. The socket is AF_INET, so `bind`/`connect`/`send_to`
// reject an `IpAddress::V6` destination up front with `Unsupported`
// (and the buffers are 28 bytes as defense in depth). This must NOT crash
// and must surface the documented error.
![test]
function ipv6_rejected_unsupported() -> Result<(), TestError> {
    match (UdpSocket::bind(SocketAddress::localhost_v6(0))) {
        Result::Ok(_)  => { return bail(Str::new("v6 bind should be rejected")); }
        Result::Err(e) => {
            match (expect(e.kind == IoErrorKind::Unsupported,
                          Str::new("v6 bind should fail Unsupported"))) {
                Result::Ok(_)  => { }
                Result::Err(t) => { return Result::Err(t); }
            }
        }
    }

    mut client: UdpSocket = match (UdpSocket::unbound()) {
        Result::Ok(s)  => { s }
        Result::Err(_) => { return bail(Str::new("unbound failed")); }
    };
    match (client.connect(SocketAddress::localhost_v6(9))) {
        Result::Ok(_)  => { return bail(Str::new("v6 connect should be rejected")); }
        Result::Err(e) => {
            match (expect(e.kind == IoErrorKind::Unsupported,
                          Str::new("v6 connect should fail Unsupported"))) {
                Result::Ok(_)  => { }
                Result::Err(t) => { return Result::Err(t); }
            }
        }
    }

    mut ex: Executor = Executor::new();
    const r: i64 = ex.block_on(v6_send_rejected(client));
    return expect_equal(r, 0 as i64);
}
