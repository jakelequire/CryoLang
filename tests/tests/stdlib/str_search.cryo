///! Str/String search + slice methods: starts_with, ends_with, find,
///! contains, trim family, to_ascii_uppercase, split iteration,
///! strip_prefix/strip_suffix, common_prefix_length and replace.

![config(testing)]
namespace CryoTests::Tests::Stdlib::StrSearch;

import std::core::result::{ Result };
import std::core::option::{ Option };
import std::core::iter::{ Iterator };
import std::collections::str::{ Str };
import std::collections::string::{ String };
import std::test::error::{ TestError };
import std::test::assert::{ bail, expect_equal, expect_true };

![test]
function starts_ends_with_work() -> Result<(), TestError> {
    const s: Str = Str::new("hello world");
    expect_true(s.starts_with("hello"), Str::new("starts_with prefix"))?;
    expect_true(!s.starts_with("world"), Str::new("starts_with neg"))?;
    expect_true(s.ends_with("world"), Str::new("ends_with suffix"))?;
    expect_true(!s.ends_with("hello"), Str::new("ends_with neg"))?;
    expect_true(s.starts_with(""), Str::new("starts_with empty"))?;
    expect_true(s.ends_with(""), Str::new("ends_with empty"))?;
    return Result::Ok(());
}

![test]
function find_and_contains_work() -> Result<(), TestError> {
    const s: Str = Str::new("abcabc");
    match (s.find("bc")) {
        Option::Some(i) => { expect_equal(i, 1)?; }
        Option::None    => { return bail(Str::new("find should locate bc")); }
    }
    match (s.find("zz")) {
        Option::Some(_) => { return bail(Str::new("find should miss zz")); }
        Option::None    => { }
    }
    expect_true(s.contains("cab"), Str::new("contains cab"))?;
    expect_true(!s.contains("xyz"), Str::new("contains neg"))?;
    return Result::Ok(());
}

![test]
function trim_family_works() -> Result<(), TestError> {
    const s: Str = Str::new("  \t hi \n ");
    expect_true(s.trim().equals(&Str::new("hi")), Str::new("trim both"))?;
    expect_true(s.trim_start().equals(&Str::new("hi \n ")), Str::new("trim_start"))?;
    expect_true(s.trim_end().equals(&Str::new("  \t hi")), Str::new("trim_end"))?;
    const none: Str = Str::new("nopad");
    expect_true(none.trim().equals(&Str::new("nopad")), Str::new("trim no-op"))?;
    return Result::Ok(());
}

![test]
function to_ascii_uppercase_works() -> Result<(), TestError> {
    const s: Str = Str::new("aBc1z");
    mut up: String = s.to_ascii_uppercase();
    expect_true(up.as_str().equals(&Str::new("ABC1Z")), Str::new("uppercase"))?;
    return Result::Ok(());
}

![test]
function split_yields_pieces() -> Result<(), TestError> {
    const s: Str = Str::new("a,bb,,c");
    mut it: implement Iterator<Str> =s.split(",");
    mut count: u64 = 0;
    mut joined: String = String::new();
    loop {
        match (it.next()) {
            Option::Some(piece) => {
                joined.append(piece);
                joined.push_byte(0x7C as u8); // '|'
                count = count + 1;
            }
            Option::None => { break; }
        }
    }
    // "a" "bb" "" "c" -> 4 pieces; joined "a|bb||c|"
    expect_equal(count, 4)?;
    const ok: boolean = joined.as_str().equals(&Str::new("a|bb||c|"));
    expect_true(ok, Str::new("split pieces"))?;
    return Result::Ok(());
}

![test]
function split_no_separator_yields_whole() -> Result<(), TestError> {
    const s: Str = Str::new("whole");
    mut it: implement Iterator<Str> =s.split(",");
    match (it.next()) {
        Option::Some(piece) => {
            expect_true(piece.equals(&Str::new("whole")), Str::new("whole piece"))?;
        }
        Option::None => { return bail(Str::new("expected one piece")); }
    }
    match (it.next()) {
        Option::Some(_) => { return bail(Str::new("expected exhaustion")); }
        Option::None    => { }
    }
    return Result::Ok(());
}

![test]
function find_last_finds_the_last_occurrence() -> Result<(), TestError> {
    const s: Str = Str::new("abcabc");
    expect_equal(s.find_last("bc").unwrap_or(-1), 4)?;
    expect_equal(s.find_last("abc").unwrap_or(-1), 3)?;
    expect_equal(s.find_last("abcabc").unwrap_or(-1), 0)?;
    expect_equal(s.find_last("").unwrap_or(-1), 6)?;
    expect_true(s.find_last("cab!").is_none(), Str::new("find_last absent"))?;
    expect_true(s.find_last("abcabca").is_none(), Str::new("find_last longer needle"))?;
    return Result::Ok(());
}

![test]
function find_byte_and_find_last_byte() -> Result<(), TestError> {
    const s: Str = Str::new("a/b/c");
    const slash: u8 = 0x2F;
    const q: u8 = 0x3F;
    expect_equal(s.find_byte(slash).unwrap_or(-1), 1)?;
    expect_equal(s.find_last_byte(slash).unwrap_or(-1), 3)?;
    expect_true(s.find_byte(q).is_none(), Str::new("find_byte absent"))?;
    expect_true(s.find_last_byte(q).is_none(), Str::new("find_last_byte absent"))?;
    expect_true(Str::new("").find_byte(slash).is_none(), Str::new("find_byte empty"))?;
    expect_true(Str::new("").find_last_byte(slash).is_none(), Str::new("find_last_byte empty"))?;
    return Result::Ok(());
}

![test]
function split_once_and_split_once_from_end() -> Result<(), TestError> {
    const s: Str = Str::new("a::b::c");
    const sep: Str = Str::new("::");
    match (s.split_once(sep)) {
        Option::Some(parts) => {
            expect_equal(parts.first, Str::new("a"))?;
            expect_equal(parts.second, Str::new("b::c"))?;
        }
        Option::None => { return bail(Str::new("split_once found nothing")); }
    }
    match (s.split_once_from_end(sep)) {
        Option::Some(parts) => {
            expect_equal(parts.first, Str::new("a::b"))?;
            expect_equal(parts.second, Str::new("c"))?;
        }
        Option::None => { return bail(Str::new("split_once_from_end found nothing")); }
    }
    match (Str::new("k=").split_once("=")) {
        Option::Some(parts) => {
            expect_equal(parts.first, Str::new("k"))?;
            expect_equal(parts.second, Str::new(""))?;
        }
        Option::None => { return bail(Str::new("split_once at the end")); }
    }
    expect_true(s.split_once(",").is_none(), Str::new("split_once absent"))?;
    expect_true(s.split_once_from_end(",").is_none(), Str::new("split_once_from_end absent"))?;
    return Result::Ok(());
}

![test]
function equals_case_insensitive_folds_ascii_only() -> Result<(), TestError> {
    const s: Str = Str::new("Keep-Alive");
    expect_true(s.equals_case_insensitive("keep-alive"), Str::new("lower"))?;
    expect_true(s.equals_case_insensitive("KEEP-ALIVE"), Str::new("upper"))?;
    expect_true(!s.equals_case_insensitive("keep_alive"), Str::new("other byte"))?;
    expect_true(!s.equals_case_insensitive("keep-aliv"), Str::new("shorter"))?;
    // "@" (0x40) and "`" (0x60) differ by the case bit but are not letters.
    expect_true(!Str::new("@").equals_case_insensitive("`"), Str::new("non-letters"))?;
    return Result::Ok(());
}

![test]
function strip_prefix_and_strip_suffix() -> Result<(), TestError> {
    const s: Str = Str::new("lib/core.cryo");
    expect_equal(s.strip_prefix("lib/"), Option::Some(Str::new("core.cryo")))?;
    expect_equal(s.strip_suffix(".cryo"), Option::Some(Str::new("lib/core")))?;
    expect_true(s.strip_prefix("core").is_none(), Str::new("prefix absent"))?;
    expect_true(s.strip_suffix("core").is_none(), Str::new("suffix absent"))?;
    expect_true(s.strip_prefix("lib/core.cryo!").is_none(), Str::new("prefix longer"))?;
    expect_equal(s.strip_prefix(""), Option::Some(s))?;
    expect_equal(s.strip_suffix(""), Option::Some(s))?;
    expect_equal(s.strip_suffix(s), Option::Some(Str::new("")))?;
    const owned: String = String::from("v1.0");
    expect_equal(owned.strip_prefix("v"), Option::Some(Str::new("1.0")))?;
    expect_equal(owned.strip_suffix(".0"), Option::Some(Str::new("v1")))?;
    return Result::Ok(());
}

![test]
function common_prefix_length_counts_shared_bytes() -> Result<(), TestError> {
    const s: Str = Str::new("std::collections");
    expect_equal(s.common_prefix_length("std::core"), 7)?;
    expect_equal(s.common_prefix_length("std"), 3)?;
    expect_equal(s.common_prefix_length("core"), 0)?;
    expect_equal(s.common_prefix_length(""), 0)?;
    expect_equal(s.common_prefix_length(s), 16)?;
    expect_equal(String::from("abc").common_prefix_length("abd"), 2)?;
    return Result::Ok(());
}

![test]
function replace_substitutes_every_occurrence() -> Result<(), TestError> {
    const s: Str = Str::new("a-b--c-");
    expect_equal(s.replace("-", "+"), String::from("a+b++c+"))?;
    expect_equal(s.replace("--", ""), String::from("a-bc-"))?;
    expect_equal(s.replace("-", "::"), String::from("a::b::::c::"))?;
    expect_equal(s.replace("x", "y"), String::from("a-b--c-"))?;
    expect_equal(s.replace("", "y"), String::from("a-b--c-"))?;
    // Scanning resumes after each replaced match, so matches never overlap.
    expect_equal(Str::new("aaa").replace("aa", "b"), String::from("ba"))?;
    expect_equal(Str::new("").replace("a", "b"), String::from(""))?;
    expect_equal(String::from("x.y").replace(".", "/"), String::from("x/y"))?;
    return Result::Ok(());
}

![test]
function split_nonempty_drops_empty_pieces() -> Result<(), TestError> {
    mut joined: String = String::new();
    mut it: implement Iterator<Str> =Str::new("::a::::bb::c::").split_nonempty("::");
    loop {
        match (it.next()) {
            Option::Some(piece) => {
                joined.append(piece);
                joined.push_byte(0x7C as u8); // '|'
            }
            Option::None => { break; }
        }
    }
    expect_equal(joined, String::from("a|bb|c|"))?;
    mut empty: implement Iterator<Str> =Str::new("").split_nonempty(",");
    expect_true(empty.next().is_none(), Str::new("empty input"))?;
    mut separators: implement Iterator<Str> =Str::new(",,").split_nonempty(",");
    expect_true(separators.next().is_none(), Str::new("separators only"))?;
    mut whole: implement Iterator<Str> =Str::new("whole").split_nonempty("");
    expect_equal(whole.next(), Option::Some(Str::new("whole")))?;
    expect_true(whole.next().is_none(), Str::new("empty separator yields once"))?;
    const owned: String = String::from("/usr//lib/");
    mut segments: implement Iterator<Str> =owned.split_nonempty("/");
    expect_equal(segments.count(), 2)?;
    return Result::Ok(());
}

/// Every text method takes the text it looks for as a `Str` by value, so a
/// literal is converted where it is passed, on a `String` receiver too, and
/// a `String` argument is passed as its view.
![test]
function text_parameters_take_a_literal_and_a_view() -> Result<(), TestError> {
    const owned: String = String::from("key=value=end");
    const separator: String = String::from("=");
    expect_true(owned.starts_with("key"), Str::new("starts_with"))?;
    expect_true(owned.ends_with("end"), Str::new("ends_with"))?;
    const first: i64 = 3;
    const last: i64 = 9;
    expect_equal(owned.find("="), Option::Some(first))?;
    expect_equal(owned.find_last(separator.as_str()), Option::Some(last))?;
    expect_true(owned.contains("value"), Str::new("contains"))?;
    expect_true(owned.equals_case_insensitive("KEY=VALUE=END"), Str::new("equals_case_insensitive"))?;
    expect_equal(owned.common_prefix_length("keys"), 3)?;
    expect_equal(owned.strip_prefix("key="), Option::Some(Str::new("value=end")))?;
    expect_equal(owned.strip_suffix("=end"), Option::Some(Str::new("key=value")))?;
    expect_equal(owned.replace("=", ", "), String::from("key, value, end"))?;
    expect_equal(owned.split("=").count(), 3)?;
    expect_equal(owned.split_nonempty(separator.as_str()).count(), 3)?;
    match (owned.split_once("=")) {
        Option::Some(halves) => { expect_equal(halves.second, Str::new("value=end"))?; }
        Option::None => { return bail(Str::new("split_once should find =")); }
    }
    match (owned.split_once_from_end("=")) {
        Option::Some(halves) => { expect_equal(halves.first, Str::new("key=value"))?; }
        Option::None => { return bail(Str::new("split_once_from_end should find =")); }
    }
    return Result::Ok(());
}
