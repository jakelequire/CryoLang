///! Str/String search + slice methods: starts_with, ends_with, find,
///! contains, trim family, to_ascii_uppercase, split iteration,
///! strip_prefix/strip_suffix, common_prefix_length and replace.

![config(testing)]
namespace CryoTests::Tests::Stdlib::StrSearch;

import std::core::result::{ Result };
import std::core::option::{ Option };
import std::core::iter;
import std::collections::str::{ SplitIter, Str };
import std::collections::string::{ String };
import std::test::error::{ TestError };
import std::test::assert::{ bail, expect_eq, expect_true };

![test]
function starts_ends_with_work() -> Result<(), TestError> {
    const s: Str = Str::new("hello world");
    expect_true(s.starts_with(&Str::new("hello")), Str::new("starts_with prefix"))?;
    expect_true(!s.starts_with(&Str::new("world")), Str::new("starts_with neg"))?;
    expect_true(s.ends_with(&Str::new("world")), Str::new("ends_with suffix"))?;
    expect_true(!s.ends_with(&Str::new("hello")), Str::new("ends_with neg"))?;
    expect_true(s.starts_with(&Str::new("")), Str::new("starts_with empty"))?;
    expect_true(s.ends_with(&Str::new("")), Str::new("ends_with empty"))?;
    return Result::Ok(());
}

![test]
function find_and_contains_work() -> Result<(), TestError> {
    const s: Str = Str::new("abcabc");
    match (s.find(&Str::new("bc"))) {
        Option::Some(i) => { expect_eq(i, 1)?; }
        Option::None    => { return bail(Str::new("find should locate bc")); }
    }
    match (s.find(&Str::new("zz"))) {
        Option::Some(_) => { return bail(Str::new("find should miss zz")); }
        Option::None    => { }
    }
    expect_true(s.contains(&Str::new("cab")), Str::new("contains cab"))?;
    expect_true(!s.contains(&Str::new("xyz")), Str::new("contains neg"))?;
    return Result::Ok(());
}

![test]
function trim_family_works() -> Result<(), TestError> {
    const s: Str = Str::new("  \t hi \n ");
    expect_true(s.trim().equals(&Str::new("hi")), Str::new("trim both"))?;
    expect_true(s.trim_start().equals(&Str::new("hi \n ")), Str::new("trim_start"))?;
    expect_true(s.trim_end().equals(&Str::new("  \t hi")), Str::new("trim_end"))?;
    const none: Str = Str::new("nopad");
    expect_true(none.trim().equals(&Str::new("nopad")), Str::new("trim no-op"))?;
    return Result::Ok(());
}

![test]
function to_ascii_uppercase_works() -> Result<(), TestError> {
    const s: Str = Str::new("aBc1z");
    mut up: String = s.to_ascii_uppercase();
    expect_true(up.as_str().equals(&Str::new("ABC1Z")), Str::new("uppercase"))?;
    return Result::Ok(());
}

![test]
function split_yields_pieces() -> Result<(), TestError> {
    const s: Str = Str::new("a,bb,,c");
    mut it: SplitIter = s.split(&Str::new(","));
    mut count: u64 = 0;
    mut joined: String = String::new();
    loop {
        match (it.next()) {
            Option::Some(piece) => {
                joined.push(piece);
                joined.push_byte(0x7C as u8); // '|'
                count = count + 1;
            }
            Option::None => { break; }
        }
    }
    // "a" "bb" "" "c" -> 4 pieces; joined "a|bb||c|"
    expect_eq(count, 4)?;
    const ok: boolean = joined.as_str().equals(&Str::new("a|bb||c|"));
    expect_true(ok, Str::new("split pieces"))?;
    return Result::Ok(());
}

![test]
function split_no_separator_yields_whole() -> Result<(), TestError> {
    const s: Str = Str::new("whole");
    mut it: SplitIter = s.split(&Str::new(","));
    match (it.next()) {
        Option::Some(piece) => {
            expect_true(piece.equals(&Str::new("whole")), Str::new("whole piece"))?;
        }
        Option::None => { return bail(Str::new("expected one piece")); }
    }
    match (it.next()) {
        Option::Some(_) => { return bail(Str::new("expected exhaustion")); }
        Option::None    => { }
    }
    return Result::Ok(());
}

![test]
function rfind_finds_the_last_occurrence() -> Result<(), TestError> {
    const s: Str = Str::new("abcabc");
    expect_eq(s.rfind(&Str::new("bc")).unwrap_or(-1), 4)?;
    expect_eq(s.rfind(&Str::new("abc")).unwrap_or(-1), 3)?;
    expect_eq(s.rfind(&Str::new("abcabc")).unwrap_or(-1), 0)?;
    expect_eq(s.rfind(&Str::new("")).unwrap_or(-1), 6)?;
    expect_true(s.rfind(&Str::new("cab!")).is_none(), Str::new("rfind absent"))?;
    expect_true(s.rfind(&Str::new("abcabca")).is_none(), Str::new("rfind longer needle"))?;
    return Result::Ok(());
}

![test]
function find_byte_and_rfind_byte() -> Result<(), TestError> {
    const s: Str = Str::new("a/b/c");
    const slash: u8 = 0x2F;
    const q: u8 = 0x3F;
    expect_eq(s.find_byte(slash).unwrap_or(-1), 1)?;
    expect_eq(s.rfind_byte(slash).unwrap_or(-1), 3)?;
    expect_true(s.find_byte(q).is_none(), Str::new("find_byte absent"))?;
    expect_true(s.rfind_byte(q).is_none(), Str::new("rfind_byte absent"))?;
    expect_true(Str::new("").find_byte(slash).is_none(), Str::new("find_byte empty"))?;
    expect_true(Str::new("").rfind_byte(slash).is_none(), Str::new("rfind_byte empty"))?;
    return Result::Ok(());
}

![test]
function split_once_and_rsplit_once() -> Result<(), TestError> {
    const s: Str = Str::new("a::b::c");
    const sep: Str = Str::new("::");
    match (s.split_once(&sep)) {
        Option::Some(parts) => {
            expect_eq(parts.first, Str::new("a"))?;
            expect_eq(parts.second, Str::new("b::c"))?;
        }
        Option::None => { return bail(Str::new("split_once found nothing")); }
    }
    match (s.rsplit_once(&sep)) {
        Option::Some(parts) => {
            expect_eq(parts.first, Str::new("a::b"))?;
            expect_eq(parts.second, Str::new("c"))?;
        }
        Option::None => { return bail(Str::new("rsplit_once found nothing")); }
    }
    match (Str::new("k=").split_once(&Str::new("="))) {
        Option::Some(parts) => {
            expect_eq(parts.first, Str::new("k"))?;
            expect_eq(parts.second, Str::new(""))?;
        }
        Option::None => { return bail(Str::new("split_once at the end")); }
    }
    expect_true(s.split_once(&Str::new(",")).is_none(), Str::new("split_once absent"))?;
    expect_true(s.rsplit_once(&Str::new(",")).is_none(), Str::new("rsplit_once absent"))?;
    return Result::Ok(());
}

![test]
function equals_case_insensitive_folds_ascii_only() -> Result<(), TestError> {
    const s: Str = Str::new("Keep-Alive");
    expect_true(s.equals_case_insensitive(&Str::new("keep-alive")), Str::new("lower"))?;
    expect_true(s.equals_case_insensitive(&Str::new("KEEP-ALIVE")), Str::new("upper"))?;
    expect_true(!s.equals_case_insensitive(&Str::new("keep_alive")), Str::new("other byte"))?;
    expect_true(!s.equals_case_insensitive(&Str::new("keep-aliv")), Str::new("shorter"))?;
    // "@" (0x40) and "`" (0x60) differ by the case bit but are not letters.
    expect_true(!Str::new("@").equals_case_insensitive(&Str::new("`")), Str::new("non-letters"))?;
    return Result::Ok(());
}

![test]
function strip_prefix_and_strip_suffix() -> Result<(), TestError> {
    const s: Str = Str::new("lib/core.cryo");
    expect_eq(s.strip_prefix(&Str::new("lib/")), Option::Some(Str::new("core.cryo")))?;
    expect_eq(s.strip_suffix(&Str::new(".cryo")), Option::Some(Str::new("lib/core")))?;
    expect_true(s.strip_prefix(&Str::new("core")).is_none(), Str::new("prefix absent"))?;
    expect_true(s.strip_suffix(&Str::new("core")).is_none(), Str::new("suffix absent"))?;
    expect_true(s.strip_prefix(&Str::new("lib/core.cryo!")).is_none(), Str::new("prefix longer"))?;
    expect_eq(s.strip_prefix(&Str::new("")), Option::Some(s))?;
    expect_eq(s.strip_suffix(&Str::new("")), Option::Some(s))?;
    expect_eq(s.strip_suffix(&s), Option::Some(Str::new("")))?;
    const owned: String = String::from("v1.0");
    expect_eq(owned.strip_prefix(&Str::new("v")), Option::Some(Str::new("1.0")))?;
    expect_eq(owned.strip_suffix(&Str::new(".0")), Option::Some(Str::new("v1")))?;
    return Result::Ok(());
}

![test]
function common_prefix_length_counts_shared_bytes() -> Result<(), TestError> {
    const s: Str = Str::new("std::collections");
    expect_eq(s.common_prefix_length(&Str::new("std::core")), 7)?;
    expect_eq(s.common_prefix_length(&Str::new("std")), 3)?;
    expect_eq(s.common_prefix_length(&Str::new("core")), 0)?;
    expect_eq(s.common_prefix_length(&Str::new("")), 0)?;
    expect_eq(s.common_prefix_length(&s), 16)?;
    expect_eq(String::from("abc").common_prefix_length(&Str::new("abd")), 2)?;
    return Result::Ok(());
}

![test]
function replace_substitutes_every_occurrence() -> Result<(), TestError> {
    const s: Str = Str::new("a-b--c-");
    expect_eq(s.replace(&Str::new("-"), &Str::new("+")), String::from("a+b++c+"))?;
    expect_eq(s.replace(&Str::new("--"), &Str::new("")), String::from("a-bc-"))?;
    expect_eq(s.replace(&Str::new("-"), &Str::new("::")), String::from("a::b::::c::"))?;
    expect_eq(s.replace(&Str::new("x"), &Str::new("y")), String::from("a-b--c-"))?;
    expect_eq(s.replace(&Str::new(""), &Str::new("y")), String::from("a-b--c-"))?;
    // Scanning resumes after each replaced match, so matches never overlap.
    expect_eq(Str::new("aaa").replace(&Str::new("aa"), &Str::new("b")), String::from("ba"))?;
    expect_eq(Str::new("").replace(&Str::new("a"), &Str::new("b")), String::from(""))?;
    expect_eq(String::from("x.y").replace(&Str::new("."), &Str::new("/")), String::from("x/y"))?;
    return Result::Ok(());
}

![test]
function split_nonempty_drops_empty_pieces() -> Result<(), TestError> {
    mut joined: String = String::new();
    mut it: SplitIter = Str::new("::a::::bb::c::").split_nonempty(&Str::new("::"));
    loop {
        match (it.next()) {
            Option::Some(piece) => {
                joined.push(piece);
                joined.push_byte(0x7C as u8); // '|'
            }
            Option::None => { break; }
        }
    }
    expect_eq(joined, String::from("a|bb|c|"))?;
    mut empty: SplitIter = Str::new("").split_nonempty(&Str::new(","));
    expect_true(empty.next().is_none(), Str::new("empty input"))?;
    mut separators: SplitIter = Str::new(",,").split_nonempty(&Str::new(","));
    expect_true(separators.next().is_none(), Str::new("separators only"))?;
    mut whole: SplitIter = Str::new("whole").split_nonempty(&Str::new(""));
    expect_eq(whole.next(), Option::Some(Str::new("whole")))?;
    expect_true(whole.next().is_none(), Str::new("empty separator yields once"))?;
    const owned: String = String::from("/usr//lib/");
    mut segments: SplitIter = owned.split_nonempty(&Str::new("/"));
    expect_eq(segments.count(), 2)?;
    return Result::Ok(());
}
