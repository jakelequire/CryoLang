///! Tuples - `(T, U, V)` type syntax, `(v0, v1, v2)` literal syntax, and both
///! `t[N]` and `t.N` positional access. Parentheses carry tuples: `()` is the
///! unit type, `(T)` is grouping, `(T,)` is a 1-tuple (trailing comma), and
///! `(T, U)` is a 2-tuple. Tuple indices must be integer literals - bounds and
///! shape are checked at compile time.

![config(testing)]
namespace CryoTests::Tests::Stdlib::TupleT;

import std::core::result;
import std::test::error;
import std::test::assert;
import std::collections::str;

![test]
function homogeneous_tuple_reads_back_each_slot() -> Result<(), TestError> {
    const t: (i32, i32, i32) = (10, 20, 30);
    expect_eq(t[0], 10)?;
    expect_eq(t[1], 20)?;
    expect_eq(t[2], 30)?;
    return Result::Ok(());
}

![test]
function heterogeneous_tuple_preserves_each_type() -> Result<(), TestError> {
    const t: (i32, string, boolean) = (42, "hello", true);
    expect_eq(t[0], 42)?;
    expect(t[1] == "hello", Str::new("tuple string slot mismatch"))?;
    expect(t[2], Str::new("tuple bool slot should be true"))?;
    return Result::Ok(());
}

![test]
function dot_access_matches_bracket_access() -> Result<(), TestError> {
    // `.N` is equivalent to `[N]` for tuple element access.
    const t: (i32, string, i32) = (5, "x", 9);
    expect_eq(t.0, 5)?;
    expect(t.1 == "x", Str::new("t.1 mismatch"))?;
    expect_eq(t.2, 9)?;
    return Result::Ok(());
}

![test]
function tuple_passes_through_function_round_trip() -> Result<(), TestError> {
    const t: (i32, i32) = make_pair(7, 11);
    const sum: i32 = t[0] + t[1];
    expect_eq(sum, 18)?;
    return Result::Ok(());
}

function make_pair(a: i32, b: i32) -> (i32, i32) {
    return (a, b);
}

![test]
function nested_tuple_indexes_compose() -> Result<(), TestError> {
    const inner: (i32, i32) = (3, 4);
    const outer: (i32, (i32, i32)) = (1, inner);
    expect_eq(outer[0], 1)?;
    expect_eq(outer[1][0], 3)?;
    expect_eq(outer[1][1], 4)?;
    // Same via dot access, including the chained `t.1.0` form.
    expect_eq(outer.0, 1)?;
    expect_eq(outer.1.0, 3)?;
    expect_eq(outer.1.1, 4)?;
    return Result::Ok(());
}

![test]
function tuple_passed_by_reference_reads_correctly() -> Result<(), TestError> {
    const t: (i32, i32, i32) = (100, 200, 300);
    const got: i32 = sum_triple(&t);
    expect_eq(got, 600)?;
    return Result::Ok(());
}

function sum_triple(t: &(i32, i32, i32)) -> i32 {
    return t[0] + t[1] + t[2];
}

![test]
function one_tuple_uses_trailing_comma() -> Result<(), TestError> {
    // `(T,)` is a 1-tuple; `(T)` would just be grouping (the bare value).
    const single: (i32,) = (99,);
    expect_eq(single[0], 99)?;
    expect_eq(single.0, 99)?;
    return Result::Ok(());
}

![test]
function paren_without_comma_is_grouping_not_tuple() -> Result<(), TestError> {
    // `(i32)` is just `i32`, and `(x)` is just `x` - parentheses group, they
    // don't make a 1-tuple without a trailing comma.
    const grouped: (i32) = (5 + 2);
    expect_eq(grouped, 7)?;
    return Result::Ok(());
}
