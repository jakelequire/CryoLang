///! Tuples — `[T, U, V]` type syntax, `(v0, v1, v2)` literal syntax, and
///! `t[N]` positional access. The bracket type form distinguishes tuples
///! from arrays (`T[]` / `T[N]`) and from the unit type `()`. Tuple indices
///! must be integer literals — bounds and shape are checked at compile time.

![config(testing)]
namespace CryoTests::Tests::Stdlib::TupleT;

import std::core::result;
import std::test::error;
import std::test::assert;

![test]
function homogeneous_tuple_reads_back_each_slot() -> Result<(), TestError> {
    const t: [i32, i32, i32] = (10, 20, 30);
    match (expect_eq(t[0], 10)) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    match (expect_eq(t[1], 20)) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    match (expect_eq(t[2], 30)) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

![test]
function heterogeneous_tuple_preserves_each_type() -> Result<(), TestError> {
    const t: [i32, string, boolean] = (42, "hello", true);
    match (expect_eq(t[0], 42)) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    match (expect(t[1] == "hello", Str::from_raw("tuple string slot mismatch", 28))) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    match (expect(t[2], Str::from_raw("tuple bool slot should be true", 30))) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

![test]
function tuple_passes_through_function_round_trip() -> Result<(), TestError> {
    const t: [i32, i32] = make_pair(7, 11);
    const sum: i32 = t[0] + t[1];
    match (expect_eq(sum, 18)) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

function make_pair(a: i32, b: i32) -> [i32, i32] {
    return (a, b);
}

![test]
function nested_tuple_indexes_compose() -> Result<(), TestError> {
    const inner: [i32, i32] = (3, 4);
    const outer: [i32, [i32, i32]] = (1, inner);
    match (expect_eq(outer[0], 1)) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    match (expect_eq(outer[1][0], 3)) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    match (expect_eq(outer[1][1], 4)) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

![test]
function tuple_passed_by_reference_reads_correctly() -> Result<(), TestError> {
    const t: [i32, i32, i32] = (100, 200, 300);
    const got: i32 = sum_triple(&t);
    match (expect_eq(got, 600)) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

function sum_triple(t: &[i32, i32, i32]) -> i32 {
    return t[0] + t[1] + t[2];
}
