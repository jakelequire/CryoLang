///! An owning value written into a local from inside a BRANCH of an `async`
///! function used to be miscompiled: heap corruption from a double free.
///!
///! A state whose first touch of a carried local is a top-level write does not
///! take the value out of the carrier — it produces its own — so the lowering
///! turns that write into a declaration. It used to bind the SAME alpha-renamed
///! name in every such state, and codegen keys a local's drop flag BY NAME, so
///! several states shared one flag while owning separate storage. A flag raised
///! where one state initialized its copy then enabled the scope-exit drop in a
///! state that never did.
///!
///! The arithmetic of it is why an `if`/`else` is the shape that breaks: one
///! declaring state is fine, two survive, and three — the entry state plus one
///! per arm — release the same heap block twice. Each declaring state now binds
///! a fresh name and hands the value back under it.
///!
///! Only the states that PRODUCE the value are separated. States that TAKE a
///! carried value still share one binding, and several of those in one function
///! still collide; the note above `prepend_agg_take` in `sema/async_lower.cryo`
///! records why they cannot simply be renamed too. That remainder is what keeps
///! `HttpServer::with_read_timeout` unenforced.
///!
///! `carried_owning_local_written_outside_any_branch` is the CONTROL: the same
///! function with the branch removed. It passed throughout, which is what
///! identified the branch — rather than the loop, the await, or the owning
///! payload — as the variable that mattered.

![config(testing)]
namespace CryoTests::Tests::Stdlib::AsyncBranchOwningLocal;

import std::core::option;
import std::core::result;
import std::collections::str;
import std::collections::string;
import std::collections::array;
import std::future;
import std::time;
import std::test::error;
import std::test::assert;

/// Churn the allocator so a double free shows up as corruption here rather
/// than as a quiet inconsistency that surfaces somewhere unrelated.
function abol_churn() -> u64 {
    mut total: u64 = 0;
    mut i: i64 = 0;
    while (i < 200) {
        mut a: Array<u8> = Array<u8>::with_capacity(128);
        a.push(1u8);
        total = total + a.length();
        a.drop();
        i = i + 1;
    }
    return total;
}

/// An owner with heap content, so a stale or doubly-dropped payload is a real
/// memory fault rather than a wrong number.
type struct Source {
    s: String;

    /// Hands back an OWNING payload across a suspend.
    async give(mut &this) -> Result<String, i64> {
        await Sleep::new(Duration::from_millis(2u64));
        mut out: String = String::from_str(Str::new("owned"));
        out.push_byte(0x42u8);
        return Result::Ok(out);
    }
}

implement trait Drop for struct Source {
    drop(mut &this) -> void { this.s.drop(); }
}

/// The control: the owning local is written at statement level, never inside a
/// branch. Six payload bytes plus 200 from the churn, per iteration.
async function abol_no_branch(iters: i64) -> u64 {
    mut r: Source = Source { s: String::from_str(Str::new("hello")) };
    mut total: u64 = 0;
    mut k: i64 = 0;
    while (k < iters) {
        mut got: Result<String, i64> = Result::Err(0);
        got = await r.give();
        match (got) {
            Result::Ok(s)  => { mut owned: String = s; total = total + owned.length(); }
            Result::Err(_) => { }
        }
        total = total + abol_churn();
        k = k + 1;
    }
    return total;
}

/// The failing shape: identical, except the write happens inside an `if`/`else`
/// whose arms both produce the value.
async function abol_in_branch(flag: boolean, iters: i64) -> u64 {
    mut r: Source = Source { s: String::from_str(Str::new("hello")) };
    mut total: u64 = 0;
    mut k: i64 = 0;
    while (k < iters) {
        mut got: Result<String, i64> = Result::Err(0);
        if (flag) {
            got = await r.give();
        } else {
            got = await r.give();
        }
        match (got) {
            Result::Ok(s)  => { mut owned: String = s; total = total + owned.length(); }
            Result::Err(_) => { }
        }
        total = total + abol_churn();
        k = k + 1;
    }
    return total;
}

![test]
function carried_owning_local_written_outside_any_branch() -> Result<(), TestError> {
    mut ex: Executor = Executor::new();
    const r: u64 = ex.block_on(abol_no_branch(2 as i64));
    ex.drop();
    return expect_eq(r, 412u64);
}

![test]
function carried_owning_local_written_inside_a_branch() -> Result<(), TestError> {
    mut ex: Executor = Executor::new();
    const r: u64 = ex.block_on(abol_in_branch(false, 2 as i64));
    ex.drop();
    return expect_eq(r, 412u64);
}
