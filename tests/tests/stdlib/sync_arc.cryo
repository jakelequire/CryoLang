///! Arc<T> - atomic reference counting (single-threaded coverage).
///!
///! Cross-thread Arc semantics depend on std::thread (Step 9, in flight);
///! these tests pin down the refcount mechanics, drop-at-zero, and clone
///! sharing on a single thread.  Cross-thread cases will go in a
///! sibling test file once spawn lands.

![config(testing)]
namespace CryoTests::Tests::Stdlib::SyncArc;

import std::core::result;
import std::core::option;
import std::core::drop;
import std::collections::array;
import std::alloc::arc;
import std::test::error;
import std::test::assert;

mut arc_payload_drops: i32 = 0;

type struct Counted {
    tag: i32;
}

implement trait Drop for struct Counted {
    drop(mut &this) -> void {
        arc_payload_drops = arc_payload_drops + 1;
    }
}

![test]
function arc_new_starts_at_strong_count_one() -> Result<(), TestError> {
    arc_payload_drops = 0;
    mut a: Arc<Counted> = Arc::new(Counted { tag: 1 });
    const sc: u64 = a.strong_count();
    a.drop();
    match (expect_eq(sc as i32, 1)) {
        Result::Ok(_)  => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    match (expect_eq(arc_payload_drops, 1)) {
        Result::Ok(_)  => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

![test]
function arc_clone_bumps_strong_count() -> Result<(), TestError> {
    arc_payload_drops = 0;
    mut a: Arc<Counted> = Arc::new(Counted { tag: 2 });
    mut b: Arc<Counted> = a.clone();
    mut c: Arc<Counted> = a.clone();
    const sc_a: u64 = a.strong_count();
    const sc_b: u64 = b.strong_count();
    const sc_c: u64 = c.strong_count();
    a.drop();
    b.drop();
    c.drop();
    // All three handles see refcount == 3 (Relaxed ordering on a single
    // thread is sequentially consistent for the issuing thread).
    match (expect_eq(sc_a as i32, 3)) {
        Result::Ok(_)  => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    match (expect_eq(sc_b as i32, 3)) {
        Result::Ok(_)  => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    match (expect_eq(sc_c as i32, 3)) {
        Result::Ok(_)  => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    // Only the *last* drop runs Counted::drop.
    match (expect_eq(arc_payload_drops, 1)) {
        Result::Ok(_)  => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

![test]
function arc_intermediate_drops_do_not_free_value() -> Result<(), TestError> {
    arc_payload_drops = 0;
    mut a: Arc<Counted> = Arc::new(Counted { tag: 3 });
    mut b: Arc<Counted> = a.clone();
    a.drop();
    // After a's drop, b still owns the value; the payload's drop must NOT
    // have run yet (would be a use-after-free risk for b).
    const after_first: i32 = arc_payload_drops;
    const sc_b: u64 = b.strong_count();
    b.drop();
    match (expect_eq(after_first, 0)) {
        Result::Ok(_)  => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    match (expect_eq(sc_b as i32, 1)) {
        Result::Ok(_)  => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    match (expect_eq(arc_payload_drops, 1)) {
        Result::Ok(_)  => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

![test]
function arc_as_ptr_reads_shared_value() -> Result<(), TestError> {
    arc_payload_drops = 0;
    mut a: Arc<Counted> = Arc::new(Counted { tag: 77 });
    mut b: Arc<Counted> = a.clone();
    const pa: Counted* = a.as_ptr();
    const pb: Counted* = b.as_ptr();
    // Both pointers must observe the same value AND the same address.
    const tag_a: i32 = pa.tag;
    const tag_b: i32 = pb.tag;
    const same_ptr: boolean = (pa as void*) == (pb as void*);
    a.drop();
    b.drop();
    match (expect_eq(tag_a, 77)) {
        Result::Ok(_)  => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    match (expect_eq(tag_b, 77)) {
        Result::Ok(_)  => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    if (!same_ptr) {
        return Result::Err(TestError::failed(Str::new(
            "Arc clones must share the same payload address")));
    }
    return Result::Ok(());
}

![test]
function arc_clones_round_trip_through_loop() -> Result<(), TestError> {
    arc_payload_drops = 0;
    mut a: Arc<Counted> = Arc::new(Counted { tag: 1 });
    mut clones: Array<Arc<Counted>> = Array<Arc<Counted>>::new();
    mut i: i32 = 0;
    while (i < 5) {
        clones.push(a.clone());
        i = i + 1;
    }
    const after_clones: u64 = a.strong_count();
    // Drop each clone individually.
    mut j: i32 = 0;
    while (j < 5) {
        match (clones.pop()) {
            Option::Some(arc) => { mut local: Arc<Counted> = arc; local.drop(); }
            Option::None      => { }
        }
        j = j + 1;
    }
    clones.drop();
    const after_drops: u64 = a.strong_count();
    a.drop();
    match (expect_eq(after_clones as i32, 6)) {
        Result::Ok(_)  => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    match (expect_eq(after_drops as i32, 1)) {
        Result::Ok(_)  => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    match (expect_eq(arc_payload_drops, 1)) {
        Result::Ok(_)  => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

// ============================================================================
// Weak<T> - non-owning atomic references
//
// Like the Rc Weak tests, these use the test-local `Counted` type so each
// Weak<Counted> instance is owned and emitted in this object.
// ============================================================================

![test]
function arc_downgrade_does_not_bump_strong() -> Result<(), TestError> {
    arc_payload_drops = 0;
    mut a: Arc<Counted> = Arc::new(Counted { tag: 1 });
    mut w: Weak<Counted> = a.downgrade();
    const strong: u64 = a.strong_count();
    const weak: u64 = a.weak_count();
    w.drop();
    a.drop();
    expect_eq(strong as i32, 1)?;
    expect_eq(weak as i32, 1)?;
    return expect_eq(arc_payload_drops, 1);
}

![test]
function arc_upgrade_while_alive_returns_some() -> Result<(), TestError> {
    arc_payload_drops = 0;
    mut a: Arc<Counted> = Arc::new(Counted { tag: 42 });
    mut w: Weak<Counted> = a.downgrade();
    mut strong_during: u64 = 0u64;
    mut tag: i32 = 0;
    match (w.upgrade()) {
        Option::Some(up) => {
            mut u: Arc<Counted> = up;
            strong_during = u.strong_count();
            tag = u.as_ptr().tag;
            u.drop();
        }
        Option::None => { }
    }
    const strong_after: u64 = a.strong_count();
    w.drop();
    a.drop();
    expect_eq(strong_during as i32, 2)?;
    expect_eq(tag, 42)?;
    expect_eq(strong_after as i32, 1)?;
    return expect_eq(arc_payload_drops, 1);   // value dropped exactly once
}

![test]
function arc_upgrade_after_last_strong_is_none() -> Result<(), TestError> {
    arc_payload_drops = 0;
    mut a: Arc<Counted> = Arc::new(Counted { tag: 5 });
    mut w: Weak<Counted> = a.downgrade();
    a.drop();                          // last strong: value dies, header kept
    const drops_after_strong: i32 = arc_payload_drops;
    mut got_none: boolean = false;
    match (w.upgrade()) {
        Option::Some(up) => { mut u: Arc<Counted> = up; u.drop(); }
        Option::None    => { got_none = true; }
    }
    w.drop();                          // header freed; no second value drop
    expect_eq(drops_after_strong, 1)?;
    expect_eq(arc_payload_drops, 1)?;
    return expect_true(got_none, Str::new("upgrade after last strong Arc is None"));
}

![test]
function arc_weak_does_not_keep_value_alive() -> Result<(), TestError> {
    arc_payload_drops = 0;
    mut a: Arc<Counted> = Arc::new(Counted { tag: 9 });
    mut w: Weak<Counted> = a.downgrade();
    a.drop();
    // The lone Weak must NOT have kept the value alive.
    const dropped: i32 = arc_payload_drops;
    w.drop();
    return expect_eq(dropped, 1);
}

![test]
function arc_get_mut_blocked_by_outstanding_weak() -> Result<(), TestError> {
    arc_payload_drops = 0;
    mut a: Arc<Counted> = Arc::new(Counted { tag: 3 });
    mut w: Weak<Counted> = a.downgrade();
    mut blocked: boolean = false;
    match (a.get_mut()) {
        Option::Some(_) => { }
        Option::None    => { blocked = true; }
    }
    w.drop();
    mut unlocked: boolean = false;
    match (a.get_mut()) {
        Option::Some(p) => { p.tag = 8; unlocked = true; }
        Option::None    => { }
    }
    const final_tag: i32 = a.as_ptr().tag;
    a.drop();
    expect_true(blocked, Str::new("get_mut blocked while a Weak exists"))?;
    expect_true(unlocked, Str::new("get_mut allowed once unique"))?;
    return expect_eq(final_tag, 8);
}

![test]
function arc_dangling_weak_upgrades_to_none() -> Result<(), TestError> {
    mut w: Weak<Counted> = Weak<Counted>::new();
    mut got_none: boolean = false;
    match (w.upgrade()) {
        Option::Some(up) => { mut u: Arc<Counted> = up; u.drop(); }
        Option::None    => { got_none = true; }
    }
    w.drop();
    return expect_true(got_none, Str::new("dangling Weak::new upgrades to None"));
}

![test]
function arc_weak_clone_bumps_weak_count() -> Result<(), TestError> {
    mut a: Arc<Counted> = Arc::new(Counted { tag: 1 });
    mut w1: Weak<Counted> = a.downgrade();
    mut w2: Weak<Counted> = w1.clone();
    const wc: u64 = a.weak_count();
    w2.drop();
    w1.drop();
    a.drop();
    return expect_eq(wc as i32, 2);
}
