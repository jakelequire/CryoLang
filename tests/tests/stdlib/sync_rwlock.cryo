///! RwLock<T> - single-threaded coverage of read/write/try_read/try_write
///! plus guard drop releasing the lock.  Multi-reader concurrency tests
///! require std::thread.

![config(testing)]
namespace CryoTests::Tests::Stdlib::SyncRwLock;

import std::core::result;
import std::core::option;
import std::core::drop;
import std::sync::rwlock;
import std::test::error;
import std::test::assert;

![test]
function rwlock_read_returns_guard() -> Result<(), TestError> {
    mut l: RwLock<i32> = RwLock::new(50);
    mut g: RwLockReadGuard<i32, GlobalAlloc> = l.read();
    const v: i32 = *g.as_ptr();
    g.drop();
    l.drop();
    match (expect_eq(v, 50)) {
        Result::Ok(_)  => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

![test]
function rwlock_write_mutates_value() -> Result<(), TestError> {
    mut l: RwLock<i32> = RwLock::new(0);
    mut wg: RwLockWriteGuard<i32, GlobalAlloc> = l.write();
    *wg.as_ptr() = 123;
    wg.drop();
    mut rg: RwLockReadGuard<i32, GlobalAlloc> = l.read();
    const v: i32 = *rg.as_ptr();
    rg.drop();
    l.drop();
    match (expect_eq(v, 123)) {
        Result::Ok(_)  => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

![test]
function rwlock_write_then_read_round_trip() -> Result<(), TestError> {
    mut l: RwLock<i32> = RwLock::new(1);
    mut wg1: RwLockWriteGuard<i32, GlobalAlloc> = l.write();
    *wg1.as_ptr() = 7;
    wg1.drop();
    mut rg1: RwLockReadGuard<i32, GlobalAlloc> = l.read();
    const a: i32 = *rg1.as_ptr();
    rg1.drop();
    mut wg2: RwLockWriteGuard<i32, GlobalAlloc> = l.write();
    *wg2.as_ptr() = a * 2;
    wg2.drop();
    mut rg2: RwLockReadGuard<i32, GlobalAlloc> = l.read();
    const b: i32 = *rg2.as_ptr();
    rg2.drop();
    l.drop();
    match (expect_eq(a, 7)) {
        Result::Ok(_)  => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    match (expect_eq(b, 14)) {
        Result::Ok(_)  => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

![test]
function rwlock_try_read_succeeds_when_unlocked() -> Result<(), TestError> {
    mut l: RwLock<i32> = RwLock::new(33);
    mut got: boolean = false;
    mut v: i32 = 0;
    match (l.try_read()) {
        Option::Some(g) => {
            mut guard: RwLockReadGuard<i32, GlobalAlloc> = g;
            got = true;
            v = *guard.as_ptr();
            guard.drop();
        }
        Option::None => { }
    }
    l.drop();
    if (!got) {
        return Result::Err(TestError::failed(Str::new(
            "try_read on unlocked RwLock must return Some")));
    }
    match (expect_eq(v, 33)) {
        Result::Ok(_)  => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

![test]
function rwlock_try_write_succeeds_when_unlocked() -> Result<(), TestError> {
    mut l: RwLock<i32> = RwLock::new(0);
    mut got: boolean = false;
    match (l.try_write()) {
        Option::Some(g) => {
            mut guard: RwLockWriteGuard<i32, GlobalAlloc> = g;
            got = true;
            *guard.as_ptr() = 555;
            guard.drop();
        }
        Option::None => { }
    }
    mut after: i32 = 0;
    {
        mut rg: RwLockReadGuard<i32, GlobalAlloc> = l.read();
        after = *rg.as_ptr();
        rg.drop();
    }
    l.drop();
    if (!got) {
        return Result::Err(TestError::failed(Str::new(
            "try_write on unlocked RwLock must return Some")));
    }
    match (expect_eq(after, 555)) {
        Result::Ok(_)  => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}
