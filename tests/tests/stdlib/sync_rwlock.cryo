///! ReadWriteLock<T> - single-threaded coverage of read/write/try_read/try_write
///! plus guard drop releasing the lock.  Multi-reader concurrency tests
///! require std::thread.

![config(testing)]
namespace CryoTests::Tests::Stdlib::SyncRwLock;

import std::core::result::{ Result };
import std::core::option::{ Option };
import std::core::drop;
import std::core::mem;
import std::sync::read_write_lock::{ ReadWriteLock, ReadWriteLockReadGuard, ReadWriteLockWriteGuard };
import std::test::error::{ TestError };
import std::test::assert::{ expect_eq };
import std::alloc::allocator::{ GlobalAllocator };
import std::collections::str::{ Str };

![test]
function read_write_lock_read_returns_guard() -> Result<(), TestError> {
    mut l: ReadWriteLock<i32> = ReadWriteLock::new(50);
    mut g: ReadWriteLockReadGuard<i32, GlobalAllocator> = l.read();
    const v: i32 = *g.as_pointer();
    match (expect_eq(v, 50)) {
        Result::Ok(_)  => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

![test]
function read_write_lock_write_mutates_value() -> Result<(), TestError> {
    mut l: ReadWriteLock<i32> = ReadWriteLock::new(0);
    mut wg: ReadWriteLockWriteGuard<i32, GlobalAllocator> = l.write();
    *wg.as_mutable_pointer() = 123;
    mem::drop(wg);  // unlocked before the lock is taken again
    mut rg: ReadWriteLockReadGuard<i32, GlobalAllocator> = l.read();
    const v: i32 = *rg.as_pointer();
    match (expect_eq(v, 123)) {
        Result::Ok(_)  => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

![test]
function read_write_lock_write_then_read_round_trip() -> Result<(), TestError> {
    mut l: ReadWriteLock<i32> = ReadWriteLock::new(1);
    mut wg1: ReadWriteLockWriteGuard<i32, GlobalAllocator> = l.write();
    *wg1.as_mutable_pointer() = 7;
    mem::drop(wg1);  // unlocked before the lock is taken again
    mut rg1: ReadWriteLockReadGuard<i32, GlobalAllocator> = l.read();
    const a: i32 = *rg1.as_pointer();
    mem::drop(rg1);  // unlocked before the lock is taken again
    mut wg2: ReadWriteLockWriteGuard<i32, GlobalAllocator> = l.write();
    *wg2.as_mutable_pointer() = a * 2;
    mem::drop(wg2);  // unlocked before the lock is taken again
    mut rg2: ReadWriteLockReadGuard<i32, GlobalAllocator> = l.read();
    const b: i32 = *rg2.as_pointer();
    match (expect_eq(a, 7)) {
        Result::Ok(_)  => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    match (expect_eq(b, 14)) {
        Result::Ok(_)  => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

![test]
function read_write_lock_try_read_succeeds_when_unlocked() -> Result<(), TestError> {
    mut l: ReadWriteLock<i32> = ReadWriteLock::new(33);
    mut got: boolean = false;
    mut v: i32 = 0;
    match (l.try_read()) {
        Option::Some(g) => {
            mut guard: ReadWriteLockReadGuard<i32, GlobalAllocator> = g;
            got = true;
            v = *guard.as_pointer();
        }
        Option::None => { }
    }
    if (!got) {
        return Result::Err(TestError::failed(Str::new(
            "try_read on unlocked ReadWriteLock must return Some")));
    }
    match (expect_eq(v, 33)) {
        Result::Ok(_)  => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

![test]
function read_write_lock_try_write_succeeds_when_unlocked() -> Result<(), TestError> {
    mut l: ReadWriteLock<i32> = ReadWriteLock::new(0);
    mut got: boolean = false;
    match (l.try_write()) {
        Option::Some(g) => {
            mut guard: ReadWriteLockWriteGuard<i32, GlobalAllocator> = g;
            got = true;
            *guard.as_mutable_pointer() = 555;
        }
        Option::None => { }
    }
    mut after: i32 = 0;
    {
        mut rg: ReadWriteLockReadGuard<i32, GlobalAllocator> = l.read();
        after = *rg.as_pointer();
    }
    if (!got) {
        return Result::Err(TestError::failed(Str::new(
            "try_write on unlocked ReadWriteLock must return Some")));
    }
    match (expect_eq(after, 555)) {
        Result::Ok(_)  => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}
