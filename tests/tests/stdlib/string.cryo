///! String / Str — borrowed view, ownership, push_str/push_byte/length.

![config(testing)]
namespace CryoTests::Tests::Stdlib::StringT;

import std::core::result;
import std::collections::str;
import std::collections::string;
import std::test::error;
import std::test::assert;

![test]
function new_string_is_empty() -> Result<(), TestError> {
    mut s: String = String::new();
    const empty: boolean = s.is_empty();
    const len: u64 = s.length();
    s.drop();
    match (expect(empty, Str::from_raw("new String is_empty" as u8*, 19))) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    const want_len: u64 = 0;
    match (expect_eq(len, want_len)) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

![test]
function push_str_grows_length() -> Result<(), TestError> {
    mut s: String = String::new();
    s.push_str(Str::from_raw("hello" as u8*, 5));
    const after_len: u64 = s.length();
    s.drop();
    const want: u64 = 5;
    match (expect_eq(after_len, want)) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

![test]
function push_str_concatenates() -> Result<(), TestError> {
    mut s: String = String::new();
    s.push_str(Str::from_raw("hello, " as u8*, 7));
    s.push_str(Str::from_raw("world" as u8*, 5));
    const after_len: u64 = s.length();
    s.drop();
    const want: u64 = 12;
    match (expect_eq(after_len, want)) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

![test]
function push_byte_appends_one() -> Result<(), TestError> {
    mut s: String = String::new();
    s.push_byte(0x48); // 'H'
    s.push_byte(0x69); // 'i'
    const after_len: u64 = s.length();
    s.drop();
    const want: u64 = 2;
    match (expect_eq(after_len, want)) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

![test]
function from_str_round_trips_bytes() -> Result<(), TestError> {
    const original: Str = Str::from_raw("Cryo" as u8*, 4);
    mut s: String = String::from_str(original);
    const ok_len: u64 = s.length();
    const view: Str = s.as_str();
    const view_eq: boolean = view.equals(&original);
    s.drop();
    const want: u64 = 4;
    match (expect_eq(ok_len, want)) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    match (expect(view_eq,
        Str::from_raw("as_str() should match the source bytes" as u8*, 38))) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

![test]
function clear_zeros_length_not_capacity() -> Result<(), TestError> {
    mut s: String = String::with_capacity(16);
    s.push_str(Str::from_raw("scratch" as u8*, 7));
    s.clear();
    const after_len: u64 = s.length();
    const cap_after: u64 = s.capacity();
    s.drop();
    const want_len: u64 = 0;
    match (expect_eq(after_len, want_len)) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    match (expect(cap_after >= 16,
        Str::from_raw("clear should not shrink capacity" as u8*, 32))) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

![test]
function str_equality_is_byte_wise() -> Result<(), TestError> {
    const a: Str = Str::from_raw("abc" as u8*, 3);
    const b: Str = Str::from_raw("abc" as u8*, 3);
    const c: Str = Str::from_raw("abd" as u8*, 3);
    match (expect(a.equals(&b),
        Str::from_raw("identical bytes should compare equal" as u8*, 36))) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    match (expect(!a.equals(&c),
        Str::from_raw("differing bytes should not compare equal" as u8*, 40))) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

![test]
function str_byte_at_in_range() -> Result<(), TestError> {
    const s: Str = Str::from_raw("abc" as u8*, 3);
    const b: u8 = s.byte_at(1).unwrap_or(0);
    match (expect_eq(b, 0x62 as u8)) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

![test]
function str_sub_bytes_window() -> Result<(), TestError> {
    const s: Str = Str::from_raw("hello, world" as u8*, 12);
    const sub: Str = s.sub_bytes(7, 12);
    const expected: Str = Str::from_raw("world" as u8*, 5);
    match (expect(sub.equals(&expected),
        Str::from_raw("sub_bytes(7,12) should be 'world'" as u8*, 33))) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}
