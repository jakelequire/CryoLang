///! String / Str - borrowed view, ownership, push/push/length.

![config(testing)]
namespace CryoTests::Tests::Stdlib::StringT;

import std::core::result;
import std::core::iter;
import std::collections::str;
import std::collections::string;
import std::collections::pair;
import std::test::error;
import std::test::assert;

![test]
function new_string_is_empty() -> Result<(), TestError> {
    mut s: String = String::new();
    const empty: boolean = s.is_empty();
    const len: u64 = s.length();
    s.drop();
    match (expect(empty, Str::new("new String is_empty"))) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    const want_len: u64 = 0;
    match (expect_eq(len, want_len)) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

![test]
function push_str_grows_length() -> Result<(), TestError> {
    mut s: String = String::new();
    s.push(Str::new("hello"));
    const after_len: u64 = s.length();
    s.drop();
    const want: u64 = 5;
    match (expect_eq(after_len, want)) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

![test]
function push_str_concatenates() -> Result<(), TestError> {
    mut s: String = String::new();
    s.push(Str::new("hello, "));
    s.push(Str::new("world"));
    const after_len: u64 = s.length();
    s.drop();
    const want: u64 = 12;
    match (expect_eq(after_len, want)) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

![test]
function push_byte_appends_one() -> Result<(), TestError> {
    mut s: String = String::new();
    s.push_byte(0x48); // 'H'
    s.push_byte(0x69); // 'i'
    const after_len: u64 = s.length();
    s.drop();
    const want: u64 = 2;
    match (expect_eq(after_len, want)) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

![test]
function from_str_round_trips_bytes() -> Result<(), TestError> {
    const original: Str = Str::new("Cryo");
    mut s: String = String::from_str(original);
    const ok_len: u64 = s.length();
    const view: Str = s.as_str();
    const view_eq: boolean = view.equals(&original);
    s.drop();
    const want: u64 = 4;
    match (expect_eq(ok_len, want)) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    match (expect(view_eq,
        Str::new("as_str() should match the source bytes"))) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

![test]
function from_generic_dispatches_by_type() -> Result<(), TestError> {
    // `String::from<T>` is a generic static method on the generic owner
    // `String<A = GlobalAlloc>`; each arm routes through `push`'s `static match`.
    const from_view: String  = String::from(Str::new("hi"));
    const from_string: String  = String::from("cee");
    const from_uint: String  = String::from(65 as u32);
    const from_int:  String  = String::from(-42 as i64);
    const from_bool: String  = String::from(true);

    const view_ok: boolean = from_view.as_str().equals(&Str::new("hi"));
    const cstr_ok: boolean = from_string.as_str().equals(&Str::new("cee"));
    const uint_ok: boolean = from_uint.as_str().equals(&Str::new("65"));
    const int_ok:  boolean = from_int.as_str().equals(&Str::new("-42"));
    const bool_ok: boolean = from_bool.as_str().equals(&Str::new("true"));

    match (expect(view_ok, Str::new("String::from(Str) should copy the view bytes"))) {
        Result::Ok(_) => { } Result::Err(e) => { return Result::Err(e); }
    }
    match (expect(cstr_ok, Str::new("String::from(string) should copy the C-string bytes"))) {
        Result::Ok(_) => { } Result::Err(e) => { return Result::Err(e); }
    }
    match (expect(uint_ok, Str::new("String::from(u32) should render decimal text"))) {
        Result::Ok(_) => { } Result::Err(e) => { return Result::Err(e); }
    }
    match (expect(int_ok, Str::new("String::from(i64) should render signed decimal text"))) {
        Result::Ok(_) => { } Result::Err(e) => { return Result::Err(e); }
    }
    match (expect(bool_ok, Str::new("String::from(boolean) should render `true`"))) {
        Result::Ok(_) => { } Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

![test]
function clear_zeros_length_not_capacity() -> Result<(), TestError> {
    mut s: String = String::with_capacity(16);
    s.push(Str::new("scratch"));
    s.clear();
    const after_len: u64 = s.length();
    const cap_after: u64 = s.capacity();
    s.drop();
    const want_len: u64 = 0;
    match (expect_eq(after_len, want_len)) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    match (expect(cap_after >= 16,
        Str::new("clear should not shrink capacity"))) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

![test]
function str_equality_is_byte_wise() -> Result<(), TestError> {
    const a: Str = Str::new("abc");
    const b: Str = Str::new("abc");
    const c: Str = Str::new("abd");
    match (expect(a.equals(&b),
        Str::new("identical bytes should compare equal"))) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    match (expect(!a.equals(&c),
        Str::new("differing bytes should not compare equal"))) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

![test]
function str_byte_at_in_range() -> Result<(), TestError> {
    const s: Str = Str::new("abc");
    const b: u8 = s.byte_at(1).unwrap_or(0);
    match (expect_eq(b, 0x62 as u8)) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

![test]
function str_sub_bytes_window() -> Result<(), TestError> {
    const s: Str = Str::new("hello, world");
    const sub: Str = s.sub_bytes(7, 12);
    const expected: Str = Str::new("world");
    match (expect(sub.equals(&expected),
        Str::new("sub_bytes(7,12) should be 'world'"))) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

// Return the number of Unicode scalars in `s` (drives `chars` to exhaustion).
function scalar_count(s: Str) -> u64 {
    mut it: implement Iterator<u32> = s.chars();
    mut n: u64 = 0;
    loop {
        match (it.next()) {
            Option::Some(_) => { n = n + 1; }
            Option::None => { break; }
        }
    }
    return n;
}

// Return the scalar at scalar-position `nth` (0-based), or 0 past the end.
function scalar_at(s: Str, nth: u64) -> u32 {
    mut it: implement Iterator<u32> = s.chars();
    mut i: u64 = 0;
    loop {
        match (it.next()) {
            Option::Some(cp) => {
                if (i == nth) { return cp; }
                i = i + 1;
            }
            Option::None => { return 0; }
        }
    }
}

![test]
function chars_counts_scalars() -> Result<(), TestError> {
    // "aé€😀" is 10 UTF-8 bytes but 4 scalars.
    const s: Str = Str::new("aé€😀");
    match (expect_eq(s.length(), 10 as u64)) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    match (expect_eq(scalar_count(s), 4 as u64)) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

![test]
function chars_decodes_scalar_values() -> Result<(), TestError> {
    // U+0061, U+00E9, U+20AC, U+1F600.
    const s: Str = Str::new("aé€😀");
    match (expect_eq(scalar_at(s, 0), 0x61 as u32)) {
        Result::Ok(_) => { } Result::Err(e) => { return Result::Err(e); }
    }
    match (expect_eq(scalar_at(s, 1), 0xE9 as u32)) {
        Result::Ok(_) => { } Result::Err(e) => { return Result::Err(e); }
    }
    match (expect_eq(scalar_at(s, 2), 0x20AC as u32)) {
        Result::Ok(_) => { } Result::Err(e) => { return Result::Err(e); }
    }
    match (expect_eq(scalar_at(s, 3), 0x1F600 as u32)) {
        Result::Ok(_) => { } Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

![test]
function char_indices_reports_byte_offsets() -> Result<(), TestError> {
    // Offsets advance by each scalar's UTF-8 width: 1, 2, 3, 4.
    const s: Str = Str::new("aé€😀");
    mut it: implement Iterator<Pair<u64, u32>> = s.char_indices();
    mut expected_off: u64 = 0;
    mut widths: u64[4];
    widths[0] = 1; widths[1] = 2; widths[2] = 3; widths[3] = 4;
    mut i: u64 = 0;
    loop {
        match (it.next()) {
            Option::Some(p) => {
                match (expect_eq(p.first, expected_off)) {
                    Result::Ok(_) => { } Result::Err(e) => { return Result::Err(e); }
                }
                expected_off = expected_off + widths[i];
                i = i + 1;
            }
            Option::None => { break; }
        }
    }
    match (expect_eq(i, 4 as u64)) {
        Result::Ok(_) => { } Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

![test]
function chars_replaces_malformed_utf8() -> Result<(), TestError> {
    // Lone continuation byte 0x80 followed by ASCII 'A' decodes to
    // U+FFFD then U+0041, one byte at a time.
    mut buf: u8[2];
    buf[0] = 0x80; buf[1] = 0x41;
    const s: Str = Str::from_raw(&buf[0], 2);
    match (expect_eq(scalar_count(s), 2 as u64)) {
        Result::Ok(_) => { } Result::Err(e) => { return Result::Err(e); }
    }
    match (expect_eq(scalar_at(s, 0), 0xFFFD as u32)) {
        Result::Ok(_) => { } Result::Err(e) => { return Result::Err(e); }
    }
    match (expect_eq(scalar_at(s, 1), 0x41 as u32)) {
        Result::Ok(_) => { } Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}
