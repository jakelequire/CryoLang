///! Box/Rc/Arc get_reference / get_mutable accessors and Box Deref.
///! get_mutable on Rc/Arc is gated on unique ownership (strong_count == 1).

![config(testing)]
namespace CryoTests::Tests::Stdlib::SmartPtrAccessors;

import std::core::result::{ Result };
import std::core::option::{ Option };
import std::core::drop;
import std::core::ops;
import std::core::mem;
import std::alloc::box::{ Box };
import std::alloc::rc::{ Rc };
import std::alloc::arc::{ Arc };
import std::test::error::{ TestError };
import std::test::assert::{ bail, expect_eq, expect_true };
import std::collections::str::{ Str };

![test]
function box_get_reference_get_mutable_deref() -> Result<(), TestError> {
    mut b: Box<i32> = Box::new(5);
    const m: mut i32* = b.get_mutable();
    *m = 9;
    const r: i32* = b.get_reference();
    const v: i32 = *r;
    const d: const i32* = b.deref();
    const dv: i32 = *d;
    expect_eq(v, 9)?;
    expect_eq(dv, 9)?;
    return Result::Ok(());
}

![test]
function rc_get_mutable_unique_then_shared() -> Result<(), TestError> {
    mut r: Rc<i32> = Rc::new(10);
    // Unique: get_mutable yields Some.
    match (r.get_mutable()) {
        Option::Some(p) => { *p = 20; }
        Option::None    => { return bail(Str::new("unique get_mutable should be Some")); }
    }
    // Clone -> count 2 -> get_mutable must be None on both handles.
    mut r2: Rc<i32> = r.clone();
    mut blocked: boolean = false;
    match (r.get_mutable()) {
        Option::Some(_) => { blocked = false; }
        Option::None    => { blocked = true; }
    }
    const shared: i32 = *r2.get_reference();
    mem::drop(r2);
    // Back to unique after dropping the clone.
    mut now_unique: boolean = false;
    match (r.get_mutable()) {
        Option::Some(_) => { now_unique = true; }
        Option::None    => { now_unique = false; }
    }
    expect_true(blocked, Str::new("shared get_mutable is None"))?;
    expect_eq(shared, 20)?;
    expect_true(now_unique, Str::new("get_mutable Some again after clone dropped"))?;
    return Result::Ok(());
}

![test]
function arc_get_mutable_unique() -> Result<(), TestError> {
    mut a: Arc<i32> = Arc::new(42);
    mut ok: boolean = false;
    match (a.get_mutable()) {
        Option::Some(p) => { *p = 43; ok = true; }
        Option::None    => { ok = false; }
    }
    const got: i32 = *a.get_reference();
    expect_true(ok, Str::new("unique arc get_mutable Some"))?;
    expect_eq(got, 43)?;
    return Result::Ok(());
}
