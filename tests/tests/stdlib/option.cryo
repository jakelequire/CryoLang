///! Option<T> - is_some/is_none/unwrap/unwrap_or, take, contains.

![config(testing)]
namespace CryoTests::Tests::Stdlib::OptionT;

import std::core::result;
import std::core::option;
import std::core::cmp;
import std::collections::str;
import std::collections::string;
import std::test::error;
import std::test::assert;

![test]
function some_is_some() -> Result<(), TestError> {
    const opt: Option<i32> = Option::Some(42);
    match (expect(opt.is_some(), Str::new("Some should be is_some"))) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    match (expect(!opt.is_none(), Str::new("Some should not be is_none"))) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

![test]
function none_is_none() -> Result<(), TestError> {
    const opt: Option<i32> = Option::None;
    match (expect(opt.is_none(), Str::new("None should be is_none"))) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    match (expect(!opt.is_some(), Str::new("None should not be is_some"))) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

![test]
function unwrap_some_yields_value() -> Result<(), TestError> {
    const opt: Option<i32> = Option::Some(7);
    match (expect_eq(opt.unwrap(), 7)) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

![test]
function unwrap_or_some_returns_inner() -> Result<(), TestError> {
    const opt: Option<i32> = Option::Some(5);
    match (expect_eq(opt.unwrap_or(0), 5)) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

![test]
function unwrap_or_none_returns_default() -> Result<(), TestError> {
    const opt: Option<i32> = Option::None;
    match (expect_eq(opt.unwrap_or(99), 99)) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

![test]
function contains_matches_value() -> Result<(), TestError> {
    const opt: Option<i32> = Option::Some(8);
    const probe: i32 = 8;
    match (expect(opt.contains(&probe),
        Str::new("Some(8).contains(&8) should be true"))) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

![test]
function contains_rejects_other_value() -> Result<(), TestError> {
    const opt: Option<i32> = Option::Some(8);
    const probe: i32 = 9;
    match (expect(!opt.contains(&probe),
        Str::new("Some(8).contains(&9) should be false"))) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

![test]
function none_panics_on_unwrap() -> Result<(), TestError> {
    // Decorated with should_panic so the runner accepts the panic as
    // success rather than failing the test.
    return Result::Ok(());
}

![test]
![should_panic]
function unwrap_none_panics() -> Result<(), TestError> {
    const opt: Option<i32> = Option::None;
    const _value: i32 = opt.unwrap();
    return Result::Ok(());
}

// `take` on Option<i32> replaces the source with None and returns
// the previous value.
![test]
function take_on_some_returns_previous() -> Result<(), TestError> {
    mut held: Option<i32> = Option::Some(42);
    mut taken: Option<i32> = held.take();
    match (expect(held.is_none(), Str::new("source becomes None after take"))) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    match (expect(taken.is_some(), Str::new("returned value is Some"))) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    match (expect_eq(taken.unwrap(), 42)) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

// `take` on None returns None and leaves source None.
![test]
function take_on_none_returns_none() -> Result<(), TestError> {
    mut held: Option<i32> = Option::None;
    mut taken: Option<i32> = held.take();
    match (expect(held.is_none(), Str::new("source stays None"))) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    match (expect(taken.is_none(), Str::new("taken is None"))) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

// Non-Copy regression: `take` must move the inner value rather than
// duplicate it.  Prior to the `*this` deref fix in the IR generator,
// this case stored the *pointer bits* into `taken`, corrupting the
// enum discriminant - a subsequent `is_none()` match fell through to
// `match.no_match → abort()` and SIGABRT'd.
![test]
function take_on_non_copy_moves_value() -> Result<(), TestError> {
    mut held: Option<String> = Option::Some(String::from_str(Str::new("hello")));
    mut taken: Option<String> = held.take();
    match (expect(held.is_none(), Str::new("source becomes None"))) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    match (expect(taken.is_some(), Str::new("taken is Some"))) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

// `![sink]` regression: `unwrap` copies the inner value out of a `&this`
// borrow.  The `![sink]` marker on `Option::unwrap` is what tells drop
// insertion the receiver is consumed at the call site; without it, the
// receiver `opt` would also be dropped at scope exit - a double-free of
// the heap buffer the unwrapped `String` now owns, which SIGABRTs.
![test]
function unwrap_on_owning_payload_no_double_free() -> Result<(), TestError> {
    const opt: Option<String> = Option::Some(String::from_str(Str::new("payload")));
    mut s: String = opt.unwrap();
    const len: u64 = s.length();
    s.drop();
    const want: u64 = 7;
    match (expect_eq(len, want)) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

// Conditional `Eq for Option<T> where T: Eq` regression tests.  Its
// `equals` matches both options by reference and calls `a.equals(b)` on
// the inner payloads - the exact generic-trait-dispatch path where a
// reference-typed binding is passed bare to a `&Self` parameter.  This
// path was doubly broken: for integers it `inttoptr`'d the loaded value
// and SEGFAULTED at runtime (self-host bug #6); for floats it passed the
// value where a pointer was expected and failed LLVM verification
// (bug #4). These exercise the fixed `ptr <- {integer,float}` arg
// coercion in codegen/ops/expr_ops.cryo.

![test]
function eq_option_i64_equal_payloads() -> Result<(), TestError> {
    const a: Option<i64> = Option::Some(5);
    const b: Option<i64> = Option::Some(5);
    match (expect(a.equals(&b),
        Str::new("Some(5).equals(&Some(5)) should be true"))) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

![test]
function eq_option_i64_unequal_payloads() -> Result<(), TestError> {
    const a: Option<i64> = Option::Some(5);
    const b: Option<i64> = Option::Some(6);
    match (expect(!a.equals(&b),
        Str::new("Some(5).equals(&Some(6)) should be false"))) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

![test]
function eq_option_i64_some_vs_none() -> Result<(), TestError> {
    const a: Option<i64> = Option::Some(5);
    const b: Option<i64> = Option::None;
    match (expect(!a.equals(&b),
        Str::new("Some(5).equals(&None) should be false"))) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

![test]
function eq_option_f64_equal_payloads() -> Result<(), TestError> {
    const a: Option<f64> = Option::Some(1.5);
    const b: Option<f64> = Option::Some(1.5);
    match (expect(a.equals(&b),
        Str::new("Some(1.5).equals(&Some(1.5)) should be true"))) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

![test]
function eq_option_f64_unequal_payloads() -> Result<(), TestError> {
    const a: Option<f64> = Option::Some(1.5);
    const b: Option<f64> = Option::Some(2.5);
    match (expect(!a.equals(&b),
        Str::new("Some(1.5).equals(&Some(2.5)) should be false"))) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

// `as_ref` borrows the payload IN PLACE: the returned pointer must alias
// the receiver's payload, not a copy.  Writing through it changes the
// original `Option`.  (If `as_ref` had copied the payload to a temporary,
// the write would be lost and `opt` would still read 10.)  This is the
// soundness pin for the borrowing accessor.
![test]
function as_ref_some_aliases_in_place() -> Result<(), TestError> {
    mut opt: Option<i32> = Option::Some(10);
    match (opt.as_ref()) {
        Option::Some(p) => { *p = 99; }
        Option::None => { return bail(Str::new("as_ref on Some returned None")); }
    }
    return expect_eq(opt.unwrap(), 99);
}

// Reading through the borrow yields the stored value, and the receiver
// stays usable afterwards (`as_ref` is NOT `![sink]`).
![test]
function as_ref_some_reads_without_consuming() -> Result<(), TestError> {
    const opt: Option<i32> = Option::Some(7);
    match (opt.as_ref()) {
        Option::Some(p) => {
            match (expect_eq(*p, 7)) {
                Result::Ok(_) => { }
                Result::Err(e) => { return Result::Err(e); }
            }
        }
        Option::None => { return bail(Str::new("as_ref on Some returned None")); }
    }
    return expect_eq(opt.unwrap_or(0), 7);
}

// Calls a method ON the as_ref result (Option<i32*>), which forces
// Option<i32*> to full materialization. The lazy-instantiation fix must
// keep Option<i32*>::as_ref deferred so this does NOT re-tower.
![test]
function as_ref_none_is_none() -> Result<(), TestError> {
    const opt: Option<i32> = Option::None;
    return expect(opt.as_ref().is_none(), Str::new("as_ref on None is None"));
}

// `as_ref` does not consume an owning payload: the receiver still owns the
// `String` afterwards, so it is unwrapped and dropped exactly once. A
// `![sink]`-style consume here would double-free the heap buffer.
![test]
function as_ref_owning_payload_does_not_consume() -> Result<(), TestError> {
    mut opt: Option<String> = Option::Some(String::from_str(Str::new("hi")));
    const present: boolean = opt.as_ref().is_some();
    mut s: String = opt.unwrap();
    const len: u64 = s.length();
    s.drop();
    match (expect(present, Str::new("as_ref on Some(String) is Some"))) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    const want: u64 = 2;
    return expect_eq(len, want);
}

