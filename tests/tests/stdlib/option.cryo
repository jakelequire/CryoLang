///! Option<T> - is_some/is_none/unwrap/unwrap_or, take, contains.

![config(testing)]
namespace CryoTests::Tests::Stdlib::OptionT;

import std::core::result;
import std::core::option;
import std::collections::str;
import std::collections::string;
import std::test::error;
import std::test::assert;

![test]
function some_is_some() -> Result<(), TestError> {
    const opt: Option<i32> = Option::Some(42);
    match (expect(opt.is_some(), Str::new("Some should be is_some"))) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    match (expect(!opt.is_none(), Str::new("Some should not be is_none"))) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

![test]
function none_is_none() -> Result<(), TestError> {
    const opt: Option<i32> = Option::None;
    match (expect(opt.is_none(), Str::new("None should be is_none"))) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    match (expect(!opt.is_some(), Str::new("None should not be is_some"))) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

![test]
function unwrap_some_yields_value() -> Result<(), TestError> {
    const opt: Option<i32> = Option::Some(7);
    match (expect_eq(opt.unwrap(), 7)) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

![test]
function unwrap_or_some_returns_inner() -> Result<(), TestError> {
    const opt: Option<i32> = Option::Some(5);
    match (expect_eq(opt.unwrap_or(0), 5)) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

![test]
function unwrap_or_none_returns_default() -> Result<(), TestError> {
    const opt: Option<i32> = Option::None;
    match (expect_eq(opt.unwrap_or(99), 99)) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

![test]
function contains_matches_value() -> Result<(), TestError> {
    const opt: Option<i32> = Option::Some(8);
    const probe: i32 = 8;
    match (expect(opt.contains(&probe),
        Str::new("Some(8).contains(&8) should be true"))) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

![test]
function contains_rejects_other_value() -> Result<(), TestError> {
    const opt: Option<i32> = Option::Some(8);
    const probe: i32 = 9;
    match (expect(!opt.contains(&probe),
        Str::new("Some(8).contains(&9) should be false"))) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

![test]
function none_panics_on_unwrap() -> Result<(), TestError> {
    // Decorated with should_panic so the runner accepts the panic as
    // success rather than failing the test.
    return Result::Ok(());
}

![test]
![should_panic]
function unwrap_none_panics() -> Result<(), TestError> {
    const opt: Option<i32> = Option::None;
    const _value: i32 = opt.unwrap();
    return Result::Ok(());
}

// `take` on Option<i32> replaces the source with None and returns
// the previous value.
![test]
function take_on_some_returns_previous() -> Result<(), TestError> {
    mut held: Option<i32> = Option::Some(42);
    mut taken: Option<i32> = held.take();
    match (expect(held.is_none(), Str::new("source becomes None after take"))) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    match (expect(taken.is_some(), Str::new("returned value is Some"))) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    match (expect_eq(taken.unwrap(), 42)) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

// `take` on None returns None and leaves source None.
![test]
function take_on_none_returns_none() -> Result<(), TestError> {
    mut held: Option<i32> = Option::None;
    mut taken: Option<i32> = held.take();
    match (expect(held.is_none(), Str::new("source stays None"))) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    match (expect(taken.is_none(), Str::new("taken is None"))) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

// Non-Copy regression: `take` must move the inner value rather than
// duplicate it.  Prior to the `*this` deref fix in the IR generator,
// this case stored the *pointer bits* into `taken`, corrupting the
// enum discriminant - a subsequent `is_none()` match fell through to
// `match.no_match → abort()` and SIGABRT'd.
![test]
function take_on_non_copy_moves_value() -> Result<(), TestError> {
    mut held: Option<String> = Option::Some(String::from_str(Str::new("hello")));
    mut taken: Option<String> = held.take();
    match (expect(held.is_none(), Str::new("source becomes None"))) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    match (expect(taken.is_some(), Str::new("taken is Some"))) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

// `![sink]` regression: `unwrap` copies the inner value out of a `&this`
// borrow.  The `![sink]` marker on `Option::unwrap` is what tells drop
// insertion the receiver is consumed at the call site; without it, the
// receiver `opt` would also be dropped at scope exit - a double-free of
// the heap buffer the unwrapped `String` now owns, which SIGABRTs.
![test]
function unwrap_on_owning_payload_no_double_free() -> Result<(), TestError> {
    const opt: Option<String> = Option::Some(String::from_str(Str::new("payload")));
    mut s: String = opt.unwrap();
    const len: u64 = s.length();
    s.drop();
    const want: u64 = 7;
    match (expect_eq(len, want)) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

