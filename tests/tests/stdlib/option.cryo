///! Option<T> — is_some/is_none/unwrap/unwrap_or, take, contains.

![config(testing)]
namespace CryoTests::Tests::Stdlib::OptionT;

import std::core::result;
import std::core::option;
import std::test::error;
import std::test::assert;

![test]
function some_is_some() -> Result<(), TestError> {
    const opt: Option<i32> = Option::Some(42);
    match (expect(opt.is_some(), Str::from_raw("Some should be is_some", 22))) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    match (expect(!opt.is_none(), Str::from_raw("Some should not be is_none", 26))) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

![test]
function none_is_none() -> Result<(), TestError> {
    const opt: Option<i32> = Option::None;
    match (expect(opt.is_none(), Str::from_raw("None should be is_none", 22))) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    match (expect(!opt.is_some(), Str::from_raw("None should not be is_some", 26))) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

![test]
function unwrap_some_yields_value() -> Result<(), TestError> {
    const opt: Option<i32> = Option::Some(7);
    match (expect_eq(opt.unwrap(), 7)) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

![test]
function unwrap_or_some_returns_inner() -> Result<(), TestError> {
    const opt: Option<i32> = Option::Some(5);
    match (expect_eq(opt.unwrap_or(0), 5)) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

![test]
function unwrap_or_none_returns_default() -> Result<(), TestError> {
    const opt: Option<i32> = Option::None;
    match (expect_eq(opt.unwrap_or(99), 99)) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

![test]
function contains_matches_value() -> Result<(), TestError> {
    const opt: Option<i32> = Option::Some(8);
    const probe: i32 = 8;
    match (expect(opt.contains(&probe),
        Str::from_raw("Some(8).contains(&8) should be true", 35))) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

![test]
function contains_rejects_other_value() -> Result<(), TestError> {
    const opt: Option<i32> = Option::Some(8);
    const probe: i32 = 9;
    match (expect(!opt.contains(&probe),
        Str::from_raw("Some(8).contains(&9) should be false", 36))) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

![test]
function none_panics_on_unwrap() -> Result<(), TestError> {
    // Decorated with should_panic so the runner accepts the panic as
    // success rather than failing the test.
    return Result::Ok(());
}

![test]
![should_panic]
function unwrap_none_panics() -> Result<(), TestError> {
    const opt: Option<i32> = Option::None;
    const _value: i32 = opt.unwrap();
    return Result::Ok(());
}
