///! VaArgs — a safe, typed wrapper over a C-ABI variadic argument list.
///! A function with a trailing `args...` bucket forwards the C calling
///! convention; `VaArgs::new(args)` wraps the raw va_list so the body can
///! read typed values via `.next()` (type inferred from the binding through
///! the `![implicit]` directive) or `.next<T>()` (explicit). Arguments must be
///! passed at their promoted width — the C variadic ABI does not widen `i32`
///! to `i64`, so these tests pass `i64`-typed values.

![config(testing)]
namespace CryoTests::Tests::Stdlib::VaArgsT;

import std::core::result;
import std::core::varargs;
import std::collections::str;
import std::test::error;
import std::test::assert;

// Sum `count` i64 varargs using the implicit `.next()` (T recovered from the
// `const v: i64 = ...` binding type).
function sum_i64(count: i32, args...) -> i64 {
    mut va: VaArgs = VaArgs::new(args);
    mut total: i64 = 0;
    mut i: i32 = 0;
    while (i < count) {
        const v: i64 = va.next();
        total = total + v;
        i = i + 1;
    }
    return total;
}

// Read two i64 varargs using the explicit `.next<i64>()` form.
function add_two(args...) -> i64 {
    mut va: VaArgs = VaArgs::new(args);
    const a: i64 = va.next<i64>();
    const b: i64 = va.next<i64>();
    return a + b;
}

![test]
function implicit_next_sums_i64_varargs() -> Result<(), TestError> {
    const a: i64 = 10;
    const b: i64 = 20;
    const c: i64 = 30;
    const s: i64 = sum_i64(3, a, b, c);
    return expect(s == 60, Str::new("VaArgs implicit .next() sum mismatch"));
}

![test]
function explicit_next_reads_i64() -> Result<(), TestError> {
    const a: i64 = 7;
    const b: i64 = 35;
    const r: i64 = add_two(a, b);
    return expect(r == 42, Str::new("VaArgs explicit .next<i64>() mismatch"));
}

![test]
function zero_varargs_is_well_formed() -> Result<(), TestError> {
    // No variadic arguments consumed: the prologue still sets up / tears down
    // the va_list cleanly.
    const s: i64 = sum_i64(0);
    return expect(s == 0, Str::new("VaArgs zero-arg sum should be 0"));
}
