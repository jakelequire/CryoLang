///! SHA-1 (RFC 3174) known-answer vectors.
///!
///! `sha1::sha1(data, len, out)` writes a 20-byte big-endian digest into
///! the caller-provided `out` buffer. These tests feed the three canonical
///! RFC 3174 / FIPS 180 vectors and compare all 20 digest bytes against the
///! published values:
///!
///!   ""                                          -> da39a3ee...afd80709
///!   "abc"                                       -> a9993e36...9cd0d89d
///!   "The quick brown fox jumps over the lazy dog" -> 2fd4e1c6...1b93eb12
///!
///! Comparing raw digest bytes keeps the test free of any hex/base64
///! formatter dependency: the assertion exercises exactly the SHA-1 output.

![config(testing)]
namespace CryoTests::Tests::Stdlib::Sha1T;

import std::core::result;
import std::collections::str;
import std::encoding::sha1;
import std::test::error;
import std::test::assert;

/// Hash `input` and compare the resulting 20-byte digest against the 20
/// expected bytes at `want`. Both `want` and the SHA-1 output are compared
/// byte-for-byte; any mismatch reports the first differing index.
function check_sha1(input: Str, want: u8*) -> Result<(), TestError> {
    mut digest: u8[20];
    sha1::sha1(input.as_ptr(), input.length(), &digest[0]);
    mut i: u64 = 0;
    while (i < 20) {
        if (digest[i] != want[i]) {
            return bail(Str::new("SHA-1 digest byte mismatch"));
        }
        i++;
    }
    return Result::Ok(());
}

// "" -> da39a3ee5e6b4b0d3255bfef95601890afd80709
![test]
function sha1_empty_string() -> Result<(), TestError> {
    mut want: u8[20];
    want[0]  = 0xda; want[1]  = 0x39; want[2]  = 0xa3; want[3]  = 0xee;
    want[4]  = 0x5e; want[5]  = 0x6b; want[6]  = 0x4b; want[7]  = 0x0d;
    want[8]  = 0x32; want[9]  = 0x55; want[10] = 0xbf; want[11] = 0xef;
    want[12] = 0x95; want[13] = 0x60; want[14] = 0x18; want[15] = 0x90;
    want[16] = 0xaf; want[17] = 0xd8; want[18] = 0x07; want[19] = 0x09;
    return check_sha1(Str::new(""), &want[0]);
}

// "abc" -> a9993e364706816aba3e25717850c26c9cd0d89d
![test]
function sha1_abc() -> Result<(), TestError> {
    mut want: u8[20];
    want[0]  = 0xa9; want[1]  = 0x99; want[2]  = 0x3e; want[3]  = 0x36;
    want[4]  = 0x47; want[5]  = 0x06; want[6]  = 0x81; want[7]  = 0x6a;
    want[8]  = 0xba; want[9]  = 0x3e; want[10] = 0x25; want[11] = 0x71;
    want[12] = 0x78; want[13] = 0x50; want[14] = 0xc2; want[15] = 0x6c;
    want[16] = 0x9c; want[17] = 0xd0; want[18] = 0xd8; want[19] = 0x9d;
    return check_sha1(Str::new("abc"), &want[0]);
}

// "The quick brown fox jumps over the lazy dog"
//   -> 2fd4e1c67a2d28fced849ee1bb76e7391b93eb12
![test]
function sha1_quick_brown_fox() -> Result<(), TestError> {
    mut want: u8[20];
    want[0]  = 0x2f; want[1]  = 0xd4; want[2]  = 0xe1; want[3]  = 0xc6;
    want[4]  = 0x7a; want[5]  = 0x2d; want[6]  = 0x28; want[7]  = 0xfc;
    want[8]  = 0xed; want[9]  = 0x84; want[10] = 0x9e; want[11] = 0xe1;
    want[12] = 0xbb; want[13] = 0x76; want[14] = 0xe7; want[15] = 0x39;
    want[16] = 0x1b; want[17] = 0x93; want[18] = 0xeb; want[19] = 0x12;
    return check_sha1(
        Str::new("The quick brown fox jumps over the lazy dog"), &want[0]);
}

// A 56-byte input (one byte short of forcing a second padding block, the
// boundary the message-length math is most likely to get wrong).
//   "abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq"
//   -> 84983e441c3bd26ebaae4aa1f95129e5e54670f1
![test]
function sha1_two_block_boundary() -> Result<(), TestError> {
    mut want: u8[20];
    want[0]  = 0x84; want[1]  = 0x98; want[2]  = 0x3e; want[3]  = 0x44;
    want[4]  = 0x1c; want[5]  = 0x3b; want[6]  = 0xd2; want[7]  = 0x6e;
    want[8]  = 0xba; want[9]  = 0xae; want[10] = 0x4a; want[11] = 0xa1;
    want[12] = 0xf9; want[13] = 0x51; want[14] = 0x29; want[15] = 0xe5;
    want[16] = 0xe5; want[17] = 0x46; want[18] = 0x70; want[19] = 0xf1;
    return check_sha1(
        Str::new("abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq"),
        &want[0]);
}
