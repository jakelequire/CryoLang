///! SHA-1 (RFC 3174) against the published test vectors, and the streaming
///! hasher against the one-shot digest.
///!
///!   ""                                          da39a3ee...afd80709
///!   "abc"                                       a9993e36...9cd0d89d
///!   "The quick brown fox jumps over the lazy dog" 2fd4e1c6...1b93eb12
///!   the 448-bit two-block message               84983e44...e54670f1
///!   one million 'a'                             34aa973c...6534016f
///!
///! A message fed in pieces must hash as the same message held whole,
///! whatever the pieces' sizes, including pieces that end exactly on, one
///! short of and one past a block boundary and a padding that needs a
///! second block.

![config(testing)]
namespace CryoTests::Tests::Stdlib::Sha1T;

import std::core::result::{ Result };
import std::collections::str::{ Str };
import std::collections::string::{ String };
import std::collections::array::{ Array };
import std::hash::{ Sha1, Sha1Digest };
import std::test::error::{ TestError };
import std::test::assert::{ expect };

const TWO_BLOCK: string = "abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq";

function digest_of(text: string) -> Sha1Digest {
    return Sha1::digest(Str::new(text).as_bytes());
}

function check_hex(digest: &Sha1Digest, want: string) -> Result<(), TestError> {
    const got: String = digest.to_hex();
    return expect(got.as_str().equals(&Str::new(want)), Str::new(want));
}

/// `text` fed one piece at a time, piece `k` being `1 + k % step` bytes.
function streamed(text: Str, step: i64) -> Sha1Digest {
    mut hasher: Sha1 = Sha1::new();
    const bytes: &Slice<u8> = text.as_bytes();
    mut at: i64 = 0;
    mut k: i64 = 0;
    while (at < bytes.length()) {
        mut end: i64 = at + 1 + k % step;
        if (end > bytes.length()) { end = bytes.length(); }
        hasher.update(bytes.subslice(at, end));
        at = end;
        k++;
    }
    return hasher.finish();
}

![test]
function sha1_empty_string() -> Result<(), TestError> {
    return check_hex(&digest_of(""), "da39a3ee5e6b4b0d3255bfef95601890afd80709");
}

![test]
function sha1_abc() -> Result<(), TestError> {
    return check_hex(&digest_of("abc"), "a9993e364706816aba3e25717850c26c9cd0d89d");
}

![test]
function sha1_quick_brown_fox() -> Result<(), TestError> {
    return check_hex(&digest_of("The quick brown fox jumps over the lazy dog"),
                     "2fd4e1c67a2d28fced849ee1bb76e7391b93eb12");
}

/// 56 bytes: the padding no longer fits the block, so it takes a second.
![test]
function sha1_two_block_boundary() -> Result<(), TestError> {
    return check_hex(&digest_of(TWO_BLOCK), "84983e441c3bd26ebaae4aa1f95129e5e54670f1");
}

![test]
function sha1_of_a_million_a() -> Result<(), TestError> {
    mut bytes: Array<u8> = Array::<u8>::with_capacity(1000000);
    for (mut i: i64 = 0; i < 1000000; i++) { bytes.push(0x61); }
    return check_hex(&Sha1::digest(bytes.as_slice()), "34aa973cd4c4daa4f61eeb2bdbad27316534016f");
}

![test]
function sha1_streaming_matches_one_shot_for_every_piece_size() -> Result<(), TestError> {
    const text: Str = Str::new("The quick brown fox jumps over the lazy dog, then over 64 more bytes of it: abcdefghijklmnopqrstuvwxyz0123456789!");
    const whole: Sha1Digest = Sha1::digest(text.as_bytes());
    for (mut step: i64 = 1; step <= 70; step++) {
        expect(streamed(text, step) == whole, Str::new("a message fed in pieces hashes as the message held whole"))?;
    }
    return Result::Ok(());
}

![test]
function sha1_digest_displays_as_its_hexadecimal_digits() -> Result<(), TestError> {
    const shown: String = String::from(digest_of("abc"));
    return expect(shown.as_str().equals(&Str::new("a9993e364706816aba3e25717850c26c9cd0d89d")),
                  Str::new("a digest displays as its 40 lowercase hexadecimal digits"));
}
