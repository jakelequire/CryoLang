///! Command / Child - spawn known binaries, check exit status, capture
///! stdout and stderr.  The stderr-drain deadlock is fixed on both
///! platforms (Unix: poll(2) over non-blocking pipes; Windows: a
///! PeekNamedPipe-gated interleaved drain), so large
///! captures are safe.  `output_with_large_stderr_does_not_deadlock`
///! (Unix /bin/sh) and `output_large_stderr_no_deadlock_win` (Windows
///! PowerShell) each force a >64-KiB stderr load as a regression.

![config(testing)]
namespace CryoTests::Tests::Stdlib::ProcessCommand;

import std::core::result::{ Result };
import std::core::option::{ Option };
import std::core::slice::{ Slice };
import std::core::drop;
import std::core::mem;
import std::collections::array::{ Array };
import std::collections::str::{ Str };
import std::io::error::{ IoError, IoErrorKind, IoOperation };
import std::io::traits;
import std::collections::string::{ String };
import std::env;
import std::process::command::{ Command, Output, Stdio };
import std::process::child::{ Child, ChildStdout, ExitStatus };
import std::process::signal::{ Signal };
import std::process::memory::{ SystemMemory };
import std::fs::path::{ Path };
import std::fs::file::{ File };
import std::time::duration::{ Duration };
import std::time::clock::{ Instant };
import std::test::error::{ TestError };
import std::test::assert::{ bail, expect, expect_eq, expect_false };

// Compare an Array<u8> against the bytes of a Str.
function array_eq_str(arr: &Array<u8>, s: Str) -> boolean {
    const b: &Slice<u8> = s.as_bytes();
    if (arr.length() != b.length()) { return false; }
    mut i: i64 = 0;
    while (i < arr.length()) {
        match (arr.get(i)) {
            Option::Some(av) => {
                match (b.get(i)) {
                    Option::Some(bv) => { if (av != bv) { return false; } }
                    Option::None     => { return false; }
                }
            }
            Option::None => { return false; }
        }
        i++;
    }
    return true;
}

// ---------------------------------------------------------------------------
// Platform abstraction.
//
// The Unix coreutils (/bin/true, /bin/false, /bin/echo) don't exist on
// Windows.  These `![target(...)]` helpers pick the right program per OS and
// account for cmd.exe's CRLF line endings, keeping the test bodies below
// platform-neutral.
// ---------------------------------------------------------------------------

// A command that exits 0.
![target(unix)]
function cmd_true() -> Command { return Command::new(Str::new("/bin/true")); }
![target(windows)]
function cmd_true() -> Command {
    mut c: Command = Command::new(Str::new("cmd"));
    c.arg(Str::new("/c")); c.arg(Str::new("exit")); c.arg(Str::new("0"));
    return c;
}

// A command that exits 1.
![target(unix)]
function cmd_false() -> Command { return Command::new(Str::new("/bin/false")); }
![target(windows)]
function cmd_false() -> Command {
    mut c: Command = Command::new(Str::new("cmd"));
    c.arg(Str::new("/c")); c.arg(Str::new("exit")); c.arg(Str::new("1"));
    return c;
}

// Base `echo` command; callers append the words to print.
![target(unix)]
function cmd_echo() -> Command { return Command::new(Str::new("/bin/echo")); }
![target(windows)]
function cmd_echo() -> Command {
    mut c: Command = Command::new(Str::new("cmd"));
    c.arg(Str::new("/c")); c.arg(Str::new("echo"));
    return c;
}

// Expected `echo` stdout: cmd.exe terminates lines with CRLF, /bin/echo
// with a bare LF.
![target(unix)]
function echo_hello_expect() -> Str { return Str::new("hello\n"); }
![target(windows)]
function echo_hello_expect() -> Str { return Str::new("hello\r\n"); }

![target(unix)]
function echo_foobar_expect() -> Str { return Str::new("foo bar\n"); }
![target(windows)]
function echo_foobar_expect() -> Str { return Str::new("foo bar\r\n"); }

// The failed spawn's error records `operation` on `path`.
function expect_context(error: &IoError, operation: IoOperation, path: Str) -> Result<(), TestError> {
    match (error.operation()) {
        Option::Some(recorded) => { expect(recorded == operation, Str::new("the error records the operation that failed"))?; }
        Option::None           => { return bail(Str::new("the error records no operation")); }
    }
    match (error.path()) {
        Option::Some(recorded) => { return expect(recorded.as_str() == path, Str::new("the error names the path")); }
        Option::None           => { return bail(Str::new("the error names no path")); }
    }
}

/// A working directory, replaced once and then read by every spawn, is
/// released once: the setter swaps the old one out, and each spawn only
/// borrows the current one.  A spawn that took its own copy freed it at the
/// end of the spawn, and the heap failed within a few rounds.
![test]
function a_working_directory_survives_many_spawns() -> Result<(), TestError> {
    mut cmd: Command = cmd_true();
    cmd.current_directory(Str::new("."));
    cmd.current_directory(Str::new(".."));
    for (mut round: i64 = 0; round < 40; round++) {
        match (cmd.status()) {
            Result::Ok(status) => { expect(status.success(), Str::new("the command runs in the directory"))?; }
            Result::Err(_)     => { return bail(Str::new("the command did not start")); }
        }
    }
    return Result::Ok(());
}

/// Every setter returns the command, so one statement configures it.
![test]
function setters_chain_on_one_command() -> Result<(), TestError> {
    mut cmd: Command = cmd_echo();
    cmd.arg(Str::new("foo")).current_directory(Str::new(".")).env(Str::new("CRYO_CHAIN"), Str::new("1")).arg(Str::new("bar"));
    match (cmd.output()) {
        Result::Ok(out) => {
            expect(out.status().success(), Str::new("the chained command should succeed"))?;
            return expect(out.stdout().equals(echo_foobar_expect().as_bytes()), Str::new("both chained arguments reach the child, in order"));
        }
        Result::Err(_) => { return bail(Str::new("output() failed")); }
    }
}

/// `args` appends every piece an iterator yields, after earlier arguments.
![test]
function args_appends_an_iterator_of_arguments() -> Result<(), TestError> {
    mut cmd: Command = cmd_echo();
    cmd.args(Str::new("  foo   bar ").split_whitespace());
    match (cmd.output()) {
        Result::Ok(out) => {
            return expect(out.stdout().equals(echo_foobar_expect().as_bytes()), Str::new("args passes each piece as one argument"));
        }
        Result::Err(_) => { return bail(Str::new("output() failed")); }
    }
}

/// `shell` runs a whole command line through the platform shell and
/// answers its exit code.
![test]
function shell_answers_the_exit_code() -> Result<(), TestError> {
    expect_eq(Command::shell(Str::new("exit 3")), 3)?;
    return expect_eq(Command::shell(Str::new("exit 0")), 0);
}

![test]
function true_command_succeeds() -> Result<(), TestError> {
    mut cmd: Command = cmd_true();
    mut success: boolean = false;
    mut code: i32 = -1;
    match (cmd.status()) {
        Result::Ok(st) => { success = st.success(); code = st.exit_code().unwrap_or(-1); }
        Result::Err(_) => { return bail(Str::new("true command status failed")); }
    }
    match (expect(success, Str::new("true command should report success"))) {
        Result::Ok(_) => { } Result::Err(e) => { return Result::Err(e); }
    }
    return expect_eq(code, 0);
}

![test]
function false_command_fails() -> Result<(), TestError> {
    mut cmd: Command = cmd_false();
    mut success: boolean = true;
    mut code: i32 = -1;
    match (cmd.status()) {
        Result::Ok(st) => { success = st.success(); code = st.exit_code().unwrap_or(-1); }
        Result::Err(_) => { return bail(Str::new("false command status failed")); }
    }
    match (expect_false(success, Str::new("false command should not report success"))) {
        Result::Ok(_) => { } Result::Err(e) => { return Result::Err(e); }
    }
    return expect_eq(code, 1);
}

/// A program that does not exist is the spawn's own error, on every
/// platform, and it names the program.
![test]
function a_missing_program_is_a_spawn_error_naming_it() -> Result<(), TestError> {
    const program: Str = Str::new("/no/such/cryo_program_xyzzy");
    mut cmd: Command = Command::new(program);
    match (cmd.status()) {
        Result::Ok(_)  => { return bail(Str::new("a missing program must not start")); }
        Result::Err(e) => {
            expect(e.kind == IoErrorKind::NotFound, Str::new("a missing program is NotFound"))?;
            expect_eq(e.os_code, 2)?;
            return expect_context(&e, IoOperation::Spawn, program);
        }
    }
}

/// A working directory that does not exist is named by the spawn's error,
/// not the program, which was never reached.
![test]
function a_missing_working_directory_is_a_spawn_error_naming_it() -> Result<(), TestError> {
    const directory: Str = Str::new("cryo_no_such_directory_xyzzy");
    mut cmd: Command = cmd_true();
    cmd.current_directory(directory);
    match (cmd.status()) {
        Result::Ok(_)  => { return bail(Str::new("the child cannot start in a missing directory")); }
        Result::Err(e) => { return expect_context(&e, IoOperation::Open, directory); }
    }
}

/// A file that is no program is `NotExecutable`.
![target(windows)]
![test]
function a_file_that_is_no_program_is_not_executable() -> Result<(), TestError> {
    // A bare name is searched for, not taken from the current directory.
    const name: Str = Str::new("./cryo_not_a_program.tmp");
    match (File::write_text(Path::from(name), Str::new("plain text"))) {
        Result::Ok(_)  => { }
        Result::Err(_) => { return bail(Str::new("could not write the text file")); }
    }
    mut cmd: Command = Command::new(name);
    const outcome: Result<ExitStatus, IoError> = cmd.status();
    mem::drop(File::remove(Path::from(name)));
    match (outcome) {
        Result::Ok(_)  => { return bail(Str::new("a text file must not start")); }
        Result::Err(e) => {
            expect_eq(e.os_code, 193)?;
            expect(e.kind == IoErrorKind::NotExecutable, Str::new("a text file is NotExecutable"))?;
            return expect_context(&e, IoOperation::Spawn, name);
        }
    }
}

/// `env_remove` keeps an inherited variable from the child, and the later
/// of `env` and `env_remove` for one key is the one that holds.
![test]
function env_remove_keeps_an_inherited_variable_from_the_child() -> Result<(), TestError> {
    const name: Str = Str::new("CRYO_REMOVED_VARIABLE");
    env::set_var(name, Str::new("inherited"));

    mut removed: Command = cmd_print_variable(name);
    removed.env_remove(name);
    const removed_output: Output = removed.output().unwrap();

    mut set_then_removed: Command = cmd_print_variable(name);
    set_then_removed.env(name, Str::new("set")).env_remove(name);
    const set_then_removed_output: Output = set_then_removed.output().unwrap();

    mut removed_then_set: Command = cmd_print_variable(name);
    removed_then_set.env_remove(name).env(name, Str::new("set"));
    const removed_then_set_output: Output = removed_then_set.output().unwrap();

    mut inherited: Command = cmd_print_variable(name);
    const inherited_output: Output = inherited.output().unwrap();
    env::remove_var(name);

    expect(removed_output.stdout().equals(unset_variable_output(name).as_bytes()), Str::new("a removed variable does not reach the child"))?;
    expect(set_then_removed_output.stdout().equals(unset_variable_output(name).as_bytes()), Str::new("env_remove after env removes"))?;
    expect(removed_then_set_output.stdout().equals(set_variable_output(Str::new("set")).as_bytes()), Str::new("env after env_remove sets"))?;
    return expect(inherited_output.stdout().equals(set_variable_output(Str::new("inherited")).as_bytes()), Str::new("an untouched variable is inherited"));
}

/// Windows variable names ignore case, so removing `cryo_...` removes the
/// inherited `CRYO_...`.
![target(windows)]
![test]
function env_remove_ignores_case_on_windows() -> Result<(), TestError> {
    const name: Str = Str::new("CRYO_REMOVED_ANY_CASE");
    env::set_var(name, Str::new("inherited"));
    mut cmd: Command = cmd_print_variable(name);
    cmd.env_remove(Str::new("cryo_removed_any_case"));
    const output: Output = cmd.output().unwrap();
    env::remove_var(name);
    return expect(output.stdout().equals(unset_variable_output(name).as_bytes()), Str::new("the removal matches the name in any case"));
}

/// A child that has been waited for is never signalled: its process id may
/// already belong to another process.
![test]
function a_reaped_child_is_not_signalled() -> Result<(), TestError> {
    mut cmd: Command = cmd_true();
    mut child: Child = cmd.spawn().unwrap();
    mem::drop(child.wait());
    match (child.kill()) {
        Result::Ok(_)  => { return bail(Str::new("kill after wait must be refused")); }
        Result::Err(e) => { return expect(e.kind == IoErrorKind::InvalidInput, Str::new("refused with InvalidInput")); }
    }
}

/// `Signal::from_i32` answers only for a number it names.
![test]
function signal_from_a_number_is_checked() -> Result<(), TestError> {
    expect(Signal::from_i32(9).unwrap().as_i32() == 9, Str::new("9 is kill"))?;
    expect(Signal::from_i32(0).is_none(), Str::new("0 names no signal"))?;
    return expect(Signal::from_i32(16).is_none(), Str::new("16 names none of the signals"));
}

/// `kill_tree` ends the grandchild too: the pipe the whole tree holds
/// reaches end of file at once, not when the grandchild's five seconds
/// are up.
![test]
function kill_tree_ends_the_childs_descendants() -> Result<(), TestError> {
    mut cmd: Command = cmd_grandchild_holds_stdout();
    cmd.stdout(Stdio::Piped).group_descendants();
    mut child: Child = cmd.spawn().unwrap();
    mut stdout: ChildStdout = child.stdout.take().unwrap();
    mut seen: Array<u8> = Array::new();
    mut chunk: [u8; 64];
    while (!Str::from_raw(seen.as_ptr(), seen.length()).contains(&grandchild_marker())) {
        const count: i64 = stdout.read(&chunk[0], 64).unwrap();
        if (count == 0) { break; }
        for (mut i: i64 = 0; i < count; i++) { seen.push(chunk[i]); }
    }
    const killed: Instant = Instant::now();
    const outcome: Result<(), IoError> = child.kill_tree();
    mem::drop(child.wait());
    mut rest: Array<u8> = Array::new();
    mem::drop(stdout.read_to_end(&rest));
    const waited_for_end: Duration = killed.elapsed();
    expect(outcome.is_ok(), Str::new("kill_tree succeeds on a grouped child"))?;
    return expect(waited_for_end.as_millis() < 3000, Str::new("every holder of the pipe is gone at once"));
}

/// A child spawned without `group_descendants` has no tree to end.
![test]
function kill_tree_needs_a_grouped_child() -> Result<(), TestError> {
    mut cmd: Command = cmd_sleep();
    mut child: Child = cmd.spawn().unwrap();
    const outcome: Result<(), IoError> = child.kill_tree();
    mem::drop(child.kill());
    mem::drop(child.wait());
    match (outcome) {
        Result::Ok(_)  => { return bail(Str::new("an ungrouped child has no tree")); }
        Result::Err(e) => { return expect(e.kind == IoErrorKind::InvalidInput, Str::new("refused with InvalidInput")); }
    }
}

/// Every wait reports how much memory the child held at its peak; any
/// program holds well over 100 KB once loaded.
![test]
function a_childs_peak_memory_is_reported() -> Result<(), TestError> {
    mut waited: Command = cmd_true();
    const waited_status: ExitStatus = waited.status().unwrap();
    mut polled: Command = cmd_true();
    mut child: Child = polled.spawn().unwrap();
    const polled_status: ExitStatus = child.wait_timeout(Duration::from_secs(30)).unwrap().unwrap();
    expect(waited_status.peak_memory_bytes().unwrap_or(0) > 100000, Str::new("wait reports the peak"))?;
    return expect(polled_status.peak_memory_bytes().unwrap_or(0) > 100000, Str::new("wait_timeout reports the peak"));
}

/// The machine reports some memory, and no more available than installed.
![test]
function system_memory_reports_total_and_available() -> Result<(), TestError> {
    const memory: SystemMemory = SystemMemory::query().unwrap();
    expect(memory.total_bytes() > 0, Str::new("some memory is installed"))?;
    expect(memory.available_bytes() > 0, Str::new("some memory is available"))?;
    return expect(memory.available_bytes() <= memory.total_bytes(), Str::new("no more is available than installed"));
}

/// A piped stdout is taken out of the running child and read while the
/// child keeps running.
![test]
function a_running_childs_output_is_read_before_it_exits() -> Result<(), TestError> {
    mut cmd: Command = cmd_print_then_wait();
    cmd.stdout(Stdio::Piped);
    mut child: Child = cmd.spawn().unwrap();
    mut stdout: ChildStdout = child.stdout.take().unwrap();
    mut seen: Array<u8> = Array::new();
    mut chunk: [u8; 64];
    while (!Str::from_raw(seen.as_ptr(), seen.length()).contains(&Str::new("ready"))) {
        const count: i64 = stdout.read(&chunk[0], 64).unwrap();
        if (count == 0) { break; }
        for (mut i: i64 = 0; i < count; i++) { seen.push(chunk[i]); }
    }
    const running: boolean = child.try_wait().unwrap().is_none();
    mem::drop(child.kill());
    mem::drop(child.wait());
    expect(Str::from_raw(seen.as_ptr(), seen.length()).contains(&Str::new("ready")), Str::new("the first line arrives"))?;
    return expect(running, Str::new("the child is still running when its first line is read"));
}

![test]
function echo_stdout_via_pipe() -> Result<(), TestError> {
    // Capture stdout through the public Child.stdout pipe handle.
    mut cmd: Command = cmd_echo();
    cmd.arg(Str::new("hello"));
    cmd.stdout(Stdio::Piped);

    mut acc: Array<u8> = Array::new();
    mut chunk: [u8; 64];
    mut success: boolean = false;
    match (cmd.spawn()) {
        Result::Ok(handle) => {
            mut c: Child = handle;
            // Take the pipe handle OUT of the child before reading it. Matching
            // `c.stdout` in place would leave `c` holding a second claim on the
            // same descriptor, so the arm's handle and the child's teardown
            // would both close it.
            mut so: Option<ChildStdout> = Option::None;
            mem::swap::<Option<ChildStdout>>(&so, &c.stdout);
            match (so) {
                Option::Some(mut h) => {
                    loop {
                        match (h.read(&chunk[0], 64)) {
                            Result::Ok(n) => {
                                if (n == 0) { break; }
                                mut i: u64 = 0;
                                while (i < n) { acc.push(chunk[i]); i++; }
                            }
                            Result::Err(_) => {
                                return bail(Str::new("reading child stdout failed"));
                            }
                        }
                    }
                }
                Option::None => { }
            }
            match (c.wait()) {
                Result::Ok(st) => { success = st.success(); }
                Result::Err(_) => { return bail(Str::new("wait failed")); }
            }
        }
        Result::Err(_) => { return bail(Str::new("spawn of echo failed")); }
    }
    const content_ok: boolean = array_eq_str(&acc, echo_hello_expect());

    match (expect(success, Str::new("echo should succeed"))) {
        Result::Ok(_) => { } Result::Err(e) => { return Result::Err(e); }
    }
    return expect(content_ok, Str::new("echo hello should print the hello line"));
}

![test]
function output_captures_stdout() -> Result<(), TestError> {
    // The convenience `output()` path: spawn + wait + collect, with the
    // arguments echoed back joined by a space.
    mut cmd: Command = cmd_echo();
    cmd.arg(Str::new("foo"));
    cmd.arg(Str::new("bar"));
    mut success: boolean = false;
    mut content_ok: boolean = false;
    match (cmd.output()) {
        Result::Ok(out) => {
            mut o: Output = out;
            success = o.status().success();
            content_ok = o.stdout().equals(echo_foobar_expect().as_bytes());
        }
        Result::Err(_) => { return bail(Str::new("output() failed")); }
    }
    match (expect(success, Str::new("echo foo bar should succeed"))) {
        Result::Ok(_) => { } Result::Err(e) => { return Result::Err(e); }
    }
    return expect(content_ok, Str::new("output().stdout should be the \"foo bar\" line"));
}

// Regression for the stderr-drain deadlock: a `collect_output()` that reads
// stdout fully, then stderr, deadlocks when a child fills its 64-KiB stderr
// pipe buffer before its stdout is drained - the child blocks on
// `write(stderr, ...)`, the parent blocks on `read(stdout, ...)` waiting for
// the terminator the child hasn't yet produced, and the whole thing hangs
// forever.
//
// collect_output() polls both pipes interleaved via poll(2).  This test forces
// roughly 100 KiB onto stderr (well past the kernel's pipe buffer)
// before the child writes any stdout, and confirms output() returns
// in bounded time with both streams captured.
![test]
function output_with_large_stderr_does_not_deadlock() -> Result<(), TestError> {
    mut cmd: Command = Command::new(Str::new("/bin/sh"));
    cmd.arg(Str::new("-c"));
    // Print ~100 KiB to stderr first (`yes` repeats "y\n" forever;
    // `head -c` caps to 100000 bytes), then one terminator line to
    // stdout.  A serial-drain implementation would hang forever here.
    cmd.arg(Str::new("yes | head -c 100000 >&2; echo done"));
    mut deadlocked: boolean = true;
    mut success:    boolean = false;
    mut got_stdout: boolean = false;
    mut got_stderr: boolean = false;
    match (cmd.output()) {
        Result::Ok(out) => {
            mut o: Output = out;
            deadlocked = false;
            success    = o.status().success();
            got_stdout = o.stdout().length() >= 4;     // "done\n"
            got_stderr = o.stderr().length() >= 100000;
        }
        Result::Err(_) => {
            // /bin/sh missing on this host - skip rather than fail.  This is
            // the path taken on Windows (no /bin/sh): the regression being
            // guarded here is the Unix poll(2)-based interleaved drain, and
            // the Windows collect_output still drains stdout-then-stderr
            // sequentially, so it must not be handed this >64-KiB-stderr
            // workload until it grows a concurrent drain of its own.
            return Result::Ok(());
        }
    }
    match (expect(!deadlocked, Str::new("output() must return; old serial drain deadlocked"))) {
        Result::Ok(_) => { } Result::Err(e) => { return Result::Err(e); }
    }
    match (expect(success, Str::new("child should exit with status 0"))) {
        Result::Ok(_) => { } Result::Err(e) => { return Result::Err(e); }
    }
    match (expect(got_stdout, Str::new("stdout 'done' terminator must be captured"))) {
        Result::Ok(_) => { } Result::Err(e) => { return Result::Err(e); }
    }
    return expect(got_stderr, Str::new("stderr must capture ~100 KiB"));
}

// A command that prints the value of the variable `name` with no extra
// output. unix: printf avoids a trailing newline; windows: cmd's echo adds
// CRLF, and echoes `%name%` itself when the variable is unset.
![target(unix)]
function cmd_print_variable(name: Str) -> Command {
    mut script: String = String::from_str(Str::new("printf %s \"$"));
    script.push(name);
    script.push(Str::new("\""));
    mut c: Command = Command::new(Str::new("/bin/sh"));
    c.arg(Str::new("-c")).arg(script.as_str());
    return c;
}
![target(windows)]
function cmd_print_variable(name: Str) -> Command {
    mut script: String = String::from_str(Str::new("echo %"));
    script.push(name);
    script.push(Str::new("%"));
    mut c: Command = Command::new(Str::new("cmd"));
    c.arg(Str::new("/c")).arg(script.as_str());
    return c;
}
![target(unix)]
function set_variable_output(value: Str) -> String { return String::from_str(value); }
![target(windows)]
function set_variable_output(value: Str) -> String {
    mut text: String = String::from_str(value);
    text.push(Str::new("\r\n"));
    return text;
}
![target(unix)]
function unset_variable_output(name: Str) -> String { return String::new(); }
![target(windows)]
function unset_variable_output(name: Str) -> String {
    mut text: String = String::from_str(Str::new("%"));
    text.push(name);
    text.push(Str::new("%\r\n"));
    return text;
}

// A child that prints `ready`, then keeps running for about five seconds.
![target(unix)]
function cmd_print_then_wait() -> Command {
    mut c: Command = Command::new(Str::new("/bin/sh"));
    c.arg(Str::new("-c")).arg(Str::new("echo ready; sleep 5"));
    return c;
}
![target(windows)]
function cmd_print_then_wait() -> Command {
    mut c: Command = Command::new(Str::new("cmd"));
    c.arg(Str::new("/c")).arg(Str::new("echo ready& ping -n 6 127.0.0.1 >NUL"));
    return c;
}

// A child whose own child - the grandchild - writes `grandchild_marker()` to
// the shared stdout and then holds it for about five seconds. The marker
// comes from the grandchild, so once it is read the grandchild exists. The
// shell waits for it rather than replacing itself, since a command follows.
![target(unix)]
function cmd_grandchild_holds_stdout() -> Command {
    mut c: Command = Command::new(Str::new("/bin/sh"));
    c.arg(Str::new("-c")).arg(Str::new("/bin/sh -c 'echo ready; exec sleep 5'; echo done"));
    return c;
}
![target(windows)]
function cmd_grandchild_holds_stdout() -> Command {
    mut c: Command = Command::new(Str::new("cmd"));
    c.arg(Str::new("/c")).arg(Str::new("ping -n 6 127.0.0.1& echo done"));
    return c;
}
// ping's first line names the address in every display language.
![target(unix)]
function grandchild_marker() -> Str { return Str::new("ready"); }
![target(windows)]
function grandchild_marker() -> Str { return Str::new("127.0.0.1"); }

// env() overrides reach the child. On Windows this exercises the
// CreateProcessA environment-block builder (the parent process does not have
// CRYO_TEST_VAR, so the child can only see it via the constructed block); on
// unix it exercises the existing per-var apply_env path.
![test]
function env_override_passed_to_child() -> Result<(), TestError> {
    mut cmd: Command = cmd_print_variable(Str::new("CRYO_TEST_VAR"));
    cmd.env(Str::new("CRYO_TEST_VAR"), Str::new("cryo_env_works"));
    mut success: boolean = false;
    mut content_ok: boolean = false;
    match (cmd.output()) {
        Result::Ok(out) => {
            mut o: Output = out;
            success = o.status().success();
            content_ok = o.stdout().equals(set_variable_output(Str::new("cryo_env_works")).as_bytes());
        }
        Result::Err(_) => { return bail(Str::new("output() of env command failed")); }
    }
    match (expect(success, Str::new("print-var command should succeed"))) {
        Result::Ok(_) => { } Result::Err(e) => { return Result::Err(e); }
    }
    return expect(content_ok, Str::new("child should see the overridden env var"));
}

// stdout=Null is honoured (it does not silently inherit the parent's
// handle on Windows). `output()` forces Piped, so verify via status(): the
// child must spawn with the NUL handle and exit cleanly.
![test]
function stdout_null_spawns_and_succeeds() -> Result<(), TestError> {
    mut cmd: Command = cmd_echo();
    cmd.arg(Str::new("hidden"));
    cmd.stdout(Stdio::Null);
    cmd.stderr(Stdio::Null);
    mut success: boolean = false;
    match (cmd.status()) {
        Result::Ok(st) => { success = st.success(); }
        Result::Err(_) => { return bail(Str::new("status() with stdout=Null failed")); }
    }
    return expect(success, Str::new("echo with stdout/stderr=Null should exit 0"));
}

// `Stdio::Fd` redirects a child stream to a caller-supplied fd.  On
// Windows the fd's underlying HANDLE is recovered (`_get_osfhandle`) and
// duplicated inheritable for the child; `Stdio::Fd` transfers ownership, so
// the spawn closes our fd and we take it out of the File with
// `into_descriptor` before dropping it, to avoid the documented double-close.  Verified end-to-end: the child's
// stdout must land in the file.
![test]
function stdout_fd_redirects_to_file() -> Result<(), TestError> {
    const p: Path = Path::from(Str::new("cryo_fd_redirect.tmp"));

    mut raw: i32 = -1;
    match (File::create(p)) {
        Result::Ok(handle) => {
            mut f: File = handle;
            raw = f.into_descriptor();  // ownership goes to the spawn; drop is now a no-op
        }
        Result::Err(_) => { return bail(Str::new("File::create failed")); }
    }

    mut cmd: Command = cmd_echo();
    cmd.arg(Str::new("fdhello"));
    cmd.stdout(Stdio::Fd(raw));
    mut success: boolean = false;
    match (cmd.status()) {
        Result::Ok(st) => { success = st.success(); }
        Result::Err(_) => {
            mem::drop(cmd);  // closes the redirect target before it is removed
            match (File::remove(p)) { Result::Ok(_) => { } Result::Err(_) => { } }
            return bail(Str::new("status() with stdout=Fd failed"));
        }
    }
    mem::drop(cmd);  // closes the redirect target before it is read back

    // Read the redirect target back: the child's stdout must be in it.
    mut readbuf: [u8; 64];
    mut got: i64 = 0;
    match (File::open(p)) {
        Result::Ok(handle) => {
            mut f: File = handle;
            match (f.read_all(&readbuf[0], 64)) {
                Result::Ok(n)  => { got = n; }
                Result::Err(_) => {
                    mem::drop(f);  // closed before the file is removed
                    match (File::remove(p)) { Result::Ok(_) => { } Result::Err(_) => { } }
                    return bail(Str::new("read-back of redirect target failed"));
                }
            }
        }
        Result::Err(_) => {
            match (File::remove(p)) { Result::Ok(_) => { } Result::Err(_) => { } }
            return bail(Str::new("File::open of redirect target failed"));
        }
    }
    match (File::remove(p)) { Result::Ok(_) => { } Result::Err(_) => { } }

    match (expect(success, Str::new("echo with stdout=Fd should exit 0"))) {
        Result::Ok(_) => { } Result::Err(e) => { return Result::Err(e); }
    }
    // "fdhello" is 7 bytes; echo adds a newline (LF or CRLF). Confirm the
    // word itself reached the file rather than just any byte count.
    const want: &Slice<u8> = Str::new("fdhello").as_bytes();
    mut content_ok: boolean = (got >= 7);
    mut i: i64 = 0;
    while (content_ok && i < 7) {
        match (want.get(i)) {
            Option::Some(wv) => { if (readbuf[i] != wv) { content_ok = false; } }
            Option::None     => { content_ok = false; }
        }
        i = i + 1;
    }
    return expect(content_ok, Str::new("redirected stdout must reach the file"));
}

// The Windows `collect_output` drain interleaves stdout/stderr via
// PeekNamedPipe, so a child that floods one pipe before touching the other
// cannot deadlock us.  The Unix twin uses `/bin/sh` (absent on Windows); this
// one drives PowerShell to push ~100 KiB onto stderr (well past the 64-KiB
// pipe buffer) *before* writing stdout, which would wedge a serial drain.
![target(windows)]
![test]
function output_large_stderr_no_deadlock_win() -> Result<(), TestError> {
    mut cmd: Command = Command::new(Str::new("powershell"));
    cmd.arg(Str::new("-NoProfile"));
    cmd.arg(Str::new("-Command"));
    cmd.arg(Str::new("$s = 'y' * 100000; [Console]::Error.Write($s); [Console]::Out.Write('done')"));
    mut deadlocked: boolean = true;
    mut got_stdout: boolean = false;
    mut got_stderr: boolean = false;
    match (cmd.output()) {
        Result::Ok(out) => {
            mut o: Output = out;
            deadlocked = false;
            got_stdout = o.stdout().length() >= 4;        // "done"
            got_stderr = o.stderr().length() >= 100000;
        }
        Result::Err(_) => {
            // PowerShell missing on this host - skip rather than fail.
            return Result::Ok(());
        }
    }
    match (expect(!deadlocked, Str::new("output() must return; interleaved drain must not deadlock"))) {
        Result::Ok(_) => { } Result::Err(e) => { return Result::Err(e); }
    }
    match (expect(got_stderr, Str::new("stderr must capture ~100 KiB"))) {
        Result::Ok(_) => { } Result::Err(e) => { return Result::Err(e); }
    }
    return expect(got_stdout, Str::new("stdout 'done' terminator must be captured"));
}

// A child that keeps running for about five seconds, writing nothing.
![target(unix)]
function cmd_sleep() -> Command {
    mut c: Command = Command::new(Str::new("/bin/sleep"));
    c.arg(Str::new("5"));
    return c;
}
![target(windows)]
function cmd_sleep() -> Command {
    mut c: Command = Command::new(Str::new("ping"));
    c.arg(Str::new("-n")); c.arg(Str::new("6")); c.arg(Str::new("127.0.0.1"));
    c.stdout(Stdio::Null);
    return c;
}

// A child that writes "out" to stdout and then "err" to stderr.
![target(unix)]
function cmd_both_streams() -> Command {
    mut c: Command = Command::new(Str::new("/bin/sh"));
    c.arg(Str::new("-c")); c.arg(Str::new("echo out; echo err 1>&2"));
    return c;
}
![target(windows)]
function cmd_both_streams() -> Command {
    mut c: Command = Command::new(Str::new("cmd"));
    c.arg(Str::new("/c")); c.arg(Str::new("echo out& echo err 1>&2"));
    return c;
}

![test]
function wait_timeout_leaves_a_running_child_running() -> Result<(), TestError> {
    mut cmd: Command = cmd_sleep();
    match (cmd.spawn()) {
        Result::Ok(handle) => {
            mut c: Child = handle;
            mut still_running: boolean = false;
            match (c.wait_timeout(Duration::from_millis(100))) {
                Result::Ok(finished) => { still_running = finished.is_none(); }
                Result::Err(_) => { return bail(Str::new("wait_timeout failed")); }
            }
            mem::drop(c.kill());
            mem::drop(c.wait());
            return expect(still_running, Str::new("a sleeping child must still be running after 100 ms"));
        }
        Result::Err(_) => { return bail(Str::new("spawn of the sleeping child failed")); }
    }
}

/// Windows has no user signals: sending one is refused, and the child is
/// left running rather than terminated.
![test]
![target(windows)]
function send_signal_other_than_kill_is_unsupported_on_windows() -> Result<(), TestError> {
    mut cmd: Command = cmd_sleep();
    match (cmd.spawn()) {
        Result::Ok(handle) => {
            mut c: Child = handle;
            mut refused: boolean = false;
            match (c.send_signal(Signal::user1())) {
                Result::Ok(_)  => { }
                Result::Err(e) => { refused = e.kind == IoErrorKind::Unsupported; }
            }
            mut still_running: boolean = false;
            match (c.wait_timeout(Duration::from_millis(100))) {
                Result::Ok(finished) => { still_running = finished.is_none(); }
                Result::Err(_) => { }
            }
            mem::drop(c.kill());
            mem::drop(c.wait());
            expect(refused, Str::new("send_signal(user1) must be Unsupported on Windows"))?;
            return expect(still_running, Str::new("the child must still be running after send_signal(user1)"));
        }
        Result::Err(_) => { return bail(Str::new("spawn of the sleeping child failed")); }
    }
}

![test]
function wait_timeout_reports_an_exited_child() -> Result<(), TestError> {
    mut cmd: Command = cmd_true();
    match (cmd.spawn()) {
        Result::Ok(handle) => {
            mut c: Child = handle;
            match (c.wait_timeout(Duration::from_secs(30))) {
                Result::Ok(finished) => {
                    match (finished) {
                        Option::Some(status) => {
                            return expect(status.success(), Str::new("true must exit 0"));
                        }
                        Option::None => { return bail(Str::new("true still running after 30 s")); }
                    }
                }
                Result::Err(_) => { return bail(Str::new("wait_timeout failed")); }
            }
        }
        Result::Err(_) => { return bail(Str::new("spawn of true failed")); }
    }
}

![test]
function stderr_same_as_stdout_lands_in_the_stdout_pipe() -> Result<(), TestError> {
    mut cmd: Command = cmd_both_streams();
    cmd.stdout(Stdio::Piped);
    cmd.stderr(Stdio::SameAsStdout);
    mut bytes: Array<u8> = Array::new();
    match (cmd.spawn()) {
        Result::Ok(handle) => {
            mut c: Child = handle;
            expect(c.stderr.is_none(), Str::new("a merged stderr has no pipe of its own"))?;
            mem::drop(c.stdout.unwrap_ptr().read_to_end(&bytes));
            mem::drop(c.wait());
        }
        Result::Err(_) => { return bail(Str::new("spawn of the two-stream child failed")); }
    }
    const text: Str = Str::from_raw(bytes.as_ptr(), bytes.length());
    expect(text.contains(&Str::new("out")), Str::new("stdout's line must be captured"))?;
    return expect(text.contains(&Str::new("err")), Str::new("stderr's line must be captured with it"));
}

![test]
function same_as_stdout_is_refused_for_stdout() -> Result<(), TestError> {
    mut cmd: Command = cmd_true();
    cmd.stdout(Stdio::SameAsStdout);
    match (cmd.spawn()) {
        Result::Ok(handle) => {
            mut c: Child = handle;
            mem::drop(c.wait());
            return bail(Str::new("stdout cannot be the same as itself"));
        }
        Result::Err(e) => {
            return expect(e.kind == IoErrorKind::InvalidInput, Str::new("refused with InvalidInput"));
        }
    }
}
