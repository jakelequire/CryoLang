///! ffi::libc - a C `long` result read at the target's width.  On Windows
///! `long` is 32 bits: a binding that read it as 64 took the zero-extended
///! register, so a negative result came back as a large positive one.

![config(testing)]
namespace CryoTests::Tests::Stdlib::FfiLibcLong;

import std::core::result::{ Result };
import std::ffi::libc;
import std::test::error::{ TestError };
import std::test::assert::{ expect_eq };

![test]
function c_long_negative_result_of_lround() -> Result<(), TestError> {
    const rounded: i64 = libc::lround(-2.6);
    return expect_eq(rounded, -3);
}

![test]
function c_long_negative_result_of_lrint() -> Result<(), TestError> {
    const rounded: i64 = libc::lrint(-7.0);
    return expect_eq(rounded, -7);
}

![test]
function c_long_argument_and_result_of_labs() -> Result<(), TestError> {
    const absolute: i64 = libc::labs(-12);
    return expect_eq(absolute, 12);
}
