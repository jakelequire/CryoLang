///! Allocator reallocate must preserve over-alignment on grow.  `realloc`
///! only guarantees 16-byte alignment, so a type with alignment > 16 that
///! grows at the SAME alignment must go through allocate/copy/free, not plain
///! realloc.  Regression for the audit finding "allocator under-aligns
///! over-aligned types on realloc-grow" (the guard checked `new > old`
///! alignment and so missed the same-over-alignment grow).
///!
///! Growing an `Array<![align(32)]>` past capacity exercises the realloc
///! path repeatedly; we assert the buffer stays 32-aligned and the data
///! survives the moves intact.

![config(testing)]
namespace CryoTests::Tests::Stdlib::AllocReallocAlign;

import std::core::option;
import std::core::result;
import std::collections::array;
import std::test::error;
import std::test::assert;

![align(32)]
type struct Aligned32 {
    x: i64;
}

![test]
function over_aligned_array_grows_aligned_and_intact() -> Result<(), TestError> {
    mut arr: Array<Aligned32> = Array<Aligned32>::new();
    mut i: i64 = 0;
    // Enough pushes to force several capacity doublings (realloc-grows).
    while (i < 40) {
        arr.push(Aligned32 { x: i });
        i = i + 1;
    }

    // Buffer must remain 32-aligned after the grows.
    const addr: u64 = arr.as_ptr() as u64;
    match (expect_eq((addr % 32) as i64, 0)) {
        Result::Ok(_)  => { }
        Result::Err(e) => { return Result::Err(e); }
    }

    // Data must survive the realloc moves: sum(0..39) = 780.
    mut sum: i64 = 0;
    mut k: u64 = 0;
    while (k < arr.length()) {
        match (arr.get(k)) {
            Option::Some(v) => { sum = sum + v.x; }
            Option::None    => { }
        }
        k = k + 1;
    }
    return expect_eq(sum, 780);
}
