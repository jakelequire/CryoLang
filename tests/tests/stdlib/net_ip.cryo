///! Ip / SocketAddr - IPv4 parse/format, rejection cases, v6 limits.

![config(testing)]
namespace CryoTests::Tests::Stdlib::NetIp;

import std::core::result::{ Result };
import std::core::option::{ Option };
import std::collections::str::{ Str };
import std::net::addr::ip::{ IpAddr, IpV4Addr, IpV6Addr };
import std::net::addr::socket_addr::{ SocketAddr };
import std::net::addr::sockaddr;
import std::core::slice::{ Slice };
import std::io::error::{ IoErrorKind };
import std::test::error::{ TestError };
import std::test::assert::{ bail, expect, expect_eq, expect_false };

![test]
function parse_localhost_octets() -> Result<(), TestError> {
    match (IpV4Addr::parse_opt(Str::new("127.0.0.1"))) {
        Option::Some(v4) => {
            match (expect_eq(v4.octet(0), 127)) { Result::Ok(_) => { } Result::Err(e) => { return Result::Err(e); } }
            match (expect_eq(v4.octet(1), 0))   { Result::Ok(_) => { } Result::Err(e) => { return Result::Err(e); } }
            match (expect_eq(v4.octet(2), 0))   { Result::Ok(_) => { } Result::Err(e) => { return Result::Err(e); } }
            match (expect_eq(v4.octet(3), 1))   { Result::Ok(_) => { } Result::Err(e) => { return Result::Err(e); } }
            return expect(v4.is_loopback(), Str::new("127.0.0.1 should be loopback"));
        }
        Option::None => { return bail(Str::new("127.0.0.1 should parse")); }
    }
}

![test]
function parse_unspecified() -> Result<(), TestError> {
    match (IpV4Addr::parse_opt(Str::new("0.0.0.0"))) {
        Option::Some(v4) => {
            return expect(v4.is_unspecified(), Str::new("0.0.0.0 should be unspecified"));
        }
        Option::None => { return bail(Str::new("0.0.0.0 should parse")); }
    }
}

![test]
function to_u32_is_big_endian() -> Result<(), TestError> {
    const v4: IpV4Addr = IpV4Addr::new(1, 2, 3, 4);
    const want: u32 = 16909060;            // 0x01020304
    return expect_eq(v4.to_u32(), want);
}

![test]
function parse_rejects_out_of_range_octet() -> Result<(), TestError> {
    const r: boolean = IpV4Addr::parse_opt(Str::new("256.0.0.1")).is_some();
    return expect_false(r, Str::new("256.0.0.1 has an out-of-range octet"));
}

![test]
function parse_rejects_too_few_parts() -> Result<(), TestError> {
    const r: boolean = IpV4Addr::parse_opt(Str::new("1.2.3")).is_some();
    return expect_false(r, Str::new("1.2.3 has too few octets"));
}

![test]
function parse_rejects_too_many_parts() -> Result<(), TestError> {
    const r: boolean = IpV4Addr::parse_opt(Str::new("1.2.3.4.5")).is_some();
    return expect_false(r, Str::new("1.2.3.4.5 has too many octets"));
}

![test]
function parse_rejects_trailing_dot() -> Result<(), TestError> {
    const r: boolean = IpV4Addr::parse_opt(Str::new("1.2.3.")).is_some();
    return expect_false(r, Str::new("1.2.3. has a trailing separator"));
}

![test]
function parse_rejects_empty() -> Result<(), TestError> {
    const r: boolean = IpV4Addr::parse_opt(Str::new("")).is_some();
    return expect_false(r, Str::new("empty string is not an address"));
}

![test]
function ipaddr_parse_v4_is_ipv4() -> Result<(), TestError> {
    match (IpAddr::parse_opt(Str::new("10.0.0.1"))) {
        Option::Some(addr) => {
            match (expect(addr.is_ipv4(), Str::new("10.0.0.1 should be v4"))) { Result::Ok(_) => { } Result::Err(e) => { return Result::Err(e); } }
            return expect_false(addr.is_ipv6(), Str::new("10.0.0.1 should not be v6"));
        }
        Option::None => { return bail(Str::new("10.0.0.1 should parse")); }
    }
}

![test]
function ipaddr_parse_rejects_garbage() -> Result<(), TestError> {
    const r: boolean = IpAddr::parse_opt(Str::new("not.an.ip.addr")).is_some();
    return expect_false(r, Str::new("garbage should not parse"));
}

// --- IPv6 parse (m2) ---------------------------------------------------

![test]
function ipv6_parse_loopback_compressed() -> Result<(), TestError> {
    match (IpV6Addr::parse_opt(Str::new("::1"))) {
        Option::Some(v6) => {
            match (expect(v6.is_loopback(), Str::new("::1 is loopback"))) {
                Result::Ok(_) => { } Result::Err(e) => { return Result::Err(e); }
            }
            return expect_eq(v6.group_at(7), 1u16);
        }
        Option::None => { return bail(Str::new("::1 should parse")); }
    }
}

![test]
function ipv6_parse_unspecified() -> Result<(), TestError> {
    match (IpV6Addr::parse_opt(Str::new("::"))) {
        Option::Some(v6) => { return expect(v6.is_unspecified(), Str::new(":: is unspecified")); }
        Option::None => { return bail(Str::new(":: should parse")); }
    }
}

![test]
function ipv6_parse_full_eight_groups() -> Result<(), TestError> {
    match (IpV6Addr::parse_opt(Str::new("2001:db8:0:0:0:0:0:1"))) {
        Option::Some(v6) => {
            match (expect_eq(v6.group_at(0), 0x2001u16)) { Result::Ok(_) => { } Result::Err(e) => { return Result::Err(e); } }
            match (expect_eq(v6.group_at(1), 0x0db8u16)) { Result::Ok(_) => { } Result::Err(e) => { return Result::Err(e); } }
            return expect_eq(v6.group_at(7), 1u16);
        }
        Option::None => { return bail(Str::new("full form should parse")); }
    }
}

![test]
function ipv6_parse_compressed_middle() -> Result<(), TestError> {
    match (IpV6Addr::parse_opt(Str::new("2001:db8::1"))) {
        Option::Some(v6) => {
            match (expect_eq(v6.group_at(0), 0x2001u16)) { Result::Ok(_) => { } Result::Err(e) => { return Result::Err(e); } }
            match (expect_eq(v6.group_at(1), 0x0db8u16)) { Result::Ok(_) => { } Result::Err(e) => { return Result::Err(e); } }
            match (expect_eq(v6.group_at(6), 0u16))      { Result::Ok(_) => { } Result::Err(e) => { return Result::Err(e); } }
            return expect_eq(v6.group_at(7), 1u16);
        }
        Option::None => { return bail(Str::new("compressed form should parse")); }
    }
}

![test]
function ipv6_parse_embedded_v4() -> Result<(), TestError> {
    match (IpV6Addr::parse_opt(Str::new("::ffff:127.0.0.1"))) {
        Option::Some(v6) => {
            match (expect_eq(v6.group_at(5), 0xffffu16)) { Result::Ok(_) => { } Result::Err(e) => { return Result::Err(e); } }
            match (expect_eq(v6.group_at(6), 0x7f00u16)) { Result::Ok(_) => { } Result::Err(e) => { return Result::Err(e); } }
            return expect_eq(v6.group_at(7), 0x0001u16);
        }
        Option::None => { return bail(Str::new("::ffff:v4 should parse")); }
    }
}

![test]
function ipv6_parse_rejects_double_compression() -> Result<(), TestError> {
    const r: boolean = IpV6Addr::parse_opt(Str::new("1::2::3")).is_some();
    return expect_false(r, Str::new("two '::' runs must be rejected"));
}

![test]
function ipv6_parse_rejects_too_many_groups() -> Result<(), TestError> {
    const r: boolean = IpV6Addr::parse_opt(Str::new("1:2:3:4:5:6:7:8:9")).is_some();
    return expect_false(r, Str::new("nine groups must be rejected"));
}

![test]
function ipaddr_parse_v6_is_ipv6() -> Result<(), TestError> {
    match (IpAddr::parse_opt(Str::new("::1"))) {
        Option::Some(addr) => { return expect(addr.is_ipv6(), Str::new("::1 routes to v6")); }
        Option::None => { return bail(Str::new("::1 should parse via IpAddr")); }
    }
}

![test]
function socket_addr_parse_v4() -> Result<(), TestError> {
    match (SocketAddr::parse_v4(Str::new("127.0.0.1:8080"))) {
        Option::Some(sa) => {
            const want_port: u16 = 8080;
            match (expect_eq(sa.port, want_port)) { Result::Ok(_) => { } Result::Err(e) => { return Result::Err(e); } }
            return expect(sa.ip.is_ipv4(), Str::new("parsed socket addr should hold a v4 ip"));
        }
        Option::None => { return bail(Str::new("127.0.0.1:8080 should parse")); }
    }
}

![test]
function socket_addr_rejects_missing_port() -> Result<(), TestError> {
    const r: boolean = SocketAddr::parse_v4(Str::new("127.0.0.1")).is_some();
    return expect_false(r, Str::new("address without a port should not parse"));
}

![test]
function socket_addr_rejects_port_overflow() -> Result<(), TestError> {
    const r: boolean = SocketAddr::parse_v4(Str::new("127.0.0.1:99999")).is_some();
    return expect_false(r, Str::new("port above 65535 should not parse"));
}

/// `from_bytes` reads exactly sixteen network-order octets and refuses
/// any other length.
![test]
function v6_from_bytes_takes_exactly_sixteen() -> Result<(), TestError> {
    mut octets: [u8; 17];
    mut i: i64 = 0;
    while (i < 17) { octets[i] = 0; i = i + 1; }
    octets[0] = 0x20; octets[1] = 0x01; octets[2] = 0x0D; octets[3] = 0xB8; octets[15] = 1;
    const whole: &Slice<u8> = octets.as_slice();
    const address: IpV6Addr = IpV6Addr::from_bytes(whole.subslice(0, 16)).unwrap();
    expect_eq(f"{address}".as_str(), Str::new("2001:db8::1"))?;
    expect(IpV6Addr::from_bytes(whole.subslice(0, 15)).is_none(), Str::new("fifteen octets are refused"))?;
    return expect(IpV6Addr::from_bytes(whole).is_none(), Str::new("seventeen octets are refused"));
}

/// A packed address unpacks to itself, for each family.
![test]
function sockaddr_round_trips_both_families() -> Result<(), TestError> {
    mut buffer: [u8; 28];
    const v4: SocketAddr = SocketAddr::parse_v4(Str::new("192.0.2.7:8080")).unwrap();
    expect_eq(sockaddr::pack_sockaddr_in(&buffer, &v4).unwrap(), 16)?;
    expect_eq(f"{sockaddr::unpack_sockaddr(&buffer)}".as_str(), Str::new("192.0.2.7:8080"))?;
    expect_eq(f"{sockaddr::unpack_sockaddr_in(&buffer)}".as_str(), Str::new("192.0.2.7:8080"))?;
    const v6: SocketAddr = SocketAddr::new(IpAddr::parse(Str::new("2001:db8::1")).unwrap(), 443);
    expect_eq(sockaddr::pack_sockaddr_in(&buffer, &v6).unwrap(), 28)?;
    return expect_eq(f"{sockaddr::unpack_sockaddr(&buffer)}".as_str(), Str::new("[2001:db8::1]:443"));
}

/// Packing refuses a buffer too short for the address's layout instead of
/// writing past it, and leaves the buffer untouched.
![test]
function sockaddr_pack_refuses_a_short_buffer() -> Result<(), TestError> {
    mut buffer: [u8; 20];
    mut i: i64 = 0;
    while (i < 20) { buffer[i] = 0xEE; i = i + 1; }
    const v6: SocketAddr = SocketAddr::new(IpAddr::parse(Str::new("::1")).unwrap(), 80);
    match (sockaddr::pack_sockaddr_in(&buffer, &v6)) {
        Result::Ok(_) => { return bail(Str::new("a 20-byte buffer cannot hold a sockaddr_in6")); }
        Result::Err(e) => { expect(e.kind == IoErrorKind::InvalidInput, Str::new("refused with InvalidInput"))?; }
    }
    mut untouched: boolean = true;
    i = 0;
    while (i < 20) { if (buffer[i] != 0xEE) { untouched = false; } i = i + 1; }
    return expect(untouched, Str::new("nothing is written"));
}
