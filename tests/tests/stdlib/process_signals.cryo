///! `Signals`: receiving the interrupt and terminate signals in-process.
///! Each test is its own process, so a signal raised here reaches no other
///! test. Delivery from another process is tested through a child.

![config(testing)]
namespace CryoTests::Tests::Stdlib::ProcessSignals;

import std::core::result::{ Result };
import std::core::option::{ Option };
import std::core::mem;
import std::collections::array::{ Array };
import std::collections::str::{ Str };
import std::collections::string::{ String };
import std::io::traits;
import std::io::stdio::{ stdout, Stdout };
import std::process::command::{ Command, Stdio };
import std::process::child::{ Child, ChildStdout, ExitStatus };
import std::test::test_child::{ TestChild };
import std::process::signal::{ Signal };
import std::process::signal_handling::{ Signals };
import std::time::duration::{ Duration };
import std::time::clock::{ Instant };
import std::ffi::libc;
import std::thread;
import std::thread::{ JoinHandle };
import std::test::error::{ TestError };
import std::test::assert::{ bail, expect, expect_eq };

/// With nothing arrived, `try_wait` answers at once and `wait_timeout`
/// waits its whole duration.
![test]
function nothing_arrived_is_none() -> Result<(), TestError> {
    const signals: Signals = Signals::listen().unwrap();
    expect(signals.try_wait().is_none(), Str::new("try_wait has nothing to hand over"))?;
    const started: Instant = Instant::now();
    const waited: Option<Signal> = signals.wait_timeout(Duration::from_millis(200));
    const elapsed: u64 = started.elapsed().as_millis();
    expect(waited.is_none(), Str::new("wait_timeout gives up with None"))?;
    return expect(elapsed >= 190, Str::new("wait_timeout waits its whole duration"));
}

/// Each signal raised is handed over once, of its own kind, interrupts
/// first, and none is invented.
![target(unix)]
![test]
function raised_signals_are_handed_over_once_each() -> Result<(), TestError> {
    const signals: Signals = Signals::listen().unwrap();
    libc::raise(libc::SIGTERM);
    libc::raise(libc::SIGINT);
    libc::raise(libc::SIGINT);
    const interrupt: i32 = Signal::interrupt().as_i32();
    const terminate: i32 = Signal::terminate().as_i32();
    expect_eq(signals.wait().as_i32(), interrupt)?;
    expect_eq(signals.wait_timeout(Duration::from_millis(1000)).unwrap().as_i32(), interrupt)?;
    expect_eq(signals.try_wait().unwrap().as_i32(), terminate)?;
    return expect(signals.try_wait().is_none(), Str::new("three signals raised, three handed over"));
}

/// A signal handled on another thread wakes a thread blocked in `wait`.
/// `raise` delivers it to the raising thread, so the waiting thread's own
/// wait is never cut short by the signal itself: only the handler's wake
/// can end it.
![target(unix)]
![test]
function a_signal_on_another_thread_wakes_a_blocked_wait() -> Result<(), TestError> {
    const signals: Signals = Signals::listen().unwrap();
    mut raiser: JoinHandle<i32> = thread::spawn(() -> i32 {
        thread::sleep(Duration::from_millis(200));
        return libc::raise(libc::SIGTERM);
    });
    const started: Instant = Instant::now();
    const received: Option<Signal> = signals.wait_timeout(Duration::from_millis(5000));
    const elapsed: u64 = started.elapsed().as_millis();
    expect_eq(raiser.join(), 0)?;
    expect_eq(received.unwrap().as_i32(), Signal::terminate().as_i32())?;
    return expect(elapsed < 4000, Str::new("the wait ends when the signal arrives"));
}

/// The child the delivery tests listen through: it listens, says it is
/// ready, and writes the one signal it receives.
![test_child]
function listens_and_reports_one_signal() -> Result<(), TestError> {
    const signals: Signals = Signals::listen()?;
    mut out: Stdout = stdout();
    out.write(Str::new("ready\n").as_bytes())?;
    out.flush()?;
    match (signals.wait_timeout(Duration::from_millis(10000))) {
        Option::Some(received) => {
            mut line: String = String::new();
            line.push(received.as_i32());
            line.push_char('\n');
            out.write(line.as_str().as_bytes())?;
            out.flush()?;
            return Result::Ok(());
        }
        Option::None => { return bail(Str::new("no signal arrived")); }
    }
}

/// A child that listened and stopped: the interrupt's default action is
/// back, so the interrupt ends it before its sleep is over.
![test_child]
function listens_then_stops_listening() -> Result<(), TestError> {
    const signals: Signals = Signals::listen()?;
    mem::drop(signals);
    mut out: Stdout = stdout();
    out.write(Str::new("ready\n").as_bytes())?;
    out.flush()?;
    thread::sleep(Duration::from_millis(10000));
    return bail(Str::new("the signal did not end the child"));
}

// Starts `role` as a grouped child with its output piped, and returns once
// it has said it is ready: a signal sent earlier could land before its
// handler is in place, or while a Windows child is still loading.
function start_ready_child(role: Str, output: mut &Option<ChildStdout>) -> Result<Child, TestError> {
    mut name: String = String::from_str(Str::new("CryoTests::Tests::Stdlib::ProcessSignals::"));
    name.push(role);
    mut command: Command = TestChild::command(name.as_str())?;
    command.stdout(Stdio::Piped).group_descendants();
    mut child: Child = command.spawn()?;
    mut pipe: ChildStdout = child.stdout.take().unwrap();
    mut line: Array<u8> = Array::new();
    pipe.read_until('\n' as u8, &line)?;
    expect(Str::from_raw(line.as_ptr(), line.length()).equals(&Str::new("ready\n")),
           Str::new("the child says it is ready"))?;
    *output = Option::Some(pipe);
    return Result::Ok(child);
}

// Waits up to five seconds for `child` to end, ending its tree if it does
// not.
function ending_within_five_seconds(child: mut &Child) -> Result<Option<ExitStatus>, TestError> {
    const status: Option<ExitStatus> = child.wait_timeout(Duration::from_millis(5000))?;
    if (status.is_none()) {
        child.kill_tree()?;
        child.wait()?;
    }
    return Result::Ok(status);
}

// Sends `sent` to a listening child and checks that it received exactly that
// signal and ended normally.
function round_trip(sent: Signal) -> Result<(), TestError> {
    mut output: Option<ChildStdout> = Option::None;
    mut child: Child = start_ready_child(Str::new("listens_and_reports_one_signal"), &output)?;
    child.send_signal(sent)?;
    const status: Option<ExitStatus> = ending_within_five_seconds(&child)?;
    mut rest: Array<u8> = Array::new();
    output.unwrap().read_to_end(&rest)?;
    mut expected: String = String::new();
    expected.push(sent.as_i32());
    expected.push_char('\n');
    expect(status.is_some(), Str::new("the child ends after the signal"))?;
    expect_eq(status.unwrap().exit_code(), Option::Some(0))?;
    return expect(Str::from_raw(rest.as_ptr(), rest.length()).equals(&expected.as_str()),
                  Str::new("the child received the signal that was sent"));
}

/// An interrupt sent from another process reaches a listening child.
![test]
function an_interrupt_from_another_process_is_received() -> Result<(), TestError> {
    return round_trip(Signal::interrupt());
}

/// A terminate sent from another process reaches a listening child.
/// Windows has no terminate a process can send to another.
![target(unix)]
![test]
function a_terminate_from_another_process_is_received() -> Result<(), TestError> {
    return round_trip(Signal::terminate());
}

/// Once the last listener is dropped, the interrupt's default action ends
/// the process again.
![test]
function dropping_the_last_listener_restores_the_default() -> Result<(), TestError> {
    mut output: Option<ChildStdout> = Option::None;
    mut child: Child = start_ready_child(Str::new("listens_then_stops_listening"), &output)?;
    child.send_signal(Signal::interrupt())?;
    const status: Option<ExitStatus> = ending_within_five_seconds(&child)?;
    expect(status.is_some(), Str::new("the child ends at the interrupt"))?;
    return expect_eq(ending_of(status.unwrap()), interrupt_ending());
}

// What ended a child: the signal on POSIX, the exit code on Windows, 0 for
// none.
![target(unix)]
function ending_of(status: ExitStatus) -> i32 { return status.terminating_signal().unwrap_or(0); }
![target(windows)]
function ending_of(status: ExitStatus) -> i32 { return status.exit_code().unwrap_or(0); }

// How the interrupt's default action ends a process. The default console
// control handler ends it with STATUS_CONTROL_C_EXIT, for Ctrl-Break as for
// Ctrl-C.
![target(unix)]
function interrupt_ending() -> i32 { return Signal::interrupt().as_i32(); }
![target(windows)]
function interrupt_ending() -> i32 { return 0xC000013A as i32; }
