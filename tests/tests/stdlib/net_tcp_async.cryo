///! Async TCP - `TcpStream::connect`, `listener.accept()`, `read_some` and
///! `write_all` over loopback, driven by a real `Executor` (worker pool +
///! reactor).
///!
///! Every test binds an EPHEMERAL port (`:0`) and reads the kernel-assigned port
///! back via `local_address()`, so concurrent runs never collide.
///!
///! The round trip proves the bytes move both ways. The timeout test proves the
///! cancellation path: a read dropped by `Futures::timeout` before anything
///! arrives releases its reactor registration, closes its socket and frees its
///! buffer, so a cancelled operation leaves nothing behind.

![config(testing)]
namespace CryoTests::Tests::Stdlib::NetTcpAsync;

import std::core::option::{ Option };
import std::core::result::{ Result };
import std::core::drop;
import std::collections::str::{ Str };
import std::future;
import std::io::error::{ IoError };
import std::net::address::socket_address::{ SocketAddress };
import std::net::socket::tcp::{ TcpListener, TcpStream };
import std::test::error::{ TestError };
import std::test::assert::{ bail, expect_equal };
import std::time;
import std::time::duration::{ Duration };
import std::future::combinator::{ Futures };
import std::future::executor::{ Executor };
import std::future::timer::{ Sleep };

// Every failure is a distinct negative number so a red test names its own step
// instead of just reporting "not 0".

/// Accept one connection, read what arrives, echo it straight back. Yields the
/// number of bytes echoed.
async function serve_echo(listener: TcpListener) -> i64 {
    mut server: TcpListener = listener;
    mut stream: TcpStream = match (await server.accept()) {
        Result::Ok(s)  => { s }
        Result::Err(_) => { return -1; }
    };
    const got: Array<u8> = match (await stream.read_some(64)) {
        Result::Ok(bytes) => { bytes }
        Result::Err(_)    => { return -2; }
    };
    const length: i64 = got.length();
    match (await stream.write_all(got)) {
        Result::Ok(_)  => { return length; }
        Result::Err(_) => { return -3; }
    }
}

/// Connect, send five bytes, read the echo back, and check both the length and
/// the content survived the round trip.
async function echo_client(port: u16) -> i64 {
    mut stream: TcpStream = match (await TcpStream::connect(SocketAddress::localhost_v4(port))) {
        Result::Ok(s)  => { s }
        Result::Err(_) => { return -10; }
    };

    mut out: Array<u8> = Array::<u8>::new();
    out.push(72); out.push(69); out.push(76); out.push(76); out.push(79);
    match (await stream.write_all(out)) {
        Result::Ok(_)  => { }
        Result::Err(_) => { return -13; }
    }

    // A read hands back only what arrived: 5 bytes, though 64 were allowed.
    const echoed: Array<u8> = match (await stream.read_some(64)) {
        Result::Ok(bytes) => { bytes }
        Result::Err(_)    => { return -16; }
    };
    const len: u64 = echoed.length() as u64;
    mut first: u8 = 0;
    match (echoed.get(0)) {
        Option::Some(v) => { first = v; }
        Option::None    => { }
    }
    if (len != 5)   { return -14; }
    if (first != 72) { return -15; }
    return 5;
}

async function echo_round_trip(port: u16, listener: TcpListener) -> i64 {
    const pair: (i64, i64) = await Futures::join(serve_echo(listener), echo_client(port));
    if (pair.0 != 5) { return pair.0; }
    if (pair.1 != 5) { return pair.1; }
    return 0;
}

/// Accept one connection and hold it open, sending nothing, so a peer's read has
/// genuinely nothing to complete on.
async function accept_and_hold(listener: TcpListener, hold_ms: u64) -> i64 {
    mut server: TcpListener = listener;
    const _held: TcpStream = match (await server.accept()) {
        Result::Ok(s)  => { s }
        Result::Err(_) => { return -20; }
    };
    await Sleep::new(Duration::from_milliseconds(hold_ms));
    return 1;
}

/// One read on a stream this future owns, so dropping the future drops the
/// read in flight and the stream with it.
async function read_owned(stream: TcpStream, limit: i64) -> Result<Array<u8>, IoError> {
    mut reading: TcpStream = stream;
    return await reading.read_some(limit);
}

/// Connect, then read with a deadline the peer will never meet. The timeout
/// drops the read in flight, which is the whole cancellation path: deregister
/// the waker, close the socket, free the buffer.
async function read_until_timeout(port: u16) -> i64 {
    const stream: TcpStream = match (await TcpStream::connect(SocketAddress::localhost_v4(port))) {
        Result::Ok(s)  => { s }
        Result::Err(_) => { return -30; }
    };
    match (await Futures::timeout(Duration::from_milliseconds(80), read_owned(stream, 32))) {
        // Bytes arrived from a peer that sends none - or the socket ended.
        Result::Ok(_)  => { return -31; }
        Result::Err(_) => { return 1; }
    }
}

async function timed_out_read(port: u16, listener: TcpListener) -> i64 {
    const pair: (i64, i64) = await Futures::join(accept_and_hold(listener, 400),
                                                 read_until_timeout(port));
    if (pair.0 != 1) { return pair.0; }
    if (pair.1 != 1) { return pair.1; }
    return 0;
}

![test]
function async_tcp_echo_round_trip() -> Result<(), TestError> {
    const listener: TcpListener = match (TcpListener::bind(SocketAddress::localhost_v4(0))) {
        Result::Ok(v)  => { v }
        Result::Err(_) => { return bail(Str::new("bind 127.0.0.1:0 failed")); }
    };
    const port: u16 = match (listener.local_address()) {
        Result::Ok(a)  => { a.port }
        Result::Err(_) => { return bail(Str::new("local_address failed")); }
    };

    mut ex: Executor = Executor::new();
    const r: i64 = ex.block_on(echo_round_trip(port, listener));
    return expect_equal(r, 0 as i64);
}

![test]
function async_tcp_read_timeout_cancels_cleanly() -> Result<(), TestError> {
    const listener: TcpListener = match (TcpListener::bind(SocketAddress::localhost_v4(0))) {
        Result::Ok(v)  => { v }
        Result::Err(_) => { return bail(Str::new("bind 127.0.0.1:0 failed")); }
    };
    const port: u16 = match (listener.local_address()) {
        Result::Ok(a)  => { a.port }
        Result::Err(_) => { return bail(Str::new("local_address failed")); }
    };

    mut ex: Executor = Executor::new();
    const r: i64 = ex.block_on(timed_out_read(port, listener));
    return expect_equal(r, 0 as i64);
}
