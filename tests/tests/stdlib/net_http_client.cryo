///! `net::http::client::Client` by URL: redirects, the redirect limit, the
///! timeout, and the URL arithmetic redirects are built on.
///!
///! The loopback tests run a server that accepts one connection per request -
///! the client opens a fresh one each time - and returns a log line per
///! request it saw: the method, the target, the body length and whether an
///! `Authorization` header came with it. A test asserts the whole log and the
///! final status as one string, so it pins what was SENT as well as what came
///! back: the method a redirect was followed with, whether its body went
///! along, and which headers survived it.

![config(testing)]
namespace CryoTests::Tests::Stdlib::NetHttpClient;

import std::core::option::{ Option };
import std::core::result::{ Result };
import std::collections::str::{ Str };
import std::collections::string::{ String };
import std::collections::array::{ Array };
import std::future;
import std::io::error::{ IoError, IoErrorKind };
import std::io::traits;
import std::io::buf::{ BufStream };
import std::net::addr::url::{ Url };
import std::net::addr::socket_addr::{ SocketAddr };
import std::net::socket::tcp::{ TcpAccept, TcpAccepted, TcpListener, TcpStream };
import std::net::http::method::{ Method };
import std::net::http::status::{ StatusCode };
import std::net::http::request::{ Request };
import std::net::http::response::{ Response };
import std::net::http::conn;
import std::net::http::client::{ Client };
import std::test::error::{ TestError };
import std::test::assert::{ bail, expect_eq };
import std::future::combinator::{ Futures };
import std::future::executor::{ Executor };
import std::time::duration::{ Duration };

function expect_text(got: Str, want: Str) -> Result<(), TestError> {
    if (!got.equals(&want)) {
        return bail(f"got `{got}`, wanted `{want}`".as_str());
    }
    return Result::Ok(());
}

// ============================================================================
// URL arithmetic.
// ============================================================================

function expect_join(base: Url, reference: string, want: string) -> Result<(), TestError> {
    return expect_text(base.join(Str::new(reference)).as_str(), Str::new(want));
}

![test]
function url_join_resolves_each_reference_form() -> Result<(), TestError> {
    const base: Url = Url::parse(Str::new("http://example.com:8080/a/b/c?x=1#f")).unwrap();
    expect_join(base, "https://other.org/p", "https://other.org/p")?;
    expect_join(base, "//other.org/p",       "http://other.org/p")?;
    expect_join(base, "/x/y?q",              "http://example.com:8080/x/y?q")?;
    expect_join(base, "?z",                  "http://example.com:8080/a/b/c?z")?;
    expect_join(base, "#g",                  "http://example.com:8080/a/b/c?x=1#g")?;
    expect_join(base, "",                    "http://example.com:8080/a/b/c?x=1")?;
    expect_join(base, "d",                   "http://example.com:8080/a/b/d")?;
    return expect_join(base, "d/?q#h",       "http://example.com:8080/a/b/d/?q#h");
}

![test]
function url_join_removes_dot_segments_without_climbing_above_the_root() -> Result<(), TestError> {
    const base: Url = Url::parse(Str::new("http://h/a/b/c")).unwrap();
    expect_join(base, "../d",          "http://h/a/d")?;
    expect_join(base, "./",            "http://h/a/b/")?;
    expect_join(base, "..",            "http://h/a/")?;
    expect_join(base, "../../../../e", "http://h/e")?;
    return expect_join(base, "/x/./y/../z", "http://h/x/z");
}

![test]
function url_authority_and_target() -> Result<(), TestError> {
    const plain: Url = Url::parse(Str::new("http://example.com/p?q=1#f")).unwrap();
    expect_text(plain.authority().as_str(), Str::new("example.com"))?;
    expect_text(plain.path_and_query().as_str(), Str::new("/p?q=1"))?;
    const ported: Url = Url::parse(Str::new("https://[::1]:8443/")).unwrap();
    expect_text(ported.authority().as_str(), Str::new("[::1]:8443"))?;
    const default_port: Url = Url::parse(Str::new("https://example.com:443")).unwrap();
    expect_text(default_port.authority().as_str(), Str::new("example.com"))?;
    return expect_text(default_port.path_and_query().as_str(), Str::new("/"));
}

// ============================================================================
// A loopback server that redirects.
// ============================================================================

/// The answer to a request for `path` on `port`: `.../redirect-<code>` redirects
/// with that status to `final?from=redirect`, relative to the request;
/// `/away` redirects to `/final` on `localhost` - another host by name;
/// `/loop` redirects to itself; anything else is 200.
function answer(path: Str, port: u16) -> Response {
    mut location: String = String::new();
    mut status: u16 = 302;
    if (path.equals(&Str::new("/loop"))) {
        location.push(Str::new("/loop"));
    } else if (path.equals(&Str::new("/away"))) {
        location.push(f"http://localhost:{port}/final".as_str());
    } else {
        match (path.rsplit_once(&Str::new("/redirect-"))) {
            Option::Some(parts) => {
                status = u16::try_from(parts.second).unwrap();
                location.push(Str::new("final?from=redirect"));
            }
            Option::None => { return Response::text(StatusCode::ok(), path); }
        }
    }
    mut redirect: Response = Response::new(StatusCode::from_u16(status));
    redirect.headers.insert(Str::new("Location"), location.as_str());
    return redirect;
}

/// Accept `connections` connections, one request on each, answering it and
/// logging it as `METHOD target body=N auth=yes|no`, a line each.
async function serve(listener: TcpListener, connections: i64, port: u16) -> String {
    mut log: String = String::new();
    mut current: TcpListener = listener;
    mut served: i64 = 0;
    while (served < connections) {
        mut accepted: TcpAccepted = await TcpAccept::start(current);
        current = accepted.take_listener();
        const stream: TcpStream = match (accepted.take_result()) {
            Result::Ok(s)  => { s }
            Result::Err(_) => { log.push(Str::new("accept failed\n")); return log; }
        };
        mut buffered: BufStream<TcpStream> = BufStream::<TcpStream>::of(stream);
        const request: Request = match (await buffered.read_request()) {
            Result::Ok(r)  => { r }
            Result::Err(_) => { log.push(Str::new("read failed\n")); return log; }
        };
        const authorized: Str = if (request.headers.contains(Str::new("Authorization"))) {
            Str::new("yes")
        } else {
            Str::new("no")
        };
        log.push(f"{request.method} {request.path} body={request.body.length()} auth={authorized}\n".as_str());
        const response: Response = answer(request.path.as_str(), port);
        match (response.encode_into(buffered.pending())) {
            Result::Ok(_)  => { }
            Result::Err(_) => { log.push(Str::new("encode failed\n")); return log; }
        }
        match (await buffered.flush()) {
            Result::Ok(_)  => { }
            Result::Err(_) => { log.push(Str::new("flush failed\n")); return log; }
        }
        served = served + 1;
    }
    return log;
}

/// Send `method` to `path` on the loopback server with an `Authorization`
/// header, and a three-byte body when it is a `POST`. The final status, or
/// the error's description.
async function request(client: Client, port: u16, method: Method, path: Str) -> String {
    const text: String = f"http://127.0.0.1:{port}{path}";
    mut outgoing: Request = Request::new(method, path);
    outgoing.headers.insert(Str::new("Authorization"), Str::new("Bearer t"));
    if (method == Method::Post) {
        mut body: Array<u8> = Array::new();
        body.push(0x61); body.push(0x62); body.push(0x63);
        outgoing.set_body(body);
    }
    match (await client.send(Url::parse(text.as_str()).unwrap(), outgoing)) {
        Result::Ok(response) => { return f"status {response.status.as_u16()}"; }
        Result::Err(error)   => { return f"error {error.describe()}"; }
    }
}

async function round_trip(listener: TcpListener, connections: i64, client: Client, port: u16,
                          method: Method, path: Str) -> String {
    const pair: (String, String) = await Futures::join(serve(listener, connections, port),
                                                       request(client, port, method, path));
    return f"{pair.0}{pair.1}";
}

/// Run one client request against the redirecting server on an ephemeral
/// loopback port, the server expecting `connections` connections, and
/// compare the server's log plus the final status with `want`.
function expect_exchange(client: Client, connections: i64, method: Method, path: string,
                         want: string) -> Result<(), TestError> {
    mut listener: TcpListener = match (TcpListener::bind(SocketAddr::localhost_v4(0))) {
        Result::Ok(v)  => { v }
        Result::Err(_) => { return bail(Str::new("bind 127.0.0.1:0 failed")); }
    };
    listener.set_nonblocking(true)?;
    const port: u16 = match (listener.local_addr()) {
        Result::Ok(a)  => { a.port }
        Result::Err(_) => { return bail(Str::new("local_addr failed")); }
    };
    mut ex: Executor = Executor::new();
    const got: String = ex.block_on(round_trip(listener, connections, client, port, method, Str::new(path)));
    return expect_text(got.as_str(), Str::new(want));
}

function client() -> Client {
    return Client::new().expect("TLS context");
}

![test]
function client_follows_a_relative_redirect_to_its_target() -> Result<(), TestError> {
    return expect_exchange(client(), 2, Method::Get, "/a/redirect-302",
        "GET /a/redirect-302 body=0 auth=yes\nGET /a/final?from=redirect body=0 auth=yes\nstatus 200");
}

![test]
function client_follows_303_after_a_post_with_a_bodyless_get() -> Result<(), TestError> {
    return expect_exchange(client(), 2, Method::Post, "/redirect-303",
        "POST /redirect-303 body=3 auth=yes\nGET /final?from=redirect body=0 auth=yes\nstatus 200");
}

![test]
function client_repeats_the_request_on_a_307() -> Result<(), TestError> {
    return expect_exchange(client(), 2, Method::Post, "/redirect-307",
        "POST /redirect-307 body=3 auth=yes\nPOST /final?from=redirect body=3 auth=yes\nstatus 200");
}

![test]
function client_drops_credentials_on_a_redirect_to_another_host() -> Result<(), TestError> {
    return expect_exchange(client(), 2, Method::Get, "/away",
        "GET /away body=0 auth=yes\nGET /final body=0 auth=no\nstatus 200");
}

![test]
function client_stops_at_the_redirect_limit_with_the_last_redirect() -> Result<(), TestError> {
    return expect_exchange(client().with_redirect_limit(2), 3, Method::Get, "/loop",
        "GET /loop body=0 auth=yes\nGET /loop body=0 auth=yes\nGET /loop body=0 auth=yes\nstatus 302");
}

![test]
function client_follows_twenty_redirects_by_default() -> Result<(), TestError> {
    return expect_exchange(client(), 21, Method::Get, "/loop",
        "GET /loop body=0 auth=yes\nGET /loop body=0 auth=yes\nGET /loop body=0 auth=yes\nGET /loop body=0 auth=yes\nGET /loop body=0 auth=yes\nGET /loop body=0 auth=yes\nGET /loop body=0 auth=yes\nGET /loop body=0 auth=yes\nGET /loop body=0 auth=yes\nGET /loop body=0 auth=yes\nGET /loop body=0 auth=yes\nGET /loop body=0 auth=yes\nGET /loop body=0 auth=yes\nGET /loop body=0 auth=yes\nGET /loop body=0 auth=yes\nGET /loop body=0 auth=yes\nGET /loop body=0 auth=yes\nGET /loop body=0 auth=yes\nGET /loop body=0 auth=yes\nGET /loop body=0 auth=yes\nGET /loop body=0 auth=yes\nstatus 302");
}

![test]
function client_with_no_redirects_returns_the_redirect() -> Result<(), TestError> {
    return expect_exchange(client().with_redirect_limit(0), 1, Method::Get, "/redirect-308",
        "GET /redirect-308 body=0 auth=yes\nstatus 308");
}

// ============================================================================
// The timeout, and what the client refuses.
// ============================================================================

/// Accept one connection, read its request and never answer; then wait for
/// the end of the connection, which only the client's timeout produces.
/// Returns 1 once the client has gone.
async function never_answer(listener: TcpListener) -> i64 {
    mut accepted: TcpAccepted = await TcpAccept::start(listener);
    mut _listener: TcpListener = accepted.take_listener();
    const stream: TcpStream = match (accepted.take_result()) {
        Result::Ok(s)  => { s }
        Result::Err(_) => { return -1; }
    };
    mut buffered: BufStream<TcpStream> = BufStream::<TcpStream>::of(stream);
    match (await buffered.read_request()) {
        Result::Ok(_)  => { }
        Result::Err(_) => { return -2; }
    }
    match (await buffered.read_request()) {
        Result::Ok(_)  => { return -3; }
        Result::Err(_) => { return 1; }
    }
}

/// 1 when the request failed with `TimedOut`, a negative step otherwise.
async function timed_request(port: u16) -> i64 {
    const timed: Client = client().with_timeout(Duration::from_millis(200));
    const text: String = f"http://127.0.0.1:{port}/slow";
    match (await timed.get(Url::parse(text.as_str()).unwrap())) {
        Result::Ok(_)      => { return -10; }
        Result::Err(error) => {
            match (error.kind) {
                IoErrorKind::TimedOut => { return 1; }
                _                     => { return -11; }
            }
        }
    }
}

async function timed_round_trip(listener: TcpListener, port: u16) -> i64 {
    const pair: (i64, i64) = await Futures::join(never_answer(listener), timed_request(port));
    if (pair.0 != 1) { return pair.0 - 100; }
    return pair.1;
}

![test]
function client_times_out_a_server_that_never_answers() -> Result<(), TestError> {
    mut listener: TcpListener = match (TcpListener::bind(SocketAddr::localhost_v4(0))) {
        Result::Ok(v)  => { v }
        Result::Err(_) => { return bail(Str::new("bind 127.0.0.1:0 failed")); }
    };
    listener.set_nonblocking(true)?;
    const port: u16 = match (listener.local_addr()) {
        Result::Ok(a)  => { a.port }
        Result::Err(_) => { return bail(Str::new("local_addr failed")); }
    };
    mut ex: Executor = Executor::new();
    return expect_eq(ex.block_on(timed_round_trip(listener, port)), 1 as i64);
}

/// 1 when an `ftp` URL is refused as `Unsupported`.
async function fetch_ftp() -> i64 {
    const plain: Client = client();
    match (await plain.get(Url::parse(Str::new("ftp://127.0.0.1/x")).unwrap())) {
        Result::Ok(_)      => { return -1; }
        Result::Err(error) => {
            match (error.kind) {
                IoErrorKind::Unsupported => { return 1; }
                _                        => { return -2; }
            }
        }
    }
}

![test]
function client_refuses_a_scheme_it_does_not_speak() -> Result<(), TestError> {
    mut ex: Executor = Executor::new();
    return expect_eq(ex.block_on(fetch_ftp()), 1 as i64);
}
