///! `HttpsClient` - HTTP/1.1 over a TLS loopback, end to end.
///!
///! Drives the full TLS-carries-HTTP path: the client resolves nothing (it is
///! handed `127.0.0.1` directly), dials, handshakes, sends a GET and reads the
///! response; the server wraps its accepted socket in TLS and frames the
///! request with the ordinary HTTP/1.1 reader, because a `TlsStream` is an
///! `AsyncTransport` like any socket and `BufStream<S>` buffers both the same
///! way.
///!
///! `HttpsClient` had NO coverage before the async port - the previous test
///! open-coded the client half against the blocking TLS API and never
///! constructed an `HttpsClient` at all. Here the client half IS the shipped
///! type, so a break in `get` / `send` fails this rather than going unnoticed.
///!
///! Both halves run as tasks on ONE `Executor`. That is not a simplification:
///! a TLS handshake is bidirectional, so on blocking sockets the client would
///! block in `SSL_connect` before the server ever reached `SSL_accept`, which
///! is why the blocking version of this test needed a thread.
///!
///! The response body is asserted BY VALUE, so a truncated or mis-framed read
///! fails rather than passing as an empty success.
///!
///! Requires `ssl` + `crypto` in `tests/cryoconfig` link_libs and the
///! `fixtures/tls/` cert+key (cwd is the `tests/` project root).

![config(testing)]
namespace CryoTests::Tests::Stdlib::NetHttps;

import std::core::result;
import std::core::option;
import std::collections::str;
import std::collections::array;
import std::collections::string;
import std::io::error;
import std::io::traits;
import std::io::buf;
import std::future;
import std::net::addr::socket_addr;
import std::net::socket::tcp;
import std::net::tls::context;
import std::net::tls::stream;
import std::net::tls::future;
import std::net::http::method;
import std::net::http::status;
import std::net::http::request;
import std::net::http::response;
import std::net::http::conn;
import std::net::https;
import std::test::error;
import std::test::assert;

/// The body the server answers with. Distinctive enough that a stale or empty
/// buffer cannot be mistaken for it.
function https_body() -> Str {
    return Str::new("hi over tls");
}

function https_bytes_eq(got: &Array<u8>, want: Str) -> boolean {
    if (got.length() != want.length()) { return false; }
    mut i: u64 = 0;
    while (i < got.length()) {
        mut a: u8 = 0;
        mut b: u8 = 1;
        match (got.get(i))          { Option::Some(v) => { a = v; } Option::None => { } }
        match (want.byte_at(i))     { Option::Some(v) => { b = v; } Option::None => { } }
        if (a != b) { return false; }
        i = i + 1;
    }
    return true;
}

/// Accept ONE connection, complete the server handshake, read a request with
/// the ordinary HTTP/1.1 framing, and answer 200 with the fixed body.
/// Returns 1 on success, or a negative step code.
async function https_serve(listener: TcpListener, acceptor: TlsAcceptor) -> i64 {
    mut acc: TcpAccepted = await TcpAccept::start(listener);
    mut lst: TcpListener = acc.take_listener();
    lst.drop();

    mut sock: TcpStream = TcpStream::from_fd(-1);
    match (acc.take_result()) {
        Result::Ok(s)  => { sock = s; }
        Result::Err(_) => { return -1; }
    }

    // `ac` is the receiver of an awaited method, so it is carried across the
    // suspend and released by the scope-exit drop; an explicit `.drop()` here
    // would be a second release of the same context.
    mut ac: TlsAcceptor = acceptor;
    mut tls: TlsStream = match (await ac.accept(sock)) {
        Result::Ok(t)  => { t }
        Result::Err(_) => { return -2; }
    };

    mut c: BufStream<TlsStream> = BufStream<TlsStream>::of(tls);
    mut req: Request = match (await c.read_request()) {
        Result::Ok(v)  => { v }
        Result::Err(_) => { return -3; }
    };
    if (!req.path.as_str().equals(Str::new("/hello"))) { return -4; }

    mut resp: Response = Response::text(StatusCode::ok(), https_body());
    match (resp.encode_into(c.pending())) {
        Result::Ok(_)  => { }
        Result::Err(_) => { return -5; }
    }
    match (await c.flush()) {
        Result::Ok(_)  => { }
        Result::Err(_) => { return -6; }
    }
    return 1;
}

/// The client half, through the shipped `HttpsClient`. The fixture certificate
/// is self-signed, so verification is off - that is the only thing this differs
/// from a real call in.
async function https_fetch(port: u16) -> i64 {
    mut client: HttpsClient = match (HttpsClient::insecure()) {
        Result::Ok(c)  => { c }
        Result::Err(_) => { return -20; }
    };
    mut resp: Response = match (await client.get(Str::new("127.0.0.1"), port,
                                                 Str::new("/hello"))) {
        Result::Ok(r)  => { r }
        Result::Err(_) => { return -21; }
    };
    if (resp.status.as_u16() != 200u16)            { return -22; }
    if (!https_bytes_eq(&resp.body, https_body())) { return -23; }
    return 1;
}

async function https_round_trip(port: u16, listener: TcpListener,
                                acceptor: TlsAcceptor) -> i64 {
    const pair: (i64, i64) = await Futures::join(https_serve(listener, acceptor),
                                                 https_fetch(port));
    if (pair.0 != 1) { return pair.0; }
    if (pair.1 != 1) { return pair.1; }
    return 0;
}

![test]
function https_loopback_round_trip() -> Result<(), TestError> {
    mut acceptor: TlsAcceptor = match (TlsAcceptor::new(Str::new("fixtures/tls/cert.pem"),
                                                        Str::new("fixtures/tls/key.pem"))) {
        Result::Ok(a)  => { a }
        Result::Err(_) => { return bail(Str::new("TlsAcceptor::new failed (fixture cert/key)")); }
    };
    mut listener: TcpListener = match (TcpListener::bind(SocketAddr::localhost_v4(0u16))) {
        Result::Ok(v)  => { v }
        Result::Err(_) => { acceptor.drop(); return bail(Str::new("bind 127.0.0.1:0 failed")); }
    };
    listener.set_nonblocking(true);
    const port: u16 = match (listener.local_addr()) {
        Result::Ok(a)  => { a.port }
        Result::Err(_) => {
            listener.drop(); acceptor.drop();
            return bail(Str::new("local_addr failed"));
        }
    };
    if (port == 0u16) {
        listener.drop(); acceptor.drop();
        return bail(Str::new("local_addr reported port 0"));
    }

    mut ex: Executor = Executor::new();
    const r: i64 = ex.block_on(https_round_trip(port, listener, acceptor));
    ex.drop();
    return expect_eq(r, 0 as i64);
}
