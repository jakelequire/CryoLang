///! `Client` on an `https` URL - HTTP/1.1 over a TLS loopback, end to end.
///!
///! Drives the full TLS-carries-HTTP path: the client resolves nothing (it is
///! handed `127.0.0.1` directly), dials, handshakes, sends a GET and reads the
///! response; the server wraps its accepted socket in TLS and frames the
///! request with the ordinary HTTP/1.1 reader, because a `TlsStream` is an
///! `AsyncTransport` like any socket and `BufStream<S>` buffers both the same
///! way.
///!
///! The client half IS the shipped type, so a break in `get` / `send` fails
///! this rather than going unnoticed.
///!
///! Both halves run as tasks on ONE `Executor`. That is not a simplification:
///! a TLS handshake is bidirectional, so on blocking sockets the client would
///! block in `SSL_connect` before the server ever reached `SSL_accept`, which
///! is why the blocking version of this test needed a thread.
///!
///! The response body is asserted BY VALUE, so a truncated or mis-framed read
///! fails rather than passing as an empty success.
///!
///! Requires `ssl` + `crypto` in `tests/cryoconfig` link_libs and the
///! `fixtures/tls/` cert+key (cwd is the `tests/` project root).

![config(testing)]
namespace CryoTests::Tests::Stdlib::NetHttps;

import std::core::result::{ Result };
import std::core::option::{ Option };
import std::collections::str::{ Str };
import std::collections::array::{ Array };
import std::collections::string::{ String };
import std::io::error::{ IoErrorKind };
import std::io::traits;
import std::fs::{ File };
import std::fs::path::{ Path };
import std::io::buf::{ BufStream };
import std::future;
import std::net::addr::socket_addr::{ SocketAddr };
import std::net::socket::tcp::{ TcpAccept, TcpAccepted, TcpListener, TcpStream };
import std::net::tls::context::{ TlsAcceptor };
import std::net::tls::stream::{ TlsStream };
import std::net::tls::future;
import std::net::http::method;
import std::net::http::status::{ StatusCode };
import std::net::http::request::{ Request };
import std::net::http::response::{ Response };
import std::net::http::conn;
import std::net::addr::url::{ Url };
import std::net::http::client::{ Client };
import std::test::error::{ TestError };
import std::test::assert::{ bail, expect_eq };
import std::sys::syscall;
import std::future::combinator::{ Futures };
import std::future::executor::{ Executor };

/// The body the server answers with. Distinctive enough that a stale or empty
/// buffer cannot be mistaken for it.
function https_body() -> Str {
    return Str::new("hi over tls");
}

function https_bytes_eq(got: &Array<u8>, want: Str) -> boolean {
    if (got.length() != want.length()) { return false; }
    mut i: i64 = 0;
    while (i < got.length()) {
        mut a: u8 = 0;
        mut b: u8 = 1;
        match (got.get(i))          { Option::Some(v) => { a = v; } Option::None => { } }
        match (want.byte_at(i))     { Option::Some(v) => { b = v; } Option::None => { } }
        if (a != b) { return false; }
        i = i + 1;
    }
    return true;
}

/// Accept ONE connection, complete the server handshake, read a request with
/// the ordinary HTTP/1.1 framing, and answer 200 with the fixed body.
/// Returns 1 on success, or a negative step code.
async function https_serve(listener: TcpListener, acceptor: TlsAcceptor) -> i64 {
    mut acc: TcpAccepted = await TcpAccept::start(listener);
    mut _lst: TcpListener = acc.take_listener();

    mut sock: TcpStream = TcpStream::from_fd(-1);
    match (acc.take_result()) {
        Result::Ok(s)  => { sock = s; }
        Result::Err(_) => { return -1; }
    }

    // `ac` is the receiver of an awaited method, so it is carried across the
    // suspend and released by the scope-exit drop; an explicit `.drop()` here
    // would be a second release of the same context.
    mut ac: TlsAcceptor = acceptor;
    mut tls: TlsStream = match (await ac.accept(sock)) {
        Result::Ok(t)  => { t }
        Result::Err(_) => { return -2; }
    };

    mut c: BufStream<TlsStream> = BufStream::<TlsStream>::of(tls);
    mut req: Request = match (await c.read_request()) {
        Result::Ok(v)  => { v }
        Result::Err(_) => { return -3; }
    };
    if (!req.path.as_str().equals(Str::new("/hello"))) { return -4; }

    mut resp: Response = Response::text(StatusCode::ok(), https_body());
    match (resp.encode_into(c.pending())) {
        Result::Ok(_)  => { }
        Result::Err(_) => { return -5; }
    }
    match (await c.flush()) {
        Result::Ok(_)  => { }
        Result::Err(_) => { return -6; }
    }
    return 1;
}

/// The client half, through the shipped `Client`, against `host` on the
/// loopback port. 1 on the expected body; `-21` when the request failed with
/// `InvalidData`, which is how a certificate the client does not trust
/// surfaces; other negatives for other failures.
async function https_fetch(client: Client, host: Str, port: u16) -> i64 {
    const text: String = f"https://{host}:{port}/hello";
    mut resp: Response = match (await client.get(Url::parse(text.as_str()).unwrap())) {
        Result::Ok(r)  => { r }
        Result::Err(e) => {
            match (e.kind) {
                IoErrorKind::InvalidData => { return -21; }
                _                        => { return -20; }
            }
        }
    };
    if (resp.status.as_u16() != 200)            { return -22; }
    if (!https_bytes_eq(&resp.body, https_body())) { return -23; }
    return 1;
}

/// The server's and the client's results, as `server * 100 + client` for the
/// two values a test expects: 101 for a served request, and the client's own
/// code when the server's handshake failed (-2) - `-200 + client`.
async function https_round_trip(client: Client, host: Str, port: u16, listener: TcpListener,
                                acceptor: TlsAcceptor) -> i64 {
    const pair: (i64, i64) = await Futures::join(https_serve(listener, acceptor),
                                                 https_fetch(client, host, port));
    return pair.0 * 100 + pair.1;
}

/// Serve the fixture certificate on an ephemeral loopback port and fetch
/// `/hello` from it with `client` as `host`.
function https_exchange(client: Client, host: string) -> Result<i64, TestError> {
    mut acceptor: TlsAcceptor = match (TlsAcceptor::new(Str::new("fixtures/tls/cert.pem"),
                                                        Str::new("fixtures/tls/key.pem"))) {
        Result::Ok(a)  => { a }
        Result::Err(_) => { return Result::Err(TestError::failed(Str::new("TlsAcceptor::new failed (fixture cert/key)"))); }
    };
    mut listener: TcpListener = match (TcpListener::bind(SocketAddr::localhost_v4(0))) {
        Result::Ok(v)  => { v }
        Result::Err(_) => { return Result::Err(TestError::failed(Str::new("bind 127.0.0.1:0 failed"))); }
    };
    listener.set_nonblocking(true);
    const port: u16 = match (listener.local_addr()) {
        Result::Ok(a)  => { a.port }
        Result::Err(_) => { return Result::Err(TestError::failed(Str::new("local_addr failed"))); }
    };
    mut ex: Executor = Executor::new();
    return Result::Ok(ex.block_on(https_round_trip(client, Str::new(host), port, listener, acceptor)));
}

/// The fixture certificate is self-signed, so verification is off - that is
/// the only thing this differs from a real call in.
![test]
function https_loopback_round_trip() -> Result<(), TestError> {
    const client: Client = Client::new().expect("TLS context").danger_accept_invalid_certs();
    return expect_eq(https_exchange(client, "127.0.0.1")?, 101 as i64);
}

/// Verification ON, with the fixture certificate (`CN=localhost`) added as a
/// root: the chain and the name both check out.
![test]
function https_verifies_a_server_against_an_added_root() -> Result<(), TestError> {
    mut client: Client = Client::new().expect("TLS context");
    const pem: Array<u8> = File::read_bytes(Path::new("fixtures/tls/cert.pem")).expect("fixture cert");
    match (client.add_root_certificate(pem.as_slice())) {
        Result::Ok(_)  => { }
        Result::Err(_) => { return bail(Str::new("the fixture certificate was refused as a root")); }
    }
    return expect_eq(https_exchange(client, "localhost")?, 101 as i64);
}

/// The control for the test above: the same server without the root added is
/// refused by the client, and the server sees its handshake fail.
![test]
function https_refuses_a_server_it_does_not_trust() -> Result<(), TestError> {
    const client: Client = Client::new().expect("TLS context");
    return expect_eq(https_exchange(client, "localhost")?, -221 as i64);
}

/// A trusted chain is not enough: with the fixture added as a root, asking
/// for `127.0.0.1`, an address the certificate does not name, is refused.
![test]
function https_refuses_a_server_that_does_not_name_the_address() -> Result<(), TestError> {
    mut client: Client = Client::new().expect("TLS context");
    const pem: Array<u8> = File::read_bytes(Path::new("fixtures/tls/cert.pem")).expect("fixture cert");
    match (client.add_root_certificate(pem.as_slice())) {
        Result::Ok(_)  => { }
        Result::Err(_) => { return bail(Str::new("the fixture certificate was refused as a root")); }
    }
    return expect_eq(https_exchange(client, "127.0.0.1")?, -221 as i64);
}

/// The crypt32 parameter structures have the sizes and layout Windows
/// reads them at.
![target(windows)]
![test]
function crypt32_structures_have_their_c_sizes() -> Result<(), TestError> {
    expect_eq(sizeof(syscall::CertificateChainParameters) as u64, 32 as u64)?;
    expect_eq(sizeof(syscall::SslChainPolicyParameters) as u64, 24 as u64)?;
    expect_eq(sizeof(syscall::CertificateChainPolicyParameters) as u64, 16 as u64)?;
    return expect_eq(sizeof(syscall::CertificateChainPolicyStatus) as u64, 24 as u64);
}

/// Bytes that hold no PEM certificate are refused, not silently accepted.
![test]
function add_root_certificate_refuses_bytes_without_a_certificate() -> Result<(), TestError> {
    mut client: Client = Client::new().expect("TLS context");
    match (client.add_root_certificate(Str::new("not a certificate").as_bytes())) {
        Result::Ok(_)  => { return bail(Str::new("accepted bytes with no certificate")); }
        Result::Err(e) => {
            match (e.kind) {
                IoErrorKind::InvalidData => { return Result::Ok(()); }
                _                        => { return bail(Str::new("wrong error kind")); }
            }
        }
    }
}
