///! WebSocket (RFC 6455): the hermetic accept-key vector, plus the full
///! non-blocking client/server pair over a TCP loopback.
///!
///! What these pin that a hand-inspection cannot:
///!
///!   - **The handshake and the first frame may arrive in ONE write.** Because
///!     `WebSocket<S>` OWNS its `BufStream<S>`, the read buffer outlives the
///!     handshake, so frame bytes that landed in the same fill as the
///!     terminating blank line survive into the first `recv`. The borrowed,
///!     byte-at-a-time version could only avoid over-reading by never
///!     buffering; this one has to KEEP what it over-read.
///!     `pipelined_upgrade_and_frame_round_trip` sends the upgrade request and
///!     the first frame in a single flush and still expects the message.
///!   - **The connection survives several frames.** `recv` carries its
///!     accumulator, and `read_frame` carries a masking key and a length,
///!     across suspension points inside a loop. A desynchronized carrier shows
///!     up as a wrong count, so every test asserts numbers.
///!   - **Control frames are serviced inline.** A Ping mid-stream is answered
///!     with a Pong and does not consume the data message behind it.
///!
///! Every failure is a distinct negative number, so a red test names its own
///! step rather than only its assertion.

![config(testing)]
namespace CryoTests::Tests::Stdlib::NetWs;

import std::core::result::{ Result };
import std::core::option;
import std::core::slice;
import std::collections::str::{ Str };
import std::collections::string::{ String };
import std::collections::array::{ Array };
import std::future;
import std::io::error::{ IoError };
import std::io::traits;
import std::io::buf::{ BufStream };
import std::net::addr::socket_addr::{ SocketAddr };
import std::net::socket::tcp::{ TcpAccept, TcpAccepted, TcpConnect, TcpListener, TcpStream };
import std::net::ws::frame::{ Frame, OpCode };
import std::net::ws::conn::{ accept, connect, Message, WebSocket };
import std::net::ws::handshake::{ compute_accept, generate_key };
import std::test::error::{ TestError };
import std::test::assert::{ bail, expect, expect_eq };
import std::future::combinator::{ Futures };
import std::future::executor::{ Executor };

/// RFC 6455 section 1.3: `base64(sha1(key + GUID))`.  The canonical worked
/// example: `dGhlIHNhbXBsZSBub25jZQ==` -> `s3pPLMBiTxaQ9kYGzzhZRbK+xOo=`.
/// Hermetic - exercises SHA-1 + base64 + the GUID concatenation with no
/// sockets involved.
![test]
function accept_key_rfc6455_vector() -> Result<(), TestError> {
    mut accept: String = compute_accept(Str::new("dGhlIHNhbXBsZSBub25jZQ=="));
    const ok: boolean = accept.as_str().equals(
        &Str::new("s3pPLMBiTxaQ9kYGzzhZRbK+xOo="));
    return expect(ok, Str::new("compute_accept must match the RFC 6455 vector"));
}

/// A client key is 16 fresh random bytes: 24 base64 characters, a new
/// value each time.
![test]
function generated_keys_are_sixteen_fresh_bytes() -> Result<(), TestError> {
    const first: String = generate_key();
    const second: String = generate_key();
    expect_eq(first.length(), 24)?;
    expect_eq(second.length(), 24)?;
    return expect(!first.as_str().equals(&second.as_str()), Str::new("two generated keys differ"));
}

// ============================================================================
// Loopback helpers
// ============================================================================

/// Bind an ephemeral port. Port 0 is what keeps concurrent runs of the suite
/// from colliding. The listener comes back whole rather than paired with its
/// port: moving one field out of a tuple that owns a destructor would leave
/// the other to be dropped twice.
function ws_bind() -> Result<TcpListener, IoError> {
    mut l: TcpListener = TcpListener::bind(SocketAddr::localhost_v4(0))?;
    l.set_nonblocking(true);
    return Result::Ok(l);
}

/// The port the kernel assigned, or 0 if it cannot be read.
function ws_port(l: &TcpListener) -> u16 {
    return match (l.local_addr()) {
        Result::Ok(a)  => { a.port }
        Result::Err(_) => { 0 }
    };
}

/// Accept one connection off `listener` and hand back the socket. The listener
/// is consumed: these tests serve exactly one client.
async function ws_accept_one(listener: TcpListener) -> Result<TcpStream, IoError> {
    mut acc: TcpAccepted = await TcpAccept::start(listener);
    mut _lst: TcpListener = acc.take_listener();
    return acc.take_result();
}

/// Read one message and report whether it decoded as `expect_text`. Consumes
/// the message's owned payload on every path.
function ws_message_is(msg: Message, expect_text: string) -> boolean {
    match (msg) {
        Message::Text(s) => {
            mut owned: String = s;
            const ok: boolean = owned.as_str().equals(&Str::new(expect_text));
            return ok;
        }
        Message::Binary(_) => { return false; }
        Message::Close     => { return false; }
    }
}

// ============================================================================
// Full upgrade + framing, both directions
// ============================================================================

/// Client: connect, upgrade, send `n` distinct text messages, then read the
/// server's echo of each. Returns `n`, or a negative step code.
async function ws_client_n(port: u16, n: i64) -> i64 {
    mut sock: TcpStream = match (await TcpConnect::start(SocketAddr::localhost_v4(port))) {
        Result::Ok(v)  => { v }
        Result::Err(_) => { return -10; }
    };
    mut ws: WebSocket<TcpStream> = match (await connect(sock, Str::new("127.0.0.1"),
                                                        Str::new("/chat"))) {
        Result::Ok(v)  => { v }
        Result::Err(_) => { return -11; }
    };

    mut sent: i64 = 0;
    while (sent < n) {
        mut msg: String = String::from_str(Str::new("m"));
        msg.push_byte((0x30 + sent) as u8);
        match (await ws.send_text(msg.as_str())) {
            Result::Ok(_)  => { }
            Result::Err(_) => { return -12; }
        }
        mut back: Message = match (await ws.recv()) {
            Result::Ok(v)  => { v }
            Result::Err(_) => { return -13; }
        };
        // The server echoes what it received, so a desynchronized connection
        // shows up as the WRONG message rather than as a read error.
        if (!ws_message_is(back, msg_text(sent))) { return -14; }
        sent = sent + 1;
    }
    return sent;
}

/// The text of the `i`th client message, as a literal the checker can compare
/// against. Kept in one place so the client and its assertion cannot drift.
function msg_text(i: i64) -> string {
    match (i) {
        0 => { return "m0"; }
        1 => { return "m1"; }
        2 => { return "m2"; }
        _ => { return "m?"; }
    }
}

/// Server: accept, upgrade, echo `n` messages back. Returns `n`, or a negative
/// step code offset by -100 so a server failure is distinguishable from a
/// client one in the same test.
async function ws_server_n(listener: TcpListener, n: i64) -> i64 {
    mut sock: TcpStream = match (await ws_accept_one(listener)) {
        Result::Ok(v)  => { v }
        Result::Err(_) => { return -100; }
    };
    mut ws: WebSocket<TcpStream> = match (await accept(sock)) {
        Result::Ok(v)  => { v }
        Result::Err(_) => { return -101; }
    };

    mut seen: i64 = 0;
    while (seen < n) {
        mut msg: Message = match (await ws.recv()) {
            Result::Ok(v)  => { v }
            Result::Err(_) => { return -102; }
        };
        mut echo: String = String::new();
        match (msg) {
            Message::Text(s)   => { mut owned: String = s; echo.push(owned.as_str()); }
            Message::Binary(b) => { mut _bb: Array<u8> = b; return -103; }
            Message::Close     => { return -104; }
        }
        match (await ws.send_text(echo.as_str())) {
            Result::Ok(_)  => { }
            Result::Err(_) => { return -105; }
        }
        seen = seen + 1;
    }
    return seen;
}

/// Both halves on ONE executor. `Futures::join` completes with a TUPLE.
async function ws_pair(listener: TcpListener, port: u16, n: i64) -> i64 {
    const pair: (i64, i64) = await Futures::join(ws_server_n(listener, n),
                                                 ws_client_n(port, n));
    if (pair.0 != n) { return pair.0; }
    if (pair.1 != n) { return pair.1; }
    return n;
}

/// One message each way: the control for the loop below. If this passes and
/// the three-message test does not, the fault is in carrying the connection
/// round the recv loop rather than in the upgrade or the framing.
![test]
function upgrade_and_one_text_frame_round_trip() -> Result<(), TestError> {
    mut l: TcpListener = match (ws_bind()) {
        Result::Ok(v)  => { v }
        Result::Err(_) => { return bail(Str::new("bind 127.0.0.1:0 failed")); }
    };
    const port: u16 = ws_port(&l);
    if (port == 0) { return bail(Str::new("local_addr failed")); }
    mut ex: Executor = Executor::new();
    const r: i64 = ex.block_on(ws_pair(l, port, 1 as i64));
    return expect_eq(r, 1 as i64);
}

/// Three messages each way down ONE connection, each body distinct. A
/// connection whose buffered state desynchronized between frames decodes the
/// wrong body, which the client checks per message.
![test]
function three_text_frames_on_one_connection() -> Result<(), TestError> {
    mut l: TcpListener = match (ws_bind()) {
        Result::Ok(v)  => { v }
        Result::Err(_) => { return bail(Str::new("bind 127.0.0.1:0 failed")); }
    };
    const port: u16 = ws_port(&l);
    if (port == 0) { return bail(Str::new("local_addr failed")); }
    mut ex: Executor = Executor::new();
    const r: i64 = ex.block_on(ws_pair(l, port, 3 as i64));
    return expect_eq(r, 3 as i64);
}

// ============================================================================
// The pipelined upgrade: request and first frame in ONE write
// ============================================================================

/// Client that writes the upgrade request AND its first data frame into the
/// SAME flush, then reads the 101 and the echo. This is the case a
/// byte-at-a-time handshake read cannot serve: the frame bytes arrive in the
/// same fill as the blank line, so they only survive if the connection - not
/// the handshake - owns the buffer.
async function ws_pipelined_client(port: u16) -> i64 {
    mut sock: TcpStream = match (await TcpConnect::start(SocketAddr::localhost_v4(port))) {
        Result::Ok(v)  => { v }
        Result::Err(_) => { return -10; }
    };
    // The handshake is driven on the CONNECTION, which is only wrapped in a
    // `WebSocket` once the upgrade is complete. Holding a `BufStream<S>*` into
    // the wrapper instead would not survive: an owning local is carried across
    // each suspend, so a pointer taken before the first `await` addresses a
    // copy the later states have stopped using.
    mut c: BufStream<TcpStream> = BufStream::<TcpStream>::of(sock);

    // Hand-built request so the frame can be appended to the SAME buffer
    // before anything is sent. The key is the RFC's worked example, so the
    // accept value the server computes is the known constant.
    mut req: String = String::with_capacity(200);
    req.push(Str::new("GET /chat HTTP/1.1\r\n"));
    req.push(Str::new("Host: 127.0.0.1\r\n"));
    req.push(Str::new("Upgrade: websocket\r\n"));
    req.push(Str::new("Connection: Upgrade\r\n"));
    req.push(Str::new("Sec-WebSocket-Key: dGhlIHNhbXBsZSBub25jZQ==\r\n"));
    req.push(Str::new("Sec-WebSocket-Version: 13\r\n\r\n"));
    match (c.pending().try_append(req.as_str().as_bytes())) {
        Result::Ok(_)  => { }
        Result::Err(_) => { return -11; }
    }
    match (c.queue_frame(true, OpCode::Text, Str::new("pipelined").as_bytes(), true)) {
        Result::Ok(_)  => { }
        Result::Err(_) => { return -12; }
    }
    match (await c.flush()) {
        Result::Ok(_)  => { }
        Result::Err(_) => { return -13; }
    }

    // Read the 101 head back a line at a time, then the server's echo.
    mut status: String = match (await c.read_line(4096)) {
        Result::Ok(v)  => { v }
        Result::Err(_) => { return -14; }
    };
    if (!status.as_str().equals(&Str::new("HTTP/1.1 101 Switching Protocols"))) { return -15; }
    mut accept_seen: boolean = false;
    loop {
        mut line: String = match (await c.read_line(4096)) {
            Result::Ok(v)  => { v }
            Result::Err(_) => { return -16; }
        };
        if (line.is_empty()) { break; }
        if (line.as_str().equals(
                &Str::new("Sec-WebSocket-Accept: s3pPLMBiTxaQ9kYGzzhZRbK+xOo="))) {
            accept_seen = true;
        }
    }
    if (!accept_seen) { return -17; }

    // The upgrade is done and the frame the server echoes may already be
    // sitting in `c`'s buffer -- wrapping it now is what carries those bytes
    // into `recv` instead of discarding them with a handshake-owned buffer.
    mut ws: WebSocket<TcpStream> = WebSocket::<TcpStream>::of(c, true);
    mut echoed: Message = match (await ws.recv()) {
        Result::Ok(v)  => { v }
        Result::Err(_) => { return -18; }
    };
    if (!ws_message_is(echoed, "pipelined")) { return -19; }
    return 1;
}

async function ws_pipelined_pair(listener: TcpListener, port: u16) -> i64 {
    const pair: (i64, i64) = await Futures::join(ws_server_n(listener, 1 as i64),
                                                 ws_pipelined_client(port));
    if (pair.0 != 1) { return pair.0; }
    return pair.1;
}

![test]
function pipelined_upgrade_and_frame_round_trip() -> Result<(), TestError> {
    mut l: TcpListener = match (ws_bind()) {
        Result::Ok(v)  => { v }
        Result::Err(_) => { return bail(Str::new("bind 127.0.0.1:0 failed")); }
    };
    const port: u16 = ws_port(&l);
    if (port == 0) { return bail(Str::new("local_addr failed")); }
    mut ex: Executor = Executor::new();
    const r: i64 = ex.block_on(ws_pipelined_pair(l, port));
    return expect_eq(r, 1 as i64);
}

// ============================================================================
// Control frames
// ============================================================================

/// Client that sends a Ping BEFORE its text message. The server must answer
/// the Ping with a Pong from inside `recv` and still deliver the text, so the
/// client sees its echo AND a Pong-free message stream.
async function ws_ping_client(port: u16) -> i64 {
    mut sock: TcpStream = match (await TcpConnect::start(SocketAddr::localhost_v4(port))) {
        Result::Ok(v)  => { v }
        Result::Err(_) => { return -10; }
    };
    mut ws: WebSocket<TcpStream> = match (await connect(sock, Str::new("127.0.0.1"),
                                                        Str::new("/chat"))) {
        Result::Ok(v)  => { v }
        Result::Err(_) => { return -11; }
    };
    match (await ws.ping(Str::new("hi").as_bytes())) {
        Result::Ok(_)  => { }
        Result::Err(_) => { return -12; }
    }
    match (await ws.send_text(Str::new("m0"))) {
        Result::Ok(_)  => { }
        Result::Err(_) => { return -13; }
    }
    // The server's Pong is a control frame; `recv` skips it and yields the
    // echo, so one `recv` is enough.
    mut back: Message = match (await ws.recv()) {
        Result::Ok(v)  => { v }
        Result::Err(_) => { return -14; }
    };
    if (!ws_message_is(back, "m0")) { return -15; }
    return 1;
}

async function ws_ping_pair(listener: TcpListener, port: u16) -> i64 {
    const pair: (i64, i64) = await Futures::join(ws_server_n(listener, 1 as i64),
                                                 ws_ping_client(port));
    if (pair.0 != 1) { return pair.0; }
    return pair.1;
}

![test]
function ping_is_answered_inline_without_losing_the_message() -> Result<(), TestError> {
    mut l: TcpListener = match (ws_bind()) {
        Result::Ok(v)  => { v }
        Result::Err(_) => { return bail(Str::new("bind 127.0.0.1:0 failed")); }
    };
    const port: u16 = ws_port(&l);
    if (port == 0) { return bail(Str::new("local_addr failed")); }
    mut ex: Executor = Executor::new();
    const r: i64 = ex.block_on(ws_ping_pair(l, port));
    return expect_eq(r, 1 as i64);
}

// ============================================================================
// The closing handshake and text validation
// ============================================================================

/// The frame each case sends, pipelined behind the upgrade request:
///   0 - Close 1000 with the reason "bye", which the server echoes;
///   1 - text that is not UTF-8 (0xC3 0x28), answered with 1007;
///   2 - a Close of one byte, answered with 1002;
///   3 - Close 1005, a code no peer may send, answered with 1002.
/// Returns the status code of the Close the server sends back, or a
/// negative step code.
async function ws_raw_client(port: u16, case: i64) -> i64 {
    mut sock: TcpStream = match (await TcpConnect::start(SocketAddr::localhost_v4(port))) {
        Result::Ok(v)  => { v }
        Result::Err(_) => { return -10; }
    };
    mut c: BufStream<TcpStream> = BufStream::<TcpStream>::of(sock);
    mut req: String = String::with_capacity(200);
    req.push(Str::new("GET /chat HTTP/1.1\r\n"));
    req.push(Str::new("Host: 127.0.0.1\r\n"));
    req.push(Str::new("Upgrade: websocket\r\n"));
    req.push(Str::new("Connection: Upgrade\r\n"));
    req.push(Str::new("Sec-WebSocket-Key: dGhlIHNhbXBsZSBub25jZQ==\r\n"));
    req.push(Str::new("Sec-WebSocket-Version: 13\r\n\r\n"));
    match (c.pending().try_append(req.as_str().as_bytes())) {
        Result::Ok(_)  => { }
        Result::Err(_) => { return -11; }
    }
    mut queued: boolean = false;
    {
        mut body: Array<u8> = Array::<u8>::new();
        if (case == 0) {
            body.push(0x03); body.push(0xE8);
            body.append(Str::new("bye").as_bytes());
            queued = c.queue_frame(true, OpCode::Close, body.as_slice(), true).is_ok();
        } else if (case == 1) {
            body.push(0xC3); body.push(0x28);
            queued = c.queue_frame(true, OpCode::Text, body.as_slice(), true).is_ok();
        } else if (case == 2) {
            body.push(0x03);
            queued = c.queue_frame(true, OpCode::Close, body.as_slice(), true).is_ok();
        } else {
            body.push(0x03); body.push(0xED);
            queued = c.queue_frame(true, OpCode::Close, body.as_slice(), true).is_ok();
        }
    }
    if (!queued) { return -12; }
    match (await c.flush()) {
        Result::Ok(_)  => { }
        Result::Err(_) => { return -13; }
    }
    loop {
        mut line: String = match (await c.read_line(4096)) {
            Result::Ok(v)  => { v }
            Result::Err(_) => { return -14; }
        };
        if (line.is_empty()) { break; }
    }
    mut answer: Frame = match (await c.read_frame()) {
        Result::Ok(f)  => { f }
        Result::Err(_) => { return -15; }
    };
    const is_close: boolean = match (answer.opcode) {
        OpCode::Close => { true }
        _             => { false }
    };
    if (!is_close) { return -16; }
    const status: &slice::Slice<u8> = answer.payload.as_slice();
    if (status.length() != 2) { return -17; }
    return (((status[0] as i64) << 8) | (status[1] as i64));
}

/// Accept, upgrade and read one message. Returns 1 when `recv` answered as
/// the case requires - `Message::Close` for case 0, an error otherwise -
/// and a negative step code when it did not.
async function ws_raw_server(listener: TcpListener, case: i64) -> i64 {
    mut sock: TcpStream = match (await ws_accept_one(listener)) {
        Result::Ok(v)  => { v }
        Result::Err(_) => { return -100; }
    };
    mut ws: WebSocket<TcpStream> = match (await accept(sock)) {
        Result::Ok(v)  => { v }
        Result::Err(_) => { return -101; }
    };
    match (await ws.recv()) {
        Result::Ok(msg) => {
            const closed: boolean = match (msg) {
                Message::Close     => { true }
                Message::Text(s)   => { mut _owned: String = s; false }
                Message::Binary(b) => { mut _bytes: Array<u8> = b; false }
            };
            if (closed && case == 0) { return 1; }
            return -102;
        }
        Result::Err(_) => {
            if (case == 0) { return -103; }
            return 1;
        }
    }
}

async function ws_raw_pair(listener: TcpListener, port: u16, case: i64) -> (i64, i64) {
    return await Futures::join(ws_raw_server(listener, case), ws_raw_client(port, case));
}

/// The server's result and the status its Close carried, for one case.
function ws_raw_case(case: i64) -> (i64, i64) {
    mut l: TcpListener = match (ws_bind()) {
        Result::Ok(v)  => { v }
        Result::Err(_) => { return (-1000, -1000); }
    };
    const port: u16 = ws_port(&l);
    mut ex: Executor = Executor::new();
    return ex.block_on(ws_raw_pair(l, port, case));
}

![test]
function close_is_answered_with_its_own_status() -> Result<(), TestError> {
    const r: (i64, i64) = ws_raw_case(0);
    expect_eq(r.0, 1 as i64)?;
    return expect_eq(r.1, 1000 as i64);
}

![test]
function text_that_is_not_utf8_fails_the_connection_with_1007() -> Result<(), TestError> {
    const r: (i64, i64) = ws_raw_case(1);
    expect_eq(r.0, 1 as i64)?;
    return expect_eq(r.1, 1007 as i64);
}

![test]
function malformed_close_is_answered_with_1002() -> Result<(), TestError> {
    const short: (i64, i64) = ws_raw_case(2);
    expect_eq(short.0, 1 as i64)?;
    expect_eq(short.1, 1002 as i64)?;
    const reserved: (i64, i64) = ws_raw_case(3);
    expect_eq(reserved.0, 1 as i64)?;
    return expect_eq(reserved.1, 1002 as i64);
}
