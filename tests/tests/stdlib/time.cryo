///! std::time: Duration unit math + checked/saturating/scaling
///! arithmetic + Display/Debug, Instant monotonicity, SystemTime
///! wall-clock sanity, and sleep.

![config(testing)]
namespace CryoTests::Tests::Stdlib::Time;

import std::core::result;
import std::core::option;
import std::core::cmp;
import std::collections::str;
import std::collections::string;
import std::time::duration;
import std::time::clock;
import std::time::datetime;
import std::test::error;
import std::test::assert;

/// Compare an owned `String` (an f-string result) to `want`, dropping it.
function check(got: String, want: string) -> Result<(), TestError> {
    mut s: String = got;
    const view: Str = s.as_str();
    const w: Str = Str::new(want);
    const eq: boolean = view.equals(&w);
    s.drop();
    return expect(eq, Str::new(want));
}

![test]
function duration_unit_conversions() -> Result<(), TestError> {
    const d: Duration = Duration::from_millis(1500u64);
    expect_eq(d.as_secs(), 1u64)?;
    expect_eq(d.subsec_nanos(), 500000000u32)?;
    expect_eq(d.subsec_millis(), 500u32)?;
    expect_eq(d.as_millis(), 1500u64)?;
    expect_eq(d.as_micros(), 1500000u64)?;
    expect_eq(d.as_nanos(), 1500000000u64)?;
    return Result::Ok(());
}

![test]
function duration_new_normalizes_overflow() -> Result<(), TestError> {
    const d: Duration = Duration::new(1u64, 1500000000u32);
    expect_eq(d.as_secs(), 2u64)?;
    expect_eq(d.subsec_nanos(), 500000000u32)?;
    return Result::Ok(());
}

![test]
function duration_checked_and_saturating() -> Result<(), TestError> {
    const a: Duration = Duration::from_millis(750u64);
    const b: Duration = Duration::from_millis(500u64);

    // 750ms + 500ms = 1.25s.
    match (a.checked_add(&b)) {
        Option::Some(sum) => {
            expect_eq(sum.as_secs(), 1u64)?;
            expect_eq(sum.as_millis(), 1250u64)?;
        }
        Option::None => {
            return Result::Err(TestError::failed(Str::new("checked_add overflowed unexpectedly")));
        }
    }

    // 750ms - 500ms = 250ms.
    match (a.checked_sub(&b)) {
        Option::Some(diff) => { expect_eq(diff.as_millis(), 250u64)?; }
        Option::None       => {
            return Result::Err(TestError::failed(Str::new("checked_sub underflowed unexpectedly")));
        }
    }

    // 500ms - 750ms has no representable result.
    match (b.checked_sub(&a)) {
        Option::Some(_) => {
            return Result::Err(TestError::failed(Str::new("checked_sub should be None")));
        }
        Option::None => { }
    }

    // ... but saturating_sub clamps to zero.
    expect_true(b.saturating_sub(&a).is_zero(),
                Str::new("smaller minus larger saturates to zero"))?;
    return Result::Ok(());
}

![test]
function duration_scale_divide_and_f64() -> Result<(), TestError> {
    // 250ms * 4 = 1s.
    expect_eq(Duration::from_millis(250u64).scale(4u64).as_millis(), 1000u64)?;
    // 1s / 4 = 250ms.
    expect_eq(Duration::from_secs(1u64).divide(4u64).as_millis(), 250u64)?;

    // f64 round-trip: 2.5s.
    const d: Duration = Duration::from_secs_f64(2.5);
    expect_eq(d.as_secs(), 2u64)?;
    expect_eq(d.subsec_millis(), 500u32)?;
    const back: f64 = d.as_secs_f64();
    expect_true(back > 2.49 && back < 2.51, Str::new("as_secs_f64 round-trips ~2.5"))?;
    return Result::Ok(());
}

![test]
function duration_ordering() -> Result<(), TestError> {
    const a: Duration = Duration::from_nanos(1u64);
    const b: Duration = Duration::from_secs(1u64);
    expect_true(a.compare(&b) == Ordering::Less, Str::new("1ns < 1s"))?;
    expect_true(b.compare(&a) == Ordering::Greater, Str::new("1s > 1ns"))?;
    expect_true(a.equals(&Duration::from_nanos(1u64)), Str::new("1ns == 1ns"))?;
    return Result::Ok(());
}

![test]
function duration_display() -> Result<(), TestError> {
    check(Duration::from_millis(1500u64).to_string(), "1.5s")?;
    check(Duration::from_millis(250u64).to_string(),  "250ms")?;
    check(Duration::from_micros(3u64).to_string(),    "3us")?;
    check(Duration::from_nanos(10u64).to_string(),    "10ns")?;
    check(Duration::from_secs(5u64).to_string(),      "5s")?;
    check(Duration::zero().to_string(),               "0ns")?;
    return Result::Ok(());
}

![test]
function duration_debug() -> Result<(), TestError> {
    const d: Duration = Duration::from_millis(1500u64);
    return check(d.to_debug_string(), "Duration { secs: 1, nanos: 500000000 }");
}

![test]
function instant_elapsed_is_monotonic() -> Result<(), TestError> {
    const start: Instant = Instant::now();
    sleep(Duration::from_millis(5u64));
    const elapsed: Duration = start.elapsed();
    expect_true(elapsed.as_millis() >= 2,
                Str::new("elapsed since a 5ms sleep is at least 2ms"))?;

    const later: Instant = Instant::now();
    expect_true(later.compare(&start) != Ordering::Less,
                Str::new("monotonic clock does not go backward"))?;

    // Instant + Duration moves forward.
    match (start.checked_add(&Duration::from_secs(1u64))) {
        Option::Some(future) => {
            expect_true(future.compare(&start) == Ordering::Greater,
                        Str::new("instant + 1s is later"))?;
        }
        Option::None => {
            return Result::Err(TestError::failed(Str::new("instant checked_add overflowed")));
        }
    }
    return Result::Ok(());
}

![test]
function system_time_is_after_2020() -> Result<(), TestError> {
    const since: Duration = SystemTime::now().duration_since_epoch();
    expect_true(since.as_secs() >= 1600000000,
                Str::new("wall clock is past 2020-09"))?;
    return Result::Ok(());
}

// ============================================================================
// DateTime - UTC civil calendar
// ============================================================================

![test]
function datetime_epoch() -> Result<(), TestError> {
    return check(DateTime::from_unix_secs(0i64).to_string(),
                 "1970-01-01T00:00:00Z");
}

// Floor division, not truncation: -1s must land on the previous civil day.
![test]
function datetime_pre_epoch_floors() -> Result<(), TestError> {
    return check(DateTime::from_unix_secs(-1).to_string(),
                 "1969-12-31T23:59:59Z");
}

![test]
function datetime_next_day() -> Result<(), TestError> {
    return check(DateTime::from_unix_secs(86400i64).to_string(),
                 "1970-01-02T00:00:00Z");
}

// 2000 is a leap year (divisible by 400), so Feb has a 29th.
![test]
function datetime_leap_day_2000() -> Result<(), TestError> {
    return check(DateTime::from_unix_secs(951782400i64).to_string(),
                 "2000-02-29T00:00:00Z");
}

![test]
function datetime_post_2000() -> Result<(), TestError> {
    return check(DateTime::from_unix_secs(1700000000i64).to_string(),
                 "2023-11-14T22:13:20Z");
}

// Year 1 exercises the expanded-year 4-digit padding and a deeply
// negative timestamp through the era arithmetic.
![test]
function datetime_year_one() -> Result<(), TestError> {
    return check(DateTime::from_unix_secs(-62135596800).to_string(),
                 "0001-01-01T00:00:00Z");
}

![test]
function datetime_fields_are_broken_out() -> Result<(), TestError> {
    const dt: DateTime = DateTime::from_unix_secs(1700000000i64);
    expect_eq(dt.year, 2023i64)?;
    expect_eq(dt.month, 11u32)?;
    expect_eq(dt.day, 14u32)?;
    expect_eq(dt.hour, 22u32)?;
    expect_eq(dt.minute, 13u32)?;
    expect_eq(dt.second, 20u32)?;
    return Result::Ok(());
}

// from_system_time drops the sub-second remainder and reads the same
// calendar point as the underlying whole-second timestamp.
![test]
function datetime_from_system_time() -> Result<(), TestError> {
    const t: SystemTime = SystemTime::from_unix_secs(1700000000i64);
    return check(DateTime::from_system_time(&t).to_string(),
                 "2023-11-14T22:13:20Z");
}
