///! `Task::spawn_blocking` - work that cannot be polled, run off the executor
///! on its blocking pool.
///!
///! The property that matters is not "the work finished" but "the work did not
///! run on the thread that spawned it", and work that merely sleeps cannot
///! tell the two apart without timing the test. So the work here BLOCKS on a
///! flag that only another task on the same executor can set, and the executor
///! is given exactly ONE worker:
///!
///!   - offloaded  -> the worker is free, the sibling task sets the flag, the
///!                   pool thread sees it and the work completes with 1.
///!   - not offloaded -> the single worker is stuck inside the work, the sibling
///!                   task never runs, and the work gives up at its own bound and
///!                   reports 0.
///!
///! The bound is what keeps the failure mode a red test rather than a hung CI.
///!
///! The sibling waits on a `Sleep` before setting the flag, so the work is
///! already handed to the pool whichever order `join` happens to poll its two
///! children in — the test proves offload, not polling order.
///!
///! Offload and CONCURRENCY are separate claims and need separate tests. A group
///! of works waiting only on the flag would finish just as happily one at a
///! time, since whoever waits it out leaves it set for the rest; the
///! concurrency tests therefore add a barrier every work must see all its peers
///! reach.

![config(testing)]
namespace CryoTests::Tests::Stdlib::FutureBlocking;

import std::core::result::{ Result };
import std::core::mem;
import std::future;
import std::alloc::arc::{ Arc };
import std::sync::atomic::{ Atomic, MemoryOrder };
import std::time;
import std::time::clock::{ Instant };
import std::test::error::{ TestError };
import std::test::assert::{ expect_equal };
import std::time::duration::{ Duration };
import std::future::combinator::{ Futures };
import std::future::executor::{ Executor, JoinHandle, Task };
import std::future::timer::{ Sleep };

/// How long a work waits for its conditions before declaring they never
/// arrived. Long enough that a loaded machine does not fail it, short enough
/// that the failing case reports instead of looking like a hang.
const FLAG_WAIT_MS: u64 = 3000;

/// How long the sibling task waits before setting the flag. Only has to
/// outlast the first poll pass.
const FLAG_SET_DELAY_MS: u64 = 50;

/// The blocking work under test: announce arrival on `barrier`, then wait for
/// `flag` and for `need` arrivals in all. 1 if both conditions were met
/// within the bound, 0 if not. A work that gives up takes its arrival back as
/// it leaves, so a work starting after it cannot count it as running still.
/// A `need` of 0 makes the flag the only condition.
///
/// Polls rather than blocking on a condvar because what is being tested is
/// that this call can spin for seconds without costing the executor anything.
/// The bound is real elapsed time, not a count of 5ms sleeps: under a loaded
/// machine a 5ms sleep takes many times that, and not by the same factor on
/// every thread, so counting iterations would make one waiter's bound outlast
/// another's by an amount that depends on scheduling.
function wait_for(flag: &Atomic<u32>, barrier: &Atomic<u32>, need: u32) -> i64 {
    barrier.fetch_add(1, MemoryOrder::AcqRel);
    const started: Instant = Instant::now();
    while (started.elapsed().as_milliseconds() < FLAG_WAIT_MS) {
        const group_ready: boolean = barrier.load(MemoryOrder::Acquire) >= need;
        if (group_ready && flag.load(MemoryOrder::Acquire) == 1) {
            return 1;
        }
        clock::sleep(Duration::from_milliseconds(5));
    }
    barrier.fetch_subtract(1, MemoryOrder::AcqRel);
    return 0;
}

/// A flag or an arrival count shared by the works of a test and the task
/// that sets it.
function shared_zero() -> Arc<Atomic<u32>> {
    return Arc::new(Atomic::<u32>::new(0));
}

/// Spawn one `wait_for` on the blocking pool; the work holds the references
/// to the flag and the barrier it is given.
function spawn_waiter(seen_flag: Arc<Atomic<u32>>, seen_barrier: Arc<Atomic<u32>>, need: u32) -> JoinHandle<i64> {
    return Task::spawn_blocking(move () -> i64 {
        return wait_for(seen_flag.get_reference(), seen_barrier.get_reference(), need);
    });
}

/// What an awaited waiter answered, or -1 when its task ended without one.
async function answer(handle: JoinHandle<i64>) -> i64 {
    return match (await handle) {
        Result::Ok(saw) => { saw }
        Result::Err(_)  => { -1 }
    };
}

/// The sibling: sleep, then set the flag the pool threads are waiting on.
/// Reaching this at all is the thing under test.
async function set_flag(flag: Arc<Atomic<u32>>) -> i64 {
    await Sleep::new(Duration::from_milliseconds(FLAG_SET_DELAY_MS));
    flag.get_reference().store(1, MemoryOrder::Release);
    return 1;
}

async function handshake() -> i64 {
    const flag: Arc<Atomic<u32>> = shared_zero();
    const barrier: Arc<Atomic<u32>> = shared_zero();
    const waiter: JoinHandle<i64> = spawn_waiter(flag.clone(), barrier.clone(), 0);
    const pair: (i64, i64) = await Futures::join(answer(waiter), set_flag(flag));
    if (pair.1 != 1) { return -3; }
    return pair.0;
}

![test]
function blocking_job_runs_off_the_executor() -> Result<(), TestError> {
    // ONE worker: if the work ran on it, nothing else on this executor could.
    mut ex: Executor = Executor::with_threads(1);
    const r: i64 = ex.block_on(handshake());
    return expect_equal(r, 1 as i64);
}

/// `count` works that must all be running at once, the flag set by a sibling
/// task after they are spawned: the number of works that saw every peer
/// running, or a negative step code.
async function group_of(count: u32, flag_up_front: boolean) -> i64 {
    const flag: Arc<Atomic<u32>> = shared_zero();
    const barrier: Arc<Atomic<u32>> = shared_zero();
    if (flag_up_front) { flag.get_reference().store(1, MemoryOrder::Release); }
    mut waiters: [JoinHandle<i64>] = [];
    for (mut i: u32 = 0; i < count; i++) {
        waiters.push(spawn_waiter(flag.clone(), barrier.clone(), count));
    }
    const raised: i64 = await set_flag(flag);
    if (raised != 1) { return -14; }
    mut saw: i64 = 0;
    while (waiters.length() > 0) {
        const answered: i64 = await answer(waiters.pop().unwrap());
        if (answered < 0) { return -15; }
        saw = saw + answered;
    }
    return saw;
}

/// Four works that must be running SIMULTANEOUSLY, on a single-worker
/// executor.
///
/// The barrier is what makes this a concurrency test rather than a repeat of
/// the one above. Waiting on the flag alone would not distinguish a pool of
/// four threads from a pool of one: the first work would wait the flag out and
/// the other three would then each find it already set and finish instantly.
/// Every work instead refuses to finish until all four have ARRIVED, so a pool
/// that serializes them deadlocks its first work against three that never
/// start, and it reports 0 at its bound.
![test]
function blocking_pool_runs_jobs_concurrently() -> Result<(), TestError> {
    mut ex: Executor = Executor::with_threads(1);
    const r: i64 = ex.block_on(group_of(4, false));
    return expect_equal(r, 4 as i64);
}

/// How many simultaneously-running works the default ceiling is probed with.
/// Above any plausible small fixed ceiling, so a pool that reverted to one
/// would fail this rather than merely being slower.
const CEILING_PROBE: u32 = 16;

/// The pool's ceiling, from both sides, through the executor that owns it.
///
/// Every work demands that all of its group be RUNNING before it finishes, so
/// "the ceiling is N" is observable as "N works can be inside the pool at
/// once", which is the only form of the claim that a serializing pool cannot
/// also satisfy.
///
/// `default_ceiling_admits_more_than_eight` is the one that would go red if
/// the default were lowered; `a_configured_ceiling_is_enforced` is the one
/// that would go red if the configured ceiling stopped bounding anything, and
/// `executor_blocking_ceiling_reaches_the_pool` the one that would go red if
/// it were taken as smaller than asked. No one of them alone pins the
/// behaviour.
![test]
function blocking_pool_default_ceiling_admits_more_than_eight() -> Result<(), TestError> {
    // The flag is set up front: the barrier, not the flag, is what these works
    // are really waiting on, and it can only be satisfied by concurrency.
    mut ex: Executor = Executor::with_threads(1);
    const r: i64 = ex.block_on(group_of(CEILING_PROBE, true));
    return expect_equal(r, CEILING_PROBE as i64);
}

![test]
function blocking_pool_a_configured_ceiling_is_enforced() -> Result<(), TestError> {
    // Two threads, three works that each demand all three be running. The
    // third cannot start until one of the first two finishes, so the barrier
    // is unreachable while they wait and they all give up at their bound: the
    // first two waiting out the third, the third starting on a thread one of
    // them gave up, counting at most itself and the other. A pool that ignored
    // its ceiling would run all three together, and every one would see three.
    mut ex: Executor = Executor::with_threads_and_blocking(1, 2);
    const r: i64 = ex.block_on(group_of(3, true));
    return expect_equal(r, 0 as i64);
}

/// The `Executor` knob, end to end, from the other side: a ceiling of three
/// runs three works at once, so all three see each other. Together with the
/// test above this pins the knob both ways: a ceiling taken as smaller than
/// asked fails here, and one dropped in favour of the default fails there.
![test]
function executor_blocking_ceiling_reaches_the_pool() -> Result<(), TestError> {
    mut ex: Executor = Executor::with_threads_and_blocking(1, 3);
    const r: i64 = ex.block_on(group_of(3, true));
    return expect_equal(r, 3 as i64);
}

/// Work abandoned mid-flight: the handle is dropped by a deadline while a pool
/// thread is still inside the work, which detaches it. The work keeps
/// running to its end, nothing may be freed twice and the executor must still
/// shut down. `Elapsed` is the expected answer — the point is that the
/// teardown after it is clean.
async function abandon_in_flight(flag: Arc<Atomic<u32>>) -> i64 {
    const barrier: Arc<Atomic<u32>> = shared_zero();
    const waiter: JoinHandle<i64> = spawn_waiter(flag.clone(), barrier.clone(), 0);
    match (await Futures::timeout(Duration::from_milliseconds(60), answer(waiter))) {
        Result::Ok(_)  => { return -20; }   // the flag is never set here
        Result::Err(_) => { return 1; }
    }
}

![test]
function dropping_a_future_leaves_its_job_to_the_pool() -> Result<(), TestError> {
    const flag: Arc<Atomic<u32>> = shared_zero();
    mut ex: Executor = Executor::with_threads(1);
    const r: i64 = ex.block_on(abandon_in_flight(flag.clone()));
    // The pool thread is still spinning on the flag. Setting it now releases
    // that thread, so the join inside `Executor::drop` is quick rather than
    // waiting out FLAG_WAIT_MS — the join itself is the path under test: it
    // must wait the work out rather than free its block underneath it.
    flag.get_reference().store(1, MemoryOrder::Release);
    mem::drop(ex);
    return expect_equal(r, 1 as i64);
}
