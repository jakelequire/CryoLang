///! Str text methods: lines, split_whitespace, repeat, join, char_count and
///! is_char_boundary; String insert, remove and pop.

![config(testing)]
namespace CryoTests::Tests::Stdlib::StrText;

import std::core::result::{ Result };
import std::core::option::{ Option };
import std::collections::str::{ Str };
import std::collections::string::{ String };
import std::test::error::{ TestError };
import std::test::assert::{ expect_equal, expect_true };

// A string literal initialises a `Str` constant through `Str::new`, the
// `string -> Str` converter.
const GREETING: Str = "Hello, world!";

function viewed_length(text: Str) -> i64 { return text.length(); }
function owned_length(text: String) -> i64 { return text.length(); }

// A literal is converted where a `Str` or a `String` is declared: a
// module-level constant, a typed local binding, and an argument.
![test]
function a_literal_converts_where_a_str_or_string_is_declared() -> Result<(), TestError> {
    expect_equal(GREETING, Str::new("Hello, world!"))?;
    const local: Str = "local";
    expect_equal(local, Str::new("local"))?;
    const owned: String = "owned";
    expect_equal(owned, String::from("owned"))?;
    expect_equal(viewed_length("argument"), 8)?;
    return expect_equal(owned_length("argument"), 8);
}

![test]
function lines_drop_line_breaks() -> Result<(), TestError> {
    const bar: Str = Str::new("|");
    expect_equal(bar.join(Str::new("a\r\nb\n").lines()), String::from("a|b"))?;
    expect_equal(bar.join(Str::new("a\n\nb").lines()), String::from("a||b"))?;
    expect_equal(bar.join(Str::new("no break").lines()), String::from("no break"))?;
    expect_equal(bar.join(Str::new("cr kept\r").lines()), String::from("cr kept\r"))?;
    expect_equal(Str::new("").lines().count(), 0)?;
    expect_equal(Str::new("\n").lines().count(), 1)?;
    return expect_equal(Str::new("a\nb\n").lines().count(), 2);
}

![test]
function split_whitespace_skips_runs() -> Result<(), TestError> {
    const bar: Str = Str::new("|");
    expect_equal(bar.join(Str::new("  a \t b\n").split_whitespace()), String::from("a|b"))?;
    expect_equal(bar.join(Str::new("one").split_whitespace()), String::from("one"))?;
    expect_equal(Str::new("").split_whitespace().count(), 0)?;
    return expect_equal(Str::new(" \r\n\t ").split_whitespace().count(), 0);
}

![test]
function repeat_writes_the_text_count_times() -> Result<(), TestError> {
    expect_equal(Str::new("ab").repeat(3), String::from("ababab"))?;
    expect_equal(Str::new("ab").repeat(0), String::new())?;
    expect_equal(Str::new("ab").repeat(-2), String::new())?;
    return expect_equal(Str::new("").repeat(5), String::new());
}

![test]
function join_puts_the_separator_between_pieces() -> Result<(), TestError> {
    const words: Str = Str::new("a b c");
    expect_equal(Str::new(", ").join(words.split_whitespace()), String::from("a, b, c"))?;
    expect_equal(Str::new(", ").join(Str::new("").split_whitespace()), String::new())?;
    return expect_equal(Str::new("").join(words.split_whitespace()), String::from("abc"));
}

![test]
function char_count_counts_scalars() -> Result<(), TestError> {
    const text: Str = Str::new("na\u{ef}ve \u{1F600}");
    expect_equal(text.length(), 11)?;
    expect_equal(text.char_count(), 7)?;
    expect_equal(Str::new("").char_count(), 0)?;
    const malformed: [u8; 3] = [0x61, 0xFF, 0x62];
    return expect_equal(Str::from(malformed.as_slice()).char_count(), 3);
}

![test]
function is_char_boundary_finds_scalar_edges() -> Result<(), TestError> {
    const text: Str = Str::new("na\u{ef}ve");
    expect_true(text.is_char_boundary(0), Str::new("start"))?;
    expect_true(text.is_char_boundary(2), Str::new("before the two-byte scalar"))?;
    expect_true(!text.is_char_boundary(3), Str::new("inside the two-byte scalar"))?;
    expect_true(text.is_char_boundary(4), Str::new("after the two-byte scalar"))?;
    expect_true(text.is_char_boundary(6), Str::new("end"))?;
    expect_true(!text.is_char_boundary(7), Str::new("past the end"))?;
    return expect_true(!text.is_char_boundary(-1), Str::new("negative"));
}

![test]
function string_insert_remove_pop() -> Result<(), TestError> {
    mut text: String = String::from("nave");
    text.insert(2, '\u{ef}');
    expect_equal(text.as_str(), Str::new("na\u{ef}ve"))?;
    text.insert(0, '>');
    text.insert(text.length(), '\u{1F600}');
    expect_equal(text.as_str(), Str::new(">na\u{ef}ve\u{1F600}"))?;
    expect_equal(text.remove(3), '\u{ef}')?;
    expect_equal(text.remove(0), '>')?;
    expect_equal(text.as_str(), Str::new("nave\u{1F600}"))?;
    expect_equal(text.pop(), Option::Some('\u{1F600}'))?;
    expect_equal(text.pop(), Option::Some('e'))?;
    expect_equal(text.as_str(), Str::new("nav"))?;
    mut empty: String = String::new();
    return expect_equal(empty.pop(), Option::None);
}

![test]
![should_panic]
function string_insert_inside_a_scalar_panics() -> Result<(), TestError> {
    mut text: String = String::from("na\u{ef}ve");
    text.insert(3, 'x');
    return Result::Ok(());
}