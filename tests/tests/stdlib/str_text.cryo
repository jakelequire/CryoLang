///! Str text methods: lines, split_whitespace, repeat, join, char_count and
///! is_char_boundary; String insert, remove and pop.

![config(testing)]
namespace CryoTests::Tests::Stdlib::StrText;

import std::core::result::{ Result };
import std::core::option::{ Option };
import std::collections::str::{ Str };
import std::collections::string::{ String };
import std::test::error::{ TestError };
import std::test::assert::{ expect_eq, expect_true };

![test]
function lines_drop_line_breaks() -> Result<(), TestError> {
    const bar: Str = Str::new("|");
    expect_eq(bar.join(Str::new("a\r\nb\n").lines()), String::from("a|b"))?;
    expect_eq(bar.join(Str::new("a\n\nb").lines()), String::from("a||b"))?;
    expect_eq(bar.join(Str::new("no break").lines()), String::from("no break"))?;
    expect_eq(bar.join(Str::new("cr kept\r").lines()), String::from("cr kept\r"))?;
    expect_eq(Str::new("").lines().count(), 0)?;
    expect_eq(Str::new("\n").lines().count(), 1)?;
    return expect_eq(Str::new("a\nb\n").lines().count(), 2);
}

![test]
function split_whitespace_skips_runs() -> Result<(), TestError> {
    const bar: Str = Str::new("|");
    expect_eq(bar.join(Str::new("  a \t b\n").split_whitespace()), String::from("a|b"))?;
    expect_eq(bar.join(Str::new("one").split_whitespace()), String::from("one"))?;
    expect_eq(Str::new("").split_whitespace().count(), 0)?;
    return expect_eq(Str::new(" \r\n\t ").split_whitespace().count(), 0);
}

![test]
function repeat_writes_the_text_count_times() -> Result<(), TestError> {
    expect_eq(Str::new("ab").repeat(3), String::from("ababab"))?;
    expect_eq(Str::new("ab").repeat(0), String::new())?;
    expect_eq(Str::new("ab").repeat(-2), String::new())?;
    return expect_eq(Str::new("").repeat(5), String::new());
}

![test]
function join_puts_the_separator_between_pieces() -> Result<(), TestError> {
    const words: Str = Str::new("a b c");
    expect_eq(Str::new(", ").join(words.split_whitespace()), String::from("a, b, c"))?;
    expect_eq(Str::new(", ").join(Str::new("").split_whitespace()), String::new())?;
    return expect_eq(Str::new("").join(words.split_whitespace()), String::from("abc"));
}

![test]
function char_count_counts_scalars() -> Result<(), TestError> {
    const text: Str = Str::new("na\u{ef}ve \u{1F600}");
    expect_eq(text.length(), 11)?;
    expect_eq(text.char_count(), 7)?;
    expect_eq(Str::new("").char_count(), 0)?;
    const malformed: [u8; 3] = [0x61, 0xFF, 0x62];
    return expect_eq(Str::from(malformed.as_slice()).char_count(), 3);
}

![test]
function is_char_boundary_finds_scalar_edges() -> Result<(), TestError> {
    const text: Str = Str::new("na\u{ef}ve");
    expect_true(text.is_char_boundary(0), Str::new("start"))?;
    expect_true(text.is_char_boundary(2), Str::new("before the two-byte scalar"))?;
    expect_true(!text.is_char_boundary(3), Str::new("inside the two-byte scalar"))?;
    expect_true(text.is_char_boundary(4), Str::new("after the two-byte scalar"))?;
    expect_true(text.is_char_boundary(6), Str::new("end"))?;
    expect_true(!text.is_char_boundary(7), Str::new("past the end"))?;
    return expect_true(!text.is_char_boundary(-1), Str::new("negative"));
}

![test]
function string_insert_remove_pop() -> Result<(), TestError> {
    mut text: String = String::from("nave");
    text.insert(2, '\u{ef}');
    expect_eq(text.as_str(), Str::new("na\u{ef}ve"))?;
    text.insert(0, '>');
    text.insert(text.length(), '\u{1F600}');
    expect_eq(text.as_str(), Str::new(">na\u{ef}ve\u{1F600}"))?;
    expect_eq(text.remove(3), '\u{ef}')?;
    expect_eq(text.remove(0), '>')?;
    expect_eq(text.as_str(), Str::new("nave\u{1F600}"))?;
    expect_eq(text.pop(), Option::Some('\u{1F600}'))?;
    expect_eq(text.pop(), Option::Some('e'))?;
    expect_eq(text.as_str(), Str::new("nav"))?;
    mut empty: String = String::new();
    return expect_eq(empty.pop(), Option::None);
}

![test]
![should_panic]
function string_insert_inside_a_scalar_panics() -> Result<(), TestError> {
    mut text: String = String::from("na\u{ef}ve");
    text.insert(3, 'x');
    return Result::Ok(());
}
