///! `HttpServer` over the async transport.
///!
///! The property to pin is not "a request is answered" — the framing tests in
///! `net_http_conn` already cover that. It is that the SERVER holds one
///! connection across several exchanges and one listener across several
///! connections, both of which are values carried through suspension points.
///! Every test therefore drives more than one exchange, and the counts are
///! asserted as numbers so a desynchronized pair cannot pass as a wrong body.
///!
///! `run_on` is driven under `Futures::select` against the client half, which
///! is itself load-bearing: `s.run_on(l)` is an `async` METHOD, and a method's
///! future keeps a pointer to its receiver that has to be re-addressed on
///! every poll. Wrapping one in a combinator used to skip that refresh
///! silently, so a green result here is also the regression test for it.
///!
///! Every failure is a distinct negative number, so a red test names its own
///! step rather than only its assertion.

![config(testing)]
namespace CryoTests::Tests::Stdlib::NetHttpServer;

import std::core::option;
import std::core::result;
import std::collections::str;
import std::collections::string;
import std::collections::array;
import std::future;
import std::time;
import std::time::clock;
import std::io::error;
import std::io::traits;
import std::io::buf;
import std::net::addr::socket_addr;
import std::net::socket::tcp;
import std::net::http::method;
import std::net::http::status;
import std::net::http::request;
import std::net::http::response;
import std::net::http::conn;
import std::net::http::server;
import std::test::error;
import std::test::assert;

/// Echoes the request path back as the body, so every exchange on a
/// connection carries a DIFFERENT body and a response served out of a stale
/// buffer shows up as the wrong one rather than as a byte error.
function hs_echo_path(req: Request) -> Response {
    mut r: Request = req;
    return Response::text(StatusCode::ok(), r.path.as_str());
}

/// Bind an ephemeral port. Port 0 is what keeps concurrent runs of the suite
/// from colliding. The listener comes back whole rather than paired with its
/// port: moving one field out of a tuple that owns a destructor would leave
/// the other to be dropped twice.
function hs_bind() -> Result<TcpListener, IoError> {
    mut l: TcpListener = TcpListener::bind(SocketAddr::localhost_v4(0))?;
    l.set_nonblocking(true);
    return Result::Ok(l);
}

/// The port the kernel assigned, or 0 if it cannot be read.
function hs_port(l: &TcpListener) -> u16 {
    return match (l.local_addr()) {
        Result::Ok(a)  => { a.port }
        Result::Err(_) => { 0 }
    };
}

/// `n` requests down ONE connection, each path distinct, each response matched
/// against the path that produced it. Returns `n`, or a negative step code.
async function hs_client_n(port: u16, n: i64) -> i64 {
    mut sock: TcpStream = match (await TcpConnect::start(SocketAddr::localhost_v4(port))) {
        Result::Ok(v)  => { v }
        Result::Err(_) => { return -10; }
    };
    mut c: BufStream<TcpStream> = BufStream<TcpStream>::of(sock);

    mut sent: i64 = 0;
    while (sent < n) {
        mut path: String = String::from_str(Str::new("/p"));
        path.push_byte((0x30 + sent) as u8);

        mut req: Request = Request::new(Method::Get, path.as_str());
        req.headers.insert(Str::new("Host"), Str::new("127.0.0.1"));
        match (req.encode_into(c.pending())) {
            Result::Ok(_)  => { }
            Result::Err(_) => { return -11; }
        }
        match (await c.flush()) {
            Result::Ok(_)  => { }
            Result::Err(_) => { return -12; }
        }

        mut resp: Response = match (await c.read_response()) {
            Result::Ok(v)  => { v }
            Result::Err(_) => { return -13; }
        };
        if (resp.status.as_u16() != 200)      { return -14; }
        if (resp.body.length() != path.length()) { return -15; }
        mut k: u64 = 0;
        while (k < path.length()) {
            mut lhs: u8 = 0;
            mut rhs: u8 = 1;
            match (resp.body.get(k))         { Option::Some(v) => { lhs = v; } Option::None => { } }
            match (path.as_str().byte_at(k)) { Option::Some(v) => { rhs = v; } Option::None => { } }
            if (lhs != rhs) { return -16; }
            k = k + 1;
        }
        sent = sent + 1;
    }
    return sent;
}

/// Run the server against a client half and report the client's answer. The
/// server never completes on its own, so `select` is what ends the pair;
/// dropping the losing side cancels the accept loop.
async function hs_drive(listener: TcpListener, port: u16, n: i64, timeout_secs: i64) -> i64 {
    mut s: HttpServer = HttpServer::new(SocketAddr::localhost_v4(port), hs_echo_path);
    s.with_read_timeout(timeout_secs);
    const sel: Selected<Result<(), IoError>, i64> =
        await Futures::select(s.run_on(listener), hs_client_n(port, n));
    return match (sel) {
        // The accept loop only completes on a fatal listener error.
        Selected::First(_)  => { -1 }
        Selected::Second(v) => { v }
    };
}

![test]
function server_serves_four_requests_on_one_connection() -> Result<(), TestError> {
    mut l: TcpListener = match (hs_bind()) {
        Result::Ok(v)  => { v }
        Result::Err(_) => { return bail(Str::new("bind 127.0.0.1:0 failed")); }
    };
    const port: u16 = hs_port(&l);
    if (port == 0) { l.drop(); return bail(Str::new("local_addr failed")); }
    mut ex: Executor = Executor::new();
    const r: i64 = ex.block_on(hs_drive(l, port, 4 as i64, 30 as i64));
    ex.drop();
    return expect_eq(r, 4 as i64);
}

/// The control for the loop: ONE exchange on the same code path. If this
/// passes and the four-exchange test does not, the fault is in carrying the
/// connection round the keep-alive loop rather than in the framing.
![test]
function server_serves_one_request_on_one_connection() -> Result<(), TestError> {
    mut l: TcpListener = match (hs_bind()) {
        Result::Ok(v)  => { v }
        Result::Err(_) => { return bail(Str::new("bind 127.0.0.1:0 failed")); }
    };
    const port: u16 = hs_port(&l);
    if (port == 0) { l.drop(); return bail(Str::new("local_addr failed")); }
    mut ex: Executor = Executor::new();
    const r: i64 = ex.block_on(hs_drive(l, port, 1 as i64, 30 as i64));
    ex.drop();
    return expect_eq(r, 1 as i64);
}

/// Two SEPARATE connections through one listener, so the listener itself is
/// proven to survive being handed back by `TcpAccepted` and carried round the
/// accept loop. The keep-alive tests never re-enter that arm.
async function hs_two_connections(listener: TcpListener, port: u16) -> i64 {
    mut s: HttpServer = HttpServer::new(SocketAddr::localhost_v4(port), hs_echo_path);
    const sel: Selected<Result<(), IoError>, i64> =
        await Futures::select(s.run_on(listener), hs_two_clients(port));
    return match (sel) {
        Selected::First(_)  => { -1 }
        Selected::Second(v) => { v }
    };
}

async function hs_two_clients(port: u16) -> i64 {
    const a: i64 = await hs_client_n(port, 1 as i64);
    if (a != 1) { return a; }
    const b: i64 = await hs_client_n(port, 1 as i64);
    if (b != 1) { return b - 100; }
    return 2;
}

![test]
function server_accepts_two_separate_connections() -> Result<(), TestError> {
    mut l: TcpListener = match (hs_bind()) {
        Result::Ok(v)  => { v }
        Result::Err(_) => { return bail(Str::new("bind 127.0.0.1:0 failed")); }
    };
    const port: u16 = hs_port(&l);
    if (port == 0) { l.drop(); return bail(Str::new("local_addr failed")); }
    mut ex: Executor = Executor::new();
    const r: i64 = ex.block_on(hs_two_connections(l, port));
    ex.drop();
    return expect_eq(r, 2 as i64);
}

/// A request line with no terminating blank line, then a half-close. The
/// server must answer the truncated first request with 400 rather than
/// hanging or serving it.
async function hs_truncated_client(port: u16) -> i64 {
    mut sock: TcpStream = match (await TcpConnect::start(SocketAddr::localhost_v4(port))) {
        Result::Ok(v)  => { v }
        Result::Err(_) => { return -20; }
    };
    mut c: BufStream<TcpStream> = BufStream<TcpStream>::of(sock);

    // Header block deliberately unterminated: one header, then EOF.
    const partial: Slice<u8> = Str::new("GET /x HTTP/1.1\r\nHost: a\r\n").as_bytes();
    match (c.pending().try_append(partial)) {
        Result::Ok(_)  => { }
        Result::Err(_) => { return -21; }
    }
    match (await c.flush()) {
        Result::Ok(_)  => { }
        Result::Err(_) => { return -22; }
    }
    match (c.transport().shutdown_write()) {
        Result::Ok(_)  => { }
        Result::Err(_) => { }
    }
    mut resp: Response = match (await c.read_response()) {
        Result::Ok(v)  => { v }
        Result::Err(_) => { return -23; }
    };
    return resp.status.as_u16() as i64;
}

async function hs_truncated(listener: TcpListener, port: u16) -> i64 {
    mut s: HttpServer = HttpServer::new(SocketAddr::localhost_v4(port), hs_echo_path);
    const sel: Selected<Result<(), IoError>, i64> =
        await Futures::select(s.run_on(listener), hs_truncated_client(port));
    return match (sel) {
        Selected::First(_)  => { -1 }
        Selected::Second(v) => { v }
    };
}

![test]
function server_answers_a_truncated_request_with_400() -> Result<(), TestError> {
    mut l: TcpListener = match (hs_bind()) {
        Result::Ok(v)  => { v }
        Result::Err(_) => { return bail(Str::new("bind 127.0.0.1:0 failed")); }
    };
    const port: u16 = hs_port(&l);
    if (port == 0) { l.drop(); return bail(Str::new("local_addr failed")); }
    mut ex: Executor = Executor::new();
    const r: i64 = ex.block_on(hs_truncated(l, port));
    ex.drop();
    return expect_eq(r, 400 as i64);
}

/// Connect, then say NOTHING. The server's read cap is what has to end this;
/// the client only reports how long the server took to hang up. A server that
/// closed immediately (no cap applied, or the connection dropped for an
/// unrelated reason) reports a small number, which is why the assertion is a
/// lower bound rather than "it closed".
async function hs_idle_client(port: u16) -> i64 {
    mut sock: TcpStream = match (await TcpConnect::start(SocketAddr::localhost_v4(port))) {
        Result::Ok(v)  => { v }
        Result::Err(_) => { return -10; }
    };
    mut c: BufStream<TcpStream> = BufStream<TcpStream>::of(sock);
    const started: Instant = Instant::now();
    // Never answered: the server has no request to reply to, so this resolves
    // only when the capped read abandons the connection and closes it.
    match (await c.read_response()) {
        Result::Ok(_)  => { return -11; }
        Result::Err(_) => { }
    }
    return (started.elapsed().as_millis()) as i64;
}

/// A ONE-second cap, so the test spends about a second rather than the 30 the
/// default would cost.
async function hs_idle(listener: TcpListener, port: u16) -> i64 {
    mut s: HttpServer = HttpServer::new(SocketAddr::localhost_v4(port), hs_echo_path);
    s.with_read_timeout(1 as i64);
    const sel: Selected<Result<(), IoError>, i64> =
        await Futures::select(s.run_on(listener), hs_idle_client(port));
    return match (sel) {
        Selected::First(_)  => { -1 }
        Selected::Second(v) => { v }
    };
}

![test]
function server_read_timeout_closes_an_idle_connection() -> Result<(), TestError> {
    mut l: TcpListener = match (hs_bind()) {
        Result::Ok(v)  => { v }
        Result::Err(_) => { return bail(Str::new("bind 127.0.0.1:0 failed")); }
    };
    const port: u16 = hs_port(&l);
    if (port == 0) { l.drop(); return bail(Str::new("local_addr failed")); }
    mut ex: Executor = Executor::new();
    const ms: i64 = ex.block_on(hs_idle(l, port));
    ex.drop();
    if (ms < 0) { return bail(Str::new("idle client failed before the cap")); }
    // The cap is one second. A server that hangs up straight away cannot pass.
    return expect_true(ms >= 900, Str::new("read cap closed the connection early"));
}
