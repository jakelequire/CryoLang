///! Once — call_once runs the initializer exactly once, even when
///! invoked multiple times.

![config(testing)]
namespace CryoTests::Tests::Stdlib::SyncOnce;

import std::core::result;
import std::core::drop;
import std::sync::once;
import std::test::error;
import std::test::assert;

mut once_runs: i32 = 0;

function bump_once_counter() -> void {
    once_runs = once_runs + 1;
}

![test]
function call_once_runs_initializer_exactly_once() -> Result<(), TestError> {
    once_runs = 0;
    mut o: Once = Once::new();
    o.call_once(bump_once_counter);
    o.call_once(bump_once_counter);
    o.call_once(bump_once_counter);
    o.drop();
    match (expect_eq(once_runs, 1)) {
        Result::Ok(_)  => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

![test]
function independent_once_instances_each_run_once() -> Result<(), TestError> {
    once_runs = 0;
    mut o1: Once = Once::new();
    mut o2: Once = Once::new();
    o1.call_once(bump_once_counter);
    o2.call_once(bump_once_counter);
    o1.call_once(bump_once_counter);
    o2.call_once(bump_once_counter);
    o1.drop();
    o2.drop();
    match (expect_eq(once_runs, 2)) {
        Result::Ok(_)  => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}
