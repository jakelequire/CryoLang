///! Slice<T> - borrowed contiguous view.

![config(testing)]
namespace CryoTests::Tests::Stdlib::SliceT;

import std::core::result::{ Result };
import std::core::option::{ Option };
import std::core::slice::{ Slice };
import std::test::error::{ TestError };
import std::test::assert::{ expect, expect_eq };
import std::collections::str::{ Str };

![test]
function from_raw_records_length() -> Result<(), TestError> {
    mut buf: [i32; 3];
    buf[0] = 10;
    buf[1] = 20;
    buf[2] = 30;
    const s: Slice<i32> = Slice::from_raw(&buf[0], 3);
    const len: i64 = s.length();
    const want: i64 = 3;
    match (expect_eq(len, want)) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

![test]
function empty_slice_is_empty() -> Result<(), TestError> {
    mut buf: [i32; 1];
    buf[0] = 0;
    const s: Slice<i32> = Slice::from_raw(&buf[0], 0);
    const empty: boolean = s.is_empty();
    match (expect(empty,
        Str::new("zero-length slice is_empty"))) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

![test]
function get_in_range_returns_some() -> Result<(), TestError> {
    mut buf: [i32; 3];
    buf[0] = 10;
    buf[1] = 20;
    buf[2] = 30;
    const s: Slice<i32> = Slice::from_raw(&buf[0], 3);
    const v: Option<i32> = s.get(1);
    match (expect_eq(v.unwrap_or(-1), 20)) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

![test]
function get_out_of_range_returns_none() -> Result<(), TestError> {
    mut buf: [i32; 3];
    buf[0] = 10;
    buf[1] = 20;
    buf[2] = 30;
    const s: Slice<i32> = Slice::from_raw(&buf[0], 3);
    const v: Option<i32> = s.get(5);
    match (expect(!v.is_some(),
        Str::new("get(5) on length-3 should be None"))) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

![test]
function subslice_window() -> Result<(), TestError> {
    mut buf: [i32; 5];
    buf[0] = 1;
    buf[1] = 2;
    buf[2] = 3;
    buf[3] = 4;
    buf[4] = 5;
    const s: Slice<i32> = Slice::from_raw(&buf[0], 5);
    const sub: Slice<i32> = s.subslice(1, 4);
    const want: i64 = 3;
    match (expect_eq(sub.length(), want)) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    match (expect_eq(sub.get(0).unwrap_or(-1), 2)) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    match (expect_eq(sub.get(2).unwrap_or(-1), 4)) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

![test]
function iter_yields_each_element() -> Result<(), TestError> {
    mut buf: [i32; 3];
    buf[0] = 10;
    buf[1] = 20;
    buf[2] = 30;
    const s: Slice<i32> = Slice::from_raw(&buf[0], 3);
    mut it: implement Iterator<i32> = s.iter();
    mut sum: i32 = 0;
    mut count: u64 = 0;
    while (true) {
        match (it.next()) {
            Option::Some(v) => {
                sum = sum + v;
                count = count + 1;
            }
            Option::None => { break; }
        }
    }
    match (expect_eq(sum, 60)) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    const want_count: u64 = 3;
    match (expect_eq(count, want_count)) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

![test]
![should_panic]
function subslice_out_of_range_panics() -> Result<(), TestError> {
    mut buf: [i32; 3];
    buf[0] = 1;
    buf[1] = 2;
    buf[2] = 3;
    const s: Slice<i32> = Slice::from_raw(&buf[0], 3);
    const _: Slice<i32> = s.subslice(0, 100);
    return Result::Ok(());
}

![test]
function index_reads_and_writes_in_place() -> Result<(), TestError> {
    mut buf: [i32; 3];
    buf[0] = 1;
    buf[1] = 2;
    buf[2] = 3;
    mut s: Slice<i32> = Slice::from_raw(&buf[0], 3);
    expect_eq(s[0], 1)?;
    const last: u8 = 2;
    expect_eq(s[last], 3)?;
    s[1] = 20;
    s[1] += 1;
    expect_eq(buf[1], 21)?;
    return Result::Ok(());
}

![test]
![should_panic]
function index_past_the_end_panics() -> Result<(), TestError> {
    mut buf: [i32; 3];
    buf[0] = 1;
    buf[1] = 2;
    buf[2] = 3;
    const s: Slice<i32> = Slice::from_raw(&buf[0], 3);
    const _: i32 = s[3];
    return Result::Ok(());
}

![test]
![should_panic]
function negative_index_panics() -> Result<(), TestError> {
    mut buf: [i32; 3];
    buf[0] = 1;
    buf[1] = 2;
    buf[2] = 3;
    const s: Slice<i32> = Slice::from_raw(&buf[0], 3);
    const before: i64 = -1;
    const _: i32 = s[before];
    return Result::Ok(());
}

![test]
function slices_compare_by_content() -> Result<(), TestError> {
    const text: Str = Str::new("abcabc");
    const front: Slice<u8> = text.as_bytes().subslice(0, 3);
    const back: Slice<u8> = text.as_bytes().subslice(3, 6);
    const shorter: Slice<u8> = text.as_bytes().subslice(3, 5);
    expect(front == back, Str::new("equal content at different addresses"))?;
    expect(!(front == shorter), Str::new("different lengths"))?;
    expect(!(front == text.as_bytes().subslice(1, 4)), Str::new("different content"))?;
    return Result::Ok(());
}
