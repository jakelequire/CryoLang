///! Slice<T> — borrowed contiguous view.

![config(testing)]
namespace CryoTests::Tests::Stdlib::SliceT;

import std::core::result;
import std::core::option;
import std::core::slice;
import std::test::error;
import std::test::assert;

![test]
function from_raw_records_length() -> Result<(), TestError> {
    mut buf: i32[3];
    buf[0] = 10;
    buf[1] = 20;
    buf[2] = 30;
    const s: Slice<i32> = Slice::from_raw(&buf[0], 3);
    const len: u64 = s.length();
    const want: u64 = 3;
    match (expect_eq(len, want)) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

![test]
function empty_slice_is_empty() -> Result<(), TestError> {
    mut buf: i32[1];
    buf[0] = 0;
    const s: Slice<i32> = Slice::from_raw(&buf[0], 0);
    const empty: boolean = s.is_empty();
    match (expect(empty,
        Str::new("zero-length slice is_empty"))) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

![test]
function get_in_range_returns_some() -> Result<(), TestError> {
    mut buf: i32[3];
    buf[0] = 10;
    buf[1] = 20;
    buf[2] = 30;
    const s: Slice<i32> = Slice::from_raw(&buf[0], 3);
    const v: Option<i32> = s.get(1);
    match (expect_eq(v.unwrap_or(-1), 20)) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

![test]
function get_out_of_range_returns_none() -> Result<(), TestError> {
    mut buf: i32[3];
    buf[0] = 10;
    buf[1] = 20;
    buf[2] = 30;
    const s: Slice<i32> = Slice::from_raw(&buf[0], 3);
    const v: Option<i32> = s.get(5);
    match (expect(!v.is_some(),
        Str::new("get(5) on length-3 should be None"))) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

![test]
function subslice_window() -> Result<(), TestError> {
    mut buf: i32[5];
    buf[0] = 1;
    buf[1] = 2;
    buf[2] = 3;
    buf[3] = 4;
    buf[4] = 5;
    const s: Slice<i32> = Slice::from_raw(&buf[0], 5);
    const sub: Slice<i32> = s.subslice(1, 4);
    const want: u64 = 3;
    match (expect_eq(sub.length(), want)) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    match (expect_eq(sub.get(0).unwrap_or(-1), 2)) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    match (expect_eq(sub.get(2).unwrap_or(-1), 4)) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

![test]
function iter_yields_each_element() -> Result<(), TestError> {
    mut buf: i32[3];
    buf[0] = 10;
    buf[1] = 20;
    buf[2] = 30;
    const s: Slice<i32> = Slice::from_raw(&buf[0], 3);
    mut it: SliceIter<i32> = s.iter();
    mut sum: i32 = 0;
    mut count: u64 = 0;
    while (true) {
        match (it.next()) {
            Option::Some(v) => {
                sum = sum + v;
                count = count + 1;
            }
            Option::None => { break; }
        }
    }
    match (expect_eq(sum, 60)) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    const want_count: u64 = 3;
    match (expect_eq(count, want_count)) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

![test]
![should_panic]
function subslice_out_of_range_panics() -> Result<(), TestError> {
    mut buf: i32[3];
    buf[0] = 1;
    buf[1] = 2;
    buf[2] = 3;
    const s: Slice<i32> = Slice::from_raw(&buf[0], 3);
    const _: Slice<i32> = s.subslice(0, 100);
    return Result::Ok(());
}
