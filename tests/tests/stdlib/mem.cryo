///! core::mem - typed memory utilities (no allocation).

![config(testing)]
namespace CryoTests::Tests::Stdlib::MemT;

import std::core::result;
import std::core::mem;
import std::test::error;
import std::test::assert;

![test]
function copy_moves_bytes() -> Result<(), TestError> {
    mut src: i32[3];
    src[0] = 10;
    src[1] = 20;
    src[2] = 30;
    mut dst: i32[3];
    dst[0] = 0;
    dst[1] = 0;
    dst[2] = 0;
    mem::copy(&dst[0], &src[0], 3);
    match (expect_eq(dst[0], 10)) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    match (expect_eq(dst[1], 20)) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    match (expect_eq(dst[2], 30)) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

![test]
function copy_overlapping_handles_overlap() -> Result<(), TestError> {
    mut buf: i32[5];
    buf[0] = 1;
    buf[1] = 2;
    buf[2] = 3;
    buf[3] = 0;
    buf[4] = 0;
    // Copy [1,2,3] forward by one slot using the overlap-safe variant.
    mem::copy_overlapping(&buf[1], &buf[0], 3);
    match (expect_eq(buf[0], 1)) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    match (expect_eq(buf[1], 1)) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    match (expect_eq(buf[2], 2)) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    match (expect_eq(buf[3], 3)) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

![test]
function zero_clears_bytes() -> Result<(), TestError> {
    mut buf: i32[3];
    buf[0] = 11;
    buf[1] = 22;
    buf[2] = 33;
    mem::zero(&buf[0], 3);
    match (expect_eq(buf[0], 0)) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    match (expect_eq(buf[1], 0)) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    match (expect_eq(buf[2], 0)) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

![test]
function swap_exchanges_values() -> Result<(), TestError> {
    mut a: i32 = 1;
    mut b: i32 = 2;
    mem::swap(&a, &b);
    match (expect_eq(a, 2)) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    match (expect_eq(b, 1)) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

![test]
function is_aligned_zero_offset_against_one() -> Result<(), TestError> {
    // Every pointer is 1-aligned.
    mut x: i32 = 0;
    const aligned: boolean = mem::is_aligned(&x as void*, 1);
    match (expect(aligned,
        Str::new("any pointer is 1-aligned"))) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}
