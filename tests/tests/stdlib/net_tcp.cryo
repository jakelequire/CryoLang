///! TcpListener / TcpStream - loopback round-trip over 127.0.0.1 and [::1].
///!
///! Every operation that can wait is a future, so both ends run as two futures
///! joined inside ONE `Executor` — its reactor is what the accept and every read
///! register with. Each test binds an EPHEMERAL port (`:0`) and reads the
///! kernel-assigned port back via `TcpListener::local_addr()`, so concurrent runs
///! never collide and nothing is left to a fixed-port guess.
///!
///! What these cover that `net_tcp_conn` does not is the DIAL path rather than the
///! buffering: the `sockaddr_in6` packer and the AF_INET6 socket behind
///! `localhost_v6`, and a connect to a port nobody is listening on being refused
///! rather than hanging.

![config(testing)]
namespace CryoTests::Tests::Stdlib::NetTcp;

import std::core::result;
import std::core::option;
import std::core::slice;
import std::core::drop;
import std::collections::str;
import std::collections::array;
import std::future;
import std::io::error;
import std::io::traits;
import std::io::buf;
import std::net::addr::ip;
import std::net::addr::socket_addr;
import std::net::socket::tcp;
import std::ffi::libc;
import std::test::error;
import std::test::assert;
import std::future::executor;

// Every failure is a distinct negative number so a red test names its own step.

function ntcp_bytes_eq(a: &Array<u8>, text: string) -> boolean {
    const b: Slice<u8> = Str::new(text).as_bytes();
    if (a.length() != b.length()) { return false; }
    mut i: u64 = 0;
    while (i < a.length()) {
        mut x: u8 = 0;
        mut y: u8 = 1;
        match (a.get(i)) { Option::Some(v) => { x = v; } Option::None => { } }
        match (b.get(i)) { Option::Some(v) => { y = v; } Option::None => { } }
        if (x != y) { return false; }
        i = i + 1;
    }
    return true;
}

/// Accept one connection, read `ping`, answer `pong`. Returns 4 on success.
async function ntcp_serve(listener: TcpListener) -> i64 {
    mut acc: TcpAccepted = await TcpAccept::start(listener);
    mut lst: TcpListener = acc.take_listener();
    lst.drop();

    mut stream: TcpStream = TcpStream::from_fd(-1);
    match (acc.take_result()) {
        Result::Ok(s)  => { stream = s; }
        Result::Err(_) => { return -1; }
    }
    mut c: BufStream<TcpStream> = BufStream<TcpStream>::of(stream);

    mut got: Array<u8> = match (await c.read_exact(4)) {
        Result::Ok(v)  => { v }
        Result::Err(_) => { return -2; }
    };
    if (!ntcp_bytes_eq(&got, "ping")) { return -3; }

    match (c.queue<string>("pong")) { Result::Ok(_) => { } Result::Err(_) => { return -4; } }
    match (await c.flush())         { Result::Ok(_) => { } Result::Err(_) => { return -5; } }
    return 4;
}

/// Dial `addr`, send `ping`, read `pong`. Returns 4 on success.
async function ntcp_client(addr: SocketAddr) -> i64 {
    mut sock: TcpStream = match (await TcpConnect::start(addr)) {
        Result::Ok(v)  => { v }
        Result::Err(_) => { return -10; }
    };
    mut c: BufStream<TcpStream> = BufStream<TcpStream>::of(sock);

    match (c.queue<string>("ping")) { Result::Ok(_) => { } Result::Err(_) => { return -11; } }
    match (await c.flush())         { Result::Ok(_) => { } Result::Err(_) => { return -12; } }

    mut got: Array<u8> = match (await c.read_exact(4)) {
        Result::Ok(v)  => { v }
        Result::Err(_) => { return -13; }
    };
    if (!ntcp_bytes_eq(&got, "pong")) { return -14; }
    return 4;
}

async function ntcp_round(addr: SocketAddr, listener: TcpListener) -> i64 {
    const pair: (i64, i64) = await Futures::join(ntcp_serve(listener), ntcp_client(addr));
    if (pair.0 != 4) { return pair.0; }
    if (pair.1 != 4) { return pair.1; }
    return 0;
}

/// A connect to a port nobody is listening on must be REFUSED, not parked.
async function ntcp_refused(addr: SocketAddr) -> i64 {
    match (await TcpConnect::start(addr)) {
        Result::Ok(s)  => {
            mut unexpected: TcpStream = s;
            unexpected.drop();
            return -20;
        }
        Result::Err(_) => { return 1; }
    }
}

/// Bind an ephemeral port and put the listener in non-blocking mode, which
/// `TcpAccept` requires: a blocking listener would stall an executor's whole
/// worker thread inside `accept`.
function ntcp_bind(addr: SocketAddr) -> Result<TcpListener, IoError> {
    mut l: TcpListener = TcpListener::bind(addr)?;
    l.set_nonblocking(true)?;
    return Result::Ok(l);
}

![test]
function loopback_round_trip() -> Result<(), TestError> {
    mut listener: TcpListener = match (ntcp_bind(SocketAddr::localhost_v4(0))) {
        Result::Ok(l)  => { l }
        Result::Err(_) => { return bail(Str::new("bind 127.0.0.1:0 failed")); }
    };
    const port: u16 = match (listener.local_addr()) {
        Result::Ok(a)  => { a.port }
        Result::Err(_) => { listener.drop(); return bail(Str::new("local_addr failed")); }
    };
    mut ex: Executor = Executor::new();
    const r: i64 = ex.block_on(ntcp_round(SocketAddr::localhost_v4(port), listener));
    ex.drop();
    return expect_eq(r, 0 as i64);
}

/// IPv6 loopback round-trip over [::1]. Exercises the full v6 dial path end to
/// end: the sockaddr_in6 packer, the AF_INET6 socket, and connect/accept.
/// Guarded: if the host has no IPv6 loopback, bind fails and the test skips
/// (returns Ok) rather than flaking.
![test]
function loopback_round_trip_v6() -> Result<(), TestError> {
    mut listener: TcpListener = match (ntcp_bind(SocketAddr::localhost_v6(0))) {
        Result::Ok(l)  => { l }
        Result::Err(_) => { return Result::Ok(()); }   // no v6 loopback -> skip
    };
    const port: u16 = match (listener.local_addr()) {
        Result::Ok(a)  => { a.port }
        Result::Err(_) => { listener.drop(); return bail(Str::new("v6 local_addr failed")); }
    };
    mut ex: Executor = Executor::new();
    const r: i64 = ex.block_on(ntcp_round(SocketAddr::localhost_v6(port), listener));
    ex.drop();
    return expect_eq(r, 0 as i64);
}

![test]
function connect_to_unbound_port_fails() -> Result<(), TestError> {
    // Bind an ephemeral port, learn it, then release it; connecting to the
    // now-unbound port should be refused. Hermetic (no fixed-port guess).
    mut listener: TcpListener = match (ntcp_bind(SocketAddr::localhost_v4(0))) {
        Result::Ok(l)  => { l }
        Result::Err(_) => { return bail(Str::new("bind 127.0.0.1:0 failed")); }
    };
    const port: u16 = match (listener.local_addr()) {
        Result::Ok(a)  => { a.port }
        Result::Err(_) => { listener.drop(); return bail(Str::new("local_addr failed")); }
    };
    listener.drop();   // release the port so the connect is refused
    mut ex: Executor = Executor::new();
    const r: i64 = ex.block_on(ntcp_refused(SocketAddr::localhost_v4(port)));
    ex.drop();
    return expect_eq(r, 1 as i64);
}
