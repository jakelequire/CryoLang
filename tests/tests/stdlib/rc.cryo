///! Rc<T> - shared single-threaded reference counting.

![config(testing)]
namespace CryoTests::Tests::Stdlib::RcT;

import std::core::result;
import std::core::option;
import std::collections::str;
import std::alloc::rc;
import std::test::error;
import std::test::assert;

![test]
function new_rc_strong_count_is_one() -> Result<(), TestError> {
    mut r: Rc<i32> = Rc::new(42);
    const count: u64 = r.strong_count();
    r.drop();
    const want: u64 = 1;
    match (expect_eq(count, want)) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

![test]
function clone_increments_strong_count() -> Result<(), TestError> {
    mut a: Rc<i32> = Rc::new(7);
    mut b: Rc<i32> = a.clone();
    const count: u64 = a.strong_count();
    b.drop();
    a.drop();
    const want: u64 = 2;
    match (expect_eq(count, want)) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

![test]
function clones_share_value() -> Result<(), TestError> {
    mut a: Rc<i32> = Rc::new(123);
    mut b: Rc<i32> = a.clone();
    const got_a: i32 = *a.as_ptr();
    const got_b: i32 = *b.as_ptr();
    b.drop();
    a.drop();
    match (expect_eq(got_a, 123)) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    match (expect_eq(got_b, 123)) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

![test]
function drop_clone_decrements_count() -> Result<(), TestError> {
    mut a: Rc<i32> = Rc::new(0);
    mut b: Rc<i32> = a.clone();
    mut c: Rc<i32> = a.clone();
    const count_before: u64 = a.strong_count();
    c.drop();
    const count_after: u64 = a.strong_count();
    b.drop();
    a.drop();
    const want_before: u64 = 3;
    const want_after: u64 = 2;
    match (expect_eq(count_before, want_before)) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    match (expect_eq(count_after, want_after)) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

![test]
function mutate_through_pointer_is_seen_by_clones() -> Result<(), TestError> {
    mut a: Rc<i32> = Rc::new(1);
    mut b: Rc<i32> = a.clone();
    *a.as_ptr() = 99;
    const got: i32 = *b.as_ptr();
    b.drop();
    a.drop();
    match (expect_eq(got, 99)) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

// A type whose destructor is an INLINE `drop` method rather than
// `implement trait Drop`. Counts how many times drop runs.
type struct InlineDropRc {
    counter_ptr: i32*;
    drop(mut &this) -> void { *this.counter_ptr = *this.counter_ptr + 1; }
}

// A payload whose destructor is an inline `drop` method must satisfy
// Rc's `where T: Drop`, so `Rc<InlineDropRc>` instantiates
// and runs the inner drop when the last handle is dropped (without this,
// `E0636: no method 'drop' found` would fire at codegen).
![test]
function rc_inline_drop_payload_compiles_and_drops() -> Result<(), TestError> {
    mut count: i32 = 0;
    mut r: Rc<InlineDropRc> = Rc::new(InlineDropRc { counter_ptr: &count });
    r.drop();
    return expect_eq(count, 1);
}

// ============================================================================
// Weak<T> - non-owning references
//
// These tests use a test-local `Payload` type rather than a builtin like
// `i32`. Each generic instance (`Rc<Payload>`, `Weak<Payload>`) is then owned
// by THIS object and its methods are emitted here, the same way
// `Rc<InlineDropRc>` above already links. A `Weak<i32>` would instead be
// designated to the stdlib's `alloc::allocator` object, which is not emitted
// for a brand-new generic reached only through `Rc::downgrade` - so it would
// fail to link in the test harness even though a normal `cryo build` of a
// program using `Weak<i32>` emits and links it fine.
// ============================================================================

// A small owned payload with an inline (no-op) destructor, satisfying Rc's
// `where T: Drop`. `v` lets the value tests read something concrete.
type struct Payload {
    v: i32;
    drop(mut &this) -> void { }
}

![test]
function downgrade_does_not_bump_strong() -> Result<(), TestError> {
    mut r: Rc<Payload> = Rc::new(Payload { v: 11 });
    mut w: Weak<Payload> = r.downgrade();
    const strong: u64 = r.strong_count();
    const weak: u64 = r.weak_count();
    w.drop();
    r.drop();
    expect_eq(strong, 1u64)?;
    return expect_eq(weak, 1u64);
}

![test]
function upgrade_while_alive_returns_some() -> Result<(), TestError> {
    mut r: Rc<Payload> = Rc::new(Payload { v: 11 });
    mut w: Weak<Payload> = r.downgrade();
    mut strong_during: u64 = 0;
    mut val: i32 = 0;
    match (w.upgrade()) {
        Option::Some(up) => {
            mut u: Rc<Payload> = up;
            strong_during = u.strong_count();
            val = (*u.as_ptr()).v;
            u.drop();
        }
        Option::None => { }
    }
    const strong_after: u64 = r.strong_count();
    w.drop();
    r.drop();
    expect_eq(strong_during, 2u64)?;   // upgrade bumped strong to 2
    expect_eq(val, 11)?;
    return expect_eq(strong_after, 1u64);   // and back to 1 once its Rc dropped
}

![test]
function upgrade_after_last_strong_is_none() -> Result<(), TestError> {
    mut r: Rc<Payload> = Rc::new(Payload { v: 5 });
    mut w: Weak<Payload> = r.downgrade();
    r.drop();                         // last strong: value dies, header kept
    mut got_none: boolean = false;
    match (w.upgrade()) {
        Option::Some(up) => { mut u: Rc<Payload> = up; u.drop(); }
        Option::None    => { got_none = true; }
    }
    w.drop();
    return expect_true(got_none, Str::new("upgrade after last strong drop is None"));
}

// Two-phase teardown: the value's destructor runs exactly once (on the
// strong->0 transition), NOT again when the surviving Weak frees the header.
![test]
function value_dropped_once_with_outstanding_weak() -> Result<(), TestError> {
    mut count: i32 = 0;
    mut r: Rc<InlineDropRc> = Rc::new(InlineDropRc { counter_ptr: &count });
    mut w: Weak<InlineDropRc> = r.downgrade();
    r.drop();
    const after_strong: i32 = count;   // value dropped once here
    w.drop();
    const after_weak: i32 = count;     // header freed; no second drop
    expect_eq(after_strong, 1)?;
    return expect_eq(after_weak, 1);
}

// get_mut is exclusive: an outstanding Weak (which could upgrade) blocks it.
![test]
function get_mut_blocked_by_outstanding_weak() -> Result<(), TestError> {
    mut r: Rc<Payload> = Rc::new(Payload { v: 3 });
    mut w: Weak<Payload> = r.downgrade();
    mut blocked: boolean = false;
    match (r.get_mut()) {
        Option::Some(_) => { }
        Option::None    => { blocked = true; }
    }
    w.drop();                          // no more weaks: now unique
    mut unlocked: boolean = false;
    match (r.get_mut()) {
        Option::Some(p) => { (*p).v = 8; unlocked = true; }
        Option::None    => { }
    }
    const final_val: i32 = (*r.as_ptr()).v;
    r.drop();
    expect_true(blocked, Str::new("get_mut blocked while a Weak exists"))?;
    expect_true(unlocked, Str::new("get_mut allowed once unique"))?;
    return expect_eq(final_val, 8);
}

![test]
function dangling_weak_upgrades_to_none() -> Result<(), TestError> {
    mut w: Weak<Payload> = Weak<Payload>::new();
    mut got_none: boolean = false;
    match (w.upgrade()) {
        Option::Some(up) => { mut u: Rc<Payload> = up; u.drop(); }
        Option::None    => { got_none = true; }
    }
    w.drop();
    return expect_true(got_none, Str::new("dangling Weak::new upgrades to None"));
}

![test]
function weak_clone_bumps_weak_count() -> Result<(), TestError> {
    mut r: Rc<Payload> = Rc::new(Payload { v: 1 });
    mut w1: Weak<Payload> = r.downgrade();
    mut w2: Weak<Payload> = w1.clone();
    const wc: u64 = r.weak_count();
    w2.drop();
    w1.drop();
    r.drop();
    return expect_eq(wc, 2u64);
}
