///! The path text a `string` still answers for itself: `join` with a
///! separator, `extension` of the last component, and `split_char` into
///! fresh copies, each read through `Str` and copied into the answer.

![config(testing)]
namespace CryoTests::Tests::Stdlib::StringPathText;

import std::core::result::{ Result };
import std::collections::str::{ Str };
import std::test::error::{ TestError };
import std::test::assert::{ expect_equal };

/// One separator between the two, none added after one already there, and
/// an empty side or an absolute segment answered as it is.
![test]
function join_puts_one_separator_between() -> Result<(), TestError> {
    const base: string = "src";
    expect_equal(Str::new(base.join("main.cryo")), Str::new("src/main.cryo"))?;
    const slashed: string = "src/";
    expect_equal(Str::new(slashed.join("main.cryo")), Str::new("src/main.cryo"))?;
    const backslashed: string = "src\\";
    expect_equal(Str::new(backslashed.join("main.cryo")), Str::new("src\\main.cryo"))?;
    const empty: string = "";
    expect_equal(Str::new(empty.join("main.cryo")), Str::new("main.cryo"))?;
    expect_equal(Str::new(base.join("")), Str::new("src"))?;
    return expect_equal(Str::new(base.join("/etc")), Str::new("/etc"));
}

/// The text after the last component's last dot; none for a name with no
/// dot, or whose only dot leads it, and a directory's dot is not the
/// file's.
![test]
function extension_is_the_last_components_suffix() -> Result<(), TestError> {
    const plain: string = "dir/file.txt";
    expect_equal(Str::new(plain.extension()), Str::new("txt"))?;
    const doubled: string = "a\\b.tar.gz";
    expect_equal(Str::new(doubled.extension()), Str::new("gz"))?;
    const dotted_directory: string = "dir.d/file";
    expect_equal(Str::new(dotted_directory.extension()), Str::new(""))?;
    const hidden: string = "a/.gitignore";
    expect_equal(Str::new(hidden.extension()), Str::new(""))?;
    const bare_hidden: string = ".gitignore";
    expect_equal(Str::new(bare_hidden.extension()), Str::new(""))?;
    const none: string = "Makefile";
    return expect_equal(Str::new(none.extension()), Str::new(""));
}

/// One piece more than there are separators, empty pieces kept.
![test]
function split_char_keeps_every_piece() -> Result<(), TestError> {
    const text: string = "a,,bc";
    const pieces: [string] = text.split_char(44 as i8);
    expect_equal(pieces.length(), 3)?;
    expect_equal(Str::new(pieces[0]), Str::new("a"))?;
    expect_equal(Str::new(pieces[1]), Str::new(""))?;
    expect_equal(Str::new(pieces[2]), Str::new("bc"))?;
    const empty: string = "";
    return expect_equal(empty.split_char(44 as i8).length(), 1);
}
