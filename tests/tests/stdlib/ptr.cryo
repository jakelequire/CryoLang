///! NonNull<T> - non-null pointer wrapper.

![config(testing)]
namespace CryoTests::Tests::Stdlib::PtrT;

import std::core::result;
import std::core::ptr;
import std::test::error;
import std::test::assert;

![test]
function non_null_round_trips_pointer() -> Result<(), TestError> {
    mut x: i32 = 42;
    const nn: NonNull<i32> = NonNull::new(&x);
    const got: i32 = *nn.as_ptr();
    match (expect_eq(got, 42)) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

![test]
function non_null_offset_walks_array() -> Result<(), TestError> {
    mut buf: i32[3];
    buf[0] = 10;
    buf[1] = 20;
    buf[2] = 30;
    const start: NonNull<i32> = NonNull::new(&buf[0]);
    const next: NonNull<i32> = start.offset(1);
    const got: i32 = *next.as_ptr();
    match (expect_eq(got, 20)) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

![test]
function non_null_offset_negative() -> Result<(), TestError> {
    mut buf: i32[3];
    buf[0] = 10;
    buf[1] = 20;
    buf[2] = 30;
    const last: NonNull<i32> = NonNull::new(&buf[2]);
    const step: i64 = -2 as i64;
    const back: NonNull<i32> = last.offset(step);
    const got: i32 = *back.as_ptr();
    match (expect_eq(got, 10)) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

![test]
![should_panic]
function non_null_new_panics_on_null() -> Result<(), TestError> {
    const raw: i32* = null;
    const _: NonNull<i32> = NonNull::new(raw);
    return Result::Ok(());
}
