///! `+` on text: a `String` or a `Str` on the left, any text or a `char`
///! on the right, gives a new `String` holding both, and leaves both sides
///! as they were. `+=` goes through the same operator.

![config(testing)]
namespace CryoTests::Tests::Stdlib::TextConcatenation;

import std::collections::{ Str, String };
import std::test::error::{ TestError };
import std::test::assert::{ expect_equal };

![test]
function a_string_adds_any_text_on_its_right() -> Result<(), TestError> {
    const name: String = String::from("Ada");
    const literal: String = name + ", welcome";
    expect_equal(literal.as_str(), Str::new("Ada, welcome"))?;
    const view: String = name + Str::new("!");
    expect_equal(view.as_str(), Str::new("Ada!"))?;
    const other: String = String::from(" Lovelace");
    const owned: String = name + other;
    expect_equal(owned.as_str(), Str::new("Ada Lovelace"))?;
    const letter: String = name + 'h';
    expect_equal(letter.as_str(), Str::new("Adah"))?;
    return Result::Ok(());
}

![test]
function adding_leaves_both_sides_as_they_were() -> Result<(), TestError> {
    const left: String = String::from("left");
    const right: String = String::from("right");
    const both: String = left + right;
    expect_equal(both.as_str(), Str::new("leftright"))?;
    expect_equal(left.as_str(), Str::new("left"))?;
    expect_equal(right.as_str(), Str::new("right"))?;
    return Result::Ok(());
}

![test]
function a_str_adds_text_into_a_new_string() -> Result<(), TestError> {
    const first: Str = Str::new("key");
    const joined: String = first + Str::new("=value");
    expect_equal(joined.as_str(), Str::new("key=value"))?;
    const literal: String = first + "s";
    expect_equal(literal.as_str(), Str::new("keys"))?;
    expect_equal(first, Str::new("key"))?;
    return Result::Ok(());
}

![test]
function additions_chain_left_to_right() -> Result<(), TestError> {
    const user: String = String::from("ada");
    const host: Str = Str::new("example.org");
    const address: String = user + "@" + host;
    expect_equal(address.as_str(), Str::new("ada@example.org"))?;
    return Result::Ok(());
}

![test]
function add_assign_replaces_the_string_with_the_sum() -> Result<(), TestError> {
    mut line: String = String::from("a");
    line += "b";
    line += Str::new("c");
    line += 'd';
    expect_equal(line.as_str(), Str::new("abcd"))?;
    return Result::Ok(());
}
