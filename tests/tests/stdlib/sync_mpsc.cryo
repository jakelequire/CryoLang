///! mpsc - the multi-producer / single-consumer channel.
///!
///! On one thread we pin down the queue contract: FIFO delivery, the
///! non-blocking `try_recv` Empty/Disconnected distinction, and that a
///! drained channel with no senders left reports Disconnected.  `recv()`
///! blocks while senders remain, so every single-threaded `recv` here is
///! issued only after a value has been enqueued.  A bounded channel's full
///! queue is shown with a second thread: its `send` waits for the receiver
///! to take a value, and returns the value once the receiver is gone.

![config(testing)]
namespace CryoTests::Tests::Stdlib::SyncMpsc;

import std::core::result::{ Result };
import std::core::option;
import std::core::drop;
import std::core::mem;
import std::collections::str::{ Str };
import std::collections::pair::{ Pair };
import std::sync::mpsc;
import std::sync::mpsc::{ Channel, Receiver, RecvError, Sender, TryRecvError };
import std::sync::atomic::{ Atomic, MemoryOrder };
import std::thread;
import std::test::error::{ TestError };
import std::test::assert::{ bail, expect_eq };

/// Send a value and fail the test if the receiver was already gone.
function send_ok(tx: &Sender<i32>, v: i32) -> Result<(), TestError> {
    match (tx.send(v)) {
        Result::Ok(_)  => { return Result::Ok(()); }
        Result::Err(_) => { return bail(Str::new("send to an open channel must succeed")); }
    }
}

/// Receive (blocking) and assert the value equals `want`.
function recv_eq(rx: &Receiver<i32>, want: i32) -> Result<(), TestError> {
    match (rx.recv()) {
        Result::Ok(v)  => { return expect_eq(v, want); }
        Result::Err(_) => { return bail(Str::new("recv must return a queued value, not Disconnected")); }
    }
}

![test]
function mpsc_delivers_in_fifo_order() -> Result<(), TestError> {
    const { first: tx, second: rx }: Pair<Sender<i32>, Receiver<i32>> = Channel::unbounded::<i32>();

    send_ok(&tx, 10)?;
    send_ok(&tx, 20)?;
    send_ok(&tx, 30)?;

    recv_eq(&rx, 10)?;
    recv_eq(&rx, 20)?;
    recv_eq(&rx, 30)?;

    return Result::Ok(());
}

![test]
function mpsc_try_recv_empty_then_disconnected() -> Result<(), TestError> {
    const { first: tx, second: rx }: Pair<Sender<i32>, Receiver<i32>> = Channel::unbounded::<i32>();

    // No value queued, but a sender is alive -> Empty.
    match (rx.try_recv()) {
        Result::Ok(_)  => { return bail(Str::new("try_recv on an empty open channel must be Err(Empty)")); }
        Result::Err(e) => {
            match (e) {
                TryRecvError::Empty        => { }
                TryRecvError::Disconnected => { return bail(Str::new("expected Empty while a sender is alive, got Disconnected")); }
            }
        }
    }

    // Drop the only sender; with the queue drained, the channel is now
    // disconnected.
    mem::drop(tx);
    match (rx.try_recv()) {
        Result::Ok(_)  => { return bail(Str::new("try_recv after all senders dropped must be Err(Disconnected)")); }
        Result::Err(e) => {
            match (e) {
                TryRecvError::Disconnected => { }
                TryRecvError::Empty        => { return bail(Str::new("expected Disconnected after the last sender dropped")); }
            }
        }
    }

    return Result::Ok(());
}

![test]
function mpsc_recv_after_senders_dropped_is_disconnected() -> Result<(), TestError> {
    const { first: tx, second: rx }: Pair<Sender<i32>, Receiver<i32>> = Channel::unbounded::<i32>();

    // Queue one value, drop the sender, then drain. The buffered value comes
    // out first; the next recv sees no value and no senders -> Disconnected.
    send_ok(&tx, 7)?;
    mem::drop(tx);

    recv_eq(&rx, 7)?;
    match (rx.recv()) {
        Result::Ok(_)  => { return bail(Str::new("recv on a drained, sender-less channel must be Err(Disconnected)")); }
        Result::Err(e) => {
            match (e) {
                RecvError::Disconnected => { }
            }
        }
    }

    return Result::Ok(());
}

![test]
function mpsc_multiple_producers_via_clone() -> Result<(), TestError> {
    const { first: tx1, second: rx }: Pair<Sender<i32>, Receiver<i32>> = Channel::unbounded::<i32>();
    const tx2: Sender<i32> = tx1.clone();

    send_ok(&tx1, 1)?;
    send_ok(&tx2, 2)?;

    recv_eq(&rx, 1)?;
    recv_eq(&rx, 2)?;

    // Dropping one of two senders must NOT disconnect the channel.
    mem::drop(tx1);
    match (rx.try_recv()) {
        Result::Ok(_)  => { return bail(Str::new("no value was queued; try_recv should be Empty")); }
        Result::Err(e) => {
            match (e) {
                TryRecvError::Empty        => { }
                TryRecvError::Disconnected => { return bail(Str::new("one live sender remains; must be Empty not Disconnected")); }
            }
        }
    }

    return Result::Ok(());
}

![test]
function mpsc_bounded_holds_up_to_its_capacity() -> Result<(), TestError> {
    const { first: tx, second: rx }: Pair<Sender<i32>, Receiver<i32>> = Channel::bounded::<i32>(2);
    send_ok(&tx, 1)?;
    send_ok(&tx, 2)?;
    recv_eq(&rx, 1)?;
    send_ok(&tx, 3)?;
    recv_eq(&rx, 2)?;
    recv_eq(&rx, 3)?;
    return Result::Ok(());
}

![test]
function mpsc_bounded_send_waits_for_room() -> Result<(), TestError> {
    const { first: tx, second: rx }: Pair<Sender<i32>, Receiver<i32>> = Channel::bounded::<i32>(1);
    send_ok(&tx, 1)?;
    // The queue is full, so the worker's send waits until the first value
    // is taken; `through` turns on only once that send has returned.
    const through: Atomic<u32> = Atomic::<u32>::new(0);
    const through_pointer: Atomic<u32>* = &through;
    const worker = thread::spawn(move () -> i32 {
        mut sent: i32 = 0;
        if (tx.send(2).is_ok()) { sent = sent + 1; }
        through_pointer.store(1, MemoryOrder::SeqCst);
        if (tx.send(3).is_ok()) { sent = sent + 1; }
        return sent;
    });
    thread::sleep_ms(50);
    expect_eq(through.load(MemoryOrder::SeqCst), 0)?;
    recv_eq(&rx, 1)?;
    recv_eq(&rx, 2)?;
    recv_eq(&rx, 3)?;
    expect_eq(worker.join(), 2)?;
    return Result::Ok(());
}

![test]
function mpsc_bounded_send_returns_the_value_when_the_receiver_goes() -> Result<(), TestError> {
    const { first: tx, second: rx }: Pair<Sender<i32>, Receiver<i32>> = Channel::bounded::<i32>(1);
    send_ok(&tx, 1)?;
    // The worker waits for room; dropping the receiver wakes it with the
    // value handed back.
    const worker = thread::spawn(move () -> i32 {
        match (tx.send(5)) {
            Result::Ok(_)  => { return -1; }
            Result::Err(e) => { return e.value; }
        }
    });
    thread::sleep_ms(30);
    mem::drop(rx);
    expect_eq(worker.join(), 5)?;
    return Result::Ok(());
}

![test]
![should_panic]
function mpsc_bounded_refuses_no_capacity() -> Result<(), TestError> {
    Channel::bounded::<i32>(0);
    return Result::Ok(());
}
