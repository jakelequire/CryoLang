///! mpsc - the multi-producer / single-consumer channel.
///!
///! On one thread we pin down the queue contract: FIFO delivery, the
///! non-blocking `try_receive` Empty/Disconnected distinction, and that a
///! drained channel with no senders left reports Disconnected.  `receive()`
///! blocks while senders remain, so every single-threaded `receive` here is
///! issued only after a value has been enqueued.  A bounded channel's full
///! queue is shown with a second thread: its `send` waits for the receiver
///! to take a value, and returns the value once the receiver is gone.

![config(testing)]
namespace CryoTests::Tests::Stdlib::SyncMpsc;

import std::core::result::{ Result };
import std::core::option;
import std::core::drop;
import std::core::mem;
import std::collections::str::{ Str };
import std::collections::pair::{ Pair };
import std::sync::channel;
import std::sync::channel::{ Channel, Receiver, ReceiveError, Sender, TryReceiveError, TrySendError };
import std::sync::atomic::{ Atomic, MemoryOrder };
import std::thread;
import std::time::duration::{ Duration };
import std::test::error::{ TestError };
import std::test::assert::{ bail, expect_equal };

/// Send a value and fail the test if the receiver was already gone.
function send_ok(tx: &Sender<i32>, v: i32) -> Result<(), TestError> {
    match (tx.send(v)) {
        Result::Ok(_)  => { return Result::Ok(()); }
        Result::Err(_) => { return bail(Str::new("send to an open channel must succeed")); }
    }
}

/// Receive (blocking) and assert the value equals `want`.
function receive_equals(rx: &Receiver<i32>, want: i32) -> Result<(), TestError> {
    match (rx.receive()) {
        Result::Ok(v)  => { return expect_equal(v, want); }
        Result::Err(_) => { return bail(Str::new("receive must return a queued value, not Disconnected")); }
    }
}

![test]
function mpsc_delivers_in_fifo_order() -> Result<(), TestError> {
    const { first: tx, second: rx }: Pair<Sender<i32>, Receiver<i32>> = Channel::unbounded::<i32>();

    send_ok(&tx, 10)?;
    send_ok(&tx, 20)?;
    send_ok(&tx, 30)?;

    receive_equals(&rx, 10)?;
    receive_equals(&rx, 20)?;
    receive_equals(&rx, 30)?;

    return Result::Ok(());
}

![test]
function mpsc_try_receive_empty_then_disconnected() -> Result<(), TestError> {
    const { first: tx, second: rx }: Pair<Sender<i32>, Receiver<i32>> = Channel::unbounded::<i32>();

    // No value queued, but a sender is alive -> Empty.
    match (rx.try_receive()) {
        Result::Ok(_)  => { return bail(Str::new("try_receive on an empty open channel must be Err(Empty)")); }
        Result::Err(e) => {
            match (e) {
                TryReceiveError::Empty        => { }
                TryReceiveError::Disconnected => { return bail(Str::new("expected Empty while a sender is alive, got Disconnected")); }
            }
        }
    }

    // Drop the only sender; with the queue drained, the channel is now
    // disconnected.
    mem::drop(tx);
    match (rx.try_receive()) {
        Result::Ok(_)  => { return bail(Str::new("try_receive after all senders dropped must be Err(Disconnected)")); }
        Result::Err(e) => {
            match (e) {
                TryReceiveError::Disconnected => { }
                TryReceiveError::Empty        => { return bail(Str::new("expected Disconnected after the last sender dropped")); }
            }
        }
    }

    return Result::Ok(());
}

![test]
function mpsc_receive_after_senders_dropped_is_disconnected() -> Result<(), TestError> {
    const { first: tx, second: rx }: Pair<Sender<i32>, Receiver<i32>> = Channel::unbounded::<i32>();

    // Queue one value, drop the sender, then drain. The buffered value comes
    // out first; the next receive sees no value and no senders -> Disconnected.
    send_ok(&tx, 7)?;
    mem::drop(tx);

    receive_equals(&rx, 7)?;
    match (rx.receive()) {
        Result::Ok(_)  => { return bail(Str::new("receive on a drained, sender-less channel must be Err(Disconnected)")); }
        Result::Err(e) => {
            match (e) {
                ReceiveError::Disconnected => { }
            }
        }
    }

    return Result::Ok(());
}

![test]
function mpsc_multiple_producers_via_clone() -> Result<(), TestError> {
    const { first: tx1, second: rx }: Pair<Sender<i32>, Receiver<i32>> = Channel::unbounded::<i32>();
    const tx2: Sender<i32> = tx1.clone();

    send_ok(&tx1, 1)?;
    send_ok(&tx2, 2)?;

    receive_equals(&rx, 1)?;
    receive_equals(&rx, 2)?;

    // Dropping one of two senders must NOT disconnect the channel.
    mem::drop(tx1);
    match (rx.try_receive()) {
        Result::Ok(_)  => { return bail(Str::new("no value was queued; try_receive should be Empty")); }
        Result::Err(e) => {
            match (e) {
                TryReceiveError::Empty        => { }
                TryReceiveError::Disconnected => { return bail(Str::new("one live sender remains; must be Empty not Disconnected")); }
            }
        }
    }

    return Result::Ok(());
}

![test]
function mpsc_bounded_holds_up_to_its_capacity() -> Result<(), TestError> {
    const { first: tx, second: rx }: Pair<Sender<i32>, Receiver<i32>> = Channel::bounded::<i32>(2);
    send_ok(&tx, 1)?;
    send_ok(&tx, 2)?;
    receive_equals(&rx, 1)?;
    send_ok(&tx, 3)?;
    receive_equals(&rx, 2)?;
    receive_equals(&rx, 3)?;
    return Result::Ok(());
}

![test]
function mpsc_bounded_send_waits_for_room() -> Result<(), TestError> {
    const { first: tx, second: rx }: Pair<Sender<i32>, Receiver<i32>> = Channel::bounded::<i32>(1);
    send_ok(&tx, 1)?;
    // The queue is full, so the worker's send waits until the first value
    // is taken; `through` turns on only once that send has returned.
    const through: Atomic<u32> = Atomic::<u32>::new(0);
    const through_pointer: Atomic<u32>* = &through;
    const worker = thread::spawn(move () -> i32 {
        mut sent: i32 = 0;
        if (tx.send(2).is_ok()) { sent = sent + 1; }
        through_pointer.store(1, MemoryOrder::SeqCst);
        if (tx.send(3).is_ok()) { sent = sent + 1; }
        return sent;
    });
    thread::sleep(Duration::from_milliseconds(50));
    expect_equal(through.load(MemoryOrder::SeqCst), 0)?;
    receive_equals(&rx, 1)?;
    receive_equals(&rx, 2)?;
    receive_equals(&rx, 3)?;
    expect_equal(worker.join(), 2)?;
    return Result::Ok(());
}

![test]
function mpsc_bounded_send_returns_the_value_when_the_receiver_goes() -> Result<(), TestError> {
    const { first: tx, second: rx }: Pair<Sender<i32>, Receiver<i32>> = Channel::bounded::<i32>(1);
    send_ok(&tx, 1)?;
    // The worker waits for room; dropping the receiver wakes it with the
    // value handed back.
    const worker = thread::spawn(move () -> i32 {
        match (tx.send(5)) {
            Result::Ok(_)  => { return -1; }
            Result::Err(e) => { return e.value; }
        }
    });
    thread::sleep(Duration::from_milliseconds(30));
    mem::drop(rx);
    expect_equal(worker.join(), 5)?;
    return Result::Ok(());
}

![test]
function mpsc_try_send_hands_back_the_value_when_full_or_disconnected() -> Result<(), TestError> {
    const { first: tx, second: rx }: Pair<Sender<i32>, Receiver<i32>> = Channel::bounded::<i32>(1);
    match (tx.try_send(1)) {
        Result::Ok(_)  => { }
        Result::Err(_) => { return bail(Str::new("try_send into an empty open channel must queue the value")); }
    }
    match (tx.try_send(2)) {
        Result::Ok(_)  => { return bail(Str::new("try_send into a full channel must not queue the value")); }
        Result::Err(e) => {
            match (e) {
                TrySendError::Full(value)     => { expect_equal(value, 2)?; }
                TrySendError::Disconnected(_) => { return bail(Str::new("the receiver is alive; must be Full")); }
            }
        }
    }
    receive_equals(&rx, 1)?;
    mem::drop(rx);
    match (tx.try_send(3)) {
        Result::Ok(_)  => { return bail(Str::new("try_send after the receiver dropped must not queue the value")); }
        Result::Err(e) => {
            match (e) {
                TrySendError::Disconnected(value) => { expect_equal(value, 3)?; }
                TrySendError::Full(_)             => { return bail(Str::new("the receiver is gone; must be Disconnected")); }
            }
        }
    }
    return Result::Ok(());
}

![test]
function mpsc_receiver_iterates_until_every_sender_drops() -> Result<(), TestError> {
    const { first: tx, second: rx }: Pair<Sender<i32>, Receiver<i32>> = Channel::unbounded::<i32>();
    const worker = thread::spawn(move () -> i32 {
        for (mut value: i32 = 1; value <= 4; value++) {
            if (tx.send(value).is_err()) { return 1; }
        }
        return 0;
    });
    mut sum: i32 = 0;
    mut count: i32 = 0;
    for (value in rx) {
        sum = sum + value;
        count = count + 1;
    }
    expect_equal(worker.join(), 0)?;
    expect_equal(count, 4)?;
    return expect_equal(sum, 10);
}

![test]
![should_panic]
function mpsc_bounded_refuses_no_capacity() -> Result<(), TestError> {
    Channel::bounded::<i32>(0);
    return Result::Ok(());
}
