///! A `HashMap` and a `HashSet` are asked with any form their key borrows as
///! (`Borrow`): a reference to the key, or a `Str` for a `String` key, so
///! no `String` is made to look one up.  A bare string literal is not one:
///! it is written `Str::new("ada")`, or passed as a typed `Str`.

![config(testing)]
namespace CryoTests::Tests::Stdlib::HashMapBorrowedKey;

import std::core::result::{ Result };
import std::core::option::{ Option };
import std::collections::hashmap::{ HashMap };
import std::collections::hashset::{ HashSet };
import std::collections::str::{ Str };
import std::collections::string::{ String };
import std::test::error::{ TestError };
import std::test::assert::{ expect_equal, expect_false, expect_true };

function ages() -> HashMap<String, i64> {
    mut map: HashMap<String, i64> = HashMap::new();
    map.insert(String::from("ada"), 36);
    map.insert(String::from("bob"), 41);
    return map;
}

![test]
function a_string_key_is_found_by_a_reference_to_a_string() -> Result<(), TestError> {
    const map: HashMap<String, i64> = ages();
    const key: String = String::from("ada");
    return expect_equal(map.get(&key).unwrap_or(-1), 36);
}

![test]
function a_string_key_is_found_by_a_str() -> Result<(), TestError> {
    const map: HashMap<String, i64> = ages();
    const name: Str = Str::new("bob");
    match (expect_equal(map.get(name).unwrap_or(-1), 41)) {
        Result::Ok(_) => { } Result::Err(e) => { return Result::Err(e); }
    }
    match (expect_equal(map.get(Str::new("ada")).unwrap_or(-1), 36)) {
        Result::Ok(_) => { } Result::Err(e) => { return Result::Err(e); }
    }
    return expect_false(map.contains_key(Str::new("zed")), Str::new("no key `zed`"));
}

![test]
function a_str_removes_and_reaches_a_value_in_place() -> Result<(), TestError> {
    mut map: HashMap<String, i64> = ages();
    match (map.get_mutable(Str::new("ada"))) {
        Option::Some(value) => { *value = 37; }
        Option::None        => { }
    }
    match (expect_equal(map.get(Str::new("ada")).unwrap_or(-1), 37)) {
        Result::Ok(_) => { } Result::Err(e) => { return Result::Err(e); }
    }
    match (expect_true(map.remove(Str::new("bob")).is_some(), Str::new("`bob` removed"))) {
        Result::Ok(_) => { } Result::Err(e) => { return Result::Err(e); }
    }
    return expect_equal(map.length(), 1);
}

![test]
function a_set_of_strings_is_asked_with_a_str_and_its_operators_still_build() -> Result<(), TestError> {
    mut few: HashSet<String> = HashSet::new();
    few.insert(String::from("x"));
    mut more: HashSet<String> = HashSet::new();
    more.insert(String::from("x"));
    more.insert(String::from("y"));
    const both: HashSet<String> = few & more;
    const only: HashSet<String> = more - few;
    match (expect_true(only.contains(Str::new("y")), Str::new("`y` only in the larger set"))) {
        Result::Ok(_) => { } Result::Err(e) => { return Result::Err(e); }
    }
    match (expect_false(only.contains(Str::new("x")), Str::new("`x` in both sets"))) {
        Result::Ok(_) => { } Result::Err(e) => { return Result::Err(e); }
    }
    return expect_equal(both.length() * 10 + (few ^ more).length(), 11);
}

![test]
function an_integer_key_is_still_found_by_a_reference() -> Result<(), TestError> {
    mut map: HashMap<i64, i64> = HashMap::new();
    map.insert(7, 49);
    const key: i64 = 7;
    return expect_equal(map.get(&key).unwrap_or(-1), 49);
}
