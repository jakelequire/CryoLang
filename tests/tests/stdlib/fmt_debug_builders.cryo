///! `Formatter::debug_struct` / `debug_tuple`: the `Debug` text of a value
///! with named fields (`Point { x: 1, y: 2 }`) or unnamed members
///! (`Some(1)`), written one member per line by a pretty formatter.

![config(testing)]
namespace CryoTests::Tests::Stdlib::FmtDebugBuilders;

import std::core::result::{ Result };
import std::collections::string::{ String };
import std::fmt::display::{ Debug, Formatter, format_debug_to_string };
import std::fmt::error::{ FmtError };
import std::test::error::{ TestError };
import std::test::assert::{ expect_eq };

type struct Point {
    x: i64;
    y: i64;
}

implement trait Debug for struct Point {
    fmt(&this, f: mut &Formatter) -> Result<(), FmtError> {
        return f.debug_struct("Point").field("x", &this.x).field("y", &this.y).finish();
    }
}

type struct Marker { }

implement trait Debug for struct Marker {
    fmt(&this, f: mut &Formatter) -> Result<(), FmtError> {
        return f.debug_struct("Marker").finish();
    }
}

type enum Shape {
    Dot;
    Circle(i64);
    Segment(Point, Point);
}

implement trait Debug for enum Shape {
    fmt(&this, f: mut &Formatter) -> Result<(), FmtError> {
        match (&this) {
            Shape::Dot => { return f.debug_tuple("Dot").finish(); }
            Shape::Circle(radius) => { return f.debug_tuple("Circle").field(radius).finish(); }
            Shape::Segment(from, to) => {
                return f.debug_tuple("Segment").field(from).field(to).finish();
            }
        }
    }
}

type struct Labelled {
    name: String;
    at: Point;
}

implement trait Debug for struct Labelled {
    fmt(&this, f: mut &Formatter) -> Result<(), FmtError> {
        return f.debug_struct("Labelled").field("name", &this.name).field("at", &this.at).finish();
    }
}

function pretty_text<T>(value: &T) -> Result<String, FmtError>
where T: Debug {
    mut out: String = String::new();
    mut f: Formatter = Formatter::pretty(&out);
    value.fmt(&f)?;
    return Result::Ok(out);
}

![test]
function a_struct_writes_its_fields_in_braces() -> Result<(), TestError> {
    const p: Point = Point { x: 1, y: -2 };
    return expect_eq(format_debug_to_string(&p).unwrap(), String::from_string("Point { x: 1, y: -2 }"));
}

![test]
function a_struct_with_no_fields_writes_its_name() -> Result<(), TestError> {
    const m: Marker = Marker { };
    return expect_eq(format_debug_to_string(&m).unwrap(), String::from_string("Marker"));
}

![test]
function a_tuple_writes_its_members_in_parentheses() -> Result<(), TestError> {
    const dot: Shape = Shape::Dot;
    const circle: Shape = Shape::Circle(3);
    const segment: Shape = Shape::Segment(Point { x: 0, y: 0 }, Point { x: 4, y: 5 });
    expect_eq(format_debug_to_string(&dot).unwrap(), String::from_string("Dot"))?;
    expect_eq(format_debug_to_string(&circle).unwrap(), String::from_string("Circle(3)"))?;
    return expect_eq(format_debug_to_string(&segment).unwrap(),
        String::from_string("Segment(Point { x: 0, y: 0 }, Point { x: 4, y: 5 })"));
}

![test]
function a_nested_value_writes_its_own_text_in_place() -> Result<(), TestError> {
    const l: Labelled = Labelled { name: String::from_string("origin"), at: Point { x: 0, y: 7 } };
    return expect_eq(format_debug_to_string(&l).unwrap(),
        String::from_string("Labelled { name: \"origin\", at: Point { x: 0, y: 7 } }"));
}

![test]
function a_pretty_formatter_writes_a_member_per_line() -> Result<(), TestError> {
    const l: Labelled = Labelled { name: String::from_string("origin"), at: Point { x: 0, y: 7 } };
    expect_eq(pretty_text(&l).unwrap(), String::from_string(
        "Labelled {\n    name: \"origin\",\n    at: Point {\n        x: 0,\n        y: 7,\n    },\n}"))?;
    const segment: Shape = Shape::Segment(Point { x: 1, y: 2 }, Point { x: 3, y: 4 });
    expect_eq(pretty_text(&segment).unwrap(), String::from_string(
        "Segment(\n    Point {\n        x: 1,\n        y: 2,\n    },\n    Point {\n        x: 3,\n        y: 4,\n    },\n)"))?;
    const m: Marker = Marker { };
    return expect_eq(pretty_text(&m).unwrap(), String::from_string("Marker"));
}

![test]
function an_f_string_pretty_hole_writes_a_member_per_line() -> Result<(), TestError> {
    const p: Point = Point { x: 1, y: 2 };
    const pretty: String = f"at {p:#?}";
    expect_eq(pretty, String::from_string("at Point {\n    x: 1,\n    y: 2,\n}"))?;
    const plain: String = f"at {p:?}";
    return expect_eq(plain, String::from_string("at Point { x: 1, y: 2 }"));
}

![test]
function a_pretty_hole_in_written_arguments_is_pretty() -> Result<(), TestError> {
    const segment: Shape = Shape::Segment(Point { x: 1, y: 2 }, Point { x: 3, y: 4 });
    mut out: String = String::new();
    mut f: Formatter = Formatter::new(&out);
    f.write(f"{segment:#?};{segment:?}").unwrap();
    return expect_eq(out, String::from_string(
        "Segment(\n    Point {\n        x: 1,\n        y: 2,\n    },\n    Point {\n        x: 3,\n        y: 4,\n    },\n);Segment(Point { x: 1, y: 2 }, Point { x: 3, y: 4 })"));
}
