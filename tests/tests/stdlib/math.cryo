///! math — float ops, abs, classification.

![config(testing)]
namespace CryoTests::Tests::Stdlib::MathT;

import std::core::result;
import std::math;
import std::test::error;
import std::test::assert;

// Within tolerance helper — float equality is bound to be approximate.
function within(a: f64, b: f64, eps: f64) -> boolean {
    const d: f64 = math::absolute(a - b);
    return d < eps;
}

![test]
function square_root_basic() -> Result<(), TestError> {
    const got: f64 = math::square_root(16.0);
    match (expect(within(got, 4.0, 0.0001),
        Str::from_raw("sqrt(16) ≈ 4", 12))) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

![test]
function cube_root_basic() -> Result<(), TestError> {
    const got: f64 = math::cube_root(27.0);
    match (expect(within(got, 3.0, 0.0001),
        Str::from_raw("cbrt(27) ≈ 3", 12))) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

![test]
function power_integer_exponent() -> Result<(), TestError> {
    const got: f64 = math::power(2.0, 10.0);
    match (expect(within(got, 1024.0, 0.0001),
        Str::from_raw("2^10 ≈ 1024", 11))) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

![test]
function natural_log_e_is_one() -> Result<(), TestError> {
    const got: f64 = math::natural_log(math::E);
    match (expect(within(got, 1.0, 0.0001),
        Str::from_raw("ln(e) ≈ 1", 9))) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

![test]
function log_base2_eight_is_three() -> Result<(), TestError> {
    const got: f64 = math::log_base2(8.0);
    match (expect(within(got, 3.0, 0.0001),
        Str::from_raw("log2(8) ≈ 3", 11))) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

![test]
function exponential_zero_is_one() -> Result<(), TestError> {
    const got: f64 = math::exponential(0.0);
    match (expect(within(got, 1.0, 0.0001),
        Str::from_raw("exp(0) ≈ 1", 10))) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

![test]
function sine_zero_is_zero() -> Result<(), TestError> {
    const got: f64 = math::sine(0.0);
    match (expect(within(got, 0.0, 0.0001),
        Str::from_raw("sin(0) ≈ 0", 10))) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

![test]
function cosine_zero_is_one() -> Result<(), TestError> {
    const got: f64 = math::cosine(0.0);
    match (expect(within(got, 1.0, 0.0001),
        Str::from_raw("cos(0) ≈ 1", 10))) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

![test]
function absolute_negative() -> Result<(), TestError> {
    const got: f64 = math::absolute(-3.5);
    match (expect(within(got, 3.5, 0.0001),
        Str::from_raw("|-3.5| ≈ 3.5", 12))) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

![test]
function hypot_3_4_is_5() -> Result<(), TestError> {
    const got: f64 = math::hypot(3.0, 4.0);
    match (expect(within(got, 5.0, 0.0001),
        Str::from_raw("hypot(3,4) ≈ 5", 14))) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

![test]
function abs_i32_negative() -> Result<(), TestError> {
    const got: i32 = math::abs_i32(-42);
    match (expect_eq(got, 42)) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

![test]
function abs_i32_positive() -> Result<(), TestError> {
    const got: i32 = math::abs_i32(42);
    match (expect_eq(got, 42)) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

![test]
function abs_i64_negative() -> Result<(), TestError> {
    const big: i64 = 1000000000000;
    const negative: i64 = 0 - big;
    const got: i64 = math::abs_i64(negative);
    match (expect_eq(got, big)) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

![test]
function is_finite_normal_value() -> Result<(), TestError> {
    const ok: boolean = math::is_finite(3.14);
    match (expect(ok,
        Str::from_raw("3.14 should be finite", 21))) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

![test]
function is_nan_self_compare() -> Result<(), TestError> {
    // NaN = 0/0 — produced by libc; we just confirm classification.
    const nan: f64 = 0.0 / 0.0;
    const flagged: boolean = math::is_nan(nan);
    match (expect(flagged,
        Str::from_raw("0/0 should be NaN", 17))) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}
