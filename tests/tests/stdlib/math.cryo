///! math - float ops, rounding, trig, classification, integer helpers.

![config(testing)]
namespace CryoTests::Tests::Stdlib::MathT;

import std::core::result;
import std::math;
import std::test::error;
import std::test::assert;

// Within tolerance helper - float equality is bound to be approximate.
function within(a: f64, b: f64, eps: f64) -> boolean {
    const d: f64 = math::fabs(a - b);
    return d < eps;
}

![test]
function sqrt_basic() -> Result<(), TestError> {
    return expect(within(math::sqrt(16.0), 4.0, 0.0001), Str::new("sqrt(16) ≈ 4"));
}

![test]
function cbrt_basic() -> Result<(), TestError> {
    return expect(within(math::cbrt(27.0), 3.0, 0.0001), Str::new("cbrt(27) ≈ 3"));
}

![test]
function pow_integer_exponent() -> Result<(), TestError> {
    return expect(within(math::pow(2.0, 10.0), 1024.0, 0.0001), Str::new("2^10 ≈ 1024"));
}

![test]
function ln_e_is_one() -> Result<(), TestError> {
    return expect(within(math::ln(math::E), 1.0, 0.0001), Str::new("ln(e) ≈ 1"));
}

![test]
function log2_eight_is_three() -> Result<(), TestError> {
    return expect(within(math::log2(8.0), 3.0, 0.0001), Str::new("log2(8) ≈ 3"));
}

![test]
function log10_thousand_is_three() -> Result<(), TestError> {
    return expect(within(math::log10(1000.0), 3.0, 0.0001), Str::new("log10(1000) ≈ 3"));
}

![test]
function log_arbitrary_base() -> Result<(), TestError> {
    return expect(within(math::log(81.0, 3.0), 4.0, 0.0001), Str::new("log_3(81) ≈ 4"));
}

![test]
function exp_zero_is_one() -> Result<(), TestError> {
    return expect(within(math::exp(0.0), 1.0, 0.0001), Str::new("exp(0) ≈ 1"));
}

![test]
function sin_zero_is_zero() -> Result<(), TestError> {
    return expect(within(math::sin(0.0), 0.0, 0.0001), Str::new("sin(0) ≈ 0"));
}

![test]
function cos_zero_is_one() -> Result<(), TestError> {
    return expect(within(math::cos(0.0), 1.0, 0.0001), Str::new("cos(0) ≈ 1"));
}

![test]
function atan2_quadrant() -> Result<(), TestError> {
    // atan2(1, 1) = pi/4
    return expect(within(math::atan2(1.0, 1.0), math::PI / 4.0, 0.0001),
        Str::new("atan2(1,1) ≈ pi/4"));
}

![test]
function tanh_zero_is_zero() -> Result<(), TestError> {
    return expect(within(math::tanh(0.0), 0.0, 0.0001), Str::new("tanh(0) ≈ 0"));
}

![test]
function to_radians_180_is_pi() -> Result<(), TestError> {
    return expect(within(math::to_radians(180.0), math::PI, 0.0001),
        Str::new("to_radians(180) ≈ pi"));
}

![test]
function fabs_negative() -> Result<(), TestError> {
    return expect(within(math::fabs(0.0 - 3.5), 3.5, 0.0001), Str::new("|-3.5| ≈ 3.5"));
}

![test]
function hypot_3_4_is_5() -> Result<(), TestError> {
    return expect(within(math::hypot(3.0, 4.0), 5.0, 0.0001), Str::new("hypot(3,4) ≈ 5"));
}

![test]
function signum_negative() -> Result<(), TestError> {
    return expect(within(math::signum(0.0 - 8.0), 0.0 - 1.0, 0.0001),
        Str::new("signum(-8) = -1"));
}

![test]
function copysign_applies_sign() -> Result<(), TestError> {
    return expect(within(math::copysign(3.0, 0.0 - 1.0), 0.0 - 3.0, 0.0001),
        Str::new("copysign(3, -) = -3"));
}

// --- rounding ----------------------------------------------------------

![test]
function floor_rounds_down() -> Result<(), TestError> {
    return expect(within(math::floor(2.7), 2.0, 0.0001), Str::new("floor(2.7) = 2"));
}

![test]
function ceil_rounds_up() -> Result<(), TestError> {
    return expect(within(math::ceil(2.1), 3.0, 0.0001), Str::new("ceil(2.1) = 3"));
}

![test]
function round_half_up() -> Result<(), TestError> {
    return expect(within(math::round(2.5), 3.0, 0.0001), Str::new("round(2.5) = 3"));
}

![test]
function trunc_toward_zero() -> Result<(), TestError> {
    return expect(within(math::trunc(0.0 - 2.7), 0.0 - 2.0, 0.0001),
        Str::new("trunc(-2.7) = -2"));
}

![test]
function fract_signed() -> Result<(), TestError> {
    return expect(within(math::fract(0.0 - 2.25), 0.0 - 0.25, 0.0001),
        Str::new("fract(-2.25) = -0.25"));
}

// --- min / max / clamp -------------------------------------------------

![test]
function min_max_f64() -> Result<(), TestError> {
    match (expect(within(math::min(1.5, 2.5), 1.5, 0.0001), Str::new("min"))) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return expect(within(math::max(1.5, 2.5), 2.5, 0.0001), Str::new("max"));
}

![test]
function clamp_f64_bounds() -> Result<(), TestError> {
    match (expect(within(math::clamp(5.0, 0.0, 3.0), 3.0, 0.0001), Str::new("clamp high"))) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return expect(within(math::clamp(0.0 - 1.0, 0.0, 3.0), 0.0, 0.0001), Str::new("clamp low"));
}

![test]
function clamp_i64_passthrough() -> Result<(), TestError> {
    return expect_eq(math::clamp_i64(2, 0, 10), 2);
}

![test]
function min_u64_picks_smaller() -> Result<(), TestError> {
    return expect_eq(math::min_u64(7, 3), 3);
}

// --- integer absolute --------------------------------------------------

![test]
function abs_i32_negative() -> Result<(), TestError> {
    return expect_eq(math::abs_i32(0 - 42), 42);
}

![test]
function abs_i64_negative() -> Result<(), TestError> {
    const big: i64 = 1000000000000;
    return expect_eq(math::abs_i64(0 - big), big);
}

// --- classification ----------------------------------------------------

![test]
function is_finite_normal_value() -> Result<(), TestError> {
    return expect(math::is_finite(3.14), Str::new("3.14 should be finite"));
}

![test]
function is_nan_of_nan() -> Result<(), TestError> {
    return expect(math::is_nan(math::nan()), Str::new("nan() should be NaN"));
}

![test]
function is_infinite_of_infinity() -> Result<(), TestError> {
    return expect(math::is_infinite(math::infinity()),
        Str::new("infinity() should be infinite"));
}

// --- integer helpers ---------------------------------------------------

![test]
function gcd_basic() -> Result<(), TestError> {
    return expect_eq(math::gcd(54, 24), 6);
}

![test]
function lcm_basic() -> Result<(), TestError> {
    return expect_eq(math::lcm(4, 6), 12);
}

![test]
function is_power_of_two_true() -> Result<(), TestError> {
    return expect(math::is_power_of_two(1024), Str::new("1024 is a power of two"));
}

![test]
function is_power_of_two_false() -> Result<(), TestError> {
    return expect(!math::is_power_of_two(1000), Str::new("1000 is not a power of two"));
}

![test]
function next_power_of_two_rounds_up() -> Result<(), TestError> {
    return expect_eq(math::next_power_of_two(1000), 1024);
}

![test]
function next_power_of_two_exact() -> Result<(), TestError> {
    return expect_eq(math::next_power_of_two(64), 64);
}
