}

![test]
function next_power_of_two_rounds_up() -> Result<(), TestError> {
    return expect_eq(math::next_power_of_two(1000), 1024);
}

![test]
function next_power_of_two_exact() -> Result<(), TestError> {
    return expect_eq(math::next_power_of_two(64), 64);
}

// --- m1: NaN-safe min/max, new consts, f32 variants, new functions ------

![test]
function min_max_f64_nan_transparent() -> Result<(), TestError> {
    // libm fmin/fmax ignore a NaN operand (both operand orders); a
    // raw `<`/`>` form would be asymmetric. Both-NaN yields NaN.
    const n: f64 = math::nan();
    match (expect(within(math::min(n, 2.0), 2.0, 0.0001), Str::new("min(nan,2)=2"))) {
        Result::Ok(_) => { } Result::Err(e) => { return Result::Err(e); }
    }
    match (expect(within(math::min(2.0, n), 2.0, 0.0001), Str::new("min(2,nan)=2"))) {
        Result::Ok(_) => { } Result::Err(e) => { return Result::Err(e); }
    }
    match (expect(within(math::max(n, 2.0), 2.0, 0.0001), Str::new("max(nan,2)=2"))) {
        Result::Ok(_) => { } Result::Err(e) => { return Result::Err(e); }
    }
    match (expect(math::is_nan(math::min(n, n)), Str::new("min(nan,nan) is nan"))) {
        Result::Ok(_) => { } Result::Err(e) => { return Result::Err(e); }
    }
    return expect(math::is_nan(math::max(n, n)), Str::new("max(nan,nan) is nan"));
}

![test]
function float_min_consts() -> Result<(), TestError> {
    match (expect(math::is_finite(math::F64_MIN), Str::new("F64_MIN is finite"))) {
        Result::Ok(_) => { } Result::Err(e) => { return Result::Err(e); }
    }
    match (expect(within(math::F64_MIN, 0.0 - math::F64_MAX, 1.0e292),
        Str::new("F64_MIN == -F64_MAX"))) {
        Result::Ok(_) => { } Result::Err(e) => { return Result::Err(e); }
    }
    return expect(within(math::F32_MIN as f64, 0.0 - (math::F32_MAX as f64), 1.0e32),
        Str::new("F32_MIN == -F32_MAX"));
}

![test]
function min_max_clamp_f32() -> Result<(), TestError> {
    const lo: f32 = 1.5;
    const hi: f32 = 2.5;
    match (expect(within(math::min(lo, hi) as f64, 1.5, 0.0001), Str::new("min<f32>"))) {
        Result::Ok(_) => { } Result::Err(e) => { return Result::Err(e); }
    }
    match (expect(within(math::max(lo, hi) as f64, 2.5, 0.0001), Str::new("max<f32>"))) {
        Result::Ok(_) => { } Result::Err(e) => { return Result::Err(e); }
    }
    const five: f32 = 5.0;
    const zero: f32 = 0.0;
    const three: f32 = 3.0;
    return expect(within(math::clamp(five, zero, three) as f64, 3.0, 0.0001),
        Str::new("clamp<f32> high"));
}

![test]
function min_f32_nan_transparent() -> Result<(), TestError> {
    const nan32: f32 = math::nan() as f32;
    const two: f32 = 2.0;
    match (expect(within(math::min(nan32, two) as f64, 2.0, 0.0001),
        Str::new("min<f32>(nan,2)=2"))) {
        Result::Ok(_) => { } Result::Err(e) => { return Result::Err(e); }
    }
    return expect(within(math::min(two, nan32) as f64, 2.0, 0.0001),
        Str::new("min<f32>(2,nan)=2"));
}

![test]
function powi_cases() -> Result<(), TestError> {
    match (expect(within(math::powi(2.0, 10), 1024.0, 0.0001), Str::new("2^10"))) {
        Result::Ok(_) => { } Result::Err(e) => { return Result::Err(e); }
    }
    match (expect(within(math::powi(2.0, 0), 1.0, 0.0001), Str::new("2^0"))) {
        Result::Ok(_) => { } Result::Err(e) => { return Result::Err(e); }
    }
    match (expect(within(math::powi(2.0, 0 - 2), 0.25, 0.0001), Str::new("2^-2"))) {
        Result::Ok(_) => { } Result::Err(e) => { return Result::Err(e); }
    }
    return expect(within(math::powi(0.0, 0), 1.0, 0.0001), Str::new("0^0 == 1"));
}

![test]
function mul_add_basic() -> Result<(), TestError> {
    return expect(within(math::mul_add(2.0, 3.0, 4.0), 10.0, 0.0001),
        Str::new("2*3+4 == 10"));
}

![test]
function log1p_expm1_roundtrip() -> Result<(), TestError> {
    match (expect(within(math::log1p(0.0), 0.0, 0.0001), Str::new("log1p(0)=0"))) {
        Result::Ok(_) => { } Result::Err(e) => { return Result::Err(e); }
    }
    match (expect(within(math::expm1(0.0), 0.0, 0.0001), Str::new("expm1(0)=0"))) {
        Result::Ok(_) => { } Result::Err(e) => { return Result::Err(e); }
    }
    return expect(within(math::log1p(math::expm1(0.5)), 0.5, 0.0001),
        Str::new("log1p(expm1(0.5)) == 0.5"));
}

![test]
function hypot_no_overflow() -> Result<(), TestError> {
    // The naive sqrt(x*x + y*y) overflows to +inf at this magnitude; libm
    // hypot scales by the larger operand and returns the right answer.
    return expect(within(math::hypot(3.0e200, 4.0e200), 5.0e200, 1.0e196),
        Str::new("hypot(3e200,4e200) ≈ 5e200 without overflow"));
}

// --- cheap fp ops (compiler intrinsics) ---------------------------------
//
// fabs/floor/ceil/trunc/round/copysign/sqrt/mul_add lower to LLVM float
// intrinsics (llvm.fabs.f64, ...) instead of calling libm.  These pin down
// the edge semantics that must keep matching the C functions of the same
// name: round's halfway-away-from-zero (NOT rint's round-to-even), the pure
// sign-bit behavior of fabs/copysign on -0.0 and NaN, sqrt's NaN domain
// result, and mul_add's single rounding (which an unfused mul+add cannot
// reproduce).  Exact `==` compares are deliberate - every operation here is
// exact.

![test]
function round_half_away_from_zero() -> Result<(), TestError> {
    // C round() semantics: halfway cases go AWAY from zero on both sides.
    // rint/nearbyint under the default mode would give -2 / 0 / -0 here.
    match (expect(math::round(0.0 - 2.5) == (0.0 - 3.0), Str::new("round(-2.5) = -3"))) {
        Result::Ok(_) => { } Result::Err(e) => { return Result::Err(e); }
    }
    match (expect(math::round(0.5) == 1.0, Str::new("round(0.5) = 1"))) {
        Result::Ok(_) => { } Result::Err(e) => { return Result::Err(e); }
    }
    return expect(math::round(0.0 - 0.5) == (0.0 - 1.0), Str::new("round(-0.5) = -1"));
}

![test]
function floor_ceil_negative_operands() -> Result<(), TestError> {
    match (expect(math::floor(0.0 - 2.1) == (0.0 - 3.0), Str::new("floor(-2.1) = -3"))) {
        Result::Ok(_) => { } Result::Err(e) => { return Result::Err(e); }
    }
    return expect(math::ceil(0.0 - 2.1) == (0.0 - 2.0), Str::new("ceil(-2.1) = -2"));
}

![test]
function rounding_preserves_nonfinite() -> Result<(), TestError> {
    match (expect(math::floor(math::infinity()) == math::infinity(),
        Str::new("floor(inf) = inf"))) {
        Result::Ok(_) => { } Result::Err(e) => { return Result::Err(e); }
    }
    match (expect(math::trunc(math::neg_infinity()) == math::neg_infinity(),
        Str::new("trunc(-inf) = -inf"))) {
        Result::Ok(_) => { } Result::Err(e) => { return Result::Err(e); }
    }
    return expect(math::is_nan(math::round(math::nan())), Str::new("round(NaN) is NaN"));
}

![test]
function fabs_is_a_pure_sign_bit_op() -> Result<(), TestError> {
    // fabs must clear the sign bit of -0.0 (a value compare cannot see it)
    // and pass NaN through rather than faulting on it.
    const neg_zero: f64 = mem::transmute<u64, f64>(0x8000000000000000);
    match (expect(!math::is_sign_negative(math::fabs(neg_zero)),
        Str::new("fabs(-0.0) clears the sign bit"))) {
        Result::Ok(_) => { } Result::Err(e) => { return Result::Err(e); }
    }
    return expect(math::is_nan(math::fabs(math::nan())), Str::new("fabs(NaN) is NaN"));
}

![test]
function copysign_edge_signs() -> Result<(), TestError> {
    // -0.0 as the sign source: copysign transfers the sign BIT, not the
    // numeric sign (which is zero here).
    const neg_zero: f64 = mem::transmute<u64, f64>(0x8000000000000000);
    match (expect(math::copysign(3.0, neg_zero) == (0.0 - 3.0),
        Str::new("copysign(3, -0.0) = -3"))) {
        Result::Ok(_) => { } Result::Err(e) => { return Result::Err(e); }
    }
    match (expect(math::copysign(0.0 - 3.0, 1.0) == 3.0,
        Str::new("copysign(-3, 1) = 3"))) {
        Result::Ok(_) => { } Result::Err(e) => { return Result::Err(e); }
    }
    // NaN keeps its payload but takes the requested sign bit.
    return expect(math::is_sign_negative(math::copysign(math::nan(), 0.0 - 1.0)),
        Str::new("copysign(NaN, -1) is sign-negative"));
}

![test]
function sqrt_domain_edges_and_f32() -> Result<(), TestError> {
    match (expect(math::is_nan(math::sqrt(0.0 - 1.0)), Str::new("sqrt(-1) is NaN"))) {
        Result::Ok(_) => { } Result::Err(e) => { return Result::Err(e); }
    }
    match (expect(math::sqrt(0.0) == 0.0, Str::new("sqrt(0) = 0"))) {
        Result::Ok(_) => { } Result::Err(e) => { return Result::Err(e); }
    }
    match (expect(math::sqrt(math::infinity()) == math::infinity(),
        Str::new("sqrt(inf) = inf"))) {
        Result::Ok(_) => { } Result::Err(e) => { return Result::Err(e); }
    }
    return expect(math::sqrt(9.0 as f32) == (3.0 as f32), Str::new("sqrt<f32>(9) = 3"));
}

![test]
function mul_add_single_rounding() -> Result<(), TestError> {
    // (1 + 2^-52)^2 = 1 + 2^-51 + 2^-104.  A separate multiply rounds the
    // product to 1 + 2^-51, so mul-then-add of -(1 + 2^-51) yields exactly
    // 0.  A true fused multiply-add keeps the full product and returns
    // exactly 2^-104 - this test fails if mul_add is ever lowered to an
    // unfused mul + add.
    const a: f64 = mem::transmute<u64, f64>(0x3FF0000000000001);        // 1 + 2^-52
    const b: f64 = mem::transmute<u64, f64>(0x3FF0000000000002);        // 1 + 2^-51
    const expected: f64 = mem::transmute<u64, f64>(0x3970000000000000); // 2^-104
    return expect(math::mul_add(a, a, 0.0 - b) == expected,
        Str::new("mul_add fuses with a single rounding"));
}
