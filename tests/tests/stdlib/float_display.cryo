///! A float's Display is the shortest text that reads back as the same
///! value, at the float's own width, with `.0` after a whole value.

![config(testing)]
namespace CryoTests::Tests::Stdlib::FloatDisplay;

import std::core::result::{ Result };
import std::collections::str::{ Str };
import std::collections::string::{ String };
import std::test::error::{ TestError };
import std::test::assert::{ expect };

function shows(text: String, wanted: string) -> Result<(), TestError> {
    return expect(text.as_str() == Str::new(wanted), f"wrote `{text}`, wanted `{wanted}`".as_str());
}

![test]
function a_float_is_written_in_its_shortest_form() -> Result<(), TestError> {
    shows((3.5).to_string(), "3.5")?;
    shows((0.1).to_string(), "0.1")?;
    shows((1.0 / 3.0).to_string(), "0.3333333333333333")?;
    shows((-1234.5678).to_string(), "-1234.5678")?;
    shows((1.0e-5).to_string(), "1e-05")?;
    return shows((1.0e20).to_string(), "1e+20");
}

![test]
function a_whole_float_keeps_a_point() -> Result<(), TestError> {
    shows((2.0).to_string(), "2.0")?;
    shows((-0.0).to_string(), "-0.0")?;
    return shows((100.0).to_string(), "100.0");
}

![test]
function an_f32_is_written_at_its_own_width() -> Result<(), TestError> {
    const tenth: f32 = 0.1;
    shows(tenth.to_string(), "0.1")?;
    const third: f32 = 1.0 / 3.0;
    return shows(third.to_string(), "0.33333334");
}

![test]
function the_text_reads_back_as_the_same_value() -> Result<(), TestError> {
    const values: [f64; 5] = [0.1, 1.0 / 3.0, 2.0e-7, 123456789.125, -9.87654321e300];
    for (mut i: i64 = 0; i < 5; i++) {
        const text: String = values[i].to_string();
        expect(f64::try_from(text.as_str()).unwrap_or(0.0) == values[i], f"`{text}` reads back".as_str())?;
    }
    return Result::Ok(());
}

![test]
function non_finite_values_and_specs_keep_their_forms() -> Result<(), TestError> {
    shows((0.0 / 0.0).to_string(), "NaN")?;
    shows((1.0 / 0.0).to_string(), "inf")?;
    shows(f"{2.5:>6}", "   2.5")?;
    return shows(f"{2.5:.2}", "2.50");
}
