///! An operating system's error codes mapped to `IoError`, and the calling
///! thread's last error read back.

![config(testing)]
namespace CryoTests::Tests::Stdlib::IoErrorCodes;

import std::core::result::{ Result };
import std::collections::str::{ Str };
import std::io::error::{ IoError, IoErrorKind, IoOperation };
import std::ffi::libc;
import std::sys::syscall;
import std::test::error::{ TestError };
import std::test::assert::{ expect, expect_eq };

function expect_windows_code(code: u32, kind: IoErrorKind) -> Result<(), TestError> {
    const error: IoError = IoError::from_windows_error(code);
    expect(error.kind == kind, error.kind.label())?;
    return expect_eq(error.os_code, code as i32);
}

![test]
function windows_error_codes_map_to_kinds() -> Result<(), TestError> {
    expect_windows_code(syscall::ERROR_FILE_NOT_FOUND, IoErrorKind::NotFound)?;
    expect_windows_code(syscall::ERROR_PATH_NOT_FOUND, IoErrorKind::NotFound)?;
    expect_windows_code(syscall::ERROR_ACCESS_DENIED, IoErrorKind::PermissionDenied)?;
    expect_windows_code(syscall::ERROR_SHARING_VIOLATION, IoErrorKind::PermissionDenied)?;
    expect_windows_code(syscall::ERROR_ALREADY_EXISTS, IoErrorKind::AlreadyExists)?;
    expect_windows_code(syscall::ERROR_FILE_EXISTS, IoErrorKind::AlreadyExists)?;
    expect_windows_code(syscall::ERROR_NOT_ENOUGH_MEMORY, IoErrorKind::OutOfMemory)?;
    expect_windows_code(syscall::ERROR_INVALID_PARAMETER, IoErrorKind::InvalidInput)?;
    expect_windows_code(syscall::ERROR_BROKEN_PIPE, IoErrorKind::BrokenPipe)?;
    expect_windows_code(syscall::ERROR_HANDLE_EOF, IoErrorKind::UnexpectedEof)?;
    expect_windows_code(syscall::ERROR_NOT_SUPPORTED, IoErrorKind::Unsupported)?;
    return expect_windows_code(9999, IoErrorKind::Other);
}

function expect_winsock_code(code: i32, kind: IoErrorKind) -> Result<(), TestError> {
    const error: IoError = IoError::from_wsa(code);
    expect(error.kind == kind, error.kind.label())?;
    return expect_eq(error.os_code, code);
}

![test]
function winsock_error_codes_map_to_kinds() -> Result<(), TestError> {
    expect_winsock_code(syscall::WSAEWOULDBLOCK, IoErrorKind::WouldBlock)?;
    expect_winsock_code(syscall::WSAEINTR, IoErrorKind::Interrupted)?;
    expect_winsock_code(syscall::WSAECONNREFUSED, IoErrorKind::ConnectionRefused)?;
    expect_winsock_code(syscall::WSAECONNRESET, IoErrorKind::ConnectionReset)?;
    expect_winsock_code(syscall::WSAECONNABORTED, IoErrorKind::ConnectionAborted)?;
    expect_winsock_code(syscall::WSAETIMEDOUT, IoErrorKind::TimedOut)?;
    expect_winsock_code(syscall::WSAEADDRINUSE, IoErrorKind::AddrInUse)?;
    expect_winsock_code(syscall::WSAENOTCONN, IoErrorKind::NotConnected)?;
    return expect_winsock_code(10999, IoErrorKind::Other);
}

/// A kind's slug and description and an operation's verb are views of
/// their text.
![test]
function kinds_and_operations_read_as_text() -> Result<(), TestError> {
    expect_eq(IoErrorKind::NotFound.label(), Str::new("not_found"))?;
    expect_eq(IoErrorKind::StorageFull.description(), Str::new("no space left on the device"))?;
    return expect_eq(IoOperation::ReadMetadata.verb(), Str::new("read the metadata of"));
}

![target(unix)]
function set_last_error_to_not_found() -> i32 {
    libc::set_errno(2);   // ENOENT
    return 2;
}
![target(windows)]
function set_last_error_to_not_found() -> i32 {
    syscall::SetLastError(syscall::ERROR_FILE_NOT_FOUND);
    return 2;
}

![test]
function last_os_error_reads_the_thread_error() -> Result<(), TestError> {
    const code: i32 = set_last_error_to_not_found();
    const error: IoError = IoError::last_os_error();
    expect(error.kind == IoErrorKind::NotFound, error.kind.label())?;
    return expect_eq(error.os_code, code);
}
