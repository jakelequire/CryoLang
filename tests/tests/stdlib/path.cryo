///! fs::path - Path / PathBuf parsing and joining.

![config(testing)]
namespace CryoTests::Tests::Stdlib::PathT;

import std::core::result;
import std::core::option;
import std::collections::str;
import std::collections::string;
import std::fs::path;
import std::test::error;
import std::test::assert;

// ============================================================================
// Path - borrowed
// ============================================================================

![test]
function absolute_path_detected() -> Result<(), TestError> {
    const src: Str = Str::new("/etc/hosts");
    const p: Path = Path::from(src);
    match (expect(p.is_absolute(),
        Str::new("/etc/hosts should be absolute"))) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

![test]
function relative_path_not_absolute() -> Result<(), TestError> {
    const src: Str = Str::new("etc/hosts");
    const p: Path = Path::from(src);
    match (expect(!p.is_absolute(),
        Str::new("etc/hosts should not be absolute"))) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

![test]
function file_name_extracts_last_segment() -> Result<(), TestError> {
    const src: Str = Str::new("/usr/local/bin/cryo");
    const p: Path = Path::from(src);
    match (p.file_name()) {
        Option::Some(name) => {
            const want: Str = Str::new("cryo");
            match (expect(name.equals(&want),
                Str::new("file_name should be 'cryo'"))) {
                Result::Ok(_) => { }
                Result::Err(e) => { return Result::Err(e); }
            }
        }
        Option::None => {
            return bail(Str::new("file_name should be Some"));
        }
    }
    return Result::Ok(());
}

![test]
function file_name_trailing_slash_is_none() -> Result<(), TestError> {
    const src: Str = Str::new("/var/log/");
    const p: Path = Path::from(src);
    match (p.file_name()) {
        Option::Some(_) => {
            return bail(Str::new("trailing-slash path should have no file_name"));
        }
        Option::None => { }
    }
    return Result::Ok(());
}

![test]
function parent_strips_last_segment() -> Result<(), TestError> {
    const src: Str = Str::new("/usr/local/bin");
    const p: Path = Path::from(src);
    match (p.parent()) {
        Option::Some(parent) => {
            const want: Str = Str::new("/usr/local");
            match (expect(parent.as_str().equals(&want),
                Str::new("parent should be /usr/local"))) {
                Result::Ok(_) => { }
                Result::Err(e) => { return Result::Err(e); }
            }
        }
        Option::None => {
            return bail(Str::new("parent should be Some"));
        }
    }
    return Result::Ok(());
}

![test]
function parent_of_root_subdir_is_root() -> Result<(), TestError> {
    const src: Str = Str::new("/usr");
    const p: Path = Path::from(src);
    match (p.parent()) {
        Option::Some(parent) => {
            const want: Str = Str::new("/");
            match (expect(parent.as_str().equals(&want),
                Str::new("parent of /usr should be /"))) {
                Result::Ok(_) => { }
                Result::Err(e) => { return Result::Err(e); }
            }
        }
        Option::None => {
            return bail(Str::new("parent of /usr should be Some(/)"));
        }
    }
    return Result::Ok(());
}

// ============================================================================
// PathBuf - owned
// ============================================================================

![test]
function pathbuf_push_appends_separator() -> Result<(), TestError> {
    mut pb: PathBuf = PathBuf::from(Str::new("/usr"));
    pb.push(Str::new("local"));
    const view: Str = pb.as_path().as_str();
    const want: Str = Str::new("/usr/local");
    const eq: boolean = view.equals(&want);
    pb.drop();
    match (expect(eq,
        Str::new("push 'local' onto '/usr' should be '/usr/local'"))) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

![test]
function pathbuf_push_absolute_replaces() -> Result<(), TestError> {
    mut pb: PathBuf = PathBuf::from(Str::new("/usr/local"));
    pb.push(Str::new("/etc"));
    const view: Str = pb.as_path().as_str();
    const want: Str = Str::new("/etc");
    const eq: boolean = view.equals(&want);
    pb.drop();
    match (expect(eq,
        Str::new("absolute push should replace path"))) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

![test]
function pathbuf_pop_strips_segment() -> Result<(), TestError> {
    mut pb: PathBuf = PathBuf::from(
        Str::new("/usr/local/bin"));
    const popped: boolean = pb.pop();
    const view: Str = pb.as_path().as_str();
    const want: Str = Str::new("/usr/local");
    const eq: boolean = view.equals(&want);
    pb.drop();
    match (expect(popped,
        Str::new("pop should return true when something was popped"))) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    match (expect(eq,
        Str::new("pop should leave '/usr/local'"))) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

![test]
function pathbuf_pop_empty_returns_false() -> Result<(), TestError> {
    mut pb: PathBuf = PathBuf::new();
    const popped: boolean = pb.pop();
    pb.drop();
    match (expect(!popped,
        Str::new("pop on empty PathBuf should return false"))) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

// ============================================================================
// Path::extension
// ============================================================================

/// `extension()` rendered as a `String` sentinel: "<none>" for `None`, the
/// extension bytes otherwise. Keeps an absent extension distinct from the
/// empty extension of a trailing dot, which a plain "" cannot. The sentinel is
/// NUL-free on purpose: `Str::new`'s length is strlen-based, so a `\0` marker
/// would collapse to the empty string and defeat the whole point.
function ext_text(p: Path) -> String {
    match (p.extension()) {
        Option::Some(x) => { return String::from_str(x); }
        Option::None    => { return String::from_str(Str::new("<none>")); }
    }
}

function expect_ext(src: Str, want: Str, msg: Str) -> Result<(), TestError> {
    const p: Path = Path::from(src);
    mut got: String = ext_text(p);
    const eq: boolean = got.as_str().equals(&want);
    got.drop();
    return expect(eq, msg);
}

![test]
function extension_simple() -> Result<(), TestError> {
    return expect_ext(Str::new("/etc/foo.rs"), Str::new("rs"),
                      Str::new("extension of foo.rs should be 'rs'"));
}

![test]
function extension_takes_last_dot_only() -> Result<(), TestError> {
    return expect_ext(Str::new("foo.tar.gz"), Str::new("gz"),
                      Str::new("extension of foo.tar.gz should be 'gz'"));
}

![test]
function extension_none_when_no_dot() -> Result<(), TestError> {
    return expect_ext(Str::new("/usr/local/bin/cryo"), Str::new("<none>"),
                      Str::new("a name with no dot has no extension"));
}

![test]
function extension_dotfile_is_none() -> Result<(), TestError> {
    return expect_ext(Str::new("/home/jake/.bashrc"), Str::new("<none>"),
                      Str::new("a leading dot is not an extension"));
}

![test]
function extension_leading_dot_with_real_ext() -> Result<(), TestError> {
    return expect_ext(Str::new(".foo.rs"), Str::new("rs"),
                      Str::new("'.foo.rs' still has extension 'rs'"));
}

![test]
function extension_trailing_dot_is_empty() -> Result<(), TestError> {
    return expect_ext(Str::new("foo."), Str::new(""),
                      Str::new("a trailing dot is an empty extension"));
}

![test]
function extension_dotdot_is_none() -> Result<(), TestError> {
    return expect_ext(Str::new(".."), Str::new("<none>"),
                      Str::new("'..' has no extension"));
}

![test]
function extension_trailing_slash_is_none() -> Result<(), TestError> {
    return expect_ext(Str::new("/var/log/"), Str::new("<none>"),
                      Str::new("a path ending in a separator has no name"));
}

// ============================================================================
// Path::join / PathBuf::join
// ============================================================================

![test]
function join_appends_component() -> Result<(), TestError> {
    const base: Path = Path::from(Str::new("/usr"));
    mut joined: PathBuf = base.join(Str::new("local"));
    const want: Str = Str::new("/usr/local");
    const eq: boolean = joined.as_path().as_str().equals(&want);
    joined.drop();
    return expect(eq, Str::new("join 'local' onto '/usr' should be '/usr/local'"));
}

![test]
function join_absolute_replaces() -> Result<(), TestError> {
    const base: Path = Path::from(Str::new("/usr/local"));
    mut joined: PathBuf = base.join(Str::new("/etc"));
    const want: Str = Str::new("/etc");
    const eq: boolean = joined.as_path().as_str().equals(&want);
    joined.drop();
    return expect(eq, Str::new("join of an absolute segment should replace"));
}

![test]
function join_leaves_receiver_intact() -> Result<(), TestError> {
    mut base: PathBuf = PathBuf::from(Str::new("/usr"));
    mut joined: PathBuf = base.join(Str::new("bin"));
    const base_want: Str = Str::new("/usr");
    const join_want: Str = Str::new("/usr/bin");
    const base_eq: boolean = base.as_path().as_str().equals(&base_want);
    const join_eq: boolean = joined.as_path().as_str().equals(&join_want);
    joined.drop();
    base.drop();
    match (expect(base_eq, Str::new("join must not mutate the receiver"))) {
        Result::Ok(_)  => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return expect(join_eq, Str::new("join result should be '/usr/bin'"));
}

// ============================================================================
// Windows path syntax
//
// Path SYNTAX is per-target, so these pin the answer the running target is
// supposed to give rather than one platform's answer everywhere. Only the
// expectations are target-gated - the test bodies, and so the test roster,
// stay identical on every target.
//
// On Unix `C:\dir\file.txt` is a single segment with no separator in it at
// all, which is the correct reading there: `\` is an ordinary filename byte.
// ============================================================================

/// Expected `parent()` of `C:\dir\file.txt`, "" meaning `None`.
![target(windows)]
function want_drive_parent() -> Str { return Str::new("C:\dir"); }
![target(unix)]
function want_drive_parent() -> Str { return Str::new(""); }

/// Expected `file_name()` of `C:\dir\file.txt`.
![target(windows)]
function want_drive_file_name() -> Str { return Str::new("file.txt"); }
![target(unix)]
function want_drive_file_name() -> Str { return Str::new("C:\dir\file.txt"); }

/// Expected `parent()` of `C:\dir` - the case that must NOT yield `C:`,
/// which would name a different location (the drive's working directory).
![target(windows)]
function want_drive_root_parent() -> Str { return Str::new("C:\\"); }
![target(unix)]
function want_drive_root_parent() -> Str { return Str::new(""); }

/// Whether the running target treats a drive-relative `C:dir` as absolute.
/// It never should: it resolves against that drive's working directory.
![target(windows)]
function want_drive_relative_absolute() -> boolean { return false; }
![target(unix)]
function want_drive_relative_absolute() -> boolean { return false; }

/// `parent()` rendered as a `String`, or "" for `None`, so a missing parent
/// and an empty parent compare the same way.
function parent_text(p: Path) -> String {
    match (p.parent()) {
        Option::Some(x) => { return String::from_str(x.as_str()); }
        Option::None    => { return String::new(); }
    }
}

![test]
function drive_path_splits_per_target() -> Result<(), TestError> {
    const p: Path = Path::from(Str::new("C:\dir\file.txt"));
    mut got: String = parent_text(p);
    const want: Str = want_drive_parent();
    const eq: boolean = got.as_str().equals(&want);
    got.drop();
    return expect(eq, Str::new("parent of 'C:\dir\file.txt'"));
}

![test]
function drive_path_file_name_per_target() -> Result<(), TestError> {
    const p: Path = Path::from(Str::new("C:\dir\file.txt"));
    const want: Str = want_drive_file_name();
    match (p.file_name()) {
        Option::Some(got) => {
            return expect(got.equals(&want),
                          Str::new("file_name of 'C:\dir\file.txt'"));
        }
        Option::None => {
            return expect(false, Str::new("file_name of 'C:\dir\file.txt' was None"));
        }
    }
}

// The root must keep its trailing separator: `C:` and `C:\` name different
// places, so stripping the last segment of `C:\dir` may not yield `C:`.
![test]
function drive_root_parent_keeps_separator() -> Result<(), TestError> {
    const p: Path = Path::from(Str::new("C:\dir"));
    mut got: String = parent_text(p);
    const want: Str = want_drive_root_parent();
    const eq: boolean = got.as_str().equals(&want);
    got.drop();
    return expect(eq, Str::new("parent of 'C:\dir' must not be 'C:'"));
}

![test]
function drive_relative_is_not_absolute() -> Result<(), TestError> {
    const p: Path = Path::from(Str::new("C:dir"));
    return expect(p.is_absolute() == want_drive_relative_absolute(),
                  Str::new("'C:dir' is drive-relative, not absolute"));
}

// A UNC share is entirely root: `\\server` alone names no filesystem, so
// stripping `share` off must yield nothing rather than a half path. Four
// source backslashes are two real ones - the UNC prefix.
//
// On Unix the same bytes hold no separator at all, so there is no parent
// there either, and the expectation needs no target gate.
![test]
function unc_share_has_no_parent() -> Result<(), TestError> {
    const p: Path = Path::from(Str::new("\\\\server\\share"));
    mut got: String = parent_text(p);
    const eq: boolean = got.is_empty();
    got.drop();
    return expect(eq, Str::new("a UNC share root has no parent"));
}

// Posix-shaped paths must answer identically on every target - the toolchain
// passes `/`-separated paths around on Windows too.
![test]
function posix_form_splits_the_same_everywhere() -> Result<(), TestError> {
    const p: Path = Path::from(Str::new("/usr/local/bin"));
    mut got: String = parent_text(p);
    const want: Str = Str::new("/usr/local");
    const eq: boolean = got.as_str().equals(&want);
    got.drop();
    match (expect(eq, Str::new("parent of '/usr/local/bin'"))) {
        Result::Ok(_)  => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return expect(p.is_absolute(), Str::new("'/usr/local/bin' is absolute"));
}
