///! fs::path — Path / PathBuf parsing and joining.

![config(testing)]
namespace CryoTests::Tests::Stdlib::PathT;

import std::core::result;
import std::core::option;
import std::collections::str;
import std::collections::string;
import std::fs::path;
import std::test::error;
import std::test::assert;

// ============================================================================
// Path — borrowed
// ============================================================================

![test]
function absolute_path_detected() -> Result<(), TestError> {
    const src: Str = Str::from_raw("/etc/hosts" as u8*, 10);
    const p: Path = Path::from_str(src);
    match (expect(p.is_absolute(),
        Str::from_raw("/etc/hosts should be absolute" as u8*, 29))) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

![test]
function relative_path_not_absolute() -> Result<(), TestError> {
    const src: Str = Str::from_raw("etc/hosts" as u8*, 9);
    const p: Path = Path::from_str(src);
    match (expect(!p.is_absolute(),
        Str::from_raw("etc/hosts should not be absolute" as u8*, 32))) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

![test]
function file_name_extracts_last_segment() -> Result<(), TestError> {
    const src: Str = Str::from_raw("/usr/local/bin/cryo" as u8*, 19);
    const p: Path = Path::from_str(src);
    match (p.file_name()) {
        Option::Some(name) => {
            const want: Str = Str::from_raw("cryo" as u8*, 4);
            match (expect(name.equals(&want),
                Str::from_raw("file_name should be 'cryo'" as u8*, 26))) {
                Result::Ok(_) => { }
                Result::Err(e) => { return Result::Err(e); }
            }
        }
        Option::None => {
            return bail(Str::from_raw("file_name should be Some" as u8*, 24));
        }
    }
    return Result::Ok(());
}

![test]
function file_name_trailing_slash_is_none() -> Result<(), TestError> {
    const src: Str = Str::from_raw("/var/log/" as u8*, 9);
    const p: Path = Path::from_str(src);
    match (p.file_name()) {
        Option::Some(_) => {
            return bail(Str::from_raw(
                "trailing-slash path should have no file_name" as u8*, 44));
        }
        Option::None => { }
    }
    return Result::Ok(());
}

![test]
function parent_strips_last_segment() -> Result<(), TestError> {
    const src: Str = Str::from_raw("/usr/local/bin" as u8*, 14);
    const p: Path = Path::from_str(src);
    match (p.parent()) {
        Option::Some(parent) => {
            const want: Str = Str::from_raw("/usr/local" as u8*, 10);
            match (expect(parent.as_str().equals(&want),
                Str::from_raw("parent should be /usr/local" as u8*, 27))) {
                Result::Ok(_) => { }
                Result::Err(e) => { return Result::Err(e); }
            }
        }
        Option::None => {
            return bail(Str::from_raw("parent should be Some" as u8*, 21));
        }
    }
    return Result::Ok(());
}

![test]
function parent_of_root_subdir_is_root() -> Result<(), TestError> {
    const src: Str = Str::from_raw("/usr" as u8*, 4);
    const p: Path = Path::from_str(src);
    match (p.parent()) {
        Option::Some(parent) => {
            const want: Str = Str::from_raw("/" as u8*, 1);
            match (expect(parent.as_str().equals(&want),
                Str::from_raw("parent of /usr should be /" as u8*, 26))) {
                Result::Ok(_) => { }
                Result::Err(e) => { return Result::Err(e); }
            }
        }
        Option::None => {
            return bail(Str::from_raw("parent of /usr should be Some(/)" as u8*, 32));
        }
    }
    return Result::Ok(());
}

// ============================================================================
// PathBuf — owned
// ============================================================================

![test]
function pathbuf_push_appends_separator() -> Result<(), TestError> {
    mut pb: PathBuf = PathBuf::from_str(Str::from_raw("/usr" as u8*, 4));
    pb.push(Str::from_raw("local" as u8*, 5));
    const view: Str = pb.as_path().as_str();
    const want: Str = Str::from_raw("/usr/local" as u8*, 10);
    const eq: boolean = view.equals(&want);
    pb.drop();
    match (expect(eq,
        Str::from_raw("push 'local' onto '/usr' should be '/usr/local'" as u8*, 47))) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

![test]
function pathbuf_push_absolute_replaces() -> Result<(), TestError> {
    mut pb: PathBuf = PathBuf::from_str(Str::from_raw("/usr/local" as u8*, 10));
    pb.push(Str::from_raw("/etc" as u8*, 4));
    const view: Str = pb.as_path().as_str();
    const want: Str = Str::from_raw("/etc" as u8*, 4);
    const eq: boolean = view.equals(&want);
    pb.drop();
    match (expect(eq,
        Str::from_raw("absolute push should replace path" as u8*, 33))) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

![test]
function pathbuf_pop_strips_segment() -> Result<(), TestError> {
    mut pb: PathBuf = PathBuf::from_str(
        Str::from_raw("/usr/local/bin" as u8*, 14));
    const popped: boolean = pb.pop();
    const view: Str = pb.as_path().as_str();
    const want: Str = Str::from_raw("/usr/local" as u8*, 10);
    const eq: boolean = view.equals(&want);
    pb.drop();
    match (expect(popped,
        Str::from_raw("pop should return true when something was popped" as u8*, 48))) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    match (expect(eq,
        Str::from_raw("pop should leave '/usr/local'" as u8*, 29))) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

![test]
function pathbuf_pop_empty_returns_false() -> Result<(), TestError> {
    mut pb: PathBuf = PathBuf::new();
    const popped: boolean = pb.pop();
    pb.drop();
    match (expect(!popped,
        Str::from_raw("pop on empty PathBuf should return false" as u8*, 40))) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}
