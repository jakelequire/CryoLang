///! TlsConnector / TlsAcceptor - loopback TLS handshake + round-trip.
///!
///! A TLS handshake is bidirectional, so it can't run single-threaded on
///! blocking sockets (client `SSL_connect` would block before the server
///! `SSL_accept` runs). The main thread is the server: it binds + listens
///! FIRST, then spawns the client thread, so there's no connect-before-
///! listen race. The client verifies nothing (self-signed fixture cert);
///! the test proves the encrypted byte channel carries data both ways.
///!
///! Requires `ssl` + `crypto` in `tests/cryoconfig` link_libs and the
///! fixture cert/key under `fixtures/tls/` (cwd is the `tests/` project
///! root when `cryo test` runs).

![config(testing)]
namespace CryoTests::Tests::Stdlib::NetTls;

import std::core::result;
import std::core::option;
import std::core::slice;
import std::collections::str;
import std::io::error;
import std::io::traits;
import std::net::addr::ip;
import std::net::addr::socket_addr;
import std::net::socket::tcp;
import std::net::tls::context;
import std::net::tls::stream;
import std::thread;
import std::ffi::libc;
import std::test::error;
import std::test::assert;

function slices_eq(a: Slice<u8>, b: Slice<u8>) -> boolean {
    if (a.length() != b.length()) { return false; }
    mut i: u64 = 0;
    while (i < a.length()) {
        match (a.get(i)) {
            Option::Some(av) => {
                match (b.get(i)) {
                    Option::Some(bv) => { if (av != bv) { return false; } }
                    Option::None     => { return false; }
                }
            }
            Option::None => { return false; }
        }
        i++;
    }
    return true;
}

/// Client thread: TCP connect, TLS handshake (no verification), send
/// "ping", expect "pong". Returns 1 on full success, 0 otherwise. Drops
/// every owning value on every path.
function tls_client(port: i32) -> i32 {
    mut tcp: TcpStream = match (TcpStream::connect(SocketAddr::localhost_v4(port as u16))) {
        Result::Ok(s)  => { s }
        Result::Err(_) => { return 0; }
    };
    mut connector: TlsConnector = match (TlsConnector::new()) {
        Result::Ok(c)  => { c }
        Result::Err(_) => { tcp.drop(); return 0; }
    };
    connector = connector.danger_accept_invalid_certs();

    mut tls: TlsStream = match (connector.connect(tcp, Str::new("localhost"))) {
        Result::Ok(t)  => { t }
        Result::Err(_) => { connector.drop(); return 0; }
    };
    // `connect` consumed `tcp`; the connector can go now (the stream
    // holds its own SSL_CTX reference).
    connector.drop();

    mut ok: i32 = 0;
    match (tls.write(Str::new("ping").as_bytes())) {
        Result::Ok(_)  => {
            mut buf: u8[16];
            match (tls.read_all(&buf[0], 4)) {
                Result::Ok(n) => {
                    if (slices_eq(Slice::from_raw(&buf[0], n), Str::new("pong").as_bytes())) {
                        ok = 1;
                    }
                }
                Result::Err(_) => { }
            }
        }
        Result::Err(_) => { }
    }
    tls.drop();
    return ok;
}

![test]
function loopback_tls_round_trip() -> Result<(), TestError> {
    const port: u16 = (24000 + (libc::getpid() % 20000)) as u16;

    // Bind + listen BEFORE spawning the client so connect can't race.
    mut listener: TcpListener = match (TcpListener::bind(SocketAddr::localhost_v4(port))) {
        Result::Ok(l)  => { l }
        Result::Err(_) => { return bail(Str::new("bind 127.0.0.1 failed")); }
    };

    const handle: thread::JoinHandle<i32> =
        thread::spawn<i32, i32>(port as i32, tls_client);

    // Server side: accept the TCP connection, wrap it in TLS.
    mut tcp_server: TcpStream = match (listener.accept()) {
        Result::Ok(s)  => { s }
        Result::Err(_) => { handle.join(); listener.drop(); return bail(Str::new("accept failed")); }
    };
    mut acceptor: TlsAcceptor = match (TlsAcceptor::new(
            Str::new("fixtures/tls/cert.pem"), Str::new("fixtures/tls/key.pem"))) {
        Result::Ok(a)  => { a }
        Result::Err(_) => { tcp_server.drop(); handle.join(); listener.drop(); return bail(Str::new("TlsAcceptor::new failed (cert/key fixture?)")); }
    };
    mut tls_server: TlsStream = match (acceptor.accept(tcp_server)) {
        Result::Ok(t)  => { t }
        Result::Err(_) => { acceptor.drop(); handle.join(); listener.drop(); return bail(Str::new("server TLS handshake failed")); }
    };

    // Read "ping", reply "pong".
    mut server_ok: boolean = false;
    mut buf: u8[16];
    match (tls_server.read_all(&buf[0], 4)) {
        Result::Ok(n) => {
            if (slices_eq(Slice::from_raw(&buf[0], n), Str::new("ping").as_bytes())) {
                match (tls_server.write(Str::new("pong").as_bytes())) {
                    Result::Ok(_)  => { server_ok = true; }
                    Result::Err(_) => { }
                }
            }
        }
        Result::Err(_) => { }
    }

    tls_server.drop();
    acceptor.drop();
    listener.drop();

    const client_ok: i32 = handle.join();

    match (expect(server_ok, Str::new("server should receive \"ping\" and send \"pong\""))) {
        Result::Ok(_)  => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return expect(client_ok == 1, Str::new("client should complete the TLS round-trip"));
}
