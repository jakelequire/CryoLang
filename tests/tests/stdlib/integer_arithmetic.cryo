///! Checked, saturating, wrapping and overflowing integer arithmetic,
///! powers, bit counts and rotations, floor division, radix parsing, and
///! the single-precision float classes.
///!
///! Each checked operation is driven to both sides of the boundary it
///! guards - the last value that fits and the first that does not - on a
///! width computed in a wider one, on a 64-bit width checked directly, and
///! on a width that delegates.

![config(testing)]
namespace CryoTests::Tests::Stdlib::IntegerArithmetic;

import std::core::result::{ Result };
import std::core::slice::{ Slice };
import std::math::{ FpCategory };
import std::collections::str::{ Str };
import std::test::error::{ TestError };
import std::test::assert::{ expect, expect_eq };

function bytes(text: string) -> &Slice<u8> {
    return Slice::from_raw(text as u8*, text.length() as i64);
}

![test]
function checked_add_at_each_bound() -> Result<(), TestError> {
    expect_eq((126 as i8).checked_add(1).unwrap_or(0), 127)?;
    expect((127 as i8).checked_add(1).is_none(), Str::new("i8 past MAX"))?;
    const minus_one_i8: i8 = -1;
    expect(i8::MIN.checked_add(minus_one_i8).is_none(), Str::new("i8 past MIN"))?;
    expect_eq((254 as u8).checked_add(1).unwrap_or(0), 255)?;
    expect((255 as u8).checked_add(1).is_none(), Str::new("u8 past MAX"))?;
    expect_eq((i64::MAX - 1).checked_add(1).unwrap_or(0), i64::MAX)?;
    expect(i64::MAX.checked_add(1).is_none(), Str::new("i64 past MAX"))?;
    expect(i64::MIN.checked_add(-1).is_none(), Str::new("i64 past MIN"))?;
    expect((u64::MAX - 1).checked_add(1).is_some(), Str::new("u64 to MAX"))?;
    expect(u64::MAX.checked_add(1).is_none(), Str::new("u64 past MAX"))?;
    const one_u128: u128 = 1;
    expect(u128::MAX.checked_add(one_u128).is_none(), Str::new("u128 past MAX"))?;
    return expect(usize::MAX.checked_add(1).is_none(), Str::new("usize past MAX"));
}

![test]
function checked_subtract_at_each_bound() -> Result<(), TestError> {
    expect_eq((3 as u32).checked_subtract(3).unwrap_or(9), 0)?;
    expect((3 as u32).checked_subtract(4).is_none(), Str::new("u32 below 0"))?;
    const above_min_i16: i16 = i16::MIN + 1;
    const minus_one_i16: i16 = -1;
    expect_eq(above_min_i16.checked_subtract(1).unwrap_or(0), i16::MIN)?;
    expect(i16::MIN.checked_subtract(1).is_none(), Str::new("i16 past MIN"))?;
    expect(i16::MAX.checked_subtract(minus_one_i16).is_none(), Str::new("i16 past MAX"))?;
    expect(i64::MIN.checked_subtract(1).is_none(), Str::new("i64 past MIN"))?;
    expect(i64::MAX.checked_subtract(-1).is_none(), Str::new("i64 past MAX"))?;
    expect_eq((0 as i64).checked_subtract(i64::MAX).unwrap_or(0), -i64::MAX)?;
    return expect((1 as isize).checked_subtract(isize::MIN).is_none(), Str::new("isize past MAX"));
}

![test]
function checked_multiply_at_each_bound() -> Result<(), TestError> {
    expect_eq((65535 as i32).checked_multiply(32768).unwrap_or(0), 2147450880)?;
    expect((65536 as i32).checked_multiply(32768).is_none(), Str::new("i32 past MAX"))?;
    const minus_65536: i32 = -65536;
    expect(minus_65536.checked_multiply(32769).is_none(), Str::new("i32 past MIN"))?;
    expect_eq((4294967295 as u64).checked_multiply(4294967297).unwrap_or(0), u64::MAX)?;
    expect((4294967296 as u64).checked_multiply(4294967296).is_none(), Str::new("u64 past MAX"))?;
    expect((-1 as i64).checked_multiply(i64::MIN).is_none(), Str::new("-1 * i64::MIN"))?;
    expect(i64::MIN.checked_multiply(-1).is_none(), Str::new("i64::MIN * -1"))?;
    expect_eq((3037000499 as i64).checked_multiply(3037000499).unwrap_or(0), 9223372030926249001)?;
    expect((3037000500 as i64).checked_multiply(3037000500).is_none(), Str::new("i64 square past MAX"))?;
    return expect_eq((0 as i64).checked_multiply(i64::MIN).unwrap_or(1), 0);
}

![test]
function saturating_clamps_to_the_bound_passed() -> Result<(), TestError> {
    expect_eq((100 as i8).saturating_add(100), 127)?;
    const minus_hundred: i8 = -100;
    expect_eq(minus_hundred.saturating_add(minus_hundred), i8::MIN)?;
    expect_eq(minus_hundred.saturating_subtract(100), i8::MIN)?;
    expect_eq((200 as u8).saturating_add(100), 255)?;
    expect_eq((5 as u16).saturating_subtract(9), 0)?;
    expect_eq((70000 as u32).saturating_multiply(70000), u32::MAX)?;
    expect_eq(i64::MAX.saturating_add(1), i64::MAX)?;
    expect_eq(i64::MIN.saturating_subtract(1), i64::MIN)?;
    expect_eq(i64::MIN.saturating_subtract(-1), i64::MIN + 1)?;
    expect_eq(i64::MAX.saturating_subtract(-1), i64::MAX)?;
    expect_eq(i64::MIN.saturating_multiply(-1), i64::MAX)?;
    expect_eq(i64::MAX.saturating_multiply(-2), i64::MIN)?;
    expect_eq(u64::MAX.saturating_multiply(2), u64::MAX)?;
    expect_eq((3 as u64).saturating_subtract(4), 0)?;
    return expect_eq((7 as i64).saturating_add(-9), -2);
}

![test]
function wrapping_gives_what_the_operators_give() -> Result<(), TestError> {
    expect_eq((255 as u8).wrapping_add(1), 0)?;
    expect_eq((0 as u8).wrapping_subtract(1), 255)?;
    expect_eq((16 as u8).wrapping_multiply(16), 0)?;
    expect_eq((65535 as u16).wrapping_add(2), 1)?;
    expect_eq(u32::MAX.wrapping_multiply(u32::MAX), 1)?;
    expect_eq(i8::MAX.wrapping_add(1), i8::MIN)?;
    expect_eq(i8::MIN.wrapping_subtract(1), i8::MAX)?;
    const minus_one_i16: i16 = -1;
    expect_eq(i16::MIN.wrapping_multiply(minus_one_i16), i16::MIN)?;
    expect_eq(i32::MAX.wrapping_add(i32::MAX), -2)?;
    expect_eq(i64::MAX.wrapping_add(1), i64::MIN)?;
    expect_eq(u64::MAX.wrapping_multiply(2), u64::MAX - 1)?;
    const one_u128: u128 = 1;
    expect(u128::MAX.wrapping_add(one_u128) == 0, Str::new("u128 past MAX wraps to 0"))?;
    const one_i128: i128 = 1;
    expect(i128::MIN.wrapping_subtract(one_i128) == i128::MAX, Str::new("i128 past MIN wraps to MAX"))?;
    expect_eq((0 as usize).wrapping_subtract(1), usize::MAX)?;
    return expect_eq(isize::MAX.wrapping_add(1), isize::MIN);
}

![test]
function overflowing_flags_exactly_the_wrapped_results() -> Result<(), TestError> {
    const fits: (u8, boolean) = (254 as u8).overflowing_add(1);
    expect_eq(fits.0, 255)?;
    expect(!fits.1, Str::new("u8 254 + 1 fits"))?;
    const wraps: (u8, boolean) = (255 as u8).overflowing_add(1);
    expect_eq(wraps.0, 0)?;
    expect(wraps.1, Str::new("u8 255 + 1 wraps"))?;
    const below: (u16, boolean) = (0 as u16).overflowing_subtract(1);
    expect(below.0 == 65535 && below.1, Str::new("u16 0 - 1 wraps"))?;
    const square: (u16, boolean) = (256 as u16).overflowing_multiply(256);
    expect(square.0 == 0 && square.1, Str::new("u16 256 * 256 wraps"))?;
    const last_square: (u16, boolean) = (255 as u16).overflowing_multiply(257);
    expect(last_square.0 == 65535 && !last_square.1, Str::new("u16 255 * 257 fits"))?;
    const past_min: (i32, boolean) = i32::MIN.overflowing_subtract(1);
    expect(past_min.0 == i32::MAX && past_min.1, Str::new("i32 MIN - 1 wraps"))?;
    const negated_min: (i64, boolean) = i64::MIN.overflowing_multiply(-1);
    expect(negated_min.0 == i64::MIN && negated_min.1, Str::new("i64 MIN * -1 wraps"))?;
    const to_min: (i8, boolean) = (-127 as i8).overflowing_subtract(1);
    expect(to_min.0 == i8::MIN && !to_min.1, Str::new("i8 -127 - 1 fits"))?;
    const one_u128: u128 = 1;
    const wide: (u128, boolean) = u128::MAX.overflowing_add(one_u128);
    expect(wide.0 == 0 && wide.1, Str::new("u128 MAX + 1 wraps"))?;
    const two_i128: i128 = 2;
    const wide_signed: (i128, boolean) = i128::MAX.overflowing_multiply(two_i128);
    expect(wide_signed.0 == -2 && wide_signed.1, Str::new("i128 MAX * 2 wraps"))?;
    const pointer: (usize, boolean) = usize::MAX.overflowing_add(1);
    expect(pointer.0 == 0 && pointer.1, Str::new("usize MAX + 1 wraps"))?;
    const minus_one_isize: isize = -1;
    const pointer_signed: (isize, boolean) = isize::MIN.overflowing_add(minus_one_isize);
    return expect(pointer_signed.0 == isize::MAX && pointer_signed.1, Str::new("isize MIN - 1 wraps"));
}

![test]
function power_wraps_and_checked_power_refuses_at_each_bound() -> Result<(), TestError> {
    expect_eq((3 as u64).power(4), 81)?;
    expect_eq((0 as u64).power(0), 1)?;
    expect_eq((0 as i32).power(5), 0)?;
    expect_eq((2 as u8).power(8), 0)?;
    expect_eq((2 as u64).power(64), 0)?;
    expect_eq((-3 as i64).power(3), -27)?;
    expect_eq((-2 as i8).power(8), 0)?;
    expect_eq((7 as u16).power(1), 7)?;
    expect_eq((2 as u8).checked_power(7).unwrap_or(0), 128)?;
    expect((2 as u8).checked_power(8).is_none(), Str::new("u8 2^8"))?;
    expect_eq((-2 as i8).checked_power(7).unwrap_or(0), i8::MIN)?;
    expect((2 as i8).checked_power(7).is_none(), Str::new("i8 2^7"))?;
    expect_eq((255 as u16).checked_power(2).unwrap_or(0), 65025)?;
    expect((256 as u16).checked_power(2).is_none(), Str::new("u16 256^2"))?;
    expect_eq((-2 as i32).checked_power(31).unwrap_or(0), i32::MIN)?;
    expect((2 as u32).checked_power(32).is_none(), Str::new("u32 2^32"))?;
    expect_eq((-2 as i64).checked_power(63).unwrap_or(0), i64::MIN)?;
    expect((2 as i64).checked_power(63).is_none(), Str::new("i64 2^63"))?;
    expect_eq((3 as u64).checked_power(40).unwrap_or(0), 12157665459056928801)?;
    expect((3 as u64).checked_power(41).is_none(), Str::new("u64 3^41"))?;
    // A base whose square overflows, raised to the first power, fits.
    expect_eq((4294967296 as u64).checked_power(1).unwrap_or(0), 4294967296)?;
    expect((4294967296 as u64).checked_power(2).is_none(), Str::new("u64 (2^32)^2"))?;
    expect_eq((0 as u64).checked_power(1000).unwrap_or(9), 0)?;
    expect_eq((1 as u64).checked_power(u32::MAX).unwrap_or(0), 1)?;
    expect_eq((-1 as i64).checked_power(u32::MAX).unwrap_or(0), -1)?;
    const two_u128: u128 = 2;
    expect(two_u128.checked_power(127).unwrap_or(0) == u128::MAX / 2 + 1, Str::new("u128 2^127"))?;
    expect(two_u128.checked_power(128).is_none(), Str::new("u128 2^128"))?;
    const minus_two_i128: i128 = -2;
    expect(minus_two_i128.checked_power(127).unwrap_or(0) == i128::MIN, Str::new("i128 (-2)^127"))?;
    expect(minus_two_i128.checked_power(128).is_none(), Str::new("i128 (-2)^128"))?;
    expect_eq((2 as usize).checked_power(63).unwrap_or(0), (usize::MAX / 2) + 1)?;
    expect((2 as usize).checked_power(64).is_none(), Str::new("usize 2^64"))?;
    return expect((2 as isize).checked_power(63).is_none(), Str::new("isize 2^63"));
}

![test]
function bit_counts_at_zero_one_and_all_ones() -> Result<(), TestError> {
    expect_eq((0 as u8).leading_zeros(), 8)?;
    expect_eq((0 as u8).trailing_zeros(), 8)?;
    expect_eq((0 as u8).count_ones(), 0)?;
    expect_eq((0 as u8).count_zeros(), 8)?;
    expect_eq((1 as u8).leading_zeros(), 7)?;
    expect_eq((128 as u8).trailing_zeros(), 7)?;
    expect_eq((255 as u8).count_ones(), 8)?;
    expect_eq((0 as u16).leading_zeros(), 16)?;
    expect_eq((0 as u16).trailing_zeros(), 16)?;
    expect_eq((32768 as u16).leading_zeros(), 0)?;
    expect_eq((40 as u16).trailing_zeros(), 3)?;
    expect_eq((0 as u32).leading_zeros(), 32)?;
    expect_eq((0 as u32).trailing_zeros(), 32)?;
    expect_eq((65535 as u32).count_zeros(), 16)?;
    expect_eq((0 as u64).leading_zeros(), 64)?;
    expect_eq((0 as u64).trailing_zeros(), 64)?;
    expect_eq(u64::MAX.count_ones(), 64)?;
    expect_eq((1 as u64).leading_zeros(), 63)?;
    expect_eq((-1 as i8).count_ones(), 8)?;
    expect_eq((-1 as i8).leading_zeros(), 0)?;
    expect_eq(i8::MIN.trailing_zeros(), 7)?;
    expect_eq((0 as i8).trailing_zeros(), 8)?;
    expect_eq((0 as i16).leading_zeros(), 16)?;
    expect_eq((-1 as i32).count_zeros(), 0)?;
    expect_eq(i32::MAX.leading_zeros(), 1)?;
    expect_eq(i64::MIN.count_ones(), 1)?;
    expect_eq((0 as u128).leading_zeros(), 128)?;
    expect_eq((0 as u128).trailing_zeros(), 128)?;
    expect_eq((1 as u128).leading_zeros(), 127)?;
    const bit_hundred: u128 = (1 as u128) << 100;
    expect_eq(bit_hundred.trailing_zeros(), 100)?;
    expect_eq(bit_hundred.leading_zeros(), 27)?;
    expect_eq(u128::MAX.count_ones(), 128)?;
    expect_eq((u64::MAX as u128).leading_zeros(), 64)?;
    expect_eq((-1 as i128).count_ones(), 128)?;
    expect_eq((0 as usize).leading_zeros(), 64)?;
    return expect_eq((-1 as isize).count_ones(), 64);
}

![test]
function rotations_carry_bits_around_each_width() -> Result<(), TestError> {
    expect_eq((129 as u8).rotate_left(1), 3)?;
    expect_eq((129 as u8).rotate_left(0), 129)?;
    expect_eq((129 as u8).rotate_left(8), 129)?;
    expect_eq((129 as u8).rotate_right(1), 192)?;
    expect_eq((129 as u8).rotate_right(9), 192)?;
    expect_eq((32769 as u16).rotate_left(4), 24)?;
    expect_eq((32769 as u16).rotate_right(16), 32769)?;
    expect_eq((24 as u16).rotate_right(4), 32769)?;
    expect_eq(i8::MIN.rotate_left(1), 1)?;
    expect_eq((1 as i8).rotate_right(1), i8::MIN)?;
    expect_eq((-2 as i64).rotate_right(1), i64::MAX)?;
    expect_eq(i32::MIN.rotate_left(33), 1)?;
    const one_u128: u128 = 1;
    expect(one_u128.rotate_right(1) == (u128::MAX / 2) + 1, Str::new("u128 1 rotated right to the top"))?;
    expect(one_u128.rotate_left(128) == 1, Str::new("u128 rotated by its width"))?;
    expect(((u128::MAX / 2) + 1).rotate_left(1) == 1, Str::new("u128 top bit rotated to the bottom"))?;
    expect((-2 as i128).rotate_right(1) == i128::MAX, Str::new("i128 -2 rotated right"))?;
    expect_eq((1 as usize).rotate_right(1), (usize::MAX / 2) + 1)?;
    return expect_eq(isize::MIN.rotate_left(1), 1);
}

![test]
function floor_division_rounds_down() -> Result<(), TestError> {
    expect_eq((7 as i64).divide_floor(2), 3)?;
    expect_eq((-7 as i64).divide_floor(2), -4)?;
    expect_eq((7 as i64).divide_floor(-2), -4)?;
    expect_eq((-7 as i64).divide_floor(-2), 3)?;
    expect_eq((-8 as i64).divide_floor(2), -4)?;
    expect_eq((7 as i64).modulo_floor(2), 1)?;
    expect_eq((-7 as i64).modulo_floor(2), 1)?;
    expect_eq((7 as i64).modulo_floor(-2), -1)?;
    expect_eq((-7 as i64).modulo_floor(-2), -1)?;
    return expect_eq((-8 as i64).modulo_floor(2), 0);
}

![test]
function parse_radix_reads_every_byte() -> Result<(), TestError> {
    expect_eq(u64::parse_radix(bytes("18446744073709551615"), 10).unwrap_or(0), u64::MAX)?;
    expect(u64::parse_radix(bytes("18446744073709551616"), 10).is_none(), Str::new("past u64::MAX"))?;
    expect_eq(u64::parse_radix(bytes("ffFF"), 16).unwrap_or(0), 65535)?;
    expect_eq(u64::parse_radix(bytes("zz"), 36).unwrap_or(0), 1295)?;
    expect_eq(u64::parse_radix(bytes("0101"), 2).unwrap_or(0), 5)?;
    expect(u64::parse_radix(bytes("12"), 2).is_none(), Str::new("a digit past the radix"))?;
    expect(u64::parse_radix(bytes(""), 10).is_none(), Str::new("empty"))?;
    expect(u64::parse_radix(bytes("1_0"), 10).is_none(), Str::new("a separator"))?;
    expect(u64::parse_radix(bytes("+1"), 10).is_none(), Str::new("a sign"))?;
    expect(u64::parse_radix(bytes("1"), 1).is_none(), Str::new("radix 1"))?;
    return expect(u64::parse_radix(bytes("1"), 37).is_none(), Str::new("radix 37"));
}

![test]
function parse_radix_prefix_stops_at_non_digit_or_overflow() -> Result<(), TestError> {
    const run: (u64, i64) = u64::parse_radix_prefix(bytes("123abc"), 10).unwrap_or((0, 0));
    expect_eq(run.0, 123)?;
    expect_eq(run.1, 3)?;
    const hex: (u64, i64) = u64::parse_radix_prefix(bytes("7fg"), 16).unwrap_or((0, 0));
    expect_eq(hex.0, 127)?;
    expect_eq(hex.1, 2)?;
    const long: (u64, i64) = u64::parse_radix_prefix(bytes("184467440737095516159"), 10).unwrap_or((0, 0));
    expect_eq(long.0, u64::MAX)?;
    expect_eq(long.1, 20)?;
    return expect(u64::parse_radix_prefix(bytes("x1"), 10).is_none(), Str::new("no leading digit"));
}

![test]
function parse_literal_reads_separated_digits() -> Result<(), TestError> {
    expect_eq(u64::parse_literal(bytes("1_000_000"), 10).unwrap_or(0), 1000000)?;
    expect_eq(u64::parse_literal(bytes("_ff_FF_"), 16).unwrap_or(0), 65535)?;
    expect_eq(u64::parse_literal(bytes("1__0"), 2).unwrap_or(0), 2)?;
    expect_eq(u64::parse_literal(bytes("18_446_744_073_709_551_615"), 10).unwrap_or(0), u64::MAX)?;
    expect(u64::parse_literal(bytes("18_446_744_073_709_551_616"), 10).is_none(), Str::new("past u64::MAX"))?;
    expect_eq(u64::parse_literal(bytes("ffff_ffff_ffff_ffff"), 16).unwrap_or(0), u64::MAX)?;
    expect(u64::parse_literal(bytes("1_0000_0000_0000_0000"), 16).is_none(), Str::new("a seventeenth hex digit"))?;
    expect_eq(u64::parse_literal(bytes("0000_0000_0000_0000_0001"), 16).unwrap_or(0), 1)?;
    expect(u64::parse_literal(bytes(""), 10).is_none(), Str::new("empty"))?;
    expect(u64::parse_literal(bytes("___"), 10).is_none(), Str::new("separators alone"))?;
    expect(u64::parse_literal(bytes("12"), 2).is_none(), Str::new("a digit past the radix"))?;
    expect(u64::parse_literal(bytes("7u8"), 10).is_none(), Str::new("a type suffix"))?;
    expect(u64::parse_literal(bytes("0x1"), 16).is_none(), Str::new("a radix prefix"))?;
    expect(u64::parse_literal(bytes("-1"), 10).is_none(), Str::new("a sign"))?;
    expect(u64::parse_literal(bytes("1"), 1).is_none(), Str::new("radix 1"))?;
    expect(u64::parse_literal(bytes("1"), 37).is_none(), Str::new("radix 37"))?;
    expect(u128::parse_literal(bytes("340_282_366_920_938_463_463_374_607_431_768_211_455"), 10).unwrap_or(0) == u128::MAX,
        Str::new("u128::MAX in decimal"))?;
    expect(u128::parse_literal(bytes("340_282_366_920_938_463_463_374_607_431_768_211_456"), 10).is_none(),
        Str::new("past u128::MAX"))?;
    expect(u128::parse_literal(bytes("340_282_366_920_938_463_463_374_607_431_768_211_455_0"), 10).is_none(),
        Str::new("past u128::MAX by a digit"))?;
    expect(u128::parse_literal(bytes("1_0000_0000_0000_0000"), 16).unwrap_or(0) == (u64::MAX as u128) + 1,
        Str::new("2 to the 64th in hex"))?;
    const ones: string = "1111111111111111111111111111111111111111111111111111111111111111_1111111111111111111111111111111111111111111111111111111111111111";
    expect(u128::parse_literal(bytes(ones), 2).unwrap_or(0) == u128::MAX, Str::new("128 binary ones"))?;
    return expect(u128::parse_literal(bytes("zz_zz"), 36).unwrap_or(0) == 1679615, Str::new("radix 36"));
}

![test]
function text_parsing_keeps_its_contracts() -> Result<(), TestError> {
    expect_eq(u64::try_from(Str::new("18446744073709551615")).unwrap_or(0), u64::MAX)?;
    expect(u64::try_from(Str::new("18446744073709551616")).is_err(), Str::new("decimal overflow"))?;
    expect(u64::try_from(Str::new("12x")).is_err(), Str::new("decimal non-digit"))?;
    expect_eq(Str::new("00000000000000ff").try_to_hex().unwrap_or(0), 255)?;
    expect(Str::new("1ffffffffffffffff").try_to_hex().is_err(), Str::new("hex overflow"))?;
    expect_eq("0x_ff".parse_int::<u64>(), 255)?;
    expect_eq("-1".parse_int::<i64>(), -1)?;
    expect_eq("18446744073709551617".parse_int::<u64>(), 1)?;
    return expect_eq("0b1_0_1z".parse_int::<u8>(), 5);
}

![test]
function single_precision_classes() -> Result<(), TestError> {
    const subnormal: f32 = 1.0e-40;
    const one: f32 = 1.0;
    const zero: f32 = 0.0;
    const negative_zero: f32 = -0.0;
    expect(f32::INFINITY.is_infinite() && f32::NEG_INFINITY.is_infinite(), Str::new("infinities"))?;
    expect(!f32::NAN.is_infinite() && !f32::NAN.is_finite(), Str::new("NaN is neither"))?;
    expect(subnormal.is_finite() && !subnormal.is_normal(), Str::new("subnormal is not normal"))?;
    expect(one.is_normal() && !zero.is_normal(), Str::new("one is normal, zero is not"))?;
    expect(negative_zero.is_sign_negative() && !zero.is_sign_negative(), Str::new("the sign bit"))?;
    expect_eq(category_ordinal(subnormal.classify()), 3)?;
    expect_eq(category_ordinal(f32::NAN.classify()), 0)?;
    expect_eq(category_ordinal(f32::NEG_INFINITY.classify()), 1)?;
    expect_eq(category_ordinal(negative_zero.classify()), 2)?;
    return expect_eq(category_ordinal(f32::MIN_POSITIVE.classify()), 4);
}

function category_ordinal(category: FpCategory) -> i32 {
    return match (category) {
        FpCategory::Nan       => { 0 }
        FpCategory::Infinite  => { 1 }
        FpCategory::Zero      => { 2 }
        FpCategory::Subnormal => { 3 }
        FpCategory::Normal    => { 4 }
    };
}
