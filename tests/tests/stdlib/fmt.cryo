///! fmt — itoa, parse, format_to_string.

![config(testing)]
namespace CryoTests::Tests::Stdlib::FmtT;

import std::core::result;
import std::core::option;
import std::collections::str;
import std::collections::string;
import std::fmt::integer;
import std::fmt::display;
import std::test::error;
import std::test::assert;

// ============================================================================
// Decimal write paths
// ============================================================================

![test]
function write_u64_decimal_zero() -> Result<(), TestError> {
    mut buf: u8[20];
    const n: u64 = integer::write_u64_decimal(&buf[0], 0);
    const view: Str = Str::from_raw(&buf[0], n);
    const want: Str = Str::from_raw("0", 1);
    match (expect(view.equals(&want),
        Str::from_raw("write_u64_decimal(0) should be '0'", 34))) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

![test]
function write_u64_decimal_small() -> Result<(), TestError> {
    mut buf: u8[20];
    const n: u64 = integer::write_u64_decimal(&buf[0], 12345);
    const view: Str = Str::from_raw(&buf[0], n);
    const want: Str = Str::from_raw("12345", 5);
    match (expect(view.equals(&want),
        Str::from_raw("write_u64_decimal(12345) bytes", 30))) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

![test]
function write_i64_decimal_negative() -> Result<(), TestError> {
    mut buf: u8[20];
    const value: i64 = -42 as i64;
    const n: u64 = integer::write_i64_decimal(&buf[0], value);
    const view: Str = Str::from_raw(&buf[0], n);
    const want: Str = Str::from_raw("-42", 3);
    match (expect(view.equals(&want),
        Str::from_raw("write_i64_decimal(-42) should be '-42'", 38))) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

