// ============================================================================
// format_to_string - Display chain end-to-end
// ============================================================================

![test]
function format_to_string_u32() -> Result<(), TestError> {
    const v: u32 = 42;
    match (format_to_string(&v)) {
        Result::Ok(mut s) => {
            const view: Str = s.as_str();
            const want: Str = Str::new("42");
            const eq: boolean = view.equals(&want);
            s.drop();
            match (expect(eq,
                Str::new("format_to_string(42) should be '42'"))) {
                Result::Ok(_) => { }
                Result::Err(e) => { return Result::Err(e); }
            }
        }
        Result::Err(_) => {
            return bail(Str::new("format_to_string failed"));
        }
    }
    return Result::Ok(());
}

![test]
function format_to_string_bool() -> Result<(), TestError> {
    const v: boolean = true;
    match (format_to_string(&v)) {
        Result::Ok(mut s) => {
            const view: Str = s.as_str();
            const want: Str = Str::new("true");
            const eq: boolean = view.equals(&want);
            s.drop();
            match (expect(eq,
                Str::new("format_to_string(true) should be 'true'"))) {
                Result::Ok(_) => { }
                Result::Err(e) => { return Result::Err(e); }
            }
        }
        Result::Err(_) => {
            return bail(Str::new("format_to_string failed"));
        }
    }
    return Result::Ok(());
}

![test]
function format_to_string_negative_i32() -> Result<(), TestError> {
    const v: i32 = -7;
    match (format_to_string(&v)) {
        Result::Ok(mut s) => {
            const view: Str = s.as_str();
            const want: Str = Str::new("-7");
            const eq: boolean = view.equals(&want);
            s.drop();
            match (expect(eq,
                Str::new("format_to_string(-7) should be '-7'"))) {
                Result::Ok(_) => { }
                Result::Err(e) => { return Result::Err(e); }
            }
        }
        Result::Err(_) => {
            return bail(Str::new("format_to_string failed"));
        }
    }
    return Result::Ok(());
}

// ============================================================================
// printf-style print family (variadic, via libc vprintf/vfprintf)
// ============================================================================
//
// These exercise the variadic-argument forwarding (Cryo `args...` lowered to a
// va_list, forwarded to libc `vprintf`).  We assert the `printf` return
// contract (bytes written) because capturing the actual stdout text in-process
// isn't available to the harness; the printed bytes themselves are incidental.

![test]
function printf_returns_byte_count() -> Result<(), TestError> {
    // "42\n" = 3 bytes
    return expect_eq(printf("%d\n", 42), 3);
}

![test]
function printf_two_heterogeneous_args() -> Result<(), TestError> {
    // "ab=7\n" = 5 -- a string and an int through one va_list
    return expect_eq(printf("%s=%d\n", "ab", 7), 5);
}

![test]
function printf_empty_is_just_newline() -> Result<(), TestError> {
    return expect_eq(printf("\n"), 1);
}

![test]
function printf_percent_escape() -> Result<(), TestError> {
    // "%%" -> single literal '%', so "100%\n" = 5
    return expect_eq(printf("100%%\n"), 5);
}

![test]
function printf_returns_byte_count_no_newline() -> Result<(), TestError> {
    return expect_eq(printf("abc"), 3);
}

// ============================================================================
// Display-based print family: print/println/eprint/eprintln take an owned
// `String` (typically an f-string) and drop it.  They return void, so this is
// a compile+run smoke test of the idiom rather than a return-value contract.
// ============================================================================

![test]
function println_display_fstring_smoke() -> Result<(), TestError> {
    const n: i32 = 7;
    println(f"value = {n}");   // builds a String via Display, prints, drops it
    print(f"no-newline");
    return Result::Ok(());
}

// Regression: a module-level `const` interpolated in an f-string hole must
// specialize `fmt_append_display<T>` for the const's type.  The mono arg-type
// resolver previously only knew locals/params/match-bindings, so a top-level
// const left T unbound and codegen emitted an unspecialized template the
// linker couldn't resolve.  Mono now recovers the type via decl_index.
const FSTRING_REGRESSION_CONST: i64 = 4242;

![test]
function fstring_interpolates_module_const() -> Result<(), TestError> {
    mut s: String = f"c={FSTRING_REGRESSION_CONST}";
    const eq: boolean = s.as_str().equals(&Str::new("c=4242"));
    s.drop();
    return expect(eq, Str::new("f-string with a module const should be 'c=4242'"));
}

// Regression: array `.length` (an implicit i64 pseudo-field, not a struct
// field) interpolated in an f-string hole must specialize fmt_append_display.
// The mono arg-type resolver's MemberAccess walk only knew real struct fields,
// so `f"{xs.length}"` left T unbound -> unspecialized template -> link error.
![test]
function fstring_interpolates_array_length() -> Result<(), TestError> {
    mut xs: i64[] = [10, 20, 30];
    mut s: String = f"n={xs.length}";
    const eq: boolean = s.as_str().equals(&Str::new("n=3"));
    s.drop();
    return expect(eq, Str::new("f-string with array .length should be 'n=3'"));
}

// Regression: a C-style `for`-loop variable interpolated in an f-string hole.
// The mono discovery walk registered params + match-arm bindings but not the
// loop variable, so `f"{i}"` left fmt_append_display<T> unspecialized for any
// T whose spec wasn't already forced elsewhere (e.g. u32) -> link error.
![test]
function fstring_interpolates_loop_variable() -> Result<(), TestError> {
    for (mut i: u32 = 0; i < 1u32; i++) {
        mut s: String = f"i={i}";
        const ok: boolean = s.as_str().equals(&Str::new("i=0"));
        s.drop();
        match (expect(ok, Str::new("loop-var f-string should be 'i=0'"))) {
            Result::Ok(_)  => { }
            Result::Err(e) => { return Result::Err(e); }
        }
    }
    return Result::Ok(());
}

// ============================================================================
// Float fixed-point formatting - rounds (not truncates)
//
// Regression: `write_fixed` truncated the fraction, so a representable
// value printed as a *different* one (3.14159 -> "3.141589").  It must
// round half-up, and a fraction that rounds to 1.0 must carry into the
// integer part.
// ============================================================================

// `Str` is a borrowed view, so the formatted-bytes buffer must stay
// alive for the whole comparison: do the format + compare inside one
// frame and never return the `Str`.
function expect_f64_fmt(v: f64, want: string) -> Result<(), TestError> {
    mut buf: u8[64];
    const n: u64 = v.to_buf(&buf[0]);
    const got: Str = Str::from_raw(&buf[0], n);
    const w: Str = Str::new(want);
    return expect(got.equals(&w), Str::new(want));
}

![test]
function float_format_rounds_last_digit() -> Result<(), TestError> {
    // Rounded, not truncated to "3.141589".
    return expect_f64_fmt(3.14159, "3.141590");
}

![test]
function float_format_simple_fraction() -> Result<(), TestError> {
    return expect_f64_fmt(0.1, "0.100000");
}

![test]
function float_format_rounding_carry_into_integer() -> Result<(), TestError> {
    // 9.9999996 rounds to 10.000000 at 6 dp - the fraction rolls over and
    // must carry into the integer part.
    return expect_f64_fmt(9.9999996, "10.000000");
}

![test]
function float_format_whole_number() -> Result<(), TestError> {
    return expect_f64_fmt(1.0, "1.000000");
}

// ============================================================================
// Container / ADT Display + Debug (recursive fmt)
//
// `Option`/`Result`/`Array` implement both `Display` and `Debug`, recursing
// into the element's own `fmt`.  The recursion threads the right trait
// (a nested value in `Debug::fmt` formats via `Debug`, not `Display`) via
// the compiler's bound-directed dispatch.
// ============================================================================

/// Compare an owned `String` to `want`, dropping it afterwards.
function check_fmt(got: String, want: string) -> Result<(), TestError> {
    mut s: String = got;
    const view: Str = s.as_str();
    const w: Str = Str::new(want);
    const eq: boolean = view.equals(&w);
    s.drop();
    return expect(eq, Str::new(want));
}

![test]
function format_option_some_display() -> Result<(), TestError> {
    const o: Option<i32> = Option::Some(42);
    match (format_to_string(&o)) {
        Result::Ok(s)  => { return check_fmt(s, "Some(42)"); }
        Result::Err(_) => { return bail(Str::new("format_to_string(Option) failed")); }
    }
}

![test]
function format_option_none_debug() -> Result<(), TestError> {
    const o: Option<i32> = Option::None;
    match (format_debug_to_string(&o)) {
        Result::Ok(s)  => { return check_fmt(s, "None"); }
        Result::Err(_) => { return bail(Str::new("format_debug_to_string(Option) failed")); }
    }
}

![test]
function format_result_ok_display() -> Result<(), TestError> {
    const r: Result<i32, i32> = Result::Ok(7);
    match (format_to_string(&r)) {
        Result::Ok(s)  => { return check_fmt(s, "Ok(7)"); }
        Result::Err(_) => { return bail(Str::new("format_to_string(Result) failed")); }
    }
}

![test]
function format_result_err_debug() -> Result<(), TestError> {
    const r: Result<i32, i32> = Result::Err(13);
    match (format_debug_to_string(&r)) {
        Result::Ok(s)  => { return check_fmt(s, "Err(13)"); }
        Result::Err(_) => { return bail(Str::new("format_debug_to_string(Result) failed")); }
    }
}

![test]
function format_array_display() -> Result<(), TestError> {
    mut a: Array<i32> = Array<i32>::new();
    a.push(1);
    a.push(2);
    a.push(3);
    match (format_to_string(&a)) {
        Result::Ok(s)  => { a.drop(); return check_fmt(s, "[1, 2, 3]"); }
        Result::Err(_) => { a.drop(); return bail(Str::new("format_to_string(Array) failed")); }
    }
}

![test]
function format_array_of_option_debug() -> Result<(), TestError> {
    // Nested Debug: the element `Option<i32>` formats via `Debug`, not
    // `Display` -- the bound-directed-dispatch case.
    mut a: Array<Option<i32>> = Array<Option<i32>>::new();
    a.push(Option::Some(1));
    a.push(Option::None);
    match (format_debug_to_string(&a)) {
        Result::Ok(s)  => { a.drop(); return check_fmt(s, "[Some(1), None]"); }
        Result::Err(_) => { a.drop(); return bail(Str::new("format_debug_to_string(Array<Option>) failed")); }
    }
}
