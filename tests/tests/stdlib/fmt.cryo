    const view: Str = Str::from_raw(&buf[0], n);
    const want: Str = Str::from_raw("deadbeef", 8);
    match (expect(view.equals(&want),
        Str::from_raw("hex 0xDEADBEEF should be 'deadbeef'", 35))) {
        Result::Ok(_) => { }
