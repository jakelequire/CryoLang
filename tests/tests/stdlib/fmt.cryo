// ============================================================================
// Parsing
// ============================================================================

![test]
function parse_u64_round_trips() -> Result<(), TestError> {
    const src: Str = Str::from_raw("1234", 4);
    match (integer::parse_u64(src)) {
        Option::Some(value) => {
            const want: u64 = 1234;
            match (expect_eq(value, want)) {
                Result::Ok(_) => { }
                Result::Err(e) => { return Result::Err(e); }
            }
        }
        Option::None => {
            return bail(Str::from_raw("parse_u64 should succeed", 24));
        }
    }
    return Result::Ok(());
}

![test]
function parse_u64_rejects_non_digit() -> Result<(), TestError> {
    const src: Str = Str::from_raw("12a4", 4);
    match (integer::parse_u64(src)) {
        Option::Some(_) => {
            return bail(Str::from_raw("parse_u64 should reject non-digit", 33));
        }
        Option::None => { }
    }
    return Result::Ok(());
}

![test]
function parse_u64_rejects_empty() -> Result<(), TestError> {
    const src: Str = Str::from_raw("", 0);
    match (integer::parse_u64(src)) {
        Option::Some(_) => {
            return bail(Str::from_raw("empty input should not parse", 28));
        }
        Option::None => { }
    }
    return Result::Ok(());
}

![test]
function parse_u32_clamps_to_range() -> Result<(), TestError> {
    // 5_000_000_000 > u32::MAX (~4.29e9).
    const src: Str = Str::from_raw("5000000000", 10);
    match (integer::parse_u32(src)) {
        Option::Some(_) => {
            return bail(Str::from_raw("oversized value should not parse to u32", 39));
        }
        Option::None => { }
    }
    return Result::Ok(());
}

![test]
function parse_u8_octet() -> Result<(), TestError> {
    const src: Str = Str::from_raw("255", 3);
    match (integer::parse_u8(src)) {
        Option::Some(value) => {
            match (expect_eq(value, 255 as u8)) {
                Result::Ok(_) => { }
                Result::Err(e) => { return Result::Err(e); }
            }
        }
        Option::None => {
            return bail(Str::from_raw("parse_u8 should accept 255", 26));
        }
    }
    return Result::Ok(());
}

![test]
function parse_u64_hex_round_trips() -> Result<(), TestError> {
    const src: Str = Str::from_raw("ff", 2);
    match (integer::parse_u64_hex(src)) {
        Option::Some(value) => {
            const want: u64 = 255;
            match (expect_eq(value, want)) {
                Result::Ok(_) => { }
                Result::Err(e) => { return Result::Err(e); }
            }
        }
        Option::None => {
            return bail(Str::from_raw("hex 'ff' should parse", 21));
        }
    }
    return Result::Ok(());
}

// ============================================================================
// format_to_string — Display chain end-to-end
// ============================================================================

![test]
function format_to_string_u32() -> Result<(), TestError> {
    const v: u32 = 42;
    match (format_to_string(&v)) {
        Result::Ok(mut s) => {
            const view: Str = s.as_str();
            const want: Str = Str::from_raw("42", 2);
            const eq: boolean = view.equals(&want);
            s.drop();
            match (expect(eq,
                Str::from_raw("format_to_string(42) should be '42'", 35))) {
                Result::Ok(_) => { }
                Result::Err(e) => { return Result::Err(e); }
            }
        }
        Result::Err(_) => {
            return bail(Str::from_raw("format_to_string failed", 23));
        }
    }
    return Result::Ok(());
}

![test]
function format_to_string_bool() -> Result<(), TestError> {
    const v: boolean = true;
    match (format_to_string(&v)) {
        Result::Ok(mut s) => {
            const view: Str = s.as_str();
            const want: Str = Str::from_raw("true", 4);
            const eq: boolean = view.equals(&want);
            s.drop();
            match (expect(eq,
                Str::from_raw("format_to_string(true) should be 'true'", 39))) {
                Result::Ok(_) => { }
                Result::Err(e) => { return Result::Err(e); }
            }
        }
        Result::Err(_) => {
            return bail(Str::from_raw("format_to_string failed", 23));
        }
    }
    return Result::Ok(());
}

![test]
function format_to_string_negative_i32() -> Result<(), TestError> {
    const v: i32 = -7;
    match (format_to_string(&v)) {
        Result::Ok(mut s) => {
            const view: Str = s.as_str();
            const want: Str = Str::from_raw("-7", 2);
            const eq: boolean = view.equals(&want);
            s.drop();
            match (expect(eq,
                Str::from_raw("format_to_string(-7) should be '-7'", 35))) {
                Result::Ok(_) => { }
                Result::Err(e) => { return Result::Err(e); }
            }
        }
        Result::Err(_) => {
            return bail(Str::from_raw("format_to_string failed", 23));
        }
    }
    return Result::Ok(());
}
