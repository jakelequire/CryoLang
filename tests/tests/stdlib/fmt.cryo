// ============================================================================
// Parsing - TryFrom<Str> for the integer widths
// ============================================================================

![test]
function parse_u64_round_trips() -> Result<(), TestError> {
    const src: Str = Str::new("1234");
    match (u64::try_from(src)) {
        Result::Ok(value) => {
            const want: u64 = 1234;
            match (expect_eq(value, want)) {
                Result::Ok(_) => { }
                Result::Err(e) => { return Result::Err(e); }
            }
        }
        Result::Err(_) => {
            return bail(Str::new("u64::try_from should succeed"));
        }
    }
    return Result::Ok(());
}

![test]
function parse_u64_rejects_non_digit() -> Result<(), TestError> {
    const src: Str = Str::new("12a4");
    match (u64::try_from(src)) {
        Result::Ok(_) => {
            return bail(Str::new("u64::try_from should reject non-digit"));
        }
        Result::Err(_) => { }
    }
    return Result::Ok(());
}

![test]
function parse_u64_rejects_empty() -> Result<(), TestError> {
    const src: Str = Str::new("");
    match (u64::try_from(src)) {
        Result::Ok(_) => {
            return bail(Str::new("empty input should not parse"));
        }
        Result::Err(_) => { }
    }
    return Result::Ok(());
}

![test]
function parse_u32_clamps_to_range() -> Result<(), TestError> {
    // 5_000_000_000 > u32::MAX (~4.29e9).
    const src: Str = Str::new("5000000000");
    match (u32::try_from(src)) {
        Result::Ok(_) => {
            return bail(Str::new("oversized value should not parse to u32"));
        }
        Result::Err(_) => { }
    }
    return Result::Ok(());
}

![test]
function parse_u8_octet() -> Result<(), TestError> {
    const src: Str = Str::new("255");
    match (u8::try_from(src)) {
        Result::Ok(value) => {
            match (expect_eq(value, 255 as u8)) {
                Result::Ok(_) => { }
                Result::Err(e) => { return Result::Err(e); }
            }
        }
        Result::Err(_) => {
            return bail(Str::new("u8::try_from should accept 255"));
        }
    }
    return Result::Ok(());
}

![test]
function parse_u64_hex_round_trips() -> Result<(), TestError> {
    const src: Str = Str::new("ff");
    match (src.try_to_hex()) {
        Result::Ok(value) => {
            const want: u64 = 255;
            match (expect_eq(value, want)) {
                Result::Ok(_) => { }
                Result::Err(e) => { return Result::Err(e); }
            }
        }
        Result::Err(_) => {
            return bail(Str::new("hex 'ff' should parse"));
        }
    }
    return Result::Ok(());
}

