///! fmt — itoa, parse, format_to_string.
///!
///! Buffer-write formatting hangs off the primitive types in `core::primitives`
///! (`value.to_decimal_buf(buf)`, `value.to_hex_buf(buf)`, etc.). Parsing
///! goes through `TryFrom<Str>` (`u64::try_from(s)` with `s: Str`) plus
///! the hex-only `Str::try_to_hex()`.

![config(testing)]
namespace CryoTests::Tests::Stdlib::FmtT;

import std::core::result;
import std::core::option;
import std::core::primitives;
import std::core::convert;
import std::collections::str;
import std::collections::string;
import std::fmt::display;
import std::test::error;
import std::test::assert;

// ============================================================================
// Decimal write paths
// ============================================================================

![test]
function write_u64_decimal_zero() -> Result<(), TestError> {
    mut buf: u8[20];
    const value: u64 = 0;
    const n: u64 = value.to_decimal_buf(&buf[0]);
    const view: Str = Str::from_raw(&buf[0], n);
    const want: Str = Str::new("0");
    match (expect(view.equals(&want),
        Str::new("u64(0).to_decimal_buf should be '0'"))) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

![test]
function write_u64_decimal_small() -> Result<(), TestError> {
    mut buf: u8[20];
    const value: u64 = 12345;
    const n: u64 = value.to_decimal_buf(&buf[0]);
    const view: Str = Str::from_raw(&buf[0], n);
    const want: Str = Str::new("12345");
    match (expect(view.equals(&want),
        Str::new("u64(12345).to_decimal_buf bytes"))) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

![test]
function write_i64_decimal_negative() -> Result<(), TestError> {
    mut buf: u8[21];
    const value: i64 = -42 as i64;
    const n: u64 = value.to_decimal_buf(&buf[0]);
    const view: Str = Str::from_raw(&buf[0], n);
    const want: Str = Str::new("-42");
    match (expect(view.equals(&want),
        Str::new("i64(-42).to_decimal_buf should be '-42'"))) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

