// ============================================================================
// format_to_string — Display chain end-to-end
// ============================================================================

![test]
function format_to_string_u32() -> Result<(), TestError> {
    const v: u32 = 42;
    match (format_to_string(&v)) {
        Result::Ok(mut s) => {
            const view: Str = s.as_str();
            const want: Str = Str::from_raw("42", 2);
            const eq: boolean = view.equals(&want);
            s.drop();
            match (expect(eq,
                Str::from_raw("format_to_string(42) should be '42'", 35))) {
                Result::Ok(_) => { }
                Result::Err(e) => { return Result::Err(e); }
            }
        }
        Result::Err(_) => {
            return bail(Str::from_raw("format_to_string failed", 23));
        }
    }
    return Result::Ok(());
}

![test]
function format_to_string_bool() -> Result<(), TestError> {
    const v: boolean = true;
    match (format_to_string(&v)) {
        Result::Ok(mut s) => {
            const view: Str = s.as_str();
            const want: Str = Str::from_raw("true", 4);
            const eq: boolean = view.equals(&want);
            s.drop();
            match (expect(eq,
                Str::from_raw("format_to_string(true) should be 'true'", 39))) {
                Result::Ok(_) => { }
                Result::Err(e) => { return Result::Err(e); }
            }
        }
        Result::Err(_) => {
            return bail(Str::from_raw("format_to_string failed", 23));
        }
    }
    return Result::Ok(());
}

![test]
function format_to_string_negative_i32() -> Result<(), TestError> {
    const v: i32 = -7;
    match (format_to_string(&v)) {
        Result::Ok(mut s) => {
            const view: Str = s.as_str();
            const want: Str = Str::from_raw("-7", 2);
            const eq: boolean = view.equals(&want);
            s.drop();
            match (expect(eq,
                Str::from_raw("format_to_string(-7) should be '-7'", 35))) {
                Result::Ok(_) => { }
                Result::Err(e) => { return Result::Err(e); }
            }
        }
        Result::Err(_) => {
            return bail(Str::from_raw("format_to_string failed", 23));
        }
    }
    return Result::Ok(());
}
