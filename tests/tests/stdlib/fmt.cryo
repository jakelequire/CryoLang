// ============================================================================
// Parsing — TryFrom<Str> for the integer widths
// ============================================================================

![test]
function parse_u64_round_trips() -> Result<(), TestError> {
    const src: Str = Str::from_raw("1234", 4);
    match (u64::from_str(src)) {
        Result::Ok(value) => {
            const want: u64 = 1234;
            match (expect_eq(value, want)) {
                Result::Ok(_) => { }
                Result::Err(e) => { return Result::Err(e); }
            }
        }
        Result::Err(_) => {
            return bail(Str::from_raw("u64::from_str should succeed", 28));
        }
    }
    return Result::Ok(());
}

![test]
function parse_u64_rejects_non_digit() -> Result<(), TestError> {
    const src: Str = Str::from_raw("12a4", 4);
    match (u64::from_str(src)) {
        Result::Ok(_) => {
            return bail(Str::from_raw("u64::from_str should reject non-digit", 37));
        }
        Result::Err(_) => { }
    }
    return Result::Ok(());
}

![test]
function parse_u64_rejects_empty() -> Result<(), TestError> {
    const src: Str = Str::from_raw("", 0);
    match (u64::from_str(src)) {
        Result::Ok(_) => {
            return bail(Str::from_raw("empty input should not parse", 28));
        }
        Result::Err(_) => { }
    }
    return Result::Ok(());
}

![test]
function parse_u32_clamps_to_range() -> Result<(), TestError> {
    // 5_000_000_000 > u32::MAX (~4.29e9).
    const src: Str = Str::from_raw("5000000000", 10);
    match (u32::from_str(src)) {
        Result::Ok(_) => {
            return bail(Str::from_raw("oversized value should not parse to u32", 39));
        }
        Result::Err(_) => { }
    }
    return Result::Ok(());
}

![test]
function parse_u8_octet() -> Result<(), TestError> {
    const src: Str = Str::from_raw("255", 3);
    match (u8::from_str(src)) {
        Result::Ok(value) => {
            match (expect_eq(value, 255 as u8)) {
                Result::Ok(_) => { }
                Result::Err(e) => { return Result::Err(e); }
            }
        }
        Result::Err(_) => {
            return bail(Str::from_raw("u8::from_str should accept 255", 30));
        }
    }
    return Result::Ok(());
}

![test]
function parse_u64_hex_round_trips() -> Result<(), TestError> {
    const src: Str = Str::from_raw("ff", 2);
    match (src.try_to_hex()) {
        Result::Ok(value) => {
            const want: u64 = 255;
            match (expect_eq(value, want)) {
                Result::Ok(_) => { }
                Result::Err(e) => { return Result::Err(e); }
            }
        }
        Result::Err(_) => {
            return bail(Str::from_raw("hex 'ff' should parse", 21));
        }
    }
    return Result::Ok(());
}

// ============================================================================
// Signed parsing
// ============================================================================

![test]
function parse_i32_negative() -> Result<(), TestError> {
    const src: Str = Str::from_raw("-42", 3);
    match (i32::from_str(src)) {
        Result::Ok(value) => {
            const want: i32 = -42;
            match (expect_eq(value, want)) {
                Result::Ok(_) => { }
                Result::Err(e) => { return Result::Err(e); }
            }
        }
        Result::Err(_) => {
            return bail(Str::from_raw("i32::from_str(\"-42\") should succeed", 35));
        }
    }
    return Result::Ok(());
}

![test]
function parse_i32_plus_sign() -> Result<(), TestError> {
    const src: Str = Str::from_raw("+100", 4);
    match (i32::from_str(src)) {
        Result::Ok(value) => {
            const want: i32 = 100;
            match (expect_eq(value, want)) {
                Result::Ok(_) => { }
                Result::Err(e) => { return Result::Err(e); }
            }
        }
        Result::Err(_) => {
            return bail(Str::from_raw("i32::from_str(\"+100\") should succeed", 36));
        }
    }
    return Result::Ok(());
}

![test]
function parse_i64_min_value() -> Result<(), TestError> {
    // i64::MIN — the boundary case that breaks naive negate-after-parse.
    const src: Str = Str::from_raw("-9223372036854775808", 20);
    match (i64::from_str(src)) {
        Result::Ok(value) => {
            const want: i64 = -9223372036854775808;
            match (expect_eq(value, want)) {
                Result::Ok(_) => { }
                Result::Err(e) => { return Result::Err(e); }
            }
        }
        Result::Err(_) => {
            return bail(Str::from_raw("i64::from_str should accept i64::MIN", 36));
        }
    }
    return Result::Ok(());
}

![test]
function parse_i8_overflow_rejected() -> Result<(), TestError> {
    // 128 is one past i8::MAX.
    const src: Str = Str::from_raw("128", 3);
    match (i8::from_str(src)) {
        Result::Ok(_) => {
            return bail(Str::from_raw("i8::from_str should reject 128", 30));
        }
        Result::Err(_) => { }
    }
    return Result::Ok(());
}

![test]
function parse_i32_lone_sign_rejected() -> Result<(), TestError> {
    const src: Str = Str::from_raw("-", 1);
    match (i32::from_str(src)) {
        Result::Ok(_) => {
            return bail(Str::from_raw("bare \"-\" should not parse", 25));
        }
        Result::Err(_) => { }
    }
    return Result::Ok(());
}

