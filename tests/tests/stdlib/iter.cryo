///! core::iter + ops::Range - bounded numeric sequences.
///!
///! `Range<T>` is half-open `[start, end)`; `RangeInclusive<T>` is the
///! closed form `[start, end]`.  Both implement `Iterator<T>` once `T`
///! satisfies the `Step + Ord` bounds.  These tests pin:
///!
///!   * `next` walks the sequence and returns `None` at the right place
///!     (one past the endpoint for `Range`, exactly at the endpoint for
///!     `RangeInclusive`).
///!   * `count` default walks the iterator and reports a u64 - usable
///!     without an O(1) override.
///!   * `fold` default reduces through a caller-supplied function.
///!   * `for_each` default consumes purely for side effects.
///!   * Integer-width parity: the same code shape works for `i32` and
///!     `u64` because `Step` is implemented for every integer width.
///!   * Edge cases: empty range, single-element range, the inclusive
///!     range's `exhausted` latch (no successor past `end`).

![config(testing)]
namespace CryoTests::Tests::Stdlib::IterT;

import std::core::result;
import std::core::option;
import std::core::iter;
import std::core::ops;
import std::test::error;
import std::test::assert;

// ============================================================================
// Range - half-open
// ============================================================================

![test]
function range_yields_each_element_in_order() -> Result<(), TestError> {
    // 0, 1, 2 - three elements.  Sum them to assert the full sequence
    // by side effect without needing a separate Array.
    mut r: Range<i32> = Range::new(0, 3);
    mut sum: i32 = 0;
    mut produced: i32 = 0;
    loop {
        match (r.next()) {
            Option::Some(v) => { sum = sum + v; produced = produced + 1; }
            Option::None    => { break; }
        }
    }
    match (expect_eq(sum, 3)) { // 0+1+2
        Result::Ok(_) => { } Result::Err(e) => { return Result::Err(e); }
    }
    return expect_eq(produced, 3);
}

![test]
function range_exhausts_after_end() -> Result<(), TestError> {
    // Draining the iterator, then calling next once more, must yield
    // None - the half-open contract.
    mut r: Range<i32> = Range::new(0, 2);
    r.next();
    r.next();
    const after: Option<i32> = r.next();
    return expect_none(&after,
        Str::new("Range(0,2) should be empty after two next() calls"));
}

![test]
function range_empty_when_start_equals_end() -> Result<(), TestError> {
    mut r: Range<i32> = Range::new(5, 5);
    const first: Option<i32> = r.next();
    return expect_none(&first,
        Str::new("Range(5,5) should be immediately empty"));
}

![test]
function range_empty_when_start_greater_than_end() -> Result<(), TestError> {
    // The bound check uses Ord; start > end immediately yields None
    // without underflow risk.
    mut r: Range<i32> = Range::new(10, 5);
    const first: Option<i32> = r.next();
    return expect_none(&first,
        Str::new("Range(10,5) should be empty"));
}

![test]
function range_single_element() -> Result<(), TestError> {
    mut r: Range<i32> = Range::new(7, 8);
    match (r.next()) {
        Option::Some(v) => {
            match (expect_eq(v, 7)) {
                Result::Ok(_) => { } Result::Err(e) => { return Result::Err(e); }
            }
        }
        Option::None => {
            return bail(Str::new("Range(7,8) should yield at least one element"));
        }
    }
    const after: Option<i32> = r.next();
    return expect_none(&after,
        Str::new("Range(7,8) should yield exactly one element"));
}

// ============================================================================
// RangeInclusive - closed
// ============================================================================

![test]
function inclusive_yields_endpoint() -> Result<(), TestError> {
    // 1..=3 yields 1, 2, 3 - three elements including the upper bound.
    mut r: RangeInclusive<i32> = RangeInclusive::new(1, 3);
    mut sum: i32 = 0;
    mut produced: i32 = 0;
    loop {
        match (r.next()) {
            Option::Some(v) => { sum = sum + v; produced = produced + 1; }
            Option::None    => { break; }
        }
    }
    match (expect_eq(sum, 6)) { // 1+2+3
        Result::Ok(_) => { } Result::Err(e) => { return Result::Err(e); }
    }
    return expect_eq(produced, 3);
}

![test]
function inclusive_yields_single_endpoint_when_start_equals_end() -> Result<(), TestError> {
    // 5..=5 yields exactly 5, then None.  The exhausted latch must
    // not run successor() past the endpoint (overflow protection for
    // unsigned types at u64::MAX).
    mut r: RangeInclusive<i32> = RangeInclusive::new(5, 5);
    match (r.next()) {
        Option::Some(v) => {
            match (expect_eq(v, 5)) {
                Result::Ok(_) => { } Result::Err(e) => { return Result::Err(e); }
            }
        }
        Option::None => {
            return bail(Str::new("5..=5 should yield 5"));
        }
    }
    const after: Option<i32> = r.next();
    return expect_none(&after,
        Str::new("5..=5 should be exhausted after one yield"));
}

![test]
function inclusive_empty_when_start_greater_than_end() -> Result<(), TestError> {
    mut r: RangeInclusive<i32> = RangeInclusive::new(10, 5);
    const first: Option<i32> = r.next();
    return expect_none(&first,
        Str::new("10..=5 should be empty (start > end)"));
}

// ============================================================================
// Integer-width parity - u64 path must work identically
// ============================================================================

![test]
function range_u64_yields_each_element() -> Result<(), TestError> {
    const start_u64: u64 = 100;
    const end_u64: u64   = 103;
    mut r: Range<u64> = Range::new(start_u64, end_u64);
    mut sum_u64: u64 = 0;
    mut count_u64: u64 = 0;
    loop {
        match (r.next()) {
            Option::Some(v) => { sum_u64 = sum_u64 + v; count_u64 = count_u64 + 1; }
            Option::None    => { break; }
        }
    }
    // 100 + 101 + 102 = 303
    const want_sum: u64 = 303;
    match (expect_eq(sum_u64, want_sum)) {
        Result::Ok(_) => { } Result::Err(e) => { return Result::Err(e); }
    }
    const want_count: u64 = 3;
    return expect_eq(count_u64, want_count);
}

// ============================================================================
// count default - walks the iterator, returns u64
// ============================================================================

![test]
function count_default_walks_to_exhaustion() -> Result<(), TestError> {
    // 0..10 → 10 elements.  Trait default `count` walks via `next`
    // until None.
    mut r: Range<i32> = Range::new(0, 10);
    const got: u64 = r.count();
    const want: u64 = 10;
    return expect_eq(got, want);
}

![test]
function count_on_empty_range_is_zero() -> Result<(), TestError> {
    mut r: Range<i32> = Range::new(5, 5);
    const got: u64 = r.count();
    return expect_eq(got, 0 as u64);
}

// ============================================================================
// fold / for_each defaults - own-generic + fn-typed-param trait defaults
// ============================================================================
//
// These defaults carry the trait's `Item` generic inside their signatures
// (`fold<Acc>(... f: (Acc, Item) -> Acc)`, `for_each(f: (Item) -> void)`).
// Until default-method materialization rewrote `Item` to the impl's trait
// arg, specializing `fold` for a concrete `Range<i32>` left a dangling
// generic that aborted the name mangler (no diagnostic, exit 134); pin the
// behavior so any regression resurfaces as a clean test failure here.

function iter_add_i32(acc: i32, x: i32) -> i32 { return acc + x; }
function iter_add_u64(acc: u64, x: u64) -> u64 { return acc + x; }

mut g_for_each_sum: i32 = 0;
function iter_accumulate(x: i32) -> void { g_for_each_sum = g_for_each_sum + x; }

![test]
function fold_default_reduces_via_function() -> Result<(), TestError> {
    // 1+2+3+4 = 10 (half-open).
    mut r: Range<i32> = Range::new(1, 5);
    return expect_eq(r.fold(0, iter_add_i32), 10);
}

![test]
function fold_default_u64_width_parity() -> Result<(), TestError> {
    // 10+11+12+13 = 46; the same default specializes for the u64 Step impl.
    const start_u64: u64 = 10;
    const end_u64: u64   = 14;
    mut r: Range<u64> = Range::new(start_u64, end_u64);
    const want: u64 = 46;
    return expect_eq(r.fold(0 as u64, iter_add_u64), want);
}

![test]
function for_each_default_visits_each_element() -> Result<(), TestError> {
    // for_each is a default with a fn-typed param but no own generic; a
    // module-global accumulator observes its side effects (1+2+3+4+5 = 15).
    g_for_each_sum = 0;
    mut r: Range<i32> = Range::new(1, 6);
    r.for_each(iter_accumulate);
    return expect_eq(g_for_each_sum, 15);
}

// ============================================================================
// char Range - covers the non-integer Step impl
// ============================================================================

![test]
function range_char_walks_ascii_letters() -> Result<(), TestError> {
    // 'a' .. 'd' should yield 'a', 'b', 'c' - three letters.  Verify
    // each as a u8 image so we don't depend on char Eq.
    mut r: Range<char> = Range::new('a', 'd');
    mut produced: i32 = 0;
    mut byte_sum: u32 = 0;
    loop {
        match (r.next()) {
            Option::Some(c) => {
                produced = produced + 1;
                byte_sum = byte_sum + (c as u8) as u32;
            }
            Option::None => { break; }
        }
    }
    match (expect_eq(produced, 3)) {
        Result::Ok(_) => { } Result::Err(e) => { return Result::Err(e); }
    }
    // 0x61 + 0x62 + 0x63 = 0x126 = 294
    const want: u32 = 294;
    return expect_eq(byte_sum, want);
}
