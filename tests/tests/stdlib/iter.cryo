///! core::iter + ops::Range - bounded numeric sequences.
///!
///! `Range<T>` is half-open `[start, end)`; `RangeInclusive<T>` is the
///! closed form `[start, end]`.  Both implement `Iterator<T>` once `T`
///! satisfies the `Step + Ord` bounds.  These tests pin:
///!
///!   * `next` walks the sequence and returns `None` at the right place
///!     (one past the endpoint for `Range`, exactly at the endpoint for
///!     `RangeInclusive`).
///!   * `count` default walks the iterator and reports a u64 - usable
///!     without an O(1) override.
///!   * `fold` default reduces through a caller-supplied function.
///!   * `for_each` default consumes purely for side effects.
///!   * Integer-width parity: the same code shape works for `i32` and
///!     `u64` because `Step` is implemented for every integer width.
///!   * Edge cases: empty range, single-element range, the inclusive
///!     range's `exhausted` latch (no successor past `end`).

![config(testing)]
namespace CryoTests::Tests::Stdlib::IterT;

import std::core::result;
import std::core::option;
import std::core::iter;
import std::core::ops;
import std::test::error;
import std::test::assert;

// ============================================================================
// Range - half-open
// ============================================================================

![test]
function range_yields_each_element_in_order() -> Result<(), TestError> {
    // 0, 1, 2 - three elements.  Sum them to assert the full sequence
    // by side effect without needing a separate Array.
    mut r: Range<i32> = Range::new(0, 3);
    mut sum: i32 = 0;
    mut produced: i32 = 0;
    loop {
        match (r.next()) {
            Option::Some(v) => { sum = sum + v; produced = produced + 1; }
            Option::None    => { break; }
        }
    }
    match (expect_eq(sum, 3)) { // 0+1+2
        Result::Ok(_) => { } Result::Err(e) => { return Result::Err(e); }
    }
    return expect_eq(produced, 3);
}

![test]
function range_exhausts_after_end() -> Result<(), TestError> {
    // Draining the iterator, then calling next once more, must yield
    // None - the half-open contract.
    mut r: Range<i32> = Range::new(0, 2);
    r.next();
    r.next();
    const after: Option<i32> = r.next();
    return expect_none(&after,
        Str::new("Range(0,2) should be empty after two next() calls"));
}

![test]
function range_empty_when_start_equals_end() -> Result<(), TestError> {
    mut r: Range<i32> = Range::new(5, 5);
    const first: Option<i32> = r.next();
    return expect_none(&first,
        Str::new("Range(5,5) should be immediately empty"));
}

![test]
function range_empty_when_start_greater_than_end() -> Result<(), TestError> {
    // The bound check uses Ord; start > end immediately yields None
    // without underflow risk.
    mut r: Range<i32> = Range::new(10, 5);
    const first: Option<i32> = r.next();
    return expect_none(&first,
        Str::new("Range(10,5) should be empty"));
}

![test]
function range_single_element() -> Result<(), TestError> {
    mut r: Range<i32> = Range::new(7, 8);
    match (r.next()) {
        Option::Some(v) => {
            match (expect_eq(v, 7)) {
                Result::Ok(_) => { } Result::Err(e) => { return Result::Err(e); }
            }
        }
        Option::None => {
            return bail(Str::new("Range(7,8) should yield at least one element"));
        }
    }
    const after: Option<i32> = r.next();
    return expect_none(&after,
        Str::new("Range(7,8) should yield exactly one element"));
}

// ============================================================================
// RangeInclusive - closed
// ============================================================================

![test]
function inclusive_yields_endpoint() -> Result<(), TestError> {
    // 1..=3 yields 1, 2, 3 - three elements including the upper bound.
    mut r: RangeInclusive<i32> = RangeInclusive::new(1, 3);
    mut sum: i32 = 0;
    mut produced: i32 = 0;
    loop {
        match (r.next()) {
            Option::Some(v) => { sum = sum + v; produced = produced + 1; }
            Option::None    => { break; }
        }
    }
    match (expect_eq(sum, 6)) { // 1+2+3
        Result::Ok(_) => { } Result::Err(e) => { return Result::Err(e); }
    }
    return expect_eq(produced, 3);
}

![test]
function inclusive_yields_single_endpoint_when_start_equals_end() -> Result<(), TestError> {
    // 5..=5 yields exactly 5, then None.  The exhausted latch must
    // not run successor() past the endpoint (overflow protection for
    // unsigned types at u64::MAX).
    mut r: RangeInclusive<i32> = RangeInclusive::new(5, 5);
    match (r.next()) {
        Option::Some(v) => {
            match (expect_eq(v, 5)) {
                Result::Ok(_) => { } Result::Err(e) => { return Result::Err(e); }
            }
        }
        Option::None => {
            return bail(Str::new("5..=5 should yield 5"));
        }
    }
    const after: Option<i32> = r.next();
    return expect_none(&after,
        Str::new("5..=5 should be exhausted after one yield"));
}

![test]
function inclusive_empty_when_start_greater_than_end() -> Result<(), TestError> {
    mut r: RangeInclusive<i32> = RangeInclusive::new(10, 5);
    const first: Option<i32> = r.next();
    return expect_none(&first,
        Str::new("10..=5 should be empty (start > end)"));
}

// ============================================================================
// Integer-width parity - u64 path must work identically
// ============================================================================

![test]
function range_u64_yields_each_element() -> Result<(), TestError> {
    const start_u64: u64 = 100;
    const end_u64: u64   = 103;
    mut r: Range<u64> = Range::new(start_u64, end_u64);
    mut sum_u64: u64 = 0;
    mut count_u64: u64 = 0;
    loop {
        match (r.next()) {
            Option::Some(v) => { sum_u64 = sum_u64 + v; count_u64 = count_u64 + 1; }
            Option::None    => { break; }
        }
    }
    // 100 + 101 + 102 = 303
    const want_sum: u64 = 303;
    match (expect_eq(sum_u64, want_sum)) {
        Result::Ok(_) => { } Result::Err(e) => { return Result::Err(e); }
    }
    const want_count: u64 = 3;
    return expect_eq(count_u64, want_count);
}

// ============================================================================
// count default - walks the iterator, returns u64
// ============================================================================

![test]
function count_default_walks_to_exhaustion() -> Result<(), TestError> {
    // 0..10 → 10 elements.  Trait default `count` walks via `next`
    // until None.
    mut r: Range<i32> = Range::new(0, 10);
    const got: u64 = r.count();
    const want: u64 = 10;
    return expect_eq(got, want);
}

![test]
function count_on_empty_range_is_zero() -> Result<(), TestError> {
    mut r: Range<i32> = Range::new(5, 5);
    const got: u64 = r.count();
    return expect_eq(got, 0 as u64);
}

// ============================================================================
// fold / for_each defaults - own-generic + fn-typed-param trait defaults
// ============================================================================
//
// These defaults carry the trait's `Item` generic inside their signatures
// (`fold<Acc>(... f: (Acc, Item) -> Acc)`, `for_each(f: (Item) -> void)`).
// Until default-method materialization rewrote `Item` to the impl's trait
// arg, specializing `fold` for a concrete `Range<i32>` left a dangling
// generic that aborted the name mangler (no diagnostic, exit 134); pin the
// behavior so any regression resurfaces as a clean test failure here.

function iter_add_i32(acc: i32, x: i32) -> i32 { return acc + x; }
function iter_add_u64(acc: u64, x: u64) -> u64 { return acc + x; }
function iter_double_i32(x: i32) -> i32 { return x * 2; }
function iter_widen_i64(x: i32) -> i64 { return (x as i64) * 10; }
function iter_add_i64(acc: i64, x: i64) -> i64 { return acc + x; }
function iter_is_even(x: i32) -> boolean { return x % 2 == 0; }
function iter_is_odd(x: i32) -> boolean { return x % 2 == 1; }

mut g_for_each_sum: i32 = 0;
function iter_accumulate(x: i32) -> void { g_for_each_sum = g_for_each_sum + x; }

![test]
function fold_default_reduces_via_function() -> Result<(), TestError> {
    // 1+2+3+4 = 10 (half-open).
    mut r: Range<i32> = Range::new(1, 5);
    return expect_eq(r.fold(0, iter_add_i32), 10);
}

![test]
function fold_default_u64_width_parity() -> Result<(), TestError> {
    // 10+11+12+13 = 46; the same default specializes for the u64 Step impl.
    const start_u64: u64 = 10;
    const end_u64: u64   = 14;
    mut r: Range<u64> = Range::new(start_u64, end_u64);
    const want: u64 = 46;
    return expect_eq(r.fold(0 as u64, iter_add_u64), want);
}

![test]
function for_each_default_visits_each_element() -> Result<(), TestError> {
    // for_each is a default with a fn-typed param but no own generic; a
    // module-global accumulator observes its side effects (1+2+3+4+5 = 15).
    g_for_each_sum = 0;
    mut r: Range<i32> = Range::new(1, 6);
    r.for_each(iter_accumulate);
    return expect_eq(g_for_each_sum, 15);
}

// ============================================================================
// char Range - covers the non-integer Step impl
// ============================================================================

![test]
function range_char_walks_ascii_letters() -> Result<(), TestError> {
    // 'a' .. 'd' should yield 'a', 'b', 'c' - three letters.  Verify
    // each as a u8 image so we don't depend on char Eq.
    mut r: Range<char> = Range::new('a', 'd');
    mut produced: i32 = 0;
    mut byte_sum: u32 = 0;
    loop {
        match (r.next()) {
            Option::Some(c) => {
                produced = produced + 1;
                byte_sum = byte_sum + (c as u8) as u32;
            }
            Option::None => { break; }
        }
    }
    match (expect_eq(produced, 3)) {
        Result::Ok(_) => { } Result::Err(e) => { return Result::Err(e); }
    }
    // 0x61 + 0x62 + 0x63 = 0x126 = 294
    const want: u32 = 294;
    return expect_eq(byte_sum, want);
}

// ============================================================================
// TakeIter adapter - lazy `take(n)` combinator
// ============================================================================
//
// `take(this, n)` is a self-returning trait default: it consumes the
// iterator by value and returns a `TakeIter<Self>` yielding at most `n`
// elements.  It's instantiated lazily at the call site (eager
// materialization would self-apply `TakeIter::take` forever).  Keeping the
// where-clause-generic `Iterator` impl on `TakeIter` (its `next` introduces
// the element type `A` only via `where I: Iterator<A>`) requires the
// monomorphizer to recover a concrete spec arg's InstantiatedType wrapper
// when checking/deriving the impl's bounds; without it the impl was dropped
// and `count`/`next` never registered for the spec.  These pin the
// consumption paths that work today: a named-iterator receiver consumed
// inline by a terminal default (`count`) or driven by `for`-in, plus
// binding the adapter to an explicit-typed local
// (`mut t: TakeIter<..> = it.take(n)`) and consuming THAT with `count` /
// `for`-in.  The typed-local binding requires the two textual
// occurrences of `TakeIter<Range<i32>>` (the annotation, resolved before
// monomorphization, and the `take(n)` return, resolved during it) to
// monomorphize to ONE concrete struct; the monomorphizer's spec cache key
// canonicalizes its argument ids (`canon_type_id`) so a nested arg that
// arrives as an InstantiatedType wrapper in one and a concrete struct in
// the other dedupes, instead of producing two structs that compare unequal.
//
// Consuming the adapter with `fold` (an own-generic default whose signature
// names the element type via `(Acc, Item) -> Acc`) also works: the adapter's
// element type comes from the impl's where-clause (`I: Iterator<A>`), and the
// lazy method-specializer recovers it from the spec'd impl's already-resolved
// signature when re-resolution of the cloned annotation can't bind it.
//
// Chaining adapters (`it.take(a).take(b)`) works too: the nested
// `TakeIter<TakeIter<..>>` monomorphizes recursively (its where-clause `A` is
// derived through the inner adapter's own Iterator impl), and its by-value
// `this` receiver - now larger than 8 bytes - is reconstructed from its two
// DirectPair LLVM slots in the method prologue.

![test]
function take_caps_count_at_n() -> Result<(), TestError> {
    // 100-element source, take 4: count reports 4, not 100.
    mut r: Range<i32> = Range::new(0, 100);
    return expect_eq(r.take(4).count(), 4 as u64);
}

![test]
function take_yields_whole_source_when_shorter_than_n() -> Result<(), TestError> {
    // Asking for more than the source holds yields the whole source: a
    // 3-element range capped at 10 still counts 3 (inner exhausts first).
    mut r: Range<i32> = Range::new(0, 3);
    return expect_eq(r.take(10).count(), 3 as u64);
}

![test]
function take_zero_yields_nothing() -> Result<(), TestError> {
    mut r: Range<i32> = Range::new(0, 100);
    return expect_eq(r.take(0).count(), 0 as u64);
}

![test]
function take_drives_for_in_loop() -> Result<(), TestError> {
    // for-in consumes the adapter in place: sum the first 5 of 0.. ->
    // 0+1+2+3+4 = 10, proving `next` stops after `n` and yields real values.
    mut r: Range<i32> = Range::new(0, 100);
    mut sum: i32 = 0;
    for (x in r.take(5)) { sum = sum + x; }
    return expect_eq(sum, 10);
}

![test]
function take_bound_to_typed_local_counts() -> Result<(), TestError> {
    // Bind the adapter to an explicit `TakeIter<Range<i32>>` local, then
    // count it.  The annotation and the `take(3)` return must denote ONE
    // concrete type; before the spec-key canonicalization they monomorphized
    // to two distinct structs and this failed type-checking (`expected
    // TakeIter<Range<i32>>, found TakeIter<Range<i32>>`).
    mut r: Range<i32> = Range::new(0, 10);
    mut t: TakeIter<Range<i32>> = r.take(3);
    return expect_eq(t.count(), 3 as u64);
}

![test]
function take_typed_local_caps_when_n_exceeds_len() -> Result<(), TestError> {
    // n > len through a typed binding: a 4-element non-zero-start range
    // capped at 100 still counts 4.  This exercises the inner iterator end
    // to end (a broken `inner` would not stop at the source's true length).
    mut r: Range<i32> = Range::new(5, 9);
    mut t: TakeIter<Range<i32>> = r.take(100);
    return expect_eq(t.count(), 4 as u64);
}

![test]
function take_typed_local_drives_for_in() -> Result<(), TestError> {
    // for-in over a typed-local adapter sums real element VALUES (not just
    // a count), proving the bound local carries a correct `inner`: the first
    // 4 of 2.. -> 2+3+4+5 = 14.
    mut r: Range<i32> = Range::new(2, 100);
    mut t: TakeIter<Range<i32>> = r.take(4);
    mut sum: i32 = 0;
    for (x in t) { sum = sum + x; }
    return expect_eq(sum, 14);
}

![test]
function take_on_call_expression_receiver_counts() -> Result<(), TestError> {
    // `.take(n)` directly on a call-expression receiver, with no intermediate
    // binding.  The receiver `Range<i32>::new(..)` produces its instantiation
    // during the same inference walk that specializes `take`, so it must be
    // monomorphized on demand; otherwise `take` resolves to the unspecialized
    // `TakeIter<This>` template (E0636) or crashes the mangler.
    return expect_eq(Range<i32>::new(0, 100).take(4).count(), 4 as u64);
}

![test]
function take_on_call_expression_receiver_caps_at_source() -> Result<(), TestError> {
    // Same call-expression-receiver shape, n > len, non-zero start: a 4-element
    // range capped at 100 counts 4, exercising the on-demand-resolved receiver's
    // inner iterator end to end.
    return expect_eq(Range<i32>::new(5, 9).take(100).count(), 4 as u64);
}

![test]
function take_typed_local_folds() -> Result<(), TestError> {
    // `fold` on a typed-local adapter, n > len, non-zero start: 5+6+7+8 = 26.
    // The adapter's element type (`A` from `where I: Iterator<A>`) is recovered
    // for fold's `(Acc, Item) -> Acc` signature from the spec'd impl.
    mut r: Range<i32> = Range::new(5, 9);
    mut t: TakeIter<Range<i32>> = r.take(100);
    return expect_eq(t.fold(0, iter_add_i32), 26);
}

![test]
function take_inline_chain_folds() -> Result<(), TestError> {
    // `fold` directly on `r.take(n)` (named-local inline): first 4 of 1.. ->
    // 1+2+3+4 = 10.
    mut r: Range<i32> = Range::new(1, 100);
    return expect_eq(r.take(4).fold(0, iter_add_i32), 10);
}

![test]
function take_on_call_expression_receiver_folds() -> Result<(), TestError> {
    // `fold` on a call-expression receiver: 10+11+12 = 33.
    return expect_eq(Range<i32>::new(10, 100).take(3).fold(0, iter_add_i32), 33);
}

![test]
function take_chain_caps_at_inner_min() -> Result<(), TestError> {
    // `r.take(10).take(3)`: the outer cap (3) wins -> count 3, not 10.
    // Requires the nested `TakeIter<TakeIter<Range<i32>>>` to monomorphize and
    // its >8-byte by-value `this` receiver to round-trip through both
    // DirectPair slots (a single-slot prologue dropped the upper half and
    // miscounted).
    mut r: Range<i32> = Range::new(0, 100);
    return expect_eq(r.take(10).take(3).count(), 3 as u64);
}

![test]
function take_chain_caps_at_outer_min() -> Result<(), TestError> {
    // `r.take(3).take(10)`: the inner cap (3) wins -> count 3.
    mut r: Range<i32> = Range::new(0, 100);
    return expect_eq(r.take(3).take(10).count(), 3 as u64);
}

![test]
function take_call_expr_receiver_drives_for_in_twice() -> Result<(), TestError> {
    // Two for-in loops, each over a `Range::new(..).take(n)` call-expression
    // receiver in the same function.  Regression: the second loop's iterator
    // binding was mistyped as the inner `Range<i32>` (the constructor's owner,
    // captured by the static-constructor side channel) instead of the
    // `TakeIter` chain result, only when more than one such loop appeared.
    mut s1: i32 = 0;
    for (x in Range<i32>::new(0, 100).take(5)) { s1 = s1 + x; }   // 0+1+2+3+4
    mut s2: i32 = 0;
    for (x in Range<i32>::new(7, 9).take(100)) { s2 = s2 + x; }   // 7+8
    return expect_eq(s1 + s2, 25);
}

![test]
function take_chain_drives_for_in_with_values() -> Result<(), TestError> {
    // for-in over a chained adapter yields real element VALUES: first 4 of
    // 5.. (capped first at 100) -> 5+6+7+8 = 26.  Proves the nested receiver's
    // `inner` survives the DirectPair reconstruction end to end.
    mut r: Range<i32> = Range::new(5, 50);
    mut sum: i32 = 0;
    for (x in r.take(100).take(4)) { sum = sum + x; }
    return expect_eq(sum, 26);
}

// ============================================================================
// MapIter / FilterIter adapters - `map` / `filter` combinators
// ============================================================================
//
// `map<B>` is an own-generic self-returning default; `filter` is a
// zero-own-generic one.  Both store a non-capturing function in a field, so
// the element type(s) are struct parameters (`MapIter<I, A, O>`,
// `FilterIter<I, A>`) rather than where-clause-only generics.  These pin
// map/filter applied directly to an iterator and `map().filter()`.
//
// Combinator-following-combinator chaining (a `map`/`filter` applied to
// another adapter's result) now works for every adapter, including a
// `TakeIter` receiver whose element lives only in its `where I: Iterator<A>`
// bound: the concrete element (`A := i32`) is cached on the spec'd impl at
// monomorphization time and re-seeded when the trailing combinator's default
// is lazily specialized.  The `chain_*` tests below pin `r.take(n).map(f)`,
// `r.take(n).filter(p)`, `r.map(f).map(g)`, deeper triple chains, and the
// values that flow through them.

![test]
function map_counts_preserve_length() -> Result<(), TestError> {
    mut r: Range<i32> = Range::new(0, 5);
    return expect_eq(r.map(iter_double_i32).count(), 5 as u64);
}

![test]
function map_folds_transformed_values() -> Result<(), TestError> {
    // sum of doubles of 0..5 = 2*(0+1+2+3+4) = 20.  `fold` (own-generic) on a
    // `map` (own-generic) result exercises chained own-generic specialization.
    mut r: Range<i32> = Range::new(0, 5);
    return expect_eq(r.map(iter_double_i32).fold(0, iter_add_i32), 20);
}

![test]
function map_can_change_element_type() -> Result<(), TestError> {
    // map i32 -> i64 (output type differs from input): sum 10*(0+1+2) = 30.
    mut r: Range<i32> = Range::new(0, 3);
    return expect_eq(r.map(iter_widen_i64).fold(0 as i64, iter_add_i64), 30 as i64);
}

![test]
function filter_counts_matching() -> Result<(), TestError> {
    // evens in 0..10 -> 0,2,4,6,8 -> 5.
    mut r: Range<i32> = Range::new(0, 10);
    return expect_eq(r.filter(iter_is_even).count(), 5 as u64);
}

![test]
function filter_drives_for_in_with_values() -> Result<(), TestError> {
    // sum of evens in 0..10 = 0+2+4+6+8 = 20.
    mut r: Range<i32> = Range::new(0, 10);
    mut sum: i32 = 0;
    for (x in r.filter(iter_is_even)) { sum = sum + x; }
    return expect_eq(sum, 20);
}

![test]
function map_then_filter_composes() -> Result<(), TestError> {
    // map doubles every element (all even), filter keeps evens -> all 10 kept.
    mut r: Range<i32> = Range::new(0, 10);
    return expect_eq(r.map(iter_double_i32).filter(iter_is_even).count(), 10 as u64);
}

// ============================================================================
// Combinator-following-combinator chaining
// ============================================================================
//
// An own-generic (`map<B>`) or zero-own-generic (`filter`) combinator applied
// to ANOTHER adapter's result.  The hard case is a `TakeIter` receiver: its
// element type is where-clause-only (`implement<I,A> Iterator<A> for
// TakeIter<I> where I: Iterator<A>`), so the trailing combinator's default
// must recover `A` from the cached impl-spec binding rather than a struct arg.

![test]
function chain_take_then_map_counts() -> Result<(), TestError> {
    // take(5) of 0..10 -> 0,1,2,3,4; map doubles -> count unchanged = 5.
    mut r: Range<i32> = Range::new(0, 10);
    return expect_eq(r.take(5).map(iter_double_i32).count(), 5 as u64);
}

![test]
function chain_take_then_map_folds_values() -> Result<(), TestError> {
    // take(5) -> 0,1,2,3,4; map doubles -> 0,2,4,6,8; sum = 20.  Proves the
    // mapped VALUES flow through the recovered element type, not just the count.
    mut r: Range<i32> = Range::new(0, 10);
    return expect_eq(r.take(5).map(iter_double_i32).fold(0, iter_add_i32), 20);
}

![test]
function chain_take_then_map_drives_for_in() -> Result<(), TestError> {
    mut r: Range<i32> = Range::new(0, 10);
    mut sum: i32 = 0;
    for (x in r.take(5).map(iter_double_i32)) { sum = sum + x; }
    return expect_eq(sum, 20);
}

![test]
function chain_take_then_filter_counts() -> Result<(), TestError> {
    // take(5) -> 0,1,2,3,4; keep odds -> 1,3 -> count 2.
    mut r: Range<i32> = Range::new(0, 10);
    return expect_eq(r.take(5).filter(iter_is_odd).count(), 2 as u64);
}

![test]
function chain_take_then_filter_folds_values() -> Result<(), TestError> {
    // take(5) -> 0,1,2,3,4; keep odds -> 1,3; sum = 4.
    mut r: Range<i32> = Range::new(0, 10);
    return expect_eq(r.take(5).filter(iter_is_odd).fold(0, iter_add_i32), 4);
}

![test]
function chain_map_then_map_counts() -> Result<(), TestError> {
    // map.map: own-generic following own-generic on a struct-param adapter.
    mut r: Range<i32> = Range::new(0, 10);
    return expect_eq(r.map(iter_double_i32).map(iter_double_i32).count(), 10 as u64);
}

![test]
function chain_map_then_map_folds_values() -> Result<(), TestError> {
    // each element *4; sum over 0..10 = 4*(0+..+9) = 4*45 = 180.
    mut r: Range<i32> = Range::new(0, 10);
    return expect_eq(
        r.map(iter_double_i32).map(iter_double_i32).fold(0, iter_add_i32), 180);
}

![test]
function chain_map_then_take_then_map_counts() -> Result<(), TestError> {
    // map -> take(3) -> map: take caps the chain to 3 regardless of mapping.
    mut r: Range<i32> = Range::new(0, 10);
    return expect_eq(
        r.map(iter_double_i32).take(3).map(iter_double_i32).count(), 3 as u64);
}

![test]
function chain_take_then_map_then_filter_counts() -> Result<(), TestError> {
    // take(6) -> 0..5; map doubles -> all even; keep evens -> all 6 kept.
    mut r: Range<i32> = Range::new(0, 10);
    return expect_eq(
        r.take(6).map(iter_double_i32).filter(iter_is_even).count(), 6 as u64);
}

![test]
function chain_take_then_filter_then_map_folds() -> Result<(), TestError> {
    // take(6) -> 0..5; keep odds -> 1,3,5; map doubles -> 2,6,10; sum = 18.
    mut r: Range<i32> = Range::new(0, 10);
    return expect_eq(
        r.take(6).filter(iter_is_odd).map(iter_double_i32).fold(0, iter_add_i32), 18);
}

// ============================================================================
// ChainIter adapter - `chain` combinator
// ============================================================================
//
// `chain` concatenates two iterators of the same element type; like `take`,
// `ChainIter`'s element is where-bound-only (`where I: Iterator<A>,
// J: Iterator<A>`).  The second iterator is passed as a named/typed-local
// argument (the supported operand form, same as combinator receivers).

![test]
function chain_concatenates_lengths() -> Result<(), TestError> {
    mut a: Range<i32> = Range::new(0, 3);
    mut b: Range<i32> = Range::new(0, 3);
    return expect_eq(a.chain(b).count(), 6 as u64);
}

![test]
function chain_preserves_order_and_values() -> Result<(), TestError> {
    // 0,1,2 then 10,11,12 -> sum 36.
    mut a: Range<i32> = Range::new(0, 3);
    mut b: Range<i32> = Range::new(10, 13);
    return expect_eq(a.chain(b).fold(0, iter_add_i32), 36);
}

![test]
function chain_drives_for_in_with_values() -> Result<(), TestError> {
    // 0,1,2,3 then 0,1 -> sum 7.
    mut a: Range<i32> = Range::new(0, 4);
    mut b: Range<i32> = Range::new(0, 2);
    mut sum: i32 = 0;
    for (x in a.chain(b)) { sum = sum + x; }
    return expect_eq(sum, 7);
}

![test]
function chain_then_map_composes() -> Result<(), TestError> {
    // (0,1,2,0,1,2) doubled -> sum 2*(0+1+2+0+1+2) = 12.
    mut a: Range<i32> = Range::new(0, 3);
    mut b: Range<i32> = Range::new(0, 3);
    return expect_eq(a.chain(b).map(iter_double_i32).fold(0, iter_add_i32), 12);
}

![test]
function chain_then_filter_composes() -> Result<(), TestError> {
    // (0..4 ++ 0..4) keep odds -> 1,3,1,3 -> count 4.
    mut a: Range<i32> = Range::new(0, 4);
    mut b: Range<i32> = Range::new(0, 4);
    return expect_eq(a.chain(b).filter(iter_is_odd).count(), 4 as u64);
}

![test]
function take_then_chain_caps_then_concatenates() -> Result<(), TestError> {
    // take(3) of 0..9 -> 0,1,2; chain 0..2 -> 0,1 -> sum 0+1+2+0+1 = 4.
    mut r: Range<i32> = Range::new(0, 9);
    mut b: Range<i32> = Range::new(0, 2);
    return expect_eq(r.take(3).chain(b).fold(0, iter_add_i32), 4);
}

![test]
function map_then_chain_concatenates() -> Result<(), TestError> {
    // map doubles 0..3 -> 0,2,4; chain 0..2 -> 0,1 -> sum 0+2+4+0+1 = 7.
    mut r: Range<i32> = Range::new(0, 3);
    mut b: Range<i32> = Range::new(0, 2);
    return expect_eq(r.map(iter_double_i32).chain(b).fold(0, iter_add_i32), 7);
}
