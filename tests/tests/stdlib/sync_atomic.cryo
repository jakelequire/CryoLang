// ---- Atomic<boolean> ---------------------------------------------------------

![test]
function atomic_bool_new_then_load() -> Result<(), TestError> {
    mut a: Atomic<boolean> = Atomic::<boolean>::new(false);
    const v: boolean = a.load(MemoryOrder::SeqCst);
    if (v) {
        return Result::Err(TestError::failed(Str::new("expected false, got true")));
    }
    return Result::Ok(());
}

![test]
function atomic_bool_store_true() -> Result<(), TestError> {
    mut a: Atomic<boolean> = Atomic::<boolean>::new(false);
    a.store(true, MemoryOrder::SeqCst);
    const v: boolean = a.load(MemoryOrder::SeqCst);
    if (!v) {
        return Result::Err(TestError::failed(Str::new("expected true after store")));
    }
    return Result::Ok(());
}

![test]
function atomic_bool_swap() -> Result<(), TestError> {
    mut a: Atomic<boolean> = Atomic::<boolean>::new(false);
    const prev: boolean = a.swap(true, MemoryOrder::SeqCst);
    const cur: boolean = a.load(MemoryOrder::SeqCst);
    if (prev) {
        return Result::Err(TestError::failed(Str::new("swap should report false (prior)")));
    }
    if (!cur) {
        return Result::Err(TestError::failed(Str::new("expected true after swap")));
    }
    return Result::Ok(());
}

// ---- fence + compiler_fence: accepted, no observable effect single-thread ----

![test]
function fence_does_not_crash() -> Result<(), TestError> {
    atomic::fence(MemoryOrder::SeqCst);
    atomic::compiler_fence(MemoryOrder::SeqCst);
    return Result::Ok(());
}

// Relaxed is below the minimum ordering LLVM's `fence` accepts; passing it
// through raw produced invalid IR. Both entry points now clamp Relaxed up to
// SeqCst, so a Relaxed (or Acquire/Release/AcqRel) request compiles and runs.
![test]
function fence_relaxed_is_clamped_not_invalid() -> Result<(), TestError> {
    atomic::fence(MemoryOrder::Relaxed);
    atomic::fence(MemoryOrder::Acquire);
    atomic::fence(MemoryOrder::Release);
    atomic::fence(MemoryOrder::AcqRel);
    atomic::compiler_fence(MemoryOrder::Relaxed);
    atomic::compiler_fence(MemoryOrder::Acquire);
    return Result::Ok(());
}

// ---- the 16-bit, 8-bit signed and pointer-width cells -----------------------

![test]
function atomic_u16_wraps_and_masks() -> Result<(), TestError> {
    const a: Atomic<u16> = Atomic::<u16>::new(65535);
    expect_equal(a.fetch_add(1, MemoryOrder::SeqCst), 65535 as u16)?;
    expect_equal(a.load(MemoryOrder::SeqCst), 0 as u16)?;
    a.store(0x1234, MemoryOrder::SeqCst);
    expect_equal(a.fetch_and(0xFF00, MemoryOrder::SeqCst), 0x1234 as u16)?;
    expect_equal(a.fetch_or(0x00AB, MemoryOrder::SeqCst), 0x1200 as u16)?;
    expect_equal(a.fetch_xor(0xFFFF, MemoryOrder::SeqCst), 0x12AB as u16)?;
    expect_equal(a.swap(7, MemoryOrder::SeqCst), 0xED54 as u16)?;
    expect_equal(a.fetch_subtract(8, MemoryOrder::SeqCst), 7 as u16)?;
    expect_equal(a.load(MemoryOrder::SeqCst), 65535 as u16)?;
    return Result::Ok(());
}

![test]
function atomic_i8_keeps_its_sign() -> Result<(), TestError> {
    const a: Atomic<i8> = Atomic::<i8>::new(-1);
    expect_equal(a.fetch_add(1, MemoryOrder::SeqCst), -1 as i8)?;
    expect_equal(a.fetch_add(-128, MemoryOrder::SeqCst), 0 as i8)?;
    expect_equal(a.load(MemoryOrder::SeqCst), -128 as i8)?;
    expect_equal(a.fetch_or(1, MemoryOrder::SeqCst), -128 as i8)?;
    expect_equal(a.fetch_and(-2, MemoryOrder::SeqCst), -127 as i8)?;
    expect_equal(a.fetch_xor(-1, MemoryOrder::SeqCst), -128 as i8)?;
    expect_equal(a.swap(-5, MemoryOrder::SeqCst), 127 as i8)?;
    match (a.compare_exchange(-5, -6, MemoryOrder::SeqCst, MemoryOrder::SeqCst)) {
        Result::Ok(previous) => { expect_equal(previous, -5 as i8)?; }
        Result::Err(_)       => { return Result::Err(TestError::failed(Str::new("an i8 exchange of the value held must succeed"))); }
    }
    expect_equal(a.fetch_subtract(10, MemoryOrder::SeqCst), -6 as i8)?;
    expect_equal(a.load(MemoryOrder::SeqCst), -16 as i8)?;
    return Result::Ok(());
}

![test]
function atomic_i16_keeps_its_sign() -> Result<(), TestError> {
    const a: Atomic<i16> = Atomic::<i16>::new(-30000);
    expect_equal(a.fetch_subtract(10000, MemoryOrder::SeqCst), -30000 as i16)?;
    expect_equal(a.load(MemoryOrder::SeqCst), 25536 as i16)?;
    expect_equal(a.fetch_add(-25537, MemoryOrder::SeqCst), 25536 as i16)?;
    expect_equal(a.fetch_and(0x7FFF, MemoryOrder::SeqCst), -1 as i16)?;
    expect_equal(a.fetch_xor(0x7FFF, MemoryOrder::SeqCst), 0x7FFF as i16)?;
    expect_equal(a.fetch_or(-32768, MemoryOrder::SeqCst), 0 as i16)?;
    expect_equal(a.swap(300, MemoryOrder::SeqCst), -32768 as i16)?;
    match (a.compare_exchange(299, 0, MemoryOrder::SeqCst, MemoryOrder::SeqCst)) {
        Result::Ok(_)       => { return Result::Err(TestError::failed(Str::new("an i16 exchange of a value not held must fail"))); }
        Result::Err(actual) => { expect_equal(actual, 300 as i16)?; }
    }
    return Result::Ok(());
}

![test]
function atomic_usize_and_isize_are_64_bits() -> Result<(), TestError> {
    // On this 64-bit host a `usize` cell carries past `u32`'s maximum.
    const u: Atomic<usize> = Atomic::<usize>::new(0xFFFFFFFF);
    expect_equal(u.fetch_add(1, MemoryOrder::SeqCst), 0xFFFFFFFF as usize)?;
    expect_equal(u.load(MemoryOrder::SeqCst), 0x100000000 as u64 as usize)?;
    expect_equal(u.fetch_xor(0x100000001 as u64 as usize, MemoryOrder::SeqCst), 0x100000000 as u64 as usize)?;
    expect_equal(u.swap(9, MemoryOrder::SeqCst), 1 as usize)?;
    match (u.compare_exchange(9, 10, MemoryOrder::SeqCst, MemoryOrder::SeqCst)) {
        Result::Ok(previous) => { expect_equal(previous, 9 as usize)?; }
        Result::Err(_)       => { return Result::Err(TestError::failed(Str::new("a usize exchange of the value held must succeed"))); }
    }
    const s: Atomic<isize> = Atomic::<isize>::new(-1);
    expect_equal(s.fetch_subtract(isize::MAX, MemoryOrder::SeqCst), -1 as isize)?;
    expect_equal(s.load(MemoryOrder::SeqCst), isize::MIN)?;
    expect_equal(s.fetch_and(0xFF, MemoryOrder::SeqCst), isize::MIN)?;
    expect_equal(s.fetch_or(-256, MemoryOrder::SeqCst), 0 as isize)?;
    expect_equal(s.swap(42, MemoryOrder::SeqCst), -256 as isize)?;
    expect_equal(s.load(MemoryOrder::SeqCst), 42 as isize)?;
    return Result::Ok(());
}

// ---- Atomic<char>, Atomic<f32>, Atomic<f64> --------------------------------

![test]
function atomic_char_cell_holds_any_code_point() -> Result<(), TestError> {
    const c: Atomic<char> = Atomic::<char>::new('a');
    expect_equal(c.load(MemoryOrder::SeqCst), 'a')?;
    c.store(0x1F600 as char, MemoryOrder::SeqCst);
    expect_equal(c.load(MemoryOrder::SeqCst) as u32, 0x1F600 as u32)?;
    expect_equal(c.swap('Z', MemoryOrder::SeqCst) as u32, 0x1F600 as u32)?;
    match (c.compare_exchange('Z', '\0', MemoryOrder::SeqCst, MemoryOrder::SeqCst)) {
        Result::Ok(previous) => { expect_equal(previous, 'Z')?; }
        Result::Err(_)       => { return Result::Err(TestError::failed(Str::new("a char exchange of the code point held must succeed"))); }
    }
    match (c.compare_exchange('Z', 'q', MemoryOrder::SeqCst, MemoryOrder::SeqCst)) {
        Result::Ok(_)      => { return Result::Err(TestError::failed(Str::new("a char exchange of another code point must fail"))); }
        Result::Err(found) => { expect_equal(found, '\0')?; }
    }
    return Result::Ok(());
}

![test]
function atomic_float_cells_hold_their_values() -> Result<(), TestError> {
    const single: Atomic<f32> = Atomic::<f32>::new(1.5);
    expect_equal(single.load(MemoryOrder::SeqCst), 1.5 as f32)?;
    single.store(-2.25, MemoryOrder::SeqCst);
    expect_equal(single.swap(16777216.0, MemoryOrder::SeqCst), -2.25 as f32)?;
    expect_equal(single.load(MemoryOrder::SeqCst), 16777216.0 as f32)?;
    const double: Atomic<f64> = Atomic::<f64>::new(1e300);
    expect_equal(double.load(MemoryOrder::SeqCst), 1e300)?;
    double.store(-0.1, MemoryOrder::SeqCst);
    expect_equal(double.swap(9007199254740993.0, MemoryOrder::SeqCst), -0.1)?;
    match (double.compare_exchange(9007199254740993.0, 2.5, MemoryOrder::SeqCst, MemoryOrder::SeqCst)) {
        Result::Ok(previous) => { expect_equal(previous, 9007199254740993.0)?; }
        Result::Err(_)       => { return Result::Err(TestError::failed(Str::new("an f64 exchange of the value held must succeed"))); }
    }
    expect_equal(double.load(MemoryOrder::SeqCst), 2.5)?;
    return Result::Ok(());
}

![test]
function atomic_float_exchange_compares_bit_patterns() -> Result<(), TestError> {
    // A NaN never equals itself, yet a NaN cell exchanges against the same NaN.
    const nan_cell: Atomic<f64> = Atomic::<f64>::new(f64::NAN);
    match (nan_cell.compare_exchange(f64::NAN, 1.0, MemoryOrder::SeqCst, MemoryOrder::SeqCst)) {
        Result::Ok(previous) => { expect_equal(previous.is_nan(), true)?; }
        Result::Err(_)       => { return Result::Err(TestError::failed(Str::new("a NaN cell must exchange against the same NaN"))); }
    }
    expect_equal(nan_cell.load(MemoryOrder::SeqCst), 1.0)?;
    // `0.0 == -0.0`, yet a `0.0` cell does not exchange against `-0.0`.
    const zero_cell: Atomic<f32> = Atomic::<f32>::new(0.0);
    match (zero_cell.compare_exchange(-0.0, 1.0, MemoryOrder::SeqCst, MemoryOrder::SeqCst)) {
        Result::Ok(_)      => { return Result::Err(TestError::failed(Str::new("a 0.0 cell must not exchange against -0.0"))); }
        Result::Err(found) => { expect_equal(found.is_sign_negative(), false)?; }
    }
    expect_equal(zero_cell.load(MemoryOrder::SeqCst), 0.0 as f32)?;
    return Result::Ok(());
}
