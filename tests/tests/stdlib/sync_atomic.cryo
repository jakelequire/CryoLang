///! std::sync::atomic - single-threaded behavior coverage.
///!
///! Verifies the per-type wrappers and the LLVM atomic intrinsics that
///! back them.  Multi-threaded ordering tests live separately (and
///! need std::thread, which is still in flight); these tests exercise
///! the API surface and confirm each operation does what it says on a
///! single thread.

![config(testing)]
namespace CryoTests::Tests::Stdlib::SyncAtomic;

import std::core::result::{ Result };
import std::sync::atomic::{ Atomic, MemoryOrder };
import std::test::error::{ TestError };
import std::test::assert::{ expect_equal };
import std::collections::str::{ Str };

// ---- Atomic<u8> -----------------------------------------------------------

![test]
function atomic_u8_new_then_load() -> Result<(), TestError> {
    mut a: Atomic<u8> = Atomic::<u8>::new(7);
    const v: u8 = a.load(MemoryOrder::SeqCst);
    match (expect_equal(v as i32, 7)) {
        Result::Ok(_)  => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

![test]
function atomic_u8_store_overwrites() -> Result<(), TestError> {
    mut a: Atomic<u8> = Atomic::<u8>::new(0);
    a.store(255, MemoryOrder::SeqCst);
    const v: u8 = a.load(MemoryOrder::SeqCst);
    match (expect_equal(v as i32, 255)) {
        Result::Ok(_)  => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

![test]
function atomic_u8_fetch_add_returns_prev() -> Result<(), TestError> {
    mut a: Atomic<u8> = Atomic::<u8>::new(10);
    const prev: u8 = a.fetch_add(5, MemoryOrder::SeqCst);
    const cur: u8 = a.load(MemoryOrder::SeqCst);
    match (expect_equal(prev as i32, 10)) {
        Result::Ok(_)  => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    match (expect_equal(cur as i32, 15)) {
        Result::Ok(_)  => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

![test]
function atomic_u8_fetch_subtract_returns_prev() -> Result<(), TestError> {
    mut a: Atomic<u8> = Atomic::<u8>::new(20);
    const prev: u8 = a.fetch_subtract(3, MemoryOrder::SeqCst);
    const cur: u8 = a.load(MemoryOrder::SeqCst);
    match (expect_equal(prev as i32, 20)) {
        Result::Ok(_)  => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    match (expect_equal(cur as i32, 17)) {
        Result::Ok(_)  => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

![test]
function atomic_u8_fetch_and_or_xor() -> Result<(), TestError> {
    mut a: Atomic<u8> = Atomic::<u8>::new(0b11110000);
    const after_and: u8 = a.fetch_and(0b11001100, MemoryOrder::SeqCst);
    const after_and_cur: u8 = a.load(MemoryOrder::SeqCst);
    const after_or: u8 = a.fetch_or(0b00000011, MemoryOrder::SeqCst);
    const after_or_cur: u8 = a.load(MemoryOrder::SeqCst);
    const after_xor: u8 = a.fetch_xor(0b11111111, MemoryOrder::SeqCst);
    const after_xor_cur: u8 = a.load(MemoryOrder::SeqCst);
    // fetch_* returns prev; cur reflects the new value.
    match (expect_equal(after_and as i32, 0b11110000)) {
        Result::Ok(_)  => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    match (expect_equal(after_and_cur as i32, 0b11000000)) {
        Result::Ok(_)  => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    match (expect_equal(after_or as i32, 0b11000000)) {
        Result::Ok(_)  => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    match (expect_equal(after_or_cur as i32, 0b11000011)) {
        Result::Ok(_)  => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    match (expect_equal(after_xor as i32, 0b11000011)) {
        Result::Ok(_)  => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    match (expect_equal(after_xor_cur as i32, 0b00111100)) {
        Result::Ok(_)  => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

![test]
function atomic_u8_swap_returns_prev() -> Result<(), TestError> {
    mut a: Atomic<u8> = Atomic::<u8>::new(42);
    const prev: u8 = a.swap(99, MemoryOrder::SeqCst);
    const cur: u8 = a.load(MemoryOrder::SeqCst);
    match (expect_equal(prev as i32, 42)) {
        Result::Ok(_)  => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    match (expect_equal(cur as i32, 99)) {
        Result::Ok(_)  => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

![test]
function atomic_u8_cmpxchg_success() -> Result<(), TestError> {
    mut a: Atomic<u8> = Atomic::<u8>::new(5);
    const res: Result<u8, u8> = a.compare_exchange(
        5, 12, MemoryOrder::SeqCst, MemoryOrder::SeqCst);
    const cur: u8 = a.load(MemoryOrder::SeqCst);
    match (res) {
        Result::Ok(prev)  => {
            match (expect_equal(prev as i32, 5)) {
                Result::Ok(_)  => { }
                Result::Err(e) => { return Result::Err(e); }
            }
        }
        Result::Err(_) => {
            return Result::Err(TestError::failed(Str::new("cmpxchg should have succeeded")));
        }
    }
    match (expect_equal(cur as i32, 12)) {
        Result::Ok(_)  => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

![test]
function atomic_u8_cmpxchg_failure() -> Result<(), TestError> {
    mut a: Atomic<u8> = Atomic::<u8>::new(5);
    // Compare against the wrong value - swap must NOT happen.
    const res: Result<u8, u8> = a.compare_exchange(
        99, 12, MemoryOrder::SeqCst, MemoryOrder::SeqCst);
    const cur: u8 = a.load(MemoryOrder::SeqCst);
    match (res) {
        Result::Ok(_)  => {
            return Result::Err(TestError::failed(Str::new("cmpxchg should have failed")));
        }
        Result::Err(observed) => {
            match (expect_equal(observed as i32, 5)) {
                Result::Ok(_)  => { }
                Result::Err(e) => { return Result::Err(e); }
            }
        }
    }
    match (expect_equal(cur as i32, 5)) {
        Result::Ok(_)  => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

// ---- Atomic<u32> ----------------------------------------------------------

![test]
function atomic_u32_round_trip() -> Result<(), TestError> {
    mut a: Atomic<u32> = Atomic::<u32>::new(0);
    a.store(1234567, MemoryOrder::SeqCst);
    const v: u32 = a.load(MemoryOrder::SeqCst);
    match (expect_equal(v as i32, 1234567)) {
        Result::Ok(_)  => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

![test]
function atomic_u32_fetch_add_sub() -> Result<(), TestError> {
    mut a: Atomic<u32> = Atomic::<u32>::new(100);
    const _p1: u32 = a.fetch_add(50, MemoryOrder::Relaxed);
    const _p2: u32 = a.fetch_subtract(20, MemoryOrder::Relaxed);
    const cur: u32 = a.load(MemoryOrder::SeqCst);
    match (expect_equal(cur as i32, 130)) {
        Result::Ok(_)  => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

![test]
function atomic_u32_swap() -> Result<(), TestError> {
    mut a: Atomic<u32> = Atomic::<u32>::new(1);
    const prev: u32 = a.swap(9999, MemoryOrder::AcqRel);
    const cur: u32 = a.load(MemoryOrder::Acquire);
    match (expect_equal(prev as i32, 1)) {
        Result::Ok(_)  => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    match (expect_equal(cur as i32, 9999)) {
        Result::Ok(_)  => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

// ---- Atomic<u64> ----------------------------------------------------------

![test]
function atomic_u64_round_trip() -> Result<(), TestError> {
    mut a: Atomic<u64> = Atomic::<u64>::new(0);
    a.store(987654321, MemoryOrder::Release);
    const v: u64 = a.load(MemoryOrder::Acquire);
    match (expect_equal(v as i32, 987654321)) {
        Result::Ok(_)  => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

![test]
function atomic_u64_release_acquire_pair() -> Result<(), TestError> {
    // Single-threaded sanity for Release/Acquire ordering pair.  Real
    // ordering can only be observed with multiple threads; this just
    // confirms the orderings are accepted and the value round-trips.
    mut a: Atomic<u64> = Atomic::<u64>::new(0);
    a.store(7, MemoryOrder::Release);
    const v: u64 = a.load(MemoryOrder::Acquire);
    match (expect_equal(v as i32, 7)) {
        Result::Ok(_)  => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

![test]
function atomic_u64_cmpxchg_loop() -> Result<(), TestError> {
    // Single-threaded CAS loop: bump the counter via compare_exchange
    // until 10 iterations succeed.  No contention, so every CAS wins.
    mut a: Atomic<u64> = Atomic::<u64>::new(0);
    mut i: i32 = 0;
    while (i < 10) {
        mut done: boolean = false;
        loop {
            const cur: u64 = a.load(MemoryOrder::Acquire);
            const res: Result<u64, u64> = a.compare_exchange(
                cur, cur + 1, MemoryOrder::AcqRel, MemoryOrder::Acquire);
            match (res) {
                Result::Ok(_)  => { done = true; break; }
                Result::Err(_) => { }
            }
        }
        i = i + 1;
    }
    const final: u64 = a.load(MemoryOrder::SeqCst);
    match (expect_equal(final as i32, 10)) {
        Result::Ok(_)  => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

