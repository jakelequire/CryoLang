///! std::sync::atomic - single-threaded behavior coverage.
///!
///! Verifies the per-type wrappers and the LLVM atomic intrinsics that
///! back them.  Multi-threaded ordering tests live separately (and
///! need std::thread, which is still in flight); these tests exercise
///! the API surface and confirm each operation does what it says on a
///! single thread.

![config(testing)]
namespace CryoTests::Tests::Stdlib::SyncAtomic;

import std::core::result;
import std::sync::atomic;
import std::test::error;
import std::test::assert;

// ---- Atomic<u8> -----------------------------------------------------------

![test]
function atomic_u8_new_then_load() -> Result<(), TestError> {
    mut a: Atomic<u8> = Atomic<u8>::new(7u8);
    const v: u8 = a.load(MemoryOrder::SeqCst);
    a.drop();
    match (expect_eq(v as i32, 7)) {
        Result::Ok(_)  => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

![test]
function atomic_u8_store_overwrites() -> Result<(), TestError> {
    mut a: Atomic<u8> = Atomic<u8>::new(0u8);
    a.store(255u8, MemoryOrder::SeqCst);
    const v: u8 = a.load(MemoryOrder::SeqCst);
    a.drop();
    match (expect_eq(v as i32, 255)) {
        Result::Ok(_)  => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

![test]
function atomic_u8_fetch_add_returns_prev() -> Result<(), TestError> {
    mut a: Atomic<u8> = Atomic<u8>::new(10u8);
    const prev: u8 = a.fetch_add(5u8, MemoryOrder::SeqCst);
    const cur: u8 = a.load(MemoryOrder::SeqCst);
    a.drop();
    match (expect_eq(prev as i32, 10)) {
        Result::Ok(_)  => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    match (expect_eq(cur as i32, 15)) {
        Result::Ok(_)  => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

![test]
function atomic_u8_fetch_sub_returns_prev() -> Result<(), TestError> {
    mut a: Atomic<u8> = Atomic<u8>::new(20u8);
    const prev: u8 = a.fetch_sub(3u8, MemoryOrder::SeqCst);
    const cur: u8 = a.load(MemoryOrder::SeqCst);
    a.drop();
    match (expect_eq(prev as i32, 20)) {
        Result::Ok(_)  => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    match (expect_eq(cur as i32, 17)) {
        Result::Ok(_)  => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

![test]
function atomic_u8_fetch_and_or_xor() -> Result<(), TestError> {
    mut a: Atomic<u8> = Atomic<u8>::new(0b11110000u8);
    const after_and: u8 = a.fetch_and(0b11001100u8, MemoryOrder::SeqCst);
    const after_and_cur: u8 = a.load(MemoryOrder::SeqCst);
    const after_or: u8 = a.fetch_or(0b00000011u8, MemoryOrder::SeqCst);
    const after_or_cur: u8 = a.load(MemoryOrder::SeqCst);
    const after_xor: u8 = a.fetch_xor(0b11111111u8, MemoryOrder::SeqCst);
    const after_xor_cur: u8 = a.load(MemoryOrder::SeqCst);
    a.drop();
    // fetch_* returns prev; cur reflects the new value.
    match (expect_eq(after_and as i32, 0b11110000)) {
        Result::Ok(_)  => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    match (expect_eq(after_and_cur as i32, 0b11000000)) {
        Result::Ok(_)  => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    match (expect_eq(after_or as i32, 0b11000000)) {
        Result::Ok(_)  => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    match (expect_eq(after_or_cur as i32, 0b11000011)) {
        Result::Ok(_)  => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    match (expect_eq(after_xor as i32, 0b11000011)) {
        Result::Ok(_)  => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    match (expect_eq(after_xor_cur as i32, 0b00111100)) {
        Result::Ok(_)  => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

![test]
function atomic_u8_swap_returns_prev() -> Result<(), TestError> {
    mut a: Atomic<u8> = Atomic<u8>::new(42u8);
    const prev: u8 = a.swap(99u8, MemoryOrder::SeqCst);
    const cur: u8 = a.load(MemoryOrder::SeqCst);
    a.drop();
    match (expect_eq(prev as i32, 42)) {
        Result::Ok(_)  => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    match (expect_eq(cur as i32, 99)) {
        Result::Ok(_)  => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

![test]
function atomic_u8_cmpxchg_success() -> Result<(), TestError> {
    mut a: Atomic<u8> = Atomic<u8>::new(5u8);
    const res: Result<u8, u8> = a.compare_exchange(
        5u8, 12u8, MemoryOrder::SeqCst, MemoryOrder::SeqCst);
    const cur: u8 = a.load(MemoryOrder::SeqCst);
    a.drop();
    match (res) {
        Result::Ok(prev)  => {
            match (expect_eq(prev as i32, 5)) {
                Result::Ok(_)  => { }
                Result::Err(e) => { return Result::Err(e); }
            }
        }
        Result::Err(_) => {
            return Result::Err(TestError::failed(Str::new("cmpxchg should have succeeded")));
        }
    }
    match (expect_eq(cur as i32, 12)) {
        Result::Ok(_)  => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

![test]
function atomic_u8_cmpxchg_failure() -> Result<(), TestError> {
    mut a: Atomic<u8> = Atomic<u8>::new(5u8);
    // Compare against the wrong value - swap must NOT happen.
    const res: Result<u8, u8> = a.compare_exchange(
        99u8, 12u8, MemoryOrder::SeqCst, MemoryOrder::SeqCst);
    const cur: u8 = a.load(MemoryOrder::SeqCst);
    a.drop();
    match (res) {
        Result::Ok(_)  => {
            return Result::Err(TestError::failed(Str::new("cmpxchg should have failed")));
        }
        Result::Err(observed) => {
            match (expect_eq(observed as i32, 5)) {
                Result::Ok(_)  => { }
                Result::Err(e) => { return Result::Err(e); }
            }
        }
    }
    match (expect_eq(cur as i32, 5)) {
        Result::Ok(_)  => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

// ---- Atomic<u32> ----------------------------------------------------------

![test]
function atomic_u32_round_trip() -> Result<(), TestError> {
    mut a: Atomic<u32> = Atomic<u32>::new(0u32);
    a.store(1234567u32, MemoryOrder::SeqCst);
    const v: u32 = a.load(MemoryOrder::SeqCst);
    a.drop();
    match (expect_eq(v as i32, 1234567)) {
        Result::Ok(_)  => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

![test]
function atomic_u32_fetch_add_sub() -> Result<(), TestError> {
    mut a: Atomic<u32> = Atomic<u32>::new(100u32);
    const _p1: u32 = a.fetch_add(50u32, MemoryOrder::Relaxed);
    const _p2: u32 = a.fetch_sub(20u32, MemoryOrder::Relaxed);
    const cur: u32 = a.load(MemoryOrder::SeqCst);
    a.drop();
    match (expect_eq(cur as i32, 130)) {
        Result::Ok(_)  => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

![test]
function atomic_u32_swap() -> Result<(), TestError> {
    mut a: Atomic<u32> = Atomic<u32>::new(1u32);
    const prev: u32 = a.swap(9999u32, MemoryOrder::AcqRel);
    const cur: u32 = a.load(MemoryOrder::Acquire);
    a.drop();
    match (expect_eq(prev as i32, 1)) {
        Result::Ok(_)  => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    match (expect_eq(cur as i32, 9999)) {
        Result::Ok(_)  => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

// ---- Atomic<u64> ----------------------------------------------------------

![test]
function atomic_u64_round_trip() -> Result<(), TestError> {
    mut a: Atomic<u64> = Atomic<u64>::new(0u64);
    a.store(987654321u64, MemoryOrder::Release);
    const v: u64 = a.load(MemoryOrder::Acquire);
    a.drop();
    match (expect_eq(v as i32, 987654321)) {
        Result::Ok(_)  => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

![test]
function atomic_u64_release_acquire_pair() -> Result<(), TestError> {
    // Single-threaded sanity for Release/Acquire ordering pair.  Real
    // ordering can only be observed with multiple threads; this just
    // confirms the orderings are accepted and the value round-trips.
    mut a: Atomic<u64> = Atomic<u64>::new(0u64);
    a.store(7u64, MemoryOrder::Release);
    const v: u64 = a.load(MemoryOrder::Acquire);
    a.drop();
    match (expect_eq(v as i32, 7)) {
        Result::Ok(_)  => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

![test]
function atomic_u64_cmpxchg_loop() -> Result<(), TestError> {
    // Single-threaded CAS loop: bump the counter via compare_exchange
    // until 10 iterations succeed.  No contention, so every CAS wins.
    mut a: Atomic<u64> = Atomic<u64>::new(0u64);
    mut i: i32 = 0;
    while (i < 10) {
        mut done: boolean = false;
        loop {
            const cur: u64 = a.load(MemoryOrder::Acquire);
            const res: Result<u64, u64> = a.compare_exchange(
                cur, cur + 1, MemoryOrder::AcqRel, MemoryOrder::Acquire);
            match (res) {
                Result::Ok(_)  => { done = true; break; }
                Result::Err(_) => { }
            }
        }
        i = i + 1;
    }
    const final: u64 = a.load(MemoryOrder::SeqCst);
    a.drop();
    match (expect_eq(final as i32, 10)) {
        Result::Ok(_)  => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

// ---- Atomic<i32> / Atomic<i64> ---------------------------------------------

![test]
function atomic_i32_round_trip() -> Result<(), TestError> {
    mut a: Atomic<i32> = Atomic<i32>::new(-42);
    const v: i32 = a.load(MemoryOrder::SeqCst);
    a.store(99, MemoryOrder::SeqCst);
    const v2: i32 = a.load(MemoryOrder::SeqCst);
    a.drop();
    match (expect_eq(v, -42)) {
        Result::Ok(_)  => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    match (expect_eq(v2, 99)) {
        Result::Ok(_)  => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

![test]
function atomic_i32_fetch_add_negative_delta() -> Result<(), TestError> {
    mut a: Atomic<i32> = Atomic<i32>::new(10);
    const _p: i32 = a.fetch_add(-3, MemoryOrder::SeqCst);
    const cur: i32 = a.load(MemoryOrder::SeqCst);
    a.drop();
    match (expect_eq(cur, 7)) {
        Result::Ok(_)  => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

![test]
function atomic_i64_round_trip() -> Result<(), TestError> {
    mut a: Atomic<i64> = Atomic<i64>::new(-1i64);
    a.store(1000000i64, MemoryOrder::SeqCst);
    const v: i64 = a.load(MemoryOrder::SeqCst);
    a.drop();
    match (expect_eq(v as i32, 1000000)) {
