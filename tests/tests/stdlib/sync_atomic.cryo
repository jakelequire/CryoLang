    return Result::Ok(());
}

// ---- Atomic<boolean> ---------------------------------------------------------

![test]
function atomic_bool_new_then_load() -> Result<(), TestError> {
    mut a: Atomic<boolean> = Atomic<boolean>::new(false);
    const v: boolean = a.load(MemoryOrder::SeqCst);
    a.drop();
    if (v) {
        return Result::Err(TestError::failed(Str::new("expected false, got true")));
    }
    return Result::Ok(());
}

![test]
function atomic_bool_store_true() -> Result<(), TestError> {
    mut a: Atomic<boolean> = Atomic<boolean>::new(false);
    a.store(true, MemoryOrder::SeqCst);
    const v: boolean = a.load(MemoryOrder::SeqCst);
    a.drop();
    if (!v) {
        return Result::Err(TestError::failed(Str::new("expected true after store")));
    }
    return Result::Ok(());
}

![test]
function atomic_bool_swap() -> Result<(), TestError> {
    mut a: Atomic<boolean> = Atomic<boolean>::new(false);
    const prev: boolean = a.swap(true, MemoryOrder::SeqCst);
    const cur: boolean = a.load(MemoryOrder::SeqCst);
    a.drop();
    if (prev) {
        return Result::Err(TestError::failed(Str::new("swap should report false (prior)")));
    }
    if (!cur) {
        return Result::Err(TestError::failed(Str::new("expected true after swap")));
    }
    return Result::Ok(());
}

// ---- fence + compiler_fence: accepted, no observable effect single-thread ----

![test]
function fence_does_not_crash() -> Result<(), TestError> {
    atomic::fence(MemoryOrder::SeqCst);
    atomic::compiler_fence(MemoryOrder::SeqCst);
    return Result::Ok(());
}

// Relaxed is below the minimum ordering LLVM's `fence` accepts; passing it
// through raw produced invalid IR. Both entry points now clamp Relaxed up to
// SeqCst, so a Relaxed (or Acquire/Release/AcqRel) request compiles and runs.
![test]
function fence_relaxed_is_clamped_not_invalid() -> Result<(), TestError> {
    atomic::fence(MemoryOrder::Relaxed);
    atomic::fence(MemoryOrder::Acquire);
    atomic::fence(MemoryOrder::Release);
    atomic::fence(MemoryOrder::AcqRel);
    atomic::compiler_fence(MemoryOrder::Relaxed);
    atomic::compiler_fence(MemoryOrder::Acquire);
    return Result::Ok(());
}
