///! ffi::cstr — CStr / CString round trips at the C boundary.

![config(testing)]
namespace CryoTests::Tests::Stdlib::CStrT;

import std::core::result;
import std::collections::str;
import std::ffi::cstr;
import std::test::error;
import std::test::assert;

![test]
function cstr_from_ptr_length() -> Result<(), TestError> {
    // Cryo `string` literals are NUL-terminated; reuse one as the
    // backing buffer.
    const buf: u8* = "hello" as u8*;
    const cs: CStr = CStr::from_ptr(buf);
    const len: u64 = cs.length();
    const want: u64 = 5;
    match (expect_eq(len, want)) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

![test]
function cstr_to_str_lossy_round_trip() -> Result<(), TestError> {
    const buf: u8* = "world" as u8*;
    const cs: CStr = CStr::from_ptr(buf);
    const view: Str = cs.to_str_lossy();
    const want: Str = Str::from_raw("world" as u8*, 5);
    match (expect(view.equals(&want),
        Str::from_raw("CStr.to_str_lossy should match source bytes" as u8*, 43))) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

![test]
function cstring_from_str_round_trips_bytes() -> Result<(), TestError> {
    const src: Str = Str::from_raw("Cryo" as u8*, 4);
    match (CString::from_str(src)) {
        Result::Ok(mut cs) => {
            const len: u64 = cs.length();
            const view: Str = cs.as_c_str().to_str_lossy();
            const eq: boolean = view.equals(&src);
            cs.drop();
            const want: u64 = 4;
            match (expect_eq(len, want)) {
                Result::Ok(_) => { }
                Result::Err(e) => { return Result::Err(e); }
            }
            match (expect(eq,
                Str::from_raw("CString round-trip should preserve bytes" as u8*, 40))) {
                Result::Ok(_) => { }
                Result::Err(e) => { return Result::Err(e); }
            }
        }
        Result::Err(_) => {
            return bail(Str::from_raw("CString::from_str gave NulError" as u8*, 31));
        }
    }
    return Result::Ok(());
}

![test]
function cstring_from_str_rejects_interior_nul() -> Result<(), TestError> {
    // Build "ab\0c" by-hand so the source carries an interior NUL.
    mut raw: u8[4];
    raw[0] = 0x61;
    raw[1] = 0x62;
    raw[2] = 0;
    raw[3] = 0x63;
    const src: Str = Str::from_raw(&raw[0], 4);
    match (CString::from_str(src)) {
        Result::Ok(mut cs) => {
            cs.drop();
            return bail(Str::from_raw("CString should reject interior NUL" as u8*, 34));
        }
        Result::Err(_) => { }
    }
    return Result::Ok(());
}

![test]
function cstring_as_ptr_is_nul_terminated() -> Result<(), TestError> {
    const src: Str = Str::from_raw("hi" as u8*, 2);
    match (CString::from_str(src)) {
        Result::Ok(mut cs) => {
            const ptr: u8* = cs.as_ptr();
            const terminator: u8 = ptr[2];
            cs.drop();
            match (expect_eq(terminator, 0 as u8)) {
                Result::Ok(_) => { }
                Result::Err(e) => { return Result::Err(e); }
            }
        }
        Result::Err(_) => {
            return bail(Str::from_raw("CString::from_str failed" as u8*, 24));
        }
    }
    return Result::Ok(());
}
