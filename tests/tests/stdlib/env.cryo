///! env — process environment variables.
///!
///! Pins the get / set / remove round trip and the interior-NUL guard.
///! Test isolation comes for free from the runner's fork-per-test: any
///! `set_var` / `remove_var` a test does affects only that child's
///! environment, and the parent's view is untouched.
///!
///! Test variable names use the `CRYO_TEST_ENV_` prefix to avoid
///! colliding with anything the host shell might also be using.

![config(testing)]
namespace CryoTests::Tests::Stdlib::EnvT;

import std::core::result;
import std::core::option;
import std::core::drop;
import std::collections::str;
import std::collections::string;
import std::env;
import std::test::error;
import std::test::assert;

// ============================================================================
// var — read
// ============================================================================

![test]
function var_unset_returns_none() -> Result<(), TestError> {
    const name: Str = Str::from_raw("CRYO_TEST_ENV_DEFINITELY_UNSET", 30);
    // Ensure no stray value (idempotent — remove_var of missing is fine).
    env::remove_var(name);

    mut got: Option<String> = env::var(name);
    const is_none: boolean = got.is_none();
    // Drop the option in case some other system already had this var.
    // is_none should be true; if it's not, fail loudly.
    match (got) {
        Option::Some(mut s) => { s.drop(); }
        Option::None        => { }
    }
    return expect_true(is_none,
        Str::from_raw("var() of an unset name should be None", 37));
}

![test]
function var_after_set_returns_value() -> Result<(), TestError> {
    const name: Str = Str::from_raw("CRYO_TEST_ENV_SET_AND_READ", 26);
    const value: Str = Str::from_raw("hello-world", 11);

    const set_ok: boolean = env::set_var(name, value);
    match (expect_true(set_ok,
        Str::from_raw("set_var should succeed for clean inputs", 39))) {
        Result::Ok(_) => { } Result::Err(e) => { return Result::Err(e); }
    }

    mut got: Option<String> = env::var(name);
    const present: boolean = got.is_some();
    // Pull the inner String out by-move so we can compare its bytes
    // against the value we set.
    match (got) {
        Option::Some(mut s) => {
            const eq: boolean = s.as_str().equals(&value);
            s.drop();
            // Always clean up the env so a re-run sees a clean slate
            // (the child process is going to exit anyway, but the
            // parent's view of env was untouched — the cleanup here
            // is symbolic / belt-and-braces).
            env::remove_var(name);
            match (expect_true(present,
                Str::from_raw("var() should be Some after set_var", 34))) {
                Result::Ok(_) => { } Result::Err(e) => { return Result::Err(e); }
            }
            return expect_true(eq,
                Str::from_raw("var()'s String should equal the value we set", 44));
        }
        Option::None => {
            env::remove_var(name);
            return bail(Str::from_raw("var() should not be None after set_var", 38));
        }
    }
}

// ============================================================================
// set_var → remove_var → var should round-trip to None
// ============================================================================

![test]
function remove_var_clears_a_set_value() -> Result<(), TestError> {
    const name: Str = Str::from_raw("CRYO_TEST_ENV_REMOVE_ROUND_TRIP", 31);
    const value: Str = Str::from_raw("transient", 9);

    env::set_var(name, value);
    const removed_ok: boolean = env::remove_var(name);

    mut after: Option<String> = env::var(name);
    const still_present: boolean = after.is_some();
    match (after) {
        Option::Some(mut s) => { s.drop(); }
        Option::None        => { }
    }
    match (expect_true(removed_ok,
        Str::from_raw("remove_var should report success", 32))) {
        Result::Ok(_) => { } Result::Err(e) => { return Result::Err(e); }
    }
    return expect_false(still_present,
        Str::from_raw("var() should be None after remove_var", 37));
}

![test]
function remove_var_on_unset_is_idempotent() -> Result<(), TestError> {
    // POSIX unsetenv on a missing name returns 0 — no error.
    const name: Str = Str::from_raw("CRYO_TEST_ENV_NEVER_SET", 23);
    const ok: boolean = env::remove_var(name);
    return expect_true(ok,
        Str::from_raw("remove_var on an unset name should still report success", 55));
}

// ============================================================================
// set_var — interior NUL in the value is rejected by the CString boundary
// ============================================================================

![test]
function set_var_rejects_interior_nul_in_value() -> Result<(), TestError> {
    const name: Str = Str::from_raw("CRYO_TEST_ENV_NUL_VALUE", 23);
    // Hand-build "ok\0nope" — a 7-byte view with a NUL at index 2.
    mut raw: u8[7];
    raw[0] = 0x6F; // 'o'
    raw[1] = 0x6B; // 'k'
    raw[2] = 0;
    raw[3] = 0x6E; // 'n'
    raw[4] = 0x6F; // 'o'
    raw[5] = 0x70; // 'p'
    raw[6] = 0x65; // 'e'
    const value: Str = Str::from_raw(&raw[0], 7);

    const set_ok: boolean = env::set_var(name, value);
    // Cleanup just in case
    env::remove_var(name);
    return expect_false(set_ok,
        Str::from_raw("set_var should reject a value with an interior NUL", 50));
}

// ============================================================================
// Updating an existing var
// ============================================================================

![test]
function set_var_overwrites_existing_value() -> Result<(), TestError> {
    const name: Str = Str::from_raw("CRYO_TEST_ENV_OVERWRITE", 23);
    env::set_var(name, Str::from_raw("first", 5));
    env::set_var(name, Str::from_raw("second", 6));

    mut got: Option<String> = env::var(name);
    const present: boolean = got.is_some();
    match (got) {
        Option::Some(mut s) => {
            const want: Str = Str::from_raw("second", 6);
            const eq: boolean = s.as_str().equals(&want);
            s.drop();
            env::remove_var(name);
            match (expect_true(present,
                Str::from_raw("var() should be Some after two set_vars", 39))) {
                Result::Ok(_) => { } Result::Err(e) => { return Result::Err(e); }
            }
            return expect_true(eq,
                Str::from_raw("the second set_var should win", 29));
        }
        Option::None => {
            env::remove_var(name);
            return bail(Str::from_raw("var() should not be None after set_var", 38));
        }
    }
}
