///! std::future::executor - `Executor::spawn` and its `JoinHandle`.
///!
///! This file imports `std::thread` alongside `std::future` on purpose. Both
///! export a `JoinHandle` leaf, and a callee's bare return leaf used to be
///! re-resolved against the importing module's scope rather than its own, so
///! `Executor::spawn` (declared `-> JoinHandle<O>` in `future::executor`) bound
///! to `thread::JoinHandle` and failed to type-check inside `executor.cryo`
///! itself. Every test file is compiled into one binary, so a single import of
///! `std::thread` anywhere was enough to poison `spawn` for the whole suite.
///! Keep both imports and keep a `thread::spawn` call here: together they are
///! what makes the two same-leaf types coexist.

![config(testing)]
namespace CryoTests::Tests::Stdlib::FutureExecutor;

import std::core::result::{ Result };
import std::collections::str::{ Str };
import std::collections::string::{ String };
import std::future;
import std::thread;
import std::test::error::{ TestError };
import std::test::assert::{ expect_equal, expect_true };
import std::future::executor::{ Executor, JoinError, Task };
import std::future::ready::{ Ready };
import std::future::timer::{ Sleep };
import std::time::duration::{ Duration };
import std::alloc::arc::{ Arc };
import std::sync::atomic::{ Atomic, MemoryOrder };

async function doubled(n: i64) -> i64 {
    return n * 2;
}

/// Naming the future's handle by its qualified path is what a caller importing
/// both modules must write; the bare leaf is genuinely ambiguous here.
![test]
function spawn_returns_the_executors_own_join_handle() -> Result<(), TestError> {
    mut ex: Executor = Executor::new();
    mut h: future::executor::JoinHandle<i64> = ex.spawn(doubled(21));
    const joined: Result<i64, JoinError> = h.join();
    match (joined) {
        Result::Ok(v)  => { return expect_equal(v, 42 as i64); }
        Result::Err(_) => {
            return expect_true(false, "spawned task did not complete");
        }
    }
}

async function greeting(name: Str) -> String {
    mut text: String = String::from_str(Str::new("hello, "));
    text.append(name);
    return text;
}

/// An `Output` that owns a destructor is moved out of the task's block whole:
/// the handle takes it and frees the block without dropping it, so the caller
/// gets the one copy and nothing is released twice.
![test]
function block_on_returns_an_owning_output() -> Result<(), TestError> {
    mut ex: Executor = Executor::new();
    const first: String = ex.block_on(greeting(Str::new("first")));
    const second: String = ex.block_on(greeting(Str::new("second")));
    expect_true(first.as_str().equals(&Str::new("hello, first")), "first output")?;
    return expect_true(second.as_str().equals(&Str::new("hello, second")), "second output");
}

/// The thread handle of the same leaf name, resolved in the same file, must
/// still be the thread one - the fix must not overcorrect in the other
/// direction.
![test]
function thread_spawn_returns_the_thread_join_handle() -> Result<(), TestError> {
    mut th: thread::JoinHandle<i64> =
        thread::spawn(() -> i64 { return 21 * 2; });
    const v: i64 = th.join().unwrap();
    return expect_equal(v, 42 as i64);
}

/// `Executor::block_on` instantiated at BOTH a unit and a non-unit `Output`,
/// with the UNIT one written FIRST.
///
/// A generic method's return type is looked up by NAME, and once the method has
/// been instantiated at several types that lookup can hand back a SIBLING
/// specialization's return. Sema re-derives the right one per call, but only
/// adopts the re-derivation for a CANONICAL return type — one whose arena
/// TypeID re-derivation cannot change. `()` was missing from that set, so the
/// correct `()` was computed and then thrown away, leaving the unit call typed
/// as the sibling's `i64`. Codegen then emitted a NAMED call to a
/// void-returning function and LLVM rejected the module outright.
///
/// The ordering matters and is the whole point: writing the non-unit call first
/// compiles either way. So does either call on its own. Keep all three shapes.
async function fe_unit_root() -> void {
    const _z: u64 = await Ready::<u64>::new(1);
}

async function fe_int_root() -> i64 {
    const z: u64 = await Ready::<u64>::new(2);
    return z as i64;
}

![test]
function block_on_at_unit_then_non_unit_output() -> Result<(), TestError> {
    mut ex: Executor = Executor::new();
    ex.block_on(fe_unit_root());
    const n: i64 = ex.block_on(fe_int_root());
    return expect_equal(n, 2 as i64);
}

![test]
function block_on_at_non_unit_then_unit_output() -> Result<(), TestError> {
    mut ex: Executor = Executor::new();
    const n: i64 = ex.block_on(fe_int_root());
    ex.block_on(fe_unit_root());
    return expect_equal(n, 2 as i64);
}

![test]
function block_on_at_unit_output_alone() -> Result<(), TestError> {
    mut ex: Executor = Executor::new();
    ex.block_on(fe_unit_root());
    return expect_equal(1 as i64, 1 as i64);
}

// ---- Task::spawn and awaiting a JoinHandle -----------------------------------

async function spawns_two_and_awaits_both() -> i64 {
    const first: future::executor::JoinHandle<i64> = Task::spawn(doubled(20));
    const second: future::executor::JoinHandle<i64> = Task::spawn(doubled(1));
    const a: Result<i64, JoinError> = await first;
    const b: Result<i64, JoinError> = await second;
    return a.unwrap() + b.unwrap();
}

/// A task spawns onto the executor polling it, and awaiting the handles
/// yields what each spawned task returned.
![test]
function task_spawn_inside_a_task_is_awaited() -> Result<(), TestError> {
    mut ex: Executor = Executor::with_threads(2);
    return expect_equal(ex.block_on(spawns_two_and_awaits_both()), 42 as i64);
}

async function napped(milliseconds: u64, value: i64) -> i64 {
    await Sleep::new(Duration::from_milliseconds(milliseconds));
    return value;
}

async function awaits_a_sleeping_task() -> i64 {
    const sleeper: future::executor::JoinHandle<i64> = Task::spawn(napped(30, 7));
    // The awaiting task parks on the handle: the only worker is free to run
    // the sleeper, whose finish wakes this task again.
    return (await sleeper).unwrap();
}

/// On one worker the awaiting task must park, not spin, or the sleeper it
/// waits for never runs; its finish is what wakes the awaiting task.
![test]
function awaiting_parks_until_the_task_finishes() -> Result<(), TestError> {
    mut ex: Executor = Executor::with_threads(1);
    return expect_equal(ex.block_on(awaits_a_sleeping_task()), 7 as i64);
}

async function aborts_before_the_first_poll() -> boolean {
    const doomed: future::executor::JoinHandle<i64> = Task::spawn(doubled(4));
    // One worker, and it is running this task: the spawned one has not been
    // polled yet, so the abort is seen before it ever runs.
    doomed.abort();
    match (await doomed) {
        Result::Ok(_)                   => { return false; }
        Result::Err(JoinError::Cancelled) => { return true; }
        Result::Err(_)                  => { return false; }
    }
}

![test]
function an_aborted_task_awaits_as_cancelled() -> Result<(), TestError> {
    mut ex: Executor = Executor::with_threads(1);
    return expect_true(ex.block_on(aborts_before_the_first_poll()), "an aborted task must await as Cancelled");
}

// ---- Task::spawn_blocking ------------------------------------------------------

async function greets_on_the_blocking_pool() -> String {
    const name: String = String::from_str(Str::new("pool"));
    const greeted: future::executor::JoinHandle<String> = Task::spawn_blocking(move () -> String {
        mut text: String = String::from_str(Str::new("hello, "));
        text.append(name.as_str());
        return text;
    });
    return (await greeted).unwrap();
}

/// The work takes its captures with it and its result comes back whole.
![test]
function spawn_blocking_returns_the_work_result() -> Result<(), TestError> {
    mut ex: Executor = Executor::with_threads(1);
    const greeting: String = ex.block_on(greets_on_the_blocking_pool());
    return expect_true(greeting.as_str().equals(&Str::new("hello, pool")), "the work's result");
}

async function raises(flag: Arc<Atomic<boolean>>) -> i64 {
    flag.get_reference().store(true, MemoryOrder::Release);
    return 0;
}

async function blocking_work_leaves_the_worker_free() -> boolean {
    const flag: Arc<Atomic<boolean>> = Arc::new(Atomic::<boolean>::new(false));
    const seen_by_work: Arc<Atomic<boolean>> = flag.clone();
    // The work waits, on its own thread, for a flag only another task raises.
    const waiting: future::executor::JoinHandle<boolean> = Task::spawn_blocking(move () -> boolean {
        for (mut tries: i32 = 0; tries < 400; tries = tries + 1) {
            if (seen_by_work.get_reference().load(MemoryOrder::Acquire)) { return true; }
            thread::sleep(Duration::from_milliseconds(5));
        }
        return false;
    });
    const raiser: future::executor::JoinHandle<i64> = Task::spawn(raises(flag));
    (await raiser).unwrap();
    return (await waiting).unwrap();
}

/// On one worker, blocking work that ran on the worker would keep the task
/// that raises its flag from ever running, and would give up after two
/// seconds; on the blocking pool it sees the flag.
![test]
function spawn_blocking_runs_off_the_worker() -> Result<(), TestError> {
    mut ex: Executor = Executor::with_threads(1);
    return expect_true(ex.block_on(blocking_work_leaves_the_worker_free()), "the blocking work must not occupy the only worker");
}
