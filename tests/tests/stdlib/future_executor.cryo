///! std::future::executor - `Executor::spawn` and its `JoinHandle`.
///!
///! This file imports `std::thread` alongside `std::future` on purpose. Both
///! export a `JoinHandle` leaf, and a callee's bare return leaf used to be
///! re-resolved against the importing module's scope rather than its own, so
///! `Executor::spawn` (declared `-> JoinHandle<O>` in `future::executor`) bound
///! to `thread::JoinHandle` and failed to type-check inside `executor.cryo`
///! itself. Every test file is compiled into one binary, so a single import of
///! `std::thread` anywhere was enough to poison `spawn` for the whole suite.
///! Keep both imports and keep a `thread::spawn` call here: together they are
///! what makes the two same-leaf types coexist.

![config(testing)]
namespace CryoTests::Tests::Stdlib::FutureExecutor;

import std::core::result;
import std::future;
import std::thread;
import std::test::error;
import std::test::assert;

async function doubled(n: i64) -> i64 {
    return n * 2;
}

/// Naming the future's handle by its qualified path is what a caller importing
/// both modules must write; the bare leaf is genuinely ambiguous here.
![test]
function spawn_returns_the_executors_own_join_handle() -> Result<(), TestError> {
    mut ex: Executor = Executor::new();
    mut h: future::executor::JoinHandle<i64> = ex.spawn(doubled(21));
    const joined: Result<i64, JoinError> = h.join();
    ex.drop();
    match (joined) {
        Result::Ok(v)  => { return expect_eq(v, 42 as i64); }
        Result::Err(_) => {
            return expect_true(false, "spawned task did not complete");
        }
    }
}

/// The thread handle of the same leaf name, resolved in the same file, must
/// still be the thread one - the fix must not overcorrect in the other
/// direction.
![test]
function thread_spawn_returns_the_thread_join_handle() -> Result<(), TestError> {
    mut th: thread::JoinHandle<i64> =
        thread::spawn<i64, i64>(21, (n: i64) -> i64 { return n * 2; });
    const v: i64 = th.join();
    return expect_eq(v, 42 as i64);
}

/// `Executor::block_on` instantiated at BOTH a unit and a non-unit `Output`,
/// with the UNIT one written FIRST.
///
/// A generic method's return type is looked up by NAME, and once the method has
/// been instantiated at several types that lookup can hand back a SIBLING
/// specialization's return. Sema re-derives the right one per call, but only
/// adopts the re-derivation for a CANONICAL return type — one whose arena
/// TypeID re-derivation cannot change. `()` was missing from that set, so the
/// correct `()` was computed and then thrown away, leaving the unit call typed
/// as the sibling's `i64`. Codegen then emitted a NAMED call to a
/// void-returning function and LLVM rejected the module outright.
///
/// The ordering matters and is the whole point: writing the non-unit call first
/// compiles either way. So does either call on its own. Keep all three shapes.
async function fe_unit_root() -> void {
    const z: u64 = await Ready<u64>::new(1);
}

async function fe_int_root() -> i64 {
    const z: u64 = await Ready<u64>::new(2);
    return z as i64;
}

![test]
function block_on_at_unit_then_non_unit_output() -> Result<(), TestError> {
    mut ex: Executor = Executor::new();
    ex.block_on(fe_unit_root());
    const n: i64 = ex.block_on(fe_int_root());
    ex.drop();
    return expect_eq(n, 2 as i64);
}

![test]
function block_on_at_non_unit_then_unit_output() -> Result<(), TestError> {
    mut ex: Executor = Executor::new();
    const n: i64 = ex.block_on(fe_int_root());
    ex.block_on(fe_unit_root());
    ex.drop();
    return expect_eq(n, 2 as i64);
}

![test]
function block_on_at_unit_output_alone() -> Result<(), TestError> {
    mut ex: Executor = Executor::new();
    ex.block_on(fe_unit_root());
    ex.drop();
    return expect_eq(1 as i64, 1 as i64);
}
