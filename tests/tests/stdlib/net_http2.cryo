///! HTTP/2 over h2c (cleartext) — loopback request/response on a REAL socket.
///!
///! A mock transport cannot catch this class of bug: the `net/ws` port passed
///! every hermetic mock-transport test and then hung on loopback. So every test
///! here binds an EPHEMERAL port (`:0`), reads the kernel-assigned port back, and
///! drives both ends as two futures joined inside ONE `Executor`, whose reactor
///! is what the accept and every read register with.
///!
///! The shapes are chosen for what each one forces the port through:
///!
///!   - a plain GET: preface, SETTINGS handshake, HPACK HEADERS, an empty body;
///!   - a 100 KB echoed POST: DATA split across many frames in BOTH directions,
///!     and — because the connection-level send window is fixed at 65535 octets
///!     regardless of SETTINGS — an `ensure_send_window` wait that has to read
///!     and apply the peer's WINDOW_UPDATEs mid-send;
///!   - a header block over the 16384-octet max frame size: HEADERS plus
///!     CONTINUATION fragments, assembled back into one block by the reader;
///!   - four sequential requests on ONE connection: an owning local awaited on
///!     repeatedly from inside a loop, which is the shape that hid the carrier
///!     bug the async layer was built on;
///!   - a client that handshakes and closes without asking for anything: the
///!     server's read loop must report a clean end rather than an error, which is
///!     also the proof that the client's connection was really DROPPED — a leaked
///!     one would hold the socket open and the server would wait forever.
///!
///! Counts are asserted, never booleans: a handler that ran twice, a body that
///! came back one byte short, or a header lost in a CONTINUATION fragment each
///! surface as a specific number rather than as "not ok".

![config(testing)]
namespace CryoTests::Tests::Stdlib::NetHttp2;

import std::core::result::{ Result };
import std::core::option::{ Option };
import std::core::slice::{ Slice };
import std::core::drop;
import std::collections::array::{ Array };
import std::collections::str::{ Str };
import std::collections::string::{ String };
import std::future;
import std::io::error::{ IoError };
import std::io::traits;
import std::io::buf::{ BufStream };
import std::net::addr::socket_addr::{ SocketAddr };
import std::net::socket::tcp::{ TcpAccept, TcpAccepted, TcpConnect, TcpListener, TcpStream };
import std::net::http::method::{ Method };
import std::net::http::status::{ StatusCode };
import std::net::http::request::{ Request };
import std::net::http::response::{ Response };
import std::net::addr::url::{ Url };
import std::net::http::client::{ Client };
import std::net::http2::server::{ Http2Server };
import std::net::http2::connection::{ Http2Connection };
import std::net::http2::frame::{ Frame };
import std::net::http2::settings::{ Settings };
import std::io::bytes::{ ByteReader, ByteWriter };
import std::core::mem;
import std::test::error::{ TestError };
import std::test::assert::{ bail, expect, expect_eq };
import std::future::combinator::{ Futures };
import std::future::executor::{ Executor };

/// What the handlers observed, so a test can assert on the SERVER side too and
/// not just on what came back over the wire.
mut g_served:       i64 = 0;
mut g_body_seen:    i64 = 0;
mut g_headers_seen: i64 = 0;

/// The fixed reply body. 14 octets.
const REPLY_LEN: i64 = 14;

/// Headers the SERVER synthesizes onto every request it rebuilds, over and above
/// whatever the client sent: `host`, mapped back from the `:authority`
/// pseudo-header, and `content-length`, which `set_body` installs when the
/// decoded body is attached. Measured, not assumed — a change in either of those
/// two places should move these counts and be noticed.
const SYNTHESIZED_HEADERS: i64 = 2;

/// Reply `200 OK` with a fixed body, recording what arrived. Consumes the
/// request.
function h2_handler(req: Request) -> Response {
    mut request_local: Request = req;
    g_served = g_served + 1;
    g_body_seen = g_body_seen + (request_local.body.length() as i64);
    g_headers_seen = g_headers_seen + (request_local.headers.length() as i64);
    const resp: Response = Response::text(StatusCode::ok(), Str::new("Hello, HTTP/2!"));
    return resp;
}

/// Reply `200 OK` echoing the request body back, so a large payload is framed,
/// flow-controlled and reassembled in BOTH directions within one exchange.
function h2_echo_handler(req: Request) -> Response {
    mut request_local: Request = req;
    g_served = g_served + 1;
    g_body_seen = g_body_seen + (request_local.body.length() as i64);
    mut echo: Array<u8> = Array::<u8>::new();
    echo.append(request_local.body.as_slice());
    mut resp: Response = Response::new(StatusCode::ok());
    resp.set_body(echo);
    return resp;
}

function h2_body_eq(body: &Array<u8>, expected: Str) -> boolean {
    if (body.length() != expected.length()) { return false; }
    const eb: &Slice<u8> = expected.as_bytes();
    mut i: i64 = 0;
    while (i < body.length()) {
        match (body.get(i)) {
            Option::Some(b) => {
                match (eb.get(i)) {
                    Option::Some(e) => { if (b != e) { return false; } }
                    Option::None    => { return false; }
                }
            }
            Option::None => { return false; }
        }
        i++;
    }
    return true;
}

/// The byte a given offset of the generated payload must hold. A prime stride
/// so a frame boundary landing anywhere still shows up as a mismatch rather
/// than aliasing onto the right value.
function h2_pattern_byte(index: i64) -> u8 {
    return (index % 251) as u8;
}

function h2_push_decimal(out: mut &String, value: u64) -> void {
    mut temp: [u8; 24];
    const digits: i64 = value.to_decimal_buf(&temp[0]);
    mut i: i64 = 0;
    while (i < digits) {
        out.push_byte(temp[i]);
        i++;
    }
}

// ---- the two ends -----------------------------------------------------------

/// Accept one connection and serve it to completion. Returns 1 on a clean end.
/// The server is consumed, so its listener is closed when this future finishes.
async function h2_serve_one(server: Http2Server, handler: (Request) -> Response) -> i64 {
    mut s: Http2Server = server;
    match (await s.serve_one(handler)) {
        Result::Ok(_)  => { return 1; }
        Result::Err(_) => { return -1; }
    }
}

/// A client that speaks HTTP/2 without negotiation, as h2c needs.
function h2_client() -> Client {
    return Client::new().expect("TLS context").with_http2();
}

/// One h2c GET through the public client. Returns the response body length on
/// a verified `200`.
async function h2_get(port: u16, path: Str) -> i64 {
    const c: Client = h2_client();
    const text: String = f"http://127.0.0.1:{port}{path}";
    mut resp: Response = match (await c.get(Url::parse(text.as_str()).unwrap())) {
        Result::Ok(r)  => { r }
        Result::Err(_) => { return -10; }
    };
    const status_ok: boolean = resp.status.as_u16() == 200;
    const body_ok: boolean = h2_body_eq(&resp.body, Str::new("Hello, HTTP/2!"));
    const got: i64 = resp.body.length();
    if (!status_ok) { return -11; }
    if (!body_ok)   { return -12; }
    return got;
}

/// POST `n` generated octets and verify the same octets come back. Returns the
/// echoed length.
async function h2_post_echo(port: u16, n: i64) -> i64 {
    const c: Client = h2_client();
    mut body: Array<u8> = Array::<u8>::new();
    mut i: i64 = 0;
    while (i < n) { body.push(h2_pattern_byte(i)); i = i + 1; }

    // `body` is handed to the request before anything suspends, so the bytes
    // belong to the client connection from here on.
    const text: String = f"http://127.0.0.1:{port}/echo";
    mut resp: Response = match (await c.post(Url::parse(text.as_str()).unwrap(),
                                             Str::new("application/octet-stream"), body)) {
        Result::Ok(r)  => { r }
        Result::Err(_) => { return -20; }
    };
    const status_ok: boolean = resp.status.as_u16() == 200;
    const got: i64 = resp.body.length();
    mut mismatches: i64 = 0;
    mut j: i64 = 0;
    while (j < got) {
        match (resp.body.get(j)) {
            Option::Some(b) => { if (b != h2_pattern_byte(j)) { mismatches = mismatches + 1; } }
            Option::None    => { mismatches = mismatches + 1; }
        }
        j = j + 1;
    }
    if (!status_ok)      { return -21; }
    if (mismatches != 0) { return -22; }
    return got;
}

/// One GET carrying `count` padded headers, so the encoded block runs well past
/// the 16384-octet max frame size and has to be split into HEADERS +
/// CONTINUATION fragments.
async function h2_many_headers(port: u16, count: u64) -> i64 {
    mut sock: TcpStream = match (await TcpConnect::start(SocketAddr::localhost_v4(port))) {
        Result::Ok(v)  => { v }
        Result::Err(_) => { return -30; }
    };
    mut conn: Http2Connection<TcpStream> =
        Http2Connection::<TcpStream>::new_client(BufStream::<TcpStream>::of(sock));
    match (await conn.handshake_client()) {
        Result::Ok(_)  => { }
        Result::Err(_) => { return -31; }
    }

    mut pad: String = String::with_capacity(210);
    mut k: u64 = 0;
    while (k < 200) { pad.push_byte((0x61 + (k % 26)) as u8); k = k + 1; }

    mut req: Request = Request::new(Method::Get, Str::new("/hdrs"));
    mut i: u64 = 0;
    while (i < count) {
        mut name: String = String::with_capacity(16);
        name.push(Str::new("x-pad-"));
        h2_push_decimal(&name, i);
        req.headers.insert(name.as_str(), pad.as_str());
        i = i + 1;
    }

    mut resp: Response = match (await conn.request(req, Str::new("http"), Str::new("localhost"))) {
        Result::Ok(r)  => { r }
        Result::Err(_) => { return -32; }
    };
    const status_ok: boolean = resp.status.as_u16() == 200;
    const got: i64 = resp.body.length() as i64;
    if (!status_ok) { return -33; }
    return got;
}

/// `n` sequential requests on ONE connection: the connection is an owning local
/// awaited on twice per iteration from inside a loop, so its carrier is taken and
/// handed back on every request rather than once for the whole future.
async function h2_sequential(port: u16, n: i64) -> i64 {
    mut sock: TcpStream = match (await TcpConnect::start(SocketAddr::localhost_v4(port))) {
        Result::Ok(v)  => { v }
        Result::Err(_) => { return -40; }
    };
    mut conn: Http2Connection<TcpStream> =
        Http2Connection::<TcpStream>::new_client(BufStream::<TcpStream>::of(sock));
    match (await conn.handshake_client()) {
        Result::Ok(_)  => { }
        Result::Err(_) => { return -41; }
    }

    mut done: i64 = 0;
    while (done < n) {
        mut req: Request = Request::new(Method::Get, Str::new("/seq"));
        mut resp: Response = match (await conn.request(req, Str::new("http"), Str::new("localhost"))) {
            Result::Ok(r)  => { r }
            Result::Err(_) => { return -42; }
        };
        const status_ok: boolean = resp.status.as_u16() == 200;
        const body_ok: boolean = h2_body_eq(&resp.body, Str::new("Hello, HTTP/2!"));
        if (!status_ok) { return -43; }
        if (!body_ok)   { return -44; }
        done = done + 1;
    }
    return done;
}

/// Handshake and leave. Nothing drops the connection explicitly — it is released
/// when this future finishes, and that release is what the server observes as a
/// clean end of stream.
async function h2_handshake_then_close(port: u16) -> i64 {
    mut sock: TcpStream = match (await TcpConnect::start(SocketAddr::localhost_v4(port))) {
        Result::Ok(v)  => { v }
        Result::Err(_) => { return -50; }
    };
    mut conn: Http2Connection<TcpStream> =
        Http2Connection::<TcpStream>::new_client(BufStream::<TcpStream>::of(sock));
    match (await conn.handshake_client()) {
        Result::Ok(_)  => { return 1; }
        Result::Err(_) => { return -51; }
    }
}

/// A client that sends the preface and a SETTINGS frame with
/// `SETTINGS_ENABLE_PUSH = 2`, which the protocol forbids, then reads two
/// frames: the server's own SETTINGS and its answer. Returns the error code
/// of a GOAWAY answer, or a negative step code; an acknowledgement in its
/// place, which means the value was taken, is -66.
async function h2_bad_settings_client(port: u16) -> i64 {
    mut sock: TcpStream = match (await TcpConnect::start(SocketAddr::localhost_v4(port))) {
        Result::Ok(v)  => { v }
        Result::Err(_) => { return -60; }
    };
    mut c: BufStream<TcpStream> = BufStream::<TcpStream>::of(sock);
    match (c.pending().try_append(Str::new("PRI * HTTP/2.0\r\n\r\nSM\r\n\r\n").as_bytes())) {
        Result::Ok(_)  => { }
        Result::Err(_) => { return -61; }
    }
    mut queued: boolean = false;
    {
        mut payload: Array<u8> = Array::<u8>::new();
        settings::push_entry(&payload, settings::SETTINGS_ENABLE_PUSH, 2);
        queued = c.queue_h2_frame(frame::FRAME_SETTINGS, 0, 0, payload.as_slice()).is_ok();
    }
    if (!queued) { return -62; }
    match (await c.flush()) {
        Result::Ok(_)  => { }
        Result::Err(_) => { return -63; }
    }
    mut first: Frame = match (await c.read_h2_frame(16384)) {
        Result::Ok(f)  => { f }
        Result::Err(_) => { return -64; }
    };
    const first_is_settings: boolean = first.ftype == frame::FRAME_SETTINGS && !first.has_flag(frame::FLAG_ACK);
    mem::drop(first);
    if (!first_is_settings) { return -65; }
    mut answer: Frame = match (await c.read_h2_frame(16384)) {
        Result::Ok(f)  => { f }
        Result::Err(_) => { return -67; }
    };
    if (answer.ftype != frame::FRAME_GOAWAY) { return -66; }
    mut fields: ByteReader = ByteReader::new(answer.payload.as_slice());
    const last_stream: u32 = fields.read_u32_big_endian().unwrap_or(999);
    const code: u32 = fields.read_u32_big_endian().unwrap_or(999);
    if (last_stream != 0) { return -68; }
    return code as i64;
}

// ---- a server written frame by frame ------------------------------------------

/// Queue a SETTINGS frame carrying one entry.
function h2_queue_setting(c: mut &BufStream<TcpStream>, id: u16, value: u32) -> boolean {
    mut payload: Array<u8> = Array::<u8>::new();
    settings::push_entry(&payload, id, value);
    return c.queue_h2_frame(frame::FRAME_SETTINGS, 0, 0, payload.as_slice()).is_ok();
}

/// A server that writes its frames by hand, for what the public server
/// never sends. It reads the client's preface, sends one SETTINGS entry,
/// then for each case:
///   0 - (ENABLE_PUSH = 1) returns the error code of the GOAWAY the client
///       answers with;
///   1 - (INITIAL_WINDOW_SIZE = 10) once the request's first 10 DATA octets
///       are in, raises the initial window to 110 and sends a PING, and
///       returns the DATA octets that arrive before the stream ends;
///   2 - (INITIAL_WINDOW_SIZE = 1000) once the request's HEADERS are in,
///       fills the stream's window to 2^31 - 1, raises the initial window
///       by one, and returns the error code of the GOAWAY the client
///       answers with;
///   3 - (INITIAL_WINDOW_SIZE = 1000) answers the request's HEADERS with a
///       header block of 17 fragments of 16384 octets, past the client's
///       256 KiB limit, and returns the error code of the client's GOAWAY;
///   4 - (INITIAL_WINDOW_SIZE = 1000) answers with a header block HPACK
///       cannot decode, and returns the error code of the client's GOAWAY.
/// An acknowledgement where a GOAWAY or DATA belongs - the client took
/// the setting, or kept waiting - returns a negative step code, as does a
/// connection that ends without a GOAWAY.
async function h2_raw_server(listener: TcpListener, case: i64) -> i64 {
    mut accepted: TcpAccepted = await TcpAccept::start(listener);
    mut _listener: TcpListener = accepted.take_listener();
    mut sock: TcpStream = match (accepted.take_result()) {
        Result::Ok(v)  => { v }
        Result::Err(_) => { return -200; }
    };
    mut c: BufStream<TcpStream> = BufStream::<TcpStream>::of(sock);
    match (await c.ensure(24)) {
        Result::Ok(_)  => { }
        Result::Err(_) => { return -201; }
    }
    c.consume(24);
    mut queued: boolean = false;
    if (case == 0) {
        queued = h2_queue_setting(&c, settings::SETTINGS_ENABLE_PUSH, 1);
    } else if (case == 1) {
        queued = h2_queue_setting(&c, settings::SETTINGS_INITIAL_WINDOW_SIZE, 10);
    } else {
        queued = h2_queue_setting(&c, settings::SETTINGS_INITIAL_WINDOW_SIZE, 1000);
    }
    if (!queued) { return -202; }
    match (await c.flush()) {
        Result::Ok(_)  => { }
        Result::Err(_) => { return -203; }
    }
    mut data: i64 = 0;
    mut changed: boolean = false;
    loop {
        mut fr: Frame = match (await c.read_h2_frame(16384)) {
            Result::Ok(f)  => { f }
            Result::Err(_) => { return -204; }
        };
        const ftype: u8 = fr.ftype;
        const ack: boolean = fr.has_flag(frame::FLAG_ACK);
        const end: boolean = fr.has_flag(frame::FLAG_END_STREAM);
        const length: i64 = fr.payload.length();
        mut fields: ByteReader = ByteReader::new(fr.payload.as_slice());
        const _last_stream: u32 = fields.read_u32_big_endian().unwrap_or(0);
        const code: u32 = fields.read_u32_big_endian().unwrap_or(999);
        mem::drop(fr);
        if (ftype == frame::FRAME_GOAWAY) {
            if (case == 1) { return -205; }
            return code as i64;
        }
        if (case == 0) {
            if (ftype == frame::FRAME_SETTINGS && ack) { return -206; }
        } else if (case == 1) {
            if (ftype == frame::FRAME_PING && ack) { return -207; }
            if (ftype == frame::FRAME_DATA) {
                data = data + length;
                if (end) { return data; }
                if (!changed && data >= 10) {
                    queued = h2_queue_setting(&c, settings::SETTINGS_INITIAL_WINDOW_SIZE, 110);
                    queued = queued && c.queue_h2_frame(frame::FRAME_PING, 0, 0,
                        Str::new("12345678").as_bytes()).is_ok();
                    if (!queued) { return -208; }
                    match (await c.flush()) {
                        Result::Ok(_)  => { }
                        Result::Err(_) => { return -209; }
                    }
                    changed = true;
                }
            }
        } else if (case >= 3) {
            if (!changed && ftype == frame::FRAME_HEADERS) {
                if (case == 3) {
                    mut fragment: Array<u8> = Array::<u8>::new();
                    for (mut i: i64 = 0; i < 16384; i++) { fragment.push(0); }
                    for (mut sent: i64 = 0; sent < 17; sent++) {
                        const ftype_out: u8 = if (sent == 0) { frame::FRAME_HEADERS } else { frame::FRAME_CONTINUATION };
                        if (!c.queue_h2_frame(ftype_out, 0, 1, fragment.as_slice()).is_ok()) { return -213; }
                        match (await c.flush()) {
                            Result::Ok(_)  => { }
                            Result::Err(_) => { return -214; }
                        }
                    }
                } else {
                    // 0x80 names entry 0 of the HPACK tables, which none has.
                    mut block: Array<u8> = Array::<u8>::new();
                    block.push(0x80);
                    queued = c.queue_h2_frame(frame::FRAME_HEADERS,
                        frame::FLAG_END_HEADERS | frame::FLAG_END_STREAM, 1, block.as_slice()).is_ok();
                    mem::drop(block);
                    if (!queued) { return -215; }
                    match (await c.flush()) {
                        Result::Ok(_)  => { }
                        Result::Err(_) => { return -216; }
                    }
                }
                changed = true;
            }
        } else {
            if (changed && ftype == frame::FRAME_SETTINGS && ack) { return -210; }
            if (!changed && ftype == frame::FRAME_HEADERS) {
                mut increment: Array<u8> = Array::<u8>::with_capacity(4);
                mut writer: ByteWriter = ByteWriter::new(&increment);
                writer.write_u32_big_endian(2147483647 - 1000);
                queued = c.queue_h2_frame(frame::FRAME_WINDOW_UPDATE, 0, 1, increment.as_slice()).is_ok();
                mem::drop(increment);
                queued = queued && h2_queue_setting(&c, settings::SETTINGS_INITIAL_WINDOW_SIZE, 1001);
                if (!queued) { return -211; }
                match (await c.flush()) {
                    Result::Ok(_)  => { }
                    Result::Err(_) => { return -212; }
                }
                changed = true;
            }
        }
    }
}

/// The client half of `h2_raw_server`'s case: handshake, then (case 1) a
/// 100-octet POST or (cases 2 to 4) a GET. Returns 1 when the connection
/// failed where the case says it must - in the handshake for case 0, in
/// the request for cases 2 to 4 - or, for case 1, whatever the request did, since
/// the server ends the connection without a response; a negative step
/// code otherwise.
async function h2_raw_client(port: u16, case: i64) -> i64 {
    mut sock: TcpStream = match (await TcpConnect::start(SocketAddr::localhost_v4(port))) {
        Result::Ok(v)  => { v }
        Result::Err(_) => { return -300; }
    };
    mut conn: Http2Connection<TcpStream> =
        Http2Connection::<TcpStream>::new_client(BufStream::<TcpStream>::of(sock));
    match (await conn.handshake_client()) {
        Result::Ok(_)  => { if (case == 0) { return -301; } }
        Result::Err(_) => { if (case == 0) { return 1; } return -302; }
    }
    mut req: Request = Request::new(Method::Get, Str::new("/"));
    if (case == 1) {
        mut body: Array<u8> = Array::<u8>::new();
        for (mut i: i64 = 0; i < 100; i++) { body.push(h2_pattern_byte(i)); }
        req = Request::new(Method::Post, Str::new("/")).with_body(body);
    }
    match (await conn.request(req, Str::new("http"), Str::new("localhost"))) {
        Result::Ok(r)  => { mut _response: Response = r; if (case >= 2) { return -303; } return 1; }
        Result::Err(_) => { return 1; }
    }
}

async function h2_raw_pair(listener: TcpListener, port: u16, case: i64) -> (i64, i64) {
    return await Futures::join(h2_raw_server(listener, case), h2_raw_client(port, case));
}

/// The server's result and the client's for one case.
function h2_raw_case(case: i64) -> (i64, i64) {
    mut listener: TcpListener = match (TcpListener::bind(SocketAddr::localhost_v4(0))) {
        Result::Ok(l)  => { l }
        Result::Err(_) => { return (-1000, -1000); }
    };
    match (listener.set_nonblocking(true)) {
        Result::Ok(_)  => { }
        Result::Err(_) => { return (-1000, -1000); }
    }
    const port: u16 = match (listener.local_addr()) {
        Result::Ok(a)  => { a.port }
        Result::Err(_) => { return (-1001, -1001); }
    };
    mut ex: Executor = Executor::new();
    return ex.block_on(h2_raw_pair(listener, port, case));
}

/// A client whose 24-octet preface is not HTTP/2's. Returns the error code
/// of the GOAWAY the server answers with, or a negative step code.
async function h2_bad_preface_client(port: u16) -> i64 {
    mut sock: TcpStream = match (await TcpConnect::start(SocketAddr::localhost_v4(port))) {
        Result::Ok(v)  => { v }
        Result::Err(_) => { return -70; }
    };
    mut c: BufStream<TcpStream> = BufStream::<TcpStream>::of(sock);
    match (c.pending().try_append(Str::new("PRI * HTTP/2.0\r\n\r\nXX\r\n\r\n").as_bytes())) {
        Result::Ok(_)  => { }
        Result::Err(_) => { return -71; }
    }
    match (await c.flush()) {
        Result::Ok(_)  => { }
        Result::Err(_) => { return -72; }
    }
    mut answer: Frame = match (await c.read_h2_frame(16384)) {
        Result::Ok(f)  => { f }
        Result::Err(_) => { return -73; }
    };
    if (answer.ftype != frame::FRAME_GOAWAY) { return -74; }
    mut fields: ByteReader = ByteReader::new(answer.payload.as_slice());
    const _last_stream: u32 = fields.read_u32_big_endian().unwrap_or(0);
    return fields.read_u32_big_endian().unwrap_or(999) as i64;
}

async function h2_join_bad_preface(port: u16, server: Http2Server) -> (i64, i64) {
    return await Futures::join(h2_serve_one(server, h2_handler),
                               h2_bad_preface_client(port));
}

// ---- a client written frame by frame ------------------------------------------

/// Queue a WINDOW_UPDATE granting `increment` octets on `stream_id`.
function h2_queue_window_update(c: mut &BufStream<TcpStream>, stream_id: u32, increment: u32) -> boolean {
    mut payload: Array<u8> = Array::<u8>::with_capacity(4);
    mut writer: ByteWriter = ByteWriter::new(&payload);
    writer.write_u32_big_endian(increment);
    return c.queue_h2_frame(frame::FRAME_WINDOW_UPDATE, 0, stream_id, payload.as_slice()).is_ok();
}

/// Queue a GET for `/` on `stream_id`, its header block written from HPACK's
/// static table alone: `:method GET`, `:path /`, `:scheme http`.
function h2_queue_get(c: mut &BufStream<TcpStream>, stream_id: u32) -> boolean {
    mut block: Array<u8> = Array::<u8>::new();
    block.push(0x82);
    block.push(0x84);
    block.push(0x86);
    return c.queue_h2_frame(frame::FRAME_HEADERS, frame::FLAG_END_HEADERS | frame::FLAG_END_STREAM,
                            stream_id, block.as_slice()).is_ok();
}

/// A client that writes its frames by hand, for what the public client
/// never sends, against the public server. After the preface it sends a
/// SETTINGS frame - INITIAL_WINDOW_SIZE = 10 for cases 11 and 12, empty
/// otherwise - and then for each case:
///   10 - a GET on stream 1; once its response has ended, a WINDOW_UPDATE
///        of 2^31 - 1 naming the closed stream 1, then a GET on stream 3;
///   11 - a GET on stream 1; once 10 octets of its response are in, a
///        WINDOW_UPDATE of 100 naming stream 5, which was never opened, and
///        a PING; once the PING is acknowledged, a WINDOW_UPDATE of 4 on
///        stream 1 for the rest of the response;
///   12 - a GET on stream 1; once 10 octets of its response are in, a
///        WINDOW_UPDATE of 1000 on stream 1; once the response has ended,
///        SETTINGS INITIAL_WINDOW_SIZE = 2^31 - 1, then a GET on stream 3;
///   13 - a header block of 17 fragments of 16384 octets on stream 1, past
///        the server's 256 KiB limit;
///   14 - a header block HPACK cannot decode;
///   15 - a header block that decodes to a response's `:status` field,
///        which no request carries.
/// Cases 10 and 12 return the DATA octets of both responses, case 11 the
/// octets that arrived before the PING's acknowledgement, and cases 13 to 15
/// the error code of the server's GOAWAY. A GOAWAY where a response belongs
/// returns -1000 minus its code, and any other failure a negative step code.
async function h2_raw_client_of_server(port: u16, case: i64) -> i64 {
    mut sock: TcpStream = match (await TcpConnect::start(SocketAddr::localhost_v4(port))) {
        Result::Ok(v)  => { v }
        Result::Err(_) => { return -400; }
    };
    mut c: BufStream<TcpStream> = BufStream::<TcpStream>::of(sock);
    mut queued: boolean =
        c.pending().try_append(Str::new("PRI * HTTP/2.0\r\n\r\nSM\r\n\r\n").as_bytes()).is_ok();
    if (case == 11 || case == 12) {
        queued = queued && h2_queue_setting(&c, settings::SETTINGS_INITIAL_WINDOW_SIZE, 10);
    } else {
        mut empty: Array<u8> = Array::<u8>::new();
        queued = queued && c.queue_h2_frame(frame::FRAME_SETTINGS, 0, 0, empty.as_slice()).is_ok();
    }
    if (case <= 12) {
        queued = queued && h2_queue_get(&c, 1);
    } else if (case == 14 || case == 15) {
        // 0x80 names entry 0 of the HPACK tables, which none has; 0x88 is
        // the static table's `:status: 200`.
        const field: u8 = if (case == 14) { 0x80 } else { 0x88 };
        mut block: Array<u8> = Array::<u8>::new();
        block.push(field);
        queued = queued && c.queue_h2_frame(frame::FRAME_HEADERS,
            frame::FLAG_END_HEADERS | frame::FLAG_END_STREAM, 1, block.as_slice()).is_ok();
    }
    if (!queued) { return -401; }
    match (await c.flush()) {
        Result::Ok(_)  => { }
        Result::Err(_) => { return -402; }
    }
    if (case == 13) {
        mut fragment: Array<u8> = Array::<u8>::new();
        for (mut i: i64 = 0; i < 16384; i++) { fragment.push(0); }
        for (mut sent: i64 = 0; sent < 17; sent++) {
            const ftype_out: u8 = if (sent == 0) { frame::FRAME_HEADERS } else { frame::FRAME_CONTINUATION };
            if (!c.queue_h2_frame(ftype_out, 0, 1, fragment.as_slice()).is_ok()) { return -403; }
            match (await c.flush()) {
                Result::Ok(_)  => { }
                Result::Err(_) => { return -404; }
            }
        }
    }
    mut sid: u32 = 1;
    mut data: i64 = 0;
    mut total: i64 = 0;
    mut before_ack: i64 = -1;
    mut ended: boolean = false;
    mut granted: boolean = false;
    loop {
        mut fr: Frame = match (await c.read_h2_frame(16384)) {
            Result::Ok(f)  => { f }
            Result::Err(_) => { return -405; }
        };
        const ftype: u8 = fr.ftype;
        const ack: boolean = fr.has_flag(frame::FLAG_ACK);
        const end: boolean = fr.has_flag(frame::FLAG_END_STREAM);
        const stream: u32 = fr.stream_id;
        const length: i64 = fr.payload.length();
        mut fields: ByteReader = ByteReader::new(fr.payload.as_slice());
        const _last_stream: u32 = fields.read_u32_big_endian().unwrap_or(0);
        const code: u32 = fields.read_u32_big_endian().unwrap_or(999);
        mem::drop(fr);
        if (ftype == frame::FRAME_GOAWAY) {
            if (case >= 13) { return code as i64; }
            return -1000 - (code as i64);
        }
        if (case == 11 && ftype == frame::FRAME_PING && ack) {
            before_ack = total + data;
            if (!h2_queue_window_update(&c, 1, 4)) { return -406; }
            match (await c.flush()) {
                Result::Ok(_)  => { }
                Result::Err(_) => { return -407; }
            }
        }
        if (ftype == frame::FRAME_DATA && stream == sid) {
            data = data + length;
            if (!granted && data >= 10 && (case == 11 || case == 12)) {
                if (case == 11) {
                    queued = h2_queue_window_update(&c, 5, 100)
                        && c.queue_h2_frame(frame::FRAME_PING, 0, 0, Str::new("12345678").as_bytes()).is_ok();
                } else {
                    queued = h2_queue_window_update(&c, 1, 1000);
                }
                if (!queued) { return -408; }
                match (await c.flush()) {
                    Result::Ok(_)  => { }
                    Result::Err(_) => { return -409; }
                }
                granted = true;
            }
            if (end) {
                total = total + data;
                data = 0;
                if (case == 11) {
                    ended = true;
                } else if (sid == 3) {
                    return total;
                } else {
                    if (case == 10) {
                        queued = h2_queue_window_update(&c, 1, 2147483647);
                    } else {
                        queued = h2_queue_setting(&c, settings::SETTINGS_INITIAL_WINDOW_SIZE, 2147483647);
                    }
                    queued = queued && h2_queue_get(&c, 3);
                    if (!queued) { return -410; }
                    match (await c.flush()) {
                        Result::Ok(_)  => { }
                        Result::Err(_) => { return -411; }
                    }
                    sid = 3;
                }
            }
        }
        if (ended && before_ack >= 0) { return before_ack; }
    }
}

async function h2_join_raw_client(port: u16, server: Http2Server, case: i64) -> (i64, i64) {
    return await Futures::join(h2_serve_one(server, h2_handler),
                               h2_raw_client_of_server(port, case));
}

/// The public server's result and the hand-written client's for one case.
function h2_server_case(case: i64) -> (i64, i64) {
    mut server: Http2Server = match (h2_bind()) {
        Result::Ok(s)  => { s }
        Result::Err(_) => { return (-1000, -1000); }
    };
    const port: u16 = match (server.local_addr()) {
        Result::Ok(a)  => { a.port }
        Result::Err(_) => { return (-1001, -1001); }
    };
    mut ex: Executor = Executor::new();
    return ex.block_on(h2_join_raw_client(port, server, case));
}

// ---- joins ------------------------------------------------------------------

/// The server's result and the client's, unchanged, so the test can tell
/// which side went wrong.
async function h2_join_bad_settings(port: u16, server: Http2Server) -> (i64, i64) {
    return await Futures::join(h2_serve_one(server, h2_handler),
                               h2_bad_settings_client(port));
}

async function h2_join_get(port: u16, server: Http2Server) -> i64 {
    const pair: (i64, i64) = await Futures::join(h2_serve_one(server, h2_handler),
                                                 h2_get(port, Str::new("/hello")));
    if (pair.0 != 1) { return pair.0; }
    return pair.1;
}

async function h2_join_echo(port: u16, server: Http2Server, n: i64) -> i64 {
    const pair: (i64, i64) = await Futures::join(h2_serve_one(server, h2_echo_handler),
                                                 h2_post_echo(port, n));
    if (pair.0 != 1) { return pair.0; }
    return pair.1;
}

async function h2_join_headers(port: u16, server: Http2Server, count: u64) -> i64 {
    const pair: (i64, i64) = await Futures::join(h2_serve_one(server, h2_handler),
                                                 h2_many_headers(port, count));
    if (pair.0 != 1) { return pair.0; }
    return pair.1;
}

async function h2_join_sequential(port: u16, server: Http2Server, n: i64) -> i64 {
    const pair: (i64, i64) = await Futures::join(h2_serve_one(server, h2_handler),
                                                 h2_sequential(port, n));
    if (pair.0 != 1) { return pair.0; }
    return pair.1;
}

async function h2_join_close(port: u16, server: Http2Server) -> i64 {
    const pair: (i64, i64) = await Futures::join(h2_serve_one(server, h2_handler),
                                                 h2_handshake_then_close(port));
    if (pair.0 != 1) { return pair.0; }
    return pair.1;
}

// ---- tests ------------------------------------------------------------------

/// Bind `127.0.0.1:0` and read back the kernel-assigned port, so concurrent runs
/// never collide and no retry loop is needed.
function h2_bind() -> Result<Http2Server, IoError> {
    return Http2Server::bind(SocketAddr::localhost_v4(0));
}

![test]
function h2c_loopback_get_round_trip() -> Result<(), TestError> {
    g_served = 0; g_body_seen = 0; g_headers_seen = 0;
    mut server: Http2Server = match (h2_bind()) {
        Result::Ok(s)  => { s }
        Result::Err(_) => { return bail(Str::new("h2 bind 127.0.0.1:0 failed")); }
    };
    const port: u16 = match (server.local_addr()) {
        Result::Ok(a)  => { a.port }
        Result::Err(_) => { return bail(Str::new("local_addr failed")); }
    };
    mut ex: Executor = Executor::new();
    const r: i64 = ex.block_on(h2_join_get(port, server));
    if (r != REPLY_LEN) { return expect_eq(r, REPLY_LEN); }
    // Exactly one dispatch, no body, and only the two headers the server
    // synthesizes — the client sent none of its own.
    if (g_served != 1)    { return expect_eq(g_served, 1 as i64); }
    if (g_body_seen != 0) { return expect_eq(g_body_seen, 0 as i64); }
    return expect_eq(g_headers_seen, SYNTHESIZED_HEADERS);
}

![test]
function h2c_loopback_echoes_a_large_body_through_flow_control() -> Result<(), TestError> {
    g_served = 0; g_body_seen = 0; g_headers_seen = 0;
    // Past the fixed 65535-octet connection send window, so the send has to wait
    // on a WINDOW_UPDATE and apply it, in both directions.
    const n: i64 = 100000;
    mut server: Http2Server = match (h2_bind()) {
        Result::Ok(s)  => { s }
        Result::Err(_) => { return bail(Str::new("h2 bind 127.0.0.1:0 failed")); }
    };
    const port: u16 = match (server.local_addr()) {
        Result::Ok(a)  => { a.port }
        Result::Err(_) => { return bail(Str::new("local_addr failed")); }
    };
    mut ex: Executor = Executor::new();
    const r: i64 = ex.block_on(h2_join_echo(port, server, n));
    if (r != n) { return expect_eq(r, n); }
    if (g_served != 1) { return expect_eq(g_served, 1 as i64); }
    return expect_eq(g_body_seen, n as i64);
}

![test]
function h2c_loopback_header_block_spanning_continuation_frames() -> Result<(), TestError> {
    g_served = 0; g_body_seen = 0; g_headers_seen = 0;
    // 300 fields of a ~200-octet value encode to far more than the 16384-octet
    // max frame size, so the block cannot go out in a single HEADERS frame.
    const count: u64 = 300;
    mut server: Http2Server = match (h2_bind()) {
        Result::Ok(s)  => { s }
        Result::Err(_) => { return bail(Str::new("h2 bind 127.0.0.1:0 failed")); }
    };
    const port: u16 = match (server.local_addr()) {
        Result::Ok(a)  => { a.port }
        Result::Err(_) => { return bail(Str::new("local_addr failed")); }
    };
    mut ex: Executor = Executor::new();
    const r: i64 = ex.block_on(h2_join_headers(port, server, count));
    if (r != REPLY_LEN) { return expect_eq(r, REPLY_LEN); }
    if (g_served != 1)  { return expect_eq(g_served, 1 as i64); }
    // Every padded field survived the split and was reassembled from the
    // CONTINUATION fragments, plus the two the server synthesizes. One field
    // lost in a fragment boundary shows up here as a number.
    return expect_eq(g_headers_seen, (count as i64) + SYNTHESIZED_HEADERS);
}

![test]
function h2c_loopback_serves_several_requests_on_one_connection() -> Result<(), TestError> {
    g_served = 0; g_body_seen = 0; g_headers_seen = 0;
    const n: i64 = 4;
    mut server: Http2Server = match (h2_bind()) {
        Result::Ok(s)  => { s }
        Result::Err(_) => { return bail(Str::new("h2 bind 127.0.0.1:0 failed")); }
    };
    const port: u16 = match (server.local_addr()) {
        Result::Ok(a)  => { a.port }
        Result::Err(_) => { return bail(Str::new("local_addr failed")); }
    };
    mut ex: Executor = Executor::new();
    const r: i64 = ex.block_on(h2_join_sequential(port, server, n));
    if (r != n) { return expect_eq(r, n); }
    // One dispatch per request, and the synthesized pair on each — so a request
    // silently served twice, or one whose headers leaked into the next, moves
    // this count.
    if (g_served != n) { return expect_eq(g_served, n); }
    return expect_eq(g_headers_seen, n * SYNTHESIZED_HEADERS);
}

![test]
function h2c_loopback_client_close_ends_the_server_loop() -> Result<(), TestError> {
    g_served = 0; g_body_seen = 0; g_headers_seen = 0;
    mut server: Http2Server = match (h2_bind()) {
        Result::Ok(s)  => { s }
        Result::Err(_) => { return bail(Str::new("h2 bind 127.0.0.1:0 failed")); }
    };
    const port: u16 = match (server.local_addr()) {
        Result::Ok(a)  => { a.port }
        Result::Err(_) => { return bail(Str::new("local_addr failed")); }
    };
    mut ex: Executor = Executor::new();
    const r: i64 = ex.block_on(h2_join_close(port, server));
    // The client handshook and left; the server's read loop reported a clean end
    // (pair.0 == 1) rather than an error, which it can only see if the client's
    // connection was actually released.
    if (r != 1) { return expect_eq(r, 1 as i64); }
    return expect_eq(g_served, 0 as i64);
}

/// The server ends a connection whose SETTINGS the protocol forbids with
/// a GOAWAY naming the error, and reports the failure itself.
![test]
function h2c_loopback_forbidden_setting_is_answered_with_goaway() -> Result<(), TestError> {
    g_served = 0; g_body_seen = 0; g_headers_seen = 0;
    mut server: Http2Server = match (h2_bind()) {
        Result::Ok(s)  => { s }
        Result::Err(_) => { return bail(Str::new("h2 bind 127.0.0.1:0 failed")); }
    };
    const port: u16 = match (server.local_addr()) {
        Result::Ok(a)  => { a.port }
        Result::Err(_) => { return bail(Str::new("local_addr failed")); }
    };
    mut ex: Executor = Executor::new();
    const pair: (i64, i64) = ex.block_on(h2_join_bad_settings(port, server));
    expect_eq(pair.1, frame::PROTOCOL_ERROR as i64)?;
    expect_eq(pair.0, -1 as i64)?;
    return expect_eq(g_served, 0 as i64);
}

/// The code a refused setting carries, or `u32::MAX` when it was taken.
function refusal_code(outcome: Result<(), u32>) -> u32 {
    return match (outcome) {
        Result::Ok(_)     => { u32::MAX }
        Result::Err(code) => { code }
    };
}

![test]
function settings_take_each_bound_and_refuse_past_it() -> Result<(), TestError> {
    mut s: Settings = Settings::defaults();
    expect_eq(refusal_code(s.apply_one(settings::SETTINGS_ENABLE_PUSH, 0)), u32::MAX)?;
    expect_eq(refusal_code(s.apply_one(settings::SETTINGS_ENABLE_PUSH, 1)), u32::MAX)?;
    expect_eq(refusal_code(s.apply_one(settings::SETTINGS_ENABLE_PUSH, 2)), frame::PROTOCOL_ERROR)?;
    expect_eq(s.enable_push, 1)?;
    expect_eq(refusal_code(s.apply_one(settings::SETTINGS_INITIAL_WINDOW_SIZE, 2147483647)), u32::MAX)?;
    expect_eq(refusal_code(s.apply_one(settings::SETTINGS_INITIAL_WINDOW_SIZE, 2147483648)),
        frame::FLOW_CONTROL_ERROR)?;
    expect_eq(s.initial_window_size, 2147483647)?;
    expect_eq(refusal_code(s.apply_one(settings::SETTINGS_MAX_FRAME_SIZE, 16384)), u32::MAX)?;
    expect_eq(refusal_code(s.apply_one(settings::SETTINGS_MAX_FRAME_SIZE, 16777215)), u32::MAX)?;
    expect_eq(refusal_code(s.apply_one(settings::SETTINGS_MAX_FRAME_SIZE, 16383)), frame::PROTOCOL_ERROR)?;
    expect_eq(refusal_code(s.apply_one(settings::SETTINGS_MAX_FRAME_SIZE, 16777216)), frame::PROTOCOL_ERROR)?;
    expect_eq(refusal_code(s.apply_one(settings::SETTINGS_MAX_FRAME_SIZE, 0)), frame::PROTOCOL_ERROR)?;
    expect_eq(s.max_frame_size, 16777215)?;
    // An identifier the protocol does not define is ignored, whatever its value.
    return expect_eq(refusal_code(s.apply_one(0x99, u32::MAX)), u32::MAX);
}

![test]
function settings_payload_stops_at_the_first_refusal() -> Result<(), TestError> {
    mut s: Settings = Settings::defaults();
    mut payload: Array<u8> = Array::<u8>::new();
    settings::push_entry(&payload, settings::SETTINGS_HEADER_TABLE_SIZE, 100);
    settings::push_entry(&payload, settings::SETTINGS_ENABLE_PUSH, 5);
    settings::push_entry(&payload, settings::SETTINGS_MAX_FRAME_SIZE, 20000);
    expect_eq(refusal_code(s.apply_payload(payload.as_slice())), frame::PROTOCOL_ERROR)?;
    expect_eq(s.header_table_size, 100)?;
    expect_eq(s.max_frame_size, 16384)?;
    payload.push(0);
    return expect_eq(refusal_code(s.apply_payload(payload.as_slice())), frame::FRAME_SIZE_ERROR);
}

/// A client ends a connection whose server says it accepts pushed streams.
![test]
function a_client_refuses_a_server_enabling_push() -> Result<(), TestError> {
    const r: (i64, i64) = h2_raw_case(0);
    expect_eq(r.1, 1 as i64)?;
    return expect_eq(r.0, frame::PROTOCOL_ERROR as i64);
}

/// A larger initial window reaches the stream that is waiting to send.
![test]
function a_new_initial_window_moves_the_open_stream_window() -> Result<(), TestError> {
    const r: (i64, i64) = h2_raw_case(1);
    expect_eq(r.1, 1 as i64)?;
    return expect_eq(r.0, 100 as i64);
}

/// An initial window change that lifts a stream's window past 2^31 - 1
/// ends the connection with FLOW_CONTROL_ERROR.
![test]
function an_initial_window_change_past_the_largest_window_is_refused() -> Result<(), TestError> {
    const r: (i64, i64) = h2_raw_case(2);
    expect_eq(r.1, 1 as i64)?;
    return expect_eq(r.0, frame::FLOW_CONTROL_ERROR as i64);
}

/// A header block past what this side accepts ends the connection with a
/// GOAWAY, ENHANCE_YOUR_CALM.
![test]
function an_oversized_header_block_is_answered_with_goaway() -> Result<(), TestError> {
    const r: (i64, i64) = h2_raw_case(3);
    expect_eq(r.1, 1 as i64)?;
    return expect_eq(r.0, frame::ENHANCE_YOUR_CALM as i64);
}

/// A header block HPACK cannot decode ends the connection with a GOAWAY,
/// COMPRESSION_ERROR.
![test]
function an_undecodable_header_block_is_answered_with_goaway() -> Result<(), TestError> {
    const r: (i64, i64) = h2_raw_case(4);
    expect_eq(r.1, 1 as i64)?;
    return expect_eq(r.0, frame::COMPRESSION_ERROR as i64);
}

/// A WINDOW_UPDATE for a stream that has ended credits no window, so the
/// next stream is served.
![test]
function a_window_update_naming_a_closed_stream_credits_nothing() -> Result<(), TestError> {
    const r: (i64, i64) = h2_server_case(10);
    expect_eq(r.1, 2 * REPLY_LEN)?;
    return expect_eq(r.0, 1 as i64);
}

/// A WINDOW_UPDATE for a stream never opened does not credit the stream
/// being sent: the response stops at its 10-octet window until its own
/// stream is credited.
![test]
function a_window_update_naming_an_unopened_stream_credits_nothing() -> Result<(), TestError> {
    const r: (i64, i64) = h2_server_case(11);
    expect_eq(r.1, 10 as i64)?;
    return expect_eq(r.0, 1 as i64);
}

/// An initial window change between streams moves no stream's window:
/// the ended stream's credited window is not lifted past 2^31 - 1, and
/// the next stream opens at the new value.
![test]
function an_initial_window_change_between_streams_moves_no_window() -> Result<(), TestError> {
    const r: (i64, i64) = h2_server_case(12);
    expect_eq(r.1, 2 * REPLY_LEN)?;
    return expect_eq(r.0, 1 as i64);
}

/// A request header block past what the server accepts ends the connection
/// with a GOAWAY, ENHANCE_YOUR_CALM.
![test]
function a_server_answers_an_oversized_request_header_block_with_goaway() -> Result<(), TestError> {
    const r: (i64, i64) = h2_server_case(13);
    expect_eq(r.1, frame::ENHANCE_YOUR_CALM as i64)?;
    return expect_eq(r.0, -1 as i64);
}

/// A request header block HPACK cannot decode ends the connection with a
/// GOAWAY, COMPRESSION_ERROR.
![test]
function a_server_answers_an_undecodable_request_header_block_with_goaway() -> Result<(), TestError> {
    const r: (i64, i64) = h2_server_case(14);
    expect_eq(r.1, frame::COMPRESSION_ERROR as i64)?;
    return expect_eq(r.0, -1 as i64);
}

/// A request header block that decodes but is not a request ends the
/// connection with a GOAWAY, PROTOCOL_ERROR.
![test]
function a_server_answers_a_malformed_request_with_goaway() -> Result<(), TestError> {
    const r: (i64, i64) = h2_server_case(15);
    expect_eq(r.1, frame::PROTOCOL_ERROR as i64)?;
    return expect_eq(r.0, -1 as i64);
}

/// A connection that does not open with HTTP/2's preface is answered with a
/// GOAWAY, PROTOCOL_ERROR.
![test]
function a_bad_preface_is_answered_with_goaway() -> Result<(), TestError> {
    g_served = 0; g_body_seen = 0; g_headers_seen = 0;
    mut server: Http2Server = match (h2_bind()) {
        Result::Ok(s)  => { s }
        Result::Err(_) => { return bail(Str::new("h2 bind 127.0.0.1:0 failed")); }
    };
    const port: u16 = match (server.local_addr()) {
        Result::Ok(a)  => { a.port }
        Result::Err(_) => { return bail(Str::new("local_addr failed")); }
    };
    mut ex: Executor = Executor::new();
    const pair: (i64, i64) = ex.block_on(h2_join_bad_preface(port, server));
    expect_eq(pair.1, frame::PROTOCOL_ERROR as i64)?;
    expect_eq(pair.0, -1 as i64)?;
    return expect_eq(g_served, 0 as i64);
}
