///! std::thread::Builder: configured spawning (stack size + OS thread
///! name) on top of `spawn_with_attr`.
///!
///! Exercises the by-value generic builder methods (`spawn` / `try_spawn`
///! take `this` by value) end-to-end, including the OS thread name (set via
///! `pthread_setname_np` on POSIX, `SetThreadDescription` on Windows) and
///! per-platform stack-size handling.

![config(testing)]
namespace CryoTests::Tests::Stdlib::ThreadBuilder;

import std::core::result;
import std::collections::str;
import std::thread;
import std::ffi::libc;
import std::sys::syscall;
import std::test::error;
import std::test::assert;

/// Plain worker: double its input.
function double_it(x: i32) -> i32 {
    return x * 2;
}

/// Worker that checks its OWN OS thread name matches "worker". The name is
/// applied by the parent right after the thread is created, so poll briefly to
/// avoid racing the set. Returns 1 on match, 0 on timeout. The readback uses
/// each platform's native API: `pthread_getname_np` on POSIX,
/// `GetThreadDescription` on Windows.
![target(unix)]
function name_is_worker(tag: i32) -> i32 {
    const expected: Str = Str::new("worker");
    mut tries: i32 = 0;
    while (tries < 500) {
        mut buf: u8[32];
        mut i: u64 = 0;
        while (i < 32) { buf[i] = 0; i = i + 1; }
        libc::pthread_getname_np(libc::pthread_self(), &buf[0], 32u64);
        const got: Str = Str::from_raw(&buf[0], libc::strlen(&buf[0]));
        if (got.equals(&expected)) { return 1; }
        thread::sleep_ms(1u64);
        tries = tries + 1;
    }
    return 0;
}

// Compare a NUL-terminated UTF-16 string to the literal "worker".
![target(windows)]
function wide_is_worker(w: u16*) -> boolean {
    // 'w' 'o' 'r' 'k' 'e' 'r' NUL
    const expected: u16[7] = [119u16, 111u16, 114u16, 107u16, 101u16, 114u16, 0u16];
    mut i: u64 = 0u64;
    while (i < 7u64) {
        if (w[i] != expected[i]) { return false; }
        i = i + 1u64;
    }
    return true;
}

![target(windows)]
function name_is_worker(tag: i32) -> i32 {
    mut tries: i32 = 0;
    while (tries < 500) {
        mut pwsz: u16* = null;
        const hr: i32 = syscall::GetThreadDescription(syscall::GetCurrentThread(), &pwsz);
        if (hr >= 0 && pwsz != null) {
            const ok: boolean = wide_is_worker(pwsz);
            syscall::LocalFree(pwsz as u8*);
            if (ok) { return 1; }
        }
        thread::sleep_ms(1u64);
        tries = tries + 1;
    }
    return 0;
}

![test]
function builder_default_spawn_join() -> Result<(), TestError> {
    // A default Builder behaves like thread::spawn.
    const h: thread::JoinHandle<i32> =
        thread::Builder::new().spawn<i32, i32>(21, double_it);
    const r: i32 = h.join();
    expect_eq(r, 42)?;
    return Result::Ok(());
}

![test]
function builder_stack_size_spawns() -> Result<(), TestError> {
    // A custom (valid) stack size must not disturb the result.
    const h: thread::JoinHandle<i32> = thread::Builder::new()
        .stack_size(1 << 20)            // 1 MiB
        .spawn<i32, i32>(50, double_it);
    const r: i32 = h.join();
    expect_eq(r, 100)?;
    return Result::Ok(());
}

![test]
function builder_sets_os_thread_name() -> Result<(), TestError> {
    // The worker reads back its own name and confirms the Builder set it.
    const h: thread::JoinHandle<i32> = thread::Builder::new()
        .name(Str::new("worker"))
        .stack_size(1 << 20)
        .spawn<i32, i32>(0, name_is_worker);
    const matched: i32 = h.join();
    expect_eq(matched, 1)?;
    return Result::Ok(());
}

// A sub-minimum (1-byte) stack request: the two OSes contract it differently.
// POSIX rejects it (EINVAL from pthread_attr_setstacksize) and the spawn
// surfaces an Err.  Windows' CreateThread has no such floor; it silently
// rounds dwStackSize up to a usable size, so the spawn succeeds and the thread
// runs correctly.  The guarantee shared by both - and what this regression
// actually guards - is that a tiny stack is handled safely, never a silent
// corruption or a crash.
![target(unix)]
function check_tiny_stack(res: Result<thread::JoinHandle<i32>, thread::SpawnError>)
        -> Result<(), TestError> {
    const is_err: boolean = res.is_err();
    match (res) {
        Result::Ok(h)  => { h.join(); }   // shouldn't happen; join to not leak
        Result::Err(_) => { }
    }
    return expect_true(is_err, Str::new("a sub-minimum stack must be rejected on POSIX"));
}
![target(windows)]
function check_tiny_stack(res: Result<thread::JoinHandle<i32>, thread::SpawnError>)
        -> Result<(), TestError> {
    match (res) {
        // Windows clamps the stack up and runs the body; confirm it ran
        // correctly (double_it(7) == 14) rather than corrupting/crashing.
        Result::Ok(h)  => { return expect_eq(h.join(), 14); }
        Result::Err(_) => { return bail(Str::new("Windows should clamp a tiny stack, not reject it")); }
    }
}

![test]
function builder_try_spawn_rejects_tiny_stack() -> Result<(), TestError> {
    const res: Result<thread::JoinHandle<i32>, thread::SpawnError> =
        thread::Builder::new().stack_size(1u64).try_spawn<i32, i32>(7, double_it);
    return check_tiny_stack(res);
}
