///! f-string interpolation (`f"...{expr}...{expr:?}..."`).
///!
///! The parser desugars an f-string into a chain of `std::fmt::interp`
///! builder calls (`fmt_new` / `fmt_append_lit` / `fmt_append_display` /
///! `fmt_append_debug`) that produce an owned `String`.  These tests pin the
///! end-to-end behaviour: literal text, `{}` (Display) and `{:?}` (Debug)
///! holes, expression holes, `{{`/`}}` escapes, and container/ADT values.

![config(testing)]
namespace CryoTests::Tests::Stdlib::FStringT;

import std::core::result;
import std::core::option;
import std::core::primitives;
import std::collections::str;
import std::collections::string;
import std::collections::array;
import std::test::error;
import std::test::assert;

/// Compare an owned `String` (typically an f-string result) to `want`,
/// dropping it afterwards.
function check(got: String, want: string) -> Result<(), TestError> {
    mut s: String = got;
    const view: Str = s.as_str();
    const w: Str = Str::new(want);
    const eq: boolean = view.equals(&w);
    s.drop();
    return expect(eq, Str::new(want));
}

// ============================================================================
// Literal text and escapes
// ============================================================================

![test]
function fstring_literal_only() -> Result<(), TestError> {
    return check(f"hello world", "hello world");
}

![test]
function fstring_empty() -> Result<(), TestError> {
    return check(f"", "");
}

![test]
function fstring_brace_escape() -> Result<(), TestError> {
    return check(f"{{not a hole}}", "{not a hole}");
}

![test]
function fstring_escape_sequences() -> Result<(), TestError> {
    // Standard string escapes are processed in the literal chunks.
    return check(f"a\tb", "a\tb");
}

// ============================================================================
// Display (`{}`) holes
// ============================================================================

![test]
function fstring_display_int() -> Result<(), TestError> {
    const x: i32 = 42;
    return check(f"x = {x}", "x = 42");
}

![test]
function fstring_display_bool() -> Result<(), TestError> {
    const b: boolean = true;
    return check(f"{b}", "true");
}

![test]
function fstring_display_str() -> Result<(), TestError> {
    const name: Str = Str::new("world");
    return check(f"hi {name}!", "hi world!");
}

![test]
function fstring_display_negative() -> Result<(), TestError> {
    const n: i32 = -7;
    return check(f"n={n}", "n=-7");
}

// ============================================================================
// Debug (`{:?}`) holes
// ============================================================================

![test]
function fstring_debug_int() -> Result<(), TestError> {
    const x: i32 = 7;
    return check(f"{x:?}", "7");
}

![test]
function fstring_debug_option_some() -> Result<(), TestError> {
    const o: Option<i32> = Option::Some(5);
    return check(f"{o:?}", "Some(5)");
}

![test]
function fstring_debug_option_none() -> Result<(), TestError> {
    const o: Option<i32> = Option::None;
    return check(f"{o:?}", "None");
}

![test]
function fstring_debug_result_ok() -> Result<(), TestError> {
    const r: Result<i32, i32> = Result::Ok(99);
    return check(f"{r:?}", "Ok(99)");
}

![test]
function fstring_debug_array() -> Result<(), TestError> {
    mut a: Array<i32> = Array<i32>::new();
    a.push(1);
    a.push(2);
    a.push(3);
    const out: String = f"{a:?}";
    a.drop();
    return check(out, "[1, 2, 3]");
}

// ============================================================================
// Multiple holes, expression holes, mixed
// ============================================================================

![test]
function fstring_multiple_holes() -> Result<(), TestError> {
    const a: i32 = 1;
    const b: i32 = 2;
    return check(f"{a} and {b}", "1 and 2");
}

![test]
function fstring_expression_hole() -> Result<(), TestError> {
    const a: i32 = 10;
    const b: i32 = 32;
    return check(f"sum = {a + b}", "sum = 42");
}

![test]
function fstring_mixed_display_debug() -> Result<(), TestError> {
    const x: i32 = 3;
    const o: Option<i32> = Option::Some(8);
    return check(f"x={x}, o={o:?}", "x=3, o=Some(8)");
}

![test]
function fstring_adjacent_holes() -> Result<(), TestError> {
    const a: i32 = 4;
    const b: i32 = 5;
    return check(f"{a}{b}", "45");
}

// ============================================================================
// Format specs: width / align / fill / zero-pad / radix / precision
// ============================================================================

![test]
function fstring_spec_width_default_left() -> Result<(), TestError> {
    const n: i32 = 42;
    return check(f"[{n:6}]", "[42    ]");
}

![test]
function fstring_spec_align_right_and_center() -> Result<(), TestError> {
    const n: i32 = 42;
    match (check(f"[{n:>6}]", "[    42]")) {
        Result::Ok(_) => { } Result::Err(e) => { return Result::Err(e); }
    }
    return check(f"[{n:^6}]", "[  42  ]");
}

![test]
function fstring_spec_fill_char() -> Result<(), TestError> {
    const n: i32 = 42;
    return check(f"[{n:*>6}]", "[****42]");
}

![test]
function fstring_spec_zero_pad_and_sign() -> Result<(), TestError> {
    const n: i32 = 42;
    const neg: i32 = 0 - 5;
    match (check(f"[{n:06}]", "[000042]")) {
        Result::Ok(_) => { } Result::Err(e) => { return Result::Err(e); }
    }
    // Sign stays leftmost, zeros fill after it.
    return check(f"[{neg:06}]", "[-00005]");
}

![test]
function fstring_spec_hex_oct_bin() -> Result<(), TestError> {
    const v: u32 = 255;
    match (check(f"{v:x}", "ff")) { Result::Ok(_) => { } Result::Err(e) => { return Result::Err(e); } }
    match (check(f"{v:X}", "FF")) { Result::Ok(_) => { } Result::Err(e) => { return Result::Err(e); } }
    match (check(f"{v:o}", "377")) { Result::Ok(_) => { } Result::Err(e) => { return Result::Err(e); } }
    return check(f"{v:b}", "11111111");
}

![test]
function fstring_spec_hex_alternate_and_pad() -> Result<(), TestError> {
    const v: u32 = 255;
    // `#` adds the 0x prefix; zeros fill between prefix and digits.
    match (check(f"{v:#x}", "0xff")) { Result::Ok(_) => { } Result::Err(e) => { return Result::Err(e); } }
    match (check(f"{v:#06x}", "0x00ff")) { Result::Ok(_) => { } Result::Err(e) => { return Result::Err(e); } }
    return check(f"{v:#b}", "0b11111111");
}

![test]
function fstring_spec_hex_negative_twos_complement() -> Result<(), TestError> {
    // Hex of a negative i32 shows its 32-bit two's-complement pattern.
    const neg: i32 = 0 - 5;
    return check(f"{neg:x}", "fffffffb");
}

![test]
function fstring_spec_float_precision() -> Result<(), TestError> {
    const pi: f64 = 3.14159265;
    match (check(f"{pi:.2}", "3.14")) { Result::Ok(_) => { } Result::Err(e) => { return Result::Err(e); } }
    return check(f"[{pi:10.3}]", "[3.142     ]");
}

![test]
function fstring_spec_string_precision_truncates() -> Result<(), TestError> {
    const s: Str = Str::new("hello");
    return check(f"{s:.3}", "hel");
}

![test]
function fstring_spec_ternary_is_not_a_spec() -> Result<(), TestError> {
    // A ternary's ` : b` (spaces) is not a valid spec, so the whole hole
    // stays the expression.
    const x: i32 = 5;
    return check(f"{x > 3 ? 100 : 200}", "100");
}

![test]
function fstring_spec_parenthesised_ternary_with_spec() -> Result<(), TestError> {
    const x: i32 = 5;
    return check(f"[{(x > 3 ? 7 : 9):>4}]", "[   7]");
}

![test]
function fstring_spec_empty_is_display() -> Result<(), TestError> {
    const n: i32 = 42;
    return check(f"[{n:}]", "[42]");
}
