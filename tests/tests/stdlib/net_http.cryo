///! HTTP StatusCode + Method - classification, reason phrases, parsing.

![config(testing)]
namespace CryoTests::Tests::Stdlib::NetHttp;

import std::core::result;
import std::core::option;
import std::collections::str;
import std::net::http::status;
import std::net::http::method;
import std::test::error;
import std::test::assert;

// ============================================================================
// StatusCode
// ============================================================================

![test]
function ok_is_200_and_success() -> Result<(), TestError> {
    const s: StatusCode = StatusCode::ok();
    const want: u16 = 200;
    match (expect_eq(s.as_u16(), want)) { Result::Ok(_) => { } Result::Err(e) => { return Result::Err(e); } }
    return expect(s.is_success(), Str::new("200 is a success status"));
}

![test]
function not_found_is_404_client_error() -> Result<(), TestError> {
    const s: StatusCode = StatusCode::not_found();
    const want: u16 = 404;
    match (expect_eq(s.as_u16(), want)) { Result::Ok(_) => { } Result::Err(e) => { return Result::Err(e); } }
    match (expect(s.is_client_error(), Str::new("404 is a client error"))) { Result::Ok(_) => { } Result::Err(e) => { return Result::Err(e); } }
    return expect_false(s.is_server_error(), Str::new("404 is not a server error"));
}

![test]
function internal_error_is_500_server_error() -> Result<(), TestError> {
    const s: StatusCode = StatusCode::internal_server_error();
    const want: u16 = 500;
    match (expect_eq(s.as_u16(), want)) { Result::Ok(_) => { } Result::Err(e) => { return Result::Err(e); } }
    return expect(s.is_server_error(), Str::new("500 is a server error"));
}

![test]
function from_u16_classifies_by_range() -> Result<(), TestError> {
    match (expect(StatusCode::from_u16(100).is_informational(), Str::new("100 is informational"))) { Result::Ok(_) => { } Result::Err(e) => { return Result::Err(e); } }
    match (expect(StatusCode::from_u16(204).is_success(), Str::new("204 is success"))) { Result::Ok(_) => { } Result::Err(e) => { return Result::Err(e); } }
    match (expect(StatusCode::from_u16(301).is_redirection(), Str::new("301 is redirection"))) { Result::Ok(_) => { } Result::Err(e) => { return Result::Err(e); } }
    return expect(StatusCode::from_u16(403).is_client_error(), Str::new("403 is client error"));
}

![test]
function reason_phrase_known_codes() -> Result<(), TestError> {
    match (expect(StatusCode::ok().reason_phrase().equals(&Str::new("OK")),
                  Str::new("200 -> OK"))) { Result::Ok(_) => { } Result::Err(e) => { return Result::Err(e); } }
    return expect(StatusCode::not_found().reason_phrase().equals(&Str::new("Not Found")),
                  Str::new("404 -> Not Found"));
}

![test]
function reason_phrase_unknown_code() -> Result<(), TestError> {
    return expect(StatusCode::from_u16(799).reason_phrase().equals(&Str::new("Unknown")),
                  Str::new("an unmapped code returns \"Unknown\""));
}

// ============================================================================
// Method
// ============================================================================

![test]
function method_parse_get() -> Result<(), TestError> {
    match (Method::parse(Str::new("GET"))) {
        Option::Some(m) => {
            return expect(m.as_str().equals(&Str::new("GET")), Str::new("parsed GET round-trips"));
        }
        Option::None => { return bail(Str::new("GET should parse")); }
    }
}

![test]
function method_as_str_wire_forms() -> Result<(), TestError> {
    match (expect(Method::Post.as_str().equals(&Str::new("POST")), Str::new("Post -> POST"))) { Result::Ok(_) => { } Result::Err(e) => { return Result::Err(e); } }
    match (expect(Method::Delete.as_str().equals(&Str::new("DELETE")), Str::new("Delete -> DELETE"))) { Result::Ok(_) => { } Result::Err(e) => { return Result::Err(e); } }
    return expect(Method::Patch.as_str().equals(&Str::new("PATCH")), Str::new("Patch -> PATCH"));
}

![test]
function method_parse_rejects_unknown() -> Result<(), TestError> {
    const r: boolean = Method::parse(Str::new("BREW")).is_some();
    return expect_false(r, Str::new("BREW is not a known method"));
}
