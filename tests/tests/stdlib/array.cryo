///! Array<T> — push/pop/get/length/is_empty/clear.

![config(testing)]
namespace CryoTests::Tests::Stdlib::ArrayT;

import std::core::result;
import std::core::option;
import std::collections::array;
import std::test::error;
import std::test::assert;

![test]
function new_array_is_empty() -> Result<(), TestError> {
    mut arr: Array<i32> = Array::new();
    const empty: boolean = arr.is_empty();
    arr.drop();
    match (expect(empty,
        Str::new("new array should be is_empty"))) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

![test]
function push_increases_length() -> Result<(), TestError> {
    mut arr: Array<i32> = Array::new();
    arr.push(1);
    arr.push(2);
    arr.push(3);
    const got_len: u64 = arr.length();
    arr.drop();
    const want_len: u64 = 3;
    match (expect_eq(got_len, want_len)) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

![test]
function get_returns_some_in_range() -> Result<(), TestError> {
    mut arr: Array<i32> = Array::new();
    arr.push(10);
    arr.push(20);
    arr.push(30);
    const opt0: Option<i32> = arr.get(0);
    const opt1: Option<i32> = arr.get(1);
    const opt2: Option<i32> = arr.get(2);
    arr.drop();
    match (expect_eq(opt0.unwrap_or(-1), 10)) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    match (expect_eq(opt1.unwrap_or(-1), 20)) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    match (expect_eq(opt2.unwrap_or(-1), 30)) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

![test]
function get_returns_none_out_of_range() -> Result<(), TestError> {
    mut arr: Array<i32> = Array::new();
    arr.push(1);
    const opt: Option<i32> = arr.get(5);
    const present: boolean = opt.is_some();
    arr.drop();
    match (expect(!present,
        Str::new("get(5) on length-1 should be None"))) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

![test]
function pop_returns_last_and_shrinks() -> Result<(), TestError> {
    mut arr: Array<i32> = Array::new();
    arr.push(1);
    arr.push(2);
    arr.push(3);
    const popped: Option<i32> = arr.pop();
    const after_len: u64 = arr.length();
    arr.drop();
    match (expect_eq(popped.unwrap_or(-1), 3)) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    const want_len: u64 = 2;
    match (expect_eq(after_len, want_len)) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

![test]
function pop_empty_returns_none() -> Result<(), TestError> {
    mut arr: Array<i32> = Array::new();
    const popped: Option<i32> = arr.pop();
    const present: boolean = popped.is_some();
    arr.drop();
    match (expect(!present,
        Str::new("pop on empty should be None"))) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

![test]
function clear_resets_length_keeps_capacity() -> Result<(), TestError> {
    mut arr: Array<i32> = Array::new();
    arr.push(1);
    arr.push(2);
    arr.push(3);
    arr.clear();
    const after_len: u64 = arr.length();
    const after_empty: boolean = arr.is_empty();
    arr.drop();
    const want_len: u64 = 0;
    match (expect_eq(after_len, want_len)) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    match (expect(after_empty,
        Str::new("clear should make is_empty true"))) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}
