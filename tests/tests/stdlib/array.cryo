///! Array<T> - push/pop/get/length/is_empty/clear/iter.

![config(testing)]
namespace CryoTests::Tests::Stdlib::ArrayT;

import std::core::result;
import std::core::option;
import std::core::iter;
import std::core::ops;
import std::core::slice;
import std::core::drop;
import std::collections::array;
import std::collections::string;
import std::alloc::allocator;
import std::test::error;
import std::test::assert;

![test]
function new_array_is_empty() -> Result<(), TestError> {
    mut arr: Array<i32> = Array::new();
    const empty: boolean = arr.is_empty();
    arr.drop();
    match (expect(empty,
        Str::new("new array should be is_empty"))) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

![test]
function push_increases_length() -> Result<(), TestError> {
    mut arr: Array<i32> = Array::new();
    arr.push(1);
    arr.push(2);
    arr.push(3);
    const got_len: u64 = arr.length();
    arr.drop();
    const want_len: u64 = 3;
    match (expect_eq(got_len, want_len)) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

![test]
function get_returns_some_in_range() -> Result<(), TestError> {
    mut arr: Array<i32> = Array::new();
    arr.push(10);
    arr.push(20);
    arr.push(30);
    const opt0: Option<i32> = arr.get(0);
    const opt1: Option<i32> = arr.get(1);
    const opt2: Option<i32> = arr.get(2);
    arr.drop();
    match (expect_eq(opt0.unwrap_or(-1), 10)) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    match (expect_eq(opt1.unwrap_or(-1), 20)) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    match (expect_eq(opt2.unwrap_or(-1), 30)) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

![test]
function get_returns_none_out_of_range() -> Result<(), TestError> {
    mut arr: Array<i32> = Array::new();
    arr.push(1);
    const opt: Option<i32> = arr.get(5);
    const present: boolean = opt.is_some();
    arr.drop();
    match (expect(!present,
        Str::new("get(5) on length-1 should be None"))) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

![test]
function pop_returns_last_and_shrinks() -> Result<(), TestError> {
    mut arr: Array<i32> = Array::new();
    arr.push(1);
    arr.push(2);
    arr.push(3);
    const popped: Option<i32> = arr.pop();
    const after_len: u64 = arr.length();
    arr.drop();
    match (expect_eq(popped.unwrap_or(-1), 3)) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    const want_len: u64 = 2;
    match (expect_eq(after_len, want_len)) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

![test]
function pop_empty_returns_none() -> Result<(), TestError> {
    mut arr: Array<i32> = Array::new();
    const popped: Option<i32> = arr.pop();
    const present: boolean = popped.is_some();
    arr.drop();
    match (expect(!present,
        Str::new("pop on empty should be None"))) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

![test]
function clear_resets_length_keeps_capacity() -> Result<(), TestError> {
    mut arr: Array<i32> = Array::new();
    arr.push(1);
    arr.push(2);
    arr.push(3);
    arr.clear();
    const after_len: u64 = arr.length();
    const after_empty: boolean = arr.is_empty();
    arr.drop();
    const want_len: u64 = 0;
    match (expect_eq(after_len, want_len)) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    match (expect(after_empty,
        Str::new("clear should make is_empty true"))) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

// ============================================================================
// iter() - forward iteration via the Iterator trait
// ============================================================================

![test]
function iter_empty_yields_none() -> Result<(), TestError> {
    mut arr: Array<i32> = Array::new();
    mut it: implement Iterator<i32> = arr.iter();
    const first: Option<i32> = it.next();
    arr.drop();
    return expect_none(&first,
        Str::new("iter() on empty Array should be None on the first next()"));
}

![test]
function iter_yields_each_element_in_order() -> Result<(), TestError> {
    mut arr: Array<i32> = Array::new();
    arr.push(10);
    arr.push(20);
    arr.push(30);
    mut it: implement Iterator<i32> = arr.iter();
    mut sum: i32 = 0;
    mut count: i32 = 0;
    loop {
        match (it.next()) {
            Option::Some(v) => { sum = sum + v; count = count + 1; }
            Option::None    => { break; }
        }
    }
    arr.drop();
    match (expect_eq(sum, 60)) {
        Result::Ok(_) => { } Result::Err(e) => { return Result::Err(e); }
    }
    return expect_eq(count, 3);
}

![test]
function iter_count_reports_length_in_O1() -> Result<(), TestError> {
    // SliceIter overrides count() - verify the override returns the
    // expected length without consuming via next() first.
    mut arr: Array<u32> = Array::new();
    arr.push(1);
    arr.push(2);
    arr.push(3);
    arr.push(4);
    mut it: implement Iterator<u32> = arr.iter();
    const got: u64 = it.count();
    arr.drop();
    const want: u64 = 4;
    return expect_eq(got, want);
}


// ============================================================================
// clear() drops owned elements - pin the H1 fix.  `clear` used to just
// set length=0, leaking every element's resources for owning `T`.  It now
// drops the `[0, length)` prefix (like `drop`), keeping capacity.  A
// counting-drop Probe makes the element drops observable.
// ============================================================================

mut g_arr_drops: i32 = 0;

type struct DropProbe {
    tag: i32;
    static new(tag: i32) -> DropProbe { return DropProbe { tag: tag }; }
}

implement trait Drop for struct DropProbe {
    drop(mut &this) -> void { g_arr_drops = g_arr_drops + 1; }
}

![test]
function clear_drops_each_owned_element() -> Result<(), TestError> {
    g_arr_drops = 0;
    mut arr: Array<DropProbe> = Array::new();
    arr.push(DropProbe::new(1));
    arr.push(DropProbe::new(2));
    arr.push(DropProbe::new(3));
    arr.clear();                       // must drop all 3 elements
    const after_clear: i32 = g_arr_drops;
    const after_len: u64 = arr.length();
    // Capacity is retained, so the array stays usable after clear.
    arr.push(DropProbe::new(4));
    arr.drop();                        // drops the 1 remaining element
    const after_drop: i32 = g_arr_drops;

    match (expect_eq(after_clear, 3)) {   // clear dropped exactly 3
        Result::Ok(_) => { } Result::Err(e) => { return Result::Err(e); }
    }
    match (expect_eq(after_len, 0)) {     // length reset
        Result::Ok(_) => { } Result::Err(e) => { return Result::Err(e); }
    }
    // 3 from clear + 1 from drop; no double-drop of the cleared elements.
    return expect_eq(after_drop, 4);
}

![test]
function get_ptr_reads_in_place_and_none_oob() -> Result<(), TestError> {
    // `get_ref` borrows the element rather than copying it. Reading
    // through the returned pointer must observe the stored value, and
    // an out-of-range index must yield None.
    mut arr: Array<i32> = Array::new();
    arr.push(100);
    arr.push(200);
    mut val: i32 = -1;
    match (arr.get_ref(1)) {
        Option::Some(p) => { val = *p; }
        Option::None    => { }
    }
    mut oob_present: boolean = true;
    match (arr.get_ref(5)) {
        Option::Some(_) => { oob_present = true; }
        Option::None    => { oob_present = false; }
    }
    arr.drop();
    match (expect_eq(val, 200)) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return expect(!oob_present,
        Str::new("get_ref(5) on length-2 should be None"));
}

![test]
function get_ptr_borrows_owning_elements_no_double_free() -> Result<(), TestError> {
    // The headline soundness case: `get` is gated on `T: Copy`, so
    // owning elements are read through `get_ref`, which borrows in
    // place. The array retains ownership, so `arr.drop()` frees each
    // String exactly once. If the borrow ever copied, dropping the
    // copy here plus the array's element drop would double-free and
    // the test process would abort.
    mut arr: Array<String> = Array::new();
    arr.push(String::from_str(Str::new("alpha")));
    arr.push(String::from_str(Str::new("beta")));
    mut ok: boolean = false;
    match (arr.get_ref(1)) {
        Option::Some(p) => {
            const s: Str = p.as_str();
            const want: Str = Str::new("beta");
            ok = s.equals(&want);
        }
        Option::None => { }
    }
    arr.drop();
    return expect(ok,
        Str::new("get_ref should borrow 'beta' from the array in place"));
}

// Sort ------------------------------------------------------------------------

function arr_eq_i32_seq(arr: &Array<i32>, expected: &Array<i32>) -> boolean {
    if (arr.length() != expected.length()) { return false; }
    mut i: u64 = 0;
    while (i < arr.length()) {
        match (arr.get(i)) {
            Option::Some(av) => {
                match (expected.get(i)) {
                    Option::Some(ev) => { if (av != ev) { return false; } }
                    Option::None     => { return false; }
                }
            }
            Option::None => { return false; }
        }
        i = i + 1;
    }
    return true;
}

![test]
function sort_empty_array_is_noop() -> Result<(), TestError> {
    mut a: Array<i32> = Array<i32>::new();
    a.sort();
    const ok: boolean = a.length() == 0;
    a.drop();
    return expect(ok, Str::new("sort on empty array must not crash or grow it"));
}

![test]
function sort_single_element_is_noop() -> Result<(), TestError> {
    mut a: Array<i32> = Array<i32>::new();
    a.push(42);
    a.sort();
    mut ok: boolean = a.length() == 1;
    match (a.get(0)) {
        Option::Some(v) => { if (v != 42) { ok = false; } }
        Option::None    => { ok = false; }
    }
    a.drop();
    return expect(ok, Str::new("sort on single-element array preserves it"));
}

![test]
function sort_already_sorted_unchanged() -> Result<(), TestError> {
    mut a: Array<i32> = Array<i32>::new();
    mut i: i32 = 0;
    while (i < 32) { a.push(i); i = i + 1; }
    a.sort();
    mut want: Array<i32> = Array<i32>::new();
    mut j: i32 = 0;
    while (j < 32) { want.push(j); j = j + 1; }
    const ok: boolean = arr_eq_i32_seq(&a, &want);
    a.drop();
    want.drop();
    return expect(ok, Str::new("already-sorted input must round-trip identical"));
}

![test]
function sort_reverse_sorted_ascends() -> Result<(), TestError> {
    mut a: Array<i32> = Array<i32>::new();
    mut i: i32 = 31;
    while (i >= 0) { a.push(i); i = i - 1; }
    a.sort();
    mut want: Array<i32> = Array<i32>::new();
    mut j: i32 = 0;
    while (j < 32) { want.push(j); j = j + 1; }
    const ok: boolean = arr_eq_i32_seq(&a, &want);
    a.drop();
    want.drop();
    return expect(ok, Str::new("reverse-sorted input must end up ascending 0..32"));
}

![test]
function sort_random_small_below_cutoff() -> Result<(), TestError> {
    // Below SORT_INSERTION_CUTOFF (16): exercises the insertion-sort path.
    mut a: Array<i32> = Array<i32>::new();
    a.push(7);  a.push(2);  a.push(9);  a.push(1);
    a.push(5);  a.push(3);  a.push(8);  a.push(4);
    a.push(6);  a.push(0);  // 10 elements
    a.sort();
    mut want: Array<i32> = Array<i32>::new();
    mut j: i32 = 0;
    while (j < 10) { want.push(j); j = j + 1; }
    const ok: boolean = arr_eq_i32_seq(&a, &want);
    a.drop();
    want.drop();
    return expect(ok, Str::new("small-input insertion-sort path must sort correctly"));
}

![test]
function sort_random_above_cutoff() -> Result<(), TestError> {
    // Above SORT_INSERTION_CUTOFF: exercises the quicksort path.
    // 64 elements; deterministic shuffle (i * 37 % 64) so the
    // test is reproducible.
    mut a: Array<i32> = Array<i32>::new();
    mut i: i32 = 0;
    while (i < 64) {
        const k: i32 = (i * 37) % 64;
        a.push(k);
        i = i + 1;
    }
    a.sort();
    // Verify the sequence is non-decreasing.
    mut ok: boolean = true;
    mut prev: i32 = -2147483648;
    mut j: u64 = 0;
    while (j < a.length()) {
        match (a.get(j)) {
            Option::Some(v) => {
                if (v < prev) { ok = false; }
                prev = v;
            }
            Option::None => { ok = false; }
        }
        j = j + 1;
    }
    a.drop();
    return expect(ok, Str::new("quicksort path must produce a non-decreasing sequence"));
}

![test]
function sort_with_duplicates() -> Result<(), TestError> {
    mut a: Array<i32> = Array<i32>::new();
    a.push(3); a.push(1); a.push(3); a.push(2);
    a.push(1); a.push(3); a.push(2); a.push(1);
    a.sort();
    // Expected: [1,1,1,2,2,3,3,3]
    mut want: Array<i32> = Array<i32>::new();
    want.push(1); want.push(1); want.push(1);
    want.push(2); want.push(2);
    want.push(3); want.push(3); want.push(3);
    const ok: boolean = arr_eq_i32_seq(&a, &want);
    a.drop();
    want.drop();
    return expect(ok, Str::new("sort with duplicates must group equal elements"));
}

// sort_by ---------------------------------------------------------------------

function desc_i32(a: &i32, b: &i32) -> boolean {
    // "less than" for descending sort: a comes before b if a > b.
    return *a > *b;
}

![test]
function sort_by_descending_predicate() -> Result<(), TestError> {
    mut a: Array<i32> = Array<i32>::new();
    a.push(2); a.push(5); a.push(1); a.push(4); a.push(3);
    a.sort_by(desc_i32);
    mut want: Array<i32> = Array<i32>::new();
    want.push(5); want.push(4); want.push(3); want.push(2); want.push(1);
    const ok: boolean = arr_eq_i32_seq(&a, &want);
    a.drop();
    want.drop();
    return expect(ok, Str::new("sort_by with desc predicate must sort descending"));
}

// Growth overflow -------------------------------------------------------------

![test]
function reserve_near_u64_max_fails_cleanly() -> Result<(), TestError> {
    // Regression: reserve_grow's capacity-doubling loop must cap at u64::MAX
    // instead of wrapping to a tiny value (infinite loop / undersized alloc).
    // For a 1-byte element there is no `cap * elem_size` overflow, so the
    // request reaches the allocator and fails gracefully with an AllocError
    // rather than hanging or corrupting memory.
    mut a: Array<u8> = Array<u8>::new();
    a.push(1 as u8);
    a.push(2 as u8);
    const r: Result<(), AllocError> = a.reserve(18446744073709551000);
    expect_true(r.is_err(),
        Str::new("reserve(~u64::MAX) must return Err, not loop forever"))?;
    // The failed reservation must leave the array untouched.
    expect_eq(a.length(), 2 as u64)?;
    a.drop();
    return Result::Ok(());
}

![test]
function try_with_capacity_layout_overflow_returns_err() -> Result<(), TestError> {
    // m4 regression: a `try_*` constructor must never panic. With an 8-byte
    // element a capacity near u64::MAX makes `capacity * sizeof(T)` overflow
    // inside the layout computation; the try_ path must catch that via
    // Layout::try_array and return Err, not abort the process.
    const huge: u64 = 18446744073709551615;   // u64::MAX; * sizeof(u64)=8 overflows
    const r: Result<Array<u64, GlobalAlloc>, AllocError> =
        Array::try_with_capacity_in(huge, GlobalAlloc::new());
    expect_true(r.is_err(),
        Str::new("try_with_capacity_in with overflowing byte size must Err, not panic"))?;
    return Result::Ok(());
}

![test]
function reserve_exact_wrapping_additional_fails() -> Result<(), TestError> {
    // Regression: `length + additional` must not silently wrap. With a
    // non-empty array, an `additional` of u64::MAX makes the sum wrap to a
    // small value (< length); without the guard reserve_exact would see
    // `required <= capacity`, return Ok WITHOUT growing, and a later
    // try_append would memcpy `additional` elements past the buffer.
    // The guard must reject the wrapped request as an AllocError. reserve_grow
    // shares the same guard.
    mut a: Array<u8> = Array<u8>::new();
    a.push(1 as u8);
    a.push(2 as u8);                                   // length 2, capacity >= 2
    const re: Result<(), AllocError> = a.reserve_exact(18446744073709551615); // u64::MAX
    expect_true(re.is_err(),
        Str::new("reserve_exact with wrapping additional must return Err"))?;
    const rg: Result<(), AllocError> = a.reserve_grow(18446744073709551615);
    expect_true(rg.is_err(),
        Str::new("reserve_grow with wrapping additional must return Err"))?;
    expect_eq(a.length(), 2 as u64)?;                  // array untouched
    a.drop();
    return Result::Ok(());
}


// ============================================================================
// from_iter - collect an iterator into a fresh Array<T>
// ============================================================================

function fi_double(x: i32) -> i32 { return x * 2; }
function fi_is_even(x: i32) -> boolean { return x % 2 == 0; }

![test]
function from_iter_collects_range_in_order() -> Result<(), TestError> {
    // 0..5 -> [0,1,2,3,4]; verify length and each element in order.
    mut r: Range<i32> = Range::new(0, 5);
    mut a: Array<i32> = from_iter(r);
    expect_eq(a.length(), 5 as u64)?;
    mut expected: i32 = 0;
    for (mut i: u64 = 0; i < a.length(); i++) {
        match (a.get(i)) {
            Option::Some(v) => {
                match (expect_eq(v, expected)) {
                    Result::Ok(_) => { } Result::Err(e) => { a.drop(); return Result::Err(e); }
                }
            }
            Option::None => { a.drop(); return bail(Str::new("missing element")); }
        }
        expected = expected + 1;
    }
    a.drop();
    return Result::Ok(());
}

![test]
function from_iter_empty_iterator_yields_empty_array() -> Result<(), TestError> {
    mut r: Range<i32> = Range::new(5, 5);
    mut a: Array<i32> = from_iter(r);
    const len: u64 = a.length();
    a.drop();
    return expect_eq(len, 0 as u64);
}

![test]
function from_iter_collects_mapped_iterator() -> Result<(), TestError> {
    // 0..4 doubled -> [0,2,4,6]; sum = 12.
    mut r: Range<i32> = Range::new(0, 4);
    mut a: Array<i32> = from_iter(r.map(fi_double));
    mut sum: i32 = 0;
    for (mut i: u64 = 0; i < a.length(); i++) {
        match (a.get(i)) { Option::Some(v) => { sum = sum + v; } Option::None => {} }
    }
    a.drop();
    return expect_eq(sum, 12);
}

![test]
function from_iter_collects_filtered_iterator() -> Result<(), TestError> {
    // 0..6 keep evens -> [0,2,4]; length 3.
    mut r: Range<i32> = Range::new(0, 6);
    mut a: Array<i32> = from_iter(r.filter(fi_is_even));
    const len: u64 = a.length();
    a.drop();
    return expect_eq(len, 3 as u64);
}
