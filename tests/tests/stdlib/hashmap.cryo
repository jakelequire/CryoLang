///! HashMap<K, V> — insert/get/contains_key/remove/length/iter.

![config(testing)]
namespace CryoTests::Tests::Stdlib::HashMapT;

import std::core::result;
import std::core::option;
import std::core::iter;
import std::collections::hashmap;
import std::collections::str;
import std::collections::pair;
import std::test::error;
import std::test::assert;

![test]
function new_map_is_empty() -> Result<(), TestError> {
    mut map: HashMap<u32, i32> = HashMap::new();
    const empty: boolean = map.is_empty();
    const len: u64 = map.length();
    map.drop();
    match (expect(empty, Str::new("new map is_empty"))) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    const want: u64 = 0;
    match (expect_eq(len, want)) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

![test]
function insert_increases_length() -> Result<(), TestError> {
    mut map: HashMap<u32, i32> = HashMap::new();
    const k1: u32 = 1;
    const k2: u32 = 2;
    const k3: u32 = 3;
    map.insert(k1, 100);
    map.insert(k2, 200);
    map.insert(k3, 300);
    const len: u64 = map.length();
    map.drop();
    const want: u64 = 3;
    match (expect_eq(len, want)) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

![test]
function get_returns_inserted_value() -> Result<(), TestError> {
    mut map: HashMap<u32, i32> = HashMap::new();
    const key: u32 = 42;
    map.insert(key, 1234);
    const got: Option<i32> = map.get(&key);
    map.drop();
    match (expect_eq(got.unwrap_or(-1), 1234)) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

![test]
function get_missing_key_is_none() -> Result<(), TestError> {
    mut map: HashMap<u32, i32> = HashMap::new();
    const present_key: u32 = 1;
    map.insert(present_key, 99);
    const missing_key: u32 = 999;
    const got: Option<i32> = map.get(&missing_key);
    const present: boolean = got.is_some();
    map.drop();
    match (expect(!present,
        Str::new("get of missing key should be None"))) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

![test]
function contains_key_true_after_insert() -> Result<(), TestError> {
    mut map: HashMap<u32, i32> = HashMap::new();
    const k: u32 = 7;
    map.insert(k, 0);
    const present: boolean = map.contains_key(&k);
    map.drop();
    match (expect(present,
        Str::new("contains_key should be true after insert"))) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

![test]
function insert_replaces_existing() -> Result<(), TestError> {
    mut map: HashMap<u32, i32> = HashMap::new();
    const k: u32 = 5;
    map.insert(k, 10);
    const previous: Option<i32> = map.insert(k, 20);
    const new_value: Option<i32> = map.get(&k);
    map.drop();
    match (expect_eq(previous.unwrap_or(-1), 10)) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    match (expect_eq(new_value.unwrap_or(-1), 20)) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

![test]
function remove_pulls_value_and_shrinks() -> Result<(), TestError> {
    mut map: HashMap<u32, i32> = HashMap::new();
    const k1: u32 = 1;
    const k2: u32 = 2;
    map.insert(k1, 100);
    map.insert(k2, 200);
    const removed: Option<i32> = map.remove(&k1);
    const len: u64 = map.length();
    const present: boolean = map.contains_key(&k1);
    map.drop();
    match (expect_eq(removed.unwrap_or(-1), 100)) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    const want_len: u64 = 1;
    match (expect_eq(len, want_len)) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    match (expect(!present,
        Str::new("contains_key should be false after remove"))) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

![test]
function remove_missing_returns_none() -> Result<(), TestError> {
    mut map: HashMap<u32, i32> = HashMap::new();
    const missing: u32 = 999;
    const removed: Option<i32> = map.remove(&missing);
    const present: boolean = removed.is_some();
    map.drop();
    match (expect(!present,
        Str::new("remove of missing key should be None"))) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

// ============================================================================
// String keys — the historical breakage that drove the Pair migration
//
// Once upon a time, `utils::Map<string, V>` was indexed by raw pointer
// equality, which silently misbehaved when two value-equal string
// literals lived in different ROData slots.  `HashMap` routes through
// `Hash + Eq for string` instead, so value-equal keys with different
// pointers find each other.  These tests pin that contract.
// ============================================================================

![test]
function string_keys_lookup_by_value() -> Result<(), TestError> {
    mut m: HashMap<string, i32> = HashMap::new();
    const probe_key: string = "alpha";
    m.insert(probe_key, 42);

    // A separate "alpha" literal — different RIP-relative address in
    // the binary, same bytes.  If the hash/eq path used pointers, this
    // get() would return None.
    const same_value_distinct_token: string = "alpha";
    const got: Option<i32> = m.get(&same_value_distinct_token);
    m.drop();
    return expect_eq(got.unwrap_or(-1), 42);
}

![test]
function string_keys_distinct_values_stay_distinct() -> Result<(), TestError> {
    mut m: HashMap<string, i32> = HashMap::new();
    m.insert("name", 1);
    m.insert("count", 2);
    m.insert("flag", 3);

    const k_name: string = "name";
    const k_count: string = "count";
    const k_missing: string = "nothere";

    const v_name: i32 = m.get(&k_name).unwrap_or(-1);
    const v_count: i32 = m.get(&k_count).unwrap_or(-1);
    const missing: Option<i32> = m.get(&k_missing);
    const has_missing: boolean = missing.is_some();
    m.drop();

    match (expect_eq(v_name, 1)) {
        Result::Ok(_) => { } Result::Err(e) => { return Result::Err(e); }
    }
    match (expect_eq(v_count, 2)) {
        Result::Ok(_) => { } Result::Err(e) => { return Result::Err(e); }
    }
    return expect_false(has_missing,
        Str::new("a key not inserted should not be findable"));
}

![test]
function string_keys_insert_replaces_existing() -> Result<(), TestError> {
    mut m: HashMap<string, i32> = HashMap::new();
    m.insert("counter", 10);
    const prev: Option<i32> = m.insert("counter", 20);
    const k: string = "counter";
    const new_val: Option<i32> = m.get(&k);
    m.drop();

    match (expect_eq(prev.unwrap_or(-1), 10)) {
        Result::Ok(_) => { } Result::Err(e) => { return Result::Err(e); }
    }
    return expect_eq(new_val.unwrap_or(-1), 20);
}

// ============================================================================
// Remove correctness — cross-key and chain scenarios
//
// These tests pin the "cursor-remove" contract: after removing one key from
// a map, every OTHER previously-inserted key must still be accessible.
// The old `previous.next = node.next` remove implementation could silently
// break the bucket chain when two keys shared a bucket (same bucket index),
// making the surviving sibling unreachable.  The cursor rewrite fixes this.
// ============================================================================

![test]
function remove_sibling_still_accessible() -> Result<(), TestError> {
    // Insert two keys.  Depending on the FNV hash, they may land in the same
    // bucket.  Either way, after removing k1, k2 must still be findable via
    // get() — not just "length is 1".
    mut map: HashMap<u32, i32> = HashMap::new();
    const k1: u32 = 1;
    const k2: u32 = 2;
    map.insert(k1, 100);
    map.insert(k2, 200);
    map.remove(&k1);
    const got: Option<i32> = map.get(&k2);
    map.drop();
    return expect_eq(got.unwrap_or(-1), 200);
}

![test]
function remove_does_not_corrupt_other_key_in_chain() -> Result<(), TestError> {
    // Use 8 keys so birthday-paradox guarantees bucket collisions with the
    // 8-bucket initial table.  Remove every other key and verify the rest
    // are still reachable.
    mut map: HashMap<u32, i32> = HashMap::new();

    // Insert keys 1..8
    const a1: u32 = 1;  map.insert(a1, 1);
    const a2: u32 = 2;  map.insert(a2, 2);
    const a3: u32 = 3;  map.insert(a3, 3);
    const a4: u32 = 4;  map.insert(a4, 4);
    const a5: u32 = 5;  map.insert(a5, 5);
    const a6: u32 = 6;  map.insert(a6, 6);
    const a7: u32 = 7;  map.insert(a7, 7);
    const a8: u32 = 8;  map.insert(a8, 8);

    // Remove the even-indexed keys
    map.remove(&a2);
    map.remove(&a4);
    map.remove(&a6);
    map.remove(&a8);

    // All odd keys must still be accessible
    const g1: i32 = map.get(&a1).unwrap_or(-1);
    const g3: i32 = map.get(&a3).unwrap_or(-1);
    const g5: i32 = map.get(&a5).unwrap_or(-1);
    const g7: i32 = map.get(&a7).unwrap_or(-1);
    const len: u64 = map.length();
    map.drop();

    match (expect_eq(g1, 1)) {
        Result::Ok(_) => { } Result::Err(e) => { return Result::Err(e); }
    }
    match (expect_eq(g3, 3)) {
        Result::Ok(_) => { } Result::Err(e) => { return Result::Err(e); }
    }
    match (expect_eq(g5, 5)) {
        Result::Ok(_) => { } Result::Err(e) => { return Result::Err(e); }
    }
    match (expect_eq(g7, 7)) {
        Result::Ok(_) => { } Result::Err(e) => { return Result::Err(e); }
    }
    const want_len: u64 = 4;
    return expect_eq(len, want_len);
}

![test]
function remove_head_then_lookup_tail_in_same_chain() -> Result<(), TestError> {
    // If two keys collide into the same bucket, the second-inserted key
    // becomes the chain HEAD (prepend-on-insert).  Remove the HEAD and
    // verify the tail (first-inserted) is still findable.
    //
    // We can't force a collision without knowing the hash in advance, so we
    // insert 8 different keys and check every one of them after the removes.
    // If any pair ended up in a chain, this exercises both "remove head" and
    // "sibling lookup" code paths.
    mut map: HashMap<u32, i32> = HashMap::new();
    const k1: u32 = 10;  map.insert(k1, 10);
    const k2: u32 = 20;  map.insert(k2, 20);
    const k3: u32 = 30;  map.insert(k3, 30);
    const k4: u32 = 40;  map.insert(k4, 40);
    const k5: u32 = 50;  map.insert(k5, 50);
    const k6: u32 = 60;  map.insert(k6, 60);
    const k7: u32 = 70;  map.insert(k7, 70);
    const k8: u32 = 80;  map.insert(k8, 80);

    // Remove the latest-inserted set (chain heads if collisions exist)
    map.remove(&k5);
    map.remove(&k6);
    map.remove(&k7);
    map.remove(&k8);

    const g1: i32 = map.get(&k1).unwrap_or(-1);
    const g2: i32 = map.get(&k2).unwrap_or(-1);
    const g3: i32 = map.get(&k3).unwrap_or(-1);
    const g4: i32 = map.get(&k4).unwrap_or(-1);
    map.drop();

    match (expect_eq(g1, 10)) {
        Result::Ok(_) => { } Result::Err(e) => { return Result::Err(e); }
    }
    match (expect_eq(g2, 20)) {
        Result::Ok(_) => { } Result::Err(e) => { return Result::Err(e); }
    }
    match (expect_eq(g3, 30)) {
        Result::Ok(_) => { } Result::Err(e) => { return Result::Err(e); }
    }
    return expect_eq(g4, 40);
}

![test]
function remove_all_then_reinsert() -> Result<(), TestError> {
    // After removing every entry from a map it must be in a consistent
    // empty state; subsequent inserts and lookups must work normally.
    mut map: HashMap<u32, i32> = HashMap::new();
    const k1: u32 = 1;  map.insert(k1, 11);
    const k2: u32 = 2;  map.insert(k2, 22);
    const k3: u32 = 3;  map.insert(k3, 33);

    map.remove(&k1);
    map.remove(&k2);
    map.remove(&k3);

    const empty: boolean = map.is_empty();

    // Re-insert with different values
    map.insert(k1, 111);
    map.insert(k2, 222);

    const g1: i32 = map.get(&k1).unwrap_or(-1);
    const g2: i32 = map.get(&k2).unwrap_or(-1);
    const g3: Option<i32> = map.get(&k3);  // k3 was not re-inserted
    const has_k3: boolean = g3.is_some();
    const len: u64 = map.length();
    map.drop();

    match (expect(empty, Str::new("map should be empty after removing all entries"))) {
        Result::Ok(_) => { } Result::Err(e) => { return Result::Err(e); }
    }
    match (expect_eq(g1, 111)) {
        Result::Ok(_) => { } Result::Err(e) => { return Result::Err(e); }
    }
    match (expect_eq(g2, 222)) {
        Result::Ok(_) => { } Result::Err(e) => { return Result::Err(e); }
    }
    match (expect_false(has_k3, Str::new("k3 should not be in map"))) {
        Result::Ok(_) => { } Result::Err(e) => { return Result::Err(e); }
    }
    const want_len: u64 = 2;
    return expect_eq(len, want_len);
}

// ============================================================================
// iter() — bucket-major traversal yields every entry exactly once
// ============================================================================

![test]
function iter_empty_map_yields_none() -> Result<(), TestError> {
    // Empty (never-allocated) map: bucket_count == 0, buckets == null.
    // The iterator must handle that without dereferencing.
    mut map: HashMap<u32, i32> = HashMap::new();
    mut it: HashMapIter<u32, i32> = map.iter();
    const first: Option<Pair<u32, i32>> = it.next();
    map.drop();
    return expect_none(&first,
        Str::new("iter on empty HashMap should be None on the first next()"));
}

![test]
function iter_visits_every_entry_exactly_once() -> Result<(), TestError> {
    // Insert N entries, iterate, expect to see N entries with the
    // correct value-for-key correspondence. Order is undefined, so
    // accumulate via key-sum and value-sum and pin those.
    mut map: HashMap<u32, i32> = HashMap::new();
    map.insert(1, 10);
    map.insert(2, 20);
    map.insert(3, 30);
    map.insert(4, 40);

    mut it: HashMapIter<u32, i32> = map.iter();
    mut visited: u64 = 0;
    mut key_sum: u32 = 0;
    mut value_sum: i32 = 0;
    loop {
        match (it.next()) {
            Option::Some(p) => {
                visited = visited + 1;
                key_sum = key_sum + p.first;
                value_sum = value_sum + p.second;
            }
            Option::None => { break; }
        }
    }
    map.drop();

    const want_visited: u64 = 4;
    match (expect_eq(visited, want_visited)) {
        Result::Ok(_) => { } Result::Err(e) => { return Result::Err(e); }
    }
    // 1+2+3+4 == 10
    const want_keys: u32 = 10;
    match (expect_eq(key_sum, want_keys)) {
        Result::Ok(_) => { } Result::Err(e) => { return Result::Err(e); }
    }
    // 10+20+30+40 == 100
    return expect_eq(value_sum, 100);
}

![test]
function iter_count_default_walks_to_exhaustion() -> Result<(), TestError> {
    // HashMapIter does not override count — verify the trait default
    // walks next() until None and returns the right length.
    mut map: HashMap<u32, i32> = HashMap::new();
    map.insert(1, 100);
    map.insert(2, 200);
    map.insert(3, 300);

    mut it: HashMapIter<u32, i32> = map.iter();
    const got: u64 = it.count();
    map.drop();
    const want: u64 = 3;
    return expect_eq(got, want);
}

![test]
function iter_spans_multiple_buckets_after_resize() -> Result<(), TestError> {
    // Force a resize by inserting past the initial 8-bucket threshold
    // (HashMap doubles when length >= bucket_count). The iterator
    // must still visit every entry — i.e., bucket-advance logic works
    // across bucket_count > 1.
    mut map: HashMap<u32, i32> = HashMap::new();
    mut i: u32 = 0;
    while (i < 20) {
        map.insert(i, (i as i32) * 2);
        i = i + 1;
    }

    mut it: HashMapIter<u32, i32> = map.iter();
    mut visited: u64 = 0;
    mut value_sum: i64 = 0;
    loop {
        match (it.next()) {
            Option::Some(p) => {
                visited = visited + 1;
                value_sum = value_sum + (p.second as i64);
            }
            Option::None => { break; }
        }
    }
    map.drop();

    const want_visited: u64 = 20;
    match (expect_eq(visited, want_visited)) {
        Result::Ok(_) => { } Result::Err(e) => { return Result::Err(e); }
    }
    // 2 * (0 + 1 + ... + 19) == 2 * 190 == 380
    const want_sum: i64 = 380;
    return expect_eq(value_sum, want_sum);
}
