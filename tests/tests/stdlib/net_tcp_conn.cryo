///! `BufConn<TcpStream>` — the buffered `AsyncRead` + `AsyncWrite` over a real
///! loopback socket, driven by a real `Executor` (worker pool + reactor).
///!
///! The in-memory trait tests (`io_async_traits`) prove the DEFAULT BODIES
///! against a scripted source. These prove the other half: that the concrete
///! transport honours the contract those bodies rely on. Specifically that a
///! `fill` only ever APPENDS to what `buffered()` reports even though the
///! connection compacts its storage underneath, and that the socket is back in
///! the connection — not still owned by a completed future — after every
///! operation.
///!
///! Every test binds an EPHEMERAL port (`:0`) and reads the kernel-assigned port
///! back, so concurrent runs never collide.
///!
///! The request/response shape is chosen on purpose: a CRLF-framed header line
///! followed by a fixed-length body, read through ONE buffer. That is exactly
///! what the blocking `http::request::read_line` could not do without losing
///! the bytes it had already buffered past the header — the limitation its own
///! doc comment records — so it is the behaviour the port depends on.

![config(testing)]
namespace CryoTests::Tests::Stdlib::NetTcpConn;

import std::core::option;
import std::core::result;
import std::core::drop;
import std::core::slice;
import std::collections::str;
import std::collections::string;
import std::collections::array;
import std::future;
import std::io::error;
import std::io::traits;
import std::net::addr::socket_addr;
import std::net::socket::tcp;
import std::io::buf;
import std::test::error;
import std::test::assert;

// Every failure is a distinct negative number so a red test names its own step.

function ntc_bytes_eq(a: &Array<u8>, text: string) -> boolean {
    const b: Slice<u8> = Str::new(text).as_bytes();
    if (a.length() != b.length()) { return false; }
    mut i: u64 = 0;
    while (i < a.length()) {
        mut x: u8 = 0;
        mut y: u8 = 1;
        match (a.get(i)) { Option::Some(v) => { x = v; } Option::None => { } }
        match (b.get(i)) { Option::Some(v) => { y = v; } Option::None => { } }
        if (x != y) { return false; }
        i = i + 1;
    }
    return true;
}

/// Accept one connection, read a `NAME len\r\n` header line plus exactly `len`
/// body bytes, and answer with the same framing. Both reads come out of the one
/// connection buffer.
async function ntc_serve(listener: TcpListener) -> i64 {
    mut acc: TcpAccepted = await TcpAccept::start(listener);
    mut lst: TcpListener = acc.take_listener();
    lst.drop();

    mut stream: TcpStream = TcpStream::from_fd(-1);
    match (acc.take_result()) {
        Result::Ok(s)  => { stream = s; }
        Result::Err(_) => { return -1; }
    }
    mut c: BufConn<TcpStream> = BufConn<TcpStream>::of(stream);

    mut head: String = match (await c.read_line(256)) {
        Result::Ok(v)  => { v }
        Result::Err(_) => { return -2; }
    };
    if (head.as_str() != Str::new("ECHO 5")) { return -3; }

    // The body was very likely already in the buffer alongside the header: the
    // fill reads a whole chunk, not a line. Reading it must therefore come out
    // of the SAME buffer rather than off the wire again.
    mut body: Array<u8> = match (await c.read_exact(5)) {
        Result::Ok(v)  => { v }
        Result::Err(_) => { return -4; }
    };
    if (!ntc_bytes_eq(&body, "HELLO")) { return -5; }

    // Queue header and body separately, flush once: queuing is synchronous, so
    // a whole reply costs exactly one suspension.
    match (c.queue<string>("BACK 5\r\n"))            { Result::Ok(_) => { } Result::Err(_) => { return -6; } }
    match (c.queue<Slice<u8>>(body.as_slice()))      { Result::Ok(_) => { } Result::Err(_) => { return -7; } }
    match (await c.flush())                          { Result::Ok(_) => { } Result::Err(_) => { return -8; } }
    return 5;
}

async function ntc_client(port: u16) -> i64 {
    mut sock: TcpStream = match (await TcpConnect::start(SocketAddr::localhost_v4(port))) {
        Result::Ok(v)  => { v }
        Result::Err(_) => { return -10; }
    };
    mut c: BufConn<TcpStream> = BufConn<TcpStream>::of(sock);

    match (c.queue<string>("ECHO 5\r\nHELLO")) { Result::Ok(_) => { } Result::Err(_) => { return -11; } }
    match (await c.flush())                    { Result::Ok(_) => { } Result::Err(_) => { return -12; } }

    mut head: String = match (await c.read_line(256)) {
        Result::Ok(v)  => { v }
        Result::Err(_) => { return -13; }
    };
    if (head.as_str() != Str::new("BACK 5")) { return -14; }

    mut body: Array<u8> = match (await c.read_exact(5)) {
        Result::Ok(v)  => { v }
        Result::Err(_) => { return -15; }
    };
    if (!ntc_bytes_eq(&body, "HELLO")) { return -16; }
    return 5;
}

async function ntc_round_trip(port: u16, listener: TcpListener) -> i64 {
    const pair: (i64, i64) = await Futures::join(ntc_serve(listener), ntc_client(port));
    if (pair.0 != 5) { return pair.0; }
    if (pair.1 != 5) { return pair.1; }
    return 0;
}

![test]
function tcp_conn_framed_round_trip() -> Result<(), TestError> {
    mut listener: TcpListener = match (TcpListener::bind(SocketAddr::localhost_v4(0u16))) {
        Result::Ok(v)  => { v }
        Result::Err(_) => { return bail(Str::new("bind 127.0.0.1:0 failed")); }
    };
    listener.set_nonblocking(true);
    const port: u16 = match (listener.local_addr()) {
        Result::Ok(a)  => { a.port }
        Result::Err(_) => { listener.drop(); return bail(Str::new("local_addr failed")); }
    };
    mut ex: Executor = Executor::new();
    const r: i64 = ex.block_on(ntc_round_trip(port, listener));
    ex.drop();
    return expect_eq(r, 0 as i64);
}

/// A peer that closes without sending the record it announced must surface as
/// `UnexpectedEof` from `read_exact`, not as a hang and not as a short read.
async function ntc_truncated_send(port: u16) -> i64 {
    mut sock: TcpStream = match (await TcpConnect::start(SocketAddr::localhost_v4(port))) {
        Result::Ok(v)  => { v }
        Result::Err(_) => { return -40; }
    };
    mut c: BufConn<TcpStream> = BufConn<TcpStream>::of(sock);
    match (c.queue<string>("REC 4\r\nab")) { Result::Ok(_) => { } Result::Err(_) => { return -41; } }
    match (await c.flush())                { Result::Ok(_) => { } Result::Err(_) => { return -42; } }
    return 1;   // dropping `c` here closes the socket mid-record
}

async function ntc_truncated_recv(listener: TcpListener) -> i64 {
    mut acc: TcpAccepted = await TcpAccept::start(listener);
    mut lst: TcpListener = acc.take_listener();
    lst.drop();
    mut stream: TcpStream = TcpStream::from_fd(-1);
    match (acc.take_result()) {
        Result::Ok(s)  => { stream = s; }
        Result::Err(_) => { return -50; }
    }
    mut c: BufConn<TcpStream> = BufConn<TcpStream>::of(stream);
    mut head: String = match (await c.read_line(64)) {
        Result::Ok(v)  => { v }
        Result::Err(_) => { return -51; }
    };
    if (head.as_str() != Str::new("REC 4")) { return -52; }
    match (await c.read_exact(4)) {
        Result::Ok(_)  => { return -53; }
        Result::Err(e) => {
            match (e.kind) {
                IoErrorKind::UnexpectedEof => { return 1; }
                _ => { return -54; }
            }
        }
    }
}

async function ntc_truncated(port: u16, listener: TcpListener) -> i64 {
    const pair: (i64, i64) = await Futures::join(ntc_truncated_recv(listener),
                                                 ntc_truncated_send(port));
    if (pair.0 != 1) { return pair.0; }
    if (pair.1 != 1) { return pair.1; }
    return 0;
}

/// A flood: the sender queues N framed records and flushes ONCE, then waits for
/// an ack in the reverse direction. The receiver reads them back one at a time
/// IN A LOOP.
///
/// This is the shape every protocol read loop has, and the one nothing else here
/// covered: the other tests call `read_line` exactly once per connection, so the
/// connection was never an owning local awaited on more than once from inside a
/// loop. That gap is what hid the carrier bug this test now guards — a state
/// suspending inside a loop left its carrier empty, and the next poll unwrapped
/// a `None`. The failure was originally blamed on `Futures::join`, which is only
/// the lens it was seen through.
async function ntc_flood_send(port: u16, n: i64) -> i64 {
    mut sock: TcpStream = match (await TcpConnect::start(SocketAddr::localhost_v4(port))) {
        Result::Ok(v)  => { v }
        Result::Err(_) => { return -60; }
    };
    mut c: BufConn<TcpStream> = BufConn<TcpStream>::of(sock);

    mut i: i64 = 0;
    while (i < n) {
        match (c.queue<string>("REC 3\r\nabc")) { Result::Ok(_) => { } Result::Err(_) => { return -61; } }
        i = i + 1;
    }
    match (await c.flush()) { Result::Ok(_) => { } Result::Err(_) => { return -62; } }

    mut ack: String = match (await c.read_line(64)) {
        Result::Ok(v)  => { v }
        Result::Err(_) => { return -63; }
    };
    if (ack.as_str() != Str::new("ACK")) { return -64; }
    return n;
}

async function ntc_flood_recv(listener: TcpListener, n: i64) -> i64 {
    mut acc: TcpAccepted = await TcpAccept::start(listener);
    mut lst: TcpListener = acc.take_listener();
    lst.drop();
    mut stream: TcpStream = TcpStream::from_fd(-1);
    match (acc.take_result()) {
        Result::Ok(s)  => { stream = s; }
        Result::Err(_) => { return -70; }
    }
    mut c: BufConn<TcpStream> = BufConn<TcpStream>::of(stream);

    // Two suspending reads per iteration, both on the connection itself, so the
    // carrier is taken and handed back four times per record.
    mut got: i64 = 0;
    while (got < n) {
        mut head: String = match (await c.read_line(64)) {
            Result::Ok(v)  => { v }
            Result::Err(_) => { return -71; }
        };
        if (head.as_str() != Str::new("REC 3")) { return -72; }
        mut body: Array<u8> = match (await c.read_exact(3)) {
            Result::Ok(v)  => { v }
            Result::Err(_) => { return -73; }
        };
        if (!ntc_bytes_eq(&body, "abc")) { return -74; }
        got = got + 1;
    }

    match (c.queue<string>("ACK\r\n")) { Result::Ok(_) => { } Result::Err(_) => { return -75; } }
    match (await c.flush())            { Result::Ok(_) => { } Result::Err(_) => { return -76; } }
    return got;
}

async function ntc_flood(port: u16, listener: TcpListener, n: i64) -> i64 {
    const pair: (i64, i64) = await Futures::join(ntc_flood_recv(listener, n),
                                                 ntc_flood_send(port, n));
    if (pair.0 != n) { return pair.0; }
    if (pair.1 != n) { return pair.1; }
    return 0;
}

![test]
function tcp_conn_flood_of_records_read_one_at_a_time() -> Result<(), TestError> {
    mut listener: TcpListener = match (TcpListener::bind(SocketAddr::localhost_v4(0u16))) {
        Result::Ok(v)  => { v }
        Result::Err(_) => { return bail(Str::new("bind 127.0.0.1:0 failed")); }
    };
    listener.set_nonblocking(true);
    const port: u16 = match (listener.local_addr()) {
        Result::Ok(a)  => { a.port }
        Result::Err(_) => { listener.drop(); return bail(Str::new("local_addr failed")); }
    };
    mut ex: Executor = Executor::new();
    const r: i64 = ex.block_on(ntc_flood(port, listener, 16 as i64));
    ex.drop();
    return expect_eq(r, 0 as i64);
}

![test]
function tcp_conn_reports_a_truncated_record_as_eof() -> Result<(), TestError> {
    mut listener: TcpListener = match (TcpListener::bind(SocketAddr::localhost_v4(0u16))) {
        Result::Ok(v)  => { v }
        Result::Err(_) => { return bail(Str::new("bind 127.0.0.1:0 failed")); }
    };
    listener.set_nonblocking(true);
    const port: u16 = match (listener.local_addr()) {
        Result::Ok(a)  => { a.port }
        Result::Err(_) => { listener.drop(); return bail(Str::new("local_addr failed")); }
    };
    mut ex: Executor = Executor::new();
    const r: i64 = ex.block_on(ntc_truncated(port, listener));
    ex.drop();
    return expect_eq(r, 0 as i64);
}
