///! Waits bounded by a `Duration`: `ConditionVariable.wait_timeout` reports that the
///! time ran out after waiting it, and `Receiver.receive_timeout` times out
///! with a sender still alive, returns a queued value at once, takes a
///! value sent while it waits, and reports a channel whose sender is gone.

![config(testing)]
namespace CryoTests::Tests::Stdlib::SyncTimedWaits;

import std::core::result::{ Result };
import std::core::mem;
import std::collections::str::{ Str };
import std::core::pair::{ Pair };
import std::alloc::allocator::{ GlobalAllocator };
import std::sync::condition_variable::{ ConditionVariable };
import std::sync::mutex::{ Mutex, MutexGuard };
import std::sync::channel;
import std::sync::channel::{ Receiver, ReceiveTimeoutError, Sender };
import std::thread;
import std::time::clock::{ Instant };
import std::time::duration::{ Duration };
import std::test::error::{ TestError };
import std::test::assert::{ expect, expect_equal };

![test]
function condition_variable_wait_timeout_reports_the_time_running_out() -> Result<(), TestError> {
    const lock: Mutex<i64> = Mutex::new(0);
    const signal: ConditionVariable = ConditionVariable::new();
    mut guard: MutexGuard<i64, GlobalAllocator> = lock.lock();
    const start: Instant = Instant::now();
    const timed_out: boolean = signal.wait_timeout(&lock, &guard, Duration::from_milliseconds(60));
    expect(timed_out, Str::new("the wait timed out"))?;
    expect(start.elapsed().as_milliseconds() >= 60, Str::new("the wait lasted the duration"))?;
    return Result::Ok(());
}

/// A wait that reports its time running out has waited all of it, every
/// time: many short waits give an early end many chances to show, and a
/// machine under load only lengthens a wait.
![test]
function condition_variable_wait_timeout_never_ends_before_its_duration() -> Result<(), TestError> {
    const lock: Mutex<i64> = Mutex::new(0);
    const signal: ConditionVariable = ConditionVariable::new();
    mut guard: MutexGuard<i64, GlobalAllocator> = lock.lock();
    for (mut i: i64 = 0; i < 200; i++) {
        const start: Instant = Instant::now();
        const timed_out: boolean = signal.wait_timeout(&lock, &guard, Duration::from_milliseconds(5));
        if (timed_out) {
            expect(start.elapsed().as_nanoseconds() >= 5000000, Str::new("a wait that timed out lasted its whole duration"))?;
        }
    }
    return Result::Ok(());
}

![test]
function receive_timeout_times_out_with_a_sender_alive() -> Result<(), TestError> {
    const { first: sender, second: receiver }: Pair<Sender<i64>, Receiver<i64>> = channel::Channel::unbounded::<i64>();
    const start: Instant = Instant::now();
    match (receiver.receive_timeout(Duration::from_milliseconds(60))) {
        Result::Ok(_) => { return Result::Err(TestError::failed(Str::new("no value was sent"))); }
        Result::Err(ReceiveTimeoutError::Disconnected) => { return Result::Err(TestError::failed(Str::new("a sender is alive"))); }
        Result::Err(ReceiveTimeoutError::Timeout) => { }
    }
    expect(start.elapsed().as_milliseconds() >= 50, Str::new("the wait lasted the duration"))?;
    return expect(sender.send(1).is_ok(), Str::new("the receiver still takes a value"));
}

![test]
function receive_timeout_returns_a_queued_value_at_once() -> Result<(), TestError> {
    const { first: sender, second: receiver }: Pair<Sender<i64>, Receiver<i64>> = channel::Channel::unbounded::<i64>();
    expect(sender.send(7).is_ok(), Str::new("the value is queued"))?;
    match (receiver.receive_timeout(Duration::from_seconds(10))) {
        Result::Ok(value) => { expect_equal(value, 7)?; }
        Result::Err(_) => { return Result::Err(TestError::failed(Str::new("the queued value"))); }
    }
    return Result::Ok(());
}

![test]
function receive_timeout_takes_a_value_sent_while_it_waits() -> Result<(), TestError> {
    const { first: sender, second: receiver }: Pair<Sender<i64>, Receiver<i64>> = channel::Channel::unbounded::<i64>();
    const worker = thread::spawn(move () -> i64 {
        thread::sleep(Duration::from_milliseconds(30));
        // The test reads the send's outcome from the thread's result.
        return if (sender.send(9).is_ok()) { 0 } else { 1 };
    });
    const start: Instant = Instant::now();
    match (receiver.receive_timeout(Duration::from_seconds(20))) {
        Result::Ok(value) => { expect_equal(value, 9)?; }
        Result::Err(_) => { return Result::Err(TestError::failed(Str::new("the value sent while waiting"))); }
    }
    expect(start.elapsed().as_seconds() < 10, Str::new("woken by the send, not the timeout"))?;
    return expect_equal(worker.join().unwrap(), 0);
}

![test]
function receive_timeout_reports_a_channel_without_senders() -> Result<(), TestError> {
    const { first: sender, second: receiver }: Pair<Sender<i64>, Receiver<i64>> = channel::Channel::unbounded::<i64>();
    mem::drop(sender);
    const start: Instant = Instant::now();
    match (receiver.receive_timeout(Duration::from_seconds(20))) {
        Result::Err(ReceiveTimeoutError::Disconnected) => { }
        Result::Err(ReceiveTimeoutError::Timeout) => { return Result::Err(TestError::failed(Str::new("no sender exists"))); }
        Result::Ok(_) => { return Result::Err(TestError::failed(Str::new("no value was sent"))); }
    }
    expect(start.elapsed().as_seconds() < 10, Str::new("answered at once"))?;
    return Result::Ok(());
}
