///! Box<T> - single-owner heap allocation.

![config(testing)]
namespace CryoTests::Tests::Stdlib::BoxT;

import std::core::result::{ Result };
import std::core::mem;
import std::core::ptr::{ NonNull };
import std::alloc::box::{ Box };
import std::alloc::layout::{ Layout };
import std::alloc::allocator::{ AllocError, Allocator, GlobalAlloc };
import std::test::error::{ TestError };
import std::test::assert::{ expect_eq };

![test]
function new_box_holds_value() -> Result<(), TestError> {
    mut b: Box<i32> = Box::new(42);
    const got: i32 = *b.as_ptr();
    match (expect_eq(got, 42)) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

// Guards against a generic constructor pinning its owner's type parameter
// from an integer LITERAL's i32 default, ignoring the declared `Box<i64>`:
// that would monomorphize `Box::new(1234567890123)` to `Box<i32>`,
// allocate 4 bytes, and store the literal truncated to its low 32 bits
// (1912276171). Mono recovers `T = i64` from the expected `Box<i64>`
// (return-type-driven inference) so the full 8-byte value round-trips.
![test]
function box_i64_preserves_wide_literal() -> Result<(), TestError> {
    mut b: Box<i64> = Box::new(1234567890123);
    const got: i64 = *b.as_ptr();
    match (expect_eq(got, 1234567890123)) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

![test]
function box_writes_visible_through_pointer() -> Result<(), TestError> {
    mut b: Box<i32> = Box::new(1);
    const p: i32* = b.as_ptr();
    *p = 99;
    const after: i32 = *b.as_ptr();
    match (expect_eq(after, 99)) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

![test]
function into_raw_then_from_raw_round_trip() -> Result<(), TestError> {
    const b1: Box<i32> = Box::new(123);
    const raw: i32* = b1.into_raw();
    // We are now responsible for the raw pointer - re-wrap and drop.
    mut b2: Box<i32> = Box::from_raw(raw);
    const got: i32 = *b2.as_ptr();
    match (expect_eq(got, 123)) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

/// Counts, through the test's own locals, what it hands out and takes back.
type struct BoxCountingAlloc {
    allocated: i64*;
    released:  i64*;
}

implement trait Allocator for struct BoxCountingAlloc {
    allocate(mut &this, layout: Layout) -> Result<NonNull<u8>, AllocError> {
        *this.allocated = *this.allocated + 1;
        mut global: GlobalAlloc = GlobalAlloc::new();
        return global.allocate(layout);
    }
    deallocate(mut &this, ptr: NonNull<u8>, layout: Layout) -> void {
        *this.released = *this.released + 1;
        mut global: GlobalAlloc = GlobalAlloc::new();
        global.deallocate(ptr, layout);
    }
}

// A pointer given up by a box on another allocator is re-wrapped with that
// allocator, and the new box frees it there when dropped.
![test]
function into_raw_then_from_raw_in_frees_through_the_allocator() -> Result<(), TestError> {
    mut allocated: i64 = 0;
    mut released: i64 = 0;
    const b1: Box<i64, BoxCountingAlloc> = Box::<i64, BoxCountingAlloc>::new_in(
        77, BoxCountingAlloc { allocated: &allocated, released: &released });
    const raw: i64* = b1.into_raw();
    mut b2: Box<i64, BoxCountingAlloc> = Box::<i64, BoxCountingAlloc>::from_raw_in(
        raw, BoxCountingAlloc { allocated: &allocated, released: &released });
    const got: i64 = *b2.as_ptr();
    match (expect_eq(got, 77)) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    match (expect_eq(released, 0)) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    mem::drop(b2);
    match (expect_eq(allocated, 1)) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    match (expect_eq(released, 1)) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

// Boxing a struct to confirm composite-T payloads also round-trip.
// Named `BoxStruct` (not `Point`) to avoid polluting the trait-impl registry
// with a bare-name key that would shadow the `Point` types defined in other
// test modules (e.g. tests/lang/structs.cryo, tests/lang/visibility.cryo).
// Requires a Drop impl so Box<BoxStruct> satisfies `where T: Drop`.
type struct BoxStruct {
    x: i32;
    y: i32;
}

implement trait Drop for struct BoxStruct {
    drop(mut &this) -> void {}
}

![test]
function box_holds_struct_by_value() -> Result<(), TestError> {
    mut b: Box<BoxStruct> = Box::new(BoxStruct { x: 3, y: 4 });
    const sx: i32 = (*b.as_ptr()).x;
    const sy: i32 = (*b.as_ptr()).y;
    match (expect_eq(sx, 3)) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    match (expect_eq(sy, 4)) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

// ============================================================================
// Pointee-drop test
//
// A `Wrapper` type whose `drop` writes a sentinel (99) through a raw pointer
// proves that Box::drop calls T's destructor before freeing the memory. If
// Box::drop bypassed the pointee's Drop impl, the sentinel would never be
// written.
// ============================================================================

type struct Wrapper {
    // Raw pointer to a stack-resident i32.  Box::drop must call
    // Wrapper::drop before freeing the allocation; Wrapper::drop writes
    // the sentinel through this pointer.  We read it back on the stack
    // after b.drop() to confirm the write happened.
    sentinel_ptr: i32*;
}

implement trait Drop for struct Wrapper {
    drop(mut &this) -> void {
        // Write sentinel value so the test can observe this was called.
        *this.sentinel_ptr = 99;
    }
}

![test]
function box_drop_calls_pointee_drop() -> Result<(), TestError> {
    mut sentinel: i32 = 0;
    mut b: Box<Wrapper> = Box::new(Wrapper { sentinel_ptr: &sentinel });
    // Before drop: sentinel is 0 (Wrapper::drop not yet called).
    const before: i32 = sentinel;
    mem::drop(b);  // runs Wrapper's destructor before the sentinel is read
    // After drop: Wrapper::drop must have written 99 through sentinel_ptr.
    const after: i32 = sentinel;
    match (expect_eq(before, 0)) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return expect_eq(after, 99);
}

// A type whose destructor is written as an INLINE `drop` method rather
// than `implement trait Drop`. Counts how many times drop runs.
type struct InlineDropBox {
    counter_ptr: i32*;
}

implement trait Drop for struct InlineDropBox {
    drop(mut &this) -> void { *this.counter_ptr = *this.counter_ptr + 1; }
}

// A payload whose destructor is an inline `drop` method must satisfy
// Box's `where T: Drop`, so `Box<InlineDropBox>` instantiates and runs
// the inner drop (without this, `E0636: no method 'drop' found` would
// fire at codegen).
![test]
function box_inline_drop_payload_compiles_and_drops() -> Result<(), TestError> {
    mut count: i32 = 0;
    mut b: Box<InlineDropBox> = Box::new(InlineDropBox { counter_ptr: &count });
    mem::drop(b);  // released before the drop count is read
    return expect_eq(count, 1);
}
