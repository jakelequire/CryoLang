///! Box<T> - single-owner heap allocation.

![config(testing)]
namespace CryoTests::Tests::Stdlib::BoxT;

import std::core::result;
import std::alloc::box;
import std::test::error;
import std::test::assert;

![test]
function new_box_holds_value() -> Result<(), TestError> {
    mut b: Box<i32> = Box::new(42);
    const got: i32 = *b.as_ptr();
    b.drop();
    match (expect_eq(got, 42)) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

// Regression for the audit finding that a generic constructor pinned its
// owner's type parameter from an integer LITERAL's i32 default, ignoring the
// declared `Box<i64>`. `Box::new(1234567890123)` monomorphized `Box<i32>`,
// allocated 4 bytes, and stored the literal truncated to its low 32 bits
// (1912276171). Mono now recovers `T = i64` from the expected `Box<i64>`
// (return-type-driven inference) so the full 8-byte value round-trips.
![test]
function box_i64_preserves_wide_literal() -> Result<(), TestError> {
    mut b: Box<i64> = Box::new(1234567890123);
    const got: i64 = *b.as_ptr();
    b.drop();
    match (expect_eq(got, 1234567890123)) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

![test]
function box_writes_visible_through_pointer() -> Result<(), TestError> {
    mut b: Box<i32> = Box::new(1);
    const p: i32* = b.as_ptr();
    *p = 99;
    const after: i32 = *b.as_ptr();
    b.drop();
    match (expect_eq(after, 99)) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

![test]
function into_raw_then_from_raw_round_trip() -> Result<(), TestError> {
    const b1: Box<i32> = Box::new(123);
    const raw: i32* = b1.into_raw();
    // We are now responsible for the raw pointer - re-wrap and drop.
    mut b2: Box<i32> = Box::from_raw(raw);
    const got: i32 = *b2.as_ptr();
    b2.drop();
    match (expect_eq(got, 123)) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

// Boxing a struct to confirm composite-T payloads also round-trip.
// Named `BoxStruct` (not `Point`) to avoid polluting the trait-impl registry
// with a bare-name key that would shadow the `Point` types defined in other
// test modules (e.g. tests/lang/structs.cryo, tests/lang/visibility.cryo).
// Requires a Drop impl so Box<BoxStruct> satisfies `where T: Drop`.
type struct BoxStruct {
    x: i32;
    y: i32;
}

implement trait Drop for struct BoxStruct {
    drop(mut &this) -> void {}
}

![test]
function box_holds_struct_by_value() -> Result<(), TestError> {
    mut b: Box<BoxStruct> = Box::new(BoxStruct { x: 3, y: 4 });
    const sx: i32 = (*b.as_ptr()).x;
    const sy: i32 = (*b.as_ptr()).y;
    b.drop();
    match (expect_eq(sx, 3)) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    match (expect_eq(sy, 4)) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

// ============================================================================
// Pointee-drop test
//
// A `Wrapper` type whose `drop` writes a sentinel (99) through a raw pointer
// proves that Box::drop now calls T's destructor before freeing the memory.
// Before the fix, the sentinel was never written because Box::drop bypassed
// the pointee's Drop impl.
// ============================================================================

type struct Wrapper {
    // Raw pointer to a stack-resident i32.  Box::drop must call
    // Wrapper::drop before freeing the allocation; Wrapper::drop writes
    // the sentinel through this pointer.  We read it back on the stack
    // after b.drop() to confirm the write happened.
    sentinel_ptr: i32*;
}

implement trait Drop for struct Wrapper {
    drop(mut &this) -> void {
        // Write sentinel value so the test can observe this was called.
        *this.sentinel_ptr = 99;
    }
}

![test]
function box_drop_calls_pointee_drop() -> Result<(), TestError> {
    mut sentinel: i32 = 0;
    mut b: Box<Wrapper> = Box::new(Wrapper { sentinel_ptr: &sentinel });
    // Before drop: sentinel is 0 (Wrapper::drop not yet called).
    const before: i32 = sentinel;
    b.drop();
    // After drop: Wrapper::drop must have written 99 through sentinel_ptr.
    const after: i32 = sentinel;
    match (expect_eq(before, 0)) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return expect_eq(after, 99);
}

// A type whose destructor is written as an INLINE `drop` method rather
// than `implement trait Drop`. Counts how many times drop runs.
type struct InlineDropBox {
    counter_ptr: i32*;
    drop(mut &this) -> void { *this.counter_ptr = *this.counter_ptr + 1; }
}

// C3 regression: a payload whose destructor is an inline `drop` method
// must satisfy Box's `where T: Drop`, so `Box<InlineDropBox>`
// instantiates and runs the inner drop. Previously this failed with
// `E0636: no method 'drop' found` at codegen.
![test]
function box_inline_drop_payload_compiles_and_drops() -> Result<(), TestError> {
    mut count: i32 = 0;
    mut b: Box<InlineDropBox> = Box::new(InlineDropBox { counter_ptr: &count });
    b.drop();
    return expect_eq(count, 1);
}

// Historical note: this file used to assert that double-`.drop()`
// on a Box handle was a runtime-idempotent no-op.  Idempotency at
// the implementation level is still true, but as of 2026-05-26 the
// move-checker rejects double `.drop()` on the same binding at
// compile time (E0452).  See `tests/tests/negative/E0452_double_drop.cryo`.
