///! fs metadata + directory operations + read_to_string + seek.
///!
///! Each test uses PID-unique paths under the OS temp dir and cleans up after
///! itself so the suite leaves no residue.

![config(testing)]
namespace CryoTests::Tests::Stdlib::FsMetaDir;

import std::core::intrinsics;
import std::core::result::{ Result };
import std::core::option::{ Option };
import std::core::slice;
import std::core::drop;
import std::core::iter;
import std::collections::str::{ Str };
import std::collections::string::{ String };
import std::io::error;
import std::io::traits;
import std::fs::{ Directory, DirectoryEntries, DirectoryEntry, File, Path, PathBuf };
import std::ffi::libc;
import std::test::error::{ TestError };
import std::test::assert::{ bail, expect_eq, expect_true };

// Scratch directory for test files.  A hardcoded "/tmp" is not portable:
// on Windows it resolves against the current drive, so a checkout on any
// drive without a top-level \tmp (a CI workspace on D:, say) fails every
// create.  Take the OS temp directory instead.
![target(linux)]
function temp_root() -> u8* { return "/tmp" as u8*; }

![target(windows)]
function temp_root() -> u8* {
    const t: u8* = libc::getenv("TEMP" as u8*);
    if (t != null) { return t; }
    return "C:/Windows/Temp" as u8*;
}

function tmp_file(buf: mut u8*, tag: string) -> Path {
    const n: i32 = libc::snprintf(buf, 256, "%s/cryo_md_%s_%d.dat",
                                        temp_root(), tag, libc::getpid());
    return Path::from(Str::from_raw(buf, n as u64));
}

![test]
function read_to_string_roundtrip() -> Result<(), TestError> {
    mut namebuf: [u8; 256];
    const p: Path = tmp_file(&namebuf[0], "rts");
    const payload: Str = Str::new("line one\nline two\n");
    match (File::write_bytes(p, payload.as_bytes())) {
        Result::Ok(_)  => { }
        Result::Err(_) => { return bail(Str::new("write failed")); }
    }
    mut got: String = String::new();
    match (File::read_text(p)) {
        Result::Ok(s)  => { got = s; }
        Result::Err(_) => { libc::unlink(p.as_str().as_ptr()); return bail(Str::new("read_to_string failed")); }
    }
    const ok: boolean = got.as_str().equals(&payload);
    libc::unlink(p.as_str().as_ptr());
    expect_true(ok, Str::new("contents match"))?;
    return Result::Ok(());
}

![test]
function metadata_reports_file() -> Result<(), TestError> {
    mut namebuf: [u8; 256];
    const p: Path = tmp_file(&namebuf[0], "meta");
    const payload: Str = Str::new("12345");   // 5 bytes
    match (File::write_bytes(p, payload.as_bytes())) {
        Result::Ok(_)  => { }
        Result::Err(_) => { return bail(Str::new("write failed")); }
    }
    mut is_file: boolean = false;
    mut is_dir: boolean = true;
    mut size: i64 = 0;
    match (p.metadata()) {
        Result::Ok(m)  => { is_file = m.is_file(); is_dir = m.is_directory(); size = m.length(); }
        Result::Err(_) => { libc::unlink(p.as_str().as_ptr()); return bail(Str::new("metadata failed")); }
    }
    libc::unlink(p.as_str().as_ptr());
    expect_true(is_file, Str::new("is_file"))?;
    expect_true(!is_dir, Str::new("not is_dir"))?;
    expect_eq(size, 5)?;
    return Result::Ok(());
}

![test]
function exists_true_and_false() -> Result<(), TestError> {
    mut namebuf: [u8; 256];
    const p: Path = tmp_file(&namebuf[0], "exists");
    // Not created yet.
    expect_true(!p.exists(), Str::new("absent before create"))?;
    match (File::write_bytes(p, Str::new("x").as_bytes())) {
        Result::Ok(_)  => { }
        Result::Err(_) => { return bail(Str::new("write failed")); }
    }
    const present: boolean = p.exists();
    libc::unlink(p.as_str().as_ptr());
    expect_true(present, Str::new("present after create"))?;
    return Result::Ok(());
}

// A path through `..`, written with the host temp directory's own
// separators, names the same directory as the direct path, and its
// canonical spelling is separated by `/` alone.
![test]
function canonicalize_resolves_parent_with_forward_separators() -> Result<(), TestError> {
    mut dirbuf: [u8; 256];
    const dn: i32 = libc::snprintf(&dirbuf[0], 256, "%s/cryo_md_canon_%d",
                                         temp_root(), libc::getpid());
    const dpath: Path = Path::from(Str::from_raw(&dirbuf[0], dn as u64));
    mut innerbuf: [u8; 256];
    const inn: i32 = libc::snprintf(&innerbuf[0], 256, "%s/cryo_md_canon_%d/inner",
                                          temp_root(), libc::getpid());
    const inner: Path = Path::from(Str::from_raw(&innerbuf[0], inn as u64));
    mut throughbuf: [u8; 256];
    const tn: i32 = libc::snprintf(&throughbuf[0], 256, "%s/cryo_md_canon_%d/inner/..",
                                         temp_root(), libc::getpid());
    const through: Path = Path::from(Str::from_raw(&throughbuf[0], tn as u64));

    match (Directory::create(dpath)) {
        Result::Ok(_)  => { }
        Result::Err(_) => { return bail(Str::new("create_dir failed")); }
    }
    match (Directory::create(inner)) {
        Result::Ok(_)  => { }
        Result::Err(_) => { Directory::remove(dpath); return bail(Str::new("create_dir inner failed")); }
    }
    const direct: Result<PathBuf, std::io::error::IoError> = dpath.canonicalize();
    const parent: Result<PathBuf, std::io::error::IoError> = through.canonicalize();
    match (Directory::remove(inner)) { Result::Ok(_) => { } Result::Err(_) => { } }
    match (Directory::remove(dpath)) { Result::Ok(_) => { } Result::Err(_) => { } }

    match (direct) {
        Result::Ok(d) => {
            match (parent) {
                Result::Ok(p) => {
                    expect_true(p.as_path().as_str().equals(&d.as_path().as_str()),
                                Str::new("the path through .. is the direct path"))?;
                    expect_true(!d.as_path().as_str().contains(&Str::new("\\")),
                                Str::new("no backslash in the canonical path"))?;
                    expect_true(!d.as_path().as_str().contains(&Str::new("..")),
                                Str::new("no .. in the canonical path"))?;
                }
                Result::Err(_) => { return bail(Str::new("canonicalize through .. failed")); }
            }
        }
        Result::Err(_) => { return bail(Str::new("canonicalize failed")); }
    }
    return Result::Ok(());
}

![test]
function create_read_remove_dir() -> Result<(), TestError> {
    mut dirbuf: [u8; 256];
    const dn: i32 = libc::snprintf(&dirbuf[0], 256, "%s/cryo_md_dir_%d",
                                         temp_root(), libc::getpid());
    const dpath: Path = Path::from(Str::from_raw(&dirbuf[0], dn as u64));

    match (Directory::create(dpath)) {
        Result::Ok(_)  => { }
        Result::Err(_) => { return bail(Str::new("create_dir failed")); }
    }

    // A file inside the directory.
    mut filebuf: [u8; 256];
    const fn2: i32 = libc::snprintf(&filebuf[0], 256, "%s/cryo_md_dir_%d/entry.dat",
                                          temp_root(), libc::getpid());
    const fpath: Path = Path::from(Str::from_raw(&filebuf[0], fn2 as u64));
    match (File::write_bytes(fpath, Str::new("hi").as_bytes())) {
        Result::Ok(_)  => { }
        Result::Err(_) => { Directory::remove(dpath); return bail(Str::new("write in dir failed")); }
    }

    // read_dir should surface exactly the one entry "entry.dat".
    mut found: boolean = false;
    mut count: u64 = 0;
    match (Directory::entries(dpath)) {
        Result::Ok(rd) => {
            mut it: DirectoryEntries = rd;
            loop {
                match (it.next()) {
                    Option::Some(e) => {
                        mut entry: DirectoryEntry = e;
                        count = count + 1;
                        if (entry.name().equals(&Str::new("entry.dat"))) { found = true; }
                    }
                    Option::None => { break; }
                }
            }
        }
        Result::Err(_) => {
            File::remove(fpath); Directory::remove(dpath);
            return bail(Str::new("read_dir failed"));
        }
    }

    // Cleanup.
    match (File::remove(fpath)) { Result::Ok(_) => { } Result::Err(_) => { } }
    match (Directory::remove(dpath))  { Result::Ok(_) => { } Result::Err(_) => { } }

    expect_eq(count, 1u64)?;
    expect_true(found, Str::new("entry.dat found"))?;
    return Result::Ok(());
}

![test]
function file_seek_cur_end_and_position() -> Result<(), TestError> {
    mut namebuf: [u8; 256];
    const p: Path = tmp_file(&namebuf[0], "seek");
    match (File::write_bytes(p, Str::new("0123456789").as_bytes())) {
        Result::Ok(_)  => { }
        Result::Err(_) => { return bail(Str::new("write failed")); }
    }
    mut pos: i64 = 0;
    mut endpos: i64 = 0;
    mut cur: i64 = 99;
    match (File::open(p)) {
        Result::Ok(h)  => {
            mut f: File = h;
            match (f.seek(traits::SeekFrom::Start(3))) { Result::Ok(v) => { pos = v; } Result::Err(_) => { } }
            match (f.seek(traits::SeekFrom::Current(2))) { Result::Ok(v) => { pos = v; } Result::Err(_) => { } }   // -> 5
            match (f.stream_position()) { Result::Ok(v) => { cur = v; } Result::Err(_) => { } }
            match (f.seek(traits::SeekFrom::End(0))) { Result::Ok(v) => { endpos = v; } Result::Err(_) => { } } // -> 10
        }
        Result::Err(_) => { libc::unlink(p.as_str().as_ptr()); return bail(Str::new("open failed")); }
    }
    libc::unlink(p.as_str().as_ptr());
    expect_eq(pos, 5 as i64)?;
    expect_eq(cur, 5 as i64)?;
    expect_eq(endpos, 10 as i64)?;
    return Result::Ok(());
}
