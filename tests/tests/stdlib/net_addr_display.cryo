///! `Display` for the network address and HTTP types: dotted IPv4, the
///! canonical compressed IPv6 form, socket addresses with a bracketed IPv6,
///! URLs, methods and status codes.

![config(testing)]
namespace CryoTests::Tests::Stdlib::NetAddrDisplay;

import std::core::result::{ Result };
import std::collections::str::{ Str };
import std::collections::string::{ String };
import std::net::addr::ip::{ IpAddr, IpV4Addr, IpV6Addr };
import std::net::addr::socket_addr::{ SocketAddr };
import std::net::addr::url::{ Url };
import std::net::http::method::{ Method };
import std::net::http::status::{ StatusCode };
import std::test::error::{ TestError };
import std::test::assert::{ expect_eq };

function shown_v6(text: string) -> String {
    return f"{IpV6Addr::parse(Str::new(text)).unwrap()}";
}

function shown_url(text: string) -> String {
    return f"{Url::parse(Str::new(text)).unwrap()}";
}

![test]
function ipv4_displays_dotted_decimal() -> Result<(), TestError> {
    expect_eq(f"{IpV4Addr::new(192, 168, 0, 1)}".as_str(), Str::new("192.168.0.1"))?;
    expect_eq(f"{IpV4Addr::broadcast()}".as_str(), Str::new("255.255.255.255"))?;
    expect_eq(f"{IpV4Addr::unspecified()}".as_str(), Str::new("0.0.0.0"))?;
    return Result::Ok(());
}

![test]
function ipv6_compresses_the_longest_zero_run() -> Result<(), TestError> {
    expect_eq(f"{IpV6Addr::localhost()}".as_str(), Str::new("::1"))?;
    expect_eq(f"{IpV6Addr::unspecified()}".as_str(), Str::new("::"))?;
    expect_eq(shown_v6("FE80:0000:0000:0000:0000:0000:0000:0001").as_str(), Str::new("fe80::1"))?;
    expect_eq(shown_v6("2001:db8:0:1:0:0:0:1").as_str(), Str::new("2001:db8:0:1::1"))?;
    expect_eq(shown_v6("1:0:0:0:0:0:0:0").as_str(), Str::new("1::"))?;
    expect_eq(shown_v6("0:0:1:2:3:4:5:6").as_str(), Str::new("::1:2:3:4:5:6"))?;
    return Result::Ok(());
}

![test]
function ipv6_keeps_a_single_zero_group_and_the_first_of_equal_runs() -> Result<(), TestError> {
    expect_eq(shown_v6("2001:db8:0:1:1:1:1:1").as_str(), Str::new("2001:db8:0:1:1:1:1:1"))?;
    expect_eq(shown_v6("2001:db8:0:0:1:0:0:1").as_str(), Str::new("2001:db8::1:0:0:1"))?;
    expect_eq(shown_v6("1:0:0:2:0:0:0:3").as_str(), Str::new("1:0:0:2::3"))?;
    expect_eq(shown_v6("1:2:3:4:5:6:7:8").as_str(), Str::new("1:2:3:4:5:6:7:8"))?;
    return Result::Ok(());
}

![test]
function ip_and_socket_addresses_display() -> Result<(), TestError> {
    expect_eq(f"{IpAddr::V4(IpV4Addr::localhost())}".as_str(), Str::new("127.0.0.1"))?;
    expect_eq(f"{IpAddr::V6(IpV6Addr::localhost())}".as_str(), Str::new("::1"))?;
    expect_eq(f"{SocketAddr::localhost_v4(8080)}".as_str(), Str::new("127.0.0.1:8080"))?;
    expect_eq(f"{SocketAddr::localhost_v6(443)}".as_str(), Str::new("[::1]:443"))?;
    expect_eq(f"{SocketAddr::any_v6(0)}".as_str(), Str::new("[::]:0"))?;
    return Result::Ok(());
}

![test]
function url_displays_as_parsed() -> Result<(), TestError> {
    expect_eq(shown_url("http://example.com/a/b?x=1&y=2#top").as_str(), Str::new("http://example.com/a/b?x=1&y=2#top"))?;
    expect_eq(shown_url("https://example.com:8443").as_str(), Str::new("https://example.com:8443/"))?;
    expect_eq(shown_url("http://example.com:80/").as_str(), Str::new("http://example.com/"))?;
    expect_eq(shown_url("http://user:secret@[::1]:8080/x").as_str(), Str::new("http://[::1]:8080/x"))?;
    expect_eq(shown_url("gopher://host/").as_str(), Str::new("gopher://host/"))?;
    return Result::Ok(());
}

![test]
function method_and_status_display() -> Result<(), TestError> {
    expect_eq(f"{Method::Get}".as_str(), Str::new("GET"))?;
    expect_eq(f"{Method::Patch}".as_str(), Str::new("PATCH"))?;
    expect_eq(f"{StatusCode::not_found()}".as_str(), Str::new("404"))?;
    expect_eq(f"{StatusCode::from_u16(65535)}".as_str(), Str::new("65535"))?;
    return Result::Ok(());
}
