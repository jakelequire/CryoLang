///! core::cmp - Ordering, Eq, Ord, min/max/clamp.

![config(testing)]
namespace CryoTests::Tests::Stdlib::CmpT;

import std::core::result::{ Result };
import std::core::cmp::{ clamp, max, min, Ordering };
import std::core::mem;
import std::test::error::{ TestError };
import std::test::assert::{ expect, expect_eq };
import std::collections::str::{ Str };

// ============================================================================
// Ordering
// ============================================================================

![test]
function ordering_reverse_swaps_less_and_greater() -> Result<(), TestError> {
    const less_rev: Ordering = Ordering::Less.reverse();
    const greater_rev: Ordering = Ordering::Greater.reverse();
    const equal_rev: Ordering = Ordering::Equal.reverse();

    const less_swapped: boolean = match (less_rev) {
        Ordering::Greater => { true }
        _ => { false }
    };
    const greater_swapped: boolean = match (greater_rev) {
        Ordering::Less => { true }
        _ => { false }
    };
    const equal_kept: boolean = match (equal_rev) {
        Ordering::Equal => { true }
        _ => { false }
    };

    match (expect(less_swapped,
        Str::new("Less.reverse() should be Greater"))) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    match (expect(greater_swapped,
        Str::new("Greater.reverse() should be Less"))) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    match (expect(equal_kept,
        Str::new("Equal.reverse() should remain Equal"))) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

// ============================================================================
// Eq trait - primitives
// ============================================================================

![test]
function eq_i32_reflexive() -> Result<(), TestError> {
    const a: i32 = 5;
    const b: i32 = 5;
    match (expect(a.equals(&b),
        Str::new("5 should equal 5"))) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

![test]
function eq_i32_distinct_unequal() -> Result<(), TestError> {
    const a: i32 = 5;
    const b: i32 = 6;
    match (expect(!a.equals(&b),
        Str::new("5 should not equal 6"))) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

![test]
function eq_string_byte_wise() -> Result<(), TestError> {
    const a: string = "alpha";
    const b: string = "alpha";
    const c: string = "beta";
    match (expect(a.equals(&b),
        Str::new("identical strings should compare equal"))) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    match (expect(!a.equals(&c),
        Str::new("differing strings should not compare equal"))) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

// ============================================================================
// Ord trait - compare returns Ordering
// ============================================================================

![test]
function ord_i32_less_compare() -> Result<(), TestError> {
    const a: i32 = 1;
    const b: i32 = 2;
    const less: boolean = match (a.compare(&b)) {
        Ordering::Less => { true }
        _ => { false }
    };
    match (expect(less,
        Str::new("1.compare(&2) should be Less"))) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

![test]
function ord_i32_greater_compare() -> Result<(), TestError> {
    const a: i32 = 9;
    const b: i32 = 4;
    const greater: boolean = match (a.compare(&b)) {
        Ordering::Greater => { true }
        _ => { false }
    };
    match (expect(greater,
        Str::new("9.compare(&4) should be Greater"))) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

![test]
function ord_i32_equal_compare() -> Result<(), TestError> {
    const a: i32 = 5;
    const b: i32 = 5;
    const equal: boolean = match (a.compare(&b)) {
        Ordering::Equal => { true }
        _ => { false }
    };
    match (expect(equal,
        Str::new("5.compare(&5) should be Equal"))) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

// ============================================================================
// min / max
// ============================================================================

![test]
function min_picks_smaller() -> Result<(), TestError> {
    const got: i32 = min(3, 7);
    match (expect_eq(got, 3)) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

![test]
function min_equal_returns_first() -> Result<(), TestError> {
    const got: i32 = min(5, 5);
    match (expect_eq(got, 5)) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

![test]
function max_picks_larger() -> Result<(), TestError> {
    const got: i32 = max(3, 7);
    match (expect_eq(got, 7)) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

// ============================================================================
// clamp
// ============================================================================

![test]
function clamp_below_lo_returns_lo() -> Result<(), TestError> {
    const got: i32 = clamp(-5, 0, 100);
    match (expect_eq(got, 0)) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

![test]
function clamp_above_hi_returns_hi() -> Result<(), TestError> {
    const got: i32 = clamp(150, 0, 100);
    match (expect_eq(got, 100)) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

![test]
function clamp_in_range_returns_value() -> Result<(), TestError> {
    const got: i32 = clamp(42, 0, 100);
    match (expect_eq(got, 42)) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

![test]
![should_panic]
function clamp_inverted_range_panics() -> Result<(), TestError> {
    // lo > hi is a programmer error.
    const _: i32 = clamp(5, 100, 0);
    return Result::Ok(());
}

// ============================================================================
// Float Eq (the IEEE `==`) and total_compare (a total order over every float)
//
// NaNs are built from explicit bit patterns via `mem::transmute` rather
// than `0.0 / 0.0`: on x86 the latter yields a *negative* (sign-bit-set)
// NaN, which would make these tests depend on the hardware's NaN sign.
// ============================================================================

// IEEE-754 f64 bit patterns.
//   +inf  = 0x7FF0000000000000      -inf  = 0xFFF0000000000000
//   +qNaN = 0x7FF8000000000000      -qNaN = 0xFFF8000000000000

![test]
function eq_f64_reflexive() -> Result<(), TestError> {
    const a: f64 = 1.5;
    const b: f64 = 1.5;
    match (expect(a.equals(&b), Str::new("1.5 should equal 1.5"))) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

![test]
function eq_f64_distinct_unequal() -> Result<(), TestError> {
    const a: f64 = 1.5;
    const b: f64 = 2.5;
    match (expect(!a.equals(&b), Str::new("1.5 should not equal 2.5"))) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

![test]
function eq_f64_signed_zeros_equal() -> Result<(), TestError> {
    // +0.0 and -0.0 differ only in the sign bit, and the IEEE `==` calls
    // them equal; so does `equals`.
    const pos: f64 = 0.0;
    const neg: f64 = mem::transmute::<u64, f64>(0x8000000000000000);   // -0.0
    expect(pos.equals(&neg), Str::new("+0.0 and -0.0 should be equal"))?;
    const pos_single: f32 = 0.0;
    const neg_single: f32 = mem::transmute::<u32, f32>(0x80000000);
    return expect(pos_single.equals(&neg_single), Str::new("f32 +0.0 and -0.0 should be equal"));
}

![test]
function eq_f64_nan_equals_nothing() -> Result<(), TestError> {
    // A NaN is unequal to everything, its own bit pattern included.
    const nan: f64 = mem::transmute::<u64, f64>(0x7FF8000000000000);
    const nan2: f64 = mem::transmute::<u64, f64>(0x7FF8000000000000);
    const one: f64 = 1.0;
    expect(!nan.equals(&nan), Str::new("a NaN should not equal itself"))?;
    expect(!nan.equals(&nan2), Str::new("identical NaN bit patterns should not compare equal"))?;
    expect(!nan.equals(&one), Str::new("a NaN should not equal 1.0"))?;
    const nan_single: f32 = mem::transmute::<u32, f32>(0x7FC00000);
    return expect(!nan_single.equals(&nan_single), Str::new("an f32 NaN should not equal itself"));
}

![test]
function total_compare_f64_less_greater_equal() -> Result<(), TestError> {
    const a: f64 = 1.0;
    const b: f64 = 2.0;
    const less: boolean = match (a.total_compare(&b)) { Ordering::Less => { true } _ => { false } };
    const greater: boolean = match (b.total_compare(&a)) { Ordering::Greater => { true } _ => { false } };
    const equal: boolean = match (a.total_compare(&a)) { Ordering::Equal => { true } _ => { false } };
    expect(less, Str::new("1.0.total_compare(&2.0) should be Less"))?;
    expect(greater, Str::new("2.0.total_compare(&1.0) should be Greater"))?;
    return expect(equal, Str::new("1.0.total_compare(&1.0) should be Equal"));
}

![test]
function total_compare_f64_nan_equal_to_its_own_bits() -> Result<(), TestError> {
    // The total order places every value, so a NaN is Equal to itself
    // there even though `equals` says otherwise.
    const nan: f64 = mem::transmute::<u64, f64>(0x7FF8000000000000);
    const equal: boolean = match (nan.total_compare(&nan)) { Ordering::Equal => { true } _ => { false } };
    return expect(equal, Str::new("a NaN should be Equal to itself under total_compare"));
}

![test]
function total_compare_f64_negatives_ordered() -> Result<(), TestError> {
    // Total order must handle the sign-bit flip: more-negative < less-negative.
    const a: f64 = 0.0 - 2.0;
    const b: f64 = 0.0 - 1.0;
    const less: boolean = match (a.total_compare(&b)) { Ordering::Less => { true } _ => { false } };
    match (expect(less, Str::new("-2.0 should compare Less than -1.0"))) {
        Result::Ok(_) => { } Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

![test]
function total_compare_f64_signed_zeros_ordered() -> Result<(), TestError> {
    // -0.0 sorts strictly below +0.0 under the total order.
    const pos: f64 = 0.0;
    const neg: f64 = mem::transmute::<u64, f64>(0x8000000000000000);   // -0.0
    const less: boolean = match (neg.total_compare(&pos)) { Ordering::Less => { true } _ => { false } };
    match (expect(less, Str::new("-0.0 should compare Less than +0.0"))) {
        Result::Ok(_) => { } Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

![test]
function total_compare_f64_positive_nan_sorts_last() -> Result<(), TestError> {
    // +NaN is greater than every finite value and +inf.
    const nan: f64 = mem::transmute::<u64, f64>(0x7FF8000000000000);
    const inf: f64 = mem::transmute::<u64, f64>(0x7FF0000000000000);
    const huge: f64 = 1.0;
    const gt_huge: boolean = match (nan.total_compare(&huge)) { Ordering::Greater => { true } _ => { false } };
    const gt_inf: boolean = match (nan.total_compare(&inf)) { Ordering::Greater => { true } _ => { false } };
    match (expect(gt_huge, Str::new("+NaN should compare Greater than a finite value"))) {
        Result::Ok(_) => { } Result::Err(e) => { return Result::Err(e); }
    }
    match (expect(gt_inf, Str::new("+NaN should compare Greater than +inf"))) {
        Result::Ok(_) => { } Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

![test]
function total_compare_f64_negative_nan_sorts_first() -> Result<(), TestError> {
    // -NaN is less than every finite value and -inf.
    const nan: f64 = mem::transmute::<u64, f64>(0xFFF8000000000000);
    const ninf: f64 = mem::transmute::<u64, f64>(0xFFF0000000000000);
    const small: f64 = 0.0 - 1.0;
    const lt_small: boolean = match (nan.total_compare(&small)) { Ordering::Less => { true } _ => { false } };
    const lt_ninf: boolean = match (nan.total_compare(&ninf)) { Ordering::Less => { true } _ => { false } };
    match (expect(lt_small, Str::new("-NaN should compare Less than a finite value"))) {
        Result::Ok(_) => { } Result::Err(e) => { return Result::Err(e); }
    }
    match (expect(lt_ninf, Str::new("-NaN should compare Less than -inf"))) {
        Result::Ok(_) => { } Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

![test]
function eq_total_compare_f32_basic() -> Result<(), TestError> {
    const a: f32 = 1.5;
    const b: f32 = 1.5;
    const c: f32 = 2.5;
    const less: boolean = match (a.total_compare(&c)) { Ordering::Less => { true } _ => { false } };
    match (expect(a.equals(&b), Str::new("f32 1.5 should equal 1.5"))) {
        Result::Ok(_) => { } Result::Err(e) => { return Result::Err(e); }
    }
    match (expect(!a.equals(&c), Str::new("f32 1.5 should not equal 2.5"))) {
        Result::Ok(_) => { } Result::Err(e) => { return Result::Err(e); }
    }
    match (expect(less, Str::new("f32 1.5.compare(&2.5) should be Less"))) {
        Result::Ok(_) => { } Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}
