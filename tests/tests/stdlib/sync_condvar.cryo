///! CondVar - single-threaded coverage.
///!
///! `wait()` blocks until another thread notifies, so it can only be
///! exercised cross-thread (covered with std::thread).  Single-threaded we
///! can still pin down construction (`new` / `try_new`) and that notifying
///! a condvar with no waiters is a harmless no-op (must not block or crash),
///! plus clean drop.

![config(testing)]
namespace CryoTests::Tests::Stdlib::SyncCondVar;

import std::core::result;
import std::core::drop;
import std::collections::str;
import std::sync::condvar;
import std::test::error;
import std::test::assert;

![test]
function condvar_notify_with_no_waiters_is_noop() -> Result<(), TestError> {
    // notify_one / notify_all on a condvar nobody is waiting on must return
    // immediately (a lost wakeup is the defined behavior, not a hang).
    mut cv: CondVar = CondVar::new();
    cv.notify_one();
    cv.notify_all();
    cv.notify_one();
    cv.drop();
    // Reaching here means none of the notifies blocked or crashed.
    return Result::Ok(());
}

![test]
function condvar_try_new_succeeds() -> Result<(), TestError> {
    match (CondVar::try_new()) {
        Result::Ok(cv) => {
            mut c: CondVar = cv;
            c.notify_all();
            c.drop();
            return Result::Ok(());
        }
        Result::Err(_) => {
            return bail(Str::new("CondVar::try_new must succeed under normal conditions"));
        }
    }
}
