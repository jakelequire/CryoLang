///! `BufferedStream<TlsStream>` — the SAME buffered connection as `BufferedStream<TcpStream>`,
///! over an encrypted transport instead of a plaintext one.
///!
///! That is the claim under test, and it is the whole point of the
///! `AsyncTransport` seam: the buffering, the compaction, the short-write
///! requeue and every `AsyncRead`/`AsyncWrite` default body are written once and
///! reused, so a TLS connection is not a second implementation to keep in step.
///! The framing exercised here is deliberately identical to `net_tcp_conn`'s —
///! a CRLF-framed header line followed by a fixed-length body, read through ONE
///! buffer — so a divergence between the two transports shows up as one of these
///! failing while its twin passes.
///!
///! Both sides run as tasks on ONE `Executor`: a TLS handshake is bidirectional,
///! and only because each side parks instead of blocking can they complete
///! without a thread.
///!
///! Requires `ssl` + `crypto` in `tests/cryoconfig` link_libs and the fixture
///! cert/key under `fixtures/tls/` (cwd is the `tests/` project root when
///! `cryo test` runs).

![config(testing)]
namespace CryoTests::Tests::Stdlib::NetTlsConn;

import std::core::option::{ Option };
import std::core::result::{ Result };
import std::core::drop;
import std::core::slice::{ Slice };
import std::collections::str::{ Str };
import std::collections::string::{ String };
import std::collections::array::{ Array };
import std::future;
import std::io::error::{ IoError, IoErrorKind };
import std::io::traits;
import std::io::buffered::{ BufferedStream };
import std::net::address::socket_address::{ SocketAddress };
import std::net::socket::tcp::{ TcpListener, TcpStream };
import std::net::tls::context::{ TlsAcceptor, TlsConnector };
import std::net::tls::stream::{ TlsStream };
import std::test::error::{ TestError };
import std::test::assert::{ bail, expect_equal };
import std::time::duration::{ Duration };
import std::future::combinator::{ Futures };
import std::core::pair::{ Pair };
import std::future::executor::{ Executor };

// Every failure is a distinct negative number so a red test names its own step.

function ntls_bytes_eq(a: &Array<u8>, text: string) -> boolean {
    const b: &Slice<u8> = Str::new(text).as_bytes();
    if (a.length() != b.length()) { return false; }
    mut i: i64 = 0;
    while (i < a.length()) {
        mut x: u8 = 0;
        mut y: u8 = 1;
        match (a.get(i)) { Option::Some(v) => { x = v; } Option::None => { } }
        match (b.get(i)) { Option::Some(v) => { y = v; } Option::None => { } }
        if (x != y) { return false; }
        i = i + 1;
    }
    return true;
}

/// Accept one connection, complete the handshake, then read a `NAME len\r\n`
/// header line plus exactly `len` body bytes and answer with the same framing.
/// Both reads come out of the one connection buffer.
async function ntls_serve(listener: TcpListener, acceptor: TlsAcceptor) -> i64 {
    mut server: TcpListener = listener;
    const sock: TcpStream = match (await server.accept()) {
        Result::Ok(s)  => { s }
        Result::Err(_) => { return -1; }
    };

    const ac: TlsAcceptor = acceptor;
    const tls: TlsStream = match (await ac.accept(sock)) {
        Result::Ok(t)  => { t }
        Result::Err(_) => { return -3; }
    };
    mut c: BufferedStream<TlsStream> = BufferedStream::<TlsStream>::of(tls);

    mut head: String = match (await c.read_line(256)) {
        Result::Ok(v)  => { v }
        Result::Err(_) => { return -4; }
    };
    if (head.as_str() != Str::new("ECHO 5")) { return -5; }

    // A TLS record carries the header and the body together, so the body is
    // already buffered: reading it must come out of the SAME buffer rather than
    // off the wire again.
    mut body: Array<u8> = match (await c.read_exact(5)) {
        Result::Ok(v)  => { v }
        Result::Err(_) => { return -6; }
    };
    if (!ntls_bytes_eq(&body, "HELLO")) { return -7; }

    match (c.queue::<string>("BACK 5\r\n"))       { Result::Ok(_) => { } Result::Err(_) => { return -8; } }
    match (c.queue::<&Slice<u8>>(body.as_slice())) { Result::Ok(_) => { } Result::Err(_) => { return -9; } }
    match (await c.flush())                     { Result::Ok(_) => { } Result::Err(_) => { return -10; } }
    return 5;
}

async function ntls_client(port: u16, connector: TlsConnector) -> i64 {
    const sock: TcpStream = match (await TcpStream::connect(SocketAddress::localhost_v4(port))) {
        Result::Ok(s)  => { s }
        Result::Err(_) => { return -20; }
    };

    const cn: TlsConnector = connector;
    const tls: TlsStream = match (await cn.connect(sock, Str::new("localhost"))) {
        Result::Ok(t)  => { t }
        Result::Err(_) => { return -22; }
    };
    mut c: BufferedStream<TlsStream> = BufferedStream::<TlsStream>::of(tls);

    match (c.queue::<string>("ECHO 5\r\nHELLO")) { Result::Ok(_) => { } Result::Err(_) => { return -23; } }
    match (await c.flush())                    { Result::Ok(_) => { } Result::Err(_) => { return -24; } }

    mut head: String = match (await c.read_line(256)) {
        Result::Ok(v)  => { v }
        Result::Err(_) => { return -25; }
    };
    if (head.as_str() != Str::new("BACK 5")) { return -26; }

    mut body: Array<u8> = match (await c.read_exact(5)) {
        Result::Ok(v)  => { v }
        Result::Err(_) => { return -27; }
    };
    if (!ntls_bytes_eq(&body, "HELLO")) { return -28; }
    return 5;
}

async function ntls_round_trip(port: u16, listener: TcpListener,
                               acceptor: TlsAcceptor, connector: TlsConnector) -> i64 {
    const pair: Pair<i64, i64> = await Futures::join(ntls_serve(listener, acceptor),
                                                  ntls_client(port, connector));
    if (pair.first != 5) { return pair.first; }
    if (pair.second != 5) { return pair.second; }
    return 0;
}

![test]
function tls_conn_framed_round_trip() -> Result<(), TestError> {
    mut acceptor: TlsAcceptor = match (TlsAcceptor::new(Str::new("fixtures/tls/cert.pem"),
                                                        Str::new("fixtures/tls/key.pem"))) {
        Result::Ok(a)  => { a }
        Result::Err(_) => { return bail(Str::new("TlsAcceptor::new failed (fixture cert/key)")); }
    };
    // The fixture certificate is self-signed, so the client cannot verify it.
    mut connector: TlsConnector = match (TlsConnector::new()) {
        Result::Ok(c)  => { c.danger_accept_invalid_certificates() }
        Result::Err(_) => { return bail(Str::new("TlsConnector::new failed")); }
    };

    const listener: TcpListener = match (TcpListener::bind(SocketAddress::localhost_v4(0))) {
        Result::Ok(v)  => { v }
        Result::Err(_) => {
            return bail(Str::new("bind 127.0.0.1:0 failed"));
        }
    };
    const port: u16 = match (listener.local_address()) {
        Result::Ok(a)  => { a.port }
        Result::Err(_) => {
            return bail(Str::new("local_address failed"));
        }
    };

    mut ex: Executor = Executor::new();
    const r: i64 = ex.block_on(ntls_round_trip(port, listener, acceptor, connector));
    return expect_equal(r, 0 as i64);
}

/// The client handshake for `hostname`, on a connector and a socket this
/// future owns, so a deadline that drops it drops both.
async function ntls_connect_owned(connector: TlsConnector, sock: TcpStream, hostname: String)
        -> Result<TlsStream, IoError> {
    const cn: TlsConnector = connector;
    const name: String = hostname;
    return await cn.connect(sock, name.as_str());
}

/// Connect to `port` and start the client side for `hostname` against a
/// listener that never answers: 0 when `connect` refuses the name before any
/// handshake (`InvalidInput`), 1 when it accepts the name and the handshake is
/// still waiting on the peer when the deadline drops it.
async function ntls_start_for(port: u16, connector: TlsConnector, hostname: String) -> i64 {
    const sock: TcpStream = match (await TcpStream::connect(SocketAddress::localhost_v4(port))) {
        Result::Ok(s)  => { s }
        Result::Err(_) => { return -1; }
    };
    match (await Futures::timeout(Duration::from_milliseconds(200),
                                  ntls_connect_owned(connector, sock, hostname))) {
        Result::Ok(outcome) => {
            match (outcome) {
                Result::Ok(_) => { return -2; }
                Result::Err(e) => {
                    if (e.kind == IoErrorKind::InvalidInput) { return 0; }
                    return -3;
                }
            }
        }
        Result::Err(_) => { return 1; }
    }
}

![test]
function tls_connect_refuses_a_name_it_cannot_set() -> Result<(), TestError> {
    // OpenSSL takes no server name longer than 255 bytes. Connecting anyway
    // would send none, and would verify the chain but not the name.
    const listener: TcpListener = match (TcpListener::bind(SocketAddress::localhost_v4(0))) {
        Result::Ok(v)  => { v }
        Result::Err(_) => { return bail(Str::new("bind 127.0.0.1:0 failed")); }
    };
    const port: u16 = match (listener.local_address()) {
        Result::Ok(a)  => { a.port }
        Result::Err(_) => { return bail(Str::new("local_address failed")); }
    };
    mut ex: Executor = Executor::new();

    mut long_name: String = String::new();
    long_name.push_repeated('a', 300);
    const refused: i64 = match (TlsConnector::new()) {
        Result::Ok(c)  => { ex.block_on(ntls_start_for(port, c, long_name)) }
        Result::Err(_) => { return bail(Str::new("TlsConnector::new failed")); }
    };
    expect_equal(refused, 0 as i64)?;

    const accepted: i64 = match (TlsConnector::new()) {
        Result::Ok(c)  => { ex.block_on(ntls_start_for(port, c, String::from_str(Str::new("localhost")))) }
        Result::Err(_) => { return bail(Str::new("TlsConnector::new failed")); }
    };
    return expect_equal(accepted, 1 as i64);
}
