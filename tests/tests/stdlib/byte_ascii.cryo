///! ASCII classification and case folding of a byte, and the one whitespace
///! set both trims use.

![config(testing)]
namespace CryoTests::Tests::Stdlib::ByteAscii;

import std::core::result::{ Result };
import std::collections::str::{ Str };
import std::test::error::{ TestError };
import std::test::assert::{ expect_eq };

![test]
function byte_classification_matches_char() -> Result<(), TestError> {
    mut code: u32 = 0;
    while (code < 256) {
        const byte: u8 = code as u8;
        const scalar: char = code as char;
        expect_eq(byte.is_digit(), scalar.is_digit())?;
        expect_eq(byte.is_alpha(), scalar.is_alpha())?;
        expect_eq(byte.is_hex_digit(), scalar.is_hex_digit())?;
        expect_eq(byte.is_whitespace(), scalar.is_whitespace())?;
        expect_eq(byte.is_uppercase(), scalar.is_uppercase())?;
        expect_eq(byte.is_lowercase(), scalar.is_lowercase())?;
        expect_eq(byte.is_uppercase() || byte.is_lowercase(), byte.is_alpha())?;
        expect_eq(byte.to_ascii_lowercase() as u32, scalar.to_ascii_lowercase() as u32)?;
        expect_eq(byte.to_ascii_uppercase() as u32, scalar.to_ascii_uppercase() as u32)?;
        code += 1;
    }
    return Result::Ok(());
}

![test]
function byte_classification_edges() -> Result<(), TestError> {
    const slash: u8 = 0x2F;
    const zero: u8 = 0x30;
    const nine: u8 = 0x39;
    const colon: u8 = 0x3A;
    expect_eq(slash.is_digit(), false)?;
    expect_eq(zero.is_digit(), true)?;
    expect_eq(nine.is_digit(), true)?;
    expect_eq(colon.is_digit(), false)?;
    const upper_f: u8 = 0x46;
    const upper_g: u8 = 0x47;
    expect_eq(upper_f.is_hex_digit(), true)?;
    expect_eq(upper_g.is_hex_digit(), false)?;
    expect_eq(upper_g.is_alpha(), true)?;
    const vertical_tab: u8 = 0x0B;
    const form_feed: u8 = 0x0C;
    const high: u8 = 0xC3;
    expect_eq(vertical_tab.is_whitespace(), true)?;
    expect_eq(form_feed.is_whitespace(), true)?;
    expect_eq(high.is_whitespace(), false)?;
    expect_eq(high.is_alpha(), false)?;
    expect_eq(high.to_ascii_lowercase(), high)?;
    const upper_z: u8 = 0x5A;
    const lower_z: u8 = 0x7A;
    expect_eq(upper_z.to_ascii_lowercase(), lower_z)?;
    expect_eq(lower_z.to_ascii_lowercase(), lower_z)?;
    const at_sign: u8 = 0x40;
    const left_bracket: u8 = 0x5B;
    const backtick: u8 = 0x60;
    const left_brace: u8 = 0x7B;
    expect_eq(at_sign.is_uppercase(), false)?;
    expect_eq(upper_z.is_uppercase(), true)?;
    expect_eq(left_bracket.is_uppercase(), false)?;
    expect_eq(backtick.is_lowercase(), false)?;
    expect_eq(lower_z.is_lowercase(), true)?;
    expect_eq(left_brace.is_lowercase(), false)?;
    expect_eq(upper_z.is_lowercase(), false)?;
    expect_eq(lower_z.is_uppercase(), false)?;
    expect_eq('\u{C9}'.is_uppercase(), false)?;
    expect_eq('\u{E9}'.is_lowercase(), false)?;
    return Result::Ok(());
}

![test]
function string_trim_strips_vertical_tab_and_form_feed() -> Result<(), TestError> {
    const text: string = "\v\f hi \f\v";
    expect_eq(Str::new(text.trim()), Str::new("hi"))?;
    expect_eq(Str::new(text).trim(), Str::new("hi"))?;
    return Result::Ok(());
}
