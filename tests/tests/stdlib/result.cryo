///! Result<T, E> - is_ok/is_err/unwrap, ok()/err() projection, contains.

![config(testing)]
namespace CryoTests::Tests::Stdlib::ResultT;

import std::core::result::{ Result };
import std::core::option::{ Option };
import std::collections::str::{ Str };
import std::collections::string::{ String };
import std::test::error::{ TestError };
import std::test::assert::{ bail, expect, expect_equal };

![test]
function ok_is_ok() -> Result<(), TestError> {
    const r: Result<i32, i32> = Result::Ok(7);
    match (expect(r.is_ok(), Str::new("Ok should be is_ok"))) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    match (expect(!r.is_err(), Str::new("Ok should not be is_err"))) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

![test]
function err_is_err() -> Result<(), TestError> {
    const r: Result<i32, i32> = Result::Err(-1);
    match (expect(r.is_err(), Str::new("Err should be is_err"))) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    match (expect(!r.is_ok(), Str::new("Err should not be is_ok"))) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

![test]
function unwrap_ok_yields_value() -> Result<(), TestError> {
    const r: Result<i32, i32> = Result::Ok(123);
    match (expect_equal(r.unwrap(), 123)) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

![test]
function unwrap_or_ok_returns_inner() -> Result<(), TestError> {
    const r: Result<i32, i32> = Result::Ok(5);
    match (expect_equal(r.unwrap_or(99), 5)) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

![test]
function unwrap_or_err_returns_default() -> Result<(), TestError> {
    const r: Result<i32, i32> = Result::Err(-1);
    match (expect_equal(r.unwrap_or(99), 99)) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

![test]
function ok_projection_some() -> Result<(), TestError> {
    const r: Result<i32, i32> = Result::Ok(8);
    const opt: Option<i32> = r.ok();
    match (expect(opt.is_some(),
        Str::new("Ok(8).ok() should yield Some"))) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    match (expect_equal(opt.unwrap_or(0), 8)) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

![test]
function err_projection_none() -> Result<(), TestError> {
    const r: Result<i32, i32> = Result::Err(-1);
    const opt: Option<i32> = r.ok();
    match (expect(opt.is_none(),
        Str::new("Err.ok() should yield None"))) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

![test]
function contains_matches() -> Result<(), TestError> {
    const r: Result<i32, i32> = Result::Ok(11);
    const probe: i32 = 11;
    match (expect(r.contains(&probe),
        Str::new("Ok(11).contains(&11) should be true"))) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

![test]
function contains_err_matches() -> Result<(), TestError> {
    const r: Result<i32, i32> = Result::Err(-99);
    const probe: i32 = -99;
    match (expect(r.contains_err(&probe),
        Str::new("Err(-99).contains_err(&-99) should be true"))) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

![test]
![should_panic]
function unwrap_err_panics() -> Result<(), TestError> {
    const r: Result<i32, i32> = Result::Err(-1);
    const _value: i32 = r.unwrap();
    return Result::Ok(());
}

// `Result::unwrap` takes its receiver by value, so the call moves `r`;
// were `r` also released at scope exit, the buffer the unwrapped `String`
// now owns would be freed twice, which SIGABRTs.
![test]
function unwrap_on_owning_ok_payload_no_double_free() -> Result<(), TestError> {
    const r: Result<String, i32> = Result::Ok(String::from_str(Str::new("payload")));
    mut s: String = r.unwrap();
    const len: i64 =s.length();
    const want: i64 =7;
    match (expect_equal(len, want)) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

// `as_mutable_reference` borrows both payloads IN PLACE: the returned pointer
// aliases the receiver's payload, not a copy.  Writing through it changes
// the original `Result`.  Soundness pin for the borrowing accessors.
![test]
function as_mutable_reference_ok_aliases_in_place() -> Result<(), TestError> {
    mut r: Result<i32, i32> = Result::Ok(7);
    match (r.as_mutable_reference()) {
        Result::Ok(p) => { *p = 70; }
        Result::Err(_) => { return bail(Str::new("as_mutable_reference on Ok gave Err")); }
    }
    return expect_equal(r.unwrap(), 70);
}

![test]
function as_mutable_reference_err_aliases_in_place() -> Result<(), TestError> {
    mut r: Result<i32, i32> = Result::Err(3);
    match (r.as_mutable_reference()) {
        Result::Ok(_) => { return bail(Str::new("as_mutable_reference on Err gave Ok")); }
        Result::Err(p) => { *p = 30; }
    }
    return expect_equal(r.unwrap_err(), 30);
}

// The read-only borrow reads the payload in place.
![test]
function as_reference_err_reads_in_place() -> Result<(), TestError> {
    const r: Result<i32, i32> = Result::Err(5);
    match (r.as_reference()) {
        Result::Ok(_) => { return bail(Str::new("as_reference on Err gave Ok")); }
        Result::Err(p) => { return expect_equal(*p, 5); }
    }
}

// `as_reference` does not consume an owning `Ok` payload: the receiver still
// owns the `String` afterwards (unwrapped + dropped exactly once).
![test]
function as_reference_owning_ok_does_not_consume() -> Result<(), TestError> {
    mut r: Result<String, i32> = Result::Ok(String::from_str(Str::new("payload")));
    const ok: boolean = r.as_reference().is_ok();
    mut s: String = r.unwrap();
    const len: i64 =s.length();
    match (expect(ok, Str::new("as_reference on Ok(String) is Ok"))) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    const want: i64 =7;
    return expect_equal(len, want);
}
