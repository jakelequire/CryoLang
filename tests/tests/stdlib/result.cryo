///! Result<T, E> — is_ok/is_err/unwrap, ok()/err() projection, contains.

![config(testing)]
namespace CryoTests::Tests::Stdlib::ResultT;

import std::core::result;
import std::core::option;
import std::test::error;
import std::test::assert;

![test]
function ok_is_ok() -> Result<(), TestError> {
    const r: Result<i32, i32> = Result::Ok(7);
    match (expect(r.is_ok(), Str::new("Ok should be is_ok"))) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    match (expect(!r.is_err(), Str::new("Ok should not be is_err"))) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

![test]
function err_is_err() -> Result<(), TestError> {
    const r: Result<i32, i32> = Result::Err(-1);
    match (expect(r.is_err(), Str::new("Err should be is_err"))) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    match (expect(!r.is_ok(), Str::new("Err should not be is_ok"))) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

![test]
function unwrap_ok_yields_value() -> Result<(), TestError> {
    const r: Result<i32, i32> = Result::Ok(123);
    match (expect_eq(r.unwrap(), 123)) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

![test]
function unwrap_or_ok_returns_inner() -> Result<(), TestError> {
    const r: Result<i32, i32> = Result::Ok(5);
    match (expect_eq(r.unwrap_or(99), 5)) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

![test]
function unwrap_or_err_returns_default() -> Result<(), TestError> {
    const r: Result<i32, i32> = Result::Err(-1);
    match (expect_eq(r.unwrap_or(99), 99)) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

![test]
function ok_projection_some() -> Result<(), TestError> {
    const r: Result<i32, i32> = Result::Ok(8);
    const opt: Option<i32> = r.ok();
    match (expect(opt.is_some(),
        Str::new("Ok(8).ok() should yield Some"))) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    match (expect_eq(opt.unwrap_or(0), 8)) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

![test]
function err_projection_none() -> Result<(), TestError> {
    const r: Result<i32, i32> = Result::Err(-1);
    const opt: Option<i32> = r.ok();
    match (expect(opt.is_none(),
        Str::new("Err.ok() should yield None"))) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

![test]
function contains_matches() -> Result<(), TestError> {
    const r: Result<i32, i32> = Result::Ok(11);
    const probe: i32 = 11;
    match (expect(r.contains(&probe),
        Str::new("Ok(11).contains(&11) should be true"))) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

![test]
function contains_err_matches() -> Result<(), TestError> {
    const r: Result<i32, i32> = Result::Err(-99);
    const probe: i32 = -99;
    match (expect(r.contains_err(&probe),
        Str::new("Err(-99).contains_err(&-99) should be true"))) {
        Result::Ok(_) => { }
        Result::Err(e) => { return Result::Err(e); }
    }
    return Result::Ok(());
}

![test]
![should_panic]
function unwrap_err_panics() -> Result<(), TestError> {
    const r: Result<i32, i32> = Result::Err(-1);
    const _value: i32 = r.unwrap();
    return Result::Ok(());
}
