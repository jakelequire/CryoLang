// E0308: a trait is implemented twice for the same type. The dispatcher
// can only pick one impl, so the second is a silent footgun; coherence
// rejects it.
![config(testing)]
![config(negative, E0308)]
namespace CryoTests::Negative::E0308ConflictingTraitImpl;

type trait Greet { greet(&this) -> int; }
type struct Foo { x: int; }

implement trait Greet for struct Foo { greet(&this) -> int { return 1; } }
implement trait Greet for struct Foo { greet(&this) -> int { return 2; } }

function main() -> int { return 0; }
