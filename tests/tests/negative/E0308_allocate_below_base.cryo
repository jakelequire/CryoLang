// E0308: a class with a base class cannot implement `Allocate`.  `delete`
// through a pointer to the base releases through the base's allocator - an
// ancestor's implementation, or the global one when there is none - which
// did not hand out the memory.  Only the root of a hierarchy implements it,
// and every class below uses that implementation.
![config(testing)]
![config(negative, E0308)]
namespace CryoTests::Negative::AllocateBelowBase;

import std::ffi::libc;

type class Base {
public:
    a: i32;
    Base(a: i32) { this.a = a; }
}

type class Arena : Base {
public:
    Arena() : Base(1) { }
}

implement trait Allocate for class Arena {  //~ ERROR[E0308] `CryoTests::Negative::AllocateBelowBase::Arena` cannot implement `Allocate`: it derives from `CryoTests::Negative::AllocateBelowBase::Base`, and `delete` through a `CryoTests::Negative::AllocateBelowBase::Base*` releases through `CryoTests::Negative::AllocateBelowBase::Base`'s allocator
    static allocate(size: u64, align: u64) -> void* { return libc::malloc(size); }
}

type class Top {
public:
    t: i32;
    Top() { this.t = 0; }
}

implement trait Allocate for class Top {
    static allocate(size: u64, align: u64) -> void* { return libc::malloc(size); }
}

type class Mid : Top {
public:
    Mid() : Top() { }
}

implement trait Allocate for class Mid {  //~ ERROR[E0308] `CryoTests::Negative::AllocateBelowBase::Mid` cannot implement `Allocate`: it derives from `CryoTests::Negative::AllocateBelowBase::Top`, and `delete` through a `CryoTests::Negative::AllocateBelowBase::Top*` releases through `CryoTests::Negative::AllocateBelowBase::Top`'s allocator
    static allocate(size: u64, align: u64) -> void* { return libc::malloc(size); }
}

function main() -> int {
    const p: Base* = new Arena() as Base*;
    delete p;
    const q: Top* = new Mid() as Top*;
    delete q;
    return 0;
}
