// E0204: a field read through a type parameter names nothing in the generic
// body.  A bound gives a parameter methods, never fields, so `this.tag.n` is
// refused where it is written - even though every copy this program asks for
// has an `A` that declares `n`, and even with no copy at all.
![config(testing)]
![config(negative, E0204)]
namespace CryoTests::Negative::FieldThroughTypeParameter;

type struct Tag { n: i32; }

type trait Named { name(&this) -> i32; }

type struct Cell<T, A> {
    value: T;
    tag:   A;
}

implement struct Cell<T, A> {
    tagged(&this) -> i32 { return this.tag.n; }   //~ ERROR[E0204] no field `n` on type `A`
}

type struct Bounded<B> where B: Named {
    inner: B;
    read(&this) -> i32 { return this.inner.n; }   //~ ERROR[E0204] no field `n` on type `B`
}

function main() -> int {
    const c: Cell<i32, Tag> = Cell::<i32, Tag> { value: 1, tag: Tag { n: 7 } };
    return c.tagged();
}
