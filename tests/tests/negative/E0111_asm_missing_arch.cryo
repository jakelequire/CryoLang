// E0111: an `asm { ... }` block requires a mandatory
// `![arch(<arch>, <dialect>)]` directive above it (it selects the target
// arch for gating and the assembly dialect).  Omitting it is an error,
// caught in sema (sema/sema.cryo visit(AsmBlockStmtNode*)).
![config(testing)]
![config(negative, E0111)]
namespace CryoTests::Negative::E0111AsmMissingArch;

function main() -> int {
    mut a: i64 = 1;
    asm { add ${+a}, ${a} }
    return 0;
}
