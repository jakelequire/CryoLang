// E0009: an octal literal whose only body is a separator (`0o_`). Same
// silent-0 hazard as the hex/binary cases. The lexer requires at least one
// real octal digit.
![config(testing)]
![config(negative, E0009)]
namespace CryoTests::Negative::EmptyOctalUnderscore;

function main() -> int {
    const x: i32 = 0o_;   //~ ERROR[E0009] Invalid octal number
    return 0;
}
