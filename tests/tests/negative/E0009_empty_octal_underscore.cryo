// E0009: an octal literal whose only body is a separator (`0o_`). Same
// silent-0 bug as the hex/binary cases. The lexer now requires at least one
// real octal digit.
![config(testing)]
![config(negative, E0009)]
namespace CryoTests::Negative::EmptyOctalUnderscore;

function main() -> int {
    const x: i32 = 0o_;
    return 0;
}
