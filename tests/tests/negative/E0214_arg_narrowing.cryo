// E0214: a call argument whose (runtime) type narrows the parameter must be
// rejected. `i64 -> u8` would silently truncate (5 stays 5 here, but 300 would
// become 44); the spec (section 2.9) requires an explicit `as` cast.
![config(testing)]
![config(negative, E0214)]
namespace CryoTests::Negative::E0214ArgNarrowing;

function cf_take_u8(v: u8) -> void {}

function main() -> int {
    const big: i64 = 5;
    cf_take_u8(big);
    return 0;
}
