///! A primitive trait is had by the built-in value types the compiler's
///! rule names and by nothing else, so an `implement` of one is refused:
///! for another type, which would slip past a `static match` over the
///! trait's types, and for a built-in type, which has it already.

![config(testing)]
![config(negative, E0312)]
namespace CryoTests::Negative::E0312PrimitiveTraitImplemented;

type struct Meters {
    value: i64;
}

implement trait Integer for Meters { }
//~^ ERROR[E0312] `Integer` cannot be implemented: it is a primitive trait, which only the built-in types have

implement trait Float for f64 { }
//~^ ERROR[E0312] `Float` cannot be implemented: it is a primitive trait, which only the built-in types have

function main() -> i32 {
    const m: Meters = Meters { value: 3 };
    return m.value as i32;
}
