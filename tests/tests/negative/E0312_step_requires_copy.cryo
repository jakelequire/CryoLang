// A range hands out copies of its ends, so a type it walks is `Copy`:
// `Step` is `Ord + Copy`, and a type owning a `String` cannot implement it.
![config(testing)]
![config(negative, E0312)]
namespace CryoTests::Negative::StepRequiresCopy;

import std::core::ops::{ Step };
import std::core::cmp::{ Ord, Ordering, Eq };
import std::collections::string::{ String };

type struct Label {
    text: String;
}

implement trait Eq for struct Label {
    equals(&this, other: &Label) -> boolean { return true; }
}

implement trait Ord for struct Label {
    compare(&this, other: &Label) -> Ordering { return Ordering::Equal; }
}

implement trait Step for struct Label {
//~^ ERROR[E0312] `CryoTests::Negative::StepRequiresCopy::Label` does not implement `std::core::marker::Copy`, which `std::core::ops::Step` requires, so `CryoTests::Negative::StepRequiresCopy::Label` cannot implement `std::core::ops::Step`
    successor(&this) -> Label { return Label { text: this.text.clone() }; }
    predecessor(&this) -> Label { return Label { text: this.text.clone() }; }
}

function main() -> int {
    return 0;
}
