// E0358: HashMap::get is gated `where V: Copy`, so calling it on a map
// with an owning (non-Copy) value type must not resolve. This guards the
// copy-out double-free fix: a bitwise get of a non-Copy String would
// alias the map's heap buffer.
![config(testing)]
![config(negative, E0358)]
namespace CryoTests::Negative::HashMapGetNonCopy;
import std::collections::hashmap;
import std::collections::string;
import std::collections::str;
function main() -> int {
    mut m: HashMap<i32, String> = HashMap::new();
    mut v: String = String::new();
    v.push("owning value");
    m.insert(1, v);
    match (m.get(&1)) {
        Option::Some(mut got) => { got.drop(); }
        Option::None => { }
    }
    m.drop();
    return 0;
}
