// A struct literal whose type name is refused - unbound, or a generic alias -
// is reported once, where the name is written.  The literal has no type, and
// neither has the unannotated local it initializes, so reading a field of
// that local reports nothing more: no second error naming `void`, a type the
// program never wrote.
![config(testing)]
![config(negative, E0203)]
namespace CryoTests::Negative::RefusedStructLiteralNameNoCascade;

type struct RlPair<A, B> { first: A; second: B; }
type RlKeyed<T> = RlPair<T, i64>;

function main() -> int {
    const k = RlNope { first: true, second: 3 };          //~ ERROR[E0203] cannot find type `RlNope`
    const g = RlKeyed::<boolean> { first: true, second: 3 }; //~ ERROR[E0233] generic type alias
    return (k.second + g.second) as int;
}
