// Compile-fail test: a generic call with arguments, none of which fixes a
// type parameter the callee declares, cannot infer it, and is refused at
// the call rather than reaching code generation with no function to call.
// The call writing the type argument, and the one whose expected type
// fixes it, are the controls.
![config(testing)]
![config(negative, E0307)]
namespace CryoTests::Negative::E0307GenericParameterNoArgumentFixes;

function width_of<T>(count: i64) -> i64 {
    return count;
}

function zeroed<T>(count: i64) -> T* {
    return null;
}

function main() -> int {
    const a: i64 = width_of(3);   //~ ERROR[E0307]
    const b: i64 = width_of::<u64>(3);
    const c: u64* = zeroed(3);
    return 0;
}
