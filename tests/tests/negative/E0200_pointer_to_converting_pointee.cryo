// A pointer converts to another pointer type without a cast only when it
// points at the same type, `void` is on either side, or it is a class to its
// base.  A pointee that merely converts (`i32` to `i64`, `f32` to `f64`,
// `i32*` to `i64*` one level down) is refused wherever the pointer meets a
// declared type: an initializer, an assignment, a `return` and a field.
![config(testing)]
![config(negative, E0200)]
namespace CryoTests::Negative::PointerToConvertingPointee;

type struct PtHolder { p: i64*; }

function pt_widen(q: i32*) -> i64* {
    return q;                                                       //~ ERROR[E0200] mismatched types
}

function main() -> int {
    mut n: i32 = 3;
    const q: i32* = &n;
    const qq: i32** = &q;
    mut f: f32 = 1.5;
    const fp: f32* = &f;
    const p: i64* = q;                                              //~ ERROR[E0200] mismatched types
    mut later: i64* = null;
    later = q;                                                      //~ ERROR[E0200] mismatched types
    const d: f64* = fp;                                             //~ ERROR[E0200] mismatched types
    const pp: i64** = qq;                                           //~ ERROR[E0200] mismatched types
    const h: PtHolder = PtHolder { p: q };                          //~ ERROR[E0200] mismatched types
    return (*p + *later + *d as i64 + **pp + *h.p + *pt_widen(q)) as int;
}
