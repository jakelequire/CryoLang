// E0464: a shift whose amount is a constant at or above the width of the
// value shifted, or negative, panics whenever it runs, so it is refused where
// it is written.  A constant below the width, and an amount only known at run
// time, are accepted.
![config(testing)]
![config(negative, E0464)]
namespace CryoTests::Negative::ConstantShiftOutOfRange;

const SPREAD: i64 = 70;

function amount() -> i64 { return 3; }

function main() -> i32 {
    const wide: u64 = 1;
    const narrow: u8 = 1;
    const signed: i32 = -8;
    const a: u64 = wide << 64;
    //~^ ERROR[E0464] shift amount 64 is not less than the width of `u64` (64)
    const b: u8 = narrow >> 8;
    //~^ ERROR[E0464] shift amount 8 is not less than the width of `u8` (8)
    const c: u64 = wide << SPREAD;
    //~^ ERROR[E0464] shift amount 70 is not less than the width of `u64` (64)
    const d: u64 = wide << -1;
    //~^ ERROR[E0464] shift amount -1 is negative
    const e: i32 = signed >> (16 + 16);
    //~^ ERROR[E0464] shift amount 32 is not less than the width of `i32` (32)
    mut f: u64 = 1;
    f <<= 64;
    //~^ ERROR[E0464] shift amount 64 is not less than the width of `u64` (64)

    // Controls.
    const g: u64 = wide << 63;
    const h: u64 = wide << (u64::BITS - 1);
    const i: u64 = wide << amount();
    return (a + b as u64 + c + d + e as u64 + f + g + h + i) as i32;
}
