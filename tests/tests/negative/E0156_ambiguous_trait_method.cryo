// E0156: a bare method call is ambiguous when the same-named method is
// provided by two different traits implemented for the receiver, and no
// bound-directed context picks one. `P` implements both `Shown::fmt` and
// `Dumped::fmt`, so `p.fmt(&sink)` can't choose; without this check it would
// silently dispatch to whichever trait registered first. (A `T: Shown`-
// bounded receiver is disambiguated by bound-directed dispatch and stays
// legal.)
![config(testing)]
![config(negative, E0156)]
namespace CryoTests::Negative::AmbiguousTraitMethod;

type trait Shown  { fmt<W>(&this, w: &W) -> i32; }
type trait Dumped { fmt<W>(&this, w: &W) -> i32; }

type struct P { x: i32; }

implement trait Shown for P {
    fmt<W>(&this, w: &W) -> i32 { return 111; }
}
implement trait Dumped for P {
    fmt<W>(&this, w: &W) -> i32 { return 222; }
}

function main() -> int {
    const p: P = P { x: 1 };
    mut sink: i32 = 0;
    const r: i32 = p.fmt(&sink);   //~ ERROR[E0156] `fmt` is provided by more than one trait implemented for `P`
    return r;
}
