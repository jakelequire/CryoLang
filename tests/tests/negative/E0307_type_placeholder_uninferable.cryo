// E0307: a call with no arguments whose type parameter nothing binds - not
// its type arguments, which leave it to inference with `_` or by writing
// none, and not the type its result is expected to have - is refused at the
// call, at the `_` where one is written, rather than reaching code
// generation with no function to call.
![config(testing)]
![config(negative, E0307)]
namespace CryoTests::Negative::TypePlaceholderUninferable;

function make_default<T>() -> i32 { return 0; }

function main() -> int {
    const placeholder: i32 = make_default::<_>();
    //~^ ERROR[E0307] cannot infer the type argument `T` for `make_default`
    const bare: i32 = make_default();
    //~^ ERROR[E0307] cannot infer the type argument `T` for `make_default`
    return placeholder + bare;
}
