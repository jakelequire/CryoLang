// E0200: a `for` loop's binding is a declaration like any other, so its
// initializer is typed under the declared type and refused when it does not
// fit: `i32 = u64` narrows silently otherwise.
![config(testing)]
![config(negative, E0200)]
namespace CryoTests::Negative::E0200ForInitNarrowing;
function main() -> int {
    const s: string = "abc";
    mut n: i32 = 0;
    for (mut j: i32 = s.length(); j > 0; j--) { n = n + 1; }   //~ ERROR[E0200] mismatched types
    return n;
}
