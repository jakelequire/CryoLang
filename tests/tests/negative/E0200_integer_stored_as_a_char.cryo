// E0200: an integer is stored where a `char` is only through `as char`, as an
// initializer, an assignment, an element of a `char` array and a returned
// value.  A literal is no exception, the NUL terminator `0` included: a
// character is written in quotes, `'\0'`.
![config(testing)]
![config(negative, E0200)]
namespace CryoTests::Negative::IntegerStoredAsAChar;

function first(code: u32) -> char {
    return code;
    //~^ ERROR[E0200] mismatched types
}

function main() -> int {
    const byte: u8 = 65;
    const from_byte: char = byte;
    //~^ ERROR[E0200] mismatched types
    const from_literal: char = 66;
    //~^ ERROR[E0200] mismatched types
    mut c: char = 'a';
    c = 0x10FFFF;
    //~^ ERROR[E0200] mismatched types
    mut buf: [char; 3] = ['x', 'y', 'z'];
    buf[2] = 0;
    //~^ ERROR[E0200] mismatched types
    buf[1] = '\0';
    const converted: char = byte as char;
    if (from_byte == from_literal || c == converted || buf[0] != 'x') { return 1; }
    return (first(66) as int);
}
