// E0213: a call through a local, or through a field, whose type is no
// function.  `x(3)` with `x: i32` is refused at the callee rather than as a
// function that cannot be found, and `h.n(4)` with no method `n` and a field
// `n: i32` rather than as a method that cannot be found.  A local or a field
// that IS a function is called through (`g(6)`, `h.f(5)`).
![config(testing)]
![config(negative, E0213)]
namespace CryoTests::Negative::CallOfNonFunctionBinding;

type struct Holder {
    n: i32;
    f: (i32) -> i32;
}

function inc(x: i32) -> i32 { return x + 1; }

function main() -> int {
    const x: i32 = 3;
    const a: i32 = x(3);       //~ ERROR[E0213] expected function, found `i32`
    const h: Holder = Holder { n: 1, f: inc };
    const b: i32 = h.n(4);     //~ ERROR[E0213] expected function, found `i32`
    const c: i32 = h.f(5);
    const g: (i32) -> i32 = inc;
    const d: i32 = g(6);
    return a + b + c + d;
}
