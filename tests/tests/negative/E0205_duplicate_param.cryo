// E0205: two parameters of the same function share a name and must be
// rejected, not silently dropped by `Scope::insert` (debug log only) -
// `function f(x: i32, x: i32)` must not compile with the second `x` shadowed
// and unreachable. The matching VarDecl case is covered by
// E0205_duplicate_local.cryo; this exercises the parameter path
// (name_resolution declare-parameters loop).
![config(testing)]
![config(negative, E0205)]
namespace CryoTests::Negative::DuplicateParam;

function dup(x: i32, x: i32) -> i32 {   //~ ERROR[E0205] the parameter `x` is already
    return x;
}

function main() -> int {
    return dup(1, 2);
}
