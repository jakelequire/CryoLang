// E0318: a derived `FromJson` reads a `![json(skip)]` field, and a
// `![json(default)]` field whose member is absent, as its type's
// `default()`, so that type must have `Default`.  A type without one is
// refused at the field, and so is a type parameter, which the derived
// implementation bounds by `FromJson` alone.  A field with `Default` is the
// control, and a derived `ToJson` asks nothing of a skipped field.
![config(testing)]
![config(negative, E0318)]
namespace CryoTests::Negative::E0318DeriveJsonDefaultFieldLacksDefault;

import std::json::convert::{ FromJson, ToJson };

type struct JdHandle with [ToJson, FromJson] {
    raw: i64;
}

type struct JdSkipped with [ToJson, FromJson] {
    ![json(skip)]
    handle: JdHandle;   //~ ERROR[E0318] `JdSkipped` cannot derive `FromJson`: field `handle` is `![json(skip)]`, so it is read as its type's `default()`
    ![json(skip)]
    count: i64;
}

type struct JdDefaulted with [ToJson, FromJson] {
    ![json(default)]
    handle: JdHandle;   //~ ERROR[E0318] `JdDefaulted` cannot derive `FromJson`: field `handle` is `![json(default)]`, so it is read as its type's `default()`
}

type struct JdGeneric<T> with [ToJson, FromJson] {
    ![json(default)]
    value: T;   //~ ERROR[E0318] `JdGeneric` cannot derive `FromJson`: field `value` is `![json(default)]`, so it is read as its type's `default()`, and `T` does not implement `Default`
}

type struct JdOnlyWritten with [ToJson] {
    ![json(skip)]
    handle: JdHandle;
}

function main() -> i32 {
    return 0;
}
