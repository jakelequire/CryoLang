// E0102: an enum discriminant is an integer literal; a float literal in its
// place is refused rather than read as its integer part.
![config(testing)]
![config(negative, E0102)]
namespace CryoTests::Negative::E0102EnumDiscriminantFloat;

type enum Level {
    Low = 1.5;   //~ ERROR[E0102] expected integer literal after '=', found '1.5'
    High = 4;
}

function main() -> i32 {
    return Level::High as i32;
}
