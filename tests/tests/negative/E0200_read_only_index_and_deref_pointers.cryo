///! `Index::index` and `Deref::deref` take `&this` and hand out read-only
///! pointers, the standard library's implementations included: a writable
///! pointer into a container or a box comes from `index_mutable` or
///! `deref_mutable`, which take `mut &this`.

![config(testing)]
![config(negative, E0200)]
namespace CryoTests::Negative::E0200ReadOnlyIndexAndDerefPointers;

import std::alloc::box::{ Box };

function main() -> int {
    const boxed: Box<i32> = Box::new(1);
    const into_box: i32* = boxed.deref();
    //~^ ERROR[E0200] mismatched types
    const values: [i32] = [1, 2];
    const into_array: i32* = values.index(0 as u64);
    //~^ ERROR[E0200] mismatched types
    return *into_box + *into_array;
}
