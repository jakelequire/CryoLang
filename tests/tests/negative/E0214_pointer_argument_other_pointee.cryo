// A pointer argument binds a pointer parameter only when the pointee is the
// same type, `void*` is on either side, or the argument converts implicitly.
// A pointer to an unrelated struct is refused at every kind of call, as it is
// at a method call: a free function, a static function, a function reached
// through its module's path, a class constructor, a generic free function, a
// static function of a generic owner and a generic static function of a
// plain one.  The last is checked at all only as a function template of its
// own, which the `boolean` argument shows.
![config(testing)]
![config(negative, E0214)]
namespace CryoTests::Negative::PointerArgumentOtherPointee;

type struct PaA { x: i64; }
type struct PaB { y: f64; }

type class PaHolder {
public:
    a: PaA*;
    PaHolder(a: PaA*) { this.a = a; }
}

type struct PaS {
    static take_static(a: PaA*) -> i64 { return a.x; }
    static take_generic<T>(v: T, a: PaA*) -> i64 { return a.x; }
}

type struct PaG<T> {
    v: T;
    static take_owned(a: PaA*) -> i64 { return a.x; }
}

function pa_take(a: PaA*) -> i64 { return a.x; }

function pa_take_generic<T>(v: T, a: PaA*) -> i64 { return a.x; }

function main() -> int {
    const b: PaB* = new PaB { y: 1.5 };
    const r1: i64 = pa_take(b);                                              //~ ERROR[E0214] mismatched types
    const r2: i64 = PaS::take_static(b);                                     //~ ERROR[E0214] mismatched types
    const r3: i64 = CryoTests::Negative::PointerArgumentOtherPointee::pa_take(b); //~ ERROR[E0214] mismatched types
    const h: PaHolder* = new PaHolder(b);                                    //~ ERROR[E0214] mismatched types
    const r4: i64 = pa_take_generic(1, b);                                   //~ ERROR[E0214] mismatched types
    const r5: i64 = PaG::<i32>::take_owned(b);                               //~ ERROR[E0214] mismatched types
    const r6: i64 = PaS::take_generic(1, b);                                 //~ ERROR[E0214] mismatched types
    const r7: i64 = PaS::take_generic(1, true);                              //~ ERROR[E0214] mismatched types
    return (r1 + r2 + r3 + h.a.x + r4 + r5 + r6 + r7) as int;
}
