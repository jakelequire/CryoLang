// E0065: an enum discriminant is a compile-time integer; a float literal in
// its place is refused rather than read as its integer part.
![config(testing)]
![config(negative, E0065)]
namespace CryoTests::Negative::E0065EnumDiscriminantFloat;

type enum Level {
    Low = 1.5;
    //~^ ERROR[E0065] the discriminant of `Low` is not a compile-time integer
    High = 4;
}

function main() -> i32 {
    return Level::High as i32;
}
