// E0154: an overloaded function taken as a value with no expected function
// type names no overload.  The expected type is what selects one
// (`const f: (i32) -> i32 = Conv::conv;`); with none, the value is refused and
// every overload is named, a free function's as a static method's.  A
// function with one signature needs no expected type.
![config(testing)]
![config(negative, E0154)]
namespace CryoTests::Negative::OverloadedFunctionValueUntyped;

type struct Conv {
    k: i32;
    static conv(x: i32) -> i32 { return x + 1; }
    static conv(x: f64) -> f64 { return x * 2.0; }
}

function twice(x: i32) -> i32 { return x * 2; }
function twice(x: i64) -> i64 { return x * 3; }

function once(x: i32) -> i32 { return x; }

function main() -> int {
    const f = Conv::conv;   //~ ERROR[E0154] `Conv::conv` is overloaded, and nothing here says which overload is meant
    const t = twice;        //~ ERROR[E0154] `twice` is overloaded, and nothing here says which overload is meant
    const o = once;
    return o(0);
}
