// E0353: a collection's length and capacity are read through its
// `length()` and `capacity()`; the fields behind them are private to the
// collection's module, read or written.
![config(testing)]
![config(negative, E0353)]
namespace CryoTests::Negative::E0353CollectionFieldsPrivate;

import std::collections::str::{ Str };
import std::collections::string::{ String };

function main() -> int {
    mut xs: [i32] = [1, 2, 3];
    const n: i64 = xs.length;
    //~^ ERROR[E0353] field `length` of `std::collections::array::Array` is private
    xs.capacity = 0;
    //~^ ERROR[E0353] field `capacity` of `std::collections::array::Array` is private
    const text: Str = Str::new("abc");
    const bytes: i64 = text.length;
    //~^ ERROR[E0353] field `length` of `std::collections::str::Str` is private
    const owned: String = String::new();
    const used: i64 = owned.length;
    //~^ ERROR[E0353] field `length` of `std::collections::string::String` is private
    return (n as int) + (bytes as int) + (used as int);
}
