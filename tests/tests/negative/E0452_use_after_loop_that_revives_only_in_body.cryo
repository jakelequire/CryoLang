///! A binding moved before a loop and assigned only in the loop's body is
///! still moved on the path that runs the body zero times, so using it
///! after the loop is a use after a move: the loop's exit holds the moves
///! it began with.

![config(testing)]
![config(negative, E0452)]
namespace CryoTests::Negative::E0452UseAfterLoopThatRevivesOnlyInBody;

type struct Owned {
    id: i64;
}

implement trait Drop for struct Owned {
    drop(mut &this) -> void { }
}

function take(value: Owned) -> i64 { return value.id; }

function after_while(times: i64) -> i64 {
    mut value: Owned = Owned { id: 1 };
    take(value);
    mut i: i64 = 0;
    while (i < times) {
        value = Owned { id: 2 };
        i += 1;
    }
    return take(value);
    //~^ ERROR[E0452] use of moved value `value`
}

function after_for(times: i64) -> i64 {
    mut value: Owned = Owned { id: 1 };
    take(value);
    for (mut i: i64 = 0; i < times; i++) {
        value = Owned { id: 3 };
    }
    return take(value);
    //~^ ERROR[E0452] use of moved value `value`
}

function main() -> i32 {
    return 0;
}
