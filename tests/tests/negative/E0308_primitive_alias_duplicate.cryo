// E0308: `int` is a spelling alias for `i32` (both resolve to the same
// arena type), so implementing one trait for both is a duplicate - the
// dispatcher silently last-wins otherwise. Coherence keys type positions
// on their resolved type identity (not their surface name), so the two
// impls collide. Guards against the name-based-key shortcut where `int`
// and `i32` would key differently and slip through.
![config(testing)]
![config(negative, E0308)]
namespace CryoTests::Negative::E0308PrimitiveAliasDuplicate;

type trait Show { show(&this) -> int; }

implement trait Show for int { show(&this) -> int { return 1; } }
implement trait Show for i32 { show(&this) -> int { return 2; } }   //~ ERROR[E0308] conflicting implementations of

function main() -> int { return 0; }
