// E0151: only the standard library declares language items.  A program's
// well-formed `![language]` is refused, once, at its own declaration: it
// claims nothing, so the standard library's declaration of the same item
// is not reported as a second claim, and the enum `?` and `for` desugar
// through stays the standard library's `Option`.
![config(testing)]
![config(negative, E0151)]
namespace CryoTests::Negative::E0151LanguageOutsideStandardLibrary;

![language("option")]
//~^ ERROR[E0151] directive `![language]` belongs to the standard library; a declaration outside it cannot be a language item
type enum CfMaybe {
    Present(i32);
    Absent;
}

function main() -> int {
    const m: CfMaybe = CfMaybe::Absent;
    return match (m) {
        CfMaybe::Present(v) => { v }
        CfMaybe::Absent     => { 0 }
    };
}
