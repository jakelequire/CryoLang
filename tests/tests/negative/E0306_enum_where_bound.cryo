// E0306: the `where` clause on an enum declaration, refused the same way a
// struct's is.
![config(testing)]
![config(negative, E0306)]
namespace CryoTests::Negative::EnumWhereBound;

type trait Tagged {
    tag(&this) -> i32;
}

type struct Plain { v: i32; }

type enum Slot<T> where T: Tagged {
    Empty;
    Full(T);
}

function main() -> int {
    const s: Slot<Plain> = Slot::Empty;   //~ ERROR[E0306] the trait bound `CryoTests::Negative::EnumWhereBound::Plain: Tagged` is not satisfied
    return 0;
}
