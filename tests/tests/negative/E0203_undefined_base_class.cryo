// E0203: a class whose base names nothing in the scope the class is written in.
//
// The base is resolved in the ENCLOSING scope, before the class body opens, so
// no member of the class can supply the name. Without this the base is simply
// dropped and the class silently loses everything it was written to inherit.
![config(testing)]
![config(negative, E0203)]
namespace CryoTests::Negative::E0203UndefinedBaseClass;

type class CfDerived : CfNoSuchBase {   //~ ERROR[E0203] cannot find type `CfNoSuchBase` in this scope
public:
    x: i32;
    CfDerived(x: i32) { this.x = x; }
}

function main() -> int {
    mut d: CfDerived = CfDerived(1);
    return d.x;
}
