///! A written `a[i]` calls `index_mutable` and a written `*b` - or a member
///! reached through `b`'s `Deref` - calls `deref_mutable`.  A type that
///! implements only `Index` or only `Deref` is read-only through `[]` and
///! `*`, and a container or pointer that is itself read-only cannot be
///! written through either.

![config(testing)]
![config(negative, E0229)]
namespace CryoTests::Negative::E0229WriteThroughReadOnlyIndexOrDeref;

import std::core::ops::{ Index, IndexMutable, Deref, DerefMutable };

type struct Point { x: i32; }

implement struct Point {
    reset(mut &this) -> void { this.x = 0; }
}

type struct Readings { values: [i32; 2]; }

implement trait Index<u64, i32> for Readings {
    index(&this, i: u64) -> const i32* { return &this.values[i]; }
}

type struct Shared { point: Point; }

implement trait Deref<Point> for Shared {
    deref(&this) -> const Point* { return &this.point; }
}

type struct Cells { values: [i32; 2]; }

implement trait Index<u64, i32> for Cells {
    index(&this, i: u64) -> const i32* { return &this.values[i]; }
}

implement trait IndexMutable<u64, i32> for Cells {
    index_mutable(mut &this, i: u64) -> i32* { return &this.values[i]; }
}

type struct Owner { point: Point; }

implement trait Deref<Point> for Owner {
    deref(&this) -> const Point* { return &this.point; }
}

implement trait DerefMutable<Point> for Owner {
    deref_mutable(mut &this) -> Point* { return &this.point; }
}

function only_reads<T>(c: mut &T) -> void where T: Index<u64, i32> {
    c[0] = 1;
    //~^ ERROR[E0229] cannot write through `[]` on `T`, which does not implement `IndexMutable`
}

function through_borrow(c: &Cells, o: &Owner) -> void {
    c[0] = 1;
    //~^ ERROR[E0250] cannot assign to a place reached through `&Cells`, which is read-only
    o.x = 1;
    //~^ ERROR[E0250] cannot assign to a place reached through `&Owner`, which is read-only
    o.reset();
    //~^ ERROR[E0250] cannot call a `mut &this` method on a place reached through `&Owner`, which is read-only
}

function main() -> int {
    mut r: Readings = Readings { values: [1, 2] };
    r[0] = 5;
    //~^ ERROR[E0229] cannot write through `[]` on `Readings`, which does not implement `IndexMutable`
    r[1] += 5;
    //~^ ERROR[E0229] cannot write through `[]` on `Readings`, which does not implement `IndexMutable`
    mut s: Shared = Shared { point: Point { x: 1 } };
    *s = Point { x: 2 };
    //~^ ERROR[E0229] cannot write through `*` on `Shared`, which does not implement `DerefMutable`
    s.x = 3;
    //~^ ERROR[E0229] cannot write through `*` on `Shared`, which does not implement `DerefMutable`
    s.reset();
    //~^ ERROR[E0229] cannot write through `*` on `Shared`, which does not implement `DerefMutable`
    const c: Cells = Cells { values: [1, 2] };
    c[0] = 1;
    //~^ ERROR[E0218] cannot assign to immutable variable `c`
    const o: Owner = Owner { point: Point { x: 0 } };
    through_borrow(&c, &o);
    return r[0] + s.x;
}
