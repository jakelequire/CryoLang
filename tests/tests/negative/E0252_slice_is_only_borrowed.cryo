// Compile-fail test: a slice is only borrowed.  `&Slice<T>` and
// `mut &Slice<T>` are its only types, so the slice written as a value - a
// field's, a parameter's, a return's or a binding's type, a type argument, a
// pointer's pointee - is refused where the type is written.  The borrowed
// forms are the control.
![config(testing)]
![config(negative, E0252)]
namespace CryoTests::Negative::E0252SliceIsOnlyBorrowed;

import std::core::option::{ Option };
import std::core::slice::{ Slice };

type struct Holder {
    items: Slice<i32>;   //~ ERROR[E0252] a `Slice` is only borrowed, never held as a value
    borrowed: &Slice<i32>;
    written: mut &Slice<i32>;
}

function parameter(items: Slice<i32>) -> i64 {   //~ ERROR[E0252] a `Slice` is only borrowed, never held as a value
    return 0;
}

function returned(items: &Slice<i32>) -> Slice<i32> {   //~ ERROR[E0252] a `Slice` is only borrowed, never held as a value
    return returned(items);
}

function bindings(view: &Slice<i32>) -> i64 {
    const optional: Option<Slice<i32>> = Option::None;   //~ ERROR[E0252] a `Slice` is only borrowed, never held as a value
    const pointer: Slice<i32>* = null;   //~ ERROR[E0252] a `Slice` is only borrowed, never held as a value
    const kept: &Slice<i32> = view;
    return kept.length();
}

function main() -> int {
    return 0;
}
