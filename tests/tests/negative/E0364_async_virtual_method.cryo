// E0364: a `virtual` or `override` method cannot be `async`.
//
// Same reason a trait method cannot be: each override lowers to its own future
// struct, so the overrides return different types and have no common signature
// to put in a vtable slot.  Reported from sema rather than the parser, because
// `virtual` and `async` are individually fine and it is their combination that
// has no lowering.
![config(testing)]
![config(negative, E0364)]
namespace CryoTests::Negative::E0364AsyncVirtualMethod;

import std::future;

type class CfAsyncVirtual {
public:
    v: i64;

    public virtual async go(&this) -> i64 { return this.v; }   //~ ERROR[E0364] a `virtual` or `override` method cannot be `async`
}

function main() -> int { return 0; }
