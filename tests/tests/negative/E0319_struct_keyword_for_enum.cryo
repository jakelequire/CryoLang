// E0319: the kind keyword before an `implement` head's type names the
// type's kind, so `struct` before an enum is refused - in a trait
// implementation's head and an inherent one's, for a generic enum, and for
// an alias naming an enum.
![config(testing)]
![config(negative, E0319)]
namespace CryoTests::Negative::StructKeywordForEnum;

type enum Light { Off; On; }
type enum Maybe<T> { Held(T); Empty; }
type Lamp = Light;

type trait Brightness {
    level(&this) -> i32;
}

implement trait Brightness for struct Light {
//~^ ERROR[E0319] `CryoTests::Negative::StructKeywordForEnum::Light` is an enum, not a struct
    level(&this) -> i32 { return 1; }
}

implement struct Light {
//~^ ERROR[E0319] `CryoTests::Negative::StructKeywordForEnum::Light` is an enum, not a struct
    flipped(&this) -> i32 { return 2; }
}

implement<T> trait Brightness for struct Maybe<T> {
//~^ ERROR[E0319] `CryoTests::Negative::StructKeywordForEnum::Maybe` is an enum, not a struct
    level(&this) -> i32 { return 3; }
}

implement struct Lamp {
//~^ ERROR[E0319] `CryoTests::Negative::StructKeywordForEnum::Light` is an enum, not a struct
    lit(&this) -> i32 { return 4; }
}

function main() -> int {
    return 0;
}
