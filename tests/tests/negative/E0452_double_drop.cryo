// E0452: calling `.drop()` twice on the same binding in straight-line
// code is rejected at compile time.  Drop is signed `drop(mut &this)`
// so the receiver looks like a borrow at the signature level, but an
// explicit `.drop()` is the user's "release now" mark - drop_insertion
// treats it as a move (so it doesn't synthesise a second auto-drop),
// and the move-checker agrees: a subsequent read or `.drop()` on the
// same binding is use-after-move.
//
// Some Drop impls (Rc / Box) make double-drop a runtime-idempotent
// no-op, so this would not observably double-free for them - but
// user-written Drops that free unconditionally don't have that
// property and would double-free silently, making a silent
// double-`.drop()` a v1.0 foot-gun worth catching at compile time.
![config(testing)]
![config(negative, E0452)]
namespace CryoTests::Negative::E0452DoubleDrop;

type class Holder {
public:
    a: i32;
    drop(mut &this) -> void {}
}

function main() -> int {
    mut h: Holder = Holder { a: 1 };
    h.drop();
    h.drop();   //~ ERROR[E0452] use of moved value 'h'
    return 0;
}
