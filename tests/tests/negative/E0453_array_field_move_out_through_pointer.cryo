// E0453: an owning array field read by value through a pointer or reference
// copies the array's handle - its buffer pointer - into an independently
// released place, while the struct it was read from still owns the same
// buffer, so the buffer and its elements are released twice.
//
// `[T]` is `Array<T>`, so the refusal covers it as well as a fixed array, and
// it covers an assignment as well as an initializer: the two spellings copy
// the same handle.  Borrow the field (`&h.items`) or clone it.
![config(testing)]
![config(negative, E0453)]
namespace CryoTests::Negative::ArrayFieldMoveOutThroughPointer;

type struct Info {
    params: [i64];
}

type struct Holder {
    items: [Info];
}

function by_initializer(h: Holder*) -> i64 {
    const items: [Info] = h.items;
    //~^ ERROR[E0453] cannot move an owning array out of a value that owns a destructor
    return items.length();
}

function by_assignment(h: &Holder) -> i64 {
    mut items: [Info] = [];
    items = h.items;
    //~^ ERROR[E0453] cannot move an owning array out of a value that owns a destructor
    return items.length();
}

function main() -> int {
    mut h: Holder = Holder { items: [] };
    return (by_initializer(&h) + by_assignment(&h)) as int;
}
