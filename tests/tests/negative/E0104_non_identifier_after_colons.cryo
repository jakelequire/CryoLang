// E0104: the segment after `::` in a type path must be an identifier.
// Without this check, `Foo::123` would silently absorb the bogus token into
// the qualified name, producing a confusing "type not found" later instead
// of pointing at the offending token. (The general expected-type case is
// E0104_expected_type.cryo.)
![config(testing)]
![config(negative, E0104)]
namespace CryoTests::Negative::NonIdentifierAfterColons;

type struct Foo { x: i32; }

function main() -> int {
    mut p: Foo::123 = Foo { x: 1 };
    return 0;
}
