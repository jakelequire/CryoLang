// E0203: a type ARGUMENT that names nothing is reported by that name.  The
// instantiation fails, and a report that stopped at the head would blame
// `String`, which resolves.  Before this, the failure surfaced at codegen
// as E0636 against a static of the head.
![config(testing)]
![config(negative, E0203)]
namespace CryoTests::Negative::TypeArgumentUndeclared;

import std::collections::string;
import std::collections::string::{ String };

function main() -> int {
    mut s: String<Nope> = String<Nope>::new();   //~ ERROR[E0203] cannot find type `Nope` in this scope
    return 0;
}
