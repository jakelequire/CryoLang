// E0200: every element of an array literal must be assignable to the
// array's element type. A `string` element in an `i32[]` array would
// otherwise compile silently and be reinterpreted at codegen (the string
// pointer read back as an i32) - a type-confusion miscompile. The element
// loop in `resolve_array_literal` `can_assign`-checks each element against
// the context-declared element type.
![config(testing)]
![config(negative, E0200)]
namespace CryoTests::Negative::ArrayLiteralElementMismatch;
function main() -> int {
    const ys: i32[] = [1, 2, "three"];
    return ys[0];
}
