// W0013: a printf conversion whose argument type does not match.
![config(testing)]
![config(negative, W0013)]
namespace CryoTests::Negative::W0013FormatStringMismatch;

import std::fmt;

function main() -> int {
    fmt::printf("%d\n", "not a number");   //~ WARN[W0013] expects an integer
    return 0;
}
