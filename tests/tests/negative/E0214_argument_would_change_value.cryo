// An argument converts to its parameter's type implicitly only where the
// parameter holds every value of the argument: an integer into a float only
// when the float holds it exactly, an integer into one of the other sign only
// when it is wider.  The rest are refused at the argument; the help names
// `as` without writing it in.
![config(testing)]
![config(negative, E0214)]
namespace CryoTests::Negative::ArgumentWouldChangeValue;

function cf_take_f64(v: f64) -> f64 { return v; }
function cf_take_f32(v: f32) -> f32 { return v; }
function cf_take_i64(v: i64) -> i64 { return v; }
function cf_take_u64(v: u64) -> u64 { return v; }

public function cf_refused(big: i64, word: i32, count: u64, small: i8) -> f64 {
    const a: f64 = cf_take_f64(big);
    //~^ ERROR[E0214] mismatched types
    const b: f32 = cf_take_f32(word);
    //~^ ERROR[E0214] mismatched types
    const c: i64 = cf_take_i64(count);
    //~^ ERROR[E0214] mismatched types
    const d: u64 = cf_take_u64(small);
    //~^ ERROR[E0214] mismatched types
    return a + b + (c as f64) + (d as f64);
}

public function cf_kept(word: i32, half: i16, unsigned_word: u32) -> f64 {
    const a: f64 = cf_take_f64(word);
    const b: f32 = cf_take_f32(half);
    const c: i64 = cf_take_i64(unsigned_word);
    const d: u64 = cf_take_u64(unsigned_word);
    return a + b + (c as f64) + (d as f64);
}
