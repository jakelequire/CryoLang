// E0117: each form of the removed class feature is refused where it is
// written, with a help line saying what to write instead, and the parse goes
// on past it so every form in the file is reported.
![config(testing)]
![config(negative, E0117)]
namespace CryoTests::Negative::RemovedClassForms;

type struct Shared {
    v: i32;
}

type class Shape {                          //~ ERROR[E0117] `type class` is not part of Cryo
    sides: i32;
}

type struct Square : Shared {               //~ ERROR[E0117] `: Shared` is not part of Cryo
    side: i32;

    Square(s: i32) : Shared(s) { }          //~ ERROR[E0117] `Square(..)` is not part of Cryo
    //~^ ERROR[E0117] `: Shared(..)` is not part of Cryo

    ~Square() { }                           //~ ERROR[E0117] `~Square()` is not part of Cryo

    virtual area(&this) -> i32 { return this.side * this.side; }   //~ ERROR[E0117] `virtual` is not part of Cryo

    override perimeter(&this) -> i32 { return 4 * this.side; }     //~ ERROR[E0117] `override` is not part of Cryo

protected:                                  //~ ERROR[E0117] `protected:` is not part of Cryo
    hidden: i32;
}

type struct Circle {
    protected radius: i32;                  //~ ERROR[E0117] `protected` is not part of Cryo
}

implement class Circle {                    //~ ERROR[E0117] `implement class` is not part of Cryo
    diameter(&this) -> i32 { return 2 * this.radius; }
}

type trait Named {
    name(&this) -> i32;
}

implement trait Named for class Circle {    //~ ERROR[E0117] `for class` is not part of Cryo
    name(&this) -> i32 { return 1; }
}

function main() -> int {
    return 0;
}
