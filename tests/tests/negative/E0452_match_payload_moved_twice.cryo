// E0452: a match-arm payload is a value the pattern took out of the subject,
// owned like any local; giving it away twice releases it twice.  The same
// program with `x` declared as a plain local has always been refused.
![config(testing)]
![config(negative, E0452)]
namespace CryoTests::Negative::E0452MatchPayloadMovedTwice;

import std::core::option;
import std::core::option::{ Option };

type struct Res {
    tag: i32;

    drop(mut &this) -> void { }
}

function consume(r: Res) -> void { }

function f(o: Option<Res>) -> void {
    match (o) {
        Option::Some(x) => { consume(x); consume(x); }
        //~^ ERROR[E0452] use of moved value 'x'
        Option::None => { }
    }
}

function main() -> int { return 0; }
