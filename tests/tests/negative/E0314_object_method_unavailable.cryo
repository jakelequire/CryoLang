// E0314: a method is callable through a trait object only when its
// signature names the implementing type as its receiver alone.  A method
// taking `this` by value, one with type parameters of its own, and one
// naming `This` in a parameter or its return have no slot in the table;
// the trait's other methods stay callable through the same object.
![config(testing)]
![config(negative, E0314)]
namespace CryoTests::Negative::ObjectMethodUnavailable;

type trait Shape {
    area(&this) -> i32;
    consume(this) -> i32;
    pick<T>(&this, t: T) -> i32;
    same(&this, other: &This) -> boolean;
    duplicate(&this) -> This;
    static make() -> i32;
}

function use_all(s: virtual &Shape) -> i32 {
    const a: i32 = s.area();
    const b: i32 = s.consume();
    //~^ ERROR[E0314] `consume` cannot be called through `virtual &CryoTests::Negative::ObjectMethodUnavailable::Shape`
    const c: i32 = s.pick(1);
    //~^ ERROR[E0314] `pick` cannot be called through `virtual &CryoTests::Negative::ObjectMethodUnavailable::Shape`
    const d: boolean = s.same(s);
    //~^ ERROR[E0314] `same` cannot be called through `virtual &CryoTests::Negative::ObjectMethodUnavailable::Shape`
    s.duplicate();
    //~^ ERROR[E0314] `duplicate` cannot be called through `virtual &CryoTests::Negative::ObjectMethodUnavailable::Shape`
    const e: i32 = s.make();
    //~^ ERROR[E0314] `make` cannot be called through `virtual &CryoTests::Negative::ObjectMethodUnavailable::Shape`
    return a;
}

function main() -> int {
    return 0;
}
