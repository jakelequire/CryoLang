// E0102: a directive argument is an integer or string literal, an identifier
// or a nested call; a float literal is refused rather than read as its
// integer part.
![config(testing)]
![config(negative, E0102)]
namespace CryoTests::Negative::E0102DirectiveArgumentFloat;

![align(8.5)]   //~ ERROR[E0102] expected directive argument (identifier, integer or string literal, or nested call), got '8.5'
type struct Padded {
    value: i32;
}

function main() -> i32 {
    const padded: Padded = Padded { value: 3 };
    return padded.value;
}
