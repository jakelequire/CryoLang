// E0455: the pointer alone crossing the suspend is enough to be unsound.
//
// Here the addressed local is never read after the suspend, so it is not even
// carried - it simply ceases to exist.  Only the pointer survives, which makes
// this strictly worse than the carried case: the write lands in a frame slot
// that now belongs to something else.  The check must key on the pointer being
// live across the suspend, not on whether its referent happens to be carried.
![config(testing)]
![config(negative, E0455)]
namespace CryoTests::Negative::E0455AsyncPointerOutlivesLocal;

import std::future;

async function ptr_only_crosses() -> i64 {
    mut buf: u8[8] = [0; 8];
    const p: u8* = &buf[0];   //~ ERROR[E0455] async: `p` holds the address of the local or parameter `buf`
    const _z: i64 = await PendingThenReady<i64>::new(2, 1);
    *p = 42;
    return 0;
}

function main() -> int { return 0; }
