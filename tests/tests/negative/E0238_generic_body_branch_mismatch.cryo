// E0238: the arms of a value-producing `if` in a generic body agree on a
// type with each type parameter standing for one opaque type, so a `T`
// arm and an `Option<T>` arm do not agree, whatever `T` becomes.
![config(testing)]
![config(negative, E0238)]
namespace CryoTests::Negative::GenericBodyBranchMismatch;

function choose<T>(xs: &Array<T>, x: T, take: boolean) -> i32 where T: Copy {
    const picked = if (take) { x } else { xs.get(0) };   //~ ERROR[E0238] mismatched types
    return 0;
}

function main() -> i32 {
    mut xs: Array<i32> = Array::<i32>::new();
    xs.push(5);
    return choose::<i32>(&xs, 1, true);
}
