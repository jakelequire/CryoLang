// E0102: generic arguments in expression position spelled without the
// turbofish.  `<` after a name is a comparison, so `Wrap<i64>::new(7)` is
// `(Wrap < i64) > ::new(7)` and stops at the `::`; the note names the
// spelling that was meant.  (`f<T>(x)` parses as two comparisons and fails in
// sema instead; it is not this file's.)
![config(testing)]
![config(negative, E0102)]
namespace CryoTests::Negative::E0102GenericArgsWithoutTurbofish;

type struct Wrap<T> {
    v: T;
    static new(v: T) -> Wrap<T> { return Wrap::<T> { v: v }; }
}

function main() -> int {
    const w: Wrap<i64> = Wrap<i64>::new(7);
    //~^ ERROR[E0102] expected expression, found '::'
    //~^^ ERROR[E0102] expected expression after '>'
    //~^^^ ERROR[E0100] expected ';', found '::'
    return 0;
}
