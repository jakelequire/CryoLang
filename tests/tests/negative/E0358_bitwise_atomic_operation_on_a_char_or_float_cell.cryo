// E0358: `fetch_and`, `fetch_or` and `fetch_xor` are a `Bitwise` cell's
// alone, an integer or `boolean` one.  A `char`, `f32` or `f64` cell loads,
// stores, swaps and compares-and-exchanges, and its bitwise operations are
// refused at the call; an integer and a boolean cell keep theirs.
![config(testing)]
![config(negative, E0358)]
namespace CryoTests::Negative::BitwiseAtomicOperationOnACharOrFloatCell;

import std::sync::atomic::{ Atomic, MemoryOrder };

function main() -> i32 {
    const letter: Atomic<char> = Atomic::<char>::new('a');
    letter.fetch_or('b', MemoryOrder::SeqCst);
    //~^ ERROR[E0358] the trait bound `char: Bitwise` is not satisfied
    const single: Atomic<f32> = Atomic::<f32>::new(1.0);
    single.fetch_and(2.0, MemoryOrder::SeqCst);
    //~^ ERROR[E0358] the trait bound `f32: Bitwise` is not satisfied
    const double: Atomic<f64> = Atomic::<f64>::new(1.0);
    double.fetch_xor(2.0, MemoryOrder::SeqCst);
    //~^ ERROR[E0358] the trait bound `f64: Bitwise` is not satisfied
    const byte: Atomic<u8> = Atomic::<u8>::new(1);
    byte.fetch_and(3, MemoryOrder::SeqCst);
    const flag: Atomic<boolean> = Atomic::<boolean>::new(false);
    flag.fetch_or(true, MemoryOrder::SeqCst);
    letter.store('c', MemoryOrder::SeqCst);
    return letter.load(MemoryOrder::SeqCst) as i32;
}
