// E0315: a value whose implementation of the trait is generic is refused
// as an argument to a trait-object parameter wherever the call's callee
// is - a function, a static method, a function value, an enum variant -
// as it is at an initializer.  An argument whose type is an instantiation
// not yet minted, behind a reference, is checked like any other.
![config(testing)]
![config(negative, E0315)]
namespace CryoTests::Negative::ObjectConversionGenericArgument;

type trait Sink {
    put(mut &this, v: i64) -> i64;
}

type struct Box2<T> {
    total: T;
}

implement trait Sink for struct Box2<i64> {
    put(mut &this, v: i64) -> i64 { this.total = this.total + v; return this.total; }
}

type struct Holder {
    sink: virtual mut &Sink;
    static new(sink: virtual mut &Sink) -> Holder { return Holder { sink: sink }; }
}

type enum Slot {
    Empty;
    Full(virtual mut &Sink);
}

function put_one(sink: virtual mut &Sink) -> i64 {
    return sink.put(1);
}

function main() -> int {
    mut b: Box2<i64> = Box2::<i64> { total: 0 };
    const a: i64 = put_one(&b);
    //~^ ERROR[E0315] implements `CryoTests::Negative::ObjectConversionGenericArgument::Sink` by a generic implementation
    const h: Holder = Holder::new(&b);
    //~^ ERROR[E0315] implements `CryoTests::Negative::ObjectConversionGenericArgument::Sink` by a generic implementation
    const f: (virtual mut &Sink) -> i64 = put_one;
    const c: i64 = f(&b);
    //~^ ERROR[E0315] implements `CryoTests::Negative::ObjectConversionGenericArgument::Sink` by a generic implementation
    const s: Slot = Slot::Full(&b);
    //~^ ERROR[E0315] implements `CryoTests::Negative::ObjectConversionGenericArgument::Sink` by a generic implementation
    const o: Option<virtual mut &Sink> = Option::Some(&b);
    //~^ ERROR[E0315] implements `CryoTests::Negative::ObjectConversionGenericArgument::Sink` by a generic implementation
    return 0;
}
