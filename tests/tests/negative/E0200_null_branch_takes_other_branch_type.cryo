// A `null` branch converts to every pointer, so it says nothing about the
// value a two-branch expression produces: the other branch's type does.  A
// `PaB*` from either branch is refused where a `PaA*` is declared, whichever
// branch the `null` is in.
![config(testing)]
![config(negative, E0200)]
namespace CryoTests::Negative::NullBranchTakesOtherBranchType;

type struct NbA { x: i64; }
type struct NbB { y: f64; }

function main() -> int {
    const b: NbB* = new NbB { y: 1.5 };
    const c: boolean = b != null;
    const first: NbA* = if (c) { null } else { b };   //~ ERROR[E0200] mismatched types
    const second: NbA* = if (c) { b } else { null };  //~ ERROR[E0200] mismatched types
    const third: NbA* = c ? null : b;                 //~ ERROR[E0200] mismatched types
    return (first.x + second.x + third.x) as int;
}
