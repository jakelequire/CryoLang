///! A pointer is read-only unless it is written `mut`: nothing is written
///! through a bare `T*` - not assigned, not given a compound assignment, no
///! `mut &this` method called on what it points at, and no writable borrow
///! taken of it - and a bare pointer does not convert to a `mut T*`.  The
///! same writes through a `mut T*` are accepted.

![config(testing)]
![config(negative, E0250)]
namespace CryoTests::Negative::E0250WriteThroughBarePointer;

type struct Counter {
    count: i32;

    bump(mut &this) -> void { this.count += 1; }
}

function write_read_only(c: Counter*, n: i32*) -> void {
    c.count = 1;
    //~^ ERROR[E0250] cannot assign to a place reached through `Counter*`, which is read-only
    (*c).bump();
    //~^ ERROR[E0250] cannot call a `mut &this` method on a place reached through `Counter*`, which is read-only
    *n += 2;
    //~^ ERROR[E0250] cannot assign to a place reached through `i32*`, which is read-only
    n[0] = 3;
    //~^ ERROR[E0250] cannot assign to a place reached through `i32*`, which is read-only
    const w: mut i32* = &*n;
    //~^ ERROR[E0251] cannot take a writable borrow of a place reached through `i32*`, which is read-only
}

function write_writable(c: mut Counter*, n: mut i32*) -> void {
    c.count = 1;
    (*c).bump();
    *n += 2;
    n[0] = 3;
    const w: mut i32* = &*n;
    *w = 4;
}

function takes_writable(n: mut i32*) -> void { *n = 0; }

function main() -> int {
    mut value: i32 = 0;
    const read_only: i32* = &value;
    takes_writable(read_only);
    //~^ ERROR[E0214] mismatched types
    mut c: Counter = Counter { count: 0 };
    write_writable(&c, &value);
    write_read_only(&c, &value);
    return value;
}
