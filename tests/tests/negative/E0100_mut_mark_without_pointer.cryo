// E0100: `mut` in front of a type marks what a pointer points at, so a
// pointer must follow it: `mut i64*`.  A value type has nothing it could
// mark, in a written type and in an `as` target alike, and a grouped
// pointer after `mut` must itself be pointed at: `mut (u8*)*`.
![config(testing)]
![config(negative, E0100)]
namespace CryoTests::Negative::MutMarkWithoutPointer;

function marked_value(v: mut i64) -> i64 {                              //~ ERROR[E0100] expected `*` after a type written with `mut`
    return v;
}

function cast_to_marked_value(v: i64) -> i64 {
    return v as mut i64;                                                //~ ERROR[E0100] expected `*` after a type written with `mut`
}

function grouped_pointer(p: mut (u8*)) -> u8 {                          //~ ERROR[E0100] expected `*` after `mut (u8*)`
    return 0;
}

function main() -> int {
    return 0;
}
