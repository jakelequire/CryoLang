// E0200: a comparison's operands are one type.  Pointers to two unrelated
// structs never point at the same object, so `pp == qp` is refused rather
// than comparing the two addresses.  A pointer compared with `null`, with a
// `void*`, or with a pointer to the same type is unaffected.
![config(testing)]
![config(negative, E0200)]
namespace CryoTests::Negative::CompareUnrelatedPointers;

type struct P { x: int; }
type struct Q { y: int; }

function main() -> int {
    mut p: P = P { x: 1 };
    mut q: Q = Q { y: 2 };
    const pp: P* = &p;
    const qp: Q* = &q;
    const vp: void* = qp as void*;
    mut r: int = 0;
    if (pp == qp) { r = r + 1; }     //~ ERROR[E0200] Pointers::P*` with `CryoTests::Negative::CompareUnrelatedPointers::Q*`: they are unrelated types
    if (qp != pp) { r = r + 2; }     //~ ERROR[E0200] Pointers::Q*` with `CryoTests::Negative::CompareUnrelatedPointers::P*`: they are unrelated types
    if (pp != null) { r = r + 4; }
    if (vp == pp) { r = r + 8; }
    if (pp == &p) { r = r + 16; }
    return r;
}
