// Compile-fail test: a generic call whose argument does not have its
// parameter's shape leaves the type parameter unbound, and the argument is
// refused as it would be for a parameter with no type parameters: a fixed
// array of another length, a value that is no array, a container no slice
// method converts.  The calls with an argument of the right shape are the
// controls.
![config(testing)]
![config(negative, E0214)]
namespace CryoTests::Negative::E0214GenericArgumentDoesNotFitTheParameterShape;

import std::core::slice::{ Slice };

type struct Box {
    value: u64;
}

type struct Picker {
    static third<T>(values: &[T; 3]) -> T {
        return values[2];
    }
}

function third<T>(values: &[T; 3]) -> T {
    return values[2];
}

function first_of<T>(values: [T]) -> i64 {
    return values.length();
}

function count_of<T>(items: &Slice<T>) -> i64 {
    return items.length();
}

function main() -> int {
    const four: [u64; 4] = [7, 8, 9, 10];
    const three: [u64; 3] = [7, 8, 9];
    const n: i64 = 5;
    const boxed: Box = Box { value: 1 };
    third(&four);   //~ ERROR[E0214]
    third(&three);
    const c: i64 = first_of(n);   //~ ERROR[E0214]
    const d: i64 = count_of(&boxed);   //~ ERROR[E0214]
    const e: i64 = count_of(&three);
    Picker::third(&four);   //~ ERROR[E0214]
    Picker::third(&three);
    return 0;
}
