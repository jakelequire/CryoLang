// E0406: a match arm naming a variant the enum does not have.
//
// Silently accepted before: the payload lookup found nothing and the binder
// fell back to binding `w` against the SUBJECT's type, so the arm never
// matched and became dead code. Here `Square` is left uncovered, so E0405
// also fires - but a typo alongside otherwise-complete coverage produced no
// diagnostic at all, which is what this pins.
![config(testing)]
![config(negative, E0406)]
namespace CryoTests::Negative::UnknownEnumVariant;

type enum Shape {
    Circle(int);
    Square(int);
}

function main() -> int {
    const s: Shape = Shape::Circle(1);
    match (s) {
        Shape::Circle(r) => { return r; }
        Shape::Squre(w)  => { return 2; }
    }
}
