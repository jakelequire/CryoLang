// Where no integer type is expected, a shifted literal takes the amount's
// type and must be held by it, whatever its sign: `-129` shifted by an `i8`
// is refused as `300` shifted by a `u8` is, where it was shifted as the `i8`
// 127.  `-128` and `-100`, which an `i8` holds, and a shift whose result has
// an expected type, are the controls.
![config(testing)]
![config(negative, E0010)]
namespace CryoTests::Negative::ShiftedLiteralNotHeldByAmount;

function main() -> int {
    const n: i8 = 1;
    const u: u8 = 1;
    const held_minimum = -128 << n;
    const held = -100 << n;
    const typed: i32 = -129 << n;
    const negated = -129 << n;              //~ ERROR[E0010] this value is -129
    const positive = 300 << u;              //~ ERROR[E0010] integer literal `300`
    return (held_minimum as int) + (held as int) + (typed as int) + (negated as int) + (positive as int);
}
