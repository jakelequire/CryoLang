// E0458: a capturing closure is passed to a method-call argument
// position.  v1.0 routes capturing closures through free-function
// `(Args) -> Ret` parameters only - the per-call-site receiver
// specialisation (`apply(closure, ...)`) is wired for Identifier
// callees, not MemberAccess or ScopeResolution callees.  Letting the
// call through would silently miscompile: codegen would lower the
// closure-struct value as if it were a function pointer (or, for
// generic receivers, leave U unbound and pass the struct address
// where a code pointer is expected), producing an LLVM verification
// failure or runtime UB.  Reject at sema with an explicit limitation
// note so the user sees a clear v1.0 boundary.
![config(testing)]
![config(negative, E0458)]
namespace CryoTests::Negative::ClosureMethodArg;

import std::core::option;

function main() -> int {
    const bias: i32 = 10;
    const some: Option<i32> = Option::Some(7);
    // Closure being passed to `Option::map<U>(f: (T) -> U)` - a
    // method, not a free function.  E0458.
    const _doubled: Option<i32> = some.map(
        (n: i32) -> i32 { return n + bias; });
    return 0;
}
