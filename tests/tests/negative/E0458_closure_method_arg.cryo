// E0458: a capturing closure passed to a method's parameter of function
// type.  The parameter takes a function pointer, which has no room for the
// closure's captures, and a method is not copied per closure the way a
// non-generic free function of the same module is.  The controls compile:
// the same closure passed to a method whose parameter is a type parameter
// with a callable bound, and a lambda that captures nothing passed to the
// function-typed parameter.
![config(testing)]
![config(negative, E0458)]
namespace CryoTests::Negative::ClosureMethodArg;

type struct Counter {
    n: i32;
    each(&this, f: (i32) -> i32) -> i32 { return f(this.n); }
    each_bounded<F>(&this, f: F) -> i32 where F: (i32) -> i32 { return f(this.n); }
}

function main() -> int {
    const bias: i32 = 10;
    const c: Counter = Counter { n: 7 };
    const a: i32 = c.each((n: i32) -> i32 { return n + bias; });   //~ ERROR[E0458] a capturing closure cannot be passed to a parameter of function type `(i32) -> i32` of `each`
    const b: i32 = c.each_bounded((n: i32) -> i32 { return n + bias; });
    const d: i32 = c.each((n: i32) -> i32 { return n * 2; });
    return a + b + d;
}
