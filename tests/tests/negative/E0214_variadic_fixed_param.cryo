// E0214: a variadic function's declared parameters are checked like any
// other function's; only the tail past them is unconstrained.  An `i64`
// into a declared `i32` narrows and is refused, on the bare call and on the
// module-qualified one alike; the same value in the TAIL is not judged.
![config(testing)]
![config(negative, E0214)]
namespace CryoTests::Negative::E0214VariadicFixedParam;

import std::ffi::libc;

extern "C" {
    function cf_vfix(a: i32, ...) -> i32;
}

function main() -> int {
    mut buf: i8[16];
    const big: i64 = 7;
    cf_vfix(big, 1);                              //~ ERROR[E0214] mismatched types
    cf_vfix(1, big);
    libc::snprintf(&buf[0], 16, "%d", 1);         //~ ERROR[E0214] mismatched types
    libc::snprintf((&buf[0]) as u8*, 16, "%d", big);
    return 0;
}
