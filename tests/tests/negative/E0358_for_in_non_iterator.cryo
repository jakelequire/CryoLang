// E0358: `for (x in <expr>)` lowers the scrutinee to `<expr>.next()` (or
// `<expr>.iter().next()` for iterables).  A scrutinee whose type is neither
// an `Iterator` nor exposes `iter()` - here a bare `i32` - has no `next`
// method, so the lowering must be rejected rather than silently miscompiled.
![config(testing)]
![config(negative, E0358)]
namespace CryoTests::Negative::ForInNonIterator;

function main() -> int {
    const cf_not_iterable: i32 = 42;
    for (i in cf_not_iterable) {   //~ ERROR[E0358] no method named `next` found on
        printf("%d\n", i);
    }
    return 0;
}
