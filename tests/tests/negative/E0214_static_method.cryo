// E0214: bad string argument to a static-method call.
![config(testing)]
![config(negative, E0214)]
namespace CryoTests::Negative::StaticMethodArg;
type struct CfMake { v: i32; static cf_of(x: i32) -> CfMake { return CfMake { v: x }; } }
function main() -> int { const m: CfMake = CfMake::cf_of("bad"); return 0; }
