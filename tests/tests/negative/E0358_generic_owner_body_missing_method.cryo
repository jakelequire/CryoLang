// E0358: a call on `this` that no method, field or `Deref` target of a
// generic owner binds is refused where it is written - in the owner's own
// body, in an implementation for every instance and in one for a single
// instance.  Without this the call reached code generation bound to nothing.
![config(testing)]
![config(negative, E0358)]
namespace CryoTests::Negative::E0358GenericOwnerBodyMissingMethod;

type trait Valued { value(&this) -> i64; }
type trait Measured { measure(&this) -> i64; }

type struct Holder<A> {
    count: i64;
    own(&this) -> i64 {
        return this.no_such_method();
        //~^ ERROR[E0358] no method named `no_such_method` found on type
    }
}

implement<A> trait Measured for struct Holder<A> {
    measure(&this) -> i64 {
        return this.other_missing();
        //~^ ERROR[E0358] no method named `other_missing` found on type
    }
}

implement trait Valued for struct Holder<i32> {
    value(&this) -> i64 {
        return this.missing_on_instance();
        //~^ ERROR[E0358] no method named `missing_on_instance` found on type
    }
}

function main() -> int {
    const holder: Holder<i32> = Holder::<i32> { count: 1 };
    return (holder.own() + holder.measure() + holder.value()) as int;
}
