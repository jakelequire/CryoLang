// E0250: `const` in front of an array type marks the pointer that follows
// it read-only, so the array is not written through it.
![config(testing)]
![config(negative, E0250)]
namespace CryoTests::Negative::ReadOnlyArrayPointer;

function append(values: const [i64]*) -> void {
    values.push(1);                                                     //~ ERROR[E0250] cannot call a `mut &this` method on a place reached through `[i64]*`, which is read-only
}

function main() -> int {
    return 0;
}
