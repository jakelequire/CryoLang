// E0250: indexing a pointer reads through that pointer alone, `p[i]` being
// `*(p + i)`, so the element is as writable as the indexed pointer's own
// level makes it.  A read-only outer level refuses the write whatever the
// elements point at; a writable one allows it, though the elements are
// read-only pointers (the project index_through_pointer_levels runs that).
![config(testing)]
![config(negative, E0250)]
namespace CryoTests::Negative::IndexDecidedByIndexedPointer;

function store_read_only(slots: const (u8*)*, value: u8*) -> void {
    slots[0] = value;                                                   //~ ERROR[E0250] cannot assign to a place reached through `const (u8*)*`, which is read-only
}

function add_read_only(counts: const i64*) -> void {
    counts[0] += 1;                                                     //~ ERROR[E0250] cannot assign to a place reached through `const i64*`, which is read-only
}

function main() -> int {
    return 0;
}
