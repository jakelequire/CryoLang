// E0200: an array literal's element converts through an `![implicit]`
// converter only against the element type the literal is declared to have.
// With nothing declared, the literal takes its first element's type, which
// is no declaration, so a later `string` is not made into a `Str`.
![config(testing)]
![config(negative, E0200)]
namespace CryoTests::Negative::ArrayElementWithNoDeclaredTypeIsNotConverted;

import std::collections::str::{ Str };

function main() -> int {
    const _views = [Str::new("a"), "b"];
    //~^ ERROR[E0200] mismatched types
    return 0;
}
