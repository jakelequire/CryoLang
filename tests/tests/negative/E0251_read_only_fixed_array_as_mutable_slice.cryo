// Compile-fail test: `as_mutable_slice()` on a fixed array writes it, so a
// read-only array never gives a writable slice through it.  A `const` fixed
// array and a `&[T; N]` are refused; a `mut` array and a `mut &[T; N]` are
// the controls.
![config(testing)]
![config(negative, E0251)]
namespace CryoTests::Negative::E0251ReadOnlyFixedArrayAsMutableSlice;

import std::core::slice::{ Slice };

function through_borrow(values: &[i32; 3]) -> void {
    const writer: mut &Slice<i32> = values.as_mutable_slice();   //~ ERROR[E0251]
}

function through_writable_borrow(values: mut &[i32; 3]) -> void {
    const writer: mut &Slice<i32> = values.as_mutable_slice();
}

function from_const() -> void {
    const values: [i32; 3] = [1, 2, 3];
    const writer: mut &Slice<i32> = values.as_mutable_slice();   //~ ERROR[E0251]
    mut writable: [i32; 3] = [1, 2, 3];
    const control: mut &Slice<i32> = writable.as_mutable_slice();
}

function main() -> int {
    return 0;
}
