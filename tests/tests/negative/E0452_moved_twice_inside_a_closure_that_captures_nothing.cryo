// E0452: the body of a closure that captures nothing is a function of its own,
// and is checked as one: a value it moves twice is released twice.
![config(testing)]
![config(negative, E0452)]
namespace CryoTests::Negative::E0452MovedTwiceInsideAClosureThatCapturesNothing;
import std::collections::string::{ String };
import std::collections::str::{ Str };

function take(s: String) -> i64 { return s.length() as i64; }

function main() -> int {
    const f = () -> i64 {
        const s: String = String::from_str(Str::new("twice"));
        const a: i64 = take(s);
        return a + take(s);   //~ ERROR[E0452] use of moved value `s`
    };
    return f() as int;
}
