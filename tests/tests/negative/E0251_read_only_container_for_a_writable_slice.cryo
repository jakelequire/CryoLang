// Compile-fail test: read access never becomes write access through the
// slice conversion.  A `&Array<T>`, or `&x` of a `const` array, where a
// `mut &Slice<T>` is wanted is refused; the writable borrow of a writable
// array is the control.
![config(testing)]
![config(negative, E0251)]
namespace CryoTests::Negative::E0251ReadOnlyContainerForAWritableSlice;

import std::core::slice::{ Slice };
import std::collections::array::{ Array };

function write_each(items: mut &Slice<i32>) -> void {
    for (mut i: i64 = 0; i < items.length(); i++) {
        items[i] = 0;
    }
}

function from_borrow(values: &Array<i32>) -> void {
    write_each(values);   //~ ERROR[E0251]
}

function from_const() -> void {
    const values: Array<i32> = Array::<i32>::new();
    write_each(&values);   //~ ERROR[E0251]
    mut writable: Array<i32> = Array::<i32>::new();
    write_each(&writable);
}

function main() -> int {
    return 0;
}
