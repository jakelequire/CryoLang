// E0201: a primitive type declares no constants, so a path naming one on it
// (`i32::MAX`) names no value - through an alias of the primitive too - and
// is refused where it is written rather than typed as the primitive with
// nothing stored behind it.
![config(testing)]
![config(negative, E0201)]
namespace CryoTests::Negative::E0201PrimitiveHasNoConstant;

type Int = i32;

function main() -> int {
    const a: i32 = i32::MAX;       //~ ERROR[E0201] cannot find value `i32::MAX`
    const b: Int = Int::MAX;       //~ ERROR[E0201] cannot find value `Int::MAX`
    const c: u8 = u8::MIN;         //~ ERROR[E0201] cannot find value `u8::MIN`
    const d: f64 = f64::NAN;       //~ ERROR[E0201] cannot find value `f64::NAN`
    const e: char = char::MAX;     //~ ERROR[E0201] cannot find value `char::MAX`
    if (i64::MAX != 0) { return 1; }   //~ ERROR[E0201] cannot find value `i64::MAX`
    return 0;
}
