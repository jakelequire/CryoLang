// E0201: a path naming a constant a primitive type does not declare
// (`i32::LIMIT`; `boolean`, which declares none) names no value - through an
// alias of the primitive too - and is refused where it is written rather than
// typed as the primitive with nothing stored behind it.  The constants the
// standard library does declare (`i32::MAX`, `f64::NAN`, `char::MAX`) are
// read in the project primitive_type_constants.
![config(testing)]
![config(negative, E0201)]
namespace CryoTests::Negative::E0201PrimitiveHasNoConstant;

type Int = i32;

function main() -> int {
    const a: i32 = i32::LIMIT;          //~ ERROR[E0201] cannot find value `i32::LIMIT`
    const b: Int = Int::LIMIT;          //~ ERROR[E0201] cannot find value `Int::LIMIT`
    const c: u8 = u8::ZERO;             //~ ERROR[E0201] cannot find value `u8::ZERO`
    const d: f64 = f64::PI;             //~ ERROR[E0201] cannot find value `f64::PI`
    const e: boolean = boolean::MAX;    //~ ERROR[E0201] cannot find value `boolean::MAX`
    if (i64::DIGITS != 0) { return 1; } //~ ERROR[E0201] cannot find value `i64::DIGITS`
    return 0;
}
