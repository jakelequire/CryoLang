///! A bare literal of a generic type whose parameters all have defaults is
///! the default instantiation inside the type's own body too, so its fields
///! are the defaults' fields: in `Holder<A>`'s methods `Holder { store: s }`
///! wants a `Store<Plain>`, and a `Store<A>` is refused there.  The owner's
///! own literal is written with its argument, `Holder::<A> { .. }`.

![config(testing)]
![config(negative, E0200)]
namespace CryoTests::Negative::E0200BareLiteralFieldsTakeDefaults;

type struct Plain { tag: i32; }

type struct Store<A> { item: A; }

type struct Holder<A = Plain> {
    store: Store<A>;

    static keep(s: Store<A>) -> void {
        const _h: Holder = Holder { store: s };
        //~^ ERROR[E0200] mismatched types
    }

    static wrap(s: Store<A>) -> Holder<A> {
        return Holder::<A> { store: s };
    }
}

function main() -> int {
    Holder::<Plain>::keep(Store::<Plain> { item: Plain { tag: 1 } });
    const h: Holder<Plain> = Holder::<Plain>::wrap(Store::<Plain> { item: Plain { tag: 2 } });
    return h.store.item.tag;
}
