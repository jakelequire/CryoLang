// E0306: a closure whose parameter type is not the item an iterator
// passes it is refused for the callable bound it does not meet, naming the
// parameter's type beside the item's - not as a type argument nothing binds:
// the closure's return still says what `map`'s `B` is.  The closure taking
// the item's own type is the control.
![config(testing)]
![config(negative, E0306)]
namespace CryoTests::Negative::E0306ClosureParameterDiffersFromItem;

import std::collections::array::{ Array };

function main() -> int {
    const fits: Array<i32> = (1..=4).map((n: i32) -> i32 { return n * n; }).collect();
    const wide: Array<i64> = (1..=4).map((n: i64) -> i64 { return n * n; }).collect();   //~ ERROR[E0306] the callable bound `F: (i32) -> i64` is not satisfied
    return fits.length() as int + wide.length() as int;
}
