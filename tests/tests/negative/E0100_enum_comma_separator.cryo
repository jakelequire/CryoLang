// E0100: Cryo separates enum variants with ';', not ','. A Rust-style
// comma must produce a clean diagnostic. Regression: a stray separator
// parked the parser cursor on the offending token and the enum-decl loop
// spun forever (infinite hang) instead of reporting the error.
![config(testing)]
![config(negative, E0100)]
namespace CryoTests::Negative::E0100EnumCommaSeparator;

type enum E { A(i32), B }

function main() -> int { return 0; }
