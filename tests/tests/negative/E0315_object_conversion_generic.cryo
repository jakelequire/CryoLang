// E0315: converting a value whose implementation of the trait is generic
// is not built yet, and neither is converting a value of a type parameter,
// whose implementation is not known in the generic body.
![config(testing)]
![config(negative, E0315)]
namespace CryoTests::Negative::ObjectConversionGeneric;

type trait Shape {
    area(&this) -> i32;
}

type struct Wrap<T> {
    value: T;
}

implement<T> trait Shape for Wrap<T> {
    area(&this) -> i32 { return 1; }
}

function convert<T>(x: &T) -> i32 where T: Shape {
    const s: virtual &Shape = x;
    //~^ ERROR[E0315] `&T` cannot become `virtual &CryoTests::Negative::ObjectConversionGeneric::Shape`: `T` is a type parameter, whose implementation of `CryoTests::Negative::ObjectConversionGeneric::Shape` is not known here
    return 0;
}

function main() -> int {
    const w: Wrap<i32> = Wrap::<i32> { value: 1 };
    const s: virtual &Shape = &w;
    //~^ ERROR[E0315] `CryoTests::Negative::ObjectConversionGeneric::Wrap<i32>` implements `CryoTests::Negative::ObjectConversionGeneric::Shape` by a generic implementation, so `&CryoTests::Negative::ObjectConversionGeneric::Wrap<i32>` cannot become `virtual &CryoTests::Negative::ObjectConversionGeneric::Shape`
    return 0;
}
