// E0200: a generic body's `return` is checked against the declared return
// type with each type parameter standing for one opaque type: an
// `Option<T>` is not the `T` the function promises, whatever `T` becomes.
![config(testing)]
![config(negative, E0200)]
namespace CryoTests::Negative::GenericBodyReturnMismatch;

function last<T>(xs: &Array<T>) -> T where T: Copy {
    return xs.get(xs.length() - 1);   //~ ERROR[E0200] mismatched types
}

function main() -> i32 {
    mut xs: Array<i32> = Array::<i32>::new();
    xs.push(5);
    return last::<i32>(&xs);
}
