// E0200: inside a generic body a type parameter is one opaque type, so a
// binding declared `T` takes a `T` and nothing else. `Array::get` answers
// `Option<T>`; accepting it as `T` made every copy read the option's tag
// word as the element (`first::<i32>` over `[5]` answered 0). Copies are
// not re-checked, so the generic body is the only place this is caught.
![config(testing)]
![config(negative, E0200)]
namespace CryoTests::Negative::GenericBodyOptionAsParam;

function first<T>(xs: &Array<T>) -> T where T: Copy {
    const v: T = xs.get(0);   //~ ERROR[E0200] mismatched types
    return v;
}

function main() -> i32 {
    mut xs: Array<i32> = Array::<i32>::new();
    xs.push(5);
    return first::<i32>(&xs);
}
