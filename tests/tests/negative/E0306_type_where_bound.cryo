// E0306: a type declaration constrains its own parameters in a `where`
// clause, and an instantiation with an argument outside the constraint is
// refused where it is written, with the bound as declared beside it.  An
// instantiation demanded with no annotation of its own is refused once more
// where it is specialized, the door behind this one.
![config(testing)]
![config(negative, E0306)]
namespace CryoTests::Negative::TypeWhereBound;

type trait Tagged {
    tag(&this) -> i32;
}

type struct Plain { v: i32; }

type struct Holder<T> where T: Tagged {
    inner: T;
}

function main() -> int {
    const h: Holder<Plain> = Holder<Plain> { inner: Plain { v: 7 } };   //~ ERROR[E0306] the trait bound `CryoTests::Negative::TypeWhereBound::Plain: Tagged` is not satisfied
    return h.inner.v;
}
