// E0214: a call through a path to a generic type's method with type
// parameters of its own checks each argument against its parameter, with the
// type's arguments and the method's substituted in: a parameter of the
// method's own type, and one of the type's, wherever the method is declared.
![config(testing)]
![config(negative, E0214)]
namespace CryoTests::Negative::GenericOwnerGenericMethodCallArgument;

type struct Wrap<T> { v: T; }
implement<T> struct Wrap<T> {
    static conv<U>(x: U) -> U { return x; }
    static make<U>(t: T, u: U) -> T { return t; }
}

type struct Cell<T> {
    v: T;
    static make<U>(t: T, u: U) -> T { return t; }
}

function main() -> int {
    const a: u8 = Wrap::<i32>::conv::<u8>("s");     //~ ERROR[E0214] mismatched types
    const b: i32 = Wrap::<i32>::make::<u8>("s", 1); //~ ERROR[E0214] mismatched types
    const c: i32 = Cell::<i32>::make::<u8>("s", 1); //~ ERROR[E0214] mismatched types
    return 0;
}
