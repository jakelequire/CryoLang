// E0307: a generic type written with more type arguments than it has
// parameters, or with fewer once its defaults fill the tail, is refused
// where it is written: an argument the declaration has no parameter for
// would otherwise be dropped.  A struct, an enum and a generic alias are
// counted alike, in a local's, a parameter's and a return's annotation;
// an omitted defaulted parameter stands.
![config(testing)]
![config(negative, E0307)]
namespace CryoTests::Negative::TypeArgumentCount;

type struct Box<T> { v: T; }

type struct Pair<A, B> { a: A; b: B; }

type struct Tagged<T, U = i64> { v: T; tag: U; }

type enum Maybe<T> { Just(T); Nothing; }

type Twice<T> = Pair<T, T>;

function unbox(b: Box<i32, u8>) -> i32 {
    //~^ ERROR[E0307] `Box` has 1 type parameter, and 2 type arguments are written
    return b.v;
}

function boxed() -> Box<i32, i32, i32> {
    //~^ ERROR[E0307] `Box` has 1 type parameter, and 3 type arguments are written
    return Box::<i32> { v: 1 };
}

function main() -> int {
    const b: Box<i32, i64> = Box::<i32> { v: 1 };
    //~^ ERROR[E0307] `Box` has 1 type parameter, and 2 type arguments are written
    const p: Pair<i32> = Pair::<i32, i32> { a: 1, b: 2 };
    //~^ ERROR[E0307] `Pair` has 2 type parameters, and 1 type argument is written
    const m: Maybe<i32, i32> = Maybe::<i32>::Nothing;
    //~^ ERROR[E0307] `Maybe` has 1 type parameter, and 2 type arguments are written
    const w: Twice<i32, u8> = Pair::<i32, i32> { a: 1, b: 2 };
    //~^ ERROR[E0307] `Twice` has 1 type parameter, and 2 type arguments are written
    const t: Tagged<i32> = Tagged::<i32> { v: 1, tag: 2 };
    return b.v + p.a + w.a + t.v;
}
