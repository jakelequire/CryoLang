///! `.` reads through one raw pointer: a receiver with a second raw pointer
///! anywhere before its value is refused, whether the access reads a field,
///! writes one or calls a method, and whatever references stand around the
///! pointers.  The program writes the extra dereference itself.

![config(testing)]
![config(negative, E0222)]
namespace CryoTests::Negative::E0222MemberThroughTwoRawPointers;

type struct Foo {
    x: i32;

    get(&this) -> i32 { return this.x; }
}

function read_field(p: Foo**) -> i32 {
    return p.x;
    //~^ ERROR[E0222] `.` reads through one raw pointer, and `Foo**` holds more than one
}

function write_field(p: Foo**) -> void {
    p.x = 1;
    //~^ ERROR[E0222] `.` reads through one raw pointer, and `Foo**` holds more than one
}

function call_method(p: const (Foo*)*) -> i32 {
    return p.get();
    //~^ ERROR[E0222] `.` reads through one raw pointer, and `const (Foo*)*` holds more than one
}

function through_a_borrow(r: &(Foo**)) -> i32 {
    return r.x;
    //~^ ERROR[E0222] `.` reads through one raw pointer, and `&Foo**` holds more than one
}

function element_address(xs: &[Foo*]) -> i32 {
    return xs.first().unwrap().x;
    //~^ ERROR[E0222] `.` reads through one raw pointer, and `Foo**` holds more than one
}

function main() -> int {
    mut f: Foo = Foo { x: 7 };
    mut p: Foo* = &f;
    mut xs: [Foo*] = [];
    const pp: Foo** = &p;
    xs.push(p);
    write_field(&p);
    return read_field(&p) + call_method(&p) + through_a_borrow(&pp) + element_address(&xs);
}
