// E0214: string passed to an i32 parameter through an instance-method call.
![config(testing)]
![config(negative, E0214)]
namespace CryoTests::Negative::E0214InstanceMethod;
type struct CfCounter {
    v: i32;
    static cf_new() -> CfCounter { return CfCounter { v: 0 }; }
    cf_bump(mut &this, by: i32) -> void { this.v = this.v + by; }
}
function main() -> int {
    mut c: CfCounter = CfCounter::cf_new();
    c.cf_bump("bad");
    return 0;
}
