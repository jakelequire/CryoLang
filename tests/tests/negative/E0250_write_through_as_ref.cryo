///! `as_ref` on `Option` and `Result` borrows the payload read-only: the
///! pointer it hands out is `const T*`, and a write through it is refused.
///! The writable borrow is `as_mutable_ref`, a `mut &this` method, which a
///! `const` binding does not offer.

![config(testing)]
![config(negative, E0250)]
namespace CryoTests::Negative::E0250WriteThroughAsRef;

function write_option(opt: &Option<i32>) -> void {
    match (opt.as_ref()) {
        Option::Some(p) => {
            *p = 1;
            //~^ ERROR[E0250] cannot assign to a place reached through `const i32*`, which is read-only
        }
        Option::None => { }
    }
}

function write_result(r: &Result<i32, i64>) -> void {
    match (r.as_ref()) {
        Result::Ok(p) => {
            *p = 1;
            //~^ ERROR[E0250] cannot assign to a place reached through `const i32*`, which is read-only
        }
        Result::Err(e) => {
            *e = 2;
            //~^ ERROR[E0250] cannot assign to a place reached through `const i64*`, which is read-only
        }
    }
}

function main() -> int {
    const opt: Option<i32> = Option::Some(3);
    const writable: Option<i32*> = opt.as_mutable_ref();
    //~^ ERROR[E0250] cannot call a `mut &this` method on a place held by a `const` binding
    write_option(&opt);
    return 0;
}
