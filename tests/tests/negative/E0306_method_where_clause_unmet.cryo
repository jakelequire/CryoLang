// E0306: a method call that binds one of the method's own type parameters
// to a type outside the bound its where-clause writes on it is refused where
// it is written, as a free call is - whether the argument is inferred or
// written (`scale_by::<boolean>`).  The calls at a type the bound admits are
// the control, a primitive under an operator trait among them.
![config(testing)]
![config(negative, E0306)]
namespace CryoTests::Negative::E0306MethodWhereClauseUnmet;

import std::core::ops::{ Add };

type trait MwPosition {
    to_position(this) -> i64;
}

implement trait MwPosition for u8 { to_position(this) -> i64 { return this as i64; } }

type struct MwMeter {
    n: i64;

    scale_by<K>(&this, k: K) -> i64 where K: MwPosition { return this.n * k.to_position(); }

    doubled<U>(&this, u: U) -> U where U: Add<U, U> { return u + u; }
}

type struct MwOpaque { v: i32; }

function main() -> int {
    const m: MwMeter = MwMeter { n: 5 };
    const scaled: i64 = m.scale_by(2 as u8);
    const twice: i32 = m.doubled(21);
    const inferred: i64 = m.scale_by(true);   //~ ERROR[E0306] the trait bound `boolean: MwPosition` is not satisfied
    const written: i64 = m.scale_by::<boolean>(false);   //~ ERROR[E0306] the trait bound `boolean: MwPosition` is not satisfied
    const opaque: MwOpaque = m.doubled(MwOpaque { v: 1 });   //~ ERROR[E0306] MwOpaque: Add<
    return 0;
}
