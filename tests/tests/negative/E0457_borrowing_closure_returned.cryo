// E0457: a closure written without `move` borrows each captured value that
// is not `Copy`, and those values are released when the function returns,
// so the closure - or a value holding it - may not be returned.  A `move`
// closure owns what it captures and may be (the control).
![config(testing)]
![config(negative, E0457)]
namespace CryoTests::Negative::BorrowingClosureReturned;

type struct Res {
    tag: i64;
}

implement trait Drop for struct Res {
    drop(mut &this) -> void { }
}

type trait Source { next_value(mut &this) -> i64; }

type struct Gen<F> where F: () -> i64 {
    f: F;
}

implement<F> trait Source for Gen<F> where F: () -> i64 {
    next_value(mut &this) -> i64 { return this.f(); }
}

function borrowing() -> implement Source {
    const p: Res = Res { tag: 1 };
    return Gen { f: () -> i64 { return p.tag; } };
    //~^ ERROR[E0457] cannot return a closure that borrows values of this function
}

function owning() -> implement Source {
    const p: Res = Res { tag: 2 };
    return Gen { f: move () -> i64 { return p.tag; } };
}

function main() -> int { return 0; }
