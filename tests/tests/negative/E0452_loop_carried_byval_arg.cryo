// E0452: a value declared outside a loop and passed BY VALUE to a function
// inside the loop is moved every iteration. A by-value owning argument is
// moved into the callee, which drops it at its scope exit (the by-value
// param-drop). Re-passing the same storage on the next iteration drops it
// again - a loop-carried double free.
//
// Regression for the move_check/drop_insertion disagreement: drop_insertion
// treated a genuine by-value (`!autoref`) argument as a move, but move_check
// walked every argument as a borrow, so this loop compiled with NO diagnostic
// and double-freed `a.p` once per iteration at runtime. move_check::read_call
// now mirrors drop_insertion (autoref => read, by-value => move), so the
// loop-carried reuse is caught before codegen. Sibling of the assignment-
// based E0452_loop_carried_move.cryo.
![config(testing)]
![config(negative, E0452)]
namespace CryoTests::Negative::LoopCarriedByValArg;

type struct Heap {
    p: void*;
}

implement trait Drop for struct Heap {
    drop(mut &this) -> void { free(this.p); }
}

// By-value owning parameter: the callee owns and drops `h`.
function consume(h: Heap) -> void { }

function main() -> int {
    mut a: Heap = Heap { p: malloc(16) };
    for (mut i: int = 0; i < 3; i++) {
        consume(a);   // moves `a` every iteration -> double free
    }
    return 0;
}
