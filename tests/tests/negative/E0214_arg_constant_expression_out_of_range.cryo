// An argument made only of integer literals passes the value its arithmetic
// gives, and adopts the parameter's type when that type holds the value, as
// the literal of the value would: `(200 + 100) / 2` passes 150 for a `u8`
// though its sum does not fit one.  A value the type does not hold keeps its
// default width and is refused at the call: the difference is negative for
// a `u32`, and the negation is past an `i8`'s minimum.  A positive value past
// the type (`200 + 100` for a `u8`) is refused as its literal is, with E0010
// (E0010_constant_expression_narrows).
![config(testing)]
![config(negative, E0214)]
namespace CryoTests::Negative::ArgConstantExpressionOutOfRange;

function cf_take_u8(v: u8) -> u8 { return v; }
function cf_take_u32(v: u32) -> u32 { return v; }
function cf_take_i8(v: i8) -> i8 { return v; }

function main() -> int {
    const b: u8 = cf_take_u8((200 + 100) / 2);
    const c: u32 = cf_take_u32(5 - 10);           //~ ERROR[E0214] mismatched types
    const d: i8 = cf_take_i8(-(64 * 3));          //~ ERROR[E0214] mismatched types
    return b as int + c as int + d as int;
}
