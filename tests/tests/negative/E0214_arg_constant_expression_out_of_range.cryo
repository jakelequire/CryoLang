// An argument made only of integer literals adopts the parameter's type when
// every value it computes on the way fits that type, as a single literal that
// fits does.  One that does not keeps its default width and is refused at the
// call: the sum overflows `u8`, the division's operand does on the way to a
// quotient that would fit, and the difference is negative for a `u32`.
![config(testing)]
![config(negative, E0214)]
namespace CryoTests::Negative::ArgConstantExpressionOutOfRange;

function cf_take_u8(v: u8) -> u8 { return v; }
function cf_take_u32(v: u32) -> u32 { return v; }

function main() -> int {
    const a: u8 = cf_take_u8(200 + 100);          //~ ERROR[E0214] mismatched types
    const b: u8 = cf_take_u8((200 + 100) / 2);    //~ ERROR[E0214] mismatched types
    const c: u32 = cf_take_u32(5 - 10);           //~ ERROR[E0214] mismatched types
    return (a + b) as int + c as int;
}
