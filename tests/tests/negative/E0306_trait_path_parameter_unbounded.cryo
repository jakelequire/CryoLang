// E0306: a call through a trait's path on a type parameter's receiver is
// the implementation a bound in scope gives the parameter, and a parameter
// no bound gives the trait is refused at the path, whatever a copy of the
// body binds it to - bounded by another trait, or by none.
![config(testing)]
![config(negative, E0306)]
namespace CryoTests::Negative::E0306TraitPathParameterUnbounded;

type trait TpShow {
    show(&this) -> i32;
}

type trait TpOther {
    other(&this) -> i32;
}

type struct TpPlain { n: i32; }

implement trait TpShow for struct TpPlain {
    show(&this) -> i32 { return this.n; }
}

implement trait TpOther for struct TpPlain {
    other(&this) -> i32 { return this.n; }
}

function shown_unbounded<P>(p: &P) -> i32 {
    return TpShow::show(p);   //~ ERROR[E0306] `P` does not implement `TpShow`
}

function shown_other<P>(p: &P) -> i32 where P: TpOther {
    return TpShow::show(p);   //~ ERROR[E0306] `P` does not implement `TpShow`
}

function main() -> int {
    const plain: TpPlain = TpPlain { n: 1 };
    return shown_unbounded(&plain) + shown_other(&plain);
}
