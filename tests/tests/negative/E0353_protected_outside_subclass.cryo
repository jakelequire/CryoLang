// E0353: `protected` members are accessible from the declaring class and
// its subclasses only.  A plain free function is neither, so reading
// `balance` here must be rejected.  (The positive subclass-access case is
// in lang/visibility.cryo.)
![config(testing)]
![config(negative, E0353)]
namespace CryoTests::Negative::E0353ProtectedOutsideSubclass;

type class Account {
protected:
    balance: i32;
public:
    Account(b: i32) { this.balance = b; }
}

function main() -> int {
    const a: Account* = new Account(5);
    return a.balance;
}
