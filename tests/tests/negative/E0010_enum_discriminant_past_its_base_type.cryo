// E0010: an enum that declares its base type stores every tag in it, so a
// discriminant the base does not hold is refused where it is written, and
// one a variant takes after its predecessor's at the variant.  A negative
// tag under an unsigned base and one past a signed base's maximum are
// refused too; each base's own bounds are held.
![config(testing)]
![config(negative, E0010)]
namespace CryoTests::Negative::EnumDiscriminantPastItsBaseType;

type enum Byte : u8 {
    Low = 0;
    High = 255;
    Past = 256;
    //~^ ERROR[E0010] the discriminant of `Past`, 256, does not fit `u8`, the base type of `Byte`
}

type enum Counted : u8 {
    Last = 255;
    After;
    //~^ ERROR[E0010] the discriminant of `After`, 256, does not fit `u8`, the base type of `Counted`
}

type enum Unsigned : u32 {
    Top = 4294967295;
    Negative = -1;
    //~^ ERROR[E0010] the discriminant of `Negative`, -1, does not fit `u32`, the base type of `Unsigned`
}

type enum Small : i8 {
    Bottom = -128;
    Top = 127;
    Past = 128;
    //~^ ERROR[E0010] the discriminant of `Past`, 128, does not fit `i8`, the base type of `Small`
}

function main() -> i32 {
    return (Byte::High as i32) + (Small::Bottom as i32);
}
