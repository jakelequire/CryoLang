// E0306: the argument for a type parameter with a callable bound
// (`F: (i32) -> i32`) must be called with exactly that signature: a closure
// of another signature, and a value that is not called at all, are refused
// at the call, with the bound shown where it is written.  The bound on a
// method may name its owner's parameters (`F: (T) -> U` on `Cell<T>`); the
// receiver's arguments are put in for them.  The controls compile: a
// closure, a named function and a non-capturing lambda of the bound's
// signature.
![config(testing)]
![config(negative, E0306)]
namespace CryoTests::Negative::CallableBoundNotMet;

function apply<F>(f: F, x: i32) -> i32 where F: (i32) -> i32 { return f(x); }

function double(x: i32) -> i32 { return x * 2; }

type struct Cell<T> {
    value: T;
    map<U, F>(&this, f: F) -> U where F: (T) -> U { return f(this.value); }
}

function main() -> int {
    const bias: i64 = 10;
    const small: i32 = 1;
    const a: i32 = apply((x: i64) -> i64 { return x + bias; }, 1);   //~ ERROR[E0306] the callable bound `F: (i32) -> i32` is not satisfied
    const b: i32 = apply(5, 1);                                      //~ ERROR[E0306] the callable bound `F: (i32) -> i32` is not satisfied
    const c: Cell<i32> = Cell::<i32> { value: 5 };
    const d: i64 = c.map((x: i64) -> i64 { return x + bias; });      //~ ERROR[E0306] the callable bound `F: (i32) -> i64` is not satisfied
    const e: i32 = apply((x: i32) -> i32 { return x + small; }, 1) + apply(double, 2)
        + apply((x: i32) -> i32 { return x; }, 3);
    const f: i64 = c.map((x: i32) -> i64 { return (x as i64) + bias; });
    return e;
}
