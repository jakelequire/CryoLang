// E0455: an accessor that hands out a pointer into a local is an address-of,
// even though no `&` appears at the call site.
//
// `owner.conn()` returns a pointer derived from `owner`'s own storage, so the
// result aliases the frame exactly as `&owner.inner` would.  A local carried
// across a suspend is taken into a fresh block-local on every poll, so that
// storage moves and the pointer goes stale - writes through it land on a copy
// the later states have stopped reading, which reports a plausible wrong value
// rather than faulting.  Unlike a view into a heap block, keeping the owner
// alive cannot repair this: it is the ADDRESS that changes, not the lifetime.
//
// A receiver that is itself an indirection is unaffected - a dynamic array's
// heap block does not move when a poll returns - so `as_ptr()` and friends stay
// available.
![config(testing)]
![config(negative, E0455)]
namespace CryoTests::Negative::E0455AsyncPointerFromAccessor;

import std::future;

type struct Inner {
    n: u64;
}

type struct Owner {
    inner: Inner;

    static make() -> Owner { return Owner { inner: Inner { n: 1 } }; }

    /// Hands out a pointer into `this`.
    conn(mut &this) -> Inner* { return &this.inner; }

    async touch(mut &this) -> u64 {
        const z: u64 = await PendingThenReady<u64>::new(1, 1);
        return this.inner.n + z;
    }
}

async function ptr_from_accessor() -> u64 {
    mut owner: Owner = Owner::make();
    mut p: Inner* = owner.conn();   //~ ERROR[E0455] async: `p` holds the address of the local or parameter `owner`
    const a: u64 = await owner.touch();
    return a + p.n;
}

function main() -> int { return 0; }
