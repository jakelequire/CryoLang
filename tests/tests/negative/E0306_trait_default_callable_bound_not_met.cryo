// E0306: a trait method's callable bound may name the implementing type,
// `F: (Acc, This::Item) -> Acc` on `Iterator::fold`; the bound is judged at
// the receiver, whose `Item` the projection reduces to, so a callback of
// another signature is refused at the call rather than called as the
// required one.
![config(testing)]
![config(negative, E0306)]
namespace CryoTests::Negative::TraitDefaultCallableBoundNotMet;

import std::collections::array::{ Array };

function main() -> int {
    mut values: Array<i32> = Array::<i32>::new();
    values.push(1);
    const start: i32 = 0;
    const total: i64 = values.iter().fold(start, (acc: i64, n: i32) -> i64 { return acc + n as i64; });
    //~^ ERROR[E0306] the callable bound `F: (i32, i32) -> i32` is not satisfied
    return total as int;
}
