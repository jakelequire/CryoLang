// E0306: a method's bound written over its owner's parameter (`R: Accepts<K>`
// on a method of `Holder<K>`) is required at the receiver's argument. A
// `Holder<i64>` is given neither an implementation written at `Accepts<i32>`
// nor a generic one whose target makes it `Accepts<i32>`; each would run an
// `i32` method on an `i64`.
![config(testing)]
![config(negative, E0306)]
namespace CryoTests::Negative::E0306MethodBoundAtOtherTraitArguments;

type trait Accepts<T> {
    accept(&this, value: T) -> T;
}

type struct Halver { }

implement trait Accepts<i32> for struct Halver {
    accept(&this, value: i32) -> i32 { return value / 2; }
}

type struct Wrap<T> {
    divisor: T;
}

implement<T> trait Accepts<T> for struct Wrap<T> where T: Copy {
    accept(&this, value: T) -> T { return value; }
}

type struct Holder<K> {
    value: K;

    apply<R>(&this, taker: R) -> K where R: Accepts<K>, K: Copy {
        return taker.accept(this.value);
    }
}

function main() -> int {
    const holder: Holder<i64> = Holder::<i64> { value: 42 };
    const halved: i64 = holder.apply(Halver { });   //~ ERROR[E0306] the trait bound `CryoTests::Negative::E0306MethodBoundAtOtherTraitArguments::Halver: Accepts<i64>` is not satisfied
    const wrap: Wrap<i32> = Wrap::<i32> { divisor: 2 };
    const kept: i64 = holder.apply(wrap);   //~ ERROR[E0306] Accepts<i64>` is not satisfied
    return (halved + kept) as int;
}
