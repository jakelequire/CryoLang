// E0200: a `mut x: implement Trait = init;` binding requires the
// initializer's concrete type to implement the named trait. `NotAnIter`
// does not implement `Iterator`, so binding it to `implement Iterator<i32>`
// must be rejected rather than silently accepted.
![config(testing)]
![config(negative, E0200)]
namespace CryoTests::Negative::ImplTraitUnmetBound;

import std::core::iter;
import std::core::option;

type struct NotAnIter {
    x: i32;
}

function main() -> int {
    const bad: NotAnIter = NotAnIter { x: 1 };
    mut it: implement Iterator<i32> = bad;   //~ ERROR[E0200] `it` is declared `implement
    return 0;
}
