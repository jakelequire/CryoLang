// E0214: a `(Args) -> Ret` parameter is a typed slot. Argument position shared
// the gating predicate with assignment, so it too accepted a value of any type
// at all for a callback parameter - and a callback is precisely the argument
// whose misuse cannot be caught later, because the callee's only use of it is
// to call it.
![config(testing)]
![config(negative, E0214)]
namespace CryoTests::Negative::FnPointerArgument;

function take_callback(f: (void*) -> void) -> void { }

function main() -> int {
    const s: string = "hello";
    take_callback(s);   //~ ERROR[E0214] mismatched types
    return 0;
}
