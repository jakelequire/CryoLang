// E0204: a function type names no type that declares fields, so a field
// read on a function-typed value names nothing.  Refused where the read is
// written.
![config(testing)]
![config(negative, E0204)]
namespace CryoTests::Negative::FieldOnFunctionValue;

function width_of(f: (i32) -> i32) -> i32 {
    return f.width;
    //~^ ERROR[E0204] no field or method `width` on type `(i32) -> i32`
}

function main() -> int {
    return 0;
}
