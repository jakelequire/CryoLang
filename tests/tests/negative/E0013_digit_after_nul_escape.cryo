// E0013: `\0` followed by a digit.  Cryo has no octal escapes: the escape
// pass reads `\0` as a NUL byte and each digit after it as its own
// character, so `"\033[1m"` would be a NUL and then "33[1m" - a string
// that ends at its first byte for anything reading it as C text.  Each
// form is refused where it is written: a string, a character literal, and
// the text of an f-string.
![config(testing)]
![config(negative, E0013)]
namespace CryoTests::Negative::DigitAfterNulEscape;
function main() -> int {
    const bold: string = "\033[1m";   //~ ERROR[E0013] `\033` is not an escape
    const c: char = '\01';            //~ ERROR[E0013] `\01` is not an escape
    const n: int = 3;
    const f: string = f"\0123 {n}";   //~ ERROR[E0013] `\012` is not an escape
    return 0;
}
