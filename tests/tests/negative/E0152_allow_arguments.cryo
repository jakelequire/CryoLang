// E0152: an `allow` names at least one lint and carries at most one
// `reason`, a non-empty string; its only key is `reason`.  A lint name is not
// checked against any list, so an allow of a lint the compiler does not know
// is accepted and does nothing.
![config(testing)]
![config(negative, E0152)]
namespace CryoTests::Negative::E0152AllowArguments;

![allow(no_such_lint)]
function unknown_lint() -> i32 { return 1; }

![allow(lookup_by_spelling, reason = "a lint this compiler does not have")]
function retired_lint() -> i32 { return 2; }

![allow(some_lint, reasn = "a typo")]
//~^ ERROR[E0152] directive `![allow]`: unknown key `reasn` (the only key is `reason`)
function misspelt_key() -> i32 { return 3; }

![allow(some_lint, reason = 42)]
//~^ ERROR[E0152] directive `![allow]`: `reason` must be a string literal
function number_reason() -> i32 { return 4; }

![allow(some_lint, reason = "")]
//~^ ERROR[E0152] directive `![allow]`: `reason` is empty; say why the lint does not apply here
function empty_reason() -> i32 { return 5; }

![allow(some_lint, reason = "one", reason = "two")]
//~^ ERROR[E0152] directive `![allow]` carries 2 reasons; write one
function two_reasons() -> i32 { return 6; }

function main() -> int {
    return unknown_lint() + retired_lint() + misspelt_key() + number_reason()
        + empty_reason() + two_reasons();
}
