// E0229: compound assignment `*=` applied to a string is not a valid
// binary op. Before compound ops were type-checked in sema (they returned
// the lhs type unchecked), this silently emitted null IR in codegen - the
// `s *= 3` statement was dropped instead of diagnosed.
![config(testing)]
![config(negative, E0229)]
namespace CryoTests::Negative::E0229InvalidCompoundOp;
function main() -> int {
    mut s: string = "hello";
    s *= 3;   //~ ERROR[E0229] Cannot apply '*' to String and Int
    return 0;
}
