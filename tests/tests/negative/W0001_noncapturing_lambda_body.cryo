// W0001: an unused local in the body of a lambda that captures nothing is
// reported where the lambda is written, as one in a capturing lambda's body
// is reported through its closure; a lambda nested in either is reached too.
// An annotated file is checked both ways: a W0001 on any other line fails
// the suite.
![config(testing)]
![config(negative, W0001)]
namespace CryoTests::Negative::W0001NoncapturingLambdaBody;

// A lambda nested in a lambda, neither capturing anything.
function cf_nested() -> i64 {
    const outer = (k: i64) -> i64 {
        const unused_outer: i64 = 1;   //~ WARN[W0001] unused variable `unused_outer`
        const inner = (x: i64) -> i64 {
            const unused_nested: i64 = 2;   //~ WARN[W0001] unused variable `unused_nested`
            return x + 1;
        };
        return inner(k);
    };
    return outer(2);
}

// A lambda capturing nothing inside one that captures `base`.
function cf_in_capturing(base: i64) -> i64 {
    const outer = (k: i64) -> i64 {
        const inner = (x: i64) -> i64 {
            const unused_in_closure: i64 = 3;   //~ WARN[W0001] unused variable `unused_in_closure`
            return x * 2;
        };
        return inner(k) + base;
    };
    return outer(1);
}

function main() -> int {
    const plain = (x: i64) -> i64 {
        const unused_inner: i64 = 3;   //~ WARN[W0001] unused variable `unused_inner`
        const used_inner: i64 = 4;
        return x + used_inner;
    };
    const base: i64 = 10;
    const capturing = (x: i64) -> i64 {
        const unused_captured_body: i64 = 5;   //~ WARN[W0001] unused variable `unused_captured_body`
        return x + base;
    };
    if (plain(1) + capturing(1) + cf_nested() + cf_in_capturing(10) == 31) { return 0; }
    return 1;
}
