// E0101: a type header is written name and parameters, then `with [...]`,
// then `where`; a `with` clause after the `where` clause is refused where
// it is written, on a struct and on an enum.  The clauses in order are the
// control.
![config(testing)]
![config(negative, E0101)]
namespace CryoTests::Negative::E0101DeriveAfterWhere;

import std::core::cmp::{ Eq };

type struct DwLate<T> where T: Eq with [Eq] {   //~ ERROR[E0101] a `with` clause goes before the `where` clause
    x: T;
}

type enum DwLateEnum<T> where T: Eq with [Eq] {   //~ ERROR[E0101] a `with` clause goes before the `where` clause
    Held(T);
}

type struct DwInOrder<T> with [Eq] where T: Eq {
    x: T;
}

function main() -> i32 {
    return 0;
}
