// E0307: a method with type parameters of its own taken as a value, where
// nothing binds them - no turbofish and no expected function type - or the
// turbofish writes more arguments than the method has parameters.  Its
// where-clause holds for the instance, as for a call (E0306).
![config(testing)]
![config(negative, E0307)]
namespace CryoTests::Negative::GenericMethodValueUninferable;

type trait Twice { twice(&this) -> i32; }
type struct Plain { k: i32; }

type struct Box { v: i32; }
implement struct Box {
    static wrap<T>(x: T) -> T { return x; }
    static need<T>(x: T) -> T where T: Twice { return x; }
}

function main() -> int {
    const a = Box::wrap;                        //~ ERROR[E0307] cannot infer `T` for `Box::wrap` used as a value
    const b = Box::wrap::<i32, u8>;             //~ ERROR[E0307] `Box::wrap` has 1 type parameter, and 2 type arguments are written
    const c: (Plain) -> Plain = Box::need;      //~ ERROR[E0306] the trait bound `CryoTests::Negative::GenericMethodValueUninferable::Plain: Twice` is not satisfied
    const d: (i32) -> i32 = Box::wrap::<i32>;
    return d(0);
}
