// E0455: an address handed to the awaited future escapes just as far.
//
// The sub-future is stashed in a field of the state machine and polled again
// from a later state's frame, so a frame address passed into its constructor is
// dangling by the time the operation writes through it.  This is the shape an
// async I/O call takes (`Read::start(s, &buf[0], 64)`), so it must be rejected
// at the `await` rather than caught by whichever consumer reads garbage first.
![config(testing)]
![config(negative, E0455)]
namespace CryoTests::Negative::E0455AsyncAddressIntoAwaitedFuture;

import std::future;

async function addr_into_future() -> i64 {
    mut buf: u8[8] = [0; 8];
    const p: u8* = await PendingThenReady<u8*>::new(2, &buf[0]);   //~ ERROR[E0455] async: this `await` hands the address of the local or parameter `buf`
    *p = 42;
    return 0;
}

function main() -> int { return 0; }
