// E0203: a local variable annotated with an UNKNOWN type name must be
// rejected with a clean diagnostic (the boolean type is `boolean`, not
// `bool`). An unknown local-var type must not be silently accepted (unused)
// or reach codegen and crash LLVM verification (E0900) - type resolution
// validates local-var annotations.
//
// Regression test: a `bool` typo must give a clear diagnostic - "cannot find
// type `bool` ... did you mean `boolean`?" - not a cryptic codegen error.
![config(testing)]
![config(negative, E0203)]
namespace CryoTests::Negative::UnknownLocalVarType;

function main() -> int {
    const x: bool = true;     // error[E0203]: cannot find type `bool`
    return x as int;
}
