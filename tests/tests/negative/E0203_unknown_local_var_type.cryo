// E0203: a local variable annotated with an UNKNOWN type name must be
// rejected with a clean diagnostic (the boolean type is `boolean`, not
// `bool`).  Before the fix, an unknown local-var type was silently accepted
// (unused) or reached codegen and crashed LLVM verification (E0900) — type
// resolution never validated local-var annotations.
//
// Regression for the audit follow-up: a `bool` typo gave a cryptic codegen
// error instead of "cannot find type `bool` ... did you mean `boolean`?".
![config(testing)]
![config(negative, E0203)]
namespace CryoTests::Negative::UnknownLocalVarType;

function main() -> int {
    const x: bool = true;     // error[E0203]: cannot find type `bool`
    return x as int;
}
