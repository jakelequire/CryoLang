// E0353: only the compiler makes a `Location`, for `location()` and for the
// caller of a `![caller_location]` function.  Its fields are private, so a
// program cannot make one up, nor write one's fields; it reads one through
// `file()`, `line()`, `column()` and `function()`.
![config(testing)]
![config(negative, E0353)]
namespace CryoTests::Negative::E0353LocationConstructed;

import std::core::intrinsics::{ Location };

function main() -> int {
    const made: Location = Location { file: "made_up.cryo", line: 1, column: 1, function: "nowhere" };
    //~^ ERROR[E0353] field `file` of `std::core::intrinsics::Location` is private
    mut here: Location = intrinsics::location();
    here.line = 9;
    //~^ ERROR[E0353] field `line` of `std::core::intrinsics::Location` is private
    return here.line() as int + made.line() as int;
}
