// E0100: a scalar type's name cannot name a variable, a global, a
// parameter, a pattern binding or a destructured local.  Such a value
// stood in front of the type wherever the type was written
// bare: with a local `i8` in scope, `i8::MIN` looked its path up in the
// local and was not found.  `string` and the alias keywords stay legal
// names.
![config(testing)]
![config(negative, E0100)]
namespace CryoTests::Negative::E0100ScalarTypeAsBindingName;

const u16: i32 = 4;
//~^ ERROR[E0100] expected a variable name, found `u16`, which names a primitive type

type struct Pair {
    value: i32;
}

function take(u32: i64) -> i64 { return u32 + 1; }
//~^ ERROR[E0100] expected a parameter name, found `u32`, which names a primitive type

function pick(o: Option<i32>) -> i32 {
    match (o) {
        Option::Some(u128) => { return u128; }
        //~^ ERROR[E0100] expected a binding name, found `u128`, which names a primitive type
        Option::None => { return 0; }
    }
}

function main() -> i32 {
    mut i8: i16 = 3;
    //~^ ERROR[E0100] expected a variable name, found `i8`, which names a primitive type
    i8 = i8 + 1;
    const char: i32 = 7;
    //~^ ERROR[E0100] expected a variable name, found `char`, which names a primitive type
    const boolean: i32 = 2;
    //~^ ERROR[E0100] expected a variable name, found `boolean`, which names a primitive type
    const { value: u64 }: Pair = Pair { value: 9 };
    //~^ ERROR[E0100] expected a variable name, found `u64`, which names a primitive type
    const string: i32 = 5;
    const int_value: i32 = string + char + boolean;
    return (take(2) as i32) + pick(Option::Some(1)) + (i8 as i32) + u64 + u16 + int_value;
}
