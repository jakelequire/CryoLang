// E0214: `?` in an `async` function, on a `Result` whose error type the
// function's own error type has no `From` implementation for.  The refusal
// is the only report: the walk of the `poll` the function is lowered into
// judges the same `?` against the function's `Result`, not against `Poll`.
![config(testing)]
![config(negative, E0214)]
namespace CryoTests::Negative::E0214TryErrorWithoutFromInAsyncFunction;

import std::core::result;
import std::future;

type enum CfLowError { Bad; }
type enum CfHighError { Failed; }

function cf_low() -> Result<i32, CfLowError> {
    return Result::Err(CfLowError::Bad);
}

async function cf_high() -> Result<i32, CfHighError> {
    const v: i32 = cf_low()?;     // no `From<CfLowError>` for `CfHighError`   //~ ERROR[E0214] the `?` operator cannot convert the error
    return Result::Ok(v);
}
