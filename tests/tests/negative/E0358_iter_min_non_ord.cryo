// E0358: `min`/`max` are `Iterator` trait-default methods bounded on
// `where This::Item: Ord`. Calling `.min()` on an iterator whose element type
// is NOT `Ord` must be rejected at sema as a missing method - the projection
// bound gates the method's availability - rather than resolving via the trait
// default and failing later at codegen.
![config(testing)]
![config(negative, E0358)]
namespace CryoTests::Negative::E0358IterMinNonOrd;

import std::core::option;
import std::core::iter;

// A payload type with NO `Ord` implementation.
type struct NotOrdered {
    x: i32;
}

type struct OneShot {
    used: boolean;
    static make() -> OneShot { return OneShot { used: false }; }
}

implement trait Iterator<NotOrdered> for struct OneShot {
    next(mut &this) -> Option<NotOrdered> {
        if (this.used) { return Option::None; }
        this.used = true;
        return Option::Some(NotOrdered { x: 1 });
    }
}

function main() -> int {
    mut it: OneShot = OneShot::make();
    it.min();          // no method `min`: NotOrdered is not `Ord`
    return 0;
}
