// E0008: a binary literal whose only body is a separator (`0b_`). Same
// silent-0 hazard as the hex case: a lone `_` would defeat the "cursor
// moved" guard. The lexer requires at least one real binary digit.
![config(testing)]
![config(negative, E0008)]
namespace CryoTests::Negative::EmptyBinaryUnderscore;

function main() -> int {
    const x: i32 = 0b_;
    return 0;
}
