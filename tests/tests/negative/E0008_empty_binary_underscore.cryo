// E0008: a binary literal whose only body is a separator (`0b_`). Same
// silent-0 bug as the hex case: the lone `_` defeated the "cursor moved"
// guard. The lexer now requires at least one real binary digit.
![config(testing)]
![config(negative, E0008)]
namespace CryoTests::Negative::EmptyBinaryUnderscore;

function main() -> int {
    const x: i32 = 0b_;
    return 0;
}
