// `intrinsic const` is not a declaration: an intrinsic is a function the
// compiler lowers, and a source location is the function
// `intrinsics::location()`.  The parser refuses the form where it reads
// the intrinsic's name.
![config(testing)]
![config(negative, E0100)]
namespace CryoTests::Negative::IntrinsicConstRemoved;

intrinsic const ANSWER: i32;    //~ ERROR[E0100] expected intrinsic name, found 'const'

function main() -> int {
    return 0;
}
