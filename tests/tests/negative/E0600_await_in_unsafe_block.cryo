// E0600: an `await` inside an `unsafe` block is rejected.
//
// The lowering explodes a body into states around suspends, and every state is
// a separate block reached by the resume dispatch. An `unsafe` block holding an
// await would be split across those states, so the scope would end at the first
// suspend and the operations it authorises after that point would be checked as
// safe — the block would silently stop meaning what it says.
//
// The rewrite is to lift the suspend out of the block, which is always possible
// because `unsafe` marks the operations, not the wait:
//   const v: i64 = await f();
//   unsafe { … }
![config(testing)]
![config(negative, E0600)]
namespace CryoTests::Negative::E0600AwaitInUnsafeBlock;

import std::future;

async function ready_one(v: i64) -> i64 {
    return await PendingThenReady<i64>::new(1, v);
}

async function awaits_inside_unsafe() -> i64 {
    unsafe {                                     //~ ERROR[E0600] async: an `await` inside an `unsafe` block is not supported
        const v: i64 = await ready_one(41);
        return v + 1;
    }
}

function main() -> i32 {
    return future::block_on(awaits_inside_unsafe()) as i32;
}
