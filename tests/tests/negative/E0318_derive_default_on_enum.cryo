// E0318: which variant is an enum's default is the type's own choice, so
// an enum cannot derive `Default`; the entry is refused and the enum's
// other entries are still generated.  A struct deriving `Default` is the
// control.
![config(testing)]
![config(negative, E0318)]
namespace CryoTests::Negative::E0318DeriveDefaultOnEnum;

import std::core::cmp::{ Eq };
import std::core::default::{ Default };

type enum DdChoice with [Eq, Default] {   //~ ERROR[E0318] an enum cannot derive `Default`
    First;
    Second;
}

type struct DdPlain with [Default] {
    x: i64;
}

function main() -> i32 {
    return 0;
}
