// E0455: a pointer into the poll frame may not be held across an `await`.
//
// An `async function` lowers to a state machine whose every poll runs on a
// fresh native frame, and a carried local is re-materialized at a new address
// in each state.  A pointer taken before a suspend therefore names storage
// that is already dead when a later state writes through it - and a write to a
// dead frame slot corrupts silently instead of faulting, which is why this has
// to be a compile error.  The remedy is to let the caller own the storage and
// pass a pointer parameter, whose pointee no suspend moves.
![config(testing)]
![config(negative, E0455)]
namespace CryoTests::Negative::E0455AsyncPointerToCarriedLocal;

import std::future;

async function ptr_across_await() -> i64 {
    mut buf: u8[8] = [0; 8];
    const p: u8* = &buf[0];   //~ ERROR[E0455] async: `p` holds the address of the local or parameter `buf`
    const _z: i64 = await PendingThenReady<i64>::new(2, 1);
    *p = 42;
    return buf[0] as i64;
}

function main() -> int { return 0; }
