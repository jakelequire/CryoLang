///! Every local holds a value before it is read, whatever its type: a
///! number, a `Copy` struct, a reference and a pointer as much as an owning
///! value.  Reading one that a path has not given a value reads whatever the
///! stack held, and a reference or pointer read that way points anywhere.
///! For a local of a `Copy` type the rule warns (W0018) until existing code
///! gives such locals their values; for an owning one it is E0219.

![config(testing)]
![config(negative, W0018)]
namespace CryoTests::Negative::W0018CopyLocalReadBeforeValue;

type struct Point {
    x: i64;
    y: i64;
}

function scalar_never_assigned() -> i64 {
    mut count: i64;
    return count;
    //~^ WARN[W0018] use of `count`, which is not initialised on every path here
}

function scalar_assigned_on_one_branch(ready: boolean) -> i64 {
    mut count: i64;
    if (ready) { count = 1; }
    return count;
    //~^ WARN[W0018] use of `count`, which is not initialised on every path here
}

function scalar_assigned_in_a_loop_body(times: i64) -> i64 {
    mut last: i64;
    for (mut i: i64 = 0; i < times; i++) { last = i; }
    return last;
    //~^ WARN[W0018] use of `last`, which is not initialised on every path here
}

function compound_assignment_reads(step: i64) -> i64 {
    mut total: i64;
    total += step;
    //~^ WARN[W0018] use of `total`, which is not initialised on every path here
    return 0;
}

function struct_member_missing() -> i64 {
    mut p: Point;
    p.x = 1;
    return p.y;
    //~^ WARN[W0018] use of `p`, which is not initialised on every path here
}

function buffer_filled_by_a_runtime_index(length: i64) -> u8 {
    mut buffer: [u8; 4];
    for (mut i: i64 = 0; i < length; i++) { buffer[i] = 1; }
    return buffer[0];
    //~^ WARN[W0018] use of `buffer`, which is not initialised on every path here
}

function reference_on_a_branch_not_taken(ready: boolean, value: &i64) -> i64 {
    mut r: &i64;
    if (ready) { r = value; }
    return *r;
    //~^ WARN[W0018] use of `r`, which is not initialised on every path here
}

function pointer_never_assigned() -> boolean {
    mut p: i64*;
    return p == null;
    //~^ WARN[W0018] use of `p`, which is not initialised on every path here
}

function reference_to_a_scalar_not_set() -> i64 {
    mut count: i64;
    const r: &i64 = &count;
    //~^ WARN[W0018] reference to `count`, which is not initialised on every path here
    return *r;
}

function fill(place: mut i64*) -> void { *place = 3; }

// Not reported, and so carrying no annotation: an annotated file fails on any
// W0018 it does not name.
function given_a_value_on_every_path(ready: boolean) -> i64 {
    mut count: i64;
    if (ready) { count = 1; } else { count = 2; }
    return count;
}

function every_member_assigned() -> i64 {
    mut p: Point;
    p.x = 1;
    p.y = 2;
    return p.x + p.y;
}

function handed_out_to_be_filled() -> i64 {
    mut count: i64;
    fill(&count);
    return count;
}

function assigned_before_a_diverging_branch(ready: boolean) -> i64 {
    mut count: i64;
    if (!ready) { return 0; }
    count = 5;
    return count;
}

function empty_array_has_nothing_to_write() -> i64 {
    const none: [i32; 0];
    const view: &Slice<i32> = &none;
    return view.length();
}

function buffer_given_a_value(length: i64) -> u8 {
    mut buffer: [u8; 4] = [0; 4];
    for (mut i: i64 = 0; i < length; i++) { buffer[i] = 1; }
    return buffer[0];
}

function main() -> i32 {
    return 0;
}
