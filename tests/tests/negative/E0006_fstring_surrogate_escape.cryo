// E0006: a `\u{...}` escape naming a surrogate in an f-string, refused as
// in a string literal.  The escape is one escape there too, so its braces
// open no hole.
![config(testing)]
![config(negative, E0006)]
namespace CryoTests::Negative::FstringSurrogateEscape;

import std::collections::string::{ String };

function main() -> int {
    const n: i32 = 1;
    const text: String = f"pair \u{dbff}{n}\u{dc00}";
    //~^ ERROR[E0006] `\u{dbff}` is a surrogate, not a character
    //~^^ ERROR[E0006] `\u{dc00}` is a surrogate, not a character
    return 0;
}
