// E0306: a closure that borrows values of the function that made it is not
// `Send`: another thread may outlive what it borrows.  A `move` closure owns
// what it captures and is `Send` when its captures are (the control).
![config(testing)]
![config(negative, E0306)]
namespace CryoTests::Negative::BorrowingClosureNotSend;

type struct Res {
    tag: i64;
}

implement trait Drop for struct Res {
    drop(mut &this) -> void { }
}

function on_thread<F>(f: F) -> i64 where F: Send + () -> i64 { return f(); }

function borrowing() -> i64 {
    const p: Res = Res { tag: 1 };
    return on_thread(() -> i64 { return p.tag; });
    //~^ ERROR[E0306] is not satisfied
}

function owning() -> i64 {
    const p: Res = Res { tag: 2 };
    return on_thread(move () -> i64 { return p.tag; });
}

function main() -> int { return 0; }
