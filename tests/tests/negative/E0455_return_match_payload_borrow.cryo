// E0455: a `match` arm binds the payload of a value the compiler
// materializes into a temporary, so a pointer/reference to that binding is
// only valid until the function returns. Returning such a borrow used to
// compile and then dangle at runtime - a use-after-free, the same shape
// that crashed `JsonValue::as_object` (`match (this) { Object(o) => Some(o) }`
// returning `Option<JsonObject*>`). Sema now rejects it before codegen.
//
// This case returns the payload pointer directly (`return p` with an
// `Inner*` return type); the `Some(p)`-wrapped variant is rejected the same
// way under a full build. Returning the payload BY VALUE (a move) is
// unaffected - the discriminator is whether the return type carries a
// *pointer* to the binding's value type. See passes/sema.cryo
// `check_return_payload_escape`.
![config(testing)]
![config(negative, E0455)]
namespace CryoTests::Negative::ReturnMatchPayloadBorrow;

type struct Inner {
    x: i32;
    drop(mut &this) -> void { }
}

type enum Wrap {
    Has(Inner);
    Nothing;
}

implement enum Wrap {
    inner_ptr(&this) -> Inner* {
        match (this) {
            Wrap::Has(p)  => { return p; }        // borrows a match temporary
            Wrap::Nothing => { return null; }
        }
    }
}

function main() -> int {
    return 0;
}
