// E0312: only a struct's `new` takes its memory from an `Allocate`
// implementation, so one written for an enum would never run.
// It is refused at its head rather than accepted and ignored.
![config(testing)]
![config(negative, E0312)]
namespace CryoTests::Negative::AllocateForEnum;

mut g_calls: i32 = 0;

type enum E { A(i32); B; }

implement trait Allocate for enum E {  //~ ERROR[E0312] trait `Allocate` can be implemented only for a struct, and `CryoTests::Negative::AllocateForEnum::E` is not one
    static allocate(size: u64, align: u64) -> void* {
        g_calls = g_calls + 1;
        return 0 as void*;
    }
}

function main() -> int {
    const p: E* = new E::A(3);
    return g_calls;
}
