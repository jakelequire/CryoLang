// E0318: a trait listed twice in one `with` clause is refused at its second
// entry, whether the two are spelled alike or one is qualified; the first
// is still generated.  Each trait listed once is the control.
![config(testing)]
![config(negative, E0318)]
namespace CryoTests::Negative::E0318DeriveListedTwice;

import std::core::cmp;
import std::core::cmp::{ Eq };
import std::core::clone::{ Clone };

type struct DtTwice with [Eq, Clone, Eq] {   //~ ERROR[E0318] `Eq` is listed twice in the `with` clause
    x: i64;
}

type struct DtSpelledTwoWays with [Eq, cmp::Eq] {   //~ ERROR[E0318] `cmp::Eq` is listed twice in the `with` clause
    x: i64;
}

type struct DtOnce with [Eq, Clone] {
    x: i64;
}

function main() -> i32 {
    return 0;
}
