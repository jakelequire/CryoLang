// E0317: a bound's type arguments fill its trait's parameters, then the
// trait's own associated types, in the order it declares them, and a bound
// writing more of them than that is refused where it is written - in a
// where clause, as a supertrait, and as an associated type's declared bound
// - once, and not again at a call the bound would be unmet at.  A
// supertrait's associated type is no position of the trait's:
// `IndexMutable<Idx>` takes one argument although its supertrait `Index`
// has an `Output`.  The bounds writing every position, or fewer, are the
// control.
![config(testing)]
![config(negative, E0317)]
namespace CryoTests::Negative::E0317BoundTooManyTraitArguments;

import std::core::ops::{ Index, IndexMutable };

type struct TaTriple { a: i32; }

implement trait Index<u64> for TaTriple {
    type Output = i32;
    index(&this, i: u64) -> const i32* { return &this.a; }
}

implement trait IndexMutable<u64> for TaTriple {
    index_mutable(mut &this, i: u64) -> mut i32* { return &this.a; }
}

type trait TaPlain {
    describe(&this) -> i32;
}

type trait TaWide : Index<u64, i32, f64> { }   //~ ERROR[E0317] `Index` takes at most 2 type arguments in a bound, and 3 are written

type trait TaHolds {
    type Item: TaPlain<i32>;   //~ ERROR[E0317] `TaPlain` takes no type arguments in a bound, and 1 is written
}

type trait TaNarrow : Index<u64> { }

function set_at<T>(c: mut &T, v: i32) -> void where T: IndexMutable<u64, i32> {   //~ ERROR[E0317] `IndexMutable` takes at most 1 type argument in a bound, and 2 are written
    c[0 as u64] = v;
}

function read_at<T>(c: &T) -> i32 where T: Index<u64, i32> {
    return c[0 as u64];
}

function write_at<T>(c: mut &T, v: i32) -> void where T: IndexMutable<u64>, T: Index<u64, i32> {
    c[0 as u64] = v;
}

function main() -> int {
    mut t: TaTriple = TaTriple { a: 1 };
    set_at(&t, 5);
    write_at(&t, 6);
    return read_at(&t);
}
