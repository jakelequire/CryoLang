// E0353: the wire records behind HTTP/2 and WebSocket are internal to the
// standard library.  A program speaks HTTP/2 through `Http2Connection`,
// `Http2Server` and the HTTP client, and a header block through its
// `HeaderCodec`; it never holds a decoded frame, the SETTINGS record a
// connection folds, or the frame reader.  WebSocket's frame codec and its
// handshake are internal modules: a program holds a `WebSocket`, made by
// `connect` or `accept`.
![config(testing)]
![config(negative, E0353)]
namespace CryoTests::Negative::E0353NetworkWireRecordsAreInternal;

import std::io::buffered::{ BufferedStream };
import std::net::socket::tcp::{ TcpStream };
import std::net::http2::frame::{ Frame };
//~^ ERROR[E0353] `std::net::http2::frame::Frame` is internal to its package and cannot be imported into `CryoTests::Negative::E0353NetworkWireRecordsAreInternal`
import std::net::http2::settings::{ Settings };
//~^ ERROR[E0353] `std::net::http2::settings::Settings` is internal to its package and cannot be imported into `CryoTests::Negative::E0353NetworkWireRecordsAreInternal`
import std::net::ws::frame as ws_frame;
//~^ ERROR[E0353] module `std::net::ws::frame` is internal to its package and cannot be imported into `CryoTests::Negative::E0353NetworkWireRecordsAreInternal`
import std::net::ws::handshake;
//~^ ERROR[E0353] module `std::net::ws::handshake` is internal to its package and cannot be imported into `CryoTests::Negative::E0353NetworkWireRecordsAreInternal`

async function read_one(c: mut &BufferedStream<TcpStream>) -> boolean {
    return (await c.read_http2_frame(16384)).is_ok();
    //~^ ERROR[E0353] method `read_http2_frame` of `std::io::buffered::BufferedStream` is internal
}

function main() -> int {
    return 0;
}
