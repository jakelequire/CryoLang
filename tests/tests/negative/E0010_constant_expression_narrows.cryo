// An expression made only of integer literals, stored where an integer of a
// narrower type is - a constant's initializer, a local's, an assignment's
// value - is refused when that type does not hold its value: computed at the
// type's width it would silently become another number.  `100 + 100` fits a
// `u8` and `0 - 128` an `i8`, so neither is refused.
![config(testing)]
![config(negative, E0010)]
namespace CryoTests::Negative::ConstantExpressionNarrows;

const A: u8 = 200 + 100;                 //~ ERROR[E0010] this value is 300, which `u8` does not hold

function main() -> int {
    const b: u8 = 250 + 10;              //~ ERROR[E0010] this value is 260, which `u8` does not hold
    const c: i8 = -100 - 100;            //~ ERROR[E0010] this value is -200, which `i8` does not hold
    const d: u32 = 5 - 10;               //~ ERROR[E0010] this value is -5, which `u32` does not hold
    mut e: u8 = 0;
    e = 255 + 1;                         //~ ERROR[E0010] this value is 256, which `u8` does not hold
    const f: u8 = 100 + 100;
    const g: i8 = 0 - 128;
    return (A as int) + (b as int) + (c as int) + (d as int) + (e as int) + (f as int) + (g as int);
}
