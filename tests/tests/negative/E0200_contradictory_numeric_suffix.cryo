// E0200: a type suffix names the literal's type, so a contradicting annotation
// is a mismatch rather than something the annotation silently wins.
![config(testing)]
![config(negative, E0200)]
namespace CryoTests::Negative::ContradictoryNumericSuffix;
function main() -> int { const x: i32 = 7u64; return 0; }   //~ ERROR[E0200] mismatched types
