///! A statement that discards a value whose type is marked `![must_use]`,
///! or the value a function or method marked `![must_use]` returns, warns.
///! A value bound, returned, or passed on is read, and warns nothing.

![config(testing)]
![config(negative, W0017)]
namespace CryoTests::Negative::W0017MustUseValueDiscarded;

![must_use]
type struct Token {
    value: i32;
}

![must_use]
type enum Outcome {
    Done;
    Failed;
}

type struct Counter {
    count: i32;

    ![must_use]
    increment(mut &this) -> i32 {
        this.count = this.count + 1;
        return this.count;
    }

    plain(mut &this) -> i32 {
        return this.count;
    }
}

type struct Holder<T> {
    held: T;

    ![must_use]
    take(&this) -> i32 {
        return 7;
    }
}

function make_token() -> Token {
    return Token { value: 1 };
}

function finish() -> Outcome {
    return Outcome::Done;
}

![must_use]
function checked() -> i32 {
    return 3;
}

![must_use]
function first<T>(value: T) -> T {
    return value;
}

function consume(token: Token) -> i32 {
    return token.value;
}

function main() -> i32 {
    make_token();   //~ WARN[W0017] this statement discards a value of type `Token`, which must be used
    finish();   //~ WARN[W0017] this statement discards a value of type `Outcome`, which must be used
    checked();   //~ WARN[W0017] this statement discards the value `checked` returns, which must be used
    first::<i32>(4);   //~ WARN[W0017] this statement discards the value `first` returns, which must be used
    mut counter: Counter = Counter { count: 0 };
    counter.increment();   //~ WARN[W0017] this statement discards the value `increment` returns, which must be used
    counter.plain();
    const holder: Holder<i64> = Holder::<i64> { held: 2 };
    holder.take();   //~ WARN[W0017] this statement discards the value `take` returns, which must be used

    const _: Token = make_token();
    const kept: i32 = checked();
    const counted: i32 = consume(make_token());
    match (finish()) {
        Outcome::Done   => { }
        Outcome::Failed => { }
    }
    match (finish()) {
        Outcome::Done   => { make_token() }   //~ WARN[W0017] this statement discards a value of type `Token`, which must be used
        Outcome::Failed => { }
    }
    mut stored: Token = make_token();
    stored = make_token();
    const chosen: Token = match (finish()) {
        Outcome::Done   => { make_token() }
        Outcome::Failed => {
            const spare: i32 = checked();
            Token { value: spare }
        }
    };
    return kept + counted + counter.increment() + stored.value + chosen.value;
}
