// E0465: an operation in an enum discriminant is computed in its operands'
// type, as a constant's initializer is, and one that overflows that type is
// refused where it is written.
![config(testing)]
![config(negative, E0465)]
namespace CryoTests::Negative::E0465EnumDiscriminantOverflowsItsType;

type enum Narrow {
    Sum = (250 as u8) + (10 as u8);
    //~^ ERROR[E0465] `(250 as u8) + (10 as u8)` overflows `u8`: its value is 260, which `u8` does not hold
}

function main() -> i32 {
    return Narrow::Sum as i32;
}
