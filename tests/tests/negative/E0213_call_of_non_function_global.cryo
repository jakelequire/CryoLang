// E0213: a module's global called, and its type is no function.  A global is
// a value, called as a local is: through a function type, and refused at the
// callee for any other.  A global of function type is called through
// (`f(2)`).
![config(testing)]
![config(negative, E0213)]
namespace CryoTests::Negative::CallOfNonFunctionGlobal;

function inc(x: i32) -> i32 { return x + 1; }

const limit: i32 = 5;
const f: (i32) -> i32 = inc;

function main() -> int {
    const a: i32 = limit(3);     //~ ERROR[E0213] expected function, found `i32`
    const ok: i32 = f(2);
    return a + ok;
}
