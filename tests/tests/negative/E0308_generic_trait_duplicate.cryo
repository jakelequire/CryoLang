// E0308: a *generic* trait is implemented twice for the same type with the
// SAME type argument. Coherence keys on the full impl head (trait + args,
// target + args, bounds), so `Conv<i8>` twice collides - while `Conv<i8>`
// and `Conv<i16>` (see the two impls below differ only in this respect)
// would NOT, which is what makes this distinct from the arg-less case in
// E0308_conflicting_trait_impl.cryo.
![config(testing)]
![config(negative, E0308)]
namespace CryoTests::Negative::E0308GenericTraitDuplicate;

type trait Conv<T> { conv(&this, v: T) -> int; }
type struct Foo { x: int; }

implement trait Conv<i8> for struct Foo { conv(&this, v: i8) -> int { return 1; } }
implement trait Conv<i8> for struct Foo { conv(&this, v: i8) -> int { return 2; } }

function main() -> int { return 0; }
