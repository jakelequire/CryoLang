// E0013: a malformed octal escape.  `\` and one to three digits `0`-`7` is
// the byte they spell (`\033` is ESC), so `\8` and `\9` name no escape, and
// a value past `\377` names no byte.  Each form is refused where it is
// written: a string, a character literal, and the text of an f-string.
![config(testing)]
![config(negative, E0013)]
namespace CryoTests::Negative::BadOctalEscape;
function main() -> int {
    const a: string = "\8";          //~ ERROR[E0013] `\8` is not an escape
    const c: char = '\9';            //~ ERROR[E0013] `\9` is not an escape
    const b: string = "\400";        //~ ERROR[E0013] `\400` is out of range
    const n: int = 3;
    const f = f"\777 {n}";           //~ ERROR[E0013] `\777` is out of range
    return 0;
}
