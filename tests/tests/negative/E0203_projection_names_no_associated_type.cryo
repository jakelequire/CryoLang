// E0203: a projection is refused where it is written when nothing answers
// which trait's associated type it is - no bound of the parameter declares
// it, two bounds do, or `This` stands for no trait or for one that declares
// no such type.  It is not kept as a projection keyed by its written name.
// `I::Item` under `where I: Seq` is `Seq`'s, and is fine.
![config(testing)]
![config(negative, E0203)]
namespace CryoTests::Negative::ProjectionNamesNoAssociatedType;

type trait Seq {
    type Item;
    first(&this) -> i32;
}

type trait Other {
    type Item;
    second(&this) -> i32;
}

type trait Shown {
    show(&this) -> i32;
}

type struct Plain {
    v: i32;
}

function fine<I>(it: &I) -> I::Item where I: Seq { return it.first(); }
function unknown<I>(it: &I) -> I::Nope where I: Seq { return it.first(); }      //~ ERROR[E0203] associated type `Nope` not found for `I`
function unbounded<I>(it: &I) -> I::Item { return 0; }                         //~ ERROR[E0203] associated type `Item` not found for `I`
function both<I>(it: &I) -> I::Item where I: Seq, I: Other { return 0; }      //~ ERROR[E0203] ambiguous associated type `Item` in bounds of `I`
function subject<I>(it: &I) -> i32 where I: Seq, I::Nope: Shown { return 0; }  //~ ERROR[E0203] associated type `Nope` not found for `I`

type trait Holder {
    type Item;
    get(&this) -> This::Nope;                                                  //~ ERROR[E0203] associated type `Nope` not found for `This`
}

implement struct Plain {
    own(&this) -> This::Item { return this.v; }                                //~ ERROR[E0203] associated type `Item` not found for `This`
}

function main() -> int {
    return 0;
}
