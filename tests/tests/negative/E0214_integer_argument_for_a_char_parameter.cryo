// E0214: a `char` parameter takes a character, and an integer of any width
// becomes one only through `as char`.  A byte, a 32-bit value, a constant, a
// decimal or hexadecimal literal and a 64-bit value are each refused, at a
// method and at a free function; each converted with `as char`, and a
// character literal, is taken.
![config(testing)]
![config(negative, E0214)]
namespace CryoTests::Negative::IntegerArgumentForACharParameter;

const SMALL: u8 = 7;

type struct Builder {
    count: i64;
    put(mut &this, c: char) -> void { this.count = this.count + (c as i64); }
}

function take(c: char) -> i64 { return c as i64; }

function main() -> int {
    mut b: Builder = Builder { count: 0 };
    const byte: u8 = 1;
    const wide: u32 = 2;
    const big: i64 = 66;
    b.put(byte);
    //~^ ERROR[E0214] mismatched types
    b.put(wide);
    //~^ ERROR[E0214] mismatched types
    b.put(SMALL);
    //~^ ERROR[E0214] mismatched types
    b.put(65);
    //~^ ERROR[E0214] mismatched types
    b.put(0x41);
    //~^ ERROR[E0214] mismatched types
    b.put(big);
    //~^ ERROR[E0214] mismatched types
    b.put(-1);
    //~^ ERROR[E0214] mismatched types
    take(byte);
    //~^ ERROR[E0214] mismatched types
    take(65);
    //~^ ERROR[E0214] mismatched types
    b.put(byte as char);
    b.put(65 as char);
    b.put('A');
    return (take(wide as char) + b.count) as int;
}
