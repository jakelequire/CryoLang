// E0010: a `char` holds a Unicode scalar value, U+0000 to U+D7FF or U+E000
// to U+10FFFF, so `as char` of a constant outside them - past U+10FFFF, a
// surrogate code point, below zero - is refused where it is written, a
// named constant's value included.  Each range's own bounds are held, and
// an operand known only when the program runs is not judged.
![config(testing)]
![config(negative, E0010)]
namespace CryoTests::Negative::ConstantCastToCharPastUnicode;

const PAST: u32 = 0x110000;

function convert(code: u32) -> char {
    return code as char;
}

function main() -> i32 {
    const first: char = 0 as char;
    const before_surrogates: char = 0xD7FF as char;
    const after_surrogates: char = 0xE000 as char;
    const last: char = 0x10FFFF as char;
    const past: char = 0x110000 as char;
    //~^ ERROR[E0010] `as char` makes no `char` of 1114112: it is past U+10FFFF, the last Unicode scalar value
    const low_surrogate: char = 0xD800 as char;
    //~^ ERROR[E0010] `as char` makes no `char` of 55296: it is a surrogate code point, U+D800 to U+DFFF, which is no Unicode scalar value
    const high_surrogate: char = 0xDFFF as char;
    //~^ ERROR[E0010] `as char` makes no `char` of 57343: it is a surrogate code point, U+D800 to U+DFFF, which is no Unicode scalar value
    const negative: char = -1 as char;
    //~^ ERROR[E0010] `as char` makes no `char` of -1: it is below zero
    const named: char = PAST as char;
    //~^ ERROR[E0010] `as char` makes no `char` of 1114112: it is past U+10FFFF, the last Unicode scalar value
    const computed: char = (0x10FFFF + 1) as char;
    //~^ ERROR[E0010] `as char` makes no `char` of 1114112: it is past U+10FFFF, the last Unicode scalar value
    const at_run_time: char = convert(0x41);
    return (first as i32) + (before_surrogates as i32) + (after_surrogates as i32) + (last as i32)
        + (past as i32) + (low_surrogate as i32) + (high_surrogate as i32) + (negative as i32)
        + (named as i32) + (computed as i32) + (at_run_time as i32);
}
