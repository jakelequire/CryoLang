// E0214: `?` in a generic function, where the conversion of the error
// involves a type parameter and no `where` bound gives it.  A generic body
// is typed once, by its bounds, so `where F: From<E>` or `where
// CfHighError: From<E>` on the function's own error type is what makes the
// conversion exist; no bound, or a bound naming another argument, does not.
// Each `?` is refused where it is written, whether or not anything
// instantiates the function.
![config(testing)]
![config(negative, E0214)]
namespace CryoTests::Negative::E0214TryGenericErrorWithoutBound;

import std::core::result;
import std::core::convert::{ From };

type enum CfLowError { Bad; }
type enum CfHighError { Wrapped; }

implement trait From<CfLowError> for enum CfHighError {
    static from(e: CfLowError) -> CfHighError { return CfHighError::Wrapped; }
}

function cf_unbound<E, F>(r: Result<i32, E>) -> Result<i32, F> {
    const n: i32 = r?;     //~ ERROR[E0214] the `?` operator cannot convert the error `E` into `F`
    return Result::Ok(n);
}

function cf_other_argument<E, F>(r: Result<i32, E>) -> Result<i32, F> where F: From<i32> {
    const n: i32 = r?;     //~ ERROR[E0214] the `?` operator cannot convert the error `E` into `F`
    return Result::Ok(n);
}

function cf_concrete<E>(r: Result<i32, E>) -> Result<i32, CfHighError> where CfHighError: From<i32> {
    const n: i32 = r?;     //~ ERROR[E0214] the `?` operator cannot convert the error `E` into `CfHighError`
    return Result::Ok(n);
}
