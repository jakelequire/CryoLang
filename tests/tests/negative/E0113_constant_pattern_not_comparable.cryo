// E0113: a constant pattern compares the subject with the constant's value,
// so the constant's type must be one compared by value.  A struct, or an
// enum whose variant carries a payload, has no such comparison.
![config(testing)]
![config(negative, E0113)]
namespace CryoTests::Negative::E0113ConstantPatternNotComparable;

type struct Point { x: i32; y: i32; }

type enum Shape { Dot; Line(i32); }

const ORIGIN: Point = Point { x: 0, y: 0 };
const DOT: Shape = Shape::Dot;

function point(p: Point) -> i32 {
    return match (p) {
        ORIGIN => { 1 }
        //~^ ERROR[E0113] constant `ORIGIN` of type `CryoTests::Negative::E0113ConstantPatternNotComparable::Point` cannot be matched against
        _ => { 0 }
    };
}

function shape(s: Shape) -> i32 {
    return match (s) {
        DOT => { 1 }
        //~^ ERROR[E0113] constant `DOT` of type `CryoTests::Negative::E0113ConstantPatternNotComparable::Shape` cannot be matched against
        _ => { 0 }
    };
}

function main() -> int {
    return point(Point { x: 0, y: 0 }) + shape(Shape::Dot);
}
