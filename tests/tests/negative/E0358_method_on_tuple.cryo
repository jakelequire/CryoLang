// E0358: a tuple type names no type that declares methods, so a call on a
// tuple names no method.  Refused where the call is written, not left for
// code generation to find unresolved.
![config(testing)]
![config(negative, E0358)]
namespace CryoTests::Negative::MethodOnTuple;

function first(t: (i32, i32)) -> i32 {
    return t.missing();
    //~^ ERROR[E0358] no method named `missing` found on type `(i32, i32)`
}

function main() -> int {
    return 0;
}
