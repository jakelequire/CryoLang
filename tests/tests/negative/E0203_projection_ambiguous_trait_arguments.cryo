// E0203: a parameter bounded twice by a trait with a parameter has two of
// the trait's associated type, one per instance (`Get<i64>`'s and
// `Get<boolean>`'s), so a projection naming it is ambiguous and is refused
// where it is written.  A single bound of the same trait is the control:
// `T::Out` under `where T: Get<boolean>` is accepted.
![config(testing)]
![config(negative, E0203)]
namespace CryoTests::Negative::ProjectionAmbiguousTraitArguments;

type trait Get<K> {
    type Out;
    get(&this, k: K) -> This::Out;
}

function both<T>(t: &T) -> T::Out where T: Get<i64>, T: Get<boolean> {   //~ ERROR[E0203] ambiguous associated type `Out` in bounds of `T`
    return t.get(true);
}

function one<T>(t: &T) -> T::Out where T: Get<boolean> {
    return t.get(true);
}

function main() -> int {
    return 0;
}
