// E0100: a ternary written with its `?` against the condition.  A `?`
// with nothing between it and its operand is the try operator, which no
// name or literal can follow; the ternary's `?` takes a space before it.
![config(testing)]
![config(negative, E0100)]
namespace CryoTests::Negative::TernaryQuestionAgainstOperand;

function cf_pick(flag: boolean, a: i32, b: i32) -> i32 {
    return flag?a:b;
    //~^ ERROR[E0100] a `?` written against its operand is the try operator; a ternary's `?` takes a space before it (`cond ? a : b`)
}

function main() -> int {
    return cf_pick(true, 0, 1);
}
