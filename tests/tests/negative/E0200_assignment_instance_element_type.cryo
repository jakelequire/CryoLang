// E0200: an assignment is judged as a declaration's initializer is.  A
// dynamic array of one element type assigned to one of another, to a local
// or to a field, and an `Option<i64>` assigned to an `Option<i32>`, are each
// a mismatch: the instantiation is one type before it is minted, and the
// assignment is the only place the pair is checked.
![config(testing)]
![config(negative, E0200)]
namespace CryoTests::Negative::AssignmentInstanceElementType;

import std::core::option::{ Option };

type enum E { A(i32*); B(i64*); }
type struct S { xs: [E]; }

function main() -> i32 {
    mut s: S = S { xs: [] };
    mut ys: [i32*] = [];
    mut local: [E] = [];
    local = ys;
    //~^ ERROR[E0200] mismatched types
    s.xs = ys;
    //~^ ERROR[E0200] mismatched types
    mut a: Option<i32> = Option::None;
    const b: Option<i64> = Option::None;
    a = b;
    //~^ ERROR[E0200] mismatched types
    return 0;
}
