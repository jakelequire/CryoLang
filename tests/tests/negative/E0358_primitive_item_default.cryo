// E0358: a trait default bounded `where This::Item: Zap` is unavailable on an
// impl whose `Item` is a primitive that does not implement `Zap`.  The
// primitive written by its keyword is a concrete `Item`, decided at the call
// like a declared type's - not a symbolic one kept and failed later.
![config(testing)]
![config(negative, E0358)]
namespace CryoTests::Negative::E0358PrimitiveItemDefault;

type trait Zap {
    zap(&this) -> i32;
}

type trait Source {
    type Item;
    get(&this) -> This::Item;
    total(&this) -> i32 where This::Item: Zap {
        return this.get().zap();
    }
}

type struct Nums {
    v: u32;
}

implement trait Source<u32> for Nums {
    get(&this) -> u32 { return this.v; }
}

function main() -> int {
    const n: Nums = Nums { v: 3 };
    n.total();         // no method `total`: u32 is not `Zap`   //~ ERROR[E0358] no method named `total` found on
    return 0;
}
