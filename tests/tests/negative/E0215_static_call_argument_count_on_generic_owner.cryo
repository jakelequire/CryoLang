// E0215 / E0216: a static call through a generic owner written bare - its
// arguments defaulted (`String`) or left to inference (`HashMap`) - is
// counted against the owner's methods of the name before the instance
// exists, and a call writing its type arguments (`make::<i64>`) is counted
// against the instance's parameters; none of them reaches code generation
// unresolved.
![config(testing)]
![config(negative, E0215)]
namespace CryoTests::Negative::StaticCallArgumentCountOnGenericOwner;

import std::collections::string::{ String };
import std::collections::hashmap::{ HashMap };

type struct Defaulted<T = i64> {
    value: T;

    static of(value: T) -> Defaulted<T> { return Defaulted::<T> { value: value }; }
}

function make<T>(seed: T) -> T { return seed; }

function text() -> String {
    return String::new("");
    //~^ ERROR[E0215] static method `new` takes 0 argument(s) but 1 were supplied
}

function main() -> int {
    const named: String = text();
    const map: HashMap<i64, i64> = HashMap::new(4);
    //~^ ERROR[E0215] static method `new` takes 0 argument(s) but 1 were supplied
    const held: Defaulted = Defaulted::of();
    //~^ ERROR[E0216] static method `of` takes 1 argument(s) but 0 were supplied
    const few: i64 = make::<i64>();
    //~^ ERROR[E0216] function `make` takes 1 argument(s) but 0 were supplied
    const many: i64 = make::<i64>(1, 2);
    //~^ ERROR[E0215] function `make` takes 1 argument(s) but 2 were supplied
    return 0;
}
