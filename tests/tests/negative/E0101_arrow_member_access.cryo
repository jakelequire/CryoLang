///! `->` is not a member-access operator in Cryo: `.` auto-dereferences, so
///! `ptr.field` resolves the member whether the receiver is a value or a
///! pointer. Writing `ptr->field` must be rejected (E0101) with a suggestion
///! to use `.` instead.

![config(testing)]
![config(negative, E0101)]
namespace CryoTests::Negative::E0101ArrowMemberAccess;

type struct Pt { x: i32; y: i32; }

function main() -> int {
    const p: Pt = Pt { x: 3, y: 4 };
    const pp: Pt* = &p;
    return pp->x;   // E0101: `->` is not valid; use `.`   //~ ERROR[E0101] `->` is not a valid operator; use
}
