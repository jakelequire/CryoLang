// E0205: a trait declares each method name once.  A trait's methods are
// looked up by name, so a second `area` would leave every implementation
// to be checked against one of the two signatures and reported missing or
// mismatched where nothing is wrong.  Refused at the second declaration.
![config(testing)]
![config(negative, E0205)]
namespace CryoTests::Negative::TraitMethodDeclaredTwice;

type trait Shape {
    area(&this) -> i32;
    area(&this, scale: i32) -> i32;   //~ ERROR[E0205] the method `area` is declared twice in this trait
}

function main() -> int {
    return 0;
}
