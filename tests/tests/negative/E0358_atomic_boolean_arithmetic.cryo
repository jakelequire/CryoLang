///! `fetch_add` and `fetch_sub` are an integer atomic's alone (`where T:
///! Integer`): on `Atomic<boolean>` they would add to the 0/1 backing byte
///! and store a byte that is neither, so a call is refused.  The boolean
///! read-modify-writes stay.

![config(testing)]
![config(negative, E0358)]
namespace CryoTests::Negative::E0358AtomicBooleanArithmetic;

import std::sync::atomic::{ Atomic, MemoryOrder };

function main() -> i32 {
    const flag: Atomic<boolean> = Atomic::new(true);
    flag.fetch_add(true, MemoryOrder::SeqCst);
    //~^ ERROR[E0358] the trait bound `boolean: Integer` is not satisfied
    flag.fetch_sub(true, MemoryOrder::SeqCst);
    //~^ ERROR[E0358] the trait bound `boolean: Integer` is not satisfied
    flag.fetch_xor(true, MemoryOrder::SeqCst);
    return if (flag.load(MemoryOrder::SeqCst)) { 1 } else { 0 };
}
