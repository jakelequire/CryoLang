// E0229: a user trait SPELLED `Add` is another trait. `+` is
// `std::core::ops::Add` by the identity its declaration claimed, and neither a
// type implementing the user trait nor a parameter bounded by it overloads
// the operator: the concrete operand is selected by identity, and the bound is
// matched by identity. The operands here reach `+` through the user trait
// alone. This file pins the bounded parameter, judged at its instantiation
// where the operand is concrete; the concrete operand is
// E0229_user_trait_spelled_add.cryo.
![config(testing)]
![config(negative, E0229)]
namespace CryoTests::Negative::E0229UserTraitSpelledAddBound;

type trait Add<Rhs, Output> { add(&this, rhs: &Rhs) -> Output; }

type struct CfP { x: i64; }

implement trait Add<CfP, CfP> for struct CfP {
    add(&this, rhs: &CfP) -> CfP { return CfP { x: this.x * 100 + rhs.x }; }
}

function cf_plus<T>(a: T, b: T) -> T where T: Add<T, T> {
    return a + b;
    //~^ ERROR[E0229] `CryoTests::Negative::E0229UserTraitSpelledAddBound::CfP` does not implement `Add`; add `implement trait Add ... for CryoTests::Negative::E0229UserTraitSpelledAddBound::CfP` to use the `+` operator on it
}

function main() -> int {
    const p: CfP = cf_plus::<CfP>(CfP { x: 1 }, CfP { x: 2 });
    return p.x as int;
}
