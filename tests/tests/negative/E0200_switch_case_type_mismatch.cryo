// E0200: a `case` value must have the same type as the value being switched
// on.  Here an integer switch has a string `case`, which could never match
// and would otherwise emit a bad `icmp`.
![config(testing)]
![config(negative, E0200)]
namespace CryoTests::Negative::SwitchCaseTypeMismatch;
function main() -> int {
    const n: i32 = 3;
    switch (n) {
        case "oops": { }
        default:     { }
    }
    return 0;
}
