// E0151: a `![caller_location]` function takes its caller's location as two
// hidden arguments, so it cannot be taken as a value - a call through the
// value would have none to pass.  Refused by the type check, so `cryo check`
// and the editor report it: a bare name, a qualified path, and a static
// method named by its type's path.
![config(testing)]
![config(negative, E0151)]
namespace CryoTests::Negative::CallerLocationValue;

![caller_location]
function cf_where_called() -> u32 {
    return LINE;
}

type struct CfSite {
    value: u32;

    ![caller_location]
    static here() -> u32 {
        return LINE;
    }
}

function main() -> int {
    const f: () -> u32 = cf_where_called;   //~ ERROR[E0151] a `![caller_location]` function cannot be taken as a value
    const g: () -> u32 = CryoTests::Negative::CallerLocationValue::cf_where_called;   //~ ERROR[E0151] a `![caller_location]` function cannot be taken as a value
    const h: () -> u32 = CfSite::here;   //~ ERROR[E0151] a `![caller_location]` function cannot be taken as a value
    return (f() + g() + h()) as int;
}
