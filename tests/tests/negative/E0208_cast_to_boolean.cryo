// E0208: nothing converts to `boolean`, explicitly or not.  An integer, a
// character, a pointer, a float or an enum is tested by the comparison the
// test means (`n != 0`); `boolean as` an integer type stays allowed.
![config(testing)]
![config(negative, E0208)]
namespace CryoTests::Negative::E0208CastToBoolean;

type enum Color { Red; Green; }

function main() -> int {
    mut n: i32 = 3;
    const p: i32* = &n;
    const ch: char = 'a';
    const x: f64 = 1.5;
    const c: Color = Color::Green;
    const _a: boolean = n as boolean;
    //~^ ERROR[E0208] cannot cast `i32` to `boolean`: nothing converts to `boolean`; compare it explicitly, as in `n != 0`
    const _b: boolean = p as boolean;
    //~^ ERROR[E0208] cannot cast `i32*` to `boolean`: nothing converts to `boolean`; compare it with `null` explicitly, as in `p != null`
    const _c: boolean = ch as boolean;
    //~^ ERROR[E0208] cannot cast `char` to `boolean`: nothing converts to `boolean`; compare it explicitly, as in `c != '\0'`
    const _d: boolean = x as boolean;
    //~^ ERROR[E0208] cannot cast `f64` to `boolean`: nothing converts to `boolean`; compare it explicitly, as in `x != 0.0`
    const _e: boolean = c as boolean;
    //~^ ERROR[E0208] cannot cast `CryoTests::Negative::E0208CastToBoolean::Color` to `boolean`: nothing converts to `boolean`; compare it with one of `CryoTests::Negative::E0208CastToBoolean::Color`'s variants (`==`), or `match` on it
    return true as i32;
}
