///! A method that takes its receiver by value, called through a reference or
///! a raw pointer to a value that owns a destructor, moves the value out of
///! storage that still releases it: refused, as the written `(*p).method()`
///! is.  A value without a destructor is copied, and is accepted.

![config(testing)]
![config(negative, E0453)]
namespace CryoTests::Negative::E0453ConsumingCallThroughReference;

type struct Tracked {
    id: i32;
    into_id(this) -> i32 { return this.id; }
}

implement trait Drop for struct Tracked {
    drop(mut &this) -> void { }
}

type struct Plain {
    id: i32;
    into_id(this) -> i32 { return this.id; }
}

function through_reference(m: &Option<Tracked>) -> i32 {
    const t: Tracked = m.unwrap();
    //~^ ERROR[E0453] cannot move a value that owns a destructor out of a pointer
    return t.id;
}

function through_mutable_reference(t: mut &Tracked) -> i32 {
    return t.into_id();
    //~^ ERROR[E0453] cannot move a value that owns a destructor out of a pointer
}

function through_pointer(t: Tracked*) -> i32 {
    return t.into_id();
    //~^ ERROR[E0453] cannot move a value that owns a destructor out of a pointer
}

function copied_through_reference(p: &Plain, o: &Option<i32>) -> i32 {
    return p.into_id() + o.unwrap();
}

function main() -> i32 {
    return 0;
}
