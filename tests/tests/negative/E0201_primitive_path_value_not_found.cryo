// E0201: a path naming no method of a primitive, `i64::comparison`, is
// refused where it is written, and only there: the refused value has no
// type, so `sort_by`'s callable bound is not checked against `i64`, the
// path's qualifier, and reported a second time (E0306).
![config(testing)]
![config(negative, E0201)]
namespace CryoTests::Negative::PrimitivePathValueNotFound;

function main() -> i32 {
    mut values: [i64] = [3, 1, 2];
    values.sort_by(i64::comparison);   //~ ERROR[E0201] cannot find value `i64::comparison` in this scope
    return 0;
}
