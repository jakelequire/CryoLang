// Compile-fail test: `*` of a slice reference would read the slice out as a
// value, and a slice is only borrowed, so it is refused where it is written.
// Reading an element and the length through the reference is the control.
![config(testing)]
![config(negative, E0252)]
namespace CryoTests::Negative::E0252SliceReferenceDereferenced;

import std::core::slice::{ Slice };

function dereferenced(view: &Slice<i32>) -> i64 {
    const copy = *view;   //~ ERROR[E0252] `*` of `&Slice<i32>` would hold the slice as a value
    return view.length() + view[0] as i64;
}

function main() -> int {
    return 0;
}
