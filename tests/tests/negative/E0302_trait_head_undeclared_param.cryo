// E0302: a trait impl head's trailing list names the template's arguments
// and declares nothing.  `S` here is declared nowhere - no leading
// `implement<S>`, no type `S` in scope - so the head reads as an impl over
// every `S` of a name the program does not hold.  The same defect as an
// elided parameter, from the other side; the note spells the head with `S`
// moved to the leading list.
![config(testing)]
![config(negative, E0302)]
namespace CryoTests::Negative::TraitHeadUndeclaredParam;

type trait Tick {
    tick(&this) -> i32;
}

type struct Holder<T> {
    v: T;
}

implement trait Tick for struct Holder<S> {   //~ ERROR[E0302] this impl head names `S`, which is declared nowhere
    tick(&this) -> i32 { return 1; }
}

function main() -> int {
    const h: Holder<i32> = Holder<i32> { v: 3 };
    return h.tick() as int;
}
