// E0318: a derived implementation works through each field, so a field -
// or a variant's payload - whose type lacks the trait refuses the clause
// entry at that field, naming it, once per trait and with no error from
// the generated body.  A float has `Eq` and `Hash` but no `Ord`, so `Ord`
// is refused at a float field while `Eq` is generated.  A type parameter
// has the trait by the generated bound, which is the control, with fields
// whose types implement it.
![config(testing)]
![config(negative, E0318)]
namespace CryoTests::Negative::E0318DeriveFieldLacksTrait;

import std::core::cmp::{ Eq, Ord };
import std::core::hash::{ Hash };
import std::core::clone::{ Clone };

type struct FlOpaque {
    x: i64;
}

type struct FlHoldsOpaque with [Eq, Hash] {
    count: i64;
    inner: FlOpaque;   //~ ERROR[E0318] `FlHoldsOpaque` cannot derive `Eq`: field `inner` has type
                       //~^ ERROR[E0318] `FlHoldsOpaque` cannot derive `Hash`: field `inner` has type
}

type struct FlFloat with [Eq, Ord] {
    f: f64;   //~ ERROR[E0318] `FlFloat` cannot derive `Ord`: field `f` has type `f64`, which does not implement `Ord`
}

type enum FlCarries with [Clone] {
    Nothing;
    Something(i64, FlOpaque);   //~ ERROR[E0318] `FlCarries` cannot derive `Clone`: the payload of `Something` has type
}

type struct FlBox<T> {
    held: T;
}

type struct FlHoldsBox<T> with [Eq] {
    boxed: FlBox<T>;   //~ ERROR[E0318] `FlHoldsBox` cannot derive `Eq`: field `boxed` has type
}

type struct FlGeneric<T> with [Eq, Hash, Clone] {
    item: T;
    count: i64;
    flag: boolean;
    items: [T];
}

function main() -> i32 {
    return 0;
}
