// E0355: a literal of a generic struct leaving out a field with no default is
// refused, with written arguments and inside a generic body alike; leaving out
// a field that has a default is not.
![config(testing)]
![config(negative, E0355)]
namespace CryoTests::Negative::E0355GenericLiteralMissingField;
type struct Pair<T> { first: T; second: T; count: i64 = 1; }
function pair_of<T>(first: T) -> Pair<T> { return Pair::<T> { first: first }; }   //~ ERROR[E0355] missing field `second` in initializer
function main() -> int {
    const p: Pair<i32> = Pair::<i32> { second: 2 };   //~ ERROR[E0355] missing field `first` in initializer
    const q: Pair<i32> = pair_of::<i32>(1);
    const r: Pair<i32> = Pair::<i32> { first: 1, second: 2 };
    return p.second + q.first + r.first;
}
