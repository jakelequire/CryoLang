// E0455: a closure written without `move` holds references to the values it
// borrows, so like a reference it may not be held live across an `await`: a
// suspended future may outlive what it borrows.  One used up before the
// `await` is accepted (the control).
![config(testing)]
![config(negative, E0455)]
namespace CryoTests::Negative::E0455AsyncBorrowingClosureAcrossAwait;

import std::collections::string::{ String };
import std::future::{ PendingThenReady };

async function across(k: i64) -> i64 {
    const s: String = String::from("abc");
    const f = () -> i64 { return s.length() as i64 + k; };   //~ ERROR[E0455] a closure that borrows local values cannot be held live across an `await`
    const step: i64 = await PendingThenReady::<i64>::new(2, 1);
    return f() + step;
}

async function before(k: i64) -> i64 {
    const s: String = String::from("abc");
    const f = () -> i64 { return s.length() as i64 + k; };
    const n: i64 = f();
    const step: i64 = await PendingThenReady::<i64>::new(2, 1);
    return n + step;
}

function main() -> int { return 0; }
