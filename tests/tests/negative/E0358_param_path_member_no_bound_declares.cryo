// E0358: inside the body declaring it, a type parameter has only the
// members its bounds give it, whether named on a receiver or through a
// path.  `T::missing()` and the value `T::missing`, where no bound of `T`
// declares `missing`, are refused at the member - once, however many
// copies of the body are made, and even when the type `T` becomes has a
// `missing` of its own.  A body nothing instantiates is not refused for
// it.
![config(testing)]
![config(negative, E0358)]
namespace CryoTests::Negative::ParamPathMemberNoBoundDeclares;

type trait CfBeta { static make() -> i32; }

type struct CfP {
    v: i32;
    static missing() -> i32 { return 7; }
}

type struct CfQ { v: i32; }

implement trait CfBeta for struct CfP { static make() -> i32 { return 1; } }
implement trait CfBeta for struct CfQ { static make() -> i32 { return 2; } }

function cf_call<T>() -> i32 where T: CfBeta {
    return T::make() + T::missing();    //~ ERROR[E0358] no method named `missing` found on type `T`
}

function cf_value<T>() -> i32 where T: CfBeta {
    const f: () -> i32 = T::absent;     //~ ERROR[E0358] no method named `absent` found on type `T`
    return f();
}

function cf_unbounded<T>() -> i32 {
    return T::make();                   //~ ERROR[E0358] no method named `make` found on type `T`
}

function cf_never_called<T>() -> i32 where T: CfBeta {
    return T::unused();
}

type struct CfHolder<T> {
    v: i32;
    get(&this) -> i32 where T: CfBeta { return T::other(); }   //~ ERROR[E0358] no method named `other` found on type `T`
}

function main() -> int {
    const h: CfHolder<CfP> = CfHolder::<CfP> { v: 1 };
    return cf_call::<CfP>() + cf_call::<CfQ>() + cf_value::<CfP>()
        + cf_unbounded::<CfP>() + h.get();
}
