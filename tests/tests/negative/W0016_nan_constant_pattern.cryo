// W0016: a float constant pattern compares as `==` does, and NaN equals no
// value, NaN included, so an arm whose constant is NaN can never be chosen.
// Any other float constant - an infinity, a plain value - still matches.
![config(testing)]
![config(negative, W0016)]
namespace CryoTests::Negative::W0016NanConstantPattern;

const NOT_A_NUMBER: f64 = 0.0 / 0.0;
const HALF: f64 = 0.5;

function double_nan(x: f64) -> u32 {
    return match (x) {
        f64::NAN      => { 1 }   //~ WARN[W0016] is NaN, so this pattern never matches
        f64::INFINITY => { 2 }
        HALF          => { 3 }
        _             => { 0 }
    };
}

function single_nan(x: f32) -> u32 {
    return match (x) {
        f32::NAN => { 1 }   //~ WARN[W0016] is NaN, so this pattern never matches
        f32::MAX => { 2 }
        _        => { 0 }
    };
}

function module_nan(x: f64) -> u32 {
    return match (x) {
        NOT_A_NUMBER => { 1 }   //~ WARN[W0016] is NaN, so this pattern never matches
        _            => { 0 }
    };
}

function payload_nan(x: Option<f64>) -> u32 {
    return match (x) {
        Option::Some(f64::NAN) => { 1 }   //~ WARN[W0016] is NaN, so this pattern never matches
        Option::Some(_)        => { 2 }
        Option::None           => { 0 }
    };
}
