// E0154: a module PREFIX two reachable modules spell names neither of them,
// in an ANNOTATION as much as in a scope call. `std::future` re-exports
// `std::future::traits`, so importing it makes `traits` name that module;
// `import std::io::traits;` makes `traits` name a second one. The short form
// is then ambiguous, and the resolver declines to root it - which the type
// layer used to report as "cannot find", false in the same way a bare plural
// leaf is: the name is found twice. The scope-call lane already says so with
// this code and wording; the annotation lane now says the same thing.
![config(testing)]
![config(negative, E0154)]
namespace CryoTests::Negative::AmbiguousModulePrefixAnnotation;

import std::future;
import std::io::traits;

function takes(t: traits::Transfer) -> i32 {   //~ ERROR[E0154] `traits` names more than one module in scope
    return 0;
}
