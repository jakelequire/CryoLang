// E0235: the `?` operator used in a function whose return type cannot be
// built from what it propagates: a `Result`'s `?` returns early with a
// `Result<(), E>`, and `int` implements no `FromResidual` of one.
![config(testing)]
![config(negative, E0235)]
namespace CryoTests::Negative::E0235TryOutsideResultFn;

import std::core::result;

function cf_helper() -> Result<i32, i32> {
    return Result::Ok(1);
}

function cf_main() -> int {          // returns int, not Result
    const v: i32 = cf_helper()?;     // `?` has no Err channel to return into   //~ ERROR[E0235] the `?` operator can only be used
    return v;
}
