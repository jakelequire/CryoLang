// A `usize` or `isize` is 32 bits on a 32-bit target, so a literal of one is
// held to what a 32-bit integer of its sign holds, wherever it is typed: an
// initializer, a suffix, an argument.  `isize` takes no bit pattern past its
// signed range, which would be negative on one target and positive on
// another.  The 32-bit bounds themselves are held.
![config(testing)]
![config(negative, E0010)]
namespace CryoTests::Negative::PointerSizedLiteralPast32Bits;

public function cf_take(n: usize) -> usize { return n; }

public function cf_refused() -> usize {
    const big: usize = 4294967296;
    //~^ ERROR[E0010] integer literal `4294967296` is out of range for type `usize`
    const suffixed: usize = 4294967296usize;
    //~^ ERROR[E0010] integer literal `4294967296usize` is out of range for type `usize`
    const pattern: isize = 2147483649;
    //~^ ERROR[E0010] integer literal `2147483649` is out of range for type `isize`
    return big + suffixed + cf_take(4294967296) + (pattern as usize);
    //~^ ERROR[E0010] integer literal `4294967296` is out of range for type `usize`
}

public function cf_held() -> isize {
    const top: usize = 4294967295;
    const high: isize = 2147483647;
    const low: isize = -2147483648;
    return high + low + (top as isize);
}
