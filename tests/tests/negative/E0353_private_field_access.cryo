// E0353: access of a private field from outside the type.
![config(testing)]
![config(negative, E0353)]
namespace CryoTests::Negative::E0353PrivateAccess;
type struct CfS {
    private: secret: i32;
    public: static cf_new() -> CfS { return CfS { secret: 0 }; }
}
function main() -> int { const s: CfS = CfS::cf_new(); return s.secret; }
