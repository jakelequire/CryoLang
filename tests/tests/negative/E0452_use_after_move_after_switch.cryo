// E0452: a value moved inside one `switch` case and then used AFTER the switch
// is a use-after-move. The move-checker joins moves across switch cases
// (merge_switch_cases / switch_case_diverges): a value moved on the case-0 path
// is possibly-moved at the post-switch merge (a `break`-ended case reaches the
// join), so a later use must be rejected - exactly like the same pattern with
// `if`/`match`. This guards the m6 join, distinct from the intra-case
// double-move covered by E0452_use_after_move_in_switch_case.cryo.
![config(testing)]
![config(negative, E0452)]
namespace CryoTests::Negative::UseAfterMoveAfterSwitch;

import std::core::drop;
import std::collections::array;

type struct Tracker {
    id: i32;
}

implement trait Drop for struct Tracker {
    drop(mut &this) -> void {
        printf("DROP %d\n", this.id);
    }
}

function main() -> int {
    mut sel: i32 = 0;
    mut x: Tracker = Tracker { id: 7 };
    mut sink: Array<Tracker> = Array<Tracker>::new();
    switch (sel) {
        case 0: { sink.push(x); }   // x moved on the case-0 path
        default: { }
    }
    sink.push(x);                   // use after the switch -> E0452   //~ ERROR[E0452] use of moved value 'x'
    return 0;
}
