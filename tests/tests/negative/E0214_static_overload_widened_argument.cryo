// E0214: an argument of an overloaded static method fits its parameter
// exactly, as an overloaded free function's and method's do, so a `u8`
// passed where the only one-parameter overload takes a `u16` matches no
// overload, even though a plain call would widen it.  Nested as another
// call's argument the refusal is the same, and nothing reaches codegen
// unbound.
![config(testing)]
![config(negative, E0214)]
namespace CryoTests::Negative::StaticOverloadWidenedArgument;

type struct S {
    f: u8;

    static m(p: u16) -> u32 { return p; }
    static m() -> S { return S { f: 1 }; }
}

function main() -> i32 {
    const a: u8 = 3;
    const y: u32 = S::m(a);
    //~^ ERROR[E0214] no overload of `m` accepts these arguments
    const x: u32 = 7;
    const z: u32 = x.wrapping_subtract(S::m(a));
    //~^ ERROR[E0214] no overload of `m` accepts these arguments
    const w: u32 = S::m(a as u16);
    if (y + z + w > 0) { return 1; }
    return 0;
}
