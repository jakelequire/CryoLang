// E0307: `_` stands for a whole type argument of a call or a path, inferred
// there.  Written in a declared type, in a parameter's type, or inside a type
// argument, nothing infers it, and it is refused where it is written.
![config(testing)]
![config(negative, E0307)]
namespace CryoTests::Negative::TypePlaceholderMisplaced;

function pick<A, B>(a: A, b: B) -> A { return a; }

function takes(value: _) -> i32 {
    //~^ ERROR[E0307] the type placeholder `_` is not allowed here
    return 0;
}

function main() -> int {
    const items: Array<_> = Array::<i32>::new();
    //~^ ERROR[E0307] the type placeholder `_` is not allowed here
    const nested: Array<i32> = pick::<Array<_>, i32>(Array::<i32>::new(), 4);
    //~^ ERROR[E0307] the type placeholder `_` is not allowed here
    return 0;
}
