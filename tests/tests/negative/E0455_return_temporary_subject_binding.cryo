// E0455: a `match` binding over a TEMPORARY subject names storage that dies at
// the end of the statement, let alone the function.
//
// The caller-backed exemption (`lang/match_binding_alias.cryo`) keys on the
// subject being reached through a by-reference parameter. A call result is
// materialized into a temporary in THIS frame, so it is the original case the
// return-escape check exists for and must keep rejecting.
![config(testing)]
![config(negative, E0455)]
namespace CryoTests::Negative::ReturnTemporarySubjectBinding;

type struct Cell { n: i64; }

type enum Slot { Filled(Cell); Empty; }

function make() -> Slot {
    return Slot::Filled(Cell { n: 1 });
}

function temporary_subject() -> Cell* {
    match (make()) {
        Slot::Filled(value) => { return &value; }   // borrows a temporary
        Slot::Empty => { core::panic("unreachable", FILE, LINE); }
    }
}

function main() -> int {
    return 0;
}
