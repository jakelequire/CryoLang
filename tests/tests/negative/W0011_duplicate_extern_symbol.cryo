// W0011: the same C symbol declared in two extern blocks with different signatures.
![config(testing)]
![config(negative, W0011)]
namespace CryoTests::Negative::W0011DuplicateExternSymbol;

extern "C" {
    function cf_dup_sym(x: int) -> int;
}

extern "C" {
    function cf_dup_sym(x: int, y: int) -> int;   //~ WARN[W0011] declared in more than one extern block
}

function main() -> int {
    return 0;
}
