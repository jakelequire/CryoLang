// E0452: a nested match-arm payload read after it was given away - the read
// sees a value already released.
![config(testing)]
![config(negative, E0452)]
namespace CryoTests::Negative::E0452MatchPayloadUsedAfterMove;

import std::core::option;
import std::core::option::{ Option };

type struct Res {
    tag: i32;

    drop(mut &this) -> void { }
}

function consume(r: Res) -> void { }
function peek(r: &Res) -> i32 { return r.tag; }

function f(o: Option<Option<Res>>) -> i32 {
    match (o) {
        Option::Some(Option::Some(x)) => { consume(x); return peek(&x); }
        //~^ ERROR[E0452] use of moved value 'x'
        _ => { return 0; }
    }
}

function main() -> int { return 0; }
