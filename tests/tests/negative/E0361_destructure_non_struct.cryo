// E0361: a destructuring binding whose annotated type isn't a struct/class.
![config(testing)]
![config(negative, E0361)]
namespace CryoTests::Negative::E0361DestructureNonStruct;

function main() -> int {
    const { x, y }: i32 = 5;   // i32 has no fields to destructure
    //~^ ERROR[E0361] cannot destructure non-struct type 'i32'
    return x;
    //~^ ERROR[E0200] mismatched types
}
