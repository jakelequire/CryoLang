// E0216 / E0215: a call through a function value supplies exactly the
// arguments its signature declares, as a call of a function by name does.
![config(testing)]
![config(negative, E0216)]
namespace CryoTests::Negative::FunctionValueCallArguments;

function add(a: i64, b: i64) -> i64 { return a + b; }

function main() -> int {
    const f: (i64, i64) -> i64 = add;
    const few: i64 = f(1);
    //~^ ERROR[E0216] `f` takes 2 argument(s) but 1 were supplied
    const many: i64 = f(1, 2, 3);
    //~^ ERROR[E0215] `f` takes 2 argument(s) but 3 were supplied
    return 0;
}
