// E0452: a `continue` reaches the back edge as the end of the body does, so
// a binding declared outside the loop and moved on the path to a `continue`
// is moved again, or released again after the loop, on a later iteration.
![config(testing)]
![config(negative, E0452)]
namespace CryoTests::Negative::LoopContinueMove;
import std::ffi::libc;

type struct Heap {
    p: mut void*;
}

implement trait Drop for struct Heap {
    drop(mut &this) -> void { libc::free(this.p); }
}

function consume(h: Heap) -> void { }

function main() -> int {
    const named: Heap = Heap { p: libc::malloc(16) };
    mut i: int = 0;
    while (i < 3) {
        i = i + 1;
        if (i == 1) { consume(named); continue; }   //~ ERROR[E0452] value `named` moved inside a loop is used again on the next iteration
    }
    return 0;
}
