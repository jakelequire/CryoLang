// E0364: only a method can be `async`.
//
// `async` describes a computation that can suspend; a field holds a value and
// runs nothing.  The keyword is consumed ahead of the member head so every
// member kind sees it, which is what lets this be reported instead of silently
// dropped.
![config(testing)]
![config(negative, E0364)]
namespace CryoTests::Negative::E0364AsyncField;

import std::future;

type struct CfAsyncField {
    async n: i64;   //~ ERROR[E0364] only a method can be `async`
}

function main() -> int { return 0; }
