///! The operators a generic body applies to a type parameter whose bounds do
///! not give it their trait are one problem when one bound licenses them all,
///! so they are one report with a caret at each operator and the single fix
///! that adds the bound.  An operator needing another trait is another
///! problem, reported apart.

![config(testing)]
![config(negative, E0229)]
namespace CryoTests::Negative::E0229OperatorBoundReportedOnce;

function largest<T>(a: T, b: T) -> T {
    if (a > b) { return a; }
    //~^ ERROR[E0229] `T` is used in ways its bounds do not allow: it needs `T: std::core::cmp::Ord`
    if (b < a) { return b; }
    //~^ ERROR[E0229] `T` is used in ways its bounds do not allow: it needs `T: std::core::cmp::Ord`
    return b;
}

function same<T, U>(a: T, b: T, u: U) -> boolean where U: Clone {
    return a == b;
    //~^ ERROR[E0229] the `==` operator cannot be applied to `T`: its bounds do not give it `std::core::cmp::Eq`
}

function main() -> int {
    return 0;
}
