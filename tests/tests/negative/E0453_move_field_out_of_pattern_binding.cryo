// E0453: moving a non-Copy field OUT of a match/enum PATTERN payload
// binding is the same double-free as moving one out of a `let` local -
// the payload binding is a by-value owned place, so the source's
// scope-exit drop glue frees the moved field a second time.
//
// Regression test: move_check must register match-arm payload bindings as
// owned value places, the same as `let` locals - if `is_owned_value_place`
// returns false for them, `check_field_move_out` is silently skipped and
// the field-move-out into the consuming call argument would compile and
// double-free at runtime (this surfaced as an infinite-recursion crash in
// the LSP's JSON-RPC encoder cloning the resulting cyclic WorkspaceEdit).
// The escape hatch is the same: `core::mem::swap`, or restructure so the
// field is not moved out of the still-live aggregate.
![config(testing)]
![config(negative, E0453)]
namespace CryoTests::Negative::MoveFieldOutOfPatternBinding;

extern "C" {
    function malloc(size: u64) -> void*;
    function free(ptr: void*) -> void;
}

type struct Heap {
    p: void*;
}

implement trait Drop for struct Heap {
    drop(mut &this) -> void { free(this.p); }
}

type struct Holder {
    h:   Heap;
    tag: i32;
}

function take(x: Heap) -> void {
    // consumes `x` (by-value owning parameter); the callee drops it.
    mut y: Heap = x;
    y.drop();
}

function make() -> Holder {
    return Holder { h: Heap { p: malloc(16) }, tag: 1 };
}

function main() -> int {
    // `owner` is a match-arm payload binding (a by-value owned place),
    // not a `let` local.  Moving its non-Copy `h` field out into the
    // consuming `take(...)` argument double-frees at `owner`'s scope exit.
    //
    // The subject is an INLINE-constructed generic-enum literal
    // (`match (Option::Some(make()))`).  For such a subject, sema must
    // resolve a Drop-owning inline variant-constructor subject to the
    // concrete `Option<Holder>` (call_resolver's `infer_variant_instantiation`),
    // not an unresolved generic param - otherwise the binding's field type
    // hides this move from move-check (a silent double-free). With the
    // concrete type, the field's `Drop` is visible and this is correctly
    // rejected.
    match (Option::Some(make())) {
        Option::Some(owner) => {
            take(owner.h);   // error[E0453]: cannot move field 'h' out of a value that owns a destructor
        }
        Option::None => { }
    }
    return 0;
}
