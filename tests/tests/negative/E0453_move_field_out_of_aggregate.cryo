// E0453: moving a non-Copy field OUT of an owned, drop-glued value in a
// CONDITIONAL context is a double free. `owner` still owns `h`, so `owner`'s
// scope-exit drop glue frees `h.p` - and so does `stolen` - the same pointer
// freed twice. Drop-skip without per-field drop flags is sound only for an
// *unconditional* move (which the partial-move feature allows and tracks); an
// in-branch move like this one keeps the hard E0453.
//
// Regression test for the partial-field-move double-free.
// The escape hatch is `core::mem::swap` (leave the field a valid value to
// be dropped in place); moving a field out THROUGH a pointer/reference is
// the caller's to manage and stays allowed (see move_field_out_ok.cryo).
![config(testing)]
![config(negative, E0453)]
namespace CryoTests::Negative::MoveFieldOutOfAggregate;

extern "C" {
    function malloc(size: u64) -> void*;
    function free(ptr: void*) -> void;
}

type struct Heap {
    p: void*;
}

implement trait Drop for struct Heap {
    drop(mut &this) -> void { free(this.p); }
}

type struct Holder {
    h:   Heap;
    tag: i32;
}

function main() -> int {
    mut owner: Holder = Holder { h: Heap { p: malloc(16) }, tag: 1 };
    if (owner.tag == 1) {
        mut stolen: Heap = owner.h;   // error[E0453]: cannot move 'h' out of 'owner'
        stolen.drop();
    }
    return 0;
}
