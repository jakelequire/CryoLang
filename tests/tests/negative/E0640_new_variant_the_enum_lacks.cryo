// E0640: `new E::V(..)` names a variant inside the enum `E`, and sema finds
// it there - once - as it finds `E::V` in value position.  A leaf the enum
// does not declare is refused where it is written; before sema looked, the
// miss surfaced only as a codegen error (E0635 "codegen: enum variant not
// found").
![config(testing)]
![config(negative, E0640)]
namespace CryoTests::Negative::E0640NewVariantTheEnumLacks;

type enum CfShape { Dot; Circle(i32); }

function main() -> int {
    const s: CfShape* = new CfShape::Square(2);
    //~^ ERROR[E0640] enum `CfShape` has no variant `Square`
    return 0;
}
