///! A read-only level is added only at the outermost pointer.  A
///! `mut (mut u8*)*` is not a `mut (const u8*)*`: through the second, a
///! `const u8*` could be stored where the first reads back a `mut u8*` and
///! writes through it.  The same holds for every level below the outermost,
///! and in the other direction.  The outermost level becomes read-only
///! freely: a `mut (mut u8*)*` is a `const (mut u8*)*`.

![config(testing)]
![config(negative, E0200)]
namespace CryoTests::Negative::E0200ReadOnlyLevelBelowOutermostPointer;

function take_inner(p: mut (const u8*)*) -> void { }
function take_outer(p: const (mut u8*)*) -> void { }

function main() -> int {
    mut b: u8 = 1;
    mut p: mut u8* = &b;
    mut pp: mut (mut u8*)* = &p;
    const ppp: mut (mut (mut u8*)*)* = &pp;

    const inner: mut (const u8*)* = pp;
    //~^ ERROR[E0200] mismatched types
    take_inner(pp);
    //~^ ERROR[E0214] mismatched types
    const deeper: mut (mut (const u8*)*)* = ppp;
    //~^ ERROR[E0200] mismatched types
    mut back: mut (mut u8*)* = pp;
    back = inner;
    //~^ ERROR[E0200] mismatched types

    // Accepted: a read-only outermost level, and an explicit `as`.
    const outer: const (mut u8*)* = pp;
    take_outer(pp);
    const cast: mut (const u8*)* = pp as mut (const u8*)*;
    return 0;
}
