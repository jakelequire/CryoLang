///! A read-only level is added only at the outermost pointer.  A `u8**` is
///! not a `const u8**`: through the second, a `const u8*` could be stored
///! where the first reads back a `u8*` and writes through it.  The same
///! holds for every level below the outermost, and in the other direction.
///! The outermost level takes `const` freely: a `u8**` is a `const (u8*)*`.

![config(testing)]
![config(negative, E0200)]
namespace CryoTests::Negative::E0200ReadOnlyLevelBelowOutermostPointer;

function take_inner(p: const u8**) -> void { }
function take_outer(p: const (u8*)*) -> void { }

function main() -> int {
    mut b: u8 = 1;
    mut p: u8* = &b;
    mut pp: u8** = &p;
    const ppp: u8*** = &pp;

    const inner: const u8** = pp;
    //~^ ERROR[E0200] mismatched types
    take_inner(pp);
    //~^ ERROR[E0214] mismatched types
    const deeper: const u8*** = ppp;
    //~^ ERROR[E0200] mismatched types
    mut back: u8** = pp;
    back = inner;
    //~^ ERROR[E0200] mismatched types

    // Accepted: `const` at the outermost level, and an explicit `as`.
    const outer: const (u8*)* = pp;
    take_outer(pp);
    const cast: const u8** = pp as const u8**;
    return 0;
}
