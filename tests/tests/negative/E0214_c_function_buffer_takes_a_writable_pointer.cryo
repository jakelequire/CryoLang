// E0214: a C function that writes into memory it is handed takes a writable
// pointer to it - the buffer `read`, `fread` and `fgets` fill, the record
// `stat` fills, the path `getcwd` writes, the lock word `pthread_mutex_lock`
// writes and the time `time` stores.  A read-only pointer is refused as that
// argument; a buffer declared writable where it is made is accepted.
![config(testing)]
![config(negative, E0214)]
namespace CryoTests::Negative::E0214CFunctionBufferTakesAWritablePointer;

import std::ffi::libc;

function read_into_read_only(view: u8*) -> void {
    libc::read(0, view, 4);                         //~ ERROR[E0214] mismatched types
}

function fread_into_read_only(view: u8*, stream: void*) -> void {
    libc::fread(view, 1, 4, stream);                //~ ERROR[E0214] mismatched types
}

function fgets_into_read_only(view: u8*, stream: void*) -> void {
    libc::fgets(view, 4, stream);                   //~ ERROR[E0214] mismatched types
}

function stat_into_read_only(record: u8*) -> void {
    libc::stat("tests", record);                    //~ ERROR[E0214] mismatched types
}

function getcwd_into_read_only(view: u8*) -> void {
    libc::getcwd(view, 4);                          //~ ERROR[E0214] mismatched types
}

function lock_read_only(lock: u8*) -> void {
    libc::pthread_mutex_lock(lock);                 //~ ERROR[E0214] mismatched types
}

function time_into_read_only(seconds: i64*) -> void {
    libc::time(seconds);                            //~ ERROR[E0214] mismatched types
}

function main() -> int {
    mut bytes: [u8; 256] = [0; 256];
    libc::getcwd(&bytes[0], 256);
    libc::stat("tests", &bytes[0]);
    mut seconds: i64 = 0;
    libc::time(&seconds);
    return 0;
}
