// E0203: a projection is answered through the traits a bound inherits, and
// refused where neither the bound nor any trait it inherits declares the
// member, or where two of them do.  `I::Item` under `I: Both` is `Source`'s,
// since `Both` extends `Source`, and is fine; `I::Nope` is declared by
// nothing `Both` or `Deep` inherits.  `Twice` declares an `Item` of its own
// beside the one it inherits from `Source`, so `Item` through `Twice` is
// ambiguous: two declarations answer it.
![config(testing)]
![config(negative, E0203)]
namespace CryoTests::Negative::ProjectionThroughSupertrait;

type trait Source {
    type Item;
    take(&this) -> i32;
}

type trait Both : Source {
    back(&this) -> i32;
}

type trait Deep : Both {
    deep(&this) -> i32;
}

type trait Twice : Source {
    type Item;
    again(&this) -> i32;
}

function fine<I>(it: &I, v: I::Item) -> i32 where I: Both { return it.take(); }
function fine_deep<I>(it: &I, v: I::Item) -> i32 where I: Deep { return it.deep(); }
function nope<I>(it: &I, v: I::Nope) -> i32 where I: Both { return it.back(); }       //~ ERROR[E0203] associated type `Nope` not found for `I`
function nope_deep<I>(it: &I, v: I::Nope) -> i32 where I: Deep { return it.deep(); } //~ ERROR[E0203] associated type `Nope` not found for `I`
function twice<I>(it: &I, v: I::Item) -> i32 where I: Twice { return it.again(); }   //~ ERROR[E0203] ambiguous associated type `Item` in bounds of `I`

type trait Inherits : Source {
    first(&this) -> This::Item;
    missing(&this) -> This::Nope;                                                    //~ ERROR[E0203] associated type `Nope` not found for `This`
}

type trait Shadows : Source {
    type Item;
    get(&this) -> This::Item;                                                        //~ ERROR[E0203] ambiguous associated type `Item` in bounds of `This`
}

function main() -> int {
    return 0;
}
