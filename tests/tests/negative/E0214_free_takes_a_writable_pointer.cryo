// E0214: `libc::free` and `libc::aligned_free` release the memory they are
// given, so each takes a writable pointer.  A read-only pointer is refused
// as their argument, the same as for any `mut T*` parameter; a pointer
// declared writable where the allocation is made is accepted.
![config(testing)]
![config(negative, E0214)]
namespace CryoTests::Negative::E0214FreeTakesAWritablePointer;

import std::ffi::libc;

function release_read_only(p: u8*) -> void {
    libc::free(p);                  //~ ERROR[E0214] mismatched types
}

function release_aligned_read_only(p: u8*) -> void {
    libc::aligned_free(p, 64);      //~ ERROR[E0214] mismatched types
}

function main() -> int {
    const block: mut u8* = libc::malloc(16);
    libc::free(block);
    return 0;
}
