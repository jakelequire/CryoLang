// E0154: a method taken as a value whose overloads include a generic one,
// where more than one overload fits what is written.  A turbofish alone does
// not choose between two generic overloads that both take it, and with no
// turbofish and no expected function type nothing chooses at all.
![config(testing)]
![config(negative, E0154)]
namespace CryoTests::Negative::OverloadedGenericMethodValue;

type struct Plain { n: i32; }
implement struct Plain {
    static conv<U>(u: U) -> U { return u; }
    static conv<U>(u: U, w: U) -> U { return w; }
}

type struct Wrap<T> { v: T; }
implement<T> struct Wrap<T> {
    static conv<U>(u: U) -> U { return u; }
    static conv<U>(u: U, w: U) -> U { return w; }
}

function main() -> int {
    const a = Plain::conv::<i32>;         //~ ERROR[E0154] `Plain::conv` is overloaded, and nothing here says which overload is meant
    const b = Plain::conv;                //~ ERROR[E0154] `Plain::conv` is overloaded, and nothing here says which overload is meant
    const c = Wrap::<i32>::conv::<u8>;    //~ ERROR[E0154] `Wrap::conv` is overloaded, and nothing here says which overload is meant
    const d: (i32) -> i32 = Plain::conv::<i32>;
    return d(0);
}
