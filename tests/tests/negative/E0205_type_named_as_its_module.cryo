// E0205: modules and types share one namespace.  A file's own module is
// spelled by its leaf inside the file, so a type declared under that leaf
// is a second owner of the name there - a redeclaration, refused at the
// type.  (`module_type_name_collision` holds the two-module shape.)
![config(testing)]
![config(negative, E0205)]
namespace CryoTests::Negative::Widget;

type struct Widget {   //~ ERROR[E0205] the name `Widget` is already declared in this scope: `CryoTests::Negative::Widget` is a module
    v: i32;
}

function main() -> int {
    const w: Widget = Widget { v: 1 };
    return w.v;
}
