// E0364: a trait method cannot be `async`.
//
// Each `async` body lowers to its OWN future struct, so two implementations of
// the same trait method return two different types.  A trait declares one
// signature for all of them, and dispatch needs one slot - neither is
// expressible without a boxed `dyn Future`, which does not exist.
![config(testing)]
![config(negative, E0364)]
namespace CryoTests::Negative::E0364AsyncTraitMethod;

import std::future;

type trait CfFetcher {
    async go(&this) -> i64;   //~ ERROR[E0364] a trait method cannot be `async`
}

function main() -> int { return 0; }
