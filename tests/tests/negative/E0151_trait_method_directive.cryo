// E0151: a trait's method takes `![language]` and no other directive, since
// no other directive's effect is applied to a trait's method; and
// `![language]` names a function, a method or a type, never a variable.
![config(testing)]
![config(negative, E0151)]
namespace CryoTests::Negative::E0151TraitMethodDirective;

type trait CfSpeak {
    ![inline]
    //~^ ERROR[E0151] directive `![inline]` does not apply to a trait method; a trait's methods take only `![language]`
    cf_speak(&this) -> i32 { return 1; }
}

![language("drop")]
//~^ ERROR[E0151] directive `![language]` belongs to the standard library; a declaration outside it cannot be a language item
//~^^ ERROR[E0151] directive `![language]` only applies to a function, a method, a struct, an enum or a trait, not variable
const CF_LIMIT: i32 = 4;

function main() -> int { return CF_LIMIT; }
