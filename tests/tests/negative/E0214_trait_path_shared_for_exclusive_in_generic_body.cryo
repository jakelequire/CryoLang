// E0214: a shared reference passed through a trait's path or an
// impl-qualified path for an exclusive parameter is refused in a generic
// body as it is in a plain one, where the template is checked, whether or
// not anything instantiates the body.  The copies are not checked again, so
// a call left unbound in the template reaches code generation unbound.  The
// value itself, which the call borrows exclusively, is accepted.
![config(testing)]
![config(negative, E0214)]
namespace CryoTests::Negative::TraitPathSharedForExclusiveInGenericBody;

import std::core::result::{ Result };
import std::collections::string::{ String };
import std::fmt::display::{ Display, Formatter };

type struct Tally { total: i32; }

type trait Fill {
    fill(&this, into: mut &Tally) -> void;
}

type struct Source { v: i32; }

implement trait Fill for struct Source {
    fill(&this, into: mut &Tally) -> void { into.total = into.total + this.v; }
}

function shown<W>(marker: W, value: i64) -> i64 {
    mut s: String = String::new();
    mut f: Formatter = Formatter::new(&s);
    match ((Display for i64)::fmt(&value, &f)) {   //~ ERROR[E0214] `fmt` takes argument 2 as an exclusive reference (`mut &`), and this is a shared one
        Result::Ok(_) => { }
        Result::Err(_) => { }
    }
    match ((Display for i64)::fmt(&value, f)) {
        Result::Ok(_) => { }
        Result::Err(_) => { }
    }
    return s.length();
}

function filled<W>(marker: W) -> i32 {
    const s: Source = Source { v: 3 };
    mut t: Tally = Tally { total: 0 };
    Fill::fill(&s, &t);                            //~ ERROR[E0214] `fill` takes argument 2 as an exclusive reference (`mut &`), and this is a shared one
    Fill::fill(&s, t);
    return t.total;
}

function main() -> int {
    return shown(1, 4096) as int;
}
