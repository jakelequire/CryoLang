// E0302: the same rule for a TRAILING parameter.  `Pair<T, A = Tag>`
// defaults its second parameter, and `implement<T> trait Show for Pair<T>`
// names one of two.  Rust fills a default at a use, never in an impl head,
// and neither does Cryo: `implement<T, A> trait Show for Pair<T, A>` or
// `implement<T> trait Show for Pair<T, Tag>`.  An inherent block declares
// its parameters in the list that names them, so it is refused the same way.
![config(testing)]
![config(negative, E0302)]
namespace CryoTests::Negative::E0302ImplHeadElidesTrailingParam;

type struct Tag { n: i32; }
type struct Pair<T, A = Tag> { t: T; a: A; }
type trait Show { show(&this) -> int; }

implement<T> trait Show for Pair<T> {
//~^ ERROR[E0302] `Pair` is a template with 2 parameters, and this impl head names 1 of them
    show(&this) -> int { return 1; }
}

implement struct Pair<T> {
//~^ ERROR[E0302] `Pair` is a template with 2 parameters, and this impl head names 1 of them
    first(&this) -> T* { return &this.t; }
}

function main() -> int { return 0; }
