// E0214: `?` on a `Result` whose error type the enclosing function cannot
// return as it is, and which the function's error type has no `From`
// implementation for.  The conversion `?` would apply does not exist, so
// the error cannot be propagated.
![config(testing)]
![config(negative, E0214)]
namespace CryoTests::Negative::E0214TryErrorWithoutFrom;

import std::core::result;

type enum CfLowError { Bad; }
type enum CfHighError { Failed; }

function cf_low() -> Result<i32, CfLowError> {
    return Result::Err(CfLowError::Bad);
}

function cf_high() -> Result<i32, CfHighError> {
    const v: i32 = cf_low()?;     // no `From<CfLowError>` for `CfHighError`   //~ ERROR[E0214] the `?` operator cannot convert the error
    return Result::Ok(v);
}
