// E0214: an integer-literal argument that does NOT fit the parameter type is
// rejected (it would silently truncate: 300 -> 44 in a u8). Literals that DO
// fit (e.g. `cf_take_u8(91)`) are accepted, since they materialize as a
// correct constant - that path is exercised throughout the stdlib.
![config(testing)]
![config(negative, E0214)]
namespace CryoTests::Negative::E0214ArgLiteralOverflow;

function cf_take_u8(v: u8) -> void {}

function main() -> int {
    cf_take_u8(300);   //~ ERROR[E0214] mismatched types
    return 0;
}
