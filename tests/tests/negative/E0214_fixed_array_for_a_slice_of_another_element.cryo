// Compile-fail test: a fixed array converts to the slice of its own element
// type and from a reference only.  A `&[i64; 2]` given for a `&Slice<i32>`,
// and a `[i32; 4]` value rather than a reference to it, are mismatches at
// the argument; the reference to an array of the slice's element is the
// control.
![config(testing)]
![config(negative, E0214)]
namespace CryoTests::Negative::E0214FixedArrayForASliceOfAnotherElement;

import std::core::slice::{ Slice };

function total(items: &Slice<i32>) -> i64 {
    return items.length();
}

function other_element() -> void {
    const wide: [i64; 2] = [1, 2];
    total(&wide);   //~ ERROR[E0214] mismatched types
}

function value_not_reference() -> void {
    const four: [i32; 4] = [1, 2, 3, 4];
    total(four);   //~ ERROR[E0214] mismatched types
    total(&four);
}

function main() -> int {
    return 0;
}
