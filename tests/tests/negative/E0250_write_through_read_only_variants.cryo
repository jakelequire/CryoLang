///! The read-only variants hand out read-only pointers: nothing is written
///! through `Slice::as_const_ptr` or `mem::const_offset`.  The writable
///! lookups `HashMap::get_mutable` and `HashMap::values_mutable` are
///! `mut &this` methods, which a `const` binding and a `&` borrow do not
///! offer.

![config(testing)]
![config(negative, E0250)]
namespace CryoTests::Negative::E0250WriteThroughReadOnlyVariants;

import std::core::slice::{ Slice };
import std::core::mem;
import std::collections::hashmap::{ HashMap };

function write_slice(s: Slice<i32>) -> void {
    *s.as_const_ptr() = 1;
    //~^ ERROR[E0250] cannot assign to a place reached through `i32*`, which is read-only
}

function write_offset(first: const i32*) -> void {
    *mem::const_offset(first, 1) = 2;
    //~^ ERROR[E0250] cannot assign to a place reached through `i32*`, which is read-only
}

function bump_all(map: &HashMap<u32, i32>) -> void {
    for (value in map.values_mutable()) {
    //~^ ERROR[E0250] cannot call a `mut &this` method on a place reached through `&HashMap<u32, i32, GlobalAlloc>`, which is read-only
        *value = 0;
    }
}

function main() -> int {
    const map: HashMap<u32, i32> = HashMap::new();
    const key: u32 = 1;
    const found: boolean = map.get_mutable(&key).is_some();
    //~^ ERROR[E0250] cannot call a `mut &this` method on a place held by a `const` binding
    return 0;
}
