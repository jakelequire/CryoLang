// E0453: partial field moves are tracked only when they are UNCONDITIONAL
// (straight-line, at function-body top level).  Drop-skip without per-field
// drop flags is sound only for a definitely-moved field; a move guarded by an
// `if`/`match`/`switch`/loop is only *possibly* moved on some path, so the
// owner's scope-exit glue cannot statically know whether to drop that field.
// A conditional field-move-out therefore stays a hard E0453 (v1 conservatism;
// conditional partial moves via drop flags are deferred).  The owner here is a
// NON-`Drop` struct, so only the branch context - not the owner kind - is what
// keeps this rejected.
![config(testing)]
![config(negative, E0453)]
namespace CryoTests::Negative::PartialMoveConditional;
import std::ffi::libc;

type struct Heap {
    p: void*;
}

implement trait Drop for struct Heap {
    drop(mut &this) -> void { libc::free(this.p); }
}

// No `implement trait Drop` for Parts: a non-`Drop` owner, dropped by per-field
// glue.  A straight-line move of `a` would be allowed; the `if` below is what
// makes it conditional and therefore rejected.
type struct Parts {
    a:   Heap;
    tag: i32;
}

function take(x: Heap) -> void {
    mut y: Heap = x;
    y.drop();   //~ WARN[W0015] explicit destructor call
}

function main() -> int {
    mut p: Parts = Parts { a: Heap { p: libc::malloc(16) }, tag: 1 };
    if (p.tag > 0) {
        // Conditional field-move-out: E0453 (only unconditional partial moves
        // are tracked in v1).
        take(p.a);   // error[E0453]: cannot move field 'a' out of a value that owns a destructor   //~ ERROR[E0453] cannot move field 'a' out of a
    }
    return 0;
}
