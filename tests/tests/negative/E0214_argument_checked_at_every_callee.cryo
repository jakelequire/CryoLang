// E0214: an argument is checked against its parameter whatever the callee
// is - a function given a reference to an instantiation not yet minted, a
// function value, a non-generic enum's variant, a generic enum's variant
// whose instance the expected type names.
![config(testing)]
![config(negative, E0214)]
namespace CryoTests::Negative::ArgumentCheckedAtEveryCallee;

type struct Wide {
    a: i64;
}

type struct Box2<T> {
    total: T;
}

type enum Slot {
    Empty;
    Full(i64);
}

function want_wide(w: &Wide) -> i64 { return w.a; }

function want_narrow(b: &Box2<i32>) -> i32 { return b.total; }

function main() -> int {
    const g: Box2<i64> = Box2::<i64> { total: 0 };
    const w: Wide = Wide { a: 1 };
    const a: i64 = want_wide(&g);
    //~^ ERROR[E0214] mismatched types
    const b: i32 = want_narrow(&g);
    //~^ ERROR[E0214] mismatched types
    const f: (&Wide) -> i64 = want_wide;
    const c: i64 = f(&g);
    //~^ ERROR[E0214] mismatched types
    const s: Slot = Slot::Full(w);
    //~^ ERROR[E0214] mismatched types
    const o: Option<i64> = Option::Some(w);
    //~^ ERROR[E0214] mismatched types
    return 0;
}
