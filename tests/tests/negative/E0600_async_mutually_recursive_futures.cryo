// E0600: the cycle does not have to be direct.
//
// `ping`'s future would hold `pong`'s, which holds `ping`'s - the same infinite
// size as direct self-recursion, reached the long way round.  The check walks the
// awaits graph rather than comparing a single pair of types, so it reports the
// edge that closes the cycle (here the one in the function lowered second).
![config(testing)]
![config(negative, E0600)]
namespace CryoTests::Negative::E0600AsyncMutuallyRecursiveFutures;

import std::future;

async function ping(n: i64) -> i64 {
    if (n <= 0) { return 0; }
    const r: i64 = await pong(n - 1);
    return r + 1;
}

async function pong(n: i64) -> i64 {
    const _z: i64 = await PendingThenReady<i64>::new(1, 1);
    const r: i64 = await ping(n);   //~ ERROR[E0600] async: this `await` would make the state machine contain itself
    return r;
}

function main() -> int { return 0; }
