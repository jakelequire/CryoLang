// E0452: a non-Copy value moved by an ASSIGNMENT RHS (`b = a`) and then
// read again on a straight-line path.  `b = a` bitwise-copies `a`'s owning
// handle into `b`; both bindings now alias the same allocation.  `consume(a)`
// then moves that already-moved handle into the callee, which frees it at
// function exit, and `b`'s scope-exit drop frees the same allocation again -
// a double free.
//
// Regression test for the MoveCheck / DropInsertion divergence on assignment
// RHS: MoveCheck walked `b = a`'s RHS in READ context (never marking `a`
// moved) while DropInsertion walked it in MOVE context (suppressing `a`'s
// scope-exit drop).  The two passes' move-sets must be identical; the
// mismatch let this double-free compile silently.  Distinct from the
// var-decl-init path (`mut b: Heap = a`) already covered by
// E0452_straight_line_use_after_move.cryo - this exercises the plain-`=`
// assignment path.
![config(testing)]
![config(negative, E0452)]
namespace CryoTests::Negative::AssignRhsUseAfterMove;
import std::ffi::libc;

type struct Heap {
    p: void*;
}

implement trait Drop for struct Heap {
    drop(mut &this) -> void { libc::free(this.p); }
}

function consume(h: Heap) -> void {
    // by-value owning parameter: drops `h` at function exit.
}

function main() -> int {
    mut a: Heap = Heap { p: libc::malloc(16) };
    mut b: Heap = Heap { p: libc::malloc(16) };
    b = a;               // moves `a` into `b` via the assignment RHS
    consume(a);          // use-after-move of `a` -> double free   //~ ERROR[E0452] use of moved value 'a'
    return 0;
}
