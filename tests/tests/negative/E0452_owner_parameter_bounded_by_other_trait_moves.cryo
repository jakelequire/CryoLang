///! Only a bound that makes a type parameter `Copy` makes its values copies:
///! a method of a generic struct that bounds the owner's parameter by
///! another trait, or by nothing, moves a value of it on its first use, and
///! a bound on one parameter says nothing of another.

![config(testing)]
![config(negative, E0452)]
namespace CryoTests::Negative::E0452OwnerParameterBoundedByOtherTrait;

type trait Named {
    name(&this) -> i64;
}

type struct Holder<T, U> {
    inner: T;

    by_other_trait(&this, value: T) -> T where T: Named {
        const first: T = value;
        return value;
        //~^ ERROR[E0452] use of moved value `value`
    }

    unbounded(&this, value: T) -> T {
        const first: T = value;
        return value;
        //~^ ERROR[E0452] use of moved value `value`
    }

    other_parameter(&this, value: U) -> U where T: Copy {
        const first: U = value;
        return value;
        //~^ ERROR[E0452] use of moved value `value`
    }
}

function main() -> i32 {
    return 0;
}
