// E0405: a nested pattern that narrows the payload (`Wrap(Inner::A)`) does
// not fully cover its variant. With `Inner::B(..)` left unhandled and no
// catch-all, `Wrap` is non-exhaustive.
![config(testing)]
![config(negative, E0405)]
namespace CryoTests::Negative::E0405NestedIncomplete;
type enum Inner { A; B(i32); }
type enum Outer { None; Wrap(Inner); }
function main() -> int {
    const o: Outer = Outer::None;
    const r: int = match (o) {
        Outer::Wrap(Inner::A) => { 1 }
        Outer::None           => { 0 }
    };
    return r;
}
