// A negative number made by arithmetic on literals (`-1`, `-(1 + 2)`,
// `0 - 1`) keeps its default type beside an unsigned operand, since no
// unsigned type holds it.  As a compound assignment's value it is refused
// (E0200), and as a binary operand where the unsigned type and the default
// type hold none of each other's values (E0229): taking the unsigned type
// would make it a huge value that overflows where the written arithmetic
// does not.  A complement of a literal is the unsigned operand's bit pattern
// and is accepted, as is a negative number beside a signed operand and one
// an unsigned operand narrower than the default type widens to meet.
![config(testing)]
![config(negative, E0200)]
namespace CryoTests::Negative::NegativeValueBesideUnsigned;

type struct Counter { count: u32; }

public function refused(start: u8, wide: u64, size: usize, word: u32, big: u128) -> u32 {
    mut b: u8 = start;
    b += -1;
    //~^ ERROR[E0200] `+=` on a `u8` takes `-1`, a negative value no `u8` holds
    b -= -1;
    //~^ ERROR[E0200] `-=` on a `u8` takes `-1`, a negative value no `u8` holds
    b *= -1;
    //~^ ERROR[E0200] `*=` on a `u8` takes `-1`, a negative value no `u8` holds
    b /= -2;
    //~^ ERROR[E0200] `/=` on a `u8` takes `-2`, a negative value no `u8` holds
    b &= -1;
    //~^ ERROR[E0200] `&=` on a `u8` takes `-1`, a negative value no `u8` holds
    b <<= -1;
    //~^ ERROR[E0200] `<<=` on a `u8` takes `-1`, a negative value no `u8` holds
    b += -(1 + 2);
    //~^ ERROR[E0200] `+=` on a `u8` takes `-3`, a negative value no `u8` holds
    b += 0 - 1;
    //~^ ERROR[E0200] `+=` on a `u8` takes `-1`, a negative value no `u8` holds
    mut w: u64 = wide;
    w += -1;
    //~^ ERROR[E0200] `+=` on a `u64` takes `-1`, a negative value no `u64` holds
    mut z: usize = size;
    z -= -2;
    //~^ ERROR[E0200] `-=` on a `usize` takes `-2`, a negative value no `usize` holds
    mut c: Counter = Counter { count: word };
    c.count += -1;
    //~^ ERROR[E0200] `+=` on a `u32` takes `-1`, a negative value no `u32` holds
    mut h: u128 = big;
    h %= -3;
    //~^ ERROR[E0200] `%=` on a `u128` takes `-3`, a negative value no `u128` holds
    const sum: u32 = word + -1;
    //~^ ERROR[E0229] `+` on a `u32` takes `-1`, a negative value no `u32` holds
    const difference: i64 = -2 - word;
    //~^ ERROR[E0229] `-` on a `u32` takes `-2`, a negative value no `u32` holds
    const masked: u32 = word & -1;
    //~^ ERROR[E0229] `&` on a `u32` takes `-1`, a negative value no `u32` holds
    const quotient: u32 = word / (0 - 2);
    //~^ ERROR[E0229] `/` on a `u32` takes `-2`, a negative value no `u32` holds
    const product: u64 = wide * -1;
    //~^ ERROR[E0229] `*` on a `u64` takes `-1`, a negative value no `u64` holds
    return c.count + sum + masked + quotient;
}

public function accepted(start: u8, word: u32, signed: i8) -> i32 {
    mut b: u8 = start;
    b -= 1;
    b += 1;
    mut m: u32 = word;
    m &= ~0xFF;
    m |= ~0;
    m ^= ~1;
    mut s: i8 = signed;
    s += -1;
    s *= -1;
    const widened: i32 = start + -1;
    const cleared: u32 = word & ~0xFF;
    const never: boolean = word == -1;
    if (never || cleared == m) { return 0; }
    return widened + (s as i32) + (b as i32);
}
