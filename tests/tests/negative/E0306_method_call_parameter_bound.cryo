// E0306: a method call that binds a parameter its implementation lends the
// method to a type outside the implementation's bound on it is refused
// where it is written (`K` in `implement<K> trait McScale<K> for McMeter
// where K: McPosition`) - `[]` on a type whose `Index` is generic over the
// index type included, refused once, at the index, and not again for the
// base.  The calls at a type the bound admits are the control.
![config(testing)]
![config(negative, E0306)]
namespace CryoTests::Negative::E0306MethodCallParameterBound;

import std::core::ops::{ Index };

type trait McPosition {
    to_position(this) -> i64;
}

implement trait McPosition for u8 { to_position(this) -> i64 { return this as i64; } }

type struct McMeter {
    n: i64;
}

type trait McScale<K> {
    scale(&this, k: K) -> i64;
}

implement<K> trait McScale<K> for struct McMeter where K: McPosition {
    scale(&this, k: K) -> i64 { return this.n * k.to_position(); }
}

type struct McCells<T> {
    a: T; b: T;
}

implement<T, I> trait Index<I> for struct McCells<T> where I: McPosition {
    type Output = T;
    index(&this, idx: I) -> const T* {
        if (idx.to_position() == 0) { return &this.a; }
        return &this.b;
    }
}

function main() -> int {
    const m: McMeter = McMeter { n: 5 };
    const c: McCells<i32> = McCells::<i32> { a: 3, b: 4 };
    const lent: i64 = m.scale(3 as u8);
    const lent_refused: i64 = m.scale(2.5);   //~ ERROR[E0306] the trait bound `f64: McPosition` is not satisfied
    const cell: i32 = c[1 as u8];
    const cell_refused: i32 = c[true];   //~ ERROR[E0306] the trait bound `boolean: McPosition` is not satisfied
    return 0;
}
