// E0306: `Array` and `Slice` are indexed through one implementation each,
// generic over the index type under the standard library's own
// `SliceIndex<T>`, which every integer type implements.  An index of any
// other type is refused at the `[]` naming the bound it does not meet, once,
// and the container is not reported as one that cannot be indexed.  The
// integer indexes are the control.
![config(testing)]
![config(negative, E0306)]
namespace CryoTests::Negative::E0306ArrayIndexNotAnInteger;

function main() -> int {
    mut xs: Array<i32> = [1, 2, 3];
    const s: &Slice<i32> = xs.as_slice();
    const read: i32 = xs[1 as u8] + s[2 as i16];
    xs[0 as usize] = read;
    const flag: i32 = xs[true];   //~ ERROR[E0306] the trait bound `boolean: SliceIndex<i32>` is not satisfied
    const half: i32 = s[1.5];   //~ ERROR[E0306] the trait bound `f64: SliceIndex<i32>` is not satisfied
    return 0;
}
