// E0455: an address into a BY-VALUE receiver cannot be held across a suspend.
//
// A by-value `this` is moved into the future, and each poll binds it into a
// fresh poll frame - so `&this.slot` names storage that is rebuilt on every
// poll, and a pointer to it read after a suspend points at the previous frame.
//
// The counterpart is legal and tested in `lang/async_method.cryo`: with a
// `&this` receiver the same expression reaches THROUGH the pointer into the
// caller's object, which does not move, so it is not reported.
![config(testing)]
![config(negative, E0455)]
namespace CryoTests::Negative::E0455AsyncMethodValueReceiverAddress;

import std::future;

async function cf_bump(n: i64) -> i64 {
    return n + 1;
}

type struct CfValueRecv {
    slot: i64;

    async leak(this) -> i64 {
        const p: i64* = &this.slot;   //~ ERROR[E0455] holds the address of the local or parameter
        const step: i64 = await cf_bump(0);
        return *p + step;
    }
}

function main() -> int { return 0; }
