// E0319: the kind keyword before an `implement` head's type names the
// type's kind, so `union` before a struct is refused, in a trait
// implementation's head and an inherent one's.
![config(testing)]
![config(negative, E0319)]
namespace CryoTests::Negative::UnionKeywordForStruct;

type struct Pair { a: i32; b: i32; }

type trait Total {
    total(&this) -> i32;
}

implement trait Total for union Pair {
//~^ ERROR[E0319] `CryoTests::Negative::UnionKeywordForStruct::Pair` is a struct, not a union
    total(&this) -> i32 { return this.a + this.b; }
}

implement union Pair {
//~^ ERROR[E0319] `CryoTests::Negative::UnionKeywordForStruct::Pair` is a struct, not a union
    first(&this) -> i32 { return this.a; }
}

function main() -> int {
    return 0;
}
