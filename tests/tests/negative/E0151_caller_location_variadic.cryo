// E0151: a `![caller_location]` function takes its caller's location as two
// hidden arguments after its written ones, and a variadic function's written
// arguments have no fixed end, so the two cannot be told apart from the
// variadic part.  The directive is refused on a variadic function and on a
// variadic method, where it is written.
![config(testing)]
![config(negative, E0151)]
namespace CryoTests::Negative::CallerLocationVariadic;

![caller_location]   //~ ERROR[E0151] `![caller_location]` cannot be applied to a variadic function
function cv_report(code: u32, args...) -> u32 {
    return code + LINE;
}

type struct CvSite {
    value: u32;

    ![caller_location]   //~ ERROR[E0151] `![caller_location]` cannot be applied to a variadic function
    static report(code: u32, args...) -> u32 {
        return code + LINE;
    }
}

function main() -> int {
    return (cv_report(1, 41) + CvSite::report(2, 42)) as int;
}
