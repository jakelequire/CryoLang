// E0200: a constant pattern matches only a value of the constant's own type.
// Read at the subject's width, a `u32` constant equal to 4294967295 would
// match the `i32` value -1, and the same constant would match `true`.
![config(testing)]
![config(negative, E0200)]
namespace CryoTests::Negative::E0200ConstantPatternTypeMismatch;

const BIG: u32 = 4294967295;

function signed(n: i32) -> i32 {
    return match (n) {
        BIG => { 1 }
        //~^ ERROR[E0200] constant `BIG` of type `u32` cannot match a value of type `i32`
        u32::MAX => { 2 }
        //~^ ERROR[E0200] constant `MAX` of type `u32` cannot match a value of type `i32`
        _ => { 0 }
    };
}

function flag(b: boolean) -> i32 {
    return match (b) {
        BIG => { 1 }
        //~^ ERROR[E0200] constant `BIG` of type `u32` cannot match a value of type `boolean`
        _ => { 0 }
    };
}

function payload(o: Option<i32>) -> i32 {
    return match (o) {
        Option::Some(BIG) => { 1 }
        //~^ ERROR[E0200] constant `BIG` of type `u32` cannot match a value of type `i32`
        _ => { 0 }
    };
}

function main() -> int {
    return signed(-1) + flag(true) + payload(Option::Some(-1));
}
