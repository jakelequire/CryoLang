// E0358 alone: a method that does not exist in a `match`'s subject leaves
// the subject without a type, so no variant of it can be found missing. A
// function whose every arm returns is then not also refused for reaching
// the end of its body (E0403), with a suggestion to add a `return` no path
// could reach.
![config(testing)]
![config(negative, E0358)]
namespace CryoTests::Negative::UnresolvedMatchSubjectEveryArmReturns;

import std::core::option::{ Option };

function pick(text: Str) -> i32 {
    match (text.missing()) {
    //~^ ERROR[E0358] no method named `missing` found on type `std::collections::str::Str`
        Option::Some(value) => { return value; }
        Option::None => { return 0; }
    }
}

function main() -> int {
    return pick(Str::new("a")) as int;
}
