// E0229: a user trait SPELLED `Add` is another trait. `+` is
// `std::core::ops::Add` by the identity its declaration claimed, and neither a
// type implementing the user trait nor a parameter bounded by it overloads
// the operator: the concrete operand is selected by identity, and the bound is
// matched by identity. The operand here reaches `+` through the user trait
// alone. This file pins the concrete operand; the bounded parameter is
// E0229_user_trait_spelled_add_bound.cryo (a sema error aborts before the
// instantiation that judges the bounded body, so the two cannot share a file).
![config(testing)]
![config(negative, E0229)]
namespace CryoTests::Negative::E0229UserTraitSpelledAdd;

type trait Add<Rhs, Output> { add(&this, rhs: &Rhs) -> Output; }

type struct CfP { x: i64; }

implement trait Add<CfP, CfP> for struct CfP {
    add(&this, rhs: &CfP) -> CfP { return CfP { x: this.x * 100 + rhs.x }; }
}

function main() -> int {
    const q: CfP = CfP { x: 3 } + CfP { x: 4 };
    //~^ ERROR[E0229] `CryoTests::Negative::E0229UserTraitSpelledAdd::CfP` does not implement `Add`; add `implement trait Add ... for CryoTests::Negative::E0229UserTraitSpelledAdd::CfP` to use the `+` operator on it
    return q.x as int;
}
