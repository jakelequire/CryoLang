// E0233: an impl-qualified path is refused in the head's own terms.  A
// member the named trait's implementation does not deliver is refused at
// the member - not as the bare path's "cannot find `CfP::nope`", and not
// left unpinned for codegen to bind by name and arity, which is the pick
// by registration order the head exists to rule out.  A head whose trait
// position names a type is refused at the head: `(CfP for CfP)` selects
// no implementation.
![config(testing)]
![config(negative, E0233)]
namespace CryoTests::Negative::ImplQualifiedNoMember;

type trait CfBeta {
    static make() -> i32;
}

type trait CfGamma {
    static make() -> i32;
    static extra() -> i32;
}

type struct CfP { v: i32; }

implement trait CfBeta for CfP {
    static make() -> i32 { return 2; }
}

implement trait CfGamma for CfP {
    static make() -> i32 { return 5; }
    static extra() -> i32 { return 7; }
}

function main() -> int {
    const a: i32 = (CfGamma for CfP)::extra();
    const b: i32 = (CfBeta for CfP)::extra();   //~ ERROR[E0233] `CfBeta`'s implementation for `CfP` has no method `extra`
    const c: i32 = (CfP for CfP)::make();       //~ ERROR[E0233] `CfP` is not a trait
    return a + b + c;
}
