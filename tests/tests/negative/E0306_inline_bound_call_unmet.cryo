// E0306: a function whose type parameter carries an inline bound
// (`<T: Tagged>`) is checked at its calls as the same bound in a `where`
// clause is: at the type argument a call binds, and in a generic caller whose
// own bounds - inline or `where` - do not give it.
![config(testing)]
![config(negative, E0306)]
namespace CryoTests::Negative::InlineBoundCallUnmet;

type trait Tagged {
    tag(&this) -> i32;
}

type struct Plain { v: i32; }

type struct Named { v: i32; }
implement trait Tagged for Named {
    tag(&this) -> i32 { return this.v; }
}

function tag_of<T: Tagged>(x: &T) -> i32 {
    return x.tag();
}

function unbounded<T>(x: &T) -> i32 {
    return tag_of(x);   //~ ERROR[E0306] the trait bound `T: Tagged` is not satisfied
}

function bounded_inline<T: Tagged>(x: &T) -> i32 {
    return tag_of(x);
}

function bounded_where<T>(x: &T) -> i32 where T: Tagged {
    return tag_of(x);
}

function main() -> int {
    const q: Plain = Plain { v: 2 };
    const t: i32 = tag_of(&q);   //~ ERROR[E0306] the trait bound `CryoTests::Negative::InlineBoundCallUnmet::Plain: Tagged` is not satisfied
    const n: Named = Named { v: 3 };
    return bounded_inline(&n) + bounded_where(&n) + t;
}
