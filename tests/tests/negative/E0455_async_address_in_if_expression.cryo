// E0455: an `if` used as an EXPRESSION is a place a frame address can be taken,
// and the check has to look there like it looks anywhere else.
//
// This one was accepted and RUN before the async lowering's expression walkers
// learned about `IfExpression`: only the ternary form was descended into, so the
// `&buf[0]` below was invisible and `p` crossed the suspend pointing into a poll
// frame that no longer exists.  The write afterwards lands in whatever the stack
// has been reused for, which corrupts silently instead of faulting.
![config(testing)]
![config(negative, E0455)]
namespace CryoTests::Negative::E0455AsyncAddressInIfExpression;

import std::future;

async function addr_in_arm(c: boolean) -> i64 {
    mut buf: u8[8] = [0; 8];
    const p: u8* = if (c) { &buf[0] } else { null };   //~ ERROR[E0455] async: `p` holds the address of the local or parameter `buf`
    const _z: i64 = await PendingThenReady<i64>::new(2, 1);
    if (p != null) { *p = 42; }
    return 0;
}

function main() -> int { return 0; }
