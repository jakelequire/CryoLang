// An integer literal that does not fit the OWNER's type argument is rejected
// where it is written, exactly as one bound to a concrete parameter is: the
// formal `initial: T` of `GonOwner<u8>::new` denotes a u8 at this call site, so
// the literal IS a u8 and its width bound is checked against that.
//
// Before the owner's type argument was substituted into the formal, the literal
// defaulted to i32 and only the comparison at the call boundary caught it
// (E0214, "narrows the value and would silently truncate"), so the diagnostic
// pointed at the argument position rather than naming the literal's own type.
![config(testing)]
![config(negative, E0010)]
namespace CryoTests::Negative::E0010GenericOwnerArgOverflow;

type struct GonOwner<T> {
    v: T;
    static new(initial: T) -> GonOwner<T> { return GonOwner<T> { v: initial }; }
}

function main() -> int {
    mut o: GonOwner<u8> = GonOwner<u8>::new(300);   //~ ERROR[E0010] out of range
    return 0;
}
