// E0203: a plain `import std::future;` binds the module and no names from
// it, re-exported ones included: `Waker` and `Ready` are reached through the
// facade (`future::Waker`, `future::Ready`) or through the sub-module the
// facade re-exports whole (`waker::Waker`), and are not in scope bare.
![config(testing)]
![config(negative, E0203)]
namespace CryoTests::Negative::PlainImportBindsNoNames;

import std::future;

function through_facade(w: future::Waker*, r: future::Ready<i32>*) -> i32 { return 0; }
function through_module(w: waker::Waker*) -> i32 { return 0; }
function bare_waker(w: Waker*) -> i32 { return 0; }        //~ ERROR[E0203] cannot find type `Waker`
function bare_ready(r: Ready<i32>*) -> i32 { return 0; }   //~ ERROR[E0203] cannot find type `Ready`

function main() -> int {
    return 0;
}
