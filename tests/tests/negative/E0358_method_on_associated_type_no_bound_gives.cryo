///! An associated type of a type parameter has the methods the bounds
///! written on it give it and no others.  A read-only container bounded by
///! `IndexViewMutable` is viewed through `IndexView`, so `container[r]` is a
///! `C::View`, and the bound on `C::ViewMutable` gives it nothing; a value
///! typed `C::Item` with no bound on it has no methods at all.

![config(testing)]
![config(negative, E0358)]
namespace CryoTests::Negative::E0358MethodOnAssociatedTypeNoBoundGives;

import std::core::ops::{ IndexView, IndexViewMutable, Range };

type trait Put {
    put(mut &this, value: i64) -> void;
}

type trait Source {
    type Item;
    take(mut &this) -> This::Item;
}

function put_read_only<C>(container: &C, value: i64) -> void
        where C: IndexViewMutable<Range<i64>>, C::ViewMutable: Put {
    container[1..3].put(value);
    //~^ ERROR[E0358] no method named `put` found on type
}

function put_unbounded<S>(source: mut &S, value: i64) -> void where S: Source {
    mut item = source.take();
    item.put(value);
    //~^ ERROR[E0358] no method named `put` found on type
}

function main() -> i32 {
    return 0;
}
