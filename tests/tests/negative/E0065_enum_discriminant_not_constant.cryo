// E0065: an enum discriminant that does not fold to a compile-time integer is
// refused at the variant: a call, two variants that name each other, and a
// bare name of one of the enum's own variants - a variant is named through
// its enum, as everywhere outside the enum's body.
![config(testing)]
![config(negative, E0065)]
namespace CryoTests::Negative::E0065EnumDiscriminantNotConstant;

function runtime_value() -> i32 { return 3; }

type enum Call {
    R = runtime_value();
    //~^ ERROR[E0065] the discriminant of `R` is not a compile-time integer
}

type enum Cycle {
    P = Cycle::Q;
    //~^ ERROR[E0065] the discriminant of `P` is not a compile-time integer
    Q = Cycle::P;
    //~^ ERROR[E0065] the discriminant of `Q` is not a compile-time integer
}

type enum Bare {
    A = 1;
    B = A;
    //~^ ERROR[E0201] cannot find value `A` in this scope
    //~^^ ERROR[E0065] the discriminant of `B` is not a compile-time integer
}

function main() -> i32 {
    return Call::R as i32 + Cycle::P as i32 + Bare::B as i32;
}
