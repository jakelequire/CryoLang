///! After a `loop` or `do-while` a binding is moved if it is moved on any
///! path that leaves the loop: a `break` taken before the body assigns it
///! leaves it moved, so using it after the loop is a use after a move.

![config(testing)]
![config(negative, E0452)]
namespace CryoTests::Negative::E0452UseAfterLoopMovedOnOneExit;

type struct Owned {
    id: i64;
}

implement trait Drop for struct Owned {
    drop(mut &this) -> void { }
}

function take(value: Owned) -> i64 { return value.id; }

function break_before_assignment(early: boolean) -> i64 {
    mut value: Owned = Owned { id: 1 };
    take(value);
    loop {
        if (early) { break; }
        value = Owned { id: 2 };
        break;
    }
    return take(value);
    //~^ ERROR[E0452] use of moved value `value`
}

function do_while_break_before_assignment(early: boolean, times: i64) -> i64 {
    mut value: Owned = Owned { id: 1 };
    take(value);
    mut i: i64 = 0;
    do {
        if (early) { break; }
        value = Owned { id: 3 };
        i += 1;
    } while (i < times);
    return take(value);
    //~^ ERROR[E0452] use of moved value `value`
}

function main() -> i32 {
    return 0;
}
