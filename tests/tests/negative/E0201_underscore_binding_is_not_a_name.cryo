// E0201: a local named `_` declares no name, so no expression can read it.
![config(testing)]
![config(negative, E0201)]
namespace CryoTests::Negative::E0201UnderscoreBindingIsNotAName;

function main() -> int {
    const _: int = 4;
    const _: int = 5;
    return _;
    //~^ ERROR[E0201] cannot find value `_` in this scope
}
