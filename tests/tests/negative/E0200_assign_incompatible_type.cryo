// E0200: plain `=` assignment must type-check the value against the slot.
// Assigning a string to an i32 binding is incompatible and must be rejected
// (it used to compile silently — a miscompile).
![config(testing)]
![config(negative, E0200)]
namespace CryoTests::Negative::E0200AssignIncompatibleType;
function main() -> int {
    mut x: i32 = 0;
    x = "a string literal";
    return 0;
}
