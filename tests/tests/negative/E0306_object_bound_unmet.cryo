// E0306: an object satisfies a bound of its own trait only when the table
// can stand for every method of the bound's trait and its supertraits.  A
// method with type parameters of its own, or one taking `This`, has no
// place in a table, so its trait is met by no object; `Counter`, whose
// methods a table holds, is met by an object in each form.
![config(testing)]
![config(negative, E0306)]
namespace CryoTests::Negative::ObjectBoundUnmet;

type trait Counter {
    bump(mut &this) -> void;
    get(&this) -> i32;
}

type trait Grow {
    grow<T>(&this, t: T) -> i32;
}

type trait Same {
    same(&this, other: &This) -> boolean;
}

type struct Tally {
    n: i32;
}

implement trait Counter for Tally {
    bump(mut &this) -> void { this.n = this.n + 1; }
    get(&this) -> i32 { return this.n; }
}

implement trait Grow for Tally {
    grow<T>(&this, t: T) -> i32 { return 1; }
}

implement trait Same for Tally {
    same(&this, other: &This) -> boolean { return this.n == other.n; }
}

type struct Keep<C> where C: Counter {
    c: C;
}

type struct Hold<G> where G: Grow {
    g: G;
}

type struct Pair<S> where S: Same {
    s: S;
}

function main() -> int {
    mut t: Tally = Tally { n: 1 };
    const shared: virtual &Counter = &t;
    const k: Keep<virtual &Counter> = Keep::<virtual &Counter> { c: shared };
    const changing: virtual mut &Counter = &t;
    const km: Keep<virtual mut &Counter> = Keep::<virtual mut &Counter> { c: changing };
    const raw: virtual Counter* = &t as Tally*;
    const kr: Keep<virtual Counter*> = Keep::<virtual Counter*> { c: raw };
    const g: virtual &Grow = &t;
    const h: Hold<virtual &Grow> = Hold::<virtual &Grow> { g: g };
    //~^ ERROR[E0306] the trait bound `virtual &CryoTests::Negative::ObjectBoundUnmet::Grow: Grow` is not satisfied
    const s: virtual &Same = &t;
    const p: Pair<virtual &Same> = Pair::<virtual &Same> { s: s };
    //~^ ERROR[E0306] the trait bound `virtual &CryoTests::Negative::ObjectBoundUnmet::Same: Same` is not satisfied
    return k.c.get() + km.c.get() + kr.c.get();
}
