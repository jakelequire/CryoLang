//~^ ERROR[E0353] `std::net::socket::udp::UdpIo` is internal to its package and cannot be imported into `CryoTests::Negative::E0353NetworkFuturesAreInternal`
import std::net::socket::udp::{ UdpReceived };
//~^ ERROR[E0353] `std::net::socket::udp::UdpReceived` is internal to its package and cannot be imported into `CryoTests::Negative::E0353NetworkFuturesAreInternal`
import std::net::tls::context::{ TlsConnector };
import std::net::tls::stream::{ TlsStream };

function assemble(connector: &TlsConnector) -> boolean {
    const stream: TlsStream = TlsStream::from_parts(null, TcpStream::from_file_descriptor(-1));
    //~^ ERROR[E0353] method `from_parts` of `std::net::tls::stream::TlsStream` is internal
    return connector.start_connect(TcpStream::from_file_descriptor(-1), Str::new("localhost")).is_ok();
    //~^ ERROR[E0353] method `start_connect` of `std::net::tls::context::TlsConnector` is internal
}

function main() -> int {
    return 0;
}
