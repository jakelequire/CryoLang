// E0353: the futures behind the sockets' `async` methods are internal to the
// standard library.  A program awaits `listener.accept()`,
// `TcpStream::connect`, `read_some`, `write_all`, `send_to`, `receive_from`,
// `send` and `receive`, and `TlsConnector.connect` / `TlsAcceptor.accept`;
// it never holds the operation itself.  A TLS stream is made only by a
// handshake, so assembling one from raw OpenSSL parts is internal too, and
// so is the step that hands back a handshake not yet run.
![config(testing)]
![config(negative, E0353)]
namespace CryoTests::Negative::E0353NetworkFuturesAreInternal;

import std::core::result::{ Result };
import std::collections::str::{ Str };
import std::io::error::{ IoError };
import std::net::socket::tcp::{ TcpListener, TcpStream };
import std::net::socket::tcp::{ TcpAccept };
//~^ ERROR[E0353] `std::net::socket::tcp::TcpAccept` is internal to its package and cannot be imported into `CryoTests::Negative::E0353NetworkFuturesAreInternal`
import std::net::socket::tcp::{ TcpAccepted };
//~^ ERROR[E0353] `std::net::socket::tcp::TcpAccepted` is internal to its package and cannot be imported into `CryoTests::Negative::E0353NetworkFuturesAreInternal`
import std::net::socket::tcp::{ TcpConnect };
//~^ ERROR[E0353] `std::net::socket::tcp::TcpConnect` is internal to its package and cannot be imported into `CryoTests::Negative::E0353NetworkFuturesAreInternal`
import std::net::socket::tcp::{ TcpRead };
//~^ ERROR[E0353] `std::net::socket::tcp::TcpRead` is internal to its package and cannot be imported into `CryoTests::Negative::E0353NetworkFuturesAreInternal`
import std::net::socket::tcp::{ TcpWrite };
//~^ ERROR[E0353] `std::net::socket::tcp::TcpWrite` is internal to its package and cannot be imported into `CryoTests::Negative::E0353NetworkFuturesAreInternal`
import std::net::socket::tcp::{ TcpIo };
//~^ ERROR[E0353] `std::net::socket::tcp::TcpIo` is internal to its package and cannot be imported into `CryoTests::Negative::E0353NetworkFuturesAreInternal`
import std::net::socket::udp::{ UdpSocket };
import std::net::socket::udp::{ UdpSendTo };
//~^ ERROR[E0353] `std::net::socket::udp::UdpSendTo` is internal to its package and cannot be imported into `CryoTests::Negative::E0353NetworkFuturesAreInternal`
import std::net::socket::udp::{ UdpSend };
//~^ ERROR[E0353] `std::net::socket::udp::UdpSend` is internal to its package and cannot be imported into `CryoTests::Negative::E0353NetworkFuturesAreInternal`
import std::net::socket::udp::{ UdpReceiveFrom };
//~^ ERROR[E0353] `std::net::socket::udp::UdpReceiveFrom` is internal to its package and cannot be imported into `CryoTests::Negative::E0353NetworkFuturesAreInternal`
import std::net::socket::udp::{ UdpReceive };
//~^ ERROR[E0353] `std::net::socket::udp::UdpReceive` is internal to its package and cannot be imported into `CryoTests::Negative::E0353NetworkFuturesAreInternal`
