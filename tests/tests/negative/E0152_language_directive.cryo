// E0152: `![language]` takes one string, and the string is the name of a
// language item the compiler has.  The shape is checked wherever the
// directive is written; outside the standard library the declaration is
// refused as well (E0151).
![config(testing)]
![config(negative, E0152)]
namespace CryoTests::Negative::E0152LanguageDirective;

![language("no_such_item")]
//~^ ERROR[E0151] directive `![language]` belongs to the standard library; a declaration outside it cannot be a language item
//~^^ ERROR[E0152] directive `![language]`: there is no language item named `no_such_item`
function cf_unknown() -> i32 { return 1; }

![language(format_new)]
//~^ ERROR[E0151] directive `![language]` belongs to the standard library; a declaration outside it cannot be a language item
//~^^ ERROR[E0152] directive `![language]`: argument 1 must be a string naming a language item
function cf_bare() -> i32 { return 2; }

function main() -> int { return cf_unknown() + cf_bare(); }
