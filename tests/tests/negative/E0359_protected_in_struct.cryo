// E0359: `protected` visibility is class-only; a struct may not use it.
![config(testing)]
![config(negative, E0359)]
namespace CryoTests::Negative::E0359ProtectedInStruct;

type struct CfS {
protected:   //~ ERROR[E0359] `protected:` is not allowed in
    secret: i32;
}

function main() -> int {
    const s: CfS = CfS { secret: 0 };
    return s.secret;
}
