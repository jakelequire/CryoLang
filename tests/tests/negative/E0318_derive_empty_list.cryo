// E0318: a `with` clause that lists no traits asks for nothing, and is
// refused where it is written.  The clause listing one trait is the
// control.
![config(testing)]
![config(negative, E0318)]
namespace CryoTests::Negative::E0318DeriveEmptyList;

import std::core::cmp::{ Eq };

type struct DeNothing with [] {   //~ ERROR[E0318] a `with` clause lists no traits
    x: i64;
}

type struct DeSomething with [Eq] {
    x: i64;
}

function main() -> i32 {
    return 0;
}
