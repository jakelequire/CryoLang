// E0308: an implementation whose target is a parameter of its own is an
// implementation for every type, so one of the same trait for a type at
// itself overlaps it, and so does a second implementation for every type.
// One at another argument (`Make<i32> for Wide`) does not.  Each pair is
// reported once, at the implementation checked second.
![config(testing)]
![config(negative, E0308)]
namespace CryoTests::Negative::BlanketImplementationOverlap;

type trait Make<S> {
    static make(source: S) -> This;
}

implement<T> trait Make<T> for T {
    static make(source: T) -> T { return source; }
}

type struct Wide { value: i64; }

implement trait Make<i32> for struct Wide {
    static make(source: i32) -> Wide { return Wide { value: source as i64 }; }
}

implement trait Make<Wide> for struct Wide {   //~ ERROR[E0308] `Make<Wide> for Wide` overlaps `Make<T> for T`
    static make(source: Wide) -> Wide { return source; }
}

implement<U> trait Make<U> for U {   //~ ERROR[E0308] `Make<U> for U` overlaps `Make<T> for T`
    static make(source: U) -> U { return source; }
}

function main() -> int {
    return 0;
}
