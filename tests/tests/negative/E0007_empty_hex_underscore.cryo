// E0007: a hex literal whose only body is a separator (`0x_`). The lone `_`
// advanced the cursor without contributing a digit, so the old "cursor moved"
// guard accepted it and valued it as a silent 0. The lexer now tracks whether
// a real digit was seen, mirroring the malformed-float-exponent rejection.
![config(testing)]
![config(negative, E0007)]
namespace CryoTests::Negative::EmptyHexUnderscore;

function main() -> int {
    const x: i32 = 0x_;
    return 0;
}
