// E0113: a payload-less path in a pattern whose leading segments name a
// module is a value path, and it must name a constant: a function or a `mut`
// global reached that way has no value to compare the subject against.
![config(testing)]
![config(negative, E0113)]
namespace CryoTests::Negative::E0113PatternPathNamesNoConstant;

mut COUNTER: u32 = 0;

function helper() -> u32 { return 1; }

function classify(code: u32) -> i32 {
    return match (code) {
        CryoTests::Negative::E0113PatternPathNamesNoConstant::helper => { 1 }
        //~^ ERROR[E0113] is not a constant, so it cannot be matched against
        CryoTests::Negative::E0113PatternPathNamesNoConstant::COUNTER => { 2 }
        //~^ ERROR[E0113] is not a constant, so it cannot be matched against
        _ => { 0 }
    };
}

function main() -> int {
    return classify(3);
}
