// E0306: `for (x in <expr>)` calls `Iterator::next` on the scrutinee (or on
// `<expr>.iter()` for a collection).  A scrutinee whose type neither
// implements `Iterator` nor exposes `iter()` - here a bare `i32` - is refused
// at the scrutinee, once, rather than silently miscompiled.
![config(testing)]
![config(negative, E0306)]
namespace CryoTests::Negative::ForInNonIterator;

import std::fmt;

function main() -> int {
    const cf_not_iterable: i32 = 42;
    for (i in cf_not_iterable) {   //~ ERROR[E0306] `i32` does not implement `Iterator`
        fmt::printf("%d\n", i);
    }
    return 0;
}
