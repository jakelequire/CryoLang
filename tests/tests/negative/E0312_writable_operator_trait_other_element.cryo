// E0312: `IndexMutable<Idx>` writes the `Output` its `Index<Idx>`
// implementation binds, and `DerefMutable` the `Target` its `Deref`
// implementation binds, so a writable method giving another element type
// is refused where it is written: reading and writing `a[i]` or `*b` always
// reach the same type.  A type whose two implementations agree is the
// control.
![config(testing)]
![config(negative, E0312)]
namespace CryoTests::Negative::WritableOperatorTraitOtherElement;

import std::core::ops::{ Index, IndexMutable, Deref, DerefMutable };

type struct Widened { cells: [i32; 2]; wide: [i64; 2]; }

implement trait Index<u64> for Widened {
    type Output = i64;
    index(&this, i: u64) -> const i64* { return &this.wide[i]; }
}

implement trait IndexMutable<u64> for Widened {
    index_mutable(mut &this, i: u64) -> i32* { return &this.cells[i]; }   //~ ERROR[E0312] `index_mutable` returns `This::Output*` in trait `IndexMutable`, but `i32*` here
}

type struct Point { x: i32; }
type struct Label { text: i64; }

type struct Twofaced { point: Point; label: Label; }

implement trait Deref for Twofaced {
    type Target = Label;
    deref(&this) -> const Label* { return &this.label; }
}

implement trait DerefMutable for Twofaced {
    deref_mutable(mut &this) -> Point* { return &this.point; }   //~ ERROR[E0312] `deref_mutable` returns `This::Target*` in trait `DerefMutable`, but `CryoTests::Negative::WritableOperatorTraitOtherElement::Point*` here
}

type struct Agreeing { cells: [i32; 2]; point: Point; }

implement trait Index<u64> for Agreeing {
    type Output = i32;
    index(&this, i: u64) -> const i32* { return &this.cells[i]; }
}

implement trait IndexMutable<u64> for Agreeing {
    index_mutable(mut &this, i: u64) -> i32* { return &this.cells[i]; }
}

implement trait Deref for Agreeing {
    type Target = Point;
    deref(&this) -> const Point* { return &this.point; }
}

implement trait DerefMutable for Agreeing {
    deref_mutable(mut &this) -> Point* { return &this.point; }
}

function main() -> int {
    return 0;
}
