// E0200: `[]` on a user type that does not implement `Index` is rejected
// with a message naming the missing trait (not the generic "cannot index").
![config(testing)]
![config(negative, E0200)]
namespace CryoTests::Negative::E0200IndexNoImpl;

type struct NoIndex { v: i32; }

function main() -> int {
    const n: NoIndex = NoIndex { v: 5 };
    const x: i32 = n[0];   //~ ERROR[E0200] cannot be indexed with `[]`
    return x;
}
