// E0458: a capturing closure passed to a GENERIC free function's fn-typed
// parameter is not yet supported. Before the guard in sema/lambda_synth.cryo
// this compiled and then SEGFAULTED at runtime (the generic body called the
// parameter as a fn-pointer while the argument was a closure-struct value).
// It must now be rejected cleanly at compile time.
![config(testing)]
![config(negative, E0458)]
namespace CryoTests::Negative::E0458ClosureIntoGenericFreeFn;

import std::core::result;

type struct Res { id: i32; }

function apply_gen<F>(x: F, body: (F*) -> i32) -> i32 {
    mut local: F = x;
    return body(&local);
}

function main() -> int {
    const bias: i32 = 5;
    // The lambda captures `bias`, so it lowers to a closure-struct value;
    // passing it to the generic `apply_gen` is the rejected construct.
    const out: i32 = apply_gen<Res>(Res { id: 1 }, (p: Res*) -> i32 { return p.id + bias; });
    return out;
}
