// E0458: a capturing closure passed to a generic free function's parameter
// of function type.  Every copy of the function takes a function pointer
// there; letting the closure through once compiled and then crashed at the
// call through the parameter.  The control compiles: a closure passed to a
// type parameter of a generic function is that parameter's argument, and
// the copy for it calls it directly.
![config(testing)]
![config(negative, E0458)]
namespace CryoTests::Negative::E0458ClosureIntoGenericFreeFn;

type struct Res { id: i32; }

function apply_gen<F>(x: F, body: (F*) -> i32) -> i32 {
    mut local: F = x;
    return body(&local);
}

function apply_bounded<T, C>(x: T, body: C) -> i32 where C: (T) -> i32 {
    return body(x);
}

function main() -> int {
    const bias: i32 = 5;
    const out: i32 = apply_gen::<Res>(Res { id: 1 }, (p: Res*) -> i32 { return p.id + bias; });   //~ ERROR[E0458] a capturing closure cannot be passed to a parameter of function type `(F*) -> i32` of `apply_gen`
    const ok: i32 = apply_bounded(Res { id: 2 }, (r: Res) -> i32 { return r.id + bias; });
    return out + ok;
}
