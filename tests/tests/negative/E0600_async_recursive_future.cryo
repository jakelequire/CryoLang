// E0600: an `async function` cannot await itself.
//
// A future stores every future it awaits as one of its own fields, so a future
// that awaits itself contains itself and has no finite size.  Nothing rejects
// that on the layout side: the nested future ends up overlapping the outer one,
// and the machine re-polls an already-completed sub-future at runtime.  Since
// there is no boxing escape hatch to point users at yet, the recursion itself has
// to be rejected - at the `await` that closes the cycle.
![config(testing)]
![config(negative, E0600)]
namespace CryoTests::Negative::E0600AsyncRecursiveFuture;

import std::future;

async function countdown(n: i64) -> i64 {
    const _z: i64 = await PendingThenReady<i64>::new(1, 1);
    if (n <= 0) { return 0; }
    const rest: i64 = await countdown(n - 1);   //~ ERROR[E0600] async: this `await` would make the state machine contain itself
    return rest + 1;
}

function main() -> int { return 0; }
