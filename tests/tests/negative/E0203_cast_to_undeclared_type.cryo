// E0203: the target of `as` is an annotation in expression position, and an
// unknown type there is the same error it is in a declaration.  Before this
// was refused, `1 as Nope` compiled and ran: the cast was emitted as nothing.
![config(testing)]
![config(negative, E0203)]
namespace CryoTests::Negative::CastToUndeclaredType;

function main() -> int {
    const v: i64 = 1 as Nope;   //~ ERROR[E0203] cannot find type `Nope` in this scope
    return v as int;
}
