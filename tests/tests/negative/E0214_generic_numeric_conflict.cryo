// Compile-fail: a single generic type parameter is inferred to two distinct
// NUMERIC widths across argument positions. `pick<T>(a: T, b: T)` called with
// an `i32` and an `i64` variable has no single `T`.
//
// Absent this check the monomorphizer would treat this "coercible" pair as
// benign, pin `T` from the first argument (i32), and silently NARROW the i64
// second argument to 32 bits - a miscompile returning a truncated value
// with no diagnostic. Two distinct concrete types in the same `T` slot are
// a hard error (whether category-incompatible like `i32`/`string` or
// merely a coercible numeric pair). A literal argument, by contrast, stays
// polymorphic and adapts to the other argument's width - that case must still
// compile and is covered by the positive suite.
![config(testing)]
![config(negative, E0214)]
namespace CryoTests::Negative::E0214GenericNumericConflict;

function pick<T>(a: T, b: T) -> T { return b; }

function main() -> int {
    const small: i32 = 7;
    const big:   i64 = 1234567890123;
    const r: i64 = pick(small, big);   // no single T: i32 vs i64 -> E0214
    return 0;
}
