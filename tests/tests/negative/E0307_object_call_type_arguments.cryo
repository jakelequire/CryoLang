// E0307: a method callable through a trait object has no type parameters of
// its own, so a type argument written on a call through an object, on the
// object or through a reference to it, is one too many.
![config(testing)]
![config(negative, E0307)]
namespace CryoTests::Negative::ObjectCallTypeArguments;

type trait Named {
    id(&this) -> i32;
}

type trait Shape : Named {
    area(&this) -> i32;
}

function on_object(s: virtual &Shape) -> i32 {
    return s.area::<i32>();
    //~^ ERROR[E0307] `Shape::area` has 0 type parameters, and 1 type argument is written
}

function supertrait_method(s: virtual &Shape) -> i32 {
    return s.id::<i32, u8>();
    //~^ ERROR[E0307] `Named::id` has 0 type parameters, and 2 type arguments are written
}

function through_reference(r: &virtual &Shape) -> i32 {
    return r.area::<u8>();
    //~^ ERROR[E0307] `Shape::area` has 0 type parameters, and 1 type argument is written
}

function main() -> int {
    return 0;
}
