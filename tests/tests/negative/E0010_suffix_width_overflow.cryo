// E0010: the width bound is checked against the type the author WROTE, not the
// surrounding context, so an out-of-range suffixed literal is caught even where
// the context would have admitted the value.
![config(testing)]
![config(negative, E0010)]
namespace CryoTests::Negative::SuffixWidthOverflow;
function main() -> int { const x: i32 = 300u8; return 0; }   //~ ERROR[E0010] out of range
