// E0200: an assignment in a generic body is checked with each type
// parameter standing for one opaque type, so a `T` slot does not take an
// `Option<T>`.
![config(testing)]
![config(negative, E0200)]
namespace CryoTests::Negative::GenericBodyAssignMismatch;

function pick<T>(xs: &Array<T>, fallback: T) -> T where T: Copy {
    mut out: T = fallback;
    out = xs.get(0);   //~ ERROR[E0200] mismatched types
    return out;
}

function main() -> i32 {
    mut xs: Array<i32> = Array::<i32>::new();
    xs.push(5);
    return pick::<i32>(&xs, 0);
}
