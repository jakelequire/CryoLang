///! A primitive trait is had by the built-in value types its rule names and
///! by nothing else: a generic bounded by one refuses any other type where
///! it is given - a type of the other sign, a float for an integer bound,
///! and a struct for `Primitive`.

![config(testing)]
![config(negative, E0306)]
namespace CryoTests::Negative::E0306PrimitiveTraitBoundUnmet;

type struct Meters {
    value: i64;
}

function negate<T>(value: T) -> T where T: SignedInteger { return value; }
function count<T>(value: T) -> T where T: Integer { return value; }
function keep<T>(value: T) -> T where T: Primitive { return value; }

function main() -> i32 {
    const small: u8 = 3;
    negate::<u8>(small);
    //~^ ERROR[E0306] SignedInteger
    count::<f64>(1.5);
    //~^ ERROR[E0306] Integer
    keep::<Meters>(Meters { value: 2 });
    //~^ ERROR[E0306] Primitive
    return 0;
}
