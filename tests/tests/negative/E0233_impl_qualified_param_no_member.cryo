// E0233: an impl-qualified path through a type parameter,
// `(CfBeta for T)::extra()`, names the member `CfBeta`'s implementation
// for whatever type `T` becomes delivers, and `CfBeta` declares no
// `extra` - so the path is refused at the member, once however many
// copies of the body are made, even where the type `T` becomes has an
// `extra` through another trait.
![config(testing)]
![config(negative, E0233)]
namespace CryoTests::Negative::ImplQualifiedParamNoMember;

type trait CfBeta { static make() -> i32; }
type trait CfGamma { static extra() -> i32; }

type struct CfP { v: i32; }
type struct CfQ { v: i32; }

implement trait CfBeta for struct CfP { static make() -> i32 { return 1; } }
implement trait CfGamma for struct CfP { static extra() -> i32 { return 3; } }
implement trait CfBeta for struct CfQ { static make() -> i32 { return 2; } }

function cf_extra<T>() -> i32 where T: CfBeta {
    return (CfBeta for T)::make() + (CfBeta for T)::extra();   //~ ERROR[E0233] `CfBeta`'s implementation for `T` has no method `extra`
}

function main() -> int {
    return cf_extra::<CfP>() + cf_extra::<CfQ>();
}
