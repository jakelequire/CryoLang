// E0006: a `\u{...}` escape naming a surrogate.  U+D800 to U+DFFF are no
// Unicode scalar values, so neither a character nor UTF-8 text holds one.
// The code points either side of the range are held.
![config(testing)]
![config(negative, E0006)]
namespace CryoTests::Negative::SurrogateEscape;

function main() -> int {
    const below: char = '\u{D7FF}';
    const above: char = '\u{E000}';
    const text: string = "\u{d7ff}\u{e000}";
    const a: string = "\u{D800}";
    //~^ ERROR[E0006] `\u{D800}` is a surrogate, not a character
    const b: char = '\u{DFFF}';
    //~^ ERROR[E0006] `\u{DFFF}` is a surrogate, not a character
    const c: string = "pair \u{dbff}\u{dc00}";
    //~^ ERROR[E0006] `\u{dbff}` is a surrogate, not a character
    //~^^ ERROR[E0006] `\u{dc00}` is a surrogate, not a character
    if (below == above) { return 1; }
    return 0;
}
