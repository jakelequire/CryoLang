// E0153: `![sink]` is not a directive.  A leftover one is warned as unknown
// (a warning carrying an E code, so the annotation gives its severity), and
// the function it stands on takes its parameter as any other function does:
// nothing else is reported.
![config(testing)]
![config(negative, E0153)]
namespace CryoTests::Negative::E0153UnknownDirectiveSink;

type struct Holder { value: i32; }

![sink]
//~^ WARN[E0153] unknown directive `![sink]`: no built-in with that name
function take(holder: Holder) -> i32 { return holder.value; }

function main() -> int {
    return take(Holder { value: 0 }) as int;
}
