// E0307: a type argument written on a method call is one of the method's
// own type parameters, so a call writing one on a method that has none - a
// struct's own method, a trait implementation's, through a reference - is
// refused; a generic method's call writing as many as it has stands.
![config(testing)]
![config(negative, E0307)]
namespace CryoTests::Negative::MethodCallTypeArguments;

type trait Shape {
    area(&this) -> i32;
}

type struct Square {
    side: i32;

    double(&this) -> i32 { return this.side * 2; }
    pick<T>(&this, value: T) -> T { return value; }
}

implement trait Shape for Square {
    area(&this) -> i32 { return this.side * this.side; }
}

function through(s: &Square) -> i32 {
    return s.double::<i64>();
    //~^ ERROR[E0307] `CryoTests::Negative::MethodCallTypeArguments::Square::double` has 0 type parameters, and 1 type argument is written
}

function main() -> int {
    const s: Square = Square { side: 3 };
    const a: i32 = s.double::<i32>();
    //~^ ERROR[E0307] `CryoTests::Negative::MethodCallTypeArguments::Square::double` has 0 type parameters, and 1 type argument is written
    const b: i32 = s.area::<i32, u8>();
    //~^ ERROR[E0307] `CryoTests::Negative::MethodCallTypeArguments::Square::area` has 0 type parameters, and 2 type arguments are written
    const d: i32 = s.pick::<i32>(4);
    return a + b + d + through(&s);
}
