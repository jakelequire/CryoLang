// An owner is read as its `Deref` target where that target is declared and
// is `Copy`.  A `Box<String>` where a `String` is declared would copy an
// owner out of the box, so it is refused; one where a `Str` is declared is
// two reads, the box's and then the string's, and only one is taken.
![config(testing)]
![config(negative, E0214)]
namespace CryoTests::Negative::OwnerReadNeedsACopyTarget;

import std::alloc::box::{ Box };
import std::collections::str::{ Str };
import std::collections::string::{ String };

function owns(text: String) -> i64 {
    return text.length() as i64;
}

function views(text: Str) -> i64 {
    return text.length() as i64;
}

function main() -> int {
    const boxed: Box<String> = Box::new(String::from("x"));
    const a: i64 = owns(boxed);
    //~^ ERROR[E0214] mismatched types
    const b: i64 = views(boxed);
    //~^ ERROR[E0214] mismatched types
    return (a + b) as int;
}
