// E0215: a call whose argument count matches NO overload of an overloaded free
// function. The sema arity check must not bail on a multi-overload set and
// fall through into a misleading codegen "cannot resolve function 'f'";
// sema reports it at the call site with a clear arity diagnostic instead.
// (The single-overload too-many/too-few cases are E0215_*/E0216_* elsewhere.)
![config(testing)]
![config(negative, E0215)]
namespace CryoTests::Negative::OverloadNoMatchingArity;

function f(a: i32) -> i32 { return a; }
function f(a: i32, b: i32) -> i32 { return a + b; }

function main() -> int {
    return f(1, 2, 3);   //~ ERROR[E0215] no overload of function `f` takes
}
