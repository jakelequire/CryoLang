// E0200: an array literal adopts its annotated element type only when the
// element needs no value change to get there - a pointer keeping its bits
// while the compiler changes which pointee it believes in. A narrower INTEGER
// must not adopt it: the element emitter stores what the element evaluated to,
// so an i32 adopted into an i64 slot would store four bytes and leave four
// undefined. The cast has to be written (`[x as i64, x as i64]`), exactly as
// for a mixed-width tuple.
![config(testing)]
![config(negative, E0200)]
namespace CryoTests::Negative::ArrayLiteralWideningElement;
function main() -> int {
    mut cf_x: i32 = 7;
    const cf_wide: i64[2] = [cf_x, cf_x];   //~ ERROR[E0200] mismatched types
    return cf_wide[0] as int;
}
