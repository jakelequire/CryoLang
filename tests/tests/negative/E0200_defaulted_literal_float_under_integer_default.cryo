// E0200: a numeric literal in a bare literal of an all-defaulted generic
// does not bind the parameter - the default does - and is then typed as
// that instance's field.  A float literal under an integer default is a
// mismatch there, not a quiet `Defaulted<f64>`.
![config(testing)]
![config(negative, E0200)]
namespace CryoTests::Negative::DefaultedLiteralFloatUnderIntegerDefault;

type struct Defaulted<T = i64> {
    value: T;
}

function main() -> int {
    const d = Defaulted { value: 1.5 };   //~ ERROR[E0200] mismatched types
    return 0;
}
