// E0216: a call supplies fewer arguments than the function declares.
![config(testing)]
![config(negative, E0216)]
namespace CryoTests::Negative::E0216TooFewArgs;

function cf_needs_two(a: i32, b: i32) -> i32 { return a + b; }

function main() -> int {
    return cf_needs_two(1);   // missing second argument   //~ ERROR[E0216] function `cf_needs_two` takes 2
}
