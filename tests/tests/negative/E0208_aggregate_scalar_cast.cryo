// E0208: a value aggregate (struct/tuple/fixed array) has no scalar
// representation, so casting one to an integer is rejected. Previously this
// fell through to an invalid LLVM `bitcast` and crashed the backend with a
// bare E0900 verifier failure instead of a clean diagnostic.
// (Class -> pointer/int upcasts stay legal: a class is a heap pointer.)
![config(testing)]
![config(negative, E0208)]
namespace CryoTests::Negative::E0208AggregateScalarCast;

type struct CfPoint { x: i32; y: i32; }

function main() -> int {
    const p: CfPoint = CfPoint { x: 1, y: 2 };
    const n: i64 = p as i64;
    return 0;
}
