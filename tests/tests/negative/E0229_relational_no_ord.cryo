// E0229: a relational operator (`<`) on a struct that does not implement
// `Ord`. Relational operators desugar to `a.compare(&b).is_lt()`, so a type
// with no `Ord` impl is rejected (with a message naming the missing trait).
![config(testing)]
![config(negative, E0229)]
namespace CryoTests::Negative::E0229RelationalNoOrd;
type struct Tag { v: i32; }
function main() -> int {
    const a: Tag = Tag { v: 1 };
    const b: Tag = Tag { v: 2 };
    const lt: boolean = a < b;   //~ ERROR[E0229] does not implement `Ord`
    return 0;
}
