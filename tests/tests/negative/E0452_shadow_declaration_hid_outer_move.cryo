// E0452: a binding moved inside a branch, where the SAME branch later declares
// a different binding that happens to be spelled the same, is still moved at
// the join.
//
// Regression test for a move set keyed by the SPELLING rather than by the
// binding.  Under that key the inner `mut a` and the outer `a` shared one
// move-state slot, and the branch-local exclusion (which drops a binding
// DECLARED in a branch from the union, because such a binding is dead at the
// join) then dropped the OUTER binding's move with it.  The post-`if`
// `consume(a)` was accepted and the allocation was released twice - the
// compiler emitted a double free.
//
// The whole difference was one spelling: deleting the inner declaration, or
// renaming it, made the same program a hard error.  The inner binding is never
// read here on purpose, so nothing but its DECLARATION can be doing the work.
![config(testing)]
![config(negative, E0452)]
namespace CryoTests::Negative::ShadowDeclarationHidOuterMove;
import std::ffi::libc;

type struct Heap {
    p: void*;
}

implement trait Drop for struct Heap {
    drop(mut &this) -> void { libc::free(this.p); }
}

function consume(h: Heap) -> void {
    // by-value owning parameter: drops `h` at function exit.
}

function main() -> int {
    mut a: Heap = Heap { p: libc::malloc(16) };
    if (1 > 0) {
        consume(a);                                   // moves the outer `a`
        mut a: Heap = Heap { p: libc::malloc(16) };    // a different binding
    }
    consume(a);   // the outer `a` is still moved -> double free   //~ ERROR[E0452] use of moved value 'a'
    return 0;
}
