// E0453: a fill literal `[value; n]` evaluates `value` once and stores the
// same bits in every slot, so an element that releases what it owns would
// be released once per slot.  It is refused unless the element is a
// plain-copy type, for a dynamic and a fixed array alike, a count fixed or
// known only at run time, a type with its own `Drop` and one that owns a
// heap array.  A plain-copy element is accepted.
![config(testing)]
![config(negative, E0453)]
namespace CryoTests::Negative::E0453FillLiteralOwningElement;

import std::core::drop::{ Drop };

type struct Counted { v: i64; }

implement trait Drop for struct Counted {
    drop(mut &this) -> void { }
}

type struct Holder { xs: [i64]; }

type struct Plain { v: i64; }

function dynamic_runtime_count(n: u64) -> i64 {
    const xs: [Counted] = [Counted { v: 1 }; n];   //~ ERROR[E0453] `[value; n]` stores one value in every slot, so its element must be a plain-copy type; `Counted` is not
    return xs.length();
}

function fixed_count() -> i64 {
    const xs: [Counted; 2] = [Counted { v: 1 }; 2];   //~ ERROR[E0453] `Counted` is not, and the one value would be released once per slot
    return xs[0].v;
}

function owns_a_heap_array(n: u64) -> i64 {
    const hs: [Holder] = [Holder { xs: [] }; n];   //~ ERROR[E0453] `Holder` is not
    return hs.length();
}

function plain_is_accepted(n: u64) -> i64 {
    const ps: [Plain] = [Plain { v: 1 }; n];
    const fs: [i64; 4] = [0; 4];
    return ps.length() + fs[0];
}

function main() -> int { return 0; }
