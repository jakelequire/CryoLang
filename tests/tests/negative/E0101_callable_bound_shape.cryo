// E0101: a callable bound is one function type, written with its return
// type.  A parenthesized list with no `-> Ret` is refused, with the fix
// adding `-> void`; a second signature on the same bound is refused, since a
// value is called with one parameter list.  The control parses: one
// signature beside a trait.
![config(testing)]
![config(negative, E0101)]
namespace CryoTests::Negative::CallableBoundShape;

function run<F: (i32)>(f: F, x: i32) -> void { }   //~ ERROR[E0101] a callable bound is written as a function type, with its return type

function both<F>(f: F) -> i32 where F: (i32) -> i32 + (i64) -> i64 { return 0; }   //~ ERROR[E0101] a bound takes one callable signature

function fine<F>(f: F) -> i32 where F: (i32) -> i32 + Copy { return f(1); }

function main() -> int { return 0; }
