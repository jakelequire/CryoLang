// E0200: an opaque `implement Trait<T>` RETURN type carries the associated
// item. `Seq<T>` is positional sugar for `Seq<Item = T>`, so a function that
// declares `-> implement Seq<i64>` but returns a value whose actual `Seq::Item`
// is `i32` makes a dishonest element-type claim and must be rejected.
![config(testing)]
![config(negative, E0200)]
namespace CryoTests::Negative::OpaqueAssocItemReturn;

import std::core::option;

type trait Seq {
    type Item;
    next_one(mut &this) -> Option<This::Item>;
}

type struct IntSeq { n: i32; lim: i32; }
implement trait Seq<i32> for struct IntSeq {
    next_one(mut &this) -> Option<i32> { return Option::None; }
}

function make_seq() -> implement Seq<i64> {   // Item is i32, not i64
    return IntSeq { n: 0, lim: 4 };
}

function main() -> int {
    return 0;
}
