// E0200: an opaque `implement Trait<T>` RETURN type carries the associated
// item. `Seq<T>` is positional sugar for `Seq<Item = T>`, so a function that
// declares `-> implement Seq<Orange>` but returns a value whose actual
// `Seq::Item` is `Apple` makes a dishonest element-type claim and must be
// rejected. Two distinct user structs are a genuine, category-level mismatch.
![config(testing)]
![config(negative, E0200)]
namespace CryoTests::Negative::OpaqueAssocItemReturn;

import std::core::option;

type struct Apple { x: i32; }
type struct Orange { y: i32; }

type trait Seq {
    type Item;
    next_one(mut &this) -> Option<This::Item>;
}

type struct AppleSeq { n: i32; }
implement trait Seq<Apple> for struct AppleSeq {
    next_one(mut &this) -> Option<Apple> { return Option::None; }
}

function make_seq() -> implement Seq<Orange> {   // Item is Apple, not Orange
    return AppleSeq { n: 0 };
}

function main() -> int {
    return 0;
}
