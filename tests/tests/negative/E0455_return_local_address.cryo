// E0455: returning the address of a function-body local hands back a
// pointer into the stack frame that is freed on return.  (Returning
// `&this` / `&param` is allowed - those are caller-backed - so this must
// flag the body-local case specifically.)
![config(testing)]
![config(negative, E0455)]
namespace CryoTests::Negative::E0455ReturnLocalAddress;

function dangling() -> i32* {
    mut x: i32 = 42;
    return &x;
}

function main() -> int { return 0; }
