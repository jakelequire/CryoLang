// E0455: returning the address of a function-body local hands back a
// pointer into the stack frame that is freed on return.  (Returning what a
// `&this` receiver or a reference parameter reaches is allowed - that is the
// caller's - so this must flag the body-local case specifically.)
![config(testing)]
![config(negative, E0455)]
namespace CryoTests::Negative::E0455ReturnLocalAddress;

function dangling() -> i32* {
    mut x: i32 = 42;
    return &x;   //~ ERROR[E0455] cannot return a reference to `x`, which is released when this function returns
}

function main() -> int { return 0; }
