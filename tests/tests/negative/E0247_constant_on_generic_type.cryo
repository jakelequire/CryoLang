// E0247: a generic type declares no constants, in its body or in a
// generic `implement` block.
![config(testing)]
![config(negative, E0247)]
namespace CryoTests::Negative::ConstantOnGenericType;

type struct Pair<T> {
    first: T;
    second: T;
    const COUNT: i32 = 2;   //~ ERROR[E0247] a generic type cannot declare constants, and `COUNT` is declared on one
}

type struct Holder<T> { value: T; }

implement<T> struct Holder<T> {
    const SLOTS: i32 = 1;   //~ ERROR[E0247] a generic type cannot declare constants, and `SLOTS` is declared on one
}

function main() -> int {
    return 0;
}
