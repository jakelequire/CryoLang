// E0306: `Rc` and the mutex / rwlock guards are never `Send`, whatever their
// fields are: `Rc`'s count is not atomic, and a lock must be released by the
// thread that took it.  Their fields alone (raw pointers, integers) would
// answer `Send`; the compiler denies these four by the identity each
// declaration claimed, so a user type merely named like one is unaffected
// (`lang/send_sync_auto_derive`).
![config(testing)]
![config(negative, E0306)]
namespace CryoTests::Negative::SendDeniedStdTypes;

import std::core::marker::{ Send };
import std::alloc::allocator::{ GlobalAlloc };
import std::sync::mutex::{ MutexGuard };
import std::sync::rwlock::{ RwLockReadGuard, RwLockWriteGuard };

function require_send<T>(v: T) -> i32 where T: Send { return 1; }

function rc(r: Rc<i32>) -> i32 {
    return require_send::<Rc<i32>>(r);
    //~^ ERROR[E0306] `std::alloc::rc::Rc<i32, std::alloc::allocator::GlobalAlloc>: Send` is not satisfied
}

function mutex_guard(g: MutexGuard<i32, GlobalAlloc>) -> i32 {
    return require_send::<MutexGuard<i32, GlobalAlloc>>(g);
    //~^ ERROR[E0306] `std::sync::mutex::MutexGuard<i32, std::alloc::allocator::GlobalAlloc>: Send` is not satisfied
}

function read_guard(g: RwLockReadGuard<i32, GlobalAlloc>) -> i32 {
    return require_send::<RwLockReadGuard<i32, GlobalAlloc>>(g);
    //~^ ERROR[E0306] `std::sync::rwlock::RwLockReadGuard<i32, std::alloc::allocator::GlobalAlloc>: Send` is not satisfied
}

function write_guard(g: RwLockWriteGuard<i32, GlobalAlloc>) -> i32 {
    return require_send::<RwLockWriteGuard<i32, GlobalAlloc>>(g);
    //~^ ERROR[E0306] `std::sync::rwlock::RwLockWriteGuard<i32, std::alloc::allocator::GlobalAlloc>: Send` is not satisfied
}

function main() -> int { return 0; }
