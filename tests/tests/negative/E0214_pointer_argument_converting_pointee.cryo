// A pointer argument binds a pointer or reference parameter only when it
// points at the same type (or `void` is on either side), never at a type that
// merely converts to the parameter's pointee: an `i32` converts to an `i64`,
// but the memory an `i32*` addresses holds four bytes, and a callee reading an
// `i64` through it reads past the value.  Refused at every kind of call, a
// value bound to a pointer parameter by its address included.
![config(testing)]
![config(negative, E0214)]
namespace CryoTests::Negative::PointerArgumentConvertingPointee;

type struct PcS {
    v: i64;
    wide_method(&this, p: i64*) -> i64 { return *p; }
    wide_ref(&this, p: &i64) -> i64 { return *p; }
    static wide_static(p: i64*) -> i64 { return *p; }
}

function pc_wide(p: i64*) -> i64 { return *p; }

function pc_wide_generic<T>(t: T, p: i64*) -> i64 { return *p; }

function pc_wide_double(p: f64*) -> f64 { return *p; }

function pc_wide_twice(p: i64**) -> i64 { return **p; }

function pc_erased_twice(p: void**) -> i64 { return 0; }

function main() -> int {
    mut n: i32 = 3;
    mut q: i32* = &n;
    const qq: i32** = &q;
    mut f: f32 = 1.5;
    const fp: f32* = &f;
    const s: PcS = PcS { v: 0 };
    const r1: i64 = pc_wide(q);                                                    //~ ERROR[E0214] mismatched types
    const r2: i64 = s.wide_method(q);                                              //~ ERROR[E0214] mismatched types
    const r3: i64 = s.wide_ref(q);                                                 //~ ERROR[E0214] mismatched types
    const r4: i64 = PcS::wide_static(q);                                           //~ ERROR[E0214] mismatched types
    const r5: i64 = CryoTests::Negative::PointerArgumentConvertingPointee::pc_wide(q); //~ ERROR[E0214] mismatched types
    const r6: i64 = pc_wide_generic(1, q);                                         //~ ERROR[E0214] mismatched types
    const r7: f64 = pc_wide_double(fp);                                         //~ ERROR[E0214] mismatched types
    const r8: i64 = pc_wide_twice(qq);                                             //~ ERROR[E0214] mismatched types
    const r9: i64 = pc_erased_twice(qq);                                           //~ ERROR[E0214] mismatched types
    const r10: i64 = pc_wide(n);                                                   //~ ERROR[E0214] mismatched types
    return (r1 + r2 + r3 + r4 + r5 + r6 + r7 as i64 + r8 + r9 + r10) as int;
}
