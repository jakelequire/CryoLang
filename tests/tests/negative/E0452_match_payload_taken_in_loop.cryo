// E0452: a match inside a loop that gives away its subject's payload gives
// the same payload away again on the next iteration - the second `consume`
// received storage the first had already freed.
![config(testing)]
![config(negative, E0452)]
namespace CryoTests::Negative::E0452MatchPayloadTakenInLoop;

import std::core::option;
import std::core::option::{ Option };

type struct Res {
    tag: i32;

    drop(mut &this) -> void { }
}

function consume(r: Res) -> void { }

function f(o: Option<Res>) -> void {
    mut i: i32 = 0;
    while (i < 2) {
        match (o) {
        //~^ ERROR[E0452] value 'o' moved inside a loop is used again on the next iteration
            Option::Some(x) => { consume(x); }
            Option::None    => { }
        }
        i = i + 1;
    }
}

function main() -> int { return 0; }
