// E0452: an arm that gives away the payload it bound has given away the
// subject's contents.  Using the subject after the match - here passing it
// on - released the payload a second time: `consume` freed it, then
// `consume_opt` freed the Option holding the same storage.
![config(testing)]
![config(negative, E0452)]
namespace CryoTests::Negative::E0452MatchSubjectUsedAfterPayloadTaken;

import std::core::option;
import std::core::option::{ Option };

type struct Res {
    tag: i32;

    drop(mut &this) -> void { }
}

function consume(r: Res) -> void { }

function consume_opt(o: Option<Res>) -> void { }

function f(o: Option<Res>) -> void {
    match (o) {
        Option::Some(x) => { consume(x); }
        Option::None    => { }
    }
    consume_opt(o);
    //~^ ERROR[E0452] use of moved value 'o'
}

function main() -> int { return 0; }
