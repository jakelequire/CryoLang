// Compile-fail test: a slice reference is the slice's two words, an
// aggregate holding no slice's address, so `as` makes no pointer from it.
![config(testing)]
![config(negative, E0208)]
namespace CryoTests::Negative::E0208SliceReferenceCast;

import std::core::slice::{ Slice };

function to_pointer(r: &Slice<i32>) -> i64 {
    const p: void* = r as void*;   //~ ERROR[E0208] cannot cast
    const q: i32* = r as i32*;   //~ ERROR[E0208] cannot cast
    return 0;
}

function main() -> int {
    return 0;
}
