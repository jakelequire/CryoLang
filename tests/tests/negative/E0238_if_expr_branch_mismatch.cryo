// E0238: the two branches of an `if` expression produce unrelated types
// (`i32` and `string`), so the expression has no single result type.
//
// Regression test for the missing branch-type agreement check: the resolver
// returned whichever branch happened to type first and never compared them,
// so arms of unrelated types reached codegen and the result was read at the
// wrong width (or, for a pointer/scalar pair, as the wrong representation
// entirely).  Compatible-but-not-identical arms (`i32` vs `i64`) and a
// diverging arm (`never`) must still be accepted; only a pair incompatible
// in BOTH directions reports.
![config(testing)]
![config(negative, E0238)]
namespace CryoTests::Negative::IfExprBranchMismatch;

function main() -> int {
    const c: boolean = true;
    const x = if (c) { 7 } else { "seven" };   //~ ERROR[E0238] mismatched types
    return 0;
}
