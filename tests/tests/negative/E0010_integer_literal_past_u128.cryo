// E0010: no integer type holds a literal past u128::MAX, so one is refused
// in every position rather than wrapped to its low 128 bits.
![config(testing)]
![config(negative, E0010)]
namespace CryoTests::Negative::E0010IntegerLiteralPastU128;

const BIG: u128 = 340282366920938463463374607431768211456;   //~ ERROR[E0010] integer literal `340282366920938463463374607431768211456` does not fit in 128 bits

function main() -> i32 {
    const local: i128 = 0x1_0000_0000_0000_0000_0000_0000_0000_0001;   //~ ERROR[E0010] integer literal `0x1_0000_0000_0000_0000_0000_0000_0000_0001` does not fit in 128 bits
    return (BIG as u64 + local as u64) as i32;
}
