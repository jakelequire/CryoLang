// E0358 / E0233: a path naming a member nothing declares is refused where
// the body is written, whether or not anything uses the body.  `T::missing()`
// and the value `T::missing` in a generic function nothing calls are E0358,
// as in one that is instantiated; `This::nonexistent()` in a trait default
// is E0233 at the trait, though no type implements the trait.
![config(testing)]
![config(negative, E0358)]
namespace CryoTests::Negative::ParamPathInUninstantiatedBody;

type trait Shape {
    static area() -> i64;
}

type trait Lone {
    static base() -> i64;
    static missing() -> i64 { return This::nonexistent(); }
    //~^ ERROR[E0233] cannot find `This::nonexistent`: no matching static method, variant, or type
}

function unused<T>() -> i64 where T: Shape {
    return T::perimeter();
    //~^ ERROR[E0358] no method named `perimeter` found on type `T`
}

function unused_value<T>() -> i64 where T: Shape {
    const _f = T::perimeter;
    //~^ ERROR[E0358] no method named `perimeter` found on type `T`
    return T::area();
}

function main() -> i32 {
    return 0;
}
