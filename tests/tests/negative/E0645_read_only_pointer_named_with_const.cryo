///! A type is named with its `const`: a read-only pointer prints as
///! `const T*`, and a read-only pointer whose pointee is itself a pointer
///! groups that pointee, `const (T*)*`, since an ungrouped `const` belongs to
///! the innermost pointer of the run.  A writable pointer to a read-only one
///! is the ungrouped `const T**`.

![config(testing)]
![config(negative, E0645)]
namespace CryoTests::Negative::E0645ReadOnlyPointerNamedWithConst;

type struct Item {
    value: i32;
}

function only_bytes<T>() -> i32 {
    return static match (T) {
    //~^ ERROR[E0645] no `static match` arm matches type `const CryoTests::Negative::E0645ReadOnlyPointerNamedWithConst::Item*`
    //~^^ ERROR[E0645] no `static match` arm matches type `const CryoTests::Negative::E0645ReadOnlyPointerNamedWithConst::Item**`
        u8 => { 1 }
    };
}

function only_bytes_behind<T>(p: const T*) -> i32 {
    return static match (const T*) {
    //~^ ERROR[E0645] no `static match` arm matches type `const (CryoTests::Negative::E0645ReadOnlyPointerNamedWithConst::Item*)*`
        u8 => { 1 }
    };
}

function main() -> int {
    mut item: Item = Item { value: 1 };
    const writable: Item* = &item;
    return only_bytes::<const Item*>() + only_bytes::<const Item**>() + only_bytes_behind::<Item*>(&writable);
}
