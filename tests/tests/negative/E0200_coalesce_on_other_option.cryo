// E0200: `opt ?? fallback` unwraps the language's `Option<T>`.  Its
// desugaring matches the subject against that enum's `Some` and `None`, so a
// subject of a program's own enum that happens to declare variants of those
// names is refused, rather than matched by the variant leaves alone.
![config(testing)]
![config(negative, E0200)]
namespace CryoTests::Negative::CoalesceOnOtherOption;

type enum Option {
    Some(i32);
    None;
}

function main() -> int {
    const a: Option = Option::Some(4);
    const v: Option = a ?? Option::Some(9);   //~ ERROR[E0200] pattern names enum `std::core::option::Option`, but the value matched is `CryoTests::Negative::CoalesceOnOtherOption::Option`
    return 0;
}
