///! A reference names a whole value, so none may be made to a local after a
///! field has been moved out of it: `&p`, an argument taken by reference
///! and a method's receiver alike.  A store through the reference releases
///! what it displaces, and the moved field would be released a second time.

![config(testing)]
![config(negative, E0452)]
namespace CryoTests::Negative::E0452ReferenceToPartiallyMovedValue;

type struct Owned {
    id: i64;
}

implement trait Drop for struct Owned {
    drop(mut &this) -> void { }
}

type struct Pair {
    first:  Owned;
    second: Owned;

    replace_first(mut &this, value: Owned) -> void { this.first = value; }
}

function consume(value: Owned) -> void { }

function replace_whole(place: mut &Pair) -> void {
    *place = Pair { first: Owned { id: 3 }, second: Owned { id: 4 } };
}

function second_of(pair: &Pair) -> i64 { return pair.second.id; }

function written_reference() -> void {
    mut pair: Pair = Pair { first: Owned { id: 1 }, second: Owned { id: 2 } };
    consume(pair.first);
    replace_whole(&pair);
    //~^ ERROR[E0452] reference to partially-moved value `pair`
}

function argument_taken_by_reference() -> i64 {
    mut pair: Pair = Pair { first: Owned { id: 1 }, second: Owned { id: 2 } };
    consume(pair.first);
    return second_of(pair);
    //~^ ERROR[E0452] reference to partially-moved value `pair`
}

function method_receiver() -> void {
    mut pair: Pair = Pair { first: Owned { id: 1 }, second: Owned { id: 2 } };
    consume(pair.first);
    pair.replace_first(Owned { id: 5 });
    //~^ ERROR[E0452] reference to partially-moved value `pair`
}

function main() -> i32 {
    return 0;
}
