// E0104: the pre-1.0 bracket tuple spelling `[T, U]` was removed in favour of
// the parenthesized form `(T, U)`.  A `[` in type position starts an array
// type, `[T]` or `[T; N]`; a `,` after its first type is the bracket tuple,
// reported at the `[`.  The parser then reads the group through its `]`, so
// the declaration parses on and nothing follows the one error.
![config(testing)]
![config(negative, E0104)]
namespace CryoTests::Negative::BracketTupleType;

function cf_f() -> [i32, i32] { return (1, 2); }
//~^ ERROR[E0104] bracket tuple types '[T, U]' are no longer supported; use '(T, U)'

function main() -> int { return 0; }
