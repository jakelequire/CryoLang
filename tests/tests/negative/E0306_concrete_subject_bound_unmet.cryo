// E0306: a `where` bound written on a type that is not a parameter is an
// assumption the body is typed by, and a call is refused where it is
// written when the type its arguments select has no implementation at the
// bound's arguments: `CfHighError` implements `From<CfLowError>`, not
// `From<CfOtherError>`.  Named with the trait's arguments, since the trait
// alone is implemented.
![config(testing)]
![config(negative, E0306)]
namespace CryoTests::Negative::E0306ConcreteSubjectBoundUnmet;

import std::core::convert::{ From };

type enum CfLowError { Bad; }
type enum CfOtherError { Other; }
type enum CfHighError { Low; }

implement trait From<CfLowError> for enum CfHighError {
    static from(value: CfLowError) -> CfHighError { return CfHighError::Low; }
}

function cf_convert<E>(error: E) -> CfHighError where CfHighError: From<E> {
    return CfHighError::from(error);
}

function main() -> int {
    const fine: CfHighError = cf_convert(CfLowError::Bad);
    const refused: CfHighError = cf_convert(CfOtherError::Other);   //~ ERROR[E0306] the trait bound `CryoTests::Negative::E0306ConcreteSubjectBoundUnmet::CfHighError: From<CryoTests::Negative::E0306ConcreteSubjectBoundUnmet::CfOtherError>` is not satisfied
    return 0;
}
