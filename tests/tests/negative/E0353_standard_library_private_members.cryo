// E0353: the heap is public as the allocator `NativeHeap`, while the raw
// calls behind it are internal to the standard library; and the storage
// helpers `Array`, `HashMap` and `Pool` grow by are private to their own
// modules, behind the public `reserve` and the allocation calls.
![config(testing)]
![config(negative, E0353)]
namespace CryoTests::Negative::E0353StandardLibraryPrivateMembers;

import std::alloc::heap::{ NativeHeap };
import std::collections::array::{ Array };
import std::collections::hashmap::{ HashMap };
import std::alloc::layout::{ Layout };
import std::alloc::pool::{ Pool };

function main() -> int {
    const named: NativeHeap = NativeHeap::new();
    const block: void* = heap::alloc(64, 16);
    //~^ ERROR[E0353] `std::alloc::heap::alloc` is internal and cannot be called
    heap::free(block);
    //~^ ERROR[E0353] `std::alloc::heap::free` is internal and cannot be called

    mut numbers: Array<i64> = Array::<i64>::new();
    const grown: boolean = numbers.reserve_grow(4).is_ok();
    //~^ ERROR[E0353] method `reserve_grow` of `std::collections::array::Array` is private
    const resized: boolean = numbers.resize_storage(8).is_ok();
    //~^ ERROR[E0353] method `resize_storage` of `std::collections::array::Array` is private

    mut table: HashMap<i64, i64> = HashMap::<i64, i64>::new();
    const rehashed: boolean = table.resize_buckets(16).is_ok();
    //~^ ERROR[E0353] method `resize_buckets` of `std::collections::hashmap::HashMap` is private

    mut slots: Pool = Pool::new(Layout::of::<i64>());
    const carved: boolean = pool::grow(slots).is_ok();
    //~^ ERROR[E0353] `std::alloc::pool::grow` is private and cannot be called
    return 0;
}
