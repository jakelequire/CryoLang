// E0353: the heap is public as the allocator `NativeHeap`, while the raw
// calls behind it are internal to the standard library; and the storage
// helpers `Array`, `HashMap` and `Pool` grow by are private to their own
// modules, behind the public `reserve` and the allocation calls.  A
// `Layout`'s size and alignment are read through its accessors, and one is
// made only by its constructors, which check the alignment.  A `Box` is made
// by its constructors and `from_raw`/`from_raw_in`, and its pointer read
// through `as_ptr`; the handles of `Rc`, `Arc`, `Arena` and `Pool` keep their
// state private, the growth curve collections share is internal, and the
// allocator's platform calls, the arena's routing slot and the pool's free
// list types are private to their modules.
![config(testing)]
![config(negative, E0353)]
namespace CryoTests::Negative::E0353StandardLibraryPrivateMembers;

import std::alloc::heap::{ NativeHeap };
import std::collections::array::{ Array };
import std::collections::hashmap::{ HashMap };
import std::alloc::layout::{ Layout };
import std::alloc::pool::{ Pool, FreeNode };
//~^ ERROR[E0353] `std::alloc::pool::FreeNode` is private and cannot be imported
import std::alloc::box::{ Box };
import std::alloc::rc::{ Rc };
import std::alloc::arc::{ Arc };
import std::alloc::arena::{ Arena };
import std::alloc::allocator::{ GlobalAlloc };
import std::collections::str::{ Str };
import std::encoding::base64;
import std::encoding::sha1;

function main() -> int {
    const named: NativeHeap = NativeHeap::new();
    const block: void* = heap::alloc(64, 16);
    //~^ ERROR[E0353] `std::alloc::heap::alloc` is internal and cannot be called
    heap::free(block);
    //~^ ERROR[E0353] `std::alloc::heap::free` is internal and cannot be called

    mut numbers: Array<i64> = Array::<i64>::new();
    const grown: boolean = numbers.reserve_grow(4).is_ok();
    //~^ ERROR[E0353] method `reserve_grow` of `std::collections::array::Array` is private
    const resized: boolean = numbers.resize_storage(8).is_ok();
    //~^ ERROR[E0353] method `resize_storage` of `std::collections::array::Array` is private

    mut table: HashMap<i64, i64> = HashMap::<i64, i64>::new();
    const rehashed: boolean = table.resize_buckets(16).is_ok();
    //~^ ERROR[E0353] method `resize_buckets` of `std::collections::hashmap::HashMap` is private

    mut slots: Pool = Pool::new(Layout::of::<i64>());
    const carved: boolean = pool::grow(slots).is_ok();
    //~^ ERROR[E0353] `std::alloc::pool::grow` is private and cannot be called

    const block_layout: Layout = Layout::of::<i64>();
    const bytes: u64 = block_layout.size;
    //~^ ERROR[E0353] field `size` of `std::alloc::layout::Layout` is private
    const forged: Layout = Layout { size: 8, alignment: 3 };
    //~^ ERROR[E0353] field `size` of `std::alloc::layout::Layout` is private
    //~^^ ERROR[E0353] field `alignment` of `std::alloc::layout::Layout` is private

    const boxed: Box<i64> = Box::new(5);
    const held: i64* = boxed.ptr;
    //~^ ERROR[E0353] field `ptr` of `std::alloc::box::Box` is private
    const owner: GlobalAlloc = boxed.alloc;
    //~^ ERROR[E0353] field `alloc` of `std::alloc::box::Box` is private
    const rebuilt: Box<i64> = Box::<i64, GlobalAlloc> { ptr: held, alloc: GlobalAlloc::new() };
    //~^ ERROR[E0353] field `ptr` of `std::alloc::box::Box` is private
    //~^^ ERROR[E0353] field `alloc` of `std::alloc::box::Box` is private

    const next_size: i64 = allocator::next_capacity(1, 9, 4);
    //~^ ERROR[E0353] `std::alloc::allocator::next_capacity` is internal and cannot be called
    const platform: void* = allocator::backend_alloc(Layout::of::<i64>());
    //~^ ERROR[E0353] `std::alloc::allocator::backend_alloc` is private and cannot be called
    const ceiling: u64 = allocator::MAX_REALLOC_ALIGN;
    //~^ ERROR[E0353] `std::alloc::allocator::MAX_REALLOC_ALIGN` is private and cannot be named

    const counted: Rc<i64> = Rc::new(3);
    const counted_header: u64 = counted.inner as u64;
    //~^ ERROR[E0353] field `inner` of `std::alloc::rc::Rc` is private
    const shared: Arc<i64> = Arc::new(4);
    const shared_header: u64 = shared.inner as u64;
    //~^ ERROR[E0353] field `inner` of `std::alloc::arc::Arc` is private

    const region: Arena = Arena::new();
    const chunk_bytes: u64 = region.chunk_size;
    //~^ ERROR[E0353] field `chunk_size` of `std::alloc::arena::Arena` is private
    const routed: u64 = arena::g_alloc_arena as u64;
    //~^ ERROR[E0353] `std::alloc::arena::g_alloc_arena` is private and cannot be named
    const free_slots: u64 = slots.free_list as u64;
    //~^ ERROR[E0353] field `free_list` of `std::alloc::pool::Pool` is private

    const padding: u8 = base64::PAD;
    //~^ ERROR[E0353] `std::encoding::base64::PAD` is private and cannot be named
    const symbol: u8 = base64::sym(Str::new("AB"), 1);
    //~^ ERROR[E0353] `std::encoding::base64::sym` is private and cannot be called
    const decoded: boolean = base64::decode_sym(65).is_some();
    //~^ ERROR[E0353] `std::encoding::base64::decode_sym` is private and cannot be called
    const first_byte: u8 = base64::byte_at(Str::new("A"), 0);
    //~^ ERROR[E0353] `std::encoding::base64::byte_at` is private and cannot be called
    const rotated: u32 = sha1::rotl32(1, 3);
    //~^ ERROR[E0353] `std::encoding::sha1::rotl32` is private and cannot be called
    mut digest: [u8; 20] = [0; 20];
    sha1::store_be32(&digest[0], 0, 7);
    //~^ ERROR[E0353] `std::encoding::sha1::store_be32` is private and cannot be called
    return 0;
}
