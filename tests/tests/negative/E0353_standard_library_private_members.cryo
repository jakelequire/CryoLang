// E0353: the heap is public as the allocator `NativeHeap`, while the raw
// calls behind it are internal to the standard library; and the storage
// helpers `Array`, `HashMap` and `Pool` grow by are private to their own
// modules, behind the public `reserve` and the allocation calls.  A
// `Layout`'s size and alignment are read through its accessors, and one is
// made only by its constructors, which check the alignment.  A `Box` is made
// by its constructors and `from_raw`/`from_raw_in`, and its pointer read
// through `as_ptr`; the handles of `Rc`, `Arc`, `Arena` and `Pool` keep their
// state private, `Arc`'s shared block and the step from a raw value pointer
// back to it are private, the growth curve collections share is internal, and the
// allocator's platform calls, the arena's routing slot and the pool's free
// list types are private to their modules.  The global arena's routing
// calls are internal, the arena's and pool's default sizes public, and the
// unwind runtime's hooks private to the module that reads them.  A
// `Duration`, an `Instant` and a `SystemTime` are read through their
// accessors, and the clocks' conversion constants are private; the units
// `datetime` splits a day by are private to it, and public on `Duration`.
// The network layer's per-OS shims are public but for their own helpers,
// a resolver's addresses and a status code are read through accessors, and
// the URL parser's bytes and steps and the router's route table are private.
![config(testing)]
![config(negative, E0353)]
namespace CryoTests::Negative::E0353StandardLibraryPrivateMembers;

import std::alloc::heap::{ NativeHeap };
import std::collections::array::{ Array };
import std::collections::hashmap::{ HashMap };
import std::alloc::layout::{ Layout };
import std::alloc::pool::{ Pool, FreeNode };
//~^ ERROR[E0353] `std::alloc::pool::FreeNode` is private and cannot be imported
import std::alloc::box::{ Box };
import std::alloc::rc::{ Rc };
import std::alloc::arc::{ Arc, ArcInner };
//~^ ERROR[E0353] `std::alloc::arc::ArcInner` is private and cannot be imported
import std::alloc::arena::{ Arena, GlobalArena };
import std::core::panic_unwind;
import std::time::duration::{ Duration };
import std::time::clock::{ Instant, SystemTime };
import std::time::datetime;
import std::alloc::allocator::{ GlobalAlloc };
import std::collections::str::{ Str };
import std::encoding::base64;
import std::encoding::sha1;
import std::net::sys;
import std::net::addr::url;
import std::net::addr::url::{ Url };
import std::net::dns::{ ResolvedAddrs };
import std::net::http::status::{ StatusCode };
import std::net::http::router::{ Router, Route };
//~^ ERROR[E0353] `std::net::http::router::Route` is private and cannot be imported
import std::net::http::headers::{ Headers };
import std::net::http2::frame as h2_frame;
import std::net::http2::connection;
import std::net::socket::udp;
import std::net::socket::tcp::{ TcpStream };
import std::net::tls::context;
import std::net::tls::future as tls_future;
import std::net::ws::conn as ws_conn;
import std::net::ws::frame as ws_frame;
import std::net::ws::frame::{ OpCode };

function count_addresses(found: &ResolvedAddrs) -> i64 {
    return found.addrs.length();
    //~^ ERROR[E0353] field `addrs` of `std::net::dns::ResolvedAddrs` is private
}

function main() -> int {
    const named: NativeHeap = NativeHeap::new();
    const block: void* = heap::alloc(64, 16);
    //~^ ERROR[E0353] `std::alloc::heap::alloc` is internal and cannot be called
    heap::free(block);
    //~^ ERROR[E0353] `std::alloc::heap::free` is internal and cannot be called

    mut numbers: Array<i64> = Array::<i64>::new();
    const grown: boolean = numbers.reserve_grow(4).is_ok();
    //~^ ERROR[E0353] method `reserve_grow` of `std::collections::array::Array` is private
    const resized: boolean = numbers.resize_storage(8).is_ok();
    //~^ ERROR[E0353] method `resize_storage` of `std::collections::array::Array` is private

    mut table: HashMap<i64, i64> = HashMap::<i64, i64>::new();
    const rehashed: boolean = table.resize_buckets(16).is_ok();
    //~^ ERROR[E0353] method `resize_buckets` of `std::collections::hashmap::HashMap` is private

    mut slots: Pool = Pool::new(Layout::of::<i64>());
    const carved: boolean = pool::grow(slots).is_ok();
    //~^ ERROR[E0353] `std::alloc::pool::grow` is private and cannot be called

    const block_layout: Layout = Layout::of::<i64>();
    const bytes: u64 = block_layout.size;
    //~^ ERROR[E0353] field `size` of `std::alloc::layout::Layout` is private
    const forged: Layout = Layout { size: 8, alignment: 3 };
    //~^ ERROR[E0353] field `size` of `std::alloc::layout::Layout` is private
    //~^^ ERROR[E0353] field `alignment` of `std::alloc::layout::Layout` is private

    const boxed: Box<i64> = Box::new(5);
    const held: i64* = boxed.ptr;
    //~^ ERROR[E0353] field `ptr` of `std::alloc::box::Box` is private
    const owner: GlobalAlloc = boxed.alloc;
    //~^ ERROR[E0353] field `alloc` of `std::alloc::box::Box` is private
    const rebuilt: Box<i64> = Box::<i64, GlobalAlloc> { ptr: held, alloc: GlobalAlloc::new() };
    //~^ ERROR[E0353] field `ptr` of `std::alloc::box::Box` is private
    //~^^ ERROR[E0353] field `alloc` of `std::alloc::box::Box` is private

    const next_size: i64 = allocator::next_capacity(1, 9, 4);
    //~^ ERROR[E0353] `std::alloc::allocator::next_capacity` is internal and cannot be called
    const platform: void* = allocator::backend_alloc(Layout::of::<i64>());
    //~^ ERROR[E0353] `std::alloc::allocator::backend_alloc` is private and cannot be called
    const ceiling: u64 = allocator::MAX_REALLOC_ALIGN;
    //~^ ERROR[E0353] `std::alloc::allocator::MAX_REALLOC_ALIGN` is private and cannot be named

    const counted: Rc<i64> = Rc::new(3);
    const counted_header: u64 = counted.inner as u64;
    //~^ ERROR[E0353] field `inner` of `std::alloc::rc::Rc` is private
    const shared: Arc<i64> = Arc::new(4);
    const shared_header: u64 = shared.inner as u64;
    //~^ ERROR[E0353] field `inner` of `std::alloc::arc::Arc` is private
    const value_start: u64 = Arc::<i64>::value_offset();
    //~^ ERROR[E0353] method `value_offset` of `std::alloc::arc::Arc` is private
    const shared_value: i64* = shared.as_ptr();
    const shared_block: u64 = Arc::<i64>::block_of(shared_value) as u64;
    //~^ ERROR[E0353] method `block_of` of `std::alloc::arc::Arc` is private

    const region: Arena = Arena::new();
    const chunk_bytes: u64 = region.chunk_size;
    //~^ ERROR[E0353] field `chunk_size` of `std::alloc::arena::Arena` is private
    const routed: u64 = arena::g_alloc_arena as u64;
    //~^ ERROR[E0353] `std::alloc::arena::g_alloc_arena` is private and cannot be named
    const free_slots: u64 = slots.free_list as u64;
    //~^ ERROR[E0353] field `free_list` of `std::alloc::pool::Pool` is private
    const arena_routes: boolean = GlobalArena::routing();
    //~^ ERROR[E0353] method `routing` of `std::alloc::arena::GlobalArena` is internal
    const arena_block: void* = GlobalArena::take(8, 8);
    //~^ ERROR[E0353] method `take` of `std::alloc::arena::GlobalArena` is internal
    const arena_holds: boolean = GlobalArena::holds(arena_block);
    //~^ ERROR[E0353] method `holds` of `std::alloc::arena::GlobalArena` is internal
    const arena_grown: void* = GlobalArena::grow(arena_block, 8, 16, 8);
    //~^ ERROR[E0353] method `grow` of `std::alloc::arena::GlobalArena` is internal
    const default_chunk: u64 = arena::DEFAULT_CHUNK_SIZE;
    const default_slots: u64 = pool::DEFAULT_SLOTS_PER_BLOCK;
    const taken_line: u32 = panic_unwind::__cryo_panic_taken_line();
    //~^ ERROR[E0353] `std::core::panic_unwind::__cryo_panic_taken_line` is private and cannot be called

    const span: Duration = Duration::from_millis(1500);
    const whole: u64 = span.secs;
    //~^ ERROR[E0353] field `secs` of `std::time::duration::Duration` is private
    const fraction: u32 = span.nanos;
    //~^ ERROR[E0353] field `nanos` of `std::time::duration::Duration` is private
    const start: Instant = Instant::now();
    const raw_start: i64 = start.secs;
    //~^ ERROR[E0353] field `secs` of `std::time::clock::Instant` is private
    const wall: SystemTime = SystemTime::now();
    const raw_wall: i64 = wall.nanos;
    //~^ ERROR[E0353] field `nanos` of `std::time::clock::SystemTime` is private
    const per_second: i64 = clock::NSEC_PER_SEC;
    //~^ ERROR[E0353] `std::time::clock::NSEC_PER_SEC` is private and cannot be named
    const epoch_ticks: i64 = clock::FILETIME_TO_UNIX_TICKS;
    //~^ ERROR[E0353] `std::time::clock::FILETIME_TO_UNIX_TICKS` is private and cannot be named
    const shift: i64 = datetime::DAYS_SHIFT;
    //~^ ERROR[E0353] `std::time::datetime::DAYS_SHIFT` is private and cannot be named
    const day: i64 = datetime::SECS_PER_DAY;
    //~^ ERROR[E0353] `std::time::datetime::SECS_PER_DAY` is private and cannot be named
    const public_day: u64 = Duration::SECS_PER_DAY;

    const padding: u8 = base64::PAD;
    //~^ ERROR[E0353] `std::encoding::base64::PAD` is private and cannot be named
    const symbol: u8 = base64::sym(Str::new("AB"), 1);
    //~^ ERROR[E0353] `std::encoding::base64::sym` is private and cannot be called
    const decoded: boolean = base64::decode_sym(65).is_some();
    //~^ ERROR[E0353] `std::encoding::base64::decode_sym` is private and cannot be called
    const first_byte: u8 = base64::byte_at(Str::new("A"), 0);
    //~^ ERROR[E0353] `std::encoding::base64::byte_at` is private and cannot be called
    const rotated: u32 = sha1::rotl32(1, 3);
    //~^ ERROR[E0353] `std::encoding::sha1::rotl32` is private and cannot be called
    mut digest: [u8; 20] = [0; 20];
    sha1::store_be32(&digest[0], 0, 7);
    //~^ ERROR[E0353] `std::encoding::sha1::store_be32` is private and cannot be called

    const open_socket: i32 = sys::os_socket_tcp();
    const colon: u8 = url::COLON;
    //~^ ERROR[E0353] `std::net::addr::url::COLON` is private and cannot be named
    const port_ok: boolean = Url::parse_port(Str::new("80")).is_ok();
    //~^ ERROR[E0353] method `parse_port` of `std::net::addr::url::Url` is private
    const status: StatusCode = StatusCode::ok();
    const status_number: u16 = status.code;
    //~^ ERROR[E0353] field `code` of `std::net::http::status::StatusCode` is private
    const routes: Router = Router::new();
    const route_count: i64 = routes.routes.length();
    //~^ ERROR[E0353] field `routes` of `std::net::http::router::Router` is private

    const headers: Headers = Headers::new();
    const header_count: i64 = headers.inner.length();
    //~^ ERROR[E0353] field `inner` of `std::net::http::headers::Headers` is private
    const frame_cap: i64 = h2_frame::MAX_FRAME_PAYLOAD;
    //~^ ERROR[E0353] `std::net::http2::frame::MAX_FRAME_PAYLOAD` is private and cannot be named
    const body_cap: i64 = connection::LOCAL_MAX_BODY_SIZE;
    //~^ ERROR[E0353] `std::net::http2::connection::LOCAL_MAX_BODY_SIZE` is private and cannot be named
    const skippable: boolean = connection::is_skippable(Str::new("host"));
    //~^ ERROR[E0353] `std::net::http2::connection::is_skippable` is private and cannot be called
    const datagram: boolean = udp::open_dgram().is_ok();
    //~^ ERROR[E0353] `std::net::socket::udp::open_dgram` is private and cannot be called
    const stream: TcpStream = TcpStream::from_fd(-1);
    const descriptor: i32 = stream.fd;
    //~^ ERROR[E0353] field `fd` of `std::net::socket::tcp::TcpStream` is private
    context::ignore_sigpipe();
    //~^ ERROR[E0353] `std::net::tls::context::ignore_sigpipe` is private and cannot be called
    const tls_failure: Str = tls_future::ssl_error(1).describe();
    //~^ ERROR[E0353] `std::net::tls::future::ssl_error` is private and cannot be called
    const message_cap: i64 = ws_conn::MAX_MESSAGE;
    //~^ ERROR[E0353] `std::net::ws::conn::MAX_MESSAGE` is private and cannot be named
    const opcode_byte: u8 = ws_frame::op_to_u8(OpCode::Text);
    //~^ ERROR[E0353] `std::net::ws::frame::op_to_u8` is private and cannot be called
    return 0;
}
