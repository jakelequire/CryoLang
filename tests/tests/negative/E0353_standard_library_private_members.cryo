function reach_locks_and_generators() -> u64 {
    const lock: Mutex<i64> = Mutex::new(1);
    const backing: u64 = lock.inner as u64;
    //~^ ERROR[E0353] field `inner` of `std::sync::mutex::Mutex` is private
    const raw_lock: u8* = lock.raw_pthread_buf();
    //~^ ERROR[E0353] method `raw_pthread_buf` of `std::sync::mutex::Mutex` is internal
    const generator: Rng = Rng::from_seed(7);
    const word: u64 = generator.s0;
    //~^ ERROR[E0353] field `s0` of `std::random::rng::Rng` is private
    const coin: Bernoulli = Bernoulli::new(0.5);
    const odds: f64 = coin.p;
    //~^ ERROR[E0353] field `p` of `std::random::distribution::Bernoulli` is private
    return word;
}

