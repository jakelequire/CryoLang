// E0312: `Allocate::allocate` hands `new` the storage it writes the value
// into, so it returns a writable pointer.  An implementation returning a
// read-only one disagrees with the trait and is refused where it is written;
// one returning `mut void*` is accepted.
![config(testing)]
![config(negative, E0312)]
namespace CryoTests::Negative::AllocateReturnsAWritablePointer;

import std::ffi::libc;

type struct ReadOnly { value: i32; }

implement trait Allocate for struct ReadOnly {
    static allocate(size: u64, align: u64) -> void* {  //~ ERROR[E0312] `allocate` returns `mut void*` in trait `Allocate`, but `void*` here
        return libc::malloc(size);
    }
}

type struct Writable { value: i32; }

implement trait Allocate for struct Writable {
    static allocate(size: u64, align: u64) -> mut void* {
        return libc::malloc(size);
    }
}

function main() -> int {
    const p: Writable* = new Writable { value: 1 };
    return p.value - 1;
}
