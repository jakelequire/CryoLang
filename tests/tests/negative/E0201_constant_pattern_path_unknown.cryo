// E0201: a path in a pattern whose leading segments name a module names one
// of that module's values, and a leaf the module does not declare is
// refused where the pattern is written.
![config(testing)]
![config(negative, E0201)]
namespace CryoTests::Negative::E0201ConstantPatternPathUnknown;

import std::collections::str;

function classify(scalar: u32) -> i32 {
    return match (scalar) {
        str::NO_SUCH_CONSTANT => { 1 }
        //~^ ERROR[E0201] cannot find value `str::NO_SUCH_CONSTANT` in this scope
        _ => { 0 }
    };
}

function main() -> int {
    return classify(3);
}
