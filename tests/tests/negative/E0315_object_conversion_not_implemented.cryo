// E0315: a value becomes a trait object only through its type's
// implementation of the trait, whose table the object carries.  A type that
// does not implement the trait has no table, at any site that converts.
![config(testing)]
![config(negative, E0315)]
namespace CryoTests::Negative::ObjectConversionNotImplemented;

type trait Shape {
    area(&this) -> i32;
}

type struct Square {
    side: i32;
}

function takes(s: virtual &Shape) -> i32 { return 1; }

function main() -> int {
    const q: Square = Square { side: 3 };
    const s: virtual &Shape = &q;
    //~^ ERROR[E0315] `CryoTests::Negative::ObjectConversionNotImplemented::Square` does not implement `CryoTests::Negative::ObjectConversionNotImplemented::Shape`, so `&CryoTests::Negative::ObjectConversionNotImplemented::Square` cannot become `virtual &CryoTests::Negative::ObjectConversionNotImplemented::Shape`
    return takes(&q);
    //~^ ERROR[E0315] `CryoTests::Negative::ObjectConversionNotImplemented::Square` does not implement `CryoTests::Negative::ObjectConversionNotImplemented::Shape`, so `&CryoTests::Negative::ObjectConversionNotImplemented::Square` cannot become `virtual &CryoTests::Negative::ObjectConversionNotImplemented::Shape`
}
