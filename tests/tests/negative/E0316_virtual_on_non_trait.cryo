// E0316: `virtual` makes an object of a trait; written on a struct, a
// primitive or a type parameter it names no table of methods.
![config(testing)]
![config(negative, E0316)]
namespace CryoTests::Negative::VirtualOnNonTrait;

type trait Shape {
    area(&this) -> i32;
}

type struct Circle { r: i32; }

function on_struct(s: virtual &Circle) -> i32 { return 1; }
//~^ ERROR[E0316] `Circle` is not a trait, so `virtual &Circle` is not a trait object
function on_primitive(s: virtual i32*) -> i32 { return 2; }
//~^ ERROR[E0316] `i32` is not a trait, so `virtual i32*` is not a trait object
function on_parameter<T>(s: virtual mut &T) -> i32 { return 3; }
//~^ ERROR[E0316] `T` is not a trait, so `virtual mut &T` is not a trait object
function on_trait(s: virtual &Shape) -> i32 { return 4; }

function main() -> int {
    return 0;
}
