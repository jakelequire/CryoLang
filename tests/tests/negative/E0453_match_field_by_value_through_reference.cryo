// E0453: a `match` on a field reached through a reference or pointer, by
// value, gives the match's subject its own copy of the field's owning handle
// and releases it when the match ends, while the storage the field is in
// still holds it and releases it again.  It is refused whether or not an arm
// binds the payload, through `&`, `mut &`, a pointer, a nested field and a
// `&this` receiver alike.  Match on a borrow of the field (`match (&h.slot)`).
// The controls compile: the borrowed match, a match on an owned local, and a
// field with no destructor.
![config(testing)]
![config(negative, E0453)]
namespace CryoTests::Negative::MatchFieldByValueThroughReference;

import std::core::option::{ Option };
import std::collections::string::{ String };

type struct Holder { slot: Option<String>; count: Option<i64>; }
type struct Nest { inner: Holder; }

type struct Owner {
    slot: Option<String>;

    length_of_slot(&this) -> i64 {
        match (this.slot) {
        //~^ ERROR[E0453] cannot match field `slot` by value through a pointer or reference
            Option::Some(text) => { return text.length(); }
            Option::None       => { return 0; }
        }
    }
}

function through_reference(h: &Holder) -> i64 {
    match (h.slot) {
    //~^ ERROR[E0453] cannot match field `slot` by value through a pointer or reference
        Option::Some(text) => { return text.length(); }
        Option::None       => { return 0; }
    }
}

function wildcard_through_reference(h: &Holder) -> boolean {
    match (h.slot) {
    //~^ ERROR[E0453] cannot match field `slot` by value through a pointer or reference
        Option::Some(_) => { return true; }
        Option::None    => { return false; }
    }
}

function through_writable_reference(h: mut &Holder) -> i64 {
    match (h.slot) {
    //~^ ERROR[E0453] cannot match field `slot` by value through a pointer or reference
        Option::Some(text) => { return text.length(); }
        Option::None       => { return 0; }
    }
}

function through_pointer(h: Holder*) -> i64 {
    match (h.slot) {
    //~^ ERROR[E0453] cannot match field `slot` by value through a pointer or reference
        Option::Some(text) => { return text.length(); }
        Option::None       => { return 0; }
    }
}

function nested_through_reference(n: &Nest) -> i64 {
    match (n.inner.slot) {
    //~^ ERROR[E0453] cannot match field `slot` by value through a pointer or reference
        Option::Some(text) => { return text.length(); }
        Option::None       => { return 0; }
    }
}

function expression_through_reference(h: &Holder) -> i64 {
    return match (h.slot) {
    //~^ ERROR[E0453] cannot match field `slot` by value through a pointer or reference
        Option::Some(text) => { text.length() }
        Option::None       => { 0 }
    };
}

function borrowed_control(h: &Holder) -> i64 {
    match (&h.slot) {
        Option::Some(text) => { return text.length(); }
        Option::None       => { return 0; }
    }
}

function owned_local_control() -> i64 {
    const slot: Option<String> = Option::None;
    match (slot) {
        Option::Some(text) => { return text.length(); }
        Option::None       => { return 0; }
    }
}

function no_destructor_control(h: &Holder) -> i64 {
    match (h.count) {
        Option::Some(n) => { return n; }
        Option::None    => { return 0; }
    }
}

function main() -> i32 { return 0; }
