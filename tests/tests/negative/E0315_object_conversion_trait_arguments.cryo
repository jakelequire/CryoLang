// E0315: a value converts to an object of a trait with arguments only when
// its type implements the trait at those arguments: its implementation's
// trait arguments, and the associated types it binds in the head or the
// body.
![config(testing)]
![config(negative, E0315)]
namespace CryoTests::Negative::ObjectConversionTraitArguments;

type trait Conv<T> {
    convert(&this) -> T;
}

type trait Pick {
    type Out;
    pick(&this, a: This::Out) -> This::Out;
}

type struct Square {
    side: i64;
}

implement trait Conv<i64> for Square {
    convert(&this) -> i64 { return this.side; }
}

implement trait Pick for Square {
    type Out = i64;
    pick(&this, a: i64) -> i64 { return a; }
}

function main() -> int {
    const q: Square = Square { side: 4 };
    const c: virtual &Conv<i32> = &q;
    //~^ ERROR[E0315] `CryoTests::Negative::ObjectConversionTraitArguments::Square` does not implement `CryoTests::Negative::ObjectConversionTraitArguments::Conv<i32>`, so `&CryoTests::Negative::ObjectConversionTraitArguments::Square` cannot become `virtual &CryoTests::Negative::ObjectConversionTraitArguments::Conv<i32>`
    const p: virtual &Pick<boolean> = &q;
    //~^ ERROR[E0315] `CryoTests::Negative::ObjectConversionTraitArguments::Square` does not implement `CryoTests::Negative::ObjectConversionTraitArguments::Pick<boolean>`, so `&CryoTests::Negative::ObjectConversionTraitArguments::Square` cannot become `virtual &CryoTests::Negative::ObjectConversionTraitArguments::Pick<boolean>`
    return 0;
}
