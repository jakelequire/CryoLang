// E0205: a type's constant shares its name with no other member of the
// type: another constant, a field, a method in any `implement` block, or an
// enum variant.  A field named by the keyword `const` is still a field.
![config(testing)]
![config(negative, E0205)]
namespace CryoTests::Negative::ConstantMemberClash;

type struct Point {
    x: i32;
    y: i32;
    const x: i32 = 1;        //~ ERROR[E0205] the constant `x` has the name of a field of
    const ORIGIN: i32 = 0;
    const ORIGIN: i32 = 1;   //~ ERROR[E0205] the constant `ORIGIN` is declared twice on this type
    const make: i32 = 2;     //~ ERROR[E0205] the constant `make` has the name of a method of
    static make() -> Point { return Point { x: 0, y: 0 }; }
}

implement struct Point {
    const shifted: i32 = 3;  //~ ERROR[E0205] the constant `shifted` has the name of a method of
}

implement struct Point {
    shifted(&this) -> i32 { return this.x; }
}

type enum Level { Quiet; Loud; }

implement enum Level {
    const Quiet: i32 = 0;    //~ ERROR[E0205] the constant `Quiet` has the name of a variant of
}

type struct Plain {
    const: i32;
    width: i32;
}

function main() -> int {
    const p: Plain = Plain { const: 1, width: 2 };
    return p.const - 1;
}
