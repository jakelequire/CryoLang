// E0151: `![json(...)]` adjusts a field's member in a derived JSON form,
// so it is refused anywhere but on a field.  The same directive on a field
// is the control.
![config(testing)]
![config(negative, E0151)]
namespace CryoTests::Negative::E0151JsonDirectiveOnType;

import std::json::convert::{ FromJson, ToJson };

![json(skip)]   //~ ERROR[E0151] directive `![json]` only applies to field, not struct
type struct JtOnType with [ToJson, FromJson] {
    x: i64;
}

type struct JtOnField with [ToJson, FromJson] {
    ![json(skip)]
    x: i64;
}

function main() -> i32 {
    return 0;
}
