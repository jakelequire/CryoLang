// E0104: the parentheses after `const` group one pointer level, so a group of
// anything that is not a pointer type is refused - a read-only pointer to it
// is written without them, `const u8*`.  Refused in a written type and in an
// `as` target alike.
![config(testing)]
![config(negative, E0104)]
namespace CryoTests::Negative::ReadOnlyGroupNotAPointer;

function grouped_value(p: const (u8)*) -> u8 {                          //~ ERROR[E0104] the parentheses after `const` group a pointer type, and `(u8)` is not one
    return *p;
}

function grouped_tuple(p: const (u8, u8)*) -> u8 {                      //~ ERROR[E0104] the parentheses after `const` group a pointer type, and `(u8, u8)` is not one
    return 0;
}

function cast_to_grouped_value(p: u8*) -> u8 {
    const q: const u8* = p as const (u8)*;                               //~ ERROR[E0104] the parentheses after `const` group a pointer type, and `(u8)` is not one
    return *q;
}

function main() -> int {
    return 0;
}
