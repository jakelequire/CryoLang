// E0104: a trait implementation for references is written for every
// reference, through a type parameter of its own after `&`; a reference
// to one named type, or to an instantiation of a parameter, is refused.
![config(testing)]
![config(negative, E0104)]
namespace CryoTests::Negative::ReferenceImplementationTarget;

type trait Describe { describe(&this) -> i64; }

implement trait Describe for i64 { describe(&this) -> i64 { return *this; } }

implement trait Describe for &i64 { describe(&this) -> i64 { return 1; } }
//~^ ERROR[E0104] a trait implementation for references names a type parameter of its own after `&`, found `i64`

type struct Holder<T> { value: T; }

implement<T> trait Describe for &Holder<T> { describe(&this) -> i64 { return 2; } }
//~^ ERROR[E0104] a trait implementation for references names a type parameter of its own after `&`, found `Holder`

implement<T> trait Describe for &T where T: Describe {
    describe(&this) -> i64 { return 100 + (*this).describe(); }
}

function main() -> int {
    const x: i64 = 5;
    return x.describe() as int;
}
