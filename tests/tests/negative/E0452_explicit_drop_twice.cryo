// E0452: an explicit `.drop()` releases the value then and there, so the
// binding is moved from; a second `.drop()` on it releases a value that is
// already gone.  A `Drop` that frees unconditionally would free twice.
![config(testing)]
![config(negative, E0452)]
namespace CryoTests::Negative::ExplicitDropTwice;

type struct Buffer {
    length: i32;
}

implement trait Drop for struct Buffer {
    drop(mut &this) -> void {}
}

function main() -> int {
    mut b: Buffer = Buffer { length: 4 };
    b.drop();
    //~^ WARN[W0015] explicit destructor call
    b.drop();
    //~^ WARN[W0015] explicit destructor call
    //~^^ ERROR[E0452] use of moved value 'b'
    return 0;
}
