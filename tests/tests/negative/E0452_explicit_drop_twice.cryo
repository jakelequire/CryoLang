// E0452: `mem::drop(b)` releases the value then and there, so the binding
// is moved from; a second `mem::drop(b)` releases a value that is already
// gone.  A `Drop` that frees unconditionally would free twice.
![config(testing)]
![config(negative, E0452)]
namespace CryoTests::Negative::ExplicitDropTwice;

import std::core::mem;

type struct Buffer {
    length: i32;
}

implement trait Drop for struct Buffer {
    drop(mut &this) -> void {}
}

function main() -> int {
    mut b: Buffer = Buffer { length: 4 };
    mem::drop(b);
    mem::drop(b);
    //~^ ERROR[E0452] use of moved value `b`
    return 0;
}
