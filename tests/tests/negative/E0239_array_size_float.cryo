// E0239: a fixed array's size is an integer constant; a float literal is
// refused rather than read as its integer part.
![config(testing)]
![config(negative, E0239)]
namespace CryoTests::Negative::E0239ArraySizeFloat;

function main() -> i32 {
    mut table: [i32; 2.7];   //~ ERROR[E0239] array size must be a compile-time integer constant
    table[0] = 3;
    return table[0];
}
