// E0308: a method of an inherent block for some instances shares its name
// with one the type's body declares, or one an earlier inherent block whose
// head overlaps declares - a block for every instance included; heads for
// disjoint instances do not conflict, nor do blocks for every instance,
// which overload a name by their parameters.
![config(testing)]
![config(negative, E0308)]
namespace CryoTests::Negative::E0308InherentMethodsOverlap;

type struct Wrap<T> {
    value: T;
    base(&this) -> i64 { return 0; }
}

type struct Two<T> {
    first: T;
    second: T;
}

implement struct Wrap<T> {
    first(&this) -> i64 { return 1; }
}

implement struct Wrap<T> {
    first(&this, n: i64) -> i64 { return n; }
}

implement<T> struct Wrap<Wrap<T>> {
    first(&this) -> i64 { return 3; }
    //~^ ERROR[E0308] conflicting definitions of method `first`: `Wrap<Wrap<T>>` overlaps `Wrap<T>`
    base(&this) -> i64 { return 3; }
    //~^ ERROR[E0308] conflicting definitions of method `base`: `Wrap` declares it in its own body
    pick(&this) -> i64 { return 3; }
}

implement<T> struct Wrap<Two<T>> {
    pick(&this) -> i64 { return 4; }
}

implement<T> struct Wrap<Wrap<Wrap<T>>> {
    pick(&this) -> i64 { return 5; }
    //~^ ERROR[E0308] conflicting definitions of method `pick`: `Wrap<Wrap<Wrap<T>>>` overlaps `Wrap<Wrap<T>>`
}

function main() -> int {
    return 0;
}
