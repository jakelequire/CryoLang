// E0306: a `HashMap` is asked with any form its key borrows as (`Borrow`),
// and a form it does not borrow as is refused at the call, naming the bound
// the key type does not meet: a bare string literal is a `string`, which a
// `String` key does not borrow as, so it is written `Str::new("ada")`.  The
// lookups by `&String` and by `Str` are the control.
![config(testing)]
![config(negative, E0306)]
namespace CryoTests::Negative::E0306MapKeyFormTheKeyDoesNotBorrowAs;

import std::collections::hashmap::{ HashMap };
import std::collections::str::{ Str };
import std::collections::string::{ String };

function main() -> int {
    mut ages: HashMap<String, i64> = HashMap::new();
    ages.insert(String::from("ada"), 36);
    const key: String = String::from("ada");
    const found: i64 = ages.get(&key).unwrap_or(0) + ages.get(Str::new("ada")).unwrap_or(0);
    const by_literal: i64 = ages.get("ada").unwrap_or(0);
    //~^ ERROR[E0306] the trait bound `std::collections::string::String<std::alloc::allocator::GlobalAllocator>: Borrow<string>` is not satisfied
    const by_number: boolean = ages.contains_key(5);
    //~^ ERROR[E0306] the trait bound `std::collections::string::String<std::alloc::allocator::GlobalAllocator>: Borrow<i32>` is not satisfied
    return (found + by_literal) as int;
}
