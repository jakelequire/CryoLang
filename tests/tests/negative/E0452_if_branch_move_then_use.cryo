// E0452: a non-Copy value moved inside one arm of an `if` and then read
// again after the join.
//
// Regression test: the move checker must not snapshot and unconditionally
// *restore* the moved-set across `if`/`else` branches, treating a value
// moved on a branch as live afterwards - the reuse below would then pass
// `check` clean and double-free at runtime. Branch move-sets are merged at
// the join (`merge_branches`): a binding moved on any branch that can fall
// through is possibly-moved afterwards and, since Cryo has no partial-move
// tracking, is conservatively Moved - so the post-`if` `consume(h)` is a
// hard-error use-after-move.
//
// The companion early-return case (`if (c) { consume(h); return 0; }
// consume(h);`) must still COMPILE - the diverging branch's move does not
// escape - and is covered by the self-host build and stdlib suite, which
// use that pattern pervasively.
![config(testing)]
![config(negative, E0452)]
namespace CryoTests::Negative::IfBranchMoveThenUse;

type struct Heap {
    p: void*;
}

implement trait Drop for struct Heap {
    drop(mut &this) -> void { free(this.p); }
}

function consume(h: Heap) -> void {
    // by-value owning parameter: drops `h` at function exit.
}

function main() -> int {
    mut h: Heap = Heap { p: malloc(16) };
    if (1 > 0) { consume(h); }   // moves `h` on the taken path
    consume(h);                  // use-after-move at the join -> double free
    return 0;
}
