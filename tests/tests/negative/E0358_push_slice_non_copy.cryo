// Array::append / try_append are gated `where T: Copy`: the bulk
// append is a bitwise `memcpy` out of the borrowed source, so for an owning
// (non-Copy) T both arrays would end up owning the same heap buffers and
// double-free on drop. Calling append on an `Array<String>` must not
// resolve. This guards the missing-Copy-bound fix (mirrors the get/iter gate
// already covered by HashMapGetNonCopy).
![config(testing)]
![config(negative, E0358)]
namespace CryoTests::Negative::PushSliceNonCopy;
import std::collections::array;
import std::collections::string;
import std::collections::str;

function main() -> int {
    mut dst: Array<String> = Array::new();
    mut src: Array<String> = Array::new();
    mut s: String = String::new();
    s.push_cstr("owning");
    src.push(s);
    // `T = String` is non-Copy, so the `where T: Copy` bound is unsatisfied
    // and the method must not resolve.
    dst.append(src.as_slice());
    src.drop();
    dst.drop();
    return 0;
}
