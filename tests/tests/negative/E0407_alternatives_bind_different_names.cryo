// E0407: the alternatives of one match arm bind different names.  The arm's
// body runs after whichever alternative matched, so a name only one of them
// binds would be read when another matched and never set it.
![config(testing)]
![config(negative, E0407)]
namespace CryoTests::Negative::AlternativesBindDifferentNames;

type enum Shape {
    Circle(int);
    Square(int);
    Rect(int, int);
}

function area(s: Shape) -> int {
    return match (s) {
        Shape::Circle(r) | Shape::Rect(r, w) => { r * w }   //~ ERROR[E0407] `w` is bound in this alternative but not in the arm's first
        Shape::Rect(a, b) | Shape::Square(a) => { a * b }   //~ ERROR[E0407] `b` is not bound in this alternative
    };
}

function main() -> int {
    return area(Shape::Circle(2));
}
