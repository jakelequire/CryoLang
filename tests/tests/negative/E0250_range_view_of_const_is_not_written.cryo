// Compile-fail test: a view `xs[r]` is written as `xs.view_mutable(r)`, so a
// place reached through it is exactly as writable as `xs`: a `const` array's
// view is read-only, and a writable array's is written.  Reading through the
// `const` array's view and writing through the writable one's are the
// controls.
![config(testing)]
![config(negative, E0250)]
namespace CryoTests::Negative::E0250RangeViewOfConstIsNotWritten;

function main() -> int {
    const fixed: [i64] = [1, 2, 3];
    mut growing: [i64] = [4, 5, 6];
    fixed[1..][0] = 7;                //~ ERROR[E0250]
    fixed[..2].as_mutable_ptr();      //~ ERROR[E0250]
    growing[1..][0] = 8;
    const read: i64 = fixed[1..][0] + growing[1..][0];
    return read as int;
}
