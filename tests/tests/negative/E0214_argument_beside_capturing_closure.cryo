// E0214: a call passing a capturing closure to a function-typed parameter
// is bound to a copy of the callee made for the closure's type, and its
// other arguments are checked against that copy's parameters as any call's
// are against its callee's: one of the wrong type is refused, as it is
// beside a closure that captures nothing.
![config(testing)]
![config(negative, E0214)]
namespace CryoTests::Negative::ArgumentBesideCapturingClosure;

type struct Square {
    side: i32;
}

function measure(base: i32, adjust: (i32) -> i32, shape: Square) -> i32 {
    return adjust(base) + shape.side;
}

function main() -> i32 {
    const bias: i32 = 7;
    const captured: i32 = measure(3, (x: i32) -> i32 { return x + bias; }, true);
    //~^ ERROR[E0214] mismatched types
    const plain: i32 = measure(3, (x: i32) -> i32 { return x * 2; }, 9);
    //~^ ERROR[E0214] mismatched types
    if (captured + plain > 0) { return 1; }
    return 0;
}
