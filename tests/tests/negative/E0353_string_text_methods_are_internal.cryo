// E0353: a `string`'s text methods are internal to the standard library; a
// program searches text through `Str`. `Str::new` views a literal or any
// other `string`, and `Str`'s own `contains`, `starts_with` and `ends_with`
// answer for it.
![config(testing)]
![config(negative, E0353)]
namespace CryoTests::Negative::E0353StringTextMethodsAreInternal;

function legacy(text: string) -> boolean {
    const found: boolean = text.contains("b");
    //~^ ERROR[E0353] method `contains` of `string` is internal
    const leads: boolean = text.starts_with("a");
    //~^ ERROR[E0353] method `starts_with` of `string` is internal
    const ends: boolean = "abc".ends_with("c");
    //~^ ERROR[E0353] method `ends_with` of `string` is internal
    return found && leads && ends;
}

function through_str(text: string) -> boolean {
    const view: Str = Str::new(text);
    return view.contains(&Str::new("b")) && view.starts_with(&Str::new("a"))
        && Str::new("abc").ends_with(&Str::new("c"));
}

function main() -> int {
    if (legacy("abc") && through_str("abc")) { return 0; }
    return 1;
}
