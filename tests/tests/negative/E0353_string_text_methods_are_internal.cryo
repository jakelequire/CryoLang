// E0353: a `string`'s text methods are internal to the standard library; a
// program works on text through `Str`, `String` and `Path`. `Str::new` views
// a literal or any other `string`, and `Str`'s own methods answer for it:
// `contains`, `starts_with`, `ends_with`, `is_empty`, and `find`,
// `find_last`, `find_byte` and `find_last_byte`, which answer an `Option`
// where the `string` methods answered -1; `trim`, `strip_prefix`, `split`
// and `split_nonempty`, which answer views of the text rather than copies;
// `replace` and `to_ascii_lowercase`, which answer a `String`. A `String`
// appends, and `Path` names a path's `parent`, `file_name` and `stem`.
![config(testing)]
![config(negative, E0353)]
namespace CryoTests::Negative::E0353StringTextMethodsAreInternal;

import std::fs::path::{ Path };

function legacy(text: string) -> boolean {
    const found: boolean = text.contains("b");
    //~^ ERROR[E0353] method `contains` of `string` is internal
    const leads: boolean = text.starts_with("a");
    //~^ ERROR[E0353] method `starts_with` of `string` is internal
    const ends: boolean = "abc".ends_with("c");
    //~^ ERROR[E0353] method `ends_with` of `string` is internal
    const blank: boolean = text.is_empty();
    //~^ ERROR[E0353] method `is_empty` of `string` is internal
    const first: i64 = text.find("b");
    //~^ ERROR[E0353] method `find` of `string` is internal
    const last: i64 = text.find_last("b");
    //~^ ERROR[E0353] method `find_last` of `string` is internal
    const byte: i64 = text.find_char(98 as i8);
    //~^ ERROR[E0353] method `find_char` of `string` is internal
    const last_byte: i64 = text.find_last_char(98 as i8);
    //~^ ERROR[E0353] method `find_last_char` of `string` is internal
    return found && leads && ends && !blank && first == last && byte == last_byte;
}

function legacy_copies(text: string) -> i64 {
    const joined: string = text.append("d");
    //~^ ERROR[E0353] method `append` of `string` is internal
    const trimmed: string = text.trim();
    //~^ ERROR[E0353] method `trim` of `string` is internal
    const rest: string = text.strip_prefix("a");
    //~^ ERROR[E0353] method `strip_prefix` of `string` is internal
    const replaced: string = text.replace("b", "x");
    //~^ ERROR[E0353] method `replace` of `string` is internal
    const lower: string = text.to_ascii_lower();
    //~^ ERROR[E0353] method `to_ascii_lower` of `string` is internal
    const pieces: [string] = text.split(",");
    //~^ ERROR[E0353] method `split` of `string` is internal
    const words: [string] = text.split_nonempty(",");
    //~^ ERROR[E0353] method `split_nonempty` of `string` is internal
    const directory: string = text.parent_directory();
    //~^ ERROR[E0353] method `parent_directory` of `string` is internal
    const name: string = text.basename();
    //~^ ERROR[E0353] method `basename` of `string` is internal
    const stem: string = text.stem();
    //~^ ERROR[E0353] method `stem` of `string` is internal
    return joined.length() + trimmed.length() + rest.length() + replaced.length() + lower.length()
        + pieces.length() + words.length() + directory.length() + name.length() + stem.length();
}

function through_str(text: string) -> boolean {
    const view: Str = Str::new(text);
    return view.contains(&Str::new("b")) && view.starts_with(&Str::new("a"))
        && Str::new("abc").ends_with(&Str::new("c")) && !view.is_empty()
        && view.find(&Str::new("b")).unwrap_or(-1) == view.find_last(&Str::new("b")).unwrap_or(-1)
        && view.find_byte(98).unwrap_or(-1) == view.find_last_byte(98).unwrap_or(-1);
}

function through_owners(text: string) -> i64 {
    const view: Str = Str::new(text);
    mut joined: String = String::from_str(view);
    joined.append("d");
    const rest: Str = view.strip_prefix(&Str::new("a")).unwrap_or(view);
    const path: Path = Path::from(view);
    const directory: Str = path.parent().unwrap_or(Path::from(".")).as_str();
    return joined.length() + view.trim().length() + rest.length()
        + view.replace(&Str::new("b"), &Str::new("x")).length() + view.to_ascii_lowercase().length()
        + view.split(&Str::new(",")).count() + view.split_nonempty(&Str::new(",")).count()
        + directory.length() + path.file_name().unwrap_or(Str::new("")).length()
        + path.stem().unwrap_or(Str::new("")).length();
}

function main() -> int {
    if (legacy("abc") && through_str("abc") && legacy_copies("abc") == through_owners("abc")) { return 0; }
    return 1;
}
