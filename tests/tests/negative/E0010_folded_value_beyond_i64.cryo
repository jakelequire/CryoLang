// A compile-time integer is folded exactly past `i64::MAX`, so an expression
// of literals that each fit their type, but whose value does not, is refused
// rather than passed over as unfoldable: computed at the type's width it
// would silently become another number.
![config(testing)]
![config(negative, E0010)]
namespace CryoTests::Negative::FoldedValueBeyondI64;

const PRODUCT: u32 = 4294967295 * 4294967295 * 4294967295;   //~ ERROR[E0010] this value is 79228162458924105385300197375, which `u32` does not hold

function main() -> int {
    const sum: i64 = 9223372036854775807 * 4;   //~ ERROR[E0010] this value is 36893488147419103228, which `i64` does not hold
    return (PRODUCT as int) + (sum as int);
}
