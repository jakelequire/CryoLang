// E0200: a dynamic array's `pop()` returns `Option<T>`, not `T` - it does not
// hand back the popped element by value. Binding its result to a bare element
// type must be a type error, not a silent miscompile. (Regression: dynamic-array
// receivers used to resolve to no name in sema, so `arr.pop()` fell through
// unresolved and this bound `void`/garbage into `x` and miscompiled at codegen.)
![config(testing)]
![config(negative, E0200)]
namespace CryoTests::Negative::ArrayPopValueUse;

function main() -> int {
    mut a: i64[] = [];
    a.push(1);
    const x: i64 = a.pop();
    return x as int;
}
