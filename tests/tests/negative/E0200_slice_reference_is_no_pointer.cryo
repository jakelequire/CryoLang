// Compile-fail test: a slice reference holds the slice's own two words, not
// the address of a slice, so it is no `Slice<T>*` and no pointer is one.
![config(testing)]
![config(negative, E0200)]
namespace CryoTests::Negative::E0200SliceReferenceIsNoPointer;

import std::core::slice::{ Slice };

function to_pointer(r: &Slice<i32>) -> i64 {
    const p: Slice<i32>* = r;   //~ ERROR[E0200] mismatched types
    return p.length();
}

function from_pointer(p: Slice<i32>*) -> &Slice<i32> {
    return p;   //~ ERROR[E0200] mismatched types
}

function main() -> int {
    return 0;
}
