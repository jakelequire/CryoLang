// E0204: a trait object has no fields.  It reaches the value behind it only
// through the trait's methods; the value's own fields are not known where
// the object is used.
![config(testing)]
![config(negative, E0204)]
namespace CryoTests::Negative::TraitObjectField;

type trait Shape {
    area(&this) -> i32;
}

function width_of(s: virtual &Shape) -> i32 {
    return s.width;
    //~^ ERROR[E0204] no field `width` on `virtual &CryoTests::Negative::TraitObjectField::Shape`: a trait object has no fields
}

function main() -> int {
    return 0;
}
