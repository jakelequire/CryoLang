// E0250: a `*` strips one level, so the place `*p` is as writable as `p`'s
// outermost indirection makes it.  Through a `&(i64*)` the place is the
// borrowed pointer, which the read-only borrow does not write, whatever the
// pointer it holds would allow; a `mut &(i64*)` writes it.  A read-only
// pointer to a borrow does not write the borrow it points at, and is
// printed with the borrow grouped, as it is written.
![config(testing)]
![config(negative, E0250)]
namespace CryoTests::Negative::DereferenceDecidedByOutermostLevel;

type struct Node { v: i64; }

function rebind_read_only(p: const (&Node)*, to: &Node) -> void {
    *p = to;                                                            //~ ERROR[E0250] cannot assign to a place reached through `const (&Node)*`, which is read-only
}

function rebind_writable(p: (&Node)*, to: &Node) -> void {
    *p = to;
}

function write_borrowed_slot(p: &(i64*), q: i64*) -> void {
    *p = q;                                                             //~ ERROR[E0250] cannot assign to a place reached through `&i64*`, which is read-only
}

function write_writable_slot(p: mut &(i64*), q: i64*) -> void {
    *p = q;
}

function main() -> int {
    return 0;
}
