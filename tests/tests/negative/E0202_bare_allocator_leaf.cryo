// E0202: a bare name means a declaration in the writing module, and the
// allocator leaf is no exception.  `malloc`, `realloc` and `free` are
// declared by `std::ffi::libc` (extern), `std::alloc::heap` (the arena
// allocator) and `std::core::intrinsics`; a module that imports none of
// them and declares none itself names nothing by the bare spelling, and the
// note says which owner to write.  Under the rule this replaces, the bare
// leaf bound the intrinsic through a record of which intrinsic owned it,
// and the same spelling reached `heap::free` - which aborts on a libc
// pointer - depending on what the program linked.
//
// This module deliberately imports nothing allocation-related.
![config(testing)]
![config(negative, E0202)]
namespace CryoTests::Negative::BareAllocatorLeaf;

function main() -> int {
    const p: void* = malloc(64);   //~ ERROR[E0202] cannot find function `malloc` in this scope
    const q: void* = realloc(p, 4096);   //~ ERROR[E0202] cannot find function `realloc` in this scope
    free(q);   //~ ERROR[E0202] cannot find function `free` in this scope
    return 0;
}
