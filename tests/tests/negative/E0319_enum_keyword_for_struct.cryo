// E0319: the kind keyword before an `implement` head's type names the
// type's kind, so `enum` before a struct is refused - in a trait
// implementation's head, an inherent one's, and a block for one instance of
// a generic struct.
![config(testing)]
![config(negative, E0319)]
namespace CryoTests::Negative::EnumKeywordForStruct;

type struct Point { x: i32; y: i32; }
type struct Cell<T> { value: T; }

type trait Area {
    area(&this) -> i32;
}

implement trait Area for enum Point {
//~^ ERROR[E0319] `CryoTests::Negative::EnumKeywordForStruct::Point` is a struct, not an enum
    area(&this) -> i32 { return this.x * this.y; }
}

implement enum Point {
//~^ ERROR[E0319] `CryoTests::Negative::EnumKeywordForStruct::Point` is a struct, not an enum
    sum(&this) -> i32 { return this.x + this.y; }
}

implement<> enum Cell<i64> {
//~^ ERROR[E0319] `CryoTests::Negative::EnumKeywordForStruct::Cell` is a struct, not an enum
    widened(&this) -> i64 { return this.value; }
}

function main() -> int {
    return 0;
}
