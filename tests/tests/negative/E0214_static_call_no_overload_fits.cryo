// E0214: a static call no overload of the method accepts, whether the
// overloads are generic or not.
![config(testing)]
![config(negative, E0214)]
namespace CryoTests::Negative::StaticCallNoOverloadFits;

type struct Plain { n: i32; }
implement struct Plain {
    static conv<U>(u: U) -> U { return u; }
    static conv<U>(u: U, w: U) -> U { return w; }
}

type struct Two { n: i32; }
implement struct Two {
    static f(u: i32) -> i32 { return 1; }
    static f(u: i64) -> i32 { return 2; }
}

function main() -> i32 {
    const a: i32 = Plain::conv(1, "s");
    //~^ ERROR[E0214] no overload of `conv` accepts these arguments
    const b: i32 = Two::f("s");
    //~^ ERROR[E0214] no overload of `f` accepts these arguments
    return a + b;
}
