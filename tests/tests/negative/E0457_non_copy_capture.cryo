// E0457: a closure body references an outer-scope non-Copy binding.
// The v1 MVP only supports by-value `Copy` captures (i32, u64, bool,
// char, references) - Drop types must be passed as arguments or boxed
// manually. This test verifies the diagnostic fires at the *use* site
// inside the lambda body rather than the lambda silently miscompiling
// into a broken capture (which is what happened before closures were
// implemented at all - the reference resolved to "not found" with
// E0201).
![config(testing)]
![config(negative, E0457)]
namespace CryoTests::Negative::NonCopyCapture;

type struct Heap {
    p: void*;
}

implement trait Drop for struct Heap {
    drop(mut &this) -> void { free(this.p); }
}

function main() -> int {
    const h: Heap = Heap { p: malloc(16) };
    const f = (x: i32) -> i32 {
        // Non-Copy capture: `h` is a Drop type, can't be by-value-copied
        // into the closure's environment
        const _used: void* = h.p;
        return x + 1;
    };
    const _y: i32 = f(0);
    return 0;
}
