// E0455: a `match` binding over a BY-VALUE parameter is still a frame local.
//
// The caller-backed exemption that lets an in-place accessor return a pointer
// into its receiver (`lang/match_binding_alias.cryo`) covers a subject reached
// through a POINTER or REFERENCE parameter only. A by-value parameter is copied
// into this frame like any local, so a pointer into its payload dangles the
// moment the function returns. Taking the address of the caller's argument
// requires the signature to say so - `s: Slot*`, not `s: Slot`.
![config(testing)]
![config(negative, E0455)]
namespace CryoTests::Negative::ReturnByValueParamBinding;

type struct Cell { n: i64; }

type enum Slot { Filled(Cell); Empty; }

function by_value_param_subject(s: Slot) -> Cell* {
    match (s) {
        Slot::Filled(value) => { return &value; }   // `s` is this frame's copy
        Slot::Empty => { core::panic("unreachable", FILE, LINE); }
    }
}

function main() -> int {
    return 0;
}
