// E0237: a module-scope `static_assert` with a false condition fails the build.
// `i32` is 4 bytes, so `sizeof(i32) == 8` is false and must be rejected at
// compile time (IMPROVEMENT.md section 4).
![config(testing)]
![config(negative, E0237)]
namespace CryoTests::Negative::E0237StaticAssert;

static_assert(sizeof(i32) == 8);   //~ ERROR[E0237] static assertion failed

function main() -> int {
    return 0;
}
