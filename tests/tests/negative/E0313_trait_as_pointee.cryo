// E0313: a trait is no type, so a pointer or reference to one is refused
// where it is written - a parameter, a field, a local, a generic trait -
// rather than accepted as a placeholder that fails at its first use.  A
// trait object is not supported yet.  `&This` in a trait and a reference to
// a type parameter bounded by the trait stay accepted.  A field whose
// annotation was refused is also reported as unresolved (E0203), as it is
// for a field naming an unknown type.
![config(testing)]
![config(negative, E0313)]
namespace CryoTests::Negative::TraitAsPointee;

type trait Shape {
    area(&this) -> i32;
    same(&this, o: &This) -> boolean { return this.area() == o.area(); }
}

type trait Conv<T> {
    conv(&this) -> T;
}

type struct Sq { s: i32; }

implement trait Shape for struct Sq {
    area(&this) -> i32 { return this.s * this.s; }
}

type struct Holder {
    p: Shape*;                                     //~ ERROR[E0313] `Shape` is a trait, so `Shape*` is not a type
    //~^ ERROR[E0203] cannot resolve type for field `p` of `Holder`
}

function by_ref(p: &Shape) -> i32 { return 1; }    //~ ERROR[E0313] `Shape` is a trait, so `&Shape` is not a type
function by_mut(p: mut &Shape) -> i32 { return 1; }  //~ ERROR[E0313] `Shape` is a trait, so `&Shape` is not a type
function by_conv(p: &Conv<i64>) -> i32 { return 1; }  //~ ERROR[E0313] `Conv` is a trait, so `&Conv<...>` is not a type

function total<T>(p: &T) -> i32 where T: Shape { return p.area(); }

function main() -> int {
    const q: Sq = Sq { s: 3 };
    const ps: [Shape*] = [];                       //~ ERROR[E0313] `Shape` is a trait, so `Shape*` is not a type
    if (!q.same(&q)) { return 1; }
    return total(&q) - 9;
}
