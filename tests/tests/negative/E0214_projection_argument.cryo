// E0214: an argument for a parameter typed by a type parameter's associated
// type (`d: I::Item`) is judged against the type the impl binding `I` gives
// it, in a plain call, a call through a module path and a method call.
// `Count`'s `Item` is `i32`, so `true` is refused in each; `4` is fine.
![config(testing)]
![config(negative, E0214)]
namespace CryoTests::Negative::ProjectionArgument;

import std::core::option::{ Option };

type trait Source {
    type Item;
    take(mut &this) -> Option<This::Item>;
}

type struct Count { n: i32; }

implement trait Source for struct Count {
    type Item = i32;
    take(mut &this) -> Option<i32> { return Option::None; }
}

function take_or<I>(it: mut &I, d: I::Item) -> I::Item where I: Source {
    return match (it.take()) {
        Option::Some(v) => { v }
        Option::None    => { d }
    };
}

type struct Holder { k: i32; }

implement struct Holder {
    pick<I>(&this, it: mut &I, d: I::Item) -> I::Item where I: Source {
        return match (it.take()) {
            Option::Some(v) => { v }
            Option::None    => { d }
        };
    }
}

function main() -> int {
    mut c: Count = Count { n: 9 };
    const h: Holder = Holder { k: 1 };
    const ok: i32 = take_or(&c, 4) + h.pick(&c, 4);
    const a: i32 = take_or(&c, true);                                 //~ ERROR[E0214] mismatched types
    const b: i32 = ProjectionArgument::take_or(&c, true);             //~ ERROR[E0214] mismatched types
    const m: i32 = h.pick(&c, true);                                  //~ ERROR[E0214] mismatched types
    return ok + a + b + m;
}
