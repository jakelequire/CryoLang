// E0154: a free-function call that two generic overloads of its arity both
// accept is ambiguous, as one a generic and a non-generic overload both
// accept is: no generic function outranks another.  It is not "no overload
// accepts these arguments" (E0214), which is for a call none accepts.  A
// call only one generic overload accepts calls it, in
// projects/generic_overload_chosen_by_arguments.
![config(testing)]
![config(negative, E0154)]
namespace CryoTests::Negative::TwoGenericFunctionsTie;

function pick<T>(a: T, b: i32) -> i32 { return 1; }
function pick<U>(a: i32, b: U) -> i32 { return 2; }

function point<U>(u: U) -> i32 { return 1; }
function point<U>(u: U*) -> i32 { return 2; }

function inside<T>(t: T) -> i32 {
    const y: i32 = 3;
    return pick(y, y);
    //~^ ERROR[E0154] `pick` is ambiguous: more than one generic function accepts these arguments
}

function main() -> int {
    const x: i32 = 7;
    mut y: i32 = 4;
    const a: i32 = pick(x, x);
    //~^ ERROR[E0154] `pick` is ambiguous: more than one generic function accepts these arguments
    const b: i32 = point(&y);
    //~^ ERROR[E0154] `point` is ambiguous: more than one generic function accepts these arguments
    const c: i32 = CryoTests::Negative::TwoGenericFunctionsTie::pick(x, x);
    //~^ ERROR[E0154] `pick` is ambiguous: more than one generic function accepts these arguments
    return (a + b + c + inside(1)) as int;
}
