// E0455: a `match` binding over a subject this frame OWNS is a frame local, so
// its address must not be returned.
//
// The counterpart to `lang/match_binding_alias.cryo`: a binding taken from a
// subject reached through a by-reference parameter aliases the caller's storage
// and may be returned. A binding taken from a LOCAL may not - the local dies
// with the frame, so the returned pointer dangles immediately. The exemption is
// about where the subject lives, not about the syntax of the binding.
![config(testing)]
![config(negative, E0455)]
namespace CryoTests::Negative::ReturnLocalSubjectBinding;

type struct Cell { n: i64; }

type enum Slot { Filled(Cell); Empty; }

function frame_local_subject() -> Cell* {
    mut s: Slot = Slot::Filled(Cell { n: 1 });
    match (s) {
        Slot::Filled(value) => { return &value; }   // `s` dies with this frame
        Slot::Empty => { core::panic("unreachable", FILE, LINE); }
    }
}

function main() -> int {
    return 0;
}
