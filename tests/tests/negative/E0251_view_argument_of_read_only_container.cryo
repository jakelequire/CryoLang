// Compile-fail test: a view `xs[r]` passed where the parameter writes
// (`mut &Slice<T>`) is the writable view `xs.view_mutable(r)`, so it is as
// writable as `xs`: one reached through a read-only reference to a fixed
// array, or held by a `const` binding, is refused, naming what made it
// read-only.  Passing the writable array's view, and reading through the
// read-only ones, are the controls.
![config(testing)]
![config(negative, E0251)]
namespace CryoTests::Negative::E0251ViewArgumentOfReadOnlyContainer;

import std::core::slice::{ Slice };

function fill(xs: mut &Slice<i64>, value: i64) -> void {
    for (mut i: i64 = 0; i < xs.length(); i++) { xs[i] = value; }
}

function sum(xs: &Slice<i64>) -> i64 {
    mut total: i64 = 0;
    for (mut i: i64 = 0; i < xs.length(); i++) { total = total + xs[i]; }
    return total;
}

function through_read_only(xs: &[i64; 4]) -> i64 {
    fill(xs[1..], 0);
    //~^ ERROR[E0251] cannot take a writable borrow of a place reached through `&[i64; 4]`, which is read-only
    return sum(xs[1..]);
}

function main() -> int {
    const fixed: [i64; 3] = [1, 2, 3];
    mut growing: [i64] = [4, 5, 6];
    fill(fixed[..2], 0);
    //~^ ERROR[E0251] cannot take a writable borrow of a place held by a `const` binding
    fill(growing[1..], 0);
    return (sum(fixed[..]) + sum(growing[..])) as int;
}
