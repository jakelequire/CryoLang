// E0310: when a trait has generic parameters AND an associated type, the
// associated type may not be bound positionally - positional args fill the
// declared generic params in order (decision #6), so an associated type of
// such a trait must be named (`Out = ...`). Here `Conv<G>` has one generic
// param and one associated type `Out`; the impl supplies two positional args
// (`Conv<i32, i64>`), the second of which can only be a positional attempt to
// bind `Out`. -> E0310 (bind `Out` by name instead).
![config(testing)]
![config(negative, E0310)]
namespace CryoTests::Negative::PositionalAssocWithGenerics;

type trait Conv<G> {
    type Out;
    run(&this) -> i32;
}

type struct Widget { v: i32; }

implement trait Conv<i32, i64> for struct Widget {
    run(&this) -> i32 { return this.v; }
}

function main() -> int {
    return 0;
}
