// An array size is computed in its operands' types, as the program computes
// them, so an operation in it that overflows its type is refused there, in a
// declaration's type and in a local's alike.  An operation whose type holds
// its value is a size as before.
![config(testing)]
![config(negative, E0465)]
namespace CryoTests::Negative::ArraySizeOverflow;

const CF_SMALL: u8 = 200;
const CF_WIDE: u16 = 200;
const CF_LEAST: i8 = i8::MIN;

type struct CfBuffer {
    overflowing: [u8; CF_SMALL * 2];
    //~^ ERROR[E0465] `CF_SMALL * 2` overflows `u8`: its value is 400, which `u8` does not hold
    held: [u8; CF_WIDE * 2];
}

public function cf_local() -> i32 {
    const negated: [u8; -CF_LEAST] = [0; 128];
    //~^ ERROR[E0465] `-CF_LEAST` overflows `i8`: its value is 128, which `i8` does not hold
    return 0;
}
