// Compile-fail test: a fixed array that converts to a slice for a generic
// writable `mut &Slice<T>` parameter must be writable, as for a parameter
// with no type parameters: a read-only array is refused once, at the
// argument.  The writable array is the control.
![config(testing)]
![config(negative, E0251)]
namespace CryoTests::Negative::E0251ReadOnlyFixedArrayForAGenericWritableSlice;

import std::core::slice::{ Slice };

function fill_with<T>(items: mut &Slice<T>, value: T) -> void {
    for (mut i: i64 = 0; i < items.length(); i++) {
        items[i] = value;
    }
}

function main() -> int {
    const frozen: [u64; 3] = [1, 2, 3];
    mut open: [u64; 3] = [1, 2, 3];
    fill_with(&frozen, 9);   //~ ERROR[E0251]
    fill_with(&open, 9);
    return 0;
}
