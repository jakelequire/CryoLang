// E0214: a negative numeric literal passed to an unsigned parameter is a
// silent value change — `cf_take_u32(-1)` would arrive as 4294967295.
// Assignment already rejects this (`let x: u32 = -1` → E0200); the call-arg
// gate was the asymmetric hole.  Sema no longer pushes an unsigned param
// type onto a negative literal (which used to coerce it away), so the literal
// stays signed and the same-width-sign-reinterpret arg check rejects it.
//
// Regression for audit finding "same-width sign reinterpret silently accepted
// at call args".  A literal that fits the target (`cf_take_u32(5)`) stays
// legal; the fix is value-correctness, not a ban on `u32` arguments.
![config(testing)]
![config(negative, E0214)]
namespace CryoTests::Negative::NegLiteralUnsignedArg;

function cf_take_u32(x: u32) -> u32 { return x; }

function main() -> int {
    const r: u32 = cf_take_u32(-1);   // error[E0214]: negative literal into u32
    return 0;
}
