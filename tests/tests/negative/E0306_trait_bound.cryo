// E0306: i32 does not satisfy the CfShow bound.
![config(testing)]
![config(negative, E0306)]
namespace CryoTests::Negative::E0306TraitBound;
type trait CfShow { cf_show(&this) -> i32; }
function cf_need<T>(x: T) -> i32 where T: CfShow { return x.cf_show(); }
function main() -> int { return cf_need<i32>(5); }   //~ ERROR[E0306] the trait bound `i32: CfShow` is
