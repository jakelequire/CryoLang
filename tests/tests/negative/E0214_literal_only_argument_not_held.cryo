// An argument made only of integer literals passes the value its arithmetic
// gives, so it is refused exactly where its parameter's type does not hold
// that value, whatever its intermediates are: `(200 + 100) / 2` is 150 and
// fits a `u8`, `-(100 + 28)` is -128 and fits an `i8`, while `-(100 + 29)`,
// `-129` and `1 - 2` do not.  A negative value an `i8` does not hold keeps
// its default width rather than adopting the parameter's type, where it
// would be negated at 8 bits and pass 127.
![config(testing)]
![config(negative, E0214)]
namespace CryoTests::Negative::LiteralOnlyArgumentNotHeld;

function take_u8(value: u8) -> u8 { return value; }
function take_i8(value: i8) -> i8 { return value; }

function main() -> int {
    const a: u8 = take_u8((200 + 100) / 2);
    const b: i8 = take_i8(-(100 + 28));
    const c: i8 = take_i8(-128);
    const d: i8 = take_i8(-(100 + 29));     //~ ERROR[E0214] mismatched types
    const e: i8 = take_i8(-129);            //~ ERROR[E0214] mismatched types
    const f: u8 = take_u8(1 - 2);           //~ ERROR[E0214] mismatched types
    return (a as int) + (b as int) + (c as int) + (d as int) + (e as int) + (f as int);
}
