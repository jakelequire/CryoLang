// E0214: a call through an `extern module` C import is argument-checked
// against the imported prototype, as any module function's call is.  An
// `i64` passed to a C `int` would be truncated silently at the C boundary,
// where nothing downstream can notice; the spec (section 2.9) requires an
// explicit `as` cast.  The same refusal covers a `u64` passed to a C
// `unsigned long` on a Windows host, where `unsigned long` is 32 bits.
![config(testing)]
![config(negative, E0214)]
namespace CryoTests::Negative::E0214CImportNarrowing;

extern module probe := "C" {
    #include "../../helpers/bindgen_probe.h"
}

function main() -> int {
    const big: i64 = 5;
    probe::bindgen_probe_add3(big, 1 as i32, 2 as i32);   //~ ERROR[E0214] mismatched types
    return 0;
}
