// E0317: an object type binds every type parameter and associated type of
// its trait, the parameters first, so it writes exactly that many type
// arguments; too few and too many are both the wrong number of trait
// arguments, the code a bound writing too many has.
![config(testing)]
![config(negative, E0317)]
namespace CryoTests::Negative::ObjectArgumentCount;

type trait Source {
    type Item;
    next(mut &this) -> Option<This::Item>;
}

type trait Conv<T> {
    type Extra;
    convert(&this) -> T;
}

type trait Shape {
    area(&this) -> i32;
}

function unbound(s: virtual mut &Source) -> i32 {
    //~^ ERROR[E0317] `Source` takes 1 type argument in an object type, and 0 are written
    return 0;
}

function too_few(c: virtual &Conv<i64>) -> i32 {
    //~^ ERROR[E0317] `Conv` takes 2 type arguments in an object type, and 1 is written
    return 0;
}

function too_many(s: virtual &Shape<i32>) -> i32 {
    //~^ ERROR[E0317] `Shape` takes 0 type arguments in an object type, and 1 is written
    return 0;
}

function main() -> int {
    return 0;
}
