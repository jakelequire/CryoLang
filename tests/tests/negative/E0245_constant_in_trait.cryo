// E0245: a trait declares no constants.  `const` followed by a name in a
// trait's body is refused where it is written, rather than read as a
// method named `const`.
![config(testing)]
![config(negative, E0245)]
namespace CryoTests::Negative::ConstantInTrait;

type trait Bounded {
    const MAX: i32 = 1;   //~ ERROR[E0245] a trait cannot declare constants
    largest(&this) -> i32;
}

function main() -> int {
    return 0;
}
