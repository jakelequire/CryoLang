// E0249: a type's constant is a module-level item, so a type declared
// inside a function body declares none.
![config(testing)]
![config(negative, E0249)]
namespace CryoTests::Negative::ConstantOnLocalType;

function main() -> int {
    type struct Local {
        v: i32;
        const ZERO: i32 = 0;   //~ ERROR[E0249] a type declared inside a function body cannot declare constants
    }
    return 0;
}
