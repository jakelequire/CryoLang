// E0315: a subtrait object's table holds its supertraits' methods too, so a
// value converts to it only when its type implements every supertrait, at
// the arguments the subtrait writes on it.
![config(testing)]
![config(negative, E0315)]
namespace CryoTests::Negative::ObjectConversionSupertrait;

type trait Named {
    id(&this) -> i32;
}

type trait Shape : Named {
    area(&this) -> i32;
}

type trait Measure<T> {
    measure(&this) -> T;
}

type trait Sized : Measure<i64> {
    count(&this) -> i32;
}

type struct Square {
    side: i32;
}

implement trait Shape for Square {
    area(&this) -> i32 { return this.side * this.side; }
}

implement trait Measure<i32> for Square {
    measure(&this) -> i32 { return 1; }
}

implement trait Sized for Square {
    count(&this) -> i32 { return 1; }
}

function main() -> int {
    const q: Square = Square { side: 3 };
    const s: virtual &Shape = &q;
    //~^ ERROR[E0315] `CryoTests::Negative::ObjectConversionSupertrait::Square` does not implement `CryoTests::Negative::ObjectConversionSupertrait::Named`, which `CryoTests::Negative::ObjectConversionSupertrait::Shape` requires, so `&CryoTests::Negative::ObjectConversionSupertrait::Square` cannot become `virtual &CryoTests::Negative::ObjectConversionSupertrait::Shape`
    const z: virtual &Sized = &q;
    //~^ ERROR[E0315] `CryoTests::Negative::ObjectConversionSupertrait::Square` does not implement `CryoTests::Negative::ObjectConversionSupertrait::Measure<i64>`, which `CryoTests::Negative::ObjectConversionSupertrait::Sized` requires, so `&CryoTests::Negative::ObjectConversionSupertrait::Square` cannot become `virtual &CryoTests::Negative::ObjectConversionSupertrait::Sized`
    return 0;
}
