///! Every change a method makes through one read-only `&this` receiver is the
///! one problem of how the receiver is declared, so it is one report: each
///! place carries its own caret, and the single fix declares the receiver
///! `mut &this`.  A writable borrow of the same receiver joins the report
///! under its own code, named in a note.  Another method's receiver is
///! another problem, reported apart.

![config(testing)]
![config(negative, E0250)]
namespace CryoTests::Negative::E0250ReceiverChangesReportedOnce;

type struct Bus {
    next_id: i32;
    listeners: [i32];
    side: i32;

    add(mut &this, listener: i32) -> void { this.listeners.push(listener); }

    subscribe(&this, listener: i32) -> mut i32* {
        this.next_id = this.next_id + 1;
        //~^ ERROR[E0250] method `subscribe` changes its receiver, which it takes as a read-only `&this`
        this.listeners.push(listener);
        //~^ ERROR[E0250] method `subscribe` changes its receiver, which it takes as a read-only `&this`
        this.add(listener);
        //~^ ERROR[E0250] method `subscribe` changes its receiver, which it takes as a read-only `&this`
        return &this.side;
        //~^ ERROR[E0250] method `subscribe` changes its receiver, which it takes as a read-only `&this`
    }

    reset(&this) -> void {
        this.next_id = 0;
        //~^ ERROR[E0250] cannot assign to a place reached through the `&this` receiver, which is read-only
    }
}
