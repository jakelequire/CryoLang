// E0311: a generic parameter whose name an enclosing declaration's generic
// parameter already holds is refused at its declaration - a method's `<T>`
// inside `struct Box<T>`, a trait method's `<T>` inside `trait Conv<T>`, an
// impl method's `<T>` inside `implement<T>`, and a second `T` in one list.
// Every consumer below the name layer that keys a substitution by the
// parameter's spelling would hold the two as one slot, so before this the
// OWNER's parameter silently won: `Box<u8>::new(1).size_of_param<i64>(5)`
// answered 1.  A parameter of a distinct name beside the owner's is
// untouched, and so is a parameter shadowing a TYPE or a value parameter
// spelled like a generic one - neither is a generic parameter.
![config(testing)]
![config(negative, E0311)]
namespace CryoTests::Negative::GenericParamShadowed;

type struct CfBox<T> {
    v: T;

    static new(v: T) -> CfBox<T> { return CfBox<T> { v: v }; }

    size_of_param<T>(&this, x: T) -> u64 { return sizeof(T); }   //~ ERROR[E0311] the generic parameter `T` shadows

    // A distinct name: nothing to refuse.
    size_of_other<K>(&this, x: K) -> u64 { return sizeof(K); }
}

type trait CfConv<T> {
    conv<T>(&this, x: T) -> u64;   //~ ERROR[E0311] the generic parameter `T` shadows
}

type struct CfHolder<T> { v: T; }
type trait CfShow { show(&this) -> u64; }

// The impl's own `T` beside the struct's `T` is two scope chains, not a
// shadow; the method's `T` inside the impl is.
implement<T> trait CfShow for struct CfHolder<T> {
    show(&this) -> u64 { return sizeof(T); }
    inner<T>(&this, x: T) -> u64 { return sizeof(T); }   //~ ERROR[E0311] the generic parameter `T` shadows
}

function twice<T, T>(x: T) -> u64 { return sizeof(T); }   //~ ERROR[E0311] the generic parameter `T` shadows

// A value parameter spelled `T` beside a generic `T`, and a type spelled `T`
// in the module: neither is a generic parameter.
type struct T { v: i32; }
function value_named_t<T>(T: T) -> u64 { return sizeof(T); }

function main() -> int {
    return 0;
}
