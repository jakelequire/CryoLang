// E0502: an import names a module by its registered name, whole.  A path
// that reaches a file but is not the namespace written in it - the suffix a
// qualifier may abbreviate to, `core::option` for `std::core::option` -
// names no module: it bound nothing and, as a plain `import M;`, said
// nothing.  The help names the module the path abbreviates.
![config(testing)]
![config(negative, E0502)]
namespace CryoTests::Negative::ImportNamesNoModule;

import core::option;   //~ ERROR[E0502] `core::option` is not a module's name

function main() -> int {
    return 0;
}
