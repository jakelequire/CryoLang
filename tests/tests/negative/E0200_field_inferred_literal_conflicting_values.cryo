// E0200: a generic struct's literal written with no type arguments is the
// instance its field values bind, and every value is checked against that
// instance's field.  `Pair { a: 1, b: true }` binds `T` from one field and
// gives the other a value of a different type; a variant whose payload is a
// different type from the instance's is refused the same way.
![config(testing)]
![config(negative, E0200)]
namespace CryoTests::Negative::FieldInferredLiteralConflictingValues;

type struct Pair<T> {
    a: T;
    b: T;
}

type struct Holder<T> {
    inner: T;
    peeked: Option<T>;
}

function main() -> int {
    const pair = Pair { a: 1, b: true };   //~ ERROR[E0200] mismatched types
    const holder = Holder { inner: 3, peeked: Option::Some(false) };   //~ ERROR[E0200] mismatched types
    if (pair.a != 1) { return 1; }
    if (holder.peeked.is_some()) { return 2; }
    return 0;
}
