// E0452: a binding an arm of a branching expression yields is moved when
// that arm runs, so a use after the expression is a use after a possible
// move.  Each form below moves `named` into `chosen` on one path; reading
// `named` afterwards would release its storage twice.
![config(testing)]
![config(negative, E0452)]
namespace CryoTests::Negative::BranchValueMoveThenUse;
import std::ffi::libc;

type struct Heap {
    p: mut void*;
}

implement trait Drop for struct Heap {
    drop(mut &this) -> void { libc::free(this.p); }
}

function consume(h: Heap) -> void { }

function from_if(flag: boolean) -> void {
    const named: Heap = Heap { p: libc::malloc(16) };
    const chosen: Heap = if (flag) { named } else { Heap { p: libc::malloc(16) } };
    consume(named);   //~ ERROR[E0452] use of moved value `named`
}

function from_ternary(flag: boolean) -> void {
    const named: Heap = Heap { p: libc::malloc(16) };
    const chosen: Heap = flag ? named : Heap { p: libc::malloc(16) };
    consume(named);   //~ ERROR[E0452] use of moved value `named`
}

function from_match(n: int) -> void {
    const named: Heap = Heap { p: libc::malloc(16) };
    const chosen: Heap = match (n) {
        1 => { named }
        _ => { Heap { p: libc::malloc(16) } }
    };
    consume(named);   //~ ERROR[E0452] use of moved value `named`
}

function main() -> int {
    from_if(true);
    from_ternary(true);
    from_match(1);
    return 0;
}
