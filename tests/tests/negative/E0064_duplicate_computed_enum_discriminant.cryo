// E0064: two variants share a discriminant when one of them is computed: a
// shift equal to a later literal, and a variant that takes the tag after its
// predecessor's, which a computed one already holds.
![config(testing)]
![config(negative, E0064)]
namespace CryoTests::Negative::E0064DuplicateComputedDiscriminant;

type enum Shifted {
    S = 1 << 1;
    T = 2;
    //~^ ERROR[E0064] variant `T` shares discriminant 2 with `S` in enum `Shifted`
}

type enum Following {
    U = 3;
    V = Following::U - 1;
    W;
    //~^ ERROR[E0064] variant `W` shares discriminant 3 with `U` in enum `Following`
}

function main() -> i32 {
    return Shifted::S as i32 + Following::U as i32;
}
