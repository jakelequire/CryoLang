// E0353: initializing a private field in a struct literal from outside the
// declaring type.  Reading/writing a private field was already rejected; so
// must fabricating one in a literal, or external code could bypass whatever
// invariant the private field protects.
![config(testing)]
![config(negative, E0353)]
namespace CryoTests::Negative::E0353PrivateLiteral;
type struct CfL {
    private: secret: i32;
    public:  tag:    i32;
}
function main() -> int {
    // `secret` is private to `CfL`; naming it here (outside CfL's own methods)
    // is an E0353 violation even though `tag` is public.
    const s: CfL = CfL { secret: 1, tag: 2 };   //~ ERROR[E0353] field `secret` of
    return s.tag;
}
