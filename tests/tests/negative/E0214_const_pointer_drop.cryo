// E0214: passing a `const T*` argument where a plain `T*` is expected silently
// drops const and is rejected; an explicit `as` cast is required instead.
![config(testing)]
![config(negative, E0214)]
namespace CryoTests::Negative::E0214ConstPointerDrop;

function wants_mut(p: i32*) -> i32 { return *p; }

function relay(cp: const i32*) -> i32 {
    return wants_mut(cp);   // const i32* -> i32* : drops const
}

function main() -> int {
    return 0;
}
