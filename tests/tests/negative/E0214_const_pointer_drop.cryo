// E0214: a read-only pointer (here spelled `const T*`) is refused as the
// argument for a `mut T*` parameter: the callee would write through it.
![config(testing)]
![config(negative, E0214)]
namespace CryoTests::Negative::E0214ConstPointerDrop;

function wants_mut(p: mut i32*) -> i32 { return *p; }

function relay(cp: const i32*) -> i32 {
    return wants_mut(cp);   // const i32* -> mut i32* : drops const   //~ ERROR[E0214] mismatched types
}

function main() -> int {
    return 0;
}
