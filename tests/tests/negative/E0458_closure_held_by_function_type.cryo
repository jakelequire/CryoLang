// E0458: a function-typed variable, field, array element, assigned place or
// returned value holds a function pointer, which has no room for a closure's
// captures.  Each is refused where the capturing closure meets it, rather
// than compiled to a call through a pointer that is not one.  A variant's
// payload is a scope-resolution call's argument and is refused as one.
// The controls stay accepted: a closure bound with its type inferred, a
// closure passed to a non-generic free function, and a lambda that captures
// nothing.
![config(testing)]
![config(negative, E0458)]
namespace CryoTests::Negative::ClosureHeldByFunctionType;

import std::core::option;
import std::core::option::{ Option };

type struct Holder { f: (i32) -> i32; }

function make(k: i32) -> () -> i32 {
    return () -> i32 { return k; };              //~ ERROR[E0458] a capturing closure cannot be held by a returned value of function type `() -> i32`
}

function apply(f: (i32) -> i32, x: i32) -> i32 { return f(x); }

function main() -> int {
    const bias: i32 = 40;
    const a: (i32) -> i32 = (x: i32) -> i32 { return x + bias; };       //~ ERROR[E0458] a capturing closure cannot be held by a variable of function type `(i32) -> i32`
    const h: Holder = Holder { f: (x: i32) -> i32 { return x + bias; } };  //~ ERROR[E0458] a capturing closure cannot be held by a field of function type `(i32) -> i32`
    const arr: [(i32) -> i32] = [(x: i32) -> i32 { return x + bias; }];  //~ ERROR[E0458] a capturing closure cannot be held by an array element of function type `(i32) -> i32`
    const o: Option<(i32) -> i32> = Option::Some((x: i32) -> i32 { return x + bias; });  //~ ERROR[E0458] passing a capturing closure to a scope-resolution call is not yet supported
    mut g: (i32) -> i32 = (x: i32) -> i32 { return x; };
    const c = (x: i32) -> i32 { return x + bias; };
    g = c;                                       //~ ERROR[E0458] a capturing closure cannot be held by an assigned place of function type `(i32) -> i32`
    const n: i32 = c(2) + apply((x: i32) -> i32 { return x * bias; }, 1) + g(0);
    return n + a(0) + h.f(0) + make(1)();
}
