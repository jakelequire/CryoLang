// Compile-fail test: an object holds its value's address, and a slice is
// borrowed as its two words, so no slice becomes a trait object.
![config(testing)]
![config(negative, E0315)]
namespace CryoTests::Negative::E0315SliceIsNoObject;

import std::core::slice::{ Slice };

type trait Measure {
    size(&this) -> i64;
}

implement trait Measure for struct Slice<i32> {
    size(&this) -> i64 { return this.length(); }
}

function measure(m: virtual &Measure) -> i64 {
    return m.size();
}

function through_object(s: &Slice<i32>) -> i64 {
    return measure(s);   //~ ERROR[E0315] cannot become
}

function main() -> int {
    return 0;
}
