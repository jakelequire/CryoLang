// E0358: a function type names no type that declares methods, so a call on
// a function-typed value names no method.  Refused where the call is
// written, not left for code generation to find unresolved.
![config(testing)]
![config(negative, E0358)]
namespace CryoTests::Negative::MethodOnFunctionValue;

function apply(f: (i32) -> i32) -> i32 {
    return f.area();
    //~^ ERROR[E0358] no method named `area` found on type `(i32) -> i32`
}

function main() -> int {
    return 0;
}
