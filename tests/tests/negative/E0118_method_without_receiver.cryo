// E0118: an instance method says how it takes its receiver - `&this`,
// `mut &this` or `this` - or is `static`.  A method in a type body, in an
// enum's implement block, in a trait and in a trait's implementation is
// each refused once where it is named, and a body that reads `this` reports
// nothing more.
![config(testing)]
![config(negative, E0118)]
namespace CryoTests::Negative::MethodWithoutReceiver;

type struct Cell {
    n: i32;

    address() -> u64 { return (this as void*) as u64; }   //~ ERROR[E0118] method `address` does not say how it takes its receiver
    read(&this) -> i32 { return this.n; }
    static make() -> Cell { return Cell { n: 1 }; }
}

type enum Slot {
    Full(i32);
    Empty;
}

implement enum Slot {
    is_full() -> boolean {                                 //~ ERROR[E0118] method `is_full` does not say how it takes its receiver
        return match (this) {
            Slot::Full(_) => { true }
            Slot::Empty   => { false }
        };
    }
}

type trait Size {
    size() -> i64;                                         //~ ERROR[E0118] method `size` does not say how it takes its receiver
}

implement trait Size for struct Cell {
    size() -> i64 { return this.n as i64; }                //~ ERROR[E0118] method `size` does not say how it takes its receiver
}

function main() -> int {
    const c: Cell = Cell::make();
    return c.read();
}
