// E0315: a method's trait-object parameter refuses an argument whose type
// does not implement the trait, as a function's does - on a struct, on an
// array and on an instantiation of a generic struct whose parameter is the
// object - rather than finding no method of the name.
![config(testing)]
![config(negative, E0315)]
namespace CryoTests::Negative::MethodObjectArgument;

type trait Sink {
    put(mut &this, v: i64) -> i64;
}

type struct Other {
    total: i64;
}

type struct Holder {
    count: i64;

    swap_in(mut &this, sink: virtual mut &Sink) -> void { this.count = this.count + 1; }
}

type struct Keeper<T> {
    item: Option<T>;

    set(mut &this, item: T) -> void { this.item = Option::Some(item); }
}

function main() -> int {
    mut o: Other = Other { total: 0 };
    mut h: Holder = Holder { count: 0 };
    h.swap_in(&o);
    //~^ ERROR[E0315] `CryoTests::Negative::MethodObjectArgument::Other` does not implement `CryoTests::Negative::MethodObjectArgument::Sink`
    mut sinks: [virtual mut &Sink] = [];
    sinks.push(&o);
    //~^ ERROR[E0315] `CryoTests::Negative::MethodObjectArgument::Other` does not implement `CryoTests::Negative::MethodObjectArgument::Sink`
    mut k: Keeper<virtual mut &Sink> = Keeper::<virtual mut &Sink> { item: Option::None };
    k.set(&o);
    //~^ ERROR[E0315] `CryoTests::Negative::MethodObjectArgument::Other` does not implement `CryoTests::Negative::MethodObjectArgument::Sink`
    return 0;
}
