// E0407: the alternatives of one match arm bind one name at two types.  The
// name layer gives `v` one binding across the arm, so the body would read an
// `i32` where a `string` was stored, or the other way about.
![config(testing)]
![config(negative, E0407)]
namespace CryoTests::Negative::AlternativesBindDifferentTypes;

type enum Value {
    Num(i32);
    Text(string);
}

function show(x: Value) -> i32 {
    return match (x) {
        Value::Num(v) | Value::Text(v) => { 1 }   //~ ERROR[E0407] `v` has type `string` here but `i32` in the arm's first alternative
    };
}

function main() -> i32 {
    return show(Value::Num(4));
}
