// W0001: a local binding that is never referenced.
![config(testing)]
![config(negative, W0001)]
namespace CryoTests::Negative::W0001UnusedVariable;

// The left operand of `??` IS a reference, and carries no annotation below on
// purpose: once a file uses `//~` the check runs both ways, so a W0001 raised
// on `cf_used` would be an unannotated diagnostic and fail the suite.
//
// It regressed because the resolution map keys a reference by the START of its
// span alone, and the `??` desugar stamped its synthesized arm binding with the
// whole expression's span - which begins exactly where the operand begins. The
// synthetic name was recorded last and overwrote the operand's entry, so the
// operand read as never-referenced.
function cf_pick() -> u64 {
    const cf_used: Option<u64> = Option::Some(7);
    return cf_used ?? 0;
}

function main() -> int {
    const unused_local: int = 5;   //~ WARN[W0001] unused variable
    if (cf_pick() == 7) { return 0; }
    return 1;
}
