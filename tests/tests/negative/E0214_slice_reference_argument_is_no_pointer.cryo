// Compile-fail test: a slice reference is not passed where a pointer is
// wanted, nor a pointer where a slice reference is: one holds the slice's
// two words, the other an address.
![config(testing)]
![config(negative, E0214)]
namespace CryoTests::Negative::E0214SliceReferenceArgumentIsNoPointer;

import std::core::slice::{ Slice };

function through_pointer(p: void*) -> i64 {
    return 0;
}

function through_reference(r: &Slice<i32>) -> i64 {
    return r.length();
}

function both(r: &Slice<i32>, p: void*) -> i64 {
    return through_pointer(r)   //~ ERROR[E0214] mismatched types
        + through_reference(p);   //~ ERROR[E0214] mismatched types
}

function main() -> int {
    return 0;
}
