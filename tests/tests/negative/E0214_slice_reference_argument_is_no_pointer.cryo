// Compile-fail test: a slice reference is not passed where a pointer to a
// slice is wanted, nor a pointer where a slice reference is: one holds the
// slice's two words, the other a slice's address.
![config(testing)]
![config(negative, E0214)]
namespace CryoTests::Negative::E0214SliceReferenceArgumentIsNoPointer;

import std::core::slice::{ Slice };

function through_pointer(p: Slice<i32>*) -> i64 {
    return p.length();
}

function through_reference(r: &Slice<i32>) -> i64 {
    return r.length();
}

function both(r: &Slice<i32>, p: Slice<i32>*) -> i64 {
    return through_pointer(r)   //~ ERROR[E0214] mismatched types
        + through_reference(p);   //~ ERROR[E0214] mismatched types
}

function main() -> int {
    return 0;
}
