// E0401: a `switch` does not catch `continue` (only `break`).  With no
// enclosing loop, `continue` inside a case is still "outside a loop".  This
// pins the semantics codegen relies on: `break` exits the switch, but
// `continue` is forwarded to an enclosing loop - and errors when there is none.
![config(testing)]
![config(negative, E0401)]
namespace CryoTests::Negative::ContinueInSwitch;
function main() -> int {
    switch (1) {
        case 1: { continue; }   //~ ERROR[E0401] `continue` outside of a loop
        default: { }
    }
    return 0;
}
