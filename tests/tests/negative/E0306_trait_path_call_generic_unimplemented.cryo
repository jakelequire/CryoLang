// E0306: `Trait::method(receiver)` selects the receiver's implementation of
// the trait, so a receiver whose generic type does not implement it is
// refused at the path, as one of a non-generic type is.
![config(testing)]
![config(negative, E0306)]
namespace CryoTests::Negative::TraitPathCallGenericUnimplemented;

type trait CfShow {
    show(this) -> i32;
}

type struct CfHolder<T> { value: T; }
type struct CfLone<T> { value: T; }

implement<T> trait CfShow for struct CfHolder<T> {
    show(this) -> i32 { return 4; }
}

function main() -> int {
    const a: i32 = CfShow::show(CfHolder::<i32> { value: 1 });
    const b: i32 = CfShow::show(CfLone::<i32> { value: 2 });   //~ ERROR[E0306] `CfLone<i32>` does not implement `CfShow`
    return a + b;
}
