// E0200: inside a `static match (T)` arm, `T` is the arm's type, and the
// declared return type `T` reads as that type too. An `f64` arm returning a
// `string` is refused there, not deferred to the copies.
![config(testing)]
![config(negative, E0200)]
namespace CryoTests::Negative::StaticMatchArmReturnMismatch;

function widen<T>(x: T) -> T {
    static match (T) {
        f64 => { return "not a float"; }   //~ ERROR[E0200] mismatched types
        _   => { return x; }
    }
}

function main() -> i32 {
    return widen::<f64>(1.5) as i32;
}
