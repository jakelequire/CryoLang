// Compile-fail test: a method call that leaves one of the method's type
// parameters unbound - its own (`make<T>`) or one its implementation lends
// it because only the trait's arguments and the method's return name it
// (`T` of `implement<T> trait Ends<T> for Everything`) - is refused at the
// call rather than reaching code generation with no method to call, with
// or without arguments.  The calls writing the type argument, and the one
// whose expected type fixes it, are the controls.
![config(testing)]
![config(negative, E0307)]
namespace CryoTests::Negative::E0307MethodTypeParameterNothingBinds;

type trait Ends<T> {
    low(&this) -> Option<&T>;
}

type struct Everything { }

implement<T> trait Ends<T> for struct Everything {
    low(&this) -> Option<&T> { return Option::None; }
}

type struct Maker {
    make<T>(&this) -> Option<&T> { return Option::None; }
    sized<T>(&this, count: i64) -> Option<&T> { return Option::None; }
}

function main() -> int {
    const everything: Everything = Everything { };
    const a: boolean = everything.low().is_none();   //~ ERROR[E0307]
    const b: boolean = everything.low::<i64>().is_none();
    const c: Option<&u8> = everything.low();
    const maker: Maker = Maker { };
    const d: boolean = maker.make().is_none();   //~ ERROR[E0307]
    const e: boolean = maker.sized(3).is_none();   //~ ERROR[E0307]
    const f: boolean = maker.sized::<u8>(3).is_none();
    return 0;
}
