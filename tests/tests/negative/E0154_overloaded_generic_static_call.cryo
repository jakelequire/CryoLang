// E0154: a static call whose arguments more than one overload accepts, a
// generic one among them.  A non-generic overload does not outrank a generic
// one for being non-generic, and no generic overload outranks another.
![config(testing)]
![config(negative, E0154)]
namespace CryoTests::Negative::OverloadedGenericStaticCall;

type struct Tie { n: i32; }
implement struct Tie {
    static conv<U>(u: U, w: U) -> U { return w; }
    static conv(u: i32, w: i32) -> i32 { return w; }
}

type struct Two { n: i32; }
implement struct Two {
    static pick<U>(u: U) -> i32 { return 1; }
    static pick<U>(u: U*) -> i32 { return 2; }
}

function main() -> i32 {
    const a: i32 = Tie::conv(7, 8);
    //~^ ERROR[E0154] `conv` is ambiguous: a non-generic and a generic method of `Tie` both accept these arguments
    mut x: i32 = 4;
    const b: i32 = Two::pick(&x);
    //~^ ERROR[E0154] `pick` is ambiguous: more than one generic method of `Two` accepts these arguments
    return a + b;
}
