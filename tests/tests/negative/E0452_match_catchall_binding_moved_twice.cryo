// E0452: a catch-all arm's binding is the whole subject, taken by value and
// owned like any local; giving it away twice releases it twice.  The same
// program with `y` declared as a plain local has always been refused.
![config(testing)]
![config(negative, E0452)]
namespace CryoTests::Negative::E0452MatchCatchallBindingMovedTwice;

import std::core::option;
import std::core::option::{ Option };

type struct Res {
    tag: i32;

    drop(mut &this) -> void { }
}

function consume(r: Option<Res>) -> void { }

function f(o: Option<Res>) -> void {
    match (o) {
        y => { consume(y); consume(y); }
        //~^ ERROR[E0452] use of moved value 'y'
    }
}

function main() -> int { return 0; }
