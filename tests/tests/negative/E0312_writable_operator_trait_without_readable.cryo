// E0312: `IndexMutable<Idx, Output>` has `Index<Idx, Output>` as its
// supertrait and `DerefMutable<Target>` has `Deref<Target>`, so a type is
// written through `[]` or `*` only where it is also read through them, at
// the same index type and with the same element type.  An implementation
// of the writable trait is refused where it is written when the readable
// one is missing, or implemented only for another index or element type.
![config(testing)]
![config(negative, E0312)]
namespace CryoTests::Negative::WritableOperatorTraitWithoutReadable;

import std::core::ops::{ Index, IndexMutable, Deref, DerefMutable };

type struct Unread { cells: [i32; 2]; }

implement trait IndexMutable<u64, i32> for Unread {
    //~^ ERROR[E0312] `CryoTests::Negative::WritableOperatorTraitWithoutReadable::Unread` does not implement `std::core::ops::Index<u64, i32>`, which `std::core::ops::IndexMutable` requires, so `CryoTests::Negative::WritableOperatorTraitWithoutReadable::Unread` cannot implement `std::core::ops::IndexMutable`
    index_mutable(mut &this, i: u64) -> i32* { return &this.cells[i]; }
}

type struct Widened { cells: [i32; 2]; wide: [i64; 2]; }

implement trait Index<u64, i64> for Widened {
    index(&this, i: u64) -> const i64* { return &this.wide[i]; }
}

implement trait IndexMutable<u64, i32> for Widened {
    //~^ ERROR[E0312] `CryoTests::Negative::WritableOperatorTraitWithoutReadable::Widened` does not implement `std::core::ops::Index<u64, i32>`, which `std::core::ops::IndexMutable` requires, so `CryoTests::Negative::WritableOperatorTraitWithoutReadable::Widened` cannot implement `std::core::ops::IndexMutable`
    index_mutable(mut &this, i: u64) -> i32* { return &this.cells[i]; }
}

type struct OtherIndex { cells: [i32; 2]; }

implement trait Index<u64, i32> for OtherIndex {
    index(&this, i: u64) -> const i32* { return &this.cells[i]; }
}

implement trait IndexMutable<i32, i32> for OtherIndex {
    //~^ ERROR[E0312] `CryoTests::Negative::WritableOperatorTraitWithoutReadable::OtherIndex` does not implement `std::core::ops::Index<i32, i32>`, which `std::core::ops::IndexMutable` requires, so `CryoTests::Negative::WritableOperatorTraitWithoutReadable::OtherIndex` cannot implement `std::core::ops::IndexMutable`
    index_mutable(mut &this, i: i32) -> i32* { return &this.cells[i]; }
}

type struct Point { x: i32; }
type struct Label { text: i64; }

type struct Hidden { point: Point; }

implement trait DerefMutable<Point> for Hidden {
    //~^ ERROR[E0312] `CryoTests::Negative::WritableOperatorTraitWithoutReadable::Hidden` does not implement `std::core::ops::Deref<CryoTests::Negative::WritableOperatorTraitWithoutReadable::Point>`, which `std::core::ops::DerefMutable` requires, so `CryoTests::Negative::WritableOperatorTraitWithoutReadable::Hidden` cannot implement `std::core::ops::DerefMutable`
    deref_mutable(mut &this) -> Point* { return &this.point; }
}

type struct Twofaced { point: Point; label: Label; }

implement trait Deref<Label> for Twofaced {
    deref(&this) -> const Label* { return &this.label; }
}

implement trait DerefMutable<Point> for Twofaced {
    //~^ ERROR[E0312] `CryoTests::Negative::WritableOperatorTraitWithoutReadable::Twofaced` does not implement `std::core::ops::Deref<CryoTests::Negative::WritableOperatorTraitWithoutReadable::Point>`, which `std::core::ops::DerefMutable` requires, so `CryoTests::Negative::WritableOperatorTraitWithoutReadable::Twofaced` cannot implement `std::core::ops::DerefMutable`
    deref_mutable(mut &this) -> Point* { return &this.point; }
}

type struct Both { cells: [i32; 2]; point: Point; }

implement trait Index<u64, i32> for Both {
    index(&this, i: u64) -> const i32* { return &this.cells[i]; }
}

implement trait IndexMutable<u64, i32> for Both {
    index_mutable(mut &this, i: u64) -> i32* { return &this.cells[i]; }
}

implement trait Deref<Point> for Both {
    deref(&this) -> const Point* { return &this.point; }
}

implement trait DerefMutable<Point> for Both {
    deref_mutable(mut &this) -> Point* { return &this.point; }
}

function main() -> int {
    return 0;
}
