// E0312: `IndexMutable<Idx>` has `Index<Idx>` as its supertrait and
// `DerefMutable` has `Deref`, so a type is written through `[]` or `*` only
// where it is also read through them, at the same index type.  An
// implementation of the writable trait is refused where it is written when
// the read-only one is missing or implemented only for another index type.
// A type implementing both is the control.  An element type other than the
// read-only implementation's is E0312_writable_operator_trait_other_element.
![config(testing)]
![config(negative, E0312)]
namespace CryoTests::Negative::WritableOperatorTraitWithoutReadable;

import std::core::ops::{ Index, IndexMutable, Deref, DerefMutable };

type struct Unread { cells: [i32; 2]; }

implement trait IndexMutable<u64> for Unread {
    //~^ ERROR[E0312] `CryoTests::Negative::WritableOperatorTraitWithoutReadable::Unread` does not implement `std::core::ops::Index<u64>`, which `std::core::ops::IndexMutable` requires, so `CryoTests::Negative::WritableOperatorTraitWithoutReadable::Unread` cannot implement `std::core::ops::IndexMutable`
    index_mutable(mut &this, i: u64) -> i32* { return &this.cells[i]; }
}

type struct OtherIndex { cells: [i32; 2]; }

implement trait Index<u64> for OtherIndex {
    type Output = i32;
    index(&this, i: u64) -> const i32* { return &this.cells[i]; }
}

implement trait IndexMutable<i32> for OtherIndex {
    //~^ ERROR[E0312] `CryoTests::Negative::WritableOperatorTraitWithoutReadable::OtherIndex` does not implement `std::core::ops::Index<i32>`, which `std::core::ops::IndexMutable` requires, so `CryoTests::Negative::WritableOperatorTraitWithoutReadable::OtherIndex` cannot implement `std::core::ops::IndexMutable`
    index_mutable(mut &this, i: i32) -> i32* { return &this.cells[i]; }
}

type struct Point { x: i32; }

type struct Hidden { point: Point; }

implement trait DerefMutable for Hidden {
    //~^ ERROR[E0312] `CryoTests::Negative::WritableOperatorTraitWithoutReadable::Hidden` does not implement `std::core::ops::Deref`, which `std::core::ops::DerefMutable` requires, so `CryoTests::Negative::WritableOperatorTraitWithoutReadable::Hidden` cannot implement `std::core::ops::DerefMutable`
    deref_mutable(mut &this) -> Point* { return &this.point; }
}

type struct Both { cells: [i32; 2]; point: Point; }

implement trait Index<u64> for Both {
    type Output = i32;
    index(&this, i: u64) -> const i32* { return &this.cells[i]; }
}

implement trait IndexMutable<u64> for Both {
    index_mutable(mut &this, i: u64) -> i32* { return &this.cells[i]; }
}

implement trait Deref for Both {
    type Target = Point;
    deref(&this) -> const Point* { return &this.point; }
}

implement trait DerefMutable for Both {
    deref_mutable(mut &this) -> Point* { return &this.point; }
}

function main() -> int {
    return 0;
}
