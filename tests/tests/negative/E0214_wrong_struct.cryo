// E0214: one struct passed where an unrelated struct is expected.
![config(testing)]
![config(negative, E0214)]
namespace CryoTests::Negative::E0214WrongStruct;
type struct CfA { v: i32; }
type struct CfB { v: i32; }
function cf_take_a(a: CfA) -> void {}
function main() -> int {
    const b: CfB = CfB { v: 1 };
    cf_take_a(b);
    return 0;
}
