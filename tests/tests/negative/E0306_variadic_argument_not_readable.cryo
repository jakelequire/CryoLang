// E0306: a variadic call passes the arguments past its declared parameters
// with no type, and the callee reads each back as a `VariadicArgument` type
// or a pointer.  Any other value is refused where it is passed: an aggregate
// (`Str`, `String`), a scalar narrower than `i32` or `f64`, and a type
// parameter no bound in scope gives `VariadicArgument`.  A `string`, a
// 64-bit integer, a pointer and a bounded type parameter are passed as they
// are.
![config(testing)]
![config(negative, E0306)]
namespace CryoTests::Negative::E0306VariadicArgumentNotReadable;

import std::fmt;
import std::collections::str::{ Str };
import std::collections::string::{ String };

function pass_bounded<T>(value: T) -> String where T: VariadicArgument {
    return fmt::format("%lld", value);
}

function pass_unbounded<T>(value: T) -> String {
    return fmt::format("%lld", value);
    //~^ ERROR[E0306] the trait bound `T: VariadicArgument` is not satisfied
}

function main() -> int {
    const view: Str = Str::new("hello world").byte_substring(0, 5);
    const owned: String = String::from_str(view);
    const port: u16 = 8080;
    const small: i8 = 3;
    const flag: boolean = true;
    const half: f32 = 1.5;
    const text: string = "ok";
    const at: u8* = view.as_pointer();
    const wide: i64 = 7;
    const fine: String = fmt::format("%s %p %.*s %lld", text, at, view.length() as i32, at, wide);
    const bounded: String = pass_bounded(wide);
    const a: String = fmt::format("[%s] [%d]", view, 7);
    //~^ ERROR[E0306] the trait bound `std::collections::str::Str: VariadicArgument` is not satisfied
    const b: String = fmt::format("%s", owned);
    //~^ ERROR[E0306] the trait bound `std::collections::string::String<std::alloc::allocator::GlobalAllocator>: VariadicArgument` is not satisfied
    const c: String = fmt::format("%u", port);
    //~^ ERROR[E0306] the trait bound `u16: VariadicArgument` is not satisfied
    const d: String = fmt::format("%d", small);
    //~^ ERROR[E0306] the trait bound `i8: VariadicArgument` is not satisfied
    const e: String = fmt::format("%d", flag);
    //~^ ERROR[E0306] the trait bound `boolean: VariadicArgument` is not satisfied
    const f: String = fmt::format("%f", half);
    //~^ ERROR[E0306] the trait bound `f32: VariadicArgument` is not satisfied
    return 0;
}
