// `usize` and `isize` are as wide as a pointer, 32 or 64 bits by target, so a
// conversion into or out of one is implicit only where it keeps every value
// on every target: into `usize` from an unsigned of at most 32 bits, out of
// it into an unsigned of at least 64.  `u64` into `usize` would truncate on a
// 32-bit target, and `usize` into `i64` would change the top half of a
// 64-bit one, so both are refused.
![config(testing)]
![config(negative, E0200)]
namespace CryoTests::Negative::PointerSizedIntegerConversions;

public function cf_refused(wide: u64, signed_wide: i64, size: usize, offset: isize) -> boolean {
    const narrowed: usize = wide;
    //~^ ERROR[E0200] mismatched types
    const narrowed_signed: isize = signed_wide;
    //~^ ERROR[E0200] mismatched types
    const reinterpreted: i64 = size;
    //~^ ERROR[E0200] mismatched types
    const as_unsigned: usize = offset;
    //~^ ERROR[E0200] mismatched types
    return narrowed > 0 && narrowed_signed > 0 && reinterpreted > 0 && as_unsigned > 0;
}

public function cf_kept(word: u32, small: i16, size: usize, offset: isize) -> boolean {
    const into_size: usize = word;
    const into_offset: isize = small;
    const out_of_size: u64 = size;
    const out_of_offset: i64 = offset;
    return into_size > 0 && into_offset > 0 && out_of_size > 0 && out_of_offset > 0;
}
