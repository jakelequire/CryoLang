// E0108: a lambda body must be brace-delimited.  The brace-less
// single-expression form `(params) -> Ret expr` used to be accepted
// by the parser but codegen wrapped the body as an expression
// statement (discarding the result) rather than a return - so the
// lambda evaluated, returned void into a non-void slot, and SIGSEGV'd
// on the first call.  Until that form is properly desugared, reject
// it at parse time with a hint at the braced form.
![config(testing)]
![config(negative, E0108)]
namespace CryoTests::Negative::E0108LambdaMissingBrace;

function main() -> int {
    const f = (n: i32) -> i32 n * 2;
    return f(21);
}
