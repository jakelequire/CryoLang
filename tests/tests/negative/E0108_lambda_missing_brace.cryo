// E0108: a lambda body must be brace-delimited.  The brace-less
// single-expression form `(params) -> Ret expr` is rejected at parse time
// with a hint at the braced form, until that form is properly desugared.
// If accepted, codegen would wrap the body as an expression statement
// (discarding the result) rather than a return - so the lambda would
// evaluate, return void into a non-void slot, and SIGSEGV on the first call.
![config(testing)]
![config(negative, E0108)]
namespace CryoTests::Negative::E0108LambdaMissingBrace;

function main() -> int {
    const f = (n: i32) -> i32 n * 2;
    return f(21);
}
