// E0318: a `with` clause generates only `Eq`, `Ord`, `Hash`, `Clone`,
// `Debug` and `Default`, chosen by the trait's name as written.  A standard
// trait with no generated implementation, a module's own trait, a trait
// written with arguments and a derivable trait imported under another name
// are each refused at their entry.  A derivable trait spelled qualified is
// the control.
![config(testing)]
![config(negative, E0318)]
namespace CryoTests::Negative::E0318DeriveNotDerivable;

import std::core::cmp;
import std::fmt::display::{ Display };
import std::core::convert::{ From };
import std::core::hash::{ Hash as Hashing };

type trait NdShown {
    shown(&this) -> i64;
}

type struct NdDisplay with [Display] {   //~ ERROR[E0318] `Display` cannot be derived
    x: i64;
}

type struct NdOwnTrait with [NdShown] {   //~ ERROR[E0318] `NdShown` cannot be derived
    x: i64;
}

type struct NdWithArguments with [From<i64>] {   //~ ERROR[E0318] `From<i64>` cannot be derived
    x: i64;
}

type struct NdAliased with [Hashing] {   //~ ERROR[E0318] `Hashing` cannot be derived
    x: i64;
}

type struct NdQualified with [cmp::Eq] {
    x: i64;
}

function main() -> i32 {
    return 0;
}
