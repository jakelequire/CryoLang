// Compile-fail test: read access never becomes write access through a fixed
// array's slice conversion.  A `&[T; N]`, or `&x` of a `const` fixed array,
// where a `mut &Slice<T>` is wanted is refused, for an argument and a
// declared binding; the writable borrow of a writable array is the control.
![config(testing)]
![config(negative, E0251)]
namespace CryoTests::Negative::E0251ReadOnlyFixedArrayForAWritableSlice;

import std::core::slice::{ Slice };

function write_each(items: mut &Slice<i32>) -> void {
    for (mut i: i64 = 0; i < items.length(); i++) {
        items[i] = 0;
    }
}

function from_borrow(values: &[i32; 4]) -> void {
    write_each(values);   //~ ERROR[E0251]
}

function from_const() -> void {
    const values: [i32; 4] = [1, 2, 3, 4];
    write_each(&values);   //~ ERROR[E0251]
    mut writable: [i32; 4] = [1, 2, 3, 4];
    write_each(&writable);
}

function into_binding(values: &[i32; 4]) -> void {
    const view: mut &Slice<i32> = values;   //~ ERROR[E0251]
}

function main() -> int {
    return 0;
}
