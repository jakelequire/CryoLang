// E0312: an `Allocate` implementation is checked against the trait like any
// other.  `allocate` takes the size and the alignment; one that takes only
// the size is refused at its declaration rather than reaching code
// generation, where `new` would call it with two arguments.
![config(testing)]
![config(negative, E0312)]
namespace CryoTests::Negative::AllocateWrongShape;

import std::ffi::libc;

type class Node {
public:
    v: i32;
    Node(v: i32) { this.v = v; }
}

implement trait Allocate for class Node {
    static allocate(size: u64) -> void* {          //~ ERROR[E0312] `allocate` takes 2 parameter(s) in trait `Allocate`, but 1 here
        return libc::malloc(size);
    }
}

function main() -> int {
    const n: Node* = new Node(3);
    return n.v - 3;
}
