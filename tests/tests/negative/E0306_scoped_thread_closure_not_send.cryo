// E0306: a closure given to the scope's `spawn` may borrow, but what it
// borrows or owns must still be thread-safe.  The scope's handle is not
// (`Scope` records its threads without a lock), so a scoped thread cannot
// spawn through it; nor is an `Rc`.  A borrowing closure over a `Sync`
// value is the control.
![config(testing)]
![config(negative, E0306)]
namespace CryoTests::Negative::ScopedThreadClosureNotSend;

import std::thread;
import std::alloc::rc::{ Rc };
import std::collections::string::{ String };

function main() -> int {
    const shared: Rc<i64> = Rc::<i64>::new(1);
    const word: String = String::from("ok");
    thread::scope((s: mut &thread::Scope) -> void {
        s.spawn(() -> void { s.spawn(() -> void { }); });
        //~^ ERROR[E0306] is not satisfied
        s.spawn(() -> void { const n: i64 = *shared.as_ptr(); });
        //~^ ERROR[E0306] is not satisfied
        s.spawn(() -> void { const n: i64 = word.length() as i64; });
    });
    return 0;
}
