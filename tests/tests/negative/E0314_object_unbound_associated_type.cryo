// E0314: a supertrait written without arguments leaves its associated types
// unbound in an object of the subtrait, so a supertrait method whose
// signature names one cannot be called through it; the object's other
// methods stay callable, and an object of the supertrait itself, which
// binds it, calls the method.
![config(testing)]
![config(negative, E0314)]
namespace CryoTests::Negative::ObjectUnboundAssociatedType;

type trait Pick {
    type Out;
    pick(&this, a: This::Out) -> This::Out;
    count(&this) -> i32;
}

type trait Twice : Pick {
    twice(&this) -> i32;
}

type struct Square {
    side: i64;
}

implement trait Pick for Square {
    type Out = i64;
    pick(&this, a: i64) -> i64 { return a; }
    count(&this) -> i32 { return 1; }
}

implement trait Twice for Square {
    twice(&this) -> i32 { return 2; }
}

function main() -> int {
    const q: Square = Square { side: 4 };
    const t: virtual &Twice = &q;
    const x: i64 = t.pick(3);
    //~^ ERROR[E0314] `pick` cannot be called through `virtual &CryoTests::Negative::ObjectUnboundAssociatedType::Twice`
    const p: virtual &Pick<i64> = &q;
    const y: i64 = p.pick(3);
    return t.twice() + t.count();
}
