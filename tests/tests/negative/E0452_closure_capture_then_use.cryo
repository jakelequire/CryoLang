// E0452: a non-Copy binding captured by a closure has moved into it, so a
// later use of the outer binding reads a value that is gone.
//
// Regression test for a capture recorded as a move by its SPELLING alone.
// The move checker records the capture by synthesizing a use of the captured
// name; once its move set was keyed by the binding a use names, that use -
// minted from the spelling, carrying no answer - named nothing, the capture's
// move went unrecorded, and this program was accepted and released `p` twice
// (once by `consume`, once by the closure).  The capture now carries the
// binding it names.
![config(testing)]
![config(negative, E0452)]
namespace CryoTests::Negative::ClosureCaptureThenUse;

type struct Res {
    tag: i32;
    drop(mut &this) -> void { }
}

function consume(r: Res) -> i32 { return r.tag; }

function main() -> int {
    const p: Res = Res { tag: 1 };
    const f = () -> i32 { return p.tag; };   // captures `p` by move
    consume(p);
    //~^ ERROR[E0452] use of moved value 'p'
    return f();
}
