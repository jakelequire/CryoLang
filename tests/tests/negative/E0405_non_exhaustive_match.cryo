// E0405: match omits CfC::Blue.
![config(testing)]
![config(negative, E0405)]
namespace CryoTests::Negative::E0405NonExhaustiveMatch;
type enum CfC { Red; Green; Blue; }
function main() -> int {
    const c: CfC = CfC::Red;
    match (c) { CfC::Red => {} CfC::Green => {} }   //~ ERROR[E0405] non-exhaustive match: not all
    return 0;
}
