// E0306: an argument with a type of its own keeps it under a method's
// bound. `narrow` is a `Range<i32>`, so `map.range(narrow)` on an
// `i64`-keyed map is refused; only a range or a static call written without
// its owner's type arguments (`map.range(1..3)`) takes them from the bound.
![config(testing)]
![config(negative, E0306)]
namespace CryoTests::Negative::E0306TypedArgumentKeepsItsTypeForABound;

import std::collections::btree_map::{ BTreeMap };
import std::core::ops::{ Range };

function walk() -> i64 {
    const map: BTreeMap<i64, i64> = BTreeMap::new();
    const narrow: Range<i32> = 1..3;
    mut count: i64 = 0;
    for (entry in map.range(narrow)) {
    //~^ ERROR[E0306] the trait bound `std::core::ops::Range<i32>: RangeBounds<i64>` is not satisfied
        count += 1;
    }
    return count;
}
