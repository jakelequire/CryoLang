// E0209: `switch` compares by value and can't destructure payloads, so it
// can't be used on an enum whose variants carry data — the diagnostic points
// the user at `match` instead.
![config(testing)]
![config(negative, E0209)]
namespace CryoTests::Negative::SwitchOnPayloadEnum;
type enum Shape { Circle(f64); Square(i32); }
function main() -> int {
    const s: Shape = Shape::Square(3);
    switch (s) {
        default: { }
    }
    return 0;
}
