// E0214: a method a number type declares in its own `implement` block has
// its arguments checked like any other method's.  A read-only pointer given
// for a writable buffer parameter is refused, and so is an argument that
// does not convert to its parameter: the method is found, and the report is
// at the argument, not "no method named".  The same calls with arguments of
// the parameters' types are accepted.
![config(testing)]
![config(negative, E0214)]
namespace CryoTests::Negative::E0214PrimitiveMethodArgumentsAreChecked;

function format_into_read_only(value: u64, buffer: u8*) -> i64 {
    return value.to_decimal_buf(buffer);    //~ ERROR[E0214] mismatched types
}

function clamp_with_a_wider_bound(small: i32, wide: i64) -> i32 {
    return small.clamp(wide, 9);            //~ ERROR[E0214] mismatched types
}

function main() -> int {
    mut digits: [u8; 24] = [0; 24];
    const value: u64 = 5;
    value.to_decimal_buf(&digits[0]);
    const small: i32 = 3;
    small.clamp(1, 9);
    return 0;
}
