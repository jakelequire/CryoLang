// E0208: a cast whose target is a struct, class, tuple or array value and
// whose operand is of any other type.  Nothing builds such a value from a
// pointer or from a different aggregate; a class converts along its
// hierarchy by pointer, and `*p` reads the value a pointer points at.
![config(testing)]
![config(negative, E0208)]
namespace CryoTests::Negative::CastIntoOtherAggregate;

type class Animal {
public:
    legs: i32;
    Animal(n: i32) { this.legs = n; }
}

type class Dog : Animal {
public:
    good: i32;
    Dog(n: i32) : Animal(n) { this.good = 1; }
}

type struct A { x: i32; }
type struct B { x: i32; }

function main() -> int {
    const p: Animal* = new Animal(4);
    const d: Dog* = new Dog(4);
    const av: Animal = *p;
    const dv: Dog = *d;
    const a: A = A { x: 1 };
    const v1: Animal = p as Animal;   //~ ERROR[E0208] cannot cast `CryoTests::Negative::CastIntoOtherAggregate::Animal*` to `CryoTests::Negative::CastIntoOtherAggregate::Animal`
    const v2: Animal = dv as Animal;  //~ ERROR[E0208] cannot cast `CryoTests::Negative::CastIntoOtherAggregate::Dog` to `CryoTests::Negative::CastIntoOtherAggregate::Animal`
    const v3: Dog = av as Dog;        //~ ERROR[E0208] cannot cast `CryoTests::Negative::CastIntoOtherAggregate::Animal` to `CryoTests::Negative::CastIntoOtherAggregate::Dog`
    const v4: B = a as B;             //~ ERROR[E0208] cannot cast `CryoTests::Negative::CastIntoOtherAggregate::A` to `CryoTests::Negative::CastIntoOtherAggregate::B`
    const up: Animal* = d as Animal*;
    const same: A = a as A;
    return up.legs + same.x;
}
