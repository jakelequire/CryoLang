// E0208: a cast whose target is a struct, tuple or array value and whose
// operand is of any other type.  Nothing builds such a value from a pointer
// or from a different aggregate; `*p` reads the value a pointer points at.
![config(testing)]
![config(negative, E0208)]
namespace CryoTests::Negative::CastIntoOtherAggregate;

type struct A { x: i32; }
type struct B { x: i32; }

function main() -> int {
    const p: A* = new A { x: 4 };
    const a: A = A { x: 1 };
    const v4: B = a as B;             //~ ERROR[E0208] cannot cast `CryoTests::Negative::CastIntoOtherAggregate::A` to `CryoTests::Negative::CastIntoOtherAggregate::B`
    const same: A = a as A;
    return p.x + same.x;
}
