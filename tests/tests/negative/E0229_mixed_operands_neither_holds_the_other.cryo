// Two numeric operands of different types compute in the one that holds
// every value of the other.  Where neither does - same-width integers of
// opposite sign, an integer a float cannot hold exactly - any common type
// would change some value, so the operation is refused and one side is
// converted with `as`.  The pairs that do widen pass silently, and two
// integers compare by their true values whatever their signs.
![config(testing)]
![config(negative, E0229)]
namespace CryoTests::Negative::MixedOperandsNeitherHoldsTheOther;

public function cf_refused(a: i32, b: u32, n: i64, f: f64, m: u64, s: i8) -> boolean {
    const sum: i32 = a + b;
    //~^ ERROR[E0229] `+` on `i32` and `u32`: neither type holds every value of the other, so one side must be converted with `as`
    const scaled: f64 = n * f;
    //~^ ERROR[E0229] `*` on `i64` and `f64`: neither type holds every value of the other, so one side must be converted with `as`
    const masked: u64 = m & s;
    //~^ ERROR[E0229] `&` on `u64` and `i8`: neither type holds every value of the other, so one side must be converted with `as`
    const below: boolean = n < f;
    //~^ ERROR[E0229] `<` on `i64` and `f64`: neither type holds every value of the other, so one side must be converted with `as`
    return below && sum > 0 && scaled > 0.0 && masked > 0;
}

public function cf_widened(a: i32, small: i8, byte: u8, f: f32, d: f64, half: i16, x: i64, y: u64) -> boolean {
    const sum: i32 = a + small;
    const mixed: i32 = a - byte;
    const wide: f64 = f * d;
    const exact: f32 = f + half;
    const less: boolean = x < y;
    return less && sum > mixed && wide > 0.0 && exact > 0.0;
}
