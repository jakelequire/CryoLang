// E0010: an integer literal stored where a `char` is must be a Unicode
// scalar value, at most 0x10FFFF.  One above it is refused in an
// initializer, an assignment and an argument; 0x10FFFF itself is held.
![config(testing)]
![config(negative, E0010)]
namespace CryoTests::Negative::CharLiteralBeyondUnicode;

function take(c: char) -> u32 { return c as u32; }

function main() -> int {
    const highest: char = 0x10FFFF;
    const a: char = 0x110000;
    //~^ ERROR[E0010] integer literal `0x110000` is out of range for type `char`, whose largest value is U+10FFFF
    mut b: char = 'a';
    b = 4294967295;
    //~^ ERROR[E0010] integer literal `4294967295` is out of range for type `char`, whose largest value is U+10FFFF
    const c: u32 = take(1114112);
    //~^ ERROR[E0010] integer literal `1114112` is out of range for type `char`, whose largest value is U+10FFFF
    if (highest != char::MAX || b != a || c != 0) { return 1; }
    return 0;
}
