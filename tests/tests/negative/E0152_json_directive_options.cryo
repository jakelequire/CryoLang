// E0152: `![json(...)]` takes `rename = "key"`, `skip`, `default` and
// `skip_none`; an option it does not know and a `rename` without a string
// are refused.  A field with several known options is the control.
![config(testing)]
![config(negative, E0152)]
namespace CryoTests::Negative::E0152JsonDirectiveOptions;

import std::json::convert::{ FromJson, ToJson };

type struct JoFields with [ToJson, FromJson] {
    ![json(flatten)]   //~ ERROR[E0152] directive `![json]`: unknown option
    first: i64;
    ![json(rename = 3)]   //~ ERROR[E0152] directive `![json]`: unknown option
    second: i64;
    ![json(rename = "third_key", default, skip_none)]
    third: Option<i64>;
}

function main() -> i32 {
    return 0;
}
