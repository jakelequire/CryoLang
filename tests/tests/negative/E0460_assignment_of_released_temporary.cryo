// E0460: an assignment that would leave a local pointing into a temporary
// the assignment made.
//
// A value made in a statement and only borrowed there is released when the
// statement ends, and an assignment is a statement like a declaration: a
// local given a borrow of the temporary outlives it, whether the local was
// declared with a value or without one. Each case reaches the temporary a
// different way: a borrowing method's receiver, a chain of results that
// carry the borrow on, a field of a temporary, an argument passed by
// reference, and a borrowed view passed on by value. The permitted side -
// an owned result, a scalar, a borrow of a binding - is
// lang/borrowed_temporary_bindings.cryo.
![config(testing)]
![config(negative, E0460)]
namespace CryoTests::Negative::AssignmentOfReleasedTemporary;

import std::collections::array::{ Array };
import std::collections::str::{ Str };
import std::collections::string::{ String };

type struct Holder {
    words: Array<String>;
}

function make_words() -> Array<String> {
    mut words: Array<String> = Array::<String>::new();
    words.push(String::from_str(Str::new("hello")));
    return words;
}

function make_string() -> String {
    return String::from_str(Str::new("text"));
}

function make_holder() -> Holder {
    return Holder { words: make_words() };
}

function view(text: &String) -> Str {
    return text.as_str();
}

function passed_on(text: Str) -> Str {
    return text;
}

function main() -> int {
    mut plain: Str = Str::new("");
    plain = make_string().as_str();
    //~^ ERROR[E0460] `plain` would point into a temporary that is released at the end of this assignment
    mut first: Str;
    first = make_words().get_reference(0).unwrap().as_str();
    //~^ ERROR[E0460] `first` would point into a temporary that is released at the end of this assignment
    mut held: Str = Str::new("");
    held = make_holder().words.get_reference(0).unwrap().as_str();
    //~^ ERROR[E0460] `held` would point into a temporary that is released at the end of this assignment
    mut viewed: Str = Str::new("");
    viewed = view(make_string());
    //~^ ERROR[E0460] `viewed` would point into a temporary that is released at the end of this assignment
    mut carried: Str = Str::new("");
    carried = passed_on(make_string().as_str());
    //~^ ERROR[E0460] `carried` would point into a temporary that is released at the end of this assignment
    return (plain.length() + first.length() + held.length() + viewed.length() + carried.length()) as int;
}
