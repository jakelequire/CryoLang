// E0465: an integer `+`, `-`, `*`, `/` or negation whose operands are
// constants and whose true result its type does not hold.  It overflows
// whenever it runs - a panic where the build checks for overflow, a wrapped
// value where it does not - so it is refused in every profile.  A `%` whose
// division overflows (`MIN % -1`) is refused too: its value 0 fits, but
// computing it panics in every profile.  Each refusal
// names the value and helps with a wider type and the wrapping method.  An
// overflow inside a larger constant expression is reported once, where it
// happens.  A negated literal is one literal (`-128` as an `i8` is held), a
// constant expression whose value fits is accepted, and an expression made
// only of literals in a typed place is the literal rule's (E0010).
![config(testing)]
![config(negative, E0465)]
namespace CryoTests::Negative::ConstantOverflow;

const SMALL: u8 = 200;
const ONE: u32 = 1;
const SUM: u8 = SMALL + 100;
//~^ ERROR[E0465] `SMALL + 100` overflows `u8`: its value is 300, which `u8` does not hold
const PAST: i32 = i32::MAX + 1;
//~^ ERROR[E0465] `i32::MAX + 1` overflows `i32`: its value is 2147483648, which `i32` does not hold
const NEGATED: i32 = -i32::MIN;
//~^ ERROR[E0465] `-i32::MIN` overflows `i32`: its value is 2147483648, which `i32` does not hold
const PRODUCT: i64 = i64::MIN * -1;
//~^ ERROR[E0465] `i64::MIN * -1` overflows `i64`: its value is 9223372036854775808, which `i64` does not hold
const QUOTIENT: i32 = i32::MIN / -1;
//~^ ERROR[E0465] `i32::MIN / -1` overflows `i32`: its value is 2147483648, which `i32` does not hold
const UNDER: u32 = 0 - ONE;
//~^ ERROR[E0465] `0 - ONE` overflows `u32`: its value is -1, which `u32` does not hold
const INNER: i8 = i8::MAX + 1 - 1;
//~^ ERROR[E0465] `i8::MAX + 1` overflows `i8`: its value is 128, which `i8` does not hold
const REMAINDER: i32 = i32::MIN % -1;
//~^ ERROR[E0465] `i32::MIN % -1` always panics: the division it is the remainder of has the quotient 2147483648, which `i32` does not hold
const WIDEST_REMAINDER: i128 = i128::MIN % -1;
//~^ ERROR[E0465] `i128::MIN % -1` always panics: the division it is the remainder of has the quotient 170141183460469231731687303715884105728, which `i128` does not hold
const LEAST: i8 = -128;
const EDGE: u8 = SMALL + 55;
const STILL: i32 = i32::MIN / 1;
const HALVED: i32 = i32::MIN % 2;
const WIDENED: i64 = (i32::MIN as i64) % -1;
const UNSIGNED_REMAINDER: u32 = u32::MAX % 7;

function take(value: u8) -> u8 {
    return value;
}

function main() -> int {
    const local: u8 = SMALL + 56;
    //~^ ERROR[E0465] `SMALL + 56` overflows `u8`: its value is 256, which `u8` does not hold
    const argument: u8 = take(u8::MAX + 1);
    //~^ ERROR[E0465] `u8::MAX + 1` overflows `u8`: its value is 256, which `u8` does not hold
    const untyped = 4294967295 * 4294967295 * 4294967295;
    //~^ ERROR[E0465] `(4294967295 * 4294967295) * 4294967295` overflows `u64`: its value is 79228162458924105385300197375, which `u64` does not hold
    return 0;
}
