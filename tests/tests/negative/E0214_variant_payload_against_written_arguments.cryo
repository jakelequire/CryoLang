// E0214: a variant constructed in an instance its path writes - on the enum
// (`Result::<i32, i32>::Ok`) or on the variant (`Result::Ok::<i32, i32>`) -
// takes its payload in that instance, so an argument the instance's payload
// type does not accept is refused at the argument.
![config(testing)]
![config(negative, E0214)]
namespace CryoTests::Negative::E0214VariantPayloadAgainstWrittenArguments;

import std::core::result::{ Result };

function main() -> int {
    const _r = Result::<i32, i32>::Ok("x");
    //~^ ERROR[E0214] mismatched types
    const _q = Result::Ok::<i32, i32>("x");
    //~^ ERROR[E0214] mismatched types
    const _o = Option::<i64>::Some(true);
    //~^ ERROR[E0214] mismatched types
    return 0;
}
