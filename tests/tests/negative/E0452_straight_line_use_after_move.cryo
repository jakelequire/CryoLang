// E0452: a non-Copy value moved by a by-value call argument and then
// read again on a straight-line path. `consume(a)` moves `a` into the
// callee, which drops its storage at function exit; re-binding `a` to
// `b` bitwise-copies the now-freed owning handle, so `b`'s scope-exit
// drop frees the same allocation a second time - a double free.
//
// Regression test: within-iteration use-after-move must be a hard error, not
// warn-only - a mere warning would still let the compiler produce a binary
// that double-frees at runtime (valgrind: "Invalid free"). The unsound
// binary must never be emitted.
![config(testing)]
![config(negative, E0452)]
namespace CryoTests::Negative::StraightLineUseAfterMove;

type struct Heap {
    p: void*;
}

implement trait Drop for struct Heap {
    drop(mut &this) -> void { free(this.p); }
}

function consume(h: Heap) -> void {
    // by-value owning parameter: drops `h` at function exit.
}

function main() -> int {
    mut a: Heap = Heap { p: malloc(16) };
    consume(a);          // moves `a`; its storage is freed by `consume`
    mut b: Heap = a;     // use-after-move: re-binds the freed handle -> double free   //~ ERROR[E0452] use of moved value 'a'
    return 0;
}
