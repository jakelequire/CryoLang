// E0200: a comparison's operands are one type.  Two enums are unrelated
// types even when their variants line up by position, so `A::Z == B::W` is
// refused rather than comparing the two discriminants (which would answer
// true).  An enum compared with its own variants is unaffected.
![config(testing)]
![config(negative, E0200)]
namespace CryoTests::Negative::CompareUnrelatedEnums;

type enum A { X; Z; }
type enum B { Y; W; }

function main() -> int {
    const a: A = A::Z;
    mut r: int = 0;
    if (a == B::Y) { r = r + 1; }    //~ ERROR[E0200] Enums::A` with `CryoTests::Negative::CompareUnrelatedEnums::B`: they are unrelated types
    if (a != B::W) { r = r + 2; }    //~ ERROR[E0200] Enums::A` with `CryoTests::Negative::CompareUnrelatedEnums::B`: they are unrelated types
    if (a == A::X) { r = r + 4; }
    return r;
}
