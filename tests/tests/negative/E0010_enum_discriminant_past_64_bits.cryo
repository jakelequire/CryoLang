// E0010: an enum's tag is at most 64 bits, so a discriminant no 64-bit
// pattern holds is refused: a computed one, and the one a variant takes
// after a predecessor at `u64::MAX`.
![config(testing)]
![config(negative, E0010)]
namespace CryoTests::Negative::E0010EnumDiscriminantPast64Bits;

type enum Wide : u64 {
    Top = 0xFFFF_FFFF_FFFF_FFFF;
    Past;
    //~^ ERROR[E0010] the discriminant of `Past`, 18446744073709551616, does not fit in 64 bits
    Far = 1 << 70;
    //~^ ERROR[E0010] the discriminant of `Far`, 1180591620717411303424, does not fit in 64 bits
}

function main() -> i32 {
    return Wide::Top as i32;
}
