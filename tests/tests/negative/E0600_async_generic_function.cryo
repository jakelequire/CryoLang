// E0600: a generic `async function` is not supported yet.
//
// The state machine is built from the typed body, and a generic body is still
// symbolic at that point - the awaited types, and so the sub-future fields that
// have to carry them, are not known until monomorphization.  Reported at the
// declaration rather than left to the use site, where the absent lowering
// surfaced as an unresolved generic instantiation from inside the future
// machinery (an internal-error shape, not a diagnostic).
![config(testing)]
![config(negative, E0600)]
namespace CryoTests::Negative::E0600AsyncGenericFunction;

import std::future;

async function identity<T>(v: T) -> T {   //~ ERROR[E0600] async: a generic `async function` is not supported yet
    const _z: i64 = await PendingThenReady<i64>::new(1, 1);
    return v;
}

function main() -> int { return 0; }
