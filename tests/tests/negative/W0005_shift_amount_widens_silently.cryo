// W0005: a shift's amount widening to the shifted value's type changes no
// value, so it draws no warning.  Only the shifted value widening, to an
// amount wider than itself, is reported.  An annotated file is checked both
// ways: a W0005 at any of the narrower amounts is unannotated and fails the
// suite.
![config(testing)]
![config(negative, W0005)]
namespace CryoTests::Negative::W0005ShiftAmountWidensSilently;

public function cf_narrower_amounts(x: u64, n: u32, y: i64, m: u8) -> u64 {
    const top: u64 = 1 << (u64::BITS - 1);
    const left: u64 = x << n;
    const right: i64 = y >> m;
    return top | left | (right as u64);
}

public function cf_wider_amount(b: u8, n: u64) -> u64 {
    return b << n;   //~ WARN[W0005] implicit conversion between `u8` and `u64`
}

function main() -> int {
    return 0;
}
