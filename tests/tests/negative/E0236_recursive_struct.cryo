// E0236: a struct that contains itself by value has infinite size and
// must be rejected.  (Pointer indirection - `next: S*` - is finite and
// stays legal; that path is covered by lang/structs.cryo / pointers.cryo.)
![config(testing)]
![config(negative, E0236)]
namespace CryoTests::Negative::E0236RecursiveStruct;

type struct S {
    x: S;
}

function main() -> int { return 0; }
