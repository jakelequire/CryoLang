// E0214: an array literal of literals takes the type another argument binds
// its parameter's `T` to only where every literal can be that type, and is
// refused once where one cannot.  An integer literal out of the bound type's
// range is refused at the literal.
![config(testing)]
![config(negative, E0214)]
namespace CryoTests::Negative::E0214LiteralArrayTypeParameterRefusals;

function cf_count<T>(xs: [T], y: T) -> i64 where T: Eq {
    return xs.length as i64;
}

function main() -> int {
    const b: u8 = 200;
    mut r: i64 = cf_count([1, 2], true);   //~ ERROR[E0214] conflicting types for the type parameter
    r = r + cf_count([300, 1], b);   //~ ERROR[E0010] out of range for type `u8`
    r = r + cf_count([1.5], 2 as i64);   //~ ERROR[E0214] mismatched types
    return r as int;
}
