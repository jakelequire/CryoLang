// E0358: a method the object's trait does not declare is not called through
// the object, whatever the types behind it provide.  A supertrait's method
// and a call through a reference to an object are not built yet, and are
// refused at the call.
![config(testing)]
![config(negative, E0358)]
namespace CryoTests::Negative::TraitObjectUnknownMethod;

type trait Shape {
    area(&this) -> i32;
}

type trait Solid : Shape {
    volume(&this) -> i32;
}

function grow(s: virtual mut &Shape) -> i32 {
    return s.missing();
    //~^ ERROR[E0358] no method named `missing` can be called on `virtual mut &CryoTests::Negative::TraitObjectUnknownMethod::Shape`
}

function through_supertrait(s: virtual &Solid) -> i32 {
    return s.area();
    //~^ ERROR[E0358] no method named `area` can be called on `virtual &CryoTests::Negative::TraitObjectUnknownMethod::Solid`
}

function through_reference(r: &virtual &Shape) -> i32 {
    return r.area();
    //~^ ERROR[E0358] no method named `area` can be called on `virtual &CryoTests::Negative::TraitObjectUnknownMethod::Shape`
}

function main() -> int {
    return 0;
}
