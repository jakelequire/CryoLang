// E0358: a method neither the object's trait nor any of its supertraits
// declares is not called through the object, whatever the types behind it
// provide.  A call through a reference to an object is not built yet, and is
// refused at the call.
![config(testing)]
![config(negative, E0358)]
namespace CryoTests::Negative::TraitObjectUnknownMethod;

type trait Shape {
    area(&this) -> i32;
}

type trait Solid : Shape {
    volume(&this) -> i32;
}

function grow(s: virtual mut &Shape) -> i32 {
    return s.missing();
    //~^ ERROR[E0358] no method named `missing` can be called on `virtual mut &CryoTests::Negative::TraitObjectUnknownMethod::Shape`
}

function through_subtrait(s: virtual &Solid) -> i32 {
    return s.missing();
    //~^ ERROR[E0358] no method named `missing` can be called on `virtual &CryoTests::Negative::TraitObjectUnknownMethod::Solid`
}

function through_reference(r: &virtual &Shape) -> i32 {
    return r.area();
    //~^ ERROR[E0358] no method named `area` can be called on `virtual &CryoTests::Negative::TraitObjectUnknownMethod::Shape`
}

function main() -> int {
    return 0;
}
