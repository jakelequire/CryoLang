// E0234: `?` applies to a type that implements `Try` - never by the variants
// an enum spells. A user enum whose variants are spelled `Ok` / `Err` and
// that implements no `Try` is refused as any other operand is (it once
// unwrapped: `outer(3)` answered 7).
![config(testing)]
![config(negative, E0234)]
namespace CryoTests::Negative::E0234UserEnumSpelledOkErr;

type enum CfOutcome { Ok(i32); Err(i32); }

function cf_inner(v: i32) -> CfOutcome {
    if (v > 10) { return CfOutcome::Err(v); }
    return CfOutcome::Ok(v * 2);
}

function cf_outer(v: i32) -> CfOutcome {
    const x: i32 = cf_inner(v)?;
    //~^ ERROR[E0234] the `?` operator requires a value whose type implements `Try`, but the operand has type 'CryoTests::Negative::E0234UserEnumSpelledOkErr::CfOutcome'
    return CfOutcome::Ok(x + 1);
}

function main() -> int {
    match (cf_outer(3)) {
        CfOutcome::Ok(v) => { return v; }
        CfOutcome::Err(e) => { return 100 + e; }
    }
}
