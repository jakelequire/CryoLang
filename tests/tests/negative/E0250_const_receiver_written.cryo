// E0250: `const &this` is `&this`, a read-only receiver, so the method does
// not write it.
![config(testing)]
![config(negative, E0250)]
namespace CryoTests::Negative::ConstReceiverWritten;

type struct Counter {
    n: i64;

    bump(const &this) -> void {
        this.n = this.n + 1;                                            //~ ERROR[E0250] cannot assign to a place reached through the `&this` receiver, which is read-only
    }
}

function main() -> int {
    return 0;
}
