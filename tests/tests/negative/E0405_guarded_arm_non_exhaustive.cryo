// E0405: a guarded arm matches conditionally, so `Color::Red if (...)`
// does not cover the `Red` variant - the match stays non-exhaustive.
![config(testing)]
![config(negative, E0405)]
namespace CryoTests::Negative::E0405GuardedArmNonExhaustive;
type enum Color { Red; Green; Blue; }
function main() -> int {
    const c: Color = Color::Green;
    match (c) {
        Color::Red if (true) => {}
        Color::Green         => {}
        Color::Blue          => {}
    }
    return 0;
}
