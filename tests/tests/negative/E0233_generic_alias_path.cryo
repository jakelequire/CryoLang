// E0233: a path through a generic type alias is refused where it is
// written, with or without type arguments on the alias.  A generic alias
// stays usable as a type, and a non-generic alias's path names its
// target's members.
![config(testing)]
![config(negative, E0233)]
namespace CryoTests::Negative::GenericAliasPath;

import std::collections::array::{ Array };

type Stack<T> = Array<T>;
type Ints = Array<i32>;

function main() -> int {
    mut s: Stack<i32> = Stack::<i32>::new();   //~ ERROR[E0233] `Stack` is a generic type alias
    mut u: Stack<i32> = Stack::new();          //~ ERROR[E0233] `Stack` is a generic type alias
    mut t: Ints = Ints::new();
    t.push(4);
    return 0;
}
