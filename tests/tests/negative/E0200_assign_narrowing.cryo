// E0200: plain `=` assignment rejects an implicit narrowing conversion, just
// like declaration-init and return do. `u8 = i64` would silently truncate
// (300 -> 44); the programmer must write an explicit `as` cast.
![config(testing)]
![config(negative, E0200)]
namespace CryoTests::Negative::E0200AssignNarrowing;
function main() -> int {
    mut x: u8 = 0;
    const big: i64 = 300;
    x = big;   //~ ERROR[E0200] mismatched types
    return 0;
}
