// E0117: arguments in parentheses after `new` build only an enum variant.  A
// struct has no constructor to pass them to: it is built by its literal,
// `new Point { .. }`, or by a function of its own.
![config(testing)]
![config(negative, E0117)]
namespace CryoTests::Negative::NewWithConstructorArguments;

type struct Point {
    x: i32;
    y: i32;
}

function main() -> int {
    const p: Point* = new Point(1, 2);       //~ ERROR[E0117] `new Point(..)` is not part of Cryo
    const q: Point* = new Point { x: 1, y: 2 };
    return q.x - 1;
}
