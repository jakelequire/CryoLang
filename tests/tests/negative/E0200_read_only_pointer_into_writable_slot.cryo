///! A read-only pointer never fills a writable slot, whatever the pointee:
///! a struct literal's field, an assignment and an argument are each judged
///! the same way when the pointee is a type parameter as when it is not.  A
///! generic body is checked once, so a pair skipped there would never be
///! checked at all.

![config(testing)]
![config(negative, E0200)]
namespace CryoTests::Negative::E0200ReadOnlyPointerIntoWritableSlot;

type struct Holder { p: mut i32*; }
type struct GenericHolder<T> {
    p: mut T*;

    store(mut &this, q: T*) -> void {
        this.p = q;
        //~^ ERROR[E0200] mismatched types
    }
}

function make(q: i32*) -> Holder {
    return Holder { p: q };
    //~^ ERROR[E0200] mismatched types
}

function make_generic<T>(q: T*) -> GenericHolder<T> {
    return GenericHolder::<T> { p: q };
    //~^ ERROR[E0200] mismatched types
}

function assign_plain(q: i32*) -> void {
    mut h: mut i32* = null;
    h = q;
    //~^ ERROR[E0200] mismatched types
}

function assign_generic<T>(q: T*) -> void {
    mut h: mut T* = null;
    h = q;
    //~^ ERROR[E0200] mismatched types
}

function take_writable<T>(p: mut T*) -> void { }

function pass_generic<T>(q: T*) -> void {
    take_writable::<T>(q);
    //~^ ERROR[E0214] mismatched types
}

// Accepted: a writable pointer fills a writable slot, and a read-only slot
// takes either.
function make_writable<T>(q: mut T*) -> GenericHolder<T> {
    mut h: mut T* = null;
    h = q;
    take_writable::<T>(q);
    return GenericHolder::<T> { p: q };
}

function read_only<T>(q: mut T*) -> void {
    mut r: T* = null;
    r = q;
}

function main() -> int {
    mut v: i32 = 1;
    const h: Holder = make(&v);
    mut g: GenericHolder<i32> = make_generic::<i32>(&v);
    g.store(&v);
    assign_plain(&v);
    assign_generic::<i32>(&v);
    pass_generic::<i32>(&v);
    const w: GenericHolder<i32> = make_writable::<i32>(&v);
    read_only::<i32>(&v);
    return *h.p + *g.p + *w.p;
}
