// E0234: a user enum spelled `Ok` / `Err` as the `?` operand INSIDE a function
// that returns the real `Result`. The shape test once called the two equal and
// the desugar rebuilt the user's `Err` payload as a `Result::Err` (`outer(30)`
// answered 130); the operand is judged by its declaration's identity, and a
// non-`Result` operand is refused before any return type is consulted.
![config(testing)]
![config(negative, E0234)]
namespace CryoTests::Negative::E0234UserEnumIntoResult;

import std::core::result::{ Result };

type enum CfOutcome { Ok(i32); Err(i32); }

function cf_inner(v: i32) -> CfOutcome {
    if (v > 10) { return CfOutcome::Err(v); }
    return CfOutcome::Ok(v * 2);
}

function cf_outer(v: i32) -> Result<i32, i32> {
    const x: i32 = cf_inner(v)?;
    //~^ ERROR[E0234] the `?` operator requires a `Result` or `Option` value, but the operand has type 'CryoTests::Negative::E0234UserEnumIntoResult::CfOutcome'
    return Result::Ok(x + 1);
}

function main() -> int {
    match (cf_outer(30)) {
        Result::Ok(v) => { return v; }
        Result::Err(e) => { return 100 + e; }
    }
}
