// E0306: a trait may put a bound on its associated type
// (`type Item: Copy;`). Every impl's concrete binding must satisfy that
// declaration-site bound. Here `Holder` binds `Item = NotCopy` - a type with a
// `Drop` impl, hence non-`Copy` - so the bound `Item: Copy` is violated and the
// impl must be rejected: the bound must be checked, not merely parsed.
![config(testing)]
![config(negative, E0306)]
namespace CryoTests::Negative::AssocDeclBound;

type trait Seq {
    type Item: Copy;
    next_one(&this) -> i32;
}

type struct NotCopy { p: i32*; }
implement trait Drop for struct NotCopy {
    destroy(&this) -> void {}
}

type struct Holder { v: i32; }

implement trait Seq<NotCopy> for struct Holder {   //~ ERROR[E0306] associated type `Item` of trait
    next_one(&this) -> i32 { return this.v; }
}

function main() -> int {
    return 0;
}
