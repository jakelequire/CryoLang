// E0151: `![must_use]` marks a type whose values must be read, or a function
// or method whose result must be; a variable or a trait is neither.
![config(testing)]
![config(negative, E0151)]
namespace CryoTests::Negative::E0151MustUsePlacement;

![must_use]
//~^ ERROR[E0151] directive `![must_use]` only applies to a function, a method, a struct, a union or an enum, not variable
const MU_LIMIT: i32 = 4;

![must_use]
//~^ ERROR[E0151] directive `![must_use]` only applies to a function, a method, a struct, a union or an enum, not trait
type trait MuSpeak {
    mu_speak(&this) -> i32;
}

function main() -> int { return MU_LIMIT; }
