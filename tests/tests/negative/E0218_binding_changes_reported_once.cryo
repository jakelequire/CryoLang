///! Every change to a binding declared without `mut` is the one problem of
///! how it is declared, so it is one report: a caret at each change, the
///! declaration labelled, and the single fix declaring it `mut`.  A mutating
///! method called on the binding joins the report under its own code, named
///! in a note.  Another binding is another problem, reported apart.

![config(testing)]
![config(negative, E0218)]
namespace CryoTests::Negative::E0218BindingChangesReportedOnce;

function cf_changes() -> i32 {
    const count: i32 = 3;
    count = 4;
    //~^ ERROR[E0218] `count` is changed, but it is declared without `mut`
    count += 1;
    //~^ ERROR[E0218] `count` is changed, but it is declared without `mut`
    const items: [i32] = [];
    items = [];
    //~^ ERROR[E0218] `items` is changed, but it is declared without `mut`
    items.push(2);
    //~^ ERROR[E0218] `items` is changed, but it is declared without `mut`
    const once: i32 = 1;
    once = 2;
    //~^ ERROR[E0218] cannot assign to immutable variable `once`
    return count + once;
}
