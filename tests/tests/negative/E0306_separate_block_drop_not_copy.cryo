// A type whose `drop` is declared in a separate inherent `implement T { ... }`
// block carries a Drop obligation and therefore is NOT Copy. Passing it to a
// `where T: Copy` bound must be rejected. Before the fix the destructor was
// invisible to the Copy classifier, so this compiled (and silently leaked /
// bit-copied an owning value) - the soundness hole this test guards.
![config(testing)]
![config(negative, E0306)]
namespace CryoTests::Negative::SeparateBlockDropNotCopy;

type struct Owner { id: i32; }
implement Owner {
    drop(mut &this) -> void { }
}

function needs_copy<T>(x: T) -> T where T: Copy { return x; }

function main() -> int {
    mut o: Owner = Owner { id: 1 };
    const c: Owner = needs_copy<Owner>(o);
    return c.id;
}
