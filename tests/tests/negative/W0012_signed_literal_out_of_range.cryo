// W0012: an integer literal beyond a signed type's range (stored two's-complement).
![config(testing)]
![config(negative, W0012)]
namespace CryoTests::Negative::W0012SignedLiteralOutOfRange;

function main() -> int {
    const wrapped: i8 = 200;   // 200 > 127; wraps to -56
    return wrapped as int;
}
