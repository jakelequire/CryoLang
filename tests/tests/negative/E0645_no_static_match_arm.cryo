///! A `static match` with no arm for the concrete `T` and no `_` default must
///! be rejected: the absence of a matching arm IS the type constraint, so
///! instantiating with an unhandled type is a compile error (E0645).

![config(testing)]
![config(negative, E0645)]
namespace CryoTests::Negative::E0645NoStaticMatchArm;

type struct cf_Only<T> {
    value: T;

    static new(v: T) -> cf_Only<T> {
        return cf_Only<T> { value: v };
    }

    code(&this) -> i32 {
        return static match (T) {
            u8  => { 8 }
            u32 => { 32 }
        };
    }
}

function main() -> int {
    // f32 matches neither arm and there is no `_`, so monomorphizing
    // cf_Only<f32>::code must fail with E0645.
    mut a: cf_Only<f32> = cf_Only<f32>::new(1.5 as f32);
    return a.code();
}
