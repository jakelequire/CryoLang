// E0208: a class value cast to a pointer or a scalar is refused; the
// address of a class value is written `&av`, and that address converts.
![config(testing)]
![config(negative, E0208)]
namespace CryoTests::Negative::ClassValueToPointer;

type class Animal {
public:
    legs: i32;
    Animal(n: i32) { this.legs = n; }

    address(&this) -> void* { return this as void*; }
}

function main() -> int {
    const av: Animal = Animal(4);
    const p: void* = av as void*;        //~ ERROR[E0208] invalid cast between an aggregate type
    const q: u8* = av as u8*;            //~ ERROR[E0208] invalid cast between an aggregate type
    const r: Animal* = av as Animal*;    //~ ERROR[E0208] invalid cast between an aggregate type
    const n: u64 = av as u64;            //~ ERROR[E0208] invalid cast between an aggregate type
    const ok: Animal* = &av;
    const ok_void: void* = &av as void*;
    const ok_recv: void* = av.address();
    return 0;
}
