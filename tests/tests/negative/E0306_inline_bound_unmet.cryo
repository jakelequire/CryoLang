// E0306: a bound written on a type parameter (`<T: Tagged>`) is checked at
// each instantiation of the type that declares it, as the same bound in a
// `where` clause is.  A parameter's inline bound and its `where` bound merge,
// so either one unmet is refused.  (The same bound on a function is checked
// at its calls: E0306_inline_bound_call_unmet.)
![config(testing)]
![config(negative, E0306)]
namespace CryoTests::Negative::InlineBoundUnmet;

import std::core::drop::{ Drop };

type trait Tagged {
    tag(&this) -> i32;
}

type struct Plain { v: i32; }

type struct Named { v: i32; }
implement trait Tagged for Named {
    tag(&this) -> i32 { return this.v; }
}

type struct Owning { v: i32; }
implement trait Tagged for Owning {
    tag(&this) -> i32 { return this.v; }
}
implement trait Drop for Owning {
    drop(mut &this) -> void { }
}

type struct Pair<T: Tagged> where T: Copy {
    a: T;
}

type enum Slot<T: Tagged> {
    Empty;
    Full(T);
}

function main() -> int {
    const p: Pair<Plain> = Pair::<Plain> { a: Plain { v: 1 } };   //~ ERROR[E0306] the trait bound `CryoTests::Negative::InlineBoundUnmet::Plain: Tagged` is not satisfied
    const o: Pair<Owning> = Pair::<Owning> { a: Owning { v: 1 } };   //~ ERROR[E0306] the trait bound `CryoTests::Negative::InlineBoundUnmet::Owning: Copy` is not satisfied
    const s: Slot<Plain> = Slot::Empty;   //~ ERROR[E0306] the trait bound `CryoTests::Negative::InlineBoundUnmet::Plain: Tagged` is not satisfied
    const fine: Pair<Named> = Pair::<Named> { a: Named { v: 4 } };
    return fine.a.v;
}
