// E0216: a variadic function's declared parameters are each required; a
// call may leave the tail empty but not a declared parameter.  Refused on
// the bare call and on the module-qualified one alike.
![config(testing)]
![config(negative, E0216)]
namespace CryoTests::Negative::E0216VariadicMissingFixed;

import std::ffi::libc;

extern "C" {
    function cf_vfix(a: i32, b: i32, ...) -> i32;
}

function main() -> int {
    cf_vfix(1);          //~ ERROR[E0216] function `cf_vfix` takes at least 2 argument(s) but 1 were supplied
    libc::printf();      //~ ERROR[E0216] function `printf` takes at least 1 argument(s) but 0 were supplied
    return 0;
}
