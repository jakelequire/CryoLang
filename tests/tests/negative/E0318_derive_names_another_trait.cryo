// E0318: a `with` entry chooses what is generated by its spelling, and the
// spelling must name the standard library's trait where the type is
// declared; a module's own trait spelled `Eq` is not derived.  The
// standard `Ord` beside it is the control.
![config(testing)]
![config(negative, E0318)]
namespace CryoTests::Negative::E0318DeriveNamesAnotherTrait;

import std::core::cmp::{ Ord };

type trait Eq {
    equals(&this, other: &This) -> boolean;
}

type struct NaMine with [Eq] {   //~ ERROR[E0318] `Eq` names `CryoTests::Negative::E0318DeriveNamesAnotherTrait::Eq`, not the standard `Eq`, so it cannot be derived
    x: i64;
}

function main() -> i32 {
    return 0;
}
