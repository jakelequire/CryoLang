// E0358: a `string` has no text methods of its own beyond a few the
// compiler still reads through; a program works on text through `Str`,
// `String` and `Path`. `Str::new` views a literal or any other `string`, and
// `Str`'s own methods answer for it: `contains`, `starts_with`, `ends_with`,
// `is_empty`, and `find`, `find_last`, `find_byte` and `find_last_byte`,
// which answer an `Option`; `trim`, `strip_prefix`, `split`,
// `split_nonempty` and `byte_substring` (which takes an end, not a length),
// which answer views of the text rather than copies; `replace` and
// `to_ascii_lowercase`, which answer a `String`. A `String` appends, and
// `Path` names a path's `parent`, `file_name` and `stem`. `string`'s own
// `append` is what `a + b` on two `string`s calls, and is internal (E0353).
![config(testing)]
![config(negative, E0358)]
namespace CryoTests::Negative::E0358StringHasNoTextMethods;

import std::fs::path::{ Path };

function legacy(text: string) -> boolean {
    const found: boolean = text.contains("b");
    //~^ ERROR[E0358] no method named `contains` found on type `string`
    const leads: boolean = text.starts_with("a");
    //~^ ERROR[E0358] no method named `starts_with` found on type `string`
    const ends: boolean = "abc".ends_with("c");
    //~^ ERROR[E0358] no method named `ends_with` found on type `string`
    const blank: boolean = text.is_empty();
    //~^ ERROR[E0358] no method named `is_empty` found on type `string`
    const first: i64 = text.find("b");
    //~^ ERROR[E0358] no method named `find` found on type `string`
    const last: i64 = text.find_last("b");
    //~^ ERROR[E0358] no method named `find_last` found on type `string`
    const byte: i64 = text.find_char(98 as i8);
    //~^ ERROR[E0358] no method named `find_char` found on type `string`
    const last_byte: i64 = text.find_last_char(98 as i8);
    //~^ ERROR[E0358] no method named `find_last_char` found on type `string`
    return found && leads && ends && !blank && first == last && byte == last_byte;
}

function legacy_copies(text: string) -> i64 {
    const joined: string = text.append("d");
    //~^ ERROR[E0353] method `append` of `string` is internal
    const trimmed: string = text.trim();
    //~^ ERROR[E0358] no method named `trim` found on type `string`
    const rest: string = text.strip_prefix("a");
    //~^ ERROR[E0358] no method named `strip_prefix` found on type `string`
    const replaced: string = text.replace("b", "x");
    //~^ ERROR[E0358] no method named `replace` found on type `string`
    const lower: string = text.to_ascii_lower();
    //~^ ERROR[E0358] no method named `to_ascii_lower` found on type `string`
    const pieces: [string] = text.split(",");
    //~^ ERROR[E0358] no method named `split` found on type `string`
    const words: [string] = text.split_nonempty(",");
    //~^ ERROR[E0358] no method named `split_nonempty` found on type `string`
    const directory: string = text.parent_directory();
    //~^ ERROR[E0358] no method named `parent_directory` found on type `string`
    const name: string = text.basename();
    //~^ ERROR[E0358] no method named `basename` found on type `string`
    const stem: string = text.stem();
    //~^ ERROR[E0358] no method named `stem` found on type `string`
    const middle: string = text.substring(1, 1);
    //~^ ERROR[E0358] no method named `substring` found on type `string`
    return joined.length() + trimmed.length() + rest.length() + replaced.length() + lower.length()
        + pieces.length() + words.length() + directory.length() + name.length() + stem.length()
        + middle.length();
}

function through_str(text: string) -> boolean {
    const view: Str = Str::new(text);
    return view.contains("b") && view.starts_with("a")
        && Str::new("abc").ends_with("c") && !view.is_empty()
        && view.find("b").unwrap_or(-1) == view.find_last("b").unwrap_or(-1)
        && view.find_byte(98).unwrap_or(-1) == view.find_last_byte(98).unwrap_or(-1);
}

function through_owners(text: string) -> i64 {
    const view: Str = Str::new(text);
    mut joined: String = String::from_str(view);
    joined.append("d");
    const rest: Str = view.strip_prefix("a").unwrap_or(view);
    const path: Path = Path::from(view);
    const directory: Str = path.parent().unwrap_or(Path::from(".")).as_str();
    return joined.length() + view.trim().length() + rest.length()
        + view.replace("b", "x").length() + view.to_ascii_lowercase().length()
        + view.split(",").count() + view.split_nonempty(",").count()
        + directory.length() + path.file_name().unwrap_or(Str::new("")).length()
        + path.stem().unwrap_or(Str::new("")).length() + view.byte_substring(1, 2).length();
}

function main() -> int {
    if (legacy("abc") && through_str("abc") && legacy_copies("abc") == through_owners("abc")) { return 0; }
    return 1;
}
