// E0358: `Array::get` requires `T: Copy`.  Inside a generic body whose
// bounds give `T` only `Clone`, a call of it on the body's `Array<T>` is
// refused there, as it is on an `Array<String>`; the body's copies are not
// checked, so it is the only place the unmet bound can be reported.
![config(testing)]
![config(negative, E0358)]
namespace CryoTests::Negative::GenericBodyMethodBoundUnmet;

function first<T>(xs: &Array<T>) -> Option<T> where T: Clone {
    return xs.get(0);   //~ ERROR[E0358] the trait bound `T: Copy` is not satisfied
}

function main() -> i32 {
    mut xs: Array<i32> = Array::<i32>::new();
    xs.push(5);
    return first::<i32>(&xs).unwrap_or(0);
}
