// E0312: an implementation's methods must match its trait's declarations.
// Each way one can disagree is refused where it is written: a method the
// trait declares without a body left out, a method the trait does not
// declare, a static method written with a receiver, a receiver of another
// form, a different number of the method's own type parameters or of its
// parameters, a parameter of another type, and another return type.  A
// method the trait gives a body may be left out.
![config(testing)]
![config(negative, E0312)]
namespace CryoTests::Negative::TraitImplMismatch;

type trait Shape {
    area(&this) -> i32;
    scale(mut &this, k: i32) -> void;
    static unit() -> This;
    name(&this) -> i32 { return 0; }
    pick<U>(&this, u: U) -> U;
}

type struct Bad { s: i32; }

implement trait Shape for struct Bad {
    area(&this) -> i64 { return 0; }               //~ ERROR[E0312] `area` returns `i32` in trait `Shape`, but `i64` here
    scale(&this, k: i32) -> void { }               //~ ERROR[E0312] `scale` takes `mut &this` in trait `Shape`, but `&this` here
    unit(&this) -> Bad { return Bad { s: 1 }; }    //~ ERROR[E0312] `unit` is static in trait `Shape`, but takes a receiver here
    pick(&this, u: i32) -> i32 { return u; }       //~ ERROR[E0312] `pick` has 1 type parameter(s) in trait `Shape`, but 0 here
    extra(&this) -> i32 { return 1; }              //~ ERROR[E0312] `extra` is not a method of trait `Shape`
}

type struct Short { s: i32; }

implement trait Shape for struct Short {            //~ ERROR[E0312] this implementation of trait `Shape` is missing `area`
    scale(mut &this, k: u8) -> void { }            //~ ERROR[E0312] parameter 1 of `scale` is `i32` in trait `Shape`, but `u8` here
    static unit(x: i32) -> Short { return Short { s: x }; }   //~ ERROR[E0312] `unit` takes 0 parameter(s) in trait `Shape`, but 1 here
    pick<V>(&this, u: V) -> V { return u; }
}

function main() -> int {
    return 0;
}
