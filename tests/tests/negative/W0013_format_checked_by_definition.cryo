// W0013: the format check follows the function a call names, not the name
// it is written with: the standard library's `printf` imported under
// another name is checked, and a program's own function named `printf` is
// not.
![config(testing)]
![config(negative, W0013)]
namespace CryoTests::Negative::W0013FormatCheckedByDefinition;

import std::fmt::{ printf as say };

function printf(label: string, n: i64) -> i64 {
    return n;
}

function main() -> int {
    const r: i64 = printf("%s", 5);
    say("%s\n", 42);   //~ WARN[W0013] expects a C string
    return r as int - 5;
}
