// E0204: a type's constant is reached through its type, never through a
// value of the type, and the help says how to write it.
![config(testing)]
![config(negative, E0204)]
namespace CryoTests::Negative::ConstantThroughValue;

type struct Point {
    x: i32;
    const ORIGIN: Point = Point { x: 0 };
}

function main() -> int {
    const p: Point = Point { x: 1 };
    const o: Point = p.ORIGIN;   //~ ERROR[E0204] no field or method `ORIGIN` on type
    return o.x;
}
