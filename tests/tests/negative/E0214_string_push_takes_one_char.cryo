// E0214: `String.push` appends one `char`, the element a String is a
// sequence of; text goes through `append`. A `Str` handed to `push` is a
// mismatched argument, not text silently appended.
![config(testing)]
![config(negative, E0214)]
namespace CryoTests::Negative::StringPushTakesOneChar;
import std::collections::string::{ String };
import std::collections::str::{ Str };
function main() -> int {
    mut s: String = String::new();
    s.push('a');
    s.push(Str::new("bc"));
    //~^ ERROR[E0214] mismatched types
    s.append(Str::new("bc"));
    return 0;
}
