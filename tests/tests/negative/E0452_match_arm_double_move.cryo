// E0452: a non-Copy value moved twice inside a single `match` arm.
//
// Regression test: the move checker must walk `match` arms
// (walk_stmt/walk_expr need a MatchStatement/MatchExpression case), or a
// double-move inside an arm would pass `check` clean and double-free at
// runtime ("free(): double free detected"). The arm body is walked
// straight-line, so the second `consume(h)` is a hard-error use-after-move
// and no binary is emitted.
![config(testing)]
![config(negative, E0452)]
namespace CryoTests::Negative::MatchArmDoubleMove;

type struct Heap {
    p: void*;
}

implement trait Drop for struct Heap {
    drop(mut &this) -> void { free(this.p); }
}

function consume(h: Heap) -> void {
    // by-value owning parameter: drops `h` at function exit.
}

function main() -> int {
    mut h: Heap = Heap { p: malloc(16) };
    match (1) {
        1 => { consume(h); consume(h); }   // second use is after move -> double free
        _ => {}
    }
    return 0;
}
