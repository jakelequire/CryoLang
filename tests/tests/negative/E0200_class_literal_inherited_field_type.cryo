// E0200: a class literal that initializes a field declared on a BASE class
// is checked against that field's type, as an initializer of the class's own
// field is.  Before the literal's field lookup walked the base chain, the
// inherited field's type was unknown to sema, no check ran, and the string
// below was stored into an `i32` slot.
![config(testing)]
![config(negative, E0200)]
namespace CryoTests::Negative::E0200ClassLiteralInheritedFieldType;

type class CfBase {
public:
    x: i32;
    CfBase() { this.x = 0; }
}

type class CfDerived : CfBase {
public:
    y: i32;
    CfDerived() : CfBase() { this.y = 0; }
}

function main() -> int {
    const d: CfDerived = CfDerived { x: "not an int", y: 3 };
    //~^ ERROR[E0200] mismatched types
    return d.y;
}
