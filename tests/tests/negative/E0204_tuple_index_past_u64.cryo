// E0204: a tuple index too large for a u64 is no tuple index, not a smaller one.
![config(testing)]
![config(negative, E0204)]
namespace CryoTests::Negative::E0204TupleIndexPastU64;
function main() -> i32 {
    const pair: (i32, i32) = (7, 8);
    return pair.18446744073709551616;   //~ ERROR[E0204] expected a tuple index after `.`, got `18446744073709551616`
}
