// E0628: a `lo..hi` range pattern whose low bound exceeds its high bound
// (`9..0`) matches nothing and is almost always a typo, so sema rejects it.
![config(testing)]
![config(negative, E0628)]
namespace CryoTests::Negative::ReversedRangePattern;
function main() -> int { const x: i32 = 1; match (x) { 9..0 => {} _ => {} } return 0; }   //~ ERROR[E0628] range pattern lower bound (9)
