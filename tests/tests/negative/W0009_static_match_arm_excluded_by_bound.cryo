///! An arm of a `static match` over a parameter a primitive trait bounds that
///! names a type the bound excludes can never be chosen: no copy binds the
///! parameter to it.  One warning per such type, with or without a `_` arm,
///! in an arm of its own or listed beside admitted types.

![config(testing)]
![config(negative, W0009)]
namespace CryoTests::Negative::W0009StaticMatchArmExcludedByBound;

function width<T>() -> i32 where T: Integer {
    return static match (T) {
        boolean => { 0 }   //~ WARN[W0009] unreachable `static match` arm: the bounds of `T` exclude `boolean`, so this arm can never be chosen
        i32     => { 32 }
        _       => { 64 }
    };
}

function kind<T>() -> i32 where T: SignedInteger {
    return static match (T) {
        i8 | i16 | i32 => { 1 }
        i64 | i128 | isize | u8 => { 2 }   //~ WARN[W0009] the bounds of `T` exclude `u8`
        f64 => { 3 }   //~ WARN[W0009] the bounds of `T` exclude `f64`
    };
}

function main() -> i32 {
    return width::<i32>() + kind::<i8>();
}
