// A returned value made only of integer literals is its exact value, as an
// initializer's is, so it is refused where the declared return type does not
// hold that value, naming the value: `200 + 100` from a `u8` function is
// 300, where it was computed at 8 bits and returned 44.  `(200 + 100) / 2`,
// whose value a `u8` holds, is the control.
![config(testing)]
![config(negative, E0010)]
namespace CryoTests::Negative::LiteralOnlyReturnNotHeld;

function half_u8() -> u8 {
    return (200 + 100) / 2;
}

function sum_u8() -> u8 {
    return 200 + 100;                       //~ ERROR[E0010] this value is 300
}

function difference_i8() -> i8 {
    return -(100 + 29);                     //~ ERROR[E0010] this value is -129
}

function main() -> int {
    return (half_u8() as int) + (sum_u8() as int) + (difference_i8() as int);
}
