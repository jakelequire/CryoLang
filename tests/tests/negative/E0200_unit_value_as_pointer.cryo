// E0200 / E0214: `()` is only the unit value, of the unit type; it is not a
// null pointer.  Written where a pointer is expected - a binding's
// initializer, an assignment, an argument - it is a mismatch, as any other
// non-pointer value is.  The null pointer is `null`.
![config(testing)]
![config(negative, E0200)]
namespace CryoTests::Negative::UnitValueAsPointer;

function takes(p: i32*) -> i32 { return 0; }

function main() -> i32 {
    const p: i32* = ();
    //~^ ERROR[E0200] mismatched types
    mut q: u8* = null;
    q = ();
    //~^ ERROR[E0200] mismatched types
    return takes(());
    //~^ ERROR[E0214] mismatched types
}
