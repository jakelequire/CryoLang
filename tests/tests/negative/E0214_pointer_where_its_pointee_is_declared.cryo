// Reading the value a pointer points to is explicit, as a reference's is.
// A `i64*` passed where an `i64` is declared is refused at every kind of
// call alike - a free function, a static method, an instance method and an
// enum variant's payload - with the fix that writes `*` before it.  A free
// function used to read through the pointer, and a static method and a
// payload took its address as the integer.
![config(testing)]
![config(negative, E0214)]
namespace CryoTests::Negative::PointerWhereItsPointeeIsDeclared;

type enum Held {
    Number(i64);
}

type struct Holder {
    base: i64;

    static take(holder: &Holder, index: i64) -> i64 {
        return holder.base + index;
    }

    pick(&this, index: i64) -> i64 {
        return this.base + index;
    }
}

function take(index: i64) -> i64 {
    return index;
}

function main() -> int {
    const holder: Holder = Holder { base: 0 };
    const x: i64 = 7;
    const p: i64* = &x;
    const a: i64 = take(p);
    //~^ ERROR[E0214] mismatched types
    const b: i64 = Holder::take(&holder, p);
    //~^ ERROR[E0214] mismatched types
    const c: i64 = holder.pick(p);
    //~^ ERROR[E0214] mismatched types
    const held: Held = Held::Number(p);
    //~^ ERROR[E0214] mismatched types
    return (a + b + c) as int;
}
