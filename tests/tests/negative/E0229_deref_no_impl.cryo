// E0229: `*` on a user type that does not implement `Deref` is rejected with a
// message naming the missing trait (not the generic "dereference requires a
// pointer"). A primitive `*x` still reports E0230; only user types get this.
![config(testing)]
![config(negative, E0229)]
namespace CryoTests::Negative::E0229DerefNoImpl;

type struct NoDeref { v: i32; }

function main() -> int {
    const n: NoDeref = NoDeref { v: 5 };
    const x: i32 = *n;
    return x;
}
