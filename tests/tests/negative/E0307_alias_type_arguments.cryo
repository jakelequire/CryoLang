// E0307: an alias with no type parameters fixes its target's arguments.
// Arguments written on it are too many, not a second choice of the
// target's: `PI::<u8>::size()` would otherwise be `Pl<u8>::size()`.
![config(testing)]
![config(negative, E0307)]
namespace CryoTests::Negative::AliasTypeArguments;

type struct Pl<T> { v: T; }

implement<T> struct Pl<T> {
    static size() -> u64 { return sizeof(T); }
}

type PI = Pl<i32>;
type PJ = PI;

function main() -> int {
    const s: u64 = PI::<u8>::size();      //~ ERROR[E0307] `PI` is a type alias with no type parameters, and 1 type argument is written
    const t: u64 = PJ::<u8, u8>::size();  //~ ERROR[E0307] `PJ` is a type alias with no type parameters, and 2 type arguments are written
    const u: u64 = PI::size();
    return (s + t + u) as int;
}
