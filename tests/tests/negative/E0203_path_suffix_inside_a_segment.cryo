// E0203: a written module path may leave off LEADING segments of the
// namespace it names, never part of one. `llections::hashmap` is the end of
// the text of `std::collections::hashmap`, and its last segment is the
// module's own, but `llections` is not one of its segments - so
// `llections::hashmap::HashMap` names no module, even with that module
// imported.
![config(testing)]
![config(negative, E0203)]
namespace CryoTests::Negative::E0203PathSuffixInsideASegment;
import std::collections::hashmap;
function cf_use() -> void {
    const _m: llections::hashmap::HashMap<i64, i64> = hashmap::HashMap::<i64, i64>::new();   //~ ERROR[E0203] cannot find type `llections::hashmap::HashMap` in
}
function main() -> int { return 0; }
