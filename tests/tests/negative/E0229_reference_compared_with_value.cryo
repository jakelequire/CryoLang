// E0229: a reference is not compared with a plain value.  Nothing
// dereferences it, so the comparison would be of its ADDRESS with `7` -
// which compiled and was silently false.  `*x == 7` compares the value.
![config(testing)]
![config(negative, E0229)]
namespace CryoTests::Negative::E0229ReferenceComparedWithValue;

function is_seven(x: &i32) -> boolean {
    return x == 7;
    //~^ ERROR[E0229] Cannot compare Reference and Int; dereference the reference to compare the value it refers to (`*x`)
    //~^^ ERROR[E0200] mismatched types
}

function main() -> int { return 0; }
