// E0223: the address of a byte of a `string`.  `s[i]` and `*s` read the
// byte as a `char`, which is wider than the byte, so there is no `char` in
// memory to point at.  `s + i` is the pointer to the byte; reading `s[i]`
// as a value is unaffected.
![config(testing)]
![config(negative, E0223)]
namespace CryoTests::Negative::AddressOfStringByte;

function main() -> int {
    const lexeme: string = "0x30";
    const byte: u8* = lexeme + 1;
    const read: char = lexeme[1];
    const indexed: char* = &lexeme[1];
    //~^ ERROR[E0223] cannot take the address of a byte of a `string`
    const first: char* = &*lexeme;
    //~^ ERROR[E0223] cannot take the address of a byte of a `string`
    if (*byte as char != read) { return 1; }
    return 0;
}
