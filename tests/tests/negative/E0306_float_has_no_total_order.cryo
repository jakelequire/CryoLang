// E0306: `f32` and `f64` implement `Eq` as the IEEE `==`, under which a NaN
// equals nothing, so they implement no `Ord` - no total order agrees with
// that equality.  A float where `T: Ord` is required is refused; the
// explicit total order is `total_compare`.
![config(testing)]
![config(negative, E0306)]
namespace CryoTests::Negative::FloatHasNoTotalOrder;

import std::core::cmp::{ max, min, Ordering };

function main() -> i32 {
    const low: f64 = 1.0;
    const high: f64 = 2.0;
    min(low, high);
    //~^ ERROR[E0306] the trait bound `f64: Ord` is not satisfied
    const single: f32 = 1.5;
    max(single, single);
    //~^ ERROR[E0306] the trait bound `f32: Ord` is not satisfied
    // Controls: the explicit total order and an integer `min` are accepted.
    const ordered: Ordering = low.total_compare(&high);
    const whole: i64 = min(1, 2);
    match (ordered) {
        Ordering::Less => { return whole as i32; }
        _ => { return 0; }
    }
}
