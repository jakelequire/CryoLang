// E0452: a destructure takes every field of its right-hand side, so the
// source is gone afterwards and handing it on releases each field twice -
// once through the destructured locals, once through the new owner.
//
// Regression test for the move checker never walking a destructure's
// initializer: the source's move went unrecorded and this program was
// accepted.
![config(testing)]
![config(negative, E0452)]
namespace CryoTests::Negative::DestructureSourceUsedAfter;

type struct Res {
    tag: i32;
    drop(mut &this) -> void { }
}

type struct Pair {
    a: Res;
    b: Res;
}

function consume_pair(p: Pair) -> i32 { return p.a.tag; }

function main() -> int {
    const p: Pair = Pair { a: Res { tag: 1 }, b: Res { tag: 2 } };
    const {a, b}: Pair = p;
    consume_pair(p);
    //~^ ERROR[E0452] use of moved value 'p'
    return a.tag + b.tag;
}
