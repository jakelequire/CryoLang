// E0600: an `await` outside the body of an `async` function or method,
// refused once, at the `await`.  A lambda body is its own function, so an
// `await` there is outside even when the lambda sits in an `async` body.
![config(testing)]
![config(negative, E0600)]
namespace CryoTests::Negative::E0600AwaitOutsideAsync;

import std::future;
import std::future::ready::{ PendingThenReady };

type struct CfHolder {
    n: i64;

    cf_plain(&this) -> i64 {
        return await PendingThenReady::<i64>::new(1, this.n);   //~ ERROR[E0600] `await` is only allowed
    }

    async cf_fine(&this) -> i64 {
        return await PendingThenReady::<i64>::new(1, this.n);
    }
}

async function cf_in_lambda(n: i64) -> i64 {
    const f = (x: i64) -> i64 { return await PendingThenReady::<i64>::new(1, x); };   //~ ERROR[E0600] `await` is only allowed
    const direct: i64 = await PendingThenReady::<i64>::new(1, n);
    return f(direct);
}

function cf_not_async(n: i64) -> i64 {
    return await PendingThenReady::<i64>::new(1, n);   //~ ERROR[E0600] `await` is only allowed
}

function cf_generic<T>(x: T) -> T {
    return await PendingThenReady::<T>::new(1, x);   //~ ERROR[E0600] `await` is only allowed
}

async function cf_generic_async<T>(x: T) -> T {
    return await PendingThenReady::<T>::new(1, x);
}

// Checked after an `async` body: a global is outside every function.
const CF_WRITTEN: i64 = await PendingThenReady::<i64>::new(1, 2);   //~ ERROR[E0600] `await` is only allowed
const CF_UNWRITTEN = await PendingThenReady::<i64>::new(1, 3);   //~ ERROR[E0600] `await` is only allowed

function main() -> int {
    const h: CfHolder = CfHolder { n: 1 };
    return (cf_not_async(1) + h.cf_plain() + cf_generic::<i64>(1) + CF_WRITTEN + CF_UNWRITTEN) as int;
}
