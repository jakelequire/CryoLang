// Compile-fail: an instance-method call supplies more arguments than the
// method accepts. `Point::sum(&this)` takes no (non-receiver) arguments, so
// `p.sum(5)` is over-arity.
//
// Regression test: method and static-method calls must not skip arity
// checking. Left unchecked, the call would pass `cryo check` with ZERO
// errors, then codegen would build an LLVM `call` with the wrong operand
// count and the module would fail verification with a raw
// internal-compiler-error (E0900) - also an LSP crash path. Arity is
// reported at sema (E0215/E0216) exactly as it is for free functions, and
// codegen is skipped once any error exists so the spurious E0900 does not
// pile on.
![config(testing)]
![config(negative, E0215)]
namespace CryoTests::Negative::E0215MethodCallArity;

type struct Point {
    x: i32;
    y: i32;

    sum(&this) -> i32 { return this.x + this.y; }
}

function main() -> i32 {
    const p: Point = Point { x: 1, y: 2 };
    return p.sum(5);   // sum takes 0 args -> E0215   //~ ERROR[E0215] method `sum` takes 0 argument(s)
}
