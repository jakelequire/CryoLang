// E0307: a generic type's method with type parameters of its own taken as a
// value, where nothing binds the type's parameter - the path writes no
// arguments on the type and no expected function type names it - or nothing
// binds the method's own.
![config(testing)]
![config(negative, E0307)]
namespace CryoTests::Negative::GenericOwnerMethodValueUninferable;

type struct Wrap<T> { v: T; }
implement<T> struct Wrap<T> {
    static conv<U>(x: U) -> U { return x; }
}

function main() -> int {
    const a = Wrap::conv::<u8>;                 //~ ERROR[E0307] cannot infer `T` for `Wrap::conv` used as a value
    const b = Wrap::<i32>::conv;                //~ ERROR[E0307] cannot infer `U` for `Wrap::conv` used as a value
    const c: (u8) -> u8 = Wrap::<i32>::conv::<u8>;
    return c(0) as int;
}
