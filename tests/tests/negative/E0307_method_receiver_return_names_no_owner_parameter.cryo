// E0307: a method call's expected type reaches a static call written as its
// receiver only through what the method returns on it.  `is_ok()` returns a
// `boolean`, which names none of the owner's parameters, so the literal
// alone would decide `T` and the call is refused.  `unwrap()` with a
// `Holder<i64>` expected is the control.
![config(testing)]
![config(negative, E0307)]
namespace CryoTests::Negative::E0307MethodReceiverReturnNamesNoOwnerParameter;

import std::core::result::{ Result };

type struct RnHolder<T> {
    value: T;

    static try_make(value: T) -> Result<RnHolder<T>, i32> { return Result::Ok(RnHolder::<T> { value: value }); }
}

function main() -> i32 {
    const made: boolean = RnHolder::try_make(1).is_ok();   //~ ERROR[E0307] cannot infer the owner type argument for `RnHolder::try_make` from a polymorphic literal
    const kept: RnHolder<i64> = RnHolder::try_make(2).unwrap();
    if (made && kept.value == 2) { return 0; }
    return 1;
}
