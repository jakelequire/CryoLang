// E0213: a call whose callee is a value the program computes, and that value
// is no function.  `one()` is an `i32`; calling it is refused at the callee,
// with rustc's wording, rather than reaching code generation.  A computed
// callee that IS a function is called through (`pick()(2)`).
![config(testing)]
![config(negative, E0213)]
namespace CryoTests::Negative::CallOfNonFunction;

type struct Pair {
    a: i32;
    b: i32;
}

function one() -> i32 { return 1; }
function pair() -> Pair { return Pair { a: 1, b: 2 }; }
function inc(x: i32) -> i32 { return x + 1; }
function pick() -> (i32) -> i32 { return inc; }

function main() -> int {
    const a: i32 = one()(3);     //~ ERROR[E0213] expected function, found `i32`
    const p: i32 = pair()(4);    //~ ERROR[E0213] expected function, found `CryoTests::Negative::CallOfNonFunction::Pair`
    const ok: i32 = pick()(2);
    return a + p + ok;
}
