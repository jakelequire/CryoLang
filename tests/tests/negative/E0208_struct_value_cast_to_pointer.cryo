// E0208: a struct value is not an address, and `as` cannot say whether a
// pointer made from one would mean the value's address, its first field or
// its bytes, so the cast is refused - for an instantiation such as `String`
// too, whose shape is not produced until after the check, and for a call
// result as for a named local.  The value's address casts as any address
// does.
![config(testing)]
![config(negative, E0208)]
namespace CryoTests::Negative::E0208StructValueCastToPointer;

import std::collections::string::{ String };

type struct Plain { a: i32; }
type struct Boxed<T> { item: T; }

function make() -> Plain { return Plain { a: 1 }; }
function first_byte(p: u8*) -> u8 { return p[0]; }

function main() -> int {
    const text: String = String::from("abc");
    const from_local: u8* = text as u8*;   //~ ERROR[E0208] invalid cast between an aggregate
    const byte: u8 = first_byte(String::from("abc") as u8*);   //~ ERROR[E0208] invalid cast between an aggregate
    const boxed: Boxed<i32> = Boxed::<i32> { item: 1 };
    const from_instance: u8* = boxed as u8*;   //~ ERROR[E0208] invalid cast between an aggregate
    const as_number: i64 = boxed as i64;   //~ ERROR[E0208] invalid cast between an aggregate
    const from_call: u8* = make() as u8*;   //~ ERROR[E0208] invalid cast between an aggregate
    const plain: Plain = Plain { a: 1 };
    const address: u8* = &plain as u8*;
    const text_address: u8* = &text as u8*;
    return 0;
}
