// E0306: an implementation for references (`for mut &T`) is an
// implementation of those references alone.  A `for` over a value of a type
// no implementation of `Iterator` names is refused at the value, although a
// head for the references of some types exists.
![config(testing)]
![config(negative, E0306)]
namespace CryoTests::Negative::E0306ForOverTypeOnlyAReferenceHeadNames;

import std::core::option::{ Option };
import std::core::iter::{ Iterator };

type trait CfMarker { mark(&this) -> i64; }

type struct CfNotIterable { value: i64; }

// Iterators only for the writable references to a marked type.
implement<T> trait Iterator<i64> for mut &T where T: CfMarker {
    next(mut &this) -> Option<i64> { return Option::None; }
}

function main() -> int {
    const plain: CfNotIterable = CfNotIterable { value: 1 };
    mut total: i64 = 0;
    for (item in plain) { total = total + item; }
    //~^ ERROR[E0306] `CfNotIterable` does not implement `Iterator`
    return total as int;
}
