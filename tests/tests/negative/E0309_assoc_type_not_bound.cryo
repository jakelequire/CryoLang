// E0309: a trait that declares an associated type must have it bound by every
// impl - either positionally (`implement Seq<i32> for X`, the sugar for
// `Seq<Item = i32>`) or via the explicit body form (`type Item = i32;`). An
// impl that binds neither leaves `Seq::Item` unprojectable, so it is rejected
// rather than silently leaving a hole the projection resolver can never fill.
![config(testing)]
![config(negative, E0309)]
namespace CryoTests::Negative::AssocTypeNotBound;

type trait Seq {
    type Item;
    next_one(&this) -> i32;
}

type struct Nums { cur: i32; }

// Binds no `Item`: no `Seq<...>` arg and no `type Item = ...;` body. -> E0309
implement trait Seq for struct Nums {
    next_one(&this) -> i32 { return this.cur; }
}

function main() -> int {
    return 0;
}
