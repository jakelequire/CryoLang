// E0215/E0216: an impl-qualified call is argument-checked against the
// entries the named trait's implementation delivers - a method with a
// receiver takes the receiver as its first argument, as the help for
// E0156 spells it - so an arity the implementation does not offer is
// refused, and an argument of the wrong type is E0214 as any static
// call's is.  The bare `CfP::go()` is the E0156 tie here (two traits
// provide `go`), so without the head there is no signature to check.
![config(testing)]
![config(negative, E0215)]
namespace CryoTests::Negative::ImplQualifiedArity;

type trait CfBeta {
    go(&this) -> i32;
}

type trait CfGamma {
    go(&this) -> i32;
}

type struct CfP { v: i32; }

implement trait CfBeta for CfP {
    go(&this) -> i32 { return this.v * 2; }
}

implement trait CfGamma for CfP {
    go(&this) -> i32 { return this.v * 5; }
}

function main() -> int {
    const p: CfP = CfP { v: 1 };
    const a: i32 = (CfBeta for CfP)::go(&p);
    const b: i32 = (CfBeta for CfP)::go(&p, 1);   //~ ERROR[E0215] method `go` takes 1 argument(s) but 2 were supplied
    const c: i32 = (CfGamma for CfP)::go();       //~ ERROR[E0216] method `go` takes 1 argument(s) but 0 were supplied
    const d: i32 = (CfGamma for CfP)::go(1);      //~ ERROR[E0214] mismatched types
    return a + b + c + d;
}
