// An alias is the type it names, so two overloads whose parameters differ
// only by an alias and its target have one signature: the second is a
// redefinition, refused where it is declared.  An alias of an alias is the
// same type again.
![config(testing)]
![config(negative, E0206)]
namespace CryoTests::Negative::OverloadDiffersOnlyByAlias;

type OaCount = i64;
type OaTally = OaCount;

function oa_pick(x: i64) -> i64 { return x + 1; }
function oa_pick(x: OaCount) -> i64 { return 100; } //~ ERROR[E0206] defined multiple times

function oa_keep(x: OaTally, y: boolean) -> i64 { return x; }
function oa_keep(x: i64, y: boolean) -> i64 { return 0; } //~ ERROR[E0206] defined multiple times

function main() -> int {
    const c: OaCount = 1;
    return (oa_pick(c) + oa_keep(c, true)) as int;
}
