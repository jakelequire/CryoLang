// Compile-fail test: a method's slice parameter takes an argument as a
// function's does, so read access never becomes write access through it.  A
// `&Array<T>`, or `&x` of a `const` array, where a method's `mut &Slice<T>` is
// wanted is refused as a read-only borrow, not as a method that does not
// exist; the writable borrow of a writable array is the control.
![config(testing)]
![config(negative, E0251)]
namespace CryoTests::Negative::E0251ReadOnlyContainerForAMethodWritableSlice;

import std::core::slice::{ Slice };
import std::collections::array::{ Array };

type struct Zeroer {
    count: i64;

    write_each(&this, items: mut &Slice<i32>) -> void {
        for (mut i: i64 = 0; i < items.length(); i++) {
            items[i] = 0;
        }
    }
}

function from_borrow(z: &Zeroer, values: &Array<i32>) -> void {
    z.write_each(values);   //~ ERROR[E0251]
}

function from_const(z: &Zeroer) -> void {
    const values: Array<i32> = Array::<i32>::new();
    z.write_each(&values);   //~ ERROR[E0251]
    mut writable: Array<i32> = Array::<i32>::new();
    z.write_each(&writable);
}

function main() -> int {
    return 0;
}
