// E0214: a method called on a generic body's own instantiation of its
// owner (`xs.push` on an `Array<T>`) has its arguments checked against the
// method's parameters seen through that instantiation: `push` takes a `T`,
// and `Array::get` answers `Option<T>`.  Unchecked, the call reached code
// generation with no method to bind.
![config(testing)]
![config(negative, E0214)]
namespace CryoTests::Negative::GenericBodyMethodArgMismatch;

function dup_first<T>(xs: mut &Array<T>) -> void where T: Copy {
    xs.push(xs.get(0));   //~ ERROR[E0214] mismatched types
}

function main() -> i32 {
    mut xs: Array<i32> = Array::<i32>::new();
    xs.push(5);
    dup_first::<i32>(&xs);
    return 0;
}
