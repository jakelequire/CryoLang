// An array size that folds to a value above `i64::MAX` is refused as too
// large, not as a size that does not fold.  (A size LITERAL past 64 bits is
// E0010_array_size_too_large.cryo.)
![config(testing)]
![config(negative, E0010)]
namespace CryoTests::Negative::FoldedArraySizeTooLarge;

const ALL_ONES: u64 = 0xFFFF_FFFF_FFFF_FFFF;

function main() -> int {
    mut too_long: [u8; ALL_ONES];   //~ ERROR[E0010] array size 18446744073709551615 is too large
    return 0;
}
