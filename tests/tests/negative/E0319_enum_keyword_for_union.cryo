// E0319: the kind keyword before an `implement` head's type names the
// type's kind, so `enum` before a union is refused, in a trait
// implementation's head and an inherent one's.
![config(testing)]
![config(negative, E0319)]
namespace CryoTests::Negative::EnumKeywordForUnion;

type union Bits { signed: i32; unsigned: u32; }

type trait Raw {
    raw(&this) -> u32;
}

implement trait Raw for enum Bits {
//~^ ERROR[E0319] `CryoTests::Negative::EnumKeywordForUnion::Bits` is a union, not an enum
    raw(&this) -> u32 { return this.unsigned; }
}

implement enum Bits {
//~^ ERROR[E0319] `CryoTests::Negative::EnumKeywordForUnion::Bits` is a union, not an enum
    as_signed(&this) -> i32 { return this.signed; }
}

function main() -> int {
    return 0;
}
