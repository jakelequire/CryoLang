// E0307: an `![implicit]` generic call in statement position has no expected
// type, so the type argument cannot be recovered from context. The fix is to
// write it explicitly (`make<i32>()`) or bind it to a typed location.
![config(testing)]
![config(negative, E0307)]
namespace CryoTests::Negative::E0307CannotInferTypeArg;

import std::core::default;

![implicit]
function make<T>() -> T where T: Default {
    return T::default();
}

function main() -> int {
    make();
    return 0;
}
