// E0353: what `collections::raw_buffer` and `future::reactor` declare is
// internal to the standard library, so a program importing an item of
// either is refused at the import, and `String`'s buffer is a private
// field of its own module.
![config(testing)]
![config(negative, E0353)]
namespace CryoTests::Negative::E0353StandardLibraryInternalModules;

import std::collections::raw_buffer::{ RawBuffer };
//~^ ERROR[E0353] `std::collections::raw_buffer::RawBuffer` is internal to its package
import std::future::reactor::{ Reactor };
//~^ ERROR[E0353] `std::future::reactor::Reactor` is internal to its package
import std::collections::string::{ String };

function main() -> int {
    const owned: String = String::new();
    const bytes: i64 = owned.buffer.capacity();
    //~^ ERROR[E0353] field `buffer` of `std::collections::string::String` is private
    //~^^ ERROR[E0353] method `capacity` of `std::collections::raw_buffer::RawBuffer` is internal
    return bytes as int;
}
