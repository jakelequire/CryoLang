// E0353: `random::bits`, `alloc::heap` and HTTP/2's `hpack` and `huffman`
// are internal modules of the standard library, so a program importing one,
// as a module or for an item, is refused at the import, and `String`'s
// buffer is a private field of its own module.  Nothing here imports the
// aggregators that declare them.
![config(testing)]
![config(negative, E0353)]
namespace CryoTests::Negative::E0353StandardLibraryInternalModules;

import std::random::bits;
//~^ ERROR[E0353] module `std::random::bits` is internal to its package
import std::alloc::heap;
//~^ ERROR[E0353] module `std::alloc::heap` is internal to its package
import std::net::http2::hpack::{ HpackDecoder };
//~^ ERROR[E0353] module `std::net::http2::hpack` is internal to its package
import std::net::http2::huffman;
//~^ ERROR[E0353] module `std::net::http2::huffman` is internal to its package
import std::collections::string::{ String };

function main() -> int {
    const owned: String = String::new();
    const bytes: i64 = owned.buffer.capacity();
    //~^ ERROR[E0353] field `buffer` of `std::collections::string::String` is private
    return bytes as int;
}
