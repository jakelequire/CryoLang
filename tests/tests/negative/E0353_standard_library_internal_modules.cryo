// E0353: `collections::raw_buffer`, `future::reactor` and `random::bits`
// are internal modules of the standard library, so a program importing
// one, as a module or for an item, is refused at the import, and
// `String`'s buffer is a private field of its own module.  Nothing here
// imports the aggregators that declare them.
![config(testing)]
![config(negative, E0353)]
namespace CryoTests::Negative::E0353StandardLibraryInternalModules;

import std::collections::raw_buffer;
//~^ ERROR[E0353] module `std::collections::raw_buffer` is internal to its package
import std::collections::raw_buffer::{ RawBuffer };
//~^ ERROR[E0353] module `std::collections::raw_buffer` is internal to its package
import std::future::reactor::{ Reactor };
//~^ ERROR[E0353] module `std::future::reactor` is internal to its package
import std::random::bits;
//~^ ERROR[E0353] module `std::random::bits` is internal to its package
import std::collections::string::{ String };

function main() -> int {
    const owned: String = String::new();
    const bytes: i64 = owned.buffer.capacity();
    //~^ ERROR[E0353] field `buffer` of `std::collections::string::String` is private
    //~^^ ERROR[E0353] method `capacity` of `std::collections::raw_buffer::RawBuffer` is internal
    return bytes as int;
}
