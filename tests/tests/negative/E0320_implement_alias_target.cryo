// E0320: an implement head naming an alias implements for the type the
// alias names, which must be one a head names by its declaration; an alias
// of a generic instance, of a pointer or of a function type is refused, in
// a trait implementation's head and an inherent one's.
![config(testing)]
![config(negative, E0320)]
namespace CryoTests::Negative::ImplementAliasTarget;

type struct Wrapper<T> { val: T; }
type struct Plain { v: i32; }

type WideWrapper = Wrapper<i64>;
type PlainPointer = Plain*;
type Callback = (i32) -> i32;

type trait Widen {
    widen(&this) -> i64;
}

implement trait Widen for WideWrapper {
//~^ ERROR[E0320] `CryoTests::Negative::ImplementAliasTarget::WideWrapper` is an alias of `CryoTests::Negative::ImplementAliasTarget::Wrapper<i64>`, which an implement head cannot name through an alias
    widen(&this) -> i64 { return this.val * 2; }
}

implement trait Widen for PlainPointer {
//~^ ERROR[E0320] `CryoTests::Negative::ImplementAliasTarget::PlainPointer` is an alias of `CryoTests::Negative::ImplementAliasTarget::Plain*`, which an implement head cannot name through an alias
    widen(&this) -> i64 { return 1; }
}

implement WideWrapper {
//~^ ERROR[E0320] `CryoTests::Negative::ImplementAliasTarget::WideWrapper` is an alias of `CryoTests::Negative::ImplementAliasTarget::Wrapper<i64>`, which an implement head cannot name through an alias
    halved(&this) -> i64 { return this.val / 2; }
}

implement Callback {
//~^ ERROR[E0320] is an alias of `(i32) -> i32`, which an implement head cannot name through an alias
    applied(&this) -> i32 { return 0; }
}

function main() -> int {
    return 0;
}
