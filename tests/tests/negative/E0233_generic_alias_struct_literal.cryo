// E0233: a struct literal through a generic type alias is refused where it
// is written, with or without type arguments on the alias, as a path
// through one is.  The literal is written through the type the alias
// names; a non-generic alias's literal builds its target.
![config(testing)]
![config(negative, E0233)]
namespace CryoTests::Negative::GenericAliasStructLiteral;

type struct Pair<A, B> {
    first: A;
    second: B;
}

type Keyed<T> = Pair<T, i64>;
type Fixed = Pair<boolean, i64>;

function main() -> int {
    const a: Keyed<boolean> = Keyed::<boolean> { first: true, second: 3 };   //~ ERROR[E0233] `Keyed` is a generic type alias, and a struct literal through one
    const b: Keyed<boolean> = Keyed { first: true, second: 4 };              //~ ERROR[E0233] `Keyed` is a generic type alias, and a struct literal through one
    const c: Keyed<boolean> = Pair::<boolean, i64> { first: false, second: 5 };
    const d: Fixed = Fixed { first: true, second: 6 };
    return (a.second + b.second + c.second + d.second) as int;
}
