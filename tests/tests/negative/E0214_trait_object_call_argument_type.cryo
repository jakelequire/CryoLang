// E0214: an argument of a call through a trait object is checked against
// the trait method's parameter type, as at a direct call.
![config(testing)]
![config(negative, E0214)]
namespace CryoTests::Negative::TraitObjectCallArgumentType;

type trait Shape {
    scale(mut &this, k: i32) -> void;
}

function grow(s: virtual mut &Shape) -> void {
    s.scale(true);
    //~^ ERROR[E0214] mismatched types
}

function main() -> int {
    return 0;
}
