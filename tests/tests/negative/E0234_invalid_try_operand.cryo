// E0234: the `?` operator applied to a value whose type does not implement
// `Try` (here a plain `i32`): a scalar operand has nothing to propagate.
![config(testing)]
![config(negative, E0234)]
namespace CryoTests::Negative::E0234InvalidTryOperand;

function cf_main() -> int {
    const x: i32 = 5;
    const y: i32 = x?;      // `?` on a non-Result value   //~ ERROR[E0234] the `?` operator requires a
    return y;
}
