// E0234: the `?` operator applied to a non-`Result` (here a plain `i32`).
// `?` only unwraps a `Result` (or propagates its `Err`); a scalar operand
// has no error channel to forward.
![config(testing)]
![config(negative, E0234)]
namespace CryoTests::Negative::E0234InvalidTryOperand;

function cf_main() -> int {
    const x: i32 = 5;
    const y: i32 = x?;      // `?` on a non-Result value   //~ ERROR[E0234] the `?` operator requires a
    return y;
}
