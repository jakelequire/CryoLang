// E0358: `min`/`max` are `Iterator` defaults bounded `where This::Item: Ord`.
// An iterator whose Item is a reference (`&i64`) does not meet the bound - a
// reference has the traits an implementation for references gives it, not
// its referent's - so `min` is no method of it, refused at the call.  The
// implementation itself is accepted: the unused defaults are never checked
// against the reference.
![config(testing)]
![config(negative, E0358)]
namespace CryoTests::Negative::E0358IterMinReferenceItem;

import std::core::option::{ Option };
import std::core::iter::{ Iterator };

type struct CfOneReference {
    value: &i64;
    used: boolean;
}

implement trait Iterator<&i64> for struct CfOneReference {
    next(mut &this) -> Option<&i64> {
        if (this.used) { return Option::None; }
        this.used = true;
        return Option::Some(this.value);
    }
}

function main() -> int {
    const x: i64 = 4;
    mut it: CfOneReference = CfOneReference { value: &x, used: false };
    it.min();          //~ ERROR[E0358] no method named `min` found on
    return 0;
}
