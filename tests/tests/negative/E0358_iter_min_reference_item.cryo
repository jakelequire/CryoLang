// E0358: `min`/`max` are `Iterator` defaults bounded `where This::Item: Ord`.
// A reference is `Ord` where what it refers to is (`Ord for &T where T:
// Ord`), so an iterator of `&Plain`, whose `Plain` implements no `Ord`, does
// not meet the bound, and `min` is no method of it, refused at the call.
// The implementation itself is accepted: the unused defaults are never
// checked against the reference.
![config(testing)]
![config(negative, E0358)]
namespace CryoTests::Negative::E0358IterMinReferenceItem;

import std::core::option::{ Option };
import std::core::iter::{ Iterator };

type struct Plain {
    value: i64;
}

type struct CfOneReference {
    value: &Plain;
    used: boolean;
}

implement trait Iterator<&Plain> for struct CfOneReference {
    next(mut &this) -> Option<&Plain> {
        if (this.used) { return Option::None; }
        this.used = true;
        return Option::Some(this.value);
    }
}

function main() -> int {
    const x: Plain = Plain { value: 4 };
    mut it: CfOneReference = CfOneReference { value: &x, used: false };
    it.min();          //~ ERROR[E0358] no method named `min` found on
    return 0;
}
