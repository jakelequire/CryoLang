// E0104: an array type is written in brackets, `[T]` or `[T; N]`.  The
// postfix spelling is refused wherever a type is written, once per type,
// and the message carries the type rewritten in brackets: the same text the
// diagnostic's fix puts in its place.  Nested lengths read outside-in
// (`u64[2][3]` is `[[u64; 2]; 3]`), a reference or pointer stays outside or
// inside the brackets as it bound, and a grouping's parentheses go.  Each
// refused type is still read as the array it spells, so nothing after it
// fails: every error in the file is annotated.
![config(testing)]
![config(negative, E0104)]
namespace CryoTests::Negative::E0104PostfixArrayType;

type struct Node { v: i64; }

const ROW: i64 = 2;
const GRID: u64[2][3] = [[1, 2], [3, 4], [5, 6]];   //~ ERROR[E0104] array types are written `[T]`: write `[[u64; 2]; 3]`

type struct Holder {
    values: i64[];        //~ ERROR[E0104] array types are written `[T]`: write `[i64]`
    bytes: u8[4];         //~ ERROR[E0104] array types are written `[T]`: write `[u8; 4]`
    sized: i64[ROW * 2];  //~ ERROR[E0104] array types are written `[T]`: write `[i64; ROW * 2]`
}

function by_reference(xs: &i64[]) -> i64 { return 0; }        //~ ERROR[E0104] array types are written `[T]`: write `[i64]`
function of_pointers(xs: &Node*[]) -> i64 { return 0; }        //~ ERROR[E0104] array types are written `[T]`: write `[Node*]`
function of_references(xs: (&Node)[]) -> i64 { return 0; }     //~ ERROR[E0104] array types are written `[T]`: write `[&Node]`
function of_functions(fs: ((i64) -> i64)[]) -> i64 { return 0; }   //~ ERROR[E0104] array types are written `[T]`: write `[(i64) -> i64]`
function of_tuples(ts: (i64, i64)[]) -> i64 { return 0; }      //~ ERROR[E0104] array types are written `[T]`: write `[(i64, i64)]`
function pointer_to(p: i64[]*) -> i64 { return 0; }            //~ ERROR[E0104] array types are written `[T]`: write `[i64]*`
function optional(o: i64[]?) -> i64 { return 0; }              //~ ERROR[E0104] array types are written `[T]`: write `[i64]?`
function of_optionals(o: i64?[]) -> i64 { return 0; }          //~ ERROR[E0104] array types are written `[T]`: write `[i64?]`
function of_const_pointers(k: const u8*[]) -> i64 { return 0; }    //~ ERROR[E0104] array types are written `[T]`: write `[const u8*]`
function generic_argument(s: Option<i64[]>) -> i64 { return 0; }   //~ ERROR[E0104] array types are written `[T]`: write `[i64]`
function mutable_fixed(x: &mut i64[3]) -> i64 { return 0; }    //~ ERROR[E0104] array types are written `[T]`: write `[i64; 3]`

function main() -> int {
    const local: i64[] = [1, 2];                  //~ ERROR[E0104] array types are written `[T]`: write `[i64]`
    const bytes: [u8; 2] = [1, 2];
    const cast: u64 = (bytes as u8[2])[0] as u64;   //~ ERROR[E0104] array types are written `[T]`: write `[u8; 2]`
    return 0;
}
