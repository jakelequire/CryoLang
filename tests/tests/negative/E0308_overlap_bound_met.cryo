// E0308: a where-bound keeps two heads apart only while the one type they
// meet at fails it.  When that type meets the bound the heads overlap,
// whether the bound's implementation is written before the head or after.
![config(testing)]
![config(negative, E0308)]
namespace CryoTests::Negative::OverlapBoundMet;

type trait Convert<S> { static convert(source: S) -> This; }
implement<T> trait Convert<T> for T { static convert(source: T) -> T { return source; } }

type trait Fault { code(&this) -> i64; }

type struct Early { code: i64; }
implement trait Fault for struct Early { code(&this) -> i64 { return this.code; } }
implement<E> trait Convert<E> for struct Early where E: Fault {
    //~^ ERROR[E0308] conflicting implementations of trait `Convert<E>`: `Convert<E> for Early` overlaps `Convert<T> for T`, so a type both heads accept would select both
    static convert(source: E) -> Early { return Early { code: source.code() }; }
}

type struct Late { code: i64; }
implement<E> trait Convert<E> for struct Late where E: Fault {
    //~^ ERROR[E0308] conflicting implementations of trait `Convert<E>`: `Convert<E> for Late` overlaps `Convert<T> for T`, so a type both heads accept would select both
    static convert(source: E) -> Late { return Late { code: source.code() }; }
}
implement trait Fault for struct Late { code(&this) -> i64 { return this.code; } }

function main() -> int { return 0; }
