// E0358: in a generic body, a call on an instantiation that still names the
// body's parameters (`Wrap<U>`) that no method of it binds is refused where
// it is written - in a body that is called and in one that is not - and a
// method declared for other instances names the head it is declared for.
// Without this the call reached code generation bound to nothing.
![config(testing)]
![config(negative, E0358)]
namespace CryoTests::Negative::E0358GenericBodyInstantiationMissingMethod;

type struct Wrap<T> {
    value: T;
}

implement<T> struct Wrap<Wrap<T>> {
    inner(&this) -> T where T: Copy { return this.value.value; }
}

function called<U>(w: &Wrap<U>) -> i64 {
    w.no_such_method();
    //~^ ERROR[E0358] no method named `no_such_method` found on type
    return 0;
}

function never_called<U>(w: &Wrap<U>) -> i64 {
    w.other_missing();
    //~^ ERROR[E0358] no method named `other_missing` found on type
    return 0;
}

function inner_on_flat<U>(w: &Wrap<U>) -> i64 {
    w.inner();
    //~^ ERROR[E0358] no method named `inner` found on type
    return 0;
}

function main() -> int {
    const flat: Wrap<i32> = Wrap { value: 5 };
    return (called(&flat) + inner_on_flat(&flat)) as int;
}
