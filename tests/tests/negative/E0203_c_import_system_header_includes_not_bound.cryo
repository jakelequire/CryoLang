// E0203: an angle-bracket C import binds the declarations of the system
// header it names and of the system headers that header includes directly,
// and none from a header included any deeper.  `size_t` is declared neither
// in <ctype.h> nor in a header it includes directly, so it is not a type
// under the alias even where <ctype.h> reaches a deeper header declaring it.
![config(testing)]
![config(negative, E0203)]
namespace CryoTests::Negative::E0203CImportSystemHeaderIncludesNotBound;

extern module cctype := "C" {
    #include <ctype.h>
}

function main() -> int {
    const length: cctype::size_t = 4;   //~ ERROR[E0203] cannot find type `cctype::size_t` in this scope
    return length as int;
}
