// E0203: an angle-bracket C import binds the declarations of the system
// header it names and none from the system headers that header includes.
// `size_t` is never declared in <ctype.h> itself, so it is not a type under
// the alias even where <ctype.h> pulls in a header that declares it.
![config(testing)]
![config(negative, E0203)]
namespace CryoTests::Negative::E0203CImportSystemHeaderIncludesNotBound;

extern module cctype := "C" {
    #include <ctype.h>
}

function main() -> int {
    const length: cctype::size_t = 4;   //~ ERROR[E0203] cannot find type `cctype::size_t` in this scope
    return length as int;
}
