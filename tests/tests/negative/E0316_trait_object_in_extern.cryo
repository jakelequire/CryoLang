// E0316: an `extern` function cannot take or return a trait object, as a
// parameter, a return, or inside either; the C side has no table to call
// through.  A pointer to a C-known type stays accepted.
![config(testing)]
![config(negative, E0316)]
namespace CryoTests::Negative::TraitObjectInExtern;

type trait Shape {
    area(&this) -> i32;
}

extern "C" {
    function takes_object(s: virtual &Shape) -> i32;
    //~^ ERROR[E0316] `virtual &Shape` is a trait object, which an `extern` function `takes_object` cannot take or return
    function returns_objects() -> [virtual Shape*; 2];
    //~^ ERROR[E0316] `virtual Shape*` is a trait object, which an `extern` function `returns_objects` cannot take or return
    function takes_plain(p: i32*) -> i32;
}

function main() -> int {
    return 0;
}
