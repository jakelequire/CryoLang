// E0200: an enum pattern is held to the enum the SUBJECT is, by the
// definition each names - never by the variant leaf alone.  `Result::Ok`
// written against a user enum whose variants are also spelled `Ok` / `Err`
// names another enum; before the identity was asked, the leaf was read off
// the subject's variant list and the arm matched (`cf_get(3)` answered 6).
![config(testing)]
![config(negative, E0200)]
namespace CryoTests::Negative::E0200PatternNamesAnotherEnum;

type enum CfOutcome { Ok(i32); Err(i32); }

function cf_get(v: i32) -> CfOutcome {
    if (v > 10) { return CfOutcome::Err(v); }
    return CfOutcome::Ok(v * 2);
}

function main() -> int {
    match (cf_get(3)) {
        Result::Ok(_) => { return 6; }
        //~^ ERROR[E0200] pattern names enum `std::core::result::Result`, but the value matched is `CryoTests::Negative::E0200PatternNamesAnotherEnum::CfOutcome`
        CfOutcome::Err(e) => { return 100 + e; }
        _ => { return 50; }
    }
}
