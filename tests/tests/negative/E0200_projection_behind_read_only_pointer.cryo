// E0200: a read-only pointer to a type parameter's associated type
// (`const I::Item*`) stays read-only once the projection reduces to the type
// the impl binds: `Count`'s `Item` is `i32`, so the result is `const i32*`,
// and binding it to a writable `i32*` drops the `const`.
![config(testing)]
![config(negative, E0200)]
namespace CryoTests::Negative::ProjectionBehindReadOnlyPointer;

type trait Source {
    type Item;
    first(&this) -> const This::Item*;
}

type struct Count { n: i32; }

implement trait Source for struct Count {
    type Item = i32;
    first(&this) -> const i32* { return &this.n; }
}

function first_of<I>(it: &I) -> const I::Item* where I: Source {
    return it.first();
}

function main() -> int {
    const c: Count = Count { n: 9 };
    const read_only: const i32* = first_of(&c);
    const writable: i32* = first_of(&c);                              //~ ERROR[E0200] mismatched types
    return *read_only + *writable;
}
