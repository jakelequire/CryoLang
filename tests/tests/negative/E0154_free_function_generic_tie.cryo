// E0154: a free-function call that a generic and a non-generic overload both
// accept is ambiguous.
//
// A function is not preferred for being non-generic, as a method or a static
// method is not, so `same(x)` beside `same<U>(u: U)` and `same(u: i32)` names
// neither. A written type argument (`same::<i32>(x)`) calls the generic one;
// a generic whose where-clause the argument fails does not accept it, so the
// plain one is the only candidate - both in lang/free_function_generic_overload.cryo.
![config(testing)]
![config(negative, E0154)]
namespace CryoTests::Negative::FreeFunctionGenericTie;

function same<U>(u: U) -> i32 { return 1; }
function same(u: i32) -> i32 { return 2; }

type trait Shout { shout(&this) -> i32; }
type struct Loud { n: i32; }
implement trait Shout for struct Loud { shout(&this) -> i32 { return this.n; } }

function loud<U>(u: U) -> i32 where U: Shout { return 1; }
function loud(u: Loud) -> i32 { return 2; }

function inside<T>(t: T) -> i32 {
    const y: i32 = 3;
    return same(y);
    //~^ ERROR[E0154] `same` is ambiguous: a non-generic and a generic function both accept these arguments
}

function main() -> int {
    const x: i32 = 7;
    const a: i32 = same(x);
    //~^ ERROR[E0154] `same` is ambiguous: a non-generic and a generic function both accept these arguments
    const b: i32 = same(7);
    //~^ ERROR[E0154] `same` is ambiguous: a non-generic and a generic function both accept these arguments
    const c: i32 = CryoTests::Negative::FreeFunctionGenericTie::same(x);
    //~^ ERROR[E0154] `same` is ambiguous: a non-generic and a generic function both accept these arguments
    const d: i32 = loud(Loud { n: 1 });
    //~^ ERROR[E0154] `loud` is ambiguous: a non-generic and a generic function both accept these arguments
    return (a + b + c + d + inside(1)) as int;
}
