// E0308: an implementation for references (`for &T`) overlaps one for
// every type (`for T`), which accepts references too; it does not overlap
// one for the mutable references (`for mut &T`), nor one for a type that
// is no reference.
![config(testing)]
![config(negative, E0308)]
namespace CryoTests::Negative::ReferenceImplementationOverlap;

type trait Every { every(&this) -> i64; }
implement<T> trait Every for T { every(&this) -> i64 { return 1; } }
implement<T> trait Every for &T { every(&this) -> i64 { return 2; } }
//~^ ERROR[E0308] conflicting implementations of trait `Every`: `Every for &T` overlaps `Every for T`, so a type both heads accept would select both

type trait Shared { shared(&this) -> i64; }
implement<T> trait Shared for &T { shared(&this) -> i64 { return 1; } }
implement<T> trait Shared for mut &T { shared(&this) -> i64 { return 2; } }

type trait Plain { plain(&this) -> i64; }
implement<T> trait Plain for &T { plain(&this) -> i64 { return 1; } }
implement trait Plain for i64 { plain(&this) -> i64 { return 2; } }

function main() -> int { return 0; }
