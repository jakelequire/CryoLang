// E0010: a fixed-array size literal that doesn't fit in 64 bits. Without a
// check, this would parse with a silent wrap (e.g. 2^64+k -> k), yielding a
// garbage array type / under-allocation with no diagnostic. The parser
// rejects it up front.
// (The value-context number-too-large case is E0010_number_too_large.cryo.)
![config(testing)]
![config(negative, E0010)]
namespace CryoTests::Negative::ArraySizeTooLarge;

function main() -> int {
    mut a: i32[0x1_0000_0000_0000_0000];
    return 0;
}
