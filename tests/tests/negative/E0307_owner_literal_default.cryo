// E0307: a generic-owner static constructor whose owner type argument can only be
// bound from a polymorphic literal (`Wrap::new(0)` with no turbofish, no concrete
// argument, and no expected type) is now an ERROR, not a silent `i32` guess - the
// `Atomic<u64>::new(0)` truncation trap.  The remedy is an owner turbofish
// (`Wrap<i64>::new(0)`) or a typed binding (`const w: Wrap<i64> = ...`), both of
// which bind the owner authoritatively before the literal-default last resort.
//
// Counterpart to the positive coverage in
// tests/tests/lang/generic_static_owner_binding.cryo, which locks in that the
// authoritative sources still win.
![config(testing)]
![config(negative, E0307)]
namespace CryoTests::Negative::E0307OwnerLiteralDefault;

type struct Wrap<T> {
    v: T;
    static new(x: T) -> Wrap<T> { return Wrap<T> { v: x }; }
}

function main() -> int {
    // No turbofish, no expected type, argument is a polymorphic literal: the owner
    // `T` has no authoritative source, so this is E0307.
    Wrap::new(0);
    return 0;
}
