// W0005: a negated literal compared with a signed integer takes the
// operand's type, as a positive literal does, so nothing widens.  Only the
// comparison of two variables of different widths below warns.  An
// annotated file is checked both ways: a W0005 at any negated literal is
// unannotated and fails the suite.
![config(testing)]
![config(negative, W0005)]
namespace CryoTests::Negative::W0005NegatedLiteralTakesOperandType;

public function cf_negated_literals(x: i8, y: i16, z: i32, w: i64) -> i32 {
    mut hits: i32 = 0;
    if (x != -128) { hits += 1; }
    if (-128 != x) { hits += 1; }
    if (x < -1) { hits += 1; }
    if (y == -32768) { hits += 1; }
    if (z == -2147483648) { hits += 1; }
    if (z >= -7) { hits += 1; }
    if (w > -9223372036854775808) { hits += 1; }
    return hits;
}

public function cf_mixed_widths(a: i8, b: i32) -> boolean {
    return a == b;   //~ WARN[W0005] implicit conversion between `i8` and `i32`
}
