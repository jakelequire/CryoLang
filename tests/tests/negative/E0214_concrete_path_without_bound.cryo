// E0214: in a generic body, a path through a type no `where` bound is
// written on calls the type's own methods, so `CfHighError::from(error)`
// with `error: E` matches none of them: only `where CfHighError: From<E>`
// would give it a `from` taking an `E`.  Refused where it is written,
// whether or not anything instantiates the function.
![config(testing)]
![config(negative, E0214)]
namespace CryoTests::Negative::E0214ConcretePathWithoutBound;

import std::core::convert::{ From };

type enum CfLowError { Bad; }
type enum CfHighError { Low; }

implement trait From<CfLowError> for enum CfHighError {
    static from(value: CfLowError) -> CfHighError { return CfHighError::Low; }
}

function cf_unbounded<E>(error: E) -> CfHighError {
    return CfHighError::from(error);   //~ ERROR[E0214] mismatched types
}

function cf_other_argument<E>(error: E) -> CfHighError where CfHighError: From<i32> {
    return CfHighError::from(error);   //~ ERROR[E0214] mismatched types
}
