// E0453: a field moved out of an operand that runs on some paths only - the
// right of `&&` or `||`, an arm of `?:` or of an `if` expression - is a
// conditional partial move, refused as the same move inside an `if`
// statement is: the owner's release at scope exit could not tell whether
// the field is still there.  The same move made unconditionally compiles.
![config(testing)]
![config(negative, E0453)]
namespace CryoTests::Negative::E0453FieldMoveInConditionalOperand;

type struct CoHolder { a: [i64]; b: [i64]; }

function co_take(xs: [i64]) -> i64 { return xs.length(); }

function co_and(go: boolean) -> boolean {
    const h: CoHolder = CoHolder { a: [7, 8], b: [9] };
    return go && co_take(h.a) == 2;   //~ ERROR[E0453] cannot move field 'a' out of `h` on only some paths
}

function co_or(go: boolean) -> boolean {
    const h: CoHolder = CoHolder { a: [7, 8], b: [9] };
    return go || co_take(h.a) == 2;   //~ ERROR[E0453] cannot move field 'a' out of `h` on only some paths
}

function co_ternary(go: boolean) -> i64 {
    const h: CoHolder = CoHolder { a: [7, 8], b: [9] };
    return go ? co_take(h.a) : 0;   //~ ERROR[E0453] cannot move field 'a' out of `h` on only some paths
}

function co_if_expression(go: boolean) -> i64 {
    const h: CoHolder = CoHolder { a: [7, 8], b: [9] };
    return if (go) { co_take(h.a) } else { 0 };   //~ ERROR[E0453] cannot move field 'a' out of `h` on only some paths
}

function co_unconditional() -> i64 {
    const h: CoHolder = CoHolder { a: [7, 8], b: [9] };
    return co_take(h.a);
}

function main() -> int {
    return 0;
}
