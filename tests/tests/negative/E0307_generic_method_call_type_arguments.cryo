// E0307: a call writing more type arguments than a generic method has type
// parameters of its own is refused for the excess, as a call writing any
// on a method with none is, and not reported as a call naming no method.
// Through a reference and on a generic receiver alike; a call writing as
// many as the method has stands.
![config(testing)]
![config(negative, E0307)]
namespace CryoTests::Negative::GenericMethodCallTypeArguments;

type struct Square {
    side: i32;

    pick<T>(&this, value: T) -> T { return value; }
    both<A, B>(&this, a: A, b: B) -> A { return a; }
}

type struct Holder<T> {
    held: T;

    keep<U>(&this, value: U) -> U { return value; }
}

function through(s: &Square) -> i32 {
    return s.pick::<i32, u8>(4);
    //~^ ERROR[E0307] `CryoTests::Negative::GenericMethodCallTypeArguments::Square::pick` has 1 type parameter, and 2 type arguments are written
}

function main() -> int {
    const s: Square = Square { side: 3 };
    const a: i32 = s.pick::<i32, u8>(4);
    //~^ ERROR[E0307] `CryoTests::Negative::GenericMethodCallTypeArguments::Square::pick` has 1 type parameter, and 2 type arguments are written
    const b: i32 = s.both::<i32, u8, u8>(1, 2);
    //~^ ERROR[E0307] `CryoTests::Negative::GenericMethodCallTypeArguments::Square::both` has 2 type parameters, and 3 type arguments are written
    const h: Holder<i64> = Holder::<i64> { held: 7 };
    const c: i32 = h.keep::<i32, i32>(5);
    //~^ ERROR[E0307] has 1 type parameter, and 2 type arguments are written
    const d: i32 = s.pick::<i32>(4);
    const e: i32 = s.both::<i32, u8>(1, 2);
    return a + b + c + d + e + through(&s);
}
