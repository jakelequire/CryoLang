// E0152: a language item has one declaration.  The standard library declares
// `option`, so a program's claim to it as well is refused at both, each
// naming the other, rather than one of the two silently becoming the enum
// `?` and `for` desugar through.
![config(testing)]
![config(negative, E0152)]
namespace CryoTests::Negative::E0152LanguageItemDeclaredTwice;

![language("option")]
//~^ ERROR[E0152] directive `![language]`: the language item `option` is also declared by `std::core::option::Option`
type enum CfMaybe {
    Present(i32);
    Absent;
}

function main() -> int {
    const m: CfMaybe = CfMaybe::Absent;
    return match (m) {
        CfMaybe::Present(v) => { v }
        CfMaybe::Absent     => { 0 }
    };
}
