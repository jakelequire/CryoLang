// E0358: a method of `implement<> struct Wrap<i64>` belongs to `Wrap<i64>`
// alone - no other instance has it, and neither does a generic body's
// `Wrap<U>` - and the report names the head it is declared for.
![config(testing)]
![config(negative, E0358)]
namespace CryoTests::Negative::E0358InherentHeadForOneInstance;

type struct Wrap<T> {
    value: T;
}

implement<> struct Wrap<i64> {
    doubled(&this) -> i64 { return this.value * 2; }
}

function generic_doubled<U>(w: &Wrap<U>) -> i64 {
    return w.doubled();
    //~^ ERROR[E0358] no method named `doubled` found on type
}

function main() -> int {
    const w: Wrap<i32> = Wrap { value: 21 };
    return w.doubled() as int;
    //~^ ERROR[E0358] no method named `doubled` found on type
}
