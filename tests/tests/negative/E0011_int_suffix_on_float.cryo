// E0011: an integer type suffix on a floating-point literal (`1.5u8`,
// `2.0i32`). These used to lex with the contradictory integer suffix
// riding along in the lexeme (the literal has a fractional part, so it
// is a float, yet carried a `u8`/`i32` suffix). The lexer now rejects an
// integer suffix once a fractional part or exponent has been seen; only
// `f32`/`f64` are valid float suffixes.
![config(testing)]
![config(negative, E0011)]
namespace CryoTests::Negative::IntSuffixOnFloat;

function main() -> int {
    const f: f32 = 1.5u8;
    return 0;
}
