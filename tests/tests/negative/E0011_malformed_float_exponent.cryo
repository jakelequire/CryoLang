// E0011: a float literal whose exponent has no digits (`1e`, `1e+`, `2e-`).
// Without a check, these would lex and be silently valued as the mantissa
// (sscanf stops at the stray 'e'), so `1e` would become 1.0 with no
// diagnostic. The lexer requires at least one digit after e/E[+/-],
// mirroring the empty-hex/bin/oct rejection.
![config(testing)]
![config(negative, E0011)]
namespace CryoTests::Negative::MalformedFloatExponent;

function main() -> int {
    const f: f64 = 1e;   //~ ERROR[E0011] malformed float literal: the
    return 0;
}
