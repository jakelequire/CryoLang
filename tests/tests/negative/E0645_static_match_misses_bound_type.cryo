///! A `static match` over a parameter a primitive trait bounds, with no `_`
///! arm, must name every type the bound allows: the bound closes the set of
///! types a copy can bind, so a missing one is refused in the generic body,
///! whether or not any call asks for it.  Expression and statement position
///! alike, and through a supertrait of the trait written.

![config(testing)]
![config(negative, E0645)]
namespace CryoTests::Negative::E0645StaticMatchMissesBoundType;

function unsigned_code<T>() -> i32 where T: UnsignedInteger {
    return static match (T) {
    //~^ ERROR[E0645] this `static match` has no arm for `u128`, `usize`, which the bounds of `T` allow
        u8  => { 1 }
        u16 => { 2 }
        u32 => { 3 }
        u64 => { 4 }
    };
}

type trait Measure : Float { }

function float_note<T>() -> void where T: Measure {
    static match (T) {
    //~^ ERROR[E0645] this `static match` has no arm for `f64`, which the bounds of `T` allow
        f32 => { }
    }
}

function main() -> i32 {
    return unsigned_code::<u8>();
}
