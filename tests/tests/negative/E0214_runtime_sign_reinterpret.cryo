// E0214: passing a RUNTIME signed value to a same-width unsigned parameter
// (sub-64-bit) silently reinterprets the bits and changes the value
// (`take_u32(n)` with `n: i32 = -1` arrives as 4294967295). Assignment
// already rejects this; the call-arg gate must flag the runtime case too, not
// only literals, closing the asymmetric hole. The literal case is covered
// by E0214_negative_literal_unsigned_arg.cryo; this exercises the runtime
// path. (64-bit i64<->u64 passing stays lenient by design - see the positive
// coverage in tests/lang.)
![config(testing)]
![config(negative, E0214)]
namespace CryoTests::Negative::RuntimeSignReinterpret;

function take_u32(u: u32) -> void {
    printf("%u\n", u);
}

function main() -> int {
    mut n: i32 = -1;
    take_u32(n);
    return 0;
}
