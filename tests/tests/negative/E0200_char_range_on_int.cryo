// E0200: a `char` range pattern (`'a'..'z'`) requires a `char` subject.
// Matching it on an integer would make codegen decode the bounds with the
// char reader against an integer value - a silent type confusion - so sema
// rejects the mismatch up front.
![config(testing)]
![config(negative, E0200)]
namespace CryoTests::Negative::CharRangeOnInt;
function main() -> int { const n: i32 = 5; match (n) { 'a'..'z' => {} _ => {} } return 0; }   //~ ERROR[E0200] char range pattern requires a
