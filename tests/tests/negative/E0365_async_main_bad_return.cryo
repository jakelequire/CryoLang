// E0365: an `async function main` must produce something the process exit
// status can carry.
//
// `main`'s value IS the exit status, so the synthesized entry point has to
// return `i32`. An async root that produces anything else has no defined way to
// become one, and silently truncating or discarding it would make the program's
// exit code disagree with the value the source returns.
![config(testing)]
![config(negative, E0365)]
namespace CryoTests::Negative::E0365AsyncMainBadReturn;

import std::future;

async function main() -> i64 {   //~ ERROR[E0365] `async function main` must return `i32` or `void`
    return 0;
}
