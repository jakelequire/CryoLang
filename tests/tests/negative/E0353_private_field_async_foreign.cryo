// E0353: a lowered `async` method's body keeps the access of the type it was
// WRITTEN IN, and nothing more.  Its own owner's private fields stay reachable
// (lang/async_method.cryo covers that side); an unrelated type's do not.
![config(testing)]
![config(negative, E0353)]
namespace CryoTests::Negative::E0353PrivateAsyncForeign;

import std::future;
import std::future::ready;

type struct AfVault {
    private: hidden: i32;
    public: static af_new() -> AfVault { return AfVault { hidden: 0 }; }
}

type struct AfThief {
    private: own: i32;
    public: static af_new() -> AfThief { return AfThief { own: 0 }; }

    public: async af_steal(mut &this, v: AfVault*) -> i32 {
        const step: i32 = await Ready<i32>::new(1);
        return this.own + v.hidden + step;   //~ ERROR[E0353] field `hidden` of
    }
}

function main() -> int {
    mut t: AfThief = AfThief::af_new();
    mut v: AfVault = AfVault::af_new();
    return future::block_on(t.af_steal(&v));
}
