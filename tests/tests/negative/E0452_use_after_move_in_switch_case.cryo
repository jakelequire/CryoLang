// E0452: a value moved inside a `switch` case body and then reused is a
// use-after-move. Previously the move-checker passed `switch` straight through
// without walking case bodies, so an intra-case double-move (or a reuse after
// the switch) was silently accepted - the identical code outside a switch is
// caught. Cryo's switch has no fallthrough, so each case is an independent
// branch. The positive drop coverage is in tests/lang/switch_case_drops.cryo.
![config(testing)]
![config(negative, E0452)]
namespace CryoTests::Negative::UseAfterMoveInSwitchCase;

import std::core::drop;
import std::collections::array;

type struct Tracker {
    id: i32;
}

implement trait Drop for struct Tracker {
    drop(mut &this) -> void {
        printf("DROP %d\n", this.id);
    }
}

function main() -> int {
    mut sel: i32 = 0;
    switch (sel) {
        case 0: {
            mut t: Tracker = Tracker { id: 7 };
            mut a: Array<Tracker> = Array<Tracker>::new();
            a.push(t);
            mut b: Array<Tracker> = Array<Tracker>::new();
            b.push(t);
        }
        default: { }
    }
    return 0;
}
