// E0318: a union does not record which of its fields it holds, so nothing
// can be generated from them; its `with` clause is refused where it is
// written.  The struct with the same fields is the control.
![config(testing)]
![config(negative, E0318)]
namespace CryoTests::Negative::E0318DeriveOnUnion;

import std::core::cmp::{ Eq };

type union DuBits with [Eq] {   //~ ERROR[E0318] a union cannot derive traits
    whole: i64;
    real: f64;
}

type struct DuBoth with [Eq] {
    whole: i64;
    real: f64;
}

function main() -> i32 {
    return 0;
}
