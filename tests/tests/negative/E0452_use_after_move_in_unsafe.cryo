// `unsafe` is not a move-checking off-switch.
//
// It marks the programmer taking responsibility for ownership the compiler
// cannot follow - ownership reached through a raw pointer - and nothing else.
// A use-after-move of an ordinary binding has nothing to do with raw pointers,
// so it is still rejected inside an `unsafe` block.
//
// This was silently accepted before the move checker learned about unsafe
// blocks: the pass had no case for them, so it never descended, while drop
// insertion (which does walk them) went on suppressing drops for moves the
// checker never saw - the leak-or-double-free divergence both passes warn
// about. The permitted side lives in lang/deref_take_in_unsafe.cryo.
![config(testing)]
![config(negative, E0452)]
namespace CryoTests::Negative::UseAfterMoveInUnsafe;

type struct Res {
    id: i64;

    static new(id: i64) -> Res { return Res { id: id }; }

    drop(mut &this) -> void { }
}

function consume(r: Res) -> i64 { return r.id; }

function main() -> int {
    unsafe {
        mut a: Res = Res::new(1);
        const first:  i64 = consume(a);
        const second: i64 = consume(a);   // `a` was moved into the first call
        return (first + second) as int;
    }
}
