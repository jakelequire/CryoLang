// E0100: `const` marks what a pointer points at, so a grouped pointer after
// `const` must itself be pointed at: `const (u8*)*`.  A group with no `*`
// after it would be a read-only pointer VALUE, which Cryo has no type for.
![config(testing)]
![config(negative, E0100)]
namespace CryoTests::Negative::ReadOnlyGroupNotPointedAt;

function grouped_pointer(p: const (u8*)) -> u8 {                        //~ ERROR[E0100] expected `*` after `const (u8*)`
    return 0;
}

function main() -> int {
    return 0;
}
