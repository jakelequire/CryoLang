// E0306: the standard library's `FilterIter<I>` is declared
// `where I: Iterator`, because its field's `I::Item` means `Iterator`'s
// `Item` and a declaration's parameter has no other place to say so.  An
// argument that is not an iterator is refused where it is written.
![config(testing)]
![config(negative, E0306)]
namespace CryoTests::Negative::FilterIterWhereBound;

import std::core::iter;
import std::core::iter::{ FilterIter };

function is_pos(x: &i64) -> boolean { return *x > 0; }

function main() -> int {
    const f: FilterIter<i64> = FilterIter::<i64>::new(5, is_pos);   //~ ERROR[E0306] the trait bound `i64: Iterator` is not satisfied
    return 0;
}
