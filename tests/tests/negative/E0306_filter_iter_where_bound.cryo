// E0306: a filtering adapter declared `where I: Iterator`, because its
// field's `I::Item` means `Iterator`'s `Item` and a declaration's parameter
// has no other place to say so.  An argument that is not an iterator is
// refused where it is written.
![config(testing)]
![config(negative, E0306)]
namespace CryoTests::Negative::FilterIterWhereBound;

import std::core::iter::{ Iterator };

type struct Filtered<I, Predicate> where I: Iterator, Predicate: (&I::Item) -> boolean {
    inner: I;
    pred:  Predicate;
}

function is_pos(x: &i64) -> boolean { return *x > 0; }

function main() -> int {
    const f: Filtered<i64, (&i64) -> boolean> = Filtered::<i64, (&i64) -> boolean> { inner: 5, pred: is_pos };   //~ ERROR[E0306] the trait bound `i64: Iterator` is not satisfied
    return 0;
}
