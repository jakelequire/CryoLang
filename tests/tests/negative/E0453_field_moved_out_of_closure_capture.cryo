///! A closure keeps what it captures for every call: a `move` closure
///! releases it when the closure is released, and any other closure borrows
///! it from its owner.  Moving a field out of a capture inside the body
///! leaves that owner to release the field a second time, so it is refused.

![config(testing)]
![config(negative, E0453)]
namespace CryoTests::Negative::E0453FieldMovedOutOfClosureCapture;

type struct Tracked {
    id: i32;
}

implement trait Drop for struct Tracked {
    drop(mut &this) -> void { }
}

type struct Holder {
    n: Tracked;
}

type struct Outer {
    inner: Holder;
}

function keep(t: Tracked) -> i32 { return t.id; }

function borrowing_closure() -> i32 {
    const holder: Holder = Holder { n: Tracked { id: 2 } };
    const f = () -> i32 { return keep(holder.n); };
    //~^ ERROR[E0453] cannot move field `n` out of a closure's capture
    return f();
}

function owning_closure() -> i32 {
    const holder: Holder = Holder { n: Tracked { id: 3 } };
    const f = move () -> i32 { return keep(holder.n); };
    //~^ ERROR[E0453] cannot move field `n` out of a closure's capture
    return f();
}

function nested_field() -> i32 {
    const outer: Outer = Outer { inner: Holder { n: Tracked { id: 4 } } };
    const f = () -> i32 {
        const taken: Tracked = outer.inner.n;
        //~^ ERROR[E0453] cannot move field `n` out of a closure's capture
        return taken.id;
    };
    return f();
}

function main() -> i32 {
    return 0;
}
