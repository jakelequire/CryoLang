// E0205: a value binding redeclared in the same scope. Previously the
// duplicate was silently dropped from the scope index (debug log only), so
// `const x = 1; const x = 2;` compiled with one binding quietly winning.
// Shadowing in a nested block is a distinct scope and stays legal (see the
// positive coverage in tests/lang).
![config(testing)]
![config(negative, E0205)]
namespace CryoTests::Negative::DuplicateLocal;

function main() -> int {
    const x: i32 = 1;
    const x: i32 = 2;
    return x;
}
