// E0205: a value binding redeclared in the same scope must be rejected, not
// silently dropped from the scope index (debug log only) - `const x = 1;
// const x = 2;` must not compile with one binding quietly winning.
// Shadowing in a nested block is a distinct scope and stays legal (see the
// positive coverage in tests/lang).
![config(testing)]
![config(negative, E0205)]
namespace CryoTests::Negative::DuplicateLocal;

function main() -> int {
    const x: i32 = 1;
    const x: i32 = 2;   //~ ERROR[E0205] the name `x` is already declared
    return x;
}
