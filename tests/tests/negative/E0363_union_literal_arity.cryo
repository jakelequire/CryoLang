// E0363: a union literal that initializes more than one field.  A `union`
// is one-of-N storage, so exactly one variant field may be set in a
// literal; naming two is an arity error.
![config(testing)]
![config(negative, E0363)]
namespace CryoTests::Negative::E0363UnionLiteralArity;

type union CfEither {
    a: i32;
    b: f32;
}

function cf_main() -> int {
    const u: CfEither = CfEither { a: 1, b: 2.0 };   // two fields set
    return 0;
}
