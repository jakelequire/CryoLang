// E0208: a cast from a pointer to a struct value.  A cast never reads
// through a pointer; `*p` is how the value it points at is read.
![config(testing)]
![config(negative, E0208)]
namespace CryoTests::Negative::CastStructPointerToValue;

type struct Point {
    x: i32;
    y: i32;
}

function main() -> int {
    const p: Point* = new Point { x: 1, y: 2 };
    const read: Point = *p;
    const cast: Point = p as Point;
    //~^ ERROR[E0208] invalid cast between an aggregate type (struct/tuple/array) and a scalar or pointer
    return read.x + cast.y;
}
