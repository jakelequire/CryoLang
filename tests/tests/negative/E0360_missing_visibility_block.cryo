// E0360: a `type class` body with members but no visibility block.  Unlike
// structs/unions, class members must sit under an explicit `public:` /
// `private:` / `protected:` section; a bare member list is rejected.
![config(testing)]
![config(negative, E0360)]
namespace CryoTests::Negative::E0360MissingVisibilityBlock;

type class CfAnimal {
    name: i32;                       // no visibility block around this member
}

function cf_main() -> int {
    return 0;
}
