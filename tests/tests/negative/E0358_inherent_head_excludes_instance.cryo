// E0358: a method an inherent block declares for some instances
// (`implement<T> struct Wrap<Wrap<T>>`) is no method of an instance the head
// does not accept, and the report names the head it is declared for.
![config(testing)]
![config(negative, E0358)]
namespace CryoTests::Negative::E0358InherentHeadExcludesInstance;

type struct Wrap<T> {
    value: T;
}

implement<T> struct Wrap<Wrap<T>> {
    inner(&this) -> T where T: Copy { return this.value.value; }
}

function main() -> int {
    const flat: Wrap<i32> = Wrap { value: 5 };
    return flat.inner();
    //~^ ERROR[E0358] no method named `inner` found on type
}
