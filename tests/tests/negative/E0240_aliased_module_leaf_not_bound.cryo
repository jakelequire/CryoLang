///! A module imported under an alias is named by the alias alone: its own
///! leaf binds nothing in the importing file, so a path through the leaf
///! is a module the file does not import.

![config(testing)]
![config(negative, E0240)]
namespace CryoTests::Negative::E0240AliasedModuleLeafNotBound;

import std::collections::hashmap as maps;

function cf_leaf_of_aliased_module() -> i64 {
    const through_alias: maps::HashMap<i64, i64> = maps::HashMap::<i64, i64>::new();
    const through_leaf: hashmap::HashMap<i64, i64> = maps::HashMap::<i64, i64>::new();
    //~^ ERROR[E0240] `hashmap` is not reachable from this module
    return through_alias.length() + through_leaf.length();
}
