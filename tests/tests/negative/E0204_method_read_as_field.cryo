// E0204: `t.kind` where `kind` is a method of `t`'s type and no field is
// named `kind`.  A method is reached only by calling it, so the read names
// nothing a value can be taken from; the type check refuses it where it is
// written, directly and through a `Deref` pointee alike, while the calls
// and the field read beside them pass.
![config(testing)]
![config(negative, E0204)]
namespace CryoTests::Negative::MethodReadAsField;

import std::alloc::box::{ Box };

type enum K { A; B; }

type struct T {
    n: i32;

    kind(&this) -> K {
        if (this.n > 0) { return K::B; }
        return K::A;
    }
}

function main() -> int {
    const t: T* = new T { n: 1 };
    const b: Box<T> = Box::new(T { n: 2 });
    if (t.kind() == K::B && b.kind() == K::B && b.n == 2) { return 0; }
    if (t.kind == K::B) { return 1; }   //~ ERROR[E0204] no field `kind` on type `CryoTests::Negative::MethodReadAsField::T`
    if (b.kind == K::B) { return 2; }   //~ ERROR[E0204] no field `kind` on type `std::alloc::box::Box`
    return 3;
}
