// E0233: a call through a trait's own path, `CfBeta::go(&p)`, selects the
// implementation by its first argument's type.  With no argument nothing
// selects - a static method through the trait's path, or a method called
// with nothing - and the call is refused where it is written, the help
// naming the impl-qualified path that does select.  An argument whose type
// does not implement the trait is E0306, and the arguments are checked
// against the implementation the receiver selects (E0215).  Before, sema
// said nothing at any of these and codegen refused each as an unresolvable
// name (E0636 "cannot resolve 'CfBeta::go'").
![config(testing)]
![config(negative, E0233)]
namespace CryoTests::Negative::TraitQualifiedUnselected;

type trait CfBeta {
    go(&this) -> i32;
    static make() -> i32;
}

type struct CfP { v: i32; }
type struct CfQ { v: i32; }

implement trait CfBeta for CfP {
    go(&this) -> i32 { return this.v * 2; }
    static make() -> i32 { return 2; }
}

function main() -> int {
    const p: CfP = CfP { v: 1 };
    const q: CfQ = CfQ { v: 1 };
    const a: i32 = CfBeta::go(&p);
    const b: i32 = CfBeta::go();        //~ ERROR[E0233] `CfBeta::go()` selects no implementation
    const c: i32 = CfBeta::make();      //~ ERROR[E0233] `CfBeta::make()` selects no implementation
    const d: i32 = CfBeta::go(&q);      //~ ERROR[E0306] `CfQ` does not implement `CfBeta`
    const e: i32 = CfBeta::go(&p, 1);   //~ ERROR[E0215] method `go` takes 1 argument(s) but 2 were supplied
    return a + b + c + d + e;
}
