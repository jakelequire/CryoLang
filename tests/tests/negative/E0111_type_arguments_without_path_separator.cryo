// E0111: `make<i64>()` parses as the comparisons `(make < i64) > ()`; with
// `i64` a type and no value it is read as the call `make::<i64>()` and its
// spelling refused at the `<`.  That call is refused too (an argument is
// missing), so no fix is offered - only help - and nothing reports the
// comparison reading.
![config(testing)]
![config(negative, E0111)]
namespace CryoTests::Negative::TypeArgumentsWithoutPathSeparator;

function make<T>(seed: T) -> T { return seed; }

function main() -> int {
    const missing: i64 = make<i64>();
    //~^ ERROR[E0216] function `make` takes 1 argument(s) but 0 were supplied
    //~^^ ERROR[E0111] type arguments in an expression are written with `::<`
    return 0;
}
