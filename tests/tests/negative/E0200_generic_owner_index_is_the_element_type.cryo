// Compile-fail test: inside an implementation for a generic type, `this[i]`
// is the element and `this.index(i)` the pointer to it, so neither is
// accepted as another type, on a slice and on an array whose index
// implementation has a where-clause the bounds in scope give.  Reading them
// as the element type and the element pointer are the controls.  A generic
// owner nothing indexes, and a type parameter no bound gives `Index`, are
// refused at the `[]` rather than typed as anything.
![config(testing)]
![config(negative, E0200)]
namespace CryoTests::Negative::E0200GenericOwnerIndexIsTheElementType;

import std::core::slice::{ Slice };
import std::core::hash::{ Hasher };
import std::collections::array::{ Array };
import std::alloc::allocator::{ Allocator };

type trait Reads {
    read_into<H>(&this, hasher: mut &H) -> void where H: Hasher;
}

implement<T> trait Reads for struct Slice<T> {
    read_into<H>(&this, hasher: mut &H) -> void
    where H: Hasher {
        const element: H = this[0];   //~ ERROR[E0200]
        const pointer: i64 = this.index(0);   //~ ERROR[E0200]
        const control: &T = &this[0];
        const control_pointer: T* = this.index(0);
    }
}

implement<T, A> trait Reads for struct Array<T, A> where A: Allocator {
    read_into<H>(&this, hasher: mut &H) -> void
    where H: Hasher {
        const element: H = this[0];   //~ ERROR[E0200]
        const pointer: i64 = this.index(0);   //~ ERROR[E0200]
        const control: &T = &this[0];
        const control_pointer: T* = this.index(0);
    }
}

type struct Holder<T> {
    value: T;
}

implement<T> trait Reads for struct Holder<T> {
    read_into<H>(&this, hasher: mut &H) -> void
    where H: Hasher {
        const element: i64 = this[0];   //~ ERROR[E0200]
    }
}

function first<T>(items: T) -> i64 {
    const element: i64 = items[0];   //~ ERROR[E0200]
    return element;
}

function main() -> int {
    return 0;
}
