// E0216: a call through a trait object is checked against the trait
// method's parameters past its receiver, as a direct call is.
![config(testing)]
![config(negative, E0216)]
namespace CryoTests::Negative::TraitObjectCallArguments;

type trait Shape {
    scale(mut &this, k: i32) -> void;
}

function grow(s: virtual mut &Shape) -> void {
    s.scale();
    //~^ ERROR[E0216] method `scale` takes 1 argument(s) but 0 were supplied
}

function main() -> int {
    return 0;
}
