// E0628: the bounds of a range pattern on an unsigned subject are ordered as
// unsigned values, so a low bound past `i64::MAX` is a large value, not a
// negative one, and `u64::MAX..1` is reversed.
![config(testing)]
![config(negative, E0628)]
namespace CryoTests::Negative::ReversedU64RangePatternPastI64Max;
function main() -> int { const x: u64 = 1; match (x) { 0xFFFF_FFFF_FFFF_FFFF..1 => {} _ => {} } return 0; }   //~ ERROR[E0628] range pattern lower bound (18446744073709551615) exceeds upper bound (1)
