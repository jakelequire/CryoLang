// E0302: an impl head names EVERY parameter of the template it is written
// for, or a concrete instantiation.  `Buf<A = Tag>` defaults its one
// parameter, and a bare `implement trait Show for Buf` has two readings - an
// impl for every `Buf<A>`, or one for `Buf<Tag>` - which the tree gave it by
// the module the head was written in.  The writer says which:
// `implement<A> trait Show for Buf<A>` or `implement trait Show for Buf<Tag>`.
![config(testing)]
![config(negative, E0302)]
namespace CryoTests::Negative::E0302ImplHeadElidesAllParams;

type struct Tag { n: i32; }
type struct Buf<A = Tag> { a: A; }
type trait Show { show(&this) -> int; }

implement trait Show for Buf {
//~^ ERROR[E0302] `Buf` is a template with 1 parameter, and this impl head names 0 of them
    show(&this) -> int { return 1; }
}

function main() -> int { return 0; }
