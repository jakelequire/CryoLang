// E0353: a constant named by a path in a pattern is reached as the same path
// written as a value is, so a constant private to its module is refused
// there too.
![config(testing)]
![config(negative, E0353)]
namespace CryoTests::Negative::E0353ConstantPatternPathPrivate;

import std::collections::str;

function classify(scalar: u32) -> i32 {
    return match (scalar) {
        str::REPLACEMENT_SCALAR => { 1 }
        //~^ ERROR[E0353] `std::collections::str::REPLACEMENT_SCALAR` is private and cannot be named
        _ => { 0 }
    };
}

function main() -> int {
    return classify(3);
}
