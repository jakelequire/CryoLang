// E0154: a function taken as a value whose overloads include a generic one,
// where more than one overload fits what is written.  A turbofish alone does
// not choose between two generic overloads that both take it, and with no
// turbofish and no expected function type nothing chooses at all.
![config(testing)]
![config(negative, E0154)]
namespace CryoTests::Negative::OverloadedGenericFunctionValue;

function pick<T>(x: T) -> T { return x; }
function pick<T>(x: T, y: T) -> T { return y; }

function main() -> int {
    const a = pick::<i32>;   //~ ERROR[E0154] `pick` is overloaded, and nothing here says which overload is meant
    const b = pick;          //~ ERROR[E0154] `pick` is overloaded, and nothing here says which overload is meant
    const c: (i32) -> i32 = pick::<i32>;
    return c(0);
}
