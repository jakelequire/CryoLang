// E0460: an assignment that would leave a field, an element, or what a
// pointer points at holding a borrow of a temporary the assignment made.
//
// A value made in a statement and only borrowed there is released when the
// statement ends. A place outlives the assignment that writes it as a local
// does, so a borrow of the temporary kept there points into released
// storage. Each case writes a different place: a field of a local, a field
// reached through a pointer, what a pointer points at, an array's element,
// and a field of a field. The permitted side - an owned result, a scalar, a
// borrow of a binding, each written into a place - is
// lang/borrowed_temporary_bindings.cryo.
![config(testing)]
![config(negative, E0460)]
namespace CryoTests::Negative::PlaceAssignmentOfReleasedTemporary;

import std::collections::array::{ Array };
import std::collections::str::{ Str };
import std::collections::string::{ String };

type struct Holder {
    text: Str;
}

type struct Outer {
    inner: Holder;
}

function make_string() -> String {
    return String::from_str(Str::new("text"));
}

function main() -> int {
    mut holder: Holder = Holder { text: Str::new("") };
    holder.text = make_string().as_str();
    //~^ ERROR[E0460] the place assigned would point into a temporary that is released at the end of this assignment
    const through: mut Holder* = &holder;
    through.text = make_string().as_str();
    //~^ ERROR[E0460] the place assigned would point into a temporary that is released at the end of this assignment
    mut slot: Str = Str::new("");
    const pointer: mut Str* = &slot;
    *pointer = make_string().as_str();
    //~^ ERROR[E0460] the place assigned would point into a temporary that is released at the end of this assignment
    mut views: Array<Str> = Array::<Str>::new();
    views.push(Str::new(""));
    views[0] = make_string().as_str();
    //~^ ERROR[E0460] the place assigned would point into a temporary that is released at the end of this assignment
    mut outer: Outer = Outer { inner: Holder { text: Str::new("") } };
    outer.inner.text = make_string().as_str();
    //~^ ERROR[E0460] the place assigned would point into a temporary that is released at the end of this assignment
    return (holder.text.length() + slot.length() + views[0].length() + outer.inner.text.length()) as int;
}
