// E0318: the implementations a `with` clause generates are module items,
// so a type declared in a function body cannot derive; its clause is
// refused where it is written.  The same type at module level is the
// control.
![config(testing)]
![config(negative, E0318)]
namespace CryoTests::Negative::E0318DeriveInFunctionBody;

import std::core::cmp::{ Eq };

type struct DbOutside with [Eq] {
    x: i64;
}

function local_type() -> i64 {
    type struct DbInside with [Eq] {   //~ ERROR[E0318] a type declared in a function body cannot derive traits
        x: i64;
    }
    return 0;
}

function main() -> i32 {
    return 0;
}
