// E0455: a `move` closure would own the thread scope's handle beyond the
// scope's body; a closure written without `move` that uses the handle
// borrows from the body (the control).
![config(testing)]
![config(negative, E0455)]
namespace CryoTests::Negative::MoveClosureCapturesThreadScope;

import std::thread;

function main() -> int {
    thread::scope((s: mut &thread::Scope) -> void {
        const owning = move () -> void { s.spawn(() -> void { }); };
        //~^ ERROR[E0455] a `move` closure cannot capture the thread scope's handle `s`
        const borrowing = () -> void { s.spawn(() -> void { }); };
        borrowing();
    });
    return 0;
}
