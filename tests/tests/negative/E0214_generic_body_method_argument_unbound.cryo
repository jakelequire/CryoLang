// E0214: in a generic body, a method call on the body's own instantiation
// (`Array<T>`, `CfW<T>`) whose argument binds to no candidate is refused
// at the argument - an `i64` for `Array::get`'s `u64` index, which the
// copies of the body could not bind either - and an overload set none of
// whose members takes the arguments is refused at the call.
![config(testing)]
![config(negative, E0214)]
namespace CryoTests::Negative::GenericBodyMethodArgumentUnbound;

type struct CfW<T> {
    v: T;
    put(&this, x: u64) -> i32 { return 1; }
    put(&this, x: string) -> i32 { return 2; }
}

function cf_last_or<T>(xs: &Array<T>, fallback: T) -> T where T: Copy {
    if (xs.length() == 0) { return fallback; }
    const i: i64 = xs.length() - 1;
    return xs.get(i).unwrap();          //~ ERROR[E0214] mismatched types
}

function cf_put<T>(w: &CfW<T>) -> i32 {
    const i: i64 = 3;
    return w.put(i);                    //~ ERROR[E0214] no overload of `put` accepts these arguments
}

function main() -> int {
    mut a: Array<i32> = Array::<i32>::new();
    a.push(4);
    const w: CfW<i32> = CfW::<i32> { v: 1 };
    return cf_last_or(&a, 0) + cf_put(&w);
}
