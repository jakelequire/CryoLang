// E0502: the data model a text format reads into is `std::encoding::value`,
// shared by every format; `std::encoding::json` offers only JSON's own
// names (`Json`, `JsonError`, `JsonErrorKind`), and the model's names carry
// no `Json` prefix.
![config(testing)]
![config(negative, E0502)]
namespace CryoTests::Negative::ValueModelIsNotInJson;
import std::encoding::json::{ Value };   //~ ERROR[E0502] `std::encoding::json` does not offer `Value`
import std::encoding::value::{ ToJson };   //~ ERROR[E0502] `std::encoding::value` does not offer `ToJson`
function main() -> int { return 0; }
