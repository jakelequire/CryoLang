// E0003: a multi-character literal like 'AB' is rejected. Without a scan
// for a closing quote to tell a multi-char literal apart from a genuinely
// unterminated one, this would be misdiagnosed as "unterminated" with a
// machine-applicable autofix that inserts a stray quote (turning 'AB' into
// 'A'B'). The lexer reports a single clear error here and offers no harmful fix.
![config(testing)]
![config(negative, E0003)]
namespace CryoTests::Negative::MultiCharCharLiteral;
function main() -> int {
    const c: char = 'AB';   //~ ERROR[E0003] one codepoint
    return 0;
}
