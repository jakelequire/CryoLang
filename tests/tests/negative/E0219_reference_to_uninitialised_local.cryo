///! A reference always names a value: `&x` of a local that some path has
///! not given a value yet is refused, as is any other use of it.  A store
///! through the reference would release whatever the uninitialised storage
///! held.  A raw pointer (`T*`) may still be handed out to be filled.

![config(testing)]
![config(negative, E0219)]
namespace CryoTests::Negative::E0219ReferenceToUninitialisedLocal;

type struct Owned {
    id: i64;
}

implement trait Drop for struct Owned {
    drop(mut &this) -> void { }
}

type struct Pair {
    first:  Owned;
    second: Owned;
}

function fill(place: mut &Owned) -> void { *place = Owned { id: 5 }; }

function read(value: &Owned) -> i64 { return value.id; }

function never_assigned() -> void {
    mut value: Owned;
    fill(&value);
    //~^ ERROR[E0219] reference to `value`, which is not initialised on every path here
}

function assigned_on_one_branch(ready: boolean) -> i64 {
    mut value: Owned;
    if (ready) { value = Owned { id: 1 }; }
    return read(&value);
    //~^ ERROR[E0219] reference to `value`, which is not initialised on every path here
}

function assigned_in_a_loop_body(times: i64) -> i64 {
    mut value: Owned;
    for (mut i: i64 = 0; i < times; i++) { value = Owned { id: i }; }
    return read(&value);
    //~^ ERROR[E0219] reference to `value`, which is not initialised on every path here
}

function one_field_of_two() -> i64 {
    mut pair: Pair;
    pair.first = Owned { id: 1 };
    const _borrowed: &Pair = &pair;
    //~^ ERROR[E0219] reference to `pair`, which is not initialised on every path here
    return 0;
}

function one_slot_of_two() -> i64 {
    mut slots: [Owned; 2];
    slots[0] = Owned { id: 1 };
    const _borrowed: &[Owned; 2] = &slots;
    //~^ ERROR[E0219] reference to `slots`, which is not initialised on every path here
    return 0;
}

function used_by_value() -> i64 {
    mut value: Owned;
    const moved: Owned = value;
    //~^ ERROR[E0219] use of `value`, which is not initialised on every path here
    return moved.id;
}

function fill_raw(place: mut Owned*) -> void { place.id = 7; }

// Not refused, and so carrying no annotation: an annotated file fails on any
// E0219 it does not name.  A raw pointer to storage not yet initialised is
// how an out-parameter is handed out to be filled, and the binding holds a
// value from there on.
function raw_pointer_to_uninitialised() -> i64 {
    mut value: Owned;
    fill_raw(&value);
    return value.id;
}

function main() -> i32 {
    return 0;
}
