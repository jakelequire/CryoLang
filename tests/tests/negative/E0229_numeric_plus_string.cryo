// E0229: `numeric + string` (numeric on the left) is rejected. Only the
// cursor-first form `string + numeric` is a valid pointer-advance; the
// commutative form has no codegen arm and previously type-checked but
// emitted invalid IR (`add ptr, i64`), aborting with an opaque LLVM
// verification error. Write `s + n`, not `n + s`.
![config(testing)]
![config(negative, E0229)]
namespace CryoTests::Negative::E0229NumericPlusString;
function main() -> int {
    const s: string = "hello";
    const r: string = 1 + s;
    return 0;
}
