// E0453: `return this;` in a `&this` or `mut &this` method reads the whole
// receiver by its implicit dereference, so the caller gets a second owner
// of storage the receiver's owner still releases - a double free when the
// type owns a destructor.  A consuming receiver (`mut this`, `![sink]`), a
// read inside `unsafe`, a `Copy` type and a clone are accepted.
![config(testing)]
![config(negative, E0453)]
namespace CryoTests::Negative::WholeValueReadThroughReference;

type struct Holder {
    items: [i64];

    again(&this) -> Holder { return this; }
    //~^ ERROR[E0453] cannot move `this` out through a reference
    again_mutable(mut &this) -> Holder { return this; }
    //~^ ERROR[E0453] cannot move `this` out through a reference

    // Controls.
    consumed(mut this) -> Holder { return this; }
    ![sink]
    sunk(&this) -> Holder { return this; }
    taken(&this) -> Holder { unsafe { return this; } }
    copied(&this) -> Holder { return Holder { items: this.items.clone() }; }
}

type struct Point {
    x: i64;

    same(&this) -> Point { return this; }
}

function main() -> i32 {
    const h: Holder = Holder { items: [1] };
    const p: Point = Point { x: 1 }.same();
    return p.x as i32 + h.items.length() as i32;
}
