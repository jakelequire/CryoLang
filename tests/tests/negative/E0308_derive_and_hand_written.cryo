// E0308: a trait derived through `with [...]` and also implemented by hand
// is implemented twice, refused as conflicting implementations at the
// hand-written block.  A derived trait beside a different hand-written one
// is the control.
![config(testing)]
![config(negative, E0308)]
namespace CryoTests::Negative::E0308DeriveAndHandWritten;

import std::core::cmp::{ Eq };
import std::core::clone::{ Clone };

type struct DhBoth with [Eq, Clone] {
    x: i64;
}

implement trait Eq for DhBoth {   //~ ERROR[E0308] conflicting implementations of trait `Eq`
    equals(&this, other: &DhBoth) -> boolean { return true; }
}

type struct DhApart with [Eq] {
    x: i64;
}

implement trait Clone for DhApart {
    clone(&this) -> DhApart { return DhApart { x: this.x }; }
}

function main() -> i32 {
    return 0;
}
