// E0209: `typeof` is a type-level construct (decltype) - it resolves to a
// type, not a runtime value - so it is only valid in type position
// (`const y: typeof(x)`).  Using it as a value is rejected.
![config(testing)]
![config(negative, E0209)]
namespace CryoTests::Negative::TypeofValuePosition;
function main() -> int {
    const x: i32 = 42;
    const t: string = typeof(x);   //~ ERROR[E0209] `typeof` may only be used in type
    return 0;
}
