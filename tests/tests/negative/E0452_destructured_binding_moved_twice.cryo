// E0452: a field bound by a destructure is an owned local like any other, so
// giving it away twice releases one value twice.
//
// Regression test for the move checker never registering a destructure's
// bindings: it walked a declaration statement only when it held a single
// variable, so `a` below was a binding it did not track, both moves went
// unrecorded, and this program was accepted and released `a` twice.
![config(testing)]
![config(negative, E0452)]
namespace CryoTests::Negative::DestructuredBindingMovedTwice;

type struct Res {
    tag: i32;
    drop(mut &this) -> void { }
}

type struct Pair {
    a: Res;
    b: Res;
}

function consume(r: Res) -> i32 { return r.tag; }

function main() -> int {
    const {a, b}: Pair = Pair { a: Res { tag: 1 }, b: Res { tag: 2 } };
    consume(a);
    consume(a);
    //~^ ERROR[E0452] use of moved value 'a'
    return 0;
}
