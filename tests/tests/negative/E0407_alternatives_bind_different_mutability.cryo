// E0407: the alternatives of one match arm write `mut` on a name in one
// alternative and not in another.  The binding is one value whichever
// alternative matched, so it cannot be mutable on one path only.
![config(testing)]
![config(negative, E0407)]
namespace CryoTests::Negative::AlternativesBindDifferentMutability;

type enum Pair {
    Left(i32);
    Right(i32);
}

function bump(p: Pair) -> i32 {
    return match (p) {
        Pair::Left(mut n) | Pair::Right(n) => { n + 1 }   //~ ERROR[E0407] `n` is written `mut` in one alternative of this arm and not in another
    };
}

function main() -> i32 {
    return bump(Pair::Left(1));
}
