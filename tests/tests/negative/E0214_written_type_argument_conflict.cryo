// E0214: a type argument a call writes beside a `_` binds its parameter, and
// an argument of another type conflicts with it, reported as the written
// argument it disagrees with rather than as one an earlier argument inferred.
![config(testing)]
![config(negative, E0214)]
namespace CryoTests::Negative::WrittenTypeArgumentConflict;

function pick<A, B>(a: A, b: B) -> A { return a; }

function main() -> int {
    pick::<_, u8>(4, "s");
    //~^ ERROR[E0214] conflicting types for the type parameter of `pick`
    return 0;
}
