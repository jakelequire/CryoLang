// Compile-fail test: a single generic type parameter is inferred to two
// incompatible concrete types across argument positions. `second<T>(a: T,
// b: T)` called with `(i32, string)` has no single `T`. Absent this check the
// monomorphizer would silently pin `T` from the first argument and reinterpret
// the string's bits as an `i32` (a miscompile); this must be rejected.
// `cryo test` compiles this file on its own and asserts E0214.
![config(testing)]
![config(negative, E0214)]
namespace CryoTests::Negative::E0214GenericInferenceConflict;

function second<T>(a: T, b: T) -> T { return b; }

function main() -> int {
    const r: i32 = second(5, "hello");
    return 0;
}
