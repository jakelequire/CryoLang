// E0453: an owning array field read by value through a pointer copies the
// array's handle while the struct it was read from still owns the buffer.
// Yielded by an arm of a branching expression whose value is moved out, the
// field is read by value on that arm's path just as an initializer reads it,
// so it is refused there too.  Lend the field (`&h.items` as a `&Slice<T>`)
// or clone it.
![config(testing)]
![config(negative, E0453)]
namespace CryoTests::Negative::ArrayFieldMoveOutThroughBranchValue;

type struct Holder {
    items: [i64];
}

function by_if(h: Holder*, flag: boolean) -> i64 {
    const items: [i64] = if (flag) { h.items } else { [] };
    //~^ ERROR[E0453] cannot move an owning array out of a value that owns a destructor
    return items.length();
}

function by_match(h: Holder*, n: int) -> [i64] {
    return match (n) {
        1 => {
            h.items
            //~^ ERROR[E0453] cannot move an owning array out of a value that owns a destructor
        }
        _ => { [] }
    };
}

function main() -> int {
    mut h: Holder = Holder { items: [] };
    return (by_if(&h, true) + by_match(&h, 1).length()) as int;
}
