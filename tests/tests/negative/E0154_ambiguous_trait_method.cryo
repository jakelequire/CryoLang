// E0154: a bare method call is ambiguous when the same-named method is
// provided by two different traits implemented for the receiver, and no
// bound-directed context picked one. `P` implements both `Display::fmt` and
// `Debug::fmt`, so `p.fmt(&sink)` can't choose. Previously this silently
// dispatched to whichever trait registered first. (A `T: Display`-bounded
// receiver is disambiguated by bound-directed dispatch and stays legal.)
![config(testing)]
![config(negative, E0154)]
namespace CryoTests::Negative::AmbiguousTraitMethod;

import std::fmt::display::{Display, Debug};

type struct P { x: i32; }

implement trait Display for P {
    fmt<W>(&this, w: &W) -> i32 { return 111; }
}
implement trait Debug for P {
    fmt<W>(&this, w: &W) -> i32 { return 222; }
}

function main() -> int {
    const p: P = P { x: 1 };
    mut sink: i32 = 0;
    const r: i32 = p.fmt(&sink);
    return r;
}
