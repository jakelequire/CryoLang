// E0100: a keyword that opens a statement or an expression cannot name a
// free function, a variable, a parameter or a pattern binding.  Every bare
// use of such a name reads as the keyword (`delete()` is the delete
// operator, `match;` the head of a match), so the declaration would name
// something nothing can reach.  The same keywords name members, which are
// only ever reached after `.` or `::`.
![config(testing)]
![config(negative, E0100)]
namespace CryoTests::Negative::E0100ExpressionKeywordAsBindingName;

type enum R {
    D(i32);
    N;
}

function delete() -> i32 { return 1; }
//~^ ERROR[E0100] expected a function name, found `delete`, which is a reserved word

function take(new: i32) -> i32 { return 0; }
//~^ ERROR[E0100] expected a parameter name, found `new`, which is a reserved word

function pick(r: R) -> i32 {
    match (r) {
        R::D(move) => { return 0; }
        //~^ ERROR[E0100] expected a binding name, found `move`, which is a reserved word
        _ => { return 0; }
    }
}

function main() -> int {
    const match: i32 = 42;
    //~^ ERROR[E0100] expected a variable name, found `match`, which is a reserved word
    mut return: i32 = 1;
    //~^ ERROR[E0100] expected a variable name, found `return`, which is a reserved word
    return 0;
}
