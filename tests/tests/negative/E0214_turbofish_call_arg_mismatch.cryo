// E0214: a call that writes its type arguments (`id::<i32>(...)`) has
// them decided by nothing its arguments say, so each argument is still
// checked against its parameter as those type arguments make it.
// `Array::get` answers `Option<i32>`, not the `i32` `id::<i32>` takes;
// passed unchecked, the program corrupted its heap.
![config(testing)]
![config(negative, E0214)]
namespace CryoTests::Negative::TurbofishCallArgMismatch;

function id<U>(x: U) -> U { return x; }

function main() -> i32 {
    mut xs: Array<i32> = Array::<i32>::new();
    xs.push(5);
    return id::<i32>(xs.get(0));   //~ ERROR[E0214] mismatched types
}
