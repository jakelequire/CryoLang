// E0200: only a simple enum - no payload on any variant and no type
// parameters - converts to `boolean`, its value being its discriminant.  An
// enum with a payload, or an instance or template of a generic one, has no
// truthiness.
![config(testing)]
![config(negative, E0200)]
namespace CryoTests::Negative::E0200PayloadOrGenericEnumToBoolean;

import std::core::result::{ Result };

type enum Tag<T> { A; B; }
type enum Shape { Dot; Circle(i32); }

function main() -> int {
    const _r: boolean = Result::<i32, i32>::Ok(1);
    //~^ ERROR[E0200] mismatched types
    const _q: boolean = Result::Ok::<i32, i32>(1);
    //~^ ERROR[E0200] mismatched types
    const _t: boolean = Tag::<i32>::B;
    //~^ ERROR[E0200] mismatched types
    const _u: boolean = Tag::A;
    //~^ ERROR[E0200] mismatched types
    const _s: boolean = Shape::Dot;
    //~^ ERROR[E0200] mismatched types
    return 0;
}
