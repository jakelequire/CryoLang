// E0200: no enum converts to `boolean` - not one with a payload and not an
// instance or template of a generic one.  A simple enum is refused as well
// (E0200_condition_not_boolean); a test on an enum compares it with a
// variant or matches on it.
![config(testing)]
![config(negative, E0200)]
namespace CryoTests::Negative::E0200PayloadOrGenericEnumToBoolean;

import std::core::result::{ Result };

type enum Tag<T> { A; B; }
type enum Shape { Dot; Circle(i32); }

function main() -> int {
    const _r: boolean = Result::<i32, i32>::Ok(1);
    //~^ ERROR[E0200] mismatched types
    const _q: boolean = Result::Ok::<i32, i32>(1);
    //~^ ERROR[E0200] mismatched types
    const _t: boolean = Tag::<i32>::B;
    //~^ ERROR[E0200] mismatched types
    const _u: boolean = Tag::A;
    //~^ ERROR[E0200] mismatched types
    const _s: boolean = Shape::Dot;
    //~^ ERROR[E0200] mismatched types
    return 0;
}
