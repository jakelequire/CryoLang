// E0306: `(Trait for Type)::member` names the member of `Trait`'s
// implementation for `Type`, so a type that does not implement the trait
// is refused at the head - the same code as a `where T: Trait` bound the
// type fails, which is what the head asserts.  Before the form existed the
// file was refused at `for` (E0100); a path the head does not qualify,
// `CfQ::make()`, stays E0233's "cannot find".
![config(testing)]
![config(negative, E0306)]
namespace CryoTests::Negative::ImplQualifiedUnimplemented;

type trait CfBeta {
    static make() -> i32;
}

type struct CfP { v: i32; }
type struct CfQ { v: i32; }

implement trait CfBeta for CfP {
    static make() -> i32 { return 2; }
}

function main() -> int {
    const a: i32 = (CfBeta for CfP)::make();
    const b: i32 = (CfBeta for CfQ)::make();   //~ ERROR[E0306] `CfQ` does not implement `CfBeta`
    return a + b;
}
