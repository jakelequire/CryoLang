// E0365: an `async function main` cannot be generic.
//
// A generic function has no code until something demands a specialization by
// supplying its type arguments. The entry point is called by the C runtime with
// none, so there is nothing to instantiate it from and no way to choose what
// `T` would be.
![config(testing)]
![config(negative, E0365)]
namespace CryoTests::Negative::E0365AsyncMainGeneric;

import std::future;

async function main<T>() -> i32 {   //~ ERROR[E0365] `async function main` cannot be generic
    return 0;
}
