// E0452: a non-Copy value passed by value to a class constructor (`new
// Holder(t)`) is MOVED into the constructed object; reusing it afterwards is a
// use-after-move. The move-checker must walk constructor arguments as moves,
// matching drop-insertion - if the two passes disagreed, this would compile
// silently (the moved-from value would stay readable).
// The straight-line and loop-carried call-argument cases are covered by
// E0452_straight_line_use_after_move.cryo / E0452_loop_carried_byval_arg.cryo;
// this pins the `new`-expression argument path.
![config(testing)]
![config(negative, E0452)]
namespace CryoTests::Negative::UseAfterMoveIntoConstructor;

import std::core::drop;

type struct Tracker {
    id: i32;
}

implement trait Drop for struct Tracker {
    drop(mut &this) -> void {
        printf("DROP %d\n", this.id);
    }
}

type class Holder {
public:
    t: Tracker;

    Holder(_t: Tracker) {
        this.t = _t;
    }
}

function main() -> int {
    mut t: Tracker = Tracker { id: 99 };
    const h: Holder* = new Holder(t);
    printf("use after move: %d\n", t.id);   //~ ERROR[E0452] use of moved value 't'
    return 0;
}
