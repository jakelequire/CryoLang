// E0319: the kind keyword before an `implement` head's type names the
// type's kind, so `union` before an enum is refused, in a trait
// implementation's head and an inherent one's.
![config(testing)]
![config(negative, E0319)]
namespace CryoTests::Negative::UnionKeywordForEnum;

type enum Light { Off; On; }

type trait Brightness {
    level(&this) -> i32;
}

implement trait Brightness for union Light {
//~^ ERROR[E0319] `CryoTests::Negative::UnionKeywordForEnum::Light` is an enum, not a union
    level(&this) -> i32 { return 1; }
}

implement union Light {
//~^ ERROR[E0319] `CryoTests::Negative::UnionKeywordForEnum::Light` is an enum, not a union
    flipped(&this) -> i32 { return 2; }
}

function main() -> int {
    return 0;
}
