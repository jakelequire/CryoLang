// E0307: a call writes all of its type arguments or none of them, so one
// writing fewer than the callee has type parameters is refused for the count -
// on a method, a free function and a generic owner's static method alike -
// and not reported as a call naming no method, nor typed by the parameters
// it leaves open.
![config(testing)]
![config(negative, E0307)]
namespace CryoTests::Negative::TypeArgumentsTooFew;

type struct Cell<T> {
    value: T;

    map<U, F>(&this, f: F) -> U where F: (T) -> U { return f(this.value); }
    static make<A, B>(a: A, b: B) -> A { return a; }
}

function pick<A, B>(a: A, b: B) -> A { return a; }

function main() -> int {
    const c: Cell<i32> = Cell::<i32> { value: 5 };
    const w: i64 = c.map::<i64>((x: i32) -> i64 { return x as i64; });
    //~^ ERROR[E0307] `CryoTests::Negative::TypeArgumentsTooFew::Cell<i32>::map` has 2 type parameters, and 1 type argument is written
    const p: i64 = pick::<i64>(4, 5);
    //~^ ERROR[E0307] `pick` has 2 type parameters, and 1 type argument is written
    const m: i64 = Cell::<i32>::make::<i64>(7, true);
    //~^ ERROR[E0307] `Cell::make` has 2 type parameters, and 1 type argument is written
    return 0;
}
