// E0239: an array's size must be a compile-time integer constant.  A mutable
// global is a runtime variable, not a constant; sizing an array with one would
// produce an array descriptor with no storage behind it, and every access
// through it a wild pointer.
![config(testing)]
![config(negative, E0239)]
namespace CryoTests::Negative::E0239NonConstArraySize;

mut cf_runtime_len: i64 = 8;

type struct CfSized { f: u8[cf_runtime_len]; }   //~ ERROR[E0239] must be a compile-time integer constant

function main() -> int {
    return 0;
}
