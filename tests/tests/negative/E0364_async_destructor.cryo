// E0364: a destructor cannot be `async`.
//
// A destructor is called by drop insertion at scope exit, from every context
// that owns the value - including ones with no executor, and including the
// teardown of a future that is itself being polled.  There is nowhere to
// suspend to and nobody to resume it.
![config(testing)]
![config(negative, E0364)]
namespace CryoTests::Negative::E0364AsyncDestructor;

import std::future;

type class CfAsyncDtor {
public:
    v: i64;

    public CfAsyncDtor(n: i64) { this.v = n; }
    public async ~CfAsyncDtor() { }   //~ ERROR[E0364] a destructor cannot be `async`
}

function main() -> int { return 0; }
