// E0319: a kind keyword names a struct, an enum or a union, so one before
// any other type is refused, in a trait implementation's head and an
// inherent one's.
![config(testing)]
![config(negative, E0319)]
namespace CryoTests::Negative::KindKeywordForPrimitive;

type trait Doubled {
    doubled(&this) -> i32;
}

implement trait Doubled for struct i32 {
//~^ ERROR[E0319] `i32` is not a struct, an enum or a union, so no kind keyword names it
    doubled(&this) -> i32 { return *this * 2; }
}

implement enum boolean {
//~^ ERROR[E0319] `boolean` is not a struct, an enum or a union, so no kind keyword names it
    as_number(&this) -> i32 { return if (*this) { 1 } else { 0 }; }
}

function main() -> int {
    return 0;
}
