// W0009: an arm written after an unguarded arm that matches every value - a
// wildcard or a binding name - can never be chosen.  A guarded catch-all
// can fall through, so the arms after it stay reachable.
![config(testing)]
![config(negative, W0009)]
namespace CryoTests::Negative::W0009UnreachableMatchArm;

function after_binding(code: u32) -> u32 {
    return match (code) {
        other => { other }
        _     => { 0 }   //~ WARN[W0009] unreachable match arm
    };
}

function after_wildcard(code: u32) -> u32 {
    mut kind: u32 = 0;
    match (code) {
        1 => { kind = 1; }
        _ => { kind = 2; }
        3 => { kind = 3; }   //~ WARN[W0009] unreachable match arm
    }
    return kind;
}

function after_guarded(code: u32) -> u32 {
    return match (code) {
        n if (n > 5) => { n }
        _            => { 0 }
    };
}

function main() -> int {
    return (after_binding(1) + after_wildcard(2) + after_guarded(3)) as int;
}
