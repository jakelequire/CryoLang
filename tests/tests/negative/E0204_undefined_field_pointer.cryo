// E0204: access of a non-existent field through a *pointer* receiver.
// Regression: a bad field on a pointer/reference receiver (e.g. an
// enum-variant payload binding, which is `T*`) used to slip silently past
// sema and crash codegen with "unterminated basic block" instead of
// reporting a proper undefined-field error.
![config(testing)]
![config(negative, E0204)]
namespace CryoTests::Negative::E0204UndefinedFieldPointer;
type struct CfP { x: i32; }
function take(p: CfP*) -> i32 { return p.y; }
function main() -> int { mut v: CfP = CfP { x: 1 }; return take(&v); }
