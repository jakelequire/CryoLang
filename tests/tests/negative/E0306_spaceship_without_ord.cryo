// E0306: `a <=> b` is the language's `Ord::compare`.  A type with a
// `compare` method of its own that does not implement `Ord` is refused at
// the left operand, rather than the method being called because its name
// is `compare`.
![config(testing)]
![config(negative, E0306)]
namespace CryoTests::Negative::E0306SpaceshipWithoutOrd;

type struct CfRank {
    value: i32;

    compare(&this, other: &CfRank) -> Ordering {
        if (this.value < other.value) { return Ordering::Less; }
        if (this.value > other.value) { return Ordering::Greater; }
        return Ordering::Equal;
    }
}

function main() -> int {
    const low: CfRank = CfRank { value: 1 };
    const high: CfRank = CfRank { value: 2 };
    const order: Ordering = low <=> high;
    //~^ ERROR[E0306] `CfRank` does not implement `Ord`
    return match (order) {
        Ordering::Less    => { 0 }
        Ordering::Equal   => { 1 }
        Ordering::Greater => { 2 }
    };
}
