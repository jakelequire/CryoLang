// E0358: a method an implementation delivers under a where-clause is no
// method of an instantiation whose arguments do not satisfy the clause, and
// the call is refused where it is written: `[Ref].clone()` where `Ref` is
// not `Clone`, and the same through a user's generic implementation.  The
// instantiation at an argument that satisfies the clause still has it.
![config(testing)]
![config(negative, E0358)]
namespace CryoTests::Negative::E0358ImplementationWhereClauseUnmet;

import std::core::clone::{ Clone };

type trait WcDup {
    dup(&this) -> This;
}

type struct WcRef { index: u32; }
type struct WcWrap<T> { item: T; }
type struct WcHolder { refs: [WcRef]; }

implement trait WcDup for i32 { dup(&this) -> i32 { return this; } }

implement<T> trait WcDup for struct WcWrap<T> where T: WcDup {
    dup(&this) -> WcWrap<T> { return WcWrap { item: this.item.dup() }; }
}

implement trait Clone for struct WcHolder {
    clone(&this) -> WcHolder {
        return WcHolder { refs: this.refs.clone() };   //~ ERROR[E0358] the trait `Clone` is not implemented for
    }
}

function main() -> int {
    const numbers: [i32] = [1, 2];
    const fine: [i32] = numbers.clone();
    const plain: [WcRef] = [WcRef { index: 4 }];
    const refused: [WcRef] = plain.clone();   //~ ERROR[E0358] the trait `Clone` is not implemented for
    const held: WcWrap<i32> = WcWrap { item: 4 };
    const fine_held: WcWrap<i32> = held.dup();
    const wrapped: WcWrap<WcRef> = WcWrap { item: WcRef { index: 3 } };
    const refused_wrapped: WcWrap<WcRef> = wrapped.dup();   //~ ERROR[E0358] the trait `WcDup` is not implemented for
    return 0;
}
