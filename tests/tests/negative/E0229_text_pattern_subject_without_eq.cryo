// A string pattern against a subject of another type compares the subject
// with the literal converted to that type, through the type's `Eq`.  `Label`
// converts from a string but has no `Eq`, so the pattern has no comparison
// to make, and the `==` it stands for is refused at the pattern - once, with
// no second refusal that the pattern does not fit the subject.
![config(testing)]
![config(negative, E0229)]
namespace CryoTests::Negative::TextPatternSubjectWithoutEq;

type struct Label {
    text: string;

    ![implicit]
    static new(text: string) -> Label {
        return Label { text: text };
    }
}

function classify(l: Label) -> i32 {
    return match (l) {
        "yes" => { 1 }
        //~^ ERROR[E0229] `CryoTests::Negative::TextPatternSubjectWithoutEq::Label` does not implement `Eq`; add `implement trait Eq ... for CryoTests::Negative::TextPatternSubjectWithoutEq::Label` to use the `==` operator on it
        _     => { 0 }
    };
}

function main() -> int {
    return classify(Label::new("yes")) as int;
}
