// E0355: field defaults do not weaken the exhaustiveness check - `ungiven` has
// no default, so omitting it is still an error even though `given` has one.
![config(testing)]
![config(negative, E0355)]
namespace CryoTests::Negative::E0355MissingFieldNoDefault;
type struct Partial { given: i32 = 5; ungiven: i32; }
function main() -> int { const p: Partial = Partial { given: 1 }; return p.given; }   //~ ERROR[E0355] missing field `ungiven` in initializer
