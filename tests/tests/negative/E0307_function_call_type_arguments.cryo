// E0307: type arguments written on a call of a function that has no type
// parameters name nothing, so the call is refused; a generic function's
// call writing as many as it has stands.
![config(testing)]
![config(negative, E0307)]
namespace CryoTests::Negative::FunctionCallTypeArguments;

function plain() -> i64 { return 3; }

function takes(value: i64) -> i64 { return value + 1; }

function pick<T>(value: T) -> T { return value; }

function main() -> int {
    const a: i64 = plain::<i64>();
    //~^ ERROR[E0307] `plain` has 0 type parameters, and 1 type argument is written
    const b: i64 = takes::<i64, u8>(4);
    //~^ ERROR[E0307] `takes` has 0 type parameters, and 2 type arguments are written
    const c: i64 = pick::<i64>(5);
    const d: i64 = CryoTests::Negative::FunctionCallTypeArguments::plain::<u8>();
    //~^ ERROR[E0307] `plain` has 0 type parameters, and 1 type argument is written
    return (a + b + c + d) as int;
}
