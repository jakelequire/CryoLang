// E0353: the adapter `peekable` builds is internal to the standard library;
// `peekable` returns `implement Peekable<...>`, so a program never names it.
![config(testing)]
![config(negative, E0353)]
namespace CryoTests::Negative::PeekableAdapterIsInternal;

import std::core::iter::{ PeekableIter };   //~ ERROR[E0353] `std::core::iter::PeekableIter` is internal to its package and cannot be imported

function main() -> int {
    return 0;
}
