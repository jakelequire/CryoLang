// E0229: adding two structs with no operator overload.
![config(testing)]
![config(negative, E0229)]
namespace CryoTests::Negative::E0229InvalidBinaryOp;
type struct CfA { v: i32; }
function main() -> int {
    const a: CfA = CfA { v: 1 };
    const b: CfA = CfA { v: 2 };
    const c: CfA = a + b;
    return 0;
}
