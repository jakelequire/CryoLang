// E0308: two methods every instance of a type has - written in its body or
// in its blocks for every instance - may share a name only when they take
// different parameters, since a call is selected by its arguments.  The
// receiver's form does not tell two apart, a block's parameter is compared
// as the type's own (`T` in `implement struct Wrap<T>` is `Wrap`'s `T`),
// and the same holds for a type with no parameters.  `overload` takes `i64`
// in one block and `i32` in the other and is accepted.
![config(testing)]
![config(negative, E0308)]
namespace CryoTests::Negative::E0308IdenticalInherentMethods;

type struct Wrap<T> {
    value: T;
    in_body(&this) -> i64 { return 10; }
    in_body(&this) -> i64 { return 11; }
    //~^ ERROR[E0308] conflicting definitions of method `in_body`: both take the same parameters
    body_and_block(&this, n: i64) -> i64 { return n; }
    takes_parameter(&this, x: T) -> i64 { return 1; }
}

implement struct Wrap<T> {
    first(&this) -> i64 { return 1; }
    body_and_block(&this, n: i64) -> i64 { return n + 1; }
    //~^ ERROR[E0308] conflicting definitions of method `body_and_block`: both take the same parameters
    overload(&this, n: i64) -> i64 { return n; }
    takes_parameter(&this, x: T) -> i64 { return 2; }
    //~^ ERROR[E0308] conflicting definitions of method `takes_parameter`: both take the same parameters
}

implement struct Wrap<T> {
    first(mut &this) -> i64 { return 2; }
    //~^ ERROR[E0308] conflicting definitions of method `first`: both take the same parameters
    overload(&this, n: i32) -> i64 { return 0; }
}

type struct Plain {
    n: i64;
}

implement struct Plain {
    twice(&this) -> i64 { return 1; }
}

implement struct Plain {
    twice(&this) -> i64 { return 2; }
    //~^ ERROR[E0308] conflicting definitions of method `twice`: both take the same parameters
}

function main() -> int {
    const w: Wrap<i64> = Wrap { value: 3 };
    return w.overload(1) as int;
}
