// E0100: a keyword that opens a declaration cannot name a variable, a
// parameter, a pattern binding or a destructured local.  A block reads a statement that begins with one as a
// declaration, so `module = q;` inside a match arm was never an assignment:
// the program compiled and the local read whatever its slot held.  Keywords
// that open nothing (`default`, `string`) remain legal names.
![config(testing)]
![config(negative, E0100)]
namespace CryoTests::Negative::E0100DeclarationKeywordAsBindingName;

function take(module: i32) -> i32 { return module; }
//~^ ERROR[E0100] expected a parameter name, found `module`, which is a reserved word

type enum R {
    D(i32);
    N;
}

type struct P {
    v:      i32;
    struct: i32;
}

function pick(r: R) -> i32 {
    match (r) {
        R::D(static) => { return static; }
        //~^ ERROR[E0100] expected a binding name, found `static`, which is a reserved word
        _ => { return 0; }
    }
}

function split(p: P) -> i32 {
    const { v: module, struct }: P = p;
    //~^ ERROR[E0100] expected a variable name, found `module`, which is a reserved word
    //~^^ ERROR[E0100] expected a variable name, found `struct`, which is a reserved word
    return module + struct;
}

function main() -> int {
    const module: i32 = 42;
    //~^ ERROR[E0100] expected a variable name, found `module`, which is a reserved word
    mut static: i32 = 1;
    //~^ ERROR[E0100] expected a variable name, found `static`, which is a reserved word
    return take(module) + static;
}
