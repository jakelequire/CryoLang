// E0214: the print family takes `fmt::Arguments` - an f-string, a literal or
// a `Str` - and consumes nothing, so a `String` is passed as its view
// (`println(name.as_str())`) or in an f-string (`println(f"{name}")`); the
// owned value itself is refused rather than moved into the call.
![config(testing)]
![config(negative, E0214)]
namespace CryoTests::Negative::E0214PrintlnTakesArgumentsNotAString;

import std::fmt;

function main() -> int {
    const name: String = String::from("ada");
    fmt::println(name);
    //~^ ERROR[E0214] mismatched types
    fmt::eprintln(name);
    //~^ ERROR[E0214] mismatched types
    fmt::println(name.as_str());
    fmt::println(f"{name}");
    fmt::println("ada");
    return 0;
}
