// E0214: string passed to an i32 parameter through a trait-method call.
![config(testing)]
![config(negative, E0214)]
namespace CryoTests::Negative::E0214TraitMethod;
type trait CfSink { cf_absorb(mut &this, x: i32) -> void; }
type struct CfS { v: i32; static cf_new() -> CfS { return CfS { v: 0 }; } }
implement trait CfSink for struct CfS {
    cf_absorb(mut &this, x: i32) -> void { this.v = x; }
}
function main() -> int {
    mut s: CfS = CfS::cf_new();
    s.cf_absorb("bad");   //~ ERROR[E0214] mismatched types
    return 0;
}
