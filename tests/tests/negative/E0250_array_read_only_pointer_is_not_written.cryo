// Compile-fail test: an array's `as_ptr()` is a read-only pointer, from any
// array, so a place reached through it is not written; the writable pointer
// is `as_mutable_ptr()`, a `mut &this` method, which a `const` array does
// not call.  Reading through `as_ptr()` and writing through the writable
// pointer of a writable array are the controls.
![config(testing)]
![config(negative, E0250)]
namespace CryoTests::Negative::E0250ArrayReadOnlyPointerIsNotWritten;

import std::collections::array::{ Array };

function main() -> int {
    const fixed: Array<i64> = Array::<i64>::with_capacity(4);
    mut growing: Array<i64> = Array::<i64>::new();
    growing.push(5);
    fixed.as_ptr()[0] = 1;            //~ ERROR[E0250]
    growing.as_ptr()[0] = 2;          //~ ERROR[E0250]
    fixed.as_mutable_ptr();           //~ ERROR[E0250]
    growing.as_mutable_ptr()[0] = 3;
    const read: i64 = growing.as_ptr()[0];
    return read as int;
}
