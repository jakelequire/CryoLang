// E0308: two implementations whose heads differ only in the names of their
// own parameters are one head: `From<I::Item> for Wrap<I> where I: Source`
// written twice.  The projection through the impl's parameter is the same
// associated type of the same bound's trait in both.
![config(testing)]
![config(negative, E0308)]
namespace CryoTests::Negative::E0308ProjectionHeadDuplicate;

type trait Source { type Item; }
type trait Make<T> { make(v: T) -> This; }
type struct Wrap<I> { n: int; }

implement<I> trait Make<I::Item> for struct Wrap<I> where I: Source {
    make(v: I::Item) -> Wrap<I> { return Wrap { n: 1 }; }
}
implement<J> trait Make<J::Item> for struct Wrap<J> where J: Source {   //~ ERROR[E0308] a trait may be implemented at most once per type
    make(v: J::Item) -> Wrap<J> { return Wrap { n: 2 }; }
}

function main() -> int { return 0; }
