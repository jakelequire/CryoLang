// E0214: inside a generic body a type parameter is one opaque type, so an
// argument is checked against its parameter like any other: an `Option<T>`
// is not the `T` that `id::<T>` takes, nor the `i32` that `take_i32` takes.
// Copies are not re-checked, so the generic body is the only place this is
// caught; unchecked, each of the two over `[5]` answered 0.
![config(testing)]
![config(negative, E0214)]
namespace CryoTests::Negative::GenericBodyCallArgMismatch;

function id<U>(x: U) -> U { return x; }

function take_i32(x: i32) -> i32 { return x; }

function first<T>(xs: &Array<T>) -> T where T: Copy {
    return id::<T>(xs.get(0));   //~ ERROR[E0214] mismatched types
}

function first_i32<T>(xs: &Array<T>) -> i32 where T: Copy {
    return take_i32(xs.get(0));   //~ ERROR[E0214] mismatched types
}

function main() -> i32 {
    mut xs: Array<i32> = Array::<i32>::new();
    xs.push(5);
    return first::<i32>(&xs) + first_i32::<i32>(&xs);
}
