// E0203, once per written name and nowhere else: a declaration whose
// signature names a type nothing declares is refused where the type is
// written, and every CALL to it reports nothing.  The declaration exists;
// what it lacks is a signature to type the call by, and the index records
// that under the key the declaration would have registered under
// (`mark_signature_refused`), so the call-miss reporters find a refusal
// rather than an absence.  Before that record the same file drew seven
// more errors, two of them false: "cannot find function `ret_bad`" for a
// function that exists, and "`param_bad` takes 0 argument(s)" for one
// whose refused parameter had been dropped from a registered signature.
// A local whose annotation was refused keeps no type either, so its member
// read is not "no field `v` on type `i32`".  The expectation lines are
// exhaustive: an extra diagnostic anywhere in this file fails the test.
![config(testing)]
![config(negative, E0203)]
namespace CryoTests::Negative::RefusedSignatureNoCascade;

type struct CfHolder { v: i32; }

function ret_bad(v: i32) -> CfNope {           //~ ERROR[E0203] cannot find type `CfNope` in this scope
    return v;
}

function param_bad(v: CfNope) -> i32 {         //~ ERROR[E0203] cannot find type `CfNope` in this scope
    return 1;
}

implement CfHolder {
    static make_bad() -> CfNope { return 1; }  //~ ERROR[E0203] cannot find type `CfNope` in this scope
    method_bad(&this) -> CfNope { return 1; }  //~ ERROR[E0203] cannot find type `CfNope` in this scope
    param_bad(&this, v: CfNope) -> i32 { return 1; }  //~ ERROR[E0203] cannot find type `CfNope` in this scope
}

function main() -> int {
    const h: CfHolder = CfHolder { v: 1 };
    const a: i32 = ret_bad(1);
    const b: i32 = param_bad(1);
    const c: i32 = CryoTests::Negative::RefusedSignatureNoCascade::ret_bad(1);
    const d: i32 = CfHolder::make_bad();
    const e: i32 = h.method_bad();
    const f: i32 = h.param_bad(1);
    const g: i32 = ret_bad(1) + 1;
    const x: CfNope = 1;                       //~ ERROR[E0203] cannot find type `CfNope` in this scope
    const w: i32 = x.v;
    return a + b + c + d + e + f + g + w;
}
