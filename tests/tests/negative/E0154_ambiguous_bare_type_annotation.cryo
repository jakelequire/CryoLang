// E0154: a bare TYPE name two specific imports bring into scope from
// different modules names neither of them, in an annotation as much as in a
// call.  `std::io::cursor` and `std::net::http2::hpack` both declare a
// `Cursor`, and both are imported by name here, so bare `Cursor` in the
// parameter's annotation is refused where it is WRITTEN, by the name layer,
// and the author must write the path out.  The annotation lane used to bind
// it silently to whichever import came first: the scope keeps the first
// import so a lookup lands somewhere, and only the identifier lane read the
// record that says the first was never the answer.  Refused once: the type
// layer stays silent about a leaf the name layer has already reported.
![config(testing)]
![config(negative, E0154)]
namespace CryoTests::Negative::AmbiguousBareTypeAnnotation;

import std::io::cursor;
import std::io::cursor::{ Cursor };
import std::net::http2::hpack;
import std::net::http2::hpack::{ Cursor };

function takes(c: Cursor) -> i32 {   //~ ERROR[E0154] `Cursor` is ambiguous: it is imported from both `std::io::cursor` and `std::net::http2::hpack`
    return c.pos as i32;
}

function main() -> int {
    return 0;
}
