// E0154: a bare TYPE name two wildcard imports bring into scope from
// different modules names neither of them, in an annotation as much as in a
// call.  `std::net::http2::frame` and `std::net::ws::frame` both declare a
// `Frame`, and both are imported whole here, so bare `Frame` in the
// parameter's annotation is refused where it is WRITTEN, by the name layer,
// and the author must write the path out.  The annotation lane used to bind
// it silently to whichever import came first: the scope keeps the first
// import so a lookup lands somewhere, and only the identifier lane read the
// record that says the first was never the answer.  Refused once: the type
// layer stays silent about a leaf the name layer has already reported.  Two
// brace entries naming it are refused earlier, at the second import (E0243).
![config(testing)]
![config(negative, E0154)]
namespace CryoTests::Negative::AmbiguousBareTypeAnnotation;

import std::net::http2::frame;
import std::net::http2::frame::*;
import std::net::ws::frame;
import std::net::ws::frame::*;

function takes(_frame: &Frame) -> i32 {   //~ ERROR[E0154] `Frame` is ambiguous: it is imported from both `std::net::http2::frame` and `std::net::ws::frame`
    return 0;
}

function main() -> int {
    return 0;
}
