// E0154: a bare TYPE name two wildcard imports bring into scope from
// different modules names neither of them, in an annotation as much as in a
// call.  `std::alloc::rc` and `std::alloc::arc` both declare a `Weak`, and
// both are imported whole here, so bare `Weak` in the parameter's annotation
// is refused where it is WRITTEN, by the name layer, and the author must
// write the path out.  The annotation lane used to bind it silently to
// whichever import came first: the scope keeps the first import so a lookup
// lands somewhere, and only the identifier lane read the record that says
// the first was never the answer.  Refused once: the type layer stays silent
// about a leaf the name layer has already reported.  Two brace entries
// naming it are refused earlier, at the second import (E0243).
![config(testing)]
![config(negative, E0154)]
namespace CryoTests::Negative::AmbiguousBareTypeAnnotation;

import std::alloc::rc;
import std::alloc::rc::*;
import std::alloc::arc;
import std::alloc::arc::*;

function takes(_weak: &Weak<i32>) -> i32 {   //~ ERROR[E0154] `Weak` is ambiguous: it is imported from both `std::alloc::rc` and `std::alloc::arc`
    return 0;
}

function main() -> int {
    return 0;
}
