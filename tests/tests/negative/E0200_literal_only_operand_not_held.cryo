// An operand made only of integer literals beside an integer operand that is
// not is its exact value, and takes the other operand's type only where that
// type holds the value; otherwise it keeps its default type and the
// operation widens to it.  So with `x: i8`, `x + -129` and `x + -(100 + 29)`
// are `i32` sums, which an `i8` place does not take, where `-129` took `i8`
// and the sum added 127; with `w: u8`, `w + (200 + 100)` is an `i32` sum,
// where the operand was computed at 8 bits and the sum added 44.  A compound
// assignment's value is held the same way.  `x + -128` and `w + (200 / 2)`,
// whose values the types hold, are the controls.
![config(testing)]
![config(negative, E0200)]
namespace CryoTests::Negative::LiteralOnlyOperandNotHeld;

function main() -> int {
    const x: i8 = 0;
    const held: i8 = x + -128;
    const sum: i8 = x + -129;               //~ ERROR[E0200] mismatched types
    const folded: i8 = x + -(100 + 29);     //~ ERROR[E0200] mismatched types
    const w: u8 = 1;
    const half: u8 = w + (200 / 2);
    const wide: u8 = w + (200 + 100);       //~ ERROR[E0200] mismatched types
    mut m: i8 = 0;
    m += -129;                              //~ ERROR[E0200] computes `i32`
    mut k: u8 = 1;
    k += 200 + 100;                         //~ ERROR[E0200] computes `i32`
    return (held as int) + (sum as int) + (folded as int) + (half as int) + (wide as int) + (m as int) + (k as int);
}
