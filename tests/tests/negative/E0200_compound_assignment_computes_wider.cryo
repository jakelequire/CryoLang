// `a += b` stores `a + b` back into `a`.  With `b` wider than `a` the sum is
// computed in `b`'s type, which `a` cannot hold for every value, so the
// assignment is refused; `b` narrower than `a` widens and passes.
![config(testing)]
![config(negative, E0200)]
namespace CryoTests::Negative::CompoundAssignmentComputesWider;

public function cf_refused(b: i64, d: f64, u: u32) -> i32 {
    mut a: i32 = 1;
    a += b;
    //~^ ERROR[E0200] `+=` computes `i64`, which the `i32` it is stored into cannot hold for every value
    mut f: f32 = 1.0;
    f *= d;
    //~^ ERROR[E0200] `*=` computes `f64`, which the `f32` it is stored into cannot hold for every value
    mut s: i32 = 2;
    s -= u;
    //~^ ERROR[E0229] `-` on `i32` and `u32`: neither type holds every value of the other
    if (f > 2.0) { return 0; }
    return a + s;
}

public function cf_widened(small: i8, half: f32) -> i64 {
    mut a: i64 = 1;
    a += small;
    mut d: f64 = 1.0;
    d *= half;
    if (d > 2.0) { return 0; }
    return a;
}
