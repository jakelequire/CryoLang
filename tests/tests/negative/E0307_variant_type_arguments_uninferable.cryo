// E0307: a generic enum's variant constructed where neither its arguments
// nor the expected type determine every type argument has no layout, and is
// refused at the variant.  Writing the arguments (`Result::<i32, i32>::Ok`)
// or giving the value a type names the instance.
![config(testing)]
![config(negative, E0307)]
namespace CryoTests::Negative::E0307VariantTypeArgumentsUninferable;

import std::core::result::{ Result };

function main() -> int {
    const _z = Result::Ok(1);
    //~^ ERROR[E0307] cannot infer the type arguments of `std::core::result::Result` for its variant `Ok`
    const _b: boolean = Result::Ok(1);
    //~^ ERROR[E0307] cannot infer the type arguments of `std::core::result::Result` for its variant `Ok`
    //~^^ ERROR[E0200] mismatched types
    return 0;
}
