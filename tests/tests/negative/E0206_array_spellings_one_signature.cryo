// E0206: `[T]` and `T[]` are one type, as are `[T; N]` and `T[N]`, so two
// functions that differ only in which spelling they write have the same
// signature.  `k` is the control: the builtin dynamic array and `Array<T>`
// are different types, so its two overloads are accepted - a check that
// compared anything coarser than the type would refuse it too.
![config(testing)]
![config(negative, E0206)]
namespace CryoTests::Negative::ArraySpellingsOneSignature;

function g(x: [i32]) -> i64 { return 1; }
function g(x: i32[]) -> i64 { return 2; }   //~ ERROR[E0206] function `g` is defined multiple times
function h(x: [u8; 4]) -> i64 { return 1; }
function h(x: u8[4]) -> i64 { return 2; }   //~ ERROR[E0206] function `h` is defined multiple times
function k(x: i32[]) -> i64 { return 1; }
function k(x: Array<i32>) -> i64 { return 2; }

function main() -> int { return 0; }
