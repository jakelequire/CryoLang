// E0246: a trait implementation declares no constants, since no trait
// declares one for it to supply.  An inherent block on the same type may.
![config(testing)]
![config(negative, E0246)]
namespace CryoTests::Negative::ConstantInTraitImplementation;

type trait Sized { size(&this) -> i32; }

type struct Holder { v: i32; }

implement trait Sized for struct Holder {
    const LIMIT: i32 = 3;   //~ ERROR[E0246] a trait implementation cannot declare constants
    size(&this) -> i32 { return this.v; }
}

implement struct Holder {
    const LIMIT: i32 = 3;
}

function main() -> int {
    return Holder::LIMIT - 3;
}
