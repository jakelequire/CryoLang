// Compile-fail test: a fixed array's `as_slice()` and `as_mutable_slice()`
// take no arguments, as the slice traits' methods take none past the
// receiver.  The calls without arguments are the controls.
![config(testing)]
![config(negative, E0215)]
namespace CryoTests::Negative::E0215FixedArraySliceMethodTakesNoArguments;

import std::core::slice::{ Slice };

function main() -> int {
    mut values: [i32; 3] = [1, 2, 3];
    const view: &Slice<i32> = values.as_slice(1);   //~ ERROR[E0215]
    const writer: mut &Slice<i32> = values.as_mutable_slice(0, 1);   //~ ERROR[E0215]
    const control: &Slice<i32> = values.as_slice();
    const writable_control: mut &Slice<i32> = values.as_mutable_slice();
    return 0;
}
