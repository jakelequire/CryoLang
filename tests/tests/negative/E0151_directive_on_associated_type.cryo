// E0151: a directive in a trait body attaches to the method after it; an
// associated type is not a declaration one can be checked against, so a
// directive written above it is refused rather than dropped.
![config(testing)]
![config(negative, E0151)]
namespace CryoTests::Negative::E0151DirectiveOnAssociatedType;

type trait CfSource {
    ![inline]
    //~^ ERROR[E0151] a directive in a trait body applies to a method; an associated type takes none
    type Item;
    cf_next(mut &this) -> i32;
}

function main() -> int { return 0; }
