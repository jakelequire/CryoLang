// E0113: a payload-less path in a pattern whose leading segments name a type
// that is no enum must name a constant of that type; a method reached that
// way has no value to compare the subject against.
![config(testing)]
![config(negative, E0113)]
namespace CryoTests::Negative::E0113TypePathPatternNamesMethod;

type struct Limits {
    const TOP: u32 = 9;

    static top() -> u32 { return 9; }
}

function classify(code: u32) -> i32 {
    return match (code) {
        Limits::top => { 1 }
        //~^ ERROR[E0113] `Limits::top` is not a constant, so it cannot be matched against
        Limits::TOP => { 2 }
        _ => { 0 }
    };
}

function main() -> int {
    return classify(3);
}
