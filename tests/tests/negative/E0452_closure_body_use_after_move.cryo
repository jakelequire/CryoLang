// E0452: a capture moved inside a closure's body may not be used again in
// that body.
//
// Regression test for uses that name no binding of the function they live in.
// The closure synthesis moves the lambda's body into `__call__` and declares a
// shadow there for each capture, read from the closure struct.  The shadow was
// given an identity of its own while the moved uses still named the OUTER
// binding, so inside `__call__` they named nothing the move checker tracks;
// this program was accepted and the value released three times.  The shadow
// now IS the captured binding inside `__call__`.
![config(testing)]
![config(negative, E0452)]
namespace CryoTests::Negative::ClosureBodyUseAfterMove;

type struct Res {
    tag: i32;
    drop(mut &this) -> void { }
}

function consume(r: Res) -> i32 { return r.tag; }

function main() -> int {
    const p: Res = Res { tag: 3 };
    const f = move () -> i32 {
        consume(p);
        return consume(p);
        //~^ ERROR[E0452] use of moved value 'p'
    };
    return f();
}
