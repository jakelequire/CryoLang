// E0318: a derived JSON form writes an enum as its variant's name, so an
// enum whose variants carry values cannot derive `ToValue` or `FromValue`; each
// entry is refused and the enum's other entries are still generated.  An
// enum whose variants carry nothing is the control.
![config(testing)]
![config(negative, E0318)]
namespace CryoTests::Negative::E0318DeriveJsonEnumWithValues;

import std::core::cmp::{ Eq };
import std::encoding::value::{ FromValue, ToValue };

type enum JvShape with [Eq, ToValue, FromValue] {   //~ ERROR[E0318] `ToValue` cannot be derived for an enum whose variants carry values
                                                  //~^ ERROR[E0318] `FromValue` cannot be derived for an enum whose variants carry values
    Circle(f64);
    Empty;
}

type enum JvPlain with [ToValue, FromValue] {
    On;
    Off;
}

function main() -> i32 {
    return 0;
}
