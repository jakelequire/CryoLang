// E0200: `delete` releases a pointee and frees its block, so its operand
// must be a pointer.  An integer, a struct value and a reference have
// neither, and each is refused where it is written.
![config(testing)]
![config(negative, E0200)]
namespace CryoTests::Negative::DeleteNonPointer;

type struct Cell {
    value: i32;
}

function release(c: &Cell) -> void {
    delete c;
    //~^ ERROR[E0200] `delete` takes a pointer, and `&CryoTests::Negative::DeleteNonPointer::Cell` is not a pointer
}

function main() -> int {
    const n: i32 = 5;
    delete n;
    //~^ ERROR[E0200] `delete` takes a pointer, and `i32` is not a pointer
    const c: Cell = Cell { value: 1 };
    delete c;
    //~^ ERROR[E0200] `delete` takes a pointer, and `CryoTests::Negative::DeleteNonPointer::Cell` is not a pointer
    return 0;
}
