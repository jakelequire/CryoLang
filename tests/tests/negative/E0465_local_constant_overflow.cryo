// A local `const` whose initializer is a compile-time integer is a constant,
// so arithmetic on it that overflows is refused (E0465) as arithmetic on a
// module constant is.  A use reaches the binding the scope rules give it: an
// inner block's `const` shadows an outer one, and the outer one is the
// constant again after the block.  A `const` initialized from another
// constant, local or module-level, is a constant too.  A `mut` local, a
// parameter and a `const` initialized from either are not constants.
![config(testing)]
![config(negative, E0465)]
namespace CryoTests::Negative::LocalConstantOverflow;

const MODULE_LIMIT: i32 = i32::MAX;

public function refused() -> i32 {
    const limit: i32 = i32::MAX;
    const past: i32 = limit + 1;
    //~^ ERROR[E0465] `limit + 1` overflows `i32`: its value is 2147483648, which `i32` does not hold
    const copied: i32 = limit;
    const doubled: i32 = copied * 2;
    //~^ ERROR[E0465] `copied * 2` overflows `i32`: its value is 4294967294, which `i32` does not hold
    const from_module: i32 = MODULE_LIMIT;
    const beyond: i32 = from_module + 1;
    //~^ ERROR[E0465] `from_module + 1` overflows `i32`: its value is 2147483648, which `i32` does not hold
    {
        const inner: i32 = limit - 1;
        const reaches_outer: i32 = inner + 2;
        //~^ ERROR[E0465] `inner + 2` overflows `i32`: its value is 2147483648, which `i32` does not hold
        if (reaches_outer == 0) { return 0; }
    }
    const least: i32 = i32::MIN;
    const negated: i32 = -least;
    //~^ ERROR[E0465] `-least` overflows `i32`: its value is 2147483648, which `i32` does not hold
    const remainder: i32 = least % -1;
    //~^ ERROR[E0465] `least % -1` always panics: the division it is the remainder of has the quotient 2147483648, which `i32` does not hold
    const small: u8 = 200;
    const sum: u8 = small + 100;
    //~^ ERROR[E0465] `small + 100` overflows `u8`: its value is 300, which `u8` does not hold
    if (past == 0 || doubled == 0 || beyond == 0 || negated == 0 || remainder == 0 || sum == 0) { return 1; }
    return 0;
}

public function accepted(parameter: i32) -> i32 {
    const limit: i32 = i32::MAX;
    {
        const limit: i32 = 0;
        const shadowed: i32 = limit + 1;
        if (shadowed == 0) { return 0; }
    }
    const below: i32 = limit - 1;
    mut changing: i32 = i32::MAX;
    const from_mut: i32 = changing;
    const checked_at_run_time: i32 = changing + 1;
    const from_parameter: i32 = parameter;
    const also_at_run_time: i32 = from_parameter + 1;
    const from_mut_plus: i32 = from_mut + 1;
    changing = 0;
    return below + checked_at_run_time + also_at_run_time + from_mut_plus + changing;
}
