// E0312: whatever implements a subtrait promises its supertraits' methods
// too, so an implementation of the subtrait for a type that does not
// implement a supertrait, at the arguments the subtrait writes on it, is
// refused where the `implement` block is written.  A generic
// implementation whose supertrait is implemented for the same template
// stands.
![config(testing)]
![config(negative, E0312)]
namespace CryoTests::Negative::SubtraitWithoutSupertrait;

type trait Base { id(&this) -> i32; }
type trait Shape : Base { area(&this) -> i32; }
type trait Measure<T> { measure(&this) -> T; }
type trait Sized<U> : Measure<U> { count(&this) -> i32; }

type struct Square { side: i32; }
type struct Box<T> { v: T; }
type struct Crate<T> { v: T; }

implement trait Shape for Square {
    //~^ ERROR[E0312] `CryoTests::Negative::SubtraitWithoutSupertrait::Square` does not implement `CryoTests::Negative::SubtraitWithoutSupertrait::Base`, which `CryoTests::Negative::SubtraitWithoutSupertrait::Shape` requires, so `CryoTests::Negative::SubtraitWithoutSupertrait::Square` cannot implement `CryoTests::Negative::SubtraitWithoutSupertrait::Shape`
    area(&this) -> i32 { return this.side * this.side; }
}

implement trait Measure<i32> for Square {
    measure(&this) -> i32 { return 1; }
}

implement trait Sized<i64> for Square {
    //~^ ERROR[E0312] `CryoTests::Negative::SubtraitWithoutSupertrait::Square` does not implement `CryoTests::Negative::SubtraitWithoutSupertrait::Measure<i64>`, which `CryoTests::Negative::SubtraitWithoutSupertrait::Sized` requires, so `CryoTests::Negative::SubtraitWithoutSupertrait::Square` cannot implement `CryoTests::Negative::SubtraitWithoutSupertrait::Sized`
    count(&this) -> i32 { return 1; }
}

implement trait Sized<i32> for Square {
    count(&this) -> i32 { return 2; }
}

implement<T> trait Base for Box<T> {
    id(&this) -> i32 { return 1; }
}

implement<T> trait Shape for Box<T> {
    area(&this) -> i32 { return 2; }
}

implement<T> trait Shape for Crate<T> {
    //~^ ERROR[E0312] `CryoTests::Negative::SubtraitWithoutSupertrait::Crate` does not implement `CryoTests::Negative::SubtraitWithoutSupertrait::Base`, which `CryoTests::Negative::SubtraitWithoutSupertrait::Shape` requires, so `CryoTests::Negative::SubtraitWithoutSupertrait::Crate` cannot implement `CryoTests::Negative::SubtraitWithoutSupertrait::Shape`
    area(&this) -> i32 { return 3; }
}

function main() -> int {
    return 0;
}
