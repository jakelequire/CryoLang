// E0200: a function-pointer field is a typed slot, and assigning to it must be
// judged like any other store. The declaration and struct-literal forms of the
// same store always were; assignment was not, because the predicate gating the
// check reported a function type as "not concrete enough to judge" - a rule it
// inherited from generic inference, where the question is instead whether a
// type can pin a type variable. Nothing diagnosed the store, and the failure
// arrived later as a call through the slot into whatever had been written there.
![config(testing)]
![config(negative, E0200)]
namespace CryoTests::Negative::FnPointerFieldAssign;

type struct Vtable {
    drop_fn: (void*) -> void;
    data:    void*;
}

function nop(p: void*) -> void { }

function main() -> int {
    mut vt: Vtable = Vtable { drop_fn: nop, data: null };
    const s: string = "hello";
    vt.drop_fn = s;   //~ ERROR[E0200] mismatched types
    return 0;
}
