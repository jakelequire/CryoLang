// A negated literal argument whose owner the expected type binds adopts the
// parameter's type when the parameter holds it: a signed type down to its
// minimum.  One past that minimum, or one for an unsigned parameter, keeps
// its default width and is refused at the call.
![config(testing)]
![config(negative, E0214)]
namespace CryoTests::Negative::NegatedLiteralArgumentPastBoundOwner;

type struct NlHolder<T> {
    value: T;
    static make(value: T) -> NlHolder<T> { return NlHolder::<T> { value: value }; }
}

function main() -> int {
    const fits: NlHolder<i8> = NlHolder::make(-128);
    const past: NlHolder<i8> = NlHolder::make(-129);      //~ ERROR[E0214] mismatched types
    const unsigned: NlHolder<u16> = NlHolder::make(-3);   //~ ERROR[E0214] mismatched types
    return fits.value as int + past.value as int + unsigned.value as int;
}
