// E0502: the value model's error is `ValueDecodeError`, so it is not
// mistaken for the byte codecs' `DecodeError` (`std::encoding::error`).
// `std::encoding::value` offers no `DecodeError`; the codecs' one is still
// imported from where it lives.
![config(testing)]
![config(negative, E0502)]
namespace CryoTests::Negative::ValueModelErrorIsValueDecodeError;

import std::encoding::value::{ DecodeError };
//~^ ERROR[E0502] `std::encoding::value` does not offer `DecodeError`
import std::encoding::value::{ ValueDecodeError };
import std::encoding::error::{ DecodeError as CodecError };

function main() -> i32 {
    return 0;
}
