// E0353: a stdio lock guard is made only by its stream's `lock()`, which
// takes the lock the guard's `drop` releases.  The guard's field is private,
// so a program cannot build one that would release a lock nobody took,
// whether it names the field or leaves it out.
![config(testing)]
![config(negative, E0353)]
namespace CryoTests::Negative::E0353StdioLockGuardConstructed;

import std::io::stdio::{ StdinLock, StdoutLock, StderrLock };

function main() -> int {
    const out: StdoutLock = StdoutLock { };
    //~^ ERROR[E0353] field `slot` of `std::io::stdio::StdoutLock` is private
    //~^^ ERROR[E0355] missing field `slot` in initializer of `std::io::stdio::StdoutLock`
    const err: StderrLock = StderrLock { slot: null };
    //~^ ERROR[E0353] field `slot` of `std::io::stdio::StderrLock` is private
    const input: StdinLock = StdinLock { };
    //~^ ERROR[E0353] field `slot` of `std::io::stdio::StdinLock` is private
    //~^^ ERROR[E0355] missing field `slot` in initializer of `std::io::stdio::StdinLock`
    return 0;
}
