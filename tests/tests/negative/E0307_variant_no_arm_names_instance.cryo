// E0307: an arm constructing a variant of a generic enum with no instance
// named takes the instance a sibling arm has, but where no arm names one,
// in an `if`, a `?:` or a `match`, nothing says which instance it is.
![config(testing)]
![config(negative, E0307)]
namespace CryoTests::Negative::VariantNoArmNamesInstance;

function main() -> int {
    const c: boolean = true;
    const first = if (c) { Option::None } else { Option::None };
    //~^ ERROR[E0307] cannot infer the type arguments of `std::core::option::Option` for its variant `None`
    //~^^ ERROR[E0307] cannot infer the type arguments of `std::core::option::Option` for its variant `None`
    const second = c ? Option::None : Option::None;
    //~^ ERROR[E0307] cannot infer the type arguments of `std::core::option::Option` for its variant `None`
    //~^^ ERROR[E0307] cannot infer the type arguments of `std::core::option::Option` for its variant `None`
    const third = match (c) {
        true  => { Option::None }
        //~^ ERROR[E0307] cannot infer the type arguments of `std::core::option::Option` for its variant `None`
        false => { Option::None }
        //~^ ERROR[E0307] cannot infer the type arguments of `std::core::option::Option` for its variant `None`
    };
    return 0;
}
