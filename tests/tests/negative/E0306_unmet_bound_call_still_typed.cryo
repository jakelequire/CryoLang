// E0306: a call refused because its argument's type does not meet the
// callee's bound is still typed by the callee's return with the bound
// parameter substituted, so a typed binding of its result and a field read
// of it report nothing more - for a free function and a static method.
![config(testing)]
![config(negative, E0306)]
namespace CryoTests::Negative::UnmetBoundCallStillTyped;

import std::core::cmp::{ min };

type struct Plain { v: i32; }

type struct Pair {
    first: i32;

    static pick<T>(value: T) -> T where T: Ord { return value; }
}

function main() -> i32 {
    const a: Plain = Plain { v: 1 };
    const b: Plain = Plain { v: 2 };
    const low: Plain = min(a, b);
    //~^ ERROR[E0306] the trait bound `CryoTests::Negative::UnmetBoundCallStillTyped::Plain: Ord` is not satisfied
    const picked: Plain = Pair::pick(Plain { v: 3 });
    //~^ ERROR[E0306] the trait bound `CryoTests::Negative::UnmetBoundCallStillTyped::Plain: Ord` is not satisfied
    // Control: a call whose bound holds.
    const whole: i32 = min(4, 5);
    return low.v + picked.v + whole;
}
