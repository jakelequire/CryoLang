// E0209: `switch` compares by value (it would test string addresses, not
// contents), so it can't dispatch on strings - the diagnostic steers the
// user to a `match` with string patterns.
![config(testing)]
![config(negative, E0209)]
namespace CryoTests::Negative::SwitchOnString;
function main() -> int {
    const s: string = "hello";
    switch (s) {   //~ ERROR[E0209] `switch` cannot match on `string`
        case "a": { }
        default:  { }
    }
    return 0;
}
