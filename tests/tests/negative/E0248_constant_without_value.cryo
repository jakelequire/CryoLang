// E0248: a type's constant is written with a value; nothing could give it
// one later.
![config(testing)]
![config(negative, E0248)]
namespace CryoTests::Negative::ConstantWithoutValue;

type struct Gauge {
    reading: f64;
    const EMPTY: Gauge;   //~ ERROR[E0248] the constant `EMPTY` has no value
}

function main() -> int {
    return 0;
}
