// E0200: an opaque `implement Trait<T>` binding carries the associated item.
// `Seq<T>` is positional sugar for `Seq<Item = T>`, so binding a value whose
// actual `Seq::Item` is `i32` to `implement Seq<i64>` names the wrong element
// type and must be rejected (not silently accepted, as it was before Stage 4).
![config(testing)]
![config(negative, E0200)]
namespace CryoTests::Negative::OpaqueAssocItemBinding;

import std::core::option;

type trait Seq {
    type Item;
    next_one(mut &this) -> Option<This::Item>;
}

type struct IntSeq { n: i32; lim: i32; }
implement trait Seq<i32> for struct IntSeq {
    next_one(mut &this) -> Option<i32> { return Option::None; }
}

function make_seq() -> implement Seq<i32> {
    return IntSeq { n: 0, lim: 4 };
}

function main() -> int {
    mut it: implement Seq<i64> = make_seq();   // Item is i32, not i64
    return 0;
}
