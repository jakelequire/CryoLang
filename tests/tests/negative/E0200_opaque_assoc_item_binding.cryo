// E0200: an opaque `implement Trait<T>` binding carries the associated item.
// `Seq<T>` is positional sugar for `Seq<Item = T>`, so binding a value whose
// actual `Seq::Item` is `Apple` to `implement Seq<Orange>` names the wrong
// element type and must be rejected, not silently accepted. Two distinct
// user structs are a genuine, category-level mismatch.
![config(testing)]
![config(negative, E0200)]
namespace CryoTests::Negative::OpaqueAssocItemBinding;

import std::core::option;

type struct Apple { x: i32; }
type struct Orange { y: i32; }

type trait Seq {
    type Item;
    next_one(mut &this) -> Option<This::Item>;
}

type struct AppleSeq { n: i32; }
implement trait Seq<Apple> for struct AppleSeq {
    next_one(mut &this) -> Option<Apple> { return Option::None; }
}

function make_seq() -> implement Seq<Apple> {
    return AppleSeq { n: 0 };
}

function main() -> int {
    mut it: implement Seq<Orange> = make_seq();   // Item is Apple, not Orange   //~ ERROR[E0200] `it` is declared `implement
    return 0;
}
