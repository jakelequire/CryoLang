// E0233: inside a body walked symbolically, a scope segment naming a generic
// parameter of that body is answered by the parameter's STAMP, never by its
// spelling. An impl on a concrete instantiation walks its methods over the
// TEMPLATE's parameters (`Holder<A>`'s `A`), which no binding in the body
// spells; a type sharing that spelling (`type struct A`) is the type, and a
// static it does not declare is refused. Before the stamp was asked, the
// spelling passed for the parameter and this program compiled with nothing
// reporting `A::nothing` (the walk is the only walk: no `Holder<i32>` is
// instantiated anywhere, so no concrete re-check runs).
![config(testing)]
![config(negative, E0233)]
namespace CryoTests::Negative::E0233TemplateParamSpellingIsNotTheParam;

type struct A { v: i32; }
type struct Holder<A> { v: i32; }
type trait Tick { tick(&this) -> i32; }

implement trait Tick for struct Holder<i32> {
    tick(&this) -> i32 {
        const x: i32 = A::nothing();
        //~^ ERROR[E0233] cannot find `A::nothing`: no matching static method, variant, or type
        return x;
    }
}

function main() -> int {
    return 3;
}
