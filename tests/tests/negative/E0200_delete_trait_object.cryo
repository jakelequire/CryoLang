// E0200: `delete` of a trait object.  The value behind `virtual Shape*`
// has a size and a destructor that are not known where the object is used,
// so there is nothing `delete` could release it with.
![config(testing)]
![config(negative, E0200)]
namespace CryoTests::Negative::DeleteTraitObject;

type trait Shape {
    area(&this) -> i32;
}

function release(p: virtual Shape*) -> void {
    delete p;
    //~^ ERROR[E0200] `delete` takes a pointer, and `virtual CryoTests::Negative::DeleteTraitObject::Shape*` is a trait object
}

function main() -> int {
    return 0;
}
