// E0101: a trait and a type alias take no `where` clause, so a bound written
// on one of their type parameters has nothing to mean and is refused where it
// is written.  The same parameter without the bound is accepted.
![config(testing)]
![config(negative, E0101)]
namespace CryoTests::Negative::InlineBoundWithoutWhere;

type trait Tagged {
    tag(&this) -> i32;
}

type trait Convert<T: Tagged> {   //~ ERROR[E0101] a trait bound cannot be written on a type parameter of a trait
    convert(&this) -> T;
}

type trait Plain<T> {
    plain(&this) -> T;
}

type struct Box2<T> { v: T; }

type Boxed<T: Tagged> = Box2<T>;   //~ ERROR[E0101] a trait bound cannot be written on a type parameter of a type alias

type Unboxed<T> = Box2<T>;

function main() -> int {
    return 0;
}
