// E0203: the prelude binds `panic` bare from `std::core::panic`, and
// `std::core` itself is not a prelude module, so a body path through
// `core` names nothing in a file that does not import it. The bare
// `panic(...)` is the prelude's function.
![config(testing)]
![config(negative, E0203)]
namespace CryoTests::Negative::CorePathWithoutAnImport;

import std::core::intrinsics;

function stop(n: i32) -> i32 {
    if (n < 0) {
        core::panic("negative", intrinsics::location());
        //~^ ERROR[E0203] cannot find type `core` in this scope
    }
    if (n == 0) {
        panic("zero", intrinsics::location());
    }
    return n;
}

function main() -> int {
    return stop(1);
}
