// E0364: a constructor cannot be `async`.
//
// An `async` body lowers to a future the CALLER polls, so the value it produces
// exists only once polling completes.  A constructor has no such caller: it must
// hand back a fully initialized object before anything can observe it, and the
// object does not exist until it returns.  There is nothing to suspend into.
![config(testing)]
![config(negative, E0364)]
namespace CryoTests::Negative::E0364AsyncConstructor;

import std::future;

type class CfAsyncCtor {
public:
    v: i64;

    public async CfAsyncCtor(n: i64) { this.v = n; }   //~ ERROR[E0364] a constructor cannot be `async`
}

function main() -> int { return 0; }
