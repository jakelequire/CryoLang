// E0306: `for (x in <expr>)` iterates through the language's `Iterator`.  A
// type with a method that is merely spelled `next` is not an iterator: the
// loop used to find `next` by name on any type and accept it, the same shape
// as `?` unwrapping any enum with an `Ok` variant.
![config(testing)]
![config(negative, E0306)]
namespace CryoTests::Negative::ForInDuckTypedNext;

import std::fmt;

type struct Countdown { n: i32; }

implement struct Countdown {
    next(mut &this) -> Option<i32> {
        if (this.n <= 0) { return Option::None; }
        this.n = this.n - 1;
        return Option::Some(this.n + 1);
    }
}

function main() -> int {
    const c: Countdown = Countdown { n: 3 };
    for (i in c) {   //~ ERROR[E0306] `Countdown` does not implement `Iterator`
        fmt::printf("%d\n", i);
    }
    return 0;
}
