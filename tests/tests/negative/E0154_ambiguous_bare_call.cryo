// E0154: a bare name two wildcard imports bring into scope from different
// modules names neither of them.  `std::ffi::libc` and
// `std::core::intrinsics` both declare `free`, and both are imported whole
// here, so bare `free(p)` is refused where it is USED and the author must
// write the path out.  Two brace entries naming it are refused earlier, at
// the second import (E0243).  The refusal is the name layer's: it is not
// about the call's signature, and it fires for a value or a callee alike.
// It is confined to the import tier: a declaration of `free` in this module
// would shadow both imports silently, since a module's own declarations
// come before its imports, and a name only ONE import binds is never
// ambiguous however many other modules declare the leaf (the runtime side
// of that is tests/tests/lang/bare_intrinsic_priority.cryo).
![config(testing)]
![config(negative, E0154)]
namespace CryoTests::Negative::AmbiguousBareCall;

import std::ffi::libc;
import std::ffi::libc::*;
import std::core::intrinsics;
import std::core::intrinsics::*;

function main() -> int {
    const p: void* = null;
    free(p);   //~ ERROR[E0154] `free` is ambiguous: it is imported from both `std::ffi::libc` and `std::core::intrinsics`
    return 0;
}
