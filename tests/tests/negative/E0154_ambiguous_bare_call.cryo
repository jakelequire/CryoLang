// E0154: a bare function call is ambiguous when two same-signature
// candidates are EQUALLY near — here both `std::alloc::heap` and
// `std::alloc::allocator` are explicitly imported and both export
// `alloc(u64, u64) -> void*`, so bare `alloc(size, align)` must demand
// qualification instead of silently picking either. Note the tier rules
// this deliberately does NOT violate: a single explicit import shadows the
// prelude silently (bare `free` in a heap-importing module binds
// `heap::free` over the prelude intrinsic with no error), and an
// unimporting module keeps binding the intrinsic — the runtime side is
// covered by tests/tests/lang/bare_intrinsic_priority.cryo. The arguments
// are typed u64 on purpose: int literals would miss the exact-signature
// match and fall into the blind-pin tier path instead of the ambiguity
// check.
![config(testing)]
![config(negative, E0154)]
namespace CryoTests::Negative::AmbiguousBareCall;

import std::alloc::heap;
import std::alloc::allocator;

function main() -> int {
    const size: u64 = 64;
    const align: u64 = 8;
    const p: void* = alloc(size, align);
    if (p == null) { return 1; }
    return 0;
}
