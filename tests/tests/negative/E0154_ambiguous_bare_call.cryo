// E0154: a bare name two specific imports bring into scope from different
// modules names neither of them.  `std::alloc::heap` and
// `std::alloc::allocator` both export `alloc(u64, u64) -> void*`, and both
// are imported by name here, so bare `alloc(size, align)` is refused where
// it is USED and the author must write the path out.  The refusal is the
// name layer's: it is not about the call's signature, and it fires for a
// value or a callee alike.  It is confined to the import tier: a declaration
// of `alloc` in this module would shadow both imports silently (spec §4
// rule 1), and a name only ONE import binds is never ambiguous however many
// other modules declare the leaf (the runtime side of that is
// tests/tests/lang/bare_intrinsic_priority.cryo).
![config(testing)]
![config(negative, E0154)]
namespace CryoTests::Negative::AmbiguousBareCall;

import std::alloc::heap;
import std::alloc::heap::{ alloc };
import std::alloc::allocator;
import std::alloc::allocator::{ alloc };

function main() -> int {
    const size: u64 = 64;
    const align: u64 = 8;
    const p: void* = alloc(size, align);   //~ ERROR[E0154] `alloc` is ambiguous: it is imported from both `std::alloc::heap` and `std::alloc::allocator`
    if (p == null) { return 1; }
    return 0;
}
