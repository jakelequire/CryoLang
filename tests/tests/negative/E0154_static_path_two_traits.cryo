// E0154: a `Type::method` path is ambiguous when two traits implemented for
// the type each provide `method` at the signature the use selects and the
// type has no inherent `method` to prefer (an inherent one names itself,
// `static_path_prefers_inherent_method`). Both forms of the path tie the
// same way: the call `P::go(&p)` and the static method taken as a value
// `P::make`. Sema reports the tie naming both traits; before it did, the
// path reached codegen unpinned and was refused there as an unknown
// associated function (E0636) or an unpinned family (E0900).
![config(testing)]
![config(negative, E0154)]
namespace CryoTests::Negative::StaticPathTwoTraits;

type trait CfBeta {
    go(&this) -> i32;
    static make() -> i32;
}

type trait CfGamma {
    go(&this) -> i32;
    static make() -> i32;
}

type struct CfP { v: i32; }

implement trait CfBeta for CfP {
    go(&this) -> i32 { return this.v * 2; }
    static make() -> i32 { return 2; }
}

implement trait CfGamma for CfP {
    go(&this) -> i32 { return this.v * 5; }
    static make() -> i32 { return 5; }
}

function main() -> int {
    const p: CfP = CfP { v: 1 };
    const a: i32 = CfP::go(&p);        //~ ERROR[E0154] `CfP::go` is ambiguous: `go` is provided by more than one trait implemented for `CfP`
    const f: () -> i32 = CfP::make;    //~ ERROR[E0154] `CfP::make` is ambiguous: `make` is provided by more than one trait implemented for `CfP`
    return a + f();
}
