// E0306: a call through a generic trait's path selects the receiver's
// implementation, and a receiver whose type has none is refused at the
// path, with no second error for the call's type.
![config(testing)]
![config(negative, E0306)]
namespace CryoTests::Negative::E0306GenericTraitPathUnimplemented;

type trait GtPeek<R> {
    peek(&this) -> R;
}

type struct GtPlain { n: i32; }
type struct GtBare { n: i32; }

implement trait GtPeek<i32> for struct GtPlain {
    peek(&this) -> i32 { return this.n; }
}

function main() -> int {
    const plain: GtPlain = GtPlain { n: 1 };
    const fine: i32 = GtPeek::peek(&plain);
    const bare: GtBare = GtBare { n: 2 };
    const refused: i32 = GtPeek::peek(&bare);   //~ ERROR[E0306] `GtBare` does not implement `GtPeek`
    return 0;
}
