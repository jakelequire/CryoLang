// E0104: the parentheses after `mut` group one pointer or borrow level, so a
// group of anything else is refused - a writable pointer to it is written
// without them, `mut u8*`.  Refused in a written type and in an `as` target
// alike.
![config(testing)]
![config(negative, E0104)]
namespace CryoTests::Negative::WritableGroupNotAnIndirection;

function grouped_value(p: mut (u8)*) -> u8 {                            //~ ERROR[E0104] the parentheses after `mut` group a pointer or a borrow type, and `(u8)` is neither
    return *p;
}

function cast_to_grouped_value(p: u8*) -> u8 {
    const q: mut u8* = p as mut (u8)*;                                  //~ ERROR[E0104] the parentheses after `mut` group a pointer or a borrow type, and `(u8)` is neither
    return *q;
}

function main() -> int {
    return 0;
}
