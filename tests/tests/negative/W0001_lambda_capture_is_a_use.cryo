// W0001: a binding a lambda captures is read by the lambda, so it is used.
// Only the two locals annotated below are unused.  An annotated file is
// checked both ways: a W0001 for any captured binding is unannotated and
// fails the suite.
![config(testing)]
![config(negative, W0001)]
namespace CryoTests::Negative::W0001LambdaCaptureIsAUse;

type struct CfOwned {
    n: i64;
}

implement trait Drop for struct CfOwned {
    drop(mut &this) -> void { }
}

// A parameter read only inside the lambda.
function cf_adder(n: i64) -> i64 {
    const add = (x: i64) -> i64 { return x + n; };
    return add(1);
}

// A local read only by a lambda nested in another lambda, and the outer
// lambda's own parameter read only by the inner one.
function cf_nested(base: i64) -> i64 {
    const outer = (k: i64) -> i64 {
        const inner = (x: i64) -> i64 { return x + base + k; };
        return inner(1);
    };
    return outer(2);
}

// A value a `move` lambda takes.
function cf_moved() -> i64 {
    const o: CfOwned = CfOwned { n: 4 };
    const mover = move () -> i64 { return o.n; };
    return mover();
}

function main() -> int {
    const unused_local: int = 5;   //~ WARN[W0001] unused variable `unused_local`
    const base: i64 = 10;
    const cap = (x: i64) -> i64 { return x + base; };
    const in_body = (x: i64) -> i64 {
        const unused_inner: i64 = 3;   //~ WARN[W0001] unused variable `unused_inner`
        return x - base;
    };
    if (cf_adder(2) + cf_nested(1) + cf_moved() + cap(1) + in_body(10) == 31) { return 0; }
    return 1;
}
