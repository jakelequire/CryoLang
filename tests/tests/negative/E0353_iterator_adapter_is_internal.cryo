![config(negative, E0353)]
namespace CryoTests::Negative::IteratorAdapterIsInternal;

import std::core::iter::{ MapIter };   //~ ERROR[E0353] `std::core::iter::MapIter` is internal to its package and cannot be imported

function main() -> int {
    return 0;
}
