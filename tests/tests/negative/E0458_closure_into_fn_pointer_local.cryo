// E0458: a capturing closure passed through a LOCAL fn-pointer - here a
// parameter `f` of fn type - has no declaration to specialize against, and
// the indirect call would treat the closure struct as a function pointer.
// Before the callee was read off its stamp this SEGFAULTED at runtime, or,
// when a global shared the parameter's leaf (the `f` below), was silently
// bound to that global's closure specialization and returned its result
// instead - exit 0 either way.  It must be rejected cleanly at compile time,
// whether or not a same-leaf global exists.
![config(testing)]
![config(negative, E0458)]
namespace CryoTests::Negative::E0458ClosureIntoFnPointerLocal;

import std::core::result;

// A global sharing the parameter's leaf, with a fn-typed parameter: the
// shape a leaf-keyed lookup bound the call below to.
function f(cb: (i32) -> i32) -> i32 { return cb(1); }

function h(cb: (i32) -> i32) -> i32 { return cb(2); }

function g(f: ((i32) -> i32) -> i32) -> i32 {
    const k: i32 = 40;
    const add_k = (x: i32) -> i32 { return x + k; };
    return f(add_k);   //~ ERROR[E0458] passing a capturing closure to a fn-pointer local's parameter
}

function main() -> int {
    return g(h);
}
