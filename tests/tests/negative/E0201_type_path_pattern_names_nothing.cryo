// E0201: a payload-less path in a pattern whose leading segments name a type
// that is no enum names a constant of that type, as the same path written as
// a value does; a type declaring no constant by the leaf's name leaves the
// pattern naming nothing.
![config(testing)]
![config(negative, E0201)]
namespace CryoTests::Negative::E0201TypePathPatternNamesNothing;

type struct Limits {
    const TOP: u32 = 9;
}

function classify(code: u32) -> i32 {
    return match (code) {
        u32::LARGEST => { 1 }
        //~^ ERROR[E0201] cannot find value `u32::LARGEST` in this scope
        Limits::BOTTOM => { 2 }
        //~^ ERROR[E0201] cannot find value `Limits::BOTTOM` in this scope
        Limits::TOP => { 3 }
        _ => { 0 }
    };
}

function main() -> int {
    return classify(3);
}
