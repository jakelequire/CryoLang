// E0313: a trait is no type, so one written where a value's type goes - a
// parameter, a return type, a local, a field, an array element, a type
// argument, an alias's target - is refused where it is written rather than
// accepted as a placeholder that fails at its first use.  The trait's own
// positions stay accepted: an impl head, a where-clause bound, an
// impl-qualified path and `&This`.  A field whose annotation was refused is
// also reported as unresolved (E0203), as it is for a field naming an
// unknown type.
![config(testing)]
![config(negative, E0313)]
namespace CryoTests::Negative::TraitAsValueType;

type trait Shape {
    area(&this) -> i32;
    same(&this, o: &This) -> boolean { return this.area() == o.area(); }
}

type trait Conv<T> {
    conv(&this) -> T;
}

type struct Sq { s: i32; }

implement trait Shape for struct Sq {
    area(&this) -> i32 { return this.s * this.s; }
}

implement trait Conv<i64> for struct Sq {
    conv(&this) -> i64 { return this.s as i64; }
}

type struct Holder {
    p: Shape;                                      //~ ERROR[E0313] `Shape` is a trait, not a type
    //~^ ERROR[E0203] cannot resolve type for field `p` of `Holder`
}

type ShapeAlias = Shape;                           //~ ERROR[E0313] `Shape` is a trait, not a type

function by_val(p: Shape) -> i32 { return 1; }     //~ ERROR[E0313] `Shape` is a trait, not a type
function by_conv(p: Conv<i64>) -> i32 { return 1; }  //~ ERROR[E0313] `Conv` is a trait, so `Conv<...>` is not a type
function ret(q: Sq) -> Shape { return q; }         //~ ERROR[E0313] `Shape` is a trait, not a type
function in_array(ps: Shape[]) -> i32 { return 0; }  //~ ERROR[E0313] `Shape` is a trait, not a type

function total<T>(p: &T) -> i32 where T: Shape { return p.area(); }

function main() -> int {
    const q: Sq = Sq { s: 3 };
    const s: Shape = q;                            //~ ERROR[E0313] `Shape` is a trait, not a type
    const r: i32 = (Shape for Sq)::area(&q);
    if (!q.same(&q)) { return 1; }
    return total(&q) - 9 + r - 9;
}
