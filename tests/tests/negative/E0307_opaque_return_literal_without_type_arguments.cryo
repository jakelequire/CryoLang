// E0307: an opaque return's concrete type is read from the type arguments
// its returned struct literal writes, so a generic struct's literal written
// without them names no instance.  It is refused at the literal, once, and
// the caller that holds the result is not reported as well.
![config(testing)]
![config(negative, E0307)]
namespace CryoTests::Negative::OpaqueReturnLiteralWithoutTypeArguments;

type trait Source { next_value(mut &this) -> i64; }

type struct Gen<F> where F: () -> i64 {
    f: F;
}

implement<F> trait Source for Gen<F> where F: () -> i64 {
    next_value(mut &this) -> i64 { return this.f(); }
}

function four() -> i64 { return 4; }

function make() -> implement Source {
    return Gen { f: four };
    //~^ ERROR[E0307] cannot infer the type arguments of `Gen` for the opaque return type
}

function main() -> int {
    mut g = make();
    if (g.next_value() != 4) { return 1; }
    return 0;
}
