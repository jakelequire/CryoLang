// An implementation for every type answers a bound on a generic body's
// parameter only as it is written.  `Make<T> for T` gives a parameter `T`
// `Make<T>` and no other `Make`, so `T: Make<i64>` is refused; and an
// implementation with a `where` clause is not asked for a parameter at
// all, since each copy of the body would meet its clause or not on its own.
![config(testing)]
![config(negative, E0306)]
namespace CryoTests::Negative::EveryTypeHeadGivesOnlyItsOwnBound;

public type trait Make<U> {
    static make(value: U) -> This;
}

implement<T> trait Make<T> for T {
    static make(value: T) -> T { return value; }
}

public type trait Bounded {
    static bounded() -> i64;
}

implement<T> trait Bounded for T where T: Copy {
    static bounded() -> i64 { return 1; }
}

function needs_make<A, B>(value: B) -> A where A: Make<B> {
    return A::make(value);
}

function needs_bounded<A>() -> i64 where A: Bounded {
    return A::bounded();
}

function another_argument<T>(value: i64) -> T {
    return needs_make::<T, i64>(value);
    //~^ ERROR[E0306] the trait bound `T: Make<i64>` is not satisfied
}

function clause_on_the_head<T>() -> i64 {
    return needs_bounded::<T>();
    //~^ ERROR[E0306] the trait bound `T: Bounded` is not satisfied
}

function main() -> int {
    return needs_bounded::<i64>() as int;
}
