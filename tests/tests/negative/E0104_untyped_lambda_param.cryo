// E0104: a lambda with an untyped parameter (`(x) -> ...`).  Cryo does not
// infer lambda parameter types, so each parameter needs an explicit
// annotation.  Before this diagnostic, the bare `(x) ->` shape parsed as a
// parenthesized expression and then tripped the misleading "`->` is not an
// operator" error; it is now reported as the missing annotation it is.
![config(testing)]
![config(negative, E0104)]
namespace CryoTests::Negative::E0104UntypedLambdaParam;

function cf_apply(f: (i32) -> i32, v: i32) -> i32 {
    return f(v);
}

function cf_main() -> int {
    // Braced body (v1.0 requires it); the defect under test is the untyped
    // parameter `x`, which must raise E0104.
    return cf_apply((x) -> { return x + 1; }, 5);   //~ ERROR[E0104] lambda parameters need explicit
}
