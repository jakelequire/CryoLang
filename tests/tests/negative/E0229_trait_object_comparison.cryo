// E0229: a raw trait object `virtual T*` compares with `null` by `==` and
// `!=`, testing its data word; it compares with nothing else and by no
// other operator, and a borrowed object does not compare at all.
![config(testing)]
![config(negative, E0229)]
namespace CryoTests::Negative::TraitObjectComparison;

type trait Shape {
    area(&this) -> i32;
}

type struct Circle {
    r: i32;
}

implement trait Shape for Circle {
    area(&this) -> i32 { return this.r; }
}

function main() -> int {
    const c: Circle = Circle { r: 2 };
    const s: virtual &Shape = &c;
    const p: virtual Shape* = &c as Circle*;
    if (s == s) { return 1; }
    //~^ ERROR[E0229] `virtual &CryoTests::Negative::TraitObjectComparison::Shape` is a borrowed trait object, which does not compare
    if (p == p) { return 2; }
    //~^ ERROR[E0229] `virtual CryoTests::Negative::TraitObjectComparison::Shape*` compares only with `null`, by `==` or `!=`
    if (p < null) { return 3; }
    //~^ ERROR[E0229] `virtual CryoTests::Negative::TraitObjectComparison::Shape*` compares only with `null`, by `==` or `!=`
    return 0;
}
