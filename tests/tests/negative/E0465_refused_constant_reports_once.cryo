// A constant whose initializer overflows is refused once, where it
// overflows.  Arithmetic on it, a constant made from it and an array sized by
// it report nothing more: the value was never one its type holds, so nothing
// computed from it is judged again.
![config(testing)]
![config(negative, E0465)]
namespace CryoTests::Negative::RefusedConstantReportsOnce;

const CF_PAST: i32 = i32::MAX + 1;
//~^ ERROR[E0465] `i32::MAX + 1` overflows `i32`: its value is 2147483648, which `i32` does not hold
const CF_DOUBLED: i32 = CF_PAST + CF_PAST;
const CF_NEGATED: i32 = -CF_PAST;
const CF_BACK: i32 = CF_PAST - 1;
const CF_PAST_AGAIN: i32 = CF_BACK + 1;
const CF_SMALL: u8 = 200;
const CF_SIZE: u8 = CF_SMALL + 100;
//~^ ERROR[E0465] `CF_SMALL + 100` overflows `u8`: its value is 300, which `u8` does not hold

type struct CfBuffer {
    sized_by_refused: [u8; CF_SIZE];
}

public function cf_local() -> i32 {
    const limit: i32 = i32::MAX;
    const past: i32 = limit + 1;
    //~^ ERROR[E0465] `limit + 1` overflows `i32`: its value is 2147483648, which `i32` does not hold
    const again: i32 = past * 2;
    return again + CF_DOUBLED + CF_NEGATED;
}
