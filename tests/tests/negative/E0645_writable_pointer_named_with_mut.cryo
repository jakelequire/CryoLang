///! A type is named with its `mut`: a read-only pointer prints as `T*`, a
///! writable one as `mut T*`, and a writable pointer whose pointee is itself
///! a pointer groups that pointee, `mut (T*)*`, since an ungrouped `mut`
///! belongs to the innermost pointer of the run.  A read-only pointer to a
///! writable one is the ungrouped `mut T**`.

![config(testing)]
![config(negative, E0645)]
namespace CryoTests::Negative::E0645WritablePointerNamedWithMut;

type struct Item {
    value: i32;
}

function only_bytes<T>() -> i32 {
    return static match (T) {
    //~^ ERROR[E0645] no `static match` arm matches type `CryoTests::Negative::E0645WritablePointerNamedWithMut::Item*`
    //~^^ ERROR[E0645] no `static match` arm matches type `mut CryoTests::Negative::E0645WritablePointerNamedWithMut::Item**`
        u8 => { 1 }
    };
}

function only_bytes_behind<T>(p: mut T*) -> i32 {
    return static match (mut T*) {
    //~^ ERROR[E0645] no `static match` arm matches type `mut (CryoTests::Negative::E0645WritablePointerNamedWithMut::Item*)*`
        u8 => { 1 }
    };
}

function main() -> int {
    mut item: Item = Item { value: 1 };
    mut read_only: Item* = &item;
    return only_bytes::<Item*>() + only_bytes::<mut Item**>() + only_bytes_behind::<Item*>(&read_only);
}
