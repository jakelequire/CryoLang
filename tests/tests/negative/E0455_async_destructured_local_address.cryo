// E0455: a destructured field is a local of the frame like any other, so its
// address cannot be held across a suspend - the frame it names is gone by
// the time the pointer is read.  The same program with `a` declared plainly
// has always been refused; the destructure was not, because the lowering
// never registered its fields as frame locals.
![config(testing)]
![config(negative, E0455)]
namespace CryoTests::Negative::E0455AsyncDestructuredLocalAddress;

import std::future;
import std::future::{ PendingThenReady };

type struct Pair {
    a: i64;
    b: i64;
}

async function f() -> i64 {
    const {a, b}: Pair = Pair { a: 1, b: 2 };
    const p: i64* = &a;
    //~^ ERROR[E0455] async: `p` holds the address of the local or parameter `a` and is live across an `await`; each poll runs on a fresh frame, so that address is dangling by the time a later step uses it — have the caller own the storage and pass a pointer parameter, whose pointee the suspend does not move
    const _z: i64 = await PendingThenReady::<i64>::new(2, 1);
    return *p;
}

function main() -> int { return 0; }
