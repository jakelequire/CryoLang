namespace TaskPanicPrintsItsReport;

import std::core::intrinsics;
import std::ffi::libc;
import std::future::{ JoinError, JoinHandle, Task };

async function gives_up() -> i64 {
    intrinsics::panic("the task gave up", intrinsics::location());
}

async function main() -> i32 {
    const doomed: JoinHandle<i64> = Task::spawn(gives_up());
    match (await doomed) {
        Result::Ok(_) => { return 1; }
        Result::Err(JoinError::Panicked(info)) => { libc::printf("awaited a panic: %s\n", info.msg); }
        Result::Err(JoinError::Cancelled) => { return 2; }
    }
    libc::printf("main carries on\n");
    return 0;
}
