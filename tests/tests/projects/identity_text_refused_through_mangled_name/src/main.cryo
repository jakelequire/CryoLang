/// A module of the compiler's own: a `MangledName` is a link symbol, the
/// text a definition is known by to the linker, and is never looked up by.
/// Its text compared with other text, used as a hash table's key, or handed
/// to a helper that compares it is refused where it is looked up.  Tested
/// for emptiness, measured, or handed on to be written out, it is not.
namespace compiler::resolver::mangled_name;

import std::collections::hashmap::{ HashMap };

type struct MangledName {
private:
    raw: string;
public:
    static new(s: string) -> MangledName { return MangledName { raw: s }; }
    as_string(&this) -> string { return this.raw; }
}

/// A link symbol compared with a literal.
function is_overflow(name: MangledName) -> i32 {
    if (name.as_string() == "__cryo_panic_overflow") { return 1; }
    return 0;
}

/// A link symbol as a hash table's key.
function seen(table: &HashMap<string, i32>, name: MangledName) -> i32 {
    if (table.contains_key(&name.as_string())) { return 1; }
    return 0;
}

/// A helper comparing what it is handed.
function is_main(text: string) -> i32 {
    if (text == "main") { return 2; }
    return 0;
}

/// A link symbol handed to that helper.
function through_helper(name: MangledName) -> i32 {
    return is_main(name.as_string());
}

/// A helper that only measures what it is handed.
function width(text: string) -> i32 {
    return text.length() as i32;
}

/// Tested for emptiness, measured, handed on to be measured.  Accepted.
function accepted(name: MangledName) -> i32 {
    mut n: i32 = name.as_string().length() as i32;
    if (name.as_string() == "") { n = n + 1; }
    return n + width(name.as_string());
}

function main() -> i32 {
    const m: MangledName = MangledName::new("main");
    mut table: HashMap<string, i32> = HashMap::<string, i32>::new();
    table.insert("main", 1);
    return is_overflow(m) + seen(&table, m) + through_helper(m) + accepted(m);
}
