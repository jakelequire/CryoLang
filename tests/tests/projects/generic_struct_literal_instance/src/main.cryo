namespace GenericStructLiteralInstance;

type struct Boxy<T> { v: T; }
type struct Pair<A, B> { a: A; b: B; }

function second<A, B>(p: Pair<A, B>) -> B { return p.b; }
function boxed_value(b: Boxy<i64>) -> i64 { return b.v; }

function main() -> i32 {
    const b: Boxy<i32> = Boxy { v: 3 };
    if (b.v != 3) { return 1; }
    const wide: Boxy<i64> = Boxy { v: 4000000000 };
    if (wide.v != 4000000000 as i64) { return 2; }
    if (boxed_value(Boxy { v: 7 }) != 7 as i64) { return 3; }
    if (second(Pair { a: 1, b: 5 }) != 5) { return 4; }
    const inner: Boxy<i32> = second(Pair { a: true, b: Boxy { v: 6 } });
    if (inner.v != 6) { return 5; }
    return 0;
}
