namespace ConstantWrapsToDeclaredType;

// Each constant's initializer leaves its declared type's range; the folded
// value is the one the program reads at run time, wrapped to that type.
const BASE: u8 = 100;
const WRAPPED_U8: u8 = BASE + 200;
const WRAPPED_I8: i8 = (BASE as i8) + 100;
const WRAPPED_U16: u16 = (WRAPPED_U8 as u16) * 2000;
const CHAIN: u8 = WRAPPED_U8 + 1;
const CODE: char = 65;
const HALF: f64 = (WRAPPED_U8 as f64) / 2.0;

implement u8 {
    const PAST_MAX: u8 = u8::MAX + BASE;
}

type struct Gauge {
    const LIMIT: u8 = BASE * 3;
    level: u8;
}

static_assert(WRAPPED_U8 == 44, "a u8 constant wraps");
static_assert(WRAPPED_I8 == -56, "an i8 constant wraps to a negative value");
static_assert(WRAPPED_U16 == 22464, "a u16 constant wraps");
static_assert(CHAIN == 45, "a constant built on a wrapped constant reads the wrapped value");
static_assert(u8::PAST_MAX == 99, "a primitive's constant wraps");
static_assert(Gauge::LIMIT == 44, "a struct's constant wraps");
static_assert((CODE as u32) == 65, "a char constant folds");
static_assert(((0x1_0000_0041 as char) as u32) == 65, "a cast to char wraps to 32 bits");

type struct Buffers {
    bytes: [u8; WRAPPED_U8];
}

function main() -> i32 {
    const local: [u8; WRAPPED_U8] = [1; Gauge::LIMIT];
    if (local.length != 44) { return 1; }
    if (WRAPPED_U8 != 44) { return 2; }
    if ((WRAPPED_I8 as i32) != -56) { return 3; }
    if (WRAPPED_U16 != 22464) { return 4; }
    if (CHAIN != 45) { return 5; }
    if (u8::PAST_MAX != 99) { return 6; }
    if (sizeof(Buffers) != 44) { return 7; }
    if (HALF != 22.0) { return 8; }
    return 0;
}
