namespace ImportAliasPathSubModule::Main;

import ImportAliasPathSubModule::Json as J;
import IapsmToml;

function take(p: J::Inner::Pt) -> i32 { return p.get(); }

// No file imports `Json::Inner`, `Json::Inner::Deeper` or `IapsmToml::Sub`:
// each is loaded because a path here names it.
function main() -> i32 {
    if (J::twice(3) != 6) { return 1; }
    if (J::Inner::deep() != 40) { return 2; }
    if (J::Inner::Deeper::bottom() != 9) { return 3; }
    const f: () -> i32 = J::Inner::deep;
    if (f() != 40) { return 4; }
    const p: J::Inner::Pt = J::Inner::Pt { v: 5 };
    if (take(p) != 5) { return 5; }
    if (J::Inner::Pt::make(8).get() != 8) { return 6; }
    const c: J::Inner::Color = J::Inner::Color::Blue;
    const n: i32 = match (c) {
        J::Inner::Color::Red  => { 1 }
        J::Inner::Color::Blue => { 2 }
    };
    if (n != 2) { return 7; }
    if (IapsmToml::one() + IapsmToml::Sub::three() != 4) { return 8; }
    return 0;
}
