namespace BoundCallNamesBoundMethod::Main;

// `W` has an inherent `equals` that always answers false and an `Eq` impl
// that compares: a call written on a type parameter bounded by `Eq` names
// `Eq::equals`, so each check below is true only when the trait's body ran.
type struct W { v: i32; }
implement struct W { equals(&this, other: &W) -> boolean { return false; } }
implement trait Eq for struct W { equals(&this, other: &W) -> boolean { return this.v == other.v; } }

type trait Keyed : Eq { key(&this) -> i32; }
implement trait Keyed for struct W { key(&this) -> i32 { return this.v; } }

/// The receiver is a parameter.
function on_param<T>(a: &T, b: &T) -> boolean where T: Eq {
    return a.equals(b);
}

/// The receiver is a local, not a parameter.
function on_local<T>(a: &T, b: &T) -> boolean where T: Eq {
    const first: &T = a;
    return first.equals(b);
}

/// The method is the bound's supertrait's.
function through_supertrait<T>(a: &T, b: &T) -> boolean where T: Keyed {
    return a.equals(b);
}

function main() -> i32 {
    const w: W = W { v: 1 };
    const same: W = W { v: 1 };
    const o: Option<W> = Option::Some(W { v: 1 });
    const r: Result<W, i32> = Result::Ok(W { v: 1 });
    if (!on_param::<W>(&w, &same)) { return 1; }
    if (!on_local::<W>(&w, &same)) { return 2; }
    if (!through_supertrait::<W>(&w, &same)) { return 3; }
    // `Option::contains` and `Result::contains` call `equals` under
    // `where T: Eq` in the standard library.
    if (!o.contains(&same)) { return 4; }
    if (!r.contains(&same)) { return 5; }
    return 0;
}
