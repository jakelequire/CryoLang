# bound_call_names_bound_method - a method call written on a type parameter
# bounded by a trait names the bound's method, and keeps naming it once the
# parameter is substituted: `W` below has an inherent `equals` beside its
# `Eq` impl, and every call made under `where T: Eq` (or a bound whose
# supertrait is `Eq`) runs `Eq::equals` - on a parameter, on a local, and
# inside the standard library's `Option::contains` and `Result::contains`.
# Generic code sees only its bounds, so an instantiation can neither
# redirect such a call to an inherent method nor make it ambiguous.  The
# exit code names the first check that reached the inherent body.
[project]
project_name = "bound_call_names_bound_method"
output_dir   = "build"
target_type  = "executable"
source_dir   = "src"
entry_point  = "src/main.cryo"
[compiler]
[dependencies]
