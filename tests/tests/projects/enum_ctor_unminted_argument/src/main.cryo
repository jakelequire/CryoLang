import std::collections::string;
import std::collections::string::{ String };

function main() -> i32 {
    const inline_len: u64 = match (Option::Some(String::from_string("hello"))) {
        Option::Some(s) => { s.length() }
        Option::None    => { 0 }
    };
    const o = Option::Some(String::from_string("hi"));
    const local_len: u64 = match (o) {
        Option::Some(s) => { s.length() }
        Option::None    => { 0 }
    };
    return (inline_len + local_len) as i32;
}
