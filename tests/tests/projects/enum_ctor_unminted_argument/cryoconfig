# enum_ctor_unminted_argument - a generic enum constructor with no expected
# type infers its instantiation from an argument that is an instantiation not
# yet minted (`String<GlobalAlloc>` before monomorphization), so the local it
# initializes and a pattern binding of its payload are typed before
# monomorphization (outcome = "run", exit 7: 5 + 2).
#
# The constructor kept the generic base `Option`: the unannotated local was
# refused (E0200 "expected `Option`, found `Option<String<GlobalAlloc>>`"), and
# a match on the inline constructor bound its payload as the template's `T`.

[project]
project_name = "enum_ctor_unminted_argument"
output_dir   = "build"
target_type  = "executable"
source_dir   = "src"
entry_point  = "src/main.cryo"

