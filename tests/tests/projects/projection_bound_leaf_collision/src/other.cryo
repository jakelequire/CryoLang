namespace projection_bound_leaf_collision::other;

import std::core::cmp;
import std::core::cmp::{ Eq, Ord, Ordering };

// Another module's `Rank`, and this one IS `Ord`.
public type struct Rank {
    y: i32;
}

implement trait Eq for Rank {
    equals(&this, other: &Rank) -> boolean { return this.y == other.y; }
}

implement trait Ord for Rank {
    compare(&this, other: &Rank) -> Ordering {
        if (this.y < other.y) { return Ordering::Less; }
        if (this.y > other.y) { return Ordering::Greater; }
        return Ordering::Equal;
    }
}
