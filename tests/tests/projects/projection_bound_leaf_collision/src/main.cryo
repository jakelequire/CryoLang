namespace projection_bound_leaf_collision;

import std::core::option;
import std::core::option::{ Option };
import std::core::iter;
import projection_bound_leaf_collision::other;

// This module's `Rank` implements nothing; `other`'s same-leaf `Rank` is `Ord`.
// `Iterator::min` is bounded `where This::Item: Ord`, so `.min()` on an
// iterator of THIS `Rank` has no method: E0358 at the call.
type struct Rank {
    x: i32;
}

type struct Ranks {
    i: i32;
    static make() -> Ranks { return Ranks { i: 0 }; }
}

implement trait Iterator<Rank> for struct Ranks {
    next(mut &this) -> Option<Rank> {
        if (this.i >= 3) { return Option::None; }
        this.i = this.i + 1;
        return Option::Some(Rank { x: 50 - this.i * 3 });
    }
}

function main() -> i32 {
    mut it: Ranks = Ranks::make();
    const m: Option<Rank> = it.min();
    return match (m) {
        Option::Some(r) => { r.x + 1 }
        Option::None    => { 0 }
    };
}
