# projection_bound_leaf_collision - two modules declare a same-leaf `Rank`;
# only the other module's implements `Ord`.  `Iterator::min` is bounded
# `where This::Item: Ord`, and the consumer calls `.min()` on an iterator of
# ITS OWN `Rank`, which is not `Ord`.
#
# The projection-bound check asked the trait table by the Item's WRITTEN
# leaf, `Rank`, which lists every module's `Rank`: the default was
# synthesized for the impl and the call admitted, and the failure surfaced
# inside `stdlib/core/iter.cryo` as two E0358s blaming `compare`.
#
# The Item's stamp names this module's `Rank`, which implements nothing:
# E0358 at the call, in this file.

[project]
project_name = "projection_bound_leaf_collision"
output_dir   = "build"
target_type  = "executable"
source_dir   = "src"
entry_point  = "src/main.cryo"

