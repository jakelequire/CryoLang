namespace generic_struct_allocate_instance;
import std::ffi::libc;

// `Allocate` implemented for a generic struct serves every instance's `new`
// and `delete`: each `new Cell<..> { .. }` calls the instance's `allocate`,
// each `delete` its `release`, and the program links.  A `new Cell { .. }`
// with no arguments written allocates the instance its expected type or its
// field values bind.

mut allocations: i32 = 0;
mut releases: i32 = 0;

type struct Cell<T> {
    v: T;
}

implement<T> trait Allocate for struct Cell<T> {
    static allocate(size: u64, align: u64) -> void* {
        allocations = allocations + 1;
        return libc::malloc(size) as void*;
    }
    static release(ptr: void*, align: u64) -> void {
        releases = releases + 1;
        libc::free(ptr as u8*);
    }
}

function main() -> i32 {
    const a: Cell<i32>* = new Cell<i32> { v: 3 };
    const b: Cell<i64>* = new Cell<i64> { v: 4 };
    const c: Cell<i64>* = new Cell { v: 5 };
    const wide: i64 = 7000000000;
    const d = new Cell { v: wide };
    const s: i64 = (a.v as i64) + b.v + c.v + (d.v - wide);
    if (allocations != 4) { return 1; }
    delete a;
    delete b;
    delete c;
    delete d;
    if (releases != 4) { return 2; }
    return s as i32;
}
