namespace ClosureFieldCalledThroughField;

// A closure held in a field of a concrete instantiation is called through
// the field, `h.f()`, as a function value held in a field is.

type struct Holder<F> where F: () -> i32 {
    f: F;
    run(&this) -> i32 { return this.f(); }
}

type struct Adder<F> where F: (i32) -> i32 {
    add: F;
}

function hold<F>(f: F) -> Holder<F> where F: () -> i32 { return Holder::<F> { f: f }; }
function adder<F>(add: F) -> Adder<F> where F: (i32) -> i32 { return Adder::<F> { add: add }; }

function main() -> i32 {
    const k: i32 = 9;
    const h = hold(() -> i32 { return k; });
    if (h.run() != 9) { return 1; }
    if (h.f() != 9) { return 2; }
    const step: i32 = 5;
    const a = adder((x: i32) -> i32 { return x + step; });
    if (a.add(10) != 15) { return 3; }
    const r = &a;
    if (r.add(2) != 7) { return 4; }
    return 0;
}
