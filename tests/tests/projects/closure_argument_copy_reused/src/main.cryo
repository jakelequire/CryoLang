namespace ClosureArgumentCopyReused::Main;

import std::ffi::libc;

// A function passed a capturing closure is copied for that closure's type,
// once: a second call passing the same closure is pinned to the same copy,
// and a call passing another closure gets a copy of its own.
function apply(f: (i32) -> i32, x: i32) -> i32 { return f(x); }

function main() -> i32 {
    const bias: i32 = 10;
    const scale: i32 = 3;
    const add = (x: i32) -> i32 { return x + bias; };
    const mul = (x: i32) -> i32 { return x * scale; };
    const a: i32 = apply(add, 1);   // 11
    const b: i32 = apply(mul, 2);   // 6
    const c: i32 = apply(add, 5);   // 15: the copy made for `add` again
    libc::printf("apply %d %d %d\n", a, b, c);
    if (a != 11 || b != 6 || c != 15) { return 1; }
    return 0;
}
