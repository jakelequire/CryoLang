# spelling_lint_refuses_unallowed - a declaration taking a spelling type with
# no `![allow(lookup_by_spelling, reason = "...")]` is refused
# (outcome = "compile_fail").
#
# The compiler knows its spelling types by the qualified names its own
# declarations give them; this program declares a `SymbolStr` and a
# `QualifiedName` at those names, and five functions take them.  Accepted,
# the program built and returned 6.

[project]
project_name = "spelling_lint_refuses_unallowed"
output_dir   = "build"
target_type  = "executable"
source_dir   = "src"
entry_point  = "src/main.cryo"

