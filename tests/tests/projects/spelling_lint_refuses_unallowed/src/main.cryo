/// A declaration taking one of the compiler's spelling types, with nothing
/// saying why, is refused at each such parameter: by value, behind a
/// reference, as an array's element, and a `QualifiedName`.  The spelling
/// types are known to the compiler by the qualified names its own
/// declarations give them, so this program declares types at those names.
namespace compiler::resolver::symbol_str;

import compiler::resolver::qualified_name::{ QualifiedName };

type struct SymbolStr {
    id: u32;

    /// A receiver is the method's owner, not a spelling it was handed: not
    /// refused.
    is_empty(&this) -> boolean {
        return this.id == 0;
    }

    /// `other` is a spelling handed to a method: refused.
    equals(&this, other: SymbolStr) -> boolean {
        return this.id == other.id;
    }
}

type struct Decl {
    n: i32;
}

function find_leaf(name: SymbolStr) -> Decl {
    return Decl { n: name.id as i32 };
}

function find_by_ref(name: &SymbolStr) -> Decl {
    return Decl { n: name.id as i32 };
}

function find_path(segments: SymbolStr[]) -> Decl {
    return Decl { n: segments.length as i32 };
}

function find_qualified(path: QualifiedName) -> Decl {
    return Decl { n: path.depth };
}

/// Takes no spelling: not refused.
function count(n: i32) -> i32 {
    return n + 1;
}

function main() -> i32 {
    const s: SymbolStr = SymbolStr { id: 3 };
    const q: QualifiedName = QualifiedName { depth: 2 };
    return find_leaf(s).n + find_qualified(q).n + count(0);
}
