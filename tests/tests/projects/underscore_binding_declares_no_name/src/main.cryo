///! A local named `_` declares no name: a block may hold any number of them,
///! each keeps its value to the end of its block like any other local, and
///! they are released in reverse order of declaration.

namespace Main;

mut g_order: i64 = 0;

type struct Tracked {
    label: i64;
}

implement trait Drop for struct Tracked {
    drop(mut &this) -> void { g_order = g_order * 10 + this.label; }
}

function seven() -> i64 { return 7; }

function many_underscores_share_one_block() -> i64 {
    const _ = seven();
    const _ = seven();
    const _: i64 = 8;
    mut _: i64 = 9;
    return seven();
}

function main() -> int {
    if (many_underscores_share_one_block() != 7) { return 1; }
    {
        const _ = Tracked { label: 1 };
        const _ = Tracked { label: 2 };
        {
            const _ = Tracked { label: 3 };
        }
        // The inner one is released first; these two are still held here.
        if (g_order != 3) { return 2; }
    }
    if (g_order != 321) { return 3; }
    return 0;
}
