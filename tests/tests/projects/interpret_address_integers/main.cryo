// `cryo interpret` runs an address cast to an integer as its byte offset in
// its allocation, the integer keeping the allocation it came from
// (tools/CryoSmith/INTERPRETER.md section 4.1).  What this program reads of
// such integers - distances, alignment below the allocation's own, equality,
// order, a round trip back to an address - depends only on offsets, so the
// compiled program prints the same lines.

namespace Main;

import std::fmt;

type struct Record {
    tag:    u8;
    count:  u64;
    weight: u16;
    marks:  [u32; 3];
}

function main() -> i32 {
    const values: [i64; 4] = [10, 20, 30, 40];
    const first: u64 = &values[0] as u64;
    const third: u64 = &values[2] as u64;
    const back: i64* = (first + 24) as i64*;
    mut cursor: u64 = first;
    cursor += 8;
    const second: i64 = *(cursor as i64*);
    fmt::println(f"array: {third - first} {*back} {second} {first - third}");

    const record: Record = Record { tag: 1, count: 2, weight: 3, marks: [4, 5, 6] };
    const start: u64 = &record as u64;
    const count_at: u64 = (&record.count as u64) - start;
    const weight_at: u64 = (&record.weight as u64) - start;
    const mark_at: u64 = (&record.marks[2] as u64) - start;
    const mark: u32 = *((start + mark_at) as u32*);
    fmt::println(f"fields: {count_at} {weight_at} {mark_at} {mark}");

    const aligned: u64 = start % 8;
    const masked: u64 = (&record.weight as u64) & 7;
    const quarter: u64 = (&record.marks[1] as u64) & 3;
    fmt::println(f"alignment: {aligned} {masked} {quarter}");

    const text: string = "abcdef";
    const letter: u8 = *(((text as u64) + 3) as u8*);
    fmt::println(f"text: {letter}");

    const same: boolean = first == (&values[0] as u64);
    const apart: boolean = first != start;
    const present: boolean = first != 0;
    const ordered: boolean = first < third && third >= first && !(third <= first);
    const null_pointer: i64* = null;
    const null_value: u64 = null_pointer as u64;
    fmt::println(f"compare: {same} {apart} {present} {ordered} {null_value}");
    return 0;
}
