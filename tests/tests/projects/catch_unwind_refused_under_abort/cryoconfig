# catch_unwind_refused_under_abort - built, and the build must FAIL
# (outcome = "build" + diagnostic).  `catch_unwind` in a program built with the
# abort strategy is refused with E0600, whose message names the strategy the
# build chose and does not call it the default: a hosted build unwinds unless
# it asks to abort.

[project]
project_name = "catch_unwind_refused_under_abort"
output_dir   = "build"
target_type  = "executable"
source_dir   = "src"
entry_point  = "src/main.cryo"

[compiler]
panic = "abort"

[dependencies]
