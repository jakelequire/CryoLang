/// A program built with `panic = "abort"` that calls `catch_unwind`: there is
/// no unwind for it to catch, so the build is refused.
namespace CatchUnwindRefusedUnderAbort;

import std::core::panic_unwind::{ catch_unwind, PanicInfo };
import std::core::result::{ Result };

function main() -> int {
    const outcome: Result<i32, PanicInfo> = catch_unwind(() -> i32 { return 7; });
    return match (outcome) {
        Result::Ok(v)  => { v }
        Result::Err(e) => { 1 }
    };
}
