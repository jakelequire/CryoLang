namespace AliasReturnOperator;

import AliasReturnOperator::weights::{ Weight, heavier };

type Count = i64;
type Tally = Count;

function one() -> Count { return 1; }
function two() -> Tally { return 2; }

function add_to(c: Count, n: i64) -> i64 { return c + n; }

function main() -> i32 {
    if (one() + 1 != 2) { return 1; }
    if (two() * 3 != 6) { return 2; }
    if (add_to(4, 5) != 9) { return 3; }
    if (heavier(3) - 1 != 12) { return 4; }
    if (one() >= two()) { return 5; }
    return 0;
}
