// `cryo interpret --dev` interprets the program as the `debug` profile
// builds it: an increment past `u8::MAX` panics with the message the
// compiled program reports, after the wrapping method has wrapped and the
// last in-range sum has been printed.

namespace Main;

import std::fmt;

function keep(value: u8) -> u8 {
    return value;
}

function main() -> i32 {
    const top: u8 = keep(255);
    fmt::println(f"wrapped {top.wrapping_add(1)}");
    mut x: u8 = keep(254);
    x += 1;
    fmt::println(f"at the edge {x}");
    x++;
    fmt::println("past the edge");
    return 0;
}
