namespace GenericReceiverByType::G;

import GenericReceiverByType::B::{ Point };

type struct Box2<T> { v: T; }

type struct Wrapper<T> { val: T; }

implement struct Wrapper<T> {
    get(&this) -> T { return this.val; }
    // Written for B's `Point` only: it reads a field A's `Point` does not
    // have, so it must not be specialized for `Wrapper<A::Point>`, whose
    // argument prints as `...::A::Point` and shares the leaf.
    only_b(this: &Wrapper<Point>) -> i64 { return this.val.y; }
    only_i32(this: &Wrapper<i32>) -> i32 { return this.val + 1; }
    only_boxed(this: &Wrapper<Box2<i32>>) -> i32 { return this.val.v; }
}
