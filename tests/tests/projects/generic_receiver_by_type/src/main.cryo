/// A method whose receiver is written as one instantiation of its generic
/// owner is specialized for exactly the owner instantiations that are that
/// type: not for another type sharing the argument's last path segment,
/// and for every argument shape - a primitive, a generic - not only a name.
namespace GenericReceiverByType::Main;

import GenericReceiverByType::A;
import GenericReceiverByType::G::{ Box2, Wrapper };

function main() -> i32 {
    const a: Wrapper<A::Point> = Wrapper::<A::Point> { val: A::make(7) };
    const n: Wrapper<i32> = Wrapper::<i32> { val: 6 };
    const b: Wrapper<Box2<i32>> = Wrapper::<Box2<i32>> { val: Box2::<i32> { v: 5 } };
    return a.get().x + n.only_i32() + b.only_boxed();
}
