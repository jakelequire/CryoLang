namespace ReferenceImplementations;

// An implementation for references gives a reference its methods.  A
// receiver of type `&X` finds `X`'s own methods first - those an
// implementation for references gives `X` when `X` is a reference - and
// only then looks through the reference.  Each body here differs from its
// referent's, so a call that reached the wrong one returns the wrong number.

type trait Describe { describe(&this) -> i64; }
implement trait Describe for i64 { describe(&this) -> i64 { return *this; } }
implement<T> trait Describe for &T where T: Describe {
    describe(&this) -> i64 { return 100 + (*this).describe(); }
}

// `this.label()` in the body is the bound's call on `T`, the referent.
type trait Label { label(&this) -> i64; }
implement trait Label for i64 { label(&this) -> i64 { return *this; } }
implement<T> trait Label for &T where T: Label {
    label(&this) -> i64 { return 1000 + this.label(); }
}

// A head for every type may have receiver methods.
type trait Twice { twice(&this) -> i64; }
implement<T> trait Twice for T where T: Describe {
    twice(&this) -> i64 { return this.describe() * 2; }
}

function through<D>(value: &D) -> i64 where D: Describe { return value.describe(); }
function by_value<D>(value: D) -> i64 where D: Describe { return value.describe(); }
function labelled<L>(value: &L) -> i64 where L: Label { return value.label(); }

function main() -> i32 {
    const x: i64 = 5;
    const r: &i64 = &x;
    const rr: & &i64 = &r;
    if (x.describe() != 5) { return 1; }
    // `&i64` steps to `i64`, which has a `describe` of its own.
    if (r.describe() != 5) { return 2; }
    // `& &i64` steps to `&i64`, which the implementation for references gives one.
    if (rr.describe() != 105) { return 3; }
    if (through(&x) != 5) { return 4; }
    // The bound is met by `&i64`, and the call is `&i64`'s, not `i64`'s.
    if (through(&r) != 105) { return 5; }
    if (by_value(x) != 5) { return 6; }
    if (by_value(r) != 105) { return 7; }
    if (rr.label() != 1005) { return 8; }
    if (labelled(&r) != 1005) { return 9; }
    const rrr: & & &i64 = &rr;
    if (rrr.describe() != 205) { return 10; }
    return 0;
}
