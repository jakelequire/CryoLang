namespace ReadOnlyPointerToPointer::Main;

/// The C shape `const char* const*`: nothing reached through `lines` is
/// written, neither the pointers nor the bytes.
function total_length(lines: const (const u8*)*, count: i64) -> i64 {
    mut total: i64 = 0;
    for (mut i: i64 = 0; i < count; i++) {
        const line: const u8* = lines[i];
        mut j: i64 = 0;
        while (line[j] != 0) { j++; }
        total += j;
    }
    return total;
}

/// The pointers are read-only; what they point at is not.
function first_slot(slots: const (u8*)*) -> u8* {
    return *slots;
}

/// A type spelled with the group names the same type in every position.
type struct Lines {
    at:    const (const u8*)*;
    count: i64;
}

function main() -> i32 {
    mut first: [u8; 3] = [97, 98, 0];
    mut second: [u8; 4] = [99, 100, 101, 0];
    mut slots: [u8*] = [&first[0], &second[0]];

    // A writable pointer to writable pointers converts to either form.
    if (total_length(&slots[0], 2) != 5) { return 1; }
    const writable_bytes: u8* = first_slot(&slots[0]);
    writable_bytes[0] = 120;
    if (first[0] != 120) { return 2; }

    // Stored, read back, and cast to the form a C interface that forgets
    // `const` would take.
    const lines: Lines = Lines { at: &slots[0], count: 2 };
    if (total_length(lines.at, lines.count) != 5) { return 3; }
    const cast_back: u8** = lines.at as u8**;
    if (cast_back[1][0] != 99) { return 4; }
    const regrouped: const (const u8*)* = cast_back as const (const u8*)*;
    if (total_length(regrouped, 1) != 2) { return 5; }
    return 0;
}
