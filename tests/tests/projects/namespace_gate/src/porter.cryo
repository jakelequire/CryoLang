/// CONTROLS. Both reach `Crate` legally and must compile silently.
///
/// They matter because a reachability gate fails in two directions, and only
/// one of them is loud. `test.json` excludes this module's names from the
/// output: a gate that rejects these is broken in the direction that actually
/// costs -- false positives on correct code, which is what reverted the
/// visibility gate on its first attempt.
namespace NamespaceGate::Porter;

import NamespaceGate::Depot;

/// CONTROL 1 -- the bare name, reachable through an import.
function carry<T>(v: T) -> Crate<T> {
    return Crate<T> { v: v };
}

/// CONTROL 2 -- the fully qualified path, which needs no import at all.
function haul<T>(v: T) -> NamespaceGate::Depot::Crate<T> {
    return NamespaceGate::Depot::Crate<T> { v: v };
}
