/// Declares `Crate`, the type `Orphan` names without importing.
///
/// Kept in its own module with no re-export: the ONLY way `Orphan`'s bare
/// `Crate` could resolve is a program-wide search that ignores scope, which
/// is exactly what E0240 exists to reject.
namespace NamespaceGate::Depot;

type struct Crate<T> {
    v: T;

    unwrap(&this) -> T { return this.v; }
}
