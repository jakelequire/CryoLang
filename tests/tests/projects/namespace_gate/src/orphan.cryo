/// ================= THE REACHABILITY GATE, PINNED =======================
///
/// Spec §5.1: "The first segment resolves in scope. There is no substring
/// matching, no suffix matching, and no dependence on what other modules
/// happen to exist in the program."
///
/// This module has NO `import` statement at all and names `Crate`, which only
/// `NamespaceGate::Depot` declares. Nothing binds it here, so it must be an
/// error -- and before the gate landed it resolved anyway, because the
/// single-candidate fast path answered `Unique` without ever consulting the
/// use site (docs/name-resolution.md §1).
///
/// E0240 rather than E0203: the name EXISTS, it is simply not reachable, and
/// only that condition has a fix to suggest. `test.json` requires the
/// declaring module in the output for exactly that reason -- an E0240 that
/// cannot name where the type lives is not doing the job that justified a
/// separate code.
///
/// IF THIS PROJECT STARTS BUILDING: the gate reopened. Do not relax
/// `test.json`.
///
/// =======================================================================
namespace NamespaceGate::Orphan;

/// Both arms are here because sema binds them through different functions:
/// the static template through `find_static_method_template`, the free
/// function through `check_generic_free_call`. Shutting one door is
/// indistinguishable from shutting both unless each is named and observed.
type struct Packer {
    /// Static generic method returning a type this module cannot see.
    /// Reported as E0240 where `Crate` is written, like the free-function
    /// arm; `test.json` pins both spans.  The call to it in `main.cryo` is
    /// still reported as E0233 afterwards: a function whose signature was
    /// refused is not registered, and the type layer has no error answer
    /// that would let its callers stay silent.
    static pack<T>(v: T) -> Crate<T> {
        return Crate<T> { v: v };
    }
}

/// Free function returning a type this module cannot see. Reported as E0240.
function box_up<T>(v: T) -> Crate<T> {
    return Crate<T> { v: v };
}
