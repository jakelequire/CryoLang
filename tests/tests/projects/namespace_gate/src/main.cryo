/// Entry point. Module discovery is import-driven, so a module nothing
/// imports is never compiled and would silently exercise nothing -- both
/// `Orphan` and `Porter` have to be reached from here for this project to
/// assert anything at all.
namespace NamespaceGate::Main;

import NamespaceGate::Orphan;
import NamespaceGate::Porter;

function main() -> int {
    const boxed:  Crate<i32> = NamespaceGate::Orphan::box_up(1);
    const packed: Crate<i32> = NamespaceGate::Orphan::Packer::pack(4);
    const ported: Crate<i32> = NamespaceGate::Porter::carry(2);
    const hauled: Crate<i32> = NamespaceGate::Porter::haul(3);
    return (boxed.unwrap() + packed.unwrap()
            + ported.unwrap() + hauled.unwrap()) as int;
}
