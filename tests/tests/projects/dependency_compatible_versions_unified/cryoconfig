# dependency_compatible_versions_unified - the program takes gauge 1.2.0 and
# accepts 1.2 and later, and its dependency dial takes gauge 1.5.0 and accepts
# 1.5 and later. Both requirements accept 1.5.0, so the build holds that one
# version of gauge, for the program and for dial alike.
[project]
project_name = "dependency_compatible_versions_unified"
output_dir   = "build"
target_type  = "executable"
source_dir   = "src"
entry_point  = "src/main.cryo"

[compiler]

[dependencies]
gauge = { git = "{fixture:gauge}", tag = "v1.2.0", version = "1.2" }
dial  = { path = "packages/dial" }
