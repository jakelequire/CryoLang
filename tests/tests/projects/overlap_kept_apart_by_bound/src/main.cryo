namespace OverlapKeptApartByBound;

// `Convert<E> for Report where E: Fault` beside `Convert<T> for T` meet
// only at `Convert<Report> for Report`, which needs `Report: Fault`.
// `Report` is no `Fault`, so the two do not overlap: a fault converts
// through the first, and a report through the second, unchanged.

type trait Convert<S> { static convert(source: S) -> This; }
implement<T> trait Convert<T> for T { static convert(source: T) -> T { return source; } }

type trait Fault { code(&this) -> i64; }

type struct Report { code: i64; }
implement<E> trait Convert<E> for struct Report where E: Fault {
    static convert(source: E) -> Report { return Report { code: source.code() + 100 }; }
}

type struct Disk { unit: i64; }
implement trait Fault for struct Disk { code(&this) -> i64 { return this.unit; } }

// The shape `?` converts an error through.
function lift<F, E>(source: E) -> F where F: Convert<E> { return F::convert(source); }

function main() -> i32 {
    const from_fault: Report = lift::<Report, Disk>(Disk { unit: 7 });
    if (from_fault.code != 107) { return 1; }
    const unchanged: Report = lift::<Report, Report>(Report { code: 3 });
    if (unchanged.code != 3) { return 2; }
    return 0;
}
