{
  "outcome": "command",
  "requires": ["git"],
  "git_fixtures": [
    { "name": "gauge", "from": "fixtures/gauge",
      "commits": [ { "tree": "v1.0.0", "tag": "v1.0.0" },
                   { "tree": "v2.0.0", "tag": "v2.0.0" } ] }
  ],
  "command": ["fetch"],
  "expect": {
    "fails": true,
    "stderr_contains": [
      "error: the program needs more than one major version of `gauge` (",
      "), and a build holds one version of each library",
      "  note: `meter` 0.1.0 asks for version 1: ",
      "writes `gauge = { git = \"file://",
      "\", tag = \"v1.0.0\" }`, which names gauge 1.0.0",
      "  note: `dial` 0.1.0 asks for version 2: ",
      "\", tag = \"v2.0.0\" }`, which names gauge 2.0.0",
      "  help: `meter` 0.1.0 asks for another version; a version of it whose cryoconfig writes `gauge = { git = \"file://",
      "\", tag = \"v2.0.0\", version = \"2\" }` builds with gauge 2.0.0"
    ],
    "stderr_excludes": ["help: `dial`", "E0507"]
  }
}
