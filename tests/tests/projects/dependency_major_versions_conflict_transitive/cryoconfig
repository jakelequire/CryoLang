# dependency_major_versions_conflict_transitive - the program depends on
# meter and dial, and they depend on gauge at two major versions (1.0.0 and
# 2.0.0). A build holds one version of each library, so `cryo fetch` refuses
# it, naming who asks for which, and shows the entry a version of meter would
# write to build with gauge 2.
[project]
project_name = "dependency_major_versions_conflict_transitive"
output_dir   = "build"
target_type  = "executable"
source_dir   = "src"
entry_point  = "src/main.cryo"

[compiler]

[dependencies]
meter = { path = "packages/meter" }
dial  = { path = "packages/dial" }
