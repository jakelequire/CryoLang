/// A METHOD's where-clause written on its implement block's own parameter
/// (`U`) is checked against the argument the head binds `U` to.  For
/// `Wrap<Plain>` the bound fails, so `twice` is not a method of it - and its
/// body, which calls `show` on a `Plain`, is never compiled.  Nothing calls it.
namespace ImplMethodBoundThroughHead::Main;

type trait Show {
    show(&this) -> i32;
}

type trait Twice {
    twice(&this) -> i32;
}

type struct Plain {
    v: i32;
}

type struct Num {
    v: i32;
}

implement trait Show for struct Num {
    show(&this) -> i32 { return this.v; }
}

type struct Wrap<T> {
    inner: T;
}

implement<U> trait Twice for struct Wrap<U> {
    twice(&this) -> i32 where U: Show { return this.inner.show() * 2; }
}

function main() -> int {
    const p: Wrap<Plain> = Wrap::<Plain> { inner: Plain { v: 3 } };
    const n: Wrap<Num> = Wrap::<Num> { inner: Num { v: 2 } };
    return p.inner.v + n.twice();
}
