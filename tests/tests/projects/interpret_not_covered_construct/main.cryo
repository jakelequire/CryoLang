// `cryo interpret` names a construct it does not run yet, with exit 71,
// rather than running past it.

namespace Main;

import std::fmt;

function main() -> i32 {
    const n: i32 = 2;
    match (n) {
        0..=3 => { fmt::println("small"); }
        _ => { fmt::println("large"); }
    }
    return 0;
}
