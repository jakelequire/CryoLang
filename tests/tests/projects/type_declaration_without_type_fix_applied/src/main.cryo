namespace TypeDeclarationWithoutTypeFix;

type trait Bump {
    bump(mut &this) -> void;
}

type struct Counter {
    count: i64;
}

implement trait Bump for struct Counter {
    bump(mut &this) -> void {
        this.count += 1;
    }
}

function main() -> i32 {
    mut counter: Counter = Counter { count: 0 };
    counter.bump();
    if (counter.count != 1) { return 1; }
    return 0;
}
