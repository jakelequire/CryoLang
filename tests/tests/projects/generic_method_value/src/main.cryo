namespace GenericMethodValue;

type struct Box { v: i32; }
implement struct Box {
    static wrap<T>(x: T) -> T { return x; }
    static pair<A, B>(a: A, b: B) -> B { return b; }
    scale<T>(&this, x: T) -> T { return x; }
    static sized<T>() -> u64 { return sizeof(T); }
}

function apply(f: (i64) -> i64, x: i64) -> i64 { return f(x); }

function through<T>(x: T) -> T {
    const f: (T) -> T = Box::wrap::<T>;
    const g: (T) -> T = Box::wrap;
    return g(f(x));
}

function main() -> i32 {
    // The turbofish names the instance; the expected type binds it alone.
    const f: (i32) -> i32 = Box::wrap::<i32>;
    if (f(5) != 5) { return 1; }
    const g: (u8) -> u8 = Box::wrap;
    if (g(7) != 7) { return 2; }
    // A function-typed parameter is an expected type.
    if (apply(Box::wrap, 9) != 9) { return 3; }
    // Two type parameters.
    const p: (i32, i64) -> i64 = Box::pair::<i32, i64>;
    if (p(1, 2) != 2) { return 4; }
    // A method with a receiver takes it first.
    const b: Box = Box { v: 3 };
    const s: (&Box, i32) -> i32 = Box::scale::<i32>;
    if (s(&b, 6) != 6) { return 5; }
    // A type parameter the signature never names: two instances, two bodies.
    const z: () -> u64 = Box::sized::<i64>;
    const z2: () -> u64 = Box::sized::<u16>;
    if (z() != 8) { return 6; }
    if (z2() != 2) { return 7; }
    // Inside a generic body, for the body's own parameter.
    if (through::<i32>(4) != 4) { return 8; }
    if (through::<u64>(8) != 8) { return 9; }
    return 0;
}
