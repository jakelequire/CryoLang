///! C++ direct-mangled-binding integration test (Compiler::Bindgen Strategy A).
///! The `CppLink` module (bindings/CppLink.cryo) binds a C++ namespace function
///! and a class's non-virtual / static methods to their Itanium-mangled symbols
///! via `![symbol("...")]`; this module calls them ACROSS the module boundary,
///! linking against `tests/helpers/libcpplinkhelper.a` (g++-compiled).  It guards
///! the compiler's cross-module link-name propagation - the mechanism that makes
///! `import vendor::<CppLib>` resolve a foreign mangled symbol from user code.

![config(testing)]
namespace FfiCppLink::CppLinkTest;

import CppLink;
import std::core::result;
import std::test::error;
import std::test::assert;

// A C++ `namespace` free function bound by its mangled symbol, called from
// another module: `cpplink::add(2,3)` == 5.
![test]
function cpp_link_namespace_function() -> Result<(), TestError> {
    expect_eq(CppLink::add(2 as i32, 3 as i32), 5 as i32)?;
    return Result::Ok(());
}

// A non-virtual C++ method bound as a REAL Cryo method (`![symbol]` on a method),
// called cross-module: `Counter{41}.get()` returns 41 through the mangled
// `_ZNK7Counter3getEv` (the `&this` receiver is the Itanium implicit `this`).
![test]
function cpp_link_instance_method() -> Result<(), TestError> {
    const c: CppLink::Counter = CppLink::Counter { v: 41 as i32 };
    expect_eq(c.get(), 41 as i32)?;
    return Result::Ok(());
}

// A static C++ member function bound as a Cryo static method, called
// cross-module: `Counter::origin()` returns 100.
![test]
function cpp_link_static_method() -> Result<(), TestError> {
    expect_eq(CppLink::Counter::origin(), 100 as i32)?;
    return Result::Ok(());
}
