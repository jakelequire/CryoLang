/// Hand-written stand-in for what `cryo vendor` (binding_source "cxx-headers")
/// emits for `tests/helpers/cpp_link_helper.hpp`: a layout-faithful struct, an
/// `implement` block whose methods are pinned to their Itanium-mangled C++
/// symbols, and an `extern "C"` namespace function - all via `![symbol("...")]`.
///
/// It lives in its OWN module so the test (a separate module) calls these across
/// a module boundary, which is what the C++ binding generator relies on: the
/// `![symbol]` override must propagate through TypeResolution/DI/sema so a
/// CONSUMING module emits the foreign mangled symbol, not the bare Cryo name.
namespace CppLink;

![repr(C)]
type struct Counter {
    v: i32;
}

implement Counter {
    ![symbol("_ZNK7Counter3getEv")]
    public get(&this) -> i32;

    ![symbol("_ZN7Counter6originEv")]
    public static origin() -> i32;
}

extern "C" {
    ![symbol("_ZN7cpplink3addEii")]
    function add(a: i32, b: i32) -> i32;
}
