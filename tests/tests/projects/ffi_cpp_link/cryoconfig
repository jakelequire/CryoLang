# ffi_cpp_link - the C++ direct-mangled-binding exemplar (Compiler::Bindgen
# Strategy A).  The `CppLink` bindings (bindings/CppLink.cryo, added via
# `source_paths`) pin a C++ namespace function and class methods to their
# Itanium-mangled symbols with `![link("...")]`; the project's `![test]`s (under
# tests/) call them from another module and assert.  Linking resolves those
# symbols against `tests/helpers/libcpplinkhelper.a`, which the Makefile builds
# with g++ before the project suite runs (`-lstdc++` pulls in the C++ runtime).
#
# The static path is relative to THIS project dir (the projects runner chdir's
# in before building): ../../../helpers -> <repo>/tests/helpers.

[project]
project_name = "ffi_cpp_link"
output_dir   = "build"
target_type  = "executable"
source_dir   = "src"
source_paths = ["bindings"]
entry_point  = "src/main.cryo"

[compiler]

[dependencies]

[link]
static = ["../../../helpers/libcpplinkhelper.a"]
system = ["stdc++"]
