namespace bare_literal_takes_defaults;

// A bare struct literal of a generic type whose parameters all have
// defaults is the default instantiation, inside the type's own body as
// anywhere else: in `Holder<A>`'s methods `Holder { .. }` is a
// `Holder<Plain>`, the same as a bare `Holder` in a signature, and its
// fields are that instantiation's.  The owner's own literal names its
// argument (`Holder::<A> { .. }`).

type struct Plain {
    tag: i32;

    static new() -> Plain {
        return Plain { tag: 7 };
    }
}

type struct Other { tag: i32; }

type struct Store<A> { item: A; }

type struct Holder<A = Plain> {
    store: Store<A>;
    count: i32;

    static fresh() -> Holder {
        return Holder { store: Store::<Plain> { item: Plain::new() }, count: 1 };
    }

    static with(item: A) -> Holder<A> {
        return Holder::<A> { store: Store::<A> { item: item }, count: 2 };
    }
}

function main() -> int {
    const fresh: Holder<Plain> = Holder::fresh();
    if (fresh.count != 1 || fresh.store.item.tag != 7) { return 1; }
    const other: Holder<Other> = Holder::<Other>::with(Other { tag: 3 });
    if (other.count != 2 || other.store.item.tag != 3) { return 2; }
    return 0;
}
