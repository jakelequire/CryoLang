namespace Main;

import std::core::iter::{ Iterator };

// A field typed by a projection of the owner's parameter.
type struct Ahead<I> where I: Iterator {
    inner: I;
    peeked: Option<I::Item>;
    has_peeked: boolean;
}

implement<I> trait Iterator<I::Item> for struct Ahead<I>
where I: Iterator {
    next(mut &this) -> Option<I::Item> {
        if (this.has_peeked) {
            this.has_peeked = false;
            return this.peeked.take();
        }
        return this.inner.next();
    }
}

function main() -> i32 {
    // The literal written where `I` is concrete, its type annotated.
    mut ahead: Ahead<Range<i64>> = Ahead { inner: 0..10, peeked: Option::None, has_peeked: false };
    if (ahead.next().unwrap() != 0) { return 1; }

    // With an element already held, the field's value typed by the field.
    const range: Range<i64> = 3..10;
    mut held: Ahead<Range<i64>> = Ahead { inner: range, peeked: Option::Some(2), has_peeked: true };
    if (held.next().unwrap() != 2) { return 2; }
    if (held.next().unwrap() != 3) { return 3; }
    const field: Option<i64> = held.peeked;
    if (field.is_some()) { return 4; }
    return 0;
}
