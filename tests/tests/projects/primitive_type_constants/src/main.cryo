namespace PrimitiveTypeConstants;

type Int = i32;

static_assert(u64::MAX == 18446744073709551615, "u64::MAX is 2^64 - 1");
static_assert(i64::MIN == -9223372036854775807 - 1, "i64::MIN is -(2^63)");
static_assert(i128::MAX == 170141183460469231731687303715884105727, "i128::MAX is 2^127 - 1");
static_assert(u8::MAX == 255 && i8::MIN == -128 && i16::MAX == 32767, "narrow limits fold");
static_assert(u32::BITS == 32 && u128::BITS == 128 && isize::BITS == 64, "BITS folds");
static_assert(char::BITS == 32, "char is 32 bits wide");
static_assert(Int::MAX == i32::MAX, "an alias reaches the primitive's constant");

type struct Table {
    // An array sized by `u64::MAX`, folded end to end.
    slots: [u8; u64::MAX >> 61];
}

function main() -> i32 {
    if ((i8::MIN as i32) != -128 || i8::MAX != 127) { return 1; }
    if ((i16::MIN as i32) != -32768 || i16::MAX != 32767) { return 2; }
    if ((i32::MIN as i64) != -2147483648 || i32::MAX != 2147483647) { return 3; }
    if (i64::MIN != -9223372036854775808 || i64::MAX != 9223372036854775807) { return 4; }
    if (i128::MIN != -170141183460469231731687303715884105728) { return 5; }
    if (u8::MIN != 0 || u8::MAX != 255 || u16::MAX != 65535) { return 6; }
    if (u32::MAX != 4294967295 || u64::MAX != 18446744073709551615) { return 7; }
    if (u128::MAX != 340282366920938463463374607431768211455 || u128::MIN != 0) { return 8; }
    if (usize::MAX != 18446744073709551615 || usize::MIN != 0) { return 9; }
    if (isize::MIN != -9223372036854775808 || isize::MAX != 9223372036854775807) { return 10; }
    if (i8::BITS != 8 || u16::BITS != 16 || i64::BITS != 64 || i128::BITS != 128 || usize::BITS != 64) { return 11; }
    if ((i32::MAX as i64) + 1 != 2147483648) { return 12; }

    if ((char::MIN as u32) != 0 || (char::MAX as u32) != 1114111 || char::BITS != 32) { return 13; }

    if (1.0 + f64::EPSILON == 1.0 || 1.0 + f64::EPSILON / 2.0 != 1.0) { return 14; }
    if ((1.0 as f32) + f32::EPSILON == (1.0 as f32)) { return 15; }
    if (f64::MIN != 0.0 - f64::MAX || f32::MIN != (0.0 as f32) - f32::MAX) { return 16; }
    if (f64::MIN_POSITIVE <= 0.0 || f64::MIN_POSITIVE / 2.0 >= f64::MIN_POSITIVE) { return 17; }
    if (f32::MIN_POSITIVE <= (0.0 as f32)) { return 18; }
    if (f64::INFINITY <= f64::MAX || f64::NEG_INFINITY >= f64::MIN) { return 19; }
    if (f32::INFINITY <= f32::MAX || f32::NEG_INFINITY >= f32::MIN) { return 20; }
    if (!f64::NAN.is_nan() || !f32::NAN.is_nan() || f64::NAN == f64::NAN) { return 21; }

    const table: Table = Table { slots: [0; u64::MAX >> 61] };
    if (table.slots.length != 7) { return 22; }
    return 0;
}
