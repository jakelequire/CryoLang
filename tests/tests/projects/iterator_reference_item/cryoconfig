# iterator_reference_item - an Iterator whose Item is a reference (`&i64`, `&Slice<u8>`) is
# implemented and driven like any other: map, filter, count, fold and `for`. A reference has
# no `Ord` of its own, so the trait's `min`/`max` (bounded `where This::Item: Ord`) are not
# copied into these implementations, and their bodies are never checked against the
# reference; `min` is reached through `map` to the values.
[project]
project_name = "iterator_reference_item"
output_dir   = "build"
target_type  = "executable"
source_dir   = "src"
entry_point  = "src/main.cryo"

