# iterator_reference_item - an Iterator whose Item is a reference (`&i64`, `&Slice<u8>`) is
# implemented and driven like any other: map, filter, count, fold, `for`, and `min`/`max`, since
# a reference is `Ord` where what it refers to is. An array of references sorts and searches by
# the values, and a path through a type parameter bound to a reference (`T::compare`) names the
# reference's own method.
[project]
project_name = "iterator_reference_item"
output_dir   = "build"
target_type  = "executable"
source_dir   = "src"
entry_point  = "src/main.cryo"

