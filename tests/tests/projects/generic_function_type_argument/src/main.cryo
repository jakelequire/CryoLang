/// A function type is a generic argument like any other, whatever its
/// return type: one returning a pointer or an array is not a pointer or an
/// array.
namespace GenericFunctionTypeArgument::Main;

function pick<T>(x: T) -> T { return x; }

function slot(n: i32) -> i32* { return null; }

function fill(n: i32) -> i32[] { mut a: i32[] = []; a.push(n); return a; }

function main() -> i32 {
    const f: (i32) -> i32* = pick(slot);
    const g: (i32) -> i32[] = pick(fill);
    const a: i32[] = g(4);
    if (f(1) == null) { return a[0] + 3; }
    return 1;
}
