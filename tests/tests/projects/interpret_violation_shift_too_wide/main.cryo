// `cryo interpret` shifts at the shifted value's width whatever the amount's
// type, as a compiled build does, and refuses a shift by that width or more
// as a violation at the shift.

namespace Main;

import std::fmt;

function amount(n: i64) -> i64 { return n; }

function main() -> i32 {
    const small: u8 = 3;
    const word: u32 = 3;
    const least: i8 = -128;
    fmt::println(f"u8 3 << 7 = {(small << amount(7)) as i64}");
    fmt::println(f"u32 3 << 31 = {(word << amount(31)) as i64}");
    fmt::println(f"i8 -128 >> 7 = {(least >> amount(7)) as i64}");
    fmt::println(f"{(word << amount(32)) as i64}");
    return 0;
}
