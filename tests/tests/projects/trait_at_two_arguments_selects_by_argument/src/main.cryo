/// `V` implements `Mul` twice, at `f32` and at `V`.  `a * k` and `a * a` both
/// call `Mul::mul`, and each binds the implementation whose `mul` its
/// argument fits: the scalar product for `k`, the other for `a`.
namespace TraitAtTwoArgumentsSelectsByArgument::Main;

import std::ffi::libc;
import std::core::ops::{ Mul };

type struct V { x: f32; }

implement trait Mul<f32, V> for struct V {
    mul(&this, rhs: &f32) -> V { return V { x: this.x * *rhs }; }
}

implement trait Mul<V, V> for struct V {
    mul(&this, rhs: &V) -> V { return V { x: this.x + rhs.x + 100.0 }; }
}

function main() -> int {
    const a: V = V { x: 2.0 };
    const k: f32 = 3.0;
    const s: V = a * k;
    const t: V = a * a;
    if (s.x as i32 != 6) { return 1; }
    if (t.x as i32 != 104) { return 2; }
    libc::printf("two-arguments ok\n");
    return 0;
}
