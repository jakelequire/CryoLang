namespace TaskSpawnOutsideATaskPanics;

import std::ffi::libc;
import std::future::{ Executor, JoinHandle, Task };

async function answer() -> i64 {
    return 42;
}

function main() -> i32 {
    // An executor exists, but this thread is not one of its workers.
    mut executor: Executor = Executor::with_threads(1);
    libc::printf("spawning outside a task\n");
    const handle: JoinHandle<i64> = Task::spawn(answer());
    libc::printf("spawned %lld\n", executor.block_on(handle).unwrap());
    return 0;
}
