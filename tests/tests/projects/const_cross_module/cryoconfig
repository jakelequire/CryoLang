# const_cross_module - a named length declared in one module and used as a
# length in another, in all three positions that want a compile-time integer:
# an array size in a type, the repeat expression that initializes it, and a
# `static_assert`.
#
# A project rather than a single test file because the load-bearing case is the
# module boundary: a constant reached through its qualifier (`Limits::CAPACITY`)
# has no source order relative to its use, so the value cannot be folded at the
# declaration - only on demand, once every module has declared.
#
# The exit code is the evidence: `main` returns a value assembled from the
# lengths the compiler folded, so a wrong fold changes it rather than silently
# passing.

[project]
project_name = "const_cross_module"
output_dir   = "build"
target_type  = "executable"
source_dir   = "src"
entry_point  = "src/main.cryo"

