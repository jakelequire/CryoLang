/// The lengths, declared once. Nothing here knows who uses them.
namespace ConstCrossModule::Limits;

type enum Tier {
    Low;
    Mid;
    High;
}

const CAPACITY: i64 = 12;
const HEADROOM: i64 = CAPACITY / 4;
const TIER_LEN: i64 = Tier::High as i64;

/// A pair whose size a constant is derived from, so `sizeof` is exercised in a
/// module-level initializer and not only in a `static_assert`. The two
/// positions read different fields of the same node, and held different
/// answers for it.
type struct Slot { a: i64; b: i64; }

const SLOT_BYTES: u64 = sizeof(Slot);
const TWO_SLOTS:  u64 = sizeof(Slot) * 2;

/// Reals, derived the same way the integers are. A float constant has no
/// length position to be folded by, so a wrong value here reaches runtime
/// with nothing else to contradict it.
const UNIT:      f64 = 1.5;
const GAP:       f64 = 0.25;
const SCALED_F:  f64 = UNIT * (1.0 - GAP);
const HALVED_F:  f64 = UNIT / 2.0;
