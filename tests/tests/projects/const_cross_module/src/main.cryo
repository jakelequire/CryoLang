/// Names the other module's lengths both ways a qualified path can be written
/// and bare, in each of the three positions that want a compile-time integer.
namespace ConstCrossModule::Main;

import ConstCrossModule::Limits;
import ConstCrossModule::Limits::{ CAPACITY, Tier };

type struct QualifiedField { f: u8[ConstCrossModule::Limits::CAPACITY]; }
type struct BareField      { f: u8[CAPACITY]; }
type struct DerivedField   { f: u8[ConstCrossModule::Limits::HEADROOM]; }
type struct EnumField      { f: u8[ConstCrossModule::Limits::TIER_LEN]; }

static_assert(ConstCrossModule::Limits::CAPACITY == 12,
              "a qualified constant folds in a static_assert");
static_assert(CAPACITY == 12, "the same constant, named bare");
static_assert(Tier::Mid as i64 == 1, "an enum variant from another module");
static_assert(sizeof(QualifiedField) == 12, "a qualified constant sizes a type");
static_assert(sizeof(DerivedField) == 3, "arithmetic done in the other module");
static_assert(sizeof(EnumField) == 2, "an enum-cast constant crosses the boundary");

function main() -> int {
    // The repeat count is the other module's constant; if it did not fold,
    // the literal would be `u8[]` and this binding would be E0200.
    const buf: u8[CAPACITY] = [1; ConstCrossModule::Limits::CAPACITY];
    const small: u8[ConstCrossModule::Limits::TIER_LEN] =
        [2; ConstCrossModule::Limits::TIER_LEN];

    return (buf.length + small.length
            + sizeof(BareField) as i64
            + sizeof(DerivedField) as i64
            + buf[11] as i64
            + small[1] as i64) as int;
}
