/// Names the other module's lengths both ways a qualified path can be written
/// and bare, in each of the three positions that want a compile-time integer.
namespace ConstCrossModule::Main;

import ConstCrossModule::Limits;
import ConstCrossModule::Limits::{ CAPACITY, Tier, INT_HALF };

type struct QualifiedField { f: u8[ConstCrossModule::Limits::CAPACITY]; }
type struct BareField      { f: u8[CAPACITY]; }
type struct DerivedField   { f: u8[ConstCrossModule::Limits::HEADROOM]; }
type struct EnumField      { f: u8[ConstCrossModule::Limits::TIER_LEN]; }

/// The SUFFIX spelling: `Limits` is the last segment of
/// `ConstCrossModule::Limits`, and naming a module that way is the normal case,
/// not the exotic one. It is a distinct test from the fully-written path above
/// because the constant table is keyed by the CANONICAL namespace - a folder
/// that matched the written qualifier against that key would accept the long
/// form and reject this one, which is what it did.
type struct SuffixField     { f: u8[Limits::CAPACITY]; }
type struct SuffixEnumField { f: u8[Limits::TIER_LEN]; }

/// A constant whose own initializer is reached through a suffix path, then used
/// as a length: the fold has to chase the name to its definition, not just
/// answer the first one.
const VIA_SUFFIX: i64 = Limits::CAPACITY;
type struct ChainedField { f: u8[VIA_SUFFIX]; }

/// A MODULE-LEVEL constant initialized from another module's REAL constant.
///
/// Distinct from the reals read inside `main` below, and the distinction is the
/// whole point: a use site in a body loads the other module's global at
/// runtime, so it is right whether or not anything folded. This position has to
/// be folded to be emitted at all, and an initializer that does not fold is not
/// diagnosed - it becomes the zeroinitializer. A qualified path had no real
/// reading, so every constant here was 0.0 while the same names in a body,
/// and the same shape with an INTEGER, were correct.
const FROM_OTHER_F:  f64 = ConstCrossModule::Limits::UNIT;
const FROM_SUFFIX_F: f64 = Limits::UNIT;
const DERIVED_F:     f64 = Limits::UNIT * 0.5;
const MIXED_F:       f64 = Limits::UNIT - Limits::GAP;
/// An enum variant in a real position: integer-valued, so it must reach the
/// real fold through the integer one rather than through a second decoder.
const ENUM_AS_F:     f64 = Limits::Tier::High as f64;

/// Reading a constant whose DECLARED type disagrees with the reading this
/// position wants. The value is the one its own declaration produced, so an
/// integer constant is promoted rather than re-folded: `INT_HALF` is 0, and a
/// real re-reading of `1 / 2` would answer 0.5 - a number it never held.
/// Both spellings, because the bare and qualified paths reach the entry by
/// different keys and disagreed about this.
const INT_HALF_QUALIFIED: f64 = Limits::INT_HALF;
const INT_HALF_BARE:      f64 = INT_HALF;
/// The mirror, which is why the integer reading cannot simply be preferred.
const REAL_DIV_QUALIFIED: f64 = Limits::REAL_DIV;

static_assert(ConstCrossModule::Limits::CAPACITY == 12,
              "a qualified constant folds in a static_assert");
static_assert(CAPACITY == 12, "the same constant, named bare");
static_assert(Limits::CAPACITY == 12, "the same constant, named by suffix");
static_assert(Limits::Tier::High as i64 == 2,
              "an enum variant reached through a suffix-spelled module");
static_assert(Tier::Mid as i64 == 1, "an enum variant from another module");
static_assert(sizeof(QualifiedField) == 12, "a qualified constant sizes a type");
static_assert(sizeof(SuffixField) == 12, "a suffix-spelled constant sizes a type");
static_assert(sizeof(SuffixEnumField) == 2, "and so does its enum-cast constant");
static_assert(sizeof(ChainedField) == 12, "through a constant that names one");
static_assert(sizeof(DerivedField) == 3, "arithmetic done in the other module");
static_assert(sizeof(EnumField) == 2, "an enum-cast constant crosses the boundary");

function main() -> int {
    // The repeat count is the other module's constant; if it did not fold,
    // the literal would be `u8[]` and this binding would be E0200.
    const buf: u8[CAPACITY] = [1; ConstCrossModule::Limits::CAPACITY];
    const small: u8[ConstCrossModule::Limits::TIER_LEN] =
        [2; ConstCrossModule::Limits::TIER_LEN];
    // The repeat position, reached by suffix. Annotated fixed, so a count that
    // did not fold types the literal `u8[]` and this is E0200.
    const suffix_buf: u8[Limits::CAPACITY] = [3; Limits::CAPACITY];

    // The same constants read as VALUES rather than as lengths.
    //
    // A length is folded by the compile-time folder and never reaches the
    // emitted global, so a constant can size a type correctly and still arrive
    // at runtime as 0 - which is what `HEADROOM` did, in this very project,
    // undetected, because nothing here loaded it. Each term below is zero when
    // the fold is right, so the exit code stays what it was and only a
    // regression moves it.
    const values: i64 = (CAPACITY - 12)
                      + (ConstCrossModule::Limits::HEADROOM - 3)
                      + (ConstCrossModule::Limits::TIER_LEN - 2)
                      + (ConstCrossModule::Limits::SLOT_BYTES as i64 - 16)
                      + (ConstCrossModule::Limits::TWO_SLOTS as i64 - 32)
                      + (Limits::CAPACITY - 12)
                      + (VIA_SUFFIX - 12)
                      + (suffix_buf.length - 12)
                      + (suffix_buf[11] as i64 - 3);

    // The reals, compared exactly: every value here is a sum of negative
    // powers of two, so each is representable and an epsilon would only hide a
    // fold that produced the wrong number.
    mut reals: i64 = 0;
    if (ConstCrossModule::Limits::SCALED_F != 1.125) { reals = reals + 1; }
    if (ConstCrossModule::Limits::HALVED_F != 0.75)  { reals = reals + 1; }

    // The module-level reals declared above, each zero when it failed to fold.
    if (FROM_OTHER_F  != 1.5)  { reals = reals + 1; }
    if (FROM_SUFFIX_F != 1.5)  { reals = reals + 1; }
    if (DERIVED_F     != 0.75) { reals = reals + 1; }
    if (MIXED_F       != 1.25) { reals = reals + 1; }
    if (ENUM_AS_F     != 2.0)  { reals = reals + 1; }

    // The declared type decides the reading, both spellings and both directions.
    if (INT_HALF_QUALIFIED != 0.0) { reals = reals + 1; }
    if (INT_HALF_BARE      != 0.0) { reals = reals + 1; }
    if (REAL_DIV_QUALIFIED != 3.5) { reals = reals + 1; }

    return (buf.length + small.length
            + sizeof(BareField) as i64
            + sizeof(DerivedField) as i64
            + buf[11] as i64
            + small[1] as i64
            + values + reals) as int;
}
