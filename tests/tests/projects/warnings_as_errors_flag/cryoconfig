# warnings_as_errors_flag - `cryo build -Werror` reports an unused local as
# an error and fails the build; without the flag the same source builds with
# one warning (the W0001 negative and unused_variable projects cover that).
[project]
project_name = "warnings_as_errors_flag"
output_dir   = "build"
target_type  = "executable"
source_dir   = "src"
entry_point  = "src/main.cryo"
[compiler]
[dependencies]
