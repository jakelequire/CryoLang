/// A static call whose owner's first parameter only a literal argument
/// could bind is refused (E0307) even when the owner's later parameters have
/// defaults, and its fix writes only the parameters with no default: the
/// defaulted ones are left to their defaults.
namespace OwnerLiteralGuessFixOmitsDefaultedParameters;

import std::alloc::box::{ Box };
import std::core::default::{ Default };

type struct Holder<T, U = i64> {
    value: T;
    extra: U;
    static new(value: T) -> Holder<T, U> where U: Default {
        return Holder::<T, U> { value: value, extra: U::default() };
    }
}

function main() -> int {
    // `is_ok()` names no parameter of `Box`, so the expected type binds
    // nothing and only the literal could decide `T`.
    const b: boolean = Box::try_new(41).is_ok();
    const h = Holder::new(5);
    return 0;
}
