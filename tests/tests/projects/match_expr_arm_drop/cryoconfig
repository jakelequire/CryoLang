# match_expr_arm_drop - built and RUN end-to-end (outcome = "run"). Guards the
# match-expression arm value-block drop path: a `let` local declared and not
# yielded in a match-expression arm must be dropped exactly once at the arm's
# end (after the value expression, which may read it), and a yielded local must
# be moved out and dropped only by the owner. The runner asserts exit code 0 and
# the success marker; any non-zero code identifies which invariant regressed.

[project]
project_name = "match_expr_arm_drop"
output_dir   = "build"
target_type  = "executable"
source_dir   = "src"
entry_point  = "src/main.cryo"

