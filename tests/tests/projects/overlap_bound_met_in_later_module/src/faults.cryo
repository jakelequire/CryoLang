namespace OverlapBoundMetInLaterModule::Faults;

import OverlapBoundMetInLaterModule::Conversion::{ Fault, Late };

// `Late` meeting `Fault` makes `Convert<E> for Late where E: Fault` accept
// `Late` itself, which `Convert<T> for T` accepts too.
implement trait Fault for struct Late { code(&this) -> i64 { return this.code; } }
