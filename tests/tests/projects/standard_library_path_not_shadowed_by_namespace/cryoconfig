# standard_library_path_not_shadowed_by_namespace - run. A program file
# declaring `namespace alloc::box;` is the program's own module: the
# prelude's `alloc::box` line still names the standard library's file, so
# `Box` resolves without an import.
[project]
project_name = "standard_library_path_not_shadowed_by_namespace"
output_dir   = "build"
target_type  = "executable"
source_dir   = "src"
entry_point  = "src/main.cryo"

