// A number converts implicitly only where the target holds every value of
// the source, and the conversion keeps the value: an unsigned value widens
// as unsigned wherever it is stored, passed or returned, and an integer
// becomes a float only where the float holds it exactly.  A shift's result
// is the shifted value's type, whatever the amount's.

type struct Wide {
    value: i64;
    ratio: f64;
}

function take_i64(v: i64) -> i64 { return v; }
function take_f64(v: f64) -> f64 { return v; }
function take_u64(v: u64) -> u64 { return v; }

function widened(v: u32) -> i64 { return v; }
function as_float(v: i32) -> f64 { return v; }

function main() -> i32 {
    const big: u32 = 4294967295;

    // An unsigned value widens to a signed one as itself.
    const local: i64 = big;
    if (local != 4294967295) { return 1; }
    if (take_i64(big) != 4294967295) { return 2; }
    if (widened(big) != 4294967295) { return 3; }
    const holder: Wide = Wide { value: big, ratio: 0.0 };
    if (holder.value != 4294967295) { return 4; }
    mut assigned: i64 = 0;
    assigned = big;
    if (assigned != 4294967295) { return 5; }

    // A signed one widens as itself.
    const negative: i32 = -7;
    const negative_wide: i64 = negative;
    if (negative_wide != -7) { return 6; }
    if (take_i64(negative) != -7) { return 7; }

    // An integer a float holds exactly becomes that float.
    if (take_f64(negative) != -7.0) { return 8; }
    if (take_f64(big) != 4294967295.0) { return 9; }
    if (as_float(negative) != -7.0) { return 10; }
    const ratio_holder: Wide = Wide { value: 0, ratio: negative };
    if (ratio_holder.ratio != -7.0) { return 11; }
    const half: f32 = 0.5;
    if (take_f64(half) != 0.5) { return 12; }

    // Mixed operands compute in the type holding both.
    const small: i8 = -5;
    const wide: i32 = -5;
    if (small != wide) { return 13; }
    if (small + wide != -10) { return 14; }
    const byte: u8 = 200;
    if (byte + wide != 195) { return 15; }

    // A negated literal takes the other operand's type.
    const lowest: i8 = -128;
    if (lowest != -128) { return 16; }
    if (lowest >= -1) { return 17; }

    // A shift's result is the shifted value's type.
    const bits: u8 = 0x81;
    const amount: u64 = 4;
    const shifted: u8 = bits << amount;
    if (shifted != 0x10) { return 18; }
    const word: u64 = 1;
    const narrow_amount: u32 = 40;
    if (word << narrow_amount != 1099511627776) { return 19; }
    const signed_word: i64 = -256;
    const byte_amount: u8 = 4;
    if (signed_word >> byte_amount != -16) { return 20; }

    // An if-expression's literal arms take the parameter's type.
    const flag: boolean = true;
    if (take_u64(if (flag) { 4294967296 } else { 0 }) != 4294967296) { return 21; }
    if (take_u64(if (flag) { 1 } else { 0 }) != 1) { return 22; }
    return 0;
}
