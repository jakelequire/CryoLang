// `cryo interpret` runs closures: one capturing nothing as a function
// value, one copying what it captures when it is made, one borrowing a
// value that is not `Copy`, each passed to a function-typed parameter and
// to a callable-bounded one, returned, and written in a generic body.

namespace Main;

import std::fmt;
import std::collections::string::{ String };

function apply(f: (i32) -> i32, value: i32) -> i32 { return f(value); }

function apply_bounded<F>(f: F, value: i32) -> i32 where F: (i32) -> i32 { return f(value); }

function tripled(value: i32) -> i32 { return value * 3; }

function chosen(doubles: boolean) -> (i32) -> i32 {
    if (doubles) { return (x: i32) -> i32 { return x * 2; }; }
    return (x: i32) -> i32 { return x - 1; };
}

function kept<T>(value: T, other: T, first: boolean) -> T where T: Copy {
    const pick = (left: T, right: T) -> T { return if (first) { left } else { right }; };
    const held = () -> T { return value; };
    return pick(held(), other);
}

type struct Pair { left: i64; right: i64; }

/// A closure capturing nothing, in a generic body copied at a struct: its
/// parameter is the struct in the copy, not the template's `T`.
function swapped<T>(first: T, second: T) -> T where T: Copy {
    const second_of: (T, T) -> T = (a: T, b: T) -> T { return b; };
    return second_of(first, second);
}

function main() -> i32 {
    const add_one: (i32) -> i32 = (x: i32) -> i32 { return x + 1; };
    mut base: i32 = 10;
    const add_base = (x: i32) -> i32 { return x + base; };
    base = 20;
    const text: String = String::from("four");
    const measured = () -> i32 { return text.length() as i32; };
    const plain: i32 = add_one(1) * 100 + add_base(1);
    const passed: i32 = apply(add_one, 4) + apply(add_base, 4) + apply(tripled, 4) + apply((x: i32) -> i32 { return x + base; }, 4);
    const bounded: i32 = apply_bounded(add_base, 5) + apply_bounded(tripled, 5) + apply_bounded((x: i32) -> i32 { return x * base; }, 5);
    const returned: i32 = chosen(true)(7) * 10 + chosen(false)(7);
    const generic: i64 = kept::<i64>(5, 6, true) * 10 + kept::<i64>(5, 6, false);
    const pair: Pair = swapped::<Pair>(Pair { left: 1, right: 2 }, Pair { left: 3, right: 4 });
    fmt::println(f"closures: {plain} {passed} {bounded} {returned} {generic} {measured()} {base} {pair.left}{pair.right}");
    return 0;
}
