# generic_async_function_called_before_its_declaration - a call to a generic
# `async function` is its future even where the caller's body is typed before
# the function's own.  A project rather than a unit-test file because a
# compiler that types such a call as the function's written result refuses
# the file, which would stop the whole unit suite from building.

[project]
project_name = "generic_async_function_called_before_its_declaration"
output_dir   = "build"
target_type  = "executable"
source_dir   = "src"
entry_point  = "src/main.cryo"

