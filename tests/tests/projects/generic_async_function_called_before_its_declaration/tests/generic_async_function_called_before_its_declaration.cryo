///! A call to a generic `async function` is its future wherever the call is
///! written, including in a body the compiler types before the function's
///! own: a caller declared above it, and an `async` caller that awaits it.

![config(testing)]
namespace GenericAsyncFunctionCalledBeforeItsDeclaration::Tests;

import std::core::result::{ Result };
import std::future;
import std::future::{ PendingThenReady };
import std::test::error::{ TestError };
import std::test::assert::{ expect_eq };

function run_sum(n: i64) -> i64 {
    return future::block_on(sum_to::<i64>(n));
}

async function doubled_sum(n: i64) -> i64 {
    const sum: i64 = await sum_to::<u8>(n);
    return sum * 2;
}

async function sum_to<T>(n: i64) -> i64 {
    mut i: i64 = 0;
    mut sum: i64 = 0;
    while (i < n) {
        i = i + 1;
        sum += await PendingThenReady::<i64>::new(1, i);
    }
    return sum;
}

![test]
function called_from_a_function_declared_above_it() -> Result<(), TestError> {
    return expect_eq(run_sum(4), 10);
}

![test]
function awaited_by_an_async_function_declared_above_it() -> Result<(), TestError> {
    return expect_eq(future::block_on(doubled_sum(3)), 12);
}

![test]
function called_where_its_result_type_is_inferred() -> Result<(), TestError> {
    const total: i64 = future::block_on(sum_to::<i32>(5));
    return expect_eq(total, 15);
}
