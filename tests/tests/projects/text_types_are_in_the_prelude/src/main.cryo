// `String`, `Str` and `Utf8Error` are prelude names: a program names all
// three bare with no import of `std::collections`.
import std::fmt;

namespace TextTypesAreInThePrelude::Main;

function first_invalid(bytes: Array<u8>) -> i64 {
    const decoded: Result<String, Utf8Error> = String::from_utf8(bytes);
    return match (decoded) {
        Result::Ok(_)      => { -1 }
        Result::Err(error) => { error.valid_up_to }
    };
}

function main() -> i32 {
    mut owned: String = String::new();
    owned.push(Str::new("text"));
    owned.push(7);
    const view: Str = Str::new("view");
    mut bytes: Array<u8> = Array::new();
    bytes.push(0x61);
    bytes.push(0xFF);
    fmt::println(f"owned {owned} view {view} length {owned.length()} invalid at {first_invalid(bytes)}");
    return 0;
}
