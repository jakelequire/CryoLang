# const_unimported_gate - a compile-time constant is resolvable only if the
# module holding it is VISIBLE from the use site (name-resolution spec Rule 0).
#
# `Limits` is compiled - `Bridge` imports it - but `main` does not, so naming
# `Limits::HIDDEN` there must be rejected. It is a project rather than a single
# negative file because the property needs three modules: one that declares, one
# that makes it reachable at all, and one that may not see it.
#
# Before the constant folder read the resolver Res stamp it answered this from a
# program-wide name map, with no import in hand, and the assertion below
# compiled clean.

[project]
project_name = "const_unimported_gate"
output_dir   = "build"
target_type  = "executable"
source_dir   = "src"
entry_point  = "src/main.cryo"

[compiler]

