/// Imports `Limits`, which is what puts it in the module graph at all - module
/// discovery is import-driven, so without this the constant would be absent
/// rather than invisible, and the test would pass for the wrong reason.
namespace ConstUnimportedGate::Bridge;

import ConstUnimportedGate::Limits;

/// A use, so the import is load-bearing and cannot be tidied away.
public function bridge_len() -> i64 {
    return Limits::HIDDEN;
}
