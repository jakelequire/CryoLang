/// Imports `Bridge` and NOT `Limits`, then names a constant of `Limits`.
namespace ConstUnimportedGate::Main;

import ConstUnimportedGate::Bridge;

/// `Limits` is not reachable from here, so this is E0240 - not "77", and not
/// "not a compile-time constant" either. The diagnostic naming the MODULE is
/// the property: the fold asks the resolver what the qualifier denotes rather
/// than matching the spelling against a program-wide map.
static_assert(Limits::HIDDEN == 77, "an unimported module is not nameable");

function main() -> int {
    return bridge_len() as int;
}
