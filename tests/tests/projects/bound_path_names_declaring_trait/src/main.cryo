namespace BoundPathDeclaringTrait::Main;

/// `P` implements two traits that each provide `make`, so a path through a
/// parameter `P` is substituted for names one of them only by what the
/// generic body's bounds say.  The bound that directs `T::make()` is the one
/// whose trait declares `make` - not merely the only bound written on `T`.
type trait Beta {
    static make() -> i32;
}

type trait Gamma {
    static make() -> i32;
}

type trait Named {
    label(&this) -> i32;
}

/// Declares nothing itself; `make` is its supertrait's.
type trait Sub : Gamma {
}

type struct P {
    v: i32;
}

implement trait Beta for P {
    static make() -> i32 { return 2; }
}

implement trait Gamma for P {
    static make() -> i32 { return 5; }
}

implement trait Named for P {
    label(&this) -> i32 { return this.v; }
}

implement trait Sub for P {
}

/// Two bounds, one of which declares `make`: Beta's.
function via_two_bounds<T>() -> i32 where T: Beta + Named {
    return T::make();
}

/// The bound's trait declares nothing; its supertrait `Gamma` declares `make`.
function via_supertrait<T>() -> i32 where T: Sub {
    return T::make();
}

function main() -> i32 {
    const a: i32 = via_two_bounds::<P>();   // 2
    const b: i32 = via_supertrait::<P>();   // 5
    if (a != 2) { return 1; }
    if (b != 5) { return 2; }
    return 0;
}
