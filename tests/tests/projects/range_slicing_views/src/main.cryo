namespace RangeSlicingViews;

import std::core::slice::{ Slice };
import std::collections::str::{ Str };
import std::collections::string::{ String };

// `a[r]` with a range `r` is a view of part of `a`: a `&Slice<T>` of an
// array or a slice, written a `mut &Slice<T>`, and a `Str` of a string's
// bytes.  Every range form, over integer types other than the literal's
// default; an element written through a view lands in the array; and
// `a..` alone counts up without end.

function sum(xs: &Slice<i64>) -> i64 {
    mut total: i64 = 0;
    for (mut i: i64 = 0; i < xs.length(); i++) { total = total + xs[i]; }
    return total;
}

function main() -> i32 {
    mut xs: [i64] = [1, 2, 3, 4, 5];
    if (sum(xs[1..3]) != 5) { return 1; }
    if (sum(xs[2..]) != 12) { return 2; }
    if (sum(xs[..2]) != 3) { return 3; }
    if (sum(xs[..]) != 15) { return 4; }
    if (sum(xs[1..=3]) != 9) { return 5; }
    if (xs[3..3].length() != 0) { return 6; }
    const whole: &Slice<i64> = xs[..];
    if (sum(whole[1..4]) != 9) { return 7; }
    const start: i64 = 1;
    const end: u64 = 4;
    if (sum(xs[start..]) != 14 || sum(xs[..end]) != 10) { return 8; }

    const text: Str = Str::new("héllo world");
    if (text[0..1] != Str::new("h")) { return 10; }
    if (text[1..3] != Str::new("é")) { return 11; }
    if (text[7..] != Str::new("world")) { return 12; }
    if (text[..6] != Str::new("héllo")) { return 13; }
    const owned: String = String::from("abcdef");
    if (owned[2..4] != Str::new("cd")) { return 14; }
    if (owned[..].length() != 6) { return 15; }

    mut counted: i64 = 0;
    for (n in 5..) {
        counted = counted + n;
        if (n == 7) { break; }
    }
    if (counted != 18) { return 16; }

    xs[1..3][0] = 20;
    xs[3..][1] += 50;
    const written: mut i64* = xs[..2].as_mutable_ptr();
    written[0] = 10;
    if (xs[0] != 10 || xs[1] != 20 || xs[2] != 3 || xs[4] != 55) { return 17; }
    if (sum(xs[1..3]) != 23) { return 18; }

    const fixed: [i64] = [7, 8, 9];
    const tail: &Slice<i64> = fixed[1..];
    if (tail[1] != 9) { return 19; }
    const first: u8 = 1;
    const short: usize = 2;
    if (sum(fixed[first as usize..short]) != 8 || sum(fixed[1..short]) != 8) { return 20; }
    return 0;
}
