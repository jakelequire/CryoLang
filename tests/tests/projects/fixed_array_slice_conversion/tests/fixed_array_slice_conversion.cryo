///! A fixed array's reference converts to a slice reference where one is
///! wanted, as a container's does: a `&[T; N]` or `mut &[T; N]` gives the
///! `&Slice<T>` over its `N` elements, and a `mut &[T; N]` the
///! `mut &Slice<T>` that writes them.  No implementation can name `N`, so
///! the compiler answers.  Each place a value meets a declared type
///! converts it, a `[T; 0]` gives the empty slice, and `for` over a fixed
///! array - a `[T; 0]` and a call's result among them - iterates the same
///! slice.

![config(testing)]
namespace FixedArraySliceConversion::Tests;

import std::core::result::{ Result };
import std::core::slice::{ Slice };
import std::test::error::{ TestError };
import std::test::assert::{ expect_eq };

function total(items: &Slice<i32>) -> i64 {
    mut sum: i64 = 0;
    for (mut i: i64 = 0; i < items.length(); i++) {
        sum += items[i] as i64;
    }
    return sum;
}

function double_each(items: mut &Slice<i32>) -> void {
    for (mut i: i64 = 0; i < items.length(); i++) {
        items[i] = items[i] * 2;
    }
}

function as_view(values: &[i32; 3]) -> &Slice<i32> {
    return values;
}

function last_of<T>(values: &[T; 3]) -> T {
    const view: &Slice<T> = values;
    return view[2];
}

function three() -> [i32; 3] {
    return [1, 2, 3];
}

type struct Window {
    items: &Slice<i32>;
}

![test]
function fixed_array_converts_for_an_argument() -> Result<(), TestError> {
    const values: [i32; 3] = [1, 2, 3];
    return expect_eq(total(&values), 6);
}

![test]
function writable_fixed_array_converts_for_a_writable_argument() -> Result<(), TestError> {
    mut values: [i32; 3] = [1, 2, 3];
    double_each(&values);
    expect_eq(values[0], 2)?;
    return expect_eq(values[2], 6);
}

![test]
function fixed_array_converts_for_a_declared_binding() -> Result<(), TestError> {
    const values: [i32; 4] = [1, 2, 3, 4];
    const view: &Slice<i32> = &values;
    expect_eq(view.length(), 4)?;
    return expect_eq(view[3], 4);
}

![test]
function fixed_array_converts_for_an_assignment() -> Result<(), TestError> {
    const first: [i32; 3] = [1, 2, 3];
    const second: [i32; 4] = [1, 2, 3, 4];
    mut view: &Slice<i32> = &first;
    view = &second;
    return expect_eq(total(view), 10);
}

![test]
function fixed_array_converts_for_a_struct_field() -> Result<(), TestError> {
    const values: [i32; 3] = [1, 2, 3];
    const window: Window = Window { items: &values };
    return expect_eq(total(window.items), 6);
}

![test]
function fixed_array_converts_for_a_return() -> Result<(), TestError> {
    const values: [i32; 3] = [1, 2, 3];
    return expect_eq(total(as_view(&values)), 6);
}

![test]
function generic_element_converts() -> Result<(), TestError> {
    const values: [u64; 3] = [7, 8, 9];
    return expect_eq(last_of::<u64>(&values), 9);
}

![test]
function nested_fixed_array_converts_to_a_slice_of_rows() -> Result<(), TestError> {
    const rows: [[i32; 2]; 3] = [[1, 2], [3, 4], [5, 6]];
    const view: &Slice<[i32; 2]> = &rows;
    expect_eq(view.length(), 3)?;
    return expect_eq(view[2][1], 6);
}

![test]
function empty_fixed_array_converts_to_the_empty_slice() -> Result<(), TestError> {
    const none: [i32; 0];
    const view: &Slice<i32> = &none;
    expect_eq(view.length(), 0)?;
    return expect_eq(total(&none), 0);
}

![test]
function for_over_an_empty_fixed_array_runs_no_iteration() -> Result<(), TestError> {
    const none: [i32; 0];
    mut count: i32 = 0;
    for (x in none) { count = count + 1; }
    return expect_eq(count, 0);
}

![test]
function for_over_a_call_result_iterates_its_elements() -> Result<(), TestError> {
    mut sum: i32 = 0;
    for (x in three()) { sum = sum + x; }
    return expect_eq(sum, 6);
}
