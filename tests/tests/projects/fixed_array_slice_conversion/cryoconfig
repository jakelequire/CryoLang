# fixed_array_slice_conversion - a fixed array's reference converts to a
# slice reference, and `for` over a fixed array (a `[T; 0]` and a call's
# result among them) iterates its slice.  A project rather than a unit-test
# file because a compiler without the conversion refuses the file, which
# would stop the whole unit suite from building.

[project]
project_name = "fixed_array_slice_conversion"
output_dir   = "build"
target_type  = "executable"
source_dir   = "src"
entry_point  = "src/main.cryo"

