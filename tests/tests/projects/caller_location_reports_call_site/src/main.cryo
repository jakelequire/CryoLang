/// `![caller_location]`: `FILE` and `LINE` in the function's body are the
/// location of the call - for a free function, a method, and through a
/// chain of such functions, the first call outside the chain.  A function
/// without it reports its own.
namespace CallerLocation::Main;

import std::fmt;

![caller_location]
function where_called() -> u32 {
    return LINE;
}

![caller_location]
function forwards() -> u32 {
    return where_called();
}

function own_line() -> u32 {
    return LINE;
}

type struct Probe { k: i32; }

implement struct Probe {
    ![caller_location]
    line_of_call(&this) -> u32 { return LINE; }
}

![caller_location]
function file_of_call() -> string {
    return FILE;
}

function main() -> i32 {
    const a: u32 = where_called();
    const b: u32 = forwards();
    const p: Probe = Probe { k: 1 };
    const c: u32 = p.line_of_call();
    const d: u32 = own_line();
    fmt::println(f"free {a} chain {b} method {c} plain {d}");
    fmt::println(f"file {file_of_call()}");
    return 0;
}
