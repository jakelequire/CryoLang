# collect_project_exit_code_is_judged - collect. A collect project's
# `cryo test` exit is judged against `expect.exit_code`, as a build or run
# project's exit is: this run has one failing test, so it exits 1, and the
# project passes only on exactly that exit.
[project]
project_name = "collect_project_exit_code_is_judged"
output_dir   = "build"
target_type  = "executable"
source_dir   = "src"
entry_point  = "src/main.cryo"

