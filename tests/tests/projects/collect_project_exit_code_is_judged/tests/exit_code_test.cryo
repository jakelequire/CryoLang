/// One passing and one failing test: the run exits 1, which the parent
/// project's `expect.exit_code` asserts.
![config(testing)]
namespace CollectExitCode::ExitCodeTest;

import std::core::result;
import std::test::error::{ TestError };
import std::test::assert::{ expect_equal };

![test]
function a_passing_test_beside_it() -> Result<(), TestError> {
    expect_equal(2, 2)?;
    return Result::Ok(());
}

![test]
function one_failing_test_makes_the_run_exit_one() -> Result<(), TestError> {
    expect_equal(1, 2)?;
    return Result::Ok(());
}
