///! A trait's default method calling a generic default of the same trait on
///! `this` - `this.draw::<f64>()`, or `this.draw()` where an `f64` is
///! expected - gets the type it asks for, not the callee's own parameter.
///! A project rather than a unit file: a compiler that types the call as
///! the callee's `T` refuses the trait, and a unit file it refuses would
///! stop its whole unit build.

![config(testing)]
namespace CryoTests::Tests::TraitDefaultCallsGenericSibling;

import std::core::result::{ Result };
import std::test::error::{ TestError };
import std::test::assert::{ expect_eq };

type trait Source {
    bits(mut &this) -> u64;

    draw<T>(mut &this) -> T {
        return static match (T) {
            f64 => { (this.bits() as f64) / 4.0 }
            u64 => { this.bits() }
        };
    }

    half(mut &this) -> f64 {
        return this.draw::<f64>() * 0.5;
    }

    quarter_expected(mut &this) -> f64 {
        const unit: f64 = this.draw();
        return unit;
    }

    whole(mut &this) -> u64 {
        return this.draw::<u64>() + 100;
    }
}

type struct Counter { value: u64; }

implement trait Source for struct Counter {
    bits(mut &this) -> u64 {
        this.value = this.value + 1;
        return this.value;
    }
}

![test]
function a_default_gets_the_type_its_generic_sibling_is_called_at() -> Result<(), TestError> {
    mut counter: Counter = Counter { value: 0 };
    expect_eq(counter.half(), 0.125)?;
    expect_eq(counter.quarter_expected(), 0.5)?;
    return expect_eq(counter.whole(), 103);
}
