namespace FieldMovedOutOfTemporaryReleasesTheRest;

import std::core::drop::{ Drop };

// A field that is not `Copy`, moved out of a value no binding owns (a call's
// result), is owned by whatever it moves to; the value's other fields are
// released when the statement ends, each exactly once.  A field only
// borrowed leaves the whole value to be released then, through its
// destructor where it has one.

// The sum of the tags released so far: every tag is a distinct power of
// two, so the sum names exactly which values were released, and a value
// released twice carries into a bit no single release sets.
mut g_released: i64 = 0;

type struct Counted {
    tag: i64;
    tag_of(&this) -> i64 { return this.tag; }
}

implement trait Drop for struct Counted {
    drop(mut &this) -> void { g_released = g_released + this.tag; }
}

type struct Two {
    a: Counted;
    b: Counted;
}

type struct Three {
    two: Two;
    c: Counted;
    id: i64;
}

type struct Guarded {
    inner: Counted;
}

implement trait Drop for struct Guarded {
    drop(mut &this) -> void { g_released = g_released + 1024; }
}

function counted(tag: i64) -> Counted { return Counted { tag: tag }; }
function two(a: i64, b: i64) -> Two { return Two { a: counted(a), b: counted(b) }; }
function three() -> Three { return Three { two: two(1, 2), c: counted(4), id: 9 }; }
function pair(a: i64, b: i64) -> (Counted, Counted) { return (counted(a), counted(b)); }
function guarded(tag: i64) -> Guarded { return Guarded { inner: counted(tag) }; }
function consume(value: Counted) -> i64 { return value.tag; }
function borrow(value: &Counted) -> i64 { return value.tag; }

function main() -> i32 {
    // Moved into a binding: the other field goes when the statement ends,
    // the moved one when the binding does.
    {
        const a: Counted = two(1, 2).a;
        if (g_released != 2) { return 1; }
        if (a.tag != 1) { return 2; }
    }
    if (g_released != 3) { return 3; }

    // Moved out of a field of a field: every other field at every depth.
    g_released = 0;
    {
        const a: Counted = three().two.a;
        if (g_released != 6) { return 4; }
        if (a.tag != 1) { return 5; }
    }
    if (g_released != 7) { return 6; }

    // Moved into a call: the callee releases it; the rest goes here.
    g_released = 0;
    if (consume(two(8, 16).b) != 16) { return 7; }
    if (g_released != 24) { return 8; }

    // An element of a tuple.
    g_released = 0;
    {
        const second: Counted = pair(32, 64).1;
        if (g_released != 32) { return 9; }
        if (second.tag != 64) { return 10; }
    }
    if (g_released != 96) { return 11; }

    // Only borrowed: the whole value goes when the statement ends.
    g_released = 0;
    if (borrow(&two(1, 2).a) != 1) { return 12; }
    if (g_released != 3) { return 13; }
    g_released = 0;
    if (two(4, 8).b.tag_of() != 8) { return 14; }
    if (g_released != 12) { return 15; }

    // Borrowed out of a value with a destructor: the destructor runs, and
    // the field is released with the value.
    g_released = 0;
    if (guarded(2).inner.tag_of() != 2) { return 16; }
    if (g_released != 1026) { return 17; }
    return 0;
}
