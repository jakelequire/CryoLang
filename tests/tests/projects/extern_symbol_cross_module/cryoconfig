# extern_symbol_cross_module - an `extern "C"` function declared in one module
# and called BARE from another.
#
# A pinned callee resolves by the kind of name the pin carries; a C function
# is pinned by its symbol.  Codegen declares a symbol it does not hold from
# the declaration index entry registered under it - and an extern's entry
# carried no symbol, so the call resolved only through a second lookup by
# family name.  In the extern's OWN module the declaration pass holds the
# symbol already; only a call from ANOTHER module asks the index, which is
# the shape the Linux target reached first (`getrandom` from
# `std::random::secure`).

[project]
project_name = "extern_symbol_cross_module"
output_dir   = "build"
target_type  = "executable"
source_dir   = "src"
entry_point  = "src/main.cryo"

