///! A where-clause chain is as long as the type it is asked of is deep.
///!
///! `Shell<P>` implements `Layers` when `P` does, so asking whether a
///! value forty shells deep implements it asks forty questions, each
///! about the type one shell smaller.  Each is a smaller question than
///! the one before, so the chain ends by itself and none of it counts
///! against the budget that stops a cycle; an interpolated string passed
///! as `Arguments` is the same chain, one wrapper per piece.

![config(testing)]
namespace CryoTests::Tests::Lang::TraitBoundDeepChain;

import std::core::result::{ Result };
import std::test::error::{ TestError };
import std::test::assert::{ expect_equal };
import std::collections::str::{ Str };
import std::fmt;
import std::fmt::{ Arguments, FormatWrite };

type trait Layers {
    layers(&this) -> i64;
}

type struct Core { }

implement trait Layers for struct Core {
    layers(&this) -> i64 { return 0; }
}

type struct Shell<P> {
    inner: P;
}

implement<P> trait Layers for struct Shell<P> where P: Layers {
    layers(&this) -> i64 { return 1 + this.inner.layers(); }
}

function shell<P>(inner: P) -> Shell<P> where P: Layers {
    return Shell::<P> { inner: inner };
}

function count(value: virtual &Layers) -> i64 {
    return value.layers();
}

function render(text: Arguments) -> String {
    mut out: String = String::new();
    const _: Result<(), fmt::FormatError> = out.write(text);
    return out;
}

![test]
function deep_chain_of_forty_shells_implements_the_trait() -> Result<(), TestError> {
    const deep = shell(shell(shell(shell(shell(shell(shell(shell(shell(shell(
                 shell(shell(shell(shell(shell(shell(shell(shell(shell(shell(
                 shell(shell(shell(shell(shell(shell(shell(shell(shell(shell(
                 shell(shell(shell(shell(shell(shell(shell(shell(shell(shell(
                 Core { }))))))))))))))))))))))))))))))))))))))));
    return expect_equal(count(&deep), 40);
}

![test]
function deep_chain_of_twenty_four_holes_with_text_between() -> Result<(), TestError> {
    const a: u64 = 7;
    const text: String = render(f"<{a} {a} {a} {a} {a} {a} {a} {a} {a} {a} {a} {a} {a} {a} {a} {a} {a} {a} {a} {a} {a} {a} {a} {a}>");
    return expect_equal(text.as_str(), Str::new("<7 7 7 7 7 7 7 7 7 7 7 7 7 7 7 7 7 7 7 7 7 7 7 7>"));
}
