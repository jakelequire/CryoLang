namespace AllocateTraitRoutesNew;

// `new` of a type that implements `Allocate` calls its `allocate(size,
// align)`; a class below it uses the root's.  `delete`
// runs the pointee's `Drop`, then the same implementation's `release`.  The
// allocators here hand out slices of one static block and count their calls.

mut g_block: [u8; 4096] = [0; 4096];
mut g_used: u64 = 0;
mut g_allocs: i32 = 0;
mut g_releases: i32 = 0;
mut g_drops: i32 = 0;
mut g_releases_at_drop: i32 = -1;

function bump(size: u64, align: u64) -> void* {
    const mask: u64 = align - 1;
    g_used = (g_used + mask) & ~mask;
    const p: void* = (&g_block[g_used as i64]) as void*;
    g_used = g_used + size;
    return p;
}

function in_block(p: void*) -> boolean {
    const base: u64 = (&g_block[0]) as u64;
    const at: u64 = p as u64;
    return at >= base && at < base + 4096;
}

type class Node {
public:
    tag: i32;
    Node(t: i32) { this.tag = t; }
}

implement trait Allocate for class Node {
    static allocate(size: u64, align: u64) -> void* {
        g_allocs = g_allocs + 1;
        return bump(size, align);
    }
    static release(ptr: void*, align: u64) -> void {
        g_releases = g_releases + 1;
    }
}

// No `Allocate` of its own: Node's serves it.
type class Leaf : Node {
public:
    value: i64;
    Leaf(v: i64) : Node(2) { this.value = v; }
}

type class Dropped : Node {
public:
    Dropped() : Node(4) { }
}

implement trait Drop for class Dropped {
    drop(mut &this) -> void {
        g_drops = g_drops + 1;
        g_releases_at_drop = g_releases;
    }
}

type struct Pod {
    x: i32;
}

implement trait Allocate for struct Pod {
    static allocate(size: u64, align: u64) -> void* {
        g_allocs = g_allocs + 1;
        return bump(size, align);
    }
}

type class Plain {
public:
    n: i32;
    Plain(n: i32) { this.n = n; }
}

function main() -> i32 {
    const a: Node* = new Node(1);
    if (g_allocs != 1 || a.tag != 1 || !in_block(a as void*)) { return 1; }
    const b: Leaf* = new Leaf(40);
    if (g_allocs != 2 || b.tag != 2 || b.value != 40 || !in_block(b as void*)) { return 2; }
    const d: Plain* = new Plain(5);
    if (g_allocs != 2 || d.n != 5 || in_block(d as void*)) { return 4; }
    const e: Pod* = new Pod { x: 9 };
    if (g_allocs != 3 || e.x != 9 || !in_block(e as void*)) { return 5; }
    const arr: Leaf* = new Leaf[2];
    if (g_allocs != 4 || !in_block(arr as void*)) { return 6; }

    delete b;
    if (g_releases != 1) { return 7; }
    const f: Dropped* = new Dropped();
    if (g_allocs != 5) { return 9; }
    delete f;
    if (g_drops != 1 || g_releases_at_drop != 1 || g_releases != 2) { return 10; }
    delete d;
    if (g_releases != 2) { return 11; }
    return 0;
}
