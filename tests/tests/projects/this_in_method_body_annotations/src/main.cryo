namespace Probe;

type struct Wrapper<S> {
    inner: S;
    static of(s: S) -> Wrapper<S> { return Wrapper::<S> { inner: s }; }
}

type trait Source {
    next_value(mut &this) -> i64;
    wrapped(this) -> Wrapper<This> { return Wrapper::<This>::of(this); }
    kept(this) -> Wrapper<This> { const w: Wrapper<This> = Wrapper::of(this); return w; }
}

type struct Counter {
    n: i64;
    boxed(this) -> Wrapper<This> { const w: Wrapper<This> = Wrapper::<This>::of(this); return w; }
    static zero() -> Wrapper<This> { const c: This = Counter { n: 0 }; return Wrapper::<This>::of(c); }
}

implement trait Source for Counter {
    next_value(mut &this) -> i64 { this.n = this.n + 1; return this.n; }
}

type struct Cell<T> {
    v: T;
    boxed(this) -> Wrapper<This> { const w: Wrapper<This> = Wrapper::<This>::of(this); return w; }
}

function main() -> i32 {
    mut w = Counter { n: 4 }.wrapped();
    if (w.inner.next_value() != 5) { return 1; }
    mut k = Counter { n: 7 }.kept();
    if (k.inner.next_value() != 8) { return 2; }
    const b = Counter { n: 3 }.boxed();
    if (b.inner.n != 3) { return 3; }
    const z = Counter::zero();
    if (z.inner.n != 0) { return 4; }
    const c = Cell::<i64> { v: 7 }.boxed();
    if (c.inner.v != 7) { return 5; }
    return 0;
}
