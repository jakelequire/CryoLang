// A generic struct's static method with a type parameter of its own, called
// through the bare owner with every type argument inferred: the owner's
// arguments come from the call's arguments, as they do for a static method
// with no parameters of its own, and the method's own from the rest.
![config(testing)]
namespace CryoTests::Tests::Lang::GenericStaticOwnParameterInferred;

import std::test;
import std::core::result::{ Result };
import std::test::assert::{ expect_eq };
import std::test::error::{ TestError };

type struct Holder<T, U> {
    value: T;
    other: U;
}

type struct Viewer<T, U> {
    first: T;
    second: U;

    static over<W>(holder: &Holder<T, U>, marker: W) -> Viewer<T, U> {
        return Viewer::<T, U> { first: holder.value, second: holder.other };
    }
}

![test]
function owner_arguments_inferred_with_the_methods_own() -> Result<(), TestError> {
    const holder: Holder<i32, i64> = Holder::<i32, i64> { value: 7, other: 8 };
    const viewer: Viewer<i32, i64> = Viewer::over(&holder, true);
    const want_first: i32 = 7;
    if (viewer.first != want_first) { return expect_eq(viewer.first, want_first); }
    const want_second: i64 = 8;
    return expect_eq(viewer.second, want_second);
}
