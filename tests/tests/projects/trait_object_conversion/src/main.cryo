namespace TraitObjectConversion::Main;

import TraitObjectConversion::Shapes::{ Shape };
import TraitObjectConversion::Circles::{ Circle };

// A reference or a pointer becomes a trait object wherever a value is
// checked against a declared type: an initializer, an assignment, an
// argument, a return, a struct-literal field, an array element and a
// variant's payload.  The trait, the implementation and these conversions
// are three modules, so the table is named here and defined in the
// implementation's module.  A raw object compares with `null` alone.

type struct Holder {
    tag:   i32;
    shape: virtual &Shape;
}

type enum Pick {
    One(virtual &Shape);
    Nothing;
}

function takes(s: virtual &Shape) -> i32 { return 1; }
function takes_mutably(s: virtual mut &Shape) -> i32 { return 2; }
function takes_raw(s: virtual Shape*) -> i32 { return 3; }

function gives(c: &Circle) -> virtual &Shape {
    return c;
}

function held(h: &Holder) -> i32 { return h.tag; }

function picked(p: Pick) -> i32 {
    return match (p) {
        Pick::One(s)  => { s.area() }
        Pick::Nothing => { 0 }
    };
}

function count(xs: [virtual &Shape; 3]) -> i32 { return 3; }

function main() -> i32 {
    mut c: Circle = Circle { r: 2 };
    const d: Circle = Circle { r: 5 };

    const initialized: virtual &Shape = &c;
    mut assigned: virtual &Shape = initialized;
    assigned = &d;
    if (takes(&c) + takes(assigned) != 2) { return 1; }
    if (takes_mutably(&c) != 2) { return 2; }
    if (takes_raw(&c as Circle*) != 3) { return 3; }
    if (takes(gives(&d)) != 1) { return 4; }

    const h: Holder = Holder { tag: 9, shape: &c };
    if (held(&h) != 9) { return 5; }
    if (count([&c, &d, initialized]) != 3) { return 6; }
    if (picked(Pick::One(&d)) != 75) { return 7; }

    mut p: virtual Shape* = null;
    if (p != null) { return 8; }
    if (!(p == null)) { return 9; }
    p = &c as Circle*;
    if (p == null) { return 10; }
    if (!(p != null)) { return 11; }
    p = null;
    if (p != null) { return 12; }
    return 0;
}
