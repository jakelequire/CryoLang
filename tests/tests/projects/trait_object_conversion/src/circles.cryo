namespace TraitObjectConversion::Circles;

import TraitObjectConversion::Shapes::{ Shape };

// The implementation, in a module of its own: its table is emitted here,
// on the demand of the conversions in another module.

type struct Circle {
    r: i32;
}

implement trait Shape for Circle {
    area(&this) -> i32 { return this.r * this.r * 3; }
}
