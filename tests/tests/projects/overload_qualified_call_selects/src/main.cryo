namespace OverloadQualifiedCallSelects::Main;

import OverloadQualifiedCallSelects::Json;
import OverloadQualifiedCallSelects::Json as J;
import OverloadQualifiedCallSelects::Facade;

function main() -> i32 {
    const wide: i64 = 7;
    if (Json::conv(1 as i32) != 32) { return 1; }
    if (Json::conv(wide) != 64) { return 2; }
    if (Json::conv(2, 3) != 5) { return 3; }
    if (J::conv(5 as i64) != 64) { return 4; }
    if (Facade::convert(1 as i32) != 32) { return 5; }
    if (Facade::convert(wide) != 64) { return 6; }
    // A literal is `i32` where the signatures differ in its type.
    if (Json::conv(1) != 32 || J::conv(-1) != 32) { return 7; }
    return 0;
}
