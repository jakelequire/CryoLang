namespace ImportModuleAliasResolves::Main;

import ImportModuleAliasResolves::Json as J;
import ImportModuleAliasResolves::Json::{ Inner as In };
import ImaFlat as F;

function take(t: J::Tag) -> i32 { return t.get(); }
function mk() -> J::Tag { return J::Tag { id: 11 }; }

// `ImportModuleAliasResolves` is no module, so `J` names the module
// `ImportModuleAliasResolves::Json`, by its identity, at every use.
function main() -> i32 {
    if (J::twice(3) != 6) { return 1; }
    if (take(mk()) != 11) { return 2; }
    mut a: J::Tag[] = [];
    a.push(J::Tag::make(3));
    if (a[0].get() != 3) { return 3; }
    const k: J::Kind = J::Kind::B;
    const n: i32 = match (k) {
        J::Kind::A => { 1 }
        J::Kind::B => { 2 }
    };
    if (n != 2) { return 4; }
    if (J::LIMIT != 7) { return 5; }
    const f: (i32) -> i32 = J::twice;
    if (f(5) != 10) { return 6; }
    if (In::deep() != 42) { return 7; }
    if (F::one() != 1) { return 8; }
    return 0;
}
