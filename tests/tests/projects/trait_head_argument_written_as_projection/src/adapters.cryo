namespace Main::Adapters;

import std::core::iter::{ Iterator };

public type trait Lookahead<T> : Iterator<T> {
    peek(mut &this) -> Option<const T*>;
}

public type struct Ahead<I> where I: Iterator {
    inner: I;
    peeked: Option<I::Item>;
    has_peeked: boolean;
}

// The head writes `Lookahead`'s plain parameter as `I::Item`.
implement<I> trait Lookahead<I::Item> for struct Ahead<I>
where I: Iterator {
    peek(mut &this) -> Option<const I::Item*> {
        if (!this.has_peeked) {
            this.peeked = this.inner.next();
            this.has_peeked = true;
        }
        return this.peeked.as_ref();
    }
}

implement<I> trait Iterator<I::Item> for struct Ahead<I>
where I: Iterator {
    next(mut &this) -> Option<I::Item> {
        if (this.has_peeked) {
            this.has_peeked = false;
            return this.peeked.take();
        }
        return this.inner.next();
    }
}

public function ahead_of<I>(inner: I) -> Ahead<I> where I: Iterator {
    return Ahead { inner: inner, peeked: Option::None, has_peeked: false };
}

/// Counts down from `from` to 1.
public type struct Countdown {
    from: i64;
}

implement trait Iterator<i64> for struct Countdown {
    next(mut &this) -> Option<i64> {
        if (this.from == 0) { return Option::None; }
        this.from = this.from - 1;
        return Option::Some(this.from + 1);
    }
}
