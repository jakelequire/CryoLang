namespace Main;

import Main::Adapters::{ Lookahead, Countdown, ahead_of };

// Skips the elements below `limit` without taking the first one at or
// above it.
function skip_while_below<P>(source: mut &P, limit: i64) -> void where P: Lookahead<i64> {
    loop {
        match (source.peek()) {
            Option::Some(value) => {
                if (*value >= limit) { return; }
            }
            Option::None => { return; }
        }
        source.next();
    }
}

function main() -> i32 {
    const range: Range<i64> = 0..10;
    // The locals' types are inferred from the call: the instance the bound
    // is checked on is the one `ahead_of` returns.
    mut ahead = ahead_of(range);
    skip_while_below(&ahead, 4);
    if (ahead.next().unwrap() != 4) { return 1; }

    mut counting = ahead_of(Countdown { from: 9 });
    skip_while_below(&counting, 0);
    if (counting.next().unwrap() != 9) { return 2; }
    if (*counting.peek().unwrap() != 8) { return 3; }
    if (counting.next().unwrap() != 8) { return 4; }
    return 0;
}
