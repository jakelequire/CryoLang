namespace OperatorBoundFix::Main;

// An operator on a type parameter its bounds do not license carries the fix
// that adds the bound to the function's `where` clause: a new clause, another
// bound of an existing one, or `+` after the parameter's own bound.

// Two operators one bound licenses: one report.
function largest<T>(a: T, b: T) -> T {
    if (a > b) { return a; }
    if (b < a) { return b; }
    return b;
}

// A clause naming another parameter gets the bound after its last one.
function same<T, U>(a: T, b: T, u: U) -> boolean where U: Clone {
    return a == b;
}

// The parameter's own bound is extended.  `Add` takes the right operand's
// type and the result's; the result is guessed, so the fix may be wrong.
function sum<T>(a: T, b: T) -> T where T: Clone {
    return a + b;
}

// A unary operator's trait takes the result's type alone.
function negate<T>(a: T) -> T {
    return -a;
}

// A method of a generic type bounds its owner's parameter on itself.
type struct Holder<T> {
    value: T;

    less(&this, other: T) -> boolean {
        return this.value < other;
    }
}

function main() -> i32 {
    return 0;
}
