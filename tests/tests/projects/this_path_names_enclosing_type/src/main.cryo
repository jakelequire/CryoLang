namespace ThisPathNamesEnclosingType::Main;

type struct Plain {
    v: i32;
    static make(v: i32) -> Plain { return Plain { v: v }; }
    doubled(&this) -> Plain { return This::make(this.v * 2); }
}

type struct Two<A, B> { a: A; b: B; }

implement struct Two<A, B> {
    static of(a: A, b: B) -> Two<A, B> { return Two::<A, B> { a: a, b: b }; }
    swapped_first(&this, a: A) -> Two<A, B> { return This::of(a, this.b); }
}

type enum Shade { Light; Dark; }

implement enum Shade {
    static dark() -> Shade { return This::Dark; }
    flipped(&this) -> Shade {
        return match (*this) {
            Shade::Light => { This::dark() }
            Shade::Dark  => { This::Light }
        };
    }
}

function main() -> i32 {
    if (Plain::make(4).doubled().v != 8) { return 1; }
    const t: Two<i32, i64> = Two::<i32, i64>::of(1, 9 as i64);
    const u: Two<i32, i64> = t.swapped_first(5);
    if (u.a != 5 || u.b != 9) { return 2; }
    const s: Shade = Shade::Light;
    match (s.flipped()) {
        Shade::Dark  => { }
        Shade::Light => { return 3; }
    }
    match (Shade::dark().flipped()) {
        Shade::Light => { }
        Shade::Dark  => { return 4; }
    }
    return 0;
}
