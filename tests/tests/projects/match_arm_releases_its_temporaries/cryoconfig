# match_arm_releases_its_temporaries - a `match` arm releases the
# temporaries its value borrows when the arm ends, before its own locals;
# an `if` branch's join the enclosing statement (outcome = "run").
#
# The program exits 0 when every release order holds, and with the number
# of the first that does not otherwise.  interpret_match_arm_releases_its_
# temporaries runs the same source through `cryo interpret`.

[project]
project_name = "match_arm_releases_its_temporaries"
output_dir   = "build"
target_type  = "executable"
source_dir   = "src"
entry_point  = "src/main.cryo"

