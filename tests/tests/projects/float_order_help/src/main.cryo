// A float is not `Ord`: a NaN is unordered against every value.  Each call
// that needs `Ord` of a float, or of a reference to one, is refused with a
// help naming `total_compare` in a comparator, never one advising an
// implementation of `Ord` for the float.  A generic function's bound is
// checked once these are settled, so float_order_help_bound holds that one.
namespace FloatOrderHelp;

function main() -> i32 {
    mut values: [f64] = [1.5, 0.5];
    values.sort();
    const lowest: Option<f64> = values.iter().min();
    const a: f64 = 1.0;
    const b: f64 = 2.0;
    const order: Ordering = a.compare(&b);
    mut references: [&f64] = [&a, &b];
    references.sort();
    return 0;
}
