///! A fixed array has the slice methods a container has: `as_slice()` on a
///! fixed array, or on a reference to one, gives the `&Slice<T>` over its
///! elements, and `as_mutable_slice()` on a writable array, or through a
///! writable reference, the `mut &Slice<T>` that writes them.  The compiler
///! answers both, as it answers the conversion, so neither needs its trait
///! in scope and a `[T; 0]` gives the empty slice.

![config(testing)]
namespace FixedArraySliceMethods::Tests;

import std::core::result::{ Result };
import std::core::slice::{ Slice };
import std::test::error::{ TestError };
import std::test::assert::{ expect_eq };

function total(items: &Slice<i32>) -> i64 {
    mut sum: i64 = 0;
    for (mut i: i64 = 0; i < items.length(); i++) {
        sum += items[i] as i64;
    }
    return sum;
}

function view_of<T>(values: &[T; 2]) -> &Slice<T> {
    return values.as_slice();
}

function zero_through(values: mut &[i32; 3]) -> void {
    const writer: mut &Slice<i32> = values.as_mutable_slice();
    writer[1] = 0;
}

![test]
function as_slice_views_every_element() -> Result<(), TestError> {
    const values: [i32; 3] = [1, 2, 3];
    const view: &Slice<i32> = values.as_slice();
    expect_eq(view.length(), 3)?;
    return expect_eq(view[2], 3);
}

![test]
function as_slice_result_is_an_argument_and_a_receiver() -> Result<(), TestError> {
    const values: [i32; 4] = [1, 2, 3, 4];
    expect_eq(total(values.as_slice()), 10)?;
    return expect_eq(values.as_slice().length(), 4);
}

![test]
function as_slice_through_a_reference() -> Result<(), TestError> {
    const values: [u64; 2] = [5, 6];
    const reference: &[u64; 2] = &values;
    return expect_eq(reference.as_slice()[1], 6);
}

![test]
function as_mutable_slice_writes_the_array() -> Result<(), TestError> {
    mut values: [i32; 3] = [1, 2, 3];
    const writer: mut &Slice<i32> = values.as_mutable_slice();
    writer[0] = 10;
    expect_eq(values[0], 10)?;
    return expect_eq(values.as_slice()[0], 10);
}

![test]
function as_mutable_slice_through_a_writable_reference() -> Result<(), TestError> {
    mut values: [i32; 3] = [1, 2, 3];
    zero_through(&values);
    return expect_eq(values[1], 0);
}

![test]
function as_slice_in_a_generic_body() -> Result<(), TestError> {
    const values: [u8; 2] = [7, 9];
    const view: &Slice<u8> = view_of(&values);
    const nine: u8 = 9;
    return expect_eq(view[1], nine);
}

![test]
function as_slice_of_an_empty_array() -> Result<(), TestError> {
    const values: [i32; 0] = [];
    return expect_eq(values.as_slice().length(), 0);
}

![test]
function for_over_as_slice() -> Result<(), TestError> {
    const values: [i32; 3] = [4, 5, 6];
    mut sum: i32 = 0;
    for (value in values.as_slice()) {
        sum += value;
    }
    return expect_eq(sum, 15);
}
