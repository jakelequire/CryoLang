# impl_qualified_call - `(Trait for Type)::member` names the member of THAT
# trait's implementation for the type, where the bare `Type::member` ties
# between two traits providing it (E0156).  One rule for every shape the
# tie can take: a static method (`(Beta for P)::make()`, which no receiver
# could select), a method with a receiver (`(Beta for P)::go(&p)`), the
# form inside a generic body over a parameter (`(Beta for T)::make()`,
# instantiated with a type both traits are implemented for), a method
# taken as a value (`(Gamma for P)::make`), and a generic owner
# (`(Beta for Wrap<i32>)::make()`).  Each call runs the named trait's
# body; the exit code sums them.  The head reuses `for` exactly as
# `implement trait Beta for P` does, and a compiler without the form
# refuses the file at `for` (E0100).
[project]
project_name = "impl_qualified_call"
output_dir   = "build"
target_type  = "executable"
source_dir   = "src"
entry_point  = "src/main.cryo"
[compiler]
[dependencies]
