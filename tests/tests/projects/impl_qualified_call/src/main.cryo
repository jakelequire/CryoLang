namespace ImplQualified::Main;

type trait Beta {
    go(&this) -> i32;
    static make() -> i32;
}

type trait Gamma {
    go(&this) -> i32;
    static make() -> i32;
}

type struct P {
    v: i32;
}

implement trait Beta for P {
    go(&this) -> i32 { return this.v * 2; }
    static make() -> i32 { return 2; }
}

implement trait Gamma for P {
    go(&this) -> i32 { return this.v * 5; }
    static make() -> i32 { return 5; }
}

type struct Wrap<T> {
    v: T;
}

implement<T> trait Beta for Wrap<T> {
    go(&this) -> i32 { return 7; }
    static make() -> i32 { return 7; }
}

implement<T> trait Gamma for Wrap<T> {
    go(&this) -> i32 { return 9; }
    static make() -> i32 { return 9; }
}

// Inside a generic body the target is the parameter; the concrete type it
// is instantiated with may implement both traits, and the head still
// names one.  `T::make()` alone is the E0156 tie once `T = P`.
function beta_of<T>() -> i32 where T: Beta {
    return (Beta for T)::make();
}

function gamma_of<T>() -> i32 where T: Gamma {
    return (Gamma for T)::make();
}

function main() -> int {
    const p: P = P { v: 1 };
    const w: Wrap<i32> = Wrap<i32> { v: 1 };
    const s_b: i32 = (Beta for P)::make();          // 2
    const s_g: i32 = (Gamma for P)::make();         // 5
    const r_b: i32 = (Beta for P)::go(&p);          // 2
    const r_g: i32 = (Gamma for P)::go(&p);         // 5
    const g_b: i32 = beta_of<P>();                  // 2
    const g_g: i32 = gamma_of<P>();                 // 5
    const f: () -> i32 = (Gamma for P)::make;
    const v_g: i32 = f();                           // 5
    const o_b: i32 = (Beta for Wrap<i32>)::make();  // 7
    const o_g: i32 = (Gamma for Wrap<i32>)::go(&w); // 9
    // 2 + 5 + 2 + 5 + 2 + 5 + 5 + 7 + 9 = 42
    return s_b + s_g + r_b + r_g + g_b + g_g + v_g + o_b + o_g;
}
