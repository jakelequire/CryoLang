namespace GroupedReportId::Main;

// The changes one method makes through a read-only `&this` are one problem:
// one report, named, with a caret at each place and the one fix.  The name
// is the same for the same source, so it can be pinned here.

type struct Bus {
    next_id: i32;
    listeners: [i32];

    subscribe(&this, listener: i32) -> i32 {
        this.next_id = this.next_id + 1;
        this.listeners.push(listener);
        return this.next_id;
    }
}

// A single place is no folded report, and is not named.
function lone() -> i32 {
    const count: i32 = 3;
    count = 4;
    return count;
}

function main() -> i32 {
    return lone();
}
