namespace TieHelp::Main;

type trait Beta {
    go(&this) -> i32;
    static make() -> i32;
}

type trait Gamma {
    go(&this) -> i32;
    static make() -> i32;
}

type struct P {
    v: i32;
}

implement trait Beta for P {
    go(&this) -> i32 { return this.v * 2; }
    static make() -> i32 { return 2; }
}

implement trait Gamma for P {
    go(&this) -> i32 { return this.v * 5; }
    static make() -> i32 { return 5; }
}

function main() -> int {
    const p: P = P { v: 1 };
    const a: i32 = p.go();
    const b: i32 = P::go(&p);
    const c: i32 = P::make();
    return a + b + c;
}
