# impl_qualified_call_tie_help - E0156's help names the impl-qualified
# path, `(Trait for Type)::member(args)`, and the same form in each of the
# tie's three spellings: a method call on a receiver (`p.go()`, the
# receiver quoted as the first argument), a static path with a receiver
# argument (`P::go(&p)`) and one with none (`P::make()`, where no receiver
# could select and the help used to say the language had no form).  A
# negative pins a code and a message, not a help line, so the help is
# pinned here by its text.
[project]
project_name = "impl_qualified_call_tie_help"
output_dir   = "build"
target_type  = "executable"
source_dir   = "src"
entry_point  = "src/main.cryo"
[compiler]
[dependencies]
