namespace PanicReportsColumnAndFunction;

import std::fmt;

type struct Ratio {
    num: i32;
    den: i32;

    whole(&this) -> i32 {
        return this.num / this.den;
    }
}

function main() -> int {
    const r: Ratio = Ratio { num: 7, den: 0 };
    fmt::println("before");
    fmt::println(f"{r.whole()}");
    fmt::println("after");
    return 0;
}
