namespace ClosureMoveFixes;

type struct Res {
    tag: i32;
}

implement trait Drop for struct Res {
    drop(mut &this) -> void { }
}

function consume(r: Res) -> i32 { return r.tag; }

function borrowed_then_moved() -> i32 {
    const p: Res = Res { tag: 1 };
    const f = () -> i32 { return p.tag; };
    const n: i32 = consume(p);
    return n + f();
}

function moved_into_closure_then_used() -> i32 {
    const q: Res = Res { tag: 2 };
    const g = move () -> i32 { return q.tag; };
    return g() + consume(q);
}

function main() -> i32 {
    return borrowed_then_moved() + moved_into_closure_then_used();
}
