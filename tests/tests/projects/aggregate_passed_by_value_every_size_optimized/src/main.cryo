type struct B16 {
    v: [u8; 16];
    ![noinline] static make(seed: u8) -> B16 { mut made: B16 = B16 { v: [0; 16] }; for (mut i: i64 = 0; i < 16; i++) { made.v[i] = seed + (i as u8); } return made; }
    ![noinline] weigh(this) -> u64 { mut total: u64 = 0; for (mut i: i64 = 0; i < 16; i++) { total = total + ((i + 1) as u64) * (this.v[i] as u64); } return total; }
    ![noinline] static pass(before: i64, value: B16, after: i64) -> u64 { return value.weigh() + (before as u64) + (after as u64); }
}

// A generic instance is passed and returned by value as its layout is.
type struct Carrier<T> {
    value: T;

    ![noinline] static echo(carrier: Carrier<T>) -> Carrier<T> { return carrier; }
}

// Fields of different widths with padding between them: 6 bytes.
type struct Mixed {
    small: i8;
    middle: i16;
    flag: boolean;

    ![noinline] static make(seed: u8) -> Mixed { return Mixed { small: seed as i8, middle: (seed as i16) * 300, flag: seed > 1 }; }
    ![noinline] weigh(this) -> u64 { return (this.small as u64) + (this.middle as u64) * 7 + if (this.flag) { 1000 } else { 2000 }; }
}

// Aggregates inside an aggregate: 12 bytes, the last eight-byte half 4 bytes.
type struct Nested {
    left: B3;
    right: B2;
    tail: Mixed;

    ![noinline] static make(seed: u8) -> Nested { return Nested { left: B3::make(seed), right: B2::make(seed + 1), tail: Mixed::make(seed + 2) }; }
    ![noinline] weigh(this) -> u64 { return this.left.weigh() * 3 + this.right.weigh() * 5 + this.tail.weigh(); }
}

// An enum whose largest variant holds 2 bytes, and one whose largest holds 7.
type enum Small {
    Pair(u8, u8);
    Nothing;
}

type enum Parcel {
    Three(B3);
    Five(B5);
    Six(B6);
    Seven(B7);
    Empty;
}

implement enum Small {
    ![noinline] static make(seed: u8) -> Small { return Small::Pair(seed, seed + 5); }
    ![noinline] weigh(this) -> u64 {
        return match (this) {
            Small::Pair(first, second) => { (first as u64) + (second as u64) * 3 }
            Small::Nothing => { 0 }
        };
    }
}

implement enum Parcel {
    ![noinline] static make(seed: u8, which: i64) -> Parcel {
        return match (which) {
            3 => { Parcel::Three(B3::make(seed)) }
            5 => { Parcel::Five(B5::make(seed)) }
            6 => { Parcel::Six(B6::make(seed)) }
            7 => { Parcel::Seven(B7::make(seed)) }
            _ => { Parcel::Empty }
        };
    }
    ![noinline] weigh(this) -> u64 {
        return match (this) {
            Parcel::Three(b) => { b.weigh() }
            Parcel::Five(b) => { b.weigh() }
            Parcel::Six(b) => { b.weigh() }
            Parcel::Seven(b) => { b.weigh() }
            Parcel::Empty => { 0 }
        };
    }
    ![noinline] static pass(before: i64, value: Parcel, after: i64) -> u64 { return value.weigh() + (before as u64) + (after as u64); }
}

function main() -> i32 {
    // A seed the optimizer cannot see, so every call is made with it.
    const seed: u8 = (env::args().length() as u8) + 2;

    Ledger::check("make 1", B1::make(seed).weigh(), Ledger::expected(1, seed));
    Ledger::check("make 2", B2::make(seed).weigh(), Ledger::expected(2, seed));
    Ledger::check("make 3", B3::make(seed).weigh(), Ledger::expected(3, seed));
    Ledger::check("make 4", B4::make(seed).weigh(), Ledger::expected(4, seed));
    Ledger::check("make 5", B5::make(seed).weigh(), Ledger::expected(5, seed));
    Ledger::check("make 6", B6::make(seed).weigh(), Ledger::expected(6, seed));
    Ledger::check("make 7", B7::make(seed).weigh(), Ledger::expected(7, seed));
    Ledger::check("make 8", B8::make(seed).weigh(), Ledger::expected(8, seed));
    Ledger::check("make 9", B9::make(seed).weigh(), Ledger::expected(9, seed));
    Ledger::check("make 10", B10::make(seed).weigh(), Ledger::expected(10, seed));
    Ledger::check("make 11", B11::make(seed).weigh(), Ledger::expected(11, seed));
    Ledger::check("make 12", B12::make(seed).weigh(), Ledger::expected(12, seed));
    Ledger::check("make 13", B13::make(seed).weigh(), Ledger::expected(13, seed));
    Ledger::check("make 14", B14::make(seed).weigh(), Ledger::expected(14, seed));
    Ledger::check("make 15", B15::make(seed).weigh(), Ledger::expected(15, seed));
    Ledger::check("make 16", B16::make(seed).weigh(), Ledger::expected(16, seed));

    Ledger::check("pass 1", B1::pass(1000, B1::make(seed), 2000), Ledger::expected(1, seed) + 3000);
    Ledger::check("pass 2", B2::pass(1000, B2::make(seed), 2000), Ledger::expected(2, seed) + 3000);
    Ledger::check("pass 3", B3::pass(1000, B3::make(seed), 2000), Ledger::expected(3, seed) + 3000);
    Ledger::check("pass 4", B4::pass(1000, B4::make(seed), 2000), Ledger::expected(4, seed) + 3000);
    Ledger::check("pass 5", B5::pass(1000, B5::make(seed), 2000), Ledger::expected(5, seed) + 3000);
    Ledger::check("pass 6", B6::pass(1000, B6::make(seed), 2000), Ledger::expected(6, seed) + 3000);
    Ledger::check("pass 7", B7::pass(1000, B7::make(seed), 2000), Ledger::expected(7, seed) + 3000);
    Ledger::check("pass 8", B8::pass(1000, B8::make(seed), 2000), Ledger::expected(8, seed) + 3000);
    Ledger::check("pass 9", B9::pass(1000, B9::make(seed), 2000), Ledger::expected(9, seed) + 3000);
    Ledger::check("pass 10", B10::pass(1000, B10::make(seed), 2000), Ledger::expected(10, seed) + 3000);
    Ledger::check("pass 11", B11::pass(1000, B11::make(seed), 2000), Ledger::expected(11, seed) + 3000);
    Ledger::check("pass 12", B12::pass(1000, B12::make(seed), 2000), Ledger::expected(12, seed) + 3000);
    Ledger::check("pass 13", B13::pass(1000, B13::make(seed), 2000), Ledger::expected(13, seed) + 3000);
    Ledger::check("pass 14", B14::pass(1000, B14::make(seed), 2000), Ledger::expected(14, seed) + 3000);
    Ledger::check("pass 15", B15::pass(1000, B15::make(seed), 2000), Ledger::expected(15, seed) + 3000);
    Ledger::check("pass 16", B16::pass(1000, B16::make(seed), 2000), Ledger::expected(16, seed) + 3000);

    // A local passed by value, read again afterwards: the call may not
    // write past the copy it was given.
    const local3: B3 = B3::make(seed);
    const guard3: B3 = B3::make(seed + 1);
    Ledger::check("local 3", B3::pass(0, local3, 0), Ledger::expected(3, seed));
    Ledger::check("local 3 again", local3.weigh() + guard3.weigh(), Ledger::expected(3, seed) + Ledger::expected(3, seed + 1));
    const local6: B6 = B6::make(seed);
    const guard6: B6 = B6::make(seed + 1);
    Ledger::check("local 6", B6::pass(0, local6, 0), Ledger::expected(6, seed));
    Ledger::check("local 6 again", local6.weigh() + guard6.weigh(), Ledger::expected(6, seed) + Ledger::expected(6, seed + 1));
    const local13: B13 = B13::make(seed);
    const guard13: B13 = B13::make(seed + 1);
    Ledger::check("local 13", B13::pass(0, local13, 0), Ledger::expected(13, seed));
    Ledger::check("local 13 again", local13.weigh() + guard13.weigh(), Ledger::expected(13, seed) + Ledger::expected(13, seed + 1));

    Ledger::check("carrier 3", Carrier::<B3>::echo(Carrier { value: B3::make(seed) }).value.weigh(), Ledger::expected(3, seed));
    Ledger::check("carrier 5", Carrier::<B5>::echo(Carrier { value: B5::make(seed) }).value.weigh(), Ledger::expected(5, seed));
    Ledger::check("carrier 6", Carrier::<B6>::echo(Carrier { value: B6::make(seed) }).value.weigh(), Ledger::expected(6, seed));
    Ledger::check("carrier 7", Carrier::<B7>::echo(Carrier { value: B7::make(seed) }).value.weigh(), Ledger::expected(7, seed));
    Ledger::check("carrier 11", Carrier::<B11>::echo(Carrier { value: B11::make(seed) }).value.weigh(), Ledger::expected(11, seed));
    Ledger::check("carrier 14", Carrier::<B14>::echo(Carrier { value: B14::make(seed) }).value.weigh(), Ledger::expected(14, seed));

    const mixed_want: u64 = (seed as u64) + (seed as u64) * 300 * 7 + 1000;
    Ledger::check("mixed", Mixed::make(seed).weigh(), mixed_want);
    Ledger::check("nested", Nested::make(seed).weigh(),
        Ledger::expected(3, seed) * 3 + Ledger::expected(2, seed + 1) * 5 + ((seed as u64) + 2) + ((seed as u64) + 2) * 300 * 7 + 1000);

    Ledger::check("small enum", Small::make(seed).weigh(), (seed as u64) + ((seed as u64) + 5) * 3);
    Ledger::check("parcel 3", Parcel::pass(10, Parcel::make(seed, 3), 20), Ledger::expected(3, seed) + 30);
    Ledger::check("parcel 5", Parcel::pass(10, Parcel::make(seed, 5), 20), Ledger::expected(5, seed) + 30);
    Ledger::check("parcel 6", Parcel::pass(10, Parcel::make(seed, 6), 20), Ledger::expected(6, seed) + 30);
    Ledger::check("parcel 7", Parcel::pass(10, Parcel::make(seed, 7), 20), Ledger::expected(7, seed) + 30);

    const weigh_three: (B3) -> u64 = (p: B3) -> u64 { return p.weigh(); };
    Ledger::check("closure 3", weigh_three(B3::make(seed)), Ledger::expected(3, seed));
    const weigh_eleven: (B11) -> u64 = (p: B11) -> u64 { return p.weigh(); };
    Ledger::check("closure 11", weigh_eleven(B11::make(seed)), Ledger::expected(11, seed));
    const captured: B5 = B5::make(seed);
    const read_captured =() -> u64 { return captured.weigh(); };
    Ledger::check("captured 5", read_captured(), Ledger::expected(5, seed));

    fmt::println(f"by-value aggregates: {wrong} wrong of {checked}");
    return 0;
}
