namespace Main;

import std::fmt;
import std::env;
import std::collections::str::{ Str };

// An aggregate passed or returned by value travels in registers when it is
// at most 16 bytes, as one integer per eight bytes on Linux. Each size from
// 1 to 16 is passed as a parameter (alone and between two others), returned,
// taken as a by-value receiver, carried by a generic struct, held by an enum
// variant, nested in a struct and passed to a closure; each must arrive with
// every byte it was given, and nothing beside it may be overwritten.

mut checked: i64 = 0;
mut wrong: i64 = 0;

type struct Ledger {
    static check(label: Str, got: u64, want: u64) -> void {
        checked = checked + 1;
        if (got != want) {
            wrong = wrong + 1;
            fmt::println(f"wrong: {label} read {got}, expected {want}");
        }
    }

    // What `make(seed)` of an aggregate of `size` bytes weighs.
    static expected(size: i64, seed: u8) -> u64 {
        mut total: u64 = 0;
        for (mut i: i64 = 0; i < size; i++) {
            total = total + ((i + 1) as u64) * (((seed as i64) + i) as u64);
        }
        return total;
    }
}

type struct B1 {
    v: [u8; 1];
    ![noinline] static make(seed: u8) -> B1 { mut made: B1 = B1 { v: [0; 1] }; for (mut i: i64 = 0; i < 1; i++) { made.v[i] = seed + (i as u8); } return made; }
    ![noinline] weigh(this) -> u64 { mut total: u64 = 0; for (mut i: i64 = 0; i < 1; i++) { total = total + ((i + 1) as u64) * (this.v[i] as u64); } return total; }
    ![noinline] static pass(before: i64, value: B1, after: i64) -> u64 { return value.weigh() + (before as u64) + (after as u64); }
}

