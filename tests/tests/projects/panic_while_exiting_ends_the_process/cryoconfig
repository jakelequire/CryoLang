# panic_while_exiting_ends_the_process - a panic raised by an atexit handler
# while the `exit` a first panic called is running writes its report and ends
# the process with the panic exit code at once: `exit` is not entered again,
# and the handlers still queued do not run.

[project]
project_name = "panic_while_exiting_ends_the_process"
output_dir   = "build"
target_type  = "executable"
source_dir   = "src"
entry_point  = "src/main.cryo"

[compiler]
panic = "abort"

[dependencies]
