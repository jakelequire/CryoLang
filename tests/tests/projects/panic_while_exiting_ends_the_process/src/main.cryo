namespace PanicWhileExitingEndsTheProcess;

import std::core::intrinsics;
import std::ffi::libc;

/// Run by the `exit` the first panic ends the process through: the second
/// panic is raised on the same thread while that `exit` is under way, and
/// `exit` must not be entered again.
function panic_at_exit() -> void {
    intrinsics::panic("the second panic, raised while the process exits", intrinsics::location());
}

/// Registered first, so `exit` would run it after the panicking handler. It
/// must never run: the second panic ends the process at once.
function after_the_second_panic() -> void {
    intrinsics::panic("an exit handler ran after the second panic", intrinsics::location());
}

function main() -> int {
    libc::atexit(after_the_second_panic as void*);
    libc::atexit(panic_at_exit as void*);
    intrinsics::panic("the first panic", intrinsics::location());
}
