// A trait default the object's table cannot hold - one with a type parameter
// of its own, or one returning `This` by value - called through
// `virtual mut &Iterator<i32>` in generic code: the default is compiled once
// for the object, with `This` the object, and in it each call on the object
// goes through the object's table.  Two modules ask for the same `map`.  A
// type's own `fold` is reached directly and under a bound, and the trait's
// default through the object.
namespace IteratorDefaultThroughObject::Main;

import std::core::iter::{ Iterator };
import IteratorDefaultThroughObject::sums::{
    Ignoring, Up, add, folded, is_odd, sum_doubled, sum_doubled_in_for, sum_doubled_object
};

type struct Odds<I> {
    source: I;

    count_odd(this) -> u64 where I: Iterator<i32> {
        return this.source.filter(is_odd).count();
    }
}

function first_three<I>(it: I) -> u64 where I: Iterator<i32> {
    return it.take(3).count();
}

function main() -> i32 {
    mut a: Up = Up { cur: 0, end: 4 };
    const oa: virtual mut &Iterator<i32> = &a;
    if (sum_doubled(oa) != 12) { return 1; }

    mut b: Up = Up { cur: 1, end: 4 };
    if (sum_doubled_object(&b) != 12) { return 2; }

    mut c: Up = Up { cur: 0, end: 5 };
    const oc: virtual mut &Iterator<i32> = &c;
    const odds: Odds<virtual mut &Iterator<i32>> = Odds { source: oc };
    if (odds.count_odd() != 2) { return 3; }

    mut d: Up = Up { cur: 0, end: 10 };
    const od: virtual mut &Iterator<i32> = &d;
    if (first_three(od) != 3) { return 4; }
    if (d.cur != 3) { return 5; }

    mut e: Up = Up { cur: 0, end: 4 };
    const oe: virtual mut &Iterator<i32> = &e;
    if (sum_doubled_in_for(oe) != 12) { return 6; }

    mut f: Ignoring = Ignoring { cur: 1, end: 4 };
    if (f.fold(0, add) != 0) { return 7; }
    if (folded(Ignoring { cur: 1, end: 4 }) != 0) { return 8; }
    mut g: Ignoring = Ignoring { cur: 1, end: 4 };
    const og: virtual mut &Iterator<i32> = &g;
    if (folded(og) != 6) { return 9; }
    return 0;
}
