namespace IteratorDefaultThroughObject::sums;

import std::core::option::{ Option };
import std::core::iter::{ Iterator };

type struct Up {
    cur: i32;
    end: i32;
}

implement trait Iterator<i32> for struct Up {
    next(mut &this) -> Option<i32> {
        if (this.cur >= this.end) { return Option::None; }
        const v: i32 = this.cur;
        this.cur = this.cur + 1;
        return Option::Some(v);
    }
}

/// Writes its own `fold`, which ignores the items.
type struct Ignoring {
    cur: i32;
    end: i32;
}

implement trait Iterator<i32> for struct Ignoring {
    next(mut &this) -> Option<i32> {
        if (this.cur >= this.end) { return Option::None; }
        const v: i32 = this.cur;
        this.cur = this.cur + 1;
        return Option::Some(v);
    }

    fold<Acc>(mut &this, initial: Acc, f: (Acc, i32) -> Acc) -> Acc {
        return initial;
    }
}

function double_it(x: i32) -> i32 { return x * 2; }
function add(acc: i32, x: i32) -> i32 { return acc + x; }
function is_odd(x: &i32) -> boolean { return *x % 2 == 1; }

function sum_doubled<I>(it: I) -> i32 where I: Iterator<i32> {
    mut doubled = it.map(double_it);
    mut sum: i32 = 0;
    loop {
        match (doubled.next()) {
            Option::Some(v) => { sum = sum + v; }
            Option::None => { break; }
        }
    }
    return sum;
}

function sum_doubled_in_for<I>(it: I) -> i32 where I: Iterator<i32> {
    mut sum: i32 = 0;
    for (v in it.map(double_it)) { sum = sum + v; }
    return sum;
}

function folded<I>(mut it: I) -> i32 where I: Iterator<i32> {
    return it.fold(0, add);
}

/// The same instance of `map` the main module asks for, asked from here.
function sum_doubled_object(o: virtual mut &Iterator<i32>) -> i32 {
    return sum_doubled(o);
}
