/// Inside the body that declares it, a type parameter with no bound has no
/// methods, and `drop` is no exception: `(*p).drop()` names nothing and is
/// refused where it is written.  A value of any type is released in place
/// through `std::core::ptr::drop_in_place`, which needs no bound.
namespace DropOnUnboundedParamRefused::Main;

import std::core::ptr;

function release_by_method<T>(p: T*) -> void {
    (*p).drop();
}

function release_in_place<T>(p: T*) -> void {
    ptr::drop_in_place::<T>(p);
}

function main() -> i32 {
    return 0;
}
