# inherent_method_over_trait - an inherent method wins over a trait impl's
# method of the same name, whatever order the two `implement` blocks were
# written in and whether the receiver or the method is generic.
#
# Every receiver here has an inherent `go` returning 1 and a `Beta::go`
# returning 2, and each of the four shapes (plain type or generic type,
# plain method or generic method) is written twice: once with the trait
# block FIRST, once with it second.  Each selector used to walk its store
# in registration order and bind whichever `go` it met first - sema's
# `select_method` over the type's folded method list, its generic-method
# finder over the template's impl blocks and the trait registry, and the
# monomorphizer's spec-impl lookup - so the trait-first spellings ran the
# trait's body for a call the source bound to the inherent one, and a
# generic method on a plain type reached the trait registry before the
# inherent owner in both orders.
#
# A call made THROUGH a bound (`via_bound<T>` under `where T: Beta`) names
# the trait's method and must still reach it, inherent `go` or not.
#
# stdout is the assertion: nine `=1` fields and two `bound=2` fields on one
# line, the ninth a type whose inherent `go` sits between two traits' `go`,
# which the argument check once called ambiguous (E0154).

[project]
project_name = "inherent_method_over_trait"
output_dir   = "build"
target_type  = "executable"
source_dir   = "src"
entry_point  = "src/main.cryo"

