# dependency_git_url_accepted - every URL form a git dependency may use is
# accepted when the cryoconfig is read, so the build goes on to the lock,
# which pins none of them: each is reported as not pinned, and none as
# refused.  No git process starts and nothing is fetched.
[project]
project_name = "dependency_git_url_accepted"
output_dir   = "build"
target_type  = "executable"
source_dir   = "src"
entry_point  = "src/main.cryo"

[compiler]

[dependencies]
over_https = { git = "https://example.com/acme/one.git", tag = "v1.0.0" }
over_ssh   = { git = "ssh://git@example.com/acme/two.git", branch = "main" }
scp_form   = { git = "git@example.com:acme/three.git", version = "1.0.0" }
local_repo = { git = "file:///srv/git/four.git", rev = "4f1c0d2e6b7a8c9d0e1f2a3b4c5d6e7f8a9b0c1d" }
