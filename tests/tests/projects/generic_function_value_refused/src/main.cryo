namespace GenericFunctionValueRefused;

type trait Twice { twice(&this) -> i32; }
type struct Plain { n: i32; }

function idf<T>(x: T) -> T { return x; }
function use_twice<T>(x: &T) -> i32 where T: Twice { return x.twice(); }

type struct Wrap<T> { v: T; }
implement<T> struct Wrap<T> {
    get(&this) -> T { return this.v; }
}

function main() -> i32 {
    const g = idf;
    const w = Wrap::get;
    const f: (&Plain) -> i32 = use_twice;
    return 0;
}
