// A call refused for an unmet bound shows the bound in the file that
// declares it under the line naming the function the bound is on, so the
// reader sees whose bound it is; lines between the two are elided.
namespace BoundReportShowsSignature::Main;

import BoundReportShowsSignature::Lib;

type struct Person {
    age: i64;
}

function main() -> i32 {
    const p: Person = Person { age: 1 };
    return (Lib::described(&p) + Lib::spread(&p, &p)) as i32;
}
