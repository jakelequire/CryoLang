// Two generic functions whose bound a call does not meet, the bound on a
// line of its own: one right under the signature, one below a parameter
// list written over several lines.
namespace BoundReportShowsSignature::Lib;

import std::fmt::display::{ Debug };

public function described<T>(value: &T) -> i64
where T: Debug {
    return 1;
}

public function spread<T>(
    first: &T,
    second: &T
) -> i64
where T: Debug {
    return 2;
}
