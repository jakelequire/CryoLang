// A fixed array has `Eq`, `Ord` and `Hash` when its element does, in a
// generic body copied for the array as much as where the call is written:
// the call is made on the slice over the elements.  `Ord` is lexicographic,
// and a prefix orders first.

import std::core::cmp::{ Eq, Ord, Ordering };
import std::core::hash::{ Hash, Hasher, FnvHasher };

function same<T: Eq>(a: &T, b: &T) -> boolean {
    return a.equals(b);
}

function order<T: Ord>(a: &T, b: &T) -> Ordering {
    return a.compare(b);
}

function hash_of<T: Hash>(value: &T) -> u64 {
    mut hasher: FnvHasher = FnvHasher::new();
    value.hash(&hasher);
    return hasher.finish();
}

type struct Key with [Eq, Ord, Hash] {
    bytes: [u8; 4];
    tag: i32;
}

function main() -> i32 {
    const a: [u8; 4] = [1, 2, 3, 4];
    const b: [u8; 4] = [1, 2, 3, 4];
    const c: [u8; 4] = [1, 2, 9, 0];

    // Written on the array.
    if (!a.equals(&b)) { return 1; }
    if (a.equals(&c)) { return 2; }
    if (!a.compare(&c).is_lt()) { return 3; }

    // In a generic body copied for the array.
    if (!same(&a, &b)) { return 4; }
    if (same(&a, &c)) { return 5; }
    if (!order(&a, &c).is_lt()) { return 6; }
    if (!order(&c, &a).is_gt()) { return 7; }
    if (!order(&a, &b).is_le() || !order(&a, &b).is_ge()) { return 8; }
    if (hash_of(&a) != hash_of(&b)) { return 9; }
    if (hash_of(&a) == hash_of(&c)) { return 10; }

    // An element type with its own implementations.
    const words: [i64; 3] = [5, -1, 7];
    const longer: [i64; 3] = [5, -1, 8];
    if (!order(&words, &longer).is_lt()) { return 11; }

    // Derived through a field.
    const k1: Key = Key { bytes: [1, 2, 3, 4], tag: 1 };
    const k2: Key = Key { bytes: [1, 2, 3, 4], tag: 1 };
    const k3: Key = Key { bytes: [1, 2, 3, 5], tag: 0 };
    if (!k1.equals(&k2)) { return 12; }
    if (k1.equals(&k3)) { return 13; }
    if (!k1.compare(&k3).is_lt()) { return 14; }
    if (hash_of(&k1) != hash_of(&k2)) { return 15; }

    // Through an Option, whose Eq is generic over the payload.
    const some_a: Option<[u8; 4]> = Option::Some(a);
    const some_c: Option<[u8; 4]> = Option::Some(c);
    if (!some_a.equals(&Option::Some(b))) { return 16; }
    if (some_a.equals(&some_c)) { return 17; }

    // A slice that is a prefix of another orders first.
    const prefix: [u8; 2] = [1, 2];
    if (!prefix.as_slice().compare(a.as_slice()).is_lt()) { return 18; }
    if (!a.as_slice().compare(prefix.as_slice()).is_gt()) { return 19; }
    return 0;
}
