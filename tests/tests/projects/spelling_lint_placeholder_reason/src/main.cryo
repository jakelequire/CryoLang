/// In the compiler's own modules an allow of the spelling lint says why the
/// spelling is no lookup.  The placeholder that says no reason is written
/// yet is refused where it is written.
namespace compiler::resolver::symbol_str;

type struct SymbolStr {
    id: u32;
}

![allow(lookup_by_spelling, reason = "pending: this took a spelling before the lint existed, and why is not written yet")]
function find_leaf(name: SymbolStr) -> i32 {
    if (name.id == 1) { return 1; } return 0;
}

![allow(lookup_by_spelling, reason = "a duplicate-declaration check: two declared names compared with each other")]
function same_leaf(a: SymbolStr, b: SymbolStr) -> i32 {
    if (a.id == b.id) { return 1; } return 0;
}

function main() -> i32 {
    return find_leaf(SymbolStr { id: 3 }) + same_leaf(SymbolStr { id: 2 }, SymbolStr { id: 2 });
}
