# static_match_arms_checked_before_mono - must FAIL to compile (outcome =
# "compile_fail").  Every arm of a `static match (T)` is checked before
# monomorphization, whichever arm an instantiation selects: an error in an
# unselected `_` arm, in an arm listing several types for one of them, and
# in an arm where `T` names the listed type is each E0200.

[project]
project_name = "static_match_arms_checked_before_mono"
output_dir   = "build"
target_type  = "executable"
source_dir   = "src"
entry_point  = "src/main.cryo"

[compiler]

