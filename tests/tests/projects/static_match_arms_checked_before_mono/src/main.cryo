namespace StaticMatchArmsCheckedBeforeMono::Main;

// Every arm is checked, whichever arm an instantiation selects: `pick_a(5)`
// never selects the `_` arm.
function pick_a<T>(x: T) -> i32 {
    return static match (T) {
        i32 => { 1 }
        _   => {
            const bad: i32 = true;
            bad
        }
    };
}

// An arm listing several types is checked once per listed type, with `T`
// narrowed to it: valid for `i32`, refused for `boolean`.
function pick_b<T>(x: T) -> i32 {
    return static match (T) {
        i32 | boolean => {
            const n: i32 = x;
            n
        }
        _ => { 0 }
    };
}

// `T` written inside an arm listing one type is that type.
function pick_c<T>(x: T) -> i32 {
    return static match (T) {
        i32    => { 1 }
        string => {
            const y: T = 5;
            0
        }
        _ => { 0 }
    };
}

function main() -> i32 {
    return pick_a(5) + pick_b(42) + pick_c(5);
}
