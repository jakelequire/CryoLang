// `Record` reaches, through the pointee of its own field, a struct that holds
// `Record` by value.  The type mapper is still building `Record` when that
// struct is measured; a layout taken then is empty, and a copy of `Record`
// made from it moves no bytes.

type struct Record {
    holder: Holder*;
    value: i64;

    static make(value: i64) -> Record {
        return Record { holder: null, value: value };
    }
}

type struct Wrapper {
    record: Record;
}

type struct Holder {
    wrapper: Wrapper;
}

function main() -> i32 {
    const record: Record = Record::make(42);
    if (record.value != 42) { return 1; }
    if (record.holder != null) { return 2; }
    const holder: Holder = Holder { wrapper: Wrapper { record: Record::make(7) } };
    if (holder.wrapper.record.value != 7) { return 3; }
    return 0;
}
