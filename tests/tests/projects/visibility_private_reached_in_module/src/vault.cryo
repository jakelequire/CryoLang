namespace VisibilityPrivateReachedInModule::Vault;

/// Every private member and item here is reached from this module, through
/// a generic instance where there is one, and none of it is refused.
public type struct Plate {
    private serial: i32;
    label: i32;
    public static make() -> Plate { return Plate { serial: 7, label: 1 }; }
}

public type struct Cell<T> {
    private hidden: T;
    shown: T;
    public static of(hidden: T, shown: T) -> Cell<T> { return Cell::<T> { hidden: hidden, shown: shown }; }
    private peek(&this) -> i32 { return 1; }
    private static mint() -> i32 { return 2; }
}

private const SEALED: i32 = 9;
private type Width = i32;

private type trait Hidden { hidden(&this) -> i32; }
implement trait Hidden for Plate { hidden(&this) -> i32 { return 4; } }

public function inside() -> i32 {
    mut c: Cell<i32> = Cell::<i32>::of(4, 3);
    mut n: Width = c.hidden;
    c.hidden = 5;
    const built: Cell<i32> = Cell::<i32> { hidden: 1, shown: 2 };
    n = n + c.hidden + built.hidden + c.peek();
    n = n + Cell::<i32>::mint() + SEALED;
    const { serial: s, label: l }: Plate = Plate::make();
    const p: Plate = Plate::make();
    return n + s + l + p.hidden();
}
