# fmt_lays_out_files_in_place - `cryo fmt` rewrites each file below a
# directory in its laid-out form: a step writes a file laid out wrongly into
# build/src and formats it; the file then holds its laid-out text, and
# `--check` finds nothing to change.
# This project's own cryoconfig is never built: the command is `fmt`.
[project]
project_name = "fmt_lays_out_files_in_place"
output_dir   = "build"

