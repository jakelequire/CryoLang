// `cryo interpret` hands a call's result back as the `return` computed it,
// though leaving the call drops an owned local whose destructor calls
// functions returning values of their own.

namespace Main;

import std::fmt;

mut trace: u64 = 0;

function fold(value: u64) -> u64 {
    trace = trace * 10 + value;
    return trace;
}

type struct Guard {
    tag: u64;
}

implement trait Drop for Guard {
    drop(mut &this) -> void {
        fold(this.tag);
    }
}

function small(seed: u8) -> u8 {
    const guard: Guard = Guard { tag: 7 };
    return seed + (guard.tag as u8);
}

function main() -> i32 {
    const first: u8 = small(200);
    fmt::println(f"result: {first} {trace}");
    return 0;
}
