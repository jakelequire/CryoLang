/// Operands are evaluated left to right: a binary operator's left operand
/// before its right, a call's arguments in the order written, and a method
/// call's receiver before its arguments, and an assignment's place before its
/// value, compound or not.  Each operand here is a call that
/// appends its digit to `trace`, so the digits read in evaluation order and
/// a compiler that reordered any of these would print a different line.
namespace EvaluationOrderLeftToRight::Main;

import std::fmt;

mut trace: u64 = 0;

function note(digit: u64) -> u64 {
    trace = trace * 10 + digit;
    return digit;
}

function combine(a: u64, b: u64, c: u64) -> u64 {
    return a * 100 + b * 10 + c;
}

type struct Counter {
    base: u64;

    static make(digit: u64) -> Counter { return Counter { base: note(digit) }; }

    add(&this, a: u64, b: u64) -> u64 { return this.base + a + b; }
}

mut slots: [u64; 4] = [0, 0, 0, 0];

type struct Pair {
    first: u64;
    second: u64;
}

mut pairs: [Pair; 4] = [Pair { first: 0, second: 0 }, Pair { first: 0, second: 0 },
    Pair { first: 0, second: 0 }, Pair { first: 0, second: 0 }];

function pair_at(index: u64) -> mut Pair* {
    return &pairs[index];
}

/// The digits `note` appended while `run` ran, as one number.
function traced(run: () -> u64) -> u64 {
    trace = 0;
    run();
    return trace;
}

function main() -> i32 {
    const arithmetic: u64 = traced(() -> u64 { return note(1) + note(2) * note(3) - note(4); });
    const comparison: u64 = traced(() -> u64 {
        const less: boolean = note(1) < note(2);
        return if (less) { 1 } else { 0 };
    });
    const bitwise: u64 = traced(() -> u64 { return (note(1) | note(2)) ^ (note(3) & note(4)); });
    const arguments: u64 = traced(() -> u64 { return combine(note(1), note(2), note(3)); });
    const nested: u64 = traced(() -> u64 { return combine(note(1), combine(note(2), note(3), note(4)), note(5)); });
    const receiver: u64 = traced(() -> u64 { return Counter::make(1).add(note(2), note(3)); });
    const indexed: u64 = traced(() -> u64 { slots[note(1)] = note(2); return 0; });
    const indexed_compound: u64 = traced(() -> u64 { slots[note(1)] += note(2); return 0; });
    const field: u64 = traced(() -> u64 { pair_at(note(1)).second = note(2); return 0; });
    const field_compound: u64 = traced(() -> u64 { pair_at(note(1)).second += note(2); return 0; });
    fmt::println(f"{arithmetic} {comparison} {bitwise} {arguments} {nested} {receiver} {indexed} {indexed_compound} {field} {field_compound}");
    return 0;
}
