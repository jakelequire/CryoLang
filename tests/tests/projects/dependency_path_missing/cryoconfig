# dependency_path_missing - a path dependency naming a directory that does
# not exist, or one with no cryoconfig, fails the build and names the
# dependency, instead of being dropped and leaving only the imports it
# would have satisfied to fail.
[project]
project_name = "dependency_path_missing"
output_dir   = "build"
target_type  = "executable"
source_dir   = "src"
entry_point  = "src/main.cryo"

[compiler]

[dependencies]
absent = { path = "does-not-exist" }
bare   = { path = "not-a-project" }
