namespace Main;

// A generic struct's literal written with no type arguments and no expected
// type is the instance its field values bind.  A field over the struct's
// parameter types its value on its own: a variant with a payload binds
// through it, a variant without one (`Option::None`) and an empty array
// take the instance's field once it is known.

type struct Holder<T> {
    inner: T;
    peeked: Option<T>;

    static twice(value: i64) -> Holder<i64> {
        return Holder { inner: value, peeked: Option::Some(value + value) };
    }
}

type struct Outcome<T, E> {
    result: Result<T, E>;
    fallback: E;
}

type struct Listed<T> {
    first: T;
    rest: [T];
}

function wrap<U>(value: U) -> Holder<U> where U: Copy {
    return Holder { inner: value, peeked: Option::Some(value) };
}

function main() -> i32 {
    const some = Holder { inner: 3, peeked: Option::Some(2) };
    if (some.peeked.unwrap() != 2) { return 1; }
    const none = Holder { inner: 3, peeked: Option::None };
    if (none.peeked.is_some()) { return 2; }
    const wrapped = wrap(7);
    if (wrapped.peeked.unwrap() != 7) { return 3; }
    const twice = Holder::<i64>::twice(4);
    if (twice.peeked.unwrap() != 8) { return 4; }
    const outcome = Outcome { result: Result::Ok(5), fallback: 6 };
    match (outcome.result) {
        Result::Ok(v) => { if (v != 5) { return 5; } }
        Result::Err(_) => { return 6; }
    }
    if (outcome.fallback != 6) { return 7; }
    const nested = Holder { inner: Option::Some(1), peeked: Option::None };
    if (nested.peeked.is_some() || nested.inner.unwrap() != 1) { return 8; }
    const listed = Listed { first: 4, rest: [5, 6] };
    if (listed.rest.length() != 2 || listed.rest[1] != 6) { return 9; }
    const empty = Listed { first: 4, rest: [] };
    if (empty.rest.length() != 0 || empty.first != 4) { return 10; }
    return 0;
}
