/// A type and a function of one name are bound in two namespaces, so
/// neither hides the other in the module's scope, whichever is declared
/// first: here the function comes first, and the type is still found
/// where a type is written.
namespace TypeAfterFunction::Main;

function Point(x: i32) -> i32 { return x + 1; }

type struct Point { x: i32; }

function main() -> int {
    const p: Point = Point { x: 3 };
    return (p.x + Point(4)) as int;
}
