// `cryo interpret` computes each integer form by the language reference:
// wrapping at the type's width, division truncating toward zero, arithmetic
// and logical shifts, `as` truncating or extending, integers of different
// types compared by their true values, operands evaluated left to right, and
// the three loop shapes with their jumps.

namespace Main;

import std::fmt;

mut trace: u64 = 0;

function note(digit: u64) -> u64 {
    trace = trace * 10 + digit;
    return digit;
}

function combine(a: u64, b: u64) -> u64 {
    return a + b;
}

function main() -> i32 {
    const a: u8 = 200;
    const b: u8 = 100;
    const wrapped_add: u8 = a + b;
    const c: i8 = -128;
    const negated: i8 = -c;
    const d: i16 = 32767;
    const wrapped_multiply: i16 = d * 2;
    const e: i32 = -7;
    const quotient: i32 = e / 2;
    const remainder: i32 = e % 2;
    const arithmetic_shift: i32 = e >> 1;
    const wide: i64 = -9;
    const wide_shift: i64 = wide >> 1;
    const f: u32 = 4294967295;
    const logical_shift: u32 = f >> 28;
    const narrowed: u8 = (300 as u16) as u8;
    const sign_extended: i64 = c as i64;
    const reinterpreted: u8 = c as u8;
    const minus_one: i32 = -1;
    const zero: u32 = 0;
    const true_values: boolean = minus_one < zero;
    const ordered: u64 = note(1) + note(2) * note(3);
    const arguments: u64 = combine(note(4), note(5));
    mut total: u32 = 0;
    for (mut i: u32 = 0; i < 5; i = i + 1) {
        if (i == 3) { continue; }
        total = total + i;
    }
    mut n: i32 = 0;
    while (n < 10) {
        n = n + 1;
        if (n == 4) { break; }
    }
    mut ranged: i64 = 0;
    for (k in 0..4) {
        ranged = ranged + (k as i64);
    }
    fmt::println(f"integers: {wrapped_add} {negated} {wrapped_multiply} {quotient} {remainder} {arithmetic_shift} {wide_shift} {logical_shift} {narrowed} {sign_extended} {reinterpreted} {true_values}");
    fmt::println(f"order: {ordered} {arguments} {trace}");
    fmt::println(f"loops: {total} {n} {ranged}");
    return 0;
}
