namespace InternalModuleDeclarerNotLoaded::Main;

// Nothing imported here loads `Depot`'s aggregator, the file declaring
// `Depot::Vault` internal, yet the module and the module declared under it
// are internal to their package whatever their items are marked.
import Depot::Vault;
import Depot::Vault::Lock;
import Depot::Vault::{ code };

function main() -> i32 {
    return Vault::code() + Lock::turn();
}
