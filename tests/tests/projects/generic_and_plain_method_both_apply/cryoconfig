# generic_and_plain_method_both_apply - a call that a non-generic method
# and a generic method of the same name both accept is ambiguous (E0154),
# on a plain owner, on a generic one, and through the path `Box2::put`
# (outcome = "compile_fail").  A call only the generic method accepts
# (`b.put(true)`) is not.  Before, the non-generic method won the two
# method calls silently, and the path call reached code generation with no
# function bound (an internal error, E0900).

[project]
project_name = "generic_and_plain_method_both_apply"
output_dir   = "build"
target_type  = "executable"
source_dir   = "src"
entry_point  = "src/main.cryo"

