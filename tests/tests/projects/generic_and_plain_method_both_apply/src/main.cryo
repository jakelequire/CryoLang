/// A non-generic method does not win over a generic one by being
/// non-generic: where both accept the arguments, the call is ambiguous.
/// Where only one does, it is the one called.
namespace main;

type struct Box2 { v: i32; }
implement struct Box2 {
    put(&this, x: i32) -> i32 { return x; }
    put<T>(&this, x: T) -> i32 { return 0; }
}

type struct Holder<T> { v: T; }
implement<T> struct Holder<T> {
    take(&this, x: i32) -> i32 { return x; }
    take<U>(&this, x: U) -> i32 { return 0; }
}

function main() -> i32 {
    const b: Box2 = Box2 { v: 1 };
    const h: Holder<i64> = Holder::<i64> { v: 2 };
    const n: i32 = b.put(1);
    const m: i32 = h.take(2);
    const k: i32 = b.put(true);
    const s: i32 = Box2::put(&b, 4);
    return n + m + k + s;
}
