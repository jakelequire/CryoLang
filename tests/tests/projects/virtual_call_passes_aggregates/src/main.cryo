/// A call through a vtable passes a large aggregate argument, and returns a
/// large aggregate, the way the method it calls declares: by a copy the
/// callee owns and through a hidden result pointer.  The pointer loaded from
/// the vtable carries no parameter attributes of its own.
namespace VirtualCallPassesAggregates::Main;

import std::fmt;

type struct Big { a: i64; b: i64; c: i64; }

type class Shape {
public:
    tag: i64;
    Shape(tag: i64) { this.tag = tag; }
    virtual total(b: Big) -> i64 { return -1; }
    virtual count(xs: [i64]) -> i64 { return -1; }
    virtual scaled(b: Big) -> Big { return Big { a: 0, b: 0, c: 0 }; }
}

type class Square : Shape {
public:
    Square(tag: i64) : Shape(tag) { }
    override total(b: Big) -> i64 { return b.a + b.b + b.c + this.tag; }
    override count(xs: [i64]) -> i64 { return xs.length * 100 + xs[1]; }
    override scaled(b: Big) -> Big { return Big { a: b.a * 2, b: b.b * 2, c: b.c * 2 }; }
}

function through(s: &Shape) -> i64 {
    const xs: [i64] = [7, 8, 9];
    const r: Big = s.scaled(Big { a: 1, b: 2, c: 3 });
    return s.total(Big { a: 1, b: 2, c: 3 }) * 10000 + s.count(xs) + r.c * 1000;
}

function main() -> i32 {
    mut sq: Square = Square(4);
    fmt::println(f"virtual {through(&sq)}");
    return 0;
}
