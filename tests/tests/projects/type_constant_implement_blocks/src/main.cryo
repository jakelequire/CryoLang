namespace TypeConstantImplementBlocks;

type struct Gauge { reading: i32; }

implement struct Gauge {
    const EMPTY: Gauge = Gauge { reading: 0 };
    const FULL: i32 = 100;
}

type enum Level { Quiet; Normal; Loud; }

implement enum Level {
    const DEFAULT: Level = Level::Normal;
}

implement i32 {
    const ANSWER: i32 = 42;
}

type Int = i32;
type Meter = Gauge;

function level_rank(l: Level) -> i32 {
    return match (l) {
        Level::Quiet  => { 0 }
        Level::Normal => { 1 }
        Level::Loud   => { 2 }
    };
}

function main() -> i32 {
    if (Gauge::EMPTY.reading != 0) { return 1; }
    if (Gauge::FULL != 100) { return 2; }
    if (level_rank(Level::DEFAULT) != 1) { return 3; }
    if (i32::ANSWER != 42) { return 4; }
    if (Int::ANSWER != 42) { return 5; }
    if (Meter::FULL != 100) { return 6; }
    mut digits: [u8; i32::ANSWER] = [0; 42];
    digits[41] = 9;
    if (digits[41] != 9) { return 7; }
    mut readings: [u8; Meter::FULL] = [0; 100];
    mut answers: [u8; Int::ANSWER] = [0; 42];
    readings[99] = 1;
    answers[41] = 2;
    if (readings[99] + answers[41] != 3) { return 8; }
    return 0;
}
