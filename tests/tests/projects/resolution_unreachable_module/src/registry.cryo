/// Forces `Alpha::Text` into the module graph.
///
/// Module discovery is import-driven: without an importer the module is never
/// compiled, no candidate carries the spelling, and `main` would fail with
/// "no such name" instead of the reachability error this project pins.
namespace ResolutionUnreachableModule::Registry;

import ResolutionUnreachableModule::Alpha::Text;

public function witness() -> i32 {
    return ResolutionUnreachableModule::Alpha::Text::tag();
}
