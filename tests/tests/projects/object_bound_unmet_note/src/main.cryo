// An object that cannot satisfy a bound of its own trait is refused with
// E0306, and the note names the method that blocks it and why: a required
// method a table cannot hold, in the bound's trait or a supertrait.  A
// type that is not an object keeps the note that it does not implement
// the trait.
namespace ObjectBoundUnmetNote;

type trait Grow {
    grow<T>(&this, t: T) -> i32;
}

type trait Same {
    same(&this, other: &This) -> boolean;
}

type trait Make {
    make(&this) -> This;
}

type trait Eat {
    eat(this) -> i32;
}

type trait Sub : Grow {
    size(&this) -> i32;
}

type struct Tally {
    n: i32;
}

type struct Plain {
    n: i32;
}

implement trait Grow for Tally {
    grow<T>(&this, t: T) -> i32 { return 1; }
}

implement trait Same for Tally {
    same(&this, other: &This) -> boolean { return this.n == other.n; }
}

implement trait Make for Tally {
    make(&this) -> This { return Tally { n: this.n }; }
}

implement trait Eat for Tally {
    eat(this) -> i32 { return this.n; }
}

implement trait Sub for Tally {
    size(&this) -> i32 { return this.n; }
}

type struct Hold<G> where G: Grow {
    g: G;
}

type struct Pair<S> where S: Same {
    s: S;
}

type struct Maker<M> where M: Make {
    m: M;
}

type struct Eater<E> where E: Eat {
    e: E;
}

type struct Nested<S> where S: Sub {
    s: S;
}

function main() -> int {
    const t: Tally = Tally { n: 1 };
    const g: virtual &Grow = &t;
    const h: Hold<virtual &Grow> = Hold::<virtual &Grow> { g: g };
    const s: virtual &Same = &t;
    const p: Pair<virtual &Same> = Pair::<virtual &Same> { s: s };
    const m: virtual &Make = &t;
    const k: Maker<virtual &Make> = Maker::<virtual &Make> { m: m };
    const e: virtual &Eat = &t;
    const f: Eater<virtual &Eat> = Eater::<virtual &Eat> { e: e };
    const u: virtual &Sub = &t;
    const n: Nested<virtual &Sub> = Nested::<virtual &Sub> { s: u };
    const q: Hold<Plain> = Hold::<Plain> { g: Plain { n: 2 } };
    return 0;
}
