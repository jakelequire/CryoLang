namespace CatchUnwindReportsAForeignException;

import std::core::panic_unwind::{ catch_unwind, PanicInfo };
import std::core::result::{ Result };
import std::fmt;

/// The unwinder's base exception object, laid out as the runtime's own: the
/// class, a cleanup function (none), and the unwinder's six words of scratch.
type struct ForeignException {
    exception_class:   u64;
    exception_cleanup: i64;
    scratch:           [u64; 6];
}

extern "C" {
    function _Unwind_RaiseException(exception_object: i64) -> i32;
}

/// The class "FOREIGN!" in ASCII: not the runtime's, so not a Cryo panic.
mut foreign: ForeignException = ForeignException {
    exception_class: 0x464F524549474E21, exception_cleanup: 0, scratch: [0; 6],
};

function raise_foreign() -> i32 {
    _Unwind_RaiseException(&foreign as i64);
    return 0;
}

function main() -> int {
    const outcome: Result<i32, PanicInfo> = catch_unwind(raise_foreign);
    match (outcome) {
        Result::Ok(_) => { fmt::println("not caught"); }
        Result::Err(info) => {
            fmt::print("caught: ");
            fmt::println(info.msg);
        }
    }
    raise_foreign();
    fmt::println("after");
    return 0;
}
