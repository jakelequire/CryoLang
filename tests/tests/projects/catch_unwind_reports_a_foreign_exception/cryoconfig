# catch_unwind_reports_a_foreign_exception - built and RUN end-to-end
# (outcome = "run").  An exception a Cryo panic did not raise, unwinding
# through Cryo frames, is caught by catch_unwind and named as foreign; one that
# reaches main's root catch is reported the same way and exits 101.  It is
# raised here through the unwinder's own entry point with another exception
# class, which is what a C++ throw looks like to the personality.

[project]
project_name = "catch_unwind_reports_a_foreign_exception"
output_dir   = "build"
target_type  = "executable"
source_dir   = "src"
entry_point  = "src/main.cryo"

