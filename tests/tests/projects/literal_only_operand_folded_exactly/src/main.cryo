/// An operand made only of integer literals beside one that is not, a
/// compound assignment's value made only of literals, and a returned value
/// made only of literals are each their exact value, computed before the
/// value takes a type: an intermediate the type does not hold changes
/// nothing.  With `x: i8`, `x + (200 / 2)` adds 100; `z * ((1 << 9) >> 3)`
/// with `z: u8` multiplies by 64; `m += (200 / 2)` adds 100; and a `u8`
/// function returning `((200 + 100) / 2)` returns 150.  An operand's value
/// the other operand's type does not hold keeps its default type, so with
/// `zero: i8`, `zero + -129` is the `i32` -129 rather than 127, and
/// `zero == -129` compares as `i32`s.  The negated literal an `i8` holds,
/// `-(100 + 25)`, and `w + (200 + 100)` stored in an `i32` (301) are the
/// controls: they were always right.
namespace LiteralOnlyOperandFoldedExactly::Main;

import std::fmt;

function half_u8() -> u8 { return ((200 + 100) / 2); }

function quotient_i8() -> i8 { return (200 / 2); }

function main() -> i32 {
    const x: i8 = 3;
    const sum: i8 = x + (200 / 2);
    const z: u8 = 2;
    const product: u8 = z * ((1 << 9) >> 3);
    mut m: i8 = 1;
    m += (200 / 2);
    const zero: i8 = 0;
    const widened: i32 = zero + -129;
    const same: boolean = zero == -129;
    const n: i8 = -3;
    const held: i8 = n - -(100 + 25);
    const w: u8 = 1;
    const wide_sum: i32 = w + (200 + 100);
    fmt::println(f"{sum} {product} {m} {widened} {same} {held} {wide_sum} {half_u8()} {quotient_i8()}");
    return 0;
}
