# init_refuses_existing_cryoconfig - `cryo init` in a directory that is
# already a project asks nothing and writes nothing.  The step scaffolds the
# library `first` in build/twice; the command then runs init there again for
# an executable `second`, which must fail naming the cryoconfig, and leave
# the first project's cryoconfig as it was.  This project's own cryoconfig
# is never built: the command is `init`.
[project]
project_name = "init_refuses_existing_cryoconfig"
output_dir   = "build"

