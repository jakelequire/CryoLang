{
  "outcome": "command",
  "steps": [
    ["init", "build/twice", "--name=first", "--type=library", "--source-dir=src", "--output-dir=out"]
  ],
  "command": ["init", "build/twice", "--name=second", "--type=executable", "--source-dir=src", "--output-dir=out"],
  "expect": {
    "fails": true,
    "stderr_contains": ["cryoconfig already exists; `cryo init` does not overwrite a file"],
    "output_excludes": ["Project name", "Created"],
    "file": "build/twice/cryoconfig",
    "file_contains": ["project_name = \"first\"", "[lib]"],
    "file_excludes": ["second", "entry_point"]
  }
}
