# shift_amount_is_checked - built and RUN end-to-end (outcome = "run").  A
# shift by the shifted type's width or more, or by a negative amount, panics
# with the amount and the width, at every integer width and for every type of
# amount; an amount below the width shifts, at the shifted value's width
# whatever the amount's type.  `MIN / -1` and `MIN % -1` panic
# as an overflow, and a zero divisor as a division by zero.  Each panic is
# caught, so one run reports them all.

[project]
project_name = "shift_amount_is_checked"
output_dir   = "build"
target_type  = "executable"
source_dir   = "src"
entry_point  = "src/main.cryo"

