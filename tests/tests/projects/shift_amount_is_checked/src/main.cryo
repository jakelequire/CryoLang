namespace ShiftAmountIsChecked;

import std::fmt;
import std::core::panic_unwind::{ catch_unwind, PanicInfo };
import std::core::result::{ Result };

// Every amount and divisor comes through a call, so none is a constant the
// compiler refuses (E0464); each meets the check that runs before the shift
// or the division.
function amount(n: i64) -> i64 { return n; }

function report(name: string, outcome: Result<i64, PanicInfo>) -> void {
    match (outcome) {
        Result::Ok(value) => { fmt::println(f"{name}: {value}"); }
        Result::Err(info) => { fmt::println(f"{name}: {info.msg}"); }
    }
}

function main() -> int {
    report("u8 << 7", catch_unwind(() -> i64 { const v: u8 = 1; return (v << amount(7)) as i64; }));
    // A shift computes at the shifted value's width: the bits shifted past
    // it are gone, whatever the amount's type.
    report("u8 3 << 7", catch_unwind(() -> i64 { const v: u8 = 3; return (v << amount(7)) as i64; }));
    report("u32 3 << 31", catch_unwind(() -> i64 { const v: u32 = 3; return (v << amount(31)) as i64; }));
    report("i8 -128 >> 7", catch_unwind(() -> i64 { const v: i8 = -128; return (v >> amount(7)) as i64; }));
    report("u8 << 8", catch_unwind(() -> i64 { const v: u8 = 1; return (v << amount(8)) as i64; }));
    report("i16 >> 15", catch_unwind(() -> i64 { const v: i16 = -4; return (v >> amount(15)) as i64; }));
    report("i16 >> 16", catch_unwind(() -> i64 { const v: i16 = -4; return (v >> amount(16)) as i64; }));
    report("u32 << 40", catch_unwind(() -> i64 { const v: u32 = 1; return (v << amount(40)) as i64; }));
    report("u64 << 63", catch_unwind(() -> i64 { const v: u64 = 1; return (v << amount(63)) as i64; }));
    report("i64 >> 64", catch_unwind(() -> i64 { const v: i64 = -1; return v >> amount(64); }));
    report("u128 << 128", catch_unwind(() -> i64 { const v: u128 = 1; return (v << amount(128)) as i64; }));
    report("u64 << -1", catch_unwind(() -> i64 { const v: u64 = 1; return (v << amount(-1)) as i64; }));
    report("u64 >> i8 -3", catch_unwind(() -> i64 {
        const v: u64 = 64;
        const n: i8 = amount(-3) as i8;
        return (v >> n) as i64;
    }));
    report("u64 << u8 200", catch_unwind(() -> i64 {
        const v: u64 = 1;
        const n: u8 = amount(200) as u8;
        return (v << n) as i64;
    }));
    report("u32 <<= 32", catch_unwind(() -> i64 {
        mut v: u32 = 1;
        v <<= amount(32);
        return v as i64;
    }));
    report("i32::MIN / -1", catch_unwind(() -> i64 {
        const m: i32 = i32::MIN;
        return (m / (amount(-1) as i32)) as i64;
    }));
    report("i32::MIN % -1", catch_unwind(() -> i64 {
        const m: i32 = i32::MIN;
        return (m % (amount(-1) as i32)) as i64;
    }));
    report("7 / 0", catch_unwind(() -> i64 { return 7 / amount(0); }));
    return 0;
}
