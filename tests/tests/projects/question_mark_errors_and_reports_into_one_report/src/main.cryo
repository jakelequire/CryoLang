///! `?` passes errors of three types, and a report, on into functions returning
///! `Result<T, ErrorReport>`.  The report passed on as itself places the
///! implementation for every type (`From<T> for T`) on `ErrorReport` beside
///! its own `From<E> for ErrorReport where E: Error`; each `?` after that
///! still names the implementation whose method takes its error, the
///! generic one by its where-clause.

namespace QuestionMarkErrorsAndReportsIntoOneReport;

import std::core::error::{ ErrorReport };
import std::encoding::json;
import std::encoding::yaml;
import std::encoding::value::{ Value };
import std::fmt::{ println };
import std::time::datetime::{ DateTime };

/// How many entries the JSON `text` holds; a `JsonError` passes on.
function entries_of(text: string) -> Result<i64, ErrorReport> {
    const value: Value = json::Json::parse(Str::from(text))?;
    return Result::Ok(value.length());
}

/// The entries of `text`; the report passes on as it is.
function entries_again(text: string) -> Result<i64, ErrorReport> {
    const entries: i64 = entries_of(text)?;
    return Result::Ok(entries);
}

/// The year of the RFC 3339 `text`; a `DateTimeError` passes on.
function year_of(text: string) -> Result<i64, ErrorReport> {
    const moment: DateTime = DateTime::parse_rfc3339(Str::from(text))?;
    return Result::Ok(moment.year);
}

/// How many entries the YAML `text` holds; a `YamlError` passes on.
function settings_of(text: string) -> Result<i64, ErrorReport> {
    const value: Value = yaml::Yaml::parse(Str::from(text))?;
    return Result::Ok(value.length());
}

function show(label: string, outcome: Result<i64, ErrorReport>) -> void {
    match (outcome) {
        Result::Ok(n) => { println(f"{label}: {n}"); }
        Result::Err(report) => { println(f"{label} refused: {report}"); }
    }
}

function main() -> i32 {
    show("entries", entries_again("[1, 2, 3]"));
    show("entries", entries_again("{"));
    show("year", year_of("2026-11-25T10:00:00Z"));
    show("year", year_of("not a date"));
    show("settings", settings_of("a: 1\nb: 2\n"));
    show("settings", settings_of("a:\n\tb: 2\n"));
    return 0;
}
