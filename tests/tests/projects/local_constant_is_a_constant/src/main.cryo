// A local `const` whose initializer is a compile-time integer is a constant
// wherever one is wanted: an array type's size and an array literal's repeat
// count, including one computed from another local constant.  A read reaches
// the binding the scope rules give it, so a shadowing `const` in an inner
// block is read there and the outer one after the block.
import std::fmt;

namespace LocalConstantIsAConstant::Main;

function main() -> i32 {
    const width: i64 = 3;
    const cells: i64 = width * 2;
    const row: [i32; cells] = [7; cells];
    mut total: i32 = 0;
    for (mut i: i64 = 0; i < cells; i++) { total = total + row[i]; }
    mut seen: i64 = 0;
    {
        const width: i64 = 10;
        seen = width;
    }
    fmt::println(f"total {total} inner {seen} outer {width}");
    return 0;
}
