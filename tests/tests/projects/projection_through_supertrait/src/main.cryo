namespace projection_through_supertrait;

import std::core::option;
import std::core::option::{ Option };

type trait Source {
    type Item;
    take(mut &this) -> Option<This::Item>;
}

type trait Both : Source {
    take_back(mut &this) -> Option<This::Item>;
    first_or(mut &this, d: This::Item) -> This::Item {
        return match (this.take()) {
            Option::Some(v) => { v }
            Option::None    => { d }
        };
    }
}

type trait Peek : Both {
    peek_count(&this) -> i32;
}

type struct Countdown {
    lo: i32;
    hi: i32;
}

implement trait Source for struct Countdown {
    type Item = i32;
    take(mut &this) -> Option<i32> {
        if (this.lo >= this.hi) { return Option::None; }
        this.lo = this.lo + 1;
        return Option::Some(this.lo);
    }
}

implement trait Both for struct Countdown {
    take_back(mut &this) -> Option<This::Item> {
        if (this.lo >= this.hi) { return Option::None; }
        this.hi = this.hi - 1;
        return Option::Some(this.hi + 1);
    }
}

implement trait Peek for struct Countdown {
    peek_count(&this) -> i32 { return this.hi - this.lo; }
}

function count_back<I>(it: mut &I) -> i32 where I: Peek {
    mut n: i32 = 0;
    loop {
        const got: Option<I::Item> = it.take_back();
        match (got) {
            Option::Some(_) => { n = n + 1; }
            Option::None    => { break; }
        }
    }
    return n;
}

function sum_with<I>(it: mut &I, f: (I::Item) -> i32) -> i32 where I: Both {
    mut s: i32 = 0;
    loop {
        match (it.take_back()) {
            Option::Some(v) => { s = s + f(v); }
            Option::None    => { break; }
        }
    }
    return s;
}

function twice(x: i32) -> i32 { return x * 2; }

function main() -> i32 {
    mut a: Countdown = Countdown { lo: 0, hi: 5 };
    const first: i32 = a.first_or(9);
    const left: i32 = count_back(&a);
    mut b: Countdown = Countdown { lo: 0, hi: 3 };
    const s: i32 = sum_with(&b, twice);
    if (first != 1) { return 1; }
    if (left != 4) { return 2; }
    if (s != 12) { return 3; }
    return 0;
}
