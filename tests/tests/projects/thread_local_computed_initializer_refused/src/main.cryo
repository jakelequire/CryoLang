/// A thread-local's initializer is static data every thread's copy starts
/// from.  One the program would have to compute at start - a call, or a
/// struct literal with a field computed by one - would reach the main
/// thread's copy only, so it is refused (E0646).  Constant initializers,
/// nested struct literals among them, are accepted.
namespace ThreadLocalComputedInitializerRefused;

type struct TcPoint { x: i32; y: i32; }
type struct TcBox { p: TcPoint; tag: string; }

function tc_seed() -> i32 { return 4; }

const TC_BASE: i32 = 5;

![thread_local]
mut tc_called: i32 = tc_seed();

![thread_local]
mut tc_partial: TcPoint = TcPoint { x: tc_seed(), y: 1 };

![thread_local]
mut tc_folded: TcBox = TcBox { p: TcPoint { x: 1, y: 2 }, tag: "ok" };

![thread_local]
mut tc_plain: i32 = 7;

function main() -> int {
    return (tc_called + tc_partial.x + tc_folded.p.y + tc_plain + TC_BASE) as int;
}
