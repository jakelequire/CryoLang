# quick_fixes - must FAIL to compile (outcome = "compile_fail").  The small
# refusals that carry an edit: a misspelled import entry, an entry imported
# twice, a field with no close spelling, a misspelled variant, a method given
# too few or too many arguments, a redundant numeric suffix and a `?` on a
# value with no `Try`.  The expected output pins each rendered fix.

[project]
project_name = "quick_fixes"
output_dir   = "build"
target_type  = "executable"
source_dir   = "src"
entry_point  = "src/main.cryo"

[compiler]

[dependencies]
