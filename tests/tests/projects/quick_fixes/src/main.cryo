namespace QuickFixes::Main;

// Each refusal here carries the edit that fixes it, and the expected output
// pins the rendered fix.

// A misspelled entry of a braced import is offered the close spelling, at
// the entry; an entry imported a second time is removed.
import std::collections::hashmap::{ HashMpa };
import std::collections::array::{ Array };
import std::collections::array::{ Array };

type struct Point {
    x: i32;
    y: i32;

    add(&this, n: i32, m: i32) -> i32 { return this.x + n + m; }
}

type enum Color { Red; Green; Blue; }

function main() -> i32 {
    const p: Point = Point { x: 1, y: 2 };
    // A one-letter name shares nothing with another one-letter name: no
    // field is offered for `z`, and what the type has is listed instead.
    const a: i32 = p.z;
    // A misspelled variant is offered the close spelling.
    const c: Color = Color::Gren;
    // Too few arguments to a method: a placeholder per missing one.
    const b: i32 = p.add(1);
    // Too many: the extra ones are removed.
    const d: i32 = p.add(1, 2, 3);
    // A redundant suffix is removed.
    const e: i32 = 5_i32;
    return a + b + d + e;
}

// A `?` on a value that implements no `Try` is offered its removal.
function first(value: i32) -> i32 {
    const n: i32 = value?;
    return n;
}
