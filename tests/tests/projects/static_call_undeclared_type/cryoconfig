# static_call_undeclared_type - a static call on a type the writer's scope
# does not name is E0203 at the qualifier, with its location, and nothing
# else.
#
# The name layer used to leave such a qualifier unanswered, deferring to "a
# later stage that needs it"; the only later report was E0900's count of
# unanswered path nodes (`15 path-bearing node(s) reached a stage requiring
# name resolution with no Res recorded`), with no file and no line.  It is
# now explained where the path is written, by the same reporter an unbound
# type spelling gets in a declaration.
#
# A project rather than a negative file so the whole pipeline is asked.

[project]
project_name = "static_call_undeclared_type"
output_dir   = "build"
target_type  = "executable"
source_dir   = "src"
entry_point  = "src/main.cryo"

[compiler]

[dependencies]
