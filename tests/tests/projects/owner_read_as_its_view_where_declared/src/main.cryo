/// An owner where its `Deref` target is declared is read as that target:
/// a `String` where a `Str` is declared, a `PathBuf` where a `Path` is.
/// Each site that declares a type is checked - a function's argument, a
/// method's and a static method's, a typed binding, a returned value, an
/// assigned value, a struct literal's field and an array element - and
/// so is an owner that is a temporary.  The owner is read, not moved: it
/// is used again after every read.  The exit code names the first check
/// that failed.
namespace OwnerReadAsItsViewWhereDeclared::Main;

import std::collections::str::{ Str };
import std::collections::string::{ String };
import std::fs::path::{ Path, PathBuf };
import std::fmt;

function length_of(text: Str) -> i64 {
    return text.length() as i64;
}

function view_of(owned: &String) -> Str {
    return *owned;
}

function name_of(path: Path) -> Str {
    return path.file_name().unwrap_or(Str::new(""));
}

function made() -> String {
    return String::from("temporary");
}

type struct Shelf {
    label: Str;

    static measure(text: Str) -> i64 {
        return text.length() as i64;
    }

    starts_with_label(&this, text: Str) -> boolean {
        return text.starts_with(this.label);
    }
}

function main() -> i32 {
    const owned: String = String::from("shelf");

    if (length_of(owned) != 5) { return 1; }

    const bound: Str = owned;
    if (bound != Str::new("shelf")) { return 2; }

    mut assigned: Str = Str::new("");
    assigned = owned;
    if (assigned != Str::new("shelf")) { return 3; }

    const shelf: Shelf = Shelf { label: owned };
    if (shelf.label != Str::new("shelf")) { return 4; }

    if (view_of(&owned) != Str::new("shelf")) { return 5; }

    if (Shelf::measure(owned) != 5) { return 6; }

    const longer: String = String::from("shelf life");
    if (!shelf.starts_with_label(longer)) { return 7; }

    const views: [Str; 2] = [owned, longer];
    if (views[1] != Str::new("shelf life")) { return 8; }

    if (length_of(made()) != 9) { return 9; }

    const path: PathBuf = PathBuf::from(Str::new("notes/today.txt"));
    if (name_of(path) != Str::new("today.txt")) { return 10; }

    // Every owner is still whole after being read.
    if (owned.length() != 5 || longer.length() != 10) { return 11; }
    if (path.as_path().as_str() != Str::new("notes/today.txt")) { return 12; }

    fmt::println("owner read as its view: all checks passed");
    return 0;
}
