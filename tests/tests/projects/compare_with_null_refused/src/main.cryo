/// A pointer is compared with a pointer, a function, a string or a
/// reference, and `null` is a pointer: a struct, class or enum value, a
/// number or a boolean compared with `null` - or with any pointer - is
/// refused by the type check, where it passed and then failed in code
/// generation or compared a value with an address.
namespace CompareWithNullRefused::Main;

type struct S { x: i32; }

type class K {
public:
    n: i32;
    K(n: i32) { this.n = n; }
}

type enum E { A; B; }

function main() -> i32 {
    const s: S = S { x: 1 };
    const k: K = K(2);
    const e: E = E::A;
    const n: i32 = 5;
    const b: boolean = true;
    const p: i32* = &n;
    mut hits: i32 = 0;
    if (s == null) { hits = hits + 1; }
    if (k != null) { hits = hits + 1; }
    if (e == null) { hits = hits + 1; }
    if (n == null) { hits = hits + 1; }
    if (b != null) { hits = hits + 1; }
    if (n == p) { hits = hits + 1; }
    return hits;
}
