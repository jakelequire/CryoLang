/// The trait whose method names `Parcel` in a parameter. `Parcel` is reachable
/// HERE, which is the point: an implementor in another module has to bring it
/// into its own scope, and this file must not do that for it.
namespace NamespaceGateMethods::Handler;

import NamespaceGateMethods::Depot;

type trait Handler {
    handle(mut &this, p: Parcel*) -> i32;
}
