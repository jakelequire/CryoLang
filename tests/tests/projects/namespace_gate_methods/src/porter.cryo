/// CONTROLS. Both name `Parcel` in a method signature and reach it legally,
/// so both must compile silently.
///
/// A reachability gate fails in two directions and only one of them is loud.
/// `test.json` excludes `Carrier` and `Hauler` from the output: rejecting them
/// is the expensive direction -- false positives on correct code.
///
/// It also excludes `E0203`, which is the signature of the one false-positive
/// class this gate actually produced: the RECEIVER. `&this` carries a
/// synthesized annotation naming the impl's target type, so reporting it
/// renders "cannot find type `Box`" against the `implement` header -- a line
/// whose author can do nothing about it. `&this` itself cannot be excluded:
/// the rendered snippet quotes the source line, which contains it.
namespace NamespaceGateMethods::Porter;

import NamespaceGateMethods::Depot;
import NamespaceGateMethods::Handler;

type struct Carrier {
    seen: i32;
}

/// CONTROL 1 -- the bare name in a trait-impl method parameter.
implement trait Handler for struct Carrier {
    handle(mut &this, p: Parcel*) -> i32 { return this.seen + p.get(); }
}

type struct Hauler {
    seen: i32;

    /// CONTROL 2 -- the bare name in an INLINE method parameter, the other
    /// population the TypeResolution pass reports.
    stow(&this, p: Parcel*) -> i32 { return this.seen + p.get(); }

    /// CONTROL 3 -- the fully qualified path, which needs no import at all.
    stow_qualified(&this, p: NamespaceGateMethods::Depot::Parcel*) -> i32 {
        return this.seen + p.get();
    }
}
