/// Entry point. Module discovery is import-driven, so both the orphan and the
/// controls have to be imported here or they are never compiled and the
/// project silently tests nothing.
namespace NamespaceGateMethods;

import NamespaceGateMethods::Depot;
import NamespaceGateMethods::Depot::{ Parcel };
import NamespaceGateMethods::Handler;
import NamespaceGateMethods::Orphan;
import NamespaceGateMethods::Porter;
import NamespaceGateMethods::Porter::{ Carrier };

function main() -> i32 {
    mut c: Carrier = Carrier { seen: 1 };
    mut p: Parcel = Parcel::of(2);
    return c.handle(&p);
}
