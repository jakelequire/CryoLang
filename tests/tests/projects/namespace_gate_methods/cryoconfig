# namespace_gate_methods - the §3.3 reachability gate on METHOD signatures.
#
# Read src/orphan.cryo first. `cryo build` must FAIL here with E0240 naming
# `Parcel` and the module that declares it, and must NOT reject the three
# CONTROLS in src/porter.cryo, which reach the same type legally.
#
# Separate from tests/tests/projects/namespace_gate because a free function's
# signature is judged in an EARLIER pass, whose abort would stop the build
# before the method arms here were ever reached.

[project]
project_name = "namespace_gate_methods"
output_dir   = "build"
target_type  = "executable"
source_dir   = "src"
entry_point  = "src/main.cryo"

