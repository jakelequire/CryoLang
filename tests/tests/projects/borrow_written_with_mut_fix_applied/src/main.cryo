namespace BorrowWrittenWithMutFix;

type struct Counter {
    count: i64;
}

function bump(counter: mut &Counter) -> void {
    counter.count += 1;
}

function main() -> i32 {
    mut counter: Counter = Counter { count: 0 };
    bump(&counter);
    if (counter.count != 1) { return 1; }
    return 0;
}
