namespace OverloadIntegerLiteralIsI32::Main;

import OverloadIntegerLiteralIsI32::Narrow::{ conv };
import OverloadIntegerLiteralIsI32::Wide::{ widen };

function main() -> i32 {
    // `i32` declared first, and `i64` first: the literal is `i32` either way.
    if (conv(1) != 32) { return 1; }
    if (widen(1) != 32) { return 2; }
    if (conv(-4) != 32 || widen(2 + 3) != 32) { return 3; }
    // A typed argument still selects by its type.
    const big: i64 = 5000000000;
    if (conv(big) != 64 || widen(big) != 64) { return 4; }
    return 0;
}
