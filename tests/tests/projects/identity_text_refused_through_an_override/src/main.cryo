/// A module of the compiler's own: text read off a definition, a
/// `DeclName`, answered by a method that overrides a base class's, is
/// identity text where the call is made through the base - the callee
/// written there is the base's method, and the answer is the override's.
/// Compared there, it is refused.  An override answering only fixed text,
/// and the text measured, are not.
namespace compiler::resolver::decl_name;

type struct DeclName {
private:
    text: string;
public:
    static of(s: string) -> DeclName { return DeclName { text: s }; }
    shown(&this) -> string { return this.text; }
}

type class Shape {
public:
    Shape() { }
    virtual label(&this) -> string;
    virtual kind(&this) -> string;
}

type class Named : Shape {
public:
    name: DeclName;
    Named(n: DeclName) : Shape() { this.name = n; }
    override label(&this) -> string { return this.name.shown(); }
    override kind(&this) -> string { return "named"; }
}

/// The override's answer compared through the base.
function is_vec(s: Shape*) -> i32 {
    if (s.label() == "Vec<i32>") { return 1; }
    return 0;
}

/// An answer of fixed text, and a measured one.  Accepted.
function accepted(s: Shape*) -> i32 {
    mut n: i32 = s.label().length() as i32;
    if (s.kind() == "named") { n = n + 1; }
    return n;
}

function main() -> i32 {
    const s: Named* = new Named(DeclName::of("Vec<i32>"));
    return is_vec(s as Shape*) + accepted(s as Shape*);
}
