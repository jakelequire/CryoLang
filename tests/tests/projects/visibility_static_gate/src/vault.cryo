namespace VisibilityStaticGate::Vault;

public type struct Crate {
    v: i32;

    /// DOOR 6a -- reached by a FULLY QUALIFIED static call
    /// (`Ns::Crate::tapped()`).
    private static tapped() -> i32 { return 5; }

    /// DOOR 6b -- reached by a TYPE-QUALIFIED static call (`Crate::latched()`),
    /// which enters the static-template lane rather than the module-qualified
    /// one.
    private static latched() -> i32 { return 6; }

    /// CONTROL: a genuinely public static, called both ways.
    public static offered() -> i32 { return 3; }
}
