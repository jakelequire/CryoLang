namespace VisibilityStaticGate::Main;

import VisibilityStaticGate::Vault;

function main() -> int {
    mut n: i32 = VisibilityStaticGate::Vault::Crate::tapped();
    n = n + Crate::latched();
    n = n + VisibilityStaticGate::Vault::Crate::offered();
    n = n + Crate::offered();
    return n as int;
}
