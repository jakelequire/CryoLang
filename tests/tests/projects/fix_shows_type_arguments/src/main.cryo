/// Generic calls and values nothing types: each refusal's fix is the line
/// with the type arguments written in.
namespace FixShowsTypeArguments;

type struct Wrap<T> {
    v: T;
    static new(v: T) -> Wrap<T> { return Wrap::<T> { v: v }; }
}

type enum Maybe<T> {
    Some(T);
    Nothing;
}

function make<T>() -> i32 { return 0; }
function pick<T>(x: i32) -> i32 { return x; }
function shown<T>(x: T) -> T { return x; }

function main() -> int {
    const a = make();
    const b = pick(3);
    const w = Wrap::new(0);
    const m = Maybe::Nothing;
    const f = shown;
    return 0;
}
