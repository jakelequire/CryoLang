namespace NegatedLiteralArgumentAdoptsBoundOwner;

// A negated literal argument of a static call whose owner the expected type
// binds adopts the parameter's type, as a bare literal does: `-3` for an
// `i16`, the minimum of an `i8`, and a magnitude past `i32` for an `i64`.

type struct Holder<T> {
    value: T;
    static make(value: T) -> Holder<T> { return Holder::<T> { value: value }; }
}

function main() -> i32 {
    const small: Holder<i16> = Holder::make(-3);
    if (small.value != -3) { return 1; }
    const lowest: Holder<i8> = Holder::make(-128);
    if (lowest.value != -128) { return 2; }
    const wide: Holder<i64> = Holder::make(-5000000000);
    if (wide.value != -5000000000) { return 3; }
    return 0;
}
