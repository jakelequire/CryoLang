namespace StdlibPanicNamesFile;

import std::fmt;

// `expect` panics at its own place in the standard library.  The panic names
// that file relative to the stdlib's root, behind `stdlib/`, whatever
// directory the stdlib was built from: the archive every program links is
// the same bytes wherever the stdlib lives.

function main() -> i32 {
    const missing: Option<i64> = Option::None;
    fmt::println("before");
    fmt::println(f"{missing.expect("nothing here")}");
    return 0;
}
