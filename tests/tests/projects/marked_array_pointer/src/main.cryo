// marked_array_pointer - `mut` and `const` in front of an array type mark
// the pointer that follows it, as they do in front of a named type: a
// parameter, a local and a field written `mut [i64]*` are written through,
// one written `const [i64]*` is read through.
namespace Main;

import std::fmt;

type struct Collector {
    values: mut [i64]*;

    add(&this, value: i64) -> void {
        this.values.push(value);
    }
}

function fill(out: mut [i64]*) -> void {
    out.push(1);
}

function count(values: const [i64]*) -> i64 {
    return values.length();
}

function main() -> int {
    mut values: [i64] = [];
    fill(&values);
    const view: mut [i64]* = &values;
    view.push(2);
    const collector: Collector = Collector { values: &values };
    collector.add(3);
    const read: const [i64]* = &values;
    fmt::printf("marked_array_pointer: %lld %lld\n", count(read), values.length());
    return 0;
}
