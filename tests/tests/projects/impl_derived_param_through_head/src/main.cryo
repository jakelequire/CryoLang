/// A parameter an implement block derives from its where-clause (`A`, which
/// the head does not write) is found by binding the bound's subject `I`
/// through the head `Skip<I>` - not by `I` being spelled like `Skip`'s own
/// parameter, which is `J`.
namespace ImplDerivedParamThroughHead::Main;

type trait Iter<X> {
    next(mut &this) -> X;
}

type struct Counter {
    n: i32;
}

implement trait Iter<i32> for struct Counter {
    next(mut &this) -> i32 { this.n = this.n + 1; return this.n; }
}

type struct Skip<J> {
    inner: J;
}

implement<I, A> trait Iter<A> for struct Skip<I> where I: Iter<A> {
    next(mut &this) -> A { this.inner.next(); return this.inner.next(); }
}

function main() -> int {
    mut s: Skip<Counter> = Skip::<Counter> { inner: Counter { n: 0 } };
    return s.next() * 10 + s.next();
}
