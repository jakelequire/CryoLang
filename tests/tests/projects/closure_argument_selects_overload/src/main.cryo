namespace ClosureArgumentSelectsOverload::Main;

// `run` is overloaded by arity, and the call passes a capturing closure
// to the two-parameter overload, declared second: that overload is the one
// specialized for the closure, with its own body and signature.
function run(f: (i32) -> i32, x: i32, y: i32) -> i32 { return f(x) * 100 + y; }

function run(f: (i32) -> i32, x: i32) -> i32 { return f(x); }

function main() -> i32 {
    const bias: i32 = 10;
    const add_bias = (x: i32) -> i32 { return x + bias; };
    return run(add_bias, 32);
}
