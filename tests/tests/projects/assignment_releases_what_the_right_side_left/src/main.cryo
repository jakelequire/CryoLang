// An assignment releases what its destination holds when the store is made.
// Here the right side replaces the destination's member through a
// reference first (`replace(&holder)` releases code 1 and stores code 2), so
// the assignment releases code 2; releasing a copy of the destination taken
// before the right side ran would release code 1 a second time and never
// release code 2.

namespace Main;

import std::fmt;

mut log: u64 = 0;

function note(code: u64) -> void { log = log * 10 + code; }

type struct Tracked {
    code: u64;
}

implement trait Drop for struct Tracked {
    drop(mut &this) -> void { note(this.code); }
}

type struct Holder {
    item:  Tracked;
    count: u64;
}

function replace(holder: mut &Holder) -> u64 {
    holder.item = Tracked { code: 2 };
    return 5;
}

function assign() -> u64 {
    mut holder: Holder = Holder { item: Tracked { code: 1 }, count: 0 };
    holder = Holder { item: Tracked { code: 3 }, count: replace(&holder) };
    note(holder.count);
    return log;
}

function main() -> i32 {
    const after_assignment: u64 = assign();
    fmt::println(f"released: {after_assignment} {log}");
    return 0;
}
