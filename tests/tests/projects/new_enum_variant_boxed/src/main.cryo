type enum Shape { Dot; Circle(i32); Rect(i32, i32); }

function area(s: Shape*) -> i32 {
    match (*s) {
        Shape::Dot => { return 0; }
        Shape::Circle(r) => { return 3 * r * r; }
        Shape::Rect(w, h) => { return w * h; }
    }
}

function main() -> i32 {
    const c: Shape* = new Shape::Circle(2);
    const r: Shape* = new Shape::Rect(3, 4);
    const d: Shape* = new Shape::Dot;
    return area(c) + area(r) + area(d);   // 12 + 12 + 0 = 24
}
