# new_enum_variant_boxed - `new E::V(args)` builds the variant on the heap.
# The variant is the one sema finds inside the enum the stamp names and
# pins on the node; codegen builds from the pin.  Every shape of variant is
# exercised: no payload, one payload, two payloads; the exit code sums what
# a `match` over each boxed value reads back.
[project]
project_name = "new_enum_variant_boxed"
output_dir   = "build"
target_type  = "executable"
source_dir   = "src"
entry_point  = "src/main.cryo"
