namespace Main;

// A method named `drop` on a type that does not implement `Drop` is an
// ordinary method: calling it borrows the receiver, which may be called
// again and is still released once, through its fields, at its scope's end.

type struct Probe {
    drops: mut i64*;
}

implement trait Drop for struct Probe {
    drop(mut &this) -> void { *this.drops = *this.drops + 1; }
}

type struct Ledger {
    p: Probe;
    tag: i64;
    drop(&this) -> i64 { return this.tag; }
}

function main() -> i32 {
    mut drops: i64 = 0;
    mut seen: i64 = 0;
    {
        const ledger: Ledger = Ledger { p: Probe { drops: &drops }, tag: 5 };
        seen = ledger.drop() + ledger.drop();
    }
    if (seen != 10) { return 1; }
    if (drops != 1) { return 2; }
    return 0;
}
