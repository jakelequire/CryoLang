namespace MethodSliceParameterTakesArrayReference;

import std::collections::array::{ Array };
import std::core::slice::{ Slice };

// A method parameter typed as a slice reference takes a reference to a
// container with the slice traits, or to a fixed array, as a function's
// parameter does: the argument is converted to the slice over its elements.

type struct Counter {
    base: i64;

    bytes(&this, items: &Slice<u8>) -> i64 { return this.base + items.length() as i64; }

    clear_all(&this, items: mut &Slice<u8>) -> i64 {
        for (mut i: u64 = 0; i < items.length(); i++) { items[i] = 0; }
        return this.base;
    }
}

function main() -> i32 {
    mut raw: [u8] = [1, 2, 3];
    const counter: Counter = Counter { base: 10 };
    if (counter.bytes(&raw) != 13) { return 1; }
    const fixed: [u8; 4] = [9, 9, 9, 9];
    if (counter.bytes(&fixed) != 14) { return 2; }
    if (counter.clear_all(&raw) != 10) { return 3; }
    if (raw[0] != 0 || raw[2] != 0) { return 4; }    return 0;
}
