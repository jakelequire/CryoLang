# dependency_git_url_refused - a git dependency whose URL or ref git would
# read as an option, or whose URL names a refused transport, is refused when
# the cryoconfig is read: before the lock is consulted and before any git
# process starts.  `--version` is the harmless probe: had it reached
# `git clone`, git would have answered it.
[project]
project_name = "dependency_git_url_refused"
output_dir   = "build"
target_type  = "executable"
source_dir   = "src"
entry_point  = "src/main.cryo"

[compiler]

[dependencies]
option_url   = { git = "--version", tag = "v1.0.0" }
upload_pack  = { git = "--upload-pack=touch", tag = "v1.0.0" }
plain_http   = { git = "http://example.com/acme/plain.git", tag = "v1.0.0" }
ssh_option   = { git = "ssh://-oProxyCommand=touch/acme/x.git", tag = "v1.0.0" }
scp_option   = { git = "-oProxyCommand=touch@host:acme/x.git", tag = "v1.0.0" }
local_path   = { git = "../somewhere/repo", tag = "v1.0.0" }
option_tag   = { git = "https://example.com/acme/tagged.git", tag = "--orphan=x" }
option_rev   = { git = "https://example.com/acme/revved.git", rev = "--detach" }
