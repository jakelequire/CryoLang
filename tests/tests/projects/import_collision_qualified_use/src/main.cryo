namespace ImportCollisionQualifiedUse::Main;

import ImportCollisionQualifiedUse::Json;
import ImportCollisionQualifiedUse::Toml;
import ImportCollisionQualifiedUse::Json::{ parse, Doc };
import ImportCollisionQualifiedUse::Toml::{ parse, Doc };

// `parse` and `Doc` are each imported twice.  Only the bare names are the
// collision: a qualified path names its own module's item.
function main() -> i32 {
    if (Toml::parse("1") != 2) { return 1; }
    if (Json::parse("1") != 1) { return 2; }
    if (ImportCollisionQualifiedUse::Toml::parse("1") != 2) { return 3; }
    const d: Toml::Doc = Toml::Doc { v: 7 };
    const e: ImportCollisionQualifiedUse::Json::Doc = ImportCollisionQualifiedUse::Json::Doc { v: 3 };
    if (d.v * 10 + e.v != 73) { return 4; }
    return 0;
}
