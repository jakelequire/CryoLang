# dependency_alias_refused - a dependency entry takes no `alias`: an import
# names a dependency's modules by the namespace its files declare, so a
# second name for it is refused when the cryoconfig is read, with help
# saying what to remove.
[project]
project_name = "dependency_alias_refused"
output_dir   = "build"
target_type  = "executable"
source_dir   = "src"
entry_point  = "src/main.cryo"

[compiler]

[dependencies]
ledger = { path = "ledger", alias = "Books" }
