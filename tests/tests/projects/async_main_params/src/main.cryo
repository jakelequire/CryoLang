/// An `async function main` that declares the C entry-point parameters. The
/// synthesized wrapper takes the same parameter list and forwards it to the
/// async root, so `argc`/`argv` reach the async body — and, exactly as for a
/// synchronous `main`, declaring parameters opts the entry point out of the
/// argc/argv/envp widening that publishes `std::env::args`.
///
/// The forwarded parameters are CLONED onto the wrapper, and a clone keeps the
/// annotation while dropping the resolved type. Type resolution has already run
/// by then, so without re-stamping it codegen cannot lower the parameter and
/// skips the entry point's body — which is what this project catches.
namespace AsyncMainParams::Main;

import std::core::intrinsics;
import std::future;
import std::time;
import std::future::executor;
import std::future::poll;
import std::future::timer;
import std::future::waker;
import std::time::duration;

async function nap(ms: u64, v: i64) -> i64 {
    await Sleep::new(Duration::from_millis(ms));
    return v;
}

async function main(argc: i32, argv: u8**) -> i32 {
    const r: i64 = await nap(20u64, 5);
    if (argc < 1) { return 1; }
    if (argv == null) { return 2; }
    if (argv[0] == null) { return 3; }
    intrinsics::printf("argv async main ran\n");
    return r as i32;
}
