# test_json_misshapen_assertion_refused - `cryo test` refuses a project
# whose test.json writes an assertion in the wrong shape, naming the key and
# the form it takes, instead of dropping the assertion and passing the
# project whatever it prints.  The two projects under tests/projects run a
# program that prints nothing, so either one read as assertion-free passes.
# This project's own cryoconfig is never built: the command is `test
# --suite=projects`, which runs only those two.
[project]
project_name = "test_json_misshapen_assertion_refused"
output_dir   = "build"

