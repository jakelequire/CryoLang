namespace StaticPathCallBindsLentParameter;

// A static method whose implementation lends it a parameter only the
// arguments bind (`E` in `implement<E> trait Convert<E> for Report`) is
// called through the owner's path as it is through a bound: each argument
// type makes its own instance, on a plain owner and on a generic one.

type trait Convert<S> { static convert(source: S) -> This; }
type trait Fault { code(&this) -> i64; }

type struct Report { code: i64; }
implement<E> trait Convert<E> for struct Report where E: Fault {
    static convert(source: E) -> Report { return Report { code: source.code() + 100 }; }
}

type struct Wrapped<T> { code: i64; }
implement<T, E> trait Convert<E> for struct Wrapped<T> where E: Fault {
    static convert(source: E) -> Wrapped<T> { return Wrapped { code: source.code() + 200 }; }
}

type struct Disk { unit: i64; }
implement trait Fault for struct Disk { code(&this) -> i64 { return this.unit; } }

type struct Net { port: i64; }
implement trait Fault for struct Net { code(&this) -> i64 { return this.port * 2; } }

function lift<F, E>(source: E) -> F where F: Convert<E> { return F::convert(source); }

function main() -> i32 {
    const from_disk: Report = Report::convert(Disk { unit: 7 });
    if (from_disk.code != 107) { return 1; }
    const from_net: Report = Report::convert(Net { port: 4 });
    if (from_net.code != 108) { return 2; }
    const lifted: Report = lift::<Report, Disk>(Disk { unit: 1 });
    if (lifted.code != 101) { return 3; }
    const wrapped: Wrapped<i32> = Wrapped::<i32>::convert(Disk { unit: 3 });
    if (wrapped.code != 203) { return 4; }
    return 0;
}
