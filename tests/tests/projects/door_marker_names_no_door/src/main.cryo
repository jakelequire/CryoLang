/// A door's doc comment names one of the compiler's doors.  A marker naming
/// anything else - a misspelt id on a function or on a method - is refused
/// where it is written; a marker naming a door is not.
namespace compiler::resolver::lookup;

type struct Names {
    count: i32;
}

implement struct Names {
    /// Door `intern`.  Text becomes a name here.
    intern(mut &this, text: string) -> i32 {
        this.count = this.count + 1;
        return text.length() as i32;
    }

    /// Door `member-feild`.  A misspelt door.
    field_of(&this, text: string) -> i32 {
        return text.length() as i32;
    }
}

/// Door `scope-valu`.  A misspelt door.
function lookup_value(text: string) -> i32 {
    return text.length() as i32;
}

function main() -> i32 {
    mut n: Names = Names { count: 0 };
    return n.intern("ab") + n.field_of("c") + lookup_value("d") - 4;
}
