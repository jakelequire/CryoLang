// A compile-time integer is computed in the type of each of its operands, as
// the running program computes it: a complement flips the bits of its
// operand's width and a left shift drops the bits shifted past it, however
// wide the constant it lands in.  Module constants and an array size are each
// compared with the same operation on a value only known when the program
// runs.
import std::fmt;

namespace ConstantComputedInItsOperandsType::Main;

const U8_NOT: u16 = ~u8::MIN;
const U8_SHL: u16 = u8::MAX << 4;
const U16_NOT: u32 = ~u16::MIN;
const U16_SHL: u32 = u16::MAX << 4;
const U32_NOT: u64 = ~u32::MIN;
const U32_SHL: u64 = u32::MAX << 4;
const U64_NOT: u128 = ~u64::MIN;
const U64_SHL: u128 = u64::MAX << 4;
const U128_NOT: u128 = ~u128::MIN;
const U128_SHL: u128 = u128::MAX << 4;
const I8_SHL: i16 = i8::MAX << 1;
const I16_SHL: i32 = i16::MAX << 1;
const I32_SHL: i64 = i32::MAX << 1;
const I64_SHL: i128 = i64::MAX << 1;
const I128_SHL: i128 = i128::MAX << 1;
const I8_NOT: i16 = ~(0 as i8);
const U8_NOT_SHR: u16 = ~u8::MIN >> 4;
const I8_SHR: i16 = (i8::MIN as i8) >> 2;

const NARROW: u8 = 0xF0;
const WIDE: u16 = 1000;
const MIXED: u32 = ~NARROW + WIDE;
const DEFAULTED = 255;
const DEFAULTED_SHL: i64 = DEFAULTED << 28;
const SUFFIXED: u16 = ~0u8;
const CAST_SHL: u64 = (u8::MAX as u16) << 4;
const WORD: u32 = 0x12345678;
const MASKED: u32 = WORD & ~0xFF;
const SIZED: [u8; ~NARROW] = [3; 15];

function keep<T>(value: T) -> T { return value; }

function same(name: string, constant: i128, run: i128) -> i32 {
    if (constant == run) { return 0; }
    fmt::println(f"{name}: constant {constant}, run {run}");
    return 1;
}

function module_constants() -> i32 {
    mut wrong: i32 = 0;
    wrong += same("U8_NOT", U8_NOT as i128, (~keep(u8::MIN)) as i128);
    wrong += same("U8_SHL", U8_SHL as i128, (keep(u8::MAX) << 4) as i128);
    wrong += same("U16_NOT", U16_NOT as i128, (~keep(u16::MIN)) as i128);
    wrong += same("U16_SHL", U16_SHL as i128, (keep(u16::MAX) << 4) as i128);
    wrong += same("U32_NOT", U32_NOT as i128, (~keep(u32::MIN)) as i128);
    wrong += same("U32_SHL", U32_SHL as i128, (keep(u32::MAX) << 4) as i128);
    wrong += same("U64_NOT", U64_NOT as i128, (~keep(u64::MIN)) as i128);
    wrong += same("U64_SHL", U64_SHL as i128, (keep(u64::MAX) << 4) as i128);
    wrong += same("U128_NOT", U128_NOT as i128, (~keep(u128::MIN)) as i128);
    wrong += same("U128_SHL", U128_SHL as i128, (keep(u128::MAX) << 4) as i128);
    wrong += same("I8_SHL", I8_SHL as i128, (keep(i8::MAX) << 1) as i128);
    wrong += same("I16_SHL", I16_SHL as i128, (keep(i16::MAX) << 1) as i128);
    wrong += same("I32_SHL", I32_SHL as i128, (keep(i32::MAX) << 1) as i128);
    wrong += same("I64_SHL", I64_SHL as i128, (keep(i64::MAX) << 1) as i128);
    wrong += same("I128_SHL", I128_SHL, keep(i128::MAX) << 1);
    wrong += same("I8_NOT", I8_NOT as i128, (~keep(0 as i8)) as i128);
    wrong += same("U8_NOT_SHR", U8_NOT_SHR as i128, (~keep(u8::MIN) >> 4) as i128);
    wrong += same("I8_SHR", I8_SHR as i128, (keep(i8::MIN) >> 2) as i128);
    wrong += same("MIXED", MIXED as i128, (~keep(NARROW) + keep(WIDE)) as i128);
    wrong += same("DEFAULTED_SHL", DEFAULTED_SHL as i128, (keep(255) << 28) as i128);
    wrong += same("SUFFIXED", SUFFIXED as i128, (~keep(0u8)) as i128);
    wrong += same("CAST_SHL", CAST_SHL as i128, (keep(u8::MAX as u16) << 4) as i128);
    wrong += same("MASKED", MASKED as i128, (keep(WORD) & ~0xFF) as i128);
    wrong += same("SIZED", SIZED[14] as i128, 3);
    return wrong;
}

function main() -> i32 {
    const wrong: i32 = module_constants();
    fmt::println(f"{wrong} wrong of 24");
    return wrong;
}
