/// Array types written in brackets: `[T]` is a dynamic array and `[T; N]` a
/// fixed one.  Each names the same type as its postfix spelling, `T[]` and
/// `T[N]`, so a value written with one passes where the other is written,
/// by value, in every position a type is written: parameters, fields,
/// locals, generic arguments, function types, references and pointers.  The
/// two spellings differing anywhere would be refused there.
///
/// The element is a whole type, so `&[Node*]` is a reference to an array of
/// pointers, `[&Node]` an array of references, and `[[u64; 2]; 3]` three
/// rows of `[u64; 2]` - the length nearest the element is the inner one.
///
/// Each check reads values back through the type and returns 0, or the
/// number of the comparison that failed.  `main` prints how many passed and
/// exits 0 only when all did.
namespace ArrayTypeCircumfix::Main;

import std::ffi::libc;

type struct Node { v: i64; }

const ROW: i64 = 2;
const GRID: [[u64; 2]; 3] = [[1, 2], [3, 4], [5, 6]];
const GRID_POSTFIX: u64[2][3] = [[1, 2], [3, 4], [5, 6]];

type struct Holder {
    written_new: [i64];
    written_old: i64[];
    fixed_new: [u8; 4];
    fixed_old: u8[4];
}

function sum_new(xs: [i64]) -> i64 {
    mut total: i64 = 0;
    for (mut i: i64 = 0; i < xs.length as i64; i++) { total += xs[i]; }
    return total;
}

function sum_old(xs: i64[]) -> i64 {
    mut total: i64 = 0;
    for (mut i: i64 = 0; i < xs.length as i64; i++) { total += xs[i]; }
    return total;
}

function length_new(xs: &[i64]) -> i64 { return xs.length as i64; }
function length_old(xs: &i64[]) -> i64 { return xs.length as i64; }

function sum_through_pointers(xs: &[Node*]) -> i64 {
    mut total: i64 = 0;
    for (mut i: i64 = 0; i < xs.length as i64; i++) { total += xs[i].v; }
    return total;
}

function sum_through_references(xs: &[&Node]) -> i64 {
    mut total: i64 = 0;
    for (mut i: i64 = 0; i < xs.length as i64; i++) { total += xs[i].v; }
    return total;
}

function first_row_sum(g: [[u64; 2]; 3]) -> u64 {
    return g[0][0] + g[0][1];
}

function apply_all(fs: &[(i64) -> i64], x: i64) -> i64 {
    mut total: i64 = 0;
    for (mut i: i64 = 0; i < fs.length as i64; i++) { total += fs[i](x); }
    return total;
}

function double(x: i64) -> i64 { return x * 2; }
function triple(x: i64) -> i64 { return x * 3; }

function parameters_take_either_spelling() -> i64 {
    const a: i64[] = [1, 2, 3];
    const b: [i64] = [4, 5];
    if (sum_new(a) != 6) { return 1; }
    if (sum_old(b) != 9) { return 2; }
    return 0;
}

function fields_take_either_spelling() -> i64 {
    const old_values: i64[] = [7, 8];
    const new_values: [i64] = [9];
    const low: u8[4] = [1, 2, 3, 4];
    const high: [u8; 4] = [5, 6, 7, 8];
    const h: Holder = Holder {
        written_new: old_values,
        written_old: new_values,
        fixed_new:   low as u8[4],
        fixed_old:   high as [u8; 4],
    };
    if (length_new(&h.written_old) + length_old(&h.written_new) != 3) { return 1; }
    if (h.written_new[1] + h.written_old[0] != 17) { return 2; }
    if (h.fixed_new[3] as i64 + h.fixed_old[0] as i64 != 9) { return 3; }
    return 0;
}

function locals_take_either_spelling() -> i64 {
    const a: [i64] = [1, 2];
    const b: i64[] = a;
    const c: [i64] = b;
    if (c.length as i64 != 2) { return 1; }
    const f: [u8; 3] = [1, 2, 3];
    const g: u8[3] = f;
    const h: [u8; 3] = g;
    if (h[2] as i64 != 3) { return 2; }
    return 0;
}

function generic_arguments_take_either_spelling() -> i64 {
    const xs: [i64] = [1, 2, 3, 4];
    const wrapped: Option<[i64]> = Option::Some(xs);
    const rewrapped: Option<i64[]> = wrapped;
    if (rewrapped.unwrap().length as i64 != 4) { return 1; }
    return 0;
}

function function_types_take_either_spelling() -> i64 {
    const f: ([i64]) -> i64 = sum_old;
    const g: (i64[]) -> i64 = sum_new;
    const xs: [i64] = [2, 3];
    const ys: i64[] = [4];
    if (f(xs) + g(ys) != 9) { return 1; }
    return 0;
}

function references_and_pointers_take_either_spelling() -> i64 {
    mut xs: i64[] = [1, 2, 3];
    const r: &[i64] = &xs;
    const r2: &i64[] = r;
    if (r2.length as i64 != 3) { return 1; }
    const p: [i64]* = &xs as i64[]*;
    const q: i64[]* = p;
    if ((*q).length as i64 != 3) { return 2; }
    return 0;
}

function reference_takes_the_whole_array_of_pointers() -> i64 {
    mut a: Node = Node { v: 3 };
    mut b: Node = Node { v: 4 };
    mut ptrs: [Node*] = [];
    ptrs.push(&a as Node*);
    ptrs.push(&b as Node*);
    if (sum_through_pointers(&ptrs) != 7) { return 1; }
    return 0;
}

function brackets_make_an_array_of_references() -> i64 {
    const a: Node = Node { v: 5 };
    const b: Node = Node { v: 6 };
    mut refs: [&Node] = [];
    refs.push(&a);
    refs.push(&b);
    if (refs.length as i64 != 2) { return 1; }
    if (sum_through_references(&refs) != 11) { return 2; }
    return 0;
}

function brackets_make_an_array_of_functions() -> i64 {
    mut fs: [(i64) -> i64] = [];
    fs.push(double);
    fs.push(triple);
    if (apply_all(&fs, 2) != 10) { return 1; }
    return 0;
}

function nested_fixed_lengths_read_outside_in() -> i64 {
    if (GRID.length as i64 != 3) { return 1; }
    if (GRID[0].length as i64 != 2) { return 2; }
    if (GRID[2][1] as i64 != 6) { return 3; }
    if (first_row_sum(GRID_POSTFIX) as i64 != 3) { return 4; }
    return 0;
}

function constant_lengths_fold() -> i64 {
    const a: [i64; ROW] = [1, 2];
    const b: [i64; ROW * 2] = [1, 2, 3, 4];
    const c: i64[4] = b;
    if (a.length as i64 + c.length as i64 != 6) { return 1; }
    return 0;
}

function optional_after_brackets_wraps_the_array() -> i64 {
    mut maybe: [i64]? = Option::None;
    if (!maybe.is_none()) { return 1; }
    const xs: [i64] = [1, 2, 3];
    maybe = Option::Some(xs);
    const same: i64[]? = maybe;
    if (same.unwrap().length as i64 != 3) { return 2; }
    return 0;
}

function optional_inside_brackets_wraps_each_element() -> i64 {
    const some: i64? = Option::Some(9);
    const none: i64? = Option::None;
    mut slots: [i64?] = [];
    slots.push(some);
    slots.push(none);
    if (slots.length as i64 != 2) { return 1; }
    if (slots[0].unwrap() != 9) { return 2; }
    if (!slots[1].is_none()) { return 3; }
    return 0;
}

function report(name: string, failed_at: i64) -> i64 {
    if (failed_at == 0) { return 1; }
    libc::printf("FAIL %s at comparison %d\n", name, failed_at);
    return 0;
}

function main() -> i32 {
    mut passed: i64 = 0;
    passed += report("parameters", parameters_take_either_spelling());
    passed += report("fields", fields_take_either_spelling());
    passed += report("locals", locals_take_either_spelling());
    passed += report("generic arguments", generic_arguments_take_either_spelling());
    passed += report("function types", function_types_take_either_spelling());
    passed += report("references and pointers", references_and_pointers_take_either_spelling());
    passed += report("array of pointers", reference_takes_the_whole_array_of_pointers());
    passed += report("array of references", brackets_make_an_array_of_references());
    passed += report("array of functions", brackets_make_an_array_of_functions());
    passed += report("nested fixed", nested_fixed_lengths_read_outside_in());
    passed += report("constant lengths", constant_lengths_fold());
    passed += report("optional array", optional_after_brackets_wraps_the_array());
    passed += report("array of optionals", optional_inside_brackets_wraps_each_element());
    libc::printf("array_type_circumfix: %d of 13 passed\n", passed);
    if (passed != 13) { return 1; }
    return 0;
}
