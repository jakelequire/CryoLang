namespace TypeArgumentsWithoutPathSeparatorFix;

import std::core::default::{ Default };

type struct Holder {
    value: i64;

    static build<T>() -> T where T: Default { return T::default(); }

    get<T>(&this) -> T where T: Default { return T::default(); }
}

function make<T>() -> T where T: Default { return T::default(); }

function pick<T>(first: T, second: T) -> T { return second; }

function remake<T>(seed: T) -> T where T: Default {
    return make<T>();
}

function main() -> i32 {
    const made: i64 = make<i64>();
    const built: i64 = Holder::build<i64>();
    const holder: Holder = Holder { value: 1 };
    const got: i64 = holder.get<i64>();
    const picked: i64 = pick<i64>(1, 2);
    const remade: i64 = remake::<i64>(9);
    // Values on both sides of the `<`: a comparison, not a call.
    const one: i64 = 1;
    const two: i64 = 2;
    const compared: boolean = one < two > (false);
    if (made != 0 || built != 0 || got != 0 || picked != 2 || remade != 0 || !compared) { return 1; }
    return 0;
}
