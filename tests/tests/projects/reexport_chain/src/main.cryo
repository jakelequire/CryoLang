/// Imports only the far end of the chain, and names `Widget` in braces -- the
/// only form that can reach it. `Top` declares nothing; the name travels two
/// `export` hops, and the brace list is what follows them.
namespace ReexportChain::Main;

import ReexportChain::Top;
import ReexportChain::Top::{ Widget };

function main() -> int {
    const w: Widget = Widget::of(9);
    return w.unwrap() as int;
}
