/// The declaring module. Nothing imports it; it is reached only by re-export.
namespace ReexportChain::Deep;

type struct Widget {
    v: i32;

    /// A static call is what distinguishes the two lanes. A type ANNOTATION
    /// resolves through module-level reachability, which is closed over
    /// re-exports without limit, so it cannot tell one hop from two. A static
    /// call needs the name bound in SCOPE, and that binding is what stops at
    /// whatever depth the import walk stops at.
    static of(n: i32) -> Widget { return Widget { v: n }; }

    unwrap(&this) -> i32 { return this.v; }
}
