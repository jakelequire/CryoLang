# reexport_chain - an `export` may name what the exporting module itself
# obtained through an `export`, without limit.
#
# Top -> Mid -> Deep, and `main` imports only Top. Every hop is written down:
# a module that writes no `export` re-exports nothing, so `Widget` arrives
# here because three modules each said so, not by propagation.
#
# Also the control on build ORDER: none of these three edges is a dependency
# edge, so nothing orders Deep before Top. If re-export resolution needed
# topological order it would fail here rather than intermittently.

[project]
project_name = "reexport_chain"
output_dir   = "build"
target_type  = "executable"
source_dir   = "src"
entry_point  = "src/main.cryo"

[compiler]

[dependencies]
