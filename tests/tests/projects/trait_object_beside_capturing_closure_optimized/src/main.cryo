namespace Main;

import std::fmt;

type trait Shape {
    area(&this, extra: i32) -> i32;
}

type struct Square {
    side: i32;
}

type struct Rectangle {
    width: i32;
    height: i32;
}

implement trait Shape for struct Square {
    area(&this, extra: i32) -> i32 { return this.side * this.side + extra; }
}

implement trait Shape for struct Rectangle {
    area(&this, extra: i32) -> i32 { return this.width * this.height - extra; }
}

// Copied for each capturing closure's type; the copy's `shape` is still a
// trait object, so each argument must arrive as one.
function measure(base: i32, adjust: (i32) -> i32, shape: virtual &Shape) -> i32 {
    return adjust(base) + shape.area(base);
}

function main() -> i32 {
    const square: Square = Square { side: 5 };
    const rectangle: Rectangle = Rectangle { width: 4, height: 6 };
    const bias: i32 = 7;
    const plain: i32 = measure(3, (x: i32) -> i32 { return x * 2; }, &square);
    const captured: i32 = measure(3, (x: i32) -> i32 { return x + bias; }, &square);
    const other: i32 = measure(2, (x: i32) -> i32 { return x * bias; }, &rectangle);
    fmt::println(f"beside a closure: {plain} {captured} {other}");
    return 0;
}
