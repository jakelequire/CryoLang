/// Buffers a `TlsStream` while importing only the stream module: its
/// `AsyncTransport` implementation lives beside the type, so `fill` is found
/// without the TLS futures module in scope. The fill is never run (it would
/// need a reactor and a handshaken peer); the function holding it is checked
/// whether or not anything calls it.
namespace TlsStreamTransportNeedsNoFuturesImport::Main;

import std::fmt;
import std::core::result::{ Result };
import std::io::error::{ IoError };
import std::io::traits::{ AsyncRead };
import std::io::buffered::{ BufferedStream };
import std::net::tls::stream::{ TlsStream };

/// One fill of a buffered TLS stream: the bytes read, or -1 for an error.
async function fill_once(tls: TlsStream) -> i64 {
    mut stream: BufferedStream<TlsStream> = BufferedStream::<TlsStream>::of(tls);
    const filled: Result<i64, IoError> = await stream.fill();
    return match (filled) {
        Result::Ok(n)  => { n }
        Result::Err(e) => { -1 }
    };
}

function main() -> int {
    fmt::println("a buffered TLS stream needs no import of the TLS futures");
    return 0;
}
