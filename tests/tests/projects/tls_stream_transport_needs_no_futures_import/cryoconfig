# tls_stream_transport_needs_no_futures_import - `BufferedStream<TlsStream>`
# reads through `TlsStream`'s `AsyncTransport` implementation in a program
# that imports `std::net::tls::stream` but not `std::net::tls::future`.

[project]
project_name = "tls_stream_transport_needs_no_futures_import"
output_dir   = "build"
target_type  = "executable"
source_dir   = "src"
entry_point  = "src/main.cryo"

[compiler]

[dependencies]

# `std::net::tls` binds the system OpenSSL.
[link]
system = ["ssl", "crypto"]
