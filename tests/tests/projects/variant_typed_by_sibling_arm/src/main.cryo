namespace VariantTypedBySiblingArm;

import std::fmt;

function pick(c: boolean) -> Option<i32> {
    // `?` gives its operand no expected type, so only the sibling arm says
    // which `Option` the `None` is.
    const value: i32 = (if (c) { Option::Some(40) } else { Option::None })?;
    return Option::Some(value + 2);
}

function shown(o: Option<i64>) -> i64 {
    return match (o) {
        Option::Some(v) => { v }
        Option::None    => { -1 }
    };
}

function main() -> i32 {
    const wide: i64 = 7;
    // Each arm with no instance takes its sibling's, in either position.
    const first = if (wide > 3) { Option::None } else { Option::Some(wide) };
    const second = wide > 3 ? Option::Some(wide * 2) : Option::None;
    const third = match (wide) {
        1 => { Option::None }
        2 => { Option::None }
        _ => { Option::Some(wide + 100) }
    };
    const typed: Result<i32, u8> = Result::Err(9);
    const fourth = if (wide > 3) { Result::Ok(5) } else { typed };
    const fifth: i32 = match (fourth) {
        Result::Ok(v)  => { v }
        Result::Err(e) => { e as i32 }
    };
    const sixth: i32 = match (pick(true)) {
        Option::Some(v) => { v }
        Option::None    => { 0 }
    };
    const seventh: boolean = match (pick(false)) {
        Option::Some(_) => { false }
        Option::None    => { true }
    };
    fmt::println(f"sibling arms: {shown(first)} {shown(second)} {shown(third)} {fifth} {sixth} {seventh}");
    return 0;
}
