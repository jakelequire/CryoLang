namespace ConstantStructLiteralFieldOrder;

type struct Point {
    x: i32;
    y: i32;
}

/// Fields of three widths, so the layout holds padding between them.
type struct Mixed {
    tag:   u8;
    value: i64;
    small: u16;
}

type struct Segment {
    start: Point;
    end:   Point;
    width: i32;
}

const SWAPPED: Point = Point { y: 2, x: 1 };
const MIXED_REVERSED: Mixed = Mixed { small: 7, value: 1000, tag: 3 };
const NESTED: Segment = Segment {
    end:   Point { y: 6, x: 5 },
    start: Point { x: 3, y: 4 },
    width: 9,
};
const POINTS: [Point; 2] = [Point { y: 20, x: 10 }, Point { x: 30, y: 40 }];

function main() -> i32 {
    if (SWAPPED.x != 1 || SWAPPED.y != 2) { return 1; }
    if (MIXED_REVERSED.tag != 3 || MIXED_REVERSED.value != 1000 || MIXED_REVERSED.small != 7) { return 2; }
    if (NESTED.start.x != 3 || NESTED.start.y != 4) { return 3; }
    if (NESTED.end.x != 5 || NESTED.end.y != 6 || NESTED.width != 9) { return 4; }
    if (POINTS[0].x != 10 || POINTS[0].y != 20) { return 5; }
    if (POINTS[1].x != 30 || POINTS[1].y != 40) { return 6; }
    return 0;
}
