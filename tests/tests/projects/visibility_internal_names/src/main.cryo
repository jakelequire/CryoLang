namespace VisibilityInternalNames::Main;

import VisibilityInternalNames::Inner;
import Shelf;
import Shelf::{ restock };
import Shelf::{ Crate };

function main() -> int {
    // Another package's internal type is refused where it is named; its
    // public one is not.
    const l: Shelf::Ledger = Shelf::Ledger { v: 1 };
    const c: Crate = Crate::new();
    return (Inner::keep().v + c.count) as int;
}
