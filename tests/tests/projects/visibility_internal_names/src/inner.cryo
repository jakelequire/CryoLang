namespace VisibilityInternalNames::Inner;

internal type struct Hidden {
    v: i32;
}

private type struct Secret {
    v: i32;
}

public type struct Shown {
    public v: i32;
}

// A signature seen by other packages may not name an internal type, nor
// one seen by other modules a private type.
public function leak() -> Hidden { return Hidden { v: 5 }; }
internal function spill() -> Secret { return Secret { v: 6 }; }
public type struct Holder {
    public held: Hidden;
}
internal type struct Keeper {
    internal kept: Secret;
}

// None of these is refused: each is seen no further than what it names.
internal function keep() -> Hidden { return Hidden { v: 7 }; }
private function hold() -> Secret { return Secret { v: 8 }; }
internal type struct Box {
    public held: Hidden;
    private secret: Secret;
}
public function show() -> Shown { return Shown { v: 9 }; }
