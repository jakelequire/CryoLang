/// `P::go(&p)` names a method two traits implemented for `P` provide, and
/// `P` has no inherent `go` to prefer: the path is refused as a tie, and
/// the call it refuses has no method and so no return type.  The local it
/// initializes is a `string`, which only `Alpha`'s `go` returns; the call is
/// not typed as `Beta`'s `i64`, so nothing is reported against the local.
namespace StaticPathTieHasNoType::Main;

type trait Alpha { go(&this) -> string; }
type trait Beta { go(&this) -> i64; }

type struct P { v: i32; }

implement trait Alpha for P { go(&this) -> string { return "a"; } }
implement trait Beta for P { go(&this) -> i64 { return 5; } }

function main() -> i32 {
    const p: P = P { v: 3 };

    const s: string = P::go(&p);

    return 0;
}
