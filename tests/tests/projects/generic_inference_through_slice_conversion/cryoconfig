# generic_inference_through_slice_conversion - a fixed array or a container
# given for a `&Slice<T>` parameter converts to a slice at the call, and `T`
# is inferred as the slice's element.  A project rather than a unit-test file
# because a compiler that leaves `T` unbound stops at the call, which would
# stop the whole unit suite from building.

[project]
project_name = "generic_inference_through_slice_conversion"
output_dir   = "build"
target_type  = "executable"
source_dir   = "src"
entry_point  = "src/main.cryo"

