namespace GenericInferenceThroughSliceConversion::Helpers;

import std::core::slice::{ Slice };

/// The last element, for a call written through the module's name.
public function last_of<T>(items: &Slice<T>) -> T {
    return items[items.length() - 1];
}

/// Counts the elements of every slice it is given, through a static and an
/// instance method that each infer their own type parameter.
public type struct Tally {
    total: i64;

    public static count_of<T>(items: &Slice<T>) -> i64 {
        return items.length();
    }

    public add_all<T>(mut &this, items: &Slice<T>) -> void {
        this.total = this.total + items.length();
    }

    public last_seen<T>(&this, items: &Slice<T>) -> T {
        return items[items.length() - 1];
    }
}
