# bound_call_through_index_field_projection - a call a generic body writes
# on a bounded parameter names the bound's method however the receiver is
# reached - an index (`this.ptr[i].equals(value)`), a field of an
# instantiation (`node.key.equals(key)`), a projection (`value.compare(&best)`
# under `where This::Item: Ord`) - so a type with an inherent method of the
# same name beside its `Eq`/`Ord` impl runs the trait's, with no ambiguity.
[project]
project_name = "bound_call_through_index_field_projection"
output_dir   = "build"
target_type  = "executable"
source_dir   = "src"
entry_point  = "src/main.cryo"
[compiler]
[dependencies]
