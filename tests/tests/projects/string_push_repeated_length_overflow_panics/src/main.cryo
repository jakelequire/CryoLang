/// 4 bytes times 2^62 more copies wraps an i64 to zero.  `push_repeated`
/// refuses that length with a panic; growing the string by the wrapped size
/// and copying would write far past its buffer.
namespace StringPushRepeatedLengthOverflow::Main;

import std::fmt;
import std::collections::string::{ String };

function main() -> i32 {
    mut s: String = String::new();
    s.push_repeated(0x1F600 as char, 4611686018427387905);
    fmt::println(f"pushed {s.length()} bytes");
    return 0;
}
