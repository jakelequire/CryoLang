namespace AliasFunctionTypeCall;

import AliasFunctionTypeCall::scales::{ Scale, Weight, double_it };

type Step = (i64) -> i64;

function bump(x: i64) -> i64 { return x + 1; }

function apply_step(s: Step, v: i64) -> i64 {
    return s(v);
}

function apply_scale(s: Scale, w: Weight) -> Weight {
    return s(w);
}

function main() -> i32 {
    if (apply_step(bump, 2) != 3) { return 1; }
    if (apply_scale(double_it, 5) != 10) { return 2; }
    const local: Step = bump;
    if (apply_step(local, 9) != 10) { return 3; }
    return 0;
}
