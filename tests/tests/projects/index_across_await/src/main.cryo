/// A local held across an `await` moves into the future's frame, and every
/// mention of it after the `await` is rewritten to reach it there - the
/// call `xs[i]` stands for among them.
namespace IndexAcrossAwait::Main;

import std::fmt;
import std::future;
import std::collections::array::{ Array };

async function step() -> i64 { return 1; }

async function library_array() -> i64 {
    mut v: Array<u8> = [1, 2, 3];
    const z: i64 = await step();
    v[1] = 20;
    v[2] += 5;
    return v[0] as i64 + v[1] as i64 + v[2] as i64 + z - 1;
}

async function builtin_array() -> i64 {
    mut v: [u8] = [1, 2, 3];
    const z: i64 = await step();
    v[1] = 20;
    v[2] += 5;
    return v[0] as i64 + v[1] as i64 + v[2] as i64 + z - 1;
}

function main() -> i32 {
    const a: i64 = future::block_on(library_array());
    const b: i64 = future::block_on(builtin_array());
    fmt::println(f"library {a} builtin {b}");
    return 0;
}
