# spelling_lint_allows_with_reason - a declaration taking a spelling type
# builds when `![allow(lookup_by_spelling, reason = "...")]` on it says why
# (outcome = "run").
#
# `spelling_lint_refuses_unallowed` with an allow and a reason on each of its
# five refused declarations: the same program, built and run.

[project]
project_name = "spelling_lint_allows_with_reason"
output_dir   = "build"
target_type  = "executable"
source_dir   = "src"
entry_point  = "src/main.cryo"

