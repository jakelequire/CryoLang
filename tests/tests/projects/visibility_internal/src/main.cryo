namespace VisibilityInternal::Main;

import VisibilityInternal::Inner;
import Shelf;
import Shelf::Stock;

function main() -> int {
    // The same package: internal items and members are reached from
    // another module.
    const h: Inner::Hidden = Inner::make();
    const v: i32 = h.v + h.weigh() + Inner::Hidden::spare().v + Inner::LIMIT;

    // Another package: every internal item and member is refused.
    const a: i32 = Shelf::restock();
    const b: i32 = Shelf::LIMIT;
    const c: i32 = Shelf::counter;
    const crate: Shelf::Crate = Shelf::Crate::new();
    const w: i32 = crate.weight;
    const t: i32 = crate.tare();
    const heavy: Shelf::Crate = Shelf::Crate::heavy();

    // Its public items and members are not.
    const n: i32 = crate.count + crate.total() + Stock::audit() + heavy.count;
    return (v + a + b + c + w + t + n) as int;
}
