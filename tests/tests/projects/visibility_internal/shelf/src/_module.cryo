namespace Shelf;

public module Shelf::Stock;

internal function restock() -> i32 { return 3; }
internal const LIMIT: i32 = 9;
internal mut counter: i32 = 0;

internal type struct Ledger {
    v: i32;
}

public type struct Crate {
    public count: i32;
    internal weight: i32;

    public static new() -> Crate { return Crate { count: 1, weight: 2 }; }
    internal static heavy() -> Crate { return Crate { count: 1, weight: 50 }; }
    internal tare(&this) -> i32 { return this.weight; }
    public total(&this) -> i32 { return this.count + this.tare(); }
}
