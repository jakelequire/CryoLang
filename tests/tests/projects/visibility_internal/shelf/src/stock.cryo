namespace Shelf::Stock;

import Shelf::{ restock };

// Another module of the same package reaches every internal item and
// member: none of these is refused.
public function audit() -> i32 {
    const l: Shelf::Ledger = Shelf::Ledger { v: Shelf::LIMIT };
    const c: Shelf::Crate = Shelf::Crate::heavy();
    return restock() + l.v + c.weight + c.tare() + Shelf::counter;
}
