// Two references compared with an operator compare the values they refer
// to when the referent implements the operator's trait (`Eq` for `==` and
// `!=`, `Ord` for `<`, `>`, `<=`, `>=`), whatever kind of type it is, so the
// operator always agrees with `equals` and `compare`.  Each pair below lives
// at two addresses, so a comparison of the addresses answers differently.
// A referent that implements no `Eq` compares its addresses once the
// references are converted to pointers.
![config(testing)]
namespace CryoTests::Tests::Projects::ReferenceComparisonByValue;

import std::core::result::{ Result };
import std::core::cmp::{ Ordering };
import std::collections::str::{ Str };
import std::fmt;
import std::test::error::{ TestError };
import std::test::assert::{ expect_true, expect_false, expect_equal };

type struct Point {
    x: i64;
    y: i64;
}

implement trait Eq for Point {
    equals(&this, other: &Point) -> boolean { return this.x == other.x && this.y == other.y; }
}

type struct Plain {
    value: i64;
}

![test]
function integers_compare_their_values() -> Result<(), TestError> {
    const four: i64 = 4;
    const other_four: i64 = 4;
    const five: i64 = 5;
    const a: &i64 = &four;
    const b: &i64 = &other_four;
    const c: &i64 = &five;
    expect_true(a == b, Str::new("two references to equal values are equal"))?;
    expect_false(a != b, Str::new("two references to equal values are not unequal"))?;
    expect_false(a == c, Str::new("4 does not equal 5"))?;
    expect_true(a < c, Str::new("4 < 5"))?;
    expect_true(c > a, Str::new("5 > 4"))?;
    expect_false(c < a, Str::new("5 < 4 is false"))?;
    expect_false(a > c, Str::new("4 > 5 is false"))?;
    expect_true(a <= b, Str::new("4 <= 4"))?;
    expect_true(a >= b, Str::new("4 >= 4"))?;
    expect_false(c <= a, Str::new("5 <= 4 is false"))?;
    return expect_false(a >= c, Str::new("4 >= 5 is false"));
}

![test]
function operators_agree_with_equals_and_compare() -> Result<(), TestError> {
    const small: u8 = 7;
    const large: u8 = 200;
    const same: u8 = 7;
    const s: &u8 = &small;
    const l: &u8 = &large;
    const t: &u8 = &same;
    expect_equal(s == t, s.equals(t))?;
    expect_equal(s == l, s.equals(l))?;
    expect_equal(s < l, s.compare(l) == Ordering::Less)?;
    expect_equal(l < s, l.compare(s) == Ordering::Less)?;
    expect_equal(s > l, s.compare(l) == Ordering::Greater)?;
    return expect_equal(s <= t, s.compare(t) != Ordering::Greater);
}

![test]
function chars_booleans_and_strings_compare_their_values() -> Result<(), TestError> {
    const letter: char = 'q';
    const same_letter: char = 'q';
    const later: char = 'z';
    expect_true(&letter == &same_letter, Str::new("'q' == 'q'"))?;
    expect_true(&letter < &later, Str::new("'q' < 'z'"))?;
    const yes: boolean = true;
    const also_yes: boolean = true;
    expect_true(&yes == &also_yes, Str::new("true == true"))?;
    const written: string = "abc";
    const built: string = fmt::format("%s%s", "ab", "c").into_raw();
    const earlier: string = "abb";
    const w: &string = &written;
    const b: &string = &built;
    const e: &string = &earlier;
    expect_true(w == b, Str::new("two strings with the same bytes are equal"))?;
    expect_true(e < w, Str::new("\"abb\" < \"abc\""))?;
    return expect_equal(w == b, w.equals(b));
}

![test]
function floats_compare_as_equals_does() -> Result<(), TestError> {
    const half: f64 = 0.5;
    const other_half: f64 = 0.5;
    expect_true(&half == &other_half, Str::new("0.5 == 0.5"))?;
    const zero: f64 = 0.0;
    const not_a_number: f64 = zero / zero;
    const n: &f64 = &not_a_number;
    // A NaN equals nothing, itself included, through the same reference too.
    expect_false(n == n, Str::new("a NaN is not equal to itself"))?;
    expect_true(n != n, Str::new("a NaN is unequal to itself"))?;
    return expect_equal(n == n, n.equals(n));
}

![test]
function writable_references_compare_their_values() -> Result<(), TestError> {
    mut first: i64 = 9;
    mut second: i64 = 9;
    const a: mut &i64 = &first;
    const b: mut &i64 = &second;
    expect_true(a == b, Str::new("two writable references to 9 are equal"))?;
    *b = 10;
    expect_true(a < b, Str::new("9 < 10 after the write"))?;
    return expect_true(a != b, Str::new("9 != 10 after the write"));
}

![test]
function a_struct_with_eq_compares_by_value() -> Result<(), TestError> {
    const p: Point = Point { x: 1, y: 2 };
    const q: Point = Point { x: 1, y: 2 };
    const r: Point = Point { x: 2, y: 1 };
    expect_true(&p == &q, Str::new("equal points are equal"))?;
    return expect_true(&p != &r, Str::new("different points are unequal"));
}

![test]
function a_referent_with_no_eq_compares_by_identity() -> Result<(), TestError> {
    const one: Plain = Plain { value: 1 };
    const other: Plain = Plain { value: 1 };
    const a: &Plain = &one;
    const b: &Plain = &other;
    const again: &Plain = &one;
    expect_false((a as Plain*) == (b as Plain*), Str::new("two values with no Eq are two values"))?;
    return expect_true((a as Plain*) == (again as Plain*), Str::new("a reference equals one to the same value"));
}
