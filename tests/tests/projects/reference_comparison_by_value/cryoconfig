# reference_comparison_by_value - two references compared with `==`, `!=`, `<`, `>`, `<=` or `>=`
# compare the values they refer to when the referent implements `Eq` (or `Ord`), whatever kind of
# type it is - an integer, a `char`, a `boolean`, a `string`, a float, a struct - so the operator
# agrees with `equals` and `compare`; a referent with no `Eq` compares by identity.
[project]
project_name = "reference_comparison_by_value"
output_dir   = "build"
target_type  = "executable"
source_dir   = "src"
entry_point  = "src/main.cryo"

