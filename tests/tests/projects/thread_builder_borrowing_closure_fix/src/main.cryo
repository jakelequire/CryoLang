/// `thread::Builder::spawn` refuses a closure written without `move`, as
/// `thread::spawn` does: it borrows from a function that may return while the
/// thread still runs. The fix writes `move`.
namespace ThreadBuilderBorrowingClosureFix;

import std::thread;
import std::collections::string::{ String };

function main() -> int {
    const s: String = String::from("abcd");
    const h: thread::JoinHandle<i64> = thread::Builder::new().spawn(() -> i64 { return s.length() as i64; });
    return h.join() as int;
}
