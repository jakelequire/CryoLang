# reexport_glob_rejected - `export A::B::*;` does not parse.
#
# A glob re-export is the one form under which an importer's in-scope set
# changes when a CHILD module gains a declaration, with the new name written
# at neither end. It is excluded from the grammar rather than diagnosed later,
# so no stage has to decide what it means.
#
# Its own project because the rejection is a PARSE error: the parse abort
# stops the build before any later pass runs, so an arm sharing a project
# with it would never be reached and would pass while testing nothing.
#
# `A::B::*` remains legal as a LOCAL import. That control cannot live here --
# the parse abort means it would never be compiled, and "no complaint about it"
# would be a zero measured over nothing. It runs in reexport_basic instead.

[project]
project_name = "reexport_glob_rejected"
output_dir   = "build"
target_type  = "executable"
source_dir   = "src"
entry_point  = "src/main.cryo"

[compiler]

