///! A suite with one passing test, so a run that selects nothing is told
///! apart from a run of a suite that holds nothing.

![config(testing)]
namespace CryoTests::Tests::PatternMatchingNothing;

import std::core::result::{ Result };
import std::test::error::{ TestError };
import std::test::assert::{ expect_equal };

![test]
function two_and_two_make_four() -> Result<(), TestError> {
    return expect_equal(2 + 2, 4);
}
