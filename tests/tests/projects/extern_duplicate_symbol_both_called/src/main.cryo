namespace ExtDup::Main;

import ExtDup::First;
import ExtDup::Second;

function main() -> int {
    const big: i64 = -4294967301;
    // The narrow declaration first, so its type is the one the symbol is
    // declared with in this module; the wide call must still pass an i64.
    const n: i32 = ExtDup::First::llabs(-5);
    const r: i64 = ExtDup::Second::llabs(big);
    return if (r == 4294967301) { 7 } else { 3 + (n & 1) };
}
