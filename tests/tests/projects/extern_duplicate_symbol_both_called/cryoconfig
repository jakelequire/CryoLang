# extern_duplicate_symbol_both_called - both declarations of one C symbol
# are called from ONE module, the narrow one first, so the symbol is declared
# in that LLVM module at the narrow type; the wide call is still emitted at
# its own declaration's signature (`call i64 @llabs(i64)` against a
# `declare i32 @llabs(i32)`), which is what LLVM's opaque pointers allow and
# what the pin's declaration demands.  The narrow declaration is wrong about
# the C ABI and its own call answers wrongly, as the program wrote it.
[project]
project_name = "extern_duplicate_symbol_both_called"
output_dir   = "build"
target_type  = "executable"
source_dir   = "src"
entry_point  = "src/main.cryo"
[compiler]
[dependencies]
