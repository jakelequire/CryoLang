/// A static method called through a generic enum's path - its own, or one
/// a trait's generic implementation gives it - is the copy of that method
/// for the instantiation the path names, with the arguments written or
/// inferred from the expected type, as on a generic struct.
namespace GenericEnumStaticMethod::Main;

import std::ffi::libc::{ printf };

type trait Make {
    static make(code: i32) -> This;
}

type enum Outcome<T, E> {
    Good(T);
    Bad(E);
}

implement enum Outcome<T, E> {
    static bad_of(code: E) -> Outcome<T, E> { return Outcome::Bad(code); }

    error_or(this, fallback: i64) -> i64 {
        match (this) {
            Outcome::Good(_) => { return fallback; }
            Outcome::Bad(e) => { return e as i64; }
        }
    }
}

implement<T, E> trait Make for enum Outcome<T, E> {
    static make(code: i32) -> Outcome<T, E> { return Outcome::Bad((code * 3) as E); }
}

function check(passed: i32, condition: boolean, what: string) -> i32 {
    if (!condition) {
        printf("FAILED: %s\n", what);
        return passed;
    }
    return passed + 1;
}

function main() -> i32 {
    mut passed: i32 = 0;
    const written: Outcome<i64, i32> = Outcome::<i64, i32>::make(5);
    passed = check(passed, written.error_or(-1) == 15, "a trait's static method with the enum's arguments written");
    const inferred: Outcome<u8, i64> = Outcome::make(7);
    passed = check(passed, inferred.error_or(-1) == 21, "a trait's static method with the enum's arguments inferred");
    const inherent: Outcome<i64, i32> = Outcome::<i64, i32>::bad_of(9);
    passed = check(passed, inherent.error_or(-1) == 9, "the enum's own static method");
    printf("generic enum static methods: %d of 3 checks passed\n", passed);
    if (passed != 3) { return 1; }
    return 0;
}
