# unimported_type_suggests_its_brace_import - the import E0240 offers for a
# bare type name is one that binds the name.
#
# A plain `import M;` binds the module and no names from it, so offered for a
# bare `HashMap` it leaves the name unbound.  The fix names it in braces, and
# through the shortest module in the program whose exports offer that
# declaration: the file imports `std::collections` for `Pair`, so `HashMap` is
# offered through that facade, not `std::collections::hashmap`.  Nothing
# loads `std::time`'s facade, so `Duration` is offered through its declaring
# module - its own report and its own line.

[project]
project_name = "unimported_type_suggests_its_brace_import"
output_dir   = "build"
target_type  = "executable"
source_dir   = "src"
entry_point  = "src/main.cryo"

