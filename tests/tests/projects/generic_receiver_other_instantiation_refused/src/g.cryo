namespace GenericReceiverOtherInstantiationRefused::G;

import GenericReceiverOtherInstantiationRefused::B::{ Point };

type struct Wrapper<T> { val: T; }

type W<U> = Wrapper<U>;

implement struct Wrapper<T> {
    get(&this) -> T { return this.val; }
    only_b(this: &Wrapper<Point>) -> i64 { return this.val.x; }
    only_b_alias(this: &W<Point>) -> i64 { return this.val.x; }
}
