/// A method written for `Wrapper<B::Point>` - directly or through an alias
/// of the owner - does not exist on `Wrapper<A::Point>`, although both
/// arguments end in `Point`.
namespace GenericReceiverOtherInstantiationRefused::Main;

import GenericReceiverOtherInstantiationRefused::A;
import GenericReceiverOtherInstantiationRefused::G::{ Wrapper };

function main() -> i32 {
    const w: Wrapper<A::Point> = Wrapper::<A::Point> { val: A::make(7) };
    const d: i64 = w.only_b();
    const e: i64 = w.only_b_alias();
    return (d + e) as i32;
}
