/// A value has no address to compare, so a value beside a function or a
/// pointer is refused by the type check, each with the help that writes its
/// fix: a function compares only with a function or `null`; beside a
/// pointer to its own type the value is shown compared with the one the
/// pointer points to, where its type compares, and its address compared,
/// where it is a place; beside a `void*` only its address; beside a pointer
/// to another type, what that pointer's target compares with; and beside
/// `null`, which a value never is, the comparison is removed. A function
/// compared with a function or `null` stays allowed.
namespace ValueComparedWithAddressRefused::Main;

type struct Plain { value: i64; }

type struct Point { x: i64; y: i64; }

implement trait Eq for Point {
    equals(&this, other: &Point) -> boolean { return this.x == other.x && this.y == other.y; }
}

function noop() -> void { }

function main() -> i32 {
    const q: Plain = Plain { value: 1 };
    const n: i64 = 7;
    const point: Point = Point { x: 1, y: 2 };
    const fv: () -> void = noop;
    const to_n: const i64* = &n;
    const to_point: Point* = &point as Point*;
    const to_plain: Plain* = &q as Plain*;
    const untyped: void* = &q as void*;
    mut hits: i32 = 0;
    if (q == fv) { hits = hits + 1; }
    if (fv != n) { hits = hits + 1; }
    if (point == fv) { hits = hits + 1; }
    if (n == to_n) { hits = hits + 1; }
    if (to_point != point) { hits = hits + 1; }
    if (q == to_plain) { hits = hits + 1; }
    if (q == untyped) { hits = hits + 1; }
    if (n < to_n) { hits = hits + 1; }
    if (q == null) { hits = hits + 1; }
    if (null != n) { hits = hits + 1; }
    if (n + 1 == to_n) { hits = hits + 1; }
    if (n == to_point) { hits = hits + 1; }
    if (fv == null || fv == noop) { hits = hits + 1; }
    return hits;
}
