/// A class that declares a constructor is built by value by calling its
/// name, from its own module and through an import; the constructor is the
/// value its name answers in an expression.  Beside it, a module offering an
/// enum and a function under one leaf, the enum declared first: a call of
/// the leaf is the function.
namespace ClassConstructedByName::Main;

import ClassConstructedByName::Shapes::{ Widget, Tone };

type class Local {
public:
    n: i32;
    Local(n: i32) { this.n = n; }
}

function main() -> i32 {
    mut a: Local = Local(2);
    mut w: Widget = Widget(3);
    const t: i32 = Tone(4);
    return a.n + w.size + t;
}
