# dependency_nested_path - a path dependency's own path dependency is found
# where its cryoconfig says, relative to that cryoconfig, and the package
# that declares it names it.  `relay` declares `anchor` as `../anchor`; the
# program declares only `relay`.
[project]
project_name = "dependency_nested_path"
output_dir   = "build"
target_type  = "executable"
source_dir   = "src"
entry_point  = "src/main.cryo"

[compiler]

[dependencies]
relay = { path = "packages/relay" }
