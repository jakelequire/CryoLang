# path_turbofish_literal_argument - a generic method called through a path
# with a turbofish, `(BetaG for NgTf)::go::<u8>(&g, 7)`: the parameter the
# turbofish binds types the literal argument, so the call is selected where
# it is written and runs `go<u8>`.  Left to its `i32` default, the literal
# matched no signature there, and the selection after monomorphization
# picked the `go<i32>` a sibling call had made.
[project]
project_name = "path_turbofish_literal_argument"
output_dir   = "build"
target_type  = "executable"
source_dir   = "src"
entry_point  = "src/main.cryo"

