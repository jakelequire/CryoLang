namespace PathTurbofishLiteralArgument::Main;

type trait BetaG { go<U>(&this, u: U) -> i64; }

type struct NgTf { v: i32; }
implement trait BetaG for NgTf { go<U>(&this, u: U) -> i64 { return sizeof(U) as i64; } }

type struct Q { v: i32; }
implement struct Q { go<U>(&this, u: U) -> i64 { return sizeof(U) as i64; } }

function main() -> i32 {
    const g: NgTf = NgTf { v: 5 };
    const q: Q = Q { v: 5 };
    // The literal is an `i32` where nothing types it, and a `u8` / `u16`
    // where the turbofish does.
    if ((BetaG for NgTf)::go(&g, 7) != 4) { return 1; }
    if ((BetaG for NgTf)::go::<u8>(&g, 7) != 1) { return 2; }
    if (Q::go(&q, 7) != 4) { return 3; }
    if (Q::go::<u16>(&q, 7) != 2) { return 4; }
    return 0;
}
