/// A `![caller_location]` function takes its caller's location as a
/// hidden argument, so it cannot be taken as a value: a call through the
/// value would pass none.  Refused for a bare name and a qualified path.
namespace CallerLocationValue::Main;
import std::core::intrinsics;
![caller_location]
function where_called() -> u32 {
    return intrinsics::location().line;
}

function main() -> i32 {
    const f: () -> u32 = where_called;
    const g: () -> u32 = CallerLocationValue::Main::where_called;
    return (f() + g()) as i32;
}
