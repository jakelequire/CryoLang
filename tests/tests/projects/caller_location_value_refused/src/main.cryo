/// A `![caller_location]` function takes its caller's location as two
/// hidden arguments, so it cannot be taken as a value: a call through the
/// value would pass none.  Refused for a bare name and a qualified path.
namespace CallerLocationValue::Main;

![caller_location]
function where_called() -> u32 {
    return LINE;
}

function main() -> i32 {
    const f: () -> u32 = where_called;
    const g: () -> u32 = CallerLocationValue::Main::where_called;
    return (f() + g()) as i32;
}
