namespace main;

import gm;

function idf<T>(x: T) -> T { return x; }
function tag<T>(x: T) -> i64 { return 7; }
function apply(f: (i32) -> i32, x: i32) -> i32 { return f(x); }
function apply64(f: (i64) -> i64, x: i64) -> i64 { return f(x); }

type struct Wrap<T> { v: T; }
implement<T> struct Wrap<T> {
    get(&this) -> T { return this.v; }
    static make(v: T) -> Wrap<T> { return Wrap::<T> { v: v }; }
}

// Inside a generic body the value names the instance for the body's own
// parameter.
function through<T>(x: T) -> T {
    const f: (T) -> T = idf;
    return f(x);
}
function owner_through<T>(w: &Wrap<T>) -> T {
    const g: (&Wrap<T>) -> T = Wrap::get;
    return g(w);
}

function main() -> i32 {
    const k = idf::<i64>;
    if (k(5 as i64) != 5 as i64) { return 1; }
    const h: (i32) -> i32 = idf;
    if (h(4) != 4) { return 2; }
    const f: (i32) -> i64 = tag::<i32>;
    if (f(1) != 7 as i64) { return 3; }
    const w: Wrap<i32> = Wrap::<i32> { v: 30 };
    const g: (&Wrap<i32>) -> i32 = Wrap::get;
    if (g(&w) != 30) { return 4; }
    const g2 = Wrap::<i32>::get;
    if (g2(&w) != 30) { return 5; }
    if (apply(idf, 9) != 9) { return 6; }
    if (apply64(idf, 11 as i64) != 11 as i64) { return 7; }
    const m: (i32) -> i32 = gm::twice_of;
    if (m(12) != 12) { return 8; }
    const m2 = gm::twice_of::<i64>;
    if (m2(13 as i64) != 13 as i64) { return 9; }
    if (through(14) != 14) { return 10; }
    if (owner_through(&w) != 30) { return 11; }
    const mk: (i64) -> Wrap<i64> = Wrap::make;
    const made: Wrap<i64> = mk(15 as i64);
    if (made.v != 15 as i64) { return 12; }
    return 0;
}
