///! A loop body that always ends in `break` never reaches its back edge, so
///! a binding it moves on some paths is not moved again on a next iteration:
///! it is possibly moved after the loop, and released at its scope exit only
///! when the body kept it.  Each case runs one path and checks the value was
///! released exactly once; the exit code counts the cases that were not.

namespace Main;

import std::fmt;

mut g_count: i32 = 0;

type struct Tracked { id: i32; }

implement trait Drop for struct Tracked {
    drop(mut &this) -> void { g_count = g_count + 1; }
}

function consume(t: Tracked) -> void { }

function released_once(n: i32, take: boolean) -> boolean {
    g_count = 0;
    {
        const x: Tracked = Tracked { id: 0 };
        mut i: i32 = 0;
        while (i < n) {
            if (take) { consume(x); }
            break;
        }
    }
    return g_count == 1;
}

function main() -> int {
    mut passed: i32 = 0;
    mut failed: i32 = 0;
    if (released_once(1, true))  { passed = passed + 1; } else { failed = failed + 1; }
    if (released_once(1, false)) { passed = passed + 1; } else { failed = failed + 1; }
    if (released_once(0, true))  { passed = passed + 1; } else { failed = failed + 1; }
    fmt::printf("ok %d\n", passed);
    return failed;
}
