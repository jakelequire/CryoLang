namespace GenericOwnerGenericMethodCall;

type struct Wrap<T> { v: T; }
implement<T> struct Wrap<T> {
    static conv<U>(x: U) -> U { return x; }
    keep<U>(&this, x: U) -> T { return this.v; }
    static make<U>(t: T, u: U) -> Wrap<T> { return Wrap::<T> { v: t }; }
    static width<U>(t: T) -> i64 { return sizeof(U) as i64; }
}

type struct Cell<T> {
    v: T;
    static conv<U>(x: U) -> U { return x; }
    keep<U>(&this, x: U) -> T { return this.v; }
}

function through<A>(a: A) -> A {
    const w: Wrap<A> = Wrap::<A>::make::<u8>(a, 3);
    return Wrap::<A>::keep::<i16>(&w, 1);
}

function main() -> i32 {
    if (Wrap::<i32>::conv::<u8>(7) != 7) { return 1; }
    const w: Wrap<i32> = Wrap::<i32> { v: 3 };
    if (Wrap::<i32>::keep::<u8>(&w, 1) != 3) { return 2; }
    // The method's own argument inferred from the call's arguments.
    const b: u16 = 9;
    if (Wrap::<i64>::conv(b) != 9) { return 3; }
    if (Wrap::<i32>::keep(&w, b) != 3) { return 4; }
    const m: Wrap<i64> = Wrap::<i64>::make::<boolean>(11, true);
    if (m.v != 11) { return 5; }
    // One instance per method argument, reused by a repeated call.
    if (Wrap::<i32>::width::<u8>(0) != 1) { return 6; }
    if (Wrap::<i32>::width::<i64>(0) != 8) { return 7; }
    if (Wrap::<i32>::width::<u8>(0) != 1) { return 8; }
    // Declared in the type's body.
    if (Cell::<i32>::conv::<u8>(4) != 4) { return 9; }
    const c: Cell<i32> = Cell::<i32> { v: 6 };
    if (Cell::<i32>::keep::<u8>(&c, 1) != 6) { return 10; }
    // Inside a generic body.
    if (through::<i32>(12) != 12) { return 11; }
    return 0;
}
