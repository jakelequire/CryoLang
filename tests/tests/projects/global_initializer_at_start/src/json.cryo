namespace GiasJson;

public type struct Pt { x: i32; y: i32; }

public function twice(x: i32) -> i32 { return x * 2; }

public function make_pt(x: i32) -> Pt { return Pt { x: x, y: x + 1 }; }

const six: i32 = twice(3);
const base: Pt = make_pt(10);

public function read_six() -> i32 { return six; }
public function base_y() -> i32 { return base.y; }
