namespace GlobalInitializerAtStart::Main;

import GiasJson;

type struct One { v: i32; }

function make_one(x: i32) -> One { return One { v: x }; }

function idf<T>(x: T) -> T { return x; }

function local_twice(x: i32) -> i32 { return x * 2; }

// Each reads 0 when its initializer is left uncomputed.
const n: i32 = GiasJson::twice(3);
const m: i32 = local_twice(n);
const later: i32 = GiasJson::read_six() + GiasJson::base_y();
const g: i64 = idf(7000000000);
mut counter: i32 = local_twice(5);

// Function values held by module-level constants.
const t: (i32) -> i32 = local_twice;
const h: (i32) -> i32 = idf;
const k: (i64) -> i64 = idf::<i64>;
const via_h: i32 = h(3);
const mk: (i32) -> One = make_one;

function main() -> i32 {
    if (n != 6) { return 1; }
    if (m != 12) { return 2; }
    if (later != 17) { return 3; }
    if (g != 7000000000) { return 4; }
    counter = counter + 1;
    if (counter != 11) { return 5; }
    if (t(4) != 8) { return 6; }
    if (h(9) != 9) { return 7; }
    if (k(8000000000) != 8000000000) { return 8; }
    if (via_h != 3) { return 9; }
    if (mk(15).v != 15) { return 10; }
    const local_mk: (i32) -> One = make_one;
    if (local_mk(16).v != 16) { return 11; }
    const p: GiasJson::Pt = GiasJson::make_pt(20);
    if (p.y != 21) { return 12; }
    return 0;
}
