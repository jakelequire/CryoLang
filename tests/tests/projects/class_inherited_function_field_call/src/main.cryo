// A call through a function-typed field names the same field a `.field`
// read does, so it is found the same way: `b.cb` is A's `cb`, one step up
// B's base chain, whether it is read or called.
function twice(x: i32) -> i32 { return x * 2; }

type class A {
public:
    pad: i32;
    cb: (i32) -> i32;
    A() { this.pad = 1; this.cb = twice; }
}

type class B : A {
public:
    extra: i64;
    B() : A() { this.extra = 3; }
}

function main() -> i32 {
    const a: A* = new A();
    if (a.cb(5) != 10) { return 1; }
    const b: B* = new B();
    return b.cb(21);   // 42 through the base class's field
}
