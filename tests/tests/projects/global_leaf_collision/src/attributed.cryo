/// The attributed twins.  Nothing reads these; they exist so the same leaves
/// are registered with an attribute before the plain module's are.
namespace GlobalLeaf::Attributed;

![thread_local]
mut counter: i32 = 100;

/// An imported global under a C symbol no object defines.  It is never
/// referenced, so no reference to THIS declaration reaches the linker; a
/// reference that arrives under its symbol can only be one meant for the
/// plain twin.
extern "C" {
    ![symbol("gl_symbol_nobody_defines")]
    mut probe: i32;
}
