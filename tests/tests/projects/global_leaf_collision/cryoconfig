# global_leaf_collision - two modules each declare a global under the SAME
# leaf, and only one of each pair carries an attribute that changes how a
# cross-module reference is emitted: `![thread_local]` (the reference must be
# a TLS access), and `![symbol("...")]` on an imported global (the reference
# binds the C symbol, not the module's mangling).  A third module reads the
# PLAIN twin of each through its qualified path.
#
# A project rather than a single file because the defect is in how the
# declaration index answers a reader in ANOTHER module: keyed by the leaf
# alone, the first registration answers for every module's same-leaf global,
# so the plain `counter` is declared thread-local (a TLS relocation against a
# non-TLS definition fails to link) and the plain `probe` is asked for under
# the imported twin's C symbol (an undefined reference).  Keyed by the leaf
# AND the declaring namespace, each reference reaches its own declaration.
#
# The exit code is the evidence: `main` returns the sum of the two plain
# globals, so the program either links and answers 14 or does not link.

[project]
project_name = "global_leaf_collision"
output_dir   = "build"
target_type  = "executable"
source_dir   = "src"
entry_point  = "src/main.cryo"

