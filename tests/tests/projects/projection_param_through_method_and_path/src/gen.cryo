namespace ProjPath::Gen;

import std::core::option::{ Option };

type trait Source {
    type Item;
    take(mut &this) -> Option<This::Item>;
}

type trait Back : Source {
    take_back(mut &this) -> Option<This::Item>;
}

function first_of<I>(it: mut &I) -> Option<I::Item> where I: Source {
    return it.take();
}

function back_of<I>(it: mut &I) -> Option<I::Item> where I: Back {
    return it.take_back();
}

function take_or<I>(it: mut &I, d: I::Item) -> I::Item where I: Source {
    return match (it.take()) {
        Option::Some(v) => { v }
        Option::None    => { d }
    };
}
