namespace ProjPath::Main;

import std::core::option::{ Option };
import ProjPath::Gen;
import ProjPath::Gen::{ Source, Back };

// `Count` yields n-1, n-2, ... 0, then nothing.  Each call below takes one
// value, so the expected results count down from 8.
type struct Count {
    n: i32;
}

implement trait Source for struct Count {
    type Item = i32;
    take(mut &this) -> Option<i32> {
        if (this.n == 0) { return Option::None; }
        this.n = this.n - 1;
        return Option::Some(this.n);
    }
}

implement trait Back for struct Count {
    take_back(mut &this) -> Option<This::Item> { return this.take(); }
}

type struct Puller {
    k: i32;
}

implement struct Puller {
    pull<I>(&this, it: mut &I) -> Option<I::Item> where I: Source {
        return it.take();
    }
    pull_back<I>(&this, it: mut &I) -> Option<I::Item> where I: Back {
        return it.take_back();
    }
    pull_or<I>(&this, it: mut &I, d: I::Item) -> I::Item where I: Source {
        return match (it.take()) {
            Option::Some(v) => { v }
            Option::None    => { d }
        };
    }
    static grab<I>(it: mut &I) -> Option<I::Item> where I: Source {
        return it.take();
    }
}

function value_of(o: Option<i32>) -> i32 {
    return match (o) { Option::Some(v) => { v } Option::None => { -1 } };
}

function main() -> i32 {
    mut c: Count = Count { n: 9 };
    const p: Puller = Puller { k: 0 };
    const a: Option<i32> = p.pull(&c);                // Some(8)
    const b: Option<i32> = p.pull_back(&c);           // Some(7)
    const x: i32 = p.pull_or(&c, 100);                // 6
    const s: Option<i32> = Puller::grab(&c);          // Some(5)
    const m: Option<i32> = Gen::first_of(&c);         // Some(4)
    const n: Option<i32> = ProjPath::Gen::back_of(&c); // Some(3)
    const y: i32 = Gen::take_or(&c, 100);             // 2
    mut e: Count = Count { n: 0 };
    const z: i32 = p.pull_or(&e, 40);                 // 40
    const w: i32 = Gen::take_or(&e, 50);              // 50
    if (value_of(a) != 8) { return 1; }
    if (value_of(b) != 7) { return 2; }
    if (x != 6) { return 3; }
    if (value_of(s) != 5) { return 4; }
    if (value_of(m) != 4) { return 5; }
    if (value_of(n) != 3) { return 6; }
    if (y != 2) { return 7; }
    if (z != 40) { return 8; }
    if (w != 50) { return 9; }
    return 0;
}
