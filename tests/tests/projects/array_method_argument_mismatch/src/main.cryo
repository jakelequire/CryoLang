/// Arguments to a dynamic array's methods are checked against the element
/// type before code generation: text handed to an `i64[]` is refused at the
/// argument, as it is for a struct's method.
namespace ArrayMethodArgumentMismatch::Main;

function main() -> i32 {
    mut nums: i64[] = [];
    nums.push(1);
    nums.push("not a number");
    nums.insert(0, "nor this");
    nums.set(0, "nor this");
    const probe: string = "absent";
    if (nums.contains(&probe)) { return 1; }
    return nums.length as i32;
}
