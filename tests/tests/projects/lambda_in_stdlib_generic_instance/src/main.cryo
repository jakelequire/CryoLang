namespace LambdaInStdlibGenericInstance;

// `Array.sort` and `Array.sort_unstable` hand a lambda to their `_by` forms.
// Each instance this program makes is emitted into the stdlib module beside
// the archive's own instances of the same methods, and each must call its own
// lambda, not the one the archive defines under the same name for another
// instance. The `i64` values differ in their high bits, so a narrower
// compare puts them out of order.

function ascending_i64(values: &[i64]) -> boolean {
    for (mut i: i64 = 1; i < values.length(); i++) {
        if (values[i - 1] > values[i]) { return false; }
    }
    return true;
}

function main() -> i32 {
    mut stable: [i64] = [932606, 583775, 466924, 283573, 335178, 550459];
    stable.sort();
    if (!ascending_i64(&stable)) { return 1; }

    mut unstable: [i64] = [932606, 583775, 466924, 283573, 335178, 550459];
    unstable.sort_unstable();
    if (!ascending_i64(&unstable)) { return 2; }

    mut small: [u8] = [200, 3, 150, 7];
    small.sort();
    if (small[0] != 3 || small[1] != 7 || small[2] != 150 || small[3] != 200) { return 3; }

    mut wide: [i32] = [70000, -70000, 140000, 0];
    wide.sort_unstable();
    if (wide[0] != -70000 || wide[1] != 0 || wide[2] != 70000 || wide[3] != 140000) { return 4; }
    return 0;
}
