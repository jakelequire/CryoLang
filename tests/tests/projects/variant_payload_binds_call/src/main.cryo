/// A variant passed to a generic function binds the function's parameters
/// its payload carries; the enum's other parameters are left to the
/// function's other arguments.
namespace variant_payload_binds_call;

import std::core::result::{ Result };

function err_or<T, E>(r: Result<T, E>, d: E) -> E {
    match (r) {
        Result::Ok(_)  => { return d; }
        Result::Err(e) => { return e; }
    }
}

function ok_or<T, E>(r: Result<T, E>, d: T) -> T {
    match (r) {
        Result::Ok(v)  => { return v; }
        Result::Err(_) => { return d; }
    }
}

function main() -> i32 {
    // `T` from the payload, `E` from the second argument.
    const x: i64 = err_or(Result::Ok(1), 6000000000);
    // `E` from the payload, `T` from the second argument.
    const y: i64 = ok_or(Result::Err(true), 9000000000);
    // 6 + 9
    return (x / 1000000000) as i32 + (y / 1000000000) as i32;
}
