namespace FieldMovedOutOfTemporaryCloneFix;

import std::core::drop::{ Drop };

mut g_released: i64 = 0;

type struct Res with [Clone] {
    id: i64;
}

implement trait Drop for struct Res {
    drop(mut &this) -> void { g_released = g_released + 1; }
}

type struct Guarded {
    inner: Res;
}

implement trait Drop for struct Guarded {
    drop(mut &this) -> void { g_released = g_released + 10; }
}

function guarded(id: i64) -> Guarded { return Guarded { inner: Res { id: id } }; }

function main() -> i32 {
    {
        const kept: Res = guarded(3).inner;
        // Fixed, the call's result is released when the statement ends,
        // the original field with it.
        if (kept.id != 3 || g_released != 11) { return 1; }
    }
    if (g_released != 12) { return 2; }
    return 0;
}
