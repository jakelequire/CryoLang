namespace static_match_arm_field_is_arm_type;

import std::fmt;

function widen(x: i64) -> i64 { return x * 2; }

type struct Cell<T> {
    value: T;

    // In the `i64` arm `this.value` is an `i64`, the type `widen` takes.
    doubled(&this) -> i64 {
        return static match (T) {
            i64 => { widen(this.value) }
            _   => { 0 }
        };
    }
}

function main() -> i32 {
    const c: Cell<i64> = Cell::<i64> { value: 21 };
    const s: Cell<u8> = Cell::<u8> { value: 3 };
    fmt::printf("doubled %lld %lld\n", c.doubled(), s.doubled());
    if (c.doubled() != 42) { return 1; }
    return 0;
}
