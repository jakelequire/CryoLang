/// `S` implements `Aa` and `Bb`, and takes each trait's default `keep`.
/// `keep` returns `Option<This>`, so it is instantiated for each call.
/// Through `T: Aa` the call runs `Aa`'s default, through `T: Bb`, `Bb`'s.
namespace BoundCallRunsBoundTraitsDefault::Main;

import std::ffi::libc;

type trait Aa {
    keep(this) -> Option<This> { return Option::None; }
}
type trait Bb {
    keep(this) -> Option<This> { return Option::Some(this); }
}

type struct S { x: i32; }
implement trait Aa for struct S { }
implement trait Bb for struct S { }

function via_a<T>(x: T) -> i32 where T: Aa {
    match (x.keep()) { Option::Some(_) => { return 2; } Option::None => { return 1; } }
}
function via_b<T>(x: T) -> i32 where T: Bb {
    match (x.keep()) { Option::Some(_) => { return 2; } Option::None => { return 1; } }
}

function main() -> int {
    const r: i32 = via_a(S { x: 0 }) + via_b(S { x: 0 }) * 10;
    libc::printf("bound default %d\n", r);
    if (r != 21) { return 1; }
    return 0;
}
