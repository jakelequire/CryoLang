// An implementation whose parameter only the trait's arguments carry,
// `implement<K> trait Scale<K> for struct Meter where K: Position`, lends it
// to the methods that take it: each call binds it from its argument.  The
// type is not generic, so the block is the type's own and the instances its
// calls ask for are emitted with it - called directly at two index types,
// through a body bounded at one of them, and with a method of the block
// that takes no lent parameter and calls a generic function.
namespace LentParameterOnNonGenericType::Main;

import std::ffi::libc;

type trait Position {
    to_position(this) -> i64;
}

implement trait Position for u8 { to_position(this) -> i64 { return this as i64; } }
implement trait Position for i16 { to_position(this) -> i64 { return this as i64 * 2; } }

type trait Scale<K> {
    scale(&this, k: K) -> i64;
    unit(&this) -> i64;
}

type struct Meter {
    n: i64;
}

implement<K> trait Scale<K> for struct Meter where K: Position {
    scale(&this, k: K) -> i64 { return this.n * k.to_position(); }
    unit(&this) -> i64 { return same(this.n); }
}

function same<V>(v: V) -> V {
    return v;
}

function scaled_by_three<S>(s: &S) -> i64 where S: Scale<u8> {
    return s.scale(3 as u8);
}

function main() -> int {
    const m: Meter = Meter { n: 5 };
    if (m.scale(3 as u8) != 15) { return 1; }
    if (m.scale(3 as i16) != 30) { return 2; }
    if (scaled_by_three(&m) != 15) { return 3; }
    if (m.unit() != 5) { return 4; }
    libc::printf("lent parameter on non-generic type ok\n");
    return 0;
}
