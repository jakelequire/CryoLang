/// Two references compare the values they refer to, by the referent's `Eq`
/// for `==` and `!=`. A referent that implements no `Eq` would be compared
/// by its two addresses where the program reads two values, so the
/// comparison is refused, each with the help that writes its fix: a struct
/// an implementation of `Eq` or its addresses with the references converted
/// to pointers, an enum its values compared, an array its addresses. `==`
/// on references to a float, a boolean or a struct with `Eq` stays allowed,
/// and so does a reference beside `null`.
namespace ReferenceEqualityWithoutEqRefused::Main;

type struct Plain { value: i64; }

type struct Point { x: i64; y: i64; }

implement trait Eq for Point {
    equals(&this, other: &Point) -> boolean { return this.x == other.x && this.y == other.y; }
}

type enum Color { Red; Green; }

type struct Holder<T> { item: T; }

function main() -> i32 {
    const plain: Plain = Plain { value: 1 };
    const other: Plain = Plain { value: 1 };
    const held: &Plain = &plain;
    const red: Color = Color::Red;
    const tint: &Color = &red;
    const pair: [i64; 2] = [1, 2];
    const both: &[i64; 2] = &pair;
    const holder: Holder<i64> = Holder::<i64> { item: 1 };
    const kept: &Holder<i64> = &holder;
    const low: f64 = 1.5;
    const flag: boolean = true;
    const point: Point = Point { x: 1, y: 2 };
    mut hits: i32 = 0;
    if (held == held) { hits = hits + 1; }
    if (&plain != &other) { hits = hits + 1; }
    if (tint == tint) { hits = hits + 1; }
    if (both != both) { hits = hits + 1; }
    if (kept == kept) { hits = hits + 1; }
    if (&low == &low || &flag != &flag || &point == &point || held == null) { hits = hits + 1; }
    return hits;
}
