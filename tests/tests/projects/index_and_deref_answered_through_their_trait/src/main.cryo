namespace IndexDerefTrait;
import std::core::ops::{ Index, IndexMutable, Deref, DerefMutable };

// `a[i]` read is `*(a.index(i))` through `Index` and written is
// `*(a.index_mutable(i))` through `IndexMutable`; a field read through a
// `Deref` type is `(*a.deref()).field` through `Deref`, and written is
// `(*a.deref_mutable()).field` through `DerefMutable`: an ordinary method of
// the same name on the same type is a different method and answers none of
// them.

type struct Grid {
    cells: [i32; 4];
    other: i32;
}

implement trait Index<u64> for struct Grid {
    type Output = i32;
    index(&this, i: u64) -> const i32* { return &this.cells[i]; }
}

implement trait IndexMutable<u64> for struct Grid {
    index_mutable(mut &this, i: u64) -> i32* { return &this.cells[i]; }
}

implement struct Grid {
    index(&this, s: string) -> const i32* { return &this.other; }
    index_mutable(mut &this, s: string) -> i32* { return &this.other; }
}

type struct Inner {
    x: i32;
}

type struct Decoy {
    x: i32;
}

type struct Wrapper {
    inner: Inner;
    decoy: Decoy;
}

implement trait Deref<Inner> for struct Wrapper {
    deref(&this) -> const Inner* { return &this.inner; }
}

implement trait DerefMutable for struct Wrapper {
    deref_mutable(mut &this) -> Inner* { return &this.inner; }
}

implement struct Wrapper {
    deref(&this) -> const Decoy* { return &this.decoy; }
    deref_mutable(mut &this) -> Decoy* { return &this.decoy; }
}

function main() -> i32 {
    mut g: Grid = Grid { cells: [1, 2, 3, 4], other: 99 };
    if (g[2 as u64] != 3) { return 1; }
    if (*g.index("any") != 99) { return 2; }
    g[1 as u64] = 20;
    if (g.cells[1] != 20 || g.other != 99) { return 3; }

    mut w: Wrapper = Wrapper { inner: Inner { x: 7 }, decoy: Decoy { x: 8 } };
    if (w.x != 7) { return 4; }
    w.x = 9;
    if (w.inner.x != 9 || w.decoy.x != 8) { return 5; }
    return 0;
}
