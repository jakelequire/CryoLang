namespace IndexDerefTrait;
import std::core::ops::{ Index, Deref };

// `a[i]` is `*(a.index(i))` through `Index`, and a field read through a
// `Deref` type is `(*a.deref()).field` through `Deref`: an ordinary method
// of the same name on the same type is a different method and answers
// neither.

type struct Grid {
    cells: [i32; 4];
    other: i32;
}

implement trait Index<u64, i32> for struct Grid {
    index(&this, i: u64) -> i32* { return &this.cells[i]; }
}

implement struct Grid {
    index(&this, s: string) -> i32* { return &this.other; }
}

type struct Inner {
    x: i32;
}

type struct Decoy {
    x: i32;
}

type struct Wrapper {
    inner: Inner;
    decoy: Decoy;
}

implement trait Deref<Inner> for struct Wrapper {
    deref(&this) -> Inner* { return &this.inner; }
}

implement struct Wrapper {
    deref(&this) -> Decoy* { return &this.decoy; }
}

function main() -> i32 {
    mut g: Grid = Grid { cells: [1, 2, 3, 4], other: 99 };
    if (g[2 as u64] != 3) { return 1; }
    if (*g.index("any") != 99) { return 2; }

    const w: Wrapper = Wrapper { inner: Inner { x: 7 }, decoy: Decoy { x: 8 } };
    if (w.x != 7) { return 3; }
    return 0;
}
