/// The `release` profile does not check for overflow: every operator that
/// overflows wraps, two's complement, to the value the explicit wrapping
/// methods give.  Operands come through `keep`, so nothing is a constant.
namespace OverflowWrapsInTheReleaseProfile::Main;

import std::fmt;

function keep<T>(value: T) -> T {
    return value;
}

function main() -> int {
    const max: i32 = keep(i32::MAX);
    const min: i64 = keep(i64::MIN);
    const zero: u8 = keep(0 as u8);
    const big: u64 = keep(u64::MAX);
    const one: u128 = keep(1 as u128);
    mut counter: i16 = keep(i16::MAX);
    counter++;
    mut total: u32 = keep(u32::MAX);
    total += keep(2 as u32);
    const sum: i32 = max + 1;
    const difference: u8 = zero - 1;
    const product: u64 = big * 2;
    const negated: i64 = -min;
    const wide: u128 = (one - 2) / 2;
    fmt::println(f"{sum} {difference} {product} {negated} {counter} {total} {wide}");
    const agrees: boolean = sum == max.wrapping_add(1) && difference == zero.wrapping_subtract(1)
        && product == big.wrapping_multiply(2) && negated == min.wrapping_negate();
    fmt::println(f"wrapping methods agree: {agrees}");
    // The methods that compute as the operators do wrap as they do.
    const two: i32 = keep(2 as i32);
    const least: i32 = keep(i32::MIN);
    const raised: i32 = two.power(31);
    const magnitude: i32 = least.abs();
    const three: u8 = keep(3 as u8);
    fmt::println(f"power {raised} {three.power(6)} abs {magnitude}");
    const methods_agree: boolean = raised == two.wrapping_power(31) && three.power(6) == three.wrapping_power(6)
        && magnitude == least.wrapping_negate();
    fmt::println(f"power and abs agree: {methods_agree}");
    return 0;
}
