// Shares its leaf with `std::alloc::allocator::Allocator` and nothing else:
// no methods, no impls, never constructed. Its only job is to make the leaf
// plural, which is what used to poison the stdlib trait's whole method set.
type struct Allocator {
    n: u32;
}

function main() -> i32 {
    // Allocates, so `Allocator`'s methods are actually dispatched rather than
    // merely left unmentioned - a build that resolved the trait to nothing
    // would still link, so the program has to use it.
    mut xs: i32[] = [];
    xs.push(7);
    xs.push(11);
    if (xs.length != 2) { return 1; }
    if (xs[0] + xs[1] != 18) { return 2; }
    return 0;
}
