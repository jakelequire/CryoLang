# trait_leaf_name_collision - a project type sharing a leaf with a stdlib trait.
#
# Declaring a type whose bare name matches a trait the standard library
# implements (here `Allocator`, against `std::alloc::allocator::Allocator`)
# used to make the stdlib itself fail to compile, with two E0154s inside
# `std::alloc::allocator` for methods this project never calls. The local type
# needs no methods, no impls and no uses: it only has to make the leaf plural.
#
# The trait-impl registry keys its entries on bare leaves so a lookup is
# module-independent. Asking WHICH trait an impl provides used to fold that
# leaf back to a qualified name by searching the whole program, and a search
# answers only while the leaf is unique - so a second, unrelated `Allocator`
# made one trait read as two and every method on it became ambiguous.
#
# The build IS the assertion, plus an allocating program so the Allocator
# trait is genuinely dispatched rather than merely left alone.

[project]
project_name = "trait_leaf_name_collision"
output_dir   = "build"
target_type  = "executable"
source_dir   = "src"
entry_point  = "src/main.cryo"

[compiler]

