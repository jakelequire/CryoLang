/// An `await` may hand a future a pointer into a dynamic array local's
/// buffer: the array's elements live in a heap block that stays where it is
/// when a poll returns, so the pointer is not into the poll frame - unlike
/// the address of the local itself, which is refused (E0455).
namespace AwaitHandsArrayBuffer::Main;

import std::fmt;
import std::future;
import std::future::ready::{ PendingThenReady };

async function fill(p: u8*, n: i64) -> i64 {
    const _tick: i64 = await PendingThenReady::<i64>::new(1, 0);
    for (mut i: i64 = 0; i < n; i++) { p[i] = 7 as u8; }
    return n;
}

async function run() -> i64 {
    mut buf: [u8] = [];
    buf.push(0 as u8);
    buf.push(0 as u8);
    const got: i64 = await fill(buf.as_ptr(), buf.length);
    return got * 100 + (buf[0] as i64) * 10 + (buf[1] as i64);
}

function main() -> i32 {
    fmt::println(f"filled {future::block_on(run())}");
    return 0;
}
