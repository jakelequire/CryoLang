namespace IteratorAdaptorsAfterTakeAndMapOnBound::Main;

// An adaptor chained after `take` or after `map` on a receiver bounded by
// `Iterator<i32>`, in a generic function and in a generic struct's method:
// `take(n).map(f)` reads the item of `TakeIter<I>` from its where-clause
// with `I` still the parameter, and `map(f).filter(p)` types and binds
// `filter`, a default each implementation copies per call, on a
// `MapIter<I, i64>` not yet minted.

import std::core::option::{ Option };
import std::core::iter::{ Iterator };

type struct Up { cur: i32; end: i32; }

implement trait Iterator<i32> for struct Up {
    next(mut &this) -> Option<i32> {
        if (this.cur >= this.end) { return Option::None; }
        const v: i32 = this.cur;
        this.cur = this.cur + 1;
        return Option::Some(v);
    }
}

function widen(x: i32) -> i64 { return (x as i64) * 1000; }
function is_big(x: &i64) -> boolean { return *x > 2000; }
function halve(x: i64) -> i64 { return x / 2; }

function first_widened<I>(it: I) -> u64 where I: Iterator<i32> {
    return it.take(3).map(widen).count();
}

function big_widened<I>(it: I) -> u64 where I: Iterator<i32> {
    return it.map(widen).filter(is_big).count();
}

function sum_of_halved_big<I>(it: I) -> i64 where I: Iterator<i32> {
    mut total: i64 = 0;
    for (v in it.take(4).map(widen).filter(is_big).map(halve)) { total = total + v; }
    return total;
}

type struct Source<I> where I: Iterator<i32> {
    inner: I;

    count_big_of_first(mut &this, n: u64) -> u64 {
        return this.inner.take(n).map(widen).filter(is_big).count();
    }
}

function main() -> i32 {
    if (first_widened(Up { cur: 1, end: 9 }) != 3) { return 1; }
    if (big_widened(Up { cur: 0, end: 5 }) != 2) { return 2; }
    // take(4) of 0..9 is 0, 1, 2, 3; widened and above 2000 is 3000; halved 1500.
    if (sum_of_halved_big(Up { cur: 0, end: 9 }) != 1500) { return 3; }
    mut s: Source<Up> = Source { inner: Up { cur: 0, end: 9 } };
    // take(6) of 0..9 is 0..5; widened and above 2000 is 3000, 4000, 5000.
    if (s.count_big_of_first(6) != 3) { return 4; }
    return 0;
}
