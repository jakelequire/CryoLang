// `cryo interpret --overflow-checks=on` judges a compound assignment's
// overflow at its target's type, whatever the right side's width and sign,
// as the compiled program does: each sum that reaches the target's bound is
// stored, and the first past it panics.

namespace Main;

import std::fmt;

function keep<T>(value: T) -> T {
    return value;
}

function main() -> i32 {
    const byte: u8 = keep(200 as u8);
    const small: i8 = keep(-128 as i8);
    const word: u32 = keep(4294967295 as u32);
    const long: u64 = keep(u64::MAX);
    mut a: i16 = keep(32567 as i16);
    a += byte;
    mut b: u16 = keep(65335 as u16);
    b += byte;
    mut c: i32 = keep(i32::MIN + 128);
    c += small;
    mut d: u64 = keep(u64::MAX - 4294967295);
    d += word;
    mut e: i128 = keep(i128::MAX - 18446744073709551615);
    e += long;
    fmt::println(f"edges {a} {b} {c} {d} {e}");
    mut past: i16 = keep(32568 as i16);
    past += byte;
    fmt::println("past the edge");
    return 0;
}
