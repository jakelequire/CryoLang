///! `collect`, `sum`, `rev`, `peekable` and `flat_map`: what each builds or
///! yields, including the empty cases and both ends of a range; and `sort`
///! handing the element type's `compare` to `sort_by`.

![config(testing)]
namespace IteratorCollectSumRevPeekFlatMap::Tests;

import std::core::result::{ Result };
import std::core::option::{ Option };
import std::core::iter::{ Iterator, DoubleEndedIterator };
import std::core::ops::{ Range, RangeInclusive };
import std::collections::array::{ Array };
import std::collections::hashmap::{ HashMap };
import std::collections::hashset::{ HashSet };
import std::collections::pair::{ Pair };
import std::collections::string::{ String };
import std::collections::str::{ Str };
import std::test::error::{ TestError };
import std::test::assert::{ expect_eq, expect_true, expect_false };

function square(x: i64) -> i64 { return x * x; }
function is_odd(x: &i64) -> boolean { return *x % 2 == 1; }
function keyed(x: i64) -> Pair<i64, i64> { return Pair::new(x % 3, x); }
function count_up_to(n: i64) -> Range<i64> { return Range::new(0, n); }
function letter(n: u32) -> char { return ('a' as u32 + n) as char; }

![test]
function collect_builds_an_array_in_order() -> Result<(), TestError> {
    const squares: Array<i64> = Range::<i64>::new(1, 5).map(square).collect();
    expect_eq(squares.length(), 4 as i64)?;
    expect_eq(squares.get(0).unwrap(), 1 as i64)?;
    return expect_eq(squares.get(3).unwrap(), 16 as i64);
}

![test]
function collect_builds_an_array_of_what_a_filter_keeps() -> Result<(), TestError> {
    const odd: Array<i64> = Range::<i64>::new(0, 6).filter(is_odd).collect();
    expect_eq(odd.length(), 3 as i64)?;
    return expect_eq(odd.get(2).unwrap(), 5 as i64);
}

![test]
function collect_of_nothing_is_empty() -> Result<(), TestError> {
    const none: Array<i64> = Range::<i64>::new(3, 3).collect();
    return expect_eq(none.length(), 0 as i64);
}

![test]
function collect_builds_a_map_where_a_later_pair_wins() -> Result<(), TestError> {
    const by_remainder: HashMap<i64, i64> = Range::<i64>::new(0, 7).map(keyed).collect();
    expect_eq(by_remainder.length(), 3 as i64)?;
    const zero: i64 = 0;
    return expect_eq(by_remainder.get(&zero).unwrap(), 6 as i64);
}

![test]
function collect_builds_a_set_without_repeats() -> Result<(), TestError> {
    const odd: HashSet<i64> = Range::<i64>::new(0, 10).filter(is_odd).collect();
    expect_eq(odd.length(), 5 as i64)?;
    const seven: i64 = 7;
    const eight: i64 = 8;
    expect_true(odd.contains(&seven), Str::new("7 is collected"))?;
    return expect_false(odd.contains(&eight), Str::new("8 is filtered out"));
}

![test]
function collect_builds_a_string_from_chars() -> Result<(), TestError> {
    const word: String = Range::<u32>::new(0, 4).map(letter).collect();
    return expect_true(word.as_str() == Str::new("abcd"), Str::new("the chars in order"));
}

![test]
function sum_adds_every_element_and_nothing_is_zero() -> Result<(), TestError> {
    const total: i64 = Range::<i64>::new(1, 101).sum();
    expect_eq(total, 5050 as i64)?;
    const none: i64 = Range::<i64>::new(0, 0).sum();
    expect_eq(none, 0 as i64)?;
    const halves: f64 = Range::<i64>::new(0, 4).map((x: i64) -> f64 { return (x as f64) / 2.0; }).sum();
    return expect_true(halves == 3.0, Str::new("0 + 0.5 + 1 + 1.5"));
}

![test]
function rev_yields_a_range_back_to_front() -> Result<(), TestError> {
    const back: Array<i64> = Range::<i64>::new(0, 4).rev().collect();
    expect_eq(back.length(), 4 as i64)?;
    expect_eq(back.get(0).unwrap(), 3 as i64)?;
    expect_eq(back.get(3).unwrap(), 0 as i64)?;
    const twice: Array<i64> = Range::<i64>::new(0, 3).rev().rev().collect();
    return expect_eq(twice.get(0).unwrap(), 0 as i64);
}

![test]
function rev_of_an_inclusive_range_starts_at_its_end() -> Result<(), TestError> {
    const back: Array<u8> = RangeInclusive::<u8>::new(253, 255).rev().collect();
    expect_eq(back.length(), 3 as i64)?;
    expect_eq(back.get(0).unwrap(), 255 as u8)?;
    expect_eq(back.get(2).unwrap(), 253 as u8)?;
    const bottom: Array<u8> = RangeInclusive::<u8>::new(0, 1).rev().collect();
    return expect_eq(bottom.length(), 2 as i64);
}

![test]
function both_ends_of_a_range_meet_once() -> Result<(), TestError> {
    mut range: Range<i64> = Range::new(0, 5);
    expect_eq(range.next().unwrap(), 0 as i64)?;
    expect_eq(range.next_back().unwrap(), 4 as i64)?;
    expect_eq(range.next().unwrap(), 1 as i64)?;
    expect_eq(range.next_back().unwrap(), 3 as i64)?;
    expect_eq(range.next().unwrap(), 2 as i64)?;
    expect_true(range.next().is_none(), Str::new("the front is exhausted"))?;
    return expect_true(range.next_back().is_none(), Str::new("the back is exhausted"));
}

![test]
function peek_then_next_yield_the_same_element() -> Result<(), TestError> {
    mut numbers: Range<i64> = Range::new(10, 12);
    mut ahead = numbers.peekable();
    expect_eq(*ahead.peek().unwrap(), 10 as i64)?;
    expect_eq(*ahead.peek().unwrap(), 10 as i64)?;
    expect_eq(ahead.next().unwrap(), 10 as i64)?;
    expect_eq(*ahead.peek().unwrap(), 11 as i64)?;
    expect_eq(ahead.next().unwrap(), 11 as i64)?;
    expect_true(ahead.peek().is_none(), Str::new("nothing left to peek"))?;
    return expect_true(ahead.next().is_none(), Str::new("nothing left to take"));
}

![test]
function flat_map_yields_each_inner_iterator_in_turn() -> Result<(), TestError> {
    // 0..4 -> [], [0], [0,1], [0,1,2]
    const flat: Array<i64> = Range::<i64>::new(0, 4).flat_map(count_up_to).collect();
    expect_eq(flat.length(), 6 as i64)?;
    expect_eq(flat.get(0).unwrap(), 0 as i64)?;
    expect_eq(flat.get(2).unwrap(), 1 as i64)?;
    return expect_eq(flat.get(5).unwrap(), 2 as i64);
}

![test]
function flat_map_of_nothing_yields_nothing() -> Result<(), TestError> {
    const flat: Array<i64> = Range::<i64>::new(0, 1).flat_map(count_up_to).collect();
    return expect_eq(flat.length(), 0 as i64);
}

![test]
function sort_orders_by_the_element_compare() -> Result<(), TestError> {
    mut values: Array<i64> = Array::new();
    values.push(3);
    values.push(-1);
    values.push(2);
    values.sort();
    expect_eq(values.get(0).unwrap(), -1 as i64)?;
    expect_eq(values.get(2).unwrap(), 3 as i64)?;
    values.sort_unstable();
    return expect_eq(values.get(1).unwrap(), 2 as i64);
}
