# iterator_collect_sum_rev_peek_flat_map - `collect`, `sum`, `rev`,
# `peekable` and `flat_map` over ranges, collecting into Array, HashMap,
# HashSet and String.  A project rather than a unit-test file because
# `collect` and `sum` call a static trait method with a type parameter of its
# own through a type parameter's path, which a compiler that leaves that call
# unbound refuses, and that would stop the whole unit suite from building.

[project]
project_name = "iterator_collect_sum_rev_peek_flat_map"
output_dir   = "build"
target_type  = "executable"
source_dir   = "src"
entry_point  = "src/main.cryo"

