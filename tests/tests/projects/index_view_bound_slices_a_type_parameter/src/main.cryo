namespace IndexViewBoundSlicesATypeParameter;

// A type parameter a bound gives `IndexView` at a range type is sliced
// through that bound, and its view is the parameter's `View`: a range
// literal indexing it takes the bound's range type.  The same function
// slices an `Array<i32>` and a `Str`.

import std::core::ops::{ IndexView, Range };
import std::collections::array::{ Array };
import std::collections::str::{ Str };
import std::core::slice::{ Slice };

function first_two<C>(container: &C) -> C::View where C: IndexView<Range<i64>> {
    return container[0..2];
}

function from<C>(container: &C, start: i64, end: i64) -> C::View where C: IndexView<Range<i64>> {
    return container[start..end];
}

function main() -> i32 {
    mut values: Array<i32> = Array::<i32>::new();
    values.push(4);
    values.push(5);
    values.push(6);
    const part: &Slice<i32> = first_two(&values);
    if (part.length() != 2) { return 1; }
    if (part[1] != 5) { return 2; }
    const tail: &Slice<i32> = from(&values, 1, 3);
    if (tail[1] != 6) { return 3; }
    const text: Str = Str::new("cryo");
    const head: Str = first_two(&text);
    if (head.length() != 2) { return 4; }
    return 0;
}
