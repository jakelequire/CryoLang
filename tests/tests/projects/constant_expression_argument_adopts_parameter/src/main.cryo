/// An argument made only of integer literals adopts the parameter's type the
/// way a single literal does: `take_u32(5)` and `take_u32(8 * 10000 + 64 * 100)`
/// both bind a `u32`.  Each value the expression computes on the way fits the
/// parameter's type, so computing it at that width gives the written value.
/// Each check returns its own exit code, so a wrong value names its line.
namespace ConstantExpressionArgument::Main;

type struct Meter { n: u16; }

implement struct Meter {
    static of(n: u16) -> Meter { return Meter { n: n }; }
    add(&this, k: u16) -> u16 { return this.n + k; }
}

function take_u32(x: u32) -> u32 { return x; }
function take_u8(x: u8) -> u8 { return x; }
function take_i8(x: i8) -> i8 { return x; }

function main() -> i32 {
    if (take_u32(5) != 5) { return 1; }
    if (take_u32(8 * 10000 + 64 * 100) != 86400) { return 2; }
    if (take_u8(2 + 3) != 5) { return 3; }
    if (take_u32((1 << 4) | 3) != 19) { return 4; }
    if (take_i8(-100 + 50) != -50) { return 5; }
    const m: Meter = Meter::of(60 * 60);
    if (m.add(4 * 10) != 3640) { return 6; }
    return 0;
}
