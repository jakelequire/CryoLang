# dev_profile_wins_over_cryoconfig_optimize - `--dev` builds at O0 although the cryoconfig pins `optimize = O2`: a profile named on the command line sets the optimization level over `[compiler] optimize`.
[project]
project_name = "dev_profile_wins_over_cryoconfig_optimize"
output_dir   = "build"
target_type  = "executable"
source_dir   = "src"
entry_point  = "src/main.cryo"
[compiler]
optimize = O2
[dependencies]
