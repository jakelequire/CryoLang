namespace ArrayLiteralElementsConvertWhereDeclared;

import std::collections::str::{ Str };
import std::collections::string::{ String };
import std::fmt;

function joined(items: [Str]) -> String {
    mut out: String = String::new();
    for (mut i: i64 = 0; i < items.length(); i++) { out.append(items[i]); }
    return out;
}

// An array literal's elements convert through the `![implicit]` converter
// for the element type the literal is declared to have: a typed binding,
// a fixed array, an owning element type and a parameter.
function main() -> i32 {
    const views: [Str] = ["a", "bc"];
    const fixed: [Str; 2] = ["d", "ef"];
    const owned: [String] = ["gh", "i"];
    const total: i64 = views[1].length() + fixed[1].length() + owned[0].length();
    fmt::println(f"views {views[0]}{views[1]} fixed {fixed[0]}{fixed[1]} owned {owned[0]}{owned[1]}");
    fmt::println(f"argument {joined(["j", "kl"])} total {total}");
    return 0;
}
