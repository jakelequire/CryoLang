/// A lowered `async` method keeps the access of the module it was written in:
/// its own type's private field (`own`, declared here) stays reachable, and
/// another module's (`hidden`) does not.
namespace VisibilityModulePrivate::Thief;

import std::future;
import std::future::{ Ready };
import VisibilityModulePrivate::Vault;
import VisibilityModulePrivate::Vault::{ Chest };

public type struct AfThief {
private:
    own: i32;
public:
    static make() -> AfThief { return AfThief { own: 0 }; }

    async steal(mut &this, v: Chest*) -> i32 {
        const step: i32 = await Ready::<i32>::new(1);
        return this.own + v.hidden + step;
    }
}
