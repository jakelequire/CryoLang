/// The declaring module.  `private` reaches this module only; `protected`
/// reaches it and every module under it (`vault/inner.cryo`).
namespace VisibilityModulePrivate::Vault;

import VisibilityModulePrivate::Forge;
import VisibilityModulePrivate::Forge::{ Helper };

public type struct Chest {
private:
    secret: i32;
    near:   i32;
    hidden: i32;
public:
    tag: i32;

    static issue() -> Chest { return Chest { secret: 1, near: 2, hidden: 4, tag: 3 }; }
}

/// A private field a literal names.
public type struct Sealed {
private:
    sealed: i32;
public:
    tag: i32;

    static make() -> Sealed { return Sealed { sealed: 1, tag: 2 }; }
}

/// A private field a literal leaves to its default: the literal still sets
/// it, so it may no more be private to the writer than a named one.
public type struct Stamped {
private:
    stamp: i32 = 7;
public:
    tag: i32;

    static make() -> Stamped { return Stamped { tag: 2 }; }
}

/// The target of another module's `implement` block (`forge.cryo`).
public type struct Minted {
private:
    seal: i32;
public:
    static make() -> Minted { return Minted { seal: 1 }; }
}

public type class Account {
protected:
    for_child:   i32;
    for_sibling: i32;
public:
    Account(b: i32) { this.for_child = b; this.for_sibling = b; }
}

/// CONTROL: a free function in the declaring module reaches a private field.
public function peek_near(v: Chest) -> i32 { return v.near; }

/// A private method is private to the module its declaration is written in,
/// which for `tuck` is `forge.cryo`'s, not `Helper`'s.
public function call_tuck() -> i32 { return Helper::tuck(); }
