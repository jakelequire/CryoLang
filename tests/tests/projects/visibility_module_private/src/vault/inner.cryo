/// Under the declaring module: `protected` reaches here, `private` does not.
namespace VisibilityModulePrivate::Vault::Inner;

import VisibilityModulePrivate::Vault;
import VisibilityModulePrivate::Vault::{ Account };

/// CONTROL: a child module reads a protected field.
public function child_reads(a: Account*) -> i32 { return a.for_child; }
