/// Another module adding to a type declared in `Vault`: an `implement` block
/// is inside the module it is written in, not inside the type it names, so it
/// cannot build a `Minted` around its private field.
namespace VisibilityModulePrivate::Forge;

import VisibilityModulePrivate::Vault;
import VisibilityModulePrivate::Vault::{ Minted };

public type struct Helper {
    n: i32;
}

implement struct Minted {
    static forge(k: i32) -> Minted { return Minted { seal: k }; }
}

implement struct Helper {
    private static tuck() -> i32 { return 5; }
}
