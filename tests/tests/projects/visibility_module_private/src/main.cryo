/// E0353 under module-scoped visibility: every access below is outside the
/// module that declares what it reaches, except the controls, which
/// `test.json` asserts produce no error.
namespace VisibilityModulePrivate::Main;

import VisibilityModulePrivate::Vault;
import VisibilityModulePrivate::Vault::{ Chest, Sealed, Stamped, Minted, Account };
import VisibilityModulePrivate::Vault::Inner;
import VisibilityModulePrivate::Sibling;
import VisibilityModulePrivate::Forge;
import VisibilityModulePrivate::Thief;

function main() -> int {
    const v: Chest = Chest::issue();
    mut n: i32 = v.secret;
    const s: Sealed = Sealed { sealed: 1, tag: 2 };
    const t: Stamped = Stamped { tag: 3 };
    n = n + s.tag + t.tag + v.tag;
    n = n + VisibilityModulePrivate::Vault::peek_near(v);
    n = n + VisibilityModulePrivate::Vault::call_tuck();
    const a: Account* = new Account(5);
    n = n + VisibilityModulePrivate::Vault::Inner::child_reads(a);
    n = n + VisibilityModulePrivate::Sibling::sibling_reads(a);
    return n as int;
}
