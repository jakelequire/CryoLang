namespace SpaceshipNamesOrdCompare;

// `a <=> b` is the language's `Ord::compare`.  A type with an inherent
// `compare` beside its `Ord` implementation compares through the trait's
// method: the inherent one, which answers `Equal` for every pair, is not a
// candidate, so the comparison is not ambiguous and does not reach it -
// directly, or through a parameter bounded by `Ord`.
import std::fmt;

type struct Rank {
    value: i32;

    compare(&this, other: &Rank) -> Ordering {
        return Ordering::Equal;
    }
}

implement trait Eq for struct Rank {
    equals(&this, other: &Rank) -> boolean { return this.value == other.value; }
}

implement trait Ord for struct Rank {
    compare(&this, other: &Rank) -> Ordering {
        if (this.value < other.value) { return Ordering::Less; }
        if (this.value > other.value) { return Ordering::Greater; }
        return Ordering::Equal;
    }
}

function as_number(order: Ordering) -> i32 {
    return match (order) {
        Ordering::Less    => { -1 }
        Ordering::Equal   => { 0 }
        Ordering::Greater => { 1 }
    };
}

function through_bound<T>(a: T, b: T) -> Ordering where T: Ord {
    return a <=> b;
}

function main() -> int {
    const low: Rank = Rank { value: 1 };
    const high: Rank = Rank { value: 2 };
    const direct: i32 = as_number(low <=> high);
    const bounded: i32 = as_number(through_bound::<Rank>(Rank { value: 3 }, Rank { value: 2 }));
    fmt::println(f"spaceship: direct = {direct}, bounded = {bounded}");
    return 0;
}
