# linux_startup_runs_c_initializers_once - a hosted Linux program starts
# through glibc, so C code linked into it sees the startup and exit a C program
# sees: its .preinit_array entry and its constructor run once each, and its
# destructor runs when the process exits.
#
# The hooks live in tests/helpers/libstartuphelpers-unix.a (built by the
# Makefile before the project suite runs); calling its two counters pulls the
# object, and with it all three hooks, into the link. The static path is
# relative to this project directory.

[project]
project_name = "linux_startup_runs_c_initializers_once"
output_dir   = "build"
target_type  = "executable"
source_dir   = "src"
entry_point  = "src/main.cryo"

[compiler]

[dependencies]

[link.unix]
static = ["../../../helpers/libstartuphelpers-unix.a"]
