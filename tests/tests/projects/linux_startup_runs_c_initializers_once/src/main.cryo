/// Prints how many times the C helper's initializers ran before `main`. The
/// helper's destructor prints its own line after `main` returns.
namespace LinuxStartupRunsCInitializersOnce::Main;

import std::fmt;

extern "C" {
    function startup_preinit_runs() -> i32;
    function startup_init_runs() -> i32;
}

function main() -> int {
    fmt::println(f"preinit ran {startup_preinit_runs()} time(s), init ran {startup_init_runs()} time(s)");
    return 0;
}
