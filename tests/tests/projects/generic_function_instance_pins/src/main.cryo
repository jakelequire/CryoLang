namespace GenericFunctionInstancePins::Main;

import std::ffi::libc;
import GenericFunctionInstancePins::Gen;
import GenericFunctionInstancePins::Gen::{ tag };

function main() -> i32 {
    const b: u8 = 7;
    const a1: i64 = tag(b);                     // inferred: tag<u8>
    const a2: i64 = tag(true);                  // inferred: tag<boolean>
    const a3: i64 = tag::<i64>(5);              // bare turbofish
    const a4: i64 = Gen::tag::<i64>(6);         // path turbofish, the same instance
    const a5: i64 = Gen::tag::<u8>(3);          // path turbofish, another instance
    const a6: i64 = Gen::tag::<i32>(2);         // path turbofish, a third instance
    const a7: i64 = tag::<f64>(1.5);
    const a8: i64 = tag(false);
    libc::printf("pins %lld %lld %lld %lld %lld %lld %lld %lld\n", a1, a2, a3, a4, a5, a6, a7, a8);
    return 0;
}
