namespace GenericFunctionInstancePins::Gen;

// The instance's own type decides the hundreds, its size the units.
function tag<T>(x: T) -> i64 {
    return static match (T) {
        u8      => { 100 + (sizeof(T) as i64) }
        boolean => { 200 + (sizeof(T) as i64) }
        i64     => { 300 + (sizeof(T) as i64) }
        i32     => { 400 + (sizeof(T) as i64) }
        f64     => { 500 + (sizeof(T) as i64) }
        _       => { 0 }
    };
}
