// `cryo interpret` builds a growable array literal as compiled code does:
// its elements in a block from the function claiming the `alloc` language
// item, the array holding the block, its length and its capacity.  One
// element, several, a repeat whose count is known only at run time, none,
// and an array grown past what its literal held all read back the values
// written; the compiled program prints the same line.

namespace Main;

import std::fmt;

function filled(count: i64) -> [i64] {
    return [6; count];
}

function main() -> i32 {
    const one: [i8] = [7];
    const many: [u16] = [3, 1, 4];
    const repeated: [i64] = filled(3);
    const empty: [i32] = [];
    mut grown: [i32] = [1, 2];
    grown.push(5);
    mut total: u64 = 0;
    for (value in one) { total = total * 10 + (value as u64); }
    for (value in many) { total = total * 10 + (value as u64); }
    for (value in repeated) { total = total * 10 + (value as u64); }
    for (value in grown) { total = total * 10 + (value as u64); }
    fmt::println(f"arrays: {total} {one[0]} {many[2]} {empty.length()} {grown.length()} {repeated.length()}");
    return 0;
}
