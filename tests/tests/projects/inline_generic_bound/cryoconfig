# Inline `<T: Bound>` generic constraints.
#
# The tree writes `where` everywhere: 398 where-clauses across 86 stdlib files
# and NOT ONE inline constraint outside a docstring, in stdlib, compiler/src,
# examples or tests. So the whole syntax had no coverage, and the compiler
# paths that read `GenericParamNode.constraints` - which only this syntax
# populates - were unreachable by every corpus in the repo.
#
# That is why this exists as a project rather than as a unit test: the
# constraint has to be attached to a declaration the package pipeline builds,
# and the point is that nothing else in the tree attaches one at all.
#
# It asserts the syntax compiles and runs. It does NOT assert bound
# enforcement - there is none on this tree, measured two ways; see the header
# of src/main.cryo before reading a pass here as a bound having been checked.
[project]
project_name = "inline_generic_bound"
output_dir = "build"
target_type = "executable"
source_dir = "src"
entry_point = "src/main.cryo"

[compiler]

[dependencies]
