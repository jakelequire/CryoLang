# A bound on a type parameter is written in a `where` clause; the inline
# `<T: Bound>` form is not syntax. This project holds a file that writes it and
# declares `compile_fail`, so the parser's refusal is asserted rather than
# assumed.
#
# It is the only thing in the tree that writes the form at all, so it is also
# the only gate that would notice the production being re-added. See
# src/main.cryo.
[project]
project_name = "inline_generic_bound"
output_dir = "build"
target_type = "executable"
source_dir = "src"
entry_point = "src/main.cryo"

