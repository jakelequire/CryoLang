# worker_pool_closes_on_unwind - a WorkerPool dropped while its workers wait for more jobs (a panic unwinding out of the owner's loop) closes itself, so the process ends with the panic instead of hanging in the join; and the ordinary publish-then-close path runs every job.
[project]
project_name = "worker_pool_closes_on_unwind"
output_dir   = "build"
target_type  = "executable"
source_dir   = "src"
entry_point  = "src/main.cryo"
[compiler]
[dependencies]
compiler = { path = "../../../../compiler", alias = "Compiler" }
