/// A `i64*` passed where an `i64` is declared is refused, and the fix
/// offered writes `*` before it: the value a pointer points to is read
/// explicitly, as a reference's is.  The pointer here is what
/// `iterate_references()` yields.  The build fails; the project pins the
/// refusal's text and the fix's, which a negative file's annotation does not.
namespace PointerForAValueParameterIsReadExplicitly::Main;

import std::collections::array::{ Array };

function take(index: i64) -> i64 {
    return index;
}

function main() -> i32 {
    mut values: Array<i64> = Array::<i64>::new();
    values.push(7);
    mut total: i64 = 0;
    for (value in values.iterate_references()) {
        total = total + take(value);
    }
    return total as i32;
}
