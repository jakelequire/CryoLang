/// A value of a callable-bounded type parameter reached through a pointer is
/// called as `(*p)(args)`: a capturing closure, one taking an argument, a
/// lambda that captures nothing, and a closure borrowing a String called
/// twice. The exit code names the first check that failed; 0 means all held.
namespace CallThroughDereferencedCallablePointer;

import std::ffi::libc;
import std::collections::string::{ String };

function call_through<F, T>(p: F*) -> T where F: () -> T {
    return (*p)();
}

function call_with<F>(p: F*, x: i64) -> i64 where F: (i64) -> i64 {
    return (*p)(x) + (*p)(1);
}

function main() -> int {
    const k: i64 = 7;
    const f = () -> i64 { return k * 6; };
    if (call_through(&f) != 42) { return 1; }
    const g = (x: i64) -> i64 { return x + k; };
    if (call_with(&g, 3) != 18) { return 2; }
    const plain = () -> i64 { return 5; };
    if (call_through(&plain) != 5) { return 3; }
    const word: String = String::from("abc");
    const measure = () -> i64 { return word.length() as i64; };
    if (call_through(&measure) != 3) { return 4; }
    if (call_through(&measure) != 3) { return 5; }
    libc::printf("dereferenced callable ok\n");
    return 0;
}
