namespace ConstantFloatDigitSeparator;

type struct Gauge { reading: f64; }

type enum Sample {
    Value(f64);
    Missing;
}

const THOUSANDS: f64 = 1_000.5;
const EXPONENT: f64 = 1_0.0e1_0;
const NEGATED: f64 = -2_500.25;
const IN_STRUCT: Gauge = Gauge { reading: 1_234.5 };

function main() -> i32 {
    if (THOUSANDS != 1000.5) { return 1; }
    if (EXPONENT != 100000000000.0) { return 2; }
    if (NEGATED != -2500.25) { return 3; }
    if (IN_STRUCT.reading != 1234.5) { return 4; }
    const s: Sample = Sample::Value(1000.5);
    const matched: i32 = match (s) {
        Sample::Value(1_000.5) => { 0 }
        _                      => { 5 }
    };
    return matched;
}
