/// A type parameter has only the methods its bounds give it, and a bound
/// gives the methods of its trait and of every supertrait of that trait.
/// A call no bound in scope declares - the function's `where`, the impl's,
/// or the type declaration's - names nothing and is refused where it is
/// written, even when nothing instantiates the body.
namespace BoundedParamMethodRefused::Main;

type trait Counter {
    count(&this) -> u64;
}

type trait Named : Counter {
    name_len(&this) -> u64;
}

type struct OnType<W> where W: Counter {
    w: W;

    total(&this) -> u64 {
        return this.w.count() + this.w.name_len();
    }
}

function on_function<T>(x: &T) -> u64 where T: Named {
    return x.count() + x.name_len() + x.reset();
}

function main() -> i32 {
    return 0;
}
