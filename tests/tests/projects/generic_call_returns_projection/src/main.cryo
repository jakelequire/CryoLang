namespace generic_call_returns_projection;

import std::core::option::{ Option };

// A generic function whose return type names its parameter's associated
// type, called with a concrete argument: the call has the type the
// argument's impl binds.  `first_of` returns `Option<I::Item>` and `take_or`
// a bare `I::Item`, each under a plain bound and through a supertrait
// (`Back : Source`, `Item` declared by `Source` alone).
type trait Source {
    type Item;
    take(mut &this) -> Option<This::Item>;
}

type trait Back : Source {
    take_back(mut &this) -> Option<This::Item>;
}

type struct Count {
    n: i32;
}

implement trait Source for struct Count {
    type Item = i32;
    take(mut &this) -> Option<i32> {
        if (this.n == 0) { return Option::None; }
        this.n = this.n - 1;
        return Option::Some(this.n);
    }
}

implement trait Back for struct Count {
    take_back(mut &this) -> Option<This::Item> { return this.take(); }
}

function first_of<I>(it: mut &I) -> Option<I::Item> where I: Source {
    return it.take();
}

function last_of<I>(it: mut &I) -> Option<I::Item> where I: Back {
    return it.take_back();
}

function take_or<I>(it: mut &I, d: I::Item) -> I::Item where I: Source {
    return match (it.take()) {
        Option::Some(v) => { v }
        Option::None    => { d }
    };
}

function back_or<I>(it: mut &I, d: I::Item) -> I::Item where I: Back {
    return match (it.take_back()) {
        Option::Some(v) => { v }
        Option::None    => { d }
    };
}

function main() -> i32 {
    mut c: Count = Count { n: 5 };
    const a: Option<i32> = first_of(&c);       // Some(4)
    const b: Option<i32> = last_of(&c);        // Some(3)
    const x: i32 = take_or(&c, 100);           // 2
    const y: i32 = back_or(&c, 100);           // 1
    mut e: Count = Count { n: 0 };
    const z: i32 = back_or(&e, 7);             // 7
    const av: i32 = match (a) { Option::Some(v) => { v } Option::None => { -1 } };
    const bv: i32 = match (b) { Option::Some(v) => { v } Option::None => { -1 } };
    if (av != 4) { return 1; }
    if (bv != 3) { return 2; }
    if (x != 2) { return 3; }
    if (y != 1) { return 4; }
    if (z != 7) { return 5; }
    return 0;
}
