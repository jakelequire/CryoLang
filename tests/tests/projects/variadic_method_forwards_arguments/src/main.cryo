namespace VariadicMethodForwardsArguments;

import std::ffi::libc;

type struct Log {
    prefix: string;

    static emit(fmt: string, args...) -> void {
        libc::vprintf(fmt, args);
    }

    line(&this, fmt: string, args...) -> void {
        libc::printf("%s", this.prefix);
        libc::vprintf(fmt, args);
    }
}

function main() -> i32 {
    Log::emit("static %d %s; ", 42, "forwarded");
    const log: Log = Log { prefix: "[log] " };
    log.line("instance %d+%d\n", 3, 4);
    return 0;
}
