# static_call_hint_leaf_collision - two modules declare a same-leaf type,
# each with a static `make` taking a different parameter type; the consumer
# imports one and calls `Beacon::make(300)`.
#
# The callee hint - the signature expected-type propagation types the
# arguments by - was asked under the WRITTEN scope spelling `Beacon::make`
# before the head's stamp, and that key was a leaf shared by every module's
# `Beacon`, last writer wins.  omega's `(i64)` typed the literal, and the
# call was refused as an `i64` narrowing to `u8`, with a note proposing an
# `as` cast that would have truncated the value.
#
# The stamp names alpha's `Beacon`, its parameter is a `u8`, and the literal
# is out of range: E0010 at the literal.

[project]
project_name = "static_call_hint_leaf_collision"
output_dir   = "build"
target_type  = "executable"
source_dir   = "src"
entry_point  = "src/main.cryo"

