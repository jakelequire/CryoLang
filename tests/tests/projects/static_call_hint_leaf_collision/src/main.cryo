namespace static_call_hint_leaf_collision;

import static_call_hint_leaf_collision::alpha;
import static_call_hint_leaf_collision::alpha::{ Beacon };
import static_call_hint_leaf_collision::omega;

function main() -> i32 {
    // Only alpha's `Beacon` is in scope, so `Beacon::make` is alpha's and its
    // parameter is a `u8`: the literal is out of range, and that is the
    // diagnostic.  A callee hint read off the WRITTEN scope spelling took
    // whichever module registered `Beacon::make` last - omega's `(i64)` -
    // and typed the literal by it, so the call was refused as an `i64`
    // narrowing to `u8` with a note proposing an `as` cast that would have
    // truncated 300 to 44.
    const b: Beacon = Beacon::make(300);
    return b.signal();
}
