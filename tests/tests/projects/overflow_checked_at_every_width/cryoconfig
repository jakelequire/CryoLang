# overflow_checked_at_every_width - built and RUN (outcome = "run") in the
# `debug` profile, whose `overflow_checks` are on: every integer operator
# that can overflow, at every width, panics at the first value past the
# type's range and computes the last value inside it.  Unwinding, so each
# panic is caught and the next case runs.

[project]
project_name = "overflow_checked_at_every_width"
output_dir   = "build"
target_type  = "executable"
source_dir   = "src"
entry_point  = "src/main.cryo"

[profile]
default = "debug"

[compiler]
panic = "unwind"

[dependencies]
