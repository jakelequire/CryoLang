/// Every integer operator that can overflow, at every width, in a build
/// that checks for overflow: the first value past the type's range panics
/// with the operation's message, the last value inside it is computed, and
/// the explicit wrapping methods wrap.  Operands come through `keep`, so no
/// case is a constant expression.  Prints one line per case and a count of
/// the cases that went otherwise; exits 0 only when none did.
namespace OverflowCheckedAtEveryWidth::Main;

import std::fmt;
import std::core::panic_unwind::{ catch_unwind, PanicInfo };
import std::core::result::{ Result };
import std::collections::str::{ Str };

const ADD: string = "attempt to add with overflow";
const SUBTRACT: string = "attempt to subtract with overflow";
const MULTIPLY: string = "attempt to multiply with overflow";
const NEGATE: string = "attempt to negate with overflow";

/// `value`, through a call, so an operation on it is computed when the
/// program runs.
function keep<T>(value: T) -> T {
    return value;
}

type struct Tally {
    cases: i64;
    wrong: i64;

    /// The case panicked with `message`.
    panics<T>(mut &this, label: string, outcome: Result<T, PanicInfo>, message: string) -> void {
        this.cases += 1;
        match (outcome) {
            Result::Ok(_) => {
                fmt::println(f"{label}: no panic");
                this.wrong += 1;
            }
            Result::Err(info) => {
                fmt::println(f"{label}: {info.msg}");
                if (Str::new(info.msg) != Str::new(message)) { this.wrong += 1; }
            }
        }
    }

    /// The case computed `want`.
    equals<T>(mut &this, label: string, outcome: Result<T, PanicInfo>, want: T) -> void where T: Eq {
        this.cases += 1;
        match (outcome) {
            Result::Ok(value) => {
                if (value == want) {
                    fmt::println(f"{label}: ok");
                } else {
                    fmt::println(f"{label}: wrong value");
                    this.wrong += 1;
                }
            }
            Result::Err(info) => {
                fmt::println(f"{label}: {info.msg}");
                this.wrong += 1;
            }
        }
    }
}

function signed_i8(tally: mut Tally*) -> void {
    const max: i8 = keep(i8::MAX);
    const min: i8 = keep(i8::MIN);
    const one: i8 = keep(1 as i8);
    const two: i8 = keep(2 as i8);
    tally.panics("i8 add", catch_unwind(() -> i8 { return max + one; }), ADD);
    tally.equals("i8 add edge", catch_unwind(() -> i8 { return (max - one) + one; }), i8::MAX);
    tally.panics("i8 subtract", catch_unwind(() -> i8 { return min - one; }), SUBTRACT);
    tally.equals("i8 subtract edge", catch_unwind(() -> i8 { return (min + one) - one; }), i8::MIN);
    tally.panics("i8 multiply", catch_unwind(() -> i8 { return max * two; }), MULTIPLY);
    tally.panics("i8 multiply negative", catch_unwind(() -> i8 { return min * -one; }), MULTIPLY);
    tally.equals("i8 multiply edge", catch_unwind(() -> i8 { return (min / two) * two; }), i8::MIN);
    tally.panics("i8 negate", catch_unwind(() -> i8 { return -min; }), NEGATE);
    tally.equals("i8 negate edge", catch_unwind(() -> i8 { return -(min + one); }), i8::MAX);
    tally.panics("i8 increment", catch_unwind(() -> i8 { mut x: i8 = max; x++; return x; }), ADD);
    tally.panics("i8 decrement", catch_unwind(() -> i8 { mut x: i8 = min; x--; return x; }), SUBTRACT);
    tally.panics("i8 compound", catch_unwind(() -> i8 { mut x: i8 = max; x += one; return x; }), ADD);
    tally.equals("i8 wrapping", catch_unwind(() -> i8 { return max.wrapping_add(one); }), i8::MIN);
    tally.equals("i8 negative literal", catch_unwind(() -> i8 { const least: i8 = -128; return least; }), i8::MIN);
}

function signed_i16(tally: mut Tally*) -> void {
    const max: i16 = keep(i16::MAX);
    const min: i16 = keep(i16::MIN);
    const one: i16 = keep(1 as i16);
    const two: i16 = keep(2 as i16);
    tally.panics("i16 add", catch_unwind(() -> i16 { return max + one; }), ADD);
    tally.equals("i16 add edge", catch_unwind(() -> i16 { return (max - one) + one; }), i16::MAX);
    tally.panics("i16 subtract", catch_unwind(() -> i16 { return min - one; }), SUBTRACT);
    tally.equals("i16 subtract edge", catch_unwind(() -> i16 { return (min + one) - one; }), i16::MIN);
    tally.panics("i16 multiply", catch_unwind(() -> i16 { return max * two; }), MULTIPLY);
    tally.panics("i16 multiply negative", catch_unwind(() -> i16 { return min * -one; }), MULTIPLY);
    tally.equals("i16 multiply edge", catch_unwind(() -> i16 { return (min / two) * two; }), i16::MIN);
    tally.panics("i16 negate", catch_unwind(() -> i16 { return -min; }), NEGATE);
    tally.equals("i16 negate edge", catch_unwind(() -> i16 { return -(min + one); }), i16::MAX);
    tally.panics("i16 increment", catch_unwind(() -> i16 { mut x: i16 = max; x++; return x; }), ADD);
    tally.panics("i16 decrement", catch_unwind(() -> i16 { mut x: i16 = min; x--; return x; }), SUBTRACT);
    tally.panics("i16 compound", catch_unwind(() -> i16 { mut x: i16 = max; x += one; return x; }), ADD);
    tally.equals("i16 wrapping", catch_unwind(() -> i16 { return max.wrapping_add(one); }), i16::MIN);
}

