function unsigned_u8(tally: mut Tally*) -> void {
    const max: u8 = keep(u8::MAX);
    const zero: u8 = keep(0 as u8);
    const one: u8 = keep(1 as u8);
    const two: u8 = keep(2 as u8);
    tally.panics("u8 add", catch_unwind(() -> u8 { return max + one; }), ADD);
    tally.equals("u8 add edge", catch_unwind(() -> u8 { return (max - one) + one; }), u8::MAX);
    tally.panics("u8 subtract", catch_unwind(() -> u8 { return zero - one; }), SUBTRACT);
    tally.equals("u8 subtract edge", catch_unwind(() -> u8 { return (zero + one) - one; }), 0 as u8);
    tally.panics("u8 multiply", catch_unwind(() -> u8 { return max * two; }), MULTIPLY);
    tally.equals("u8 multiply edge", catch_unwind(() -> u8 { return (max / two) * two; }), u8::MAX - 1);
    tally.panics("u8 increment", catch_unwind(() -> u8 { mut x: u8 = max; x++; return x; }), ADD);
    tally.panics("u8 decrement", catch_unwind(() -> u8 { mut x: u8 = zero; x--; return x; }), SUBTRACT);
    tally.panics("u8 compound", catch_unwind(() -> u8 { mut x: u8 = zero; x -= one; return x; }), SUBTRACT);
    tally.equals("u8 wrapping", catch_unwind(() -> u8 { return zero.wrapping_subtract(one); }), u8::MAX);
}

