    tally.panics("isize multiply", catch_unwind(() -> isize { return max * two; }), MULTIPLY);
    tally.panics("isize multiply negative", catch_unwind(() -> isize { return min * -one; }), MULTIPLY);
    tally.equals("isize multiply edge", catch_unwind(() -> isize { return (min / two) * two; }), isize::MIN);
    tally.panics("isize negate", catch_unwind(() -> isize { return -min; }), NEGATE);
    tally.equals("isize negate edge", catch_unwind(() -> isize { return -(min + one); }), isize::MAX);
    tally.panics("isize increment", catch_unwind(() -> isize { mut x: isize = max; x++; return x; }), ADD);
    tally.panics("isize decrement", catch_unwind(() -> isize { mut x: isize = min; x--; return x; }), SUBTRACT);
    tally.panics("isize compound", catch_unwind(() -> isize { mut x: isize = max; x += one; return x; }), ADD);
    tally.equals("isize wrapping", catch_unwind(() -> isize { return max.wrapping_add(one); }), isize::MIN);
