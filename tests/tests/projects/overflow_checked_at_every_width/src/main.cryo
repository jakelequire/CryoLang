/// An operand of another width or sign is converted to the expression's
/// type, and the overflow is judged there: `200 + -5` is 195 in an `i32`.
function mixed(tally: mut Tally*) -> void {
    const byte: u8 = keep(200 as u8);
    const less: i32 = keep(-5 as i32);
    const most: i32 = keep(i32::MAX);
    tally.equals("u8 plus i32", catch_unwind(() -> i32 { return byte + less; }), 195 as i32);
    tally.panics("u8 plus i32 past i32", catch_unwind(() -> i32 { return byte + most; }), ADD);
}

/// `power` overflows as `*` does, at the first exponent whose power leaves
/// the type; `wrapping_power` wraps there in every build.  A base whose
/// square overflows, raised to the first power, fits.
function power_at_every_width(tally: mut Tally*) -> void {
    const i8_two: i8 = keep(2 as i8);
    tally.panics("i8 power", catch_unwind(() -> i8 { return i8_two.power(7); }), MULTIPLY);
    tally.equals("i8 power edge", catch_unwind(() -> i8 { return (-i8_two).power(7); }), i8::MIN);
    tally.equals("i8 wrapping power", catch_unwind(() -> i8 { return i8_two.wrapping_power(7); }), i8::MIN);
    const i16_two: i16 = keep(2 as i16);
    tally.panics("i16 power", catch_unwind(() -> i16 { return i16_two.power(15); }), MULTIPLY);
    tally.equals("i16 power edge", catch_unwind(() -> i16 { return (-i16_two).power(15); }), i16::MIN);
    tally.equals("i16 wrapping power", catch_unwind(() -> i16 { return i16_two.wrapping_power(15); }), i16::MIN);
    const i32_two: i32 = keep(2 as i32);
    tally.panics("i32 power", catch_unwind(() -> i32 { return i32_two.power(31); }), MULTIPLY);
    tally.equals("i32 power edge", catch_unwind(() -> i32 { return (-i32_two).power(31); }), i32::MIN);
    tally.equals("i32 wrapping power", catch_unwind(() -> i32 { return i32_two.wrapping_power(31); }), i32::MIN);
    const i64_two: i64 = keep(2 as i64);
    tally.panics("i64 power", catch_unwind(() -> i64 { return i64_two.power(63); }), MULTIPLY);
    tally.equals("i64 power edge", catch_unwind(() -> i64 { return (-i64_two).power(63); }), i64::MIN);
    tally.equals("i64 wrapping power", catch_unwind(() -> i64 { return i64_two.wrapping_power(63); }), i64::MIN);
    const i128_two: i128 = keep(2 as i128);
    tally.panics("i128 power", catch_unwind(() -> i128 { return i128_two.power(127); }), MULTIPLY);
    tally.equals("i128 power edge", catch_unwind(() -> i128 { return (-i128_two).power(127); }), i128::MIN);
    tally.equals("i128 wrapping power", catch_unwind(() -> i128 { return i128_two.wrapping_power(127); }), i128::MIN);
    const isize_two: isize = keep(2 as isize);
    tally.panics("isize power", catch_unwind(() -> isize { return isize_two.power(63); }), MULTIPLY);
    tally.equals("isize power edge", catch_unwind(() -> isize { return (-isize_two).power(63); }), isize::MIN);
    tally.equals("isize wrapping power", catch_unwind(() -> isize { return isize_two.wrapping_power(63); }), isize::MIN);
    const u8_two: u8 = keep(2 as u8);
    tally.panics("u8 power", catch_unwind(() -> u8 { return u8_two.power(8); }), MULTIPLY);
    tally.equals("u8 power edge", catch_unwind(() -> u8 { return u8_two.power(7); }), 128 as u8);
    tally.equals("u8 wrapping power", catch_unwind(() -> u8 { return u8_two.wrapping_power(8); }), 0 as u8);
    const u16_two: u16 = keep(2 as u16);
    tally.panics("u16 power", catch_unwind(() -> u16 { return u16_two.power(16); }), MULTIPLY);
    tally.equals("u16 power edge", catch_unwind(() -> u16 { return u16_two.power(15); }), 32768 as u16);
    tally.equals("u16 wrapping power", catch_unwind(() -> u16 { return u16_two.wrapping_power(16); }), 0 as u16);
    const u32_two: u32 = keep(2 as u32);
    tally.panics("u32 power", catch_unwind(() -> u32 { return u32_two.power(32); }), MULTIPLY);
    tally.equals("u32 power edge", catch_unwind(() -> u32 { return u32_two.power(31); }), 2147483648 as u32);
    tally.equals("u32 wrapping power", catch_unwind(() -> u32 { return u32_two.wrapping_power(32); }), 0 as u32);
    const u64_two: u64 = keep(2 as u64);
    const u64_wide: u64 = keep(4294967296 as u64);
    tally.panics("u64 power", catch_unwind(() -> u64 { return u64_two.power(64); }), MULTIPLY);
    tally.equals("u64 power edge", catch_unwind(() -> u64 { return u64_wide.power(1); }), 4294967296 as u64);
    tally.equals("u64 wrapping power", catch_unwind(() -> u64 { return u64_two.wrapping_power(64); }), 0 as u64);
    const u128_two: u128 = keep(2 as u128);
    tally.panics("u128 power", catch_unwind(() -> u128 { return u128_two.power(128); }), MULTIPLY);
    tally.equals("u128 power edge", catch_unwind(() -> u128 { return u128_two.power(127); }), u128::MAX / 2 + 1);
    tally.equals("u128 wrapping power", catch_unwind(() -> u128 { return u128_two.wrapping_power(128); }), 0 as u128);
    const usize_two: usize = keep(2 as usize);
    tally.panics("usize power", catch_unwind(() -> usize { return usize_two.power(64); }), MULTIPLY);
    tally.equals("usize power edge", catch_unwind(() -> usize { return usize_two.power(63); }), usize::MAX / 2 + 1);
    tally.equals("usize wrapping power", catch_unwind(() -> usize { return usize_two.wrapping_power(64); }), 0 as usize);
}

/// A signed type's `abs` negates as `-` does, so `MIN.abs()` overflows;
/// `checked_abs` answers `None` there.
function abs_at_every_signed_width(tally: mut Tally*) -> void {
    const i8_least: i8 = keep(i8::MIN);
    tally.panics("i8 abs", catch_unwind(() -> i8 { return i8_least.abs(); }), NEGATE);
    tally.equals("i8 abs edge", catch_unwind(() -> i8 { return (i8_least + 1).abs(); }), i8::MAX);
    tally.equals("i8 checked abs", catch_unwind(() -> boolean { return i8_least.checked_abs().is_none(); }), true);
    const i16_least: i16 = keep(i16::MIN);
    tally.panics("i16 abs", catch_unwind(() -> i16 { return i16_least.abs(); }), NEGATE);
    tally.equals("i16 abs edge", catch_unwind(() -> i16 { return (i16_least + 1).abs(); }), i16::MAX);
    tally.equals("i16 checked abs", catch_unwind(() -> boolean { return i16_least.checked_abs().is_none(); }), true);
    const i32_least: i32 = keep(i32::MIN);
    tally.panics("i32 abs", catch_unwind(() -> i32 { return i32_least.abs(); }), NEGATE);
    tally.equals("i32 abs edge", catch_unwind(() -> i32 { return (i32_least + 1).abs(); }), i32::MAX);
    tally.equals("i32 checked abs", catch_unwind(() -> boolean { return i32_least.checked_abs().is_none(); }), true);
    const i64_least: i64 = keep(i64::MIN);
    tally.panics("i64 abs", catch_unwind(() -> i64 { return i64_least.abs(); }), NEGATE);
    tally.equals("i64 abs edge", catch_unwind(() -> i64 { return (i64_least + 1).abs(); }), i64::MAX);
    tally.equals("i64 checked abs", catch_unwind(() -> boolean { return i64_least.checked_abs().is_none(); }), true);
    const i128_least: i128 = keep(i128::MIN);
    tally.panics("i128 abs", catch_unwind(() -> i128 { return i128_least.abs(); }), NEGATE);
    tally.equals("i128 abs edge", catch_unwind(() -> i128 { return (i128_least + 1).abs(); }), i128::MAX);
    tally.equals("i128 checked abs", catch_unwind(() -> boolean { return i128_least.checked_abs().is_none(); }), true);
    const isize_least: isize = keep(isize::MIN);
    tally.panics("isize abs", catch_unwind(() -> isize { return isize_least.abs(); }), NEGATE);
    tally.equals("isize abs edge", catch_unwind(() -> isize { return (isize_least + 1).abs(); }), isize::MAX);
    tally.equals("isize checked abs", catch_unwind(() -> boolean { return isize_least.checked_abs().is_none(); }), true);
}

/// A compound assignment stores `a op b` back into `a`, whose type holds
/// the right side's, so its overflow is judged at the target's type: the
/// last value inside the target's range is stored, the first past it
/// panics, whatever the right side's width and sign.
function compound_at_the_target(tally: mut Tally*) -> void {
    const byte: u8 = keep(200 as u8);
    const small: i8 = keep(-128 as i8);
    const minus_two: i8 = keep(-2 as i8);
    const middle: i32 = keep(-5 as i32);
    const word: u32 = keep(4294967295 as u32);
    const long: u64 = keep(u64::MAX);
    tally.equals("i16 += u8 edge", catch_unwind(() -> i16 { mut x: i16 = keep(32567 as i16); x += byte; return x; }), i16::MAX);
    tally.panics("i16 += u8", catch_unwind(() -> i16 { mut x: i16 = keep(32568 as i16); x += byte; return x; }), ADD);
    tally.equals("i16 -= u8 edge", catch_unwind(() -> i16 { mut x: i16 = keep(-32568 as i16); x -= byte; return x; }), i16::MIN);
    tally.panics("i16 -= u8", catch_unwind(() -> i16 { mut x: i16 = keep(-32569 as i16); x -= byte; return x; }), SUBTRACT);
    tally.equals("i16 *= i8 edge", catch_unwind(() -> i16 { mut x: i16 = keep(16384 as i16); x *= minus_two; return x; }), i16::MIN);
    tally.panics("i16 *= i8", catch_unwind(() -> i16 { mut x: i16 = keep(-16384 as i16); x *= minus_two; return x; }), MULTIPLY);
    tally.equals("u16 += u8 edge", catch_unwind(() -> u16 { mut x: u16 = keep(65335 as u16); x += byte; return x; }), u16::MAX);
    tally.panics("u16 += u8", catch_unwind(() -> u16 { mut x: u16 = keep(65336 as u16); x += byte; return x; }), ADD);
    tally.equals("u16 -= u8 edge", catch_unwind(() -> u16 { mut x: u16 = keep(200 as u16); x -= byte; return x; }), 0 as u16);
    tally.panics("u16 -= u8", catch_unwind(() -> u16 { mut x: u16 = keep(199 as u16); x -= byte; return x; }), SUBTRACT);
    tally.equals("u16 *= u8 edge", catch_unwind(() -> u16 { mut x: u16 = keep(327 as u16); x *= byte; return x; }), 65400 as u16);
    tally.panics("u16 *= u8", catch_unwind(() -> u16 { mut x: u16 = keep(328 as u16); x *= byte; return x; }), MULTIPLY);
    tally.equals("i32 += i8 edge", catch_unwind(() -> i32 { mut x: i32 = keep(i32::MIN + 128); x += small; return x; }), i32::MIN);
    tally.panics("i32 += i8", catch_unwind(() -> i32 { mut x: i32 = keep(i32::MIN + 127); x += small; return x; }), ADD);
    tally.equals("i64 -= i32 edge", catch_unwind(() -> i64 { mut x: i64 = keep(i64::MAX - 5); x -= middle; return x; }), i64::MAX);
    tally.panics("i64 -= i32", catch_unwind(() -> i64 { mut x: i64 = keep(i64::MAX - 4); x -= middle; return x; }), SUBTRACT);
    tally.equals("i64 *= u32 edge", catch_unwind(() -> i64 { mut x: i64 = keep(2147483648 as i64); x *= word; return x; }), 9223372034707292160 as i64);
    tally.panics("i64 *= u32", catch_unwind(() -> i64 { mut x: i64 = keep(2147483649 as i64); x *= word; return x; }), MULTIPLY);
    tally.equals("u64 += u32 edge", catch_unwind(() -> u64 { mut x: u64 = keep(u64::MAX - 4294967295); x += word; return x; }), u64::MAX);
    tally.panics("u64 += u32", catch_unwind(() -> u64 { mut x: u64 = keep(u64::MAX - 4294967294); x += word; return x; }), ADD);
    tally.equals("i128 += u64 edge", catch_unwind(() -> i128 { mut x: i128 = keep(i128::MAX - 18446744073709551615); x += long; return x; }), i128::MAX);
    tally.panics("i128 += u64", catch_unwind(() -> i128 { mut x: i128 = keep(i128::MAX - 18446744073709551614); x += long; return x; }), ADD);
    tally.equals("u128 -= u64 edge", catch_unwind(() -> u128 { mut x: u128 = keep(18446744073709551615 as u128); x -= long; return x; }), 0 as u128);
    tally.panics("u128 -= u64", catch_unwind(() -> u128 { mut x: u128 = keep(18446744073709551614 as u128); x -= long; return x; }), SUBTRACT);
    tally.equals("u128 *= u64 edge", catch_unwind(() -> u128 { mut x: u128 = keep(u128::MAX / 18446744073709551615); x *= long; return x; }), u128::MAX);
    tally.panics("u128 *= u64", catch_unwind(() -> u128 { mut x: u128 = keep(u128::MAX / 18446744073709551615 + 1); x *= long; return x; }), MULTIPLY);
}

function main() -> int {
    mut tally: Tally = Tally { cases: 0, wrong: 0 };
    mixed(&tally);
    power_at_every_width(&tally);
    abs_at_every_signed_width(&tally);
    compound_at_the_target(&tally);
    signed_i8(&tally);
    signed_i16(&tally);
    signed_i32(&tally);
    signed_i64(&tally);
    signed_i128(&tally);
    signed_isize(&tally);
    unsigned_u8(&tally);
    unsigned_u16(&tally);
    unsigned_u32(&tally);
    unsigned_u64(&tally);
    unsigned_u128(&tally);
    unsigned_usize(&tally);
    fmt::println(f"overflow checks: {tally.wrong} wrong of {tally.cases}");
    if (tally.wrong != 0) { return 1; }
    return 0;
}
