    const one: isize = keep(1 as isize);
    const two: isize = keep(2 as isize);
    tally.panics("isize add", catch_unwind(() -> isize { return max + one; }), ADD);
    tally.equals("isize add edge", catch_unwind(() -> isize { return (max - one) + one; }), isize::MAX);
    tally.panics("isize subtract", catch_unwind(() -> isize { return min - one; }), SUBTRACT);
