function unsigned_usize(tally: mut Tally*) -> void {
    const max: usize = keep(usize::MAX);
    const zero: usize = keep(0 as usize);
    const one: usize = keep(1 as usize);
    const two: usize = keep(2 as usize);
    tally.panics("usize add", catch_unwind(() -> usize { return max + one; }), ADD);
    tally.equals("usize add edge", catch_unwind(() -> usize { return (max - one) + one; }), usize::MAX);
    tally.panics("usize subtract", catch_unwind(() -> usize { return zero - one; }), SUBTRACT);
    tally.equals("usize subtract edge", catch_unwind(() -> usize { return (zero + one) - one; }), 0 as usize);
    tally.panics("usize multiply", catch_unwind(() -> usize { return max * two; }), MULTIPLY);
    tally.equals("usize multiply edge", catch_unwind(() -> usize { return (max / two) * two; }), usize::MAX - 1);
    tally.panics("usize increment", catch_unwind(() -> usize { mut x: usize = max; x++; return x; }), ADD);
    tally.panics("usize decrement", catch_unwind(() -> usize { mut x: usize = zero; x--; return x; }), SUBTRACT);
    tally.panics("usize compound", catch_unwind(() -> usize { mut x: usize = zero; x -= one; return x; }), SUBTRACT);
    tally.equals("usize wrapping", catch_unwind(() -> usize { return zero.wrapping_subtract(one); }), usize::MAX);
}

/// An operand of another width or sign is converted to the expression's
/// type, and the overflow is judged there: `200 + -5` is 195 in an `i32`.
function mixed(tally: mut Tally*) -> void {
    const byte: u8 = keep(200 as u8);
    const less: i32 = keep(-5 as i32);
    const most: i32 = keep(i32::MAX);
    tally.equals("u8 plus i32", catch_unwind(() -> i32 { return byte + less; }), 195 as i32);
    tally.panics("u8 plus i32 past i32", catch_unwind(() -> i32 { return byte + most; }), ADD);
}

function main() -> int {
    mut tally: Tally = Tally { cases: 0, wrong: 0 };
    mixed(&tally);
    signed_i8(&tally);
    signed_i16(&tally);
    signed_i32(&tally);
    signed_i64(&tally);
    signed_i128(&tally);
    signed_isize(&tally);
    unsigned_u8(&tally);
    unsigned_u16(&tally);
    unsigned_u32(&tally);
    unsigned_u64(&tally);
    unsigned_u128(&tally);
    unsigned_usize(&tally);
    fmt::println(f"overflow checks: {tally.wrong} wrong of {tally.cases}");
    if (tally.wrong != 0) { return 1; }
    return 0;
}
