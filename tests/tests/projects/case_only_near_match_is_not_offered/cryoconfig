# case_only_near_match_is_not_offered - a near match that differs from the
# written name only in letter case is not offered as a fix.
#
# `std::core` offers the module `drop`, not the trait `Drop`; a name that
# differs only in case names another kind of thing as often as it fixes a
# typo, so E0502 lists what the module offers and suggests nothing.  The
# CONTROL is `Mutx` beside it: one letter short of `Mutex`, which
# `std::sync` offers, and still offered as the fix.

[project]
project_name = "case_only_near_match_is_not_offered"
output_dir   = "build"
target_type  = "executable"
source_dir   = "src"
entry_point  = "src/main.cryo"

