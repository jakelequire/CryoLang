# extern_private_function_is_private - a `private function` declared in an
# extern block is a declaration of its module and takes its written
# visibility: `Ffi::llabs(-9)` from another module is E0353.
#
# The extern-block registration recorded no visibility verdict, and the
# verdict map's permissive default answered "public" for every extern
# function, so this program compiled and ran (exit 9).  The verdict is now
# recorded with the registration, and a candidate with none is a recorded
# defect rather than a public item.
[project]
project_name = "extern_private_function_is_private"
output_dir   = "build"
target_type  = "executable"
source_dir   = "src"
entry_point  = "src/main.cryo"
[compiler]
[dependencies]
