///! A program's own module named `panic` beside the prelude's
///! `std::core::panic`: the program names its module by its full path,
///! as it would any module whose leaf a prelude module shares, and a
///! bare `panic(...)` is still the prelude's function.

namespace UserModuleNamedPanic;

import std::core::intrinsics;
import std::fmt::{ println };
import UserModuleNamedPanic::panic;

function main() -> i32 {
    println(f"{UserModuleNamedPanic::panic::describe(3)}");
    if (UserModuleNamedPanic::panic::describe(0) == 0) {
        panic("a bare panic is the prelude's", intrinsics::location());
    }
    return 0;
}
