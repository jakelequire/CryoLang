# resolution_scope - the keystone corpus slice (docs/name-resolution.md §5.2).
#
# The keystone replaces the ambient cursor with an explicit scope at 49
# `ResolutionContext::new("")` sites. §8.2g measured that the compiler's own
# sources cannot tell a correct implementation of that from a broken one: of
# 13,370 wrong-cursor resolutions, 13,369 had exactly ONE candidate in the
# whole program, so no scope could have changed the answer. The self-host
# fixed point stays byte-identical either way.
#
# §8.2h narrowed it further: CRYO_SCOPE_PROBE runs only inside cascade step
# 2c, which is reached only when a scope is ALREADY set - the complement of
# the sites the keystone fixes. So `HomeDiffPlural > 0` is NOT a usable
# acceptance test either; a correct entry registers zero on it.
#
# What is left is behavior. Every module here declares the SAME leaf names
# with DIFFERENT values, so a name that binds to the wrong module produces a
# wrong NUMBER rather than a compile error - observable with no instrument,
# before and after the keystone, and on both OSes.
#
# Sibling coverage, deliberately not duplicated here:
#   generic_name_collision - the same idea for GENERIC functions and types.
#   visibility_e2e         - cross-package `public`/`private`.

[project]
project_name = "resolution_scope"
output_dir   = "build"
target_type  = "executable"
source_dir   = "src"
entry_point  = "src/main.cryo"

