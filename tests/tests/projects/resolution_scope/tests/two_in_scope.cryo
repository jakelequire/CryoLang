/// Imports TWO of the colliding modules at once. Every reference here is
/// QUALIFIED, which must keep resolving exactly however many candidates the
/// scope holds -- the keystone must not "fix" ambiguity by making a qualified
/// path prefer the nearest or the first-seen module.
///
/// There is deliberately NO bare `tint()` or bare `Paint` in this file: with
/// both imports in scope that is genuinely ambiguous, and pinning what the
/// compiler does with it today would pin behavior spec §5.1 has not settled
/// (it is the E0203/E0154 question in §2.6). This file pins the part that IS
/// settled.
![config(testing)]
namespace ResolutionScope::TwoInScope;

import ResolutionScope::Red;
import ResolutionScope::Green;

function red_qualified() -> i32 { return ResolutionScope::Red::tint(); }
function green_qualified() -> i32 { return ResolutionScope::Green::tint(); }

function red_type_qualified() -> i32 {
    const p: ResolutionScope::Red::Paint = ResolutionScope::Red::Paint::mix();
    return p.shade();
}

function green_type_qualified() -> i32 {
    const p: ResolutionScope::Green::Paint = ResolutionScope::Green::Paint::mix();
    return p.shade();
}
