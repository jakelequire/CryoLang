/// Imports ONLY Green. Held alongside UsesRed and UsesBlue so a fix has to
/// route each caller to its OWN import rather than pick one winner globally.
![config(testing)]
namespace ResolutionScope::UsesGreen;

import ResolutionScope::Green;

function bare_call() -> i32 { return tint(); }

function bare_annotation() -> Paint { return Paint::mix(); }
