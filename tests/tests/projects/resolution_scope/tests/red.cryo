/// One of THREE modules declaring the same two leaves, `tint` and `Paint`.
/// Each returns a different value, so a name that binds to the wrong module
/// yields a wrong NUMBER rather than a compile error -- the only signal that
/// survives the keystone, since §8.2h shows the scope probe cannot see it.
![config(testing)]
namespace ResolutionScope::Red;

function tint() -> i32 { return 1; }

type struct Paint {
    v: i32;

    static mix() -> Paint { return Paint { v: 1 }; }
    shade(&this) -> i32 { return this.v; }
}
