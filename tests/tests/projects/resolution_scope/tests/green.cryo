/// Twin of `Red`, same leaves, value 2. Three-way rather than two-way on
/// purpose: a fix that consistently prefers one module program-wide passes a
/// two-way collision by coincidence one time in two, and a three-way one only
/// one time in three.
![config(testing)]
namespace ResolutionScope::Green;

function tint() -> i32 { return 2; }

type struct Paint {
    v: i32;

    static mix() -> Paint { return Paint { v: 2 }; }
    shade(&this) -> i32 { return this.v; }
}
