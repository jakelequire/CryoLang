/// Imports ONLY Red. Its bare `tint()` and bare `Paint` must bind to Red's,
/// decided by this module's imports and nothing else.
![config(testing)]
namespace ResolutionScope::UsesRed;

import ResolutionScope::Red;

function bare_call() -> i32 { return tint(); }

/// Bare `Paint` in RETURN position. The annotation is re-resolved downstream
/// while the compiler is standing in the CALLER's module, which binds a
/// different `Paint` -- the wrong-cursor case, in the type lane.
function bare_annotation() -> Paint { return Paint::mix(); }
