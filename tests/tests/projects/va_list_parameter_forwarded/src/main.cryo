namespace VaListParameterForwarded;

import std::ffi::libc;

// A `va_list` a Cryo function takes as a parameter is passed on to a C
// `v*` function as the variadic bucket is: each hop through Cryo code
// keeps it as it is, and only the foreign function takes it by value.

function format_into(buffer: mut u8*, size: u64, fmt: string, args: va_list) -> i32 {
    return libc::vsnprintf(buffer, size, fmt, args);
}

function format_twice_removed(buffer: mut u8*, size: u64, fmt: string, args: va_list) -> i32 {
    return format_into(buffer, size, fmt, args);
}

function through(buffer: mut u8*, size: u64, fmt: string, args...) -> i32 {
    return format_into(buffer, size, fmt, args);
}

function through_two(buffer: mut u8*, size: u64, fmt: string, args...) -> i32 {
    return format_twice_removed(buffer, size, fmt, args);
}

function direct(buffer: mut u8*, size: u64, fmt: string, args...) -> i32 {
    return libc::vsnprintf(buffer, size, fmt, args);
}

function main() -> i32 {
    mut buffer: [u8; 64];
    const at: mut u8* = &buffer[0];
    if (direct(at, 64, "direct %d %s", 42, "hi") != 12) { return 1; }
    if (libc::strcmp(at, "direct 42 hi") != 0) { return 2; }
    if (through(at, 64, "through %d %s", 42, "hi") != 13) { return 3; }
    if (libc::strcmp(at, "through 42 hi") != 0) { return 4; }
    if (through_two(at, 64, "two %d %s", 7, "hops") != 10) { return 5; }
    if (libc::strcmp(at, "two 7 hops") != 0) { return 6; }
    return 0;
}
