namespace EmptyArrayLiteralToGenericOwnerParameter;

import std::sync::mutex::{ Mutex };

// An empty array literal given where a generic owner's parameter `T` is
// expected takes its element type from the argument the owner's turbofish
// or receiver writes for `T`, as a literal with elements does.

type struct Shelf<T> {
    items: T;

    static new(items: T) -> Shelf<T> { return Shelf::<T> { items: items }; }

    replace(mut &this, items: T) -> void { this.items = items; }
}

function main() -> i32 {
    mut shelf: Shelf<[i64]> = Shelf::<[i64]>::new([]);
    if (shelf.items.length() != 0) { return 1; }
    shelf.items.push(4);
    if (shelf.items.length() != 1) { return 2; }
    shelf.replace([]);
    if (shelf.items.length() != 0) { return 3; }
    const results: Mutex<[i64]> = Mutex::<[i64]>::new([]);
    if ((*results.lock().as_ptr()).length() != 0) { return 4; }
    return 0;
}
