# discovery_skips_dot_directory - a directory whose name begins with `.`
# holds no sources, so the namespace a file inside one declares is no module
# an import can name (outcome = "compile_fail").
#
# `src/.tool-state/hidden.cryo` declares `namespace Hidden;`; the import of
# `Hidden` is refused as naming no module.

[project]
project_name = "discovery_skips_dot_directory"
output_dir   = "build"
target_type  = "executable"
source_dir   = "src"
entry_point  = "src/main.cryo"

