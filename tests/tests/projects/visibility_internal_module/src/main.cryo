namespace VisibilityInternalModule::Main;

internal module Hidden;

import Yard::Gate;
import Yard::Engine;
import Yard::{ Gears };
import Yard::Engine::Piston;
import VisibilityInternalModule::Hidden;

// What an internal module declares reaches its package, so a public
// signature may not name it.
public function leak() -> Hidden::Secret { return Hidden::Secret { v: 1 }; }

// Its own package names an internal module's items freely.
function kept() -> i32 { return Hidden::Secret { v: 2 }.v; }

function main() -> i32 {
    const c: Yard::Gears::Cog = Yard::Gears::Cog { teeth: 3 };
    return Gate::open() + Yard::open_hours() + Yard::Engine::Piston::fire() + c.teeth + kept();
}
