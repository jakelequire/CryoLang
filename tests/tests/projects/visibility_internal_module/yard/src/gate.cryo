namespace Yard::Gate;

import Yard::Engine::Piston;
import Yard::Gears;

// A module of the same package reaches the internal modules, the one
// declared under an internal module included: none of these is refused.
public function open() -> i32 {
    const c: Gears::Cog = Gears::Cog { teeth: 3 };
    return Piston::fire() + c.teeth;
}
