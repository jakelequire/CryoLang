namespace ByteOrderMark;

import ByteOrderMark::marked::{ Counter };
import std::fmt;

// This file and `marked.cryo` both begin with a UTF-8 byte order mark
// (EF BB BF), which an editor writes when it saves "UTF-8 with BOM".  The
// mark is no part of the text: both files must compile as if it were absent.

function main() -> i32 {
    mut counter: Counter = Counter::new();
    counter.add(40);
    counter.add(2);
    if (counter.total != 42) {
        return 1;
    }
    fmt::println("ok");
    return 0;
}
