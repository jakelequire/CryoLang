/// An integer literal in a variant's payload pattern compares as an integer
/// whatever digits it is written with: `0xE` and `-0x1E` hold an `E` digit
/// and no fraction or exponent, and `7usize` holds an `e` only in its
/// suffix.  A literal taken for a float by those letters would not compare
/// equal to the integer it writes.
namespace HexPayloadPatternsCompare::Main;

import std::ffi::libc::{ printf };
import std::core::option::{ Option };

function classify(value: Option<i64>) -> i32 {
    return match (value) {
        Option::Some(0xE)    => { 1 }
        Option::Some(-0x1E)  => { 2 }
        Option::Some(0b1_01) => { 3 }
        Option::Some(0x2E)   => { 4 }
        _                    => { 0 }
    };
}

function sized(value: Option<usize>) -> i32 {
    return match (value) {
        Option::Some(7usize) => { 1 }
        _                    => { 0 }
    };
}

function main() -> i32 {
    mut passed: i32 = 0;
    if (classify(Option::Some(14)) == 1) { passed += 1; }
    if (classify(Option::Some(-30)) == 2) { passed += 1; }
    if (classify(Option::Some(5)) == 3) { passed += 1; }
    if (classify(Option::Some(46)) == 4) { passed += 1; }
    if (classify(Option::Some(15)) == 0) { passed += 1; }
    if (classify(Option::Some(-14)) == 0) { passed += 1; }
    if (classify(Option::None) == 0) { passed += 1; }
    if (sized(Option::Some(7)) == 1) { passed += 1; }
    if (sized(Option::Some(8)) == 0) { passed += 1; }
    printf("hex payload patterns compare: %d of 9 checks passed\n", passed);
    return if (passed == 9) { 0 } else { 1 };
}
