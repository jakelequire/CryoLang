# The mmap-backed heap's own behaviour - size classes, free-list reuse, the
# large path, over-alignment, reallocation in place and across classes -
# driven through `GlobalAlloc`, which serves every allocation from that heap
# under `[low_level] native_alloc = true`.

[project]
project_name = "native_heap_through_global_alloc"
output_dir   = "build"
target_type  = "executable"
source_dir   = "src"
entry_point  = "src/main.cryo"

[low_level]
native_alloc = true

