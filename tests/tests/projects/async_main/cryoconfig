# async_main - `async function main` end-to-end (outcome = "run").
#
# The entry point cannot be a unit test: an `async function main` is rewritten
# into a synchronous `main`, and the unit-test binary supplies its own. Only a
# project gets a `main` of its own to rewrite.

[project]
project_name = "async_main"
output_dir   = "build"
target_type  = "executable"
source_dir   = "src"
entry_point  = "src/main.cryo"

