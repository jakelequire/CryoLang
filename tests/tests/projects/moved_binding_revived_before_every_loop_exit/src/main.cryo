namespace Main;

// A `loop` is left only by a `break`, and a `do-while` runs its body at
// least once and is left by its condition: a binding moved before such a
// loop and assigned on every path to its exits holds a value after it, may
// be used there, and is released once.

type struct Counted {
    drops: mut i64*;
    id: i64;
}

implement trait Drop for struct Counted {
    drop(mut &this) -> void { *this.drops = *this.drops + 1; }
}

function take(value: Counted) -> i64 { return value.id; }

function in_loop(times: i64, drops: mut i64*) -> i64 {
    mut value: Counted = Counted { drops: drops, id: 1 };
    mut seen: i64 = take(value);
    mut i: i64 = 0;
    loop {
        value = Counted { drops: drops, id: 2 };
        i += 1;
        if (i >= times) { break; }
        seen += take(value);
    }
    return seen + take(value);
}

function in_do_while(times: i64, drops: mut i64*) -> i64 {
    mut value: Counted = Counted { drops: drops, id: 1 };
    mut seen: i64 = take(value);
    mut i: i64 = 0;
    do {
        value = Counted { drops: drops, id: 3 };
        i += 1;
    } while (i < times);
    return seen + take(value);
}

// Revived and left alive: released at its scope's end, not by the loop.
function kept_after_loop(drops: mut i64*) -> i64 {
    mut value: Counted = Counted { drops: drops, id: 4 };
    const seen: i64 = take(value);
    loop {
        value = Counted { drops: drops, id: 5 };
        break;
    }
    return seen + value.id;
}

function main() -> i32 {
    mut drops: i64 = 0;
    if (in_loop(1, &drops) != 3) { return 1; }
    if (drops != 2) { return 2; }
    drops = 0;
    if (in_loop(3, &drops) != 7) { return 3; }
    if (drops != 4) { return 4; }
    drops = 0;
    if (in_do_while(1, &drops) != 4) { return 5; }
    if (drops != 2) { return 6; }
    drops = 0;
    if (in_do_while(3, &drops) != 4) { return 7; }
    if (drops != 4) { return 8; }
    drops = 0;
    if (kept_after_loop(&drops) != 9) { return 9; }
    if (drops != 2) { return 10; }
    return 0;
}
