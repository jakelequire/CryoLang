# path_call_generic_method - a generic method called through a path with
# its receiver as the first argument: `Q::go(&q, 7)`, `BetaG::go(&r, 7)`,
# `(BetaG for NgTf)::go(&g, 7)`.  The method's own type parameters bind
# from the turbofish or from the arguments after the receiver, as they do
# for `q.go(7)`, and monomorphization mints the specialization the call
# runs.  The impl-qualified form is how a caller names a trait's method
# beside an inherent one of the same name.
[project]
project_name = "path_call_generic_method"
output_dir   = "build"
target_type  = "executable"
source_dir   = "src"
entry_point  = "src/main.cryo"
[compiler]
[dependencies]
