namespace PathCallGenericMethod::Main;

type trait BetaG { go<U>(&this, u: U) -> i64; }
type trait Mk { static make() -> i64; }

// Only an inherent generic method.
type struct Q { v: i32; }
implement struct Q {
    go<U>(&this, u: U) -> i64 { return 1; }
    id<U>(&this, u: U) -> U { return u; }
}

// Only a trait's generic method.
type struct R { v: i32; }
implement trait BetaG for R { go<U>(&this, u: U) -> i64 { return 20; } }

// An inherent generic method and a trait's of the same name: the path
// `NgTf::go(..)` is ambiguous, and the impl-qualified path names the trait's.
type struct NgTf { v: i32; }
implement trait BetaG for NgTf { go<U>(&this, u: U) -> i64 { return 300; } }
implement struct NgTf { go<U>(&this, u: U) -> i64 { return 0; } }

// An inherent static method and a trait's: the impl-qualified path names
// the trait's.
type struct SNn { v: i32; }
implement trait Mk for SNn { static make() -> i64 { return 4000; } }
implement struct SNn { static make() -> i64 { return 0; } }

function main() -> i32 {
    const q: Q = Q { v: 5 };
    const r: R = R { v: 5 };
    const g: NgTf = NgTf { v: 5 };
    // A path call binds a generic method's own parameter from the turbofish
    // or from the arguments after the receiver, as `q.go(7)` does.
    if (Q::go::<i32>(&q, 7) + Q::go(&q, 7) != 2) { return 1; }
    // The parameter reaches the return type.
    const s: u64 = Q::id(&q, 41u64);
    if (s + 1 != 42) { return 2; }
    // Through the type, the trait and the implementation.
    if (R::go(&r, 7) + BetaG::go(&r, 7) + (BetaG for R)::go(&r, 7) != 60) { return 3; }
    // The trait's method beside an inherent one of the same name.
    if ((BetaG for NgTf)::go(&g, 7) + (BetaG for NgTf)::go::<u8>(&g, 7) != 600) { return 4; }
    if ((Mk for SNn)::make() != 4000) { return 5; }
    // Two instantiations of one method are two definitions.
    if (Q::id(&q, 3) + (Q::id(&q, 2u64) as i32) != 5) { return 6; }
    return 0;
}
