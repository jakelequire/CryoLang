namespace ClosureKeepsEnclosingParameters::Main;

type struct Cell { n: i64; }

type enum Slot { Filled(Cell); Empty; }

// `s` reaches the caller's slot, so a payload binding taken from it may be
// returned - before a closure and after one alike.
function slot_ptr_after_closure(s: Slot*) -> Cell* {
    const bump = (x: i64) -> i64 { return x + 1; };
    if (bump(1) != 2) { core::panic("closure miscomputed", FILE, LINE); }
    match (s) {
        Slot::Filled(value) => { return &value; }
        Slot::Empty => { core::panic("an Empty slot", FILE, LINE); }
    }
}

// The same after a closure that captures another parameter.
function slot_ptr_after_capture(s: Slot*, k: i64) -> Cell* {
    const add_k = (x: i64) -> i64 { return x + k; };
    if (add_k(1) != 1 + k) { core::panic("closure miscomputed", FILE, LINE); }
    match (s) {
        Slot::Filled(value) => { return &value; }
        Slot::Empty => { core::panic("an Empty slot", FILE, LINE); }
    }
}

function main() -> i32 {
    mut s: Slot = Slot::Filled(Cell { n: 20 });
    const p: Cell* = slot_ptr_after_closure(&s);
    p.n = p.n + 2;
    // Read the ORIGINAL back: a copy would still hold 20.
    const seen: i64 = match (&s) {
        Slot::Filled(v) => { v.n }
        Slot::Empty => { 0 }
    };
    if (seen != 22) { return 1; }

    mut t: Slot = Slot::Filled(Cell { n: 1 });
    const q: Cell* = slot_ptr_after_capture(&t, 4);
    q.n = q.n + 5;
    const seen2: i64 = match (&t) {
        Slot::Filled(v) => { v.n }
        Slot::Empty => { 0 }
    };
    if (seen2 != 6) { return 2; }
    return 0;
}
