namespace OpaqueReturnOfInferredGenericLiteral;

// A generic struct's literal written without type arguments is the instance
// its field values give it, and a function returning it as `implement
// Trait` returns that instance: a closure's type cannot be written, so this
// is the only way to return a value holding one.

type trait Source { next_value(mut &this) -> i64; }

type struct Gen<F> where F: () -> i64 {
    f: F;
}

implement<F> trait Source for Gen<F> where F: () -> i64 {
    next_value(mut &this) -> i64 { return this.f(); }
}

// Callers come before the functions they call.
function main() -> i32 {
    mut fixed = from_function();
    if (fixed.next_value() != 4) { return 1; }
    mut doubled = doubling(10);
    if (doubled.next_value() != 23) { return 2; }
    if (doubled.next_value() != 23) { return 3; }
    mut again = from_function();
    if (again.next_value() + fixed.next_value() != 8) { return 4; }
    return 0;
}

function four() -> i64 { return 4; }

function from_function() -> implement Source {
    return Gen { f: four };
}

function doubling(start: i64) -> implement Source {
    const offset: i64 = 3;
    return Gen { f: move () -> i64 { return start * 2 + offset; } };
}
