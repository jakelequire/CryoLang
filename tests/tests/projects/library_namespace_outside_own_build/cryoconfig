# library_namespace_outside_own_build - a library's rules hold in its own
# project's build, not only where a dependent compiles it.  The `[lib]` is
# src/tally, whose lib.cryo declares `Tally`; `Tally::inner` beside it is
# the library's own, while `Helper` and `Tallying` (which only begins with
# `Tally`) are outside it: E0510 for each.  The binary's entry point,
# src/main.cryo, is outside the library's directory, so its namespace is
# the program's and not the library's: no E0510 for it.
[project]
project_name = "library_namespace_outside_own_build"
output_dir   = "build"

[lib]
name       = "tally"
source_dir = "src/tally"

[[bin]]
name        = "tally_cli"
entry_point = "src/main.cryo"

[compiler]

[dependencies]
