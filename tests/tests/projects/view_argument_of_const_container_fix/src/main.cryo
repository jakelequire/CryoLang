namespace ViewArgumentOfConstContainerFix;

import std::core::slice::{ Slice };

// A view of a `const` array passed where the parameter writes is refused,
// naming the binding, with `mut` offered as machine-applicable; made, the
// view is written and the program runs.

function fill(xs: mut &Slice<i64>, value: i64) -> void {
    for (mut i: i64 = 0; i < xs.length(); i++) { xs[i] = value; }
}

function main() -> i32 {
    const values: [i64] = [1, 2, 3];
    fill(values[1..], 0);
    return (values[0] + values[1] + values[2] - 1) as i32;
}
