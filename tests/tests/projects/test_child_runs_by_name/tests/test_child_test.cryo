///! A `![test_child]` function is not a test: the runner neither runs nor
///! lists it, and a test starts it by name through `TestChild::command`,
///! as a process of its own whose exit says how the child ended. A project
///! rather than a unit file: a compiler without test children refuses
///! `TestChild`, and a unit file it refuses would stop its whole unit build.
///! `fails_on_purpose` returning `Err` also proves the suite never runs a
///! test child as a test: this project would fail if it did.

![config(testing)]
namespace CryoTests::Tests::TestChildren;

import std::core::result::{ Result };
import std::core::option::{ Option };
import std::core::slice::{ Slice };
import std::collections::str::{ Str };
import std::collections::string::{ String };
import std::fmt;
import std::env;
import std::process::command::{ Command, Output };
import std::test::error::{ TestError };
import std::test::assert::{ bail, expect, expect_eq };
import std::test::test_child::{ TestChild };

![test_child]
function prints_ready() -> Result<(), TestError> {
    fmt::print("ready");
    return Result::Ok(());
}

![test_child]
function fails_on_purpose() -> Result<(), TestError> {
    return bail(Str::new("the test child failed on purpose"));
}

/// Captured output bytes as text; empty when they are not UTF-8.
function text_of(bytes: &Slice<u8>) -> Str {
    return match (Str::from_utf8(bytes)) {
        Result::Ok(text) => { text }
        Result::Err(_)   => { Str::new("") }
    };
}

![test]
function a_test_child_runs_by_name_and_exits_zero() -> Result<(), TestError> {
    const command: Command = TestChild::command(Str::new("CryoTests::Tests::TestChildren::prints_ready"))?;
    const output: Output = command.output()?;
    expect_eq(output.status().exit_code(), Option::Some(0))?;
    return expect(text_of(output.stdout()).equals(&Str::new("ready")), Str::new("the test child's own output reaches the parent"));
}

![test]
function a_test_child_returning_err_exits_one_with_its_message() -> Result<(), TestError> {
    const command: Command = TestChild::command(Str::new("CryoTests::Tests::TestChildren::fails_on_purpose"))?;
    const output: Output = command.output()?;
    expect_eq(output.status().exit_code(), Option::Some(1))?;
    return expect(text_of(output.stderr()).contains(&Str::new("the test child failed on purpose")), Str::new("the test child's error message is on stderr"));
}

![test]
function an_unknown_test_child_exits_two() -> Result<(), TestError> {
    const command: Command = TestChild::command(Str::new("CryoTests::Tests::TestChildren::no_such_child"))?;
    const output: Output = command.output()?;
    expect_eq(output.status().exit_code(), Option::Some(2))?;
    return expect(text_of(output.stderr()).contains(&Str::new("no_such_child")), Str::new("the error names the test child asked for"));
}

![test]
function the_list_shows_tests_and_no_test_children() -> Result<(), TestError> {
    const executable: Option<String> = env::current_exe();
    if (executable.is_none()) { return bail(Str::new("the test binary's own path cannot be read")); }
    mut command: Command = Command::new(executable.unwrap().as_str());
    command.arg(Str::new("--list"));
    const output: Output = command.output()?;
    const listed: Str = text_of(output.stdout());
    expect(listed.contains(&Str::new("the_list_shows_tests_and_no_test_children")), Str::new("the list shows this test"))?;
    expect(!listed.contains(&Str::new("prints_ready")), Str::new("the list leaves out a test child"))?;
    return expect(!listed.contains(&Str::new("fails_on_purpose")), Str::new("the list leaves out every test child"));
}
