namespace TraitLeafDispatch::Main;

import TraitLeafDispatch::Alpha;
import TraitLeafDispatch::Omega;

type struct Shape { v: int; }

implement trait TraitLeafDispatch::Alpha::Render for struct Shape {
    render(&this) -> int { return 1; }
}

implement trait TraitLeafDispatch::Omega::Render for struct Shape {
    render(&this) -> int { return 2; }
}

/// Each bound names one of the two same-leaf traits; the call inside must
/// reach that trait's method and not the other's.
function via_alpha<T>(x: &T) -> int where T: TraitLeafDispatch::Alpha::Render { return x.render(); }
function via_omega<T>(x: &T) -> int where T: TraitLeafDispatch::Omega::Render { return x.render(); }

function main() -> int {
    const s: Shape = Shape { v: 0 };
    const a: int = via_alpha(&s);
    const o: int = via_omega(&s);
    return a * 10 + o;
}
