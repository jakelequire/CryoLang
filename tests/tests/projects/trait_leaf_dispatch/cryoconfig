# trait_leaf_dispatch - two traits sharing a leaf, both implemented for one
# receiver, each reached through a bound naming ONE of them.
#
# A bound-directed call (`x.render()` under `where T: Omega::Render`) is
# stamped with the trait the bound names, and overload selection prefers
# that trait's method. Compared by leaf, `Alpha::Render::render` satisfies
# a stamp of `Omega::Render` and the first-registered impl answers for
# both bounds. Compared by identity - the canonical name a method's
# `origin_trait` and an impl head's `qualified_trait_name` carry - each
# bound reaches its own trait's body.
#
# The exit code is the assertion: Alpha renders 1, Omega renders 2, and
# main returns alpha * 10 + omega. A leaf comparison exits 11.

[project]
project_name = "trait_leaf_dispatch"
output_dir   = "build"
target_type  = "executable"
source_dir   = "src"
entry_point  = "src/main.cryo"

