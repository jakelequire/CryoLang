/// An allow whose reason is empty - or only spaces - says nothing, and is
/// refused where it is written.  The declaration it sits on is not refused a
/// second time.
namespace compiler::resolver::symbol_str;

type struct SymbolStr {
    id: u32;
}

![allow(lookup_by_spelling, reason = "   ")]
function find_leaf(name: SymbolStr) -> i32 {
    return name.id as i32;
}

function main() -> i32 {
    return find_leaf(SymbolStr { id: 3 });
}
