/// A bare identifier in an expression names a value, so one that names only a
/// type is refused where it is written: used as a value (E0201), called
/// (E0231), a generic parameter as a value (E0201), handed as an argument
/// (E0201).  `Point(1, 2)` passed the fast check and failed in code
/// generation; a class that declares a constructor is the one type callable
/// by its name.
namespace BareTypeAsValueRefused::Main;

type struct Point { x: i32; y: i32; }
type enum Color { Red; Green; }

function g(v: i32) -> i32 { return v; }

function f<T>() -> i32 {
    const t = T;
    return 0;
}

function main() -> i32 {
    const p = Point;
    const q: Point = Point(1, 2);
    const c: i32 = Color(5);
    return g(Point) + f::<i32>();
}
