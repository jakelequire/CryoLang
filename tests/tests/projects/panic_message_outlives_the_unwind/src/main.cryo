namespace PanicMessageOutlivesTheUnwind;

import std::core::intrinsics;
import std::core::panic_unwind::{ catch_unwind, PanicInfo };
import std::core::result::{ Result };
import std::collections::string::{ String };
import std::collections::str::{ Str };
import std::fmt;

// The message lives in a String this frame owns: the unwind's cleanup drops it
// before catch_unwind or the root report reads the panic.
function fail_with_owned_message() -> i32 {
    mut owned: String = String::from_str(Str::new("an owned message, dropped by the unwind before it is reported"));
    intrinsics::panic(owned.as_cstr() as string, intrinsics::location());
}

function main() -> int {
    const outcome: Result<i32, PanicInfo> = catch_unwind(fail_with_owned_message);
    match (outcome) {
        Result::Ok(_) => { fmt::println("no panic"); }
        Result::Err(info) => {
            fmt::print("caught: ");
            fmt::println(info.msg);
        }
    }
    fail_with_owned_message();
    fmt::println("after");
    return 0;
}
