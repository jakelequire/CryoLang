# panic_message_outlives_the_unwind - built and RUN end-to-end
# (outcome = "run").  A panic's message is read after the unwind has run the
# cleanups - by catch_unwind and by the root report - so a message the
# panicking frame owns must still read back whole once that frame's String
# has been dropped.

[project]
project_name = "panic_message_outlives_the_unwind"
output_dir   = "build"
target_type  = "executable"
source_dir   = "src"
entry_point  = "src/main.cryo"

