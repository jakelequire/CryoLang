/// The SECOND declaration of the leaf `Widget`.
///
/// Its only job is to make the leaf plural.  With one declaration the name is
/// unique program-wide and resolves through the single-candidate path, which
/// never consults the use site's imports - so the case under test does not
/// arise at all until a second declarer exists.
namespace PluralLeafGate::Omega;

type struct Widget<T> {
    v: T;

    unwrap(&this) -> T { return this.v; }
}
