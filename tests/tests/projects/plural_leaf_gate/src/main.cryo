/// Reaches all three modules so the build actually compiles them.  See the
/// cryoconfig header: discovery is import-driven, and an unreached Alpha or
/// Omega would leave the leaf singular and the gate asserting nothing.
namespace PluralLeafGate::Main;

import std::core::intrinsics;
import PluralLeafGate::Alpha;
import PluralLeafGate::Omega;
import PluralLeafGate::Orphan;

function main(argc: int, argv: string*) -> int {
    intrinsics::printf("plural_leaf_gate: expected to fail compilation.\n");
    return 0;
}
