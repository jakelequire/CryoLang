# plural_leaf_gate - a bare leaf that TWO modules declare, named by a module
# that imports neither, must be an error.
#
# spec §5.1: "The first segment resolves in scope. There is no substring
# matching, no suffix matching, and no dependence on what other modules happen
# to exist in the program." `Orphan` has no `import` at all, so nothing binds
# `Widget` there and both signatures must be rejected.
#
# This was the pinned-wrong half of `resolution_leaf_index`, where it bound to
# whichever declarer the FILESYSTEM enumerated first - measured with controls in
# docs/name-resolution.md §8.2y. That project keeps the two controls, which are
# about a module that DOES import a declarer and still pass; only the rejected
# case lives here.
#
# WHY main IMPORTS ALL THREE. Module discovery is import-driven, so a file
# nothing imports is never compiled. Alpha and Omega must both be reached or the
# leaf is not plural and the error under test cannot arise; Orphan must be
# reached or nothing writes the bare name. A build that discovered none of them
# would emit no diagnostic and this gate would assert nothing.
[project]
project_name = "plural_leaf_gate"
output_dir   = "build"
target_type  = "executable"
source_dir   = "src"
entry_point  = "src/main.cryo"

