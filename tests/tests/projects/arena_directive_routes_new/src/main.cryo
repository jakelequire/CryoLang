namespace ArenaDirectiveRoutesNew;

// `![arena(f)]` on a class routes `new` of it, and of every class deriving
// from it, through `f(size, align)`.  The allocator here hands out slices of
// one static block and counts its calls.

mut g_block: u8[4096] = [0; 4096];
mut g_used: u64 = 0;
mut g_calls: i32 = 0;

function bump(size: u64, align: u64) -> void* {
    g_calls = g_calls + 1;
    const mask: u64 = align - 1;
    g_used = (g_used + mask) & ~mask;
    const p: void* = (&g_block[g_used as i64]) as void*;
    g_used = g_used + size;
    return p;
}

![arena(bump)]
type class Node {
public:
    tag: i32;
    Node(t: i32) { this.tag = t; }
}

type class Leaf : Node {
public:
    value: i64;
    Leaf(v: i64) : Node(2) { this.value = v; }
}

type class Plain {
public:
    n: i32;
    Plain(n: i32) { this.n = n; }
}

function main() -> i32 {
    const a: Node* = new Node(1);
    if (g_calls != 1 || a.tag != 1) { return 1; }
    const b: Leaf* = new Leaf(40);
    if (g_calls != 2 || b.tag != 2 || b.value != 40) { return 2; }
    const c: Plain* = new Plain(5);
    if (g_calls != 2 || c.n != 5) { return 3; }
    const base: u64 = (&g_block[0]) as u64;
    const at: u64 = a as u64;
    if (at < base || at >= base + 4096) { return 4; }
    delete b;
    if (g_calls != 2) { return 5; }
    delete c;
    return 0;
}
