namespace PrivateFunctionFieldCallRefused::Hookmod;

function double_it(x: i32) -> i32 { return x * 2; }

public type struct Hook {
private:
    run: (i32) -> i32;
public:
    open_run: (i32) -> i32;
    static make() -> Hook { return Hook { run: double_it, open_run: double_it }; }
    /// The declaring module calls its own private field.
    fire_inside(&this, x: i32) -> i32 { return this.run(x); }
}
