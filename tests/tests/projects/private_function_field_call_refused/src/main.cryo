namespace PrivateFunctionFieldCallRefused::Main;

import PrivateFunctionFieldCallRefused::Hookmod;
import PrivateFunctionFieldCallRefused::Hookmod::{ Hook };

function main() -> i32 {
    const h: Hook = Hook::make();
    const a: i32 = h.fire_inside(3);
    const b: i32 = h.open_run(4);
    const c: i32 = h.run(5);
    return a + b + c;
}
