namespace Main;

// A `where` bound on a parameter's associated type (`C::Item: Put`) gives a
// value of that type the bound trait's methods in the generic body, and
// each copy calls the implementation for its own `Item`: a struct's own,
// and for a reference `Item` an implementation for every `mut &T`.

type trait Put {
    put(mut &this, value: i64) -> void;
}

type struct Cell {
    value: i64;
}

implement trait Put for struct Cell {
    put(mut &this, value: i64) -> void { this.value = value; }
}

implement<T> trait Put for mut &T where T: Put {
    put(mut &this, value: i64) -> void { (*this).put(value); }
}

type trait Source {
    type Item;
    take(mut &this) -> This::Item;
}

type struct ByValue {
    cell: Cell;
}

implement trait Source for struct ByValue {
    type Item = Cell;
    take(mut &this) -> Cell { return Cell { value: this.cell.value }; }
}

type struct ByReference {
    cell: Cell;
}

implement trait Source for struct ByReference {
    type Item = mut &Cell;
    take(mut &this) -> mut &Cell { return &this.cell; }
}

function store<C>(source: mut &C, value: i64) -> C::Item where C: Source, C::Item: Put {
    mut item = source.take();
    item.put(value);
    return item;
}

function main() -> i32 {
    mut by_value = ByValue { cell: Cell { value: 1 } };
    const taken: Cell = store(&by_value, 5);
    if (taken.value != 5) { return 1; }
    if (by_value.cell.value != 1) { return 2; }
    mut by_reference = ByReference { cell: Cell { value: 1 } };
    store(&by_reference, 7);
    if (by_reference.cell.value != 7) { return 3; }
    return 0;
}
