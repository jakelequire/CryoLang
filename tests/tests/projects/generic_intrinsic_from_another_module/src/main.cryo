/// A generic intrinsic declared in another module is called through its
/// module, as a non-generic one is, and `drop_in_place` releases a value
/// named by a pointer variable or by `&place` alike: a field released in
/// place runs its destructor once.  The exit code says which count was
/// wrong; 0 means both held.
namespace GenericIntrinsicFromAnotherModule::Main;

import GenericIntrinsicFromAnotherModule::Rel;
import std::core::drop::{ Drop };
import std::alloc::box::{ Box };
import std::ffi::libc;

mut g_drops: i32 = 0;

type struct Counted { v: i32; }
implement trait Drop for struct Counted {
    drop(mut &this) -> void { g_drops = g_drops + 1; }
}

type struct Holder { c: Counted; n: i32; }

function release<T>(p: T*) -> void {
    Rel::drop_in_place::<T>(p);
}

function main() -> int {
    const a: Counted* = Box::new(Counted { v: 1 }).into_raw();
    release::<Counted>(a);
    if (g_drops != 1) { return 1; }

    const h: Holder* = Box::new(Holder { c: Counted { v: 2 }, n: 3 }).into_raw();
    Rel::drop_in_place::<Counted>(&(*h).c);
    if (g_drops != 2) { return 2; }

    libc::printf("intrinsic-from-another-module ok\n");
    return 0;
}
