namespace EnumWith128BitPayload;
import std::fmt;

type enum Reading {
    Missing;
    Signed(i128);
    Unsigned(u128);
}

static_assert(sizeof(Reading) == 32, "a 128-bit payload sits at offset 16");

function wrap(value: u128) -> Option<u128> {
    return Option::Some(value);
}

function negated(value: i128) -> Reading {
    return Reading::Signed(0 - value);
}

function total(readings: &[Reading; 3]) -> i128 {
    mut sum: i128 = 0;
    for (mut i: i64 = 0; i < 3; i++) {
        match (readings[i]) {
            Reading::Signed(v)   => { sum = sum + v; }
            Reading::Unsigned(v) => { sum = sum + (v as i128); }
            Reading::Missing     => { }
        }
    }
    return sum;
}

function main() -> i32 {
    const top: u128 = u128::MAX;
    match (wrap(top)) {
        Option::Some(v) => { if (v != top) { return 1; } }
        Option::None    => { return 2; }
    }
    const readings: [Reading; 3] = [
        negated(170141183460469231731687303715884105727),
        Reading::Missing,
        Reading::Unsigned(170141183460469231731687303715884105727),
    ];
    if (total(&readings) != 0) { return 3; }
    const first: u64 = &readings[0] as u64;
    const second: u64 = &readings[1] as u64;
    fmt::println(f"element stride {second - first}");
    return 0;
}
