namespace ThreadJoinReturnsThePanic;

import std::core::intrinsics;
import std::core::result::{ Result };
import std::fmt;
import std::thread;

function main() -> int {
    const code: i32 = 7;
    const failing = thread::spawn(move () -> i32 {
        if (code == 7) { intrinsics::panic("the worker gave up", intrinsics::location()); }
        return code;
    });
    match (failing.join()) {
        Result::Ok(_) => { fmt::println("joined a result"); }
        Result::Err(info) => {
            fmt::print("joined a panic: ");
            fmt::println(info.msg);
        }
    }
    const working = thread::spawn(move () -> i32 { return code * 6; });
    match (working.join()) {
        Result::Ok(value) => { fmt::printf("joined %d\n", value); }
        Result::Err(_) => { fmt::println("joined a second panic"); }
    }
    fmt::println("main carries on");
    return 0;
}
