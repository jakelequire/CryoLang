/// An expression made only of integer literals, stored where an integer of a
/// written type is - a local's initializer, an assigned value, a function's
/// or a method's argument - is the value its arithmetic gives, computed
/// exactly: an intermediate the type does not hold changes nothing.
/// `(200 + 100) / 2` in a `u8` is 150, `(200 / 2)` and `((1 << 9) >> 3)` in
/// an `i8` are 100 and 64, `(300 - 100)` in a `u8` is 200, and
/// `-(100 + 28)` passed for an `i8` is -128.  A module's constant is the
/// control: its initializer was always folded exactly.
namespace LiteralOnlyValueFoldedExactly::Main;

import std::fmt;

const MODULE_HALF: u8 = ((200 + 100) / 2);

function take_u8(value: u8) -> u8 { return value; }

function take_i8(value: i8) -> i8 { return value; }

function main() -> i32 {
    const half: u8 = ((200 + 100) / 2);
    const quotient: i8 = (200 / 2);
    const shifted: i8 = ((1 << 9) >> 3);
    const difference: u8 = (300 - 100);
    mut assigned: u8 = 0;
    assigned = ((200 + 100) / 2);
    const argument: u8 = take_u8(((200 + 100) / 2));
    const negated: i8 = take_i8((-(100 + 28)));
    const base: i8 = 3;
    const through_method: i8 = base.wrapping_add((-(100 + 28)));
    fmt::println(f"{MODULE_HALF} {half} {quotient} {shifted} {difference} {assigned} {argument} {negated} {through_method}");
    return 0;
}
