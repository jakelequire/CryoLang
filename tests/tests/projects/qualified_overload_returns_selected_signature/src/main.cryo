namespace QualifiedOverloadReturnsSelectedSignature::Main;

import QualifiedOverloadReturnsSelectedSignature::Conv;

function main() -> i32 {
    const a: i32 = Conv::conv(5 as i32);
    if (a != 1) { return 1; }
    const b: i64 = Conv::conv(9 as i64);
    if (b != 7) { return 2; }
    const c: f64 = Conv::conv(2.5);
    if (c != 5.0) { return 3; }
    if (Conv::conv(5) != 1) { return 4; }
    return 0;
}
