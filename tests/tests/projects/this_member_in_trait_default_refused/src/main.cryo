/// `This::member` in a trait's own default body is typed by the trait's
/// declaration of the member, so a wrong use of its result is refused in
/// the default's body.  A member the trait does not declare is refused
/// where it is written, once, however many types implement the trait.
namespace ThisMemberInTraitDefaultRefused;

type trait Seven {
    static base() -> i64;
    static missing() -> i64 { return This::nonexistent(); }
    static mistyped() -> i64 {
        const s: string = This::base();
        return 0;
    }
}

type struct Item { n: i64; }

implement trait Seven for struct Item {
    static base() -> i64 { return 3; }
}

implement trait Seven for i64 {
    static base() -> i64 { return 5; }
}

function main() -> i32 {
    return 0;
}
