namespace StringPlusOwnAppend;

// `a + b` on two strings concatenates them through the standard library's
// `append`; a program's own `append` on `string`, taking something else,
// is another method and leaves `+` alone.

implement string {
    append(&this, n: i32) -> string {
        return "n";
    }
}

function main() -> i32 {
    const a: string = "x";
    const b: string = "y";
    const c: string = a + b;
    if (c.length() != 2) { return 1; }
    mut d: string = "p";
    d += "q";
    if (d.length() != 2) { return 2; }
    if (a.append(5).length() != 1) { return 3; }
    return 0;
}
