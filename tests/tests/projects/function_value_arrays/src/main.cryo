namespace FunctionValueArrays;

type Step = (i64) -> i64;

function inc(x: i64) -> i64 { return x + 1; }
function dbl(x: i64) -> i64 { return x * 2; }
function one(x: i32) -> i32 { return x + 1; }
function two(x: i32) -> i32 { return x * 2; }

type struct Holder<T> { v: T; }
implement<T> struct Holder<T> {
    get(&this) -> T { return this.v; }
    get_ptr(&this) -> T* { return &this.v; }
}

type struct Picker { k: i32; }
implement struct Picker {
    pick(&this) -> (i32) -> i32 { if (this.k == 1) { return one; } return two; }
}

function main() -> i32 {
    // An array of an alias of a function type, called through by index.
    const steps: Step[] = [inc, dbl, inc];
    mut acc: i64 = 1;
    for (mut i: u64 = 0; i < steps.length(); i++) { acc = steps[i](acc); }
    if (acc != 5) { return 1; }
    // A parenthesized function type as the element type.
    const fs: ((i32) -> i32)[] = [one, two];
    if (fs[0](3) != 4) { return 2; }
    if (fs[1](3) != 6) { return 3; }
    // Grown one element at a time.
    mut grown: ((i32) -> i32)[] = [];
    grown.push(two);
    grown.push(one);
    if (grown[0](grown[1](2)) != 6) { return 4; }
    // A pointer to a function value.
    const pf: ((i32) -> i32)* = &fs[1];
    const g: (i32) -> i32 = *pf;
    if (g(5) != 10) { return 5; }
    // A method returning a function, and a generic owner over a function type.
    const p: Picker = Picker { k: 1 };
    if (p.pick()(3) != 4) { return 6; }
    const h: Holder<Step> = Holder::<Step> { v: dbl };
    if (h.get()(4) != 8) { return 7; }
    const hp: Step* = h.get_ptr();
    if ((*hp)(5) != 10) { return 8; }
    // A parenthesized cast target followed by `*` is still multiplication.
    const n: i64 = 3;
    if (n as (i64) * 4 != 12) { return 9; }
    return 0;
}
