namespace TraitMethodThroughFieldInGenericBody::Main;

// `S` is not generic; its trait method `go<W>` is.  Each call below reaches
// an `S` through a field and passes the enclosing generic body's own type
// parameter on, so `go` is specialized once per instantiation of the body.
// `sizeof(W)` tells the specializations apart.
type trait Bb { go<W>(&this, w: W) -> i32; }
type trait Run { run<W>(&this, w: W) -> i32; }

type struct S { v: i32; }
implement trait Bb for S { go<W>(&this, w: W) -> i32 { return this.v + sizeof(W) as i32; } }

type struct T2 { s: S; }

// A trait implementation's generic method.
implement trait Run for T2 {
    run<W>(&this, w: W) -> i32 { return this.s.go(w); }
}

// An inherent generic method.
implement struct T2 {
    via_inherent<W>(&this, w: W) -> i32 { return this.s.go(w) * 100; }
}

// A generic free function.
function via_free<W>(t: &T2, w: W) -> i32 { return t.s.go(w); }

function main() -> i32 {
    const t: T2 = T2 { s: S { v: 10 } };
    const a: i64 = 3;
    const b: u8 = 4;
    if (t.run(a) != 18) { return 1; }            // W = i64
    if (t.run(b) != 11) { return 2; }            // W = u8
    if (t.via_inherent(a) != 1800) { return 3; }
    if (via_free(&t, b) != 11) { return 4; }
    if (via_free(&t, a) != 18) { return 5; }
    return 0;
}
