// One implementation of `Index` and `IndexMutable` covers every index type a
// bound on its own parameter admits: `I` is bound only by the trait's
// arguments, so `[]` asks whether the type implements the trait at all and
// each use binds `I` to the index it is given.  A generic body bounded by
// `Index<i64, i32>` or `IndexMutable<u8, i32>` reaches the copy of the method
// at that index type.
namespace IndexGenericOverIndexType::Main;

import std::ffi::libc;
import std::core::ops::{ Index, IndexMutable };

type trait Position {
    to_position(this) -> i64;
}

implement trait Position for i64 { to_position(this) -> i64 { return this; } }
implement trait Position for u8 { to_position(this) -> i64 { return this as i64; } }

type struct Cells<T> {
    a: T; b: T;
}

implement<T, I> trait Index<I, T> for struct Cells<T> where I: Position {
    index(&this, idx: I) -> const T* {
        if (idx.to_position() == 0) { return &this.a; }
        return &this.b;
    }
}

implement<T, I> trait IndexMutable<I, T> for struct Cells<T> where I: Position {
    index_mutable(mut &this, idx: I) -> T* {
        if (idx.to_position() == 0) { return &this.a; }
        return &this.b;
    }
}

function second<C>(c: &C) -> i32 where C: Index<i64, i32> {
    return c[1 as i64];
}

function set_second<C>(c: mut &C, v: i32) -> void where C: IndexMutable<u8, i32> {
    c[1 as u8] = v;
}

function main() -> int {
    mut c: Cells<i32> = Cells::<i32> { a: 3, b: 4 };
    c[0 as u8] = 10;
    if (c[1 as i64] != 4) { return 1; }
    if (second(&c) != 4) { return 2; }
    set_second(&c, 20);
    if (c[0 as i64] != 10 || c[1 as u8] != 20) { return 3; }
    libc::printf("index generic over index type ok\n");
    return 0;
}
