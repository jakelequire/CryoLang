import std::collections::string::{ String };
import std::future::{ PendingThenReady, block_on };

function step(n: i64) -> PendingThenReady<i64> { return PendingThenReady::<i64>::new(2, n); }

async function pair_plain(a: String, b: String) -> (String, String) {
    const pair: (String, String) = (b, a);
    await step(1);
    return pair;
}

async function pair_generic<T>(a: T, b: T) -> (T, T) {
    const pair: (T, T) = (b, a);
    await step(1);
    return pair;
}

async function listed(a: String, b: String) -> [String] {
    const all: [String] = [a, b];
    await step(1);
    return all;
}

async function carried_into_tuple(a: String) -> (String, i64) {
    const n: i64 = await step(3);
    const out: (String, i64) = (a, n);
    return out;
}

function main() -> i32 {
    const p: (String, String) = block_on(pair_plain(String::from("x"), String::from("yy")));
    if (p.0.length() != 2 || p.1.length() != 1) { return 1; }
    const g: (String, String) = block_on(pair_generic(String::from("x"), String::from("yy")));
    if (g.0.length() != 2 || g.1.length() != 1) { return 2; }
    const l: [String] = block_on(listed(String::from("x"), String::from("yy")));
    if (l.length() != 2 || l[1].length() != 2) { return 3; }
    const c: (String, i64) = block_on(carried_into_tuple(String::from("abc")));
    if (c.0.length() != 3 || c.1 != 3) { return 4; }
    return 0;
}
