namespace VisibilityInternalWithinPackage::Main;

import VisibilityInternalWithinPackage::Tally;
import Shelf::Stock;

function main() -> int {
    // Another module of this package reaches its internal items and members.
    const t: Tally::Counter = Tally::start();
    if (t.count + t.bump() + Tally::Counter::zero().count + Tally::STEP != 8) { return 1; }

    // The dependency's own modules reach its internal items: 3 + 9 + 50 + 50 + 0.
    if (Stock::audit() != 112) { return 2; }
    return 0;
}
