namespace VisibilityInternalWithinPackage::Tally;

internal const STEP: i32 = 2;

internal type struct Counter {
    internal count: i32;

    internal bump(&this) -> i32 { return this.count + STEP; }
    internal static zero() -> Counter { return Counter { count: 0 }; }
}

internal function start() -> Counter { return Counter { count: 2 }; }
