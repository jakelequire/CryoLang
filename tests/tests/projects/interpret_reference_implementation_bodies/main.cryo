// `*this` in a by-reference method names the receiver's value itself, in
// the interpreter as in a compiled program: in a method of `i64` it is the
// integer, and in a method an implementation for references gives `&T` it
// is the reference, whose referent's method is then called.  A bound met by
// a reference reaches the standard library's `Eq` and `Ord` for `&T`.
namespace InterpretReferenceImplementationBodies;

import std::fmt;
import std::core::cmp::{ Ordering };

type trait Describe { describe(&this) -> i64; }
implement trait Describe for i64 { describe(&this) -> i64 { return *this; } }
implement<T> trait Describe for &T where T: Describe {
    describe(&this) -> i64 { return 100 + (*this).describe(); }
}

function described<D>(value: D) -> i64 where D: Describe { return value.describe(); }

function smaller<T>(a: T, b: T) -> T where T: Ord {
    return match (a.compare(&b)) {
        Ordering::Greater => { b }
        _ => { a }
    };
}

function same<T>(a: T, b: T) -> boolean where T: Eq { return a.equals(&b); }

function main() -> i32 {
    const seven: i64 = 7;
    const by_value: i64 = described(seven);
    const by_reference: i64 = described(&seven);
    fmt::println(f"describe: {by_value} {by_reference}");
    const three: i64 = 3;
    const other_seven: i64 = 7;
    const least: &i64 = smaller(&seven, &three);
    const equal: boolean = same(&seven, &other_seven);
    fmt::println(f"references: {*least} {equal}");
    return 0;
}
