namespace Main;

type struct Wrap<T> {
    value: T;
    callback: () -> i64;
}

type trait Named {
    name_length(&this) -> i64;
}

implement<T> trait Named for struct Wrap<T> {
    name_length(&this) -> i64 { return 4; }
}

// The field is a function value, called as one in every copy of the body.
function through_field<U>(w: &Wrap<U>) -> i64 {
    return w.callback();
}

// The box has no `name_length`; its target does.
function through_deref<U>(b: &Box<Wrap<U>>) -> i64 {
    return b.name_length();
}

function seven() -> i64 {
    return 7;
}

function main() -> i32 {
    const w: Wrap<i32> = Wrap { value: 5, callback: seven };
    const b: Box<Wrap<i32>> = Box::new(Wrap { value: 6, callback: seven });
    if (through_field(&w) != 7) { return 1; }
    if (through_deref(&b) != 4) { return 2; }
    return 0;
}
