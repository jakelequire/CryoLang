namespace generic_owner_this_param;

// `This` in a generic owner's method is the owner over its own parameters,
// so a parameter typed `&This` takes `&Wrap<i32>` on a `Wrap<i32>`, as the
// same parameter written `&Wrap<T>` does.

type trait Same {
    same(&this, o: &This) -> boolean;
}

type struct Wrap<T> { v: T; }

implement<T> trait Same for struct Wrap<T> {
    same(&this, o: &This) -> boolean { return true; }
}

type struct Box<T> { v: T; }

implement<U> struct Box<U> {
    by_ref(&this, o: &This) -> i32 { return 1; }
    by_val(&this, o: This) -> i32 { return 2; }
    renew(&this, v: U) -> This { return Box::<U> { v: v }; }
}

type struct Inl<T> {
    v: T;
    by_ref(&this, o: &This) -> i32 { return 3; }
}

type struct Pair<K, V> { k: K; v: V; }

implement<K, V> struct Pair<K, V> {
    swap_with(&this, o: &This) -> V { return o.v; }
}

function same_in<A>(w: Wrap<A>) -> boolean {
    return w.same(&w);
}

function main() -> i32 {
    const w: Wrap<i32> = Wrap::<i32> { v: 5 };
    if (!w.same(&w)) { return 1; }
    const b: Box<i32> = Box::<i32> { v: 5 };
    if (b.by_ref(&b) != 1) { return 2; }
    if (b.by_val(b) != 2) { return 3; }
    if (b.renew(9).v != 9) { return 4; }
    const n: Inl<u8> = Inl::<u8> { v: 4 };
    if (n.by_ref(&n) != 3) { return 5; }
    const p: Pair<i32, i64> = Pair::<i32, i64> { k: 1, v: 7 };
    const q: Pair<i32, i64> = Pair::<i32, i64> { k: 2, v: 8 };
    if (p.swap_with(&q) != 8) { return 6; }
    if (!same_in::<i64>(Wrap::<i64> { v: 6 })) { return 7; }
    return 0;
}
