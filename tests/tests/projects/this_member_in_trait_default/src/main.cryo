namespace ThisMemberInTraitDefault;

// `This::member` in a trait's own default body names the trait's member,
// and each implementation's copy reads `This` as the implementing type:
// a struct, a primitive, a generic struct, and one that overrides a default.

type trait Seven {
    static base() -> i64;
    twice(&this) -> i64 { return This::base() * 2; }
    static build_default() -> i64 { return This::base() + 1; }
    static chained() -> i64 { return This::build_default() * 10; }
}

type struct Item { n: i64; }

implement trait Seven for struct Item {
    static base() -> i64 { return 3; }
}

implement trait Seven for i64 {
    static base() -> i64 { return 5; }
}

type struct Boxed<T> { v: T; }

implement<T> trait Seven for struct Boxed<T> where T: Seven {
    static base() -> i64 { return T::base() + 100; }
}

type struct Own { n: i64; }

implement trait Seven for struct Own {
    static base() -> i64 { return 7; }
    static build_default() -> i64 { return 1000; }
}

type trait Scale<X> {
    static unit() -> X;
    static pair() -> [X] { return [This::unit(), This::unit()]; }
}

implement trait Scale<i32> for struct Item {
    static unit() -> i32 { return 9; }
}

function main() -> i32 {
    const it: Item = Item { n: 1 };
    mut r: i64 = it.twice();                       // 6
    r = r + Item::build_default();                 // 4
    r = r + Item::chained();                       // 40
    const five: i64 = 0;
    r = r + five.twice();                          // 10
    r = r + i64::build_default();                  // 6
    const b: Boxed<Item> = Boxed::<Item> { v: it };
    r = r + b.twice();                             // 206
    r = r + Own::chained();                        // 10000
    const p: [i32] = Item::pair();
    r = r + (p[0] + p[1]) as i64;                  // 18
    return (r - 10280) as i32;
}
