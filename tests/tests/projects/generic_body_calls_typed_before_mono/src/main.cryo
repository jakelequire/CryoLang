namespace GenericBodyCallsTypedBeforeMono;

type struct Wrap<U> {
    v: U;
    unwrap_v(&this) -> U { return this.v; }
}

type struct Maker {
    k: i32;
    wrap<U>(&this, u: U) -> Wrap<U> { return Wrap::<U> { v: u }; }
}

// The explicit argument is the body's own parameter: `wrap::<F>` returns
// `Wrap<F>`, and `unwrap_v` is selected on it.
function via_explicit<F>(m: &Maker, f: F) -> F {
    return m.wrap::<F>(f).unwrap_v();
}

type struct Outer<T> {
    w: Wrap<T>;
    n: i32;

    // `w` is `Wrap<T>`, the field seen through `Outer<T>`.
    via_destructure(mut this) -> T {
        const { w, n }: Outer<T> = this;
        return w.unwrap_v();
    }
}

function main() -> i32 {
    const m: Maker = Maker { k: 0 };
    const a: i32 = via_explicit::<i32>(&m, 2);
    const b: i64 = via_explicit::<i64>(&m, 40 as i64);
    const o: Outer<i32> = Outer::<i32> { w: Wrap::<i32> { v: 3 }, n: 1 };
    const c: i32 = o.via_destructure();
    if (a == 2 && b == 40 && c == 3) { return 0; }
    return 1;
}
