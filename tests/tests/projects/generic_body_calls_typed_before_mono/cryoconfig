# generic_body_calls_typed_before_mono - two calls in generic bodies that
# the first type-check pass used to leave untyped: a call on the result of
# a method called with the body's own parameter as explicit argument
# (`m.wrap::<F>(f).unwrap_v()`), and a call on a binding destructured from
# a type that names the body's parameter (`const { w, n }: Outer<T> = this;`).
[project]
project_name = "generic_body_calls_typed_before_mono"
output_dir   = "build"
target_type  = "executable"
source_dir   = "src"
entry_point  = "src/main.cryo"
