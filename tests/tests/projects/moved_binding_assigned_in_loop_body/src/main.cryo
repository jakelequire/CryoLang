namespace Main;

// A binding moved before a loop and given a new value only inside its body
// holds a value after the loop on the paths that ran the body and none on
// the path that did not, so it is released by a flag: once whatever the
// number of iterations, and each value the body displaces is released when
// the next one is stored.  Every value made here is released exactly once:
// the one given away by its taker, each one the loop stores by the next
// store or by the end of the scope.

type struct Counted {
    drops: mut i64*;
    id: i64;
}

implement trait Drop for struct Counted {
    drop(mut &this) -> void { *this.drops = *this.drops + 1; }
}

function take(value: Counted) -> i64 { return value.id; }

function in_while(times: i64, drops: mut i64*) -> i64 {
    mut value: Counted = Counted { drops: drops, id: 1 };
    const id: i64 = take(value);
    mut i: i64 = 0;
    while (i < times) {
        value = Counted { drops: drops, id: 2 };
        i += 1;
    }
    return id;
}

function in_for(times: i64, drops: mut i64*) -> i64 {
    mut value: Counted = Counted { drops: drops, id: 1 };
    const id: i64 = take(value);
    for (mut i: i64 = 0; i < times; i++) {
        value = Counted { drops: drops, id: 3 };
    }
    return id;
}

function in_loop(times: i64, drops: mut i64*) -> i64 {
    mut value: Counted = Counted { drops: drops, id: 1 };
    const id: i64 = take(value);
    mut i: i64 = 0;
    loop {
        if (i >= times) { break; }
        value = Counted { drops: drops, id: 4 };
        i += 1;
    }
    return id;
}

function main() -> i32 {
    const runs: [i64; 3] = [0, 1, 3];
    for (mut r: i64 = 0; r < 3; r++) {
        const times: i64 = runs[r];
        mut drops: i64 = 0;
        in_while(times, &drops);
        if (drops != 1 + times) { return (10 + r) as i32; }
        drops = 0;
        in_for(times, &drops);
        if (drops != 1 + times) { return (20 + r) as i32; }
        drops = 0;
        in_loop(times, &drops);
        if (drops != 1 + times) { return (30 + r) as i32; }
    }
    return 0;
}
