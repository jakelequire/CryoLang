namespace StaticTraitMethodWithOwnParametersThroughParameter;

import std::core::iter::{ Iterator, FromIterator };
import std::core::ops::{ Range };
import std::collections::array::{ Array };

type trait Make {
    static make() -> This;
}

type trait MakeAny {
    static make_any<I>(x: I) -> This;
}

type trait FromAny<T> {
    static from_any<I>(x: I, t: T) -> This;
}

type struct Seven {
    value: i64;
}

implement trait Make for struct Seven {
    static make() -> Seven { return Seven { value: 7 }; }
}

implement trait MakeAny for struct Seven {
    static make_any<I>(x: I) -> Seven { return Seven { value: 9 }; }
}

implement trait FromAny<i64> for struct Seven {
    static from_any<I>(x: I, t: i64) -> Seven { return Seven { value: t }; }
}

function made<C>() -> C where C: Make {
    return C::make();
}

function made_from_any<C, I>(x: I) -> C where C: MakeAny {
    return C::make_any(x);
}

function made_through_generic_trait<C, I>(x: I) -> C where C: FromAny<i64> {
    return C::from_any(x, 5);
}

function collected<C, I>(source: I) -> C where C: FromIterator<i64>, I: Iterator<i64> {
    return C::from_iterator(source);
}

function main() -> i32 {
    const plain: Seven = made();
    if (plain.value != 7) { return 1; }
    const own: Seven = made_from_any(true);
    if (own.value != 9) { return 2; }
    const both: Seven = made_through_generic_trait(false);
    if (both.value != 5) { return 3; }
    const values: Array<i64> = collected(Range::<i64>::new(0, 3));
    if (values.length() != 3) { return 4; }
    if (values.get(2).unwrap() != 2) { return 5; }
    return 0;
}
