/// `Vault::latch()` names the private FUNCTION `latch`: a path in an
/// expression names a value, never the public type spelled the same way.
/// Taken as the type, the call's visibility would be the type's, and a
/// private function would be callable from here.
namespace VisibilityFunctionBesideType::Main;

import VisibilityFunctionBesideType::Vault;

function main() -> int {
    const n: i32 = VisibilityFunctionBesideType::Vault::latch();
    return n as int;
}
