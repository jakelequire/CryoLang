namespace BooleanAsInteger;

// `boolean as` an integer type is 1 for `true` and 0 for `false`, at every
// width.  A truth test on any other type is the comparison it means.

type enum Color { Red; Green; }

function count(flags: [boolean]) -> i64 {
    mut total: i64 = 0;
    for (mut i: i64 = 0; i < flags.length; i++) {
        total = total + (flags[i] as i64);
    }
    return total;
}

function main() -> i32 {
    if (true as i32 != 1) { return 1; }
    if (false as i32 != 0) { return 2; }
    if (true as u8 != 1) { return 3; }
    if (false as u64 != 0) { return 4; }
    if (count([true, false, true, true]) != 3) { return 5; }

    const n: i32 = 7;
    const zero: i32 = 0;
    const p: i32* = &n;
    const q: i32* = null;
    const c: Color = Color::Green;
    if (!(n != 0) || zero != 0) { return 6; }
    if (p == null || q != null) { return 7; }
    if (c == Color::Red) { return 8; }
    const flag: boolean = n > 5;
    if ((flag as i32) + ((zero != 0) as i32) != 1) { return 9; }
    return 0;
}
