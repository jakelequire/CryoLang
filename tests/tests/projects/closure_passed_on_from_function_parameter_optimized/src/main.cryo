namespace Main;
import std::fmt;

// The same program as closure_passed_on_from_function_parameter, built at O2.

type struct Offset { low: u8; high: i64; }

function apply(x: i64, f: (i64) -> i64) -> i64 { return f(x); }

function forward(x: i64, f: (i64) -> i64) -> i64 { return apply(x + 1, f); }

function forward_twice(x: i64, f: (i64) -> i64) -> i64 { return forward(x * 2, f) + apply(x, f); }

function swapped(f: (i64) -> i64, x: i64) -> i64 { return forward(x, f); }

function main() -> i32 {
    const step: i64 = 100;
    const offset: Offset = Offset { low: 7, high: 1000 };
    const plus = (n: i64) -> i64 { return n + step; };
    const shifted = (n: i64) -> i64 { return n + (offset.low as i64) + offset.high; };
    fmt::println(f"passed on: {forward(1, plus)} {forward_twice(3, plus)} {swapped(shifted, 5)} {forward(2, (n: i64) -> i64 { return n * step; })}");
    return 0;
}
