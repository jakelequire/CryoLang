namespace FixShowsMethodCall::Main;

// Each read below names a method of `Counter` where a value is wanted.
// `total` takes nothing but its read-only receiver, so `total()` is the
// fix; `scaled` takes an argument, `bump` writes its receiver and `make`
// has no receiver, so each gets the advice alone.

type struct Counter {
    count: i64;

    total(&this) -> i64 { return this.count; }

    scaled(&this, factor: i64) -> i64 { return this.count * factor; }

    bump(mut &this) -> i64 {
        this.count = this.count + 1;
        return this.count;
    }
}

function main() -> i32 {
    mut c: Counter = Counter { count: 2 };
    const a: i64 = c.total;
    const b: i64 = c.scaled;
    const d: i64 = c.bump;
    return (a + b + d) as i32;
}
