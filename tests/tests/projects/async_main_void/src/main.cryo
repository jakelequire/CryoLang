/// A `-> void` `async function main`. Its future's `Output` is unit, so the
/// synthesized entry point discards the driver's result and returns `0` — the
/// process still needs an exit status even though the async root produces no
/// value.
namespace AsyncMainVoid::Main;

import std::core::intrinsics;
import std::future;
import std::time;
import std::future::executor;
import std::future::poll;
import std::future::timer;
import std::future::waker;
import std::time::duration;

async function tick(ms: u64) -> void {
    await Sleep::new(Duration::from_millis(ms));
}

async function main() -> void {
    await tick(20u64);
    await tick(20u64);
    intrinsics::printf("void async main ran\n");
}
