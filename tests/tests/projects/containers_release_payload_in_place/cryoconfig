# containers_release_payload_in_place - built and RUN end-to-end (outcome = "run").
# The owning containers release what they hold in place, the way a value
# leaving scope is released: a `Drop` implementation, the glue alone for a
# payload with none, nothing for a `Copy` value such as a pointer.  A method
# merely named `drop` is not a destructor, in a container or at scope exit.

[project]
project_name = "containers_release_payload_in_place"
output_dir   = "build"
target_type  = "executable"
source_dir   = "src"
entry_point  = "src/main.cryo"

