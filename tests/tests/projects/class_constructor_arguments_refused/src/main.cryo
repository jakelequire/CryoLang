/// A construction's arguments are checked against the constructor of their
/// arity, written `new C(args)` or by value `C(args)`: a wrong type, a
/// count no constructor takes, and arguments to a type that declares no
/// constructor are each refused where they are written.
namespace ClassConstructorArgumentsRefused::Main;

type struct Wrap { n: i32; }

type struct Plain { n: i32; }

type class Holder {
public:
    w: Wrap;
    Holder(w: Wrap) { this.w = w; }
}

type class Two {
public:
    a: i32;
    Two(a: i32) { this.a = a; }
    Two(a: i32, b: i64) { this.a = a; }
}

function main() -> i32 {
    const a: Holder* = new Holder("not a Wrap");
    const b: Holder = Holder("not a Wrap");
    const c: Holder* = new Holder();
    const d: Holder* = new Holder(Wrap { n: 1 }, 5);
    const e: Plain* = new Plain(1);
    const f: Two* = new Two(1, 2, 3);
    return 0;
}
