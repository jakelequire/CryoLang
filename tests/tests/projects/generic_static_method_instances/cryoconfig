# generic_static_method_instances - one instance of a generic static method
# per (owner, method, the method's type arguments), reused when asked again.
#
# The method's signature does not mention its parameter, so a run that
# printed the wrong width would mean two calls shared one instance.

[project]
project_name = "generic_static_method_instances"
output_dir   = "build"
target_type  = "executable"
source_dir   = "src"
entry_point  = "src/main.cryo"

