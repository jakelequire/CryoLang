/// A generic static method on a generic owner has one instance per
/// (owner, method, the method's own type arguments).  `width<T>` does not
/// mention `T` in its signature, so only the type arguments tell its
/// instances apart: each call must run the instance at its own `T`, a
/// repeated call must reuse the instance made for the first, and the same
/// method on another owner is another instance.
namespace GenericStaticMethodInstances::Main;

import std::ffi::libc;

type struct Cell<A> {
    v: A;

    static width<T>(a: A) -> i64 { return sizeof(T) as i64; }
    static keep<T>(a: A, t: T) -> T { return t; }
}

function main() -> i32 {
    const a: i64 = Cell::<i64>::width::<u8>(1);    // 1
    const b: i64 = Cell::<i64>::width::<i32>(1);   // 4
    const c: i64 = Cell::<i64>::width::<u8>(2);    // 1: the first instance again
    const d: i64 = Cell::<i32>::width::<i64>(3);   // 8: another owner
    const e: i64 = Cell::<i32>::width::<i32>(3);   // 4
    const f: i64 = Cell::<i64>::keep::<i64>(1, 40);
    const g: i64 = Cell::<i64>::keep::<i64>(2, 2);
    libc::printf("widths %lld %lld %lld %lld %lld keep %lld\n", a, b, c, d, e, f + g);
    if (a != 1 || b != 4 || c != 1 || d != 8 || e != 4 || f + g != 42) { return 1; }
    return 0;
}
