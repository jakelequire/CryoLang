# vendor_raylib — the headline acceptance project for the vendor library
# system (.todo/VENDOR_PLAN.md §6.1): build and RUN a raylib window demo whose
# bindings AND native link flags come entirely from `cryo vendor`, with no
# hand-written bindings and no manual `[link]` entries here.
#
# IGNORED in the suite (test.json `ignore: true`) until the vendor feature is
# complete AND a raylib checkout has been registered on the machine — it needs
# libclang binding generation (Stage 2), an installed raylib, and a display to
# open a window.  See README.md for how to run it by hand today.
#
# Note the deliberately empty [link]: the raylib libraries (-lraylib, plus the
# per-OS GL/X11/winmm set) are injected automatically from the vendor registry
# entry's link metadata — that is the whole point of the test.

[project]
project_name = "vendor_raylib"
output_dir   = "build"
target_type  = "executable"
source_dir   = "src"
entry_point  = "src/main.cryo"

[compiler]

[dependencies]
