/// vendor_raylib - a first-window raylib demo driven entirely by vendored,
/// auto-generated bindings.
///
/// Everything under `RayLib::` (the `Color` struct and the `InitWindow` /
/// `BeginDrawing` / ... functions) comes from the `.cryo` bindings the binding
/// generator produced from raylib's headers - nothing in this project is
/// hand-written FFI, and the cryoconfig declares no link flags.  The single
/// `import vendor::RayLib` is the whole integration surface.
namespace VendorRaylib::Main;

import vendor::RayLib;

function main() -> int {
    RayLib::InitWindow(800, 450, "Cryo + raylib - vendored bindings");
    RayLib::SetTargetFPS(60);

    // raylib ships its palette as compound-literal `#define`s, e.g.
    //   #define RAYWHITE (Color){ 245, 245, 245, 255 }
    // which is a function-like / compound macro the generator reports and
    // drops (it has no faithful Cryo binding).  So build the colors directly
    // from the generated `RayLib::Color` struct instead of the dropped macros.
    const raywhite:  RayLib::Color = RayLib::Color { r: 245, g: 245, b: 245, a: 255 };
    const darkgray:  RayLib::Color = RayLib::Color { r: 80,  g: 80,  b: 80,  a: 255 };

    // Auto-terminate after ~120 frames (~2s) so this is a non-hanging automated
    // test: it opens a real window, draws, then exits 0 on its own.  (It still
    // honors an early close/ESC via WindowShouldClose.)
    mut frame: i32 = 0;
    while (!RayLib::WindowShouldClose() && frame < 120) {
        RayLib::BeginDrawing();
        RayLib::ClearBackground(raywhite);
        RayLib::DrawText("Congrats! You created your first Cryo window.",
                         150, 200, 20, darkgray);
        RayLib::EndDrawing();
        frame = frame + 1;
    }

    RayLib::CloseWindow();
    return 0;
}
