///! The `std::core` facade: one brace import names core's types and traits
///! from their own modules, `Ordering` from `cmp`, `Hash`, `Hasher` and
///! `SipHasher` from `hash`, `Error` and `ErrorReport` from `error`,
///! `Slice` from `slice`, `NonNull` from `pointer`, and `TryFrom` and
///! `ConversionError` from `convert`.

namespace CoreFacadeShortImport;

import std::core::{
    Ordering, Hash, Hasher, SipHasher, Error, ErrorReport, Slice, NonNull, TryFrom, ConversionError
};
import std::fmt::{ println };

/// A hash of `value` through the `Hash` bound the facade names.
function hash_of<T>(value: &T) -> u64 where T: Hash {
    mut hasher: SipHasher = SipHasher::with_keys_2_4(1, 2);
    value.hash(&hasher);
    return hasher.finish();
}

/// The report of any `Error`, through the bound the facade names.
function report_of<E>(error: &E) -> ErrorReport where E: Error {
    return ErrorReport::from_error(error);
}

/// The sum of a view's elements.
function total(view: &Slice<i32>) -> i32 {
    mut sum: i32 = 0;
    for (mut i: i64 = 0; i < view.length(); i++) { sum = sum + view[i]; }
    return sum;
}

function main() -> i32 {
    const one: i32 = 1;
    const two: i32 = 2;
    const order: Ordering = one.compare(&two);
    println(f"ordering less: {order == Ordering::Less}");
    println(f"hashes agree: {hash_of(&two) == hash_of(&two)}");
    const numbers: [i32] = [3, 4, 5];
    println(f"slice total: {total(numbers.as_slice())}");
    mut cell: i32 = 9;
    const pointer: NonNull<i32> = NonNull::new(&cell);
    println(f"through the pointer: {*pointer.as_pointer()}");
    // A path from the package root reaches a core module with no import.
    mut left: i32 = 1;
    mut right: i32 = 2;
    std::core::mem::swap(&left, &right);
    println(f"swapped: {left} {right}");
    const narrowed: Result<i32, ConversionError> = i32::try_from(5000000000);
    match (narrowed) {
        Result::Ok(_) => { println(f"narrowed"); }
        Result::Err(error) => { println(f"refused: {report_of(&error)}"); }
    }
    return 0;
}
