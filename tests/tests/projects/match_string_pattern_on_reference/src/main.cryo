/// A string pattern on a reference to a string: the pattern is compared with
/// the subject's own value, which is the reference.  Refused at the pattern;
/// `match (*s)` compares the string.
namespace MatchStringPatternOnReference::Main;

function is_yes(s: &string) -> i32 {
    return match (s) {
        // The pattern this project's refusal points at.
        "yes" => { 1 }
        _     => { 0 }
    };
}

function main() -> i32 {
    const s: string = "yes";
    return is_yes(&s);
}
