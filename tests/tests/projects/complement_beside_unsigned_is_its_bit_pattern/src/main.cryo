// A complement of a literal beside an unsigned operand is that operand's bit
// pattern, also where nothing around the operation expects an integer type:
// an interpolated value, a generic argument, an unannotated constant.  The
// help for a negative operand beside an unsigned one writes such a
// complement, and what it writes compiles.
import std::fmt;

namespace ComplementBesideUnsignedIsItsBitPattern::Main;

function keep<T>(value: T) -> T { return value; }

function main() -> i32 {
    const byte: u8 = keep(0xAB as u8);
    const half: u16 = keep(0xABCD as u16);
    const word: u32 = keep(0x12345678 as u32);
    const wide: u64 = keep(0x123456789ABCDEF0 as u64);
    const huge: u128 = keep(0x123456789ABCDEF0 as u128);
    const untyped = word & ~0xFF;
    fmt::println(f"{byte | ~0x0F} {half & ~0xFF} {word & ~0xFF} {wide & ~0xFF} {huge & ~0xFF}");
    fmt::println(f"{keep(word & ~0xFF)} {untyped} {keep(~0xF0 & byte)} {word | ~3} {word ^ ~0}");
    return 0;
}
