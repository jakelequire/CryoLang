/// Inside the body that declares it, a type parameter has only the methods
/// its bounds give it.  A method call on one that no bound in scope names -
/// the function's `where`, the impl's, or the type declaration's - names
/// nothing and is refused where it is written, even when nothing
/// instantiates the body.  `x.drop()` on one is refused as well, beside
/// `std::core::ptr::drop_in_place` (`drop_on_unbounded_param_refused`).
namespace UnboundedParamMethodRefused::Main;

type trait Counter {
    count(&this) -> u64;
}

type struct Unbounded<W> {
    w: W;

    total(&this) -> u64 {
        this.w.count();
        return 0;
    }
}

type struct OnType<W> where W: Counter {
    w: W;

    total(&this) -> u64 {
        return this.w.count();
    }
}

function on_function<T>(x: &T) -> u64 where T: Counter {
    return x.count();
}

function free_unbounded<T>(x: &T) -> u64 {
    x.count();
    return 0;
}

function main() -> i32 {
    return 0;
}
