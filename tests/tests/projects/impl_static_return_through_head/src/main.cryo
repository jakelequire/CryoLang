/// An implement block's parameters are its own: `U` below relates to `Wrap`'s
/// `T` only through the head `Wrap<U>`.  A static method's return written in
/// `U`, called through the owner with a turbofish, is `Wrap<Num>` - the
/// owner's argument reaches `U` through the head, not by `U` being spelled
/// like `T`.
namespace ImplStaticReturnThroughHead::Main;

type trait Make {
    static make() -> This;
}

type struct Num {
    v: i32;
}

implement trait Make for struct Num {
    static make() -> Num { return Num { v: 42 }; }
}

type struct Wrap<T> {
    inner: T;
}

implement<U> trait Make for struct Wrap<U> where U: Make {
    static make() -> Wrap<U> { return Wrap::<U> { inner: U::make() }; }
}

function main() -> int {
    const w: Wrap<Num> = Wrap::<Num>::make();
    return w.inner.v;
}
