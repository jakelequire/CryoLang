/// A struct value cast to a pointer, and a type's constant read through a
/// value: each fix is shown as the edited line.
namespace FixShowsAddressAndConstantPath;

type struct Point {
    x: i32;
    y: i32;
    const ORIGIN_X: i32 = 0;
}

function main() -> int {
    const p: Point = Point { x: 1, y: 2 };
    const q: i64* = p as i64*;
    const o: i32 = p.ORIGIN_X;
    return 0;
}
