# dependency_repository_identity - one repository is one library however
# its URL is spelled: the scheme, a user, a trailing `/` and `.git` dropped,
# the host in lower case, and the short `user@host:path` form written as
# `host/path`; a `file://` repository is its path as written.  And the
# series a version or a requirement belongs to, which a build holds one of
# per library: the major, or below 1.0.0 the minor too.  Asked of the
# resolver's own functions for each case.
[project]
project_name = "dependency_repository_identity"
output_dir   = "build"
target_type  = "executable"
source_dir   = "src"
entry_point  = "src/main.cryo"

[compiler]

[dependencies]
compiler = { path = "../../../../compiler" }
