/// A bound written on a type's own declaration constrains the type's
/// parameter in every method the type declares, so a call on a value of that
/// parameter is typed by the bound's trait.  A wrong use of such a call's
/// result is refused in the method's body even when nothing instantiates the
/// type.
namespace TypeDeclBoundTypesCalls::Main;

type trait Sized2 {
    size(&this) -> u64;
}

type struct Holder<T> where T: Sized2 {
    item: T;

    doubled(&this) -> u64 {
        const n: u64 = this.item.size();
        return n * 2;
    }

    as_text(&this) -> u64 {
        const s: string = this.item.size();
        return 0;
    }
}

function main() -> i32 {
    return 0;
}
