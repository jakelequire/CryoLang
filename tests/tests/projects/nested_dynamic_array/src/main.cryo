/// An array of arrays: rows pushed, read back, indexed through both levels
/// and grown in place.  `Array<T>`'s own body indexes its storage as
/// `this.ptr[i]` with `T` itself an array, which is pointer arithmetic over
/// the rows, never an index into the first row.
namespace NestedDynamicArray::Main;

import std::fmt;

function build() -> [[i32]] {
    mut nested: [[i32]] = [];
    for (mut r: i32 = 0; r < 3; r++) {
        mut row: [i32] = [];
        for (mut c: i32 = 0; c <= r; c++) { row.push(r * 10 + c); }
        nested.push(row);
    }
    return nested;
}

function main() -> i32 {
    mut nested: [[i32]] = build();
    nested[1].push(19);
    mut total: i32 = 0;
    for (mut r: i64 = 0; r < nested.length(); r++) {
        for (mut c: i64 = 0; c < nested[r].length(); c++) { total += nested[r][c]; }
    }
    fmt::println(f"rows {nested.length()} widths {nested[0].length()} {nested[1].length()} {nested[2].length()}");
    fmt::println(f"corner {nested[2][2]} pushed {nested[1][2]} total {total}");
    return 0;
}
