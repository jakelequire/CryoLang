namespace ConstantFoldFull64BitRange;

const ALL_ONES: u64 = 0xFFFF_FFFF_FFFF_FFFF;
const HIGH_BIT: u64 = 0x8000_0000_0000_0000;
const LOWEST_I64: i64 = -9223372036854775807 - 1;
const HIGHEST_I128: i128 = 170141183460469231731687303715884105727;

// Globals whose initializers the folder computes: `>>`, `/` and `%` over a
// value above `i64::MAX`, and a cast that wraps.
const TOP_NIBBLE: u64 = ALL_ONES >> 60;
const HALF: u64 = ALL_ONES / 2;
const REMAINDER: u64 = ALL_ONES % 10;
const WRAPPED: u64 = (0 - 1) as u64;

implement u64 {
    const ALL_SET: u64 = 0xFFFF_FFFF_FFFF_FFFF;
}

type struct Register {
    const MASK = 0xFFFF_FFFF_FFFF_FFFF;
    const LANES = 4;
    value: u64;
}

static_assert(ALL_ONES == 18446744073709551615, "a u64 constant above i64::MAX folds");
static_assert(u64::ALL_SET == ALL_ONES, "a primitive's constant above i64::MAX folds");
static_assert(Register::MASK == ALL_ONES, "an unannotated type constant above i64::MAX folds");
static_assert(HIGH_BIT - 1 == 9223372036854775807, "arithmetic across i64::MAX folds");
static_assert(ALL_ONES >> 60 == 15, "a shift of a u64 constant folds");
static_assert(LOWEST_I64 < 0 && LOWEST_I64 - 1 < LOWEST_I64, "i64::MIN and below fold");
static_assert(HIGHEST_I128 > ALL_ONES, "an i128 constant folds");
static_assert(((0 - 1) as u64) == ALL_ONES, "a cast to u64 wraps");
static_assert((ALL_ONES as i64) == -1, "a cast to i64 wraps");
static_assert((ALL_ONES as u32) == 4294967295, "a cast to u32 wraps");

type struct Buffers {
    nibble: [u8; ALL_ONES >> 60];
    lanes: [u64; Register::LANES];
}

function main() -> i32 {
    if (TOP_NIBBLE != 15) { return 1; }
    if (HALF != 9223372036854775807) { return 2; }
    if (REMAINDER != 5) { return 3; }
    if (WRAPPED != ALL_ONES) { return 4; }
    const nibble: [u8; u64::ALL_SET / 0x1000_0000_0000_0000] = [7; ALL_ONES >> 60];
    if (nibble.length != 15 || nibble[14] != 7) { return 5; }
    const buffers: Buffers = Buffers { nibble: nibble, lanes: [Register::MASK; Register::LANES] };
    if (buffers.lanes[3] != ALL_ONES) { return 6; }
    if (Register::MASK != u64::ALL_SET) { return 7; }
    return 0;
}
