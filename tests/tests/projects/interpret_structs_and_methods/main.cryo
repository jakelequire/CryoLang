// `cryo interpret` runs structs, their methods and generic instances by the
// language reference: a struct literal's fields are evaluated in the order
// written, whatever order the struct declares them in; a `mut &this` method
// writes the receiver where it lies; a generic function runs as the
// monomorphiser instantiated it.

namespace Main;

import std::fmt;

mut trace: u64 = 0;

function note(digit: u64) -> u64 {
    trace = trace * 10 + digit;
    return digit;
}

type struct Pair {
    first: u64;
    second: u64;
    third: u32 = 7;

    static new(first: u64, second: u64) -> Pair {
        return Pair { second: second, first: first };
    }

    sum(&this) -> u64 {
        return this.first + this.second + (this.third as u64);
    }

    bump(mut &this, by: u64) -> void {
        this.first = this.first + by;
    }
}

type struct Holder<T> {
    value: T;

    get(&this) -> T where T: Copy {
        return this.value;
    }
}

function larger<T>(a: T, b: T) -> T where T: Ord + Copy {
    if (a > b) { return a; }
    return b;
}

function main() -> i32 {
    const written: Pair = Pair { second: note(2), first: note(1) };
    mut pair: Pair = Pair::new(10, 20);
    pair.bump(5);
    const holder: Holder<u16> = Holder::<u16> { value: 513 };
    fmt::println(f"structs: {trace} {written.first} {written.second} {pair.sum()} {holder.get()} {larger::<i32>(-3, 4)} {larger::<u8>(200, 100)}");
    return 0;
}
