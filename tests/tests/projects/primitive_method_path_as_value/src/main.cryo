namespace PrimitiveMethodPathAsValue;

import std::core::cmp::{ Ordering };

type enum Level {
    Low;
    High;
}

implement enum Level {
    weight(&this) -> i32 {
        return match (this) {
            Level::Low  => { 1 }
            Level::High => { 10 }
        };
    }
}

function main() -> i32 {
    // A primitive's method by path is a value taking the receiver first.
    mut values: [i64] = [3, 1, 2];
    values.sort_by(i64::compare);
    if (values[0] != 1 || values[1] != 2 || values[2] != 3) { return 1; }

    const order: (&i64, &i64) -> Ordering = i64::compare;
    const low: i64 = 4;
    const high: i64 = 9;
    match (order(&low, &high)) {
        Ordering::Less => { }
        _              => { return 2; }
    }

    // So is an enum's.
    const weigh: (&Level) -> i32 = Level::weight;
    const level: Level = Level::High;
    if (weigh(&level) != 10) { return 3; }
    return 0;
}
