/// A bound gives its subject the methods of the trait it names and of every
/// supertrait of that trait, however deep: `T: Top` reaches `Mid::mid` and
/// `Base::base`, and a default body in `Mid` reaches `Base::base` on `this`.
/// The standard library's `Step : Ord` and `Ord : Eq` are the same shape;
/// `Range`'s iterator compares its bounds through `Step`.  A supertrait is
/// written as a bound writes a trait, so a qualified path names one too.
namespace SupertraitMethodsThroughBound::Main;

import std::core::cmp;
import std::core::cmp::{ Ord, Eq, Ordering };
import std::core::ops::{ Step };

type trait Ranked : cmp::Ord {
    rank(&this) -> i32;
}

implement trait Ranked for i32 { rank(&this) -> i32 { return 7; } }

function rank_if_less<T>(a: &T, b: &T) -> i32 where T: Ranked {
    if (a.compare(b) == Ordering::Less) { return a.rank(); }
    return 0;
}

type trait Base {
    base(&this) -> i32;
}

type trait Mid : Base {
    mid(&this) -> i32 { return this.base() + 10; }
}

type trait Top : Mid {
    top(&this) -> i32;
}

type struct P { v: i32; }

implement trait Base for P { base(&this) -> i32 { return this.v; } }
implement trait Mid for P { }
implement trait Top for P { top(&this) -> i32 { return 100; } }

function through_top<T>(x: &T) -> i32 where T: Top {
    return x.top() + x.mid() + x.base();
}

function strictly_less<T>(a: &T, b: &T) -> boolean where T: Step {
    return a.compare(b) == Ordering::Less && !a.equals(b);
}

function main() -> i32 {
    const p: P = P { v: 1 };
    if (through_top(&p) != 112) { return 1; }
    const x: i32 = 1;
    const y: i32 = 2;
    if (!strictly_less(&x, &y)) { return 2; }
    if (strictly_less(&y, &x)) { return 3; }
    mut sum: i32 = 0;
    for (i in 0..4) { sum = sum + i; }
    if (sum != 6) { return 4; }
    if (rank_if_less(&x, &y) != 7) { return 5; }
    if (rank_if_less(&y, &x) != 0) { return 6; }
    return 0;
}
