namespace UnknownDirectiveWithoutArgumentsFix::Main;

// A misspelled directive written without arguments, whose nearest built-in
// takes none and may stand where it is written, is offered the rename as a
// machine-applicable fix.

![noinlin]
function helper() -> i32 { return 7; }

function main() -> i32 {
    if (helper() != 7) { return 1; }
    return 0;
}
