namespace OverloadedGenericStaticCall;

// Each overload returns a value that tells it apart from its sibling, so a
// call bound to the wrong overload fails the check rather than passing.
type struct Plain { n: i32; }
implement struct Plain {
    static conv<U>(u: U) -> U { return u; }
    static conv<U>(u: U, w: U) -> U { return w; }
}

type struct Mixed { n: i32; }
implement struct Mixed {
    static conv<U>(u: U) -> U { return u; }
    static conv(u: i32, w: i32) -> i32 { return w + 100; }
}

type struct Ptr { n: i32; }
implement struct Ptr {
    static at<U>(u: U) -> i32 { return 1; }
    static at<U>(u: U, w: U*) -> i32 { return 2; }
}

function twice<T>(x: T, y: T) -> T {
    return Plain::conv(Plain::conv(x), y);
}

function main() -> i32 {
    // Two generic overloads: the arguments' count chooses.
    if (Plain::conv(7) != 7) { return 1; }
    if (Plain::conv(7, 9) != 9) { return 2; }
    // A generic overload beside a non-generic one: each call fits one.
    if (Mixed::conv(5) != 5) { return 3; }
    if (Mixed::conv(7, 8) != 108) { return 4; }
    // A literal adopts the type another argument binds.
    const b: u8 = 200 as u8;
    if (Plain::conv(b, 3) != 3 as u8) { return 5; }
    // The turbofish binds the chosen overload's parameter.
    if (Plain::conv::<i64>(1, 2) != 2 as i64) { return 6; }
    const s: string = Plain::conv("a", "bc");
    if (s.length() != 2) { return 7; }
    // A parameter's shape decides when the counts agree with only one.
    mut x: i32 = 4;
    if (Ptr::at(x, &x) != 2) { return 8; }
    if (Ptr::at(x) != 1) { return 9; }
    // Inside a generic body.
    if (twice(1, 2) != 2) { return 10; }
    return 0;
}
