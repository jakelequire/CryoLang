/// A closure written without `move` borrows what it captures from the
/// function that made it, which may return while a spawned thread still
/// runs, so `thread::spawn` refuses it as not `Send`; the fix writes `move`.
namespace ThreadSpawnBorrowingClosureFix;

import std::thread;
import std::collections::string::{ String };

function main() -> int {
    const s: String = String::from("abc");
    const h: thread::JoinHandle<i64> = thread::spawn(() -> i64 { return s.length() as i64; });
    return h.join() as int;
}
