# dependency_git_rev_with_requirement - a git dependency on a commit is that
# commit, here the fixture's first, 0.1.0, though the branch has moved on to
# 0.1.1; its version meets the requirement "=0.1.0".  The runner builds the
# fixture with a fixed author, committer and date, so the commit id below is
# the same on every host.
[project]
project_name = "dependency_git_rev_with_requirement"
output_dir   = "build"
target_type  = "executable"
source_dir   = "src"
entry_point  = "src/main.cryo"

[compiler]

[dependencies]
greeter = { git = "{fixture:greeter}", rev = "3d231b2999766f67d0159801d0a9f63aef92d679", version = "=0.1.0" }
