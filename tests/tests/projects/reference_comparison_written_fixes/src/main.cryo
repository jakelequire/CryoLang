/// Every fix the refused reference comparisons show, compiled and run: the
/// values compared through `*`, a float ordered by `total_compare`, the
/// addresses compared with the reference converted to a pointer, and the
/// value a reference refers to compared with a function. Beside them, what
/// stays allowed: two references by the referent's `Eq` or `Ord`, by
/// identity where it has no `Eq`, and a reference with `null`. The larger
/// float sits at the lower address, so an order of addresses would print
/// the opposite of an order of values.
namespace ReferenceComparisonWrittenFixes::Main;

import std::fmt;

type struct Point { x: i64; y: i64; }

implement trait Eq for Point {
    equals(&this, other: &Point) -> boolean { return this.x == other.x && this.y == other.y; }
}

type struct Plain { value: i64; }

function nothing() -> void { }

function main() -> i32 {
    const point: Point = Point { x: 1, y: 2 };
    const same_point: Point = Point { x: 1, y: 2 };
    const at_point: &Point = &point;
    const to_point: Point* = &point as Point*;
    const plain: Plain = Plain { value: 1 };
    const other_plain: Plain = Plain { value: 1 };
    const at_plain: &Plain = &plain;
    const untyped: void* = &plain as void*;
    const floats: [f64; 2] = [2.5, 1.5];
    const larger: &f64 = &floats[0];
    const smaller: &f64 = &floats[1];
    const low: f64 = 1.5;
    const high: f64 = 2.5;
    const counts: [i64; 2] = [9, 1];
    const nine: &i64 = &counts[0];
    const one: &i64 = &counts[1];
    const flag: boolean = false;
    const set: &boolean = &flag;
    const pair: [i64; 2] = [1, 2];
    const both: &[i64; 2] = &pair;
    const action: () -> void = nothing;
    const at_action: &(() -> void) = &action;
    fmt::println(f"values: {*at_point == *to_point} {*to_point != *at_point}");
    fmt::println(f"addresses: {(at_point as Point*) == to_point} {(at_plain as void*) == untyped} {to_point == (&same_point as Point*)}");
    fmt::println(f"floats: {*larger < *smaller} {larger.total_compare(smaller).is_less()} {larger.total_compare(smaller).is_greater_or_equal()}");
    fmt::println(f"borrowed floats: {low > high} {(&low).total_compare(&high).is_greater()} {(&high).total_compare(&low).is_greater()}");
    fmt::println(f"boolean: {*set <= *set}");
    fmt::println(f"array addresses: {(both as [i64; 2]*) > (both as [i64; 2]*)}");
    fmt::println(f"function: {*at_action == action}");
    fmt::println(f"by Ord: {nine < one} {nine > one} by Eq: {at_point == &same_point}");
    fmt::println(f"by identity: {at_plain == at_plain} {at_plain == &other_plain}");
    fmt::println(f"null: {at_point == null} {null != at_plain}");
    return 0;
}
