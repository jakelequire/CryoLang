namespace InherentTraitMethodExplicit::Main;

type trait Beta {
    go(&this, u: i32) -> i64;
}

// Each receiver has an inherent `go` returning 0 and a `Beta::go` returning
// a distinct power of ten: a bare `x.go(7)` on any of them is ambiguous.
type struct NnTf { v: i32; }
implement trait Beta for NnTf { go(&this, u: i32) -> i64 { return 1; } }
implement struct NnTf { go(&this, u: i32) -> i64 { return 0; } }

type struct GnIf<T> { v: T; }
implement<T> struct GnIf<T> { go(&this, u: i32) -> i64 { return 0; } }
implement<T> trait Beta for GnIf<T> { go(&this, u: i32) -> i64 { return 10; } }

type struct IgTn { v: i32; }
implement trait Beta for IgTn { go(&this, u: i32) -> i64 { return 100; } }
implement struct IgTn { go<U>(&this, u: U) -> i64 { return 0; } }

type struct GIgTn<T> { v: T; }
implement<T> trait Beta for GIgTn<T> { go(&this, u: i32) -> i64 { return 1000; } }
implement<T> struct GIgTn<T> { go<U>(&this, u: U) -> i64 { return 0; } }

/// A call through the bound names `Beta::go` for any `T`.
function via_bound<T>(x: &T) -> i64 where T: Beta {
    return x.go(0);
}

function main() -> i32 {
    const a: NnTf = NnTf { v: 5 };
    const d: GnIf<i32> = GnIf::<i32> { v: 5 };
    const ig: IgTn = IgTn { v: 5 };
    const gig: GIgTn<i32> = GIgTn::<i32> { v: 5 };
    // The impl-qualified path names the trait's method: 1111.
    const direct: i64 = (Beta for NnTf)::go(&a, 7) + (Beta for GnIf<i32>)::go(&d, 7)
        + (Beta for IgTn)::go(&ig, 7) + (Beta for GIgTn<i32>)::go(&gig, 7);
    // So does a call through the bound: 1111 again.
    const bound: i64 = via_bound::<NnTf>(&a) + via_bound::<GnIf<i32>>(&d)
        + via_bound::<IgTn>(&ig) + via_bound::<GIgTn<i32>>(&gig);
    if (direct != 1111) { return 1; }
    if (bound != 1111) { return 2; }
    return 0;
}
