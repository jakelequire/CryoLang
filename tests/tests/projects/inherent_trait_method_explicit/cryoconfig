# inherent_trait_method_explicit - where an inherent method and a trait
# impl's method of one name both accept a call (a bare `x.go(7)` is E0156,
# see `inherent_trait_method_ambiguous`), the impl-qualified path
# `(Trait for Owner)::member(args)` names the trait's method, and so does a
# call through a bound on a type parameter.  Every receiver's inherent `go`
# returns 0 and its `Beta::go` a distinct power of ten, so each sum says
# which body ran: exit 1 when a qualified call reached an inherent body,
# exit 2 when a bound call did.
[project]
project_name = "inherent_trait_method_explicit"
output_dir   = "build"
target_type  = "executable"
source_dir   = "src"
entry_point  = "src/main.cryo"
[compiler]
[dependencies]
