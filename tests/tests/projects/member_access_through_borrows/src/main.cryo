namespace MemberAccessThroughBorrows::Main;

type struct Foo {
    x: i32;

    get(&this) -> i32 { return this.x; }
    bump(mut &this) -> void { this.x += 1; }
}

type struct Holder {
    inner: Foo*;
}

function read_two_borrows(r: &(&Foo)) -> i32 { return r.x; }
function call_two_borrows(r: &(&Foo)) -> i32 { return r.get(); }
function read_three_borrows(r: &(&(&Foo))) -> i32 { return r.x + r.get(); }
function read_borrowed_pointer(r: &(Foo*)) -> i32 { return r.x; }
function call_borrowed_pointer(r: &(Foo*)) -> i32 { return r.get(); }
function write_borrowed_pointer(r: &(Foo*)) -> void { r.x = 40; r.bump(); }
function read_pointer_to_borrow(p: (&Foo)*) -> i32 { return p.x + p.get(); }
function read_pointer_field(h: &Holder) -> i32 { return h.inner.x; }
function read_dereferenced(p: Foo**) -> i32 { return (*p).x + (*p).get(); }

function main() -> i32 {
    mut f: Foo = Foo { x: 7 };
    mut p: Foo* = &f;
    mut r: &Foo = &f;
    const rr: &(&Foo) = &r;

    if (read_two_borrows(&r) != 7) { return 1; }
    if (call_two_borrows(&r) != 7) { return 2; }
    if (read_three_borrows(&rr) != 14) { return 3; }
    if (read_borrowed_pointer(&p) != 7) { return 4; }
    if (call_borrowed_pointer(&p) != 7) { return 5; }
    if (read_pointer_to_borrow(&r) != 14) { return 6; }
    if (read_dereferenced(&p) != 14) { return 7; }

    // A write and a `mut &this` call through `&(Foo*)` reach `f` itself.
    write_borrowed_pointer(&p);
    if (f.x != 41) { return 8; }
    const h: Holder = Holder { inner: &f };
    if (read_pointer_field(&h) != 41) { return 9; }
    return 0;
}
