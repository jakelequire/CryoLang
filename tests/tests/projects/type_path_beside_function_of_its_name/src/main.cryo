/// A path's scope segment is asked in the type namespace, so a type and a
/// function of one name declared in one module leave `Limits::make()` and
/// `Limits::LARGEST` naming the type's members even with the function
/// declared first.  The function stays reachable by a plain call.
namespace TypePathBesideFunctionOfItsName::Main;

import std::fmt;

function Limits() -> i32 {
    return 9;
}

type struct Limits {
    top: i32;

    const LARGEST: i32 = 40;

    static make() -> Limits { return Limits { top: 3 }; }
}

function main() -> i32 {
    const made: Limits = Limits::make();
    fmt::println(f"{made.top} {Limits::LARGEST} {Limits()}");
    return 0;
}
