/// `sizeof` of a type declared nowhere.  A struct sits beside it so a first-
/// token lookup has something to find - `Foo` is real, `Nope` is not - and
/// the exit code is the size, so a silent 0 is an exit of 0.
namespace SizeofUndeclaredType::Main;

type struct Foo { a: i64; b: i64; }

function main() -> int {
    const s: u64 = sizeof(Nope);
    return s as int;
}
