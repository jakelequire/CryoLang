# sizeof_undeclared_type - `sizeof` of a type that exists nowhere must be
# REFUSED.  The operand is an annotation in EXPRESSION position, and no pass
# refuses one of those: the name layer declines it silently, type resolution's
# undefined-type check walks declarations and a few statement shapes but not a
# `sizeof`, and sema, which decides the operand's type, has no diagnostic for a
# failed resolution.  Before codegen refused an undecided operand this program
# COMPILED and exited 0: `sizeof(Nope)` was emitted as the constant 0.
#
# A project rather than a negative file because the refusal is codegen's and
# the negative suite runs `cryo check`, which stops before codegen.
#
# E0900 is the refusal codegen owes an operand nothing decided.  It is the
# wrong code for a user's typo, and this project pins the REFUSAL, not the
# code: when a diagnostic for an unknown type in expression position is
# decided, `test.json` moves to it, and the reason is that decision.

[project]
project_name = "sizeof_undeclared_type"
output_dir   = "build"
target_type  = "executable"
source_dir   = "src"
entry_point  = "src/main.cryo"

