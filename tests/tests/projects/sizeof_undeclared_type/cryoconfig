# sizeof_undeclared_type - `sizeof` of a type that exists nowhere is E0203 at
# the operand, the same diagnostic an unknown type gets in a declaration.
#
# The operand is an annotation in EXPRESSION position, resolved by sema in
# the body's context.  A failed resolution there is reported through the
# declaration sites' reporter when the failure is a name the name layer
# could not place (docs/cryo.md 12.2: "a name that exists nowhere is an error
# in every position"); the same holds for a cast target and a type argument, which
# `E0203_cast_to_undeclared_type` and `E0203_type_argument_undeclared` pin.
# Before this, no pass refused the operand: the program COMPILED and exited
# 0 with `sizeof(Nope)` emitted as the constant 0, and later codegen refused
# the undecided operand as E0900 - the wrong code for a typo.  Codegen's
# refusal stays as the door behind sema's, and this project cannot reach it.
#
# A project rather than a negative file so the whole pipeline is asked.

[project]
project_name = "sizeof_undeclared_type"
output_dir   = "build"
target_type  = "executable"
source_dir   = "src"
entry_point  = "src/main.cryo"

