namespace TypeParameterForConcreteParam::Main;

// A value of a type parameter passed where a parameter declares a concrete
// type is refused on the generic body, whatever an instantiation would bind
// the parameter to: inside the body `x` is a `T`, not an `f64`.

function takes_f64(v: f64) -> f64 { return v; }

function passes<T>(x: T) -> f64 {
    return takes_f64(x);
}

// A `static match (T)` arm naming `f64` narrows `T`, and `&T` with it, to
// `f64`: the same call there is accepted.
function narrowed<T>(x: &T) -> f64 {
    return static match (T) {
        f64 => { takes_f64(*x) }
        _   => { 0.0 }
    };
}

function main() -> i32 {
    const v: f64 = 2.0;
    return (passes::<f64>(v) + narrowed::<f64>(&v)) as i32;
}
