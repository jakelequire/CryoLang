# type_where_bound_inferred - a type's `where` bound is checked on an
# instantiation that no annotation writes.
#
# `Holder<T> where T: Tagged` instantiated through `Holder::wrap(Plain {..})`
# has its argument inferred at the call, so the written-annotation check in
# type resolution never sees `Holder<Plain>`; the monomorphizer refuses it
# where it is specialized, E0306 at the bound.  A project rather than a
# negative file because `cryo check` stops before monomorphization.

[project]
project_name = "type_where_bound_inferred"
output_dir   = "build"
target_type  = "executable"
source_dir   = "src"
entry_point  = "src/main.cryo"

[compiler]

