namespace TypeWhereBoundInferred;

type trait Tagged { tag(&this) -> i32; }

type struct Plain { v: i32; }

type struct Holder<T> where T: Tagged {
    inner: T;
    static wrap(x: T) -> Holder<T> { return Holder<T> { inner: x }; }
    peek(&this) -> i32 { return this.inner.tag(); }
}

function main() -> i32 {
    return Holder::wrap(Plain { v: 7 }).peek();
}
