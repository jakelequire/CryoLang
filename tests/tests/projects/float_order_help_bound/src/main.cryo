// A generic function bounded by `Ord`, called with floats, is refused with
// the help naming `total_compare`, not one advising an implementation of
// `Ord` for the float.
namespace FloatOrderHelpBound;

import std::core::cmp;

function main() -> i32 {
    const smaller: f32 = cmp::min(1.0 as f32, 2.0 as f32);
    return 0;
}
