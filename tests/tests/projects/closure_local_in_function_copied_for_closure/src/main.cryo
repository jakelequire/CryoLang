namespace Main;
import std::fmt;

// A function copied for the capturing closure passed to its function-typed
// parameter is checked as a new function, so a capturing closure its body
// holds in a local with no type is a closure type of the copy's own, and the
// local takes that type.

type struct Pair { left: i64; right: i64; }

function scaled(x: i64, f: (i64) -> i64) -> i64 {
    const pair: Pair = Pair { left: x, right: 3 };
    const times = (n: i64) -> i64 { return n * pair.right + pair.left; };
    return f(times(x));
}

function main() -> i32 {
    const bias: i64 = 1000;
    const plus = (n: i64) -> i64 { return n + bias; };
    fmt::println(f"copied: {scaled(2, plus)} {scaled(5, (n: i64) -> i64 { return n - bias; })} {scaled(7, (n: i64) -> i64 { return n * 2; })}");
    return 0;
}
