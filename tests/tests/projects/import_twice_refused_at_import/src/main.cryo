namespace ImportTwiceRefusedAtImport::Main;

import ImportTwiceRefusedAtImport::Json;
import ImportTwiceRefusedAtImport::Toml;
import ImportTwiceRefusedAtImport::Json::{ parse, Doc, shape };
import ImportTwiceRefusedAtImport::Toml::{ parse, Doc };
import ImportTwiceRefusedAtImport::Json::{ shape };

function main() -> i32 {
    const a: i32 = parse("1");
    const b: i32 = Toml::parse("1");
    const d: Doc = Doc { v: shape() };
    return a + b + d.v;
}
