# link_failure_carries_linker_report - a program whose link fails on a C
# function declared and defined nowhere.  The error the build reports carries
# the linker's own output as a note (`the tool reported:`), where the reader
# of the error finds the reason; the linker's output printed as it ran would
# sit above every diagnostic the build renders, apart from this one.
[project]
project_name = "link_failure_carries_linker_report"
output_dir   = "build"
target_type  = "executable"
source_dir   = "src"
entry_point  = "src/main.cryo"
[compiler]
[dependencies]
