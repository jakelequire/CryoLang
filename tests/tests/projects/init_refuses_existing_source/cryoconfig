# init_refuses_existing_source - `cryo init` never overwrites a source
# file.  The step scaffolds the library `first` in build/one with its
# sources in build/shared; the command then scaffolds `second` in
# build/two, a directory with no cryoconfig, with the same source
# directory, whose lib.cryo is already there: init must fail naming it,
# and leave it as the step wrote it.
# This project's own cryoconfig is never built: the command is `init`.
[project]
project_name = "init_refuses_existing_source"
output_dir   = "build"

