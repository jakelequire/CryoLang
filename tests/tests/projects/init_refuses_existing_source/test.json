{
  "outcome": "command",
  "steps": [
    ["init", "build/one", "--name=first", "--type=library", "--source-dir=../shared", "--output-dir=out"]
  ],
  "command": ["init", "build/two", "--name=second", "--type=library", "--source-dir=../shared", "--output-dir=out"],
  "expect": {
    "fails": true,
    "stderr_contains": ["lib.cryo already exists; `cryo init` does not overwrite a file"],
    "output_excludes": ["Created"],
    "file": "build/shared/lib.cryo",
    "file_contains": ["namespace First;"],
    "file_excludes": ["Second"]
  }
}
