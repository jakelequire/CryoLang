namespace RepeatLiteralEvaluatesValueBeforeCount;

import std::fmt;

// Operands are evaluated left to right, so a repeat literal `[value; count]`
// whose count is computed at run time evaluates its value, effects
// included, before its count.
//
// Each `note` appends its digit to `g_order` when it runs.

mut g_order: i64 = 0;

function note(digit: i64, value: i64) -> i64 {
    g_order = g_order * 10 + digit;
    return value;
}

function main() -> i32 {
    const filled: [i64] = [note(1, 7); note(2, 3)];
    const first: i64 = g_order;
    g_order = 0;
    const nested: [i64] = [note(3, note(4, 5)); note(5, 2) + note(6, 0)];
    fmt::println(f"order: {first} {g_order} {filled.length()} {filled[2]} {nested.length()} {nested[1]}");
    return 0;
}
