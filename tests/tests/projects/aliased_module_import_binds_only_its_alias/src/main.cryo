namespace AliasedImport::Main;

// Two modules whose leaf is `connection`, one imported under its own name
// and one under an alias.  The alias is the aliased module's only name
// here, so `connection` names the other one alone and is not ambiguous.

import AliasedImport::First::connection;
import AliasedImport::Second::connection as second_connection;

function main() -> i32 {
    const first: i64 = connection::LENGTH;
    const second: i64 = second_connection::LENGTH;
    if (first != 24 || second != 7) { return 1; }
    return 0;
}
