namespace PubExt::Ffi;

import std::ffi::libc::{ CLong };

public extern "C" {
    function llabs(v: i64) -> i64;
}

extern "C" {
    public function labs(v: CLong) -> CLong;
}

private extern "C" {
    function abs(v: i32) -> i32;
}

public function small_magnitude(v: i32) -> i32 {
    return abs(v);
}
