# extern_public_block_and_function - both written forms of a public C
# binding: `public extern "C" { ... }` makes every function in the block
# public, and `public function` inside a plain `extern "C"` block makes that
# one public.  A block's keyword is the default for the functions in it, so
# a `private extern "C"` block's function stays callable from its own module.
#
# Exit 42 = llabs(-30) through the public block + labs(-9) through the
# public function + the private block's abs(-3), each called from where it
# is visible.
[project]
project_name = "extern_public_block_and_function"
output_dir   = "build"
target_type  = "executable"
source_dir   = "src"
entry_point  = "src/main.cryo"
