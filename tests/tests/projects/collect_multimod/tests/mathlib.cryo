/// A project-local module under test. The test module below imports this by
/// namespace - exercising real cross-module resolution inside the package.
![config(testing)]
namespace CollectMultimod::MathLib;

/// Sum two integers.
function add(a: i32, b: i32) -> i32 { return a + b; }

/// Double an integer.
function twice(n: i32) -> i32 { return n * 2; }
