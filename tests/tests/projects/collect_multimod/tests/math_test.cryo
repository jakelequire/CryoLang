/// Tests that call into a sibling project-local module (CollectMultimod::MathLib),
/// proving cross-module compilation + test discovery work inside a project that
/// the parent suite drives via the projects meta-runner.
![config(testing)]
namespace CollectMultimod::MathTest;

import std::core::result;
import std::test::error;
import std::test::assert;

import CollectMultimod::MathLib;

![test]
function add_across_modules() -> Result<(), TestError> {
    expect_eq(CollectMultimod::MathLib::add(2, 3), 5)?;
    return Result::Ok(());
}

![test]
function twice_across_modules() -> Result<(), TestError> {
    expect_eq(CollectMultimod::MathLib::twice(21), 42)?;
    return Result::Ok(());
}
