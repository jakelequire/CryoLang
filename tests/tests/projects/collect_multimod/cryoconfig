# collect_multimod — a multi-module test PROJECT exercised by the parent
# suite's projects meta-runner (outcome = "collect": build this package and
# run its own `![test]` functions; the project passes iff they all pass).
#
# This is the FFI/module-system/integration use case in miniature: two
# project-local modules (Math + the test module that imports it) compiled and
# run as one real Cryo package, separate from the parent test binary.

[project]
project_name = "collect_multimod"
output_dir   = "build"
target_type  = "executable"
source_dir   = "src"
entry_point  = "src/main.cryo"

[compiler]

