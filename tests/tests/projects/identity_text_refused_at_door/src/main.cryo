/// A module of the compiler's own: text read off a definition, a
/// `DeclName`, is shown and never looked up by.  Each way of handing it to a
/// door or a hash table is refused where it is handed; showing it, a door
/// asked by other text, a door's own body and a declaration that says why
/// are not.
namespace compiler::resolver::decl_name;

import std::collections::hashmap::{ HashMap };
import std::fmt;

type struct DeclName {
private:
    text: string;
public:
    static of(s: string) -> DeclName { return DeclName { text: s }; }
    shown(&this) -> string { return this.text; }
}

type struct Names {
    count: i32;
}

implement struct Names {
    /// Door `intern`.  Text becomes a name here.
    intern(mut &this, text: string) -> i32 {
        this.count = this.count + 1;
        return text.length() as i32;
    }

    /// Door `scope-value`.  A door's own body compares text.
    lookup(mut &this, text: string) -> i32 {
        const name: DeclName = DeclName::of(text);
        return this.intern(name.shown());
    }
}

/// Formatted into the key a door is asked by.
function formatted(names: mut &Names, name: DeclName) -> i32 {
    return names.intern(fmt::format("%s::new", name.shown()));
}

/// Handed to a door as it is.
function handed_as_is(names: mut &Names, name: DeclName) -> i32 {
    return names.intern(name.shown());
}

/// Carried through a local.
function through_local(names: mut &Names, name: DeclName) -> i32 {
    const path: string = name.shown();
    const key: string = path + "::new";
    return names.intern(key);
}

/// Carried through an assignment.
function through_assignment(names: mut &Names, name: DeclName) -> i32 {
    mut key: string = "";
    key = name.shown();
    return names.intern(key);
}

/// The key of a hash table.
function as_table_key(name: DeclName) -> i32 {
    mut seen: HashMap<string, i32> = HashMap::<string, i32>::new();
    seen.insert(name.shown(), 1);
    return seen.length() as i32;
}

/// Shown: a message is not a lookup.
function shown_only(names: mut &Names, name: DeclName) -> i32 {
    const message: string = fmt::format("`%s` is declared here", name.shown());
    return names.intern("a literal") + message.length() as i32;
}

/// A declaration that says why its use is not a lookup.
![allow(lookup_by_spelling, reason = "mangles the definition's path into its link symbol")]
function allowed(names: mut &Names, name: DeclName) -> i32 {
    return names.intern(fmt::format("_C%s", name.shown()));
}

function main() -> i32 {
    mut names: Names = Names { count: 0 };
    const d: DeclName = DeclName::of("a::b");
    return formatted(&names, d) + handed_as_is(&names, d) + through_local(&names, d)
        + through_assignment(&names, d) + as_table_key(d) + shown_only(&names, d)
        + allowed(&names, d) + names.lookup("a::b");
}
