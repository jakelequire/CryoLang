namespace ImplHeadArgumentSpelledWithAliasKeyword;

type trait Measure { measure(&this) -> i64; }

type struct Box<T> { v: T; }

// `Box<int>` is `Box<i32>` and `Box<double>` is `Box<f64>`: each head is
// selected for the instance its alias keyword spells, and for no other.
implement trait Measure for struct Box<int> {
    measure(&this) -> i64 { return (this.v as i64) * 10; }
}

implement trait Measure for struct Box<i64> {
    measure(&this) -> i64 { return this.v + 1; }
}

implement trait Measure for struct Box<double> {
    measure(&this) -> i64 { return (this.v * 2.0) as i64; }
}

function main() -> i32 {
    const a: Box<i32> = Box::<i32> { v: 2 };
    const b: Box<i64> = Box::<i64> { v: 4 };
    const c: Box<f64> = Box::<f64> { v: 1.5 };
    return (a.measure() + b.measure() + c.measure()) as i32;
}
