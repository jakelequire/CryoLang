namespace VariantOwnerTypeArguments;

import std::core::result::{ Result };

// A variant constructed through the enum's written type arguments is that
// instance's variant, and a simple enum - no payload, no type parameters -
// converts to `boolean` as its discriminant.

type enum Color { Red; Green; }

function is_ok(r: Result<i32, string>) -> boolean {
    match (r) {
        Result::Ok(_)  => { return true; }
        Result::Err(_) => { return false; }
    }
}

function main() -> i32 {
    const some = Option::<i32>::Some(4);
    if (some.unwrap() != 4) { return 1; }
    const named = Option::<string>::Some("hi");
    if (named.unwrap().length() != 2) { return 2; }
    if (!is_ok(Result::<i32, string>::Ok(7))) { return 3; }
    if (is_ok(Result::<i32, string>::Err("no"))) { return 4; }
    const red: boolean = Color::Red;
    const green: boolean = Color::Green;
    if (red || !green) { return 5; }
    return 0;
}
