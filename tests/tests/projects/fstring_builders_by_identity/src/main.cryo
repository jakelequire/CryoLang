namespace FstringBuildersByIdentity::Main;

// An f-string lowers to calls of the standard library's builders, named by
// what they are rather than by how they are spelled.  This module declares
// functions under the builders' own names and under the names the language
// gives them, with signatures nothing in an f-string could call; its
// f-strings still reach the library's builders, and its own functions are
// still its own.

import std::fmt;
import std::collections::str::{ Str };
import std::collections::string::{ String };

function fmt_new() -> i32 { return 1; }
function fmt_append_lit(total: i32, more: i32) -> i32 { return total + more; }
function fmt_append_display(total: i32, more: i32) -> i32 { return total * more; }
function fmt_append_debug(total: i32) -> i32 { return total - 1; }
function fmt_append_fmt() -> i32 { return 5; }
function format_new() -> i32 { return 2; }
function format_append_literal(total: i32) -> i32 { return total + 2; }
function format_append_display(total: i32) -> i32 { return total + 3; }

function main() -> i32 {
    const count: i32 = 7;
    const shown: String = f"count = {count}, debug = {count:?}, padded = [{count:>3}]";
    const want: Str = Str::new("count = 7, debug = 7, padded = [  7]");
    if (!shown.as_str().equals(&want)) { return 1; }

    // The module's own functions answer its own calls.
    const own: i32 = fmt_append_lit(fmt_new(), 2) + fmt_append_display(3, 4)
        + fmt_append_debug(10) + fmt_append_fmt() + format_new()
        + format_append_literal(1) + format_append_display(1);
    if (own != 3 + 12 + 9 + 5 + 2 + 3 + 4) { return 2; }

    fmt::println(f"builders by identity: {shown}");
    return 0;
}
