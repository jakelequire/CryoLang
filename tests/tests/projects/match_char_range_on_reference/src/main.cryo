/// A char range on a reference to a char: the bounds are compared with the
/// subject's own value, which is the reference.  Refused at the pattern;
/// `match (*c)` compares the char.
namespace MatchCharRangeOnReference::Main;

function is_digit(c: &char) -> i32 {
    return match (c) {
        // The pattern this project's refusal points at.
        '0'..'9' => { 1 }
        _        => { 0 }
    };
}

function main() -> i32 {
    const c: char = '5';
    return is_digit(&c);
}
