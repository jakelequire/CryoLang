# match_char_range_on_reference - a char range pattern on a reference to a
# char is refused (outcome = "compile_fail").
#
# A range's bounds are compared with the subject's own value, and a reference
# is not a char: the check looked through the reference and accepted it, and
# the backend then refused a compare of a pointer with an integer as an
# internal error (E0900, LLVM module verification).

[project]
project_name = "match_char_range_on_reference"
output_dir   = "build"
target_type  = "executable"
source_dir   = "src"
entry_point  = "src/main.cryo"

[compiler]

