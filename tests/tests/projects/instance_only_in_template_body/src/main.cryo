/// A template's own body may name an instantiation that exists nowhere
/// else - a map of fixed key and value types inside a method of a generic
/// struct that is never instantiated.  Checking that body builds the map's
/// inner instances without demanding them, so nothing asks for their code
/// and the program builds; the same body in an instantiated template runs.
namespace InstanceOnlyInTemplateBody::Main;

import std::fmt;
import std::collections::hashmap::{ HashMap };

type struct Inline<T> {
    value: T;

    local(mut &this) -> void where T: Copy {
        const map: HashMap<i32, i16> = HashMap::new();
        fmt::println(f"{map.length()}");
    }

    temporary(&this) -> i64 {
        return HashMap::<u8, i64>::new().length();
    }

    static inserted() -> i64 {
        mut map: HashMap<i16, u32> = HashMap::new();
        map.insert(3, 4);
        return map.length();
    }
}

type struct Split<T> {
    value: T;
}

implement struct Split<T> {
    moved(&this) -> i64 {
        mut map: HashMap<u16, u16> = HashMap::new();
        map.insert(1, 2);
        const kept: HashMap<u16, u16> = map;
        return kept.length();
    }
}

type trait Defaulted {
    counted(&this) -> i64 {
        mut map: HashMap<i8, u8> = HashMap::new();
        map.insert(1, 1);
        return map.length();
    }
}

type enum Choice<T> {
    One(T);
    Empty;
}

implement enum Choice<T> {
    counted(&this) -> i64 {
        const map: HashMap<u32, i8> = HashMap::new();
        return map.length();
    }
}

type union Overlaid<T> {
    first: T;
    second: u64;

    moved(&this) -> i64 {
        mut map: HashMap<u32, u64> = HashMap::new();
        map.insert(1, 1);
        const kept: HashMap<u32, u64> = map;
        return kept.length();
    }
}

type struct Used<T> {
    value: T;

    counted(&this) -> i64 {
        mut map: HashMap<i64, i32> = HashMap::new();
        map.insert(5, 6);
        map.insert(7, 8);
        return map.length();
    }
}

function main() -> i32 {
    const used: Used<u8> = Used::<u8> { value: 1 };
    fmt::println(f"maps in template bodies: {used.counted()}");
    return 0;
}
