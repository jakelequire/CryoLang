# standard_library_path_not_shadowed_by_core_directory - run. A program
# directory `core/` holding a `_module.cryo` is the program's own module:
# the standard library's `core::_module` line still names the standard
# library's file, so `core::panic` and the rest of `core` resolve there.
[project]
project_name = "standard_library_path_not_shadowed_by_core_directory"
output_dir   = "build"
target_type  = "executable"
source_dir   = "src"
entry_point  = "src/main.cryo"

