# windows_command_line_split_once - the program starts itself again with
# command lines written unit by unit, so nothing quotes them, and each child
# checks that env::args() returns the split the runtime's entry made: `""`
# inside quotes is a literal quote, an empty quoted argument is kept,
# backslashes escape only before a quote, and a lone surrogate reads as
# U+FFFD.

[project]
project_name = "windows_command_line_split_once"
output_dir   = "build"
target_type  = "executable"
source_dir   = "src"
entry_point  = "src/main.cryo"

