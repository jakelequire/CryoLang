namespace GenericOverloadChosenByArguments::Main;

import GenericOverloadChosenByArguments::Pick;

// A generic and a plain function of one arity: the arguments say which a
// call calls, whichever is declared first and whether the call is bare or
// through a module path.
function first_generic<U>(items: [U]) -> i64 { return items.length(); }
function first_generic(value: i32) -> i64 { return 100; }

function first_plain(value: i32) -> i64 { return 200; }
function first_plain<U>(items: [U]) -> i64 { return items.length() + 10; }

function same<U>(u: U) -> i32 { return 1; }
function same(u: i32) -> i32 { return 2; }

function main() -> int {
    if (same("seven") != 1) { return 11; }
    const three: [i64] = [1, 2, 3];
    if (first_generic(three) != 3) { return 1; }
    if (first_generic(7) != 100) { return 2; }
    const two: [boolean] = [true, false];
    if (first_plain(two) != 12) { return 3; }
    if (first_plain(7) != 200) { return 4; }
    const one: [i64] = [5];
    if (first_plain::<i64>(one) != 11) { return 5; }

    const four: [i64] = [1, 2, 3, 4];
    if (Pick::count(four) != 4) { return 6; }
    if (Pick::count(9) != 300) { return 7; }
    const five: [boolean] = [true, false, true, false, true];
    if (Pick::tally(five) != 25) { return 8; }
    if (Pick::tally(9) != 400) { return 9; }
    const six: [i64] = [1, 2, 3, 4, 5, 6];
    if (Pick::tally::<i64>(six) != 26) { return 10; }
    return 0;
}
