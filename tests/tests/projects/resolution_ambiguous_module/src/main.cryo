/// Two imported modules ending in `::Text` make the bare `Text` scope name
/// neither of them, and that is E0154 rather than a pick.
///
/// Both are imported HERE, so both are reachable and the spelling is genuinely
/// ambiguous. The resolver used to break exactly this tie by argument arity,
/// then by longest shared namespace prefix with whatever module it was standing
/// in, then by graph order - three tie-breaks the source never mentions.
namespace ResolutionAmbiguousModule::Main;

import ResolutionAmbiguousModule::Alpha::Text;
import ResolutionAmbiguousModule::Beta::Text;
import ResolutionAmbiguousModule::Solo::Only;

/// The control: one module ends in `::Only`, so it stays unambiguous and must
/// still resolve.
///
/// It lives in its own function, several lines from the rejection below,
/// because the renderer echoes the source around an error - a control sharing
/// that line would appear in the output no matter what the compiler decided
/// about it, and could not be asserted absent.
function control() -> i32 {
    return Only::ping();
}

function main(argc: int, argv: string*) -> int {
    return (Text::tag() + control()) as int;
}
