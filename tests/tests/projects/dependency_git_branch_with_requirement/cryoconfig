# dependency_git_branch_with_requirement - a git dependency on a branch is
# the branch's head, here 0.1.1, held to the requirement "~0.1.1"; the lock
# records the branch and the version.
[project]
project_name = "dependency_git_branch_with_requirement"
output_dir   = "build"
target_type  = "executable"
source_dir   = "src"
entry_point  = "src/main.cryo"

[compiler]

[dependencies]
greeter = { git = "{fixture:greeter}", branch = "main", version = "~0.1.1" }
