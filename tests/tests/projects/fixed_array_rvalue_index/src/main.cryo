/// A fixed-size array a call returns is indexed as a value: it has no
/// storage of its own until codegen gives it a temporary, and the element
/// is read from there, with a constant or a computed index.
namespace FixedArrayRvalueIndex::Main;

function pair() -> [i32; 2] {
    return [1, 2];
}

function triple(base: i64) -> [i64; 3] {
    return [base, base + 1, base + 2];
}

function main() -> i32 {
    mut i: i64 = 2;
    const a: i32 = pair()[1];
    const b: i64 = triple(10)[i];
    const c: i64 = triple(20)[0] + triple(30)[i - 1];
    return a + (b + c - 60) as i32;
}
