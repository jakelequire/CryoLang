/// `cryo interpret` takes a `match` on a `Str` with string patterns as the
/// compiled program does: an arm is taken when the subject equals the
/// literal converted to `Str`, through `Str`'s `Eq`.  The exit code is the
/// sum of the arms taken, so a pattern that never matches, or one that
/// matches everything, moves it.
namespace InterpretMatchStrTextPatterns::Main;

import std::collections::str::{ Str };

function weight(word: Str) -> i32 {
    return match (word) {
        "one"         => { 1 }
        "two" | "dos" => { 2 }
        ""            => { 4 }
        _             => { 8 }
    };
}

function main() -> i32 {
    // 1 + 2 + 2 + 4 + 8 + 8 = 25
    return weight("one") + weight("two") + weight("dos") + weight("") + weight("three") + weight("on");
}
