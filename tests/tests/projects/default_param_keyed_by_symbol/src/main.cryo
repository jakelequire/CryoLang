namespace DefaultParamKeyed::Main;

type trait Conv {
    conv<U>(&this, x: U) -> u64 { return sizeof(U); }
    other<K>(&this, x: K) -> u64 { return sizeof(K); }
}

// The impl's `U` spells the default's method parameter.
type struct Holder<U> { v: U; }
implement<U> trait Conv for struct Holder<U> { }

// The same impl with a parameter spelled differently: the control.
type struct Other<T> { v: T; }
implement<T> trait Conv for struct Other<T> { }

function main() -> i32 {
    const h: Holder<u8> = Holder<u8> { v: 1 };
    const o: Other<u8>  = Other<u8> { v: 1 };
    const a: u64 = h.conv<i64>(5);    // the method's U is i64: 8, not the impl's u8
    const b: u64 = h.other<i64>(5);   // 8
    const c: u64 = o.conv<i64>(5);    // 8
    const d: u64 = o.other<i64>(5);   // 8
    return (a + b + c + d) as i32;
}
