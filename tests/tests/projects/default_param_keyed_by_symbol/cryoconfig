# default_param_keyed_by_symbol - a trait default's OWN generic parameter
# keeps its meaning under an impl whose own parameter spells it.  `conv<U>`
# is resolved in the trait's file, where no enclosing `U` exists, and copied
# under `implement<U> trait Conv for struct Holder<U>`; the impl's `U` is
# the owner's argument (u8) and the method's `U` is the call's (i64).  The
# substitution tables are keyed by the parameter's symbol, so the impl's
# substitution leaves the method's `U` alone and `h.conv<i64>(5)` answers
# sizeof(i64).  Keyed by spelling, the impl's `U` rewrote the method's and
# it answered sizeof(u8).  The exit code sums the four shapes: the shared
# spelling, the method's distinct `<K>`, and both under an impl spelled
# `<T>`; 8 each.
[project]
project_name = "default_param_keyed_by_symbol"
output_dir   = "build"
target_type  = "executable"
source_dir   = "src"
entry_point  = "src/main.cryo"
