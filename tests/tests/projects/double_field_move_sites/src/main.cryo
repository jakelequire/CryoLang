namespace DoubleFieldMoveSites::Main;

import std::collections::string::{ String };

// The field is moved out by the first call and again by the second: the
// report points at both, the second as the error and the first as where the
// value went.

type struct Token {
    text: String;
}

type struct Holder {
    token: Token;
    count: i32;
}

function take(t: Token) -> i32 {
    return t.text.length() as i32;
}

function main() -> i32 {
    const h: Holder = Holder { token: Token { text: String::from("t") }, count: 1 };
    const a: i32 = take(h.token);
    const b: i32 = take(h.token);
    return a + b;
}
