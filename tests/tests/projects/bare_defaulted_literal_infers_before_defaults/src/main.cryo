namespace BareDefaultedLiteralInfersBeforeDefaults;

// `Defaulted { value: x }` names a type whose only parameter has a default,
// with no type arguments: `T` comes from the expected type, else from the
// field values (inside the type's own body and a generic function's body
// too), and the default `i64` fills it only when nothing decides it - a
// numeric literal included, whose own type is a guess and loses to the
// declared default, as it does at a static call.

import std::core::default::{ Default };

type struct Defaulted<T = i64> {
    value: T;
    static empty() -> Defaulted<T> where T: Default {
        return Defaulted { value: T::default() };
    }
    static wrap(value: T) -> Defaulted<T> {
        return Defaulted { value: value };
    }
}

type struct Pair<A = i64, B = u16> {
    first: A;
    second: B;
}

function wrap_any<U>(value: U) -> Defaulted<U> {
    return Defaulted { value: value };
}

function small_value(d: Defaulted<i8>) -> i8 { return d.value; }
function wide_value(d: Defaulted<i64>) -> i64 { return d.value; }
function pair_sum(p: Pair<i8, u16>) -> i64 { return (p.first as i64) + (p.second as i64); }

function main() -> i32 {
    const empty: Defaulted<u8> = Defaulted::<u8>::empty();
    if (empty.value != 0) { return 1; }
    const wrapped: Defaulted<u32> = Defaulted::<u32>::wrap(40000);
    if (wrapped.value != 40000) { return 2; }
    const small: i8 = -5;
    const from_field = Defaulted { value: small };
    if (small_value(from_field) != -5) { return 3; }
    const from_literal = Defaulted { value: 5000000000 };
    if (wide_value(from_literal) != 5000000000) { return 4; }
    const from_expected: Defaulted<u8> = Defaulted { value: 200 };
    if (from_expected.value != 200) { return 5; }
    const mixed = Pair { first: small, second: 60000 };
    if (pair_sum(mixed) != 59995) { return 6; }
    const generic: Defaulted<boolean> = wrap_any(true);
    if (!generic.value) { return 7; }
    return 0;
}
