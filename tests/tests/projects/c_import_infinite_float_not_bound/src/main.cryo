/// A C constant whose value is not finite is left unbound, so naming it is
/// refused rather than reading the number its C runtime text reads back as.
/// The finite constant beside them is bound.
namespace CImportInfiniteFloatNotBound::Main;

extern module cif := "C" {
    #include "../include/infinite.h"
}

function main() -> int {
    const doubled: f64 = cif::CIF_DOUBLED;
    const overflow: f64 = cif::CIF_OVERFLOW;
    const infinity: f64 = cif::cif_infinity;
    return (doubled + overflow + infinity) as int;
}
