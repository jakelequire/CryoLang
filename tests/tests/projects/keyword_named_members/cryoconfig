# keyword_named_members - run. A keyword names a member wherever only a
# member can stand: a field, a method and a static method in a struct body,
# a trait's method and its implementation, an enum's method, and the name
# after `.` and `::` that reaches each.  The standard library's
# `Router.delete` registers a route through the same rule.
[project]
project_name = "keyword_named_members"
output_dir   = "build"
target_type  = "executable"
source_dir   = "src"
entry_point  = "src/main.cryo"

