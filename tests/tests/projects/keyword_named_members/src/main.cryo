namespace Main;

import std::collections::str::{ Str };
import std::net::http::method::{ Method };
import std::net::http::request::{ Request };
import std::net::http::response::{ Response };
import std::net::http::router::{ Router };
import std::net::http::status::{ StatusCode };

type struct Counter {
    match: i32;
    return: i32;

    delete(mut &this, amount: i32) -> i32 {
        this.match = this.match - amount;
        return this.match;
    }

    static new(start: i32) -> Counter {
        return Counter { match: start, return: 0 };
    }

    static while(value: i32) -> i32 {
        return value * 2;
    }
}

type trait Removes {
    delete(mut &this, amount: i32) -> i32;
    loop(&this) -> i32;
}

type struct Bin {
    held: i32;
}

implement trait Removes for Bin {
    delete(mut &this, amount: i32) -> i32 {
        this.held = this.held - amount;
        return this.held;
    }

    loop(&this) -> i32 {
        return this.held + 1;
    }
}

type enum Verb {
    Read;
    Write;
}

implement Verb {
    if(&this) -> i32 {
        return match (this) {
            Verb::Read  => { 1 }
            Verb::Write => { 2 }
        };
    }
}

function removed(request: Request) -> Response {
    return Response::text(StatusCode::no_content(), Str::new(""));
}

function main() -> i32 {
    mut counter: Counter = Counter::new(10);
    if (counter.delete(3) != 7) { return 1; }
    if (counter.match != 7 || counter.return != 0) { return 2; }
    if (Counter::while(4) != 8) { return 3; }

    mut bin: Bin = Bin { held: 5 };
    if (bin.delete(2) != 3) { return 4; }
    if (bin.loop() != 4) { return 5; }

    if (Verb::Write.if() != 2) { return 6; }

    mut router: Router = Router::new();
    router.delete(Str::new("/items"), removed);
    const response: Response = router.dispatch(Request::new(Method::Delete, Str::new("/items")));
    if (response.status.as_u16() != 204) { return 7; }
    return 0;
}
