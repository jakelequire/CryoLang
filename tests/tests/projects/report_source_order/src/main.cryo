namespace ReportSourceOrder::Main;

// Reports are printed in the order of where they are in the source, not the
// order the stages found them in: the import at the bottom is refused by
// name resolution, which runs before the checks that refuse the two
// functions above it, and it is still printed last.

function first() -> i32 {
    const e: i64 = 5;
    const f: i32 = e;
    return f;
}

type struct Point {
    x: i32;
}

function second() -> i32 {
    const p: Point = Point { x: 1 };
    return p.w;
}

import std::collections::hashmap::{ HashMpa };

function main() -> i32 {
    return first() + second();
}
