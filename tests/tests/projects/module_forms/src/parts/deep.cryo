namespace ModuleForms::Parts::Deep;

// Public members of an internal module's public type reach its package,
// as the type does, so naming the type in them is not refused.
public type struct Gauge {
    public level: i32;
    public next:  Gauge*;

    public static make(level: i32) -> Gauge { return Gauge { level: level, next: null }; }
}

public function chain(g: &Gauge) -> Gauge* { return g.next; }
