namespace ModuleForms::Main;

import ModuleForms::Parts;
import ModuleForms::Parts::Plain;
import ModuleForms::Parts::Left;
import ModuleForms::Parts::Right;
import ModuleForms::Parts::Hidden;
import ModuleForms::Parts::Deep;
import ModuleForms::Parts::Inner;

// Every form declares a module this program imports; the internal ones are
// imported from their own package.
function main() -> i32 {
    const g: Deep::Gauge = Deep::Gauge { level: 5 };
    const sum: i32 = Plain::value() + Left::value() + Right::value() + Hidden::value()
        + g.level + Inner::value();
    return if (sum == 21) { 0 } else { 1 };
}
