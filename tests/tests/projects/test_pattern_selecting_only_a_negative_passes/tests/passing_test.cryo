///! The unit suite's one test, which the run's pattern does not select.

![config(testing)]
namespace CryoTests::Tests::PatternSelectingOnlyANegative;

import std::core::result::{ Result };
import std::test::error::{ TestError };
import std::test::assert::{ expect_equal };

![test]
function two_and_two_make_four() -> Result<(), TestError> {
    return expect_equal(2 + 2, 4);
}
