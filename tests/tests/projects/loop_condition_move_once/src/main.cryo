/// A value moved in a loop condition is accepted when the body always
/// leaves the loop, by `break` or `return`: the condition is then tested
/// exactly once.  A `for`'s update that moves is accepted when the body
/// never reaches it.  Each value is released exactly once.
///
/// The elements count their own releases.  `make` builds two elements, so
/// every value released exactly once gives 2 per value made.  `main` prints
/// how many checks passed and exits 0 only when all did.
namespace LoopConditionMoveOnce::Main;

import std::core::drop::{ Drop };
import std::ffi::libc;

mut g_released: i64 = 0;

type struct Counted { v: i64; }

implement trait Drop for struct Counted {
    drop(mut &this) -> void {
        g_released = g_released + 1;
    }
}

type struct Holder { a: [Counted]; b: [Counted]; }

function make() -> [Counted] {
    mut xs: [Counted] = [];
    xs.push(Counted { v: 1 });
    xs.push(Counted { v: 2 });
    return xs;
}

function take(xs: [Counted]) -> i64 {
    return xs.length() as i64;
}

function body_always_breaks() -> i64 {
    const v: [Counted] = make();
    mut n: i64 = 0;
    while (take(v) == 2) {
        n += 1;
        break;
    }
    return n;
}

function body_always_returns() -> i64 {
    const h: Holder = Holder { a: make(), b: make() };
    while (take(h.a) == 2) {
        return 1;
    }
    return 0;
}

function update_never_reached() -> i64 {
    const v: [Counted] = make();
    mut n: i64 = 0;
    for (mut i: i64 = 0; i < 3; n += take(v)) {
        n = 7;
        break;
    }
    return n;
}

function check(name: string, run: () -> i64, want_result: i64, want_released: i64) -> i64 {
    g_released = 0;
    const got: i64 = run();
    if (got != want_result || g_released != want_released) {
        libc::printf("FAIL %s: result %d (want %d), %d releases (want %d)\n",
            name, got, want_result, g_released, want_released);
        return 0;
    }
    return 1;
}

function main() -> i32 {
    mut passed: i64 = 0;
    passed += check("body always breaks", body_always_breaks, 1, 2);
    passed += check("body always returns", body_always_returns, 1, 4);
    passed += check("update never reached", update_never_reached, 7, 2);
    libc::printf("loop_condition_move_once: %d of 3 passed\n", passed);
    if (passed != 3) { return 1; }
    return 0;
}
