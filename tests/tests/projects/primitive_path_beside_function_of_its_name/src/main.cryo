/// A path whose scope segment spells a primitive names the primitive's
/// members even where a function of that spelling is declared: the segment
/// names what owns the member, a type, and a primitive's spelling always
/// means the primitive in type position.  `u16::MAX` is the constant, both
/// in an expression and as a pattern, and `u16::wrapping_add(top, 2)` is the
/// method called through its owner.  A plain call `u16()` still names the
/// function, since a call's callee is asked in the value namespace.
namespace PrimitivePathBesideFunctionOfItsName::Main;

import std::fmt;

function u16() -> i32 {
    return 7;
}

function main() -> i32 {
    const top: u16 = u16::MAX;
    const sum: u16 = u16::wrapping_add(top, 2);
    const by_method: u16 = top.wrapping_add(3);
    const called: i32 = u16();
    const matched: i32 = match (top) {
        u16::MAX => { 1 }
        _ => { 0 }
    };
    fmt::println(f"{top} {sum} {by_method} {called} {matched}");
    return 0;
}
