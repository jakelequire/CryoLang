# windows_default_triple_follows_the_link_driver - where LLVM reports windows-msvc, the host triple follows the C driver the link will run: a `CRYO_CC` naming a gcc selects windows-gnu even when no gcc is on PATH and an MSVC linker (`tools/lld-link`, an empty file) is; any other `CRYO_CC`, or none, leaves the PATH probe to decide.
[project]
project_name = "windows_default_triple_follows_the_link_driver"
output_dir   = "build"
target_type  = "executable"
source_dir   = "src"
entry_point  = "src/main.cryo"
[compiler]
[dependencies]
compiler = { path = "../../../../compiler" }
