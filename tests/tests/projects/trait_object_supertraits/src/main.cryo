namespace TraitObjectSupertraits::Main;

import TraitObjectSupertraits::Traits::{ Named, Shape, Solid };
import TraitObjectSupertraits::Bricks::{ Brick, Slab };
import TraitObjectSupertraits::Naming;

// A subtrait object calls its supertraits' methods through its own table,
// which holds each supertrait's methods first, in the order the supertraits
// are written, a trait inherited twice once.  The exit code names the first
// call or word that answered wrong.

function through_solid(s: virtual &Solid) -> i32 {
    return s.volume() * 1000 + s.area() * 10 + s.id();
}

/// The table's method words of `o`, from the fourth word on: `Named`'s
/// `id` and `tag`, `Shape`'s `area`, then `Solid`'s own.
function solid_word(o: virtual &Solid, index: i64) -> void* {
    mut copy: virtual &Solid = o;
    const words: void** = (&copy) as void**;
    const table: void** = words[1] as void**;
    return table[3 + index];
}

function shape_word(o: virtual &Shape, index: i64) -> void* {
    mut copy: virtual &Shape = o;
    const words: void** = (&copy) as void**;
    const table: void** = words[1] as void**;
    return table[3 + index];
}

function data_of(o: virtual &Solid) -> void* {
    mut copy: virtual &Solid = o;
    const words: void** = (&copy) as void**;
    return words[0];
}

function main() -> i32 {
    const b: Brick = Brick { side: 3 };
    const s: Slab = Slab { width: 2, depth: 5 };
    const sb: virtual &Solid = &b;
    const ss: virtual &Solid = &s;

    // The subtrait's own methods, `id` its own rather than `Named`'s.
    if (sb.volume() != 27) { return 1; }
    if (sb.id() != 11) { return 2; }
    if (ss.id() != 12) { return 3; }
    // A supertrait's method, and a supertrait's supertrait's.
    if (sb.area() != 9) { return 4; }
    if (ss.area() != 10) { return 5; }
    // `tag` is `Named`'s default for `Brick`, and `Slab`'s own.
    if (sb.tag() != 71) { return 6; }
    if (ss.tag() != 9) { return 7; }
    if (through_solid(&b) != 27101) { return 8; }
    if (through_solid(&s) != 10112) { return 9; }

    // A `Shape` object reaches the same supertrait methods.
    const shb: virtual &Shape = &b;
    if (shb.area() != 9 || shb.id() != 1 || shb.tag() != 71) { return 10; }

    // A `Solid` table starts with the whole `Shape` table, `Named`'s
    // methods first: the same three words, and the fourth `area` itself.
    for (mut i: i64 = 0; i < 3; i++) {
        if (solid_word(sb, i) != shape_word(shb, i)) { return 11; }
    }
    const area: (void*) -> i32 = solid_word(sb, 2) as (void*) -> i32;
    if (area(data_of(sb)) != 9) { return 12; }
    const named_id: (void*) -> i32 = solid_word(sb, 0) as (void*) -> i32;
    if (named_id(data_of(sb)) != 1) { return 13; }
    const own_id: (void*) -> i32 = solid_word(sb, 4) as (void*) -> i32;
    if (own_id(data_of(sb)) != 11) { return 14; }
    return 0;
}
