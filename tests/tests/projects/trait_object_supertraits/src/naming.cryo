namespace TraitObjectSupertraits::Naming;

import TraitObjectSupertraits::Traits::{ Named };
import TraitObjectSupertraits::Bricks::{ Brick, Slab };

// The supertrait's implementations live apart from the subtraits', so a
// table takes its supertrait methods from another module.

implement trait Named for Brick {
    id(&this) -> i32 { return 1; }
}

implement trait Named for Slab {
    id(&this) -> i32 { return 2; }
    tag(&this) -> i32 { return 9; }
}
