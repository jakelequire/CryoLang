namespace TraitObjectSupertraits::Traits;

type trait Named {
    id(&this) -> i32;
    tag(&this) -> i32 { return 71; }
}

type trait Shape : Named {
    area(&this) -> i32;
}

/// Inherits `Named` twice, through `Shape` and directly, and declares an
/// `id` of its own, which is nearer than `Named`'s.
type trait Solid : Shape, Named {
    volume(&this) -> i32;
    id(&this) -> i32;
}
