namespace TraitObjectSupertraits::Bricks;

import TraitObjectSupertraits::Traits::{ Shape, Solid };

type struct Brick {
    side: i32;
}

type struct Slab {
    width: i32;
    depth: i32;
}

implement trait Shape for Brick {
    area(&this) -> i32 { return this.side * this.side; }
}

implement trait Solid for Brick {
    volume(&this) -> i32 { return this.side * this.side * this.side; }
    id(&this) -> i32 { return 11; }
}

implement trait Shape for Slab {
    area(&this) -> i32 { return this.width * this.depth; }
}

implement trait Solid for Slab {
    volume(&this) -> i32 { return this.width * this.depth; }
    id(&this) -> i32 { return 12; }
}
