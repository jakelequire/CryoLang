namespace ConstantFoldFull128BitRange;
import std::fmt;

const TOP: u128 = u128::MAX;
const BELOW_TOP: u128 = u128::MAX - 1;
const ABOVE_SIGNED: u128 = i128::MAX as u128 + 1;
const SIGNED_TOP: u128 = ABOVE_SIGNED - 1;
const HALF: u128 = TOP / 2;
const DOUBLED: u128 = SIGNED_TOP * 2 + 1;
const HIGH_BIT: u128 = (1 as u128) << 127;
const ALL_ONES: u128 = ~(0 as u128);
const WRAPPED: u128 = (0 - 1) as u128;
const BACK_TO_SIGNED: i128 = TOP as i128;
const LOWEST_SIGNED: i128 = ABOVE_SIGNED as i128;
const LOW_HALF: u64 = TOP as u64;
const TOP_HALF: u128 = TOP >> 64;
const REACHES_TOP: u128 = (TOP - 5) + 5;

static_assert(TOP == 340282366920938463463374607431768211455, "u128::MAX folds");
static_assert(BELOW_TOP + 1 == TOP, "arithmetic just below u128::MAX folds");
static_assert(ABOVE_SIGNED == 170141183460469231731687303715884105728, "i128::MAX + 1 folds");
static_assert(SIGNED_TOP == i128::MAX as u128, "subtraction back across i128::MAX folds");
static_assert(HALF == SIGNED_TOP, "u128::MAX / 2 is i128::MAX");
static_assert(DOUBLED == TOP, "multiplication across i128::MAX folds");
static_assert(HIGH_BIT == ABOVE_SIGNED, "a shift to bit 127 folds");
static_assert(ALL_ONES == TOP, "the complement of zero as u128 is u128::MAX");
static_assert(WRAPPED == TOP, "-1 cast to u128 wraps to u128::MAX");
static_assert(BACK_TO_SIGNED == -1, "u128::MAX cast to i128 wraps to -1");
static_assert(LOWEST_SIGNED == i128::MIN, "i128::MAX + 1 cast to i128 wraps to i128::MIN");
static_assert(LOW_HALF == u64::MAX, "u128::MAX cast to u64 wraps");
static_assert(TOP_HALF == u64::MAX as u128, "a shift right of u128::MAX folds");
static_assert(REACHES_TOP == TOP, "a sum reaching u128::MAX folds");
static_assert(TOP > ABOVE_SIGNED && ABOVE_SIGNED > SIGNED_TOP, "comparisons across i128::MAX fold");
static_assert(i128::MIN < 0 && (i128::MIN as u128) == ABOVE_SIGNED, "i128::MIN folds and casts");

function describe(value: u128) -> string {
    return match (value) {
        TOP          => { "top" }
        ABOVE_SIGNED => { "above signed" }
        _            => { "other" }
    };
}

function main() -> i32 {
    fmt::println(f"top {TOP}");
    fmt::println(f"above signed {ABOVE_SIGNED}");
    fmt::println(f"signed top {SIGNED_TOP}");
    fmt::println(f"back to signed {BACK_TO_SIGNED} lowest signed {LOWEST_SIGNED}");
    fmt::println(f"{describe(TOP)}, {describe(BELOW_TOP + 1)}, {describe(SIGNED_TOP + 1)}, {describe(BELOW_TOP)}");
    mut runtime_top: u128 = 0;
    runtime_top = runtime_top - 1;
    if (runtime_top != TOP) { return 1; }
    if (runtime_top / 2 + 1 != ABOVE_SIGNED) { return 2; }
    return 0;
}
