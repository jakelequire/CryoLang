namespace GenericOwnerMethodValue;

type struct Wrap<T> { v: T; }
implement<T> struct Wrap<T> {
    static conv<U>(x: U) -> U { return x; }
    keep<U>(&this, x: U) -> T { return this.v; }
    static make<U>(t: T, u: U) -> T { return t; }
}

function through<A>(a: A) -> A {
    const f: (A, u8) -> A = Wrap::<A>::make::<u8>;
    const g: (A, i16) -> A = Wrap::make;
    return g(f(a, 3), 1);
}

function main() -> i32 {
    const f: (u8) -> u8 = Wrap::<i32>::conv::<u8>;
    if (f(7) != 7) { return 1; }
    const g: (u16) -> u16 = Wrap::<i64>::conv;
    if (g(9) != 9) { return 2; }
    const w: Wrap<i32> = Wrap::<i32> { v: 3 };
    const k: (&Wrap<i32>, u8) -> i32 = Wrap::<i32>::keep::<u8>;
    if (k(&w, 1) != 3) { return 3; }
    // The owner's argument bound by the expected type alone.
    const k2: (&Wrap<i32>, u16) -> i32 = Wrap::keep::<u16>;
    if (k2(&w, 2) != 3) { return 4; }
    const k3: (&Wrap<i32>, i64) -> i32 = Wrap::keep;
    if (k3(&w, 5) != 3) { return 5; }
    const mk: (i64, u8) -> i64 = Wrap::make;
    if (mk(11, 0) != 11) { return 6; }
    if (through::<i32>(4) != 4) { return 7; }
    if (through::<u64>(8) != 8) { return 8; }
    return 0;
}
