namespace MatchArmWidensByItsOwnSign;

// A match arm whose value is narrower than the match widens by the arm
// value's own signedness: an unsigned arm is zero-extended into a signed
// match, a signed arm is sign-extended.

function pick_u32(k: i32, big: u32) -> i64 {
    const r: i64 = match (k) {
        0 => { big }
        _ => { 0 }
    };
    return r;
}

function pick_u8(k: i32, byte: u8) -> i32 {
    return match (k) {
        0 => { 1 }
        _ => { byte }
    };
}

function pick_i32(k: i32, small: i32) -> i64 {
    const r: i64 = match (k) {
        0 => { small }
        _ => { 0 }
    };
    return r;
}

// A `static match` reduced to one arm widens that arm's value the same way.
function widened<T>(big: u32) -> i64 {
    const r: i64 = static match (T) {
        i32 => { big }
        _   => { 0 }
    };
    return r;
}

function main() -> i32 {
    if (pick_u32(0, 4294967295) != 4294967295) { return 1; }
    if (pick_u8(1, 255) != 255) { return 2; }
    if (pick_i32(0, -1) != -1) { return 3; }
    if (widened::<i32>(4294967295) != 4294967295) { return 4; }
    return 0;
}
