/// A class with constructors of two arities is built through each, by
/// `new` and by value; each call's arguments meet the constructor of its
/// own arity.
namespace ClassConstructorOverloadsByArity::Main;

type class Two {
public:
    a: i32;
    b: i64;
    Two(a: i32) { this.a = a; this.b = 0; }
    Two(a: i32, b: i64) { this.a = a; this.b = b; }
}

function main() -> i32 {
    const t1: Two* = new Two(1);
    const t2: Two* = new Two(2, 5);
    const v2: Two = Two(3, 6);
    return t1.a + t2.a + (t2.b as i32) + v2.a;
}
