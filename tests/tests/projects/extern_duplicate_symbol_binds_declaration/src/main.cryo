namespace ExtDup::Main;

import ExtDup::First;
import ExtDup::Second;
import ExtDup::Second::{ llabs };

function main() -> int {
    // -(2^32 + 5): an i64 call answers 2^32 + 5; an i32 call truncates the
    // argument to -5, answers 5, and sign-extends it back.
    const big: i64 = -4294967301;
    const r: i64 = llabs(big);
    return if (r == 4294967301) { 7 } else { 3 };
}
