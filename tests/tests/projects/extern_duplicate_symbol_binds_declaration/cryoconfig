# extern_duplicate_symbol_binds_declaration - two extern blocks declare one C
# symbol with different Cryo signatures; a call binds the declaration the
# name layer stamped, not the first block registered.
#
# `first.cryo` declares `llabs(i32) -> i32`, `second.cryo` declares
# `llabs(i64) -> i64`, and `main.cryo` imports `second`'s and calls it with
# an i64 the i32 signature would truncate.  A callee pinned by SYMBOL alone
# cannot tell the two apart, and codegen took the first block's signature:
# `call i32 @llabs(i32 %trunc)`, exit 3 where 7 is correct.
[project]
project_name = "extern_duplicate_symbol_binds_declaration"
output_dir   = "build"
target_type  = "executable"
source_dir   = "src"
entry_point  = "src/main.cryo"
[compiler]
[dependencies]
