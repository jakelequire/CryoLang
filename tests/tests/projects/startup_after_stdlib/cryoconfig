# startup_after_stdlib - globals computed at program start read globals the stdlib computes at program start (`stdio::NEWLINE`, `request::HTTP_VERSION`, `char::MAX`), so the program's startup code must run after the stdlib's; the link log names the order the startup code runs in, where `std::core::primitives`, which `std::net::http::request` imports, runs before it.
[project]
project_name = "startup_after_stdlib"
output_dir   = "build"
target_type  = "executable"
source_dir   = "src"
entry_point  = "src/main.cryo"
