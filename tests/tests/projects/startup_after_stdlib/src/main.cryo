namespace startup_after_stdlib;

import std::io::stdio;
import std::net::http::request;

// Each is computed when the program starts, from a global the stdlib also
// computes then: read before the stdlib's startup code ran, each is 0.
const NEWLINE_LENGTH: i64 = stdio::NEWLINE.length();
const VERSION_LENGTH: i64 = request::HTTP_VERSION.length();
const LAST_SCALAR: u32 = char::MAX as u32;

function main() -> i32 {
    if (NEWLINE_LENGTH != 1) { return 1; }
    if (VERSION_LENGTH != 8) { return 2; }
    if (LAST_SCALAR != 1114111) { return 3; }
    return 0;
}
