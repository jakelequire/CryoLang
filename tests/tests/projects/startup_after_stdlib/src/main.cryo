namespace startup_after_stdlib;

import std::collections::str::{ Str };
import std::io::stdio;
import std::log::logger::{ Logger };
import std::log::record::{ LogLevel };
import std::net::http::request;

// Each is computed when the program starts, from a global the stdlib also
// computes then: read before the stdlib's startup code ran, each is 0, and
// no level is let through.
const NEWLINE_LENGTH: i64 = stdio::NEWLINE.length();
const VERSION_LENGTH: i64 = request::HTTP_VERSION.length();
const WARNINGS_ENABLED: boolean = Logger::new(Str::new("startup")).is_enabled(LogLevel::Warning);
// A type's constant made of a literal is folded: nothing computes it at
// startup.
const LAST_SCALAR: u32 = char::MAX as u32;

function main() -> i32 {
    if (NEWLINE_LENGTH != 1) { return 1; }
    if (VERSION_LENGTH != 8) { return 2; }
    if (!WARNINGS_ENABLED) { return 3; }
    if (LAST_SCALAR != 1114111) { return 4; }
    return 0;
}
