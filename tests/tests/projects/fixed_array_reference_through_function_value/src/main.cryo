namespace FixedArrayReferenceThroughFunctionValue;

// A by-value argument in a `&T` parameter of a function VALUE is passed by
// address, as at a direct call.  A fixed-size array has no value-to-pointer
// coercion at the call, so it reaches the callee only that way: an
// `Array<[i32; 2]>` instantiates the iterator's `find`/`filter`, whose
// predicates take `&Item`.  A `string` item is itself a pointer, so passing
// the value where its address belongs compiles and is wrong.

function first<T>(xs: [T]) -> T {
    return xs[0];
}

function second_big(a: &[i32; 2]) -> boolean {
    return a[1] > 10;
}

function above(limit: i32, x: &[i32; 2]) -> boolean {
    return x[0] > limit;
}

function is_cd(s: &string) -> boolean {
    return *s == "cd";
}

function apply(f: (&[i32; 2]) -> boolean, v: [i32; 2]) -> boolean {
    return f(v);
}

function apply2(f: (i32, &[i32; 2]) -> boolean, v: [i32; 2]) -> boolean {
    return f(10, v);
}

function apply_str(f: (&string) -> boolean, v: string) -> boolean {
    return f(v);
}

function main() -> i32 {
    const rows: [[i32; 2]] = [[1, 2], [3, 4]];
    const row: [i32; 2] = first(rows);
    mut r: i32 = row[1];
    if (apply(second_big, [1, 20])) { r = r + 4; }
    if (!apply(second_big, [30, 2])) { r = r + 8; }
    if (apply2(above, [11, 0])) { r = r + 16; }
    if (!apply2(above, [9, 0])) { r = r + 32; }
    const words: [string] = ["ab", "cd", "ef"];
    match (words.iter().find(is_cd)) {
        Option::Some(w) => { if (w == "cd") { r = r + 64; } }
        Option::None    => { }
    }
    if (apply_str(is_cd, "cd")) { r = r + 1; }
    return r;
}
