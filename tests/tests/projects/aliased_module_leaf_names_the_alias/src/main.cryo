namespace Main;

// A module imported under an alias is named by the alias alone, so a path
// through its own leaf is a module this file does not reach (E0240).  The
// report names the alias the module is imported under, at a type path and
// at a call path.

import std::collections::hashmap as maps;
import std::core::mem as memory;

function main() -> i32 {
    const through_alias: maps::HashMap<i64, i64> = maps::HashMap::<i64, i64>::new();
    const through_leaf: hashmap::HashMap<i64, i64> = maps::HashMap::<i64, i64>::new();
    mut a: i64 = 1;
    mut b: i64 = 2;
    mem::swap(&a, &b);
    return (through_alias.length() + through_leaf.length()) as i32;
}
