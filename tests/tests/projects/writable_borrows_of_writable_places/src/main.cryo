namespace WritableBorrows;
import std::core::ops::{ Index, IndexMutable };

type struct Counted {
    slot: i32;
    calls: i32*;
}

implement trait Index<i64, i32> for struct Counted {
    index(&this, i: i64) -> const i32* {
        *this.calls = *this.calls + 1;
        return &this.slot;
    }
}

implement trait IndexMutable<i64, i32> for struct Counted {
    index_mutable(mut &this, i: i64) -> i32* {
        *this.calls = *this.calls + 10;
        return &this.slot;
    }
}

type trait Shape {
    scale(mut &this, k: i32) -> void;
}

type struct Square {
    side: i32;
}

implement trait Shape for struct Square {
    scale(mut &this, k: i32) -> void { this.side = this.side * k; }
}

function write_through(p: i32*, v: i32) -> void { *p = v; }
function write_borrow(r: mut &i32, v: i32) -> void { *r = v; }
function read_through(p: const i32*) -> i32 { return *p; }
function resize(s: virtual mut &Shape) -> void { s.scale(2); }

function main() -> i32 {
    mut a: i32 = 1;
    write_through(&a, 2);
    if (a != 2) { return 1; }
    write_borrow(&a, 3);
    if (a != 3) { return 2; }

    const b: i32 = 4;
    if (read_through(&b) != 4) { return 3; }
    const read_only: const i32* = &b;
    if (*read_only != 4) { return 4; }

    mut calls: i32 = 0;
    mut c: Counted = Counted { slot: 5, calls: &calls };
    write_through(&c[0], 6);
    if (c.slot != 6 || calls != 10) { return 5; }
    if (read_through(&c[0]) != 6 || calls != 11) { return 6; }

    mut s: Square = Square { side: 2 };
    resize(&s);
    if (s.side != 4) { return 7; }

    const r: &i32 = &a;
    const escaped: i32* = r as i32*;
    if (*escaped != 3) { return 8; }
    return 0;
}
