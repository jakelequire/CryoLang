# writable_borrows_of_writable_places - `&x` taken where write access is
# wanted (a `T*`, a `mut &T`, a `virtual mut &Trait`) is a writable borrow
# of a writable place, and `&x` taken where a `const T*` is wanted is a
# read-only one, of a `const` binding too.  `&c[i]` borrowed for writing
# goes through `index_mutable` and borrowed for reading through `index`:
# the container's `index` adds 1 to a counter and `index_mutable` 10, so the
# counter tells which ran.  A `&T` reaches a writable `T*` only through `as`.
# The exit code names the first check that failed.
[project]
project_name = "writable_borrows_of_writable_places"
output_dir   = "build"
target_type  = "executable"
source_dir   = "src"
entry_point  = "src/main.cryo"
[compiler]
[dependencies]
