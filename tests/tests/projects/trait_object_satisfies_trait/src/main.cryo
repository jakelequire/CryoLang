namespace TraitObjectSatisfiesTrait::Main;

import TraitObjectSatisfiesTrait::Counters::{ Base, Big, Counter, Seven, Source, Tally };
import TraitObjectSatisfiesTrait::Keepers::{ bump_all, described, ident, Keeper, taken, Wrap };

// A trait object satisfies a bound of its own trait and of each of its
// supertraits: a generic struct or function instantiated at an object
// calls each bounded method through the object's table, so one instance
// serves every implementation.  The exit code names the first check that
// answered wrong.

function main() -> i32 {
    mut t: Tally = Tally { n: 1 };
    mut b: Big = Big { n: 2 };
    // Two implementations through one instance, `Keeper<virtual mut &Counter>`.
    mut k: Keeper<virtual mut &Counter> = Keeper::<virtual mut &Counter> { c: &t };
    if (k.add(2) != 3 + 6 + 7) { return 1; }
    if (t.n != 3) { return 2; }
    mut kb: Keeper<virtual mut &Counter> = Keeper::<virtual mut &Counter> { c: &b };
    // Big's override of the default `twice`, reached through the table.
    if (kb.add(1) != 12 + 1000 + 9) { return 3; }
    // A raw object meets the bound as well.
    const p: virtual Counter* = &t as Tally*;
    mut kp: Keeper<virtual Counter*> = Keeper::<virtual Counter*> { c: p };
    if (kp.add(1) != 4 + 8 + 7) { return 4; }
    // `B: Base` met by an object of the subtrait `Counter`, by value.
    const sub: virtual &Counter = &t;
    if (ident::<virtual &Counter>(sub) != 7) { return 5; }
    const whole: virtual &Base = &b;
    if (ident(whole) != 9) { return 6; }
    // A growable array of objects, each element bumped through its table.
    const all: [virtual mut &Counter] = [&t, &b];
    if (bump_all::<virtual mut &Counter>(&all, 1) != 5 + 22) { return 7; }
    if (t.n != 5 || b.n != 22) { return 8; }
    // `S::Item` with `S` an object is the object's argument.
    const s: Seven = Seven { extra: 3 };
    const so: virtual &Source<i64> = &s;
    const got: i64 = taken::<virtual &Source<i64>>(&so);
    if (got != 10) { return 9; }
    // An implementation bounded on `T: Base` applies to `Wrap<virtual &Counter>`.
    const w: Wrap<virtual &Counter> = Wrap::<virtual &Counter> { inner: &b };
    if (described(&w) != 900) { return 10; }
    // A borrowed object meets a bound with a `mut &this` method, as a call
    // of that method on it is accepted.
    mut ks: Keeper<virtual &Counter> = Keeper::<virtual &Counter> { c: &t };
    if (ks.add(1) != 6 + 12 + 7 || t.n != 6) { return 11; }
    return 0;
}
