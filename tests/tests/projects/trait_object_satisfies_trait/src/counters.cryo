namespace TraitObjectSatisfiesTrait::Counters;

type trait Base {
    id(&this) -> i32;
}

/// `twice` is a default the table holds: an object reaches Big's override.
type trait Counter : Base {
    bump(mut &this, by: i32) -> void;
    get(&this) -> i32;
    twice(&this) -> i32 { return this.get() * 2; }
}

type trait Source {
    type Item;
    take(&this) -> This::Item;
}

type struct Tally {
    n: i32;
}

implement trait Base for Tally {
    id(&this) -> i32 { return 7; }
}

implement trait Counter for Tally {
    bump(mut &this, by: i32) -> void { this.n = this.n + by; }
    get(&this) -> i32 { return this.n; }
}

type struct Big {
    n: i64;
}

implement trait Base for Big {
    id(&this) -> i32 { return 9; }
}

implement trait Counter for Big {
    bump(mut &this, by: i32) -> void { this.n = this.n + (by as i64) * 10; }
    get(&this) -> i32 { return this.n as i32; }
    twice(&this) -> i32 { return 1000; }
}

type struct Seven {
    extra: i64;
}

implement trait Source for Seven {
    type Item = i64;
    take(&this) -> i64 { return 7 + this.extra; }
}
