namespace TraitObjectSatisfiesTrait::Keepers;

import TraitObjectSatisfiesTrait::Counters::{ Base, Counter, Source };

/// A generic struct whose bounded calls, in an instance at an object, go
/// through the object's table.
type struct Keeper<C> where C: Counter {
    c: C;

    add(mut &this, by: i32) -> i32 {
        this.c.bump(by);
        return this.c.get() + this.c.twice() + this.c.id();
    }
}

type trait Describe {
    describe(&this) -> i32;
}

type struct Wrap<T> {
    inner: T;
}

/// An implementation whose bound an object meets applies to a `Wrap` of it.
implement<T> trait Describe for Wrap<T> where T: Base {
    describe(&this) -> i32 { return this.inner.id() * 100; }
}

/// A supertrait's bound, met by an object of the subtrait.
function ident<B>(b: B) -> i32 where B: Base {
    return b.id();
}

function bump_all<C>(cs: &[C], by: i32) -> i32 where C: Counter {
    mut sum: i32 = 0;
    for (mut i: i64 = 0; i < cs.length(); i++) {
        mut c: C = cs[i];
        c.bump(by);
        sum = sum + c.get();
    }
    return sum;
}

/// The associated type of an object is its own type argument.
function taken<S>(s: &S) -> S::Item where S: Source {
    return s.take();
}

function described<D>(d: &D) -> i32 where D: Describe {
    return d.describe();
}
