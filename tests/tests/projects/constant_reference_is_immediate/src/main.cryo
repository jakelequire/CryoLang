namespace ConstantReferenceIsImmediate;

const LIMIT: u16 = 40000;
const ENABLED: boolean = true;
const BASE: u8 = 100;
const WRAPPED: u8 = BASE + 200;
const HALF: f64 = 0.5;
const LETTER: char = 'Z';
const WIDE: i128 = -170141183460469231731687303715884105728;
const BIG: u128 = 0x10000000000000000000000000;
mut counter: i32 = 5;

type struct Gauge {
    const FULL: i64 = -3;
}

function read_through(p: u16*) -> u16 { return *p; }

function main() -> i32 {
    if (LIMIT != 40000 || !ENABLED || WRAPPED != 44) { return 1; }
    if (Gauge::FULL != -3 || u32::MAX != 4294967295 || i8::MIN != -128) { return 2; }

    // A constant still has an address, and the value behind it is the same.
    const p: u16* = &LIMIT;
    if (read_through(p) != LIMIT) { return 3; }

    // A mutable global is read at run time, never folded to its initializer.
    counter = counter + 2;
    if (counter != 7) { return 4; }

    const sum: i64 = (LIMIT as i64) + Gauge::FULL;
    if (sum != 39997) { return 5; }

    if (HALF + HALF != 1.0 || f64::INFINITY < f64::MAX || f32::EPSILON <= (0.0 as f32)) { return 6; }

    // A constant written as a match pattern is compared by its value.
    const probe: u16 = 40000;
    const matched: i32 = match (probe) {
        LIMIT => { 1 }
        _     => { 0 }
    };
    if (matched != 1) { return 7; }

    // Characters and 128-bit integers fold as the narrower integers do.
    if (LETTER != 'Z' || (char::MAX as u32) != 1114111 || (char::MIN as u32) != 0) { return 8; }
    const letter_hits: i32 = match ('Z') {
        LETTER => { 1 }
        _      => { 0 }
    };
    if (letter_hits != 1) { return 9; }
    if (WIDE != i128::MIN || BIG >> 100 != 1 || i128::MAX != 170141183460469231731687303715884105727) { return 10; }
    return 0;
}
