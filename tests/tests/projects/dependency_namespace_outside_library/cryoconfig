# dependency_namespace_outside_library - a library has one top-level
# namespace, the one its lib.cryo declares, and every file of it declares
# that namespace or one below it.  `sprawl` declares `Sprawl` in lib.cryo
# and `Sprawl::inner` beside it, which are its own; `Helper` and
# `Sprawling` (which only begins with `Sprawl`) are outside it: E0510 for
# each, before any import is resolved.
[project]
project_name = "dependency_namespace_outside_library"
output_dir   = "build"
target_type  = "executable"
source_dir   = "src"
entry_point  = "src/main.cryo"

[compiler]

[dependencies]
sprawl = { path = "sprawl" }
