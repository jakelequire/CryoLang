# generic_owner_index_is_typed - `this[i]` and `this.index(i)` inside an
# implementation for a generic type are typed as the element and the
# element pointer, so a method called on the element is the element type's.
# A project rather than a unit-test file because a compiler that leaves them
# untyped stops at the method call, which would stop the whole unit suite
# from building.

[project]
project_name = "generic_owner_index_is_typed"
output_dir   = "build"
target_type  = "executable"
source_dir   = "src"
entry_point  = "src/main.cryo"

