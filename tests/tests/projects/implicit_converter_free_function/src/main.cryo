namespace Cv1::Main;


type struct Celsius { degrees: i32; }

// A free-function converter: an `i32` passed where a `Celsius` is expected
// becomes `to_celsius(value)`.
![implicit]
function to_celsius(value: i32) -> Celsius {
    return Celsius { degrees: value * 10 };
}

function show(c: Celsius) -> i32 { return c.degrees; }

function main() -> i32 {
    const d: i32 = show(4);
    if (d == 40) { return 0; }
    return 1;
}
