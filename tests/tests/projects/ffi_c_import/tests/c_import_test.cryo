///! FFI / C-import integration tests (Compiler::Bindgen).  An inline
///! `extern module cit := "C" { #include ... }` drives libclang to generate
///! real Cryo types and constants from a C header; these tests construct and
///! read them, proving the bindings round-trip through name/type resolution
///! and codegen.  Reached only through the import's alias namespace (`cit::`).

![config(testing)]
namespace FfiCImport::CImportTest;

import std::core::result;
import std::test::error;
import std::test::assert;

extern module cit := "C" {
    #include "../include/c_types.h"
}

// `struct Vec2 { int x; int y; }` -> a Cryo `type struct cit::Vec2` with i32
// fields, constructible and field-addressable.
![test]
function c_import_struct_construct_and_read() -> Result<(), TestError> {
    const v: cit::Vec2 = cit::Vec2 { x: 3 as i32, y: 4 as i32 };
    expect_eq(v.x + v.y, 7 as i32)?;
    return Result::Ok(());
}

// `typedef int Celsius;` -> a Cryo type alias usable in type position.
![test]
function c_import_typedef_alias() -> Result<(), TestError> {
    const c: cit::Celsius = 21 as i32;
    expect_eq(c, 21 as i32)?;
    return Result::Ok(());
}

// `enum Mode { MODE_OFF = 0, MODE_ON = 7 }` -> a Cryo enum whose explicit
// discriminant values round-trip.
![test]
function c_import_enum_value() -> Result<(), TestError> {
    expect_eq(cit::Mode::MODE_ON as i32, 7 as i32)?;
    return Result::Ok(());
}

// Anonymous `enum { FLAG_A = 1, FLAG_B = 2, ... }` -> one alias-namespaced
// global `const` per constant, reachable only as `cit::FLAG_A` (never bare).
![test]
function c_import_anon_enum_const() -> Result<(), TestError> {
    expect_eq((cit::FLAG_A + cit::FLAG_B) as i32, 3 as i32)?;
    return Result::Ok(());
}

// A negative anonymous-enum constant round-trips: emitted as its u64
// two's-complement bit pattern, truncated to the const's `int` width.
![test]
function c_import_anon_enum_negative() -> Result<(), TestError> {
    expect_eq(cit::FLAG_NEG as i32, -3 as i32)?;
    return Result::Ok(());
}

// Object-like `#define` numeric macros -> alias-namespaced `const`s.  Decimal
// (CIT_MAX) and hex (CIT_MASK = 0xFF = 255); the function-like macro (CIT_SQUARE)
// in the header is reported-and-skipped, not bound.
![test]
function c_import_define_int() -> Result<(), TestError> {
    expect_eq((cit::CIT_MAX + cit::CIT_MASK) as i32, 511 as i32)?;
    return Result::Ok(());
}

// A negative `#define` constant.
![test]
function c_import_define_negative() -> Result<(), TestError> {
    expect_eq(cit::CIT_NEG as i32, -3 as i32)?;
    return Result::Ok(());
}

// A floating-point `#define` constant -> an `f64` const (3.5 is exact).
![test]
function c_import_define_float() -> Result<(), TestError> {
    expect_eq(cit::CIT_HALF as f64, 3.5 as f64)?;
    return Result::Ok(());
}

// A string `#define` (`"cry\to"`) -> a `string` const whose C escapes are
// decoded: byte 0 is 'c' (99), byte 3 is a TAB (9), not the raw backslash (92).
![test]
function c_import_define_string() -> Result<(), TestError> {
    expect_eq(cit::CIT_NAME[0] as i32, 99 as i32)?;
    expect_eq(cit::CIT_NAME[3] as i32, 9 as i32)?;
    expect_eq(cit::CIT_NAME[4] as i32, 111 as i32)?;
    return Result::Ok(());
}

// Char `#define`s -> `char` consts carrying the code point: `'\n'` == 10 (the
// escape is decoded), `'A'` == 65.
![test]
function c_import_define_char() -> Result<(), TestError> {
    expect_eq(cit::CIT_NL as i32, 10 as i32)?;
    expect_eq(cit::CIT_LET as i32, 65 as i32)?;
    return Result::Ok(());
}

// A struct with bitfields: the `a:3`/`b:5` run collapses to one opaque storage
// blob, so the per-field map can't inflate the layout — sizeof stays 8 (the
// packed 4-byte unit + `c`), matching the C ABI.
![test]
function c_import_bitfield_layout() -> Result<(), TestError> {
    expect_eq(sizeof(cit::Bits) as i32, 8 as i32)?;
    return Result::Ok(());
}

// A C11 anonymous union member contributes storage with no FieldDecl; emitted as
// an aligned blob in place, so sizeof stays 8 (`tag` + the 4-byte union).
![test]
function c_import_anonymous_member_layout() -> Result<(), TestError> {
    expect_eq(sizeof(cit::Tagged) as i32, 8 as i32)?;
    return Result::Ok(());
}

// A named field of anonymous struct type maps to a layout-faithful blob (not a
// pointer-sized void*), so sizeof is 12 (`kind` + an 8-byte {x,y}), not 16.
![test]
function c_import_anonymous_typed_field_layout() -> Result<(), TestError> {
    expect_eq(sizeof(cit::Named) as i32, 12 as i32)?;
    return Result::Ok(());
}

// A top-level named C `union` -> a native Cryo `type union`: a literal sets
// exactly one member, members are accessed directly (`v.i`, no accessor method),
// and they overlay at offset 0 so sizeof is the largest member (4).
![test]
function c_import_union_native() -> Result<(), TestError> {
    const v: cit::Value = cit::Value { i: 1234 as i32 };
    expect_eq(v.i, 1234 as i32)?;
    expect_eq(sizeof(cit::Value) as i32, 4 as i32)?;
    return Result::Ok(());
}
