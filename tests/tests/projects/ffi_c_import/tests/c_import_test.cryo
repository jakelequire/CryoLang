///! FFI / C-import integration tests (Compiler::Bindgen).  An inline
///! `extern module cit := "C" { #include ... }` drives libclang to generate
///! real Cryo types and constants from a C header; these tests construct and
///! read them, proving the bindings round-trip through name/type resolution
///! and codegen.  Reached only through the import's alias namespace (`cit::`).

![config(testing)]
namespace FfiCImport::CImportTest;

import std::core::result;
import std::test::error;
import std::test::assert;

extern module cit := "C" {
    #include "../include/c_types.h"
}

// `struct Vec2 { int x; int y; }` -> a Cryo `type struct cit::Vec2` with i32
// fields, constructible and field-addressable.
![test]
function c_import_struct_construct_and_read() -> Result<(), TestError> {
    const v: cit::Vec2 = cit::Vec2 { x: 3 as i32, y: 4 as i32 };
    expect_eq(v.x + v.y, 7 as i32)?;
    return Result::Ok(());
}

// `typedef int Celsius;` -> a Cryo type alias usable in type position.
![test]
function c_import_typedef_alias() -> Result<(), TestError> {
    const c: cit::Celsius = 21 as i32;
    expect_eq(c, 21 as i32)?;
    return Result::Ok(());
}

// `enum Mode { MODE_OFF = 0, MODE_ON = 7 }` -> a Cryo enum whose explicit
// discriminant values round-trip.
![test]
function c_import_enum_value() -> Result<(), TestError> {
    expect_eq(cit::Mode::MODE_ON as i32, 7 as i32)?;
    return Result::Ok(());
}

// Anonymous `enum { FLAG_A = 1, FLAG_B = 2, ... }` -> one alias-namespaced
// global `const` per constant, reachable only as `cit::FLAG_A` (never bare).
![test]
function c_import_anon_enum_const() -> Result<(), TestError> {
    expect_eq((cit::FLAG_A + cit::FLAG_B) as i32, 3 as i32)?;
    return Result::Ok(());
}

// A negative anonymous-enum constant round-trips: emitted as its u64
// two's-complement bit pattern, truncated to the const's `int` width.
![test]
function c_import_anon_enum_negative() -> Result<(), TestError> {
    expect_eq(cit::FLAG_NEG as i32, -3 as i32)?;
    return Result::Ok(());
}

// Object-like `#define` numeric macros -> alias-namespaced `const`s.  Decimal
// (CIT_MAX) and hex (CIT_MASK = 0xFF = 255); the function-like (CIT_SQUARE) and
// string (CIT_NAME) macros in the header are reported-and-skipped, not bound.
![test]
function c_import_define_int() -> Result<(), TestError> {
    expect_eq((cit::CIT_MAX + cit::CIT_MASK) as i32, 511 as i32)?;
    return Result::Ok(());
}

// A negative `#define` constant.
![test]
function c_import_define_negative() -> Result<(), TestError> {
    expect_eq(cit::CIT_NEG as i32, -3 as i32)?;
    return Result::Ok(());
}

// A floating-point `#define` constant -> an `f64` const (3.5 is exact).
![test]
function c_import_define_float() -> Result<(), TestError> {
    expect_eq(cit::CIT_HALF as f64, 3.5 as f64)?;
    return Result::Ok(());
}
