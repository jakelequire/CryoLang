# ffi_c_import — an FFI / C-import test PROJECT exercised by the parent suite's
# projects meta-runner (outcome = "collect": build this package and run its own
# `![test]` functions; the project passes iff they all pass).
#
# This is the FFI/C-interop exemplar called out in docs/testing.md §7: an inline
# `extern module := "C" { #include ... }` import drives libclang to generate
# real Cryo types and constants, which the tests then construct and read.  The
# header is dependency-free and declares NO functions, so there is nothing to
# link — the package builds and runs as a normal executable.

[project]
project_name = "ffi_c_import"
output_dir   = "build"
target_type  = "executable"
source_dir   = "src"
entry_point  = "src/main.cryo"

