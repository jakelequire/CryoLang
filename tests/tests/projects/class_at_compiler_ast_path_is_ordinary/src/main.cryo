namespace compiler::ast::node;

// A program's own class that lives at the path the compiler's AST base class
// has.  What allocates a class is said by an `Allocate` it implements, never
// by its path, so `new` here takes the ordinary allocator.

type class ASTNode {
public:
    kind: i32;
    ASTNode(k: i32) { this.kind = k; }
}

function main() -> i32 {
    const n: ASTNode* = new ASTNode(7);
    return n.kind - 7;
}
