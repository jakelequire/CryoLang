namespace ForOverBoundedParameterIterator;

import std::core::option::{ Option };
import std::core::iter::{ Iterator };

// A `for` loop's scrutinee is an iterator when its type implements the
// language's `Iterator`.  A type parameter does when a `where` bound in scope
// gives it the trait: the function's, the method's own, or the bound the
// owner's declaration writes on its parameter.

type struct Up {
    cur: i32;
    end: i32;
}

implement trait Iterator<i32> for struct Up {
    next(mut &this) -> Option<i32> {
        if (this.cur >= this.end) { return Option::None; }
        const v: i32 = this.cur;
        this.cur = this.cur + 1;
        return Option::Some(v);
    }
}

function total<I>(parts: I) -> i32 where I: Iterator<i32> {
    mut out: i32 = 0;
    for (piece in parts) { out = out + piece; }
    return out;
}

type struct Summer {
    base: i32;

    total<I>(&this, parts: I) -> i32 where I: Iterator<i32> {
        mut out: i32 = this.base;
        for (piece in parts) { out = out + piece; }
        return out;
    }
}

type struct Counter<I> where I: Iterator<i32> {
    scale: i32;

    weigh(&this, parts: I) -> i32 {
        mut out: i32 = 0;
        for (piece in parts) { out = out + piece * this.scale; }
        return out;
    }
}

function main() -> i32 {
    if (total(Up { cur: 0, end: 4 }) != 6) { return 1; }
    const s: Summer = Summer { base: 100 };
    if (s.total(Up { cur: 0, end: 4 }) != 106) { return 2; }
    const c: Counter<Up> = Counter::<Up> { scale: 10 };
    if (c.weigh(Up { cur: 1, end: 4 }) != 60) { return 3; }
    return 0;
}
