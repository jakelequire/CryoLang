/// An addition past `i64::MAX` in an optimized build whose profile table
/// asks for overflow checks: a panic, not a wrapped sum.
namespace OverflowChecksSetByAProfileTable;

import std::fmt;
import std::env;

function main() -> int {
    const count: i64 = env::args().length();
    const total: i64 = i64::MAX - 1 + count;
    fmt::println(f"total {total}");
    fmt::println(f"next {total + 1}");
    return 0;
}
