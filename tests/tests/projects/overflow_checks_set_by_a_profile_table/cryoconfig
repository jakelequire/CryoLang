# overflow_checks_set_by_a_profile_table - built and RUN (outcome = "run")
# in the default `release` profile, whose `[profile.release]` table turns
# `overflow_checks` on: the table's setting wins over the profile's own
# default, and the optimization level has no part in it.

[project]
project_name = "overflow_checks_set_by_a_profile_table"
output_dir   = "build"
target_type  = "executable"
source_dir   = "src"
entry_point  = "src/main.cryo"

[profile.release]
overflow_checks = true

