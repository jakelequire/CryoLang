///! A literal converts through its `![implicit]` converter where a `Str`
///! or a `String` is declared for it: a returned value against the return
///! type, an assigned value against the place's type, and a struct
///! literal's field and a field's default against the field's type.

namespace LiteralConvertsAtReturnAssignmentAndField;

import std::collections::str::{ Str };
import std::collections::string::{ String };
import std::fmt::{ println };

function returned_view() -> Str { return "returned"; }
function returned_owned() -> String { return "owned return"; }

/// A holder of text in both forms, one field with a default.
type struct TextHolder {
    view:  Str;
    owned: String;
    label: Str = "default label";
}

function main() -> i32 {
    const view_back: Str = returned_view();
    const owned_back: String = returned_owned();
    println(f"return: {view_back} / {owned_back}");

    mut view: Str = Str::new("before");
    view = "assigned";
    mut owned: String = String::from("before");
    owned = "assigned owned";
    println(f"assignment: {view} / {owned}");

    const holder: TextHolder = TextHolder { view: "field", owned: "owned field" };
    println(f"field: {holder.view} / {holder.owned}");
    println(f"default: {holder.label}");
    return 0;
}
