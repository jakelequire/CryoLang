namespace MemberVis::Gauge;

public type struct Meter {
    private level: i64;

    public static new(level: i64) -> Meter {
        return Meter { level: level };
    }

    ![inline]
    public reading(&this) -> i64 {
        return this.level;
    }

    ![inline]
    private raw(&this) -> i64 {
        return this.level * 2;
    }

    ![inline]
    private static zero() -> Meter {
        return Meter { level: 0 };
    }
}
