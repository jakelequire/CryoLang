# generic_bare_name_infers_in_own_body - a generic type's bare name inside
# its own body infers its arguments from the call (`Pair::make(x, x)` in
# `Pair<T>::twin<U>` makes a `Pair<U>`), and `This::` names the enclosing
# type with its own parameters, in an implement block and in the type's
# declaration.  Exits 0; each wrong answer exits with its own code.
[project]
project_name = "generic_bare_name_infers_in_own_body"
output_dir   = "build"
target_type  = "executable"
source_dir   = "src"
entry_point  = "src/main.cryo"
