namespace GenericBareNameInfersInOwnBody::Main;

type struct Pair<T> { a: T; b: T; }

implement struct Pair<T> {
    static make(a: T, b: T) -> Pair<T> {
        return Pair::<T> { a: a, b: b };
    }

    // A bare `Pair` inside `Pair<T>`'s own body infers its arguments from
    // the call: `Pair<U>` here, not the enclosing `Pair<T>`.
    twin<U>(&this, x: U) -> Pair<U> {
        return Pair::make(x, x);
    }

    // `This` is the enclosing `Pair<T>`.
    flipped(&this) -> Pair<T> {
        return This::make(this.b, this.a);
    }
}

// `This` in a method written in the type's own declaration.
type struct Cell<T> {
    v: T;

    static of(v: T) -> Cell<T> { return Cell::<T> { v: v }; }

    copy_of(&this) -> Cell<T> { return This::of(this.v); }
}

function main() -> i32 {
    const p: Pair<i32> = Pair::make(1, 2);
    const q: Pair<i64> = p.twin(7 as i64);
    const f: Pair<i32> = p.flipped();
    if (q.a != 7 || q.b != 7) { return 1; }
    if (f.a != 2 || f.b != 1) { return 2; }
    const c: Cell<u8> = Cell::of(9 as u8);
    const d: Cell<u8> = c.copy_of();
    if (d.v != 9) { return 3; }
    return 0;
}
