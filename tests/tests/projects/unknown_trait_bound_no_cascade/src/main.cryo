namespace UnknownTraitBoundNoCascade::Main;

/// `Nowhere` names no trait: refused where it is written.  A call that
/// instantiates `f` is not reported again for a bound the program has no
/// trait for.
function f<T>(x: &T) -> i32 where T: Nowhere { return 1; }

function main() -> i32 {
    const a: i32 = 5;
    return f::<i32>(&a) + f(&a);
}
