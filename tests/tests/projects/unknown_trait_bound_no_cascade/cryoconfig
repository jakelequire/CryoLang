# unknown_trait_bound_no_cascade - `where T: Nowhere` names no trait, and
# the bound is refused where it is written (E0242).  Calls that instantiate
# the function are not refused a second time for the same bound: the build
# reports exactly one error.  Before, each call added "the trait bound
# `i32: Nowhere` is not satisfied" (E0306).
[project]
project_name = "unknown_trait_bound_no_cascade"
output_dir   = "build"
target_type  = "executable"
source_dir   = "src"
entry_point  = "src/main.cryo"
[compiler]
[dependencies]
