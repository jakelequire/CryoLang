namespace ShiftLiteralTakesResultType;

function top_bit() -> u64 {
    return 1 << (u64::BITS - 1);
}

function identity(v: u64) -> u64 { return v; }

function main() -> i32 {
    const high: u64 = (u64::MAX >> 1) + 1;
    const amount: u32 = 40;

    const a: u64 = 1 << (u64::BITS - 1);
    if (a != high) { return 1; }

    mut b: u64 = 0;
    b = 1 << amount;
    if (b != 1099511627776) { return 2; }

    if (identity(1 << (u64::BITS - 1)) != high) { return 3; }
    if (top_bit() != high) { return 4; }

    const c: i64 = 1 << amount;
    if (c != 1099511627776) { return 5; }

    const d: u64 = 0xFF << amount;
    if (d >> amount != 255) { return 6; }

    // An amount within the amount's own width is unaffected.
    const e: u32 = 1 << (amount - 9);
    if (e != 2147483648) { return 7; }
    return 0;
}
