namespace DerefCallNamesMethodBeforeField::Counter;

// A field and a method of one name, the field private: outside this module
// only the method can be reached.
public type struct Tally {
    private count: i64;
    public step: (i64) -> i64;

    public static new(count: i64, step: (i64) -> i64) -> Tally {
        return Tally { count: count, step: step };
    }

    public count(&this) -> i64 {
        return this.count;
    }
}
