namespace DerefCallNamesMethodBeforeField::Main;

import DerefCallNamesMethodBeforeField::Counter::{ Tally };
import std::core::ops::{ Deref };

// A call through `Deref` names the pointee's method before its field of the
// same name, as a call on the pointee itself does; a pointee with only a
// callable field of the name still has the field called.  The exit code
// names the first call that answered wrong.
type struct Holder {
    tally: Tally;
}

implement trait Deref for struct Holder {
    type Target = Tally;
    deref(&this) -> const Tally* { return &this.tally; }
}

function double(n: i64) -> i64 { return n * 2; }

function main() -> i32 {
    const holder: Holder = Holder { tally: Tally::new(7, double) };
    if (holder.tally.count() != 7) { return 1; }
    if (holder.count() != 7) { return 2; }
    if (holder.step(5) != 10) { return 3; }
    return 0;
}
