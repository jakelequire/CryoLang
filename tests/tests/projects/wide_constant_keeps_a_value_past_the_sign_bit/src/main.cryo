// A 128-bit constant read as an immediate keeps its value when the value's
// 64-bit pattern has its top bit set: `u64::MAX` in a `u128` is positive and
// extends with zeros, while a negative `i128` such as `i64::MIN` extends
// with ones.  A module-level constant is read this way; a local one gives
// the same values whether it is read so or loaded.
import std::fmt;

namespace WideConstantKeepsAValuePastTheSignBit::Main;

const TWO_POW_64: u128 = 18446744073709551616;
const MODULE_U64_MAX: u128 = 18446744073709551615;
const MODULE_TWO_POW_63: u128 = 9223372036854775808;
const MODULE_I64_MIN: i128 = -9223372036854775808;

function keep<T>(value: T) -> T { return value; }

function main() -> i32 {
    const local_u64_max: u128 = 18446744073709551615;
    const local_i64_min: i128 = -9223372036854775808;
    const from_module: u128 = keep(TWO_POW_64) - MODULE_U64_MAX;
    const from_local: u128 = keep(TWO_POW_64) - local_u64_max;
    const half: u128 = MODULE_TWO_POW_63 + keep(MODULE_TWO_POW_63);
    const below: i128 = keep(MODULE_I64_MIN) + local_i64_min;
    fmt::println(f"module {from_module} local {from_local} half {half} below {below}");
    return 0;
}
