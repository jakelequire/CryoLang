namespace GenericLiteralInOwnBodyTypedByOwnerArguments::Main;

import std::fmt;

type struct Box<T> {
    f0: T;

    static make(p0: T) -> T {
        return p0;
    }

    // Inside `Box<T>`'s own body, a bare `Box { .. }` passed where
    // `Box::<Box<u8>>::make` takes its `T` is the `Box<u8>` the call's owner
    // arguments name, not the body's own `Box<T>`.
    nested(&this, x: u8) -> u8 {
        const inner: Box<u8> = Box::<Box<u8>>::make(Box { f0: x });
        return inner.f0;
    }

    placeholder(&this, x: u8) -> u8 {
        const inner: Box<u8> = Box::<Box<u8>>::make(Box::<_> { f0: x });
        return inner.f0;
    }

    // The owner's argument names a wider instance than the field alone
    // would bind, so the `u8` field value widens to it.
    widened(&this, x: u8) -> u16 {
        const inner: Box<u16> = Box::<Box<u16>>::make(Box { f0: x });
        return inner.f0;
    }
}

function main() -> i32 {
    const x: u8 = 3;
    const outside: Box<u8> = Box::<Box<u8>>::make(Box { f0: x });
    const holder: Box<i64> = Box::<i64> { f0: 9 };
    fmt::println(f"{outside.f0} {holder.nested(x)} {holder.placeholder(5)} {holder.widened(200)}");
    return 0;
}
