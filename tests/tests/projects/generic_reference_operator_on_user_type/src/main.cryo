namespace GenericReferenceOperatorOnUserType::Main;

import std::core::cmp;

type struct V2 { x: i32; }

implement trait cmp::Eq for struct V2 {
    equals(&this, other: &V2) -> boolean { return this.x == other.x; }
}
implement trait cmp::Ord for struct V2 {
    compare(&this, other: &V2) -> cmp::Ordering {
        if (this.x < other.x) { return cmp::Ordering::Less; }
        if (this.x > other.x) { return cmp::Ordering::Greater; }
        return cmp::Ordering::Equal;
    }
}

function same<T>(a: &T, b: &T) -> boolean where T: cmp::Eq { return a == b; }
function differ<T>(a: &T, b: &T) -> boolean where T: cmp::Eq { return a != b; }
function less<T>(a: &T, b: &T) -> boolean where T: cmp::Ord { return a < b; }
function at_least<T>(a: &T, b: &T) -> boolean where T: cmp::Ord { return a >= b; }

function main() -> i32 {
    const p: V2 = V2 { x: 1 };
    const p2: V2 = V2 { x: 1 };
    const q: V2 = V2 { x: 2 };
    if (!same::<V2>(&p, &p2)) { return 1; }
    if (same::<V2>(&p, &q)) { return 2; }
    if (differ::<V2>(&p, &p2)) { return 3; }
    if (!differ::<V2>(&p, &q)) { return 4; }
    if (!less::<V2>(&p, &q)) { return 5; }
    if (less::<V2>(&q, &p)) { return 6; }
    if (!at_least::<V2>(&p2, &p)) { return 7; }
    if (at_least::<V2>(&p, &q)) { return 8; }
    const m: i64 = 7;
    const k: i64 = 9;
    if (!same::<i64>(&m, &m)) { return 9; }
    if (same::<i64>(&m, &k)) { return 10; }
    if (!at_least::<i64>(&m, &m)) { return 11; }
    return 0;
}
