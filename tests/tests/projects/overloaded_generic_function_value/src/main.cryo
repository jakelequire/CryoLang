namespace OverloadedGenericFunctionValue;
import OverloadedGenericFunctionValue::lib;

function pick<T>(x: T) -> T { return x; }
function pick<T>(x: T, y: T) -> T { return y; }

function mix(x: i32) -> i32 { return x + 100; }
function mix<T>(x: T, y: T) -> T { return x; }

function apply2(f: (i64, i64) -> i64, a: i64, b: i64) -> i64 { return f(a, b); }

function twice<T>(x: T, y: T) -> T {
    const one: (T) -> T = pick::<T>;
    const two: (T, T) -> T = pick;
    return two(one(x), y);
}

function main() -> i32 {
    // The expected type chooses the overload, with or without a turbofish.
    const f: (i32) -> i32 = pick::<i32>;
    const g: (i32, i32) -> i32 = pick::<i32>;
    const h: (i64, i64) -> i64 = pick;
    if (f(5) != 5) { return 1; }
    if (g(1, 9) != 9) { return 2; }
    if (h(3, 4) != 4) { return 3; }
    // A function-typed parameter is an expected type.
    if (apply2(pick, 7, 8) != 8) { return 4; }
    // A generic overload beside a non-generic one.
    const m1: (i32) -> i32 = mix;
    const m2: (i32, i32) -> i32 = mix::<i32>;
    if (m1(1) != 101) { return 5; }
    if (m2(6, 2) != 6) { return 6; }
    // A module path.
    const p1: (u8) -> u8 = lib::sel::<u8>;
    const p2: (u8, u8) -> u8 = lib::sel::<u8>;
    if (p1(3) != 3) { return 7; }
    if (p2(3, 4) != 4) { return 8; }
    // Inside a generic body, for the body's own parameter.
    if (twice::<i32>(1, 2) != 2) { return 9; }
    if (twice::<u8>(5, 6) != 6) { return 10; }
    return 0;
}
