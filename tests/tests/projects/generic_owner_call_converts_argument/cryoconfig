# generic_owner_call_converts_argument - a call through a path whose owner
# is a generic type (`String::from_str("lit")`, `String<A = GlobalAlloc>`)
# has its arguments converted where it is written: the literal becomes the
# `Str` the parameter takes in the body as written, not only in the copy
# monomorphization binds the call in.
[project]
project_name = "generic_owner_call_converts_argument"
output_dir   = "build"
target_type  = "executable"
source_dir   = "src"
entry_point  = "src/main.cryo"
