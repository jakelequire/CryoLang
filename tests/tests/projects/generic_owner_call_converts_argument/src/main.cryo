namespace GenericOwnerCallConvertsArgument::Main;

import std::collections::string::{ String };

type struct Node { value: i64; tag: String; }

function tagged<T>(v: T) -> String {
    return String::from_str("generic");
}

function main() -> i32 {
    const s: String = String::from_str("outside");
    if (s.length() != 7) { return 1; }
    const lit: Node = Node { value: 1, tag: String::from_str("lit") };
    if (lit.tag.length() != 3) { return 2; }
    const n: Node* = new Node { value: 2, tag: String::from_str("node") };
    if (n.tag.length() != 4) { return 3; }
    delete n;
    if (tagged::<i32>(5).length() != 7) { return 4; }
    return 0;
}
