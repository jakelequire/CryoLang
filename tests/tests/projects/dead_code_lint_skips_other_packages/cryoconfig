# dead_code_lint_skips_other_packages - the unused-code lints run on the
# package being built and on no other: the program's unused local is
# reported (W0001), the dependency's is not.  The dependency's code is its
# own package's to lint, when that package is built.
[project]
project_name = "dead_code_lint_skips_other_packages"
output_dir   = "build"
target_type  = "executable"
source_dir   = "src"
entry_point  = "src/main.cryo"

[compiler]

[dependencies]
lender = { path = "lender", alias = "Lender" }
