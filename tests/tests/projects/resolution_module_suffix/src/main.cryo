/// A module-suffix scope (`Text::tag()`) must name the module this file
/// IMPORTED, not one picked from the module graph by scan order.
///
/// Two modules end in `::Text` and two end in `::Code`; this file imports
/// `Beta::Text` and `Alpha::Code`, so the two leaves must resolve to
/// OPPOSITE parents.  A resolver that scans the graph and keeps the first
/// match — or breaks the tie by shared prefix with whatever module it is
/// standing in — has one global order to give, so it cannot satisfy both.
/// Whichever order it enumerates in, one of the two answers is wrong, which
/// is what makes the exit code independent of filesystem enumeration order.
///
/// `Only::ping` is the public control: one module ends in `::Only`, so
/// suffix resolution must keep answering it. A gate that rejects it has
/// stopped resolving module-suffix scopes rather than resolving them
/// against the imports.
namespace ResolutionModuleSuffix::Main;

import ResolutionModuleSuffix::Registry;
import ResolutionModuleSuffix::Beta::Text;
import ResolutionModuleSuffix::Alpha::Code;
import ResolutionModuleSuffix::Solo::Only;

function main(argc: int, argv: string*) -> int {
    // 6 + 30 + 1 = 37.  Sum, not three comparisons, so a wrong bind on
    // either leaf changes the exit code rather than being masked by the
    // other one passing.
    const total: i32 = Text::tag() + Code::val() + Only::ping();
    return total as int;
}
