/// Forces all four same-leaf modules into the module graph.
///
/// Module discovery is import-driven: a file nothing imports is never
/// compiled, so without this the probe's two candidates per leaf would
/// collapse to one and the program would bind correctly for a reason it is
/// not testing.  Every call here is written fully qualified, so this module
/// never asks the question `main` asks.
namespace ResolutionModuleSuffix::Registry;

import ResolutionModuleSuffix::Alpha::Text;
import ResolutionModuleSuffix::Beta::Text;
import ResolutionModuleSuffix::Alpha::Code;
import ResolutionModuleSuffix::Beta::Code;

public function witness() -> i32 {
    return ResolutionModuleSuffix::Alpha::Text::tag()
         + ResolutionModuleSuffix::Beta::Text::tag()
         + ResolutionModuleSuffix::Alpha::Code::val()
         + ResolutionModuleSuffix::Beta::Code::val();
}
