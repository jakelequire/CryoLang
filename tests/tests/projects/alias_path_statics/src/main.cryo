namespace alias_path_statics;

import alias_path_statics::shapes::{ Boxed, BoxU8 };

// A path through a type alias names what the same path through the alias's
// target names: `PI::plain(8)` is `Pl::<i32>::plain(8)`.  The target's type
// arguments come with it, so `PU::plain` takes a `u8`.

type struct Pl<T> {
    v: T;
}

implement<T> struct Pl<T> {
    static plain(x: T) -> T { return x; }
    static make(x: T) -> Pl<T> { return Pl::<T> { v: x }; }
    static width() -> u64 { return sizeof(T); }
    get(&this) -> T { return this.v; }
}

type PI = Pl<i32>;
type PU = Pl<u8>;
type PJ = PI;

type struct Flat { n: i32; }

implement struct Flat {
    static mk(n: i32) -> Flat { return Flat { n: n }; }
}

type FA = Flat;

type enum Color { Red; Green; }
type Hue = Color;

function main() -> i32 {
    if (PI::plain(8) != 8) { return 1; }
    const p: PI = PI::make(5);
    if (p.get() != 5) { return 2; }
    if (PU::width() != 1) { return 3; }
    if (PI::width() != 4) { return 4; }
    if (PJ::plain(9) != 9) { return 5; }
    if (FA::mk(4).n != 4) { return 6; }
    const h: Hue = Hue::Green;
    const shade: i32 = match (h) {
        Color::Red   => { 1 }
        Color::Green => { 2 }
    };
    if (shade != 2) { return 7; }
    if (Boxed::wrap(3).inner != 3) { return 9; }
    if (shapes::BoxU8::wrap(250).inner != 250) { return 10; }
    if (BoxU8::width() != 1) { return 11; }
    return 0;
}
