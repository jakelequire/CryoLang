namespace UnknownDirectiveSuggestionHelpOnly::Main;

// A misspelled directive is offered its nearest built-in as help alone when
// renaming it might not be accepted: the built-in takes arguments, the
// directive was written with arguments, or the built-in may not stand on
// the declaration it is written on.

![symbl]
function takes_arguments() -> i32 { return 1; }

![inlin(3)]
function written_with_arguments() -> i32 { return 2; }

![inlin]
type struct Placed { value: i32; }

function main() -> i32 {
    const p: Placed = Placed { value: 3 };
    return takes_arguments() + written_with_arguments() + p.value - 6;
}
