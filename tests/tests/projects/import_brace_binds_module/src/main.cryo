namespace ImportBraceBindsModule::Main;

import IbbmA::Toml::{ one };

// The brace import is the file's only import of `IbbmA::Toml`, and nothing
// imports `IbbmA::Toml::Sub`: the sub-module is loaded because a path here
// names it, through the module the brace import binds.
function main() -> i32 {
    if (one() != 1) { return 1; }
    if (Toml::one() != 1) { return 2; }
    if (Toml::Sub::three() != 3) { return 3; }
    return 0;
}
