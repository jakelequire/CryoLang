namespace GenericLiteralInOwnBodyInferredAtStaticCall::Main;

import std::fmt;

type struct Pixel {
    level: u8;
}

function peek<U>(b: Box<U>) -> U {
    return b.f0;
}

type struct Box<T> {
    f0: T;

    static make(p0: T) -> T {
        return p0;
    }

    // Inside `Box<T>`'s own body, `Box::make` written without the owner's
    // arguments infers them at the call: the bare literal is the `Box<Pixel>`
    // its field binds, so the owner is `Box<Box<Pixel>>`.
    inferred(&this, p: Pixel) -> u8 {
        const inner: Box<Pixel> = Box::make(Box { f0: p });
        return inner.f0.level;
    }

    // With nothing expected, the literal is the instance its field binds,
    // not the one the body belongs to.
    bound_by_field(&this, x: u16) -> u16 {
        return peek(Box { f0: x });
    }

    // A field given the body's own `T` binds the body's own instance.
    own_instance(&this) -> T where T: Copy {
        return peek(Box { f0: this.f0 });
    }
}

function main() -> i32 {
    const holder: Box<i64> = Box::<i64> { f0: 9 };
    fmt::println(f"{holder.inferred(Pixel { level: 4 })} {holder.bound_by_field(700)} {holder.own_instance()}");
    return 0;
}
