namespace BareOwnerInfersBeforeDefaults;

// `Defaulted::from(small, 1)` names an owner whose only parameter has a
// default, with no type arguments: `T` comes from `small: i8` (or from the
// expected type when no argument decides it), and the default `i64` fills
// it only when nothing at the call does - a literal argument included,
// whose own type is a guess and loses to the declared default.

import std::core::default::{ Default };

type struct Defaulted<T = i64> {
    value: T;
    static from<W>(value: T, marker: W) -> Defaulted<T> {
        return Defaulted::<T> { value: value };
    }
    static plain(value: T) -> Defaulted<T> {
        return Defaulted::<T> { value: value };
    }
    static zero() -> Defaulted<T> where T: Default {
        return Defaulted::<T> { value: T::default() };
    }
    static size() -> i64 {
        return 8;
    }
}

function main() -> i32 {
    const small: i8 = 5;
    const made: Defaulted<i8> = Defaulted::from(small, 1);
    if (made.value != 5) { return 1; }
    const plain = Defaulted::plain(small);
    const widened: i8 = plain.value;
    if (widened != 5) { return 2; }
    const literal = Defaulted::plain(7);
    const wide: i64 = literal.value;
    if (wide != 7) { return 3; }
    const zero = Defaulted::zero();
    const zero_value: i64 = zero.value;
    if (zero_value != 0) { return 4; }
    if (Defaulted::size() != 8) { return 5; }
    const expected: Defaulted<u8> = Defaulted::zero();
    if (expected.value != 0) { return 6; }
    return 0;
}
