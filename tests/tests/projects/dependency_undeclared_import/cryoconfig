# dependency_undeclared_import - a package names only its own modules, the
# standard library's, and those of the dependencies its own cryoconfig
# declares.  The program declares `courier` and `vault`; `courier` declares
# `parcel`.  The program importing `Parcel` (reached only through
# `courier`) and `courier` importing `Vault` (which only the program
# declares) are both refused with E0508, naming the package and the
# cryoconfig to add it to.  `courier`'s own import of `Parcel` stands.
[project]
project_name = "dependency_undeclared_import"
output_dir   = "build"
target_type  = "executable"
source_dir   = "src"
entry_point  = "src/main.cryo"

[compiler]

[dependencies]
courier = { path = "courier" }
vault   = { path = "vault" }
