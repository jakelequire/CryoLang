/// The ways an allow for the spelling lint can be written wrong, each refused
/// once, where it is written.
namespace compiler::resolver::symbol_str;

/// On a type: an allow wider than one declaration would cover the methods
/// written into it later, which never had a reason of their own.
![allow(lookup_by_spelling, reason = "every method of this type")]
type struct SymbolStr {
    id: u32;
}

/// The lint has two levels, denied and allowed with a reason.
![warn(lookup_by_spelling)]
function by_warn(name: SymbolStr) -> i32 {
    if (name.id == 1) { return 1; } return 0;
}

/// A misspelt key is refused as that, not also as a missing reason.
![allow(lookup_by_spelling, reasn = "a typo")]
function by_typo(name: SymbolStr) -> i32 {
    if (name.id == 1) { return 1; } return 0;
}

/// A reason is text.
![allow(lookup_by_spelling, reason = 42)]
function by_number(name: SymbolStr) -> i32 {
    if (name.id == 1) { return 1; } return 0;
}

function main() -> i32 {
    const s: SymbolStr = SymbolStr { id: 1 };
    return by_warn(s) + by_typo(s) + by_number(s);
}
