# primitive_abs_clamp_methods - `abs`, `checked_abs` and `clamp` are methods
# of each numeric primitive (`i32::abs`), not generic functions
# in `std::math`: `(-5 as i32).abs()`, `x.checked_abs()` answering `None`
# for the type's minimum, `x.clamp(lo, hi)` on signed, unsigned and float
# types.  The program exits 0; each wrong answer exits with its own code.
[project]
project_name = "primitive_abs_clamp_methods"
output_dir   = "build"
target_type  = "executable"
source_dir   = "src"
entry_point  = "src/main.cryo"
