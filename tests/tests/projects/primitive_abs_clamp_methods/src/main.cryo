namespace PrimitiveAbsClampMethods::Main;

import std::core::option;
import std::core::option::{ Option };

function main() -> i32 {
    if ((-5 as i32).abs() != 5) { return 1; }
    if ((-3 as i8).abs() != 3) { return 2; }

    match ((-9 as i64).checked_abs()) {
        Option::Some(m) => { if (m != 9) { return 3; } }
        Option::None    => { return 4; }
    }
    match (i32::min_value().checked_abs()) {
        Option::Some(_) => { return 5; }
        Option::None    => { }
    }
    match (i8::min_value().checked_abs()) {
        Option::Some(_) => { return 6; }
        Option::None    => { }
    }

    if ((150 as i32).clamp(0, 100) != 100) { return 7; }
    if ((-5 as i32).clamp(0, 100) != 0) { return 8; }
    if ((7 as u8).clamp(1, 5) != 5) { return 9; }
    if ((3 as u64).clamp(4, 9) != 4) { return 10; }
    if ((0.5 as f32).clamp(1.0 as f32, 2.0 as f32) != (1.0 as f32)) { return 11; }
    if ((2.5 as f64).clamp(0.0, 2.0) != 2.0) { return 12; }
    return 0;
}
