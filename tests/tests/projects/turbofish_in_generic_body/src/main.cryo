namespace turbofish_in_generic_body;

// Inside a generic function, a call that gives a generic owner's method its
// own type arguments returns in them, whether the method is declared in the
// type's body or in an `implement` block: `w.conv::<u32>(5)` on a `Wrap<A>`
// is a `u32`.  A return in the owner's parameter is the receiver's argument.

type struct Wrap<T> {
    v: T;
}

implement<T> struct Wrap<T> {
    conv<U>(&this, x: U) -> U { return x; }
    keep<U>(&this, x: U) -> T { return this.v; }
}

type struct Body<T> {
    v: T;
    conv<U>(&this, x: U) -> U { return x; }
    keep<U>(&this, x: U) -> T { return this.v; }
}

function via_impl<A>(w: Wrap<A>) -> u32 {
    return w.conv::<u32>(5);
}

function keep_impl<A>(w: Wrap<A>) -> A {
    return w.keep::<u8>(1);
}

function via_body<A>(b: Body<A>) -> u32 {
    return b.conv::<u32>(6);
}

function keep_body<A>(b: Body<A>) -> A {
    return b.keep::<u8>(1);
}

function main() -> i32 {
    const w: Wrap<i64> = Wrap::<i64> { v: 7 };
    const v: Wrap<u16> = Wrap::<u16> { v: 9 };
    const b: Body<i64> = Body::<i64> { v: 8 };
    if (via_impl::<i64>(w) != 5) { return 1; }
    if (via_impl::<u16>(v) != 5) { return 2; }
    if (keep_impl::<i64>(w) != 7) { return 3; }
    if (keep_impl::<u16>(v) != 9) { return 4; }
    if (via_body::<i64>(b) != 6) { return 5; }
    if (keep_body::<i64>(b) != 8) { return 6; }
    return 0;
}
