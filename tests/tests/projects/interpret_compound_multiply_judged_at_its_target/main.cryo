// `cryo interpret --overflow-checks=on` judges a compound assignment's
// overflow at its target's type, whatever the right side's width and sign,
// as the compiled program does: each product that reaches the target's
// bound is stored, and the first past it panics.

namespace Main;

import std::fmt;

function keep<T>(value: T) -> T {
    return value;
}

function main() -> i32 {
    const byte: u8 = keep(200 as u8);
    const minus_two: i8 = keep(-2 as i8);
    const word: u32 = keep(4294967295 as u32);
    const long: u64 = keep(u64::MAX);
    mut a: i16 = keep(16384 as i16);
    a *= minus_two;
    mut b: u16 = keep(327 as u16);
    b *= byte;
    mut c: i64 = keep(2147483648 as i64);
    c *= word;
    mut d: u128 = keep(u128::MAX / 18446744073709551615);
    d *= long;
    fmt::println(f"edges {a} {b} {c} {d}");
    mut past: i16 = keep(-16384 as i16);
    past *= minus_two;
    fmt::println("past the edge");
    return 0;
}
