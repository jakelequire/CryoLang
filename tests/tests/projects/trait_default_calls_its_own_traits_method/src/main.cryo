namespace TraitDefaultCallsItsOwnTraitsMethod;

type trait Named {
    id(&this) -> i32;
    tag(&this) -> i32 { return 70 + this.id(); }
}

type trait Solid : Named { id(&this) -> i32; }

type struct Brick { side: i32; }

implement trait Named for Brick { id(&this) -> i32 { return 1; } }
implement trait Solid for Brick { id(&this) -> i32 { return 11; } }

function main() -> i32 {
    const b: Brick = Brick { side: 2 };
    return b.tag();
}
