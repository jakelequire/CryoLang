namespace GenericInstanceFromUse::Main;

type class Cell<T> {
public:
    v: T;
    Cell(x: T) { this.v = x; }
    get(&this) -> T { return this.v; }
}

function first_ok<T>(r: Result<T, T>, d: T) -> T {
    return match (r) {
        Result::Ok(v)  => { v }
        Result::Err(_) => { d }
    };
}

function main() -> i32 {
    // A variant argument binds only what its payload carries; the call's
    // other arguments bind the rest.
    if (first_ok(Result::Ok(4), 9) != 4) { return 1; }
    if (first_ok(Result::Err(5), 9) != 9) { return 2; }

    // Type arguments written on a variant call.
    const r = Result::Ok::<i32, i32>(4);
    const n: i32 = match (r) {
        Result::Ok(v)  => { v }
        Result::Err(e) => { e }
    };
    if (n != 4) { return 4; }
    const w = Result::Err::<i32, i64>(7000000000);
    const m: i64 = match (w) {
        Result::Ok(v)  => { v as i64 }
        Result::Err(e) => { e }
    };
    if (m != 7000000000) { return 5; }

    // A generic class constructed by value.
    const a: Cell<i32> = Cell::<i32>(4);
    if (a.get() != 4) { return 6; }
    const b: Cell<i32> = Cell(5);
    if (b.get() != 5) { return 7; }
    const c = Cell::<i64>(8000000000);
    if (c.get() != 8000000000) { return 8; }
    return 0;
}
