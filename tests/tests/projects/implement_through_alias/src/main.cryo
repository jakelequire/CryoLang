/// An `implement` head naming a type alias implements for the type the alias
/// names: the methods are reached through the type and through the alias,
/// by a value, through a bound and through a trait object, for a struct, an
/// enum, a primitive and an alias of an alias.
namespace ImplementThroughAlias::Main;

import std::fmt;

type struct Point { x: i32; y: i32; }
type PointAlias = Point;
type PointAliasAgain = PointAlias;

type enum Shade { Light; Dark(i32); }
type ShadeAlias = Shade;

type Count = i32;

type trait Measure { measure(&this) -> i32; }

implement trait Measure for PointAlias {
    measure(&this) -> i32 { return this.x * 10 + this.y; }
}

implement struct PointAliasAgain {
    static at(x: i32, y: i32) -> PointAliasAgain { return Point { x: x, y: y }; }
    swapped(&this) -> Point { return Point { x: this.y, y: this.x }; }
}

implement trait Measure for ShadeAlias {
    measure(&this) -> i32 {
        return match (this) {
            Shade::Light   => { 1 }
            Shade::Dark(n) => { n + 100 }
        };
    }
}

implement enum ShadeAlias {
    darker(&this) -> Shade {
        return match (this) {
            Shade::Light   => { Shade::Dark(1) }
            Shade::Dark(n) => { Shade::Dark(n + 1) }
        };
    }
}

implement trait Measure for Count {
    measure(&this) -> i32 { return *this * 2; }
}

function bounded<T>(v: &T) -> i32 where T: Measure { return v.measure(); }

function dynamic(v: virtual &Measure) -> i32 { return v.measure(); }

function main() -> i32 {
    const p: Point = Point::at(1, 2);
    const q: PointAlias = PointAlias::at(3, 4);
    const r: PointAliasAgain = p.swapped();
    const s: Shade = Shade::Light;
    const t: ShadeAlias = s.darker();
    const n: i32 = 21;
    const c: Count = 4;
    fmt::println(f"through an alias: {p.measure()} {q.measure()} {r.measure()} {bounded(&p)} {dynamic(&q)} {q.swapped().measure()} | {s.measure()} {t.measure()} {bounded(&t)} {dynamic(&s)} {t.darker().measure()} | {n.measure()} {bounded(&c)}");
    return 0;
}
