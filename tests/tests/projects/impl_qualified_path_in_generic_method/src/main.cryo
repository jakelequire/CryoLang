namespace ImplQualifiedPathInGenericMethod::Main;

import std::collections::str::{ Str };
import std::collections::string::{ String };
import std::fmt::interp::{
    fmt_append_debug, fmt_append_display, fmt_append_fmt, fmt_append_lit, fmt_new
};

// Two traits provide a generic `go` for `S`, so a call names one of them by
// its implementation: `(Bb for S)::go(&s, w)`.  Each call below sits in a
// generic body and passes that body's own type parameter on, so the method
// it names is specialized once per instantiation of the body.
type trait Aa { go<W>(&this, w: W) -> i32; }
type trait Bb { go<W>(&this, w: W) -> i32; }
type trait Run { run<W>(&this, w: W) -> i32; }

type struct S { v: i32; }
implement trait Aa for S { go<W>(&this, w: W) -> i32 { return 1; } }
implement trait Bb for S { go<W>(&this, w: W) -> i32 { return this.v + sizeof(W) as i32; } }

type struct T2 { s: S; }

// A trait implementation's generic method.
implement trait Run for T2 {
    run<W>(&this, w: W) -> i32 { return (Bb for S)::go(&this.s, w); }
}

// An inherent generic method.
implement struct T2 {
    via_inherent<W>(&this, w: W) -> i32 { return (Aa for S)::go(&this.s, w) * 100; }
}

// A generic free function.
function via_free<W>(s: &S, w: W) -> i32 { return (Bb for S)::go(s, w); }

function main() -> i32 {
    const t: T2 = T2 { s: S { v: 10 } };
    const a: i64 = 3;
    const b: u8 = 4;
    if (t.run(a) != 18) { return 1; }            // Bb's, with W = i64
    if (t.run(b) != 11) { return 2; }            // Bb's, with W = u8
    if (t.via_inherent(a) != 100) { return 3; }  // Aa's
    if (via_free(&t.s, b) != 11) { return 4; }   // Bb's

    // `Debug for String` names `Str`'s `Debug::fmt` the same way, from its
    // generic `fmt<W>`: `{:?}` quotes, `{}` does not.
    const s: String = String::from("ab");
    const d: String = f"{s:?}|{s}";
    const want: Str = Str::new("\"ab\"|ab");
    if (!d.as_str().equals(&want)) { return 5; }
    return 0;
}
