# library_without_namespace_own_build - a library-only project's own build
# holds its `[lib]` to the rule a dependent's build does: the library's
# namespace is the one its lib.cryo declares, and this lib.cryo declares
# none, so the library has no name to be imported by: E0509.
[project]
project_name = "library_without_namespace_own_build"
output_dir   = "build"

[lib]
name       = "plain"
source_dir = "src"

[compiler]

[dependencies]
