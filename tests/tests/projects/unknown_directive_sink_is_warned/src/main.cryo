namespace UnknownDirectiveSinkIsWarned::Main;

// `![sink]` is not a directive: a leftover one is warned as unknown, and the
// function it stands on takes its parameter as any other function does.

type struct Holder { value: i32; }

![sink]
function take(holder: Holder) -> i32 { return holder.value; }

function main() -> i32 {
    return take(Holder { value: 0 });
}
