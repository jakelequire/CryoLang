# dependency_entry_refused - `[dependencies]` entries the cryoconfig's reader
# refuses, each with the fix shown: a misspelt key, a `version` that is not
# a requirement, and two of `tag`, `branch`, `rev` at once.
[project]
project_name = "dependency_entry_refused"
output_dir   = "build"
target_type  = "executable"
source_dir   = "src"
entry_point  = "src/main.cryo"

[compiler]

[dependencies]
misspelt = { path = "misspelt", verison = "0.1" }
malformed = { git = "https://example.com/acme/malformed.git", version = "v0.1" }
two_refs = { git = "https://example.com/acme/two.git", branch = "main", tag = "v1.0.0" }
