namespace OverloadedGenericMethodValue;

// Each overload returns a value that tells it apart from its sibling, so a
// value bound to the wrong overload fails the check rather than passing.
type struct Plain { n: i32; }
implement struct Plain {
    static conv<U>(u: U) -> U { return u; }
    static conv<U>(u: U, w: U) -> U { return w; }
    static mix(x: i32) -> i32 { return x + 100; }
    static mix<U>(x: U, y: U) -> U { return x; }
    get<U>(&this, u: U) -> U { return u; }
    get<U>(&this, u: U, w: U) -> U { return w; }
}

type struct Wrap<T> { v: T; }
implement<T> struct Wrap<T> {
    static conv<U>(u: U) -> U { return u; }
    static conv<U>(u: U, w: U) -> U { return w; }
}

function apply2(f: (i64, i64) -> i64, a: i64, b: i64) -> i64 { return f(a, b); }

function twice<T>(x: T, y: T) -> T {
    const one: (T) -> T = Plain::conv::<T>;
    const two: (T, T) -> T = Plain::conv;
    return two(one(x), y);
}

function main() -> i32 {
    // The expected type chooses the overload, with or without a turbofish.
    const f: (u8, u8) -> u8 = Plain::conv::<u8>;
    const g: (u8) -> u8 = Plain::conv::<u8>;
    const h: (i64, i64) -> i64 = Plain::conv;
    if (f(1 as u8, 2 as u8) != 2) { return 1; }
    if (g(5 as u8) != 5) { return 2; }
    if (h(3, 4) != 4) { return 3; }
    // A function-typed parameter is an expected type.
    if (apply2(Plain::conv, 7, 8) != 8) { return 4; }
    // A generic overload beside a non-generic one.
    const m1: (i32) -> i32 = Plain::mix;
    const m2: (i32, i32) -> i32 = Plain::mix::<i32>;
    if (m1(1) != 101) { return 5; }
    if (m2(6, 2) != 6) { return 6; }
    // A method with a receiver, receiver first.
    const p: Plain = Plain { n: 1 };
    const r1: (&Plain, u8, u8) -> u8 = Plain::get::<u8>;
    const r2: (&Plain, u8) -> u8 = Plain::get::<u8>;
    if (r1(&p, 1 as u8, 2 as u8) != 2) { return 7; }
    if (r2(&p, 5 as u8) != 5) { return 8; }
    // A generic owner's static method.
    const w1: (u8, u8) -> u8 = Wrap::<i32>::conv::<u8>;
    const w2: (u8) -> u8 = Wrap::<i32>::conv::<u8>;
    if (w1(1 as u8, 3 as u8) != 3) { return 9; }
    if (w2(6 as u8) != 6) { return 10; }
    // Inside a generic body, for the body's own parameter.
    if (twice::<i32>(1, 2) != 2) { return 11; }
    if (twice::<u8>(5 as u8, 6 as u8) != 6) { return 12; }
    return 0;
}
