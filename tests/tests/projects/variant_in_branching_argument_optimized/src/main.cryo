namespace Main;

import std::fmt;

type struct Token {
    value: u16;
}

type enum Choice {
    Small;
    Large;
}

type struct Counter {
    seen: u64;

    // A method's parameter is an expected type for its argument as a free
    // function's is.
    count(mut &this, item: Option<Token>) -> u64 {
        this.seen = this.seen + Counter::weigh(item);
        return this.seen;
    }

    static weigh(item: Option<Token>) -> u64 {
        return match (item) {
            Option::Some(token) => { token.value as u64 }
            Option::None => { 1000 }
        };
    }
}

// Each parameter is the expected type of the argument given for it, and so
// of each arm of an `if`, `?:` or `match` written there: a variant in an arm
// is the instance the parameter names, whatever the other arms hold.
function describe(first: Option<Token>, second: Result<Token, u32>) -> u64 {
    const left: u64 = match (first) {
        Option::Some(token) => { token.value as u64 }
        Option::None => { 7 }
    };
    const right: u64 = match (second) {
        Result::Ok(token) => { token.value as u64 }
        Result::Err(code) => { 100 + (code as u64) }
    };
    return left * 1000 + right;
}

function holds(flag: u8) -> boolean { return flag == 1; }

function main() -> i32 {
    const yes: boolean = holds(1);
    const no: boolean = !yes;
    const choice: Choice = if (yes) { Choice::Large } else { Choice::Small };
    const both_none: u64 = describe(if (yes) { Option::None } else { Option::None }, if (no) { Result::Err(4) } else { Result::Err(5) });
    const mixed: u64 = describe(if (no) { Option::Some(Token { value: 9 }) } else { Option::None }, if (yes) { Result::Ok(Token { value: 11 }) } else { Result::Err(6) });
    const ternary: u64 = describe(yes ? Option::Some(Token { value: 12 }) : Option::None, no ? Result::Ok(Token { value: 13 }) : Result::Err(8));
    const matched: u64 = describe(match (choice) { Choice::Small => { Option::None } Choice::Large => { Option::Some(Token { value: 14 }) } }, match (choice) { Choice::Small => { Result::Ok(Token { value: 15 }) } Choice::Large => { Result::Err(9) } });
    mut counter: Counter = Counter { seen: 0 };
    counter.count(if (yes) { Option::None } else { Option::Some(Token { value: 2 }) });
    const total: u64 = counter.count(yes ? Option::Some(Token { value: 3 }) : Option::None);
    fmt::println(f"variants in branching arguments: {both_none} {mixed} {ternary} {matched} {total}");
    return 0;
}
