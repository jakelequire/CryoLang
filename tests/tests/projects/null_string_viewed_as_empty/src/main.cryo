namespace NullStringViewedAsEmpty;

import std::fmt;
import std::collections::str::{ Str };

function main() -> int {
    const absent: string = null;
    const by_new: Str = Str::new(absent);
    const by_from: Str = Str::from(absent);
    const converted: Str = absent;
    const shown: string = if (by_new == Str::new("") && by_new.is_empty()) { "empty" } else { "not empty" };
    fmt::printf("null views: %lld %lld %lld %s\n", by_new.length(), by_from.length(), converted.length(), shown);
    return 0;
}
