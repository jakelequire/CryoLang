/// A call through a type's path reaches an implementation for every type
/// beside the type's own methods of the name: the arguments choose it when
/// they choose none of the type's own.  `Wide` implements `Make<i32>`
/// itself and has `Make<Wide>` from `implement<T> trait Make<T> for T`, so
/// `Wide::make(3)` runs its own and `Wide::make(wide)` the head's.  A
/// method the type declares inherently outranks the head's.
namespace BlanketImplementationBesideOwnMethods::Main;

import std::ffi::libc::{ printf };

type trait Make<S> {
    static make(source: S) -> This;
}

implement<T> trait Make<T> for T {
    static make(source: T) -> T { return source; }
}

type struct Wide { value: i64; }

implement trait Make<i32> for struct Wide {
    static make(source: i32) -> Wide { return Wide { value: (source as i64) * 10 }; }
}

type struct Tall {
    value: i64;

    static make(source: Tall) -> Tall { return Tall { value: source.value + 1 }; }
}

function check(passed: i32, condition: boolean, what: string) -> i32 {
    if (!condition) {
        printf("FAILED: %s\n", what);
        return passed;
    }
    return passed + 1;
}

function main() -> i32 {
    mut passed: i32 = 0;
    passed = check(passed, Wide::make(Wide { value: 12 }).value == 12,
        "the head's method at the type itself, beside the type's own");
    passed = check(passed, Wide::make(3).value == 30, "the type's own implementation at its argument");
    passed = check(passed, Tall::make(Tall { value: 1 }).value == 2,
        "a method the type declares outranks the head's");
    printf("blanket beside own methods: %d of 3 checks passed\n", passed);
    if (passed != 3) { return 1; }
    return 0;
}
