# dependency_file_url_only_from_this_machine - a package fetched from a
# remote names only remote repositories.  The program, and every package
# reached from it through path dependencies and file:// repositories
# alone, is on this machine and may name a file:// repository; a package
# reached through an https or ssh repository may not.  No fixture can be
# fetched from a remote without the network, so the resolver's rule is
# asked directly for each case.
[project]
project_name = "dependency_file_url_only_from_this_machine"
output_dir   = "build"
target_type  = "executable"
source_dir   = "src"
entry_point  = "src/main.cryo"

[compiler]

[dependencies]
compiler = { path = "../../../../compiler" }
