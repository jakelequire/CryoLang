///! Which package may name a `file://` repository, asked of the resolver for
///! each kind of declarer and URL.

namespace FileUrlOnlyFromThisMachine;

import std::fmt;
import std::collections::str::{ Str };
import compiler::deps::git_url::{ GitUrl };

mut g_failed: i32 = 0;

/// Compare the resolver's answer for a declarer and a URL with `want`, where
/// -1 is a refusal, 0 a package fetched from a remote, 1 one on this machine.
function check(what: string, declarer_on_this_machine: boolean, url: string, want: i32) -> void {
    mut got: i32 = -1;
    match (GitUrl::package_on_this_machine(declarer_on_this_machine, Str::new(url))) {
        Option::Some(local) => { got = if (local) { 1 } else { 0 }; }
        Option::None        => { }
    }
    if (got != want) {
        fmt::printf("FAIL %s: got %d, want %d\n", what, got, want);
        g_failed = g_failed + 1;
    }
}

function main() -> int {
    check("the program names a file repository", true, "file:///srv/json5.git", 1);
    check("the program names an https repository", true, "https://example.com/acme/json5.git", 0);
    check("the program names an ssh repository", true, "git@example.com:acme/json5.git", 0);
    check("a remote package names a file repository", false, "file:///srv/json5.git", -1);
    check("a remote package names an https repository", false, "https://example.com/acme/json5.git", 0);
    fmt::printf("file url checks: %d failed\n", g_failed);
    return g_failed;
}
