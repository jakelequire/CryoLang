namespace ImportTypeAndFunctionSameLeaf::Globs;

// The function's module first, by wildcard: the type's module after it
// binds the type namespace, not a rival for the function.
import ImportTypeAndFunctionSameLeaf::Labels::*;
import ImportTypeAndFunctionSameLeaf::Shapes::*;

public function via_globs() -> i32 {
    const t: Tag = Tag { id: 5 };
    return t.id + Tag(10);
}
