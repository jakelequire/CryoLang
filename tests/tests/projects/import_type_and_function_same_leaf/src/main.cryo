namespace ImportTypeAndFunctionSameLeaf::Main;

import ImportTypeAndFunctionSameLeaf::Globs;
import ImportTypeAndFunctionSameLeaf::Shapes::{ Tag };
import ImportTypeAndFunctionSameLeaf::Labels::{ Tag };

// `Tag` is a type from `Shapes` and a function from `Labels`: two
// namespaces, so neither import collides with the other.
function main() -> i32 {
    const t: Tag = Tag { id: 3 };
    const n: i32 = Tag(4);
    if (t.id != 3) { return 1; }
    if (n != 8) { return 2; }
    if (Globs::via_globs() != 25) { return 3; }
    return 0;
}
