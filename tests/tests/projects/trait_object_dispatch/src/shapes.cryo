namespace TraitObjectDispatch::Shapes;

// The traits, in a module of their own: neither the implementations nor the
// calls through objects are written here.

/// A value of three words, returned through the caller's slot on both
/// systems, so a call through a table passes the return slot ahead of the
/// receiver as a direct call does.
type struct Extent {
    width:  i64;
    height: i64;
    depth:  i64;
}

type trait Shape {
    area(&this) -> i32;
    name(&this) -> i32 { return 7; }
    scale(mut &this, k: i32) -> void;
    extent(&this, pad: i64, ratio: f64) -> Extent;
    same(&this, other: &This) -> boolean;
}

/// Declares `area` too: an object of `Label` calls the implementation's
/// `Label::area`, never `Shape::area`, whatever the value's type provides.
type trait Label {
    area(&this) -> i32;
}
