namespace TraitObjectDispatch::Figures;

import TraitObjectDispatch::Shapes::{ Extent, Label, Shape };

// The implementations: their tables are defined here, in the module that
// holds them, and the calls through them are written elsewhere.

type struct Circle {
    r: i32;
}

type struct Square {
    side: i32;
}

implement trait Shape for Circle {
    area(&this) -> i32 { return this.r * this.r * 3; }
    scale(mut &this, k: i32) -> void { this.r = this.r * k; }
    extent(&this, pad: i64, ratio: f64) -> Extent {
        const d: i64 = (this.r * 2) as i64 + pad;
        return Extent { width: d, height: d, depth: (ratio * 10.0) as i64 };
    }
    same(&this, other: &Circle) -> boolean { return this.r == other.r; }
}

implement trait Label for Circle {
    area(&this) -> i32 { return 1000; }
}

implement trait Shape for Square {
    area(&this) -> i32 { return this.side * this.side; }
    name(&this) -> i32 { return 9; }
    scale(mut &this, k: i32) -> void { this.side = this.side + k; }
    extent(&this, pad: i64, ratio: f64) -> Extent {
        return Extent { width: this.side as i64, height: pad, depth: (ratio * 100.0) as i64 };
    }
    same(&this, other: &Square) -> boolean { return this.side == other.side; }
}
