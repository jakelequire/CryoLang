namespace ImportCollisionBareUseRefused::Main;

import ImportCollisionBareUseRefused::Json;
import ImportCollisionBareUseRefused::Toml;
import ImportCollisionBareUseRefused::Json::{ parse };
import ImportCollisionBareUseRefused::Toml::{ parse };

function main() -> i32 {
    const a: i32 = parse("1");
    const b: i32 = Toml::parse("1");
    const c: i32 = Json::parse("1");
    return a + b + c;
}
