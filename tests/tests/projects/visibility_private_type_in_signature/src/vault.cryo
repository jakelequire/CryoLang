namespace VisibilityPrivateTypeInSignature::Vault;

private type struct Ledger {
    v: i32;
    get(&this) -> i32 { return this.v; }
}

private type trait Sealed { seal(&this) -> i32; }

public type trait Counted { count(&this) -> i32; }
implement trait Counted for Ledger { count(&this) -> i32 { return this.v; } }

// Each of these names `Ledger` or `Sealed` where another module can see it.
public function issue() -> Ledger { return Ledger { v: 7 }; }
public function take(l: Ledger) -> i32 { return l.v; }
public function many() -> [Ledger] { return []; }
public function bounded<T>(x: &T) -> i32 where T: Sealed { return x.seal(); }

public type struct Book {
    entry: Ledger*;
    public first(&this) -> Ledger { return Ledger { v: 1 }; }
}

public type Entry = Ledger;
public type enum Slot { Full(Ledger); Empty; }
public type trait Keeper { keep(&this) -> Ledger; }

// None of these is refused: the item is private, the member is private,
// or the concrete type is hidden behind `implement Trait`.
private function private_issue() -> Ledger { return Ledger { v: 2 }; }
public function counted() -> implement Counted { return Ledger { v: 3 }; }

public type struct Shelf {
    private hidden: Ledger*;
    private peek(&this) -> Ledger { return Ledger { v: 4 }; }
    public size(&this) -> i32 { return 0; }
}

// A public trait implemented for a public type is seen wherever both are:
// its arguments and its associated types are what its methods hand out.
public type trait Convert<T> { convert(&this) -> T; }
public type trait Produce { type Output; produce(&this) -> This::Output; }
public type trait Drain { type Item; drain(&this) -> This::Item; }

implement trait Convert<Ledger> for Book { convert(&this) -> Ledger { return Ledger { v: 5 }; } }
implement trait Produce for Shelf {
    type Output = [Ledger];
    produce(&this) -> [Ledger] { return []; }
}
implement trait Drain<Ledger*> for Shelf { drain(&this) -> Ledger* { return this.hidden; } }

// None of these is refused: the trait is private, the type is private, or
// no private type is named.
private type trait Hidden<T> { reveal(&this) -> T; }
implement trait Hidden<Ledger> for Book { reveal(&this) -> Ledger { return Ledger { v: 6 }; } }
implement trait Convert<i32> for Ledger { convert(&this) -> i32 { return this.v; } }
implement trait Convert<i32> for Book { convert(&this) -> i32 { return 8; } }
implement trait Produce for Book {
    type Output = i32;
    produce(&this) -> i32 { return 9; }
}
