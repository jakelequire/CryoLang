// A trait default chained after an adaptor on a receiver known only by its
// bound: the adaptor's item is its source's (`FilterIter<I>::Item` is
// `I::Item`), which the bound answers, so `map(f: (This::Item) -> B)` on
// `it.filter(f)` under `I: Iterator<i32>` reads `(i32) -> B`, and the call
// after it is typed in that `B`.
namespace IteratorChainedAdaptorsOnBound::Main;

import std::core::option::{ Option };
import std::core::iter::{ Iterator };

type struct Up {
    cur: i32;
    end: i32;
}

implement trait Iterator<i32> for struct Up {
    next(mut &this) -> Option<i32> {
        if (this.cur >= this.end) { return Option::None; }
        const v: i32 = this.cur;
        this.cur = this.cur + 1;
        return Option::Some(v);
    }
}

function dbl(x: i32) -> i32 { return x * 2; }
function widen(x: i32) -> i64 { return (x as i64) * 1000; }
function is_odd(x: &i32) -> boolean { return (*x % 2) == 1; }

function sum_i64<I>(mut it: I) -> i64 where I: Iterator<i64> {
    mut sum: i64 = 0;
    loop {
        match (it.next()) {
            Option::Some(v) => { sum = sum + v; }
            Option::None => { break; }
        }
    }
    return sum;
}

function odd_doubled<I>(it: I) -> i32 where I: Iterator<i32> {
    return it.filter(is_odd).map(dbl).count() as i32;
}

function odd_widened<I>(it: I) -> i64 where I: Iterator<i32> {
    return sum_i64(it.filter(is_odd).map(widen));
}

function odd_doubled_widened<I>(it: I) -> i64 where I: Iterator<i32> {
    return sum_i64(it.filter(is_odd).map(dbl).map(widen));
}

type struct Source<I> {
    it: I;

    odd_count(this) -> i64 where I: Iterator<i32> {
        return this.it.filter(is_odd).map(dbl).count();
    }
}

function main() -> i32 {
    if (odd_doubled(Up { cur: 0, end: 6 }) != 3) { return 1; }
    if (odd_widened(Up { cur: 0, end: 6 }) != 9000) { return 2; }
    if (odd_doubled_widened(Up { cur: 0, end: 6 }) != 18000) { return 3; }
    const s: Source<Up> = Source::<Up> { it: Up { cur: 0, end: 8 } };
    if (s.odd_count() != 4) { return 4; }
    return 0;
}
