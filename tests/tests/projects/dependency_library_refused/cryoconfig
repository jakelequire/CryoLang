# dependency_library_refused - path dependencies the resolver refuses, each
# with the fix shown: `shapes` says version 0.1.0, which the requirement
# "0.2" does not accept; `tool` is an executable, with no [lib].
[project]
project_name = "dependency_library_refused"
output_dir   = "build"
target_type  = "executable"
source_dir   = "src"
entry_point  = "src/main.cryo"

[compiler]

[dependencies]
shapes = { path = "shapes", version = "0.2" }
tool = { path = "tool" }
