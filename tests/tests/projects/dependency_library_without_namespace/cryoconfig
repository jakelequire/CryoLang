# dependency_library_without_namespace - a dependency's [lib] is named by
# the namespace its `lib.cryo` declares.  `bare` has no lib.cryo (its one
# file declares `Bare` elsewhere) and `blank`'s lib.cryo declares no
# namespace, so neither library has a name to import: E0509 for each,
# before any import is resolved.
[project]
project_name = "dependency_library_without_namespace"
output_dir   = "build"
target_type  = "executable"
source_dir   = "src"
entry_point  = "src/main.cryo"

[compiler]

[dependencies]
bare  = { path = "bare" }
blank = { path = "blank" }
