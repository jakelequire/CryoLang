namespace FormatSpecPlusAndScientific;

import std::collections::str::{ Str };
import std::collections::string::{ String };

// `+` writes a decimal number's sign when it is not negative; `e` writes a
// number in scientific form. Each check returns its own exit code.

function same(got: String, want: string) -> boolean {
    mut text: String = got;
    return text.as_str().equals(&Str::new(want));
}

function main() -> i32 {
    const n: i32 = 42;
    const neg: i32 = 0 - 5;
    const zero: i64 = 0;
    const big: u64 = 18446744073709551615;
    const half: f64 = 0.5;
    const back: f64 = 0.0 - 1.5;
    if (!same(f"{n:+}", "+42")) { return 1; }
    if (!same(f"{neg:+}", "-5")) { return 2; }
    if (!same(f"{zero:+}", "+0")) { return 3; }
    if (!same(f"{big:+}", "+18446744073709551615")) { return 4; }
    if (!same(f"{half:+.1}", "+0.5")) { return 5; }
    if (!same(f"{back:+.1}", "-1.5")) { return 6; }
    // Zero-fill keeps the sign leftmost; a radix writes no sign.
    if (!same(f"[{n:+06}]", "[+00042]")) { return 7; }
    if (!same(f"[{half:+07.2}]", "[+000.50]")) { return 8; }
    if (!same(f"{n:+x}", "2a")) { return 9; }

    const x: f64 = 1234.5;
    const small: f64 = 0.00012;
    const negative: f64 = 0.0 - 1234.5;
    const nothing: f64 = 0.0;
    const count: i64 = 1500;
    if (!same(f"{x:e}", "1.234500e+3")) { return 20; }
    if (!same(f"{x:.2e}", "1.23e+3")) { return 21; }
    if (!same(f"{small:.1e}", "1.2e-4")) { return 22; }
    if (!same(f"{negative:.2e}", "-1.23e+3")) { return 23; }
    if (!same(f"{nothing:.1e}", "0.0e+0")) { return 24; }
    if (!same(f"{x:+.0e}", "+1e+3")) { return 25; }
    if (!same(f"{count:.1e}", "1.5e+3")) { return 26; }
    if (!same(f"[{x:>10.1e}]", "[    1.2e+3]")) { return 27; }
    return 0;
}
