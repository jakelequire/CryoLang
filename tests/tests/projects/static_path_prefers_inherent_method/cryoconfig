# static_path_prefers_inherent_method - an inherent method and a trait impl's
# method share one name and one signature on one type.  The path `P::go(&p)`
# binds the inherent method: a `Type::method` path names the inherent item
# and a trait's is reached through the impl-qualified path
# `(Beta for P)::go(&p)`, as in Rust.  The two answer 3 (`v * 3`) and 2,
# so the program exits 23 (a bare `p.go()` is ambiguous, E0156); a
# selector that saw two entries of one signature as a tie left the call
# unpinned and codegen refused it (E0636), and one keyed by symbol bound
# whichever registered last.
[project]
project_name = "static_path_prefers_inherent_method"
output_dir   = "build"
target_type  = "executable"
source_dir   = "src"
entry_point  = "src/main.cryo"
[compiler]
[dependencies]
