namespace StaticPathPrefersInherentMethod::Main;

type trait Beta {
    go(&this) -> i32;
}

type struct P {
    v: i32;
}

implement trait Beta for P {
    go(&this) -> i32 { return this.v * 2; }
}

implement struct P {
    go(&this) -> i32 { return this.v * 3; }
}

function main() -> int {
    const p: P = P { v: 1 };
    const a: i32 = p.go();
    const b: i32 = P::go(&p);
    return a * 10 + b;
}
