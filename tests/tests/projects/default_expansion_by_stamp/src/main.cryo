/// ======== DEFAULT EXPANSION ASKS THE STAMP, NOT THE SPELLING ========
///
/// `std::fs::path` declares `PathBuf<A = GlobalAlloc>`, an all-default
/// template.  This module imports that module - a plain `import M;` binds no
/// names (D7) - and declares its OWN non-generic `PathBuf`.  Every `PathBuf`
/// written here is stamped to this module's struct by the name layer, and
/// default expansion must leave it alone: the stdlib's defaults belong to a
/// different definition however the two are spelled.
///
/// Measured before the fix: the pass kept a per-pass table of all-default
/// templates keyed by BARE leaf, fed from the process-global registry
/// regardless of imports, and matched annotations by written spelling.  The
/// import brought the stdlib module into the compilation, its `PathBuf`
/// entered the table, `p: PathBuf` below was rewritten to
/// `PathBuf<GlobalAlloc>`, and `p.n` was refused:
///
///     error[E0204]: no field or method `n` on type `...::PathBuf`
///
/// Removing the import made the program compile - an import that binds
/// nothing poisoned an unrelated same-leaf type.  Refused by the compiler at
/// `7239982f` and by the pin `db5af63c` alike.
///
/// IF THIS PROJECT STOPS BUILDING: a spelling-keyed table came back.  Do not
/// relax `test.json`.
///
/// ====================================================================
namespace DefaultExpansionByStamp::Main;

import std::fs::path;
import std::ffi::libc;

type struct PathBuf {
    n: i32;

    static with(n: i32) -> PathBuf {
        return PathBuf { n: n };
    }
}

function main() -> i32 {
    const p: PathBuf = PathBuf::with(7);
    libc::printf("own PathBuf: %d\n", p.n);
    return p.n;
}
