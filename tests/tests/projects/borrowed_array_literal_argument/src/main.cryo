namespace BorrowedArrayLiteralArgument;

type struct Counter {
    base: i64;

    total(&this, items: &[i64]) -> i64 { return this.base + items.length(); }

    sum(&this, items: &[i64]) -> i64 {
        mut s: i64 = this.base;
        for (mut i: i64 = 0; i < items.length(); i++) { s = s + items[i]; }
        return s;
    }
}

function free_total(items: &[i64]) -> i64 { return items.length(); }

function main() -> i32 {
    const c: Counter = Counter { base: 2 };
    return (c.total(&[]) + free_total(&[]) + c.sum(&[3, 4])) as i32;
}
