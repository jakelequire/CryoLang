namespace GenericReferenceComparesReferents::Main;

import std::core::cmp;

function same<T>(a: &T, b: &T) -> boolean where T: cmp::Eq { return a == b; }
function differ<T>(a: &T, b: &T) -> boolean where T: cmp::Eq { return a != b; }
function less<T>(a: &T, b: &T) -> boolean where T: cmp::Ord { return a < b; }
function at_least<T>(a: &T, b: &T) -> boolean where T: cmp::Ord { return a >= b; }

function main() -> i32 {
    // Two bindings, equal values, different addresses.
    const m: i64 = 7;
    const n: i64 = 7;
    const k: i64 = 9;
    if (!same::<i64>(&m, &n)) { return 1; }
    if (differ::<i64>(&m, &n)) { return 2; }
    if (same::<i64>(&m, &k)) { return 3; }
    if (!less::<i64>(&m, &k)) { return 4; }
    if (less::<i64>(&k, &m)) { return 5; }
    if (!at_least::<i64>(&n, &m)) { return 6; }
    const x: u8 = 3;
    const y: u8 = 3;
    if (!same::<u8>(&x, &y)) { return 7; }
    return 0;
}
