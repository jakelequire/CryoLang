namespace ExportAliasOffersItem::Main;

import ExportAliasOffersItem::Facade::{ print, Point, F };
import ExportAliasOffersItem::Facade;
import ExportAliasOffersItem::Outer::*;

function main() -> i32 {
    if (print(1) != 2) { return 1; }
    if (Facade::print(2) != 3) { return 2; }
    if (Facade::inner() != 2) { return 3; }
    const p: Point = Point { v: 7 };
    if (p.v != 7) { return 4; }
    const q: Facade::Point = Facade::Point { v: 8 };
    if (q.v != 8) { return 5; }
    if (F::printf(4) != 5) { return 6; }
    const r: F::Pt = F::Pt { v: 9 };
    if (r.v != 9) { return 7; }
    return 0;
}
