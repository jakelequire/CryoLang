namespace new_generic_struct_layout;

// `new` of a generic struct allocates and fills the instance, not the
// template: with the arguments written (`new Big<i64> { .. }`), and with
// them bound by the expected type (`new Pair { .. }`).

type struct Big<T> {
    a: T;
    b: T;
    c: T;
    d: T;
}

type struct Pair<T> {
    first: T;
    second: T;
}

function main() -> i32 {
    const big: Big<i64>* = new Big<i64> { a: 1, b: 2, c: 3, d: 4 };
    const total: i64 = big.a + big.b + big.c + big.d;
    delete big;
    if (total != 10) { return 1; }

    const expected: Pair<i64>* = new Pair { first: 20, second: 22 };
    const sum: i64 = expected.first + expected.second;
    delete expected;
    if (sum != 42) { return 2; }
    return 40;
}
