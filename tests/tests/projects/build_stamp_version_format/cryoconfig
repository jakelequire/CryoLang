# build_stamp_version_format - the text `cryo -v` and `cryo version --verbose` print, from a stamp and without one, and how `cryo stamp` finds the region it rewrites: an unstamped binary reads `+unknown`, a clean stamp reads `+<first eight of the commit>`, a dirty one adds `-dirty`, a stamp reads back what it wrote, and a binary holding no region or two is refused.
[project]
project_name = "build_stamp_version_format"
output_dir   = "build"
target_type  = "executable"
source_dir   = "src"
entry_point  = "src/main.cryo"
[compiler]
[dependencies]
compiler = { path = "../../../../compiler", alias = "Compiler" }
