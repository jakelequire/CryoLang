namespace main;

import std::fmt;
import std::ffi::libc;
import utils::build_stamp;
import utils::build_stamp::{ BuildStamp, StampSlot, VersionReport };

const COMMIT: string = "3f9c2a1b5e0d4c3b2a1908f7e6d5c4b3a2918070";

mut g_failed: i32 = 0;

function check(what: string, got: string, want: string) -> void {
    if (got != want) {
        fmt::printf("FAIL %s\n  got:  [%s]\n  want: [%s]\n", what, got, want);
        g_failed = g_failed + 1;
    }
}

function check_int(what: string, got: i64, want: i64) -> void {
    if (got != want) {
        fmt::printf("FAIL %s: got %d, want %d\n", what, got, want);
        g_failed = g_failed + 1;
    }
}

function stamp_text(dirty: string) -> string {
    return fmt::format("commit=%s\ndate=2026-10-12\nbranch=naming-impl\ndescribe=3f9c2a1b\ndirty=%s\nprofile=release\n",
        COMMIT, dirty);
}

/// A buffer of `n` bytes holding a stamp region at each offset in `at`.
function buffer_with_regions(n: u64, at: u64[]) -> u8* {
    const buf: u8* = libc::malloc(n) as u8*;
    for (mut i: u64 = 0; i < n; i++) { buf[i] = 46; }
    for (mut r: u64 = 0; r < at.length(); r++) {
        const base: u64 = at[r as i64];
        for (mut k: u64 = 0; k < 16; k++) {
            buf[base + k] = build_stamp::BUILD_STAMP.marker[k];
        }
        for (mut k: u64 = 0; k < 496; k++) {
            buf[base + 16 + k] = 120;
        }
    }
    return buf;
}

function main(argc: int, argv: string*) -> int {
    // This binary was never stamped, so its own region is all zeros.
    check("running binary", BuildStamp::running().version("1.0.0", "alpha"), "1.0.0-alpha+unknown");
    check("unstamped", BuildStamp::empty().version("1.0.0", "alpha"), "1.0.0-alpha+unknown");

    const clean: BuildStamp = BuildStamp::parse(stamp_text("no"));
    check("clean", clean.version("1.0.0", "alpha"), "1.0.0-alpha+3f9c2a1b");
    check("no prerelease", clean.version("1.0.0", ""), "1.0.0+3f9c2a1b");
    check("dirty", BuildStamp::parse(stamp_text("yes")).version("1.0.0", "alpha"),
        "1.0.0-alpha+3f9c2a1b-dirty");

    // What a stamp writes is what it reads back, field for field.
    check("render", clean.render(), stamp_text("no"));
    const again: BuildStamp = BuildStamp::parse(clean.render());
    check("round trip commit", again.commit, COMMIT);
    check("round trip date", again.date, "2026-10-12");
    check("round trip branch", again.branch, "naming-impl");
    check("round trip describe", again.describe, "3f9c2a1b");
    check("round trip dirty", again.dirty, "no");
    check("round trip profile", again.profile, "release");
    check("unstamped renders nothing", BuildStamp::empty().render(), "");

    // A key a newer stamp writes is skipped; the rest still reads.
    const newer: BuildStamp = BuildStamp::parse(fmt::format("commit=%s\nflavour=x\ndirty=no\n", COMMIT));
    check("unknown key skipped", newer.version("1.0.0", "alpha"), "1.0.0-alpha+3f9c2a1b");

    const report: VersionReport = VersionReport {
        version: "cryo version " + clean.version("1.0.0", "alpha"),
        binary:  "/opt/cryo/bin/cryo",
        size:    "6854992 bytes",
        stamp:   clean,
        llvm:    "20.1.8",
        target:  "x86_64-pc-linux-gnu",
        stdlib:  "/opt/cryo/stdlib",
    };
    check("verbose stamped", report.render(),
        "cryo version 1.0.0-alpha+3f9c2a1b\n\n"
        + "binary:       /opt/cryo/bin/cryo\n"
        + "size:         6854992 bytes\n"
        + "commit:       3f9c2a1b5e0d4c3b2a1908f7e6d5c4b3a2918070\n"
        + "commit-date:  2026-10-12\n"
        + "branch:       naming-impl\n"
        + "describe:     3f9c2a1b\n"
        + "dirty:        no\n"
        + "llvm:         20.1.8\n"
        + "target:       x86_64-pc-linux-gnu\n"
        + "stdlib:       /opt/cryo/stdlib\n"
        + "profile:      release\n");

    const bare: VersionReport = VersionReport {
        version: "cryo version 1.0.0-alpha+unknown",
        binary:  "/opt/cryo/bin/cryo",
        size:    "",
        stamp:   BuildStamp::empty(),
        llvm:    "20.1.8",
        target:  "x86_64-pc-linux-gnu",
        stdlib:  "",
    };
    check("verbose unstamped", bare.render(),
        "cryo version 1.0.0-alpha+unknown\n\n"
        + "binary:       /opt/cryo/bin/cryo\n"
        + "size:         unknown\n"
        + "commit:       unknown\n"
        + "commit-date:  unknown\n"
        + "branch:       unknown\n"
        + "describe:     unknown\n"
        + "dirty:        unknown\n"
        + "llvm:         20.1.8\n"
        + "target:       x86_64-pc-linux-gnu\n"
        + "stdlib:       unknown\n"
        + "profile:      unknown\n");

    // `cryo stamp` rewrites the one region a binary holds, and refuses a
    // binary holding none or two.
    mut count: u64 = 0;
    const one: u8* = buffer_with_regions(2048, [100]);
    check_int("one region: offset", StampSlot::locate(one, 2048, &count), 116);
    check_int("one region: count", count as i64, 1);
    StampSlot::clear_text(one, 2048);
    check_int("cleared text", one[116] as i64, 0);
    check_int("cleared text end", one[116 + 495] as i64, 0);
    check_int("bytes after region kept", one[116 + 496] as i64, 46);
    check_int("marker kept", one[100] as i64, build_stamp::BUILD_STAMP.marker[0] as i64);

    const two: u8* = buffer_with_regions(4096, [100, 2000]);
    check_int("two regions: offset", StampSlot::locate(two, 4096, &count), -1);
    check_int("two regions: count", count as i64, 2);
    StampSlot::clear_text(two, 4096);
    check_int("two regions: left as is", two[116] as i64, 120);

    const none: u8* = buffer_with_regions(2048, []);
    check_int("no region: offset", StampSlot::locate(none, 2048, &count), -1);
    check_int("no region: count", count as i64, 0);

    fmt::printf("build stamp checks: %d failed\n", g_failed);
    return if (g_failed == 0) { 0 } else { 1 };
}
