/// A value read out of a reference by `*r` is cloned as a whole: the fix
/// brackets the dereference before `.clone()`, since a postfix call written
/// straight after `*r` would apply to `r`.
namespace FixShowsCloneOfDereference;

function first(r: &[i32]) -> i32 {
    const s = *r;
    return s[0];
}

function main() -> i32 {
    const values: [i32] = [4, 5, 6];
    return first(&values);
}
