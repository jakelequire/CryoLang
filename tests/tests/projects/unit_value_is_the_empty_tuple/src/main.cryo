namespace unit_value_is_the_empty_tuple;

// `()` is the one value of the unit type, with type `()`: it is returned
// from a `-> ()` function, binds to a `()` global or local, is assigned, and
// fills a unit payload.  It is zero-sized, so it is stored as `{}`, not as
// an 8-byte null pointer written into a payload narrower than a pointer.

import std::core::result::{ Result };
import std::core::option::{ Option };

const UNIT: () = ();

function done() -> () { return (); }

type struct Guarded {
    payload: Result<(), u8>;
    after: u8;
}

function main() -> i32 {
    const u: () = done();
    mut local: () = ();
    local = UNIT;
    local = u;
    mut g: Guarded = Guarded { payload: Result::Err(7), after: 40 };
    g.payload = Result::Ok(());
    const o: Option<()> = Option::Some(());
    mut n: i32 = g.after as i32;
    match (g.payload) {
        Result::Ok(_) => { n = n + 1; }
        Result::Err(_) => { }
    }
    match (o) {
        Option::Some(_) => { n = n + 1; }
        Option::None => { }
    }
    return n;
}
