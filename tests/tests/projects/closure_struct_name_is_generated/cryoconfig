# closure_struct_name_is_generated - a program that declares a type with the
# name the compiler gives a closure's struct (`__Closure_0`, with a `__call__`).
# The closure's struct is a generated definition, whose path no written
# declaration can have, so the closure keeps its own struct and call: the
# program exits 42.  If the two share a path, the arena's struct cache hands
# the closure the program's type and the call runs the program's `__call__`:
# exit 232 (1000 mod 256), with no diagnostic.
[project]
project_name = "closure_struct_name_is_generated"
output_dir   = "build"
target_type  = "executable"
source_dir   = "src"
entry_point  = "src/main.cryo"
[compiler]
[dependencies]
