/// An argument made only of literals takes the type of the parameter it is
/// passed to, on a primitive's method as on a function or a struct's
/// method: `x.wrapping_subtract(-(19371 & 32767))` with `x: i16` passes an
/// `i16`, since `i16` holds every value the expression computes.  A
/// primitive's methods are its `implement` blocks', so the parameter is
/// found there.  The struct's method is the control: its parameter was
/// always found.
namespace PrimitiveMethodLiteralArguments::Main;

import std::fmt;

type struct Cell16 {
    value: i16;

    plus(&this, other: i16) -> i16 { return this.value.wrapping_add(other); }
}

function main() -> i32 {
    const x: i16 = 5;
    const y: i8 = 0;
    const z: u16 = 1;
    const cell: Cell16 = Cell16 { value: 5 };
    const signed: i16 = x.wrapping_subtract((-(19371 & 32767)));
    const narrow: i8 = y.wrapping_add((-(100 + 27)));
    const unsigned: u16 = z.wrapping_multiply((300 * 200));
    const control: i16 = cell.plus((-(19371 & 32767)));
    fmt::println(f"{signed} {narrow} {unsigned} {control}");
    return 0;
}
