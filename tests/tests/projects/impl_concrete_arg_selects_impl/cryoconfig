# impl_concrete_arg_selects_impl - two impl heads of one trait for one
# template, differing only in a concrete target argument (`Wrap<T, Alpha>`
# answers 1, `Wrap<T, Beta>` answers 2), each selected by the subject's
# argument: `wa.show() * 10 + wb.show()` is 12.
#
# RED at the commit that added it (section 8.223): the registry holds ONE
# impl per (trait, TEMPLATE) and the later registration overwrites the
# earlier, so both subjects run one body and the program exits 22 - a
# miscompile with no diagnostic.
[project]
project_name = "impl_concrete_arg_selects_impl"
output_dir   = "build"
target_type  = "executable"
source_dir   = "src"
entry_point  = "src/main.cryo"
