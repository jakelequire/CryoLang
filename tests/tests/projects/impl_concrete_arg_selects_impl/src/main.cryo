namespace ImplConcreteArg::Main;

type struct Alpha { a: i32; }
type struct Beta  { b: i32; }

type struct Wrap<T, A> {
    v: T;
    tag: A;
}

type trait Show {
    show(&this) -> i32;
}

implement<T> trait Show for Wrap<T, Beta> {
    show(&this) -> i32 { return 2; }
}

implement<T> trait Show for Wrap<T, Alpha> {
    show(&this) -> i32 { return 1; }
}

function main() -> int {
    const wa: Wrap<i32, Alpha> = Wrap<i32, Alpha> { v: 1, tag: Alpha { a: 0 } };
    const wb: Wrap<i32, Beta>  = Wrap<i32, Beta>  { v: 2, tag: Beta { b: 0 } };
    // Each subject selects the head whose concrete argument it carries: 12.
    return wa.show() * 10 + wb.show();
}
