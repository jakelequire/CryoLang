# dependency_git_tag_disagrees_with_version - the fixture's commit is tagged
# v0.2.0 while its cryoconfig says `version = "0.1.0"`; a dependency pinned
# by that tag is refused by `cryo fetch`, which shows the `rev` that takes the
# commit anyway.
[project]
project_name = "dependency_git_tag_disagrees_with_version"
output_dir   = "build"
target_type  = "executable"
source_dir   = "src"
entry_point  = "src/main.cryo"

[compiler]

[dependencies]
greeter = { git = "{fixture:greeter}", tag = "v0.2.0" }
