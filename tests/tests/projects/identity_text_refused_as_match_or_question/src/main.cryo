/// A module of the compiler's own: text read off a definition, a
/// `DeclName`, is shown and never looked up by.  As a `match`'s subject,
/// or handed with other text to a call answering a `boolean` - an equality,
/// a prefix test - it is refused where it is looked up, and so it is when a
/// helper's parameter carries it there.  Tested for emptiness, measured, or
/// handed alone to a call answering a `boolean`, it is not.
namespace compiler::resolver::decl_name;

type struct DeclName {
private:
    text: string;
public:
    static of(s: string) -> DeclName { return DeclName { text: s }; }
    shown(&this) -> string { return this.text; }
}

/// Identity text as a `match`'s subject.
function matched(name: DeclName) -> i32 {
    return match (name.shown()) {
        "a::b" => { 1 }
        _      => { 0 }
    };
}

/// Identity text compared by a call.
function equal_by_call(name: DeclName, other: string) -> i32 {
    if (name.shown().eq(other)) { return 1; }
    return 0;
}

/// Identity text tested for a prefix.
function prefixed(name: DeclName) -> i32 {
    if (name.shown().starts_with("a::")) { return 1; }
    return 0;
}

/// A helper matching what it is handed.
function kind_of(text: string) -> i32 {
    return match (text) {
        "a::b" => { 2 }
        _      => { 0 }
    };
}

/// Identity text handed to that helper.
function through_helper(name: DeclName) -> i32 {
    return kind_of(name.shown());
}

/// Tested for emptiness, measured, handed alone to a `boolean` call.
/// Accepted.
function accepted(name: DeclName) -> i32 {
    mut n: i32 = name.shown().length() as i32;
    if (name.shown().is_empty()) { n = n + 1; }
    if (name.shown() == "") { n = n + 1; }
    return n;
}

function main() -> i32 {
    const d: DeclName = DeclName::of("a::b");
    return matched(d) + equal_by_call(d, "a::b") + prefixed(d) + through_helper(d) + accepted(d);
}
