/// Uses of a type parameter its bounds do not allow: a method on a receiver,
/// a static through the parameter, a conversion to an object, and `?`
/// converting one parameter's error into another's. Each fix is the
/// signature with the bound added.
namespace FixShowsMissingBound;

import std::core::result::{ Result };

type trait Named {
    name(&this) -> i32;
    static make() -> This;
}

type struct Plain { n: i32; }

implement trait Named for struct Plain {
    name(&this) -> i32 { return this.n; }
    static make() -> Plain { return Plain { n: 0 }; }
}

function call_missing<T>(t: &T) -> i32 {
    return t.name();
}

function make_one<T>() -> T {
    return T::make();
}

function as_object<T>(t: &T) -> virtual &Named {
    return t;
}

function convert<E, F>(r: Result<i32, E>) -> Result<i32, F> {
    const v: i32 = r?;
    return Result::Ok(v);
}

function main() -> int { return 0; }
