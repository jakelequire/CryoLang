// A trait default with a type parameter of its own, called on a receiver
// known only by its bound, binds that parameter from an argument whose type
// names the trait's associated type: `map(f: (This::Item) -> B)` under
// `I: Iterator<i32>` reads `(i32) -> B`.  Through a function's bound and an
// implement block's, with `B` the item type and not, and `fold`'s
// accumulator.
namespace IteratorGenericDefaultOnBound::Main;

import std::core::option::{ Option };
import std::core::iter::{ Iterator };

type struct Up {
    cur: i32;
    end: i32;
}

implement trait Iterator<i32> for struct Up {
    next(mut &this) -> Option<i32> {
        if (this.cur >= this.end) { return Option::None; }
        const v: i32 = this.cur;
        this.cur = this.cur + 1;
        return Option::Some(v);
    }
}

function dbl(x: i32) -> i32 { return x * 2; }
function widen(x: i32) -> i64 { return (x as i64) * 1000; }
function add(acc: i64, x: i32) -> i64 { return acc + (x as i64); }

function sum_i32<I>(mut it: I) -> i32 where I: Iterator<i32> {
    mut sum: i32 = 0;
    loop {
        match (it.next()) {
            Option::Some(v) => { sum = sum + v; }
            Option::None => { break; }
        }
    }
    return sum;
}

function sum_i64<I>(mut it: I) -> i64 where I: Iterator<i64> {
    mut sum: i64 = 0;
    loop {
        match (it.next()) {
            Option::Some(v) => { sum = sum + v; }
            Option::None => { break; }
        }
    }
    return sum;
}

function doubled<I>(it: I) -> i32 where I: Iterator<i32> {
    return sum_i32(it.map(dbl));
}

function widened<I>(it: I) -> i64 where I: Iterator<i32> {
    return sum_i64(it.map(widen));
}

function folded<I>(mut it: I) -> i64 where I: Iterator<i32> {
    return it.fold(5, add);
}

type struct Holder<I> {
    inner: I;
}

implement<I> struct Holder<I> where I: Iterator<i32> {
    doubled_count(this) -> i64 {
        return this.inner.map(dbl).count() as i64;
    }
}

function main() -> i32 {
    if (doubled(Up { cur: 0, end: 4 }) != 12) { return 1; }
    if (widened(Up { cur: 1, end: 3 }) != 3000) { return 2; }
    if (folded(Up { cur: 0, end: 4 }) != 11) { return 4; }
    const h: Holder<Up> = Holder { inner: Up { cur: 0, end: 7 } };
    if (h.doubled_count() != 7) { return 5; }
    return 0;
}
