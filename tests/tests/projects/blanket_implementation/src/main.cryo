/// `implement<T> trait Make<T> for T` gives every type `Make` of itself.  A
/// call through a bound selects it when the bound's types are the same type
/// - a primitive, a struct, inside a generic function - and selects a type's
/// own implementation at another argument beside it, and a call through a
/// type's path reaches it when the type has no `make` of its own.  Each type
/// runs its own copy of the head's method.
namespace BlanketImplementation::Main;

import std::ffi::libc::{ printf };

type trait Make<S> {
    static make(source: S) -> This;
}

implement<T> trait Make<T> for T {
    static make(source: T) -> T { return source; }
}

type struct Wide { value: i64; }

implement trait Make<i32> for struct Wide {
    static make(source: i32) -> Wide { return Wide { value: (source as i64) * 10 }; }
}

type struct Plain { value: i64; }

function through<E, F>(source: E) -> F where F: Make<E> {
    return F::make(source);
}

function same<E>(source: E) -> E where E: Make<E> {
    return through::<E, E>(source);
}

function check(passed: i32, condition: boolean, what: string) -> i32 {
    if (!condition) {
        printf("FAILED: %s\n", what);
        return passed;
    }
    return passed + 1;
}

function main() -> i32 {
    mut passed: i32 = 0;
    passed = check(passed, through::<i32, i32>(7) == 7, "a primitive through a bound");
    passed = check(passed, through::<Wide, Wide>(Wide { value: 8 }).value == 8,
        "a struct with an implementation of its own, through a bound at itself");
    passed = check(passed, through::<i32, Wide>(6).value == 60,
        "the struct's own implementation through a bound at another type");
    passed = check(passed, same::<i64>(9) == 9, "inside a generic function");
    passed = check(passed, i32::make(11) == 11, "a primitive's path");
    passed = check(passed, Plain::make(Plain { value: 12 }).value == 12, "a struct's path");
    passed = check(passed, Wide::make(13).value == 130, "a struct's own implementation through its path");
    printf("blanket implementations: %d of 7 checks passed\n", passed);
    if (passed != 7) { return 1; }
    return 0;
}
