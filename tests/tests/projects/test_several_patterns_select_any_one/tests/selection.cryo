/// Two unit tests the patterns name, and one they do not, which fails.
![config(testing)]
namespace SeveralPatterns::Selection;

import std::core::result::{ Result };
import std::collections::str::{ Str };
import std::test::error::{ TestError };
import std::test::assert::{ bail, expect_equal };

![test]
function kiwi_runs() -> Result<(), TestError> {
    return expect_equal(2 + 2, 4);
}

![test]
function lime_runs() -> Result<(), TestError> {
    return expect_equal(3 * 3, 9);
}

![test]
function plum_is_left_out() -> Result<(), TestError> {
    return bail(Str::new("no pattern names this test, so it must not run"));
}
