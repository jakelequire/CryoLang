# test_several_patterns_select_any_one - `cryo test` given several patterns
# runs, in each of its three suites, every test whose name contains any one
# of them, and nothing else.  Each suite holds one test no pattern names, and
# that test fails when it runs: a unit test that returns an error, a
# compile-fail file that compiles, a project whose output is not what it
# asserts.  The patterns name two of each suite's other tests, so a runner
# that reads only the first pattern runs none of the compile-fail files or
# projects.
[project]
project_name = "test_several_patterns_select_any_one"
output_dir   = "build"
target_type  = "executable"
source_dir   = "src"
entry_point  = "src/main.cryo"

[compiler]

