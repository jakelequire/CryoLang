namespace GenericFunctionOverloadsSelectByArity::Main;

// Two generic functions overload `pick` by arity: each call is an
// instance of the template its argument count selects, inferred or
// written with a turbofish.
function pick<T>(a: T) -> T { return a; }
function pick<T>(a: T, b: T) -> T { return b; }

function main() -> i32 {
    const x: i32 = pick(3);
    const y: i32 = pick(4, 5);
    const z: i64 = pick(6 as i64, 7 as i64);
    const w: i32 = pick::<i32>(8, 9);
    const v: i32 = pick::<i32>(10);
    if (x == 3 && y == 5 && z == 7 && w == 9 && v == 10) { return 0; }
    return 1;
}
