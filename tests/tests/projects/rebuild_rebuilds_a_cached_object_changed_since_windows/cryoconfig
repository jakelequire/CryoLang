# rebuild_rebuilds_a_cached_object_changed_since_windows - run, built twice.
# The runner builds a copy of the project, then overwrites the value
# module's object in the build directory with bytes that are not an object,
# and replaces src/main.cryo, so the second build must compile again.  The
# value module's source is unchanged, so its key is too; a module's earlier
# object is reused only while the file still has the digest its key
# recorded, so the second build compiles the value module again and links
# (exit 4), where reusing the overwritten file fails the link.  The object's
# path names the native build directory, so the Linux half is its own project.
[project]
project_name = "rebuild_rebuilds_a_cached_object_changed_since_windows"
output_dir   = "build"
target_type  = "executable"
source_dir   = "src"
entry_point  = "src/main.cryo"

[compiler]

[dependencies]
