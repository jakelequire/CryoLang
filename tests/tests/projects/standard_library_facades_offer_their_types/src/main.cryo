// Each standard library module offers its common types one level up, so a
// brace import of the module names them: `std::sync::{ Mutex }`, not
// `std::sync::mutex::{ Mutex }`.  A static call needs the name bound in
// scope, so each type reached here through a facade is called where a call
// is cheap, not only written in an annotation.  `std::net` offers what
// `std::net::address` itself only re-exports: the brace list follows the
// second hop.  (`std::net::tls` is left out: naming it links OpenSSL.)
import std::fmt;
import std::fmt::{ Display };
import std::collections::{ HashMap, Pair };
import std::io::{ Cursor, IoErrorKind };
import std::sync::{ Atomic, MemoryOrder, Mutex };
import std::time::{ Duration, Instant };
import std::net::{ IpV4Address, TcpStream };
import std::net::address::{ SocketAddress };
import std::encoding::value::{ Value };
import std::alloc::{ Arc };
import std::process::{ Command };
import std::random::{ Rng };
import std::log::{ LogLevel };
import std::encoding::{ Base64 };
import std::env::{ ArgumentParser };
import std::thread::{ ThreadLocal };
import std::net::ws::{ Message };
import std::net::http2::{ Http2Server };

namespace StandardLibraryFacadesOfferTheirTypes::Main;

function shown<T>(value: T) -> String where T: Display {
    return f"{value}";
}

function main() -> i32 {
    mut counts: HashMap<i32, i32> = HashMap::new();
    counts.insert(1, 2);
    const pair: Pair<i32, i32> = Pair::new(3, 4);
    const _cursor: Cursor = Cursor::new(Array::new());
    const kind: IoErrorKind = IoErrorKind::NotFound;
    const counter: Atomic<u32> = Atomic::new(5);
    const _guarded: Mutex<i32> = Mutex::new(6);
    const pause: Duration = Duration::from_milliseconds(1500);
    const _started: Instant = Instant::now();
    const address: IpV4Address = IpV4Address::new(127, 0, 0, 1);
    const _value: Value = Value::integer_value(7);
    const shared: Arc<i32> = Arc::new(8);
    const _command: Command = Command::new("echo");
    mut _generator: Rng = Rng::from_seed(9);
    const level: Option<LogLevel> = LogLevel::parse("debug");
    const _codec: Base64 = Base64::standard();
    const _parser: ArgumentParser = ArgumentParser::new("facades");
    const no_stream: Option<TcpStream> = Option::None;
    const no_socket: Option<SocketAddress> = Option::None;
    const no_local: Option<ThreadLocal<i32>> = Option::None;
    const no_message: Option<Message> = Option::None;
    const no_server: Option<Http2Server> = Option::None;
    const unset: boolean = no_stream.is_none() && no_socket.is_none() && no_local.is_none()
        && no_message.is_none() && no_server.is_none();
    fmt::println(f"pair {pair.first} entries {counts.length()} counter {counter.load(MemoryOrder::SeqCst)} pause {shown(pause)} address {shown(address)} shared {*shared.get_reference()} level {level.is_some()} unset {unset} kind {kind == IoErrorKind::NotFound}");
    return 0;
}
