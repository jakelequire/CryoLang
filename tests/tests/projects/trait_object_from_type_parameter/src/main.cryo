namespace TraitObjectFromTypeParameter::Main;

import std::collections::str::{ Str };
import std::collections::string::{ String };
import std::core::result::{ Result };
import std::fmt::display::{ Display, Formatter };
import std::fmt::error::{ FmtError };
import std::fmt::write::{ FmtWrite };

// A value whose type is a parameter of the generic body converts to a trait
// object when every copy of the body has an implementation of the trait for
// it: a type parameter bounded by the trait, `This` in one of the trait's
// own defaults, and the receiver of an implementation of the trait written
// for an instantiation, whose methods are checked over the template's
// parameters.  Each copy's object holds the table of its own type.

type trait Shout {
    level(&this) -> i64;

    /// A default that hands its receiver on as an object of its own trait.
    doubled(&this) -> i64 {
        return Loudness::twice(&this);
    }
}

type struct Loudness {
    static twice(s: virtual &Shout) -> i64 { return s.level() * 2; }
}

type struct Bell {
    ring: i64;
}

implement trait Shout for struct Bell {
    level(&this) -> i64 { return this.ring; }
}

type struct Horn<T> {
    blast: T;
}

implement<T> trait Shout for struct Horn<T> {
    level(&this) -> i64 { return 100; }
}

type struct Gauge<T> {
    reading: T;
}

implement trait Shout for struct Gauge<i64> {
    level(&this) -> i64 { return this.reading + 1000; }
}

type struct Dial<T> {
    turn: T;
}

/// An implementation written for an instantiation, its receiver handed on
/// in a method it writes itself.
implement trait Shout for struct Dial<i64> {
    level(&this) -> i64 { return this.turn; }
    doubled(&this) -> i64 { return Loudness::twice(&this) + 1; }
}

/// A bounded type parameter, in a generic function.
function twice_any<S>(s: &S) -> i64 where S: Shout {
    const object: virtual &Shout = s;
    return object.level() * 2;
}

/// A bounded type parameter of a generic struct, in its method.
type struct Relay<S> where S: Shout {
    inner: S;

    relayed(&this) -> i64 { return Loudness::twice(&this.inner) + 3; }
}

/// A writer that counts what it is given.
type struct Counter {
    bytes: i64;
}

implement trait FmtWrite for struct Counter {
    write_str(mut &this, source: Str) -> Result<(), FmtError> {
        this.bytes += source.length();
        return Result::Ok(());
    }
}

/// A `Formatter` made over any writer a bound names.
function formatted_into<W, V>(w: mut &W, value: &V) -> boolean where W: FmtWrite, V: Display {
    mut f: Formatter = Formatter::new(w);
    return match (value.fmt(&f)) {
        Result::Ok(_)  => { true }
        Result::Err(_) => { false }
    };
}

function main() -> int {
    const bell: Bell = Bell { ring: 21 };
    const horn: Horn<boolean> = Horn::<boolean> { blast: true };
    const gauge: Gauge<i64> = Gauge::<i64> { reading: 7 };
    if (bell.doubled() != 42) { return 1; }
    if (horn.doubled() != 200) { return 2; }
    if (gauge.doubled() != 2014) { return 3; }
    const dial: Dial<i64> = Dial::<i64> { turn: 30 };
    if (dial.doubled() != 61) { return 4; }
    if (twice_any(&bell) != 42) { return 5; }
    if (twice_any(&horn) != 200) { return 6; }
    if (twice_any(&gauge) != 2014) { return 7; }
    const relay: Relay<Bell> = Relay::<Bell> { inner: Bell { ring: 5 } };
    if (relay.relayed() != 13) { return 8; }
    mut text: String = String::new();
    mut counter: Counter = Counter { bytes: 0 };
    const value: i64 = -12345;
    if (!formatted_into(&text, &value) || !formatted_into(&counter, &value)) { return 9; }
    if (text.length() != 6 || counter.bytes != 6) { return 10; }
    return 0;
}
