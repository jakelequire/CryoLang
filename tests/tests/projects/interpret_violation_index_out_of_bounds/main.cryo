// `cryo interpret` refuses an index past a fixed array's last element as a
// violation at the index, rather than reading the storage beyond it.

namespace Main;

import std::fmt;

function main() -> i32 {
    const values: [i32; 3] = [1, 2, 3];
    mut total: i32 = 0;
    mut i: i64 = 0;
    while (i < 4) {
        total = total + values[i];
        i = i + 1;
    }
    fmt::println(f"{total}");
    return 0;
}
