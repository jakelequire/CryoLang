// Two references compared with an operator compare the values they refer
// to by the referent's implementation of the operator's trait, in the
// interpreter as in a compiled program; the addresses of a referent with no
// `Eq` compare once the references are converted to pointers.
namespace InterpretReferenceComparison;

import std::fmt;

type struct Plain {
    value: i64;
}

function main() -> i32 {
    const four: i64 = 4;
    const other_four: i64 = 4;
    const five: i64 = 5;
    const a: &i64 = &four;
    const b: &i64 = &other_four;
    const c: &i64 = &five;
    const equal: boolean = a == b;
    const unequal: boolean = a != b;
    const less: boolean = a < c;
    const greater: boolean = c > a;
    const at_most: boolean = c <= a;
    fmt::println(f"integers: {equal} {unequal} {less} {greater} {at_most}");
    const unit: u16 = 300;
    const same_unit: u16 = 300;
    const units: boolean = &unit == &same_unit;
    fmt::println(f"units: {units}");
    const one: Plain = Plain { value: 1 };
    const other: Plain = Plain { value: 1 };
    const p: &Plain = &one;
    const q: &Plain = &other;
    const again: &Plain = &one;
    const two_values: boolean = (p as Plain*) == (q as Plain*);
    const one_value: boolean = (p as Plain*) == (again as Plain*);
    fmt::println(f"identity: {two_values} {one_value}");
    return 0;
}
