///! An implementation whose head names no type - one for a reference `&T`,
///! one for every type `T` - is a definition of its own, and its methods
///! are definitions of it.  A method with type parameters of its own is
///! instantiated per (receiver, method definition, type arguments), so a
///! method with no definition was never instantiated, and a generic body
///! calling it through such an implementation reached codegen unbound.  A
///! project rather than a unit file: a compiler without the rule refuses it.

![config(testing)]
namespace CryoTests::Tests::Lang::ImplementationForNoNamedType;

import std::core::result::{ Result };
import std::test::error::{ TestError };
import std::test::assert::{ expect_equal };

type trait Describe {
    describe<H>(&this, h: H) -> i64;
}

implement trait Describe for i64 {
    describe<H>(&this, h: H) -> i64 { return *this; }
}

// Reached by a receiver that is a reference to something `Describe`.
implement<T> trait Describe for &T where T: Describe {
    describe<H>(&this, h: H) -> i64 { return (*this).describe(h) + 100; }
}

function described<K>(key: &K) -> i64 where K: Describe {
    return key.describe(1);
}

type trait Measure {
    measure<U>(&this, unit: U) -> i64;
}

type struct Rod { length: i64; }

// Gives every type a `Measure`: the head names a type parameter.
implement<T> trait Measure for T {
    measure<U>(&this, unit: U) -> i64 { return 7; }
}

function measured<K>(value: &K) -> i64 where K: Measure {
    return value.measure(true);
}

![test]
function generic_method_through_a_reference_implementation() -> Result<(), TestError> {
    const x: i64 = 5;
    const r: &i64 = &x;
    return expect_equal(described(&x) * 1000 + described(&r), 5105);
}

![test]
function generic_method_through_an_implementation_for_every_type() -> Result<(), TestError> {
    const rod: Rod = Rod { length: 3 };
    return expect_equal(measured(&rod) + measured(&rod.length), 14);
}
