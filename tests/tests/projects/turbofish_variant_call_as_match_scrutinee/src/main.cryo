namespace turbofish_variant_call_as_match_scrutinee;

type enum Holder<T> {
    Held(T);
    Empty;
}

function main() -> i32 {
    const wide: f64 = 1.5;
    match (Holder::<f64>::Held(wide)) {
        Holder::Held(v) => { if (v != 1.5) { return 1; } }
        Holder::Empty => { return 2; }
    }
    match (Holder::<u16>::Empty) {
        Holder::Held(_) => { return 3; }
        Holder::Empty => { }
    }
    const label: i64 = match (Holder::<i8>::Held(-4)) {
        Holder::Held(v) => { v as i64 }
        Holder::Empty => { 0 }
    };
    if (label != -4) { return 4; }
    return 0;
}
