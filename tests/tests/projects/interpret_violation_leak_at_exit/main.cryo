// `cryo interpret` reports a heap block still allocated when `main` returns
// as a leak, which is how it judges a destructor that never frees.

namespace Main;

import std::core::intrinsics;

function main() -> i32 {
    const block: mut void* = intrinsics::malloc(16);
    if (block == null) { return 1; }
    return 0;
}
