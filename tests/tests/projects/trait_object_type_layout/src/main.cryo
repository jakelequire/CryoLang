namespace trait_object_type_layout;

// A trait object is two words, the value's address and its table's,
// whatever its form: 16 bytes at 8-byte alignment, laid out in a struct as
// any aggregate of that size is.  Functions taking each form, an array of
// objects and a struct holding one are declared, compiled and linked.

type trait Shape {
    area(&this) -> i32;
}

type trait Conv<T> {
    convert(&this) -> T;
}

type struct Holder {
    tag:   i32;
    shape: virtual &Shape;
}

function borrowed(s: virtual &Shape) -> i32 { return 1; }
function borrowed_mutably(s: virtual mut &Shape) -> i32 { return 2; }
function raw(s: virtual Shape*) -> i32 { return 3; }
function converted(c: virtual &Conv<i64>) -> i32 { return 4; }
function many(xs: [virtual &Shape; 2]) -> i32 { return 5; }
function held(h: &Holder) -> i32 { return h.tag; }

function main() -> i32 {
    if (sizeof(virtual &Shape) != 16) { return 1; }
    if (sizeof(virtual mut &Shape) != 16) { return 2; }
    if (sizeof(virtual Shape*) != 16) { return 3; }
    if (sizeof(virtual &Conv<i64>) != 16) { return 4; }
    if (alignof(virtual &Shape) != 8) { return 5; }
    if (sizeof(Holder) != 24) { return 6; }
    if (sizeof([virtual &Shape; 2]) != 32) { return 7; }
    return 0;
}
