import std::core::default::{ Default };
import std::fmt;

type struct Holder<T> { inner: T; }

implement<T> trait Default for Holder<T> where T: Default {
    static default() -> Holder<T> { return Holder::<T> { inner: (Default for T)::default() }; }
}

type struct Seven { value: i64; }

implement trait Default for Seven {
    static default() -> Seven { return Seven { value: 7 }; }
}

// Two traits giving a static of one name: the head picks the implementation.
type trait Named { static name() -> i64; }
type trait Numbered { static name() -> i64; }

implement<T> trait Named for Holder<T> { static name() -> i64 { return 1; } }
implement<T> trait Numbered for Holder<T> { static name() -> i64 { return 2; } }

function fresh<T>() -> Holder<T> where T: Default {
    const made: Holder<T> = (Default for Holder<T>)::default();
    return made;
}

mut passed: i64 = 0;

function check(label: string, ok: boolean) -> void {
    if (ok) { passed += 1; } else { fmt::println(f"FAILED: {label}"); }
}

function main() -> i32 {
    const primitive: Holder<i64> = (Default for Holder<i64>)::default();
    check("concrete arguments, primitive payload", primitive.inner == 0);
    const custom: Holder<Seven> = (Default for Holder<Seven>)::default();
    check("concrete arguments, user payload", custom.inner.value == 7);
    const generic: Holder<Seven> = fresh::<Seven>();
    check("inside a generic body", generic.inner.value == 7);
    const picked: i64 = (Named for Holder<i64>)::name() * 10 + (Numbered for Holder<i64>)::name();
    check("the head picks the implementation", picked == 12);
    fmt::println(f"impl_qualified_static_on_instantiation: {passed} of 4 passed");
    return 0;
}
