namespace Probe;

type struct Holder<F> where F: () -> i32 {
    f: F;
    run(&this) -> i32 { return this.f(); }
}

type struct Pair<A, B> {
    a: A;
    b: B;
    swapped(&this) -> Pair<B, A> where A: Copy, B: Copy { return Pair { a: this.b, b: this.a }; }
}

function hold<F>(f: F) -> Holder<F> where F: () -> i32 { return Holder { f: f }; }

function run_held<F>(f: F) -> i32 where F: () -> i32 { return Holder { f: f }.run(); }

function bound_local<F>(f: F) -> i32 where F: () -> i32 {
    const h: Holder<F> = Holder { f: f };
    return h.run();
}

function pair_of<T>(x: T, n: i64) -> Pair<T, i64> { return Pair { a: x, b: n }; }

function main() -> i32 {
    const k: i32 = 9;
    const h = hold(() -> i32 { return k; });
    if (h.run() != 9) { return 1; }
    if (run_held(() -> i32 { return k + 1; }) != 10) { return 2; }
    if (bound_local(() -> i32 { return k + 2; }) != 11) { return 3; }
    const p = pair_of(true, 5);
    if (!p.a || p.b != 5) { return 4; }
    const q = p.swapped();
    if (q.a != 5) { return 5; }
    if (!q.b) { return 6; }
    return 0;
}
