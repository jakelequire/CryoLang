/// Forms Cryo does not have: `public module` and `implement class` are
/// replaced by one edit each; a constructor and a destructor are shown in
/// the shape Cryo writes them.
namespace FixShowsRemovedFormReplacement;

public module Inner;

type struct Counter {
    n: i32;
    Counter(start: i32) { }
    ~Counter() { }
}

implement class Counter {
    get(&this) -> i32 { return this.n; }
}

function main() -> int { return 0; }
