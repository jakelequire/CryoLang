# multi_target_teardown - one `cryo build` compiles three targets ([lib] and
# two [[bin]]s) in one process, each with its own compilation context, and
# drops each context before the next target starts (outcome = "build").
#
# Both bins import the module the lib compiles, so every target re-reads the
# same stdlib and the same module; a context whose teardown freed something a
# later target still reached would fail or crash the second or third target.

[project]
project_name = "multi_target_teardown"
output_dir   = "build"

[lib]
name = "teardown_shapes"
source_dir = "src"

[[bin]]
name = "first"
entry_point = "src/first.cryo"

[[bin]]
name = "second"
entry_point = "src/second.cryo"

[compiler]

[dependencies]
