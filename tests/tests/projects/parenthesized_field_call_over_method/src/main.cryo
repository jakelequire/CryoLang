namespace ParenthesizedFieldCallOverMethod;

// Parentheses around a member access make it the field's value: `(h.f)(x)`
// calls what the field holds even where the type has a method `f`, which
// `h.f(x)` still calls.

type struct Closures<F> where F: (i32) -> i32 {
    f: F;
    f(&this, x: i32) -> i32 { return x * 100; }
    through_value(&this, x: i32) -> i32 { return (this.f)(x); }
}

function double(x: i32) -> i32 { return x * 2; }

type struct Functions {
    f: (i32) -> i32;
    f(&this, x: i32) -> i32 { return x * 1000; }
}

function closures<F>(f: F) -> Closures<F> where F: (i32) -> i32 { return Closures::<F> { f: f }; }

function main() -> i32 {
    const step: i32 = 5;
    const c = closures((x: i32) -> i32 { return x + step; });
    if ((c.f)(1) != 6) { return 1; }
    if (c.f(1) != 100) { return 2; }
    if (c.through_value(2) != 7) { return 3; }
    const r = &c;
    if ((r.f)(3) != 8) { return 4; }
    if (r.f(3) != 300) { return 5; }
    const g: Functions = Functions { f: double };
    if ((g.f)(4) != 8) { return 6; }
    if (g.f(4) != 4000) { return 7; }
    return 0;
}
