namespace main;
import std::collections::str::{ Str };
import std::alloc::allocator::{ GlobalAlloc };
import std::core::ops::{ Deref };

type trait Valued { value(&this) -> i64; }
type trait Measured { measure(&this) -> i64; }

// `Wrap` has no `length` or `is_empty`; its target `Str` does.
type struct Wrap<A> {
    view: Str;
    inherent_length(&this) -> i64 { return this.length(); }
}

implement<A> trait Deref for struct Wrap<A> {
    type Target = Str;
    deref(&this) -> const Str* { return &this.view; }
}

// An implementation for one instance of the generic owner.
implement trait Valued for struct Wrap<GlobalAlloc> {
    value(&this) -> i64 {
        if (this.is_empty()) { return -1; }
        return this.length();
    }
}

// An implementation for every instance.
implement<A> trait Measured for struct Wrap<A> {
    measure(&this) -> i64 { return this.length() + 1; }
}

function main() -> i32 {
    const wrap: Wrap<GlobalAlloc> = Wrap::<GlobalAlloc> { view: Str::new("hello") };
    if (wrap.value() != 5) { return 1; }
    if (wrap.measure() != 6) { return 2; }
    if (wrap.inherent_length() != 5) { return 3; }
    const empty: Wrap<GlobalAlloc> = Wrap::<GlobalAlloc> { view: Str::new("") };
    if (empty.value() != -1) { return 4; }
    return 0;
}
