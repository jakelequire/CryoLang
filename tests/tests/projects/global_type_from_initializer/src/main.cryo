/// A module-level variable with no written type takes its initializer's,
/// and is read like any other global: from a function declared above it,
/// from below, and from a module that imports this one.
namespace global_type_from_initializer;

import limits;

function idf<T>(x: T) -> T { return x; }

function twice(x: i32) -> i32 { return x * 2; }

/// Reads the globals declared below it.
function above() -> i32 {
    const wide: i64 = k(40);
    return n + c + t(1) + (wide as i32) + (s.length() as i32);
}

const n = 5;
const s = "abc";
const c = twice(4);
const k = idf::<i64>;
const t = twice;
mut counter = 7;

function main() -> i32 {
    counter = counter + limits::STEP;
    // 5 + 8 + 2 + 40 + 3 = 58; 7 + 3 = 10; 58 + 10 = 68
    return above() + counter;
}
