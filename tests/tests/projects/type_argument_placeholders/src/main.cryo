namespace TypeArgumentPlaceholders;

// `_` as a type argument is inferred where it is written, as an unwritten
// list's arguments are, and the arguments written beside it are kept: in a
// free call, a method call, a static method on a generic owner, an owner's
// arguments on a path, a struct literal, a variant, a generic function taken
// as a value, and inside a generic body.

type struct Cell<T> {
    value: T;

    map<U, F>(&this, f: F) -> U where F: (T) -> U { return f(this.value); }
    static make<A, B>(a: A, b: B) -> A { return a; }
    static wrap(v: T) -> Cell<T> { return Cell::<T> { value: v }; }
}

type struct Two<A, B> {
    a: A;
    b: B;

    static of(a: A, b: B) -> Two<A, B> { return Two::<A, B> { a: a, b: b }; }
}

function pick<A, B>(a: A, b: B) -> A { return a; }
function second<A, B>(a: A, b: B) -> B { return b; }

/// A `_` in a generic body, beside an argument naming the body's parameter.
function first_of<T>(t: T, n: i64) -> T where T: Copy {
    return pick::<T, _>(t, n);
}

function main() -> i32 {
    const c: Cell<i32> = Cell::<i32> { value: 5 };
    // The written `i64` is the result; `_` is the closure's type.
    const offset: i64 = 100;
    const w: i64 = c.map::<i64, _>((x: i32) -> i64 { return x as i64 + offset; });
    if (w != 105) { return 1; }
    // A written argument types a literal argument: `u8`, not the default `i32`.
    const p: u8 = pick::<u8, _>(200, 5);
    if (p != 200) { return 2; }
    const q: i32 = pick::<_, i64>(7, 5);
    if (q != 7) { return 3; }
    const all: i32 = pick::<_, _>(9, 5);
    if (all != 9) { return 4; }
    const m: i64 = Cell::<i32>::make::<i64, _>(7, true);
    if (m != 7) { return 5; }
    const wrapped: Cell<i64> = Cell::<_>::wrap(11);
    if (wrapped.value != 11) { return 6; }
    const two: Two<i64, boolean> = Two::<i64, _>::of(12, true);
    if (two.a != 12 || !two.b) { return 7; }
    const literal: Two<u8, i64> = Two::<u8, _> { a: 13, b: 14 };
    if (literal.a != 13 || literal.b != 14) { return 8; }
    const some: Option<i64> = Option::<_>::Some(15);
    if (some.unwrap() != 15) { return 9; }
    const ok: Result<u8, i64> = Result::Ok::<_, i64>(16);
    if (ok.unwrap() != 16) { return 10; }
    const f: (i64, boolean) -> boolean = second::<i64, _>;
    if (!f(1, true)) { return 11; }
    if (first_of(17, 3) != 17) { return 12; }
    return 0;
}
