namespace TraitDefaultLeafCollision::Main;

import TraitDefaultLeafCollision::Alpha;
import TraitDefaultLeafCollision::Omega;

function main() -> int {
    const a: TraitDefaultLeafCollision::Alpha::Cell =
        TraitDefaultLeafCollision::Alpha::Cell { v: 0 };
    const x: int = a.twice(0);
    if (x != 11) { return 10; }

    // `Omega::Cell` implements no trait at all, so `twice` is not a method
    // it has.  The trait-impl table asked by the receiver's LEAF answers
    // with Alpha's impl, and Alpha's default body runs against Omega's
    // inherent `seed`: the program compiles, and returns 25 here.
    const o: TraitDefaultLeafCollision::Omega::Cell =
        TraitDefaultLeafCollision::Omega::Cell { v: 0 };
    const y: int = o.twice(0);
    return y;
}
