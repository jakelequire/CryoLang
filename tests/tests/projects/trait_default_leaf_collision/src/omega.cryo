/// Shares its leaf with `TraitDefaultLeafCollision::Alpha::Cell`, implements
/// NO trait, and happens to carry an inherent `seed` of the shape Alpha's
/// impl of `Feed<int>` supplies.  Making the leaf plural is the whole
/// variable: renaming this type makes `o.twice(0)` in main.cryo the error it
/// always was.
namespace TraitDefaultLeafCollision::Omega;

type struct Cell { v: int; }

implement Cell {
    seed(&this) -> int { return 25; }
}
