namespace TraitDefaultLeafCollision::Shared;

/// `twice` has a body and its own generic param, so it is not cloned into an
/// impl block before sema: a call to it on a receiver is answered by looking
/// the receiver up in the trait-impl table, and the default's body then calls
/// `seed` on that receiver.
type trait Feed<T> {
    seed(&this) -> T;
    twice<B>(&this, b: B) -> T { return this.seed(); }
}
