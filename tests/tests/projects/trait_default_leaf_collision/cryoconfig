# trait_default_leaf_collision - two modules declare a same-leaf type; one
# implements a trait carrying a generic default method, the other implements
# nothing and calls that default.
#
# The trait-impl table was asked by the receiver's BARE LEAF wherever the
# receiver's identity had not answered: sema's generic-default lookup listed
# every trait any `Cell` implemented, and mono's specializer took the first
# impl whose written target spelled `Cell`.  `Omega::Cell.twice(0)` therefore
# bound Alpha's `Feed<int>` default, whose body ran Omega's inherent `seed`:
# a method the type never had compiled, linked and returned 25.
#
# One key, the receiver's own: the call is E0358 at its site.

[project]
project_name = "trait_default_leaf_collision"
output_dir   = "build"
target_type  = "executable"
source_dir   = "src"
entry_point  = "src/main.cryo"

