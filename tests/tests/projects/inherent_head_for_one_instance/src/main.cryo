namespace Main;

type struct Wrap<T> {
    value: T;
}

// For `Wrap<i64>` only: the empty leading list declares nothing, so `i64`
// is an argument, not a parameter's name.
implement<> struct Wrap<i64> {
    doubled(&this) -> i64 { return this.value * 2; }
    static zero() -> Wrap<i64> { return Wrap { value: 0 }; }
}

implement struct Wrap<T> {
    get(&this) -> &T { return &this.value; }
}

function generic_get<U>(w: &Wrap<U>) -> &U {
    return w.get();
}

function main() -> i32 {
    const w: Wrap<i64> = Wrap { value: 21 };
    if (w.doubled() != 42) { return 1; }
    if (Wrap::<i64>::zero().value != 0) { return 2; }
    if (*generic_get(&w) != 21) { return 3; }
    return 0;
}
