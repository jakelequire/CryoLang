namespace RangeLiteralTypedFromBound;

// A range literal passed for a method's own type parameter bound by a trait
// written with arguments takes its element type from the bound:
// `map.range(10..20)` on an `i64`-keyed map, whose `range<R>` requires
// `R: RangeBounds<K>`, passes a `Range<i64>` rather than the literal's own
// `Range<i32>`.  A user trait works the same way: `Wrap::new(5000000000)`
// under `R: Measures<i64>` is a `Wrap<i64>`, read off
// `implement<T> Measures<T> for Wrap<T>`.

import std::collections::btree_map::{ BTreeMap };

type trait Measures<T> {
    measure(&this) -> T;
}

type struct Wrap<T> {
    value: T;
    static new(value: T) -> Wrap<T> {
        return Wrap::<T> { value: value };
    }
}

implement<T> trait Measures<T> for struct Wrap<T> where T: Copy {
    measure(&this) -> T { return this.value; }
}

type struct Scale<K> {
    factor: K;
    apply<R>(&this, source: R) -> K where R: Measures<K>, K: Copy {
        return source.measure();
    }
}

function main() -> i32 {
    mut map: BTreeMap<i64, i64> = BTreeMap::new();
    for (mut key: i64 = 0; key < 40; key += 1) {
        map.insert(key, key * 2);
    }
    mut count: i64 = 0;
    for (entry in map.range(10..20)) {
        count += 1;
    }
    if (count != 10) { return 1; }
    count = 0;
    for (entry in map.range(30..)) {
        count += 1;
    }
    if (count != 10) { return 2; }
    const scale: Scale<i64> = Scale::<i64> { factor: 3 };
    const measured: i64 = scale.apply(Wrap::new(5000000000));
    if (measured != 5000000000) { return 3; }
    return 0;
}
