/// The function's return type names the struct, not the function's own
/// specialization.
namespace GenericFunctionNamedLikeType::Ret;

type struct Tag { n: i32; }

function make_tag(n: i32) -> Tag { const t: Tag = Tag { n: n }; return t; }

function Tag<T>(x: T) -> Tag { return make_tag(4); }

function run() -> i32 {
    const t: Tag = Tag(1);
    return t.n;
}
