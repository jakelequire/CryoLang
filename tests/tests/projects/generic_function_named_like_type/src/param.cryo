/// A parameter of the function is typed as the enum it shares a name with.
namespace GenericFunctionNamedLikeType::Param;

type enum Mode { On; Off; }

function Mode<T>(x: T, m: Mode) -> i32 {
    match (m) {
        Mode::On  => { return 9; }
        Mode::Off => { return 1; }
    }
}

function run() -> i32 { return Mode(1, Mode::On); }
