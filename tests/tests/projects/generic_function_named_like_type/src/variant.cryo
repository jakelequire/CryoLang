/// A variant path, a local's annotation and the patterns in the function's
/// body name the enum.
namespace GenericFunctionNamedLikeType::Variant;

type enum Mode { On; Off; }

function Mode<T>(x: T) -> i32 {
    const m: Mode = Mode::Off;
    match (m) {
        Mode::On  => { return 1; }
        Mode::Off => { return 8; }
    }
}

function run() -> i32 { return Mode(1); }
