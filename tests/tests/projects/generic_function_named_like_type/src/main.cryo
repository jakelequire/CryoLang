/// A generic function or static method that shares its name with a type is
/// specialized without its body and signature coming to mean the function:
/// a name written in the template denotes the specialization being built
/// only when it resolves to the template's own declaration.
namespace GenericFunctionNamedLikeType::Main;

import GenericFunctionNamedLikeType::Ret;
import GenericFunctionNamedLikeType::Literal;
import GenericFunctionNamedLikeType::Heap;
import GenericFunctionNamedLikeType::Variant;
import GenericFunctionNamedLikeType::Param;
import GenericFunctionNamedLikeType::Method;

function main() -> i32 {
    // 4 + 6 + 7 + 8 + 9 + 5
    return Ret::run() + Literal::run() + Heap::run() + Variant::run()
        + Param::run() + Method::run();
}
