/// A `new` in the function's body allocates the struct, and the pointer's
/// annotation names it.
namespace GenericFunctionNamedLikeType::Heap;

type struct Cell { n: i32; }

function Cell<T>(x: T) -> i32 {
    const c: Cell* = new Cell { n: 7 };
    const n: i32 = c.n;
    delete c;
    return n;
}

function run() -> i32 { return Cell(1); }
