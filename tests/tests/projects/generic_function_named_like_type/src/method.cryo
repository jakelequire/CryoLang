/// A generic static method named like a generic type, whose signature writes
/// that type over the method's own parameter: `Bag<T>` is the struct
/// instantiated at the method's argument, not the method's specialization.
namespace GenericFunctionNamedLikeType::Method;

type struct Bag<T> { v: T; }

function make_bag<T>(x: T) -> Bag<T> { return Bag::<T> { v: x }; }

type struct Holder { n: i32; }

implement struct Holder {
    static Bag<T>(x: T) -> Bag<T> { return make_bag::<T>(x); }
}

function run() -> i32 {
    const b: Bag<i32> = Holder::Bag::<i32>(5);
    return b.v;
}
