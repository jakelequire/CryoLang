# dependency_fetch_ignores_line_ending_config - a dependency's files are
# the bytes git stores, whatever the host's git configuration says.  The
# fixture `lines` carries a .gitattributes asking for CRLF line endings on
# checkout, and `cryo fetch` runs with core.autocrlf=true in its
# environment; a working tree would hold CRLF files on every host.  The
# lock's content hash is the one of the LF bytes in the fixture's commits,
# which hold no path of this machine, so it is the same on every host.
[project]
project_name = "dependency_fetch_ignores_line_ending_config"
output_dir   = "build"
target_type  = "executable"
source_dir   = "src"
entry_point  = "src/main.cryo"

[compiler]

[dependencies]
lines = { git = "{fixture:lines}", tag = "v1" }
