namespace CharUnicodeEscape;

// A character literal written with a `\u{...}` escape is the code point it
// names, as a value and as a pattern's bound.

function in_range(c: char) -> boolean {
    match (c) {
        '\u{41}'..'\u{43}' => { return true; }
        _ => { return false; }
    }
}

function is_b(c: char) -> boolean {
    match (c) {
        '\u{42}' => { return true; }
        _ => { return false; }
    }
}

function main() -> i32 {
    const lit: char = '\u{42}';
    if ((lit as i32) != 66) { return 1; }
    if (lit != 'B') { return 2; }
    if (!in_range('B')) { return 3; }
    if (in_range('D')) { return 4; }
    if (!is_b('B')) { return 5; }
    if (('\u{7a}' as i32) != 122) { return 6; }
    return 0;
}
