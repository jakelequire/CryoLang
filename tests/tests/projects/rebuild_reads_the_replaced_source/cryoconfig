# rebuild_reads_the_replaced_source - run, built twice.  The runner builds
# a copy of the project, replaces src/value.cryo with edits/value.cryo, and
# builds again into the same build directory: the second run must read the
# replaced source (exit 2, not the first source's 1) and reuse the object of
# the module that did not change.
[project]
project_name = "rebuild_reads_the_replaced_source"
output_dir   = "build"
target_type  = "executable"
source_dir   = "src"
entry_point  = "src/main.cryo"

