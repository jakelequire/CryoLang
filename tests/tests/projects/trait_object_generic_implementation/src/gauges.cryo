namespace TraitObjectGenericImplementation::Gauges;

// Generic implementations, and one for an instantiation of a generic type.
// Each instantiation a conversion names has a table of its own, built from
// the copies of the implementations for that instantiation and emitted with
// them, here or in the standard library.

type trait Named {
    label(&this) -> i64;
}

type trait Sink : Named {
    put(mut &this, v: i64) -> i64;
}

type trait Meter {
    read(&this) -> i64;
}

type struct Tank<T> {
    total: i64;
    fill:  T;
}

type struct Gauge<T> {
    level: T;
}

implement<T> trait Named for struct Tank<T> {
    label(&this) -> i64 { return sizeof(T) as i64 * 1000; }
}

// `put` adds the width of the instantiation's argument, so two
// instantiations' tables point at two different methods.
implement<T> trait Sink for struct Tank<T> {
    put(mut &this, v: i64) -> i64 {
        this.total = this.total + v + sizeof(T) as i64;
        return this.total;
    }
}

implement trait Meter for struct Gauge<i64> {
    read(&this) -> i64 { return this.level; }
}
