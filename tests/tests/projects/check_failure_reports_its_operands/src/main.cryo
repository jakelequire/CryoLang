namespace CheckFailureReportsItsOperands;

import std::collections::string::{ String };
import std::collections::str::{ Str };
import std::env;
import std::fmt;

type struct Noisy {
    name: String;
}

implement trait Drop for Noisy {
    drop(mut &this) -> void {
        mut line: String = String::from_str(Str::new("dropped on the way out: "));
        line.push(this.name.as_str());
        fmt::println(line);
    }
}

function main() -> int {
    const _held: Noisy = Noisy { name: String::from_str(Str::new("held")) };
    mut values: [i32; 3] = [1, 2, 3];
    // The index is only known at run time, so the check is not folded away.
    const index: i64 = env::args().length() + 4;
    return values[index];
}
