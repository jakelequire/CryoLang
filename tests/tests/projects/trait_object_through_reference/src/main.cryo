namespace TraitObjectThroughReference::Main;

// A method call through a reference or a pointer to a trait object loads the
// object through each level and calls through its table, as a call on the
// object itself does.  The exit code names the first call that answered
// wrong.

type trait Named {
    id(&this) -> i32;
}

type trait Shape : Named {
    area(&this) -> i32;
    scale(mut &this, by: i32) -> void;
}

type struct Square {
    side: i32;
}

implement trait Named for Square {
    id(&this) -> i32 { return 4; }
}

implement trait Shape for Square {
    area(&this) -> i32 { return this.side * this.side; }
    scale(mut &this, by: i32) -> void { this.side = this.side * by; }
}

type struct Holder {
    shape: virtual mut &Shape;
}

function by_reference(r: &virtual &Shape) -> i32 {
    return r.area();
}

function supertrait_by_reference(r: &virtual &Shape) -> i32 {
    return r.id();
}

function by_pointer(p: virtual &Shape*) -> i32 {
    return p.area();
}

function raw_by_pointer(p: virtual Shape**) -> i32 {
    return p.area();
}

function two_levels(r: & &virtual &Shape) -> i32 {
    return r.area();
}

function grow(r: &virtual mut &Shape) -> i32 {
    r.scale(2);
    return r.area();
}

function through_holder(h: &Holder) -> i32 {
    const r: &virtual mut &Shape = &h.shape;
    r.scale(3);
    return r.area();
}

function main() -> i32 {
    mut sq: Square = Square { side: 3 };
    const s: virtual &Shape = &sq;
    if (by_reference(&s) != 9) { return 1; }
    if (supertrait_by_reference(&s) != 4) { return 2; }
    if (by_pointer(&s) != 9) { return 3; }
    const sp: Square* = &sq;
    const raw: virtual Shape* = sp;
    if (raw_by_pointer(&raw) != 9) { return 4; }
    const rs: &virtual &Shape = &s;
    if (two_levels(&rs) != 9) { return 5; }
    const m: virtual mut &Shape = &sq;
    if (grow(&m) != 36) { return 6; }
    if (sq.side != 6) { return 7; }
    const h: Holder = Holder { shape: &sq };
    if (through_holder(&h) != 324) { return 8; }
    if (sq.side != 18) { return 9; }
    return 0;
}
