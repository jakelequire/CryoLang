/// `this.m()` in `Bx<T>::run` is resolved where it is written, in the generic
/// body: only the inherent `m` applies to `Bx<T>`.  `Bx<i32>`'s copy of `run`
/// calls `Bx<i32>`'s copy of that same `m` - by identity, not by selecting
/// `m` again on `Bx<i32>`, where a trait implemented for that one
/// instantiation also provides an `m`.  Written on a `Bx<i32>` receiver
/// directly, the call names both and is refused (E0156).
namespace GenericBodyCallKeepsWrittenAnswer::Main;

import std::ffi::libc;

type trait Tr { m(&this) -> i32; }

type struct Bx<T> { v: T; }
implement<T> struct Bx<T> {
    m(&this) -> i32 { return 1; }
    run(&this) -> i32 { return this.m(); }
}
implement trait Tr for struct Bx<i32> {
    m(&this) -> i32 { return 2; }
}

function main() -> int {
    const b: Bx<i32> = Bx::<i32> { v: 0 };
    if (b.run() != 1) { return 1; }
    const s: Bx<string> = Bx::<string> { v: "s" };
    if (s.run() != 1) { return 2; }
    libc::printf("written-answer ok\n");
    return 0;
}
