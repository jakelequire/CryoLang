namespace literal_element_widening;

import std::collections::array::{ Array };

function sum_of(values: [f64; 2]) -> f64 {
    return values[0] + values[1];
}

function main() -> i32 {
    // A fixed array of f64 from f32 elements.
    const x: f32 = 1.5;
    const pair: [f64; 2] = [x, -x];
    if (pair[0] != 1.5 || pair[1] != -1.5) { return 1; }

    // Integers widen by their own signedness.
    const big: u32 = 4000000000;
    const negative: i8 = -3;
    const values: [i64; 3] = [big, negative, 7];
    if (values[0] != 4000000000 || values[1] != -3 || values[2] != 7) { return 2; }

    // A fill widens its one value for every slot.
    const minus_one: i8 = -1;
    const filled: [i64; 3] = [minus_one; 3];
    if (filled[0] != -1 || filled[2] != -1) { return 3; }

    // An owning array literal widens each element.
    const small: u16 = 65535;
    const minus_two: i16 = -2;
    const grown: Array<i64> = [small, minus_two, small];
    if (grown.length() != 3 || grown[0] != 65535 || grown[1] != -2) { return 4; }

    // A tuple literal widens each position.
    const quarter: f32 = 0.25;
    const byte: u8 = 200;
    const tuple: (f64, i64) = (quarter, byte);
    if (tuple.0 != 0.25 || tuple.1 != 200) { return 5; }

    // A literal argument widens to the parameter's element type.
    const step: f32 = 1.25;
    if (sum_of([step, step]) != 2.5) { return 6; }
    return 0;
}
