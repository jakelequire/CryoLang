namespace StaticOverloadTieJudgesWhereBound;

type trait Shout { shout(&this) -> i32; }

type struct Loud { n: i32; }
implement trait Shout for struct Loud { shout(&this) -> i32 { return this.n; } }

type struct P { k: i32; }
implement struct P {
    static h<U>(u: U) -> i32 where U: Shout { return 1; }
    static h(u: i32) -> i32 { return 2; }
}

function main() -> i32 {
    // `i32` does not implement `Shout`, so the generic `h` does not accept
    // `x` and the plain one is the only candidate.
    const x: i32 = 7;
    const plain: i32 = P::h(x);
    // `Loud` implements it and the plain one does not take it.
    const generic: i32 = P::h(Loud { n: 3 });
    return plain * 10 + generic;
}
