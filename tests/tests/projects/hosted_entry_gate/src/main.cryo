/// Built and run end-to-end by the projects meta-runner. Every check below is
/// something the hosted program entry is responsible for; see the cryoconfig
/// for what each one would catch. Returns 0 and prints the success marker, or a
/// distinct code per failure so a red run says which part of startup broke.
namespace HostedEntryGate::Main;

import std::core::intrinsics;
import std::core::option;
import std::collections::array;
import std::collections::pair;
import std::collections::str;
import std::collections::string;
import std::env;

function main() -> int {
    // argv: the entry captured the process arguments and passed them to `main`,
    // which published them through `set_args`. argv[0] is always present.
    mut args: Array<String> = env::args();
    const argc: u64 = args.length();
    mut name_len: u64 = 0;
    if (argc > 0) {
        match (args.get_ref(0)) {
            Option::Some(a) => { name_len = a.as_str().length(); }
            Option::None    => {}
        }
    }
    args.drop();
    if (argc == 0)    { return 1; }
    if (name_len == 0) { return 2; }

    // envp: `main`'s third argument, which only the entry supplies. An empty
    // vector means it arrived null; a first entry with an empty key means it
    // pointed at something that is not the environment block.
    mut ev: Array<Pair<String, String>> = env::vars();
    const nvars: u64 = ev.length();
    mut key_len: u64 = 0;
    if (nvars > 0) {
        match (ev.get_ref(0)) {
            Option::Some(p) => { key_len = p.first.as_str().length(); }
            Option::None    => {}
        }
    }
    ev.drop();
    if (nvars == 0)   { return 3; }
    if (key_len == 0) { return 4; }

    // flush: deliberately no trailing newline, and nothing printed after it.
    // The runner captures output, so this is fully buffered and only arrives if
    // termination ran libc's exit path.
    intrinsics::printf("hosted entry gate: argv+envp+flush ok");
    return 0;
}
