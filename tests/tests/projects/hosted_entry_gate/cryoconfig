# hosted_entry_gate - the standing acceptance check for the HOSTED program entry.
#
# A hosted binary starts at the runtime's `__cryo_entry` (runtime/core/src/entry.cryo),
# not at crt0: the driver links libcryort-core-hosted.a and passes
# `-Wl,-e,__cryo_entry`, so the entry itself owns everything crt0's startup would
# otherwise have done. This project asserts the parts of that contract a Cryo
# program can observe, and each assertion maps to one thing the entry supplies:
#
#   argv   - captured per-OS (the initial stack on Linux, a PEB command-line
#            parse on Windows), handed to `main` as argc/argv.
#   envp   - `main`'s THIRD argument, which `env::vars()` reads. Sourced from
#            `argv + argc + 1` on Linux and msvcrt's `__p__environ()` on Windows,
#            so a wrong envp shows up here and nowhere else (`env::var` goes
#            through `getenv` and would still work).
#   flush  - the success marker is printed with NO trailing newline and nothing
#            follows it. Captured output is fully buffered, so it only reaches
#            the runner if termination went through libc `exit`. Exiting with a
#            raw process kill instead would silently drop it.
#
# NOT covered here: C/C++ static constructors (the .preinit_array/_init/.init_array
# walk on Linux, mingw's __main on Windows). Observing those needs a native object
# with a constructor in it, which this project has no way to build.

[project]
project_name = "hosted_entry_gate"
output_dir   = "build"
target_type  = "executable"
source_dir   = "src"
entry_point  = "src/main.cryo"

