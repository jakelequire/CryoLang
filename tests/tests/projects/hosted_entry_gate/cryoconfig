# hosted_entry_gate - the standing acceptance check for the HOSTED program entry.
#
# A hosted Windows binary starts at the runtime's `__cryo_entry`
# (runtime/core/entry.cryo): the driver links the runtime's hosted archive and
# passes `-Wl,-e,__cryo_entry`, so the entry owns everything mingw's startup
# would otherwise have done. A hosted Linux binary starts through glibc
# (crt1's `_start`, then `__libc_start_main`). This project asserts the parts
# of startup a Cryo program can observe, on both:
#
#   argv   - handed to `main` as argc/argv (on Windows, split out of the PEB's
#            command line by the runtime).
#   envp   - `main`'s THIRD argument, which `env::vars()` reads (on Windows,
#            transcoded from the PEB's environment block), so a wrong envp
#            shows up here and nowhere else (`env::var` goes through `getenv`
#            and would still work).
#   flush  - the success marker is printed with NO trailing newline and nothing
#            follows it. Captured output is fully buffered, so it only reaches
#            the runner if termination went through libc `exit`. Exiting with a
#            raw process kill instead would silently drop it.
#
# NOT covered here: C static constructors and destructors. The Linux ones are
# linux_startup_runs_c_initializers_once's; mingw's __main on Windows is not
# covered, since that needs a native object this project has no way to build.

[project]
project_name = "hosted_entry_gate"
output_dir   = "build"
target_type  = "executable"
source_dir   = "src"
entry_point  = "src/main.cryo"

