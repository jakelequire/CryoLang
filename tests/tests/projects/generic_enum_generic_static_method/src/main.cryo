/// A static method with a type parameter of its own (`scaled<S>`) called
/// through a generic enum's path runs the copy for the enum's arguments and
/// the method's - written or inferred from the argument - as one on a
/// generic struct does: each copy calls its own `S`'s `width`.
namespace GenericEnumGenericStaticMethod::Main;

import std::ffi::libc::{ printf };

type trait Width {
    width(&this) -> i64;
}

type struct Narrow { n: i32; }
type struct Wide { n: i64; }

implement trait Width for struct Narrow {
    width(&this) -> i64 { return 4; }
}

implement trait Width for struct Wide {
    width(&this) -> i64 { return 8; }
}

type enum Outcome<T, E> {
    Good(T);
    Bad(E);
}

implement enum Outcome<T, E> {
    static scaled<S>(source: S, scale: i64) -> i64 where S: Width {
        return source.width() * scale;
    }
}

function check(passed: i32, condition: boolean, what: string) -> i32 {
    if (!condition) {
        printf("FAILED: %s\n", what);
        return passed;
    }
    return passed + 1;
}

function main() -> i32 {
    mut passed: i32 = 0;
    passed = check(passed, Outcome::<u8, i32>::scaled::<Narrow>(Narrow { n: 1 }, 10) == 40,
        "the method's argument written");
    passed = check(passed, Outcome::<u8, i32>::scaled(Wide { n: 1 }, 10) == 80,
        "the method's argument inferred");
    passed = check(passed, Outcome::<i64, i64>::scaled(Narrow { n: 1 }, 3) == 12,
        "another instantiation of the enum");
    printf("generic enum generic static methods: %d of 3 checks passed\n", passed);
    if (passed != 3) { return 1; }
    return 0;
}
