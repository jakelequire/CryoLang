/// A reference compares with a reference or `null` and nothing else. Two
/// references compare values and a pointer compares addresses, so a
/// reference beside a pointer is refused, whichever side each is on and
/// whether or not the referent implements `Eq`, with the help writing both
/// meanings out: the values, and the addresses with the reference converted
/// to the pointer's type (a `void*` points at no value). A reference beside
/// a function is refused the same way: one that refers to a function is
/// shown that function compared, any other what it compares with. The
/// `null` literal is no address of anything, so a reference still compares
/// with it, whether or not its referent implements `Eq`. A value beside a
/// pointer is refused as the type check refuses it: `Eq` takes its operand
/// as `&This`, so no implementation answers for a pointer.
namespace ReferenceComparedWithPointerRefused::Main;

type struct Point { x: i64; y: i64; }

implement trait Eq for Point {
    equals(&this, other: &Point) -> boolean { return this.x == other.x && this.y == other.y; }
}

type struct Plain { value: i64; }

function nothing() -> void { }

function main() -> i32 {
    const point: Point = Point { x: 1, y: 2 };
    const at_point: &Point = &point;
    const to_point: Point* = &point as Point*;
    const plain: Plain = Plain { value: 1 };
    const at_plain: &Plain = &plain;
    const to_plain: Plain* = &plain as Plain*;
    const untyped: void* = &plain as void*;
    const count: i64 = 3;
    const at_count: &i64 = &count;
    const to_count: i64* = &count as i64*;
    const action: () -> void = nothing;
    const at_action: &(() -> void) = &action;
    mut hits: i32 = 0;
    if (at_point == to_point) { hits = hits + 1; }
    if (to_plain != at_plain) { hits = hits + 1; }
    if (at_count == to_count) { hits = hits + 1; }
    if (at_plain == untyped) { hits = hits + 1; }
    if (at_point == action) { hits = hits + 1; }
    if (action != at_action) { hits = hits + 1; }
    if (at_point == null || null != at_plain) { hits = hits + 1; }
    if (point == to_point) { hits = hits + 1; }
    return hits;
}
