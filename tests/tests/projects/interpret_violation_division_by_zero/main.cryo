// `cryo interpret` refuses a division by zero, which the language reference
// says faults, as a violation at the division.

namespace Main;

import std::fmt;

function divide(a: i32, b: i32) -> i32 {
    return a / b;
}

function main() -> i32 {
    const zero: i32 = 0;
    fmt::println(f"{divide(7, zero)}");
    return 0;
}
