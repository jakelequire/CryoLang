/// `delete p` releases `*p` as a scope exit releases a value of its type:
/// the pointee's `Drop`, if it has one, then the values its fields own.  A
/// struct with no `Drop` of its own still has its array's elements and its
/// owning field released, and one with a `Drop` runs it once, then its
/// fields' releases, each once.
namespace DeleteReleasesOwnedFields::Main;

import std::fmt;
import std::core::drop::{ Drop };

type struct Probe { id: i32; }

mut g_released: i32 = 0;
mut g_holder_dropped: i32 = 0;

implement trait Drop for struct Probe {
    drop(mut &this) -> void { g_released = g_released + 1; }
}

/// No `Drop` of its own: everything it releases is its fields'.
type struct Bag {
    items: [Probe];
    single: Probe;
}

/// A `Drop` of its own, which releases nothing it owns.
type struct Holder {
    item: Probe;
}

implement trait Drop for struct Holder {
    drop(mut &this) -> void { g_holder_dropped = g_holder_dropped + 1; }
}

function main() -> i32 {
    mut bag: Bag* = new Bag { items: [], single: Probe { id: 0 } };
    bag.items.push(Probe { id: 1 });
    bag.items.push(Probe { id: 2 });
    delete bag;
    fmt::println(f"bag released {g_released} of 3");

    g_released = 0;
    mut holder: Holder* = new Holder { item: Probe { id: 3 } };
    delete holder;
    fmt::println(f"holder dropped {g_holder_dropped}, released {g_released} of 1");
    return 0;
}
