namespace ReexportPrivate::Store;

/// Not in this module's export set. Spelled `private` deliberately: the
/// default is public, so an unmarked declaration would test nothing.
private type struct Hidden {
    v: i32;

    get(&this) -> i32 { return this.v; }
}

type struct Shown {
    v: i32;

    get(&this) -> i32 { return this.v; }
}
