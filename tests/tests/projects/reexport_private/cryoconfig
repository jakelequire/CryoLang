# reexport_private - an `export` naming a `private` item is E0241, reported
# where the export is WRITTEN.
#
# An export cannot widen visibility, so `Hidden` is grantable by nobody. The
# author of the export can act on that; an importer, who would only see the
# name appear absent, cannot -- which is why this is not left to E0240 at the
# use site.
#
# Per Q7 a top-level declaration is PUBLIC by default, so `private` must be
# spelled or this project exercises nothing: `Shown` is the control that the
# gate is not simply rejecting every re-exported item. That control asserts on
# the REJECTION phrasings, not on the bare name -- the caret display echoes the
# source line, so `Shown` appears in the output either way and excluding it
# would fail whatever the compiler did. `aborting due to 1 error` pins the
# count, which is what "only Hidden was rejected" actually means.
#
# Separate from reexport_private_module: this arm is decided after the LAST
# module's type resolution, and that arm aborts the build during it, so one
# project cannot hold both -- this one would never be reached.

[project]
project_name = "reexport_private"
output_dir   = "build"
target_type  = "executable"
source_dir   = "src"
entry_point  = "src/main.cryo"

[compiler]

