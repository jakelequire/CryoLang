/// `put` is declared twice with type parameters of its own, at one and at two
/// arguments.  `o.put(1)` calls the first and `o.put(1, 2)` the second, on a
/// plain type, on a generic type, and in each copy of a generic function.
namespace GenericMethodOverloadsSelectByArguments::Main;

import std::ffi::libc;

type struct O { v: i32; }
implement struct O {
    put<U>(&this, u: U) -> i32 { return 1; }
    put<U>(&this, u: U, w: i32) -> i32 { return 2; }
}

type struct Ov<T> { v: T; }
implement<T> struct Ov<T> {
    put<U>(&this, u: U) -> i32 { return 1; }
    put<U>(&this, u: U, w: i32) -> i32 { return 2; }
}

function both<X>(o: &O, x: X) -> i32 {
    return o.put(x) + o.put(x, 2) * 10;
}

function main() -> int {
    const o: O = O { v: 0 };
    const a: i32 = o.put(1) + o.put(1, 2) * 10;
    const g: Ov<i32> = Ov::<i32> { v: 0 };
    const b: i32 = g.put(1) + g.put(1, 2) * 10;
    const c: i32 = both::<i64>(&o, 5 as i64) + both::<u8>(&o, 7 as u8) - 21;
    libc::printf("overloads %d %d %d\n", a, b, c);
    if (a != 21 || b != 21 || c != 21) { return 1; }
    return 0;
}
