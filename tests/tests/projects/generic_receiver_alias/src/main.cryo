/// A method whose receiver is written through a non-generic alias of one
/// instantiation of its owner is specialized for that instantiation, and it
/// reads the receiver at the alias's argument type.  The owner's other
/// methods stay on every instantiation.
namespace GenericReceiverAlias::Main;

type struct Wrapper<T> { val: T; }

type WideWrapper = Wrapper<i64>;

implement struct Wrapper<T> {
    get(&this) -> T { return this.val; }
    wide(this: &WideWrapper) -> i64 { return this.val; }
}

function main() -> i32 {
    // 2^32 + 7: both halves must survive the read.
    const w: Wrapper<i64> = Wrapper::<i64> { val: 4294967303 };
    const r: i64 = w.wide();
    const n: Wrapper<i32> = Wrapper::<i32> { val: 2 };
    // 1 * 10 + 7 + 2
    return (r / 4294967296) as i32 * 10 + (r % 4294967296) as i32 + n.get();
}
