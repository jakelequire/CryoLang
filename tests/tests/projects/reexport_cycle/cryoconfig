# reexport_cycle - two modules re-exporting from each other COMPILE.
#
# This is the control on the edge kind, and the reason `export` may never
# become a build-order edge: a per-export dependency edge would make this
# program one E0501 cycle, which is the trap `public module` already hit.
# Because the cycle is legal, resolution through re-exports cannot terminate
# on the graph being acyclic -- it terminates on a seen-set.
#
# `main` imports Alpha only, and names a type Alpha never declares.

[project]
project_name = "reexport_cycle"
output_dir   = "build"
target_type  = "executable"
source_dir   = "src"
entry_point  = "src/main.cryo"

