namespace TraitQualified::Main;

type trait Beta {
    go(&this) -> i32;
}

type trait Gamma {
    go(&this) -> i32;
}

type struct P {
    v: i32;
}

implement trait Beta for P {
    go(&this) -> i32 { return this.v * 2; }
}

implement trait Gamma for P {
    go(&this) -> i32 { return this.v * 5; }
}

function main() -> int {
    const p: P = P { v: 1 };
    // `p.go()` and `P::go(&p)` are E0156 here: two traits provide `go`.
    // Naming the trait chooses: each call runs that trait's body. 2*10 + 5.
    const b: i32 = Beta::go(&p);
    const g: i32 = Gamma::go(&p);
    return b * 10 + g;
}
