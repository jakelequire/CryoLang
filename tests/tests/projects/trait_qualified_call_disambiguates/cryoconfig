# trait_qualified_call_disambiguates - a method two traits provide for one
# type is called through the trait's own path: `Beta::go(&p)` runs Beta's
# body and `Gamma::go(&p)` Gamma's, where `p.go()` and `P::go(&p)` are the
# E0156 tie.  The implementation is the receiver's - the first argument's
# type behind its reference - and the method the named trait delivers for
# it.  Under the compilers before this landed the path reached codegen
# unpinned and was refused as `cannot resolve 'Beta::go'` (E0636).
[project]
project_name = "trait_qualified_call_disambiguates"
output_dir   = "build"
target_type  = "executable"
source_dir   = "src"
entry_point  = "src/main.cryo"
[compiler]
[dependencies]
