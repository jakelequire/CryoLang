namespace StaticMatchArmNarrowsParam::Main;

// Inside a `static match (T)` arm, `T` is the type the arm listed: a `T`
// annotation and `as T` name it.  An arm listing several types is valid for
// each, and each instantiation selecting it computes at its own type.
function bump<T>(x: T) -> i64 {
    return static match (T) {
        u8 | i32 => {
            const y: T = x + (1 as T);
            (y as i64) * 100 + (sizeof(T) as i64)
        }
        i64 => {
            const z: T = x * (2 as T);
            z
        }
        _ => { 0 }
    };
}

// A method of the listed type, called in an arm listing several types.
function cap<T>(x: T) -> i64 {
    return static match (T) {
        u8 | i32 => { x.clamp(0 as T, 50 as T) as i64 }
        _        => { -1 }
    };
}

function describe<T>(x: T) -> i64 {
    mut out: i64 = 0;
    static match (T) {
        boolean => { out = if (x) { 4 } else { 3 }; }
        f64     => { out = x as i64; }
        _       => { out = -1; }
    }
    return out;
}

function main() -> i32 {
    if (bump(40 as u8) != 4101) { return 1; }
    if (bump(-3 as i32) != -196) { return 2; }
    if (bump(21 as i64) != 42) { return 3; }
    if (bump(true) != 0) { return 4; }
    if (cap(200 as u8) != 50) { return 8; }
    if (cap(-7 as i32) != 0) { return 9; }
    if (cap(1.5) != -1) { return 10; }
    if (describe(true) != 4) { return 5; }
    if (describe(7.9) != 7) { return 6; }
    if (describe(1 as u16) != -1) { return 7; }
    return 0;
}
