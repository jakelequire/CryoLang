# static_match_arm_narrows_param - inside a `static match (T)` arm, `T` is
# the type the arm listed (`const y: T`, `x as T`), and an arm listing
# several types is valid for each: `u8 | i32` computes at each width.  The
# program exits 0; each wrong answer exits with its own code.
[project]
project_name = "static_match_arm_narrows_param"
output_dir   = "build"
target_type  = "executable"
source_dir   = "src"
entry_point  = "src/main.cryo"
[compiler]
[dependencies]
