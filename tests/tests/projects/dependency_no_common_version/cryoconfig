# dependency_no_common_version - the program takes gauge 1.2.0 and accepts
# only 1.2.x (`~1.2`); its dependency dial takes gauge 1.5.0 and accepts 1.5
# and later. One major version is asked for, but neither version meets both
# requirements, so `cryo fetch` refuses it and shows the program's entry
# rewritten to build gauge 1.5.0.
[project]
project_name = "dependency_no_common_version"
output_dir   = "build"
target_type  = "executable"
source_dir   = "src"
entry_point  = "src/main.cryo"

[compiler]

[dependencies]
gauge = { git = "{fixture:gauge}", tag = "v1.2.0", version = "~1.2" }
dial  = { path = "packages/dial" }
