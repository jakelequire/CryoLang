{
  "outcome": "command",
  "requires": ["git"],
  "git_fixtures": [
    { "name": "gauge", "from": "fixtures/gauge",
      "commits": [ { "tree": "v1.2.0", "tag": "v1.2.0" },
                   { "tree": "v1.5.0", "tag": "v1.5.0" } ] }
  ],
  "command": ["fetch"],
  "expect": {
    "fails": true,
    "stderr_contains": [
      "error: no version of `gauge` (",
      ") meets every requirement on it",
      "  note: the program requires ~1.2: cryoconfig writes `gauge = { git = \"file://",
      "\", tag = \"v1.2.0\", version = \"~1.2\" }`, which names gauge 1.2.0",
      "  note: `dial` 0.1.0 requires 1.5: ",
      "\", tag = \"v1.5.0\", version = \"1.5\" }`, which names gauge 1.5.0",
      "  help: to build gauge 1.5.0, write `gauge = { git = \"file://",
      "\", tag = \"v1.5.0\", version = \"1\" }` in cryoconfig"
    ],
    "stderr_excludes": ["help: `dial`", "major version"]
  }
}
