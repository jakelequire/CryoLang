# module_type_import_collision - a type bound under an imported module's
# name is a redeclaration, refused at the entry that completed the pair.
#
# Modules and types share ONE namespace in a file's scope (docs/cryo.md
# 14.6).  `import Gpu::Vertex;` makes `Vertex` spell the module in main's
# scope, and `type struct Vertex` declared after it makes the same name a
# type: E0205 at the declaration.  The other half of the rule - a module
# declaring a type named like itself - is `module_type_name_collision`.
#
# A project rather than a lang test because the shape needs two real modules.

[project]
project_name = "module_type_import_collision"
output_dir   = "build"
target_type  = "executable"
source_dir   = "src"
entry_point  = "src/main.cryo"

