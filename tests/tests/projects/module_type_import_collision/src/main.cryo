namespace ModuleTypeImportCollision::Main;

import ModuleTypeImportCollision::Gpu::Vertex;

// `Vertex` spells the imported module `Gpu::Vertex` in this scope, so a
// type declared under that name is a second owner of it: E0205 at the
// declaration, the entry that completed the pair.
type struct Vertex { v: i32; }

function main() -> i32 {
    const x: Vertex = Vertex { v: 1 };
    return x.v + Vertex::count();
}
