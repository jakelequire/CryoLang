namespace IndexViewMutableBoundSlicesATypeParameter;

// A type parameter bounded by `IndexViewMutable` alone is viewed through
// that bound's supertrait `IndexView`, at the index type the bound writes:
// `[]` on it is a view, and a range literal indexing it takes the bound's
// range type, as under a bound naming `IndexView` itself.  Writing both
// bounds at the same index type is the same view.

import std::core::ops::{ IndexView, IndexViewMutable, Range };
import std::collections::array::{ Array };
import std::core::slice::{ Slice };

function first_two<C>(container: &C) -> C::View where C: IndexViewMutable<Range<i64>> {
    return container[0..2];
}

function from<C>(container: &C, start: i64, end: i64) -> C::View where C: IndexViewMutable<Range<i64>> {
    return container[start..end];
}

function last_two<C>(container: &C) -> C::View
        where C: IndexView<Range<i64>>, C: IndexViewMutable<Range<i64>> {
    return container[1..3];
}

function main() -> i32 {
    mut values: Array<i32> = Array::<i32>::new();
    values.push(4);
    values.push(5);
    values.push(6);
    const part: &Slice<i32> = first_two(&values);
    if (part.length() != 2) { return 1; }
    if (part[1] != 5) { return 2; }
    const tail: &Slice<i32> = from(&values, 1, 3);
    if (tail[1] != 6) { return 3; }
    const end: &Slice<i32> = last_two(&values);
    if (end[0] != 5) { return 4; }
    return 0;
}
