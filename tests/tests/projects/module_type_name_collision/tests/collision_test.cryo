![config(testing)]
namespace ModuleTypeCollision::Tests::Collision;

import ModuleTypeCollision::Gpu::Buffer;
import std::core::result;
import std::test::error;
import std::test::assert;

// A module-level const reached through a qualifier that also names a type.
// Only the call-argument position ever worked; every other position typed the
// path as the struct.
![test]
function const_through_colliding_qualifier_in_argument() -> Result<(), TestError> {
    return expect_eq(Buffer::takes_flags(Buffer::USAGE_VERTEX), 1);
}

![test]
function const_through_colliding_qualifier_in_binding() -> Result<(), TestError> {
    const v: u32 = Buffer::USAGE_VERTEX;
    return expect_eq(v, 1);
}

![test]
function const_through_colliding_qualifier_in_assignment() -> Result<(), TestError> {
    mut v: u32 = 0;
    v = Buffer::USAGE_INDEX;
    return expect_eq(v, 2);
}

// The originally reported shape: an operator next to the qualified path.
![test]
function const_through_colliding_qualifier_under_operator() -> Result<(), TestError> {
    const mask: u32 = Buffer::USAGE_VERTEX | Buffer::USAGE_INDEX;
    return expect_eq(mask, 3);
}

// CONTROL: the qualifier must still reach the TYPE's own static method, so the
// fix cannot be "the module always wins".
![test]
function static_method_still_reached_through_the_type() -> Result<(), TestError> {
    const b: Buffer::Buffer = Buffer::make(9);
    return expect_eq(b.handle, 9);
}
