# module_type_name_collision - a module and the type it declares sharing one
# name is a redeclaration, refused at the type.
#
# Modules and types share ONE namespace in a file's scope (docs/cryo.md
# 14.6).  `namespace Gpu::Buffer;` declaring `type struct Buffer` completes
# a pair inside its own file - the module's leaf spells the module there -
# so the struct is E0205, the entry that completed it.  The importer's half
# of the rule, a type bound under an imported module's leaf, is
# `module_type_import_collision`.
#
# Under the adjudicating rule this replaces, `Buffer::USAGE_VERTEX` reached
# the module's constant and `Buffer::make` the type's static through the
# same segment, by asking which of the two OWNED the member - and the
# constant arrived typed as the struct in every position but a call
# argument, surfacing as `Buffer does not implement BitOr`.  A segment now
# names exactly one owner, so there is nothing to ask.
#
# A project rather than a lang test because the shape needs two real modules.

[project]
project_name = "module_type_name_collision"
output_dir   = "build"
target_type  = "executable"
source_dir   = "src"
entry_point  = "src/main.cryo"

