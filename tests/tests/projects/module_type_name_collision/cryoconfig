# module_type_name_collision - a module and a type sharing one name.
#
# `Gpu::Buffer` is a MODULE that declares a struct also called `Buffer`, so the
# qualifier in `Buffer::USAGE_VERTEX` names both. Resolving it to the type
# without asking whether the member belongs to that type typed the whole path
# as the struct: the module's `const` arrived as a `Buffer`, and nothing
# complained until the value was used, where it surfaced as
# `Buffer does not implement BitOr` - naming neither the constant, nor the
# module, nor anything the author could act on.
#
# A project rather than a lang test because the shape needs two real modules.

[project]
project_name = "module_type_name_collision"
output_dir   = "build"
target_type  = "executable"
source_dir   = "src"
entry_point  = "src/main.cryo"

