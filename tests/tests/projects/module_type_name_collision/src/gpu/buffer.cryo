namespace ModuleTypeCollision::Gpu::Buffer;

// A module `Buffer` whose own declarations include a struct named `Buffer`.
// The module's leaf spells the module inside its own file, so the struct is
// a second owner of the name there: E0205 at the struct.
public const USAGE_VERTEX: u32 = 1;
public const USAGE_INDEX:  u32 = 2;

type struct Buffer {
    handle: u64;

    static make(h: u64) -> Buffer { return Buffer { handle: h }; }
}

public function takes_flags(flags: u32) -> u32 { return flags; }
