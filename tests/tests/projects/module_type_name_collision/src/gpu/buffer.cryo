namespace ModuleTypeCollision::Gpu::Buffer;

// The collision: a module `Buffer` whose own declarations include a struct
// named `Buffer`, plus module-level constants reached through the same
// qualifier.
const USAGE_VERTEX: u32 = 1;
const USAGE_INDEX:  u32 = 2;

type struct Buffer {
    handle: u64;

    static make(h: u64) -> Buffer { return Buffer { handle: h }; }
}

function takes_flags(flags: u32) -> u32 { return flags; }
