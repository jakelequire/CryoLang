namespace BoundNamesOneOfSeveralImpls::Main;

type trait Conv<S> {
    static conv(s: S) -> i64;
}

type struct Holder { v: i64; }

implement trait Conv<&Holder> for u64 {
    static conv(s: &Holder) -> i64 { return s.v + 1; }
}

implement trait Conv<i64> for u64 {
    static conv(s: i64) -> i64 { return s * 100; }
}

implement trait Conv<&Holder> for i32 {
    static conv(s: &Holder) -> i64 { return s.v + 2; }
}

function through_ptr<T>(h: Holder*) -> i64 where T: Conv<&Holder> {
    return T::conv(h);
}

function through_value<T>(n: i64) -> i64 where T: Conv<i64> {
    return T::conv(n);
}

function main() -> i32 {
    mut h: Holder = Holder { v: 40 };
    if (through_ptr::<u64>(&h) != 41) { return 1; }
    if (through_ptr::<i32>(&h) != 42) { return 2; }
    if (through_value::<u64>(3) != 300) { return 3; }
    return 0;
}
