# task_spawn_from_async_main - an `async function main` spawns tasks onto
# the executor polling it with `Task::spawn` and awaits their handles: a
# task's value comes back as `Ok`, and a task that panics comes back as
# `Err(Panicked)` while main carries on.

[project]
project_name = "task_spawn_from_async_main"
output_dir   = "build"
target_type  = "executable"
source_dir   = "src"
entry_point  = "src/main.cryo"

