namespace TaskSpawnFromAsyncMain;

import std::core::intrinsics;
import std::ffi::libc;
import std::future::{ JoinError, JoinHandle, Sleep, Task };
import std::time::duration::{ Duration };

async function fetch(id: i64) -> i64 {
    await Sleep::new(Duration::from_milliseconds(10));
    return id * 10;
}

async function gives_up() -> i64 {
    intrinsics::panic("the task gave up", intrinsics::location());
}

async function main() -> i32 {
    const first: JoinHandle<i64> = Task::spawn(fetch(1));
    const second: JoinHandle<i64> = Task::spawn(fetch(2));
    const doomed: JoinHandle<i64> = Task::spawn(gives_up());

    const a: i64 = (await first).unwrap();
    const b: i64 = (await second).unwrap();
    libc::printf("awaited %lld\n", a + b);

    match (await doomed) {
        Result::Ok(_) => { return 1; }
        Result::Err(JoinError::Panicked(info)) => { libc::printf("awaited a panic: %s\n", info.msg); }
        Result::Err(JoinError::Cancelled) => { return 2; }
    }
    libc::printf("main carries on\n");
    return 0;
}
