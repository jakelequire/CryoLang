namespace GenericAtReadOnlyPointer::Main;

type struct Cell {
    value: i32;
}

function first_of(p: const Cell*) -> Option<const Cell*> {
    return Option::Some(p);
}

function value_or_zero(found: Option<const Cell*>) -> i32 {
    match (found) {
        Option::Some(p) => { return p.value; }
        Option::None => { return 0; }
    }
}

function read_through_try(found: Option<const Cell*>) -> Option<i32> {
    const p: const Cell* = found?;
    return Option::Some(p.value);
}

function main() -> i32 {
    const a: Cell = Cell { value: 1 };
    const b: Cell = Cell { value: 2 };

    // `Option<const Cell*>`: its methods, and `?` through its `Try`.
    if (value_or_zero(first_of(&a)) != 1) { return 1; }
    if (value_or_zero(Option::None) != 0) { return 2; }
    if (read_through_try(first_of(&b)).unwrap() != 2) { return 3; }

    // `[const Cell*]`: every method that hands back an `Option` of an
    // element or of an element's address.
    mut cells: [const Cell*] = [];
    cells.push(&a);
    cells.push(&b);
    if (cells.length() != 2) { return 4; }
    if (cells[0].value != 1) { return 5; }
    if ((*cells.first().unwrap()).value != 1) { return 6; }
    if ((*cells.last().unwrap()).value != 2) { return 7; }
    if (cells.get(1).unwrap().value != 2) { return 8; }
    if ((*cells.get_ref(0).unwrap()).value != 1) { return 9; }
    if (cells.pop().unwrap().value != 2) { return 10; }
    if (cells.get(1).is_some()) { return 11; }

    // `[Cell*]` beside `[const Cell*]`: two instances that differ only in
    // the `const`, and share their symbols, in one program.
    mut c: Cell = Cell { value: 3 };
    mut writable: [Cell*] = [];
    writable.push(&c);
    cells.push(&c);
    writable.get(0).unwrap().value = 4;
    if (cells.get(1).unwrap().value != 4) { return 12; }
    return 0;
}
