namespace ExpectedTokenOffersNoInsertion;

// The parser stops at the `}` after `big`, wanting a `;`, and after the
// arm it gave up on stops at the next arm's `{`, wanting `=>`. Neither token
// is what is missing - an `unsafe` block inside an arm yields no value, and
// the next arm already has its `=>` - so neither error offers to insert one.

function pick(k: i32, big: u32) -> i64 {
    const r: i64 = match (k) {
        0 => { unsafe { big } }
        _ => { 0 }
    };
    return r;
}

function main() -> i32 {
    return pick(0, 1) as i32;
}
