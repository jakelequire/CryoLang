namespace CloneHelpNamesTheGenericDeclaration;

type struct Tracked { id: i32; }
implement trait Drop for struct Tracked { drop(mut &this) -> void { } }

type struct Other { id: i32; }
implement trait Drop for struct Other { drop(mut &this) -> void { } }

// No `Clone` at all: the declaration to derive it on is `Either<L, R>`.
type enum Either<L, R> {
    Left(L);
    Right(R);
}

// `Clone` wherever both arguments are.
type struct Both<A, B> with [Clone] {
    a: A;
    b: B;
}

function take_option(value: Option<Tracked>) -> void { }
function take_either(value: Either<Tracked, i32>) -> void { }
function take_both(value: Both<Tracked, Other>) -> void { }

function main() -> i32 {
    const maybe: Option<Tracked> = Option::Some(Tracked { id: 1 });
    take_option(maybe);
    take_option(maybe);

    const either: Either<Tracked, i32> = Either::Left(Tracked { id: 2 });
    take_either(either);
    take_either(either);

    const both: Both<Tracked, Other> = Both { a: Tracked { id: 3 }, b: Other { id: 4 } };
    take_both(both);
    take_both(both);
    return 0;
}
