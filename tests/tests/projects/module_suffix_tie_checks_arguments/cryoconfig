# module_suffix_tie_checks_arguments - two modules end in `::Text`; this file
# imports `Beta::Text`, whose `tag` takes a `String`, and calls it with a
# string literal.  The argument check for a module-qualified call is keyed
# by the module the segment's stamp names, so the `![implicit]` conversion
# runs and the call answers the literal's length, 5.  A check keyed by the
# written spelling missed the exact key, matched the suffix against every
# module, found two, and checked nothing: the raw literal was passed as a
# by-value `String` and the binary died of heap corruption (0xC0000374).
[project]
project_name = "module_suffix_tie_checks_arguments"
output_dir   = "build"
target_type  = "executable"
source_dir   = "src"
entry_point  = "src/main.cryo"
[compiler]
[dependencies]
