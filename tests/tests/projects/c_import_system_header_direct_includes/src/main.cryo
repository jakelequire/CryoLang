/// <math.h> declares `sqrt` and `floor` in a system header it includes
/// directly (corecrt_math.h on the Windows C runtime, bits/mathcalls.h on
/// glibc), so the angle-bracket import binds them under the alias and they
/// link against the C math library.  The exit code says which call answered
/// wrong; 0 means both held.
namespace CImportSystemHeaderDirectIncludes::Main;

import std::ffi::libc;

extern module cmath := "C" {
    #include <math.h>
}

function main() -> int {
    if (cmath::sqrt(16.0) != 4.0) { return 1; }
    if (cmath::floor(2.5) != 2.0) { return 2; }
    libc::printf("math header import ok\n");
    return 0;
}
