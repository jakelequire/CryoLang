// `cryo interpret` runs traits: methods called on a value, through a
// bound and through a trait object; a default method calling an earlier
// method on `this`; a supertrait's method called through an object of the
// trait over it; and the same reached through an enum's implementation.

namespace Main;

import std::fmt;

type trait Measure {
    size(&this) -> i32;
    doubled(&this) -> i32 { return this.size() * 2; }
}

type trait Label : Measure {
    code(&this) -> i32;
}

type struct Box2 { width: i32; height: i32; }

type enum Shade { Light; Dark(i32); }

implement trait Measure for struct Box2 {
    size(&this) -> i32 { return this.width * this.height; }
}

implement trait Label for struct Box2 {
    code(&this) -> i32 { return this.width + 100; }
}

implement trait Measure for enum Shade {
    size(&this) -> i32 {
        match (this) {
            Shade::Light => { return 1; }
            Shade::Dark(depth) => { return depth; }
        }
    }
    doubled(&this) -> i32 { return this.size() + 1000; }
}

implement trait Label for enum Shade {
    code(&this) -> i32 { return this.size() + 200; }
}

function bounded<T>(value: &T) -> i32 where T: Label { return value.size() * 10 + value.code(); }

function through_object(value: virtual &Label) -> i32 {
    return value.size() * 10000 + value.doubled() * 100 + value.code();
}

function main() -> i32 {
    const box: Box2 = Box2 { width: 3, height: 4 };
    const shade: Shade = Shade::Dark(7);
    const direct: i32 = box.size() + box.doubled() + shade.doubled();
    const by_bound: i32 = bounded(&box) + bounded(&shade);
    const by_object: i32 = through_object(&box) + through_object(&shade);
    fmt::println(f"traits: {direct} {by_bound} {by_object}");
    return 0;
}
