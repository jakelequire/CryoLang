namespace OpaqueGenericReturnOfInferredGenericLiteral;

// A generic function returning `implement Trait` built from a generic
// struct's literal written without type arguments returns, in each of its
// specializations, the instance the literal's field values give it there:
// `holding(7)` returns a `Holder<i32>` and `holding(true)` a
// `Holder<boolean>`, each answering through its own implementation.

type trait Source { next_value(mut &this) -> i64; }

type trait Weight { weight(&this) -> i64; }

implement trait Weight for i32 { weight(&this) -> i64 { return this as i64; } }

implement trait Weight for boolean { weight(&this) -> i64 { return if (this) { 100 } else { 0 }; } }

type struct Holder<T> {
    value: T;
}

implement<T> trait Source for Holder<T> where T: Weight {
    next_value(mut &this) -> i64 { return this.value.weight(); }
}

function main() -> i32 {
    mut small = holding(7);
    mut flag = holding(true);
    if (small.next_value() != 7) { return 1; }
    if (flag.next_value() != 100) { return 2; }
    return 0;
}

function holding<T>(value: T) -> implement Source where T: Weight {
    return Holder { value: value };
}
