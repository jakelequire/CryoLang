# chain_default_same_param - `Iterator`'s default `chain<J>` on a receiver
# whose impl declares its own `J` (`implement<I, J, A> trait Iterator<A> for
# struct ChainIter<I, J>`): `a.chain(b).chain(c)` with `c` of the type the
# impl's `J` is bound to.  The method's `J` and the impl's `J` are two
# declarations the substitution tables tell apart by symbol; before that they
# were one slot by spelling and the call was "no method 'chain'" (E0636).
# The two `J`s bind to ONE type here, so the arena - which keys a parameter
# by its spelling alone - has one answer for it; the sibling project
# `chain_default_param_conflict` pins what happens when they do not.
# 0+1+2 + 10+11 + 0+1 = 25.
[project]
project_name = "chain_default_same_param"
output_dir   = "build"
target_type  = "executable"
source_dir   = "src"
entry_point  = "src/main.cryo"
[compiler]
[dependencies]
