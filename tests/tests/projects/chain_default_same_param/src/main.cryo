namespace ChainDefaultSame::Main;

import std::core::iter;
import std::core::iter::{ Iterator, ChainIter };
import std::core::ops;
import std::core::ops::{ Range };
import std::core::option;
import std::core::option::{ Option };

function main() -> i32 {
    mut a: Range<i32> = Range::new(0, 3);      // 0,1,2
    mut b: Range<i32> = Range::new(10, 12);    // 10,11
    mut c: Range<i32> = Range::new(0, 2);      // 0,1
    mut sum: i32 = 0;
    for (x in a.chain(b).chain(c)) { sum = sum + x; }
    return sum;                                // 25
}
