namespace QuestionMarkThroughBoundedFrom;

import std::core::convert::{ From };
import std::core::result::{ Result };

// `?` converts an error through `From`, and an implementation whose trait
// argument is a parameter of its own, bounded, converts every type that
// meets the bound: `From<E> for Report where E: Fault`.

type trait Fault { code(&this) -> i64; }

type struct Report { code: i64; }
implement<E> trait From<E> for struct Report where E: Fault {
    static from(error: E) -> Report { return Report { code: error.code() + 100 }; }
}

type struct Disk { unit: i64; }
implement trait Fault for struct Disk { code(&this) -> i64 { return this.unit; } }

function read_disk(unit: i64) -> Result<i64, Disk> {
    if (unit > 0) { return Result::Err(Disk { unit: unit }); }
    return Result::Ok(5);
}

function load(unit: i64) -> Result<i64, Report> {
    const value: i64 = read_disk(unit)?;
    return Result::Ok(value);
}

function main() -> i32 {
    match (load(7)) {
        Result::Ok(_) => { return 1; }
        Result::Err(report) => { if (report.code != 107) { return 2; } }
    }
    match (load(0)) {
        Result::Ok(value) => { if (value != 5) { return 3; } }
        Result::Err(_) => { return 4; }
    }
    return 0;
}
