namespace Main;

// A bound that makes a type parameter `Copy` makes its values copies in the
// move check of every body it is in scope of: a method's own `where`
// clause on its owner's parameter, the owner's `where` clause, an
// implementation's, and a trait `Copy` is a supertrait of.  A type built of
// such a parameter's values (`(T, T)`) is a copy too.

type trait Plain : Copy {}

implement trait Plain for i32 {}

type struct Holder<T> {
    inner: T;

    pair(&this, value: T) -> T where T: Copy {
        const _first: T = value;
        const second: T = value;
        return second;
    }

    both(&this, value: T) -> (T, T) where T: Copy {
        const both: (T, T) = (value, value);
        const _again: (T, T) = both;
        return both;
    }

    through_supertrait(&this, value: T) -> T where T: Plain {
        const _first: T = value;
        return value;
    }
}

type struct Bounded<T> where T: Copy {
    inner: T;

    twice(&this, value: T) -> T {
        const _first: T = value;
        return value;
    }
}

type trait Twice<T> {
    twice_of(&this, value: T) -> T;
}

implement<T> trait Twice<T> for struct Holder<T> where T: Copy {
    twice_of(&this, value: T) -> T {
        const _first: T = value;
        return value;
    }
}

function main() -> i32 {
    const holder: Holder<i32> = Holder { inner: 1 };
    if (holder.pair(8) != 8) { return 1; }
    const both: (i32, i32) = holder.both(3);
    if (both[0] != 3 || both[1] != 3) { return 2; }
    if (holder.through_supertrait(4) != 4) { return 3; }
    const bounded: Bounded<i32> = Bounded { inner: 2 };
    if (bounded.twice(5) != 5) { return 4; }
    if (holder.twice_of(6) != 6) { return 5; }
    return 0;
}
