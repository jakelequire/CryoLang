/// `\u{...}` in an f-string is one escape, as in a string literal: its
/// braces open no hole, so the escape writes the code point's UTF-8 bytes
/// and a value of the same spelling in scope is not read.
namespace FstringUnicodeEscape::Main;

import std::ffi::libc::{ printf };
import std::collections::str::{ Str };
import std::collections::string::{ String };

function check(passed: i32, condition: boolean, what: string) -> i32 {
    if (!condition) {
        printf("FAILED: %s\n", what);
        return passed;
    }
    return passed + 1;
}

function main() -> i32 {
    mut passed: i32 = 0;
    const one_byte: String = f"\u{41}";
    passed = check(passed, one_byte.as_str() == Str::new("A"), "`\\u{41}` is `A`");
    const four_bytes: String = f"\u{1F600}";
    passed = check(passed, four_bytes.as_str() == Str::new("\u{1F600}") && four_bytes.as_str().length() == 4,
        "`\\u{1F600}` is its four UTF-8 bytes");
    const n: i32 = 5;
    const beside: String = f"\u{e9}x{n}\u{7d}";
    passed = check(passed, beside.as_str() == Str::new("\u{e9}x5}"), "an escape beside a hole");
    const face: i32 = 9;
    const spelled: String = f"\u{face}{face}";
    passed = check(passed, spelled.as_str() == Str::new("\u{face}9"), "an escape spelling a local reads no value");
    printf("f-string unicode escapes: %d of 4 checks passed\n", passed);
    if (passed != 4) { return 1; }
    return 0;
}
