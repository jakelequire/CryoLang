namespace ClassCastsByPointer;

type class Animal {
public:
    legs: i32;
    Animal(n: i32) { this.legs = n; }
}

type class Dog : Animal {
public:
    good: i32;
    Dog(n: i32) : Animal(n) { this.good = 1; }
}

type struct A { x: i32; }

function main() -> i32 {
    // Up and down the hierarchy, by pointer.
    const d: Dog* = new Dog(4);
    const a: Animal* = d as Animal*;
    if (a.legs != 4) { return 1; }
    const back: Dog* = a as Dog*;
    if (back.good != 1) { return 2; }
    // The value a pointer points at is read with `*`, not cast.
    const av: Animal = *a;
    if (av.legs != 4) { return 3; }
    // A cast to an aggregate's own type is the value itself.
    const s: A = A { x: 7 };
    const t: A = s as A;
    if (t.x != 7) { return 4; }
    return 0;
}
