# dependency_git_requirement_unsatisfied - the head of the fixture's default
# branch says version 0.1.1, which the requirement "0.2" does not accept, so
# `cryo fetch` refuses it, naming both and showing the entry that accepts it.
[project]
project_name = "dependency_git_requirement_unsatisfied"
output_dir   = "build"
target_type  = "executable"
source_dir   = "src"
entry_point  = "src/main.cryo"

[compiler]

[dependencies]
greeter = { git = "{fixture:greeter}", version = "0.2" }
