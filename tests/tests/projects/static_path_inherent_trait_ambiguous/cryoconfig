# static_path_inherent_trait_ambiguous - an inherent method and a trait
# impl's method share one name on one type, and the path `NnTf::go(&a, 7)`
# names both: neither outranks the other, whether either is generic or
# static, so the path is ambiguous (E0156), as the method form `a.go(7)` is.
# The help names the impl-qualified path `(Beta for NnTf)::go(&a, 7)` for
# the trait's method.  A path naming only a trait's method (`Lone::go`) is
# not a tie.
[project]
project_name = "static_path_inherent_trait_ambiguous"
output_dir   = "build"
target_type  = "executable"
source_dir   = "src"
entry_point  = "src/main.cryo"
[compiler]
[dependencies]
