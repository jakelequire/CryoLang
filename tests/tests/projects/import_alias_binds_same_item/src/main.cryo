namespace ImportAliasBindsSameItem::Main;

import ImportAliasBindsSameItem::Json::{ parse, conv, conv as cv, ident as idf, Tag as Shape };
import ImportAliasBindsSameItem::Toml::{ parse as toml_parse };
import ImportAliasBindsSameItem::Toml::twice as tw;

// Each alias names the declaration its entry names; `parse` stays Json's.
function main() -> i32 {
    if (parse("1") != 1) { return 1; }
    if (toml_parse("1") != 2) { return 2; }
    if (conv(1 as i32) != 2 || conv(5 as i64) != 100) { return 3; }
    if (cv(1 as i32) != 2 || cv(5 as i64) != 100) { return 4; }
    if (idf::<i32>(7) != 7 || idf(8) != 8) { return 5; }
    const s: Shape = Shape::make(9);
    if (s.get() != 9) { return 6; }
    const f: (i32) -> i32 = tw;
    if (tw(3) != 6 || f(4) != 8) { return 7; }
    return 0;
}
