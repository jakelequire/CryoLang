/// KNOWN-FAIL CANARY.  This test MUST FAIL - the parent meta-runner runs
/// this project with `fails: true` and asserts the `cryo test` run exits
/// non-zero.
///
/// The test framework is compiled by the compiler under test: a miscompile
/// of `expect_eq`, `?` propagation, or the runner's failure accounting
/// could convert real failures into passes, and every green run would be
/// meaningless.  This canary closes that trust loop: if failure detection
/// ever breaks, this test "passes", the project's `cryo test` exits 0, and
/// the parent suite goes red.
///
/// If you are here because known_fail_canary failed: do NOT "fix" this
/// test to pass - either this file was edited, or failure detection in the
/// framework/compiler is broken.
![config(testing)]
namespace KnownFailCanary::CanaryTest;

import std::core::result;
import std::test::error;
import std::test::assert;

![test]
function canary_this_test_must_fail() -> Result<(), TestError> {
    // 1 != 2: expect_eq MUST return Err, `?` MUST propagate it, and the
    // runner MUST turn the failure into a non-zero process exit.
    expect_eq(1, 2)?;
    return Result::Ok(());
}
