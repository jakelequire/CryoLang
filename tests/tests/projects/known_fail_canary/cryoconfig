# known_fail_canary - the trust-loop canary for the test framework itself.
#
# The framework (expect_*, Result propagation, the runner's exit code) is
# compiled by the compiler under test, so a miscompile there could convert
# failures into passes and every other green test would be meaningless.
# This project contains ONE test that must fail; the parent meta-runner
# drives it with `fails: true` and asserts the `cryo test` run exits
# NON-zero.  If failure detection ever breaks, this project goes red.

[project]
project_name = "known_fail_canary"
output_dir   = "build"
target_type  = "executable"
source_dir   = "src"
entry_point  = "src/main.cryo"

[compiler]

[dependencies]
