/// `Trait::method(receiver)` runs the implementation the receiver's type
/// selects when that implementation is generic, on a struct and on an enum,
/// as the method form `receiver.method()` does: by value and through a
/// reference, with a return written `This`, and inside a generic function,
/// where each instance calls its own receiver's copy.  A non-generic
/// implementation is called the same way beside them.
namespace TraitPathCallOnGenericImplementation::Main;

import std::ffi::libc::{ printf };

type trait Show {
    show(this) -> i64;
}

type trait Twin {
    twin(&this) -> This;
}

type struct Holder<T> {
    value: T;
    tag: i64;
}

type enum Either<A, B> {
    Left(A);
    Right(B);
}

type enum Plain {
    One;
    Two;
}

implement<T> trait Show for struct Holder<T> {
    show(this) -> i64 { return (this.value as i64) * 10; }
}

implement<T> trait Twin for struct Holder<T> {
    twin(&this) -> Holder<T> { return Holder::<T> { value: this.value, tag: this.tag * 2 }; }
}

implement<A, B> trait Show for enum Either<A, B> {
    show(this) -> i64 {
        match (this) {
            Either::Left(a) => { return a as i64; }
            Either::Right(b) => { return (b as i64) + 100; }
        }
    }
}

implement trait Show for enum Plain {
    show(this) -> i64 {
        match (this) {
            Plain::One => { return 1; }
            Plain::Two => { return 2; }
        }
    }
}

function shown<T>(holder: Holder<T>) -> i64 {
    return Show::show(holder) + 1;
}

function check(passed: i32, condition: boolean, what: string) -> i32 {
    if (!condition) {
        printf("FAILED: %s\n", what);
        return passed;
    }
    return passed + 1;
}

function main() -> i32 {
    mut passed: i32 = 0;
    const holder: Holder<i64> = Holder::<i64> { value: 4, tag: 3 };
    passed = check(passed, Show::show(holder) == 40, "a generic struct's implementation");

    const right: Either<i32, u8> = Either::Right(3);
    passed = check(passed, Show::show(right) == 103, "a generic enum's implementation");

    const doubled: Holder<i64> = Twin::twin(&holder);
    passed = check(passed, doubled.value == 4 && doubled.tag == 6, "a `This` return through a reference receiver");

    passed = check(passed, shown(Holder::<u8> { value: 2, tag: 0 }) == 21, "a generic function's u8 instance");
    passed = check(passed, shown(holder) == 41, "a generic function's i64 instance");

    passed = check(passed, Show::show(Plain::Two) == 2, "a non-generic implementation");

    printf("trait path calls on generic implementations: %d of 6 checks passed\n", passed);
    if (passed != 6) { return 1; }
    return 0;
}
