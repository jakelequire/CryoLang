/// A `where` bound written on a type that is not a parameter, on a type
/// declaration, is checked for each instantiation: `UdHighError` implements
/// `From<UdLowError>`, not `From<UdOtherError>`, so `UdConverter<UdOtherError>`
/// is refused (E0306), naming the trait with its arguments, and
/// `UdConverter<UdLowError>` is not.
namespace WhereBoundOnTypeDeclarationUnmet::Main;

import std::core::convert::{ From };

type enum UdLowError { Bad; }

type enum UdOtherError { Other; }

type enum UdHighError { Low; }

implement trait From<UdLowError> for enum UdHighError {
    static from(value: UdLowError) -> UdHighError { return UdHighError::Low; }
}

type struct UdConverter<E> where UdHighError: From<E> { tag: i32; }

function main() -> i32 {
    const fine: UdConverter<UdLowError> = UdConverter::<UdLowError> { tag: 1 };
    const refused: UdConverter<UdOtherError> = UdConverter::<UdOtherError> { tag: 2 };
    return fine.tag + refused.tag;
}
