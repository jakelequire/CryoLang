// A module that declares its own `Ordering` and `Formatter`, and a field
// type with an inherent `equals` of another shape beside its `Eq`: the
// generated code names the standard library's items and the traits'
// methods by identity, so none of these change what it does.
namespace DeriveWithClause::Identity;

import std::core::cmp::{ Eq, Ord };
import std::fmt::display::{ Debug };

public type enum Ordering {
    Up;
    Down;
}

public type struct Formatter {
    width: i64;
}

public type struct Code with [Eq, Ord, Debug] {
    value: i64;

    /// Not `Eq::equals`: a derived `equals` on a type holding a `Code`
    /// must not reach it.
    public equals(&this, other: i64) -> boolean {
        return this.value == other;
    }
}

public type struct Tagged with [Eq, Ord, Debug] {
    code: Code;
    rank: i64;
}

public function tagged(code: i64, rank: i64) -> Tagged {
    return Tagged { code: Code { value: code }, rank: rank };
}

/// The module's own `Ordering`, still usable beside the derived methods.
public function own_ordering() -> Ordering {
    return Ordering::Down;
}
