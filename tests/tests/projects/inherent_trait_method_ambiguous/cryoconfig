# inherent_trait_method_ambiguous - an inherent method and a trait impl's
# method of the same name that both accept a call's arguments make the call
# ambiguous (E0156): neither outranks the other, whichever order the two
# `implement` blocks were written in and whether the receiver or either
# method is generic.  Each of the eleven receivers below has both, and each
# call on one is refused where it is written, with every candidate named
# and the impl-qualified form `(Trait for Owner)::member(args)` in the help.
#
# A call made THROUGH a bound (`via_bound<T>` under `where T: Beta`) names
# the bound's method and is not ambiguous for any `T`, including a `T` that
# also has an inherent `go`: nothing is reported at lines 75, 80 or 106.
[project]
project_name = "inherent_trait_method_ambiguous"
output_dir   = "build"
target_type  = "executable"
source_dir   = "src"
entry_point  = "src/main.cryo"
[compiler]
[dependencies]
