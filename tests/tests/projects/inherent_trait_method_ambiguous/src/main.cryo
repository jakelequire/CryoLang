namespace InherentTraitMethodAmbiguous::Main;

import std::fmt;

type trait Beta {
    go(&this, u: i32) -> i64;
}

type trait BetaG {
    go<U>(&this, u: U) -> i64;
}

type trait Gamma {
    go(&this, u: i32) -> i64;
}

// Plain type, plain method: the trait block first, then the inherent one.
type struct NnTf { v: i32; }
implement trait Beta for NnTf { go(&this, u: i32) -> i64 { return 2; } }
implement struct NnTf { go(&this, u: i32) -> i64 { return 1; } }

// Plain type, plain method: the inherent block first.
type struct NnIf { v: i32; }
implement struct NnIf { go(&this, u: i32) -> i64 { return 1; } }
implement trait Beta for NnIf { go(&this, u: i32) -> i64 { return 2; } }

// Generic type, plain method: the trait block first.
type struct GnTf<T> { v: T; }
implement<T> trait Beta for GnTf<T> { go(&this, u: i32) -> i64 { return 2; } }
implement<T> struct GnTf<T> { go(&this, u: i32) -> i64 { return 1; } }

// Generic type, plain method: the inherent block first.
type struct GnIf<T> { v: T; }
implement<T> struct GnIf<T> { go(&this, u: i32) -> i64 { return 1; } }
implement<T> trait Beta for GnIf<T> { go(&this, u: i32) -> i64 { return 2; } }

// Generic type, generic method: the trait block first.
type struct GgTf<T> { v: T; }
implement<T> trait BetaG for GgTf<T> { go<U>(&this, u: U) -> i64 { return 2; } }
implement<T> struct GgTf<T> { go<U>(&this, u: U) -> i64 { return 1; } }

// Generic type, generic method: the inherent block first.
type struct GgIf<T> { v: T; }
implement<T> struct GgIf<T> { go<U>(&this, u: U) -> i64 { return 1; } }
implement<T> trait BetaG for GgIf<T> { go<U>(&this, u: U) -> i64 { return 2; } }

// Plain type, generic method: the trait block first.
type struct NgTf { v: i32; }
implement trait BetaG for NgTf { go<U>(&this, u: U) -> i64 { return 2; } }
implement struct NgTf { go<U>(&this, u: U) -> i64 { return 1; } }

// Plain type, generic method: the inherent block first.
type struct NgIf { v: i32; }
implement struct NgIf { go<U>(&this, u: U) -> i64 { return 1; } }
implement trait BetaG for NgIf { go<U>(&this, u: U) -> i64 { return 2; } }

// An inherent method between two traits' methods: all three are candidates.
type struct Three { v: i32; }
implement trait Beta for Three { go(&this, u: i32) -> i64 { return 2; } }
implement struct Three { go(&this, u: i32) -> i64 { return 1; } }
implement trait Gamma for Three { go(&this, u: i32) -> i64 { return 3; } }

// A generic inherent method beside a plain trait one, on a plain type and
// on a generic one.
type struct IgTn { v: i32; }
implement trait Beta for IgTn { go(&this, u: i32) -> i64 { return 2; } }
implement struct IgTn { go<U>(&this, u: U) -> i64 { return 1; } }

type struct GIgTn<T> { v: T; }
implement<T> trait Beta for GIgTn<T> { go(&this, u: i32) -> i64 { return 2; } }
implement<T> struct GIgTn<T> { go<U>(&this, u: U) -> i64 { return 1; } }

/// Through the bound the call names `BetaG::go`: not ambiguous for any `T`.
function via_bound_g<T>(x: &T) -> i64 where T: BetaG {
    return x.go::<i32>(0);
}

/// Through the bound the call names `Beta::go`: not ambiguous for any `T`.
function via_bound<T>(x: &T) -> i64 where T: Beta {
    return x.go(0);
}

function main() -> i32 {
    const a: NnTf = NnTf { v: 5 };
    const b: NnIf = NnIf { v: 5 };
    const c: GnTf<i32> = GnTf::<i32> { v: 5 };
    const d: GnIf<i32> = GnIf::<i32> { v: 5 };
    const e: GgTf<i32> = GgTf::<i32> { v: 5 };
    const f: GgIf<i32> = GgIf::<i32> { v: 5 };
    const g: NgTf = NgTf { v: 5 };
    const h: NgIf = NgIf { v: 5 };
    const t: Three = Three { v: 5 };
    const ig: IgTn = IgTn { v: 5 };
    const gig: GIgTn<i32> = GIgTn::<i32> { v: 5 };
    const n1: i64 = a.go(7);
    const n2: i64 = b.go(7);
    const n3: i64 = c.go(7);
    const n4: i64 = d.go(7);
    const n5: i64 = e.go::<i32>(7);
    const n6: i64 = f.go::<i32>(7);
    const n7: i64 = g.go::<i32>(7);
    const n8: i64 = h.go::<i32>(7);
    const n9: i64 = t.go(7);
    const n10: i64 = ig.go(7);
    const n11: i64 = gig.go(7);
    const n12: i64 = via_bound_g::<GgTf<i32>>(&e) + via_bound::<GnTf<i32>>(&c) + via_bound::<IgTn>(&ig);
    fmt::printf("%lld\n", n1 + n2 + n3 + n4 + n5 + n6 + n7 + n8 + n9 + n10 + n11 + n12);
    return 0;
}
