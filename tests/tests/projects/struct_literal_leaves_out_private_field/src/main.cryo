namespace StructLiteralLeavesOutPrivateField::Main;

import StructLiteralLeavesOutPrivateField::Meter::{ Gauge };

// The literal leaves out `count`, which it may write, and `slot` and
// `spare`, which it may not.  Only `count` is offered as a field to add:
// adding `slot` would be refused as leaving it out is.
function main() -> int {
    const g: Gauge = Gauge { };
    return g.count as int;
}
