namespace StructLiteralLeavesOutPrivateField::Meter;

// A literal outside this module may name `count` but neither private
// field, the one with a default included.
public type struct Gauge {
    public count: i32;
    private slot: i32;
    private spare: i32 = 3;

    public static new(count: i32) -> Gauge { return Gauge { count: count, slot: 0 }; }
}
