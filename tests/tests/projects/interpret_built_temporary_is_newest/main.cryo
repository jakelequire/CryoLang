// A statement's temporaries are released newest first, and a temporary is
// made when its value is complete.  The outer literal below is built while
// its field's call borrows an inner literal, so the outer one is made last
// and released first.  `cryo interpret` releases them in that order; the
// compiled program does too.

namespace Main;

import std::fmt;

mut log: u64 = 0;

type struct Tracked {
    code: u64;
    seen: u64;
}

implement trait Drop for struct Tracked {
    drop(mut &this) -> void { log = log * 10 + this.code; }
}

function peek(tracked: &Tracked) -> u64 { return tracked.code; }

function main() -> i32 {
    const seen: u64 = peek(&(Tracked { code: 2, seen: peek(&(Tracked { code: 1, seen: 0 })) }));
    fmt::println(f"released: {log} {seen}");
    return 0;
}
