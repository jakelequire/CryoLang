# compiler_log_flag_over_project - cryoconfig's `debug = true` switches logging on beneath the command line: `--log lex=off`, its value given as the next argument, keeps the lexer quiet while the other areas the project switched on still log.
[project]
project_name = "compiler_log_flag_over_project"
output_dir   = "build"
target_type  = "executable"
source_dir   = "src"
entry_point  = "src/main.cryo"
[compiler]
debug = true
