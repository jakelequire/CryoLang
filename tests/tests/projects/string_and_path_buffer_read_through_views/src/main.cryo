namespace StringAndPathBufferReadThroughViews::Main;

import std::collections::str::{ Str };
import std::collections::string::{ String };
import std::fs::path::{ Path, PathBuf };

// A `String` reads through the `Str` view of its text and a `PathBuf` through
// the `Path` view of its own, so the view's methods answer on the owner, and
// the view follows the text as it grows past its storage, shrinks and moves.
// The exit code names the first answer that was wrong.

function length_of(text: Str) -> i64 { return text.length(); }

function main() -> i32 {
    mut text: String = String::new();
    if (!text.is_empty() || text.length() != 0) { return 1; }
    // Growing well past the first allocation moves the storage more than once.
    for (mut i: i64 = 0; i < 40; i++) { text.push("ab,"); }
    if (text.length() != 120) { return 2; }
    if (text.split(&Str::new(",")).count() != 41) { return 3; }
    if (!text.starts_with(&Str::new("ab,ab")) || !text.ends_with(&Str::new("ab,"))) { return 4; }
    if (text.rfind(&Str::new("ab")).unwrap() != 117) { return 5; }
    if (length_of(*text) != 120) { return 6; }
    if (text.chars().count() != 120) { return 7; }
    text.truncate(5);
    if (text.as_str() != Str::new("ab,ab")) { return 8; }
    text.shrink_to_fit();
    if (text.find(&Str::new(",")).unwrap() != 2) { return 9; }
    text.insert(0, 'x');
    if (text.pop().unwrap() != 'b' || text.remove(0) != 'x') { return 10; }
    if (text.trim() != Str::new("ab,a")) { return 11; }
    text.clear();
    if (!text.is_empty()) { return 12; }
    const lines: String = String::from("one\ntwo\nthree");
    if (lines.lines().count() != 3) { return 13; }

    mut path: PathBuf = PathBuf::from(Str::new("/usr/lib"));
    path.push(Str::new("libcryo.so"));
    if (path.length() != 19) { return 14; }
    if (path.file_name().unwrap() != Str::new("libcryo.so")) { return 15; }
    if (path.extension().unwrap() != Str::new("so")) { return 16; }
    if (path.parent().unwrap().as_str() != Str::new("/usr/lib")) { return 17; }
    if (!path.pop() || path.as_str() != Str::new("/usr/lib")) { return 18; }
    const joined: PathBuf = path.join(Str::new("cryo"));
    if (joined.as_str() != Str::new("/usr/lib/cryo")) { return 19; }
    const renamed: PathBuf = joined.with_extension(Str::new("toml"));
    if (renamed.stem().unwrap() != Str::new("cryo") || renamed.length() != 18) { return 20; }
    const view: Path = *renamed;
    if (!view.starts_with(Path::new("/usr"))) { return 21; }
    return 0;
}
