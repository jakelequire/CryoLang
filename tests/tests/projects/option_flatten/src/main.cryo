///! `Option<Option<T>>::flatten` gives the inner option of a `Some` and
///! `None` otherwise, and moves an owned payload out exactly once.

namespace Main;

mut g_dropped: i64 = 0;

type struct Tracked {
    label: i64;
}

implement trait Drop for struct Tracked {
    drop(mut &this) -> void { g_dropped = g_dropped + 1; }
}

function main() -> int {
    const both: Option<Option<i32>> = Option::Some(Option::Some(4));
    const inner_none: Option<Option<i32>> = Option::Some(Option::None);
    const outer_none: Option<Option<i32>> = Option::None;
    if (both.flatten().unwrap_or(0) != 4) { return 1; }
    if (inner_none.flatten().is_some()) { return 2; }
    if (outer_none.flatten().is_some()) { return 3; }
    {
        const owned: Option<Option<Tracked>> = Option::Some(Option::Some(Tracked { label: 9 }));
        const flat: Option<Tracked> = owned.flatten();
        match (flat) {
            Option::Some(t) => { if (t.label != 9) { return 4; } }
            Option::None => { return 5; }
        }
    }
    if (g_dropped != 1) { return 6; }
    return 0;
}
