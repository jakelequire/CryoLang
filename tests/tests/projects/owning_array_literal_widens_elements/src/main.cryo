namespace owning_array_literal_widens_elements;

import std::collections::array::{ Array };

function main() -> i32 {
    const minus_two: i16 = -2;
    const small: u16 = 65535;
    const grown: Array<i64> = [minus_two, small, minus_two];
    if (grown[0] != -2) { return 1; }
    if (grown[1] != 65535) { return 2; }
    if (grown[2] != -2) { return 3; }
    return 0;
}
