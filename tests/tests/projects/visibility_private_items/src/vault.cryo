namespace VisibilityPrivateItems::Vault;

private const SEALED: i32 = 9;
public const OPEN: i32 = 1;
private mut tally: i32 = 0;
private type Width = i64;
public type Height = i64;

/// A trait's methods have no visibility of their own: they are reachable
/// only where the trait is, whatever type implements it.
private type trait Hidden { hidden(&this) -> i32; }
public type trait Shown { shown(&this) -> i32; }

public type struct Plate {
    private serial: i32;
    label: i32;
    public static make() -> Plate { return Plate { serial: 7, label: 1 }; }
}

implement trait Hidden for Plate { hidden(&this) -> i32 { return 4; } }
implement trait Shown for Plate { shown(&this) -> i32 { return 5; } }
