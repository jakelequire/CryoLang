namespace VisibilityPrivateItems::Main;

import VisibilityPrivateItems::Vault;
import VisibilityPrivateItems::Vault::{ SEALED, Width, Plate };

function bounded<T>(x: &T) -> i32 where T: Vault::Hidden { return 0; }

function main() -> int {
    mut n: i32 = Vault::SEALED;
    n = n + Vault::tally;
    const { serial: s, label: l }: Plate = Plate::make();
    const p: Plate = Plate::make();
    n = n + s + l + p.hidden();
    // The public items are reachable: none of these is reported.
    const h: Vault::Height = 3;
    n = n + Vault::OPEN + p.shown() + (h as i32);
    return n as int;
}
