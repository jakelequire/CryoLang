namespace TraitImplTargetLeafCollision::Shared;

/// `twice` has a body and its own generic param, so it is not cloned into an
/// impl block before sema: the receiver's impl is looked up in the trait-impl
/// table, and `T` is substituted from the trait arguments that impl was
/// written with. Picking the wrong impl therefore picks the wrong `T`.
type trait Feed<T> {
    seed(&this) -> T;
    twice<B>(&this, b: B) -> T { return this.seed(); }
}
