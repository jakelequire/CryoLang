/// Shares its leaf with `TraitImplTargetLeafCollision::Alpha::Cell` and is
/// otherwise unrelated to it. Making the leaf plural is the whole variable:
/// renaming this type makes the program compile unchanged.
namespace TraitImplTargetLeafCollision::Omega;

import TraitImplTargetLeafCollision::Shared;
import TraitImplTargetLeafCollision::Shared::{ Feed };

type struct Cell { v: int; }

implement trait Feed<double> for struct Cell {
    seed(&this) -> double { return 2.5; }
}
