namespace TraitImplTargetLeafCollision::Main;

// Order matters, and that is the defect being pinned: with these two lines
// swapped the program compiled even before the fix.
import TraitImplTargetLeafCollision::Alpha;
import TraitImplTargetLeafCollision::Omega;

function main() -> int {
    const a: TraitImplTargetLeafCollision::Alpha::Cell =
        TraitImplTargetLeafCollision::Alpha::Cell { v: 0 };
    const x: int = a.twice(0);
    if (x != 11) { return 10; }

    const o: TraitImplTargetLeafCollision::Omega::Cell =
        TraitImplTargetLeafCollision::Omega::Cell { v: 0 };
    const y: double = o.twice(0);
    if (y < 2.4 || y > 2.6) { return 20; }

    return 0;
}
