# trait_impl_target_leaf_collision - two modules declare a same-leaf type and
# each implements the same trait for it.
#
# The trait-impl table is appended to in module-collection order and was
# scanned for the first entry whose target matched the receiver's BARE LEAF,
# with the qualified identity offered only as an alternative in the same
# disjunction - so the leaf always answered first. Two `Cell`s then shared one
# answer, and a generic trait default (`twice<B>`) took its trait arguments
# from whichever impl the module graph reached first: `Alpha::Cell.twice()`
# reduced to `f64` and the program failed to compile with E0200.
#
# Inverting only the two `import` lines in main.cryo made it compile, which is
# the whole defect: which impl a call binds to depended on import order in an
# unrelated file. The import order below is the one that FAILED.
#
# The build IS the assertion, plus a run: both receivers must reach their own
# impl's `seed`, so an answer that merely type-checks is not enough.

[project]
project_name = "trait_impl_target_leaf_collision"
output_dir   = "build"
target_type  = "executable"
source_dir   = "src"
entry_point  = "src/main.cryo"

