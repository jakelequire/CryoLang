namespace ExpectedTypeReachesMethodReceiver;

import std::core::result::{ Result };
import std::core::option::{ Option };
import std::alloc::box::{ Box };

type struct Holder<T> {
    value: T;

    static try_make(value: T) -> Result<Holder<T>, i32> { return Result::Ok(Holder::<T> { value: value }); }
    static maybe(value: T) -> Option<Holder<T>> { return Option::Some(Holder::<T> { value: value }); }
}

function main() -> int {
    // `unwrap` on `Result<Box<T>, AllocError>` gives a `Box<T>`: `T` is `i64`.
    const b: Box<i64> = Box::try_new(41).unwrap();
    if (*b != 41) { return 1; }
    const e: Holder<i64> = Holder::try_make(1).expect("made");
    if (e.value != 1) { return 2; }
    // A `u8` value: 300 would not fit, so the instance is the one expected.
    const o: Holder<u8> = Holder::maybe(255).unwrap_or(Holder::<u8> { value: 9 });
    if (o.value != 255) { return 3; }
    const k: Option<Holder<i16>> = Holder::try_make(3).ok();
    if (k.unwrap().value != 3) { return 4; }
    // As an argument: the parameter's type is the expected type.
    if (width(Holder::try_make(7).unwrap()) != 7) { return 5; }
    return 0;
}

function width(h: Holder<u16>) -> i64 {
    return h.value as i64;
}
