/// A method whose receiver is written through a non-generic alias of
/// `Wrapper<i64>` does not exist on `Wrapper<i32>`: run there, it would read
/// the four-byte value as eight.
namespace GenericReceiverAliasRefused::Main;

type struct Wrapper<T> { val: T; }

type WideWrapper = Wrapper<i64>;

implement struct Wrapper<T> {
    get(&this) -> T { return this.val; }
    wide(this: &WideWrapper) -> i64 { return this.val; }
}

function main() -> i32 {
    const n: Wrapper<i32> = Wrapper::<i32> { val: 2 };
    return n.wide() as i32 + n.get();
}
