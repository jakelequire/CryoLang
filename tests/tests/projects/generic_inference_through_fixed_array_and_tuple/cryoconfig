# generic_inference_through_fixed_array_and_tuple - a generic function's
# type parameter is inferred from a fixed array's element and from a tuple's
# elements, and a tuple's positions are read in a generic body.  A project
# rather than a unit-test file because a compiler without the inference
# refuses the file, which would stop the whole unit suite from building.

[project]
project_name = "generic_inference_through_fixed_array_and_tuple"
output_dir   = "build"
target_type  = "executable"
source_dir   = "src"
entry_point  = "src/main.cryo"

