///! A generic function's type parameter is inferred from the argument it
///! is written into: through a fixed array's element when the lengths
///! agree, and through each element of a tuple of the same arity, by value
///! or through a reference.  A tuple's positions are read in the generic
///! body whatever its elements are, by `.N` and by `[N]`.

![config(testing)]
namespace GenericInferenceThroughFixedArrayAndTuple::Tests;

import std::core::result::{ Result };
import std::test::error::{ TestError };
import std::test::assert::{ expect_eq, expect_true };

type struct Point {
    x: i32;
    y: i32;
}

function third<T>(values: &[T; 3]) -> T {
    return values[2];
}

function first_of_pair<T>(values: [T; 2]) -> T {
    return values[0];
}

function overwrite_all<T>(values: mut &[T; 3], value: T) -> void {
    for (mut i: i64 = 0; i < 3; i++) {
        values[i] = value;
    }
}

function corner<T>(grid: &[[T; 2]; 2]) -> T {
    return grid[1][1];
}

function second_of<T>(pair: (i32, T)) -> T {
    return pair.1;
}

function swapped<T, U>(pair: (T, U)) -> (U, T) {
    return (pair.1, pair.0);
}

function first_through_reference<T>(pair: &(T, i32)) -> T {
    return pair.0;
}

function first_by_index<T>(pair: &(T, i32)) -> T {
    return pair[0];
}

![test]
function element_of_a_fixed_array_reference_binds() -> Result<(), TestError> {
    const values: [u64; 3] = [7, 8, 9];
    return expect_eq(third(&values), 9);
}

![test]
function element_of_a_fixed_array_value_binds() -> Result<(), TestError> {
    const values: [i16; 2] = [4, 5];
    const four: i16 = 4;
    return expect_eq(first_of_pair(values), four);
}

![test]
function writable_fixed_array_and_a_value_bind_one_parameter() -> Result<(), TestError> {
    mut values: [i32; 3] = [1, 2, 3];
    overwrite_all(&values, 6);
    expect_eq(values[0], 6)?;
    return expect_eq(values[2], 6);
}

![test]
function element_of_a_nested_fixed_array_binds() -> Result<(), TestError> {
    const grid: [[u8; 2]; 2] = [[1, 2], [3, 4]];
    return expect_eq(corner(&grid), 4);
}

![test]
function struct_element_of_a_fixed_array_binds() -> Result<(), TestError> {
    const points: [Point; 3] = [Point { x: 1, y: 2 }, Point { x: 3, y: 4 }, Point { x: 5, y: 6 }];
    const last: Point = third(&points);
    expect_eq(last.x, 5)?;
    return expect_eq(last.y, 6);
}

![test]
function element_of_a_tuple_binds() -> Result<(), TestError> {
    const pair: (i32, u64) = (1, 5);
    return expect_eq(second_of(pair), 5);
}

![test]
function each_element_of_a_tuple_binds_its_parameter() -> Result<(), TestError> {
    const pair: (i32, boolean) = (3, true);
    const turned: (boolean, i32) = swapped(pair);
    expect_true(turned.0, "the boolean moved to the front")?;
    return expect_eq(turned.1, 3);
}

![test]
function element_of_a_tuple_reference_binds() -> Result<(), TestError> {
    const pair: (i64, i32) = (11, 2);
    expect_eq(first_through_reference(&pair), 11)?;
    return expect_eq(first_by_index(&pair), 11);
}
