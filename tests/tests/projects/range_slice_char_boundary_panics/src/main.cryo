namespace RangeSliceCharBoundaryPanics;

import std::collections::str::{ Str };

// A string's range may not end inside a UTF-8 character: `é` is the two
// bytes 1 and 2 of "héllo", so `[0..2]` panics, and the report names the
// `text[r]` that asked.

function main() -> i32 {
    const text: Str = Str::new("héllo");
    const cut: Str = text[0..2];
    return cut.length() as i32;
}
