// `cryo interpret` runs the operating system's random source as a fixed
// stream of bytes (two draws differ, and every run draws the same), a
// growable array literal as a heap block the `alloc` language item gives,
// and `memset` to zero over wider elements as each element's zero.

namespace Main;

import std::fmt;
import std::ffi::libc;
import std::random::secure::{ SecureRng };
import std::random::source::{ RandomSource };

function main() -> i32 {
    mut rng: SecureRng = SecureRng::new();
    const first: u64 = rng.next_64();
    const second: u64 = rng.next_64();
    mut words: [u64] = [7, 8, 9, 10];
    const before: u64 = words[0] + words[1] + words[2] + words[3];
    libc::memset(words.as_mutable_pointer(), 0, 32);
    const after: u64 = words[0] + words[1] + words[2] + words[3];
    fmt::println(f"machine: {first != second} {before} {after} {words.length()}");
    return 0;
}
