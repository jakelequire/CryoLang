///! `panic`, `assert`, `unreachable` and `todo` are bound bare in every file
///! by the prelude, from `std::core::panic`, with nothing imported but the
///! intrinsics `panic` takes its place from.

namespace PanicHelpersBareFromThePrelude;

import std::core::intrinsics;
import std::fmt::{ println };

/// `n` halved; an odd `n` is a stub nobody wrote.
function halve(n: i32) -> i32 {
    if (n % 2 != 0) { todo(); }
    return n / 2;
}

/// The name of `n`, for 1 and 2 only.
function name_of(n: i32) -> string {
    return match (n) {
        1 => { "one" }
        2 => { "two" }
        _ => { unreachable() }
    };
}

function main() -> i32 {
    assert(halve(8) == 4, "eight halves to four");
    println(f"{name_of(2)}");
    panic("the helpers are bare", intrinsics::location());
}
