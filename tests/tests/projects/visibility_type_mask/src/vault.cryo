namespace VisibilityTypeMask::Vault;

/// Imported HERE and not by `Main`: the mask must come from a module the use
/// site never sees, or the test would only be measuring ordinary scope.
import VisibilityTypeMask::Decoy;

/// The private type `Main` names across the module boundary.
private type struct Hidden {
    v: i32;
}

/// CONTROL: a public sibling named the same way from `Main`.
public type struct Shown {
    v: i32;
}

/// Keeps the import above load-bearing without naming `Decoy::Hidden`, so the
/// mask is contributed by declaration alone.
public function decoy_tag() -> i32 { return VisibilityTypeMask::Decoy::tag(); }
