namespace VisibilityTypeMask::Decoy;

/// The masking declaration: a SECOND, PUBLIC type sharing the leaf `Hidden`.
/// `Main` neither imports this module nor names anything in it.
public type struct Hidden {
    v: i32;
}

/// Pulls this file into the compilation. Module discovery is import-driven, so
/// a file nothing imports contributes no declarations and the leaf would never
/// be plural.
public function tag() -> i32 { return 0; }
