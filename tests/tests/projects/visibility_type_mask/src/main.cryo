namespace VisibilityTypeMask::Main;

import VisibilityTypeMask::Vault;

function main() -> int {
    const h: VisibilityTypeMask::Vault::Hidden =
        VisibilityTypeMask::Vault::Hidden { v: 7 };
    const s: VisibilityTypeMask::Vault::Shown =
        VisibilityTypeMask::Vault::Shown { v: 1 };
    // The same private type as the SCOPE of a path (`Type::member`): a third
    // way to spell it out in full, refused by the same walk.
    const k: i32 = VisibilityTypeMask::Vault::Hidden::kind();
    return (h.v + s.v + k + VisibilityTypeMask::Vault::decoy_tag()) as int;
}
