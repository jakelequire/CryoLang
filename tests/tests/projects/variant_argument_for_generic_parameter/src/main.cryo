namespace VariantArgumentForGenericParameter::Main;

import std::core::option::{ Option };
import std::fmt;

type trait Source {
    type Item;
    take(mut &this) -> Option<This::Item>;
}

type struct Empty { n: i32; }

implement trait Source for struct Empty {
    type Item = i32;
    take(mut &this) -> Option<i32> { return Option::None; }
}

function plain_opt<T>(d: Option<T>) -> Option<T> { return d; }

function depth<T>(d: Option<Option<T>>) -> i32 {
    return match (d) {
        Option::Some(_) => { 1 }
        Option::None    => { 0 }
    };
}

function take_opt<I>(it: mut &I, d: Option<I::Item>) -> Option<I::Item> where I: Source {
    return match (it.take()) {
        Option::Some(v) => { Option::Some(v) }
        Option::None    => { d }
    };
}

function or_zero<T>(o: Option<T>, zero: T) -> T {
    return match (o) {
        Option::Some(v) => { v }
        Option::None    => { zero }
    };
}

function main() -> i32 {
    mut e: Empty = Empty { n: 0 };
    const a: Option<i32> = plain_opt(Option::Some(3));
    const b: Option<i64> = plain_opt(Option::Some(30000000000));
    const c: i32 = depth(Option::Some(Option::Some(2)));
    const d: Option<i32> = take_opt(&e, Option::Some(10));
    const z: i32 = depth(plain_opt(Option::None::<Option<i32>>));
    const t: i32 = depth(Option::<Option<i32>>::None) + depth(Option::Some(Option::None::<i64>)) * 2;
    fmt::printf("variants %d %lld %d %d %d %d\n", or_zero(a, 0), or_zero(b, 0), c, or_zero(d, 0), z, t);
    return 0;
}
