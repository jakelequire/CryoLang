namespace GenericClassInfersFromConstructor::Main;

type class Cell<T> {
public:
    v: T;
    Cell(x: T) { this.v = x; }
    get(&this) -> T { return this.v; }
}

type class Pair<A, B> {
public:
    a: A;
    b: B;
    Pair(a: A, b: B) { this.a = a; this.b = b; }
    first(&this) -> A { return this.a; }
    second(&this) -> B { return this.b; }
}

function main() -> i32 {
    // Nothing names the instance: the constructor's argument binds `T`, a
    // literal by its own type, as a generic function's call would.
    const c = Cell(4);
    if (c.get() != 4) { return 1; }

    // A typed argument binds it to its type.
    const big: i64 = 8000000000;
    const d = Cell(big);
    if (d.get() != 8000000000) { return 2; }

    // Each type parameter from its own argument.
    const p = Pair(7, big);
    if (p.first() != 7) { return 3; }
    if (p.second() != 8000000000) { return 4; }

    // Written type arguments and the expected type still decide first.
    const e = Cell::<i64>(5);
    if (e.get() != 5) { return 5; }
    const f: Cell<i64> = Cell(6);
    if (f.get() != 6) { return 6; }
    return 0;
}
