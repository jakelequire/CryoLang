namespace ImplParamBoundThroughHead::Main;

type trait Show {
    show(&this) -> i32;
}

type struct Plain { v: i32; }
type struct Num { v: i32; }

implement trait Show for struct Num {
    show(&this) -> i32 { return this.v; }
}

type struct Wrap<T> {
    inner: T;
}

// The impl's parameter is its own, spelled apart from the type's: `U` is
// bound through the head `Wrap<U>`, so `where U: Show` keeps the impl for
// `Wrap<Num>` and drops it for `Wrap<Plain>`, whose body would not compile.
implement<U> trait Show for struct Wrap<U>
where U: Show {
    show(&this) -> i32 { return this.inner.show() + 1; }
}

function main() -> int {
    const p: Wrap<Plain> = Wrap::<Plain> { inner: Plain { v: 3 } };
    const n: Wrap<Num> = Wrap::<Num> { inner: Num { v: 3 } };
    return p.inner.v + n.show();
}
