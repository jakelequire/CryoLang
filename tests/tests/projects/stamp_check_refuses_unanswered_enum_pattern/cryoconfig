# stamp_check_refuses_unanswered_enum_pattern - the name layer's exit check
# refuses a build in which an enum pattern's written path was left with no
# answer.  The program is correct; the test switch counts the first enum
# pattern the check walks as unanswered, which is the state a name layer
# that skipped it would leave.  Freestanding, so that pattern is this
# project's own.
[project]
project_name = "stamp_check_refuses_unanswered_enum_pattern"
output_dir   = "build"
target_type  = "executable"
source_dir   = "src"
entry_point  = "src/main.cryo"
[compiler]
no_std = true
no_runtime = true
test_plant_unanswered_name = "enum pattern"
[dependencies]
