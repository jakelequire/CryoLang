namespace StampCheckRefusesUnansweredEnumPattern::Main;

type enum Light { Red; Green; }

function pick(n: i32) -> Light {
    if (n > 0) { return Light::Green; }
    return Light::Red;
}

function main() -> i32 {
    match (pick(1)) {
        Light::Red   => { return 1; }
        Light::Green => { return 0; }
    }
}
