namespace TraitHeadWithWrittenArgumentSkipsOtherInstances;

import std::collections::hashmap::{ HashMap };
import std::collections::string::{ String };
import std::alloc::allocator::{ GlobalAlloc };
import std::core::hash::{ FnvHasher };

// A trait implementation whose head writes a type at one of the owner's
// positions (`String<GlobalAlloc>` for the key) is an implementation for the
// instances with that argument there and for no other: an instance keyed by
// something else neither has it nor has its head's types made at its own
// arguments.

type trait Counted {
    counted(&this) -> i64;
}

implement<V, H> trait Counted for struct HashMap<String<GlobalAlloc>, V, GlobalAlloc, H> {
    counted(&this) -> i64 { return this.length() * 10; }
}

function main() -> i32 {
    // Its value type is one no String-keyed map in the program has: a head
    // made at this map's `V` would be an instance nothing else asks for.
    mut by_number: HashMap<i64, u8, GlobalAlloc, FnvHasher> = HashMap::new();
    by_number.insert(7, 1);
    if (by_number.length() != 1) { return 1; }

    mut by_name: HashMap<String, i32, GlobalAlloc, FnvHasher> = HashMap::new();
    by_name.insert(String::from_str("a"), 1);
    by_name.insert(String::from_str("b"), 2);
    if (by_name.counted() != 20) { return 2; }
    return 0;
}
