namespace string_hex_escape_is_esc;

import std::fmt;

function main() -> i32 {
    const open: string = "\x1b[1;35m";
    const reset: string = "\x1b[0m";
    const bytes: u8* = open as u8*;
    if (bytes[0] != 27 as u8) { return 1; }
    if (open.length() != 7) { return 2; }
    if (reset.length() != 4) { return 3; }
    // A line printed through `printf` keeps everything after its first colour.
    fmt::printf("\x1b[37m|-\x1b[0m\x1b[1;35mFunctionDecl\x1b[0m 'main'\n");
    return 0;
}
