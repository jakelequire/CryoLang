namespace index_under_expected_type;

function first_plus_second(values: [f64; 2]) -> f64 {
    return values[0] + values[1];
}

function second(values: [f64; 3]) -> f64 {
    return values[1];
}

function main() -> i32 {
    const values: [f64; 2] = [1.5, 2.0];
    if (first_plus_second(values) != 3.5) { return 1; }
    if (second([0.5, 4.25, 8.0]) != 4.25) { return 2; }
    const read: f64 = values[1];
    if (read != 2.0) { return 3; }
    return 0;
}
