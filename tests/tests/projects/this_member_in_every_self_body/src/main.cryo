namespace ThisMemberInEverySelfBody;

// `This` names the self type wherever there is one: `This::member` in a
// generic struct's own body and in a trait impl (generic or not) resolves as
// it does in a non-generic struct's body, and a generic struct's static method
// returning `This` is instantiated with `This` read as the instance.

type struct Plain {
    n: i64;

    static zero() -> This { return Plain { n: 0 }; }
    static again() -> This { return This::zero(); }
}

type struct Gen<T> {
    v: T;

    static make(v: T) -> This { return Gen::<T> { v: v }; }
    static again(v: T) -> This { return This::make(v); }
    bumped(&this, v: T) -> This { return This::make(v); }
}

type trait Maker {
    static build() -> This;
    static build_twice() -> This;
}

type struct Item { n: i64; }

implement trait Maker for struct Item {
    static build() -> This { return Item { n: 4 }; }
    static build_twice() -> This { return This::build(); }
}

type struct Boxed<T> { v: T; }

implement<T> trait Maker for struct Boxed<T> where T: Maker {
    static build() -> This { return Boxed::<T> { v: T::build() }; }
    static build_twice() -> This { return This::build(); }
}

function main() -> i32 {
    mut r: i64 = Plain::again().n;
    r = r + Gen::<i64>::again(2).v;
    const g: Gen<i64> = Gen::<i64>::make(1);
    r = r + g.bumped(8).v;
    r = r + Item::build_twice().n * 4;
    r = r + Boxed::<Item>::build_twice().v.n * 16;
    return r as i32;
}
