namespace TraitImplSameNameCallAmbiguous::Main;

// Two traits provide `go` for `S`.  Inside `Bb`'s implementation for `T2`,
// `this.s.go(w)` is a call on a concrete receiver that both traits answer:
// being written inside an implementation of one of them does not choose it.
type trait Aa { go<W>(&this, w: W) -> i32; }
type trait Bb { go<W>(&this, w: W) -> i32; }

type struct S { v: i32; }
implement trait Aa for S { go<W>(&this, w: W) -> i32 { return 1; } }
implement trait Bb for S { go<W>(&this, w: W) -> i32 { return 2; } }

type struct T2 { s: S; }
implement trait Bb for T2 {
    go<W>(&this, w: W) -> i32 { return this.s.go(w); }
}

function main() -> i32 {
    const t: T2 = T2 { s: S { v: 1 } };
    return t.go(5);
}
