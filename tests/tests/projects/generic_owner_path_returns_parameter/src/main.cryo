namespace GenericOwnerPathReturnsParameter::Main;

// A method of a generic owner returning its bare parameter, or a pointer
// to it, called through a path that writes the owner's arguments: the
// written arguments are substituted into the return.
type struct Box2<T> { v: T; }
implement struct Box2<T> {
    get(&this) -> T { return this.v; }
    at(&this) -> T* { return &this.v; }
}

function main() -> i32 {
    const bx: Box2<i32> = Box2::<i32> { v: 2 };
    const c: i32 = Box2::<i32>::get(&bx);
    const p: i32* = Box2::<i32>::at(&bx);
    if (c == 2 && *p == 2) { return 0; }
    return 1;
}
