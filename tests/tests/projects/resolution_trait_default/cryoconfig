# resolution_trait_default - a trait default's body is source written in the
# TRAIT's file, and binds against that file's imports.
#
# Read src/main.cryo first. NameResolution walked struct, union, class and impl
# method bodies but not trait ones, so every module-qualified path inside a
# trait default reached sema with nothing recorded and was answered by a scan
# of the module graph - which cannot see imports at all.

[project]
project_name = "resolution_trait_default"
output_dir   = "build"
target_type  = "executable"
source_dir   = "src"
entry_point  = "src/main.cryo"

[compiler]

