/// Forces both same-leaf `::Text` modules into the module graph.
///
/// Module discovery is import-driven, so without this the two candidates for
/// `Text` collapse to one and both defaults bind correctly for a reason this
/// project is not testing.  Every call here is fully qualified, so this module
/// never asks the question the trait defaults ask.
namespace ResolutionTraitDefault::Registry;

import ResolutionTraitDefault::Alpha::Text;
import ResolutionTraitDefault::Beta::Text;

public function witness() -> i32 {
    return ResolutionTraitDefault::Alpha::Text::tag()
         + ResolutionTraitDefault::Beta::Text::tag();
}
