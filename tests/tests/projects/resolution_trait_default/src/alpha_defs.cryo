/// A trait whose DEFAULT body spells `Text::tag()` and imports `Alpha::Text`.
///
/// The body is written here and runs for every implementing type, wherever
/// those live.  What `Text` names is therefore fixed by THIS file's imports;
/// the implementor's imports describe a different file that did not write the
/// path.
namespace ResolutionTraitDefault::AlphaDefs;

import ResolutionTraitDefault::Alpha::Text;

type trait Ping {
    /// Required, so the default below has a real implementor call to make and
    /// the impl block is not empty.
    seed_a(&this) -> i32;

    ping(&this) -> i32 { return Text::tag() + this.seed_a(); }
}
