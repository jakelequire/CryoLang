/// A module-qualified path in a TRAIT DEFAULT body binds against the imports
/// of the file that WROTE the default, not the implementing type's file and
/// not whatever module the compiler is standing in when the default is
/// instantiated.
///
/// `Widget` implements both traits and imports NEITHER `::Text` module, so
/// nothing reachable from this file can supply either answer.  `AlphaDefs`
/// imports `Alpha::Text` (5) and `BetaDefs` imports `Beta::Text` (6), so the
/// two defaults must resolve to OPPOSITE parents while spelling the same
/// segment.
///
/// The exit code separates every way of getting it wrong: 11 is correct, 10 is
/// both defaults bound to Alpha, 12 is both bound to Beta - which is what any
/// resolver answering from one global scan order must produce, since it has a
/// single answer to give and the two files need different ones.  Binding
/// against the IMPLEMENTOR's imports resolves nothing at all and fails the
/// build rather than returning a number.
namespace ResolutionTraitDefault::Main;

import ResolutionTraitDefault::Registry;
import ResolutionTraitDefault::AlphaDefs;
import ResolutionTraitDefault::BetaDefs;

type struct Widget {
    unused: i32;
}

// Only the required method is given, so the inherited defaults are what run.
implement trait Ping for struct Widget {
    seed_a(&this) -> i32 { return 0; }
}

implement trait Pong for struct Widget {
    seed_b(&this) -> i32 { return 0; }
}

function main(argc: int, argv: string*) -> int {
    const w: Widget = Widget { unused: 0 };
    // Summed, not compared separately, so a wrong bind on either default
    // moves the exit code instead of being masked by the other one passing.
    const total: i32 = w.ping() + w.pong();
    return total as int;
}
