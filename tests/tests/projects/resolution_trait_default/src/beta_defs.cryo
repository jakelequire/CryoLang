/// The mirror of `AlphaDefs`: the same spelling, the opposite import.
///
/// Two trait defaults writing `Text::tag()` while importing different parents
/// is what makes this probe independent of module enumeration order - one
/// global scan order has one answer to give, and the two files need different
/// ones.
namespace ResolutionTraitDefault::BetaDefs;

import ResolutionTraitDefault::Beta::Text;

type trait Pong {
    seed_b(&this) -> i32;

    pong(&this) -> i32 { return Text::tag() + this.seed_b(); }
}
