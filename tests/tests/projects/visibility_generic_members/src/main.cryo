namespace VisibilityGenericMembers::Main;

import VisibilityGenericMembers::Vault::{ Cell };

/// A generic body reaching through its own parameter is refused as a
/// concrete receiver is, and so is its destructure, which reads every field.
function read_through<T>(c: &Cell<T>) -> T {
    return c.hidden;
}

function take_apart<T>(c: Cell<T>) -> T {
    const { hidden: h, shown: s }: Cell<T> = c;
    return s;
}

function main() -> int {
    mut c: Cell<i32> = Cell::<i32>::of(5, 6);
    mut n: i32 = c.hidden;
    c.hidden = 7;
    const built: Cell<i32> = Cell::<i32> { hidden: 1, shown: 2 };
    n = n + c.peek();
    n = n + Cell::<i32>::mint();
    // The public members are reachable: none of these is reported.
    n = n + c.shown + built.shown + c.offered() + Cell::<i32>::stocked();
    n = n + read_through(&c);
    return (n + take_apart(Cell::<i32>::of(8, 9))) as int;
}
