namespace VisibilityGenericMembers::Vault;

/// A generic type's private members are private exactly as a concrete
/// type's are: to this module.
public type struct Cell<T> {
    private hidden: T;
    shown: T;

    public static of(hidden: T, shown: T) -> Cell<T> { return Cell::<T> { hidden: hidden, shown: shown }; }
    private peek(&this) -> i32 { return 1; }
    private static mint() -> i32 { return 2; }
    public offered(&this) -> i32 { return 3; }
    public static stocked() -> i32 { return 4; }
}
