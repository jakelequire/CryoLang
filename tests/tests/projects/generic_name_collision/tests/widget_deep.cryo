/// One of two modules defining a generic `Widget`. This one is reached only by
/// an IMPORT from `WidgetMid`, never declared alongside the method that returns
/// it -- so resolving the return annotation against its module by NAME is not
/// enough; only the module's own scope (its imports) finds it.
![config(testing)]
namespace GenericNameCollision::WidgetDeep;

type struct Widget<T> {
    v: T;

    unwrap(&this) -> T { return this.v; }
}
