/// Declares a generic method whose return annotation is a BARE `Widget` that
/// this module only IMPORTS. Callers of `make` live in modules that import the
/// colliding `WidgetOther::Widget`, and the return annotation is re-resolved in
/// the caller's context -- so `Widget` here must keep meaning what THIS module
/// says it means.
![config(testing)]
namespace GenericNameCollision::WidgetMid;

import GenericNameCollision::WidgetDeep;

type struct Maker {
    tag: i64;

    static new() -> Maker { return Maker { tag: 1 }; }

    /// Inferred call site (no turbofish).
    make<T>(mut &this, v: T) -> Widget<T> {
        return Widget<T> { v: v };
    }

    /// Same annotation reached through the explicit-type-argument path, which
    /// re-resolves the return separately from the inferred one.
    make_tf<T>(mut &this, v: T) -> Widget<T> {
        return Widget<T> { v: v };
    }
}
