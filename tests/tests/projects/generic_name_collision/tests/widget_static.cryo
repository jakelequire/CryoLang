/// The STATIC-template and FREE-function arms of the same collision that
/// `widget_mid.cryo` pins for instance methods.
///
/// Why a separate module rather than two more methods on `Maker`: sema reaches
/// these through different functions, so they are independent regressions.
/// `Maker::make` is bound by `find_generic_method_in`; the two below are bound
/// by `find_static_method_template` and `check_generic_free_call` respectively
/// (spec §8.2, keystone shape B). Before this file the corpus contained no
/// static generic method at all, so the largest of those three clusters was
/// exercised by nothing.
///
/// As in `widget_mid.cryo`, `Widget` here is a BARE name this module only
/// IMPORTS -- it is never declared alongside the code that returns it. Callers
/// live in modules that import the colliding `WidgetOther::Widget`, so the
/// annotation must keep meaning what THIS module's scope says it means.
![config(testing)]
namespace GenericNameCollision::WidgetStatic;

import GenericNameCollision::WidgetDeep;

type struct StaticMaker {
    tag: i64;

    /// Static generic method. No receiver, so the return annotation cannot be
    /// recovered from a receiver type the way an instance method's can -- the
    /// only thing that can bind `Widget` correctly is this module's scope.
    static build<T>(v: T) -> Widget<T> {
        return Widget<T> { v: v };
    }

    /// The explicit-type-argument path, separate from the inferred one above.
    static build_tf<T>(v: T) -> Widget<T> {
        return Widget<T> { v: v };
    }
}

/// Free generic function whose SIGNATURE names the colliding type. Distinct
/// from `Alpha::pick`/`Beta::pick`, where the collision is on the function
/// leaf; here the function name is unique and the collision is in the type it
/// returns, which is what the callee-signature re-resolution actually gets
/// wrong.
function wrap<T>(v: T) -> Widget<T> {
    return Widget<T> { v: v };
}
