/// Imports ONLY Beta. Tested alongside UsesAlpha so the fix has to route each
/// caller to its own import rather than consistently picking one winner.
![config(testing)]
namespace GenericNameCollision::UsesBeta;

import GenericNameCollision::Beta;

function beta_pick(a: i32, b: i32) -> i32 {
    const got: i32 = pick(a, b);
    return got;
}
