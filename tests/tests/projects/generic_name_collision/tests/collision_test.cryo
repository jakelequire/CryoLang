![config(testing)]
namespace GenericNameCollision::CollisionTest;

import std::core::result;
import std::test::error;
import std::test::assert;

import GenericNameCollision::UsesAlpha;
import GenericNameCollision::UsesBeta;

// Alpha's `pick` returns the smaller; a bind to Beta's would yield 7.
![test]
function bare_call_binds_to_the_imported_module() -> Result<(), TestError> {
    expect_eq(GenericNameCollision::UsesAlpha::alpha_pick(3, 7), 3)?;
    return Result::Ok(());
}

// The mirror image: Beta's returns the larger. Both must hold at once, so a
// fix that just picks one template program-wide fails this pair.
![test]
function each_caller_binds_to_its_own_import() -> Result<(), TestError> {
    expect_eq(GenericNameCollision::UsesBeta::beta_pick(3, 7), 7)?;
    return Result::Ok(());
}

// Explicit qualification must keep working regardless of the collision.
![test]
function qualified_calls_still_resolve() -> Result<(), TestError> {
    expect_eq(GenericNameCollision::Alpha::pick<i32>(4, 9), 4)?;
    expect_eq(GenericNameCollision::Beta::pick<i32>(4, 9), 9)?;
    return Result::Ok(());
}
