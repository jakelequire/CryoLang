# generic_name_collision - two project-local modules each define a generic
# function with the SAME leaf name and arity. Templates are registered
# program-wide rather than per-importer, so both are candidates for either
# one's callers; selection has to fall back on what the CALLER imports.
#
# Before that tier existed, a same-named generic anywhere in the program made
# every bare call to either one return no template, which skipped generic
# inference and left the call typed at its abstract return type - surfacing far
# from the cause as "expected i32, found T".

[project]
project_name = "generic_name_collision"
output_dir   = "build"
target_type  = "executable"
source_dir   = "src"
entry_point  = "src/main.cryo"

