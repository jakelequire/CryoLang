namespace MovedValueCloneHint::Main;

import std::collections::string::{ String };

// A value moved twice is refused (E0452).  Its type implementing `Clone`,
// the report offers `.clone()` where the value is first moved; a struct
// without it is told to implement it.

type struct Person {
    name: String;
    age: i32;
}

type struct Token {
    text: String;
}

type struct Holder {
    token: Token;
    count: i32;
}

function take_name(n: String) -> i32 {
    return n.length() as i32;
}

function take_token(t: Token) -> i32 {
    return t.text.length() as i32;
}

function main() -> i32 {
    const person: Person = Person { name: String::from("Alice"), age: 30 };
    const a: i32 = take_name(person.name);
    const b: i32 = take_name(person.name);
    const h: Holder = Holder { token: Token { text: String::from("t") }, count: 1 };
    const c: i32 = take_token(h.token);
    const d: i32 = take_token(h.token);
    const s: String = String::from("x");
    const s2: String = s;
    const s3: String = s;
    return a + b + c + d + person.age + h.count;
}
