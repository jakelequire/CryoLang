/// Built and run end-to-end by the projects meta-runner (Low-Level Plan
/// Stage 0). This project's cryoconfig sets `[low_level] native_syscalls =
/// true`, so ConfigGating keeps the `![config(native_syscalls)]` arm of
/// `backend` and strips the `not(...)` arm. The program prints and exits with
/// the native arm's value — proving the switch flips a real built binary. The
/// OFF polarity is covered by the `config_native_syscalls_gate` lang test.
namespace NativeSyscallsGate::Main;

import std::core::intrinsics;

![config(native_syscalls)]
function backend() -> int {
    intrinsics::printf("native arm selected\n");
    return 3;
}

![config(not(native_syscalls))]
function backend() -> int {
    intrinsics::printf("libc arm selected\n");
    return 0;
}

function main() -> int {
    return backend();
}
