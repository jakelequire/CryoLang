# native_syscalls_gate - the native syscall backend's end-to-end differential
# suite, built and run by the projects meta-runner. On Linux, `std::sys` and
# `syscall::sys_callN` ARE the raw `syscall` instruction (Low-Level Plan
# Stage 2; the interim `[low_level] native_syscalls` migration switch was
# deleted once the backend was proven). Each operation is cross-checked
# against plain libc, the `-errno` contract is asserted on deliberate
# failures, and the expected exit code 3 is produced by the native
# `exit_group` path itself. The seam contract is also asserted from the unit
# suite by the `sys_seam` stdlib test.

[project]
project_name = "native_syscalls_gate"
output_dir   = "build"
target_type  = "executable"
source_dir   = "src"
entry_point  = "src/main.cryo"

