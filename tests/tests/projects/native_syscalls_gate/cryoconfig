# native_syscalls_gate - a test PROJECT that opts into the native low-level
# backend via `[low_level] native_syscalls = true`. The projects meta-runner
# builds and runs it. Since Stage 2 this is the native backend's end-to-end
# differential suite: `std::sys` and `syscall::sys_callN` compile to the raw
# `syscall` instruction, each operation is cross-checked against plain libc,
# the `-errno` contract is asserted on deliberate failures, and the expected
# exit code 3 is produced by the native `exit_group` path itself. The OFF
# polarity is covered by the `config_native_syscalls_gate` lang test and the
# `sys_seam` stdlib test (same assertions, libc backend).

[project]
project_name = "native_syscalls_gate"
output_dir   = "build"
target_type  = "executable"
source_dir   = "src"
entry_point  = "src/main.cryo"

[low_level]
native_syscalls = true

