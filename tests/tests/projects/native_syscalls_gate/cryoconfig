# native_syscalls_gate - a test PROJECT that opts into the native low-level
# backend via `[low_level] native_syscalls = true`. The projects meta-runner
# builds and runs it; ConfigGating keeps the `![config(native_syscalls)]` arm
# of `backend`, so the program prints "native arm selected" and exits 3. This
# is the ON-polarity companion to the `config_native_syscalls_gate` lang test
# (which covers the default OFF polarity).

[project]
project_name = "native_syscalls_gate"
output_dir   = "build"
target_type  = "executable"
source_dir   = "src"
entry_point  = "src/main.cryo"

[low_level]
native_syscalls = true

[compiler]

[dependencies]
