///! A method's where-clause may name its owner's parameters in a bound's
///! arguments (`R: Accepts<K>` on a method of `Holder<K>`). A generic body
///! whose own bound gives the same trait with the owner's argument put in
///! (`R: Accepts<i64>` calling it on a `Holder<i64>`) makes the call.

![config(testing)]
namespace CryoTests::Tests::Lang::MethodBoundNamesOwnerParameter;

import std::core::result::{ Result };
import std::test::error::{ TestError };
import std::test::assert::{ expect_eq };

type trait Accepts<T> {
    accept(&this, value: T) -> T;
}

type struct Doubler { }

implement trait Accepts<i64> for struct Doubler {
    accept(&this, value: i64) -> i64 { return value * 2; }
}

type struct Holder<K> {
    value: K;

    apply<R>(&this, taker: R) -> K where R: Accepts<K>, K: Copy {
        return taker.accept(this.value);
    }
}

function through_a_bound<R>(holder: &Holder<i64>, taker: R) -> i64 where R: Accepts<i64> {
    return holder.apply(taker);
}

![test]
function a_generic_body_bounded_with_the_owners_argument_makes_the_call() -> Result<(), TestError> {
    const holder: Holder<i64> = Holder::<i64> { value: 21 };
    expect_eq(through_a_bound(&holder, Doubler { }), 42)?;
    expect_eq(holder.apply(Doubler { }), 42)?;
    return Result::Ok(());
}
