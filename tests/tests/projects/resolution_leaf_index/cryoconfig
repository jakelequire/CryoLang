# resolution_leaf_index - a plural leaf, from a module that IMPORTS one of its
#                         declarers.  Read tests/leaf_index_test.cryo first.
#
# `Widget` is declared by both `Alpha` and `Omega`.  The half of this project
# that named it from a module importing NEITHER is now an error and lives in
# tests/tests/projects/plural_leaf_gate, a compile_fail asserting E0155.  What
# remains here is the half that must keep WORKING: an importing module binds the
# module it imported, which §4's rib chain requires.
#
# THE TWO ARE A PAIR AND NEITHER IS SUFFICIENT.  A change that rejected every
# bare plural leaf - rather than only one nothing binds - would satisfy the gate
# project and break these controls.  A change that stopped making the leaf
# plural at all would satisfy both while testing neither, which is what
# CONTROL_the_leaf_is_declared_by_two_distinct_types exists to catch.
#
# HISTORY WORTH KEEPING.  Before the rejection this project pinned known-wrong
# behavior: the bare leaf in the importing-nothing module resolved through the
# arena's global leaf index, which is first-registration-wins over depth-first
# module discovery seeded by FILESYSTEM enumeration order.  Which declarer won
# was therefore invisible in the source and moved when a directory was copied.
# Measured with controls in docs/name-resolution.md §8.2y; the rejection and the
# split are §8.121.  The leaf index itself survives, but only as the candidate
# pool for the did-you-mean suggestion - it no longer answers a lookup.

[project]
project_name = "resolution_leaf_index"
output_dir   = "build"
target_type  = "executable"
source_dir   = "src"
entry_point  = "src/main.cryo"

