# resolution_leaf_index - KNOWN-WRONG BEHAVIOR, PINNED SO IT CANNOT MOVE
#                          SILENTLY.  Read tests/leaf_index_test.cryo first.
#
# WHAT THIS PINS, and why it is NOT a duplicate of resolution_tripwire.
#
# `resolution_tripwire` pins a leaf declared ONCE, named by a module that
# imports nothing. That case is answered by cascade step 2c: the leaf is unique
# program-wide, so `DeclarationIndex::resolve_qualified_scoped` takes its
# single-candidate fast path, which never consults the use site's imports.
#
# THIS project declares the leaf TWICE. Two candidates skip that fast path, the
# multi-candidate branch finds no local and no imported candidate, and 2c
# correctly MISSES -- whereupon the GLOBAL LEAF INDEX (cascade step 5) answers
# instead, from the whole program, without consulting scope at all.
#
# So the two projects pin two different mechanisms for one defect, and they
# fail in different ways when it is fixed. Without this one, deleting step 5
# has nothing observing it: on every corpus in the tree step 5 answers ZERO
# times, because 2c takes every unique leaf first. Step 5 is starved, not dead,
# and that distinction is invisible until a leaf is plural.
#
# THE PICK IS ARBITRARY, AND THAT IS THE POINT. The leaf index answers by
# REGISTRATION ORDER, not by scope and not by name: `register_leaf_name` is
# first-registration-wins and compares no names at all, and registration order
# is depth-first module discovery seeded by the order the FILESYSTEM enumerates
# the directory. `Alpha` wins here for no reason a reader of `Orphan` could
# discover, and on a host that does not enumerate alphabetically `Omega` wins
# instead. What a bare name means therefore depends on something no reader of
# the source can see, and copying a directory can change what this program
# compiles to.
#
# An earlier revision of this header said the pick was NAME ORDER and cited a
# rename as the measurement. That was wrong, and the sibling test file records
# the retraction: renaming the declaring file, module-name sort order and the
# import graph all leave the winner UNMOVED, while enumerating the same sources
# in a different directory order moves it. `Alpha` sorting first was a
# coincidence of the host it was written on. The retraction never reached this
# file, so the config of the fixture disagreed with the fixture.
#
# THE FLIP PROTOCOL. When a fix lands, the `WRONG_` tests STOP COMPILING -- the
# annotation in each names the type that is bound today, so a changed bind is
# E0200 and a fixed resolver is "unknown type" at `Orphan`'s own signatures.
# That is the design. Move the case to a `compile_fail` project with the right
# `expect.diagnostic` in the SAME change that makes it an error -- do not
# adjust the assertion to get back to green. The same protocol was exercised
# once already, on resolution_tripwire's visibility half.
#
# THE CONTROLS ARE LOAD-BEARING. `CONTROL_an_importing_module_binds_the_module_
# it_imported` is what distinguishes "the resolver has no scope" from "the
# resolver has scope and this module had none": the SAME plural leaf, from a
# module that imports one declarer, binds that one -- and where that declarer is
# the one the global leaf index does NOT pick, it cannot be passing by
# coincidence. Which declarer that is depends on the host: the index picks by
# registration order, which follows directory enumeration order, so on a host
# where it picks `Omega` this control still runs but no longer discriminates.
# Measured in docs/name-resolution.md §8.2y.

[project]
project_name = "resolution_leaf_index"
output_dir   = "build"
target_type  = "executable"
source_dir   = "src"
entry_point  = "src/main.cryo"

