/// One of the TWO declarations of the leaf `Widget`.
///
/// `tag` is what makes which-one-bound observable at runtime rather than only
/// in a type annotation: the two `Widget`s are otherwise identical, so a test
/// that merely round-tripped a value could not tell them apart.
![config(testing)]
namespace ResolutionLeafIndex::Alpha;

type struct Widget<T> {
    v: T;

    unwrap(&this) -> T { return this.v; }

    /// Identifies the declaring module.  See `Omega::Widget::tag`.
    tag(&this) -> i32 { return 1; }
}
