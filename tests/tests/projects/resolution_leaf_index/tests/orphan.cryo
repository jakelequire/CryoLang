/// A module that names a leaf TWO other modules declare, with nothing in
/// scope to name either.
///
/// There is no `import` here at all. `Widget` is declared by
/// `ResolutionLeafIndex::Alpha` and by `ResolutionLeafIndex::Omega`, neither of
/// which this module imports, so under spec §5.1 -- "the first segment resolves
/// in scope" -- the bare `Widget` in these signatures must not resolve.
///
/// It resolves anyway, to whichever declarer sorts first. See the tripwire in
/// `leaf_index_test.cryo`.
///
/// Both arms are here because sema binds them through different functions: the
/// static template through `find_static_method_template`, the free function
/// through `check_generic_free_call`.
![config(testing)]
namespace ResolutionLeafIndex::Orphan;

type struct Packer {
    /// Static generic method returning a type this module cannot see.
    static pack<T>(v: T) -> Widget<T> {
        return Widget<T> { v: v };
    }
}

/// Free function returning a type this module cannot see.
function box_up<T>(v: T) -> Widget<T> {
    return Widget<T> { v: v };
}
