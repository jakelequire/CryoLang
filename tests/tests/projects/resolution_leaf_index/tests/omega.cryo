/// The SECOND declaration of the leaf `Widget`, identical to `Alpha`'s except
/// for `tag`.
///
/// Its only job is to make the leaf plural, which is what stops cascade 2c
/// answering from `DeclarationIndex::resolve_qualified_scoped`'s
/// single-candidate fast path and hands the question to the global leaf index.
/// It loses the leaf index's name-order pick to `Alpha`, which is what makes
/// `Importer` -- the module that imports THIS one and binds it -- a control
/// that cannot pass by coincidence.
![config(testing)]
namespace ResolutionLeafIndex::Omega;

type struct Widget<T> {
    v: T;

    unwrap(&this) -> T { return this.v; }

    /// Identifies the declaring module.  See `Alpha::Widget::tag`.
    tag(&this) -> i32 { return 2; }
}
