/// A C floating constant the importer cannot read is reported and left
/// unbound, so naming it is refused rather than reading a made-up value.
namespace CImportUnreadableFloatNotBound::Main;

extern module ciu := "C" {
    #include "../include/unreadable.h"
}

function main() -> int {
    const value: f64 = ciu::CIU_NO_EXPONENT;
    return value as int;
}
