namespace string_octal_escape_is_esc;

import std::fmt;

function main() -> i32 {
    // `\033` is ESC, then `[1m` as written.
    const bold: string = "\033[1m";
    const b: u8* = bold as u8*;
    if (b[0] != 27 as u8) { return 1; }
    if (b[1] != '[' as u8) { return 2; }
    if (bold.length() != 4) { return 3; }

    // `\0` alone is still NUL: the string ends there for C.
    const nul: string = "a\0b";
    const n: u8* = nul as u8*;
    if (nul.length() != 1) { return 4; }
    if (n[1] != 0 as u8) { return 5; }

    // At most three digits: `\0123` is `\012` (newline) and then `3`; an
    // escape also ends at the first non-octal digit: `\18` is byte 1, `8`.
    const three: string = "\0123";
    const t: u8* = three as u8*;
    if (t[0] != 10 as u8 || t[1] != '3' as u8 || three.length() != 2) { return 7; }
    const stop: string = "\18";
    const s: u8* = stop as u8*;
    if (s[0] != 1 as u8 || s[1] != '8' as u8 || stop.length() != 2) { return 8; }

    // Character literals read the same escapes.
    if ('\033' as u32 != 27) { return 9; }
    if ('\0' as u32 != 0) { return 10; }
    if ('\177' as u32 != 127) { return 11; }

    fmt::printf("\033[1mbold\033[0m\n");
    return 0;
}
