# string_octal_escape_is_esc - `\` and one to three octal digits in a string
# or character literal is the byte they spell, read as C reads it: `\033` is
# ESC, so `"\033[1m"` is ESC and then `[1m`; `\0` alone is still NUL; an
# escape ends after three digits or at the first non-octal one
# (outcome = "run").

[project]
project_name = "string_octal_escape_is_esc"
output_dir   = "build"
target_type  = "executable"
source_dir   = "src"
entry_point  = "src/main.cryo"

