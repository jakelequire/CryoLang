namespace TraitObjectTraitArguments::Main;

import TraitObjectTraitArguments::Traits::{ Measure, Sized, Pick, Convert, Counter };
import std::collections::str::{ Chars };
import std::collections::string::{ String };

// An object of a trait with arguments binds the trait's parameters, then its
// associated types, positionally; a call through it sees the method's
// signature with them put in, and a supertrait's arguments are the ones the
// subtrait writes, with the object's put in.  The exit code names the first
// call that answered wrong.

type struct Square {
    side: i64;
}

implement trait Measure<i64> for Square {
    measure(&this) -> i64 { return this.side * this.side; }
    scale(&this, by: i64) -> i64 { return this.side * by; }
}

implement trait Measure<i32> for Square {
    measure(&this) -> i32 { return 7; }
    scale(&this, by: i32) -> i32 { return by + 1; }
}

implement trait Sized<i64> for Square {
    label(&this) -> i32 { return 3; }
}

implement trait Pick for Square {
    type Out = i64;
    type Extra = boolean;
    pick(&this, a: i64, b: i64) -> i64 { if (a > b) { return a; } return b; }
    extra(&this) -> Option<boolean> { return Option::Some(true); }
}

implement trait Convert<f64> for Square {
    type Error = i32;
    convert(&this) -> f64 { return 2.5; }
    failure(&this) -> i32 { return 41; }
}

type struct Countdown {
    left: i32;
}

implement trait Counter<i32> for Countdown {
    next(mut &this) -> Option<i32> {
        if (this.left == 0) { return Option::None; }
        this.left = this.left - 1;
        return Option::Some(this.left);
    }
}

function scaled<T>(m: virtual &Measure<T>, by: T) -> T {
    return m.scale(by);
}

function drain(c: virtual mut &Counter<i32>) -> i32 {
    mut sum: i32 = 0;
    while (true) {
        match (c.next()) {
            Option::Some(v) => { sum = sum + v; }
            Option::None => { break; }
        }
    }
    return sum;
}

function count_chars(it: virtual mut &Iterator<u32>) -> i32 {
    mut n: i32 = 0;
    while (true) {
        match (it.next()) {
            Option::Some(_) => { n = n + 1; }
            Option::None => { break; }
        }
    }
    return n;
}

function main() -> i32 {
    const s: Square = Square { side: 4 };
    const sized: virtual &Sized<i64> = &s;
    if (sized.measure() != 16) { return 1; }
    if (sized.scale(3) != 12) { return 2; }
    if (sized.label() != 3) { return 3; }
    const small: virtual &Measure<i32> = &s;
    if (small.measure() != 7) { return 5; }
    if (small.scale(4) != 5) { return 6; }
    const p: virtual &Pick<i64, boolean> = &s;
    if (p.pick(5, 9) != 9) { return 8; }
    match (p.extra()) {
        Option::Some(b) => { if (!b) { return 9; } }
        Option::None => { return 10; }
    }
    const c: virtual &Convert<f64, i32> = &s;
    if (c.convert() != 2.5) { return 11; }
    if (c.failure() != 41) { return 12; }
    if (c.again() != 2.5) { return 4; }
    const pair: (i32, i32) = c.failed_twice();
    if (pair.0 + pair.1 != 82) { return 7; }
    const big: virtual &Measure<i64> = &s;
    if (scaled(big, 2) != 8) { return 13; }
    if (scaled(small, 6) != 7) { return 14; }
    mut down: Countdown = Countdown { left: 4 };
    if (drain(&down) != 6) { return 15; }
    const word: String = "hello";
    mut chars: Chars = word.chars();
    if (count_chars(&chars) != 5) { return 16; }
    return 0;
}
