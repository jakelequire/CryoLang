namespace TraitObjectTraitArguments::Traits;

type trait Measure<T> {
    measure(&this) -> T;
    scale(&this, by: T) -> T;
}

type trait Sized<U> : Measure<U> {
    label(&this) -> i32;
}

type trait Pick {
    type Out;
    type Extra;
    pick(&this, a: This::Out, b: This::Out) -> This::Out;
    extra(&this) -> Option<This::Extra>;
}

type trait Convert<T> {
    type Error;
    convert(&this) -> T;
    failure(&this) -> This::Error;
    again(&this) -> T { return this.convert(); }
    failed_twice(&this) -> (This::Error, This::Error) { return (this.failure(), this.failure()); }
}

type trait Counter {
    type Item;
    next(mut &this) -> Option<This::Item>;
}
