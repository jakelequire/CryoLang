// `cryo interpret --overflow-checks=on` checks a negation, a product and a
// difference as a checked build does: `-i32::MIN` is the first to panic,
// after the products and differences inside the range were computed.

namespace Main;

import std::fmt;

function keep(value: i32) -> i32 {
    return value;
}

function main() -> i32 {
    const least: i32 = keep(i32::MIN);
    const half: i32 = keep(-1073741824);
    fmt::println(f"product {half * 2}");
    fmt::println(f"difference {(least + 1) - 1}");
    const negated: i32 = -least;
    fmt::println(f"negation {negated}");
    return 0;
}
