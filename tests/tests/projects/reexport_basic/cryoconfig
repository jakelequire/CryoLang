# reexport_basic - `export` grants an importer of the exporting module exactly
# what the same path would grant if it were imported there.
#
# `Aggregate` re-exports `Aggregate::Inner`; `main` imports only `Aggregate`
# and names `Widget` bare. Without the re-export that is E0240, which is what
# tests/tests/projects/namespace_gate pins.
#
# `Widget` is the load-bearing assertion: a TYPE annotation is what the gate
# judges. The free-function calls resolve whether or not the export exists --
# function visibility is a separate, still-open door -- so they are exercise,
# not evidence.
#
# src/globctl.cryo carries the other half of the wildcard decision: `M::*` is
# still a legal LOCAL import. It lives here because the project that pins the
# export-side rejection aborts at parse and could never compile a control.
#
# src/specific.cryo pins the brace-list form of the grant, with a STATIC call
# rather than an annotation: an annotation resolves through module-level
# reachability whichever import form was written, so it cannot distinguish
# them, and the brace list read no re-export edge at all while every test here
# used the bare form. Its 6 is why the expected status is 18 and not 12.

[project]
project_name = "reexport_basic"
output_dir   = "build"
target_type  = "executable"
source_dir   = "src"
entry_point  = "src/main.cryo"

