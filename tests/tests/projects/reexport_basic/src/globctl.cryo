/// CONTROL for the wildcard decision: `M::*` stays legal as a LOCAL import,
/// where its blast radius is this one file. Only the EXPORT form is rejected
/// (tests/tests/projects/reexport_glob_rejected), and that project aborts at
/// parse, so this half has to be asserted somewhere that actually compiles.
namespace ReexportBasic::GlobCtl;

import ReexportBasic::Inner::*;

function via_glob() -> i32 {
    const w: Widget = make_widget(5);
    return w.unwrap();
}
