/// Re-exports its child so an importer of `ReexportBasic::Aggregate` alone
/// reaches `Widget` without naming `Inner`.
///
/// The `export` is also what puts `Widget` in scope HERE -- there is no
/// accompanying `import`, and `relay` below would not compile without it.
namespace ReexportBasic::Aggregate;

export ReexportBasic::Inner;
import ReexportBasic::Inner::{ Widget, make_widget };

function relay(n: i32) -> Widget {
    return make_widget(n);
}
