/// Imports ONLY the aggregate, and names in braces what it takes. Neither
/// `Widget` nor `make_widget` is declared by the aggregate - both arrive
/// through its `export`, which is the property: an `export` grants an importer
/// what the same path would grant if it were imported there, so the aggregate
/// OFFERS them, and `import M::{ N }` must find `N` in that offered set rather
/// than in the module's own declarations.
///
/// Naming them is now the only way to reach them. A plain `import M;` binds no
/// names, and a QUALIFIER cannot reach a re-exported name either: a qualified
/// path is checked against the module that DECLARED the name, so
/// `Aggregate::Widget` is refused - `Widget` is declared in `Inner`.
namespace ReexportBasic::Main;

import ReexportBasic::Aggregate;
import ReexportBasic::Aggregate::{ Widget, make_widget, relay };
import ReexportBasic::GlobCtl;
import ReexportBasic::GlobCtl::{ via_glob };
import ReexportBasic::Specific;
import ReexportBasic::Specific::{ via_specific };

function main() -> int {
    const w: Widget = relay(3);
    const direct: Widget = make_widget(4);
    return (w.unwrap() + direct.unwrap() + via_glob() + via_specific()) as int;
}
