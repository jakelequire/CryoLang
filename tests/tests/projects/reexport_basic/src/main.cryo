/// Imports ONLY the aggregate. Every name below arrives through its `export`.
namespace ReexportBasic::Main;

import ReexportBasic::Aggregate;
import ReexportBasic::GlobCtl;
import ReexportBasic::Specific;

function main() -> int {
    const w: Widget = relay(3);
    const direct: Widget = make_widget(4);
    return (w.unwrap() + direct.unwrap() + via_glob() + via_specific()) as int;
}
