# dependency_interrupted_extraction_recovered - an extraction cut short
# leaves its files in a `.partial` sibling of the commit's directory, never
# in the directory itself.  A step leaves such a sibling behind, holding a
# file the commit does not have, before the first `cryo fetch`; the fetch
# removes it and extracts the commit whole, so the lock's content hash is
# the one of the commit's own files and the program runs.
[project]
project_name = "dependency_interrupted_extraction_recovered"
output_dir   = "build"
target_type  = "executable"
source_dir   = "src"
entry_point  = "src/main.cryo"

[compiler]

[dependencies]
greeter = { git = "{fixture:greeter}", tag = "v1" }
