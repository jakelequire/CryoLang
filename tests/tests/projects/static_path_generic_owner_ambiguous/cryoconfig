# static_path_generic_owner_ambiguous - `GnTf::<i32>::go(&c, 7)` on a generic
# owner with an inherent `go` and a trait's: neither outranks the other, so
# the path is ambiguous (E0156), as it is on a plain type.  A generic
# owner's path is resolved once its instantiation exists, so this project
# holds only those shapes; `static_path_inherent_trait_ambiguous` holds the
# rest.
[project]
project_name = "static_path_generic_owner_ambiguous"
output_dir   = "build"
target_type  = "executable"
source_dir   = "src"
entry_point  = "src/main.cryo"
[compiler]
[dependencies]
