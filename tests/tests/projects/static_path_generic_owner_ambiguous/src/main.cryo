namespace StaticPathGenericOwnerAmbiguous::Main;

type trait Beta { go(&this, u: i32) -> i64; }
type trait BetaG { go<U>(&this, u: U) -> i64; }

// Generic type, plain method.
type struct GnTf<T> { v: T; }
implement<T> trait Beta for GnTf<T> { go(&this, u: i32) -> i64 { return 2; } }
implement<T> struct GnTf<T> { go(&this, u: i32) -> i64 { return 1; } }

// Generic type, generic method.
type struct GgTf<T> { v: T; }
implement<T> trait BetaG for GgTf<T> { go<U>(&this, u: U) -> i64 { return 2; } }
implement<T> struct GgTf<T> { go<U>(&this, u: U) -> i64 { return 1; } }

type struct GIgTn<T> { v: T; }
implement<T> trait Beta for GIgTn<T> { go(&this, u: i32) -> i64 { return 2; } }
implement<T> struct GIgTn<T> { go<U>(&this, u: U) -> i64 { return 1; } }

function main() -> i32 {
    const c: GnTf<i32> = GnTf::<i32> { v: 5 };
    const e: GgTf<i32> = GgTf::<i32> { v: 5 };
    const gig: GIgTn<i32> = GIgTn::<i32> { v: 5 };
    const n3: i64 = GnTf::<i32>::go(&c, 7);
    const n4: i64 = GgTf::<i32>::go::<i32>(&e, 7);
    const n8: i64 = GIgTn::<i32>::go(&gig, 7);
    return (n3 + n4 + n8) as i32;
}
