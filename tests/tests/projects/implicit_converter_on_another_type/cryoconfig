# implicit_converter_on_another_type - an `![implicit]` static method
# declared on one type and returning another (`Meters::to_feet`) converts a
# `Meters` where a `Feet` is expected: the call is made on the type that
# declares the converter, not on the type it returns.
[project]
project_name = "implicit_converter_on_another_type"
output_dir   = "build"
target_type  = "executable"
source_dir   = "src"
entry_point  = "src/main.cryo"
