namespace Cv2::Main;


type struct Meters { v: i32; }
type struct Feet { v: i32; }

// A static converter declared on a type other than the one it returns:
// `Meters::to_feet` turns a `Meters` into a `Feet`.
implement struct Meters {
    ![implicit]
    static to_feet(m: Meters) -> Feet {
        return Feet { v: m.v * 100 };
    }
}

function show(f: Feet) -> i32 { return f.v; }

function main() -> i32 {
    const d: i32 = show(Meters { v: 2 });
    if (d == 200) { return 0; }
    return 1;
}
