namespace TypeConstantStructBody;

function twice(n: i32) -> i32 { return n * 2; }

type struct Point {
    x: i32;
    y: i32;

    /// A struct-valued constant, folded, written out of field order.
    const ORIGIN: Point = Point { y: 0, x: 0 };
    const UNIT: Point = Point { y: 1, x: 1 };
    const DIMENSIONS: i32 = 2;
    const SLOTS: i32 = This::DIMENSIONS * 2;
    const LARGEST: u64 = 18446744073709551615;
    const SCALE: f64 = 1_000.5;
    /// Computed before `main`, since its initializer calls a function.
    const COMPUTED: i32 = twice(21);
    private const SECRET: i32 = 7;

    static new(x: i32, y: i32) -> Point { return Point { x: x, y: y }; }
    secret_plus(&this) -> i32 { return Point::SECRET + This::SECRET + this.x; }
}

type union Bits {
    whole: u32;
    half: u16;
    const ALL_SET: Bits = Bits { whole: 4294967295 };
}

/// A module global named like a type's constant is a different global.
const ORIGIN: i32 = 99;

/// A field named by the keyword `const` is still a field.
type struct Plain {
    const: i32;
}

function main() -> i32 {
    const o: Point = Point::ORIGIN;
    if (o.x != 0 || o.y != 0) { return 1; }
    if (Point::UNIT.x != 1 || Point::UNIT.y != 1) { return 2; }
    mut slots: [i32; Point::SLOTS] = [0, 0, 0, 0];
    slots[3] = Point::DIMENSIONS;
    if (slots[3] != 2) { return 3; }
    if (Point::LARGEST != 18446744073709551615) { return 4; }
    if (Point::SCALE != 1000.5) { return 5; }
    if (Point::COMPUTED != 42) { return 6; }
    if (Point::new(1, 2).secret_plus() != 15) { return 7; }
    if (Bits::ALL_SET.whole != 4294967295) { return 8; }
    if (ORIGIN != 99) { return 9; }
    const at: Point* = &Point::ORIGIN;
    if (at.y != 0) { return 10; }
    const p: Plain = Plain { const: 11 };
    if (p.const != 11) { return 11; }
    return 0;
}
