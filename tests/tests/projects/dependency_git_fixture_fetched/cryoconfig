# dependency_git_fixture_fetched - a git dependency fetched and built with
# no network.  The runner builds the repository `greeter` from the two
# committed trees under fixtures/greeter, tags each commit, and writes its
# file:// URL for `{fixture:greeter}`; the step `cryo fetch` pins the tag in
# a cryoconfig.lock beside this file in the project's copy, and the build
# compiles the commit that tag names.
[project]
project_name = "dependency_git_fixture_fetched"
output_dir   = "build"
target_type  = "executable"
source_dir   = "src"
entry_point  = "src/main.cryo"

[compiler]

[dependencies]
greeter = { git = "{fixture:greeter}", tag = "v1.1.0" }
