/// A function taking a function-typed parameter is copied for each
/// capturing closure passed to it, and the copy is checked from scratch:
/// a slice element read and an operator on a struct implementing `Add` in
/// its body are each resolved again there, so a literal beside the element
/// takes its type and a method called on it is found.
namespace DesugarInClosureCopy::Main;

import std::fmt;

type struct V2 { x: i32; }

implement trait Add<V2, V2> for struct V2 {
    add(&this, rhs: &V2) -> V2 { return V2 { x: this.x + rhs.x }; }
}

function element_beside_literal(f: (u32) -> u8, p: &Slice<u32>, v: u64) -> u8 {
    const o: u64 = (f(((v as u32) & 1073741823) + (p[(v % (p.length() as u64))] & 1073741823)) as u64);
    return o as u8;
}

function method_on_element(f: (i16) -> i16, p: &Slice<i16>) -> i16 {
    return p[(1 % (p.length() as u64))].wrapping_add(f(2));
}

function operator_on_struct(f: (i32) -> i32, a: V2, b: V2) -> i32 {
    return f((a + b).x);
}

function main() -> i32 {
    const unsigned: [u32; 3] = [5, 6, 7];
    const signed: [i16; 2] = [30, 40];
    const bias: u32 = 3;
    const step: i16 = 5;
    const scale: i32 = 10;
    const a: u8 = element_beside_literal((x: u32) -> u8 { return ((x + bias) & 255) as u8; }, &unsigned, 4);
    const b: i16 = method_on_element((x: i16) -> i16 { return x * step; }, &signed);
    const c: i32 = operator_on_struct((x: i32) -> i32 { return x * scale; }, V2 { x: 2 }, V2 { x: 5 });
    fmt::println(f"desugars in a closure's copy: {a} {b} {c}");
    return 0;
}
