/// An array of arrays releases every row, and every row its elements, when
/// it goes out of scope: the outer array is `Array<T>` over a `T` that is
/// itself an `Array`, and that `T` has the `Drop` the outer one's release
/// is bounded on.
namespace NestedDynamicArrayReleasesRows::Main;

import std::fmt;
import std::core::drop::{ Drop };

type struct Probe { id: i32; }

mut g_released: i32 = 0;

implement trait Drop for struct Probe {
    drop(mut &this) -> void { g_released = g_released + 1; }
}

function main() -> i32 {
    {
        mut rows: [[Probe]] = [];
        mut first: [Probe] = [];
        first.push(Probe { id: 1 });
        first.push(Probe { id: 2 });
        rows.push(first);
        mut second: [Probe] = [];
        second.push(Probe { id: 3 });
        rows.push(second);
    }
    fmt::println(f"released {g_released} of 3");
    return 0;
}
