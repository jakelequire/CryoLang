// A function named as a value inside a generic body is the declaration it
// names in every copy of that body: by its bare name, by its module path, a
// static method by its type's path, bound to a local, passed to a parameter
// of function type, and passed to a trait default with a function-typed
// parameter (`filter`) on a receiver known only by its bound.
namespace FunctionValueInGenericBody::Main;

import std::core::option::{ Option };
import std::core::iter::{ Iterator };

type struct Up {
    cur: i32;
    end: i32;
}

implement trait Iterator<i32> for struct Up {
    next(mut &this) -> Option<i32> {
        if (this.cur >= this.end) { return Option::None; }
        const v: i32 = this.cur;
        this.cur = this.cur + 1;
        return Option::Some(v);
    }
}

type struct Scale {
    by: i32;
    static triple(x: i32) -> i32 { return x * 3; }

    // A generic method's body is copied per instance, as a generic
    // function's is.
    apply_to<T>(&this, ignored: T, v: i32) -> i32 {
        return apply(dbl, v) * this.by;
    }
}

function dbl(x: i32) -> i32 { return x * 2; }
function is_even(x: &i32) -> boolean { return (*x % 2) == 0; }

function apply(f: (i32) -> i32, v: i32) -> i32 { return f(v); }

function by_name<T>(ignored: T) -> i32 {
    return apply(dbl, 3);
}

function by_path<T>(ignored: T) -> i32 {
    return apply(FunctionValueInGenericBody::Main::dbl, 3) + apply(Scale::triple, 1);
}

function bound_to_local<T>(ignored: T) -> i32 {
    const f: (i32) -> i32 = dbl;
    return f(5);
}

function evens<I>(it: I) -> i32 where I: Iterator<i32> {
    return it.filter(is_even).count() as i32;
}

function main() -> i32 {
    if (by_name(1) != 6) { return 1; }
    if (by_name(true) != 6) { return 2; }
    if (by_path(1) != 9) { return 3; }
    if (bound_to_local(1) != 10) { return 4; }
    const s: Scale = Scale { by: 10 };
    if (s.apply_to(1, 2) != 40) { return 5; }
    const c: Up = Up { cur: 0, end: 5 };
    if (evens(c) != 3) { return 6; }
    return 0;
}
