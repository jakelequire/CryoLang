/// Arguments to a method of an instantiation written out in full are checked
/// against the template's method seen through it: text handed to an
/// `Array<i64>` is refused at the argument, as it is for a dynamic `i64[]`.
namespace InstantiationMethodArgumentMismatch::Main;
import std::collections::array::{ Array };

function main() -> i32 {
    mut nums: Array<i64> = Array::<i64>::new();
    nums.push(1);
    nums.push("not a number");
    nums.insert(0, "nor this");
    return nums.length as i32;
}
