/// An out-of-range index on a `[T]` reports the line of the `xs[i]` that
/// wrote it, not the library's bounds check behind it - here inside a
/// function the array is passed to by reference.
namespace IndexOutOfRangeSite::Main;

import std::fmt;

function nth(xs: &[i64], i: i64) -> i64 {
    return xs[i];
}

function main() -> i32 {
    const xs: [i64] = [10, 20];
    fmt::println(f"first {nth(&xs, 0)}");
    fmt::println(f"past the end {nth(&xs, 2)}");
    return 0;
}
