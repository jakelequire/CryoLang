# trait_default_copy_typed_by_its_implementation - a trait implemented for
# one type at two arguments: each implementation's copy of the trait's
# default calls that implementation's methods, so the copy for `Measure<i32>`
# is typed against `i32`.  The exit code is the sum of the two copies'
# answers, 27 + 8.
[project]
project_name = "trait_default_copy_typed_by_its_implementation"
output_dir   = "build"
target_type  = "executable"
source_dir   = "src"
entry_point  = "src/main.cryo"
