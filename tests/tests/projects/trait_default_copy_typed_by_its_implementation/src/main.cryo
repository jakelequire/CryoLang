namespace TraitDefaultCopyTypedByItsImplementation;

type trait Measure<T> {
    measure(&this) -> T;
    scale(&this, by: T) -> T;
    scaled_measure(&this) -> T { return this.scale(this.measure()); }
}

type struct Square { side: i64; }

implement trait Measure<i64> for Square {
    measure(&this) -> i64 { return this.side * this.side; }
    scale(&this, by: i64) -> i64 { return this.side * by; }
}

implement trait Measure<i32> for Square {
    measure(&this) -> i32 { return 7; }
    scale(&this, by: i32) -> i32 { return by + 1; }
}

function scaled_at_i32<S>(s: &S) -> i32 where S: Measure<i32> { return s.scaled_measure(); }
function scaled_at_i64<S>(s: &S) -> i64 where S: Measure<i64> { return s.scaled_measure(); }

function main() -> i32 {
    const s: Square = Square { side: 3 };
    return scaled_at_i64(&s) as i32 + scaled_at_i32(&s);
}
