// `B` redeclares `A`'s `x` under a wider type.  Inside `B`, `this.x` is
// B's own field: the write must land in B's slot and leave A's `x` and `y`
// as A's constructor wrote them.
type class A {
public:
    x: i32;
    y: i32;
    A() { this.x = 7; this.y = 9; }
    ax(&this) -> i32 { return this.x; }
    ay(&this) -> i32 { return this.y; }
}

type class B : A {
public:
    x: i64;
    B() : A() { this.x = 4294967297; }   // 0x1_0000_0001: an i64 whose low word is 1
    bx(&this) -> i64 { return this.x; }
}

function main() -> i32 {
    const b: B* = new B();
    // A's slots are A's: 7 and 9.  B's own `x` holds the i64.
    if (b.ax() != 7) { return 1; }
    if (b.bx() != 4294967297) { return 2; }
    if (b.x != 4294967297) { return 3; }
    return b.ay();   // 9
}
