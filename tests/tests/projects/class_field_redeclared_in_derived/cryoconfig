# class_field_redeclared_in_derived - a derived class redeclaring a base
# field's NAME under a wider type.  Sema resolves `this.x` inside `B` to B's
# own field (derived-first) and records its coordinates on the node; codegen
# addresses the slot from those coordinates.  Before the node carried them,
# codegen searched the flattened body by the name root-first, so B's i64
# store landed on A's i32 `x` and ran into A's `y` beside it: `b.ay()`
# answered 1 (the store's high word) instead of 9, and the process exited 1.
[project]
project_name = "class_field_redeclared_in_derived"
output_dir   = "build"
target_type  = "executable"
source_dir   = "src"
entry_point  = "src/main.cryo"
[compiler]
[dependencies]
