/// A `?` in a loop's condition binds a fresh residual each time the
/// condition is tested, and the arm that moves the residual leaves the
/// function, so the move is not carried to the next iteration.  `while`,
/// `for` and `do-while` conditions are each run to the end of the loop and
/// to the early return the `?` makes.
namespace TryInLoopCondition::Main;

import std::fmt;
import std::collections::string::{ String };

function below(n: i32, limit: i32) -> Result<boolean, String> {
    if (n > 7) { return Result::Err(String::from("past seven")); }
    return Result::Ok(n < limit);
}

function count_while(limit: i32) -> Result<i32, String> {
    mut n: i32 = 0;
    while (below(n, limit)?) {
        n = n + 1;
    }
    return Result::Ok(n);
}

function count_for(limit: i32) -> Result<i32, String> {
    mut total: i32 = 0;
    for (mut i: i32 = 0; below(i, limit)?; i++) {
        total = total + i;
    }
    return Result::Ok(total);
}

function count_do_while(limit: i32) -> Result<i32, String> {
    mut n: i32 = 0;
    do {
        n = n + 2;
    } while (below(n, limit)?);
    return Result::Ok(n);
}

function shown(result: Result<i32, String>) -> String {
    match (result) {
        Result::Ok(n) => { return f"{n}"; }
        Result::Err(message) => { return message; }
    }
}

function main() -> i32 {
    const loops: String = f"while {shown(count_while(3))} {shown(count_while(20))}";
    const counted: String = f"for {shown(count_for(4))} {shown(count_for(20))}";
    const tested_after: String = f"do-while {shown(count_do_while(5))} {shown(count_do_while(20))}";
    fmt::println(f"{loops}, {counted}, {tested_after}");
    return 0;
}
