namespace GlobalCallInitializerValue::Main;

import GcivJson;

type struct Span { lo: i32; hi: i32; }

function span_of(n: i32) -> Span { return Span { lo: n, hi: n * 10 }; }

function thrice(x: i32) -> i32 { return x * 3; }

const n: i32 = GcivJson::twice(3);
const t: i32 = thrice(4);
const s: Span = span_of(2);

function main() -> i32 {
    if (n != 6) { return 1; }
    if (t != 12) { return 2; }
    if (s.lo != 2 || s.hi != 20) { return 3; }
    return 0;
}
