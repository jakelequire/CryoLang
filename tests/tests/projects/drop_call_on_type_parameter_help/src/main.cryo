namespace DropCallOnTypeParameterHelp::Main;

type trait Sized2 {
    size(&this) -> i64;
}

function release_unbounded<T>(p: T*) -> void {
    (*p).drop();
}

function release_bounded<T>(p: T*) -> void where T: Sized2 {
    (*p).drop();
}

function measure<T>(p: T*) -> i64 {
    return (*p).size();
}

function main() -> i32 {
    return 0;
}
