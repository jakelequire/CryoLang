namespace VariantWrittenArgumentsTypePayload;

import std::core::result::{ Result };

// The instance a variant's path writes types its payload: `200` below is a
// `u8`, the payload of `Option<u8>` and `Result<u8, i32>`.  A payload-free
// variant takes its instance from the expected type or the parameter.

function is_none(o: Option<i32>) -> boolean {
    match (o) {
        Option::Some(_) => { return false; }
        Option::None    => { return true; }
    }
}

function byte_of(r: Result<u8, i32>) -> i32 {
    match (r) {
        Result::Ok(b)  => { return b as i32; }
        Result::Err(e) => { return e; }
    }
}

function main() -> i32 {
    const a = Option::<u8>::Some(200);
    if (a.unwrap() != 200) { return 1; }
    if (byte_of(Result::Ok::<u8, i32>(200)) != 200) { return 2; }
    if (byte_of(Result::<u8, i32>::Ok(201)) != 201) { return 3; }
    const m: Option<i32> = Option::None;
    if (!is_none(m)) { return 4; }
    if (!is_none(Option::None)) { return 5; }
    if (is_none(Option::<i32>::Some(1))) { return 6; }
    return 0;
}
