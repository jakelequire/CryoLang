/// A callee that is neither a name, a path nor a field - here a call's
/// result - is a function value the program computes: the call has the
/// function's return type and goes through the value.  `big` returns a
/// struct, so its call passes the result through a hidden slot, which the
/// value's type alone has to tell.
namespace CallThroughComputedFunctionValue::Main;

import std::ffi::libc;

type struct Big {
    a: i64;
    b: i64;
    c: i64;
    d: i64;
}

function dbl(x: f64) -> f64 { return x * 2.0; }
function inc(x: i64) -> i64 { return x + 1; }
function neg(x: i64) -> i64 { return 0 - x; }
function big(x: i64) -> Big { return Big { a: x, b: x + 1, c: x + 2, d: x + 3 }; }

function pick() -> (f64) -> f64 { return dbl; }
function choose(up: boolean) -> (i64) -> i64 {
    if (up) { return inc; }
    return neg;
}
function maker() -> (i64) -> Big { return big; }

function main() -> i32 {
    const d: f64 = pick()(2.0);
    const u: i64 = choose(true)(41);
    const n: i64 = choose(false)(5);
    const t: i64 = choose(choose(false)(1) > 0)(7);
    const b: Big = maker()(10);
    libc::printf("dbl %.1f inc %lld neg %lld nested %lld big %lld %lld\n", d, u, n, t, b.a, b.d);
    if (d != 4.0 || u != 42 || n != -5 || t != -7 || b.a != 10 || b.d != 13) { return 1; }
    return 0;
}
