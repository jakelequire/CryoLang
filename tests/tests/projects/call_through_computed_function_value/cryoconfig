# call_through_computed_function_value - calling a function value an
# expression computes: a call's result (`pick()(2.0)`).
#
# The type check gave such a call the callee's own type, and code generation
# asked the callee for the type of a global function it is not, and crashed.
# `maker()(10)` returns a struct, so the call also has to pass the hidden
# result slot the callee's type requires.

[project]
project_name = "call_through_computed_function_value"
output_dir   = "build"
target_type  = "executable"
source_dir   = "src"
entry_point  = "src/main.cryo"

