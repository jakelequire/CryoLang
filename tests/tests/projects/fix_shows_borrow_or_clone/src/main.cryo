/// Moves out of storage that still owns the value: each refusal shows its
/// fix as code - the borrow, the clone, or an example of the fixed shape.
namespace FixShowsBorrowOrClone;

import std::collections::string::{ String };

type struct Holder {
    name: String;
    items: [String];
}

type struct Plain {
    name: String;
}

function take(s: String) -> void { }
function take_plain(p: Plain) -> void { }

function by_ref(h: &Holder) -> void {
    const n: String = h.name;
    const xs: [String] = h.items;
}

function element(xs: [String]) -> void {
    const x: String = xs[0];
}

function loop_move() -> void {
    const s: String = String::from("a");
    for (mut i: i32 = 0; i < 2; i++) {
        take(s);
    }
}

function no_clone() -> void {
    const p: Plain = Plain { name: String::from("x") };
    take_plain(p);
    take_plain(p);
}

function main() -> int { return 0; }
