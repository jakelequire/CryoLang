namespace GenericMethodOnOwnerMintedInCopy;

type struct Wrap<T> { v: T; }
implement<T> struct Wrap<T> {
    static conv<U>(x: U) -> U { return x; }
    keep<U>(&this, x: U) -> T { return this.v; }
    // The instance's body needs an owner nothing else makes.
    nest<U>(&this, x: U) -> U {
        const p: Wrap<U> = Wrap::<U> { v: x };
        return p.keep::<i8>(1);
    }
}

// Each function's copy is the first to need its `Wrap<A>`, so the owner is
// made only after the copy's calls were walked.
function member<A>(a: A) -> A {
    const w: Wrap<A> = Wrap::<A> { v: a };
    return w.keep::<i16>(1);
}

function path<A>(a: A) -> A {
    const w: Wrap<A> = Wrap::<A> { v: a };
    return Wrap::<A>::keep::<i16>(&w, 1);
}

function static_path<A>(a: A) -> A {
    return Wrap::<A>::conv::<A>(a);
}

function nested<A>(a: A) -> u32 {
    const w: Wrap<A> = Wrap::<A> { v: a };
    return Wrap::<A>::nest::<u32>(&w, 5);
}

function main() -> i32 {
    if (member::<u64>(13) != 13) { return 1; }
    if (path::<i16>(14) != 14) { return 2; }
    if (static_path::<u16>(15) != 15) { return 3; }
    if (nested::<i64>(16) != 5) { return 4; }
    return 0;
}
