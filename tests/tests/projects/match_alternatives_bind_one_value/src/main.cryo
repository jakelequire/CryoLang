/// An arm whose alternatives bind the same name (`A(v) | B(v)`) binds ONE
/// value under it - whichever alternative matched - in an ordinary function
/// and in an `async function` alike.  The async lowering renames every local
/// to a fresh spelling before it flattens the body, and the alternatives have
/// to come out of that rename spelled alike, or the arm body reads a name only
/// one of them binds.  An owning payload is matched too, so the one binding
/// is released once whichever alternative produced it.
namespace MatchAlternativesBindOneValue::Main;

import std::ffi::libc;
import std::future;
import std::future::{ Sleep };
import std::time::duration;
import std::time::duration::{ Duration };
import std::collections::string;
import std::collections::string::{ String };

type enum Shape { A(i64); B(i64); C; }

type enum Label { Named(String); Titled(String); Blank; }

function pick(s: Shape) -> i64 {
    match (s) {
        Shape::A(v) | Shape::B(v) => { return v + 1; }
        Shape::C => { return 0; }
    }
}

function label_len(l: Label) -> u64 {
    match (l) {
        Label::Named(t) | Label::Titled(t) => { return t.length(); }
        Label::Blank => { return 0; }
    }
}

async function apick(s: Shape) -> i64 {
    match (s) {
        Shape::A(v) | Shape::B(v) => {
            await Sleep::new(Duration::from_millis(1));
            return v + 1;
        }
        Shape::C => { return 0; }
    }
}

async function alabel_len(l: Label) -> u64 {
    match (l) {
        Label::Named(t) | Label::Titled(t) => {
            await Sleep::new(Duration::from_millis(1));
            return t.length();
        }
        Label::Blank => { return 0; }
    }
}

async function main() -> i32 {
    const a: i64 = pick(Shape::A(4));
    const b: i64 = pick(Shape::B(6));
    const c: i64 = await apick(Shape::A(10));
    const d: i64 = await apick(Shape::B(20));
    const e: u64 = label_len(Label::Named(String::from_string("abc")));
    const f: u64 = label_len(Label::Titled(String::from_string("abcde")));
    const g: u64 = await alabel_len(Label::Named(String::from_string("ab")));
    const h: u64 = await alabel_len(Label::Titled(String::from_string("abcdef")));
    libc::printf("%lld %lld %lld %lld %llu %llu %llu %llu\n", a, b, c, d, e, f, g, h);
    if (a == 5 && b == 7 && c == 11 && d == 21 && e == 3 && f == 5 && g == 2 && h == 6) {
        return 0;
    }
    return 1;
}
