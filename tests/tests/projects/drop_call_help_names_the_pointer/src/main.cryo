namespace DropCallHelpNamesThePointer::Main;

type struct Slot<T> { item: T*; }

function release_named<T>(q: T*) -> void {
    (*q).drop();
}

function release_field<T>(s: Slot<T>) -> void {
    (*s.item).drop();
}

function release_value<T>(v: T) -> void {
    v.drop();
}

function main() -> i32 {
    return 0;
}
