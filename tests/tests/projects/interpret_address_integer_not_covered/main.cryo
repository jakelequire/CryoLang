// An address's integer is its allocation's made-up base plus an offset
// (tools/CryoSmith/INTERPRETER.md section 4.1).  Multiplying it folds the
// base into the result, which a compiled build would print as wherever its
// allocator put the value, so `cryo interpret` stops there as not covered
// rather than print a number of its own.

namespace Main;

import std::fmt;

function main() -> i32 {
    const value: i64 = 7;
    const address: u64 = &value as u64;
    const folded: u64 = address * 31;
    fmt::println(f"{folded}");
    return 0;
}
