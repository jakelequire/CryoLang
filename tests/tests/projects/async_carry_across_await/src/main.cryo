// A value an async function holds across an `await` is carried in the
// future, and a rebuild of it after the suspend - in a branch, a loop, a
// `match` arm or at the top level - is the value later states see.  Which
// states carry it is decided per state by how that state FIRST touches the
// name: a state that reads it needs the previous value, and so does a state
// whose only write sits inside a branch - the path that skips the branch
// still has to see what the previous state left.  Getting that wrong is
// silent: the state would bind a value nobody wrote and publish it into the
// carrier for the next state to take.
//
// Each case also counts destructors: one per Tag built, because assigning
// over a value releases the one it displaces whether the value is a by-value
// parameter (materialized as a real local in each state) or a local carried
// in the future's field.
//
// `main` prints how many checks passed and exits 0 only when all did.
namespace AsyncCarryAcrossAwait::Main;

import std::fmt;
import std::core::drop::{ Drop };
import std::future;
import std::future::ready::{ PendingThenReady };

mut ac_drops: i32 = 0;

type struct Tag {
    id: u32;
}

implement trait Drop for struct Tag {
    drop(mut &this) -> void {
        ac_drops = ac_drops + 1;
    }
}

// Two suspends, so the value has to survive a real state transition.
async function rebuilt_in_if(c: boolean) -> u32 {
    mut v = Tag { id: 1 };
    const a = await PendingThenReady::<u32>::new(1, 10);
    if (c) { v = Tag { id: 2 }; }
    const b = await PendingThenReady::<u32>::new(1, 20);
    return v.id + a + b;
}

async function rebuilt_in_if_else(c: boolean) -> u32 {
    mut v = Tag { id: 1 };
    const a = await PendingThenReady::<u32>::new(1, 10);
    if (c) { v = Tag { id: 5 }; } else { v = Tag { id: 7 }; }
    const b = await PendingThenReady::<u32>::new(1, 20);
    return v.id + a + b;
}

async function rebuilt_in_loop(n: u32) -> u32 {
    mut v = Tag { id: 1 };
    const a = await PendingThenReady::<u32>::new(1, 10);
    mut i: u32 = 0;
    while (i < n) { v = Tag { id: 40 }; i = i + 1; }
    const b = await PendingThenReady::<u32>::new(1, 20);
    return v.id + a + b;
}

async function rebuilt_in_match(c: u32) -> u32 {
    mut v = Tag { id: 1 };
    const a = await PendingThenReady::<u32>::new(1, 10);
    match (c) {
        0 => { }
        _ => { v = Tag { id: 9 }; }
    }
    const b = await PendingThenReady::<u32>::new(1, 20);
    return v.id + a + b;
}

// The unconditional shape: the state produces its own value, and the value
// it displaces is still alive until the assignment releases it.
async function rebuilt_at_top_level() -> u32 {
    mut v = Tag { id: 1 };
    const a = await PendingThenReady::<u32>::new(1, 10);
    v = Tag { id: 3 };
    const b = await PendingThenReady::<u32>::new(1, 20);
    return v.id + a + b;
}

// A suspend between the carry-in and the rebuild: the hand-back inserted
// before `return Poll::Pending` must publish the value, or the next poll takes
// an empty carrier.
async function suspend_between(c: boolean) -> u32 {
    mut v = Tag { id: 1 };
    const a = await PendingThenReady::<u32>::new(1, 10);
    const m = await PendingThenReady::<u32>::new(2, 100);
    if (c) { v = Tag { id: 4 }; }
    const b = await PendingThenReady::<u32>::new(1, 20);
    return v.id + a + b + m;
}

// A droppable by-value parameter takes the same CARRY route as a local, but a
// different assignment route: it is materialized as a real local per state, so
// the rebuild below releases the argument the caller handed in.
async function param_rebuilt_in_if(mut v: Tag, c: boolean) -> u32 {
    const a = await PendingThenReady::<u32>::new(1, 10);
    if (c) { v = Tag { id: 6 }; }
    const b = await PendingThenReady::<u32>::new(1, 20);
    return v.id + a + b;
}

// A `match` EXPRESSION arm writes the carried value.  The write is
// branch-nested, so the arm that skips it must still see what the previous
// state left.
async function me_arm_rebuilds(c: u32) -> u32 {
    mut v = Tag { id: 1 };
    const a = await PendingThenReady::<u32>::new(1, 10);
    const k: u32 = match (c) {
        0 => { 0 }
        _ => { v = Tag { id: 9 }; 1 }
    };
    const b = await PendingThenReady::<u32>::new(1, 20);
    return v.id + a + b + k;
}

/// `ac_drops` is reset before each future is built, so it counts that
/// case's releases only.
function ac_check(name: string, got: u32, want: u32, want_drops: i32) -> i32 {
    if (got == want && ac_drops == want_drops) { return 1; }
    fmt::println(f"FAIL {name}: got {got} with {ac_drops} release(s), want {want} with {want_drops}");
    return 0;
}

function main() -> i32 {
    mut passed: i32 = 0;
    ac_drops = 0;
    passed += ac_check("branch_rebuild_taken_uses_new_value",
        future::block_on(rebuilt_in_if(true)), 32, 2);
    // The path that skips the branch must still see the value state 0 built.
    ac_drops = 0;
    passed += ac_check("branch_rebuild_skipped_keeps_previous_value",
        future::block_on(rebuilt_in_if(false)), 31, 1);
    ac_drops = 0;
    passed += ac_check("if_else_rebuild_then_branch",
        future::block_on(rebuilt_in_if_else(true)), 35, 2);
    ac_drops = 0;
    passed += ac_check("if_else_rebuild_else_branch",
        future::block_on(rebuilt_in_if_else(false)), 37, 2);
    ac_drops = 0;
    passed += ac_check("loop_rebuild_zero_iterations_keeps_previous",
        future::block_on(rebuilt_in_loop(0)), 31, 1);
    ac_drops = 0;
    passed += ac_check("loop_rebuild_runs_uses_new_value",
        future::block_on(rebuilt_in_loop(2)), 70, 3);
    ac_drops = 0;
    passed += ac_check("match_arm_rebuild_uses_new_value",
        future::block_on(rebuilt_in_match(1)), 39, 2);
    ac_drops = 0;
    passed += ac_check("match_arm_without_rebuild_keeps_previous",
        future::block_on(rebuilt_in_match(0)), 31, 1);
    ac_drops = 0;
    passed += ac_check("top_level_rebuild_binds_fresh_value",
        future::block_on(rebuilt_at_top_level()), 33, 2);
    ac_drops = 0;
    passed += ac_check("suspend_between_carry_and_rebuild_taken",
        future::block_on(suspend_between(true)), 134, 2);
    ac_drops = 0;
    passed += ac_check("suspend_between_carry_and_rebuild_skipped",
        future::block_on(suspend_between(false)), 131, 1);
    ac_drops = 0;
    passed += ac_check("param_branch_rebuild_taken",
        future::block_on(param_rebuilt_in_if(Tag { id: 1 }, true)), 36, 2);
    ac_drops = 0;
    passed += ac_check("param_branch_rebuild_skipped_keeps_argument",
        future::block_on(param_rebuilt_in_if(Tag { id: 1 }, false)), 31, 1);
    ac_drops = 0;
    passed += ac_check("match_expr_arm_rebuild_taken_uses_new_value",
        future::block_on(me_arm_rebuilds(1)), 40, 2);
    ac_drops = 0;
    passed += ac_check("match_expr_arm_rebuild_skipped_keeps_previous",
        future::block_on(me_arm_rebuilds(0)), 31, 1);
    fmt::println(f"async_carry_across_await: {passed} of 15 passed");
    if (passed != 15) { return 1; }
    return 0;
}
