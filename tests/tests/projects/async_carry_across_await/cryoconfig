# async_carry_across_await - a value an async function holds across an `await`
# is carried in the future, and a rebuild of it after the suspend - in a
# branch, a loop, a `match` arm or at the top level - is the value later
# states see, with one release for every value built.  Each case checks both
# the result and the release count.
[project]
project_name = "async_carry_across_await"
output_dir   = "build"
target_type  = "executable"
source_dir   = "src"
entry_point  = "src/main.cryo"
[compiler]
[dependencies]
