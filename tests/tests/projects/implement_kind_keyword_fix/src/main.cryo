namespace ImplementKindKeywordFix;

type enum Light { Off; On; }

type trait Brightness {
    level(&this) -> i32;
}

implement trait Brightness for struct Light {
    level(&this) -> i32 {
        return match (this) {
            Light::Off => { 0 }
            Light::On  => { 7 }
        };
    }
}

function main() -> i32 {
    const light: Light = Light::On;
    if (light.level() != 7) { return 1; }
    return 0;
}
