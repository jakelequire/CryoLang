/// A store of the compiler's own modules: each table keyed by text or a raw
/// number is refused at its field; one keyed by an identity's key type, or
/// allowed with a reason, is not.
namespace compiler::resolver::symbol_str;

import std::collections::hashmap::{ HashMap };
import std::collections::hashset::{ HashSet };
import std::core::hash::{ Hash, Hasher };
import std::core::cmp::{ Eq };
import app;

type struct SymbolStr {
    id: u32;
}

/// An identity's key: made from the identity, never from a number.
type struct DefKey {
private:
    slot: u64;
public:
    static first() -> DefKey { return DefKey { slot: 0 }; }
}

implement trait Hash for struct DefKey {
    hash<H>(&this, hasher: mut &H) -> void where H: Hasher {
        this.slot.hash(hasher);
    }
}

implement trait Eq for struct DefKey {
    equals(&this, other: &DefKey) -> boolean {
        return this.slot == other.slot;
    }
}

type struct Store {
    by_def:      HashMap<DefKey, i32>;
    by_pos:      i64[];
    by_spelling: HashMap<SymbolStr, i32>;
    by_id:       HashMap<u32, i32>;
    by_text:     HashMap<string, i32>;
    seen:        HashSet<u64>;
    ![allow(lookup_by_spelling, reason = "keyed by a source position, which no spelling reaches")]
    by_slot:     HashMap<u64, i32>;
    ![allow(lookup_by_spelling)]
    reasoned:    HashMap<u32, i32>;
}

function main() -> i32 {
    mut m: HashMap<DefKey, i32> = HashMap::<DefKey, i32>::new();
    m.insert(DefKey::first(), 3);
    const three: i32 = match (m.get(&DefKey::first())) {
        Option::Some(v) => { v }
        Option::None    => { 0 }
    };
    return three + app::four();
}
