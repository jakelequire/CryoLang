/// A module outside the compiler's namespace keys its tables as it likes.
namespace app;

import std::collections::hashmap::{ HashMap };

type struct Table {
    by_name: HashMap<string, i32>;
}

function four() -> i32 {
    mut t: Table = Table { by_name: HashMap::<string, i32>::new() };
    const key: string = "four";
    t.by_name.insert(key, 4);
    return match (t.by_name.get(&key)) {
        Option::Some(v) => { v }
        Option::None    => { 0 }
    };
}
