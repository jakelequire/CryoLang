namespace TypeConstantCrossModule::Geometry;

public type struct Point {
    x: i32;
    y: i32;
    const ORIGIN: Point = Point { x: 0, y: 0 };
    const CORNERS: i32 = 4;
    private const HIDDEN: i32 = 5;

    static hidden_doubled() -> i32 { return Point::HIDDEN * 2; }
}

implement u8 {
    const HALF: u8 = 128;
}

/// A module global with a type constant's name.
const CORNERS: i32 = 40;
