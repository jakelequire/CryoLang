namespace TypeConstantCrossModule;

import TypeConstantCrossModule::Geometry;
import TypeConstantCrossModule::Geometry::{ Point };

function main() -> i32 {
    const o: Point = Point::ORIGIN;
    if (o.x != 0 || o.y != 0) { return 1; }
    mut corners: [i32; Point::CORNERS] = [0; 4];
    corners[3] = Geometry::Point::CORNERS;
    if (corners[3] != 4) { return 2; }
    if (Geometry::CORNERS != 40) { return 3; }
    if (Point::hidden_doubled() != 10) { return 4; }
    if (u8::HALF != 128) { return 5; }
    return 0;
}
