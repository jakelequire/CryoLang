/// A call of a pointee's field that holds a function, reached through
/// `Deref`, is the value the function returns, as the same call on the
/// pointee is: it initializes an `i64`, takes part in arithmetic and
/// compares with an integer. The exit code names the first that answered
/// wrong.
namespace DerefFieldCallIsItsResult::Main;

import std::core::ops::{ Deref };

type struct Tally {
    step: (i64) -> i64;
}

type struct Holder {
    tally: Tally;
}

implement trait Deref for struct Holder {
    type Target = Tally;
    deref(&this) -> const Tally* { return &this.tally; }
}

function double(n: i64) -> i64 { return n * 2; }

function main() -> i32 {
    const holder: Holder = Holder { tally: Tally { step: double } };
    const direct: i64 = holder.tally.step(5);
    const through: i64 = holder.step(5);
    if (direct != through) { return 1; }
    if (holder.step(5) + 1 != 11) { return 2; }
    if (holder.step(4) != 8) { return 3; }
    return 0;
}
