// `cryo interpret` computes with 128-bit integers as the language defines
// them: addition and multiplication wrap at 128 bits, division truncates
// toward zero, a signed right shift is arithmetic, a narrowing cast keeps
// the low bits and a widening one keeps the value.  The fold below is the
// shape a 128-bit hasher writes; the compiled program prints the same line.

namespace Main;

import std::fmt;

function main() -> i32 {
    const greatest: u128 = 340282366920938463463374607431768211455;
    const wrapped: u128 = greatest.wrapping_add(2);
    const prime: u128 = 309485009821345068724781371;
    mut hash: u128 = 144066263297769815596495629667062367629;
    for (mut i: u8 = 0; i < 4; i++) {
        hash = hash ^ ((i as u16) as u128);
        hash = hash.wrapping_multiply(prime);
    }
    const negative: i128 = 0 - 170141183460469231731687303715884105727;
    const quotient: i128 = negative / 7;
    const remainder: i128 = negative % 7;
    const one: u128 = 1;
    const shifted: u128 = one << 100;
    const high: u64 = (hash >> 64) as u64;
    const low: u64 = hash as u64;
    const sign: i128 = negative >> 120;
    const back: i64 = negative as i64;
    fmt::println(f"wide: {wrapped} {high} {low} {quotient} {remainder} {shifted >> 90} {sign} {back} {negative < 0} {greatest > hash}");
    return 0;
}
