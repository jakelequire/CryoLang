///! An inherent block whose head writes the type's arguments - `implement<T>
///! struct Wrap<Wrap<T>>` - lends its methods to exactly the instances the
///! head accepts: its parameters bind to the parts of the receiver's
///! arguments in their places, a method of one name may be declared by two
///! such blocks whose heads accept no instance in common, and a generic body
///! whose receiver every instantiation of which the head accepts calls them.

namespace Main;

type struct Wrap<T> {
    value: T;
}

type struct Two<T> {
    first: T;
    second: T;
}

implement struct Wrap<T> {
    get(&this) -> T where T: Copy { return this.value; }
}

implement<T> struct Wrap<Wrap<T>> {
    inner(&this) -> T where T: Copy { return this.value.value; }
    unwrapped(&this) -> Wrap<T> where T: Copy { return this.value; }
    pick(&this) -> i64 { return 3; }
}

implement<T> struct Wrap<Two<T>> {
    second(&this) -> T where T: Copy { return this.value.second; }
    pick(&this) -> i64 { return 4; }
}

function nested_inner<U>(w: Wrap<Wrap<U>>) -> U where U: Copy {
    return w.inner();
}

function main() -> int {
    const nested: Wrap<Wrap<i32>> = Wrap { value: Wrap { value: 5 } };
    const paired: Wrap<Two<i64>> = Wrap { value: Two { first: 1, second: 7 } };
    if (nested.inner() != 5) { return 1; }
    if (nested.unwrapped().get() != 5) { return 2; }
    if (paired.second() != 7) { return 3; }
    if (nested.pick() != 3 || paired.pick() != 4) { return 4; }
    if (nested_inner(nested) != 5) { return 5; }
    const deeper: Wrap<Wrap<Wrap<u8>>> = Wrap { value: Wrap { value: Wrap { value: 9 } } };
    if (deeper.inner().get() != 9) { return 6; }
    return 0;
}
