// An object refused a bound (E0306) is never told to implement the trait
// for itself, since no implementation can be written for an object: it is
// told to use a type that implements the trait, and why the object does
// not.  A type that is not an object keeps the site's own help.
namespace ObjectBoundUnmetHelp;

type trait Grow {
    grow<T>(&this, t: T) -> i32;
}

type trait Size {
    size(&this) -> i32;
}

type struct Tally {
    n: i32;
}

type struct Plain {
    n: i32;
}

implement trait Grow for Tally {
    grow<T>(&this, t: T) -> i32 { return 1; }
}

implement trait Size for Tally {
    size(&this) -> i32 { return this.n; }
}

type struct Hold<G> where G: Grow {
    g: G;
}

type struct Measure<S> where S: Size {
    s: S;
}

function main() -> int {
    const t: Tally = Tally { n: 1 };
    const g: virtual &Grow = &t;
    const h: Hold<virtual &Grow> = Hold::<virtual &Grow> { g: g };
    const m: Measure<virtual &Grow> = Measure::<virtual &Grow> { s: g };
    const q: Hold<Plain> = Hold::<Plain> { g: Plain { n: 2 } };
    return 0;
}
