namespace ThreadScopePanicsWhenAThreadPanicked;

import std::core::intrinsics;
import std::core::panic_unwind::{ catch_unwind, PanicInfo };
import std::core::result::{ Result };
import std::fmt;
import std::thread;

function run_scope() -> i32 {
    thread::scope((s: mut &thread::Scope) -> void {
        s.spawn(() -> void { fmt::println("the quiet thread ran"); });
        s.spawn(() -> void { intrinsics::panic("a scoped thread gave up", intrinsics::location()); });
    });
    return 0;
}

function main() -> int {
    const outcome: Result<i32, PanicInfo> = catch_unwind(run_scope);
    match (outcome) {
        Result::Ok(_) => { fmt::println("the scope returned"); }
        Result::Err(info) => {
            fmt::print("the scope panicked: ");
            fmt::println(info.msg);
        }
    }
    return 0;
}
