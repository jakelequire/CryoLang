namespace trait_default_copy_pattern_spans;

// A trait's default body is checked as each implementation's copy of it.
// The copy keeps the pattern's segment spans, so a variant the enum does
// not declare is reported at the variant's name, not at the whole path.

type enum Color { Red; Green; }

type trait Paint {
    shade(&this, c: Color) -> i32 {
        return match (c) {
            Color::Red => { 1 }
            Color::Purple => { 2 }
            _ => { 3 }
        };
    }
}

type struct P { n: i32; }

implement trait Paint for struct P { }

function main() -> i32 {
    const p: P = P { n: 1 };
    return p.shade(Color::Red);
}
