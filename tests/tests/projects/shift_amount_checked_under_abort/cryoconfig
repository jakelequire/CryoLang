# shift_amount_checked_under_abort - a shift by its type's width or more in a
# program built with the abort strategy writes the panic report, with the
# amount and the width, and exits 101, as every other panic does.

[project]
project_name = "shift_amount_checked_under_abort"
output_dir   = "build"
target_type  = "executable"
source_dir   = "src"
entry_point  = "src/main.cryo"

[compiler]
panic = "abort"

[dependencies]
