namespace OpaqueMethodReturnOfInferredGenericLiteral;

// A method returning `implement Trait` built from a generic struct's
// literal written without type arguments returns the instance the
// literal's field values give it: an instance method, a static one, and a
// method of an inherent implementation, the last holding a capturing
// `move` closure, whose type cannot be written.  Each is called from a
// function written before the type.

type trait Source { next_value(mut &this) -> i64; }

type struct Gen<F> where F: () -> i64 {
    f: F;
}

implement<F> trait Source for Gen<F> where F: () -> i64 {
    next_value(mut &this) -> i64 { return this.f(); }
}

function four() -> i64 { return 4; }

function main() -> i32 {
    const maker: Maker = Maker { tag: 0 };
    mut made = maker.make();
    mut made_static = Maker::made();
    const counter: Counter = Counter { start: 9 };
    mut counting = counter.counting();
    if (made.next_value() != 4) { return 1; }
    if (made_static.next_value() != 4) { return 2; }
    if (counting.next_value() != 10) { return 3; }
    return 0;
}

type struct Maker {
    tag: i64;

    make(&this) -> implement Source { return Gen { f: four }; }

    static made() -> implement Source { return Gen { f: four }; }
}

type struct Counter {
    start: i64;
}

implement struct Counter {
    counting(&this) -> implement Source {
        const start: i64 = this.start;
        return Gen { f: move () -> i64 { return start + 1; } };
    }
}
