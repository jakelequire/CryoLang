namespace StringLiteralKeepsEveryByte;

// A string literal's constant holds every byte its escapes spell, a NUL
// among them, and `\a \b \f \v` are the C control bytes.

const GLOBAL_TEXT: string = "x\0yz";

function byte_at(s: string, i: i64) -> i32 {
    const p: u8* = s as u8*;
    return p[i] as i32;
}

function main() -> i32 {
    const s: string = "a\0bc";
    if (byte_at(s, 0) != 97) { return 1; }
    if (byte_at(s, 1) != 0) { return 2; }
    if (byte_at(s, 2) != 98) { return 3; }
    if (byte_at(s, 3) != 99) { return 4; }
    if (byte_at(s, 4) != 0) { return 5; }
    // Two literals alike up to a NUL are two constants.
    const t: string = "a\0bd";
    if (byte_at(t, 3) != 100) { return 6; }
    if (byte_at(GLOBAL_TEXT, 2) != 121) { return 7; }
    if (byte_at(GLOBAL_TEXT, 3) != 122) { return 8; }
    const c: string = "\a\b\f\v";
    if (byte_at(c, 0) != 7) { return 9; }
    if (byte_at(c, 1) != 8) { return 10; }
    if (byte_at(c, 2) != 12) { return 11; }
    if (byte_at(c, 3) != 11) { return 12; }
    if (c.length() != 4) { return 13; }
    // A one-digit hex escape is that byte, in a string and a character.
    if (byte_at("\x9", 0) != 9) { return 14; }
    if (('\x9' as i32) != 9) { return 15; }
    return 0;
}
