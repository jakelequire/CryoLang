namespace ImplQualifiedCallBindsGenericOwner;

import std::json::convert::{ FromJson, JsonDecodeError };
import std::json::value::{ JsonValue };
import std::collections::str::{ Str };
import std::collections::string::{ String };

type trait Make {
    static make_one() -> Result<This, i32>;
}

type struct Holder<T> {
    value: T;
}

implement trait Make for Holder<i64> {
    static make_one() -> Result<Holder<i64>, i32> { return Result::Ok(Holder::<i64> { value: 40 }); }
}

implement trait Make for Holder<i32> {
    static make_one() -> Result<Holder<i32>, i32> { return Result::Ok(Holder::<i32> { value: 2 }); }
}

function main() -> int {
    const text: JsonValue = JsonValue::String(String::from_str(Str::new("four")));
    // `String` written bare: its allocator parameter takes its default.
    const bare: i64 = match ((FromJson for String)::from_json(&text)) {
        Result::Ok(read) => { read.length() }
        Result::Err(_) => { 100 }
    };
    if (bare != 4) { return 1; }
    const absent: JsonValue = JsonValue::Null;
    const refused: i64 = match ((FromJson for String)::from_json(&absent)) {
        Result::Ok(read) => { read.length() }
        Result::Err(_) => { 8 }
    };
    if (refused != 8) { return 2; }
    // An implementation for each instance: the written arguments select it.
    const wide: i64 = match ((Make for Holder<i64>)::make_one()) {
        Result::Ok(h) => { h.value }
        Result::Err(_) => { 100 }
    };
    if (wide != 40) { return 3; }
    const narrow: i32 = match ((Make for Holder<i32>)::make_one()) {
        Result::Ok(h) => { h.value }
        Result::Err(_) => { 100 }
    };
    if (narrow != 2) { return 4; }
    // Through a local, not only as a match subject.
    const kept: Result<String, JsonDecodeError> = (FromJson for String)::from_json(&text);
    if (kept.unwrap().length() != 4) { return 5; }
    return 0;
}
