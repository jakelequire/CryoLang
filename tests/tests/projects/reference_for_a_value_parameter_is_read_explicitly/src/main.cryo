/// A `&i64` passed where an `i64` is declared is refused, and the fix
/// offered writes `*` before it: the value a reference refers to is read
/// explicitly.  The build fails; the project pins the refusal's text and
/// the fix's, which a negative file's annotation does not.
namespace ReferenceForAValueParameterIsReadExplicitly::Main;

function take(index: i64) -> i64 {
    return index;
}

function main() -> i32 {
    const x: i64 = 7;
    const r: &i64 = &x;
    return take(r) as i32;
}
