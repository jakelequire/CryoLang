/// A `match` on a `Str` with string patterns: each pattern is the literal
/// converted to `Str`, and an arm is taken when the subject equals it
/// through `Str`'s `Eq`.  The statement form, the expression form, a
/// pattern list, a guard, the empty string, a view into longer text and a
/// subject that is a call (evaluated once) are each checked; the exit code
/// names the first check that failed.
namespace MatchStrSubjectWithTextPatterns::Main;

import std::collections::str::{ Str };
import std::collections::string::{ String };
import std::fmt;

function classify(word: Str) -> i32 {
    return match (word) {
        "yes" | "y"    => { 1 }
        "no"           => { 2 }
        ""             => { 3 }
        _              => { 0 }
    };
}

function classify_statement(word: Str) -> i32 {
    mut answer: i32 = -1;
    match (word) {
        "stop"  => { answer = 10; }
        "go"    => { answer = 20; }
        _       => { answer = 30; }
    }
    return answer;
}

function guarded(word: Str, allowed: boolean) -> i32 {
    return match (word) {
        "admin" if (allowed) => { 1 }
        "admin"              => { 2 }
        _                    => { 3 }
    };
}

/// Counts its calls, so a subject evaluated more than once is seen.
type struct Source {
    calls: i32;

    next(mut &this) -> Str {
        this.calls = this.calls + 1;
        return "third";
    }
}

function main() -> i32 {
    if (classify("yes") != 1) { return 1; }
    if (classify("y") != 1) { return 2; }
    if (classify("no") != 2) { return 3; }
    if (classify("") != 3) { return 4; }
    if (classify("yesno") != 0) { return 5; }
    if (classify("ye") != 0) { return 6; }

    if (classify_statement("stop") != 10) { return 7; }
    if (classify_statement("go") != 20) { return 8; }
    if (classify_statement("going") != 30) { return 9; }

    if (guarded("admin", true) != 1) { return 10; }
    if (guarded("admin", false) != 2) { return 11; }
    if (guarded("user", true) != 3) { return 12; }

    // A view of part of a longer text: no terminator follows "no" here, so
    // the comparison is by the view's length, not to a terminator.
    const text: Str = "nothing";
    match (text.split_once("t")) {
        Option::Some(parts) => {
            if (classify(parts.first) != 2) { return 13; }
        }
        Option::None => { return 14; }
    }

    // A `String`'s text, matched through its view.
    const owned: String = String::from_string("go");
    if (classify_statement(owned.as_str()) != 20) { return 15; }

    mut source: Source = Source { calls: 0 };
    const picked: i32 = match (source.next()) {
        "first"  => { 1 }
        "second" => { 2 }
        "third"  => { 3 }
        _        => { 0 }
    };
    if (picked != 3) { return 16; }
    if (source.calls != 1) { return 17; }

    // The text a reference refers to, matched through the dereference.
    const word: Str = "no";
    const borrowed: &Str = &word;
    if (classify(*borrowed) != 2) { return 18; }
    const direct: i32 = match (*borrowed) {
        "no" => { 1 }
        _    => { 0 }
    };
    if (direct != 1) { return 19; }

    fmt::println("text patterns: all checks passed");
    return 0;
}
