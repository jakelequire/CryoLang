# match_str_subject_with_text_patterns - a `match` on a `Str` subject with
# string patterns (outcome = "run").
#
# Each string pattern is the literal converted to `Str` where the subject
# declares the type, and the arm is taken when the subject equals it
# through `Str`'s `Eq`.  The program exits 0 when every check holds, and
# with the number of the first failed check otherwise.

[project]
project_name = "match_str_subject_with_text_patterns"
output_dir   = "build"
target_type  = "executable"
source_dir   = "src"
entry_point  = "src/main.cryo"

