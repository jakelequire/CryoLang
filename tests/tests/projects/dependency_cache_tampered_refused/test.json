{
  "outcome": "build",
  "requires": ["git"],
  "git_fixtures": [
    { "name": "greeter", "from": "fixtures/greeter",
      "commits": [ { "tree": "v1", "tag": "v1" } ] }
  ],
  "steps": [
    ["fetch"],
    { "write": "{cache:greeter@v1}/src/lib.cryo", "text": "namespace Greeting;\npublic function value() -> int { return 12; }\n", "fails": true },
    { "write": "{cache:greeter@v1}/src/extra.cryo", "text": "namespace Greeting;\n" }
  ],
  "expect": {
    "fails": true,
    "output_contains": [
      "error: the files of dependency 'greeter' in the cache are not those of commit",
      "help: run `cryo fetch`"
    ]
  }
}
