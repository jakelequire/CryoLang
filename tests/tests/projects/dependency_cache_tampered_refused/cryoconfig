# dependency_cache_tampered_refused - the package cache holds a commit's
# files read-only, and a build refuses a cached tree that is not the one
# the lock records.  After `cryo fetch`, a step tries to rewrite the cached
# lib.cryo (refused: the file is read-only), then adds a file beside it
# (the directory takes it); the build then refuses the dependency, naming
# the commit, instead of compiling files that are not that commit's.
[project]
project_name = "dependency_cache_tampered_refused"
output_dir   = "build"
target_type  = "executable"
source_dir   = "src"
entry_point  = "src/main.cryo"

[compiler]

[dependencies]
greeter = { git = "{fixture:greeter}", tag = "v1" }
