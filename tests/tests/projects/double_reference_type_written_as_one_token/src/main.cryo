namespace DoubleReferenceTypeWrittenAsOneToken;

// `&&T` in a type is two references, `& &T`, though `&&` is one token: the
// spellings with and without a space name the same type, and a `mut` after
// the pair marks the inner reference.

function read_twice(value: &&i64) -> i64 {
    return *(*value);
}

function spaced(value: & &i64) -> &&i64 {
    return value;
}

function repoint(slot: mut &&i64, to: &i64) -> void {
    *slot = to;
}

function add_through(value: &&mut i64, amount: i64) -> void {
    *(*value) += amount;
}

function main() -> i32 {
    const x: i64 = 5;
    const r: &i64 = &x;
    const rr: &&i64 = &r;
    if (read_twice(rr) != 5) { return 1; }
    const same: & &i64 = spaced(rr);
    if (read_twice(same) != 5) { return 2; }

    const y: i64 = 9;
    mut pointed: &i64 = &x;
    repoint(&pointed, &y);
    if (*pointed != 9) { return 4; }

    mut counter: i64 = 1;
    const m: mut &i64 = &counter;
    add_through(&m, 41);
    if (counter != 42) { return 3; }
    return 0;
}
