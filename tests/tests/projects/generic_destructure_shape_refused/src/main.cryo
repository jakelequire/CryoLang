/// A destructure in a generic body is checked against the fields its type's
/// template declares, where it is written: a field bound twice, a field the
/// type does not have and a field left out are refused even when nothing
/// instantiates the body, and once, on the generic body, when something does.
/// A field bound twice also binds its name twice, which the name layer
/// refuses first (E0205).
namespace GenericDestructureShapeRefused::Main;

type struct Two<T> {
    a: T;
    b: T;
}

function bound_twice<T>(p: Two<T>) -> T {
    const {a, a}: Two<T> = p;
    return a;
}

function unknown_field<T>(p: Two<T>) -> T {
    const {a, b, c}: Two<T> = p;
    return b;
}

function field_left_out<T>(p: Two<T>) -> T {
    const {a}: Two<T> = p;
    return a;
}

function used<T>(p: Two<T>) -> T {
    const {a, d}: Two<T> = p;
    return a;
}

function intact<T>(p: Two<T>) -> T {
    const {a, b}: Two<T> = p;
    return b;
}

function main() -> i32 {
    const t: Two<i32> = Two::<i32> { a: 1, b: 2 };
    return used::<i32>(t) + intact::<i32>(Two::<i32> { a: 3, b: 4 });
}
