# test_command_passes_undeclared_options - `cryo test --no-capture`: the
# compiler declares no `--no-capture` flag, so `cryo test` hands it to the test
# binary as written, whose runner declares it, and the tests run.
# build_refuses_undeclared_option is the control: `cryo build` still refuses it.

[project]
project_name = "test_command_passes_undeclared_options"
output_dir   = "build"
target_type  = "executable"
source_dir   = "src"
entry_point  = "src/main.cryo"

