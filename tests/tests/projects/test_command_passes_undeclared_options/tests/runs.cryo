///! A test for the runner to run once `--no-capture` has reached it.

![config(testing)]
namespace TestCommandPassesUndeclaredOptions::Tests;

import std::core::result::{ Result };
import std::test::error::{ TestError };
import std::test::assert::{ expect_eq };

![test]
function runs_with_the_option_forwarded() -> Result<(), TestError> {
    return expect_eq(2 + 2, 4);
}
