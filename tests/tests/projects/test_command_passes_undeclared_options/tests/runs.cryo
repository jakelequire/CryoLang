///! A test whose output reaches `cryo test`'s own stdout only when
///! `--no-capture` has reached the runner: a captured passing test's output
///! is never replayed.

![config(testing)]
namespace TestCommandPassesUndeclaredOptions::Tests;

import std::core::result::{ Result };
import std::fmt;
import std::ffi::libc;
import std::test::error::{ TestError };
import std::test::assert::{ expect_equal };

![test]
function runs_with_the_option_forwarded() -> Result<(), TestError> {
    fmt::printf("written by a test the runner did not capture\n");
    libc::fflush(null);
    return expect_equal(2 + 2, 4);
}
