# native_alloc_gate - a test PROJECT that opts into the native mmap-backed
# heap via `[low_level] native_alloc = true` (Low-Level Plan Stage 3). The
# projects meta-runner builds and runs it. Every GlobalAlloc allocation in
# this binary - Box/Array/String/HashMap/format/new/delete - is served by
# `std::alloc::heap` instead of libc malloc. The program stresses the
# collections end-to-end with content checksums, so a corrupted or misrouted
# block fails loudly. The OFF polarity (gate mechanism) is covered by the
# `config_native_alloc_gate` lang test; the heap's raw surface is unit-tested
# in `tests/stdlib/native_heap.cryo` in every build.

[project]
project_name = "native_alloc_gate"
output_dir   = "build"
target_type  = "executable"
source_dir   = "src"
entry_point  = "src/main.cryo"

[low_level]
native_alloc = true

