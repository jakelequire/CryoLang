/// `toupper` and `isxdigit` are declared in <ctype.h> itself on every C
/// library this compiler targets, so an angle-bracket import binds both
/// under the alias and they link against the C library.  The exit code says
/// which call answered wrong; 0 means both held.
namespace CImportSystemHeader::Main;

import std::ffi::libc;

extern module cctype := "C" {
    #include <ctype.h>
}

function main() -> int {
    if (cctype::toupper(97) != 65) { return 1; }
    if (cctype::isxdigit(70) == 0) { return 2; }
    libc::printf("system header import ok\n");
    return 0;
}
