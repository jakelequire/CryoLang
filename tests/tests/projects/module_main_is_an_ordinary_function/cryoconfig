# module_main_is_an_ordinary_function - only the entry file's `main` is the
# program's entry point (outcome = "run").
#
# A sub-module declaring its own `main` is an ordinary function, called by
# its path.  Both were emitted as the C entry point when the entry point was
# recognised by its name, and the link refused two definitions of `main`.

[project]
project_name = "module_main_is_an_ordinary_function"
output_dir   = "build"
target_type  = "executable"
source_dir   = "src"
entry_point  = "src/main.cryo"

