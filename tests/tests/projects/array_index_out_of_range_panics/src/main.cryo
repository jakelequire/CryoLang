/// An index at the array's length is out of range: the read panics before
/// it touches memory past the last element, and the program never prints
/// what it read.  A negative signed index is out of range the same way.
namespace ArrayIndexOutOfRange::Main;

import std::fmt;
import std::collections::array::{ Array };

function main() -> i32 {
    const xs: Array<i64> = [1, 2, 3];
    const in_range: i32 = 2;
    fmt::println(f"in range: {xs[in_range]}");
    const at_length: i32 = 3;
    fmt::println(f"read past the end: {xs[at_length]}");
    return 0;
}
