// `cryo interpret` computes the bit-operation intrinsics by their
// definitions in stdlib/core/intrinsics.cryo: a byte swap reverses the
// bytes, a population count counts the set bits, a zero input's leading
// and trailing zero counts are its width, and a rotation takes its count
// modulo the width.  The compiled program prints the same line.

namespace Main;

import std::core::intrinsics;
import std::fmt;

function main() -> i32 {
    const word: u64 = 0x0123456789ABCDEF;
    const half: u32 = 0x80000001;
    const zero: u64 = 0;
    const swapped: u64 = intrinsics::bswap64(word);
    const swapped_half: u32 = intrinsics::bswap32(half);
    const swapped_short: u16 = intrinsics::bswap16(0x1234);
    const left: u64 = word.rotate_left(12);
    const right: u64 = word.rotate_right(68);
    const left_half: u32 = half.rotate_left(33);
    const right_half: u32 = half.rotate_right(1);
    fmt::println(f"bits: {swapped} {swapped_half} {swapped_short} {left} {right} {left_half} {right_half}");
    fmt::println(f"counts: {word.count_ones()} {half.count_ones()} {word.leading_zeros()} {half.leading_zeros()} {zero.leading_zeros()} {word.trailing_zeros()} {zero.trailing_zeros()} {intrinsics::ctz32(0)} {intrinsics::clz32(0)}");
    return 0;
}
