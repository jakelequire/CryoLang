/// A checked multiplication that overflows reports its place whole - file,
/// line, column and the method's qualified name - and the operation, then
/// ends the program before the result is used.
namespace OverflowPanicReportsItsPlace;

import std::fmt;

type struct Area {
    width:  u32;
    height: u32;

    cells(&this) -> u32 {
        return this.width * this.height;
    }
}

function main() -> int {
    const area: Area = Area { width: 65536, height: 65536 };
    fmt::println("before");
    fmt::println(f"{area.cells()}");
    fmt::println("after");
    return 0;
}
