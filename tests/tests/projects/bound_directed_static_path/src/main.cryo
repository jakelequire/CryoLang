namespace BoundDirected::Main;

type trait Beta {
    go(&this) -> i32;
    static make() -> i32;
}

type trait Gamma {
    go(&this) -> i32;
    static make() -> i32;
}

type struct P {
    v: i32;
}

implement trait Beta for P {
    go(&this) -> i32 { return this.v * 2; }
    static make() -> i32 { return 2; }
}

implement trait Gamma for P {
    go(&this) -> i32 { return this.v * 5; }
    static make() -> i32 { return 5; }
}

type struct Wrap<T> {
    v: T;
}

implement<T> struct Wrap<T> where T: Gamma {
    // An impl-level bound directs the path inside a method too.
    static via_impl_bound() -> i32 { return T::make(); }
}

function via_beta<T>() -> i32 where T: Beta {
    return T::make();
}

function via_gamma<T>() -> i32 where T: Gamma {
    return T::make();
}

function via_beta_recv<T>(t: &T) -> i32 where T: Beta {
    return T::go(t);
}

function via_value<T>() -> i32 where T: Gamma {
    const f: () -> i32 = T::make;
    return f();
}

function main() -> int {
    const p: P = P { v: 1 };
    const a: i32 = via_beta::<P>();           // 2
    const b: i32 = via_gamma::<P>();          // 5
    const c: i32 = via_beta_recv::<P>(&p);    // 2
    const d: i32 = via_value::<P>();          // 5
    const w: Wrap<P> = Wrap::<P> { v: P { v: 3 } };
    const e: i32 = Wrap::<P>::via_impl_bound() + w.v.v - 3; // 5
    // 2 + 5 + 2 + 5 + 5 = 19
    return a + b + c + d + e;
}
