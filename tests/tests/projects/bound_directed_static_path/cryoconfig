# bound_directed_static_path - `T::make()` under `where T: Beta` names
# Beta's `make`, as `t.go()` under the same bound names Beta's `go`: the
# bound is the only thing that says what the member is where the call is
# written, and it directs the path after `T` is substituted with a type
# that implements two traits providing the member (`P`: Beta and Gamma).
# One rule at every shape the path takes: the static call, the call with
# a receiver argument (`T::go(t)`), the method taken as a value
# (`T::make`), and a method of a generic impl whose bound is the impl's
# (`implement<T> struct Wrap<T> where T: Gamma`).  A parameter with two
# bounds is not directed and its instantiation ties (E0156); a bound whose
# trait lacks the member leaves the bare reading.  Each call runs the bound
# trait's body; the exit code sums them.  Before the rule every one of
# the five was the E0156 tie once `T = P`.
[project]
project_name = "bound_directed_static_path"
output_dir   = "build"
target_type  = "executable"
source_dir   = "src"
entry_point  = "src/main.cryo"
