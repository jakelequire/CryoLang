namespace StdlibCallableCombinators;

import std::collections::array::{ Array };

// The standard library's combinators take their callback through a callable
// bound, so a capturing closure is accepted wherever a named function or a
// non-capturing lambda is, and each is called with the value it is given.

function double(n: i32) -> i32 { return n * 2; }
function is_even(n: i32) -> boolean { return n % 2 == 0; }

function main() -> i32 {
    const offset: i32 = 100;
    const some: Option<i32> = Option::Some(5);
    const none: Option<i32> = Option::None;

    // Option
    if (some.map((n: i32) -> i32 { return n + offset; }).unwrap_or(0) != 105) { return 1; }
    if (some.map(double).unwrap_or(0) != 10) { return 2; }
    if (none.unwrap_or_else(() -> i32 { return offset; }) != 100) { return 3; }
    const chained: Option<i64> = some.and_then((n: i32) -> Option<i64> { return Option::Some((n + offset) as i64); });
    if (chained.unwrap_or(0) != 105) { return 4; }
    if (none.or_else(() -> Option<i32> { return Option::Some(offset); }).unwrap_or(0) != 100) { return 5; }
    const as_result: Result<i32, i32> = none.ok_or_else(() -> i32 { return offset + 1; });
    match (as_result) {
        Result::Ok(_)  => { return 6; }
        Result::Err(e) => { if (e != 101) { return 7; } }
    }

    // Result
    const ok: Result<i32, i32> = Result::Ok(7);
    const err: Result<i32, i32> = Result::Err(3);
    if (ok.map((n: i32) -> i32 { return n + offset; }).unwrap_or(0) != 107) { return 8; }
    if (err.unwrap_or_else((e: i32) -> i32 { return e + offset; }) != 103) { return 9; }
    const mapped_err: Result<i32, i64> = err.map_err((e: i32) -> i64 { return (e + offset) as i64; });
    match (mapped_err) {
        Result::Ok(_)  => { return 10; }
        Result::Err(e) => { if (e != 103) { return 11; } }
    }
    const then: Result<i32, i32> = ok.and_then((n: i32) -> Result<i32, i32> { return Result::Ok(n * offset); });
    if (then.unwrap_or(0) != 700) { return 12; }
    const recovered: Result<i32, i64> = err.or_else((e: i32) -> Result<i32, i64> { return Result::Ok(e + offset); });
    if (recovered.unwrap_or(0) != 103) { return 13; }

    // Iterator
    mut values: Array<i32> = Array::<i32>::new();
    values.push(1);
    values.push(2);
    values.push(3);
    const sum: i32 = values.iter().fold(offset, (acc: i32, n: i32) -> i32 { return acc + n; });
    if (sum != 106) { return 14; }
    if (!values.iter().any((n: i32) -> boolean { return n + offset == 102; })) { return 15; }
    if (!values.iter().all((n: i32) -> boolean { return n < offset; })) { return 16; }
    if (!values.iter().any(is_even)) { return 17; }
    const limit: i32 = 2;
    const found: Option<i32> = values.iter().find((n: &i32) -> boolean { return *n > limit; });
    if (found.unwrap_or(0) != 3) { return 18; }
    mut seen: i32 = 0;
    const counter: mut i32* = &seen;
    values.iter().for_each((n: i32) -> void { unsafe { *counter = *counter + n + offset; } });
    if (seen != 306) { return 19; }

    // A callable bound binds the accumulator before a literal's default
    // could: `0` is an `i64` here, the closure's, not an `i32`.
    const wide_sum: i32 = values.iter().fold(0, (acc: i64, n: i32) -> i64 { return acc + (n * offset) as i64; }) as i32;
    if (wide_sum != 600) { return 20; }
    if (values.iter().fold(0, (acc: i32, n: i32) -> i32 { return acc + double(n); }) != 12) { return 21; }
    return 0;
}
