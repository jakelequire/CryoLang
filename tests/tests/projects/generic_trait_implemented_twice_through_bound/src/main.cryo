/// One type implements a generic trait at two arguments, `Conv<i32>` and
/// `Conv<i64>`.  A call through the bound `T: Conv<X>` is answered by the
/// implementation whose head writes the `X` of each copy, and the two
/// implementations' methods are two link symbols.
namespace GenericTraitImplementedTwice;

type trait Conv<X> {
    conv(&this) -> i32;
}

type struct S { v: i32; }

implement trait Conv<i32> for struct S { conv(&this) -> i32 { return 1; } }
implement trait Conv<i64> for struct S { conv(&this) -> i32 { return 20; } }

/// A second type with one implementation: the bound still selects it.
type struct One { v: i32; }

implement trait Conv<i64> for struct One { conv(&this) -> i32 { return 300; } }

function via<T, X>(t: &T) -> i32 where T: Conv<X> {
    return t.conv();
}

function main() -> i32 {
    const s: S = S { v: 0 };
    const o: One = One { v: 0 };
    if (via::<S, i32>(&s) != 1) { return 1; }
    if (via::<S, i64>(&s) != 20) { return 2; }
    if (via::<One, i64>(&o) != 300) { return 3; }
    return 0;
}
