namespace InstancePlacement;

import std::collections::array::{ Array };
import std::core::pair::{ Pair };
import std::core::option::{ Option };
import std::collections::string::{ String };
import std::collections::str::{ Str };
import std::core::result::{ Result };
import std::fmt::display::{ Display, Formatter };
import std::fmt::error::{ FormatError };
import std::core::hash::{ Hash, Hasher };
import InstancePlacement::Shapes::{ Square };
import InstancePlacement::Wrapping::{ Wrapped, wrap, Label };
import InstancePlacement::Measuring::{ Measure };
import std::core::slice::{ Slice };

type struct Meters { value: i64; }

implement trait Display for struct Meters {
    fmt(&this, f: mut &Formatter) -> Result<(), FormatError> {
        return f.write_str(Str::new("m"));
    }
}

type struct Counting { bytes: i64; }

implement trait Hasher for struct Counting {
    write_u8(mut &this, value: u8) -> void { this.bytes += 1; }

    finish(&this) -> u64 { return this.bytes as u64; }
}

type struct Holder<T> {
    item: T;

    item_reference(&this) -> &T { return &this.item; }
}

function rebuilt<T>(items: &Array<T>) -> Array<T> where T: Clone {
    mut out: Array<T> = Array::new();
    for (item in items.iterate_references()) { out.push(item.clone()); }
    return out;
}

function identity<T>(value: T) -> T { return value; }

function main() -> i32 {
    mut words: Array<String> = Array::new();
    words.push(String::from("a"));
    const copy: Array<String> = rebuilt(&words);
    const held: Holder<String> = Holder { item: String::from("held") };
    const labelled: Pair<String, Meters> = Pair::new(String::from("m"), Meters { value: 2 });
    const n: i64 = identity(3);
    // Neither `Shapes` nor `Wrapping` imports the other: the type
    // argument's module is chosen before the template's.
    const square: Wrapped<Square> = wrap(Square { side: 4 });
    // An instantiated type's arguments come before its own module, which
    // holds its template.
    const maybe: Option<Wrapped<Square>> = Option::Some(wrap(Square { side: 0 }));
    // A method's own type arguments place its instance as a type's do,
    // ahead of its receiver: a standard-library method given a program's
    // closure (one that captures, so its type is the program's) or type is
    // defined in the program ...
    mut numbers: Array<i64> = Array::new();
    numbers.push(1);
    numbers.push(3);
    const origin: i64 = 0;
    numbers.sort_by_key((value: &i64) -> i64 { return origin - *value; });
    mut text: String = String::new();
    text.append(Meters { value: 5 });
    // A trait implementation's method too: `Hash for i64` given a
    // program's hasher.
    mut counting: Counting = Counting { bytes: 0 };
    const hashed: i64 = 7;
    hashed.hash(&counting);
    // ... and a method of a type of no parameters given a type of a module
    // its own does not import is defined in that type's module.
    const label: Label = Label { width: 1 };
    const paired: Wrapped<Square> = label.paired(Square { side: 2 });
    // An instance none of whose type arguments names a module is defined
    // in the module declaring the method, whichever module asked for it:
    // an `i32` index into an `Array<i64>`.
    const first: i32 = 0;
    const indexed: i64 = numbers[first];
    // A module's own trait implemented for a standard-library
    // instantiation is defined in that module.
    const values: [i32; 3] = [4, 5, 6];
    const measured: i64 = Slice::<i32>::from_raw(&values[0], 3).size();
    const total: i64 = copy.length() + held.item_reference().length() + labelled.second.value + n
        + square.inner.side + maybe.unwrap().inner.side + numbers[0] + text.length() + paired.inner.side
        + (counting.finish() as i64) + indexed + measured;
    return if (total == 65) { 0 } else { 1 };
}
