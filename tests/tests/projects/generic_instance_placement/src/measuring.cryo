namespace InstancePlacement::Measuring;

import std::core::slice::{ Slice };

public type trait Measure {
    size(&this) -> i64;
}

// Written here for a standard-library instantiation: the block names this
// module's trait, so it is defined in this module, not with `Slice<i32>`
// in std::core::slice.
implement trait Measure for struct Slice<i32> {
    size(&this) -> i64 { return this.length() * 10 + this.as_pointer()[0] as i64; }
}
