namespace InstancePlacement::Wrapping;

public type struct Wrapped<T> { public inner: T; }

public function wrap<T>(value: T) -> Wrapped<T> { return Wrapped { inner: value }; }

/// A type of no type parameters whose method has one of its own.
public type struct Label {
    public width: i64;

    public paired<T>(&this, value: T) -> Wrapped<T> { return Wrapped { inner: value }; }
}
