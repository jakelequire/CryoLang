# match_string_pattern_on_struct - a string pattern on a struct subject is
# refused (outcome = "compile_fail").
#
# A literal pattern is compared with the subject's own value, so a string
# pattern against a struct has nothing to compare with: accepted, it compiled
# to an arm that never matched, with no diagnostic, and this program returned
# 0 where the writer expected 1.

[project]
project_name = "match_string_pattern_on_struct"
output_dir   = "build"
target_type  = "executable"
source_dir   = "src"
entry_point  = "src/main.cryo"

