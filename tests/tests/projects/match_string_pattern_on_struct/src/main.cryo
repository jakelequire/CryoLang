/// A string pattern on a struct subject: the struct holds "yes", and the arm
/// written for "yes" can never be tested against it - the struct is not a
/// string.  Refused at the pattern.
namespace MatchStringPatternOnStruct::Main;

type struct Word {
    text: string;
}

function classify(w: Word) -> i32 {
    return match (w) {
        // The pattern this project's refusal points at.
        "yes" => { 1 }
        _     => { 0 }
    };
}

function main() -> i32 {
    const w: Word = Word { text: "yes" };
    return classify(w);
}
