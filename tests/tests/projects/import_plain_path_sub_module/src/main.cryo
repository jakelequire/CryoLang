namespace ImportPlainPathSubModule::Main;

import IppsmA::Toml;
import IppsmA::{ Yaml };

function take(p: Toml::Sub::Pt) -> i32 { return p.v; }

// No file imports `IppsmA::Toml::Sub`, `IppsmA::Toml::Sub::Deep` or
// `IppsmA::Yaml::Sub`: each is loaded because a path here names it, and
// reached through the import whose binding heads the path.
function main() -> i32 {
    if (Toml::one() != 1) { return 1; }
    if (Toml::Sub::three() != 3) { return 2; }
    if (Toml::Sub::Deep::nine() != 9) { return 3; }
    const p: Toml::Sub::Pt = Toml::Sub::Pt { v: 4 };
    if (take(p) != 4) { return 4; }
    const f: () -> i32 = Toml::Sub::three;
    if (f() != 3) { return 5; }
    if (Yaml::Sub::five() != 5) { return 6; }
    return 0;
}
