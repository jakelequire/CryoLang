/// `pick` is two generic functions, one taking one argument and one taking
/// two.  Each is its own template: `pick(3)` instantiates the one-argument
/// declaration, whose `pick<i32>` is not the two-argument declaration's.
namespace GenericFunctionOverloadsAreTwoTemplates::Main;

function pick<T>(a: T) -> T { return a; }
function pick<T>(a: T, b: T) -> T { return b; }

function main() -> i32 {
    const x: i32 = pick(3);
    if (x != 3) { return 1; }
    return 0;
}
