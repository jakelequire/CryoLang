namespace new_generic_enum_variant;

// `new E<..>::V(..)` allocates the instance the arguments name, whose
// variant's payload type is bound.

function main() -> i32 {
    const o: Option<i64>* = new Option<i64>::Some(41);
    const k: i64 = match (*o) {
        Option::Some(x) => { x }
        Option::None    => { 0 }
    };
    delete o;
    return k as i32;
}
