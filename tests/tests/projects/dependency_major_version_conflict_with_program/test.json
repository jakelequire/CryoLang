{
  "outcome": "command",
  "requires": ["git"],
  "git_fixtures": [
    { "name": "gauge", "from": "fixtures/gauge",
      "commits": [ { "tree": "v1.0.0", "tag": "v1.0.0" },
                   { "tree": "v2.0.0", "tag": "v2.0.0" } ] }
  ],
  "command": ["fetch"],
  "expect": {
    "fails": true,
    "stderr_contains": [
      "error: the program needs more than one major version of `gauge` (",
      "  note: the program asks for version 1: cryoconfig writes `gauge = { git = \"file://",
      "\", tag = \"v1.0.0\" }`, which names gauge 1.0.0",
      "  note: `dial` 0.1.0 asks for version 2: ",
      "  help: to build gauge 2.0.0, write `gauge = { git = \"file://",
      "\", tag = \"v2.0.0\", version = \"2\" }` in cryoconfig"
    ],
    "stderr_excludes": ["help: `dial`"]
  }
}
