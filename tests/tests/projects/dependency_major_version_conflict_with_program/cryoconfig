# dependency_major_version_conflict_with_program - the program takes gauge
# 1.0.0, and its dependency dial takes gauge 2.0.0. `cryo fetch` refuses the
# two major versions and shows the program's entry rewritten to build gauge
# 2.0.0.
[project]
project_name = "dependency_major_version_conflict_with_program"
output_dir   = "build"
target_type  = "executable"
source_dir   = "src"
entry_point  = "src/main.cryo"

[compiler]

[dependencies]
gauge = { git = "{fixture:gauge}", tag = "v1.0.0" }
dial  = { path = "packages/dial" }
