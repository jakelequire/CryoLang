/// A function handed one of the compiler's spelling types may carry it -
/// store it, hand it on, hand it to a door - with nothing said.  Looking
/// something up by it outside a door, with nothing saying why, is refused at
/// the parameter, naming where it is looked up: a comparison, a hash table's
/// key, a `match`.  The spelling types are known to the compiler by the
/// qualified names its own declarations give them, so this program declares
/// types at those names.
namespace compiler::resolver::symbol_str;

import compiler::resolver::qualified_name::{ QualifiedName };
import std::collections::hashmap;
import std::collections::hashmap::{ HashMap };
import std::core::option;
import std::core::option::{ Option };

type struct SymbolStr {
    id: u32;

    /// A receiver is the method's owner, not a spelling it was handed: not
    /// refused.
    is_empty(&this) -> boolean {
        return this.id == 0;
    }

    /// `other` is compared: refused.
    equals(&this, other: SymbolStr) -> boolean {
        return this.id == other.id;
    }
}

type struct Decl {
    n: i32;
    name: SymbolStr;
}

/// A search: each element's name compared with the spelling.  Refused.
function find_leaf(decls: &Decl[], name: SymbolStr) -> i32 {
    for (mut i: i64 = 0; i < decls.length; i++) {
        if (decls[i].name.equals(name)) { return decls[i].n; }
    }
    return 0;
}

/// The spelling's number, behind a reference, as a hash table's key.
/// Refused.
function find_by_ref(table: &HashMap<u32, i32>, name: &SymbolStr) -> i32 {
    return match (table.get(&name.id)) {
        Option::Some(n) => { n }
        Option::None    => { 0 }
    };
}

/// An element's number as a `match`'s subject.  Refused.
function find_path(segments: SymbolStr[]) -> i32 {
    return match (segments[0].id) {
        1 => { 1 }
        _ => { 0 }
    };
}

/// The path's text compared.  Refused.
function find_qualified(path: QualifiedName) -> i32 {
    if (path.text == "a::b") { return 1; }
    return 0;
}

/// Carried into a value: not refused.
function carry(name: SymbolStr) -> Decl {
    return Decl { n: 1, name: name };
}

/// Handed on to a function that looks it up: refused there, not here.
function pass_along(decls: &Decl[], name: SymbolStr) -> i32 {
    return find_leaf(decls, name);
}

/// Handed to a door: not refused.
function by_door(name: SymbolStr) -> i32 {
    return door_leaf(name);
}

/// Door `scope-value`: a door is where a spelling is looked up, and its marker
/// says why; not refused.
function door_leaf(name: SymbolStr) -> i32 {
    if (name.id == 7) { return 7; }
    return 0;
}

/// A depth is a number, not the path's spelling: not refused.
function depth_of(path: QualifiedName) -> i32 {
    if (path.depth == 2) { return 2; }
    return 0;
}

/// Takes no spelling: not refused.
function count(n: i32) -> i32 {
    return n + 1;
}

/// Denying is the default, and changes nothing: the lookup is refused.
![deny(lookup_by_spelling)]
function by_deny(name: SymbolStr) -> i32 {
    if (name.id == 1) { return 1; }
    return 0;
}

function main() -> i32 {
    const s: SymbolStr = SymbolStr { id: 3 };
    const q: QualifiedName = QualifiedName { depth: 2, text: "a::b" };
    mut decls: Decl[] = [];
    decls.push(carry(s));
    mut table: HashMap<u32, i32> = HashMap::<u32, i32>::new();
    table.insert(3, 4);
    mut segs: SymbolStr[] = [];
    segs.push(s);
    return find_leaf(&decls, s) + find_by_ref(&table, &s) + find_path(segs) + find_qualified(q)
        + pass_along(&decls, s) + by_door(s) + depth_of(q) + count(0) + by_deny(s);
}
