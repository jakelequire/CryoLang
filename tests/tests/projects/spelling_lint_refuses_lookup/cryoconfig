
# spelling_lint_refuses_lookup - a function that looks up by a spelling it
# was handed, outside a door and with no
# `![allow(lookup_by_spelling, reason = "...")]`, is refused
# (outcome = "compile_fail"); one that only carries it is not.
#
# The compiler knows its spelling types by the qualified names its own
# declarations give them; this program declares a `SymbolStr` and a
# `QualifiedName` at those names.  Five functions look one up, by a
# comparison, a hash table's key and a `match`; a carrier, a function handing
# the spelling on, a door and a function reading a number that is not the
# spelling are accepted.

[project]
project_name = "spelling_lint_refuses_lookup"
output_dir   = "build"
target_type  = "executable"
source_dir   = "src"
entry_point  = "src/main.cryo"

