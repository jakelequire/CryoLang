namespace OverloadedFunctionValueByExpectedType::Main;

type struct Conv {
    k: i32;
    static conv(x: i32) -> i32 { return x + 1; }
    static conv(x: f64) -> f64 { return x * 2.0; }
}

function twice(x: i32) -> i32 { return x * 2; }
function twice(x: i64) -> i64 { return x * 3; }

function apply(f: (i64) -> i64, v: i64) -> i64 { return f(v); }

function pick() -> (f64) -> f64 { return Conv::conv; }

function main() -> i32 {
    const f: (i32) -> i32 = Conv::conv;
    const g: (f64) -> f64 = Conv::conv;
    const h: (i64) -> i64 = twice;
    const k: (i32) -> i32 = twice;
    if (f(4) != 5) { return 1; }
    if (g(1.5) != 3.0) { return 2; }
    if (h(5 as i64) != 15) { return 3; }
    if (k(5) != 10) { return 4; }
    if (apply(twice, 2 as i64) != 6) { return 5; }
    const p: (f64) -> f64 = pick();
    if (p(2.0) != 4.0) { return 6; }
    // Direct calls select by their arguments, whatever the context.
    twice(1);
    Conv::conv(1);
    const a: i64 = twice(4 as i64);
    if (a != 12) { return 7; }
    if (Conv::conv(2.0) != 4.0) { return 8; }
    return 0;
}
