// A generic function's bound that an object cannot meet is refused at the
// call with E0306, and the note names the method that blocks the object.
namespace ObjectBoundUnmetNoteCall;

type trait Grow {
    grow<T>(&this, t: T) -> i32;
}

type struct Tally {
    n: i32;
}

implement trait Grow for Tally {
    grow<T>(&this, t: T) -> i32 { return 1; }
}

function grows<G>(g: G) -> i32 where G: Grow {
    return 1;
}

function main() -> int {
    const t: Tally = Tally { n: 1 };
    const g: virtual &Grow = &t;
    return grows(g);
}
