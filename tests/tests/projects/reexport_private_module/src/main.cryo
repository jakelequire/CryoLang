/// `Shown` arrives through the re-export and is named in braces (the control);
/// `Hidden` is named by neither, and must stay unreachable. Naming `Shown`
/// keeps the two apart: without it both would fail, and the E0240 this asserts
/// would be indistinguishable from a file that simply imported nothing.
namespace ReexportPrivateModule::Main;

import ReexportPrivateModule::Facade;
import ReexportPrivateModule::Facade::{ Shown };

function main() -> int {
    const s: Shown  = Shown  { v: 1 };
    const h: Hidden = Hidden { v: 2 };
    return (s.get() + h.get()) as int;
}
