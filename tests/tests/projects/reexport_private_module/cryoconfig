# reexport_private_module - `export A::B;` grants B's export set, and a
# `private` declaration is not in it.
#
# The sharper half of "an export cannot widen visibility": E0241 judges the
# items a brace list names, and a whole-module export names none, so only the
# use-site gate can catch this. `Shown` is the control -- it comes through the
# same export, so a run where BOTH are rejected proves nothing.
#
# The note must not offer an import either: no import reaches a private
# declaration, and suggesting one would send the author to fix a file that
# cannot help them.

[project]
project_name = "reexport_private_module"
output_dir   = "build"
target_type  = "executable"
source_dir   = "src"
entry_point  = "src/main.cryo"

