// An enum variant's discriminant is a compile-time integer expression, folded
// by the same folder as a constant's initializer: a shift, an OR of the
// enum's own variants written through the enum, a named constant (this
// module's or another's), a forward reference to a later variant and a
// negated literal.  A variant without one takes the one after its
// predecessor's.  The tags are the same wherever they are read: a cast, a
// match on the value and an array size.
namespace enum_discriminant_constant_expressions;

import std::fmt;
import enum_discriminant_constant_expressions::bits;

const BASE: u32 = 1 << 4;

type enum Flag : u32 {
    A = 1 << 0;
    B = 1 << 1;
    C = 1 << 2;
    AB = Flag::A | Flag::B;
    ABC = Flag::AB | Flag::C;
    D = BASE;
    E;
    Big = 0xFFFF_FFFF;
}

type enum Signed {
    Low = -2;
    Mid;
    High;
}

type enum Forward {
    X = Forward::Y + 10;
    Y = 3;
}

type enum Imported {
    Shifted = 1 << bits::SHIFT;
}

const AB_SIZE: i64 = Flag::AB as i64;

function name_of(f: Flag) -> string {
    return match (f) {
        Flag::A => { "A" }
        Flag::AB => { "AB" }
        _ => { "other" }
    };
}

function main() -> i32 {
    const cells: [u8; AB_SIZE] = [0; AB_SIZE];
    fmt::printf("flags %u %u %u %u %u %u %u %u\n", Flag::A as u32, Flag::B as u32, Flag::C as u32,
        Flag::AB as u32, Flag::ABC as u32, Flag::D as u32, Flag::E as u32, Flag::Big as u32);
    fmt::printf("signed %d %d %d\n", Signed::Low as i32, Signed::Mid as i32, Signed::High as i32);
    fmt::printf("forward %d %d\n", Forward::X as i32, Forward::Y as i32);
    mut size: i64 = 0;
    for (mut i: i64 = 0; i < AB_SIZE; i++) { size = size + 1 + cells[i] as i64; }
    fmt::printf("matched %s size %lld\n", name_of(Flag::AB), size);
    fmt::printf("imported %d\n", Imported::Shifted as i32);
    return 0;
}
