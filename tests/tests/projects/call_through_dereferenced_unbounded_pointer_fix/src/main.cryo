/// `(*p)()` for a type parameter no callable bound gives a signature is
/// refused as a call through a local of that type is, with the bound written
/// from the call as the fix.
namespace CallThroughDereferencedUnboundedPointerFix;

function call_through<F>(p: F*) -> void {
    (*p)(1);
}

function main() -> int { return 0; }
