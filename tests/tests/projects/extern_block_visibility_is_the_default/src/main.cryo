namespace BlockVis::Main;

import BlockVis::Ffi;

function main() -> int {
    const from_private_block: i32 = Ffi::abs(-3);
    const from_public_block: i64 = Ffi::llabs(-30);
    const narrowed_in_block: i64 = Ffi::labs(-9);
    const global: i32 = Ffi::hidden_counter;
    return from_private_block + (from_public_block + narrowed_in_block) as int + global;
}
