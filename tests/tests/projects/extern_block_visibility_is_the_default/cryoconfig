# extern_block_visibility_is_the_default - the keyword before `extern`
# is the visibility of every function and global in the block that writes
# none, and one written on the function or global itself decides its own:
# a `private extern "C"` block's function, a `private function` in a
# `public extern "C"` block and a `private mut` global are all E0353 from
# another module, while the block's other public function is accepted.
[project]
project_name = "extern_block_visibility_is_the_default"
output_dir   = "build"
target_type  = "executable"
source_dir   = "src"
entry_point  = "src/main.cryo"
