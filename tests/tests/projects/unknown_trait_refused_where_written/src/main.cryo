namespace UnknownTraitRefused::Main;

type trait Known { id(&this) -> i32; }

// A supertrait no trait answers.
type trait Sub : Missing { go(&this) -> i32; }

// A where-clause bound on a function, on a type declaration and on an impl.
function f<T>(x: &T) -> i32 where T: Nowhere { return 1; }

type struct W<T> where T: AlsoMissing { v: T; }

implement<T> struct W<T> where T: StillMissing {
    get(&this) -> i32 { return 2; }
}

// A known trait beside an unknown one: only the unknown one is reported.
function g<T>(x: &T) -> i32 where T: Known + Absent { return 3; }

function main() -> i32 {
    return 0;
}
