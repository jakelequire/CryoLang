# unknown_trait_refused_where_written - a name written where a trait must
# stand that names nothing in scope is refused where it is written, as a
# trait (E0242, "cannot find trait `X` in this scope"): a supertrait, and a
# `where` bound on a function, a type declaration and an impl.  Such a name
# used to compile until something asked the bound for a method or checked
# it at an instantiation, and then was reported there, if at all.
[project]
project_name = "unknown_trait_refused_where_written"
output_dir   = "build"
target_type  = "executable"
source_dir   = "src"
entry_point  = "src/main.cryo"
[compiler]
[dependencies]
