namespace AssignmentReleasesDisplacedValueLast;

import std::core::drop::{ Drop };
import std::fmt;

// The value an assignment displaces is older than every value its statement
// makes, so it is released last, after the statement's temporaries - for a
// local, a field of one, and a place reached through a reference alike.
//
// Each release appends the released resource's id to `g_order`.

mut g_order: i64 = 0;

type struct Resource {
    id: i64;
}

implement trait Drop for struct Resource {
    drop(mut &this) -> void { g_order = g_order * 10 + this.id; }
}

type struct Holder {
    resource: Resource;
}

function make(id: i64) -> Resource { return Resource { id: id }; }

function combine(first: &Resource, second: &Resource) -> Resource {
    return Resource { id: first.id + second.id };
}

function store_through(target: mut &Resource) -> void {
    *target = combine(&make(5), &make(2));
}

function main() -> i32 {
    mut local: Resource = make(9);
    g_order = 0;
    local = combine(&make(1), &make(2));
    const one: i64 = g_order;

    mut holder: Holder = Holder { resource: make(7) };
    g_order = 0;
    holder.resource = combine(&make(4), &make(5));
    const two: i64 = g_order;

    mut target: Resource = make(8);
    g_order = 0;
    store_through(&target);
    const three: i64 = g_order;

    fmt::println(f"order: {one} {two} {three} {local.id} {holder.resource.id} {target.id}");
    return 0;
}
