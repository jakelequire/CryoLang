namespace NumericConversionFix::Main;

// A value of one number type given where another is expected is offered the
// `as` conversion, an operator expression parenthesized first.  The fixes
// that edit two places of one line are drawn as the line with both edits.

type struct Node {
    value: i32;
}

function takes(a: i32) -> i32 { return a; }

function deep(pp: Node**) -> i32 {
    return pp.value;
}

function main() -> i32 {
    const e: i64 = 5;
    const f: i32 = e;
    const g: i32 = takes(e + 1);
    const u: u32 = 7;
    const k: i32 = takes(u);
    return f + g + k;
}
