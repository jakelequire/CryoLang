# impl_concrete_arg_filters_impl - an impl head naming a CONCRETE target
# argument applies to that instantiation only: `implement<T> trait Show for
# Wrap<T, Alpha>` gives `Wrap<i32, Beta>` no `show`, and `wb.show()` is E0358.
#
# RED at the commit that added it (section 8.223): the trait-impl registry
# keys an impl by (trait, TEMPLATE), so the head is selected for every
# instantiation of `Wrap`, and this program compiles and exits 11.  A
# concrete target argument is a filter on selection, not a parameter to
# bind; honouring it is the registry change section 8.223 scopes.
[project]
project_name = "impl_concrete_arg_filters_impl"
output_dir   = "build"
target_type  = "executable"
source_dir   = "src"
entry_point  = "src/main.cryo"
[compiler]
[dependencies]
