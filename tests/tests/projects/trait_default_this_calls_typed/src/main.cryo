/// A trait's default method is written against `This`, which stands for any
/// type implementing the trait, so a call on `this` is typed by the trait's
/// own declaration of that method - in a default with type parameters of its
/// own and in one without.  A wrong use of such a call's result is refused
/// in the default's body even when no type implements the trait yet.
namespace TraitDefaultThisCallsTyped::Main;

type trait Counter {
    count(&this) -> u64;

    doubled(&this) -> u64 {
        const n: u64 = this.count();
        return n * 2;
    }

    as_text(&this) -> u64 {
        const s: string = this.count();
        return 0;
    }

    scaled<T>(&this, by: T) -> u64 {
        const s: string = this.count();
        return 0;
    }
}

function main() -> i32 {
    return 0;
}
