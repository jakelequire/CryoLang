/// A module that names a type it has NOTHING in scope to name.
///
/// There is no `import` here at all. `Crate` is declared only by
/// `ResolutionTripwire::Depot`, which this module never imports, so under
/// spec §5.1 -- "the first segment resolves in scope" -- the bare `Crate` in
/// these signatures must not resolve.
///
/// It resolves anyway. See the tripwire in `tripwire_test.cryo`.
///
/// Both arms are here because sema binds them through different functions:
/// the static template through `find_static_method_template`, the free
/// function through `check_generic_free_call` (keystone shape B).
![config(testing)]
namespace ResolutionTripwire::Orphan;

type struct Packer {
    /// Static generic method returning a type this module cannot see.
    static pack<T>(v: T) -> Crate<T> {
        return Crate<T> { v: v };
    }
}

/// Free function returning a type this module cannot see.
function box_up<T>(v: T) -> Crate<T> {
    return Crate<T> { v: v };
}
