// `cryo interpret --overflow-checks=on` judges a compound assignment's
// overflow at its target's type, whatever the right side's width and sign,
// as the compiled program does: each difference that reaches the target's
// bound is stored, and the first past it panics.

namespace Main;

import std::fmt;

function keep<T>(value: T) -> T {
    return value;
}

function main() -> i32 {
    const byte: u8 = keep(200 as u8);
    const middle: i32 = keep(-5 as i32);
    const long: u64 = keep(u64::MAX);
    mut a: i16 = keep(-32568 as i16);
    a -= byte;
    mut b: u16 = keep(200 as u16);
    b -= byte;
    mut c: i64 = keep(i64::MAX - 5);
    c -= middle;
    mut d: u128 = keep(18446744073709551615 as u128);
    d -= long;
    fmt::println(f"edges {a} {b} {c} {d}");
    mut past: u16 = keep(199 as u16);
    past -= byte;
    fmt::println("past the edge");
    return 0;
}
