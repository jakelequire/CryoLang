# facade_offers_one_name_from_two_children - a facade's brace exports of one
# leaf from two children are refused at the facade.
#
# A brace `export` binds its names in the exporting module as an import does,
# so the second `Widget` is a second binding of one name: refused where it is
# written (E0243), before any importer can ask which one the facade means.
# The importer is never reported.  A whole-module re-export of two children
# that both declare a name is the other shape, refused at the use (E0155,
# `reexport_plural_function`).

[project]
project_name = "facade_offers_one_name_from_two_children"
output_dir   = "build"
target_type  = "executable"
source_dir   = "src"
entry_point  = "src/main.cryo"

