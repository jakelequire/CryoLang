///! `==` and `!=` compare two values of one type, so the right operand is
///! built against the left operand's type: an enum constructor on the right
///! takes the left's type arguments, and a literal in its payload the left's
///! payload type.

![config(testing)]
namespace CryoTests::Tests::Lang::EqualityRightOperandTypedFromLeft;

import std::core::option::{ Option };
import std::core::result::{ Result };
import std::collections::str::{ Str };
import std::test::error::{ TestError };
import std::test::assert::{ expect_true };

![test]
function an_option_compares_with_a_literal_payload_of_its_own_type() -> Result<(), TestError> {
    const value: Option<i64> = Option::Some(4);
    expect_true(value == Option::Some(4), Str::new("Some(4) == Some(4)"))?;
    return expect_true(value != Option::Some(5), Str::new("Some(4) != Some(5)"));
}

![test]
function an_option_compares_with_none() -> Result<(), TestError> {
    const value: Option<i64> = Option::Some(4);
    const empty: Option<u8> = Option::None;
    expect_true(value != Option::None, Str::new("Some(4) != None"))?;
    return expect_true(empty == Option::None, Str::new("None == None"));
}

![test]
function a_result_compares_with_both_variants() -> Result<(), TestError> {
    const good: Result<i64, i32> = Result::Ok(1);
    const bad: Result<i64, i32> = Result::Err(-2);
    expect_true(good == Result::Ok(1), Str::new("Ok(1) == Ok(1)"))?;
    expect_true(bad == Result::Err(-2), Str::new("Err(-2) == Err(-2)"))?;
    return expect_true(good != Result::Err(1), Str::new("Ok(1) != Err(1)"));
}
