# bound_call_borrows_in_copy - a trait-bound call in a generic body passes
# its arguments as the copy binds them: `a.equals(b)` in `Option<T>::equals`
# for `T = string` hands `string::equals` the payload's address, where the
# payload itself was passed and the program crashed.  Exits 0; each wrong
# answer exits with its own code.
[project]
project_name = "bound_call_borrows_in_copy"
output_dir   = "build"
target_type  = "executable"
source_dir   = "src"
entry_point  = "src/main.cryo"
[compiler]
[dependencies]
