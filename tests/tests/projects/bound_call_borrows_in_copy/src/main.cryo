namespace BoundCallBorrowsInCopy::Main;

// A trait-bound call in a generic body passes a reference argument as the
// reference it is in every copy: `a.equals(b)` in `Option<T>::equals`, with
// `T = string` (itself a pointer), hands `string::equals` the payload's
// address.
function main() -> i32 {
    const a: Option<string> = Option::Some("abc");
    const b: Option<string> = Option::Some("abc");
    const c: Option<string> = Option::Some("abd");
    const n: Option<string> = Option::None;
    if (!a.equals(&b)) { return 1; }
    if (a.equals(&c)) { return 2; }
    if (a.equals(&n)) { return 3; }
    const s: string = "abc";
    if (!a.contains(&s)) { return 4; }
    const r: Result<string, i32> = Result::Ok("abc");
    if (!r.contains(&s)) { return 5; }
    return 0;
}
