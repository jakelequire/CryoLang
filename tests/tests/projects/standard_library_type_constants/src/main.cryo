namespace StandardLibraryTypeConstants;

import std::time::duration::{ Duration };
import std::json::parser::{ Parser };

static_assert(u64::MAX_DECIMAL_DIGITS == 20 && i64::MAX_DECIMAL_DIGITS == 20, "64-bit decimal digits");
static_assert(u8::MAX_BIN_DIGITS == 8 && u128::MAX_OCT_DIGITS == 43, "binary and octal digits");
static_assert(Duration::NANOS_PER_SEC == 1000000000, "Duration's unit count folds");

function main() -> i32 {
    // A buffer sized by the digit count holds the widest value it bounds.
    mut decimal: [u8; u64::MAX_DECIMAL_DIGITS] = [0; u64::MAX_DECIMAL_DIGITS];
    if (u64::MAX.to_decimal_buf(&decimal[0]) != u64::MAX_DECIMAL_DIGITS) { return 1; }
    mut signed: [u8; i32::MAX_DECIMAL_DIGITS] = [0; i32::MAX_DECIMAL_DIGITS];
    if (i32::MIN.to_decimal_buf(&signed[0]) != i32::MAX_DECIMAL_DIGITS) { return 2; }
    mut hex: [u8; u32::MAX_HEX_DIGITS] = [0; u32::MAX_HEX_DIGITS];
    if (u32::MAX.to_hex_buf(&hex[0]) != u32::MAX_HEX_DIGITS) { return 3; }

    if (Duration::from_millis(1500).as_nanos() != 3 * Duration::NANOS_PER_SEC / 2) { return 4; }
    if (Duration::MILLIS_PER_SEC * Duration::NANOS_PER_MILLI != Duration::NANOS_PER_SEC) { return 5; }
    if (Parser::MAX_DEPTH != 256) { return 6; }
    return 0;
}
