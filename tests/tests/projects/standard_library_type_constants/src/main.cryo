namespace StandardLibraryTypeConstants;

import std::time::duration::{ Duration };

static_assert(u64::MAX_DECIMAL_DIGITS == 20 && i64::MAX_DECIMAL_DIGITS == 20, "64-bit decimal digits");
static_assert(u8::MAX_BINARY_DIGITS == 8 && u128::MAX_OCTAL_DIGITS == 43, "binary and octal digits");
static_assert(Duration::NANOSECONDS_PER_SECOND == 1000000000, "Duration's unit count folds");

function main() -> i32 {
    // A buffer sized by the digit count holds the widest value it bounds.
    mut decimal: [u8; u64::MAX_DECIMAL_DIGITS] = [0; u64::MAX_DECIMAL_DIGITS];
    if (u64::MAX.to_decimal_buffer(&decimal[0]) != u64::MAX_DECIMAL_DIGITS) { return 1; }
    mut signed: [u8; i32::MAX_DECIMAL_DIGITS] = [0; i32::MAX_DECIMAL_DIGITS];
    if (i32::MIN.to_decimal_buffer(&signed[0]) != i32::MAX_DECIMAL_DIGITS) { return 2; }
    mut hex: [u8; u32::MAX_HEX_DIGITS] = [0; u32::MAX_HEX_DIGITS];
    if (u32::MAX.to_hex_buffer(&hex[0]) != u32::MAX_HEX_DIGITS) { return 3; }

    if (Duration::from_milliseconds(1500).as_nanoseconds() != 3 * Duration::NANOSECONDS_PER_SECOND / 2) { return 4; }
    if (Duration::MILLISECONDS_PER_SECOND * Duration::NANOSECONDS_PER_MILLISECOND != Duration::NANOSECONDS_PER_SECOND) { return 5; }
    return 0;
}
