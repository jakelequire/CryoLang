namespace compiler::tools;

import std::collections::hashmap;
import std::collections::hashmap::{ HashMap };

// Nothing treats the `compiler` namespace specially: a program declared
// under it is checked as any other is.

type struct Cache {
    by_label: HashMap<string, i32>;
}

function main() -> i32 {
    mut c: Cache = Cache { by_label: HashMap::<string, i32>::new() };
    c.by_label.insert("a", 1);
    c.by_label.insert("b", 2);
    if (c.by_label.length() != 2) { return 1; }
    return 0;
}
