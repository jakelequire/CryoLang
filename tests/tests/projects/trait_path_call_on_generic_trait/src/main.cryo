/// A call through a generic trait's path, `Peek::peek(&x)` with `trait
/// Peek<R>`, runs the receiver's implementation and has its return: on a
/// plain struct, at each of two arguments a type implements the trait at
/// (chosen by the call's arguments), and on an instantiation of a generic
/// implementation.
namespace TraitPathCallOnGenericTrait::Main;

import std::ffi::libc::{ printf };

type trait Peek<R> {
    peek(&this) -> R;
}

type trait Put<R> {
    put(&this, value: R) -> i64;
}

type struct Plain { n: i32; }
type struct Holder<T> { item: T; }

implement trait Peek<i32> for struct Plain {
    peek(&this) -> i32 { return this.n; }
}

implement trait Put<i32> for struct Plain {
    put(&this, value: i32) -> i64 { return (value as i64) + 1; }
}

implement trait Put<i64> for struct Plain {
    put(&this, value: i64) -> i64 { return value + 100; }
}

implement<T> trait Peek<T> for struct Holder<T> {
    peek(&this) -> T { return this.item; }
}

function check(passed: i32, condition: boolean, what: string) -> i32 {
    if (!condition) {
        printf("FAILED: %s\n", what);
        return passed;
    }
    return passed + 1;
}

function main() -> i32 {
    mut passed: i32 = 0;
    const plain: Plain = Plain { n: 9 };
    const peeked: i32 = Peek::peek(&plain);
    passed = check(passed, peeked == 9, "a generic trait's path on a plain struct has the implementation's return");
    passed = check(passed, Put::put(&plain, 5) == 6, "the implementation at the argument's type, `i32`");
    passed = check(passed, Put::put(&plain, 7 as i64) == 107, "the implementation at the argument's type, `i64`");
    const holder: Holder<i64> = Holder { item: 40 };
    const held: i64 = Peek::peek(&holder);
    passed = check(passed, held == 40, "a generic implementation on an instantiation");
    printf("generic trait paths: %d of 4 checks passed\n", passed);
    if (passed != 4) { return 1; }
    return 0;
}
