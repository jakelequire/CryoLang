// An array size is computed in its operands' types, so an operation in it
// that overflows its type is refused, with help that writes the size computed
// in a type that holds it.  A method call is no array size, so the help
// offers no wrapping method.
namespace ArraySizeOverflowShowsTheFix::Main;

const SMALL: u8 = 200;
const LEAST: i8 = i8::MIN;

type struct Buffer {
    doubled: [u8; SMALL * 2];
    negated: [u8; -LEAST];
}

function main() -> i32 {
    return 0;
}
