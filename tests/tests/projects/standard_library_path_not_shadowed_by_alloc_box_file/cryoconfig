# standard_library_path_not_shadowed_by_alloc_box_file - run. A program
# file at `alloc/box.cryo` is the program's own: the prelude's
# `alloc::box` line still names the standard library's file, so `Box`
# resolves without an import.
[project]
project_name = "standard_library_path_not_shadowed_by_alloc_box_file"
output_dir   = "build"
target_type  = "executable"
source_dir   = "src"
