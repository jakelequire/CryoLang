/// `Top::Widget` reaches `Deep::Widget` through `Left` and through `Right`.
/// Two routes to one declaration are one item, so the path names it rather
/// than being refused as offered from more than one module.
namespace TwoRoutes::Main;

import TwoRoutes::Top;

function main() -> int {
    const w: Top::Widget = Top::Widget { v: 9 };
    return w.v as int;
}
