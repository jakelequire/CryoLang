/// A `match` binding of a subject matched by value, not written `mut`, of
/// a `Copy` type, is a copy taken on entering the arm, so assigning the
/// subject in the arm leaves it as it was - in a generic function's copy as
/// in a function that is not generic: a payload binding, one nested in a
/// payload, and a binding of the whole subject.
namespace MatchBindingCopiedInGenericCopy::Main;

import std::fmt;

type enum Slot<T> {
    Wide(i64);
    Narrow(T);
    Nested(Option<i64>);
}

function payload_kept<T>(seed: i64, other: T) -> i64 where T: Copy {
    mut subject: Slot<T> = Slot::<T>::Wide(seed);
    mut seen: i64 = 0;
    match (subject) {
        Slot::Wide(value) => {
            subject = Slot::<T>::Narrow(other);
            seen = value;
        }
        _ => { }
    }
    return seen;
}

function nested_kept<T>(seed: i64, other: T) -> i64 where T: Copy {
    mut subject: Slot<T> = Slot::<T>::Nested(Option::Some(seed));
    mut seen: i64 = 0;
    match (subject) {
        Slot::Nested(Option::Some(value)) => {
            subject = Slot::<T>::Narrow(other);
            seen = value;
        }
        _ => { }
    }
    return seen;
}

function whole_kept<T>(seed: T, other: T) -> T where T: Copy {
    mut subject: T = seed;
    mut seen: T = other;
    match (subject) {
        value => {
            subject = other;
            seen = value;
        }
    }
    return seen;
}

function main() -> i32 {
    const payload: i64 = payload_kept::<i8>(1234567, 5);
    const nested: i64 = nested_kept::<u16>(7654321, 9);
    const whole: i64 = whole_kept::<i64>(4242, 17);
    fmt::println(f"kept: {payload} {nested} {whole}");
    return 0;
}
