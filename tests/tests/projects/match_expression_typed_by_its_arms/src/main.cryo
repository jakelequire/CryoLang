namespace MatchExpressionTypedByItsArms::Main;

import std::fmt;

type enum Outer { First; Second; }
type enum Inner { Left; Right; }

function widen(value: u64) -> u64 {
    return value + 1;
}

function pick(e: Inner) -> Inner {
    return e;
}

function main() -> i32 {
    const inner: Inner = pick(Inner::Right);
    const small: u16 = 300;

    // As another match's subject: the subject is an `Inner`, its arms'
    // type, whatever the outer match is expected to be.
    const outer: Outer = match (match (inner) { Inner::Right => { Inner::Left } _ => { Inner::Right } }) {
        Inner::Left => { Outer::Second }
        _ => { Outer::First }
    };
    const counted: u32 = match (match (inner) { Inner::Right => { Inner::Right } _ => { Inner::Left } }) {
        Inner::Right => { 3 }
        _ => { 4 }
    };
    const outer_number: u8 = match (outer) { Outer::Second => { 2 } _ => { 1 } };

    // As an operand of a comparison stored in a `boolean`: the match is a
    // `u16`, compared with a `u16`.
    const above: boolean = (match (inner) { Inner::Right => { small } _ => { small } }) >= 299;
    const below: boolean = (match (inner) { Inner::Right => { small } _ => { small } }) < 200;

    // As an argument: literal arms take the parameter's type, so an arm no
    // `i32` holds is a `u64`.
    const passed: u64 = widen(match (inner) { Inner::Right => { 4000000000 } _ => { 1 } });
    const as_if: u64 = widen(if (above) { 4000000000 } else { 1 });

    // A match of a narrower type stored wider widens at the initializer.
    const stored: u64 = match (inner) { Inner::Right => { small } _ => { small } };

    fmt::println(f"{outer_number} {counted} {above} {below} {passed} {as_if} {stored}");
    return 0;
}
