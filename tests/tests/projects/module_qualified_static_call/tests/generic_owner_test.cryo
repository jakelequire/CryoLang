![config(testing)]
namespace ModQualStatic::Tests::GenericOwner;

import ModQualStatic::Widget::Deque;
import std::core::result;
import std::test::error;
import std::test::assert;

// The owner's arguments come from the annotation, not the scope.  The
// CONTROL: the scope segment carries no arguments, so it was keyed by its
// stamp and always resolved.  A regression that keyed the owner on the written
// spelling again would keep this one passing while the rest failed.
![test]
function generic_owner_args_from_annotation() -> Result<(), error::TestError> {
    const s: Deque::Slot<i64> = Deque::Slot::make(4);
    return assert::expect_eq(s.item, 4);
}

// The owner's arguments are written on the scope segment.  A specialization
// has one identity, so `Deque::Slot<i64>` and a bare `Slot<i64>` must reach
// the same registration; keyed on the spelling, `Deque::Slot` named nothing
// and the call failed with E0233 before any argument was looked at.
![test]
function generic_owner_with_explicit_args() -> Result<(), error::TestError> {
    const s: Deque::Slot<i64> = Deque::Slot<i64>::make(4);
    return assert::expect_eq(s.item, 4);
}

// The return-type axis from static_call_test.cryo, on the generic owner: a
// void, a primitive and a different type each leave nothing in the call's own
// signature to recover the owner from.
![test]
function generic_owner_static_returning_void() -> Result<(), error::TestError> {
    Deque::Slot<i64>::touch();
    return Result::Ok(());
}

![test]
function generic_owner_static_returning_a_primitive() -> Result<(), error::TestError> {
    return assert::expect_eq(Deque::Slot<i64>::capacity(), 4);
}

![test]
function generic_owner_static_returning_a_different_type() -> Result<(), error::TestError> {
    const o: Deque::Other = Deque::Slot<i64>::other();
    return assert::expect_eq(o.z, 9);
}

// A generic static on the generic owner: the method's own argument is
// inferred, the owner's is written on the scope.
![test]
function generic_owner_generic_static() -> Result<(), error::TestError> {
    const v: i64 = Deque::Slot<i64>::tag(7 as u8, 5);
    return assert::expect_eq(v, 5);
}

// The call is written inside a generic body, so the owner's argument is a
// type parameter when the body is checked and a concrete type when it is
// instantiated; both spellings of the owner must reach the same template.
![test]
function generic_owner_inside_generic_body() -> Result<(), error::TestError> {
    const s: Deque::Slot<i64> = Deque::boxed(11);
    return assert::expect_eq(s.item, 11);
}
