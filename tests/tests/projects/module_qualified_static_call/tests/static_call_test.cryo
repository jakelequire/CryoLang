![config(testing)]
namespace ModQualStatic::Tests::StaticCall;

import ModQualStatic::Widget::Deque;
import std::core::result;
import std::test::error;
import std::test::assert;

// The only signature that ever resolved: the owner is recoverable from the
// call's own return type. It is the CONTROL - if the fix regressed to keying
// on the return type again, this one would keep passing while the rest failed.
![test]
function static_returning_its_own_type() -> Result<(), TestError> {
    mut g: Deque::Gadget = Deque::Gadget::make(5);
    return expect_eq(g.a, 5);
}

// A void static: there is no return type to recover an owner from, so this
// call failed at codegen with E0636.
![test]
function static_returning_void() -> Result<(), TestError> {
    Deque::Gadget::touch(1);
    return Result::Ok(());
}

![test]
function static_returning_a_primitive() -> Result<(), TestError> {
    mut g: Deque::Gadget = Deque::Gadget::make(11);
    return expect_eq(Deque::Gadget::peek(&g), 11);
}

![test]
function static_taking_no_arguments() -> Result<(), TestError> {
    return expect_eq(Deque::Gadget::count(), 3);
}

// A static returning a DIFFERENT type from the same module. Keying the owner
// on the return type looked for `Other::other`, which does not exist.
![test]
function static_returning_a_different_type() -> Result<(), TestError> {
    const o: Deque::Other = Deque::Gadget::other();
    return expect_eq(o.z, 7);
}

![test]
function static_returning_a_pointer() -> Result<(), TestError> {
    const p: Deque::Gadget* = Deque::Gadget::mkptr();
    return expect_true(p == null, "mkptr returns null");
}
