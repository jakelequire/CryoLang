# module_qualified_static_call - a static method reached through its MODULE.
#
# `Deque::Gadget::peek(&g)` names a module, a type declared in it, and that
# type's static. The owner segment is a PATH, and the import-scoped index that
# folds an owner to its declaration is keyed by leaf, so the written spelling
# survived to codegen as the callee key and matched nothing. The call was then
# rebuilt from the call's RETURN type, which is why a static returning its own
# enclosing type resolved and every other signature failed at codegen.
#
# The return types below are the axis, not incidental variety: void, a
# primitive, a pointer, and a different struct are each present, because
# holding the call shape constant and varying only the return type is what
# separated "the module qualifier is lost" from "the owner is guessed from the
# result".
#
# A project rather than a lang test because the shape needs the type to live in
# a module the caller reaches by name.

[project]
project_name = "module_qualified_static_call"
output_dir   = "build"
target_type  = "executable"
source_dir   = "src"
entry_point  = "src/main.cryo"

