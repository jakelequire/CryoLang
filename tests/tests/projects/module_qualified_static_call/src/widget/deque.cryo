namespace ModQualStatic::Widget::Deque;

/// A second type in the same module, so a static can return something that is
/// neither its owner nor a primitive.
type struct Other {
    z: i64;
}

type struct Gadget {
    a: i64;
    b: i64;

    static make(n: i64) -> Gadget { return Gadget { a: n, b: n }; }
    static touch(n: i64) -> void { }
    static peek(g: Gadget*) -> i64 { return g.a; }
    static count() -> i64 { return 3; }
    static other() -> Other { return Other { z: 7 }; }
    static mkptr() -> Gadget* { return null; }
}

/// A GENERIC type in the same module.  Its statics are reached through the
/// module with the owner's arguments written at the call site
/// (`Deque::Slot<i64>::make`), which is the shape that keyed a specialization
/// on the spelling: the module qualifier made the written owner differ from
/// the bare leaf the specializer registers under.
type struct Slot<T> {
    item: T;

    static make(v: T) -> Slot<T> { return Slot<T> { item: v }; }
    static touch() -> void { }
    static capacity() -> i64 { return 4; }
    static other() -> Other { return Other { z: 9 }; }
    static tag<U>(u: U, t: T) -> T { return t; }
}

/// A generic BODY naming the owner through the module, the way a container's
/// implementation names a helper type it does not declare.
function boxed<T>(v: T) -> Slot<T> {
    return Slot<T>::make(v);
}

/// A trait declared here, so a bound elsewhere has to name it THROUGH the
/// module: `where X: Deque::Measured`.
type trait Measured {
    size(&this) -> i64;
}

implement trait Measured for struct Gadget {
    size(&this) -> i64 { return this.a + this.b; }
}
