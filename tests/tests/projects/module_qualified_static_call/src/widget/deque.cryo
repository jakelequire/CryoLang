namespace ModQualStatic::Widget::Deque;

/// A second type in the same module, so a static can return something that is
/// neither its owner nor a primitive.
type struct Other {
    z: i64;
}

type struct Gadget {
    a: i64;
    b: i64;

    static make(n: i64) -> Gadget { return Gadget { a: n, b: n }; }
    static touch(n: i64) -> void { }
    static peek(g: Gadget*) -> i64 { return g.a; }
    static count() -> i64 { return 3; }
    static other() -> Other { return Other { z: 7 }; }
    static mkptr() -> Gadget* { return null; }
}
