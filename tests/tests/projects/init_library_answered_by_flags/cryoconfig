# init_library_answered_by_flags - `cryo init` given every answer as a
# flag reads nothing from the terminal and writes what the flags say.  The
# steps scaffold a library (`tally-lib`, sources in `code/`) and an
# executable under build/, and build both; this program then depends on the
# library, requiring the version `cryo init`
# wrote, and calls the function its `lib.cryo` declares, by the namespace
# derived from the project name.
[project]
project_name = "init_library_answered_by_flags"
output_dir   = "build"
target_type  = "executable"
source_dir   = "src"
entry_point  = "src/main.cryo"

[compiler]

[dependencies]
tally = { path = "build/tally", version = "0.1" }
