namespace AsyncOverloads;
import std::future::ready::{ PendingThenReady };
import std::future::traits::{ Future };
import std::future::poll::{ Poll };
import std::future::waker::{ Context, Waker };

// Each `async` overload is called with an argument only it takes exactly;
// the other overload's parameter is wide enough to take it too, so a call
// bound to the wrong body still compiles and answers that body's value.

type struct S {
    base: i64;
}

implement struct S {
    async get(&this, n: i32) -> i64 {
        const v: i64 = await PendingThenReady::<i64>::new(1, this.base);
        return v + (n as i64);
    }
    async get(&this, n: i64) -> i64 {
        const v: i64 = await PendingThenReady::<i64>::new(1, this.base);
        return v * 1000 + n;
    }
}

type trait Conv<X> {
    async conv(&this, n: X) -> i64;
}

type struct T {
    base: i64;
}

implement trait Conv<i32> for T {
    async conv(&this, n: i32) -> i64 {
        const v: i64 = await PendingThenReady::<i64>::new(1, this.base);
        return v + (n as i64);
    }
}

implement trait Conv<i64> for T {
    async conv(&this, n: i64) -> i64 {
        const v: i64 = await PendingThenReady::<i64>::new(1, this.base);
        return v * 1000 + n;
    }
}

async function get(n: i32) -> i64 {
    const v: i64 = await PendingThenReady::<i64>::new(1, 4);
    return v + (n as i64);
}

async function get(n: i64) -> i64 {
    const v: i64 = await PendingThenReady::<i64>::new(1, 4);
    return v * 1000 + n;
}

function drive<F, R>(fut: F) -> R
where F: Future<R> {
    mut f:  F       = fut;
    mut cx: Context = Context::new(Waker::noop());
    loop {
        match (f.poll(&cx)) {
            Poll::Ready(v) => { return v; }
            Poll::Pending  => { }
        }
    }
}

function main() -> i32 {
    const s: S = S { base: 4 };
    if (drive(s.get(3 as i32)) != 7) { return 1; }
    if (drive(s.get(5 as i64)) != 4005) { return 2; }

    const t: T = T { base: 4 };
    if (drive(t.conv(3 as i32)) != 7) { return 3; }
    if (drive(t.conv(5 as i64)) != 4005) { return 4; }

    if (drive(get(3 as i32)) != 7) { return 5; }
    if (drive(get(5 as i64)) != 4005) { return 6; }
    return 0;
}
