# generic_operator_needs_bound - must FAIL to compile (outcome =
# "compile_fail").  An operator on a type parameter is licensed by the
# parameter's bounds alone and refused on the generic body otherwise: a
# binary operator, a compound assignment and a unary operator on an unbounded
# `T`, and `+` on a `T` bounded only by `Ord`, are each E0229, while `<` under
# `Ord` is accepted.

[project]
project_name = "generic_operator_needs_bound"
output_dir   = "build"
target_type  = "executable"
source_dir   = "src"
entry_point  = "src/main.cryo"

[compiler]

