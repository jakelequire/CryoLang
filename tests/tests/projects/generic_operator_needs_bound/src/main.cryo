namespace GenericOperatorNeedsBound::Main;

import std::core::cmp;

// An operator on a type parameter is licensed by the parameter's bounds
// alone, and refused on the generic body when they do not give it the
// operator's trait - whatever an instantiation would have supplied.

// No bound at all: `+` on `T`.
function sum<T>(a: T, b: T) -> T {
    return a + b;
}

// A compound assignment is the same operator.
function bump<T>(a: T, b: T) -> T {
    mut x: T = a;
    x += b;
    return x;
}

// A unary operator.
function negate<T>(a: T) -> T {
    return -a;
}

// A bound that gives `T` another trait: `Ord` orders, it does not add.
function sum_ordered<T>(a: T, b: T) -> T where T: cmp::Ord {
    return a + b;
}

// Licensed: `Ord` gives `<`.
function smaller<T>(a: T, b: T) -> T where T: cmp::Ord {
    if (a < b) { return a; }
    return b;
}

function main() -> i32 {
    return sum(1, 2) + bump(3, 4) + negate(5) + sum_ordered(6, 7) + smaller(8, 9);
}
