///! A generic struct's static method with a type parameter of its own
///! (`Viewer<K, V>::over<W>`), called through the bare owner from a generic
///! body with every type argument inferred: the argument names the owner's
///! parameters beside the method's (`&Holder<K, V, W>`), and the body passes
///! its own (`&Holder<T, i64, A>`). A project rather than a unit file: a
///! compiler that leaves the method's parameter unbound stops at code
///! generation, and a unit file it refuses would stop its whole unit build.

![config(testing)]
namespace CryoTests::Tests::GenericStaticOwnParameterInGenericBody;

import std::core::result::{ Result };
import std::test::error::{ TestError };
import std::test::assert::{ expect_eq };

type struct Holder<T, U, A> {
    value: T;
    other: U;
    tag: A;
}

type struct Viewer<K, V> {
    first: K;
    second: V;

    static over<W>(holder: &Holder<K, V, W>) -> Viewer<K, V> {
        return Viewer::<K, V> { first: holder.value, second: holder.other };
    }
}

type struct Outer<T, A> {
    holder: Holder<T, i64, A>;

    view(&this) -> Viewer<T, i64> {
        return Viewer::over(&this.holder);
    }
}

![test]
function owner_and_own_arguments_inferred_in_a_generic_body() -> Result<(), TestError> {
    const narrow: Outer<i32, u8> = Outer::<i32, u8> { holder: Holder::<i32, i64, u8> { value: 7, other: 8, tag: 1 } };
    const narrow_view: Viewer<i32, i64> = narrow.view();
    expect_eq(narrow_view.first, 7)?;
    expect_eq(narrow_view.second, 8)?;
    const wide: Outer<u64, boolean> = Outer::<u64, boolean> { holder: Holder::<u64, i64, boolean> { value: 9, other: 10, tag: true } };
    const wide_view: Viewer<u64, i64> = wide.view();
    expect_eq(wide_view.first, 9)?;
    return expect_eq(wide_view.second, 10);
}
