# where_bound_leaf_collision - two impls whose where-bounds name same-leaf
# traits from different modules.
#
# `coherence_key_for` renders an impl head to a string and rejects a second
# impl that renders identically. The bound half of that string used to be
# built by truncating the trait reference to its leaf and searching the
# program to recover a qualified name, and such a search declines as soon as
# any unrelated declaration shares the leaf. Two distinct traits then folded
# to one name, so these two impls - which differ ONLY in which module their
# bound comes from - rendered identically and the second was rejected with a
# spurious E0308.
#
# Writing the bounds fully qualified does not avoid it: the qualifier was
# discarded before the search, so the spelling never reached the key.
#
# The build IS the assertion. E0308_conflicting_trait_impl.cryo covers the
# opposite direction, so a fix that simply stopped keying bounds would fail
# there rather than here.

[project]
project_name = "where_bound_leaf_collision"
output_dir   = "build"
target_type  = "executable"
source_dir   = "src"
entry_point  = "src/main.cryo"

[compiler]

