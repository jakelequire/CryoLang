# where_bound_leaf_collision - two impls whose where-bounds name same-leaf
# traits from different modules.
#
# Two heads that differ only in their where-bounds OVERLAP: a bound narrows
# which types a head is for but nothing can prove two bounds disjoint, so a
# type satisfying both would select both, and the later head is refused where
# it is declared (Rust's rule).  That is the assertion here: E0308 at the
# SECOND head, with the overlap wording.
#
# The leaf collision is the second half.  `coherence_key_for` renders an impl
# head to a string and rejects a second impl that renders IDENTICALLY, with
# the "at most once per type" wording; its bound half was once built by
# truncating the trait reference to its leaf and searching the program for a
# qualified name, a search that declined as soon as any unrelated declaration
# shared the leaf, so these two bounds folded to one name and the pair was
# refused as a DUPLICATE.  The two traits are distinct declarations and the
# pair is refused as an OVERLAP; the excluded wording is what keeps that
# apart.  E0308_conflicting_trait_impl.cryo covers the identical pair.
#
# `emit` is never called: the report belongs at the declaration, not at a
# use, and a use-site report would blame the wrong code.

[project]
project_name = "where_bound_leaf_collision"
output_dir   = "build"
target_type  = "executable"
source_dir   = "src"
entry_point  = "src/main.cryo"

