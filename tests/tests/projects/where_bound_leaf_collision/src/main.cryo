namespace WhereBoundLeafCollision::Main;

import WhereBoundLeafCollision::Alpha;
import WhereBoundLeafCollision::Omega;

type struct Holder<T> { v: T; }

type trait Emit { emit(&this) -> int; }

/// One trait, one target, two impls that differ only in the MODULE their
/// where-bound trait comes from.  The two bounds are distinct traits (the
/// leaf collision does not fold them into one head), and the pair is still
/// refused: two heads told apart only by their bounds overlap, and the
/// second is E0308 where it is declared.
implement<T> trait Emit for struct Holder<T> where T: WhereBoundLeafCollision::Alpha::Render {
    emit(&this) -> int { return 1; }
}

implement<T> trait Emit for struct Holder<T> where T: WhereBoundLeafCollision::Omega::Render {
    emit(&this) -> int { return 2; }
}

function main() -> int { return 0; }
