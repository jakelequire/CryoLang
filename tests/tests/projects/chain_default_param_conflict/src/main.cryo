namespace ChainDefaultConflict::Main;

import std::core::iter;
import std::core::iter::{ Iterator, ChainIter, TakeIter };
import std::core::ops;
import std::core::ops::{ Range };
import std::core::option;
import std::core::option::{ Option };

function main() -> i32 {
    mut a: Range<i32> = Range::new(0, 3);      // 0,1,2
    mut b: Range<i32> = Range::new(10, 12);    // 10,11
    mut r: Range<i32> = Range::new(0, 9);
    mut c: TakeIter<Range<i32>> = r.take(2);   // 0,1 - a J the impl's J is not
    mut sum: i32 = 0;
    for (x in a.chain(b).chain(c)) { sum = sum + x; }
    return sum;                                // 25: the method's `J` and the impl's are two types
}
