# chain_default_param_conflict - the sibling of `chain_default_same_param`
# with `c` of a type the impl's `J` is NOT bound to: the method's `J` is
# `TakeIter<Range<i32>>` and the impl's is `Range<i32>`.  The arena keys a
# generic parameter by its SPELLING alone (`TypeArena::create_generic_param`
# caches by the name), so the two `J`s are one arena type with two answers,
# and a substitution asked for it answers nothing rather than whichever was
# added first - which rebuilt `This` as `ChainIter<Range, TakeIter>` and ran
# the chain over garbage (it yielded nothing).  The call is REFUSED where its
# specialization is missed until the arena tells the two parameters apart
# by symbol; when it does, this project becomes a run project exiting 25.
[project]
project_name = "chain_default_param_conflict"
output_dir   = "build"
target_type  = "executable"
source_dir   = "src"
entry_point  = "src/main.cryo"
[compiler]
[dependencies]
