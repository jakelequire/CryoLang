/// A generic caller whose parameter is spelled unlike the callee owner's: the
/// awaited future is typed with the caller's `X`, substituted for `Holder`'s
/// `S` through the receiver `Holder<X>`.  Left as `S`, it names a parameter
/// `run` does not have, and the async lowering cannot spell the future's
/// frame field (E0600).
namespace GenericCallerReceiverArgs::Main;

import std::future;

type trait Tick {
    tick(&this) -> i64;
}

type struct Num {
    v: i64;
}

implement trait Tick for struct Num {
    tick(&this) -> i64 { return this.v; }
}

type struct Holder<S> {
    inner: S;
}

implement<S> trait Tick for struct Holder<S> where S: Tick {
    tick(&this) -> i64 { return this.inner.tick(); }
}

type trait Drain {
    async drain(mut &this) -> i64;
}

implement<S> trait Drain for struct Holder<S> where S: Tick {
    async drain(mut &this) -> i64 { return this.inner.tick(); }
}

async function run<X>(x: X) -> i64 where X: Tick {
    mut h: Holder<X> = Holder::<X> { inner: x };
    const a: i64 = await h.drain();
    return a;
}

function main() -> int {
    return future::block_on(run::<Num>(Num { v: 42 })) as int;
}
