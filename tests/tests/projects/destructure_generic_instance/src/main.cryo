namespace DestructureGenericInstance::Main;

type struct Cell<T> {
    hidden: T;
    shown: T;
}

type struct Pair<A, B> {
    first: A;
    second: B;
}

function make_pair(a: u8, b: i64) -> Pair<u8, i64> {
    return Pair::<u8, i64> { first: a, second: b };
}

function main() -> int {
    // An instantiation outside any generic body, named only by the
    // destructure and its initializer.
    const { hidden: h, shown: s }: Cell<i32> = Cell::<i32> { hidden: 8, shown: 9 };
    if (h + s != 17) { return 1; }

    // Each field typed through the instance's own arguments.
    mut { first: a, second: b }: Pair<u8, i64> = make_pair(3, 5000000000);
    a = a + 1;
    if (a != 4) { return 2; }
    if (b != 5000000000) { return 3; }

    // The same instance again, already minted by the first destructure.
    const { shown: s2, hidden: h2 }: Cell<i32> = Cell::<i32> { hidden: 1, shown: 2 };
    if (h2 != 1 || s2 != 2) { return 4; }
    return 0;
}
