/// What the demangler prints for a symbol the compiler emitted.  Each input
/// is a symbol as it appears in an object file, mangled from:
///
///     type struct Node { v: i64; }
///     function dynamic(xs: [i64]) -> i64
///     function fixed(xs: [u8; 4]) -> i64
///     function nested(g: [[u64; 2]; 3]) -> i64
///     function of_pointers(xs: &[Node*]) -> i64
///     function of_dynamic(xs: [[i64]]) -> i64
///     function pointer_to(p: [i64]*) -> i64
///     function returns() -> [i32; 2]
///
/// in namespace `Mang::Main`.  A fixed array's length is part of the symbol,
/// and the outer array's comes first in it, so a demangler that printed the
/// lengths in the order it read them would print `nested`'s type inside
/// out.  A dynamic `[T]` is the `Array<T>` instance with the default
/// allocator, and is printed as the instance its symbol names.
///
/// The table a `virtual &Shape` over a `Circle` names is printed with the
/// trait and the type, and with the trait's arguments when it takes any:
///
///     type trait Shape { ... }        implement trait Shape for Circle
///     type trait Conv<T> { ... }      implement trait Conv<i64> for Circle
///
/// A generic instance named as an implementing type arrives with two length
/// prefixes run together - `35` for the whole instance and `5` for `Array`
/// reads as `535` - and is printed as the instance.
namespace main;

import std::fmt;
import compiler::resolver::demangler::{ Demangler };

mut g_passed: i32 = 0;
mut g_total: i32 = 0;

function check(symbol: string, want: string) -> void {
    g_total = g_total + 1;
    const got: string = Demangler::demangle(symbol);
    if (got == want) {
        g_passed = g_passed + 1;
        return;
    }
    fmt::printf("FAIL %s\n  got:  [%s]\n  want: [%s]\n", symbol, got, want);
}

function main(argc: int, argv: string*) -> int {
    check("C$4Mang.4Main.7dynamic$FN$L3std.11collections.5array.5Array$Ll_N$L3std.5alloc.9allocator.11GlobalAlloc$G$G$G$Rl",
          "Mang::Main::dynamic(std::collections::array::Array<i64, std::alloc::allocator::GlobalAlloc>) -> i64");
    check("C$4Mang.4Main.5fixed$FA$L4$Gh$Rl",
          "Mang::Main::fixed([u8; 4]) -> i64");
    check("C$4Mang.4Main.6nested$FA$L3$GA$L2$Gm$Rl",
          "Mang::Main::nested([[u64; 2]; 3]) -> i64");
    check("C$4Mang.4Main.11of_pointers$FRN$L3std.11collections.5array.5Array$LPN$L4Mang.4Main.4Node$G_N$L3std.5alloc.9allocator.11GlobalAlloc$G$G$G$Rl",
          "Mang::Main::of_pointers(&std::collections::array::Array<Mang::Main::Node*, std::alloc::allocator::GlobalAlloc>) -> i64");
    check("C$4Mang.4Main.10of_dynamic$FN$L3std.11collections.5array.5Array$LN$L3std.11collections.5array.5Array$Ll_N$L3std.5alloc.9allocator.11GlobalAlloc$G$G$G_N$L3std.5alloc.9allocator.11GlobalAlloc$G$G$G$Rl",
          "Mang::Main::of_dynamic(std::collections::array::Array<std::collections::array::Array<i64, std::alloc::allocator::GlobalAlloc>, std::alloc::allocator::GlobalAlloc>) -> i64");
    check("C$4Mang.4Main.10pointer_to$FPN$L3std.11collections.5array.5Array$Ll_N$L3std.5alloc.9allocator.11GlobalAlloc$G$G$G$Rl",
          "Mang::Main::pointer_to(std::collections::array::Array<i64, std::alloc::allocator::GlobalAlloc>*) -> i64");
    check("C$4Mang.4Main.7returns$Fv$RA$L2$Gi",
          "Mang::Main::returns() -> [int; 2]");
    check("C$vt$4Mang.4Main.5Shape$f4Mang.4Main.6Circle",
          "<vtable for Mang::Main::Shape for Mang::Main::Circle>");
    check("C$vt$4Mang.4Main.4Conv$Ll$G$f4Mang.4Main.6Circle",
          "<vtable for Mang::Main::Conv<i64> for Mang::Main::Circle>");
    check("C$vt$3std.3fmt.5write.8FmtWrite$f3std.11collections.5array.535Array$Lh_N$L3std.5alloc.9allocator.11GlobalAlloc$G$G",
          "<vtable for std::fmt::write::FmtWrite for std::collections::array::Array<u8, std::alloc::allocator::GlobalAlloc>>");
    check("C$tr$3std.3fmt.5write.8FmtWrite$f3std.11collections.5array.535Array$Lh_N$L3std.5alloc.9allocator.11GlobalAlloc$G$G-10write_char$F$m_c$RN$L3std.4core.6result.6Result$Lu_N$L3std.3fmt.5error.8FmtError$G$G$G",
          "<std::fmt::write::FmtWrite for std::collections::array::Array<u8, std::alloc::allocator::GlobalAlloc>>.write_char(mut &this, char) -> std::core::result::Result<(), std::fmt::error::FmtError>");
    check("printf", "printf (unmangled)");
    check("C$4Mang.4Main.7dynamic$FA", "C$4Mang.4Main.7dynamic$FA (malformed)");
    check("C$4Mang.4Main.7dynamic$FAl$Rl", "C$4Mang.4Main.7dynamic$FAl$Rl (malformed)");
    fmt::printf("demangler checks: %d of %d passed\n", g_passed, g_total);
    if (g_passed != g_total) { return 1; }
    return 0;
}
