/// What the demangler prints for a symbol the compiler emitted.  Each input
/// is a symbol as it appears in an object file, mangled from:
///
///     type struct Node { v: i64; }
///     function dynamic(xs: [i64]) -> i64
///     function fixed(xs: [u8; 4]) -> i64
///     function nested(g: [[u64; 2]; 3]) -> i64
///     function of_pointers(xs: &[Node*]) -> i64
///     function of_dynamic(xs: [[i64]]) -> i64
///     function pointer_to(p: [i64]*) -> i64
///     function returns() -> [i32; 2]
///
/// in namespace `Mang::Main`.  A fixed array's length is part of the symbol,
/// and the outer array's comes first in it, so a demangler that printed the
/// lengths in the order it read them would print `nested`'s type inside
/// out.
namespace main;

import std::fmt;
import compiler::resolver::demangler;
import compiler::resolver::demangler::{ Demangler };

mut g_passed: i32 = 0;
mut g_total: i32 = 0;

function check(symbol: string, want: string) -> void {
    g_total = g_total + 1;
    const got: string = Demangler::demangle(symbol);
    if (got == want) {
        g_passed = g_passed + 1;
        return;
    }
    fmt::printf("FAIL %s\n  got:  [%s]\n  want: [%s]\n", symbol, got, want);
}

function main(argc: int, argv: string*) -> int {
    check("C$4Mang.4Main.7dynamic$FAl$Rl",
          "Mang::Main::dynamic([i64]) -> i64");
    check("C$4Mang.4Main.5fixed$FA$L4$Gh$Rl",
          "Mang::Main::fixed([u8; 4]) -> i64");
    check("C$4Mang.4Main.6nested$FA$L3$GA$L2$Gm$Rl",
          "Mang::Main::nested([[u64; 2]; 3]) -> i64");
    check("C$4Mang.4Main.11of_pointers$FRAPN$L4Mang.4Main.4Node$G$Rl",
          "Mang::Main::of_pointers(&[Mang::Main::Node*]) -> i64");
    check("C$4Mang.4Main.10of_dynamic$FAAl$Rl",
          "Mang::Main::of_dynamic([[i64]]) -> i64");
    check("C$4Mang.4Main.10pointer_to$FPAl$Rl",
          "Mang::Main::pointer_to([i64]*) -> i64");
    check("C$4Mang.4Main.7returns$Fv$RA$L2$Gi",
          "Mang::Main::returns() -> [int; 2]");
    check("printf", "printf (unmangled)");
    check("C$4Mang.4Main.7dynamic$FA", "C$4Mang.4Main.7dynamic$FA (malformed)");
    fmt::printf("demangler checks: %d of %d passed\n", g_passed, g_total);
    if (g_passed != g_total) { return 1; }
    return 0;
}
