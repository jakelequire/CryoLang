# demangler_output - the text `cryo demangle` prints for a symbol: array types in brackets, `[T]` and `[T; N]` with nested lengths outside-in, references and pointers where they bound, and the markers for a symbol that is not mangled or does not decode.
[project]
project_name = "demangler_output"
output_dir   = "build"
target_type  = "executable"
source_dir   = "src"
entry_point  = "src/main.cryo"
[compiler]
[dependencies]
compiler = { path = "../../../../compiler", alias = "Compiler" }
