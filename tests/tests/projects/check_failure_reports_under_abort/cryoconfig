# check_failure_reports_under_abort - a failed bounds check in a program built
# with the abort strategy writes the panic report, with the index and the
# length, and exits 101, as every other panic does.

[project]
project_name = "check_failure_reports_under_abort"
output_dir   = "build"
target_type  = "executable"
source_dir   = "src"
entry_point  = "src/main.cryo"

[compiler]
panic = "abort"

[dependencies]
