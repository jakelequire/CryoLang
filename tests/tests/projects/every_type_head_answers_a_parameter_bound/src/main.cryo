/// An implementation for every type with no `where` clause gives its trait
/// to every type, so it answers a bound on a generic body's own type
/// parameter: every copy of the body has the trait, whatever it binds the
/// parameter to.  Checked for a free function's bound at the trait's
/// arguments, a method's bound on its owner's parameter at the method's
/// own type argument, and a method's bound with no arguments.  The exit
/// code names the first check that failed.
namespace EveryTypeHeadAnswersAParameterBound::Main;

import std::fmt;

public type trait Make<U> {
    static make(value: U) -> This;
}

implement<T> trait Make<T> for T {
    static make(value: T) -> T { return value; }
}

public type trait Tagged {
    static tag() -> i64;
}

implement<T> trait Tagged for T {
    static tag() -> i64 { return 7; }
}

function needs_make<A, B>(value: B) -> A where A: Make<B> {
    return A::make(value);
}

function through_param<T>(value: T) -> T {
    return needs_make::<T, T>(value);
}

type struct Holder<T> {
    value: T;

    pass_through<Q>(&this, given: Q) -> T where T: Make<Q> {
        return T::make(given);
    }

    tag_of(&this) -> i64 where T: Tagged {
        return T::tag();
    }
}

function from_holder<T>(holder: &Holder<T>, given: T) -> T {
    return holder.pass_through(given);
}

function tag_through<T>(holder: &Holder<T>) -> i64 {
    return holder.tag_of();
}

function main() -> i32 {
    if (through_param(41) != 41) { return 1; }
    const holder: Holder<i64> = Holder { value: 3 };
    if (from_holder(&holder, 12) != 12) { return 2; }
    if (tag_through(&holder) != 7) { return 3; }
    fmt::println("every-type head: all checks passed");
    return 0;
}
