namespace LambdaCallsCapturedCallable;

import std::core::cmp::{ Ordering, Ord };

// A lambda calls a callable it captures: a closure local of the enclosing
// body, and a parameter whose callable bound lets the body call it.  A
// parameter that is a reference to such a callable is called through it.

function captured_closure_local(k: i32) -> i32 {
    const peek = () -> i32 { return k; };
    const wrapped = () -> i32 { return peek() + 1; };
    return wrapped();
}

function count_rising<F>(values: &[i64], key: F) -> i64 where F: (&i64) -> i64 {
    const rises = (a: &i64, b: &i64) -> boolean { return key(a) < key(b); };
    mut n: i64 = 0;
    for (mut i: i64 = 1; i < values.length(); i++) {
        if (rises(&values[i - 1], &values[i])) { n += 1; }
    }
    return n;
}

function order_through<F>(compare: &F, x: &i64, y: &i64) -> Ordering where F: (&i64, &i64) -> Ordering {
    return compare(x, y);
}

function main() -> i32 {
    if (captured_closure_local(9) != 10) { return 1; }

    const values: [i64] = [3, 1, 4, 1, 5];
    // By value 3,1,4,1,5 rises twice; negated it rises twice the other way.
    if (count_rising(&values, (v: &i64) -> i64 { return *v; }) != 2) { return 2; }
    const flip: i64 = 0 - 1;
    if (count_rising(&values, (v: &i64) -> i64 { return *v * flip; }) != 2) { return 3; }
    const offset: i64 = 10;
    const shifted = (v: &i64) -> i64 { return *v + offset; };
    if (count_rising(&values, shifted) != 2) { return 4; }

    const one: i64 = 1;
    const two: i64 = 2;
    const ascending = (a: &i64, b: &i64) -> Ordering { return a.compare(b); };
    if (order_through(&ascending, &one, &two) != Ordering::Less) { return 5; }
    if (order_through(&ascending, &two, &one) != Ordering::Greater) { return 6; }
    const sign: i64 = 0 - 1;
    const descending = (a: &i64, b: &i64) -> Ordering { return (*a * sign).compare(&(*b * sign)); };
    if (order_through(&descending, &one, &two) != Ordering::Greater) { return 7; }
    return 0;
}
