# module_suffix_tie_rejects_mismatch - two modules end in `::Text`; this file
# imports `Beta::Text`, whose `tag` takes a `String`, and passes an `i32`.
# The argument check is keyed by the module the segment's stamp names, so
# the mismatch is E0214 at the argument.  A check keyed by the written
# spelling matched the suffix against every module, found two, and checked
# nothing: the program compiled and its binary died of heap corruption.
[project]
project_name = "module_suffix_tie_rejects_mismatch"
output_dir   = "build"
target_type  = "executable"
source_dir   = "src"
entry_point  = "src/main.cryo"
