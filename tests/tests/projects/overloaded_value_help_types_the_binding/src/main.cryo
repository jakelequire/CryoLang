// An overloaded function taken as a value with nothing to select an overload
// is refused (E0154), and the help line shows the fix: the binding the value
// initializes, typed with one overload's signature.  A value that is not a
// declaration's whole initializer - an argument here - has no binding of its
// own, and the help writes a placeholder name.
namespace Main;

type struct Conv {
    k: i32;
    static conv(x: i32) -> i32 { return x + 1; }
    static conv(x: f64) -> f64 { return x * 2.0; }
}

function twice(x: i32) -> i32 { return x * 2; }
function twice(x: i64) -> i64 { return x * 3; }

function keep<T>(v: T) -> T { return v; }

function main() -> i32 {
    const doubler = twice;
    const step = Conv::conv;
    const kept = keep(twice);
    return 0;
}
