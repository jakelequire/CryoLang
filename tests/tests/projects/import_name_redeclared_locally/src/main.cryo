/// A declaration named like an explicit import, or like a module alias, in
/// the same namespace is a redeclaration; one in the other namespace is not.
namespace main;

import shapes::{ Tag, Mark };
import json as Loc;
import json::{ one };

type struct Tag { v: i32; }
type struct Loc { v: i32; }
function one() -> i32 { return 1; }
function Mark() -> i32 { return 2; }

function main() -> i32 {
    const t: Tag = Tag { v: 3 };
    return t.v + Mark();
}
