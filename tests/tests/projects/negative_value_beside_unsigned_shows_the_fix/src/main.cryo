// A negative number beside an unsigned operand is refused with help that
// writes the operation the program can mean, in the compound form for a
// compound assignment and as an expression for a binary operator.
namespace NegativeValueBesideUnsignedShowsTheFix::Main;

type struct Counter { count: u32; }

function refused(start: u8, wide: u64, word: u32, big: u128) -> u64 {
    mut b: u8 = start;
    b += -1;
    b -= -2;
    b *= -1;
    b /= -2;
    b &= -1;
    b <<= -3;
    b >>= -1;
    mut c: Counter = Counter { count: word };
    c.count += -(1 + 2);
    mut h: u128 = big;
    h %= -3;
    const sum: u32 = word + -1;
    const difference: i64 = -2 - word;
    const masked: u32 = word | (0 - 4);
    const quotient: u32 = word / -2;
    const product: u64 = wide * -1;
    return wide;
}

function main() -> i32 {
    refused(1, 1, 1, 1);
    return 0;
}
