/// `catch_unwind` runs closures that capture the caller's locals without
/// `move`: one returns a value computed from its captures, one panics with a
/// message built from them. Prints one line per case; exits 0 only when both
/// came back as expected.
namespace CatchUnwindTakesACapturingClosure::Main;

import std::fmt;
import std::core::intrinsics;
import std::core::panic_unwind::{ catch_unwind, PanicInfo };
import std::core::result::{ Result };

function main() -> int {
    const limit: i64 = 21;
    const scale: i64 = 2;
    const returned: Result<i64, PanicInfo> = catch_unwind(() -> i64 { return limit * scale; });
    const value: i64 = match (returned) {
        Result::Ok(v)  => { v }
        Result::Err(e) => { -1 }
    };
    fmt::println(f"the closure returned {value}");

    const threshold: i64 = 3;
    const panicked: Result<i64, PanicInfo> = catch_unwind(() -> i64 {
        if (limit > threshold) {
            intrinsics::panic("the closure saw a limit above its threshold", intrinsics::location());
        }
        return limit;
    });
    const caught: boolean = match (panicked) {
        Result::Ok(v)  => { false }
        Result::Err(info) => {
            fmt::println(f"caught: {info.msg}");
            true
        }
    };
    if (value != 42 || !caught) { return 1; }
    return 0;
}
