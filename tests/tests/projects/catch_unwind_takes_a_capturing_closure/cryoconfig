# catch_unwind_takes_a_capturing_closure - under the unwinding strategy,
# `catch_unwind` runs a closure that borrows the caller's locals, both when it
# returns and when it panics.

[project]
project_name = "catch_unwind_takes_a_capturing_closure"
output_dir   = "build"
target_type  = "executable"
source_dir   = "src"
entry_point  = "src/main.cryo"

[compiler]
panic = "unwind"

[dependencies]
