// A constant expression that overflows, or a constant remainder whose
// division overflows, is refused with help that writes the computation the
// program can mean: in a type that holds the value, and with the wrapping
// method where one wraps the operation.
namespace ConstantOverflowShowsTheFix::Main;

const SMALL: u8 = 200;
const SUM: u8 = SMALL + 100;
const NEGATED: i32 = -i32::MIN;
const REMAINDER: i32 = i32::MIN % -1;
const NARROW_REMAINDER: i8 = i8::MIN % -1;
const WIDEST_REMAINDER: i128 = i128::MIN % -1;

function main() -> i32 {
    return 0;
}
