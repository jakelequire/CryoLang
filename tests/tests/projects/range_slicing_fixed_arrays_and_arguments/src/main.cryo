namespace RangeSlicingFixedArraysAndArguments;

import std::core::slice::{ Slice };
import std::collections::array::{ Array };

// A fixed array is viewed as a container is, through the slice over its
// elements: read, written, and through a reference to it.  A view passed
// where the parameter writes (`mut &Slice<T>`) is the writable view.  A
// generic body views a container written in its own parameters
// (`&Array<T>`, `&[T; 4]`, `&Slice<T>`), and writes through one.

function fill(xs: mut &Slice<i64>, value: i64) -> void {
    for (mut i: i64 = 0; i < xs.length(); i++) { xs[i] = value; }
}

function sum(xs: &Slice<i64>) -> i64 {
    mut total: i64 = 0;
    for (mut i: i64 = 0; i < xs.length(); i++) { total = total + xs[i]; }
    return total;
}

function middle<T>(xs: &Array<T>) -> &Slice<T> {
    return xs[1..xs.length() - 1];
}

function tail_of_fixed<T>(xs: &[T; 4]) -> &Slice<T> {
    return xs[1..];
}

function tail_of_slice<T>(xs: &Slice<T>) -> &Slice<T> {
    return xs[1..];
}

function set_second<T>(xs: mut &Array<T>, value: T) -> void where T: Copy {
    xs[1..][0] = value;
}

function zero_tail(xs: mut &[i64; 4]) -> void {
    fill(xs[2..], 0);
}

function read_tail(xs: &[i64; 4]) -> i64 {
    return sum(xs[2..]);
}

function main() -> i32 {
    mut fixed: [i64; 4] = [1, 2, 3, 4];
    if (sum(fixed[1..3]) != 5) { return 1; }
    fixed[1..][0] = 20;
    if (fixed[1] != 20) { return 2; }
    if (read_tail(&fixed) != 7) { return 3; }
    zero_tail(&fixed);
    if (fixed[2] != 0 || fixed[3] != 0 || fixed[0] != 1) { return 4; }
    if (sum(tail_of_fixed(&fixed)) != 20) { return 5; }
    mut xs: [i64] = [1, 2, 3, 4, 5];
    fill(xs[1..3], 9);
    if (xs[1] != 9 || xs[2] != 9 || xs[3] != 4) { return 6; }
    if (sum(middle(&xs)) != 22) { return 7; }
    if (sum(tail_of_slice(xs[..])) != 27) { return 8; }
    set_second(&xs, 40);
    if (xs[1] != 40) { return 9; }
    const constant: [i64; 3] = [5, 6, 7];
    if (sum(constant[..2]) != 11) { return 10; }
    const empty: [i64; 0] = [];
    if (empty[..].length() != 0) { return 11; }
    return 0;
}
