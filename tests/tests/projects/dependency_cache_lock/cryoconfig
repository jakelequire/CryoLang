# dependency_cache_lock - the lock the package cache and the compiler's own
# archives share.  A held lock is refused to another taker until it is
# released, a lock older than its expiry is cleared and taken, and threads
# contending for one lock never hold it at once.
[project]
project_name = "dependency_cache_lock"
output_dir   = "build"
target_type  = "executable"
source_dir   = "src"
entry_point  = "src/main.cryo"

[compiler]

[dependencies]
compiler = { path = "../../../../compiler" }
