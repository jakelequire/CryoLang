namespace MethodValueTakesReceiverFirst::Main;

type trait Beta { shift(&this, u: i32) -> i64; }

type struct IgTn { v: i32; }
implement struct IgTn {
    go(&this, u: i32) -> i64 { return (this.v + u) as i64; }
    bump(mut &this, by: i32) -> void { this.v = this.v + by; }
    take(this) -> i32 { return this.v * 3; }
}
implement trait Beta for IgTn { shift(&this, u: i32) -> i64 { return (this.v * u) as i64; } }

function main() -> i32 {
    mut ig: IgTn = IgTn { v: 5 };
    const f = IgTn::go;
    if (f(&ig, 7) != 12) { return 1; }
    const g: (&IgTn, i32) -> i64 = IgTn::go;
    if (g(&ig, 1) != 6) { return 2; }
    const b = IgTn::bump;
    b(&ig, 10);
    if (ig.v != 15) { return 3; }
    const s = IgTn::shift;
    if (s(&ig, 2) != 30) { return 4; }
    const q = (Beta for IgTn)::shift;
    if (q(&ig, 3) != 45) { return 5; }
    const t = IgTn::take;
    if (t(ig) != 45) { return 6; }
    return 0;
}
