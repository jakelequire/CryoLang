// `cryo interpret` binds a `match` arm's names by docs/cryo.md section 7.2:
// in a subject matched by value, a binding not written `mut` of a `Copy`
// payload is a copy taken when the arm is entered, so assigning the subject
// in the arm does not change it; a `mut` binding names the payload where it
// lies, so writing it writes the subject.  Nested patterns test the
// payload's own variant.

namespace Main;

import std::fmt;

type enum Inner {
    A(u32, u32);
    B;
}

type enum Outer {
    X(u32, Inner);
    Y(u32);
}

function describe(value: Outer) -> u32 {
    return match (value) {
        Outer::X(a, Inner::A(b, _)) => { a * 100 + b }
        Outer::X(a, _) => { a }
        Outer::Y(n) => { 1000 + n }
    };
}

function main() -> i32 {
    mut v: Outer = Outer::X(7, Inner::A(11, 13));
    mut kept: u32 = 0;
    match (v) {
        Outer::X(a, b) => {
            v = Outer::Y(1);
            kept = a + match (b) { Inner::A(x, y) => { x + y } Inner::B => { 0 } };
        }
        Outer::Y(_) => { }
    }
    match (v) {
        Outer::Y(mut n) => { n = 5; }
        Outer::X(_, _) => { }
    }
    const after: u32 = match (v) { Outer::Y(n) => { n } Outer::X(_, _) => { 0 } };
    fmt::println(f"bindings: {kept} {after} {describe(Outer::X(3, Inner::A(4, 9)))} {describe(Outer::X(6, Inner::B))} {describe(Outer::Y(8))}");
    return 0;
}
