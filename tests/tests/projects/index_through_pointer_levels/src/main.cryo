// index_through_pointer_levels - an element reached by indexing a pointer is
// as writable as that pointer's own level: `slots[i] = q` with
// `slots: mut (const u8*)*` stores a read-only pointer into a writable array of
// them, and `&slots[i]` borrows the slot for writing.  The level the
// elements point through does not decide it.
namespace Main;

import std::fmt;

function store(slots: mut (const u8*)*, index: i64, value: const u8*) -> void {
    slots[index] = value;
}

function rebind(slot: mut &(const u8*), value: const u8*) -> void {
    *slot = value;
}

function main() -> int {
    const first: u8 = 65;
    const second: u8 = 66;
    mut table: [const u8*; 2] = [null, null];
    const slots: mut (const u8*)* = &table[0] as mut (const u8*)*;
    store(slots, 0, &first);
    store(slots, 1, &first);
    rebind(&slots[1], &second);
    fmt::printf("index_through_pointer_levels: %c%c\n", *table[0] as i32, *table[1] as i32);
    return 0;
}
