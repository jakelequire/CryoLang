namespace HeadForEveryTypeMethodsAreCalled;

import std::fmt;

type trait Describe { describe(&this) -> i64; }
implement trait Describe for i64 { describe(&this) -> i64 { return *this; } }
implement trait Describe for i32 { describe(&this) -> i64 { return *this as i64; } }

type trait Twice { twice(&this) -> i64; }
implement<T> trait Twice for T where T: Describe {
    twice(&this) -> i64 { return this.describe() * 2; }
}

/// A type's own method outranks the head for every type.
type struct Inherent {
    value: i64;
    twice(&this) -> i64 { return 7; }
}
implement trait Describe for Inherent { describe(&this) -> i64 { return this.value; } }

function through_bound<T>(value: T) -> i64 where T: Twice {
    return value.twice();
}

function method_call() -> boolean {
    const x: i64 = 5;
    const y: i32 = 4;
    return x.twice() == 10 && y.twice() == 8;
}

function bound_call() -> boolean {
    const x: i64 = 6;
    return through_bound::<i64>(x) == 12;
}

function trait_path_call() -> boolean {
    const x: i64 = 5;
    return Twice::twice(&x) == 10;
}

function type_path_call() -> boolean {
    const x: i64 = 3;
    return i64::twice(&x) == 6;
}

function own_method_first() -> boolean {
    const inherent: Inherent = Inherent { value: 3 };
    return inherent.twice() == 7 && inherent.describe() == 3;
}

function main() -> i32 {
    mut passed: i32 = 0;
    if (method_call()) { passed += 1; } else { fmt::println("FAIL method_call"); }
    if (bound_call()) { passed += 1; } else { fmt::println("FAIL bound_call"); }
    if (trait_path_call()) { passed += 1; } else { fmt::println("FAIL trait_path_call"); }
    if (type_path_call()) { passed += 1; } else { fmt::println("FAIL type_path_call"); }
    if (own_method_first()) { passed += 1; } else { fmt::println("FAIL own_method_first"); }
    fmt::println(f"head_for_every_type_methods_are_called: {passed} of 5 passed");
    if (passed != 5) { return 1; }
    return 0;
}
