# inherent_owner_leaf_collision - a generic owner's generic method, with an
# unrelated NON-generic type of the same leaf declaring a method of the
# same name in another module.
#
# The monomorphizer finds the declaration that owns a specialized
# receiver's generic method in the inherent-owner index.  A specialization
# is not an inherent owner, so `generic::Pair<i32>` misses under its own
# name; asked again by the receiver's LEAF, the index answered with
# whichever module registered `Pair` last - `plain::Pair` - and the wrong
# owner's `scale<U>` was specialized while the call site references
# `generic::Pair<i32>::scale<i32>`, which nothing emits: an undefined
# reference at link.  Keyed by the declaration's own name only, the owner
# is found through the specialization's template and the program links.
#
# The exit code is the assertion: 5 + 2 = 7 through generic::Pair's scale,
# 1 * 100 = 100 through plain::Pair's; main returns 7 * 10 + 100 / 100.

[project]
project_name = "inherent_owner_leaf_collision"
output_dir   = "build"
target_type  = "executable"
source_dir   = "src"
entry_point  = "src/main.cryo"

