namespace inherent_owner_leaf_collision::plain;

/// An unrelated NON-generic type spelled `Pair`, with a generic method of
/// the same name.  Registered as an inherent owner under its leaf.
public type struct Pair {
    tag: i32;

    static make(t: i32) -> Pair {
        return Pair { tag: t };
    }

    /// Same name, same arity, a different body: returns `n` times 100.
    scale<U>(&this, n: U) -> U {
        return n * (100 as U);
    }
}
