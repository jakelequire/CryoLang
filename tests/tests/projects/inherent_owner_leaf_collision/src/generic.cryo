namespace inherent_owner_leaf_collision::generic;

import std::core::ops;

/// A generic owner whose generic method must be found on THIS declaration.
public type struct Pair<T> {
    first:  T;
    second: T;

    static new(a: T, b: T) -> Pair<T> {
        return Pair::<T> { first: a, second: b };
    }

    /// Returns `n` scaled by the first element, as U.
    scale<U>(&this, n: U) -> U where U: ops::Add<U, U> {
        return n + (this.first as U);
    }
}
