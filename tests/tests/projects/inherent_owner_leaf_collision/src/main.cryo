namespace inherent_owner_leaf_collision;

import inherent_owner_leaf_collision::generic;
import inherent_owner_leaf_collision::generic::{ Pair };
import inherent_owner_leaf_collision::plain;

function main() -> i32 {
    const p: Pair<i32> = Pair<i32>::new(2, 3);
    // 5 + 2 = 7 through generic::Pair<i32>::scale<i32>; plain::Pair's
    // scale<U> would give 500.
    const v: i32 = p.scale<i32>(5);
    const q: plain::Pair = plain::Pair::make(1);
    const w: i32 = q.scale<i32>(1);
    return v * 10 + (w / 100);
}
