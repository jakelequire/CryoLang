# bound_supertrait_method_takes_bound_arguments - a method a bound reaches
# through its trait's supertrait is typed with the arguments the bound
# gives that supertrait: under `where T: Store<i64, i32>` (and
# `Store<K, V> : Lookup<V>`), `t.get()` is `Lookup::get` at `Lookup<i32>`
# and returns `i32`, not the supertrait's own parameter `V`.  Two levels of
# supertrait, with the parameters reordered on the way, are covered.
# The exit code names the first check that failed.
[project]
project_name = "bound_supertrait_method_takes_bound_arguments"
output_dir   = "build"
target_type  = "executable"
source_dir   = "src"
entry_point  = "src/main.cryo"
[compiler]
[dependencies]
