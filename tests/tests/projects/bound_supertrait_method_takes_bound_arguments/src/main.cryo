namespace BoundSupertraitArguments;

type trait Lookup<V> {
    get(&this) -> V;
}

type trait Store<K, V> : Lookup<V> {
    put(mut &this, key: K, value: V) -> void;
}

type trait Ledger<A, B> : Store<B, A> {
    total(&this) -> i64;
}

type struct Cell {
    key: i64;
    value: i32;
}

implement trait Lookup<i32> for struct Cell {
    get(&this) -> i32 { return this.value; }
}

implement trait Store<i64, i32> for struct Cell {
    put(mut &this, key: i64, value: i32) -> void {
        this.key = key;
        this.value = value;
    }
}

implement trait Ledger<i32, i64> for struct Cell {
    total(&this) -> i64 { return this.key + this.value as i64; }
}

function stored<T>(t: mut &T) -> i32 where T: Store<i64, i32> {
    t.put(4, 40);
    const value: i32 = t.get();
    return value;
}

function ledgered<T>(t: mut &T) -> i64 where T: Ledger<i32, i64> {
    t.put(5, 50);
    const value: i32 = t.get();
    return value as i64 + t.total();
}

function main() -> i32 {
    mut cell: Cell = Cell { key: 0, value: 0 };
    if (stored(&cell) != 40) { return 1; }
    if (ledgered(&cell) != 105) { return 2; }
    return 0;
}
