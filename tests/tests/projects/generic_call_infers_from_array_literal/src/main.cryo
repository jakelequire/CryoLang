/// A generic call whose type parameter only an array literal argument fixes
/// binds it from the literal's elements: the literal passed for an `[T]`
/// parameter is the `Array` of its own element type.  The exit code names
/// what read wrong; 0 means all held.
namespace GenericCallInfersFromArrayLiteral::Main;

type struct Point {
    x: i64;
    y: i64;
}

function generic_len<T>(xs: [T]) -> i64 {
    return xs.length();
}

function first<T>(xs: [T]) -> T {
    return xs[0];
}

function last<T>(xs: [T]) -> T {
    return xs[xs.length() - 1];
}

function count_if_true(xs: [boolean]) -> i64 {
    mut n: i64 = 0;
    for (mut i: i64 = 0; i < xs.length(); i++) {
        if (xs[i]) { n += 1; }
    }
    return n;
}

function echo<T>(xs: [T]) -> [T] {
    return xs;
}

function main() -> i32 {
    if (generic_len([true, false]) != 2) { return 1; }
    if (generic_len([1, 2, 3]) != 3) { return 2; }
    if (first([7, 8]) != 7) { return 3; }
    if (last(["a", "bc"]).length() != 2) { return 4; }
    const p: Point = last([Point { x: 1, y: 2 }, Point { x: 3, y: 4 }]);
    if (p.x != 3 || p.y != 4) { return 5; }
    if (count_if_true(echo([true, false, true])) != 2) { return 7; }
    if (generic_len([0; 4]) != 4) { return 8; }
    return 0;
}
