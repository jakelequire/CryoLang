namespace GenericOperatorOnUserType::Main;

import std::core::ops::{ Add, Sub };
import std::core::cmp;

type struct V2 { x: i32; }

implement trait Add<V2, V2> for struct V2 {
    add(&this, rhs: &V2) -> V2 { return V2 { x: this.x + rhs.x }; }
}
implement trait Sub<V2, V2> for struct V2 {
    sub(&this, rhs: &V2) -> V2 { return V2 { x: this.x - rhs.x }; }
}
implement trait cmp::Eq for struct V2 {
    equals(&this, other: &V2) -> boolean { return this.x == other.x; }
}
implement trait cmp::Ord for struct V2 {
    compare(&this, other: &V2) -> cmp::Ordering {
        if (this.x < other.x) { return cmp::Ordering::Less; }
        if (this.x > other.x) { return cmp::Ordering::Greater; }
        return cmp::Ordering::Equal;
    }
}

function sum<T>(a: T, b: T) -> T where T: Add<T, T> { return a + b; }
function diff<T>(a: T, b: T) -> T where T: Sub<T, T> { return a - b; }
function same<T>(a: T, b: T) -> boolean where T: cmp::Eq { return a == b; }
function less<T>(a: T, b: T) -> boolean where T: cmp::Ord { return a < b; }

function main() -> i32 {
    const p: V2 = V2 { x: 1 };
    const q: V2 = V2 { x: 2 };
    if (sum::<V2>(p, q).x != 3) { return 1; }
    if (diff::<V2>(q, p).x != 1) { return 3; }
    if (!same::<V2>(p, V2 { x: 1 })) { return 4; }
    if (same::<V2>(p, q)) { return 5; }
    if (!same::<i64>(7, 7)) { return 6; }
    if (!less::<V2>(p, q)) { return 7; }
    if (less::<V2>(q, p)) { return 8; }
    if (!less::<u8>(1, 2)) { return 9; }
    return 0;
}
