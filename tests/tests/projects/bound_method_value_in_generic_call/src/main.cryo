namespace BoundMethodValueInGenericCall;

import std::core::cmp::{ Ordering, Ord };
import std::core::default::{ Default };

// A bound's method named through the type parameter, `T::m`, is a function
// value in the generic body: its receiver first, `This` being `T` and the
// bound's trait arguments put in.  A generic callee taking it binds its own
// parameters from that type where the body is written.

type struct Pt with [Eq] {
    x: i64;
}

implement trait Ord for Pt {
    compare(&this, other: &Pt) -> Ordering { return this.x.compare(&other.x); }
}

implement trait Default for Pt {
    static default() -> Pt { return Pt { x: 7 }; }
}

type trait Scale<U> {
    scale(&this, by: U) -> This;
}

implement trait Scale<i64> for Pt {
    scale(&this, by: i64) -> Pt { return Pt { x: this.x * by }; }
}

type trait Bump {
    bump(mut &this) -> void;
}

implement trait Bump for Pt {
    bump(mut &this) -> void { this.x += 1; }
}

function order_with<T, F>(compare: F, a: &T, b: &T) -> Ordering where F: (&T, &T) -> Ordering {
    return compare(a, b);
}

function in_order<T>(a: &T, b: &T) -> boolean where T: Ord {
    return order_with(T::compare, a, b) != Ordering::Greater;
}

function make_with<R, F>(make: F) -> R where F: () -> R {
    return make();
}

function fresh<T>() -> T where T: Default {
    return make_with(T::default);
}

function apply_scale<T, U, F>(scale: F, value: &T, by: U) -> T where F: (&T, U) -> T {
    return scale(value, by);
}

function scaled<T>(value: &T, by: i64) -> T where T: Scale<i64> {
    return apply_scale(T::scale, value, by);
}

function apply_bump<T, F>(bump: F, value: mut &T) -> void where F: (mut &T) -> void {
    bump(value);
}

function bumped<T>(value: mut &T) -> void where T: Bump {
    apply_bump(T::bump, value);
}

function main() -> i32 {
    const p: Pt = Pt { x: 1 };
    const q: Pt = Pt { x: 2 };
    if (!in_order(&p, &q)) { return 1; }
    if (in_order(&q, &p)) { return 2; }
    const three: i64 = 3;
    const two: i64 = 2;
    if (in_order(&three, &two)) { return 3; }
    if (!in_order(&two, &three)) { return 4; }
    if (fresh::<Pt>().x != 7) { return 5; }
    if (scaled(&q, 5).x != 10) { return 6; }
    mut r: Pt = Pt { x: 40 };
    bumped(&r);
    if (r.x != 41) { return 7; }
    return 0;
}
