namespace generic_body_own_method_turbofish;

import std::fmt;

type struct Box<T> {
    value: T;

    map<U>(&this, f: (T) -> U) -> Box<U> {
        return Box::<U> { value: f(this.value) };
    }

    // `this.map::<i64>(g)` is a `Box<i64>`: the method's own `U` is the
    // written `i64`, the owner's `T` is this body's `T`.
    widened(&this, g: (T) -> i64) -> i64 {
        const b: Box<i64> = this.map::<i64>(g);
        return b.value;
    }
}

function twice(x: i32) -> i64 { return (x as i64) * 2; }

function main() -> i32 {
    const b: Box<i32> = Box::<i32> { value: 21 };
    const w: i64 = b.widened(twice);
    fmt::printf("widened %lld\n", w);
    if (w != 42) { return 1; }
    return 0;
}
