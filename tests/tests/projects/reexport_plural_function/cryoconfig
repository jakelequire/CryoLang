# reexport_plural_function - a FUNCTION two children of one facade declare,
# called through the facade, is refused.
#
# `Facade` re-exports `Left` and `Right`, and both declare `make()`. The path
# `Facade::make()` names the item the facade offers under `make`, and it
# offers two, so it names neither - the same refusal `Facade::Widget` gets for
# a type (spec §4.4, docs/name-resolution.md §8.144), reached by the call form.
# Picking one would bind the call to whichever child the graph enumerated
# first, which is not a property the source states.
#
# `Left::make()` is the CONTROL: the declaring module's own path is not
# plural, and it must not be mentioned by the diagnostic.

[project]
project_name = "reexport_plural_function"
output_dir   = "build"
target_type  = "executable"
source_dir   = "src"
entry_point  = "src/main.cryo"

