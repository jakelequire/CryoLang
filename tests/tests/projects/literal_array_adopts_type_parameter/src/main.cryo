namespace LiteralArrayAdoptsTypeParameter;

// An array literal of literals adapts to the type another argument, or the
// expected type, binds its parameter's `T` to, as a single literal does: its
// literals are typed as that `T`, not as their defaults.

function count_eq<T>(xs: [T], y: T) -> i64 where T: Eq {
    mut n: i64 = 0;
    for (mut i: i64 = 0; i < xs.length; i++) {
        if (xs[i] == y) { n += 1; }
    }
    return n;
}

function count3<T>(xs: [T; 3], y: T) -> i64 where T: Eq {
    mut n: i64 = 0;
    for (mut i: i64 = 0; i < 3; i++) {
        if (xs[i] == y) { n += 1; }
    }
    return n;
}

function first<T>(xs: [T]) -> T {
    return xs[0];
}

function main() -> i32 {
    const wide: i64 = 5000000000;
    const neg: i64 = -3;
    const small: f32 = 2.5;
    const b: u8 = 200;
    mut r: i64 = count_eq([5000000000, 1, 5000000000], wide);      // 2
    r = r + count_eq([-3, 4, -3, -3], neg) * 4;                   // 12
    r = r + count_eq([1.5, 2.5], small) * 16;                     // 16
    r = r + count3([200, 200, 1], b) * 32;                        // 64
    const big: i64 = first([7, 8]);
    r = r + (big - 6) * 128;                                      // 128
    return r as i32;                                              // 222
}
