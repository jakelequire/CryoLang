/// Two references compare the values they refer to, by the referent's `Ord`
/// for `<`, `>`, `<=` and `>=`. A referent that implements no `Ord` has no
/// order to compare by, and an order of the two addresses says nothing
/// about the values, so the comparison is refused, each with the help that
/// writes its fix: a float its values compared and `total_compare`, a user
/// type an implementation of `Ord`, a boolean its values compared, an array
/// its addresses. `==` on the same references stays allowed.
namespace ReferenceOrderedWithoutOrdRefused::Main;

type struct Plain { value: i64; }

function main() -> i32 {
    const low: f64 = 1.5;
    const high: f64 = 2.5;
    const first: &f64 = &low;
    const second: &f64 = &high;
    const plain: Plain = Plain { value: 1 };
    const held: &Plain = &plain;
    const flag: boolean = true;
    const set: &boolean = &flag;
    const pair: [i64; 2] = [1, 2];
    const both: &[i64; 2] = &pair;
    mut hits: i32 = 0;
    if (first < second) { hits = hits + 1; }
    if (first >= second) { hits = hits + 1; }
    if (&low > &high) { hits = hits + 1; }
    if (held <= held) { hits = hits + 1; }
    if (set > set) { hits = hits + 1; }
    if (both < both) { hits = hits + 1; }
    if (first == second || held == held || set != set) { hits = hits + 1; }
    return hits;
}
