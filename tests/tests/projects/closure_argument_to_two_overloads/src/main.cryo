namespace ClosureArgumentToTwoOverloads::Main;

// One closure value passed to both overloads of `pick`: each call is a
// specialization of the overload it selects.
function pick(f: (i32) -> i32) -> i32 { return f(1); }

function pick(f: (i32) -> i32, x: i32) -> i32 { return f(x) + 20; }

function main() -> i32 {
    const bias: i32 = 10;
    const add_bias = (x: i32) -> i32 { return x + bias; };
    const a: i32 = pick(add_bias);
    const b: i32 = pick(add_bias, 1);
    return a + b;
}
