# closure_argument_to_two_overloads - one capturing closure passed to two
# overloads of one free function is specialized once for each: a
# specialization is kept under the overload it was made from, not under the
# family's path.  Keyed by the path, the second call was handed the first
# overload's one-parameter specialization and refused (E0214).  The program
# exits 42: `pick(add_bias)` is 11 and `pick(add_bias, 1)` is 31.
[project]
project_name = "closure_argument_to_two_overloads"
output_dir   = "build"
target_type  = "executable"
source_dir   = "src"
entry_point  = "src/main.cryo"
