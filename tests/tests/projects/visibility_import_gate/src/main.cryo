/// ============ A SPECIFIC IMPORT NAMING A PRIVATE DECLARATION ============
///
/// Spec 3.2: a module's export set is exactly its declarations not marked
/// `private`, and nothing else about it is nameable from outside.  Spec 3.3:
/// visibility is checked when a candidate is PROPOSED, and a candidate that
/// is not visible is an error with a diagnostic, never a silent miss.  An
/// import is where a bare name's candidate is proposed.
///
/// Measured before the gate: this import bound nothing and said nothing, so a
/// use of `hidden` below reported "cannot find value" - a name that exists,
/// reported as one that does not - and a compiler that still bound bare names
/// by their unique leaf compiled it and returned 7.
///
/// IF THIS PROJECT STARTS PASSING ITS BUILD: the import binds a private name
/// or refuses it in silence.  Do not relax `test.json`.
///
/// =======================================================================
namespace VisibilityImportGate::Main;

import VisibilityImportGate::Vault::{ shown, hidden, labs, llabs };

function main() -> int {
    const control: () -> i32 = shown;
    const gated: () -> i32 = hidden;
    const ext_control: (i64) -> i64 = labs;
    const ext_gated: (i64) -> i64 = llabs;
    return (control() + gated()) as int + (ext_control(-1) + ext_gated(-2)) as int;
}
