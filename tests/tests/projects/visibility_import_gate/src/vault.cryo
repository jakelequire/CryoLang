/// One private declaration and one public control.  `private` is written out
/// and is load-bearing: a top-level declaration is PUBLIC by default, so a
/// visibility probe that leaves the keyword off tests nothing at all.
namespace VisibilityImportGate::Vault;

/// Named by a specific import in `main.cryo`.  A private declaration is
/// offered to no importer, so the import that names it cannot bind it; the
/// gate is that the import says so, with the qualified name, rather than
/// binding nothing in silence and leaving the use site to report a name that
/// exists as one that does not.
private function hidden() -> i32 { return 7; }

/// CONTROL: a public sibling imported the same way, which must bind silently.
public function shown() -> i32 { return 3; }

/// The same rule for an imported function: a top-level declaration of this
/// module, public unless written `private`.  `labs` is the control and must
/// import silently; `llabs` opts out and the import naming it is refused.
extern "C" {
    function labs(j: i64) -> i64;
    private function llabs(j: i64) -> i64;
}
