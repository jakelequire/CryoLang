![config(testing)]
namespace QualifiedTypeSelectsModule::Tests::Qualified;

import QualifiedTypeSelectsModule::A;
import QualifiedTypeSelectsModule::B;
import QualifiedTypeSelectsModule::Hidden;
import std::core::result;
import std::test::error;
import std::test::error::{ TestError };
import std::test::assert;
import std::test::assert::{ expect_eq };

// Both modules are imported and both declare `Widget`, so the leaf alone names
// neither owner. Each spelling must reach its OWN module's type.
//
// Resolving the leaf through the scope chain and checking the written qualifier
// against the result afterwards can refuse a wrong answer but cannot produce
// the right one: the leaf binds to whichever module registered last, so the
// other spelling resolves to nothing at all.
//
// The fields differ, so a cross-binding cannot compile; the widths differ, so a
// binding that type-checks against the wrong owner fails on content.
![test]
function each_qualifier_selects_its_own_module() -> Result<(), TestError> {
    mut wa: A::Widget = A::Widget { ax: 3 };
    mut wb: B::Widget = B::Widget { by: 4 };
    const sum: i64 = (wa.ax as i64) + wb.by;
    return expect_eq(sum, 7);
}

// The second-registered module is the half that regressed: the first one
// answers from the leaf either way, so a test that only spells `A::Widget`
// passes with the defect present.
![test]
function the_later_module_is_reachable_by_name() -> Result<(), TestError> {
    mut wb: B::Widget = B::Widget { by: 11 };
    return expect_eq(wb.by, 11);
}

// A qualified path names its own module, so reaching a type does not depend on
// the leaf having been bound in the writer's scope by an import.
![test]
function qualified_path_reaches_a_non_public_type() -> Result<(), TestError> {
    mut t: Hidden::Tucked = Hidden::tucked(6);
    return expect_eq(Hidden::tucked_n(&t), 6);
}

// The STATIC-CALL half of the same question. The annotation consumer read the
// stamp under a condition that excluded qualified spellings; the call consumer
// keyed the owner off the written text instead, and the scope map's refusal
// reached it as that text echoed back - so the key was a name nothing is
// registered under, and the lookup widened the bare leaf and answered from
// whichever module registered `Widget` first.
//
// Both spellings on purpose. A test that writes only `A::Widget::make` passes
// with the defect present, because the first-registered module answers from the
// leaf either way; `B::Widget::make` was `E0233`.
![test]
function each_qualifier_selects_its_own_module_for_a_static_call() -> Result<(), TestError> {
    mut sa: A::Widget = A::Widget::make(5);
    mut sb: B::Widget = B::Widget::make(6);
    const sum: i64 = (sa.ax as i64) + sb.by;
    return expect_eq(sum, 11);
}

// The second-registered module alone, so the assertion cannot be satisfied by
// the first one answering. The widths differ, so a bind against the wrong owner
// fails on content rather than on the type name.
![test]
function the_later_module_is_reachable_by_a_static_call() -> Result<(), TestError> {
    mut sb: B::Widget = B::Widget::make(12);
    return expect_eq(sb.by, 12);
}
