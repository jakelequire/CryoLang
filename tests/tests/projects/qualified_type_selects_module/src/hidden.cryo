namespace QualifiedTypeSelectsModule::Hidden;

// NOT public. A qualified path names its own module, so reaching it does not
// depend on the leaf having been brought into the writer's scope.
type struct Tucked {
    n: i32;
}

public function tucked(n: i32) -> Tucked { return Tucked { n: n }; }
public function tucked_n(t: &Tucked) -> i32 { return t.n; }
