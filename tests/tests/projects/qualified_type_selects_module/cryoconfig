# qualified_type_selects_module - a qualified type name must be resolved BY its
# qualifier, not by its leaf.
#
# Two modules declare the same type leaf and both are imported. Resolving the
# leaf through the scope chain and then checking the written qualifier against
# the result can refuse a wrong answer but cannot produce the right one: the
# leaf binds to whichever module registered last, so one of the two spellings
# resolves to nothing at all. `b::Widget` was E0203 with `a::Widget` compiling
# beside it.
#
# The fields differ, so a cross-binding cannot compile, and the values differ,
# so a binding that type-checks but selects the wrong module fails on content.
#
# A project rather than a lang test because the shape needs three real modules.

[project]
project_name = "qualified_type_selects_module"
output_dir   = "build"
target_type  = "executable"
source_dir   = "src"
entry_point  = "src/main.cryo"

