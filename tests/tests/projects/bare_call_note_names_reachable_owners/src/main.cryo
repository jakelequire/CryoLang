/// E0202's note names the modules a bare call's leaf could be spelled
/// through, and only those the writer may call it from: `heap::realloc` and
/// `heap::alloc` are internal to the standard library and `Tools::helper` is
/// private to its module, so none of them is offered, while `libc`,
/// `intrinsics`, `allocator` and `Tools::shown` are.
namespace BareCallNoteNamesReachableOwners::Main;

import BareCallNoteNamesReachableOwners::Tools;

function main() -> int {
    const grown: void* = realloc(null, 8);
    const block: void* = alloc(8);
    helper();
    shown();
    return 0;
}
