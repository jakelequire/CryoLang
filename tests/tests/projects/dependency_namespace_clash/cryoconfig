# dependency_namespace_clash - a top-level namespace belongs to one package
# in a build.  The program declares `Util` and so does its dependency
# `crate_box`, and the dependency also declares `std`, the standard
# library's: each is refused with E0507 naming both packages and both
# files, before any import is resolved, instead of the dependency's `Util`
# silently replacing the program's.
[project]
project_name = "dependency_namespace_clash"
output_dir   = "build"
target_type  = "executable"
source_dir   = "src"
entry_point  = "src/main.cryo"

[compiler]

[dependencies]
crate_box = { path = "crate_box" }
