/// A `where` bound written on a type that is not a parameter, on an
/// implement block, holds only for the instantiations whose types satisfy
/// it.  `UiHighError` implements `From<UiLowError>`, not `From<UiOtherError>`,
/// so `UiHolder<UiOtherError>` has no implementation of `UiDescribe` and the
/// call that needs one is refused (E0306), while the call on
/// `UiHolder<UiLowError>` is not.
namespace WhereBoundOnImplementationUnmet::Main;

import std::core::convert::{ From };

type enum UiLowError { Bad; }

type enum UiOtherError { Other; }

type enum UiHighError { Low; }

implement trait From<UiLowError> for enum UiHighError {
    static from(value: UiLowError) -> UiHighError { return UiHighError::Low; }
}

type trait UiDescribe { describe(&this) -> i32; }

type struct UiHolder<E> { tag: i32; }

implement<E> trait UiDescribe for struct UiHolder<E> where UiHighError: From<E> {
    describe(&this) -> i32 { return this.tag; }
}

function ui_describe<T>(value: &T) -> i32 where T: UiDescribe {
    return value.describe();
}

function main() -> i32 {
    const fine: UiHolder<UiLowError> = UiHolder::<UiLowError> { tag: 1 };
    const refused: UiHolder<UiOtherError> = UiHolder::<UiOtherError> { tag: 3 };
    return ui_describe(&fine) + ui_describe(&refused);
}
