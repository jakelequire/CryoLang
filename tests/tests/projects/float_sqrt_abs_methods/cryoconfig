# float_sqrt_abs_methods - `sqrt` and `abs` are methods of `f32` and
# `f64` (`(16.0).sqrt()`, `x.abs()`), each at its own precision: a
# negative root is NaN, and `abs` clears the sign bit, so `-0.0` gives
# `0.0` and a negative NaN loses its sign.
[project]
project_name = "float_sqrt_abs_methods"
output_dir   = "build"
target_type  = "executable"
source_dir   = "src"
entry_point  = "src/main.cryo"
