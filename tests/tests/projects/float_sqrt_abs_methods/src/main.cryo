namespace FloatSqrtAbsMethods::Main;

import std::core::mem;

function sign_bit(v: f64) -> u64 {
    return mem::transmute::<f64, u64>(v) >> 63;
}

function sign_bit32(v: f32) -> u32 {
    return mem::transmute::<f32, u32>(v) >> 31;
}

function main() -> i32 {
    if ((16.0).sqrt() != 4.0) { return 1; }
    const third: f32 = 9.0 as f32;
    if (third.sqrt() != (3.0 as f32)) { return 2; }
    const neg: f64 = 0.0 - 1.0;
    const root: f64 = neg.sqrt();
    if (root == root) { return 3; }
    if ((0.0 - 3.5).abs() != 3.5) { return 4; }
    if ((0.0 - 2.5 as f32).abs() != (2.5 as f32)) { return 5; }

    // `-0.0 < 0.0` is false, so a compare-and-negate `abs` hands `-0.0`
    // back with its sign; clearing the sign bit gives `0.0`.
    const neg_zero: f64 = mem::transmute::<u64, f64>(0x8000000000000000);
    if (sign_bit(neg_zero) != 1) { return 6; }
    if (sign_bit(neg_zero.abs()) != 0) { return 7; }
    const neg_zero32: f32 = mem::transmute::<u32, f32>(0x80000000);
    if (sign_bit32(neg_zero32) != 1) { return 8; }
    if (sign_bit32(neg_zero32.abs()) != 0) { return 9; }

    // A NaN with its sign set compares false against `0.0` too; `abs`
    // clears the sign and keeps it a NaN.
    const neg_nan: f64 = mem::transmute::<u64, f64>(0xFFF8000000000000);
    const cleared: f64 = neg_nan.abs();
    if (cleared == cleared) { return 10; }
    if (sign_bit(cleared) != 0) { return 11; }
    return 0;
}
