# Cryo Test Suite — repo-level e2e tests.
#
# This project exercises the language, the compiler, and the standard
# library by way of `cryo test`.  Test files live in `tests/` (a sibling
# of `src/`); each file's namespace declaration carries `![config(testing)]`,
# and each test function carries `![test]`.  See docs/testing.md for the
# full surface.
#
# `src/main.cryo` is a placeholder that `cryo test` suppresses — the
# compiler synthesises a test-runner main that drives every discovered
# `![test]` function.  Running `cryo run` from this project would invoke
# the placeholder main; running `cryo test` is the canonical entry point.

[project]
project_name = "cryo-tests"
output_dir   = "build"
target_type  = "executable"
entry_point  = "src/main.cryo"

[compiler]
debug     = false
# Build the test suite optimized (O2). NOTE: `optimize` was historically
# a no-op (the level was hardcoded O2); once it became real, `false` (=O0)
# surfaced a pre-existing varargs miscompile that mem2reg masks at O1+
# (std VaArgs `.next<T>()` segfaults at O0). Keep O2 until that codegen
# bug is fixed; then an O0 test matrix would be worth adding.
optimize  = true
emit_llvm = true
# C-side ABI test helpers (see helpers/abi_helpers.c and the top-level
# Makefile target that builds the static archive).  The static archive
# is consumed via plain -l, so the linker resolves `abi_*` symbols at
# link time.
link_paths = ["helpers"]
link_libs  = ["abihelpers"]

[dependencies]

# Repo-level test suite opts into the grouped, color-on-TTY layout so the
# 800+ tests are scannable when run interactively. End-user projects with
# no `[test]` section get the cargo-style `plain` default. Override per-run
# with `cryo test --format=plain` or `CRYO_TEST_FORMAT=...`.
[test]
format = "pretty"
color  = "auto"
