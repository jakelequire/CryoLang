namespace Main;

import std::net::http::router;
import std::net::http::server;
import std::net::http::request;
import std::net::http::response;
import std::net::http::method;
import std::net::http::status;
import std::net::socket_addr;
import std::collections::str;
import std::collections::string;
import std::collections::array;

// ============================================================================
// Handlers
// ============================================================================

function handle_root(req: Request) -> Response {
    req.drop();
    return Response::text(
        StatusCode::ok(),
        Str::from_raw("Hello, World!\n" as u8*, 14)
    );
}

function handle_health(req: Request) -> Response {
    req.drop();
    const body_str: Str = Str::from_raw("{\"status\":\"ok\"}" as u8*, 15);
    mut body: Array<u8> = Array::with_capacity(15);
    body.push_slice(body_str.as_bytes());
    return Response::json(StatusCode::ok(), body);
}

/// GET /greet/:name  →  "Hello, <name>!\n"
///
/// Demonstrates path-parameter capture. The `:name` segment in the
/// route pattern is extracted and made available via `req.param`.
function handle_greet(req: Request) -> Response {
    mut req_local: Request = req;
    match (req_local.param(Str::from_raw("name" as u8*, 4))) {
        Option::Some(mut name) => {
            // Build the greeting dynamically.
            mut body: Array<u8> = Array::with_capacity(64);
            body.push_slice(Str::from_raw("Hello, " as u8*, 7).as_bytes());
            body.push_slice(name.as_str().as_bytes());
            body.push_slice(Str::from_raw("!\n" as u8*, 2).as_bytes());
            const resp: Response = Response::text(
                StatusCode::ok(),
                Str::from_raw(body.as_ptr(), body.length())
            );
            body.drop();
            name.drop();
            req_local.drop();
            return resp;
        }
        Option::None => {
            req_local.drop();
            return Response::text(
                StatusCode::internal_server_error(),
                Str::from_raw("missing name param\n" as u8*, 19)
            );
        }
    }
}

/// POST /echo  →  mirrors the request body back as text/plain.
///
/// Demonstrates reading the request body and forwarding it verbatim.
function handle_echo(req: Request) -> Response {
    mut req_local: Request = req;
    const body_str: Str = Str::from_raw(
        req_local.body.as_ptr(),
        req_local.body.length()
    );
    const resp: Response = Response::text(StatusCode::ok(), body_str);
    req_local.drop();
    return resp;
}

/// DELETE /greet/:name  →  204 No Content (idempotent placeholder).
function handle_delete_greet(req: Request) -> Response {
    req.drop();
    return Response::new(StatusCode::no_content());
}

// ── custom fallbacks ────────────────────────────────────────────────────────

function handle_not_found(req: Request) -> Response {
    req.drop();
    const msg: Str = Str::from_raw(
        "404 Not Found\n  Try: GET /  GET /health  GET /greet/:name  POST /echo\n" as u8*,
        70
    );
    return Response::text(StatusCode::not_found(), msg);
}

function handle_method_not_allowed(req: Request) -> Response {
    req.drop();
    return Response::text(
        StatusCode::method_not_allowed(),
        Str::from_raw("405 Method Not Allowed\n" as u8*, 23)
    );
}

// ============================================================================
// Ready callback — printed once after bind, before first accept
// ============================================================================

function on_ready() -> void {
    printf("HTTP server listening on http://127.0.0.1:8080\n");
    printf("  GET    /              -> Hello, World!\n");
    printf("  GET    /health        -> {\"status\":\"ok\"}\n");
    printf("  GET    /greet/:name   -> Hello, <name>!\n");
    printf("  DELETE /greet/:name   -> 204 No Content\n");
    printf("  POST   /echo          -> echoes the request body\n");
}

// ============================================================================
// Entry point
// ============================================================================

function main() -> int {
    const addr: SocketAddr = SocketAddr::localhost_v4(8080);

    mut router: Router = Router::new();
    router
        .get(Str::from_raw("/" as u8*, 1),               handle_root)
        .get(Str::from_raw("/health" as u8*, 7),          handle_health)
        .get(Str::from_raw("/greet/:name" as u8*, 12),    handle_greet)
        .del(Str::from_raw("/greet/:name" as u8*, 12),    handle_delete_greet)
        .post(Str::from_raw("/echo" as u8*, 5),           handle_echo)
        .on_not_found(handle_not_found)
        .on_method_not_allowed(handle_method_not_allowed);

    mut server: HttpServer = HttpServer::with_router(addr, &router);
    server.with_ready(on_ready);

    match (server.run()) {
        Result::Ok(_)  => { }
        Result::Err(_) => {
            printf("Server error: failed to bind 127.0.0.1:8080\n");
        }
    }

    router.drop();
    return 0;
}
