///! Todo list - `Array<T>` of owned structs, with `Option`-based lookup.
///!
///! Drives a tiny in-memory todo list through `add`, `complete`, and
///! `remove` operations. The whole thing is a single batch - no stdin
///! loop - so the example stays focused on:
///!
///!   - `Array<Todo>` ownership: when an item is removed, its `String`
///!     fields drop with it; when the whole list drops at the end, so
///!     does every remaining item.
///!   - `Status` as a unit enum used in display formatting; it owns
///!     nothing, so it is `Copy` and passes by value freely.
///!   - `Option<i64>` for "find item by id" lookups - the result is
///!     `None` when the id doesn't exist.
///!
///! Run with:  cryo run

namespace Main;

import std::fmt;

// ============================================================================
// Status - unit enum, Copy
// ============================================================================

type enum Status {
    Pending;
    Done;
}

function status_marker(s: Status) -> string {
    match (s) {
        Status::Pending => { return "[ ]"; }
        Status::Done    => { return "[x]"; }
    }
}

// ============================================================================
// Todo - owns its description String
// ============================================================================

type struct Todo {
    id: u32;
    description: String;
    status: Status;

    static new(id: u32, description: Str) -> Todo {
        return Todo {
            id: id,
            description: String::from_str(description),
            status: Status::Pending
        };
    }
}

// ============================================================================
// TodoList - small wrapper that keeps id allocation honest
// ============================================================================

type struct TodoList {
    items: Array<Todo>;
    next_id: u32;

    static new() -> TodoList {
        return TodoList {
            items: Array::new(),
            next_id: 1
        };
    }

    add(mut &this, description: Str) -> u32 {
        const id: u32 = this.next_id;
        this.next_id = this.next_id + 1;
        this.items.push(Todo::new(id, description));
        return id;
    }

    /// Find the array index of a todo by its id, or `None` if no
    /// item matches. Linear scan - fine for a demo list.
    find_index(&this, id: u32) -> Option<i64> {
        const n: i64 = this.items.length();
        mut i: i64 = 0;
        while (i < n) {
            match (this.items.get_reference(i)) {
                Option::Some(item) => {
                    if (item.id == id) { return Option::Some(i); }
                }
                Option::None => { }
            }
            i = i + 1;
        }
        return Option::None;
    }

    /// Flip status to Done. We can't pop-and-rebuild without
    /// duplicating the description pointer, which would double-free
    /// at drop time - so we mutate the array slot in place via its
    /// raw pointer.
    complete(mut &this, id: u32) -> boolean {
        match (this.find_index(id)) {
            Option::Some(index) => {
                const slot: mut Todo* = this.items.as_mutable_pointer();
                slot[index].status = Status::Done;
                return true;
            }
            Option::None => { return false; }
        }
    }

    remove(mut &this, id: u32) -> boolean {
        match (this.find_index(id)) {
            Option::Some(index) => {
                this.items.swap_remove(index);
                return true;
            }
            Option::None => { return false; }
        }
    }

    length(&this) -> i64 {
        return this.items.length();
    }

    /// Display the list in id-ascending order. Because `swap_remove`
    /// reorders the backing array, we walk the id range rather than
    /// relying on insertion order.
    show(&this) -> void {
        if (this.items.length() == 0) {
            fmt::println("  (empty)");
            return;
        }
        mut id: u32 = 1;
        while (id < this.next_id) {
            match (this.find_index(id)) {
                Option::Some(idx) => {
                    match (this.items.get_reference(idx)) {
                        Option::Some(item) => {
                            fmt::println(f"  #{item.id:<2} {status_marker(item.status)} {item.description}");
                        }
                        Option::None => { }
                    }
                }
                Option::None => { }
            }
            id = id + 1;
        }
    }
}

// ============================================================================
// Entry point
// ============================================================================

function main() -> int {
    fmt::println("todo-cli - in-memory task list demo.\n");

    mut list: TodoList = TodoList::new();

    const id_a: u32 = list.add("write Cryo examples");
    const id_b: u32 = list.add("review pull requests");
    const id_c: u32 = list.add("buy groceries");
    list.add("clean the keyboard");

    fmt::println("After adding four items:");
    list.show();

    fmt::println(f"\nMarking #{id_a} and #{id_c} complete...");
    list.complete(id_a);
    list.complete(id_c);
    list.show();

    fmt::println(f"\nRemoving #{id_b}...");
    list.remove(id_b);
    list.show();

    const removed_missing: boolean = list.remove(999);
    if (removed_missing) {
        fmt::println("\nRemoving #999 returned true (unexpected!)");
    } else {
        fmt::println("\nRemoving #999 returned false (id not found).");
    }
    fmt::println(f"Final count: {list.length()} item(s).");

    return 0;
}
