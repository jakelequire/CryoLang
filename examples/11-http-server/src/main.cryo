///! HTTP server - `std::net::http` with a router and four routes.
///!
///! Binds to `127.0.0.1:8080` and exposes a handful of routes:
///!
///!   GET  /                  - plain text greeting
///!   GET  /health            - JSON health probe
///!   GET  /greet/:name       - path-parameter echo
///!   POST /echo              - echoes the request body back
///!
///! What this example demonstrates:
///!   - `Router::new()` + chained `.get()` / `.post()` / `.delete()` -
///!     fluent registration of route handlers.
///!   - Free-function handlers with the signature
///!     `(Request) -> Response` - Cryo's first-class function values.
///!   - `Response::text` / `Response::json` constructors; a handler's
///!     request is released when the handler returns.
///!   - `HttpServer::with_router(addr, &router)` + `await .run()`, which
///!     is why `main` is an `async function`: the accept loop and every
///!     connection read run on the executor `async main` sets up.
///!
///! Run with:  cryo run    then  curl http://127.0.0.1:8080/
///!
///! `net::http` is a preview module: its shape may change in a 1.x release.

namespace Main;

import std::future;
import std::fmt;
import std::net::{ SocketAddress };
import std::net::http::{ HttpServer, Request, Response, Router, StatusCode };

// ============================================================================
// Handlers
// ============================================================================

function handle_root(req: Request) -> Response {
    return Response::text(StatusCode::ok(), "Hello from the Cryo HTTP server!\n");
}

function handle_health(req: Request) -> Response {
    const body_text: Str = "{\"status\":\"ok\"}";
    mut body: Array<u8> = Array::with_capacity(body_text.length());
    body.append(body_text.as_bytes());
    return Response::json(StatusCode::ok(), body);
}

/// GET /greet/:name - pull the `:name` segment out of `req.params`
/// and bake it into a personalized response.
///
/// `params.get_reference` borrows the captured value rather than copying
/// it: the captured String stays owned by the request's map.
function handle_greet(req: Request) -> Response {
    const key: String = String::from_str("name");
    match (req.params.get_reference(&key)) {
        Option::Some(name) => {
            const greeting: String = f"Hello, {name.as_str()}!\n";
            return Response::text(StatusCode::ok(), greeting.as_str());
        }
        Option::None => {
            return Response::text(StatusCode::internal_server_error(), "missing :name param\n");
        }
    }
}

/// POST /echo - mirror the request body back as text/plain.
function handle_echo(req: Request) -> Response {
    const body_view: Str = Str::from_raw(req.body.as_pointer(), req.body.length());
    return Response::text(StatusCode::ok(), body_view);
}

function handle_not_found(req: Request) -> Response {
    return Response::text(
        StatusCode::not_found(),
        "404 Not Found\n  Try GET /, /health, /greet/:name, or POST /echo\n"
    );
}

function handle_method_not_allowed(req: Request) -> Response {
    return Response::text(StatusCode::method_not_allowed(), "405 Method Not Allowed\n");
}

// ============================================================================
// One-shot startup banner
// ============================================================================

function on_ready() -> void {
    fmt::println("listening on http://127.0.0.1:8080");
    fmt::println("  GET  /              -> greeting");
    fmt::println("  GET  /health        -> {\"status\":\"ok\"}");
    fmt::println("  GET  /greet/:name   -> personalized greeting");
    fmt::println("  POST /echo          -> echoes the body");
    fmt::println("  (Ctrl-C to stop)");
}

// ============================================================================
// Entry point
// ============================================================================

async function main() -> i32 {
    const addr: SocketAddress = SocketAddress::localhost_v4(8080);

    mut router: Router = Router::new();
    router.get("/",               handle_root)
          .get("/health",         handle_health)
          .get("/greet/:name",    handle_greet)
          .post("/echo",          handle_echo)
          .on_not_found(handle_not_found)
          .on_method_not_allowed(handle_method_not_allowed);

    mut server: HttpServer = HttpServer::with_router(addr, &router);
    server.with_ready(on_ready);

    match (await server.run()) {
        Result::Ok(_) => { }
        Result::Err(_) => {
            fmt::println("server error: could not bind 127.0.0.1:8080");
            return 1;
        }
    }

    return 0;
}
