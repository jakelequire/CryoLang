///! JSON config - `std::encoding::json` parsing into typed structs with
///! a derived `FromValue`.
///!
///! Loads `data/server.json`, parses it into a `Value`, and reads that
///! tree into a strongly-typed `ServerConfig`.
///!
///! What this example demonstrates:
///!   - `json::Json::parse(Str)` returns `Result<Value, JsonError>`.
///!   - `with [FromValue]` derives the reading of a struct from a JSON
///!     object: each field from the member of its name, through the
///!     field type's own `from_value` - a nested struct, an
///!     `Array<String>`, an integer of any width.
///!   - Members the struct does not name (`version`, `owner`) are
///!     ignored, and one it names and the file lacks is refused with an
///!     error that says where (`at .server.port: ...`).
///!
///! Run with:  cryo run

namespace Main;

import std::fs::{ File };
import std::encoding::value::{ FromValue, Value, ValueDecodeError };
import std::encoding::json;
import std::fmt;

// ============================================================================
// The typed shape we want
// ============================================================================

type struct ServerBlock with [FromValue] {
    host: String;
    port: u16;
    tls: boolean;
}

type struct Limits with [FromValue] {
    max_connections: u32;
    timeout_seconds: u32;
}

type struct ServerConfig with [FromValue] {
    service: String;
    server: ServerBlock;
    limits: Limits;
    features: Array<String>;
}

// ============================================================================
// Pretty-print
// ============================================================================

function print_config(c: &ServerConfig) -> void {
    fmt::println("\nLoaded config:");
    fmt::println(f"  service          : {c.service}");
    fmt::println(f"  host:port        : {c.server.host}:{c.server.port}");
    const tls: Str = if (c.server.tls) { "enabled" } else { "disabled" };
    fmt::println(f"  tls              : {tls}");
    fmt::println(f"  max_connections  : {c.limits.max_connections}");
    fmt::println(f"  timeout_seconds  : {c.limits.timeout_seconds}");

    mut features: String = String::new();
    for (feature in c.features.iterate_references()) {
        if (!features.is_empty()) { features.append(", "); }
        features.append(feature.as_str());
    }
    fmt::println(f"  features         : [{features}]");
}

// ============================================================================
// Entry point
// ============================================================================

function main() -> int {
    fmt::println("Reading data/server.json...");

    match (File::read_text("data/server.json")) {
        Result::Ok(source) => {
            fmt::println("Parsing...");
            match (json::Json::parse(source.as_str())) {
                Result::Ok(root) => {
                    match (ServerConfig::from_value(&root)) {
                        Result::Ok(config) => {
                            print_config(&config);
                            return 0;
                        }
                        Result::Err(error) => {
                            fmt::println(f"error: {error}");
                            return 1;
                        }
                    }
                }
                Result::Err(_) => {
                    fmt::println("error: failed to parse JSON");
                    return 1;
                }
            }
        }
        Result::Err(error) => {
            fmt::println(f"error: {error}");
            return 1;
        }
    }
}
