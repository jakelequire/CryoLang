namespace Main;

type trait MyTrait {
    do_something(&this) -> int;
}

type trait DebugView {
    debug_view(&this) -> string;
}

type struct MyStruct {
    value: int;
    static new(value: int) -> MyStruct {
        return MyStruct { value };
    }
}

implement trait MyTrait for struct MyStruct {
    do_something(&this) -> int {
        return this.value * 2;
    }
}

// Intentional Error
implement DebugView for MyStruct { }

function use_trait<T>(instance: T) -> void
where T: DebugView {
    printf("Result: %s\n", T::debug_view());
}

function main() -> int {
    printf("Hello, world!\n");

    const my_struct: MyStruct = MyStruct::new(42);
    use_trait(my_struct);

    return 0;
}
