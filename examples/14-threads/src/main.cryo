///! Native threads: spawn/join, message-passing channels, and scoped
///! fork-join parallelism.
///!
///! A thread's body is a `move` closure: what it captures is moved INTO
///! the thread where the closure is made, and the body's result is moved
///! back OUT through `JoinHandle::join`. A closure written without `move`
///! borrows from the function that spawns it, which may return while the
///! thread still runs, so `thread::spawn` refuses it.
///!
///! Run with:  cryo run

namespace Main;

import std::thread;
import std::sync::mpsc;
import std::sync::atomic::{ Atomic, MemoryOrder };
import std::collections::string::{ String };
import std::collections::pair::{ Pair };
import std::fmt;
import std::core::result::{ Result };

/// A worker that doubles its input. Used to show a value moving in and
/// the result moving back out via `join`.
function double_it(x: i32) -> i32 {
    return x * 2;
}

/// A worker that builds a new `String` from one it was given. The thread
/// owns the original (moved in by its `move` closure, released when the
/// thread ends) and hands the new one back through `join`.
function decorate(s: &String) -> String {
    mut out: String = s.clone();
    out.push(" [done on worker]");
    return out;
}

/// A producer: send the squares of 1..5 down a channel and report how many
/// were sent. A send fails only once the receiver is gone, when nothing more
/// can arrive, so the producer stops there. The thread's closure owns the
/// sender, so it is released when the thread ends, and the receiver then
/// observes disconnection.
function produce(tx: &mpsc::Sender<i32>) -> i32 {
    mut sent: i32 = 0;
    while (sent < 5) {
        const i: i32 = sent + 1;
        match (tx.send(i * i)) {   // 1, 4, 9, 16, 25
            Result::Ok(_)  => { sent = sent + 1; }
            Result::Err(_) => { return sent; }
        }
    }
    return sent;
}

function main() -> int {
    // 1. spawn + join: move a value in, get the result back.
    const n: i32 = 21;
    const h: thread::JoinHandle<i32> = thread::spawn(move () -> i32 { return double_it(n); });
    fmt::printf("spawn/join:   double(21) = %d\n", h.join());

    // 2. Move owned data (a String) into a thread, and a new one back out.
    mut greeting: String = String::new();
    greeting.push("hello from main");
    const sh: thread::JoinHandle<String> =
        thread::spawn(move () -> String { return decorate(&greeting); });
    mut result: String = sh.join();
    fmt::printf("move String:  %.*s\n",
        result.length() as i32, result.as_str().as_ptr());

    // 3. Message passing: a producer thread feeds a channel, main drains
    //    it until every sender has dropped (disconnection).
    const { first: tx, second: rx }: Pair<mpsc::Sender<i32>, mpsc::Receiver<i32>> =
        mpsc::Channel::unbounded::<i32>();
    const ph: thread::JoinHandle<i32> = thread::spawn(move () -> i32 { return produce(&tx); });
    mut sum: i32 = 0;
    mut draining: boolean = true;
    while (draining) {
        match (rx.recv()) {
            Result::Ok(v)  => { sum = sum + v; }
            Result::Err(_) => { draining = false; }   // all senders dropped
        }
    }
    fmt::printf("channel:      sum of squares 1..5 = %d\n", sum);
    ph.join();

    // 4. Scoped fork-join: four threads each bump a shared atomic counter
    //    that lives on main's stack. `thread::scope` joins them all before it
    //    returns, so each closure may borrow the stack counter, and an
    //    atomic is updated through a shared reference.
    const counter: Atomic<u8> = Atomic::<u8>::new(0);
    thread::scope((s: mut &thread::Scope) -> void {
        for (mut w: i32 = 0; w < 4; w = w + 1) {
            s.spawn(() -> void { counter.fetch_add(1, MemoryOrder::SeqCst); });
        }
    });
    fmt::printf("scoped:       4 workers bumped counter to %d\n",
        counter.load(MemoryOrder::SeqCst) as i32);

    return 0;
}
