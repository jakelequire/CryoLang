///! Hello, World! - the smallest possible Cryo program.
///!
///! Every Cryo project has a `cryoconfig` describing the build and a
///! `src/main.cryo` containing the entry point. `function main() -> int`
///! is what the runtime calls - the return value becomes the process
///! exit status.
///!
///! `fmt::println` writes a line to standard output. It takes text or an
///! f-string, which formats each `{value}` through `Display` (or `Debug`,
///! written `{value:?}`): `fmt::println(f"x = {x}, dbg = {x:?}")`.
///!
///! Run with:  cryo run

namespace Main;

import std::fmt;

function main() -> int {
    fmt::println("Hello, world!");
    fmt::println("Welcome to Cryo.");
    return 0;
}
