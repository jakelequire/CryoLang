///! Hello, World! - the smallest possible Cryo program.
///!
///! Every Cryo project has a `cryoconfig` describing the build and a
///! `src/main.cryo` containing the entry point. `function main() -> int`
///! is what the runtime calls - the return value becomes the process
///! exit status.
///!
///! `printf` is exposed by the auto-imported `core::intrinsics`
///! module; it forwards to libc and accepts the usual `%d`/`%s` format
///! specifiers. For type-safe, `Display`/`Debug`-formatted output, build a
///! `String` with an f-string - `f"x = {x}, dbg = {x:?}"` - or call
///! `std::fmt::display::format_to_string(&value)`.
///!
///! Run with:  cryo run

namespace Main;

import std::fmt;
import std::collections::array::{ Array };
import std::collections::hashmap::{ HashMap };
import std::collections::str::{ Str };
import std::collections::string::{ String };
import std::core::drop::{ Drop };
import std::core::option::{ Option };
import std::core::result::{ Result };
import std::fs::path::{ Path };
import std::io::stdio::{ Stdin, stdin };
import std::json::value::{ JsonValue };
import std::net::addr::socket_addr::{ SocketAddr };
import std::net::http::request::{ Request };
import std::net::http::response::{ Response };
import std::net::http::router::{ Router };
import std::net::http::server::{ HttpServer };
import std::net::http::status::{ StatusCode };
import std::sync::atomic::{ Atomic, MemoryOrder };

function main() -> int {
    fmt::printf("Hello, world!\n");
    fmt::printf("Welcome to Cryo.\n");
    return 0;
}
