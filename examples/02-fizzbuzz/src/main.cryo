///! FizzBuzz - control flow, enums, and pattern matching.
///!
///! Two flavors of the same problem:
///!   - `classic_fizzbuzz`   - straightforward `if`/`else if` chain.
///!   - `match_fizzbuzz`     - model each result as an enum variant
///!                            and pattern-match to print it.
///!
///! The enum version is a good demonstration of how Cryo's match
///! statements work - every variant must be handled, and payloads
///! are destructured into bindings.
///!
///! Run with:  cryo run

namespace Main;

import std::fmt;
import std::collections::array::{ Array };
import std::collections::hashmap::{ HashMap };
import std::collections::str::{ Str };
import std::collections::string::{ String };
import std::core::drop::{ Drop };
import std::core::option::{ Option };
import std::core::result::{ Result };
import std::fs::path::{ Path };
import std::io::stdio::{ Stdin, stdin };
import std::json::value::{ JsonValue };
import std::net::addr::socket_addr::{ SocketAddr };
import std::net::http::request::{ Request };
import std::net::http::response::{ Response };
import std::net::http::router::{ Router };
import std::net::http::server::{ HttpServer };
import std::net::http::status::{ StatusCode };
import std::sync::atomic::{ Atomic, MemoryOrder };

// ============================================================================
// Classic if/else if version
// ============================================================================

function classic_fizzbuzz(n: i32) -> void {
    mut i: i32 = 1;
    while (i <= n) {
        if (i % 15 == 0) {
            fmt::printf("FizzBuzz\n");
        } else if (i % 3 == 0) {
            fmt::printf("Fizz\n");
        } else if (i % 5 == 0) {
            fmt::printf("Buzz\n");
        } else {
            fmt::printf("%d\n", i);
        }
        i = i + 1;
    }
}

// ============================================================================
// Enum-driven version
// ============================================================================

type enum FizzBuzz {
    Number(i32);
    Fizz;
    Buzz;
    FizzBuzz;
}

function classify(n: i32) -> FizzBuzz {
    if (n % 15 == 0) { return FizzBuzz::FizzBuzz; }
    if (n % 3 == 0)  { return FizzBuzz::Fizz; }
    if (n % 5 == 0)  { return FizzBuzz::Buzz; }
    return FizzBuzz::Number(n);
}

function print_classification(c: FizzBuzz) -> void {
    match (c) {
        FizzBuzz::Number(value) => { fmt::printf("%d\n", value); }
        FizzBuzz::Fizz          => { fmt::printf("Fizz\n"); }
        FizzBuzz::Buzz          => { fmt::printf("Buzz\n"); }
        FizzBuzz::FizzBuzz      => { fmt::printf("FizzBuzz\n"); }
    }
}

function match_fizzbuzz(n: i32) -> void {
    mut i: i32 = 1;
    while (i <= n) {
        print_classification(classify(i));
        i = i + 1;
    }
}

// ============================================================================
// Entry point
// ============================================================================

function main() -> int {
    const limit: i32 = 20;

    fmt::printf("--- classic ---\n");
    classic_fizzbuzz(limit);

    fmt::printf("\n--- match ---\n");
    match_fizzbuzz(limit);

    return 0;
}
