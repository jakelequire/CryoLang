///! Word count - file I/O, byte-level scanning, and HashMap.
///!
///! Reads a text file, walks every byte to extract whitespace-delimited
///! words (lowercased, ASCII punctuation stripped), counts the
///! occurrences of each, and prints the top ten in descending order.
///!
///! What this example demonstrates:
///!   - `File::read_bytes(path)` - load a whole file into `Array<u8>`;
///!     a failure names the file it could not read.
///!   - `HashMap<String, i64>` - index into a parallel `WordCount`
///!     array so we keep one owned `String` per unique word.
///!   - `Array.sort_by` with a closure to rank the words by count; the
///!     sort is stable, so equal counts keep the order the words first
///!     appeared in.
///!   - Careful ownership: every `String` lives in exactly one place
///!     (`words[i].text`), and the HashMap key is a borrowing alias -
///!     a fresh `String` made from the same bytes - so the dropping
///!     of `words` plus the dropping of the map's keys is symmetric.
///!
///! Run with:  cryo run

namespace Main;

import std::core::option::{ Option };
import std::core::result::{ Result };
import std::collections::string::{ String };
import std::collections::array::{ Array };
import std::collections::hashmap::{ HashMap };
import std::fs::{ File };
import std::core::cmp::{ Ordering };
import std::fmt;

// ============================================================================
// WordCount - one entry per unique word
// ============================================================================

type struct WordCount {
    text: String;
    count: i64;
}

// ============================================================================
// Byte classification - ASCII fast path
// ============================================================================

/// What this example counts as part of a word: ASCII letters, digits and
/// the apostrophe of a contraction.
function is_word_byte(b: u8) -> boolean {
    return b.is_alpha() || b.is_digit() || b == 0x27;
}

// ============================================================================
// Tokenize + tally
// ============================================================================

/// Extract a lowercased word starting at `start` from `bytes`. Returns
/// the next byte index to resume scanning at. Walks past every
/// in-word byte and appends each to `out`.
function take_word(bytes: &Array<u8>, start: i64, out: mut &String) -> i64 {
    const n: i64 = bytes.length();
    mut i: i64 = start;
    while (i < n) {
        match (bytes.get(i)) {
            Option::Some(byte) => {
                if (!is_word_byte(byte)) { break; }
                out.push_byte(byte.to_ascii_lowercase());
                i = i + 1;
            }
            Option::None => { break; }
        }
    }
    return i;
}

/// Skip every non-word byte starting at `start`. Returns the next
/// in-word byte index (or `bytes.length()` at end-of-input).
function skip_non_word(bytes: &Array<u8>, start: i64) -> i64 {
    const n: i64 = bytes.length();
    mut i: i64 = start;
    while (i < n) {
        match (bytes.get(i)) {
            Option::Some(byte) => {
                if (is_word_byte(byte)) { break; }
                i = i + 1;
            }
            Option::None => { break; }
        }
    }
    return i;
}

/// Walk `bytes` and append a `WordCount` row for every unique word.
/// Repeat occurrences bump the existing row's `count`.
function tally(bytes: &Array<u8>, words: mut &Array<WordCount>) -> i64 {
    mut index: HashMap<String, i64> = HashMap::new();
    mut total: i64 = 0;

    mut i: i64 = 0;
    const n: i64 = bytes.length();
    while (i < n) {
        i = skip_non_word(bytes, i);
        if (i >= n) { break; }

        mut word: String = String::new();
        i = take_word(bytes, i, &word);
        if (word.is_empty()) {
            continue;
        }
        total = total + 1;

        match (index.get(&word)) {
            Option::Some(existing_idx) => {
                // Word already counted - bump the array slot in place.
                const slot: mut WordCount* = words.as_mutable_ptr();
                slot[existing_idx].count = slot[existing_idx].count + 1;
            }
            Option::None => {
                // New word. Take a separate String for the map key so
                // the array's String and the map's String are
                // independent allocations.
                const new_idx: i64 = words.length();
                mut key: String = String::from_str(word.as_str());
                words.push(WordCount { text: word, count: 1 });
                index.insert(key, new_idx);
            }
        }
    }

    return total;
}

// ============================================================================
// Output
// ============================================================================

function print_report(words: &Array<WordCount>, top_k: i64, total: i64) -> void {
    fmt::printf("--- word count report ---\n");
    fmt::printf("  total words:  %lld\n", total);
    fmt::printf("  unique words: %lld\n", words.length());
    fmt::printf("  top %lld:\n", top_k);

    const n: i64 = words.length();
    const limit: i64 = if (top_k < n) { top_k } else { n };
    mut i: i64 = 0;
    while (i < limit) {
        match (words.get_ref(i)) {
            Option::Some(entry) => {
                fmt::printf(
                    "    %4lld  %.*s\n",
                    entry.count,
                    entry.text.length() as i32,
                    entry.text.as_ptr()
                );
            }
            Option::None => { }
        }
        i = i + 1;
    }
}

// ============================================================================
// Entry point
// ============================================================================

function main() -> int {
    // The path is relative to the cwd `cryo run` uses, which is the
    // project root.  Adjust if running the binary by hand.
    match (File::read_bytes("data/sample.txt")) {
        Result::Ok(bytes) => {
            mut buffer: Array<u8> = bytes;
            mut words: Array<WordCount> = Array::new();
            const total: i64 = tally(&buffer, &words);

            // Most frequent first.
            words.sort_by((a: &WordCount, b: &WordCount) -> Ordering { return b.count.compare(&a.count); });
            print_report(&words, 10, total);

            return 0;
        }
        Result::Err(error) => {
            fmt::println(f"error: {error} (run from the project root with `cryo run`)");
            return 1;
        }
    }
}
