///! HTTP GET - fetch a page with `std::net::http::Client`.
///!
///! Reads the URL from the command line (`http://example.com/` when none is
///! given), fetches it, and prints the status, the number of body bytes and
///! the body's first line. It reaches the network, so what it prints
///! depends on the server; with no network it prints the error and exits 1.
///!
///! What this example demonstrates:
///!   - `Client::new()` and `await client.get(url)`, an `async` method that
///!     resolves the host, connects, speaks HTTP (or HTTPS, through TLS) and
///!     follows redirects.
///!   - `Url::parse` refusing a malformed address with a `UrlError`.
///!   - One `BoxedError` carrying a `UrlError` or an `IoError` through `?`,
///!     printed with its message.
///!
///! Run with:  cryo run    or    cryo run -- http://example.com/

namespace Main;

import std::fmt;
import std::env;
import std::future;
import std::core::{ BoxedError };
import std::net::{ Url };
import std::net::http::{ Client, Response };

/// GET `address`, following redirects.
async function fetch(address: Str) -> Result<Response, BoxedError> {
    const url: Url = Url::parse(address)?;
    const client: Client = Client::new()?;
    return Result::Ok((await client.get(url))?);
}

/// The body's first line, or nothing when the body is not UTF-8 text.
function first_line(body: &Array<u8>) -> String {
    return match (Str::from_utf8(body)) {
        Result::Ok(text) => {
            mut lines = text.lines();
            String::from_str(lines.next().unwrap_or(""))
        }
        Result::Err(_) => { String::new() }
    };
}

async function main() -> i32 {
    const arguments: Array<String> = env::args();
    const address: String = if (arguments.length() > 1) { arguments[1].clone() }
        else { String::from_str("http://example.com/") };
    return match (await fetch(address.as_str())) {
        Result::Ok(reply) => {
            fmt::println(f"GET {address}");
            fmt::println(f"status: {reply.status.as_u16()}");
            fmt::println(f"body: {reply.body.length()} bytes");
            fmt::println(f"first line: {first_line(&reply.body)}");
            0
        }
        Result::Err(error) => {
            fmt::println(f"GET {address} failed: {error}");
            1
        }
    };
}
