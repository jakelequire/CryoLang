///! Fibonacci — recursion, iteration, and command-line arguments.
///!
///! Demonstrates three things:
///!   • Two algorithms for computing the n-th Fibonacci number —
///!     the textbook recursive version (exponential time) and a
///!     constant-space iterative loop.
///!   • `env::args()` — owned `Array<String>` of the command-line
///!     argv. The first element is the program name.
///!   • Parsing user input via `u32::try_from(s)` for `s: Str`, which
///!     lives in `collections::str` (`TryFrom<Str> for u32`) and
///!     returns `Result<u32, ConversionError>`.
///!
///! Run with:  cryo run -- 15      (the `--` separates `cryo` flags
///!                                from arguments forwarded to the
///!                                built binary.)

namespace Main;

import std::core::intrinsics;
import std::core::option;
import std::core::result;
import std::collections::str;
import std::env;

// ============================================================================
// Algorithms
// ============================================================================

/// Recursive — exponential time; here for pedagogy, not speed.
function fib_recursive(n: u32) -> u64 {
    if (n < 2) {
        return n as u64;
    }
    return fib_recursive(n - 1) + fib_recursive(n - 2);
}

/// Iterative — O(n) time, O(1) space.
function fib_iterative(n: u32) -> u64 {
    if (n < 2) { return n as u64; }
    mut prev: u64 = 0;
    mut curr: u64 = 1;
    mut i: u32 = 2;
    while (i <= n) {
        const next: u64 = prev + curr;
        prev = curr;
        curr = next;
        i = i + 1;
    }
    return curr;
}

// ============================================================================
// Argument parsing
// ============================================================================

/// Pull the numeric argument out of argv. Default to 10.
function parse_n(args: &Array<String>) -> u32 {
    if (args.length() < 2) {
        return 10;
    }
    // `String` owns heap data, so it isn't `Copy` and the by-value
    // `Array::get` isn't available. `get_ptr` borrows the element in place
    // (`Option<String*>`); the array keeps ownership and `args.drop()`
    // cleans it up. Method calls on the pointer auto-deref.
    match (args.get_ptr(1)) {
        Option::Some(raw) => {
            match (u32::try_from(raw.as_str())) {
                Result::Ok(value) => { return value; }
                Result::Err(_) => {
                    intrinsics::printf("warning: could not parse argument, using default 10\n");
                    return 10;
                }
            }
        }
        Option::None => { return 10; }
    }
}

// ============================================================================
// Entry point
// ============================================================================

function main() -> int {
    mut args: Array<String> = env::args();
    const n: u32 = parse_n(&args);
    args.drop();

    if (n > 92) {
        // 93 already overflows u64. We refuse rather than print
        // garbage.
        intrinsics::printf("error: n must be <= 92 (would overflow u64)\n");
        return 1;
    }

    intrinsics::printf("Fibonacci sequence (n = %u):\n", n);
    mut i: u32 = 0;
    while (i <= n) {
        const value: u64 = fib_iterative(i);
        intrinsics::printf("  fib(%u) = %lu\n", i, value);
        i = i + 1;
    }

    // Recursive sanity-check up to a sensible cap so the demo
    // doesn't appear to hang on big inputs.
    if (n <= 20) {
        intrinsics::printf("\nrecursive verification:\n");
        intrinsics::printf("  fib_recursive(%u) = %lu\n", n, fib_recursive(n));
    }

    return 0;
}
