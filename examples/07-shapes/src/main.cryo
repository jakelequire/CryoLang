///! Shapes - traits, generic dispatch, and bounded type parameters.
///!
///! A canonical "different types share a behaviour" demo: three
///! shape structs (Circle, Rectangle, Triangle), all implementing
///! the `Shape` trait that exposes `area`, `perimeter`, and `name`.
///!
///! What this example demonstrates:
///!   - `type trait` - declaring abstract behaviour.
///!   - `implement trait X for struct Y` - providing the impl.
///!   - Generic functions with `where T: Shape` bounds - the compiler
///!     monomorphizes each call, dispatching statically.
///!   - The `This` self-type - used inside trait bodies to refer
///!     to the implementing type (Cryo's convention, NOT `Self`).
///!
///! Run with:  cryo run

namespace Main;

import std::core::intrinsics;
import std::math;

// ============================================================================
// The trait
// ============================================================================

type trait Shape {
    area(&this) -> f64;
    perimeter(&this) -> f64;
    name(&this) -> string;
}

// ============================================================================
// Circle
// ============================================================================

type struct Circle {
    radius: f64;

    static new(radius: f64) -> Circle {
        return Circle { radius: radius };
    }
}

implement trait Shape for struct Circle {
    area(&this) -> f64 {
        return math::PI * this.radius * this.radius;
    }
    perimeter(&this) -> f64 {
        return 2.0 * math::PI * this.radius;
    }
    name(&this) -> string {
        return "circle";
    }
}

// ============================================================================
// Rectangle
// ============================================================================

type struct Rectangle {
    width: f64;
    height: f64;

    static new(width: f64, height: f64) -> Rectangle {
        return Rectangle { width: width, height: height };
    }

    is_square(&this) -> boolean {
        return this.width == this.height;
    }
}

implement trait Shape for struct Rectangle {
    area(&this) -> f64 {
        return this.width * this.height;
    }
    perimeter(&this) -> f64 {
        return 2.0 * (this.width + this.height);
    }
    name(&this) -> string {
        if (this.is_square()) { return "square"; }
        return "rectangle";
    }
}

// ============================================================================
// Triangle (Heron's formula for area)
// ============================================================================

type struct Triangle {
    a: f64;
    b: f64;
    c: f64;

    static new(a: f64, b: f64, c: f64) -> Triangle {
        return Triangle { a: a, b: b, c: c };
    }
}

implement trait Shape for struct Triangle {
    area(&this) -> f64 {
        const s: f64 = (this.a + this.b + this.c) / 2.0;
        return math::sqrt(s * (s - this.a) * (s - this.b) * (s - this.c));
    }
    perimeter(&this) -> f64 {
        return this.a + this.b + this.c;
    }
    name(&this) -> string {
        return "triangle";
    }
}

// ============================================================================
// Generic helpers - same code path for every Shape impl
// ============================================================================

/// Generic over any type implementing `Shape`. Each call site is
/// monomorphized; there is no virtual dispatch.
function describe<S>(shape: &S) -> void
where S: Shape {
    intrinsics::printf(
        "  %-10s  area=%.4f  perimeter=%.4f\n",
        shape.name(),
        shape.area(),
        shape.perimeter()
    );
}

/// Returns the ratio of a shape's perimeter to its area - a kind of
/// shape-density measure. Shows a generic doing real work, not just
/// printing.
function compactness<S>(shape: &S) -> f64
where S: Shape {
    const a: f64 = shape.area();
    if (a == 0.0) { return 0.0; }
    return shape.perimeter() / a;
}

// ============================================================================
// Entry point
// ============================================================================

function main() -> int {
    intrinsics::printf("shapes - trait-based polymorphism.\n\n");

    const c: Circle    = Circle::new(2.5);
    const r: Rectangle = Rectangle::new(3.0, 4.0);
    const s: Rectangle = Rectangle::new(5.0, 5.0);
    const t: Triangle  = Triangle::new(3.0, 4.0, 5.0);  // classic 3-4-5

    intrinsics::printf("Shapes by their measurements:\n");
    describe(&c);
    describe(&r);
    describe(&s);
    describe(&t);

    intrinsics::printf("\nCompactness (perimeter / area):\n");
    intrinsics::printf("  circle    : %.4f\n", compactness(&c));
    intrinsics::printf("  rectangle : %.4f\n", compactness(&r));
    intrinsics::printf("  square    : %.4f\n", compactness(&s));
    intrinsics::printf("  triangle  : %.4f\n", compactness(&t));

    return 0;
}
