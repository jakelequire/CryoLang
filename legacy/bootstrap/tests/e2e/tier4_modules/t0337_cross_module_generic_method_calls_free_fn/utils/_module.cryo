namespace Utils;

function double_it(x: int) -> int {
    return x * 2;
}

type struct Container<T> {
    items: T[];
    size: int;

    static new() -> Container<T> {
        return Container {
            items: [],
            size: 0,
        };
    }

    add(item: T) -> void {
        this.items.push(item);
        this.size = this.size + 1;
    }

    count() -> int {
        return double_it(this.size);
    }
}
