// @test: cross_module_enum_fn_returning_generic
// @expect: compile_success
// @mode: project
// @stdout: 42
// @stdout: 99
// @tags: modules, project, generics, enums, implement, cross_module, function_type
// @description: Cross-module enum with method taking function param that returns a generic type

namespace Main;

import Optional;
import std::collections::array::{ Array };
import std::collections::hashmap::{ HashMap };
import std::collections::str::{ Str };
import std::collections::string::{ String };
import std::core::drop::{ Drop };
import std::core::option::{ Option };
import std::core::result::{ Result };
import std::fs::path::{ Path };
import std::io::stdio::{ Stdin, stdin };
import std::json::value::{ JsonValue };
import std::net::addr::socket_addr::{ SocketAddr };
import std::net::http::request::{ Request };
import std::net::http::response::{ Response };
import std::net::http::router::{ Router };
import std::net::http::server::{ HttpServer };
import std::net::http::status::{ StatusCode };
import std::sync::atomic::{ Atomic, MemoryOrder };

function fallback() -> Optional::Maybe<int> {
    return Optional::some(99);
}

function main() -> int {
    const a: Optional::Maybe<int> = Optional::some(42);
    const b: Optional::Maybe<int> = Optional::none_int();

    // a is Some(42), or_else should return a unchanged
    const r1: Optional::Maybe<int> = a.or_else(fallback);
    printf("%d\n", r1.unwrap_or(0));

    // b is None, or_else should call fallback() -> Some(99)
    const r2: Optional::Maybe<int> = b.or_else(fallback);
    printf("%d\n", r2.unwrap_or(0));

    return 0;
}
