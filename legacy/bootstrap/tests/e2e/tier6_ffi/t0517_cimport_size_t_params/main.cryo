// @test: cimport_size_t_params
// @expect: compile_success
// @mode: project
// @stdout: length: 11
// @tags: ffi, cimport, size_t, stddef
// @description: CImport with size_t parameters - requires stddef.h preprocessing. Critical for stdlib interop since many C APIs use size_t.

namespace Main;

import std::collections::array::{ Array };
import std::collections::hashmap::{ HashMap };
import std::collections::str::{ Str };
import std::collections::string::{ String };
import std::core::drop::{ Drop };
import std::core::option::{ Option };
import std::core::result::{ Result };
import std::fs::path::{ Path };
import std::io::stdio::{ Stdin, stdin };
import std::json::value::{ JsonValue };
import std::net::addr::socket_addr::{ SocketAddr };
import std::net::http::request::{ Request };
import std::net::http::response::{ Response };
import std::net::http::router::{ Router };
import std::net::http::server::{ HttpServer };
import std::net::http::status::{ StatusCode };
import std::sync::atomic::{ Atomic, MemoryOrder };

c := extern "C" {
    #include "./funcs.h"
}

function main() -> i32 {
    const len: u64 = c::my_strlen("hello world");
    printf("length: %llu\n", len);
    return 0;
}
