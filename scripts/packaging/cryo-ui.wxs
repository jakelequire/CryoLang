<?xml version="1.0" encoding="utf-8"?>
<!--
  The Cryo MSI's wizard.  A first install shows: welcome, the license, the
  install location (a per-user directory, %USERPROFILE%\.cryo unless the
  user picks another), the C toolchain choice, ready, progress, and a finish
  page that says whether this computer links Cryo programs and, when it
  cannot, why and where the full report is.  A second run of the same MSI
  offers repair and removal.

  The stock dialogs come from wixl's ui extension (`wixl ext ui`); the ones
  named Cryo* are this file's.  Every dialog is 370 by 270 units, the size
  of the stock ones, with their banner, bitmap and button positions.  A
  dialog's controls are listed in its tab order, the ones that take focus
  first, so that one of those is the control the dialog opens on.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Fragment>
    <UI Id="CryoUI">
      <TextStyle Id="WixUI_Font_Normal" FaceName="Tahoma" Size="8"/>
      <TextStyle Id="WixUI_Font_Bigger" FaceName="Tahoma" Size="12"/>
      <TextStyle Id="WixUI_Font_Title" FaceName="Tahoma" Size="9" Bold="yes"/>
      <Property Id="DefaultUIFont" Value="WixUI_Font_Normal"/>
      <Property Id="WixUI_Mode" Value="InstallDir"/>

      <DialogRef Id="ErrorDlg"/>
      <DialogRef Id="FilesInUse"/>
      <DialogRef Id="MsiRMFilesInUse"/>
      <DialogRef Id="PrepareDlg"/>
      <DialogRef Id="ProgressDlg"/>
      <DialogRef Id="ResumeDlg"/>
      <DialogRef Id="UserExit"/>
      <DialogRef Id="WelcomeDlg"/>
      <DialogRef Id="MaintenanceWelcomeDlg"/>
      <DialogRef Id="MaintenanceTypeDlg"/>
      <DialogRef Id="VerifyReadyDlg"/>

      <ProgressText Action="DependencyStep">Checking that this computer can link a Cryo program</ProgressText>

      <!-- License -->
      <Dialog Id="CryoLicenseDlg" Width="370" Height="270" Title="[ProductName] Setup">
        <Control Id="LicenseAcceptedCheckBox" Type="CheckBox" X="20" Y="207" Width="330" Height="18" CheckBoxValue="1" Property="LicenseAccepted" Text="I &amp;accept the terms in the License Agreement"/>
        <Control Id="Back" Type="PushButton" X="180" Y="243" Width="56" Height="17" Text="&amp;Back">
          <Publish Event="NewDialog" Value="WelcomeDlg"/>
        </Control>
        <Control Id="Next" Type="PushButton" X="236" Y="243" Width="56" Height="17" Default="yes" Text="&amp;Next"
                 DisableCondition="LicenseAccepted &lt;&gt; &quot;1&quot;" EnableCondition="LicenseAccepted = &quot;1&quot;">
          <Publish Event="NewDialog" Value="CryoInstallDirDlg" Condition="LicenseAccepted = &quot;1&quot;"/>
        </Control>
        <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Cancel="yes" Text="Cancel">
          <Publish Event="SpawnDialog" Value="CancelDlg"/>
        </Control>
        <Control Id="LicenseText" Type="ScrollableText" X="20" Y="60" Width="330" Height="140" Sunken="yes">
          <Text SourceFile="$(var.LicenseRtf)"/>
        </Control>
        <Control Id="BannerBitmap" Type="Bitmap" X="0" Y="0" Width="370" Height="44" Text="WixUI_Bmp_Banner"/>
        <Control Id="BannerLine" Type="Line" X="0" Y="44" Width="370" Height="0"/>
        <Control Id="Title" Type="Text" X="15" Y="6" Width="200" Height="15" Transparent="yes" NoPrefix="yes" Text="{\WixUI_Font_Title}License Agreement"/>
        <Control Id="Description" Type="Text" X="25" Y="23" Width="340" Height="15" Transparent="yes" NoPrefix="yes" Text="Please read the license of [ProductName], the Apache License 2.0."/>
        <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="370" Height="0"/>
      </Dialog>

      <!-- Install location -->
      <Dialog Id="CryoInstallDirDlg" Width="370" Height="270" Title="[ProductName] Setup">
        <Control Id="ChangeFolder" Type="PushButton" X="20" Y="120" Width="56" Height="17" Text="&amp;Change...">
          <Publish Event="SpawnDialog" Value="CryoBrowseDlg"/>
        </Control>
        <Control Id="Back" Type="PushButton" X="180" Y="243" Width="56" Height="17" Text="&amp;Back">
          <Publish Event="NewDialog" Value="CryoLicenseDlg"/>
        </Control>
        <Control Id="Next" Type="PushButton" X="236" Y="243" Width="56" Height="17" Default="yes" Text="&amp;Next">
          <Publish Event="SetTargetPath" Value="INSTALLDIR" Order="1"/>
          <Publish Event="NewDialog" Value="CryoToolchainDlg" Order="2"/>
        </Control>
        <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Cancel="yes" Text="Cancel">
          <Publish Event="SpawnDialog" Value="CancelDlg"/>
        </Control>
        <Control Id="Folder" Type="PathEdit" X="20" Y="100" Width="320" Height="18" Property="INSTALLDIR"/>
        <Control Id="BannerBitmap" Type="Bitmap" X="0" Y="0" Width="370" Height="44" Text="WixUI_Bmp_Banner"/>
        <Control Id="BannerLine" Type="Line" X="0" Y="44" Width="370" Height="0"/>
        <Control Id="Title" Type="Text" X="15" Y="6" Width="200" Height="15" Transparent="yes" NoPrefix="yes" Text="{\WixUI_Font_Title}Install Location"/>
        <Control Id="Description" Type="Text" X="25" Y="23" Width="340" Height="15" Transparent="yes" NoPrefix="yes" Text="Where [ProductName] is installed, for you alone."/>
        <Control Id="FolderLabel" Type="Text" X="20" Y="60" Width="290" Height="30" NoPrefix="yes" Text="Install [ProductName] to this folder. Its bin directory is added to your PATH."/>
        <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="370" Height="0"/>
      </Dialog>

      <Dialog Id="CryoBrowseDlg" Width="370" Height="270" Title="[ProductName] Setup">
        <Control Id="Up" Type="PushButton" X="286" Y="55" Width="28" Height="17" ToolTip="Up one level" Text="&amp;Up">
          <Publish Event="DirectoryListUp" Value="0"/>
        </Control>
        <Control Id="NewFolder" Type="PushButton" X="317" Y="55" Width="28" Height="17" ToolTip="Create a new folder" Text="Ne&amp;w">
          <Publish Event="DirectoryListNew" Value="0"/>
        </Control>
        <Control Id="OK" Type="PushButton" X="240" Y="243" Width="56" Height="17" Default="yes" Text="OK">
          <Publish Event="SetTargetPath" Value="INSTALLDIR" Order="1"/>
          <Publish Event="EndDialog" Value="Return" Order="2"/>
        </Control>
        <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Cancel="yes" Text="Cancel">
          <Publish Event="Reset" Value="0" Order="1"/>
          <Publish Event="EndDialog" Value="Return" Order="2"/>
        </Control>
        <Control Id="DirectoryCombo" Type="DirectoryCombo" X="70" Y="55" Width="210" Height="80" Property="INSTALLDIR" Fixed="yes" Remote="yes">
          <Subscribe Event="IgnoreChange" Attribute="IgnoreChange"/>
        </Control>
        <Control Id="DirectoryList" Type="DirectoryList" X="25" Y="83" Width="320" Height="98" Property="INSTALLDIR" Sunken="yes"/>
        <Control Id="PathEdit" Type="PathEdit" X="25" Y="202" Width="320" Height="18" Property="INSTALLDIR"/>
        <Control Id="BannerBitmap" Type="Bitmap" X="0" Y="0" Width="370" Height="44" Text="WixUI_Bmp_Banner"/>
        <Control Id="BannerLine" Type="Line" X="0" Y="44" Width="370" Height="0"/>
        <Control Id="Title" Type="Text" X="15" Y="6" Width="200" Height="15" Transparent="yes" NoPrefix="yes" Text="{\WixUI_Font_Title}Change Install Location"/>
        <Control Id="Description" Type="Text" X="25" Y="23" Width="340" Height="15" Transparent="yes" NoPrefix="yes" Text="Browse to the folder to install [ProductName] to."/>
        <Control Id="ComboLabel" Type="Text" X="25" Y="58" Width="44" Height="10" Text="Look in:"/>
        <Control Id="PathLabel" Type="Text" X="25" Y="190" Width="320" Height="10" Text="Folder name:"/>
        <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="370" Height="0"/>
      </Dialog>

      <!-- The C toolchain: the consent the dependency step acts on -->
      <Dialog Id="CryoToolchainDlg" Width="370" Height="270" Title="[ProductName] Setup">
        <Control Id="InstallToolchain" Type="CheckBox" X="20" Y="125" Width="330" Height="30" CheckBoxValue="1" Property="CRYO_INSTALL_TOOLCHAIN" Text="If this computer has &amp;none, install llvm-mingw for me with winget."/>
        <Control Id="Back" Type="PushButton" X="180" Y="243" Width="56" Height="17" Text="&amp;Back">
          <Publish Event="NewDialog" Value="CryoInstallDirDlg"/>
        </Control>
        <Control Id="Next" Type="PushButton" X="236" Y="243" Width="56" Height="17" Default="yes" Text="&amp;Next">
          <Publish Event="NewDialog" Value="VerifyReadyDlg"/>
        </Control>
        <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Cancel="yes" Text="Cancel">
          <Publish Event="SpawnDialog" Value="CancelDlg"/>
        </Control>
        <Control Id="BannerBitmap" Type="Bitmap" X="0" Y="0" Width="370" Height="44" Text="WixUI_Bmp_Banner"/>
        <Control Id="BannerLine" Type="Line" X="0" Y="44" Width="370" Height="0"/>
        <Control Id="Title" Type="Text" X="15" Y="6" Width="200" Height="15" Transparent="yes" NoPrefix="yes" Text="{\WixUI_Font_Title}C Toolchain"/>
        <Control Id="Description" Type="Text" X="25" Y="23" Width="340" Height="15" Transparent="yes" NoPrefix="yes" Text="What [ProductName] needs to link the programs it compiles."/>
        <Control Id="Explanation" Type="Text" X="20" Y="60" Width="330" Height="60" NoPrefix="yes" Text="Cryo links every program it compiles with a C toolchain (gcc or clang). Once its files are installed, Setup builds and runs a small program to check that a new terminal on this computer can link one, and says on the last page whether it can."/>
        <Control Id="Command" Type="Text" X="32" Y="158" Width="318" Height="30" NoPrefix="yes" Text="It runs: winget install --exact --id MartinStorsjo.LLVM-MinGW.UCRT --scope user. Nothing is installed when a toolchain is already there."/>
        <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="370" Height="0"/>
      </Dialog>

      <!-- Finish: what the install did, and what is missing -->
      <Dialog Id="CryoExitDlg" Width="370" Height="270" Title="[ProductName] Setup">
        <Control Id="Finish" Type="PushButton" X="236" Y="243" Width="56" Height="17" Default="yes" Cancel="yes" Text="&amp;Finish">
          <Publish Event="EndDialog" Value="Return"/>
        </Control>
        <Control Id="Back" Type="PushButton" X="180" Y="243" Width="56" Height="17" Disabled="yes" Text="Back"/>
        <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Disabled="yes" Text="Cancel"/>
        <Control Id="Bitmap" Type="Bitmap" X="0" Y="0" Width="370" Height="234" Text="WixUI_Bmp_Dialog"/>
        <Control Id="Title" Type="Text" X="135" Y="20" Width="220" Height="40" Transparent="yes" NoPrefix="yes" Hidden="yes"
                 Text="{\WixUI_Font_Bigger}Completed the [ProductName] Setup Wizard"
                 ShowCondition="CRYO_DEPENDENCY_STATUS &lt;&gt; &quot;failed&quot;"/>
        <Control Id="FailedTitle" Type="Text" X="135" Y="20" Width="220" Height="40" Transparent="yes" NoPrefix="yes" Hidden="yes"
                 Text="{\WixUI_Font_Bigger}[ProductName] is installed, but cannot link programs yet"
                 ShowCondition="CRYO_DEPENDENCY_STATUS = &quot;failed&quot;"/>
        <Control Id="Linked" Type="Text" X="135" Y="65" Width="220" Height="120" Transparent="yes" NoPrefix="yes" Hidden="yes"
                 Text="[ProductName] is installed in [INSTALLDIR], its bin directory is on your PATH, and this computer links Cryo programs. Open a new terminal and run: cryo version --verbose"
                 ShowCondition="CRYO_DEPENDENCY_STATUS = &quot;ok&quot;"/>
        <Control Id="Failed" Type="Text" X="135" Y="65" Width="220" Height="160" Transparent="yes" NoPrefix="yes" Hidden="yes"
                 Text="[CRYO_DEPENDENCY_REPORT] The full report is in [CRYO_DEPENDENCY_LOG]. Install a C toolchain, or run [INSTALLDIR]install-dependencies.ps1 in a terminal, then open a new terminal."
                 ShowCondition="CRYO_DEPENDENCY_STATUS = &quot;failed&quot;"/>
        <Control Id="Finished" Type="Text" X="135" Y="65" Width="220" Height="40" Transparent="yes" NoPrefix="yes" Hidden="yes"
                 Text="Click the Finish button to exit the Setup Wizard."
                 ShowCondition="NOT CRYO_DEPENDENCY_STATUS"/>
        <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="370" Height="0"/>
      </Dialog>

      <!-- An install that failed before its files were in place -->
      <Dialog Id="CryoFatalErrorDlg" Width="370" Height="270" Title="[ProductName] Setup">
        <Control Id="Finish" Type="PushButton" X="236" Y="243" Width="56" Height="17" Default="yes" Cancel="yes" Text="&amp;Finish">
          <Publish Event="EndDialog" Value="Exit"/>
        </Control>
        <Control Id="Back" Type="PushButton" X="180" Y="243" Width="56" Height="17" Disabled="yes" Text="Back"/>
        <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Disabled="yes" Text="Cancel"/>
        <Control Id="Bitmap" Type="Bitmap" X="0" Y="0" Width="370" Height="234" Text="WixUI_Bmp_Dialog"/>
        <Control Id="Title" Type="Text" X="135" Y="20" Width="220" Height="40" Transparent="yes" NoPrefix="yes" Text="{\WixUI_Font_Bigger}[ProductName] Setup Wizard ended prematurely"/>
        <Control Id="Description" Type="Text" X="135" Y="70" Width="220" Height="100" Transparent="yes" NoPrefix="yes" Text="[ProductName] Setup ended because of an error, and your system has not been changed. Run the installer from a terminal with a log to see the error: msiexec /i &lt;the .msi file&gt; /l*v install.log"/>
        <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="370" Height="0"/>
      </Dialog>

      <!-- The way through: first install, then maintenance -->
      <Publish Dialog="WelcomeDlg" Control="Next" Event="NewDialog" Value="CryoLicenseDlg" Condition="NOT Installed"/>
      <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog" Value="CryoToolchainDlg" Order="1" Condition="NOT Installed"/>
      <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog" Value="MaintenanceTypeDlg" Order="2" Condition="Installed"/>
      <Publish Dialog="MaintenanceWelcomeDlg" Control="Next" Event="NewDialog" Value="MaintenanceTypeDlg"/>
      <Publish Dialog="MaintenanceTypeDlg" Control="RepairButton" Event="NewDialog" Value="VerifyReadyDlg"/>
      <Publish Dialog="MaintenanceTypeDlg" Control="RemoveButton" Event="NewDialog" Value="VerifyReadyDlg"/>
      <Publish Dialog="MaintenanceTypeDlg" Control="Back" Event="NewDialog" Value="MaintenanceWelcomeDlg"/>

      <InstallUISequence>
        <Show Dialog="CryoExitDlg" OnExit="success"/>
        <Show Dialog="CryoFatalErrorDlg" OnExit="error"/>
      </InstallUISequence>
      <AdminUISequence>
        <Show Dialog="CryoExitDlg" OnExit="success"/>
        <Show Dialog="CryoFatalErrorDlg" OnExit="error"/>
      </AdminUISequence>
    </UI>

    <UIRef Id="WixUI_Common"/>
  </Fragment>
</Wix>
