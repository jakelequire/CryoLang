<?xml version="1.0" encoding="utf-8"?>
<!--
  The Cryo MSI: a per-user install of the Windows release tree, by default
  into %USERPROFILE%\.cryo, the place install.ps1 installs to.  Built on
  Linux by scripts/build-msi.sh with wixl, with the tree's files harvested
  by wixl-heat into the CryoFiles component group and the wizard of
  cryo-ui.wxs.

  Beyond its files, the MSI runs the tree's user-setup.ps1 (the script
  install.ps1 runs too) as the installing user to add the install's bin
  directory to the User PATH (and to remove it, with the archives the
  install built in the user's cache, before uninstalling), and, from the
  wizard, the install's dependency step (dependency-step.js), which checks
  that the installed compiler links a program and, when the user agreed,
  installs a C toolchain through winget.  A quiet install (winget's) runs
  no wizard, so no dependency step; winget installs the toolchain as the
  package's dependency.

  The dependency step runs in the wizard, as the user, and not in the
  install's own sequence: an action there is started by the Windows
  Installer service with the service's environment, which holds neither
  the user's PATH nor their winget.  For the same reason the actions that
  do run there are given what they need from the user's environment as
  arguments (the user's cache root, from LocalAppDataFolder), or read it
  from the user's registry (the User PATH).
-->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Product Id="*" Name="Cryo" Language="1033" Version="$(var.Version)"
           Manufacturer="CryoLang" UpgradeCode="6B1A3E2C-9C1D-4F3E-8A57-2D0C5E4B7A19">
    <Package InstallerVersion="500" Compressed="yes" InstallScope="perUser"
             Description="The Cryo compiler, standard library, runtime and language server"/>
    <MajorUpgrade DowngradeErrorMessage="A newer Cryo is already installed."/>
    <Media Id="1" Cabinet="cryo.cab" EmbedCab="yes"/>

    <Property Id="ARPURLINFOABOUT" Value="https://cryolang.org"/>
    <Property Id="ARPNOMODIFY" Value="1"/>
    <!-- The wizard's toolchain checkbox, ticked until the user clears it. -->
    <Property Id="CRYO_INSTALL_TOOLCHAIN" Value="1"/>
    <!-- Where the install was put, read back by every later run (repair,
         upgrade, removal) before the default below applies. -->
    <Property Id="INSTALLDIR">
      <RegistrySearch Id="RememberedInstallDirectory" Root="HKCU" Key="Software\CryoLang\Cryo"
                      Name="InstallDirectory" Type="raw"/>
    </Property>

    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="INSTALLDIR" Name=".cryo">
        <Component Id="InstallDirectoryRecord" Guid="3F6C2B8E-71D4-4C1A-9E35-5A2B7D0C9E41">
          <RegistryValue Root="HKCU" Key="Software\CryoLang\Cryo" Name="InstallDirectory"
                         Type="string" Value="[INSTALLDIR]" KeyPath="yes"/>
        </Component>
      </Directory>
    </Directory>

    <Feature Id="Cryo" Level="1">
      <ComponentGroupRef Id="CryoFiles"/>
      <ComponentRef Id="InstallDirectoryRecord"/>
    </Feature>

    <UIRef Id="CryoUI"/>

    <Binary Id="DependencyStepScript" SourceFile="$(var.DependencyStepScript)"/>

    <!-- Where the files go unless a property, the wizard or the record
         above chose, and where Apps & Features (and install.ps1, which
         leaves an MSI's install to the MSI) finds them. -->
    <CustomAction Id="SetInstallDirectory" Property="INSTALLDIR" Value="[%USERPROFILE]\.cryo\"/>
    <CustomAction Id="SetInstallLocation" Property="ARPINSTALLLOCATION" Value="[INSTALLDIR]"/>
    <CustomAction Id="SetPowerShell" Property="POWERSHELL"
                  Value="[System64Folder]WindowsPowerShell\v1.0\powershell.exe"/>
    <CustomAction Id="SetDependencyLog" Property="CRYO_DEPENDENCY_LOG"
                  Value="[LocalAppDataFolder]cryo\install-dependencies.log"/>

    <CustomAction Id="AddToPath" Property="POWERSHELL" Execute="immediate" Return="ignore"
                  ExeCommand="-NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;[INSTALLDIR]user-setup.ps1&quot; -AddToPath"/>
    <CustomAction Id="DependencyStep" BinaryKey="DependencyStepScript" JScriptCall="DependencyStep" Return="check"/>
    <CustomAction Id="RemoveFromPath" Property="POWERSHELL" Execute="deferred" Impersonate="yes" Return="ignore"
                  ExeCommand="-NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;[INSTALLDIR]user-setup.ps1&quot; -RemoveFromPath -RemoveArchives -CacheRoot &quot;[LocalAppDataFolder]cryo&quot;"/>

    <!-- wixl places an action given only After= at the end of the sequence
         and one given only Before= at its start, so every action is given
         its number.  AppSearch is 50 and CostFinalize 1000 in both
         sequences, ExecuteAction 1300 in the wizard's.  The removal's
         action is deferred, so it runs inside the transaction
         InstallInitialize (1500) opens, before RemoveFiles (3500) takes its
         script away. -->
    <InstallUISequence>
      <Custom Action="SetInstallDirectory" Sequence="990">NOT INSTALLDIR</Custom>
      <Custom Action="SetPowerShell" Sequence="1002"/>
      <Custom Action="SetDependencyLog" Sequence="1003"/>
      <Custom Action="DependencyStep" Sequence="1301">NOT Installed AND NOT REMOVE</Custom>
    </InstallUISequence>
    <InstallExecuteSequence>
      <Custom Action="SetInstallDirectory" Sequence="990">NOT INSTALLDIR</Custom>
      <Custom Action="SetInstallLocation" Sequence="1001"/>
      <Custom Action="SetPowerShell" Sequence="1002"/>
      <!-- An upgrade removes the older Cryo whole, right after
           InstallValidate (1400), before it installs anything. -->
      <RemoveExistingProducts Sequence="1401"/>
      <Custom Action="RemoveFromPath" Sequence="3490">REMOVE="ALL" AND NOT UPGRADINGPRODUCTCODE</Custom>
      <Custom Action="AddToPath" Sequence="6601">NOT Installed AND NOT REMOVE</Custom>
    </InstallExecuteSequence>
  </Product>
</Wix>
