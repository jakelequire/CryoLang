///! One-off codemod: `std::json` moved to `std::encoding::json`.
///!
///!   json-module-codemod <file>...
///!
///! Rewrites every `std::json` that is a whole path segment (not followed by
///! a letter, digit or `_`) in each named file to `std::encoding::json`, and
///! prints each file with the number of paths rewritten. The file list comes
///! from `git grep -l "std::json"`.

namespace JsonModuleCodemod;

import std::fs::{ File, Path };
import std::env;
import std::fmt::{ println };

type struct PathRename {
    /// Whether `byte` continues an identifier, so `std::json` before it is
    /// a longer name and not the module.
    static continues_identifier(byte: u8) -> boolean {
        return (byte as char).is_alphanumeric() || byte == '_' as u8;
    }

    /// `text` with every whole `std::json` segment written as
    /// `std::encoding::json`, and how many there were.
    static rewrite(text: Str) -> (String, i64) {
        const old: Str = Str::new("std::json");
        mut out: String = String::new();
        mut count: i64 = 0;
        mut at: i64 = 0;
        while (at < text.length()) {
            const rest: Str = text.byte_substring(at, text.length());
            match (rest.find(&old)) {
                Option::None => {
                    out.append(rest);
                    at = text.length();
                }
                Option::Some(found) => {
                    const end: i64 = at + found + old.length();
                    out.append(text.byte_substring(at, at + found));
                    const whole: boolean = match (text.byte_at(end)) {
                        Option::Some(next) => { !PathRename::continues_identifier(next) }
                        Option::None       => { true }
                    };
                    if (whole) {
                        out.append("std::encoding::json");
                        count += 1;
                    } else {
                        out.append(old);
                    }
                    at = end;
                }
            }
        }
        return (out, count);
    }
}

function main() -> int {
    const arguments: Array<String> = env::args();
    mut failed: boolean = false;
    for (mut i: i64 = 1; i < arguments.length(); i++) {
        const path: Path = Path::from(arguments[i].as_str());
        match (File::read_text(path)) {
            Result::Err(error) => {
                println(f"FAILED to read {arguments[i]}");
                failed = true;
            }
            Result::Ok(text) => {
                const rewritten: (String, i64) = PathRename::rewrite(text.as_str());
                if (rewritten.1 > 0) {
                    match (File::write_text(path, rewritten.0.as_str())) {
                        Result::Err(error) => {
                            println(f"FAILED to write {arguments[i]}");
                            failed = true;
                        }
                        Result::Ok(_) => { println(f"{rewritten.1} {arguments[i]}"); }
                    }
                }
            }
        }
    }
    return if (failed) { 1 } else { 0 };
}
