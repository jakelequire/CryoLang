///! One-off codemod for the change that makes the print family take
///! `fmt::Arguments`: an argument of `print`, `println`, `eprint` or
///! `eprintln` written as a `String` made from a literal -
///! `String::from_string("text")`, `String::from("text")`,
///! `String::from_str("text")` or `String::from_str(Str::new("text"))` -
///! becomes the literal, which the literal converter makes the arguments of,
///! and any other `String::from_str(view)` becomes the view, a `Str`.
///! Rewrites each file named on the command line in place and prints how
///! many arguments it changed.

import std::core::option::{ Option };
import std::core::result::{ Result };
import std::collections::array::{ Array };
import std::collections::str::{ Str };
import std::collections::string::{ String };
import std::env;
import std::fmt::{ println, eprintln };
import std::fs::{ File, Path };

type struct Codemod {
    text: Str;

    byte(&this, index: i64) -> u8 {
        return match (this.text.byte_at(index)) {
            Option::Some(b) => { b }
            Option::None => { 0 }
        };
    }

    static is_identifier_byte(b: u8) -> boolean {
        return (b >= 'a' as u8 && b <= 'z' as u8) || (b >= 'A' as u8 && b <= 'Z' as u8)
            || (b >= '0' as u8 && b <= '9' as u8) || b == '_' as u8;
    }

    spells(&this, index: i64, word: Str) -> boolean {
        if (index + word.length() > this.text.length()) { return false; }
        return this.text.byte_substring(index, index + word.length()) == word;
    }

    /// End index (exclusive) of the string literal starting at `index`, or -1.
    literal_end(&this, index: i64) -> i64 {
        if (this.byte(index) != '"' as u8) { return -1; }
        mut i: i64 = index + 1;
        while (i < this.text.length()) {
            const b: u8 = this.byte(i);
            if (b == '\\' as u8) { i = i + 2; continue; }
            if (b == '"' as u8) { return i + 1; }
            if (b == '\n' as u8) { return -1; }
            i++;
        }
        return -1;
    }

    /// The print-family call whose name ends just before `open` (its `(`).
    opens_print_call(&this, open: i64) -> boolean {
        mut start: i64 = open;
        while (start > 0 && Codemod::is_identifier_byte(this.byte(start - 1))) { start--; }
        if (start == open) { return false; }
        if (start > 0 && this.byte(start - 1) == '.' as u8) { return false; }
        const name: Str = this.text.byte_substring(start, open);
        return name == Str::new("print") || name == Str::new("println")
            || name == Str::new("eprint") || name == Str::new("eprintln");
    }

    /// At `index`, a wrapper around a literal followed by the call's `)`:
    /// the literal's start and end, and where the argument ends.
    wrapped_literal(&this, index: i64) -> Option<(i64, i64, i64)> {
        mut prefixes: Array<Str> = Array::<Str>::new();
        prefixes.push(Str::new("String::from_str(Str::new("));
        prefixes.push(Str::new("String::from_string("));
        prefixes.push(Str::new("String::from_str("));
        prefixes.push(Str::new("String::from("));
        mut k: i64 = 0;
        while (k < prefixes.length()) {
            const prefix: Str = prefixes[k];
            if (this.spells(index, prefix)) {
                const start: i64 = index + prefix.length();
                const end: i64 = this.literal_end(start);
                if (end < 0) { return this.wrapped_view(index); }
                // One `)` per `(` the prefix opened.
                const closes: i64 = if (k == 0) { 2 } else { 1 };
                mut at: i64 = end;
                mut c: i64 = 0;
                while (c < closes) {
                    if (this.byte(at) != ')' as u8) { return this.wrapped_view(index); }
                    at++;
                    c++;
                }
                while (this.byte(at) == ' ' as u8) { at++; }
                if (this.byte(at) != ')' as u8) { return this.wrapped_view(index); }
                return Option::Some((start, end, at));
            }
            k++;
        }
        return this.wrapped_view(index);
    }

    /// At `index`, `String::from_str(view)` followed by the call's `)`: the
    /// view is a `Str` already, so it is the argument.  The view's start and
    /// end, and where the argument ends.
    wrapped_view(&this, index: i64) -> Option<(i64, i64, i64)> {
        const prefix: Str = Str::new("String::from_str(");
        if (!this.spells(index, prefix)) { return Option::None; }
        const start: i64 = index + prefix.length();
        mut depth: i64 = 0;
        mut at: i64 = start;
        while (at < this.text.length()) {
            const b: u8 = this.byte(at);
            if (b == '"' as u8) {
                const end: i64 = this.literal_end(at);
                if (end < 0) { return Option::None; }
                at = end;
                continue;
            }
            if (b == '(' as u8) { depth++; }
            if (b == ')' as u8) {
                if (depth == 0) { break; }
                depth--;
            }
            at++;
        }
        if (at >= this.text.length()) { return Option::None; }
        const end: i64 = at;
        at++;
        while (this.byte(at) == ' ' as u8) { at++; }
        if (this.byte(at) != ')' as u8) { return Option::None; }
        return Option::Some((start, end, at));
    }

    static rewrite(path: Str) -> i64 {
        const source: String = match (File::read_text(Path::from(path))) {
            Result::Ok(text) => { text }
            Result::Err(e) => {
                eprintln(f"print-arguments-codemod: cannot read {path}: {e}");
                return -1;
            }
        };
        const codemod: Codemod = Codemod { text: source.as_str() };
        mut out: String = String::with_capacity(source.length());
        mut changed: i64 = 0;
        mut i: i64 = 0;
        mut copied: i64 = 0;
        while (i < codemod.text.length()) {
            if (codemod.byte(i) == '(' as u8 && codemod.opens_print_call(i)) {
                mut j: i64 = i + 1;
                while (codemod.byte(j) == ' ' as u8) { j++; }
                match (codemod.wrapped_literal(j)) {
                    Option::Some(found) => {
                        out.append(codemod.text.byte_substring(copied, j));
                        out.append(codemod.text.byte_substring(found.0, found.1));
                        copied = found.2;
                        i = found.2;
                        changed++;
                        continue;
                    }
                    Option::None => { }
                }
            }
            i++;
        }
        if (changed == 0) { return 0; }
        out.append(codemod.text.byte_substring(copied, codemod.text.length()));
        match (File::write_text(Path::from(path), out.as_str())) {
            Result::Ok(_) => { }
            Result::Err(e) => {
                eprintln(f"print-arguments-codemod: cannot write {path}: {e}");
                return -1;
            }
        }
        return changed;
    }
}

/// The second pass: a build log's refusals of a `String` where the print
/// family declares `Arguments`, each at the argument's first byte.
type struct LogPass {
    static number(text: Str) -> i64 {
        mut value: i64 = 0;
        mut i: i64 = 0;
        while (i < text.length()) {
            const b: u8 = text.byte_at(i).unwrap();
            if (b < '0' as u8 || b > '9' as u8) { break; }
            value = value * 10 + (b - '0' as u8) as i64;
            i++;
        }
        return value;
    }

    /// Rewrite the argument starting at (`line`, `column`) of `path`:
    /// `String::new()` becomes `""`, `x.clone()` becomes `x.as_str()`, and
    /// any other `String` is passed as its view.  1 when it was rewritten.
    static rewrite_argument(path: Str, line: i64, column: i64) -> i64 {
        const source: String = match (File::read_text(Path::from(path))) {
            Result::Ok(text) => { text }
            Result::Err(e) => {
                eprintln(f"print-arguments-codemod: cannot read {path}: {e}");
                return -1;
            }
        };
        const codemod: Codemod = Codemod { text: source.as_str() };
        const text: Str = source.as_str();
        mut start: i64 = 0;
        mut current: i64 = 1;
        while (current < line && start < text.length()) {
            if (codemod.byte(start) == '\n' as u8) { current++; }
            start++;
        }
        start = start + column - 1;
        mut depth: i64 = 0;
        mut simple: boolean = true;
        mut end: i64 = start;
        while (end < text.length()) {
            const b: u8 = codemod.byte(end);
            if (b == '"' as u8) {
                const close: i64 = codemod.literal_end(end);
                if (close < 0) { return 0; }
                end = close;
                continue;
            }
            if (b == '(' as u8 || b == '[' as u8) { depth++; }
            if (b == ')' as u8 || b == ']' as u8) {
                if (depth == 0) { break; }
                depth--;
            }
            if (depth == 0 && (b == ' ' as u8 || b == ',' as u8)) { simple = false; }
            end++;
        }
        if (end >= text.length()) { return 0; }
        const argument: Str = text.byte_substring(start, end);
        mut replacement: String = String::new();
        const clone: Str = Str::new(".clone()");
        if (argument == Str::new("String::new()")) {
            replacement.append(Str::new("\"\""));
        } else if (argument.ends_with(clone) && simple) {
            replacement.append(argument.byte_substring(0, argument.length() - clone.length()));
            replacement.append(Str::new(".as_str()"));
        } else if (simple) {
            replacement.append(argument);
            replacement.append(Str::new(".as_str()"));
        } else {
            replacement.append(Str::new("("));
            replacement.append(argument);
            replacement.append(Str::new(").as_str()"));
        }
        mut out: String = String::with_capacity(text.length() + 16);
        out.append(text.byte_substring(0, start));
        out.append(replacement.as_str());
        out.append(text.byte_substring(end, text.length()));
        match (File::write_text(Path::from(path), out.as_str())) {
            Result::Ok(_) => { }
            Result::Err(e) => {
                eprintln(f"print-arguments-codemod: cannot write {path}: {e}");
                return -1;
            }
        }
        return 1;
    }

    static run(base: Str, log_path: Str) -> i32 {
        const log: String = match (File::read_text(Path::from(log_path))) {
            Result::Ok(text) => { text }
            Result::Err(e) => {
                eprintln(f"print-arguments-codemod: cannot read {log_path}: {e}");
                return 1;
            }
        };
        const text: Str = log.as_str();
        mut directory: String = String::from_str(base);
        mut location: String = String::new();
        mut files: Array<String> = Array::<String>::new();
        mut lines: Array<i64> = Array::<i64>::new();
        mut columns: Array<i64> = Array::<i64>::new();
        mut start: i64 = 0;
        while (start < text.length()) {
            mut end: i64 = start;
            while (end < text.length() && text.byte_at(end).unwrap() != '\n' as u8) { end++; }
            mut line: Str = text.byte_substring(start, end);
            if (line.length() > 0 && line.byte_at(line.length() - 1).unwrap() == '\r' as u8) {
                line = line.byte_substring(0, line.length() - 1);
            }
            start = end + 1;
            const heading: Str = Str::new("=== TOOL ");
            if (line.starts_with(heading)) {
                directory = String::from_str(base);
                directory.append(Str::new("/"));
                directory.append(line.byte_substring(heading.length(), line.length()));
                continue;
            }
            if (line.starts_with("error[")) { location = String::new(); continue; }
            const arrow: Str = Str::new(" --> ");
            if (line.starts_with(arrow) && location.length() == 0) {
                location = String::from_str(line.byte_substring(arrow.length(), line.length()));
                continue;
            }
            if (location.length() > 0
                    && line.contains("expected `std::fmt::interpolation::Arguments`, found `std::collections::string::String")) {
                const at: Str = location.as_str();
                const colon2: i64 = at.find_last(":").unwrap();
                const colon1: i64 = at.byte_substring(0, colon2).find_last(":").unwrap();
                mut full: String = String::from_str(directory.as_str());
                full.append(Str::new("/"));
                full.append(at.byte_substring(0, colon1));
                files.push(full);
                lines.push(LogPass::number(at.byte_substring(colon1 + 1, colon2)));
                columns.push(LogPass::number(at.byte_substring(colon2 + 1, at.length())));
                location = String::new();
            }
        }
        // Last first, so an edit never moves a column still to be visited.
        mut total: i64 = 0;
        mut index: i64 = files.length() - 1;
        while (index >= 0) {
            const done: i64 = LogPass::rewrite_argument(files[index].as_str(), lines[index], columns[index]);
            if (done < 0) { return 1; }
            total = total + done;
            index--;
        }
        println(f"print-arguments-codemod: rewrote {total} arguments from the log");
        return 0;
    }
}

function main() -> i32 {
    const arguments: Array<String> = env::args();
    if (arguments.length() == 4 && arguments[1].as_str() == Str::new("--log")) {
        return LogPass::run(arguments[2].as_str(), arguments[3].as_str());
    }
    mut total: i64 = 0;
    mut files: i64 = 0;
    mut i: i64 = 1;
    while (i < arguments.length()) {
        const changed: i64 = Codemod::rewrite(arguments[i].as_str());
        if (changed < 0) { return 1; }
        if (changed > 0) { files++; }
        total = total + changed;
        i++;
    }
    println(f"print-arguments-codemod: {total} arguments in {files} files");
    return 0;
}
