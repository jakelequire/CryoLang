#!/usr/bin/env bash
# Cryo commit-msg hook.  Installed by `make install-hooks`, which points
# core.hooksPath at this directory.
#
# A shim on purpose: the rules live in scripts/ns-commit-guard.py, where they
# can be run directly against a staged tree and broken on demand to prove they
# work.  A rule that only ever executes inside a hook is a rule nobody has
# watched fail.
set -u

repo="$(git rev-parse --show-toplevel 2>/dev/null)" || exit 0
[ -n "$repo" ] || exit 0

# Pick an interpreter by RUNNING it, not by finding it on PATH.  Windows ships
# an App Execution Alias at ...\WindowsApps\python3.exe which `command -v`
# resolves happily and which prints "Python was not found" and exits 49.  A
# hook that picked it did nothing at all, silently, on every commit - the
# failure mode a hook has to be built against, since nobody notices a guard
# that stopped guarding.
py=""
for c in python3 python py; do
    if command -v "$c" >/dev/null 2>&1 && "$c" -c "import sys" >/dev/null 2>&1; then
        py="$c"; break
    fi
done
if [ -z "$py" ]; then
    echo "commit-msg: no working python on PATH; the ledger guard did NOT run." >&2
    echo "  This commit is going through unchecked.  Install python, or run" >&2
    echo "  scripts/ns-commit-guard.py by hand." >&2
    exit 0
fi

exec "$py" "$repo/scripts/ns-commit-guard.py" --message-file "$1"
