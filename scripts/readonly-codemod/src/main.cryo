namespace ReadOnlyCodemod;

// One-off: makes the source say which places it writes, before a read-only
// borrow is enforced.  Two kinds of site, read from the files named on the
// command line:
//
// 1. Receivers, from the rows the compiler's read-only probe records
//    (`compiler/src/compiler/readonly_probe.cryo` in the commit that added
//    it, with two more rows), each at a method's name:
//
//      NORECEIVER|-|<file>:<line>:<column>   an instance method with no receiver
//      OWNER|WRITE|<file>:<line>:<column>    a `&this` method assigning through `this`
//      OWNER|MUTCALL|<file>:<line>:<column>  a `&this` method calling a `mut &this` one on `this`
//
//    A method with no receiver gets `&this`, or `mut &this` when it is also
//    an owner; a written `&this` owner gains `mut`.  `OWNER|ADDR` (a `&this`
//    method handing out a pointer into `this`) is decided by hand.  Rerun
//    the probe after a pass: a receiver made writable makes its callers
//    owners in turn.
//
// 2. Read-only pointer locals, from a build's diagnostics: an `E0200` whose
//    ` --> <file>:<line>:<column>` names the initializer of a local declared
//    `T*` and given a `const T*`.  The local's annotation gains `const`.
//    Rerun the probe after a pass: a local that is written through, or
//    handed to a writer, shows up as a write through a `const` pointer.
//
// Run from the directory the positions are relative to.

import std::env;
import std::fmt;
import std::fs::file;
import std::fs::path::{ Path };
import std::collections::str::{ Str };
import std::collections::string::{ String };

type enum SiteKind {
    Receiver;
    ConstLocal;
}

type struct Site {
    kind: SiteKind;
    path: String;
    line: i64;
    column: i64;
    writable: boolean;
    offset: i64;
}

function parse_number(text: Str) -> i64 {
    mut value: i64 = 0;
    for (mut i: i64 = 0; i < text.length(); i++) {
        const b: u8 = text.byte_at(i).unwrap();
        if (b < '0' || b > '9') { break; }
        value = value * 10 + (b - '0') as i64;
    }
    return value;
}

/// The file part of a probe position.  The probe prefixes a relative file
/// with the working directory, and an absolute one by mistake too: the
/// last drive prefix starts the real path.
function file_part(location: Str) -> Str {
    mut start: i64 = 0;
    for (mut i: i64 = 1; i + 1 < location.length(); i++) {
        if (location.byte_at(i).unwrap() == ':' && location.byte_at(i + 1).unwrap() == '/') { start = i - 1; }
    }
    return location.sub_bytes(start, location.length());
}

/// Add the site, or mark the one already at that position writable.
function add_site(sites: mut &[Site], kind: SiteKind, location: Str, writable: boolean) -> void {
    const colon: Str = Str::new(":");
    const last_colon: i64 = location.rfind(&colon).unwrap();
    const before_column: Str = location.sub_bytes(0, last_colon);
    const line_colon: i64 = before_column.rfind(&colon).unwrap();
    const path: Str = file_part(before_column.sub_bytes(0, line_colon));
    const line: i64 = parse_number(before_column.sub_bytes(line_colon + 1, before_column.length()));
    const column: i64 = parse_number(location.sub_bytes(last_colon + 1, location.length()));
    for (mut i: i64 = 0; i < sites.length(); i++) {
        mut site: Site* = &sites[i];
        if (site.line == line && site.column == column && site.path.as_str() == path) {
            if (writable) { site.writable = true; }
            return;
        }
    }
    sites.push(Site { kind: kind, path: String::from_str(path), line: line, column: column, writable: writable, offset: 0 });
}

function starts_with_at(text: &[u8], at: i64, word: string) -> boolean {
    const n: i64 = word.length() as i64;
    if (at + n > text.length()) { return false; }
    for (mut k: i64 = 0; k < n; k++) {
        if (text[at + k] != word[k] as u8) { return false; }
    }
    return true;
}

/// The byte offset of a 1-based line and column.
function offset_of(text: &[u8], line: i64, column: i64) -> i64 {
    mut current: i64 = 1;
    mut i: i64 = 0;
    while (i < text.length() && current < line) {
        if (text[i] == '\n') { current++; }
        i++;
    }
    return i + column - 1;
}

/// Where a site's text changes.  A receiver changes just inside the
/// parameter list after the method's name; a `const` local's annotation
/// changes just after the `:` before the `=` that precedes its initializer.
function edit_point(text: &[u8], kind: SiteKind, at: i64) -> i64 {
    match (kind) {
        SiteKind::Receiver => {
            mut open: i64 = at;
            while (open < text.length() && text[open] != '(') { open++; }
            mut first: i64 = open + 1;
            while (first < text.length() && text[first] == ' ') { first++; }
            return first;
        }
        SiteKind::ConstLocal => {
            // Not a declaration's initializer (a `return`, an argument): -1.
            mut equals: i64 = at - 1;
            while (equals > 0 && text[equals] != '=') {
                if (text[equals] == ';' || text[equals] == '{' || text[equals] == '}') { return -1; }
                equals--;
            }
            mut colon: i64 = equals;
            while (colon > 0 && text[colon] != ':') {
                if (text[colon] == ';' || text[colon] == '{' || text[colon] == '}') { return -1; }
                colon--;
            }
            mut first: i64 = colon + 1;
            while (first < text.length() && text[first] == ' ') { first++; }
            return first;
        }
    }
}

function push_text(out: mut &[u8], word: string) -> void {
    for (mut k: i64 = 0; k < word.length() as i64; k++) { out.push(word[k] as u8); }
}

/// Rewrite one file's sites, given in ascending order of their edit points.
/// Returns the number rewritten.
function rewrite(text: &[u8], sites: &[Site*], out: mut &[u8]) -> i64 {
    mut count: i64 = 0;
    mut copied: i64 = 0;
    for (mut s: i64 = 0; s < sites.length(); s++) {
        const site: Site* = sites[s];
        const first: i64 = site.offset;
        if (first < copied) {
            fmt::println(f"not a declaration: {site.path.as_str()}:{site.line}");
            continue;
        }
        for (mut k: i64 = copied; k < first; k++) { out.push(text[k]); }
        copied = first;
        match (site.kind) {
            SiteKind::ConstLocal => {
                if (!starts_with_at(text, first, "const ")) { push_text(out, "const "); count++; }
            }
            SiteKind::Receiver => {
                if (starts_with_at(text, first, "mut &this")) { continue; }
                if (starts_with_at(text, first, "&this")) {
                    if (site.writable) { push_text(out, "mut "); count++; }
                    continue;
                }
                push_text(out, if (site.writable) { "mut &this" } else { "&this" });
                if (text[first] == '\n' || text[first] == '\r') {
                    push_text(out, ",");
                } else if (text[first] != ')') {
                    push_text(out, ", ");
                }
                count++;
            }
        }
    }
    for (mut k: i64 = copied; k < text.length(); k++) { out.push(text[k]); }
    return count;
}

function read_sites(text: Str, sites: mut &[Site]) -> void {
    mut after_mismatch: boolean = false;
    for (row in text.split(&Str::new("\n"))) {
        const line: Str = row.trim_end();
        match (line.strip_prefix(&Str::new("NORECEIVER|-|"))) {
            Option::Some(location) => { add_site(sites, SiteKind::Receiver, location, false); }
            Option::None => { }
        }
        match (line.strip_prefix(&Str::new("OWNER|WRITE|"))) {
            Option::Some(location) => { add_site(sites, SiteKind::Receiver, location, true); }
            Option::None => { }
        }
        match (line.strip_prefix(&Str::new("OWNER|MUTCALL|"))) {
            Option::Some(location) => { add_site(sites, SiteKind::Receiver, location, true); }
            Option::None => { }
        }
        if (after_mismatch) {
            match (line.strip_prefix(&Str::new(" --> "))) {
                Option::Some(location) => { add_site(sites, SiteKind::ConstLocal, location, false); }
                Option::None => { }
            }
        }
        after_mismatch = line.starts_with(&Str::new("error[E0200]"));
    }
}

function main() -> int {
    const arguments: [String] = env::args();
    if (arguments.length() < 2) {
        fmt::println("usage: readonly_codemod <probe sites or diagnostics file>...");
        return 1;
    }
    mut sites: [Site] = [];
    for (mut a: i64 = 1; a < arguments.length(); a++) {
        match (file::read_to_string(Path::from(arguments[a].as_str()))) {
            Result::Err(_) => { fmt::println(f"cannot read {arguments[a].as_str()}"); return 1; }
            Result::Ok(text) => { read_sites(text.as_str(), &sites); }
        }
    }
    mut done: [boolean] = [];
    for (mut i: i64 = 0; i < sites.length(); i++) { done.push(false); }
    mut total: i64 = 0;
    mut files: i64 = 0;
    for (mut i: i64 = 0; i < sites.length(); i++) {
        if (done[i]) { continue; }
        const path: Str = sites[i].path.as_str();
        match (file::read(Path::from(path))) {
            Result::Err(_) => { fmt::println(f"cannot read {path}"); return 1; }
            Result::Ok(bytes) => {
                // This file's sites, by ascending edit point.
                mut own: [Site*] = [];
                for (mut j: i64 = i; j < sites.length(); j++) {
                    if (done[j] || !(sites[j].path.as_str() == path)) { continue; }
                    done[j] = true;
                    mut site: Site* = &sites[j];
                    site.offset = edit_point(&bytes, site.kind, offset_of(&bytes, site.line, site.column));
                    mut at: i64 = own.length();
                    own.push(site);
                    while (at > 0 && own[at - 1].offset > site.offset) {
                        own[at] = own[at - 1];
                        at--;
                    }
                    own[at] = site;
                }
                mut out: [u8] = [];
                const count: i64 = rewrite(&bytes, &own, &out);
                if (count > 0) {
                    match (file::write(Path::from(path), out.as_slice())) {
                        Result::Err(_) => { fmt::println(f"cannot write {path}"); return 1; }
                        Result::Ok(_) => { total += count; files++; }
                    }
                }
            }
        }
    }
    fmt::println(f"rewrote {total} site(s) in {files} file(s)");
    return 0;
}
