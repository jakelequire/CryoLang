# thread: spawning, the handles, the builder, scopes, identity and the
# scheduling calls are public, each handle's OS id and shared block private.
# The shared result block, the start payloads, their entry trampolines and
# the detached-thread reaper are private, as is the state machine's bytes.
# The name cap is public: it is the truncation `Builder.name` applies.
stdlib/thread/_module.cryo public
stdlib/thread/_module.cryo STATE_LIVE private
stdlib/thread/_module.cryo STATE_THREAD_DONE private
stdlib/thread/_module.cryo STATE_DETACHED private
stdlib/thread/_module.cryo Shared private
stdlib/thread/_module.cryo Shared.state private
stdlib/thread/_module.cryo Shared.result private
stdlib/thread/_module.cryo Payload private
stdlib/thread/_module.cryo Payload.body private
stdlib/thread/_module.cryo Payload.ctx private
stdlib/thread/_module.cryo Payload.shared private
stdlib/thread/_module.cryo thread_body private
stdlib/thread/_module.cryo thread_trampoline private
stdlib/thread/_module.cryo reap_detached private
stdlib/thread/_module.cryo JoinHandle.tid private
stdlib/thread/_module.cryo JoinHandle.shared private
stdlib/thread/_module.cryo Builder.stack_bytes private
stdlib/thread/_module.cryo Builder.name_buf private
stdlib/thread/_module.cryo Builder.name_len private
stdlib/thread/_module.cryo ThreadId.raw private
stdlib/thread/_module.cryo Thread.id_ private
stdlib/thread/_module.cryo ScopePayload private
stdlib/thread/_module.cryo ScopePayload.body private
stdlib/thread/_module.cryo ScopePayload.ctx private
stdlib/thread/_module.cryo scope_body private
stdlib/thread/_module.cryo scope_trampoline private
stdlib/thread/_module.cryo Scope.tids private
stdlib/thread/_module.cryo Scope.stack_bytes private
stdlib/thread/local.cryo public
stdlib/thread/local.cryo ThreadLocal.key private
stdlib/thread/local.cryo ThreadLocal.init private

# fmt: the print calls, Formatter, the traits, FmtError, Arguments, the
# float parser and the to-string calls are public; a Formatter's writer is
# private behind get_writer.  The f-string String builders are internal
# language items, as the pieces builders already are; the pieces' fields
# are private.  fmt::spec is the f-string spec's plumbing: what the spec
# piece calls is internal and the rest private.
stdlib/fmt/_module.cryo public
stdlib/fmt/_module.cryo g_fmt_stderr private
stdlib/fmt/display.cryo public
stdlib/fmt/display.cryo Formatter.writer private
stdlib/fmt/display.cryo write_debug_byte private
stdlib/fmt/display.cryo write_debug_scalar private
stdlib/fmt/error.cryo public
stdlib/fmt/write.cryo public
stdlib/fmt/float.cryo private
stdlib/fmt/float.cryo parse_f64 public
stdlib/fmt/interp.cryo private
stdlib/fmt/interp.cryo fmt_new internal
stdlib/fmt/interp.cryo fmt_append_lit internal
stdlib/fmt/interp.cryo fmt_append_display internal
stdlib/fmt/interp.cryo fmt_append_debug internal
stdlib/fmt/interp.cryo fmt_append_fmt internal
stdlib/fmt/interp.cryo Arguments public
stdlib/fmt/spec.cryo private
stdlib/fmt/spec.cryo FmtSpec internal
stdlib/fmt/spec.cryo fmt_parse_spec internal
stdlib/fmt/spec.cryo fmt_uint_body internal
stdlib/fmt/spec.cryo fmt_sint_body internal
stdlib/fmt/spec.cryo fmt_float_body internal
stdlib/fmt/spec.cryo fmt_display_body internal
stdlib/fmt/spec.cryo BodyText internal
stdlib/fmt/spec.cryo BodyText.head_len internal
stdlib/fmt/spec.cryo BodyText.as_str() internal
stdlib/fmt/spec.cryo fmt_pad internal
