# math: every constant and function is a user API.
stdlib/math/_module.cryo public

# random: the generators, the trait, the distributions and the error are
# public.  A distribution that only stores its parameters is a plain record;
# one that clamps or validates (Bernoulli, WeightedIndex) keeps its state
# private, as Rng and its words do.
stdlib/random/distribution.cryo public
stdlib/random/distribution.cryo TWO_PI private
stdlib/random/distribution.cryo Bernoulli.p private
stdlib/random/distribution.cryo WeightedIndex.cumulative private
stdlib/random/distribution.cryo WeightedIndex.total private
stdlib/random/error.cryo public
stdlib/random/error.cryo RandomError.rank() private
stdlib/random/rng.cryo public
stdlib/random/rng.cryo Rng.s0 private
stdlib/random/rng.cryo Rng.s1 private
stdlib/random/rng.cryo Rng.s2 private
stdlib/random/rng.cryo Rng.s3 private
stdlib/random/secure.cryo public
stdlib/random/source.cryo public

# sync: every lock, its guard and its handle is public with its backing
# pointer private; the heap-pinned backing records are private.  The mutex's
# raw buffer is internal: the condition variable pairs with it.
stdlib/sync/atomic.cryo public
stdlib/sync/atomic.cryo Atomic.value private
stdlib/sync/barrier.cryo public
stdlib/sync/barrier.cryo BarrierInner private
stdlib/sync/barrier.cryo BarrierInner.pthread_buf private
stdlib/sync/barrier.cryo BarrierWaitResult.is_leader private
stdlib/sync/barrier.cryo Barrier.inner private
stdlib/sync/condvar.cryo public
stdlib/sync/condvar.cryo CondVarInner private
stdlib/sync/condvar.cryo CondVarInner.pthread_buf private
stdlib/sync/condvar.cryo CondVar.inner private
stdlib/sync/mpsc.cryo public
stdlib/sync/mpsc.cryo ChanNode private
stdlib/sync/mpsc.cryo ChanNode.next private
stdlib/sync/mpsc.cryo ChanNode.value private
stdlib/sync/mpsc.cryo ChannelState.head private
stdlib/sync/mpsc.cryo ChannelState.tail private
stdlib/sync/mpsc.cryo ChannelState.senders private
stdlib/sync/mpsc.cryo ChannelState.refs private
stdlib/sync/mpsc.cryo ChannelState.rx_open private
stdlib/sync/mpsc.cryo ChannelState.pop() private
stdlib/sync/mpsc.cryo ChannelInner private
stdlib/sync/mpsc.cryo ChannelInner.ready private
stdlib/sync/mpsc.cryo new_inner private
stdlib/sync/mpsc.cryo free_inner private
stdlib/sync/mpsc.cryo release_sender private
stdlib/sync/mpsc.cryo Sender.inner private
stdlib/sync/mpsc.cryo Receiver.inner private
stdlib/sync/mutex.cryo public
stdlib/sync/mutex.cryo MutexInner private
stdlib/sync/mutex.cryo MutexInner.pthread_buf private
stdlib/sync/mutex.cryo MutexInner.value private
stdlib/sync/mutex.cryo MutexInner.alloc private
stdlib/sync/mutex.cryo MutexGuard.inner private
stdlib/sync/mutex.cryo Mutex.inner private
stdlib/sync/mutex.cryo Mutex.raw_pthread_buf() internal
stdlib/sync/once.cryo public
stdlib/sync/once.cryo OnceInner private
stdlib/sync/once.cryo OnceInner.pthread_buf private
stdlib/sync/once.cryo Once.inner private
stdlib/sync/rwlock.cryo public
stdlib/sync/rwlock.cryo RwLockInner private
stdlib/sync/rwlock.cryo RwLockInner.pthread_buf private
stdlib/sync/rwlock.cryo RwLockInner.value private
stdlib/sync/rwlock.cryo RwLockInner.alloc private
stdlib/sync/rwlock.cryo RwLockReadGuard.inner private
stdlib/sync/rwlock.cryo RwLockWriteGuard.inner private
stdlib/sync/rwlock.cryo RwLock.inner private

# time: the one Duration method left unmarked.
stdlib/time/duration.cryo public
