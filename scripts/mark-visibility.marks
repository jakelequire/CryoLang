# fs::dir: the directory calls, DirEntry and ReadDir are public with their
# state private; the dirent and Win32 attribute decoding is private.  The
# default directory mode is public, as the allocators' default sizes are.
stdlib/fs/dir.cryo public
stdlib/fs/dir.cryo DT_DIR private
stdlib/fs/dir.cryo DT_REG private
stdlib/fs/dir.cryo DT_LNK private
stdlib/fs/dir.cryo DIRENT_OFF_TYPE_LINUX private
stdlib/fs/dir.cryo FILE_ATTRIBUTE_DIRECTORY private
stdlib/fs/dir.cryo FILE_ATTRIBUTE_REPARSE_POINT private
stdlib/fs/dir.cryo INVALID_FILE_ATTRIBUTES private
stdlib/fs/dir.cryo dirent_name_offset private
stdlib/fs/dir.cryo dirent_dtype private
stdlib/fs/dir.cryo is_dot_or_dotdot private
stdlib/fs/dir.cryo DirEntry.entry_name private
stdlib/fs/dir.cryo DirEntry.dtype private
stdlib/fs/dir.cryo ReadDir.dirp private
stdlib/fs/dir.cryo ReadDir.base private

# fs::file: OpenOptions keeps its switches private behind its setters, and
# its translation to open(2) flags is private.  File's descriptor is left
# unmarked: a caller hands it to a spawn by reading and clearing it, and
# hiding it needs an accessor whose name is Jake's to choose.
stdlib/fs/file.cryo public
stdlib/fs/file.cryo OpenOptions.read private
stdlib/fs/file.cryo OpenOptions.write private
stdlib/fs/file.cryo OpenOptions.append private
stdlib/fs/file.cryo OpenOptions.truncate private
stdlib/fs/file.cryo OpenOptions.create private
stdlib/fs/file.cryo OpenOptions.create_new private
stdlib/fs/file.cryo OpenOptions.to_flags() private
stdlib/fs/file.cryo File.fd none

# io::buf: the buffered wrappers are public with their buffers private; a
# writer's buffer drain and a stream's compaction are steps of the type and
# private.  The default buffer size is public.
stdlib/io/buf.cryo public
stdlib/io/buf.cryo BYTE_LF private
stdlib/io/buf.cryo FILL_CHUNK private
stdlib/io/buf.cryo BufWriter.writer private
stdlib/io/buf.cryo BufWriter.buffer private
stdlib/io/buf.cryo BufWriter.length private
stdlib/io/buf.cryo BufWriter.flush_buffer() private
stdlib/io/buf.cryo LineWriter.inner private
stdlib/io/buf.cryo BufReader.reader private
stdlib/io/buf.cryo BufReader.buffer private
stdlib/io/buf.cryo BufReader.position private
stdlib/io/buf.cryo BufReader.filled private
stdlib/io/buf.cryo BufStream.inner private
stdlib/io/buf.cryo BufStream.rbuf private
stdlib/io/buf.cryo BufStream.rpos private
stdlib/io/buf.cryo BufStream.scratch private
stdlib/io/buf.cryo BufStream.wbuf private
stdlib/io/buf.cryo BufStream.compact() private

# io::cursor: a cursor's buffer and position are private behind accessors.
stdlib/io/cursor.cryo public
stdlib/io/cursor.cryo Cursor.buffer private
stdlib/io/cursor.cryo Cursor.pos private

# io::fd: the raw descriptor calls are low-level API and public.
stdlib/io/fd.cryo public

# io::stdio: the stream handles, their locks, the descriptor numbers and
# the newline constants are public; the three lock buffers are private.
stdlib/io/stdio.cryo public
stdlib/io/stdio.cryo g_stdin_lock private
stdlib/io/stdio.cryo g_stdout_lock private
stdlib/io/stdio.cryo g_stderr_lock private

# io::traits: the traits and SeekFrom are public, and so is Transfer with
# its fields, which every AsyncTransport implementation constructs; the
# chunk size and byte constants are private.
stdlib/io/traits.cryo public
stdlib/io/traits.cryo READ_TO_END_CHUNK private
stdlib/io/traits.cryo BYTE_LF private
stdlib/io/traits.cryo BYTE_CR private
