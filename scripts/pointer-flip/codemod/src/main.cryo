namespace Main;

// Reads the audit compiler's `AUDIT <file> <line> <col> <end line> <end col>`
// lines and marks each named pointer level `mut`: the innermost level of a
// run gets `mut ` in front, an outer level becomes `mut (<inner>)*`.  Every
// edit is an insertion, so the edits of one file never overlap.

import std::env;
import std::fmt;
import std::collections::str::{ Str };
import std::collections::string::{ String };
import std::io::error::{ IoError };
import std::fs::file;
import std::fs::path::{ Path };

type struct Record {
    start: i64;
    end:   i64;
}

type struct Insertion {
    offset: i64;
    text:   String;
}

type struct FileWork {
    path:    String;
    records: [Record];

    static number(field: Str) -> i64 {
        mut value: i64 = 0;
        for (mut i: i64 = 0; i < field.length(); i++) {
            const b: u8 = field.byte_at(i).unwrap();
            value = value * 10 + ((b - 48) as i64);
        }
        return value;
    }

    add(mut &this, start: i64, end: i64) -> void {
        for (mut i: i64 = 0; i < this.records.length(); i++) {
            if (this.records[i].start == start && this.records[i].end == end) { return; }
        }
        this.records.push(Record { start: start, end: end });
    }

    /// Apply this file's records; answers how many levels were marked.
    apply(mut &this) -> i64 {
        const read: Result<String, IoError> = file::read_to_string(Path::from(this.path.as_str()));
        if (read.is_err()) { fmt::println(f"cannot read {this.path}"); return 0; }
        const content: String = read.unwrap();
        const text: Str = content.as_str();
        mut line_starts: [i64] = [0];
        for (mut i: i64 = 0; i < text.length(); i++) {
            if (text.byte_at(i).unwrap() == 10) { line_starts.push(i + 1); }
        }
        for (mut i: i64 = 0; i < this.records.length(); i++) {
            const s: i64 = this.records[i].start;
            const e: i64 = this.records[i].end;
            this.records[i].start = line_starts[s / 1000000 - 1] + s % 1000000 - 1;
            this.records[i].end = line_starts[e / 1000000 - 1] + e % 1000000 - 1;
        }
        mut insertions: [Insertion] = [];
        mut marked: i64 = 0;
        mut done: [boolean] = [];
        for (mut i: i64 = 0; i < this.records.length(); i++) { done.push(false); }
        for (mut i: i64 = 0; i < this.records.length(); i++) {
            if (done[i]) { continue; }
            const start: i64 = this.records[i].start;
            mut ends: [i64] = [];
            for (mut j: i64 = i; j < this.records.length(); j++) {
                if (this.records[j].start == start) { ends.push(this.records[j].end); done[j] = true; }
            }
            // Outermost level first: its prefix is written first.
            for (mut a: i64 = 0; a < ends.length(); a++) {
                for (mut b: i64 = a + 1; b < ends.length(); b++) {
                    if (ends[b] > ends[a]) { const t: i64 = ends[a]; ends[a] = ends[b]; ends[b] = t; }
                }
            }
            mut prefix: String = String::new();
            for (mut k: i64 = 0; k < ends.length(); k++) {
                const star: i64 = ends[k] - 1;
                if (text.byte_at(star).unwrap() != 42) {
                    fmt::println(f"SKIP {this.path} offset {star}: no `*` at the end");
                    continue;
                }
                mut before: i64 = star - 1;
                while (before > start && text.byte_at(before).unwrap() == 32) { before = before - 1; }
                const innermost: boolean = text.byte_at(before).unwrap() != 42;
                if (innermost) {
                    const head: Str = text.sub_bytes(start, star);
                    if (head.starts_with(&Str::new("const ")) || head.starts_with(&Str::new("mut "))) {
                        fmt::println(f"SKIP {this.path} offset {start}: already marked");
                        continue;
                    }
                    prefix.push("mut ");
                } else {
                    prefix.push("mut (");
                    insertions.push(Insertion { offset: star, text: String::from(")") });
                }
                marked = marked + 1;
            }
            if (prefix.length() > 0) { insertions.push(Insertion { offset: start, text: prefix }); }
        }
        mut order: [i64] = [];
        for (mut a: i64 = 0; a < insertions.length(); a++) { order.push(a); }
        for (mut a: i64 = 0; a < order.length(); a++) {
            for (mut b: i64 = a + 1; b < order.length(); b++) {
                if (insertions[order[b]].offset < insertions[order[a]].offset) {
                    const t: i64 = order[a]; order[a] = order[b]; order[b] = t;
                }
            }
        }
        mut out: String = String::new();
        mut next: i64 = 0;
        for (mut i: i64 = 0; i <= text.length(); i++) {
            while (next < order.length() && insertions[order[next]].offset == i) {
                out.push(insertions[order[next]].text.as_str());
                next = next + 1;
            }
            if (i < text.length()) { out.push_byte(text.byte_at(i).unwrap()); }
        }
        const written: Result<(), IoError> = file::write(Path::from(this.path.as_str()), out.as_bytes());
        if (written.is_err()) { fmt::println(f"cannot write {this.path}"); }
        return marked;
    }
}

function main() -> int {
    const arguments: Array<String> = env::args();
    if (arguments.length() < 2) { fmt::println("usage: pointer_codemod <audit output>..."); return 2; }
    mut audit: String = String::new();
    for (mut a: i64 = 1; a < arguments.length(); a++) {
        const read: Result<String, IoError> = file::read_to_string(Path::from(arguments[a].as_str()));
        if (read.is_err()) { fmt::println(f"cannot read {arguments[a]}"); return 2; }
        audit.push(read.unwrap().as_str());
        audit.push("\n");
    }
    mut files: [FileWork] = [];
    const newline: Str = Str::new("\n");
    const tab: Str = Str::new("\t");
    for (raw in audit.as_str().split(&newline)) {
        const line: Str = raw.trim_end();
        if (!line.starts_with(&Str::new("AUDIT\t"))) { continue; }
        mut fields: [Str] = [];
        for (f in line.split(&tab)) { fields.push(f); }
        if (fields.length() != 6) { continue; }
        const start_line: i64 = FileWork::number(fields[2]);
        const end_line: i64 = FileWork::number(fields[4]);
        if (start_line != end_line) { fmt::println(f"SKIP multi-line {fields[1]}:{start_line}"); continue; }
        mut name: Str = fields[1];
        match (name.strip_prefix(&Str::new("./"))) {
            Option::Some(rest) => { name = rest; }
            Option::None       => { }
        }
        mut found: i64 = -1;
        for (mut i: i64 = 0; i < files.length(); i++) {
            if (files[i].path.as_str().equals(&name)) { found = i; }
        }
        if (found < 0) {
            files.push(FileWork { path: String::from_str(name), records: [] });
            found = files.length() - 1;
        }
        // Columns become byte offsets once the file is read; carried as
        // line * 1_000_000 + column until then.
        files[found].add(start_line * 1000000 + FileWork::number(fields[3]),
                         end_line * 1000000 + FileWork::number(fields[5]));
    }
    mut total: i64 = 0;
    for (mut i: i64 = 0; i < files.length(); i++) {
        total = total + files[i].apply();
    }
    fmt::println(f"marked {total} levels in {files.length()} files");
    return 0;
}
