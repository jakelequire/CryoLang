# Single source of truth for the LLVM toolchain versions.
#
# Sourced by scripts/fetch-windows-llvm.sh and scripts/ci/install-llvm.sh,
# and hashed (hashFiles) into the GitHub Actions toolchain cache keys — so
# bumping a version here automatically invalidates the CI cache.

# Major version installed from apt.llvm.org on Linux (latest 20.x patch).
LLVM_MAJOR=20

# Official LLVM Windows (MSVC) release that provides LLVM-C.dll.
LLVM_WIN_VERSION=20.1.8

# mstorsjo/llvm-mingw release used as the wine-runnable cross driver/linker.
LLVM_MINGW_VERSION=20260602

# SHA-256 of the two downloaded release assets (the GitHub asset digests for
# clang+llvm-${LLVM_WIN_VERSION}-x86_64-pc-windows-msvc.tar.xz and
# llvm-mingw-${LLVM_MINGW_VERSION}-ucrt-x86_64.zip). fetch-windows-llvm.sh
# verifies each download against these before extracting, so a corrupted or
# tampered artifact never enters the cross toolchain. Update alongside the
# version bumps above (mismatched values fail the fetch, not silently drift).
LLVM_WIN_SHA256=f229769f11d6a6edc8ada599c0cda964b7dee6ab1a08c6cf9dd7f513e85b107f
LLVM_MINGW_SHA256=3de3eda9377bbaf35f8c9001f190380f63b8ee981fa55d3ae9d7cce7c6ad7c70
