///! One-off codemod: rename the `ByteReader`/`ByteWriter` method calls a
///! compiler run refused, at the exact spans its diagnostics name.
///!
///!   byte-order-codemod <base-directory> <log>...
///!
///! Each `<log>` is a compiler run's output over sources whose paths it
///! prints relative to `<base-directory>`. An `error[E0358]: no method named
///! `read_u32_big_endian` found on type `...ByteReader`` names the method's
///! own span, so the call is rewritten there to the generic method with its
///! type argument written out: `read_u32_big_endian(` to
///! `read_big_endian::<u32>(`, `write_u16_little_endian(` to
///! `write_little_endian::<u16>(`, and the one-byte `read_u8`/`write_i8`
///! to `read_big_endian::<u8>`/`write_big_endian::<i8>`. The type argument
///! is always written: inferred from a literal argument it would be `i64`,
///! eight bytes. A text search cannot tell a `ByteWriter`'s `write_u8` from
///! a `Hasher`'s; the type the compiler names can. Every rewrite is printed,
///! and a span whose text is not the refused name is printed as `MISMATCH`
///! and left alone.

namespace ByteOrderCodemod;

import std::fs::{ File };
import std::env;
import std::fmt::{ println };

type struct Site {
    path: String;
    line: i64;
    column: i64;
    name: String;
}

/// The replacement for a refused method name, or `None` for a name this
/// codemod does not rename.
function replacement(name: Str) -> Option<String> {
    const access: Str = if (name.starts_with(&Str::new("read_"))) { Str::new("read") } else { Str::new("write") };
    if (!name.starts_with(&Str::new("read_")) && !name.starts_with(&Str::new("write_"))) { return Option::None; }
    const rest: Str = name.byte_substring(access.length() + 1, name.length());
    if (rest == Str::new("u8") || rest == Str::new("i8")) {
        return Option::Some(f"{access}_big_endian::<{rest}>");
    }
    for (order in [Str::new("big_endian"), Str::new("little_endian")]) {
        const suffix: String = f"_{order}";
        if (rest.ends_with(&suffix.as_str())) {
            const width: Str = rest.byte_substring(0, rest.length() - suffix.length());
            if (width == Str::new("u16") || width == Str::new("i16") || width == Str::new("u32") || width == Str::new("i32") || width == Str::new("u64") || width == Str::new("i64")) {
                return Option::Some(f"{access}_{order}::<{width}>");
            }
        }
    }
    return Option::None;
}

/// The text between the first pair of backticks after `start`.
function quoted(text: Str, start: i64) -> Option<Str> {
    const rest: Str = text.byte_substring(start, text.length());
    match (rest.find_byte('`' as u8)) {
        Option::None => { return Option::None; }
        Option::Some(open) => {
            const after: Str = rest.byte_substring(open + 1, rest.length());
            match (after.find_byte('`' as u8)) {
                Option::None => { return Option::None; }
                Option::Some(close) => { return Option::Some(after.byte_substring(0, close)); }
            }
        }
    }
}

/// `path:line:column` from a ` --> ` line, split from the right so a
/// drive letter's colon stays in the path.
function location(line: Str) -> Option<Site> {
    const trimmed: Str = line.trim();
    if (!trimmed.starts_with(&Str::new("--> "))) { return Option::None; }
    const spec: Str = trimmed.byte_substring(4, trimmed.length());
    const last: Option<i64> = spec.find_last_byte(':' as u8);
    if (last.is_none()) { return Option::None; }
    const head: Str = spec.byte_substring(0, last.unwrap());
    const middle: Option<i64> = head.find_last_byte(':' as u8);
    if (middle.is_none()) { return Option::None; }
    const column: Option<u64> = u64::parse_literal(spec.byte_substring(last.unwrap() + 1, spec.length()).as_bytes(), 10);
    const number: Option<u64> = u64::parse_literal(head.byte_substring(middle.unwrap() + 1, head.length()).as_bytes(), 10);
    if (column.is_none() || number.is_none()) { return Option::None; }
    return Option::Some(Site {
        path: String::from(head.byte_substring(0, middle.unwrap())),
        line: number.unwrap() as i64,
        column: column.unwrap() as i64,
        name: String::new()
    });
}

function already_listed(sites: &Array<Site>, site: &Site) -> boolean {
    for (mut s: i64 = 0; s < sites.length(); s++) {
        const other: &Site = &sites[s];
        if (other.path.as_str() == site.path.as_str() && other.line == site.line && other.column == site.column) {
            return true;
        }
    }
    return false;
}

function read_log(log: Str, sites: mut &Array<Site>) -> void {
    match (File::read_text(log)) {
        Result::Err(error) => { println(f"log not read: {log}: {error}"); }
        Result::Ok(text) => {
            const marker: Str = Str::new("error[E0358]: no method named `");
            mut pending: Option<String> = Option::None;
            for (raw in text.as_str().split(&Str::new("\n"))) {
                const line: Str = raw.trim_end();
                if (line.starts_with(&marker)) {
                    pending = Option::None;
                    const found: Option<i64> = line.find(&Str::new("found on type `"));
                    if (found.is_some() && line.byte_substring(found.unwrap(), line.length()).contains(&Str::new("io::bytes::Byte"))) {
                        match (quoted(line, 0)) {
                            Option::Some(name) => {
                                if (replacement(name).is_some()) { pending = Option::Some(String::from(name)); }
                            }
                            Option::None => { }
                        }
                    }
                } else if (pending.is_some()) {
                    match (location(line)) {
                        Option::Some(site) => {
                            const named: Site = Site {
                                path: site.path.clone(),
                                line: site.line,
                                column: site.column,
                                name: pending.unwrap()
                            };
                            if (!already_listed(sites, &named)) { sites.push(named); }
                            pending = Option::None;
                        }
                        Option::None => { }
                    }
                }
            }
        }
    }
}

/// `line` with every refused call on it renamed, rightmost first so an
/// earlier column still points at its text.
function rewrite_line(line: Str, path: Str, number: i64, sites: &Array<Site>, total: mut &i64) -> String {
    mut current: String = String::from(line);
    mut bound: i64 = line.length() + 2;
    while (true) {
        mut best: i64 = -1;
        for (mut s: i64 = 0; s < sites.length(); s++) {
            if (sites[s].path.as_str() == path && sites[s].line == number && sites[s].column < bound && (best < 0 || sites[s].column > sites[best].column)) {
                best = s;
            }
        }
        if (best < 0) { break; }
        const site: &Site = &sites[best];
        bound = site.column;
        const old_name: Str = site.name.as_str();
        const start: i64 = site.column - 1;
        const end: i64 = start + old_name.length();
        const text: Str = current.as_str();
        const fits: boolean = end < text.length()
            && text.byte_substring(start, end) == old_name
            && (text.byte_substring(end, end + 1) == Str::new("(") || text.byte_substring(end, end + 1) == Str::new(":"));
        if (!fits) {
            println(f"MISMATCH {path}:{number}:{site.column} `{old_name}`: {text.trim()}");
            continue;
        }
        const new_name: String = replacement(old_name).unwrap();
        const rewritten: String = f"{text.byte_substring(0, start)}{new_name}{text.byte_substring(end, text.length())}";
        println(f"{path}:{number}:{site.column} {old_name} -> {new_name}");
        current = rewritten;
        *total = *total + 1;
    }
    return current;
}

function main() -> i32 {
    const arguments: Array<String> = env::args();
    if (arguments.length() < 3) {
        println(f"usage: byte-order-codemod <base-directory> <log>...");
        return 2;
    }
    const base: Str = arguments[1].as_str();
    mut sites: Array<Site> = Array::<Site>::new();
    for (mut a: i64 = 2; a < arguments.length(); a++) {
        read_log(arguments[a].as_str(), &sites);
    }
    mut paths: Array<String> = Array::<String>::new();
    for (mut s: i64 = 0; s < sites.length(); s++) {
        mut seen: boolean = false;
        for (mut p: i64 = 0; p < paths.length(); p++) {
            if (paths[p].as_str() == sites[s].path.as_str()) { seen = true; }
        }
        if (!seen) { paths.push(sites[s].path.clone()); }
    }
    mut total: i64 = 0;
    for (mut p: i64 = 0; p < paths.length(); p++) {
        const path: &String = &paths[p];
        const file: String = f"{base}/{path}";
        match (File::read_text(file.as_str())) {
            Result::Err(error) => { println(f"not read: {file}: {error}"); }
            Result::Ok(text) => {
                mut lines: Array<String> = Array::<String>::new();
                mut number: i64 = 0;
                for (line in text.as_str().split(&Str::new("\n"))) {
                    number = number + 1;
                    lines.push(rewrite_line(line, path.as_str(), number, &sites, &total));
                }
                mut views: Array<Str> = Array::<Str>::new();
                for (mut l: i64 = 0; l < lines.length(); l++) { views.push(lines[l].as_str()); }
                const joined: String = Str::new("\n").join(views.iter());
                match (File::write_text(file.as_str(), joined.as_str())) {
                    Result::Ok(_) => { }
                    Result::Err(error) => { println(f"not written: {file}: {error}"); }
                }
            }
        }
    }
    println(f"renamed {total} call(s) in {paths.length()} file(s)");
    return 0;
}
