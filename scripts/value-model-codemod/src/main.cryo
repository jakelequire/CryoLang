///! One-off codemod: move the JSON value model to `std::encoding::value`
///! and JSON's entry points to `json::Json`.
///!
///!   value-model-codemod tokens <file>...
///!   value-model-codemod spans <base-directory> <log>...
///!
///! `tokens` rewrites whole identifiers and paths in each file.  Each old
///! type name is declared exactly once, in the standard library, so every
///! identifier spelled so names that declaration and is renamed:
///! `JsonValue` to `Value`, `JsonNumber` to `Number`, `JsonObject` to
///! `Object`, `JsonExtract` to `Extract`, `ToJson` to `ToValue`, `FromJson`
///! to `FromValue`, `JsonDecodeError` to `DecodeError`.  The modules
///! `std::encoding::json::value` and `std::encoding::json::convert` become
///! `std::encoding::value`.  In a file that names `encoding::json`, the
///! calls `parser::parse`, `serializer::stringify` and
///! `serializer::stringify_pretty` become `json::Json::parse`,
///! `json::Json::to_text` and `json::Json::to_pretty_text`, and an import of
///! the `parser` or `serializer` module becomes one import of
///! `std::encoding::json`.
///!
///! `spans` renames the trait methods `to_json` and `from_json` to
///! `to_value` and `from_value` at the exact spans a compiler run refused
///! them (`error[E0358]: no method named `to_json``): a type of a tool may
///! declare its own `to_json`, which a text search cannot tell from the
///! trait's.  Every rewrite is printed; a span whose text is not the
///! refused name is printed as `MISMATCH` and left alone.

namespace ValueModelCodemod;

import std::fs::{ File };
import std::env;
import std::fmt::{ println };

type struct Rename {
    from: Str;
    to: Str;
    /// Only in a file that names `encoding::json`.
    json_files_only: boolean;
}

type struct Site {
    path: String;
    line: i64;
    column: i64;
    name: String;
}

function renames() -> Array<Rename> {
    mut out: Array<Rename> = Array::<Rename>::new();
    out.push(Rename { from: Str::new("std::encoding::json::value"), to: Str::new("std::encoding::value"), json_files_only: false });
    out.push(Rename { from: Str::new("std::encoding::json::convert"), to: Str::new("std::encoding::value"), json_files_only: false });
    out.push(Rename { from: Str::new("serializer::stringify_pretty"), to: Str::new("json::Json::to_pretty_text"), json_files_only: true });
    out.push(Rename { from: Str::new("serializer::stringify"), to: Str::new("json::Json::to_text"), json_files_only: true });
    out.push(Rename { from: Str::new("parser::parse"), to: Str::new("json::Json::parse"), json_files_only: true });
    out.push(Rename { from: Str::new("JsonDecodeError"), to: Str::new("DecodeError"), json_files_only: false });
    out.push(Rename { from: Str::new("JsonExtract"), to: Str::new("Extract"), json_files_only: false });
    out.push(Rename { from: Str::new("JsonValue"), to: Str::new("Value"), json_files_only: false });
    out.push(Rename { from: Str::new("JsonNumber"), to: Str::new("Number"), json_files_only: false });
    out.push(Rename { from: Str::new("JsonObject"), to: Str::new("Object"), json_files_only: false });
    out.push(Rename { from: Str::new("ToJson"), to: Str::new("ToValue"), json_files_only: false });
    out.push(Rename { from: Str::new("FromJson"), to: Str::new("FromValue"), json_files_only: false });
    return out;
}

function is_identifier_byte(byte: u8) -> boolean {
    return (byte >= 48 && byte <= 57) || (byte >= 65 && byte <= 90) || (byte >= 97 && byte <= 122) || byte == 95;
}

/// Whether the byte at `index` of `text` cannot continue an identifier,
/// nor, when `path` is set, a path (a `:`); true past either end.
function is_boundary(text: Str, index: i64, path: boolean) -> boolean {
    if (index < 0) { return true; }
    match (text.byte_at(index)) {
        Option::Some(byte) => { return !is_identifier_byte(byte) && !(path && byte == 58); }
        Option::None => { return true; }
    }
}

function rename_tokens(text: Str, json_file: boolean, path: Str, total: mut &i64) -> String {
    const table: Array<Rename> = renames();
    mut out: String = String::new();
    mut i: i64 = 0;
    while (i < text.length()) {
        mut matched: boolean = false;
        if (is_boundary(text, i - 1, false)) {
            for (mut r: i64 = 0; r < table.length(); r++) {
                const rename: &Rename = &table[r];
                if (rename.json_files_only && !json_file) { continue; }
                // A path is renamed only where it starts, not as the tail
                // of a longer one (`json::parser::parse`).
                const path_like: boolean = rename.from.contains(&Str::new("::"));
                if (!is_boundary(text, i - 1, path_like)) { continue; }
                const end: i64 = i + rename.from.length();
                if (end > text.length()) { continue; }
                if (text.byte_substring(i, end) != rename.from) { continue; }
                if (!is_boundary(text, end, false)) { continue; }
                out.append(rename.to);
                i = end;
                *total = *total + 1;
                matched = true;
                break;
            }
        }
        if (!matched) {
            out.push_byte(text.byte_at(i).unwrap());
            i = i + 1;
        }
    }
    // An import of JSON's parser or serializer module is now an import of
    // json itself, written once.
    mut lines: Array<String> = Array::<String>::new();
    mut imported: boolean = false;
    for (raw in out.as_str().split(&Str::new("\n"))) {
        const trimmed: Str = raw.trim();
        const module_import: boolean = trimmed == Str::new("import std::encoding::json::parser;")
            || trimmed == Str::new("import std::encoding::json::serializer;")
            || trimmed == Str::new("import std::encoding::json;");
        if (module_import && json_file) {
            if (imported) {
                println(f"{path}: dropped `{trimmed}`");
                continue;
            }
            imported = true;
            lines.push(f"{raw.byte_substring(0, raw.length() - raw.trim_start().length())}import std::encoding::json;");
            continue;
        }
        lines.push(String::from(raw));
    }
    mut views: Array<Str> = Array::<Str>::new();
    for (mut l: i64 = 0; l < lines.length(); l++) { views.push(lines[l].as_str()); }
    return Str::new("\n").join(views.iter());
}

function tokens(arguments: &Array<String>) -> i32 {
    mut total: i64 = 0;
    for (mut a: i64 = 2; a < arguments.length(); a++) {
        const file: Str = arguments[a].as_str();
        match (File::read_text(file)) {
            Result::Err(error) => { println(f"not read: {file}: {error}"); }
            Result::Ok(text) => {
                mut count: i64 = 0;
                const json_file: boolean = text.as_str().contains(&Str::new("encoding::json"));
                const rewritten: String = rename_tokens(text.as_str(), json_file, file, &count);
                if (rewritten.as_str() == text.as_str()) { continue; }
                match (File::write_text(file, rewritten.as_str())) {
                    Result::Ok(_) => { println(f"{file}: {count} rename(s)"); total = total + count; }
                    Result::Err(error) => { println(f"not written: {file}: {error}"); }
                }
            }
        }
    }
    println(f"renamed {total} identifier(s) and path(s)");
    return 0;
}

/// The method a refused name is renamed to, or `None` for any other name.
function method_replacement(name: Str) -> Option<Str> {
    if (name == Str::new("to_json")) { return Option::Some(Str::new("to_value")); }
    if (name == Str::new("from_json")) { return Option::Some(Str::new("from_value")); }
    return Option::None;
}

/// The text between the first pair of backticks in `text`.
function quoted(text: Str) -> Option<Str> {
    match (text.find_byte('`' as u8)) {
        Option::None => { return Option::None; }
        Option::Some(open) => {
            const after: Str = text.byte_substring(open + 1, text.length());
            match (after.find_byte('`' as u8)) {
                Option::None => { return Option::None; }
                Option::Some(close) => { return Option::Some(after.byte_substring(0, close)); }
            }
        }
    }
}

/// `path:line:column` from a ` --> ` line, split from the right so a
/// drive letter's colon stays in the path.
function location(line: Str) -> Option<Site> {
    const trimmed: Str = line.trim();
    if (!trimmed.starts_with(&Str::new("--> "))) { return Option::None; }
    const spec: Str = trimmed.byte_substring(4, trimmed.length());
    const last: Option<i64> = spec.find_last_byte(':' as u8);
    if (last.is_none()) { return Option::None; }
    const head: Str = spec.byte_substring(0, last.unwrap());
    const middle: Option<i64> = head.find_last_byte(':' as u8);
    if (middle.is_none()) { return Option::None; }
    const column: Option<u64> = u64::parse_literal(spec.byte_substring(last.unwrap() + 1, spec.length()).as_bytes(), 10);
    const number: Option<u64> = u64::parse_literal(head.byte_substring(middle.unwrap() + 1, head.length()).as_bytes(), 10);
    if (column.is_none() || number.is_none()) { return Option::None; }
    return Option::Some(Site {
        path: String::from(head.byte_substring(0, middle.unwrap())),
        line: number.unwrap() as i64,
        column: column.unwrap() as i64,
        name: String::new()
    });
}

function already_listed(sites: &Array<Site>, site: &Site) -> boolean {
    for (mut s: i64 = 0; s < sites.length(); s++) {
        const other: &Site = &sites[s];
        if (other.path.as_str() == site.path.as_str() && other.line == site.line && other.column == site.column) {
            return true;
        }
    }
    return false;
}

function read_log(log: Str, sites: mut &Array<Site>) -> void {
    match (File::read_text(log)) {
        Result::Err(error) => { println(f"log not read: {log}: {error}"); }
        Result::Ok(text) => {
            const marker: Str = Str::new("error[E0358]: no method named `");
            mut pending: Option<String> = Option::None;
            for (raw in text.as_str().split(&Str::new("\n"))) {
                const line: Str = raw.trim_end();
                if (line.starts_with(&marker)) {
                    pending = Option::None;
                    match (quoted(line)) {
                        Option::Some(name) => {
                            if (method_replacement(name).is_some()) { pending = Option::Some(String::from(name)); }
                        }
                        Option::None => { }
                    }
                } else if (pending.is_some()) {
                    match (location(line)) {
                        Option::Some(site) => {
                            const named: Site = Site {
                                path: site.path.clone(), line: site.line, column: site.column, name: pending.unwrap()
                            };
                            if (!already_listed(sites, &named)) { sites.push(named); }
                            pending = Option::None;
                        }
                        Option::None => { }
                    }
                }
            }
        }
    }
}

/// `line` with every refused call on it renamed, rightmost first so an
/// earlier column still points at its text.
function rewrite_line(line: Str, path: Str, number: i64, sites: &Array<Site>, total: mut &i64) -> String {
    mut current: String = String::from(line);
    mut bound: i64 = line.length() + 2;
    while (true) {
        mut best: i64 = -1;
        for (mut s: i64 = 0; s < sites.length(); s++) {
            if (sites[s].path.as_str() == path && sites[s].line == number && sites[s].column < bound
                && (best < 0 || sites[s].column > sites[best].column)) {
                best = s;
            }
        }
        if (best < 0) { break; }
        const site: &Site = &sites[best];
        bound = site.column;
        const old_name: Str = site.name.as_str();
        const start: i64 = site.column - 1;
        const end: i64 = start + old_name.length();
        const text: Str = current.as_str();
        const fits: boolean = end <= text.length() && text.byte_substring(start, end) == old_name && is_boundary(text, end, false);
        if (!fits) {
            println(f"MISMATCH {path}:{number}:{site.column} `{old_name}`: {text.trim()}");
            continue;
        }
        const new_name: Str = method_replacement(old_name).unwrap();
        const rewritten: String = f"{text.byte_substring(0, start)}{new_name}{text.byte_substring(end, text.length())}";
        println(f"{path}:{number}:{site.column} {old_name} -> {new_name}");
        current = rewritten;
        *total = *total + 1;
    }
    return current;
}

function spans(arguments: &Array<String>) -> i32 {
    const base: Str = arguments[2].as_str();
    mut sites: Array<Site> = Array::<Site>::new();
    for (mut a: i64 = 3; a < arguments.length(); a++) { read_log(arguments[a].as_str(), &sites); }
    mut paths: Array<String> = Array::<String>::new();
    for (mut s: i64 = 0; s < sites.length(); s++) {
        mut seen: boolean = false;
        for (mut p: i64 = 0; p < paths.length(); p++) {
            if (paths[p].as_str() == sites[s].path.as_str()) { seen = true; }
        }
        if (!seen) { paths.push(sites[s].path.clone()); }
    }
    mut total: i64 = 0;
    for (mut p: i64 = 0; p < paths.length(); p++) {
        const path: &String = &paths[p];
        const file: String = f"{base}/{path}";
        match (File::read_text(file.as_str())) {
            Result::Err(error) => { println(f"not read: {file}: {error}"); }
            Result::Ok(text) => {
                mut lines: Array<String> = Array::<String>::new();
                mut number: i64 = 0;
                for (line in text.as_str().split(&Str::new("\n"))) {
                    number = number + 1;
                    lines.push(rewrite_line(line, path.as_str(), number, &sites, &total));
                }
                mut views: Array<Str> = Array::<Str>::new();
                for (mut l: i64 = 0; l < lines.length(); l++) { views.push(lines[l].as_str()); }
                const joined: String = Str::new("\n").join(views.iter());
                match (File::write_text(file.as_str(), joined.as_str())) {
                    Result::Ok(_) => { }
                    Result::Err(error) => { println(f"not written: {file}: {error}"); }
                }
            }
        }
    }
    println(f"renamed {total} call(s) in {paths.length()} file(s)");
    return 0;
}

function main() -> i32 {
    const arguments: Array<String> = env::args();
    if (arguments.length() >= 3 && arguments[1].as_str() == Str::new("tokens")) { return tokens(&arguments); }
    if (arguments.length() >= 4 && arguments[1].as_str() == Str::new("spans")) { return spans(&arguments); }
    println(f"usage: value-model-codemod tokens <file>... | spans <base-directory> <log>...");
    return 2;
}
