///! One-off codemod: in the files named on the command line, a flag
///! constant whose value is a single bit, written as a decimal or `0x`
///! literal, is rewritten as `1 << N`, in place.
///!
///!   `public const O_CREAT:     i32 = 64;`  ->  `public const O_CREAT:     i32 = 1 << 6;`
///!
///! A constant is a flag when its name starts with one of the families below
///! or is one of the names listed, and is not one of the exclusions: field
///! values, operation codes and sizes that happen to be powers of two, and
///! aliases, which are written by hand as the constant they equal. A
///! trailing comment that only restates the new value (`// 1 << 30`) is
///! dropped. Every rewrite is printed, so the run is reviewable line by
///! line.

namespace FlagConstantsCodemod;

import std::fs::{ File };
import std::env;
import std::fmt::{ println };

function flag_families() -> Array<Str> {
    mut all: Array<Str> = Array::<Str>::new();
    const names: Array<string> = [
        "SA_", "O_", "AT_", "S_IS", "S_IR", "S_IW", "S_IX", "TFD_", "MSG_", "AI_",
        "NI_", "POLL", "PROT_", "MAP_", "MS_", "MCL_", "MFD_", "EPOLL", "EFD_",
        "SFD_", "RTLD_", "CLONE_", "GRND_", "GENERIC_", "FILE_SHARE_",
        "FILE_ATTRIBUTE_", "FILE_FLAG_", "MEM_", "PAGE_", "HEAP_",
        "FORMAT_MESSAGE_", "ENABLE_", "AFD_POLL_", "UA_", "FLAG_", "INTEREST_",
        "PENDING_"
    ];
    for (name in names) { all.push(Str::new(name)); }
    return all;
}

function flag_names() -> Array<Str> {
    mut all: Array<Str> = Array::<Str>::new();
    const names: Array<string> = [
        "FD_CLOEXEC", "X_OK", "W_OK", "R_OK", "TIMER_ABSTIME",
        "WNOHANG", "WUNTRACED", "WEXITED", "WCONTINUED", "WNOWAIT",
        "IGNBRK", "BRKINT", "IGNPAR", "PARMRK", "INPCK", "ISTRIP", "INLCR",
        "IGNCR", "ICRNL", "IUCLC", "IXON", "IXANY", "IXOFF", "IMAXBEL", "IUTF8",
        "OPOST", "ONLCR", "OCRNL", "ONOCR", "ONLRET",
        "ISIG", "ICANON", "ECHO", "ECHOE", "ECHOK", "ECHONL", "NOFLSH", "TOSTOP",
        "IEXTEN", "CSTOPB", "CREAD", "PARENB", "PARODD", "HUPCL", "CLOCAL",
        "REG_EXTENDED", "REG_ICASE", "REG_NOSUB", "REG_NEWLINE", "REG_NOTBOL",
        "REG_NOTEOL", "FUTEX_PRIVATE_FLAG", "FUTEX_CLOCK_REALTIME",
        "STARTF_USESTDHANDLES", "HANDLE_FLAG_INHERIT", "DUPLICATE_SAME_ACCESS",
        "MOVEFILE_REPLACE_EXISTING", "STACK_SIZE_PARAM_IS_A_RESERVATION",
        "CREATE_SUSPENDED", "DETACHED_PROCESS", "CREATE_NEW_CONSOLE",
        "CREATE_NEW_PROCESS_GROUP", "CREATE_UNICODE_ENVIRONMENT",
        "CREATE_BREAKAWAY_FROM_JOB", "CREATE_NO_WINDOW", "KEY_QUERY_VALUE",
        "KEY_SET_VALUE", "KEY_CREATE_SUB_KEY", "KEY_ENUMERATE_SUB_KEYS",
        "KEY_NOTIFY", "SYNCHRONIZE", "SSL_VERIFY_PEER",
        "SSL_VERIFY_FAIL_IF_NO_PEER_CERT"
    ];
    for (name in names) { all.push(Str::new(name)); }
    return all;
}

function exclusions() -> Array<Str> {
    mut all: Array<Str> = Array::<Str>::new();
    const names: Array<string> = [
        // Access modes: a two-bit field, not flags.
        "O_RDONLY", "O_WRONLY", "O_RDWR", "O_ACCMODE",
        // Buffer sizes.
        "NI_MAXHOST", "NI_MAXSERV",
        // Operation codes.
        "EPOLL_CTL_ADD", "EPOLL_CTL_DEL", "EPOLL_CTL_MOD",
        // Aliases, written as the constant they equal.
        "O_NDELAY", "TFD_NONBLOCK", "TFD_CLOEXEC", "EPOLL_CLOEXEC",
        "EFD_CLOEXEC", "EFD_NONBLOCK", "SFD_CLOEXEC", "SFD_NONBLOCK", "MAP_ANON"
    ];
    for (name in names) { all.push(Str::new(name)); }
    return all;
}

function contains(list: &Array<Str>, name: Str) -> boolean {
    for (entry in list) {
        if (entry == name) { return true; }
    }
    return false;
}

function is_flag(name: Str, families: &Array<Str>, names: &Array<Str>, excluded: &Array<Str>) -> boolean {
    if (contains(excluded, name)) { return false; }
    if (contains(names, name)) { return true; }
    for (family in families) {
        if (name.starts_with(&family)) { return true; }
    }
    return false;
}

/// The value of a decimal or `0x` literal, or `None` for anything else.
function literal_value(text: Str) -> Option<u64> {
    match (text.strip_prefix(&Str::new("0x"))) {
        Option::Some(digits) => { return u64::parse_literal(digits.as_bytes(), 16); }
        Option::None => { }
    }
    return u64::parse_literal(text.as_bytes(), 10);
}

/// The line rewritten, or `None` when it declares no single-bit flag
/// constant.
function rewrite_line(line: Str, families: &Array<Str>, names: &Array<Str>, excluded: &Array<Str>) -> Option<String> {
    const found_start: Option<i64> = line.find(&Str::new("const "));
    const found_colon: Option<i64> = line.find_byte(':' as u8);
    const found_equals: Option<i64> = line.find_byte('=' as u8);
    const found_semicolon: Option<i64> = line.find_byte(';' as u8);
    if (found_start.is_none() || found_colon.is_none() || found_equals.is_none() || found_semicolon.is_none()) {
        return Option::None;
    }
    const start: i64 = found_start.unwrap();
    const colon: i64 = found_colon.unwrap();
    const equals: i64 = found_equals.unwrap();
    const semicolon: i64 = found_semicolon.unwrap();
    // Only a declaration: nothing but a visibility before `const`, so a
    // comment that mentions one is left alone.
    const before: Str = line.byte_substring(0, start).trim();
    if (!(before.is_empty() || before == Str::new("public") || before == Str::new("internal") || before == Str::new("private"))) {
        return Option::None;
    }
    if (!(start < colon && colon < equals && equals < semicolon)) { return Option::None; }
    const name: Str = line.byte_substring(start + 6, colon).trim();
    if (!is_flag(name, families, names, excluded)) { return Option::None; }
    const parsed: Option<u64> = literal_value(line.byte_substring(equals + 1, semicolon).trim());
    if (parsed.is_none()) { return Option::None; }
    const value: u64 = parsed.unwrap();
    if (value == 0 || (value & (value - 1)) != 0) { return Option::None; }
    const bit: u32 = value.trailing_zeros();
    mut shifted: String = String::new();
    shifted.push("1 << ");
    shifted.push(bit);
    mut out: String = String::new();
    out.push(line.byte_substring(0, equals + 1));
    out.push(" ");
    out.push(shifted.as_str());
    out.push(";");
    const rest: Str = line.byte_substring(semicolon + 1, line.length());
    mut restated: String = String::new();
    restated.push("// ");
    restated.push(shifted.as_str());
    if (rest.trim() != restated.as_str()) {
        out.push(rest);
    } else if (rest.ends_with(&Str::new("\r"))) {
        out.push("\r");
    }
    return Option::Some(out);
}

function main() -> i32 {
    const arguments: Array<String> = env::args();
    const families: Array<Str> = flag_families();
    const names: Array<Str> = flag_names();
    const excluded: Array<Str> = exclusions();
    mut total: i64 = 0;
    for (mut a: i64 = 1; a < arguments.length(); a++) {
        const file: Str = arguments[a].as_str();
        match (File::read_text(file)) {
            Result::Err(error) => { println(f"skipped: {error}"); }
            Result::Ok(text) => {
                mut result: String = String::new();
                mut number: i64 = 0;
                mut rewritten: i64 = 0;
                for (line in text.as_str().split(&Str::new("\n"))) {
                    if (number > 0) { result.push("\n"); }
                    number = number + 1;
                    match (rewrite_line(line, &families, &names, &excluded)) {
                        Option::Some(new_line) => {
                            println(f"{file}:{number}: {line.trim()}  ->  {new_line.as_str().trim()}");
                            result.push(new_line.as_str());
                            rewritten = rewritten + 1;
                        }
                        Option::None => { result.push(line); }
                    }
                }
                if (rewritten > 0) {
                    match (File::write_text(file, result.as_str())) {
                        Result::Ok(_) => { total = total + rewritten; }
                        Result::Err(error) => { println(f"not written: {error}"); }
                    }
                }
            }
        }
    }
    println(f"rewrote {total} constant(s)");
    return 0;
}
