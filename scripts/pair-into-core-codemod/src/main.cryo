///! One-off codemod for the change that moves `Pair` into `core`: every
///! spelling of the module path `std::collections::pair` becomes
///! `std::core::pair`.  Rewrites each file named on the command line in
///! place and prints how many paths it changed.

import std::collections::array::{ Array };
import std::collections::str::{ Str };
import std::collections::string::{ String };
import std::env;
import std::fmt::{ println, eprintln };
import std::fs::{ File, Path };

type struct Codemod {
    static rewrite(path: Str) -> i64 {
        const source: String = match (File::read_text(Path::from(path))) {
            Result::Ok(text) => { text }
            Result::Err(e) => {
                eprintln(f"pair-into-core-codemod: cannot read {path}: {e}");
                return -1;
            }
        };
        const from: Str = Str::new("std::collections::pair");
        const to: Str = Str::new("std::core::pair");
        if (!source.as_str().contains(from)) { return 0; }
        const out: String = source.as_str().replace(from, to);
        // Each replacement shortens the text by the difference of the two paths.
        const count: i64 = (source.length() - out.length()) / (from.length() - to.length());
        match (File::write_text(Path::from(path), out.as_str())) {
            Result::Ok(_) => { }
            Result::Err(e) => {
                eprintln(f"pair-into-core-codemod: cannot write {path}: {e}");
                return -1;
            }
        }
        return count;
    }
}

function main() -> i32 {
    const arguments: Array<String> = env::args();
    mut total: i64 = 0;
    mut files: i64 = 0;
    mut i: i64 = 1;
    while (i < arguments.length()) {
        const changed: i64 = Codemod::rewrite(arguments[i].as_str());
        if (changed < 0) { return 1; }
        if (changed > 0) { files++; }
        total = total + changed;
        i++;
    }
    println(f"pair-into-core-codemod: {total} paths in {files} files");
    return 0;
}
