namespace tagharness::mint;

import compiler::types::type_ref;

// The first handle of an allocator no arena holds.  The allocator is public
// and compiles anywhere; what its handles answer is the question.
function second_allocator_handle() -> type_ref::TypeRef {
    mut refs: type_ref::TypeRefs = type_ref::TypeRefs::new();
    return refs.next();
}
