[project]
project_name = "tagharness"
output_dir   = "build"
target_type  = "executable"
entry_point  = "src/main.cryo"

[compiler]
debug    = false
optimize = O0

# The compiler library links LLVM and libclang; these mirror the compiler's
# own per-OS link overlays (compiler/cryoconfig).  Paths are relative to this
# directory, four levels under the repository root.
[link.unix]
system = ["LLVM-20"]
search = ["/usr/lib/llvm-20/lib"]
static = ["/usr/lib/llvm-20/lib/libclang-20.so.1"]

[link.windows]
system = ["LLVM-C", "clang"]
search = ["../../../../.toolchains/llvm-win/lib"]

[dependencies]
compiler = { path = "../../../../compiler", alias = "Compiler" }
