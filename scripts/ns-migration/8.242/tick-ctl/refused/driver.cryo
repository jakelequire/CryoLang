// The second driver §8.242 tried: MOVE the future to a fresh location after
// every `Pending`, so the frame's address changes between polls.  Outside
// `src/` because the compiler refuses it - and that refusal is the finding:
//
//   error[E0459]: future 'g' is moved after it has been polled
//     15 |     match (g.poll(cx)) {
//        |            ---------- polled here, fixing its address
//
// A polled future's address is fixed by E0459, so the frame cannot move
// between polls and a receiver pointer into it cannot go stale that way.
namespace TickCtl::Driver;

import std::future::poll::{ Poll };
import std::future::traits::{ Future };
import std::future::waker::{ Context, Waker };

function move_poll<F, R>(f: F, cx: Context*) -> R
where F: Future<R> {
    mut g: F = f;
    match (g.poll(cx)) {
        Poll::Ready(v) => { return v; }
        Poll::Pending  => { return move_poll(g, cx); }
    }
}

function move_block_on<F, R>(fut: F) -> R
where F: Future<R> {
    mut cx: Context = Context::new(Waker::noop());
    return move_poll(fut, &cx);
}
