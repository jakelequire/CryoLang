type enum Mode { Ready; Busy; }

const LIMIT: i64 = 5;

function classify(v: i64) -> i64 {
    return match (v) {
        LIMIT => { 1 }
        Ready => { Ready + 100 }
    };
}

function pick<T>(a: T) -> T { return a; }
