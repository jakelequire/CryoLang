namespace Main;
import std::future;
type trait Tick { tick(&this) -> i64; }
type struct Clock { v: i64; }
implement trait Tick for struct Clock { tick(&this) -> i64 { return this.v; } }
type struct Holder<S> { inner: S; }
type trait Drain { async drain(mut &this) -> i64; }
implement<S> trait Drain for struct Holder<S> where S: Tick {
    async drain(mut &this) -> i64 { return this.inner.tick(); }
}
type struct Conn<T> { h: Holder<T>; }
implement struct Conn<U> {
    async run(mut &this) -> i64 where U: Tick { const a: i64 = await this.h.drain(); return a; }
}
async function go() -> i64 {
    mut c: Conn<Clock> = Conn::<Clock> { h: Holder::<Clock> { inner: Clock { v: 42 } } };
    const r: i64 = await c.run();
    return r;
}
function main() -> int { return future::block_on(go()) as int; }
