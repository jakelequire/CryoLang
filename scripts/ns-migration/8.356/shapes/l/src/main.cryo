namespace Main;
type trait Tick { tick(&this) -> i64; }
implement trait Tick for i64 { tick(&this) -> i64 { return *this + 1; } }
type struct Conn<S> {
    inner: S;
    // `other.inner` is i64; `S` carries no bound
    plus(&this, other: &Conn<i64>) -> i64 { return other.inner.tick(); }
}
function main() -> int {
    const a: Conn<u8> = Conn::<u8> { inner: 1 };
    const b: Conn<i64> = Conn::<i64> { inner: 41 };
    return a.plus(&b) as int;
}
