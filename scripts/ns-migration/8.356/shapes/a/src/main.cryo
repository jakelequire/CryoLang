namespace Main;
type trait Tick { tick(&this) -> i64; }
type struct Clock { v: i64; }
implement trait Tick for struct Clock { tick(&this) -> i64 { return this.v; } }
type struct Conn<T> { inner: T; }
// field read through `this`, bound on the method, impl spelled U
implement struct Conn<U> {
    run(&this) -> i64 where U: Tick { return this.inner.tick(); }
}
function main() -> int {
    const c: Conn<Clock> = Conn::<Clock> { inner: Clock { v: 42 } };
    return c.run() as int;
}
