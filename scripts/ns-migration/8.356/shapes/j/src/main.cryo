namespace Main;
type struct Conn<S> {
    inner: S;
    // another instantiation of the owner, read inside the owner's own body
    plus(&this, other: &Conn<i64>) -> i64 { return other.inner + 1; }
}
function main() -> int {
    const a: Conn<u8> = Conn::<u8> { inner: 1 };
    const b: Conn<i64> = Conn::<i64> { inner: 41 };
    return a.plus(&b) as int;
}
