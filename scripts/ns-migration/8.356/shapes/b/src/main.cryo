namespace Main;
type trait Tick { tick(&this) -> i64; }
type struct Clock { v: i64; }
implement trait Tick for struct Clock { tick(&this) -> i64 { return this.v; } }
type struct Conn<T> {
    inner: T;
    get(&this) -> T* { return &this.inner; }
}
// owner method's return read through `this`, impl spelled U
implement struct Conn<U> {
    run(&this) -> i64 where U: Tick { const p: U* = this.get(); return p.tick(); }
}
function main() -> int {
    const c: Conn<Clock> = Conn::<Clock> { inner: Clock { v: 42 } };
    return c.run() as int;
}
