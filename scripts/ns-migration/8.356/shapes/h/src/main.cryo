namespace Main;
type trait MyIter<Item> {
    mynext(mut &this) -> Option<Item>;
}
type struct PtrSrc<T> { ptr: T*; n: u64; }
implement<T> trait MyIter<T*> for struct PtrSrc<T> {
    mynext(mut &this) -> Option<T*> {
        if (this.n == 0) { return Option::None; }
        this.n = this.n - 1;
        const p: T* = this.ptr;
        return Option::Some(p);
    }
}
type struct MyCopied<I> { inner: I; }
implement<Item, I> trait MyIter<Item> for struct MyCopied<I>
where I: MyIter<Item*>, Item: Copy {
    mynext(mut &this) -> Option<Item> {
        return match (this.inner.mynext()) {
            Option::Some(p) => { Option::Some(*p) }
            Option::None    => { Option::None }
        };
    }
}
function main() -> int {
    mut x: i32 = 42;
    mut src: PtrSrc<i32> = PtrSrc::<i32> { ptr: &x, n: 1 };
    mut c: MyCopied<PtrSrc<i32>> = MyCopied::<PtrSrc<i32>> { inner: src };
    match (c.mynext()) {
        Option::Some(v) => { return v; }
        Option::None    => { return 1; }
    }
}
