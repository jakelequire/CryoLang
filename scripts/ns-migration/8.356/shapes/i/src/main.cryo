namespace Main;
import std::core::ops;
import std::core::ops::{ Deref };
type struct Boxed { value: i32; }
implement trait Deref<i32> for Boxed { deref(&this) -> i32* { return &this.value; } }
function deref_ptr<Target, U>(x: &Target) -> U* where Target: Deref<U> { return x.deref(); }
function main() -> int { const b: Boxed = Boxed { value: 42 }; const p: i32* = deref_ptr::<Boxed, i32>(&b); return *p; }
