+    /// SHADOW: `coherence_key_for` over the stamp-keyed renderers.
+    static coherence_key_for_res(node: ImplBlockNode*,
+                             canonical_target: SymbolStr,
+                             ctx: CompilationContext*) -> string {
+        mut key: string = TypeResolutionPasses::ann_canon_key_res(
+            node.trait_annotation, node, ctx);
+        key = key + " for ";
+        // Target base by resolved type identity (folds primitive aliases
+        // and type aliases).  `canonical_target` is the head's own key
+        // already - the stamp's name, a primitive's spelling - so it is the
+        // stamped form here.
+        const head_res: Res = match (node.res) {
+            ResSlot::Answered(a) => { a }
+            _                    => { Res::PrimTy(canonical_target) }
+        };
+        key = key + TypeResolutionPasses::type_name_key_res(
+            canonical_target, head_res, node, ctx);
+        if (node.target_args.length > 0) {
+            key = key + "<";
+            for (mut i: i64 = 0; i < node.target_args.length; i++) {
+                if (i > 0) { key = key + ","; }
+                key = key + TypeResolutionPasses::ann_canon_key_res(
+                    node.target_args[i], node, ctx);
+            }
+            key = key + ">";
+        }
+        if (node.where_bounds.length > 0) {
+            key = key + " where ";
+            for (mut i: i64 = 0; i < node.where_bounds.length; i++) {
+                const wb: TraitBound* = &node.where_bounds[i];
+                const pidx: i64 = TypeResolutionPasses::impl_param_index(
+                    node, wb.type_parameter);
+                if (pidx >= 0) {
+                    key = key + fmt::format("#%lld:", pidx);
+                } else {
+                    key = key + ctx.intern_table.resolve(wb.type_parameter)
+                        + ":";
+                }
+                for (mut j: i64 = 0; j < wb.trait_refs.length; j++) {
+                    if (j > 0) { key = key + "+"; }
+                    const tr: TraitRef* = &wb.trait_refs[j];
+                    if (tr.path.length > 0) {
+                        // The bound's carried identity, never a search for its
+                        // leaf. Recovering the qualified name by searching the
+                        // program declines as soon as any unrelated
+                        // declaration shares the leaf, and two distinct traits
+                        // then fold to one key - so two impls differing only in
+                        // which module their bound came from rendered
+                        // identically and coherence rejected the second.
+                        key = key + ctx.intern_table.resolve(tr.identity());
+                    }
+                    if (tr.type_args.length > 0) {
+                        key = key + "<";
+                        for (mut k: i64 = 0; k < tr.type_args.length; k++) {
+                            if (k > 0) { key = key + ","; }
+                            key = key + TypeResolutionPasses::ann_canon_key_res(
+                                tr.type_args[k], node, ctx);
+                        }
+                        key = key + ">";
+                    }
+                }
+                key = key + ";";
+            }
+        }
+        return key;
+    }
