namespace Main;

type trait Show {
    show(&this) -> i32;
}

type trait Take<X> {
    take(&this) -> X;
}

type struct Num {
    v: i32;
}

implement trait Show for struct Num {
    show(&this) -> i32 { return this.v; }
}

type struct Wrap<T> {
    inner: T;
}

// A method's return is written in the impl's own parameter, spelled unlike the type's.
implement<U> trait Take<U> for struct Wrap<U> {
    take(&this) -> U { return this.inner; }
}

function main() -> int {
    const w: Wrap<Num> = Wrap::<Num> { inner: Num { v: 42 } };
    return w.take().show();
}
