namespace Main;

type trait Show {
    show(&this) -> i32;
}

type trait Twice {
    twice(&this) -> i32;
}

type struct Plain {
    v: i32;
}

type struct Wrap<T> {
    inner: T;
}

// A METHOD's where-clause names the impl's own parameter; it fails for Plain,
// and nothing calls the method.
implement<U> trait Twice for struct Wrap<U> {
    twice(&this) -> i32 where U: Show { return this.inner.show() * 2; }
}

function main() -> int {
    const w: Wrap<Plain> = Wrap::<Plain> { inner: Plain { v: 7 } };
    return w.inner.v;
}
