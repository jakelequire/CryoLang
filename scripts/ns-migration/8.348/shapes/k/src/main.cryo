namespace Main;

import std::future;

type trait Show {
    show(&this) -> i64;
}

type trait Go {
    async go(mut &this) -> i64;
}

type struct Num {
    v: i64;
}

implement trait Show for struct Num {
    show(&this) -> i64 { return this.v; }
}

type struct Wrap<T> {
    inner: T;
}

// An async method in an impl spelling its parameter unlike the type's; the
// lowering rebuilds the frame from types the body computed.
implement<U> trait Go for struct Wrap<U> {
    async go(mut &this) -> i64 where U: Show {
        const got: U = this.inner;
        return got.show();
    }
}

async function main() -> i32 {
    mut w: Wrap<Num> = Wrap::<Num> { inner: Num { v: 42 } };
    const r: i64 = await w.go();
    return r as i32;
}
