+    /// SHADOW: the symbol `resolve_path`'s walk binds for a one-segment path.
+    shadow_lookup_ns(&this, name: SymbolStr, ns: Namespace, start: ScopeID) -> SymbolID {
+        mut scope_id: ScopeID = start;
+        while (scope_id.is_valid()) {
+            const sc: Scope* = this.get_scope(scope_id);
+            const found: SymbolID = sc.find(name);
+            if (found.is_valid()) {
+                const sym: Symbol = this.get_symbol(found);
+                if (ns.accepts(sym.kind)) { return found; }
+            }
+            scope_id = sc.parent_id;
+        }
+        const pre: SymbolID = this.lookup_prelude(name);
+        if (pre.is_valid()) {
+            const psym: Symbol = this.get_symbol(pre);
+            if (ns.accepts(psym.kind)) { return pre; }
+        }
+        return SymbolID::invalid();
+    }
