            const gp_ref: TypeRef = this.head_param_type(impl_block, gi);
            if (gp_ref.is_valid()) { subst.add(gp_ref.id, args[gi]); }
        }
    }

    /// The type of the parameter an implement block's head writes at
    /// position `index` (`U` in `.. for Wrap<U>`, at 0), or invalid where
    /// the head writes a type there.
    head_param_type(&this, impl_block: ImplBlockNode*, index: i64) -> TypeRef {
        if (impl_block == null || index < 0 || index >= impl_block.target_args.length) {
            return TypeRef::invalid();
        }
        const ta: TypeAnnotation* = impl_block.target_args[index];
        if (ta == null) { return TypeRef::invalid(); }
        match (*ta) {
            TypeAnnotation::Named(n) => {
                if (n.param_sym().is_valid()) {
                    return this.arena.create_generic_param(n.param_sym(), n.name, index as u64);
