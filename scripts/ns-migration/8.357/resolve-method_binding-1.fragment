    /// `ty` as the enclosing implement block reads it.  A generic impl's
    /// body is walked with `this` typed as the template, so a type computed
    /// from a field names the owner's parameters (`BufStream`'s `S`), while
    /// the impl's bounds - its own and its methods' - are written on the
    /// impl's parameters; the owner's parameter at each position is read as
    /// the one the head writes there.  Unchanged outside an impl.
    through_impl_head(mut &this, ty: TypeRef) -> TypeRef {
        const impl_node: ImplBlockNode* = this.state.symbolic_impl_node;
        if (impl_node == null) { return ty; }
        return this.trait_checker().owner_type_through_head(impl_node, ty);
    }

    /// The generic parameter `ty` names, read through the enclosing impl's
    /// head (`through_impl_head`); null when `ty` is not a parameter.
    param_name_through_impl_head(mut &this, ty: TypeRef) -> GenericParamType* {
        const seen: TypeRef = this.through_impl_head(ty);
        const t: Type* = this.arena.lookup(seen.id);
        if (t == null || t.kind != TypeKind::GenericParam) { return null; }
        return t as GenericParamType*;
