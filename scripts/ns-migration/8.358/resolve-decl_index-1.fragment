    /// Whether the definition `d` is private to a module other than
    /// `use_ns`: declared elsewhere, and recorded as not public by its
    /// registration.  False for a definition declared in `use_ns`, or one
    /// with no module.
    hidden_from(&this, d: DefId, use_ns: SymbolStr, intern: InternTable*) -> boolean {
        if (!d.is_valid() || !use_ns.is_valid()) { return false; }
        const q: SymbolStr = this.defs.path_of(d);
        const d_ns: SymbolStr = this.namespace_of(q, intern);
        if (!d_ns.is_valid() || d_ns.id == use_ns.id) { return false; }
        return !this.is_candidate_public(q);
    }

