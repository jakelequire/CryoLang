namespace Main;

type trait Show {
    show(&this) -> i32;
}

type struct Num {
    v: i32;
}

implement trait Show for struct Num {
    show(&this) -> i32 { return this.v; }
}

type struct Wrap<T> {
    inner: T;
}

// Shape A: the impl's own `T`, bounded at the impl.
implement<T> trait Show for struct Wrap<T>
where T: Show {
    show(&this) -> i32 { return this.inner.show() + 1; }
}

function main() -> int {
    const w: Wrap<Num> = Wrap::<Num> { inner: Num { v: 41 } };
    return w.show();
}
