namespace Main;

type trait Show {
    show(&this) -> i32;
}

type trait Twice {
    twice(&this) -> i32;
}

type struct Num {
    v: i32;
}

implement trait Show for struct Num {
    show(&this) -> i32 { return this.v; }
}

type struct Wrap<T> {
    inner: T;
}

// Shape B: a METHOD's where-clause names the impl's `T`.
implement<T> trait Twice for struct Wrap<T> {
    twice(&this) -> i32 where T: Show { return this.inner.show() * 2; }
}

function main() -> int {
    const w: Wrap<Num> = Wrap::<Num> { inner: Num { v: 21 } };
    return w.twice();
}
