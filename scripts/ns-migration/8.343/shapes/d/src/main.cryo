namespace Main;

type trait Show {
    show(&this) -> i32;
}

type struct Plain {
    v: i32;
}

type struct Wrap<T> {
    inner: T;
}

// The impl applies only where its parameter implements Show.
implement<U> trait Show for struct Wrap<U>
where U: Show {
    show(&this) -> i32 { return this.inner.show() + 1; }
}

function main() -> int {
    const w: Wrap<Plain> = Wrap::<Plain> { inner: Plain { v: 7 } };
    return w.inner.v;
}
