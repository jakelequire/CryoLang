+    /// PROBE: what kind of place `e` is, for the MUTREF count.
+    mutref_place(&this, e: ExpressionNode*) -> string {
+        if (e == null) { return "null"; }
+        if ((e as ASTNode*).kind == NodeKind::UnaryExpression) {
+            const u0: UnaryExprNode* = e as UnaryExprNode*;
+            if (u0.op.lexeme == "&") { return "amp<" + this.mutref_place(u0.operand) + ">"; }
+        }
+        if (e.resolved_type.is_valid()) {
+            const t: Type* = this.arena.lookup(e.resolved_type.id);
+            if (t != null && t.kind == TypeKind::Reference) {
+                if ((t as ReferenceType*).is_mutable()) { return "ref-mut"; }
+                return "ref-shared";
+            }
+            if (t != null && t.kind == TypeKind::Pointer) { return "ptr"; }
+        }
+        const k: NodeKind = (e as ASTNode*).kind;
+        if (k == NodeKind::Identifier) {
+            const id: IdentifierNode* = e as IdentifierNode*;
+            mut cls: string = "nonlocal";
+            match (this.state.local_muts.get(&id.name.id)) {
+                Option::Some(m) => { cls = "local-const"; if (m) { cls = "local-mut"; } }
+                Option::None    => { }
+            }
+            return cls;
+        }
+        if (k == NodeKind::MemberAccess) {
+            return "field<" + this.mutref_place((e as MemberAccessNode*).object) + ">";
+        }
+        if (k == NodeKind::ArrayAccess) { return "index"; }
+        if (k == NodeKind::UnaryExpression) {
+            const u: UnaryExprNode* = e as UnaryExprNode*;
+            if (u.op.lexeme == "&") { return "amp<" + this.mutref_place(u.operand) + ">"; }
+            if (u.op.lexeme == "*") { return "deref<" + this.mutref_place(u.operand) + ">"; }
+            return "unary";
+        }
+        if (k == NodeKind::CallExpression) { return "call"; }
+        return "expr";
+    }
+
+    /// PROBE: print one MUTREF line.
+    mutref_line(&this, cat: string, e: ExpressionNode*) -> void {
+        if (e == null) { return; }
+        const sp: SourceSpan = e.span;
+        fmt::eprintln(fmt::format("SHADOW\tMUTREF\t%s\t%s\t%s:%u:%u", cat, this.mutref_place(e),
+            sp.file, sp.start_line, sp.start_col));
+    }
+
+    /// PROBE: a shared reference given for a `mut &` parameter.
+    mutref_arg(&this, arg: ExpressionNode*, arg_ty: TypeRef, param_ty: TypeRef) -> void {
+        if (arg == null || !arg_ty.is_valid() || !param_ty.is_valid()) { return; }
+        const pt: Type* = this.arena.lookup(param_ty.id);
+        const at: Type* = this.arena.lookup(arg_ty.id);
+        if (pt == null || at == null) { return; }
+        if (pt.kind != TypeKind::Reference || !(pt as ReferenceType*).is_mutable()) { return; }
+        if (at.kind == TypeKind::Reference && !(at as ReferenceType*).is_mutable()) {
+            this.mutref_line("arg", arg);
+        }
+    }
+
+    /// PROBE: a call of a `mut &this` method, with what its receiver is.
+    mutref_recv(&this, call: CallExprNode*, member: MemberAccessNode*) -> void {
+        if (call == null || member == null || call.resolved_method == null) { return; }
+        if (call.resolved_method.kind != NodeKind::MethodDeclaration) { return; }
+        const mn: MethodNode* = call.resolved_method as MethodNode*;
+        if (mn.func == null || mn.func.parameters.length == 0) { return; }
+        const rp: VarDeclNode* = mn.func.parameters[0];
+        if (rp == null || !rp.is_ref_receiver() || !rp.resolved_type.is_valid()) { return; }
+        const rt: Type* = this.arena.lookup(rp.resolved_type.id);
+        if (rt == null || rt.kind != TypeKind::Reference || !(rt as ReferenceType*).is_mutable()) { return; }
+        this.mutref_line("recv", member.object);
+    }
