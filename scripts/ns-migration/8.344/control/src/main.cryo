namespace Main;

import std::fmt;

type struct Count {
    n: i32;

    next(mut &this) -> i32 {
        this.n = this.n + 1;
        return this.n;
    }

    peek(&this) -> i32 {
        return this.n;
    }

    sneaky(&this) -> i32 {
        return this.next();
    }

    honest1(mut &this) -> i32 {
        return this.next();
    }
}

type struct Outer {
    c: Count;

    sneaky2(&this) -> i32 {
        return this.c.next();
    }

    honest(mut &this) -> i32 {
        return this.c.next();
    }
}

function bump(c: mut &Count) -> void { c.n = c.n + 1; }

function via_shared(r: &Count) -> void {
    bump(r);
}

function via_shared_method(r: &Count) -> void {
    r.next();
}

function main() -> int {
    const k: Count = Count { n: 0 };
    bump(&k);
    k.next();
    mut m: Count = Count { n: 10 };
    bump(&m);
    m.next();
    via_shared(&k);
    via_shared_method(&k);
    fmt::printf("k=%d m=%d\n", k.n, m.n);
    return 0;
}
