namespace forge_facts::store_ext;

import forge_facts::store::{ MyStore };
import compiler::resolver::symbol_str::{ SymbolStr };

/// A reader declared in an `implement` block in another file than its type,
/// and named nothing like `lookup_*`.
implement struct MyStore {
    owner_of(&this, name: SymbolStr) -> u32 {
        if (name.id == 0) { return 0; }
        return 1;
    }
}
