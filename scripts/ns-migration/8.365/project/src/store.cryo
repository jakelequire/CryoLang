namespace forge_facts::store;

import compiler::resolver::symbol_str::{ SymbolStr };
import compiler::resolver::qualified_name::{ QualifiedName };
import std::collections::hashmap::{ HashMap };

/// A store: owns a map keyed by a spelling's id.
type struct MyStore {
    table: HashMap<u32, u32>;
}

implement struct MyStore {
    static new() -> MyStore {
        return MyStore { table: HashMap::<u32, u32>::new() };
    }

    /// A reader keyed by `string`.
    find_s(&this, key: string) -> u32 {
        if (key.length() == 0) { return 0; }
        return 1;
    }
}

/// An array-backed store: a linear lookup over bare names.
type struct LeafTable {
    names: SymbolStr[];
}

implement struct LeafTable {
    index_of(&this, name: SymbolStr) -> i64 {
        for (mut i: i64 = 0; i < this.names.length; i++) {
            if (this.names[i].id == name.id) { return i; }
        }
        return -1;
    }
}

/// A record with its name inside, and a member table of them.
type struct Rec {
    name: SymbolStr;
    v:    i32;
}

type struct Owner {
    recs: Rec[];
}

implement struct Owner {
    get_rec(&this, name: SymbolStr) -> i32 {
        for (mut i: i64 = 0; i < this.recs.length; i++) {
            if (this.recs[i].name.equals(name)) { return this.recs[i].v; }
        }
        return -1;
    }
}

/// A context carrying a store under a new member.
type struct Ctx {
    tbl:   MyStore*;
    table: LeafTable*;
}

/// Declarations taking a spelling by reference, as an array, and as a path.
type struct Takers {
    dummy: i32;
}

implement struct Takers {
    static take_all(names: &SymbolStr[]) -> i64 { return names.length; }
    static take_path(q: QualifiedName) -> i32 { return 0; }
}
