s00|control: no shape|return 0;
s01|a reader named nothing like lookup_*, declared in an implement block in another file|const st: MyStore = MyStore::new(); return st.owner_of(n) as i32;
s02|a reader keyed by string, not SymbolStr|const st: MyStore = MyStore::new(); return st.find_s("key") as i32;
s03|a store reached through a new member of a context|return ctx.tbl.owner_of(n) as i32;
s04|an array-backed store with a linear lookup|return ctx.table.index_of(n) as i32;
s05|a record-array member table read through its door|return o.get_rec(n);
s06|a read written as a loop, compared by equals|for (mut i: i64 = 0; i < o.recs.length; i++) { if (o.recs[i].name.equals(n)) { return o.recs[i].v; } } return -1;
s07|a read written as a loop through a local bound to the element, compared by id|for (mut i: i64 = 0; i < o.recs.length; i++) { const r: Rec = o.recs[i]; if (r.name.id == n.id) { return r.v; } } return -1;
s08|a derived-name comparison: text resolved first, then compared|const leaf: string = intern.resolve(n); if (leaf == "needle") { return 1; } return 0;
s09|text turned into a module through the graph's text door|if (graph.module_named(intern.intern(text)).is_valid()) { return 1; } return 0;
s10|a receiver no pattern reaches: parenthesized and cast|const p: void* = ctx.tbl as void*; return ((ctx.tbl).owner_of(n) + (p as MyStore*).owner_of(n)) as i32;
s11|a store local spelled like a SymbolStr in an inner block|{ const di: SymbolStr = n; if (di.id == 0) { return 0; } } const di: MyStore* = ctx.tbl; return di.owner_of(n) as i32;
s12|a spelling passed by reference as an array|mut names: SymbolStr[] = []; names.push(n); return Takers::take_all(&names) as i32;
s13|a spelling passed as a QualifiedName|return Takers::take_path(QualifiedName::from_symbol(n));
s14|a compiler store door behind a parenthesized receiver|if ((idx).lookup_type(n).is_valid()) { return 1; } return 0;
