namespace NbOverlap::Shapes;

import std::core::intrinsics;
import std::ffi::libc;

type trait Show {
    show(&this) -> i32;
}

type trait Conv<S> {
    conv(&this) -> i32;
}

type struct Wrap<T> { v: T; }
type struct Pair<A, B> { a: A; b: B; }
type struct Tri<A, B> { a: A; b: B; }
type struct Box2<T> { v: T; }
type struct Nest<T> { v: T; }

// OVERLAP: the D28 shape - a generic head and a concrete one.
implement<T> trait Show for struct Wrap<T>   { show(&this) -> i32 { return 1; } }
implement    trait Show for struct Wrap<i32> { show(&this) -> i32 { return 2; } }

// NO overlap: a repeated parameter against two different concretes.
implement<T> trait Show for struct Pair<T, T>     { show(&this) -> i32 { return 3; } }
implement    trait Show for struct Pair<i32, u8>  { show(&this) -> i32 { return 4; } }

// OVERLAP: Tri<A, B> and Tri<i32, V> unify at Tri<i32, V>.
implement<A, B> trait Show for struct Tri<A, B>   { show(&this) -> i32 { return 5; } }
implement<V>    trait Show for struct Tri<i32, V> { show(&this) -> i32 { return 6; } }

// NO overlap: the trait's own argument differs.
implement trait Conv<i8> for struct Box2<i32> { conv(&this) -> i32 { return 7; } }
implement trait Conv<u8> for struct Box2<i32> { conv(&this) -> i32 { return 8; } }

// OVERLAP through the trait argument: Conv<S> for Nest<S> and Conv<i8> for
// Nest<T> unify at S = T = i8.
implement<S> trait Conv<S>  for struct Nest<S> { conv(&this) -> i32 { return 9; } }
implement<T> trait Conv<i8> for struct Nest<T> { conv(&this) -> i32 { return 10; } }

public function run() -> void {
    const w: Wrap<i32> = Wrap<i32> { v: 1 };
    libc::printf("Wrap<i32>.show()=%d\n", w.show());
}
