namespace NbOverlap::Bound;

import std::core::intrinsics;
import std::ffi::libc;

type trait Alpha { alpha(&this) -> i32; }
type trait Beta  { beta(&this) -> i32; }
type trait Emit  { emit(&this) -> i32; }

type struct Holder<T> { v: T; }

type struct OnlyA { x: i32; }
type struct OnlyB { x: i32; }
type struct Both  { x: i32; }

implement trait Alpha for struct OnlyA { alpha(&this) -> i32 { return 0; } }
implement trait Beta  for struct OnlyB { beta(&this) -> i32 { return 0; } }
implement trait Alpha for struct Both  { alpha(&this) -> i32 { return 0; } }
implement trait Beta  for struct Both  { beta(&this) -> i32 { return 0; } }

// Two heads told apart only by their where-bounds: the pair
// where_bound_leaf_collision pins as accepted.
implement<T> trait Emit for struct Holder<T> where T: Alpha { emit(&this) -> i32 { return 1; } }
implement<T> trait Emit for struct Holder<T> where T: Beta  { emit(&this) -> i32 { return 2; } }

public function run() -> void {
    const a: Holder<OnlyA> = Holder::<OnlyA> { v: OnlyA { x: 0 } };
    const b: Holder<OnlyB> = Holder::<OnlyB> { v: OnlyB { x: 0 } };
    const c: Holder<Both>  = Holder::<Both>  { v: Both  { x: 0 } };
    libc::printf("OnlyA=%d OnlyB=%d Both=%d\n", a.emit(), b.emit(), c.emit());
}
