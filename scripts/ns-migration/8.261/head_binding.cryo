/// One binding made while two impl heads are unified: a parameter of one
/// head (by the side it was written on and its name) stands for a written
/// argument of the other (the annotation and the side it was written on).
/// The two heads' parameters are distinct variables even when they share a
/// spelling - `T` on each side is two `T`s - which is what `side` keeps apart.
type struct HeadBinding {
    side:      i64;
    param:     SymbolStr;
    term:      TypeAnnotation*;
    term_side: i64;
}

