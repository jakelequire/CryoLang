# Test build artifacts
tests/.build/

*.dbg.txt
*.txt
# ...but example input data must ship with the repo; the broad `*.txt` rule
# above otherwise excludes it, so a fresh clone can't run the example.
!examples/**/data/*.txt
# The unit-test roster golden is a committed gate input (scripts/roster-check.py
# diffs `cryo test --list` against it); exempt from the broad `*.txt` rule.
!tests/test-roster.txt
# Vendored third-party license - libLLVM is redistributed (statically linked
# into the Linux `cryo`, shipped as LLVM-C.dll on Windows), so its license is
# committed and bundled into the release archives. Exempt from the `*.txt` rule.
!LLVM-LICENSE.txt

# Python
__pycache__/
*.pyc
*.pyo
*.pyd

# Pinned self-host compiler - committed, exempt from the global `cryo` ignore.
# Refresh via `make pin` whenever compiler/src/ adopts syntax that the
# pinned binary can no longer parse. See CONTRIBUTING.md.
!bin/cryo
# Pin sidecar produced by scripts/cryo-pin.py - committed alongside bin/cryo
# so every pin refresh is a reviewable diff (sha256, build host, git commit).
!bin/cryo.pin.txt
# Windows-pinned self-host compiler - same model, exempt from `**.exe`.
# Built by cross-compiling from Linux with the mingw-w64 toolchain + the
# windows libLLVM-C import lib (see scripts/fetch-windows-llvm.sh), then
# bundled by scripts/cryo-pin.py.
!bin/cryo.exe
!bin/cryo.exe.pin.txt
# Runtime libLLVM-C for bin/cryo.exe.  Fetched by scripts/fetch-windows-llvm.sh
# and copied next to bin/cryo.exe by `make pin`; ~70MB, not committed
# (bin/cryo.exe links it dynamically, like bin/cryo links the system libLLVM).
bin/LLVM-C.dll

# Fetched cross-compile toolchains (windows libLLVM-C import lib + DLL,
# etc.).  Too large to commit; populated on demand by
# scripts/fetch-windows-llvm.sh.
.toolchains/

# Cryo build-output dirs.  `.bin/` is the stdlib's output_dir (and a stray
# root `.bin/` appears when stdlib is built from the repo root); both hold
# only emitted artifacts (objects, IR, manifests, incremental caches), so
# ignore the whole tree.  NOTE the leading dot: this is `.bin/`, distinct
# from the committed pin `bin/cryo`, which is unaffected.
.bin/

# Release packaging output (scripts/build-release.sh, make release)
dist/

*.rsp
*.fp
*.modkeys
