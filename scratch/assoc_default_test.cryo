// Stage 3 test: a trait DEFAULT METHOD whose signature uses `This::Item`
// (both as a parameter and as the return type), materialized into a concrete
// impl. Exercises projection resolution via the impl-context `Item` binding.

import core::option;

type trait Seq {
    type Item;
    next_one(mut &this) -> Option<This::Item>;

    // Default method: returns the next element or `fallback` when exhausted.
    // Both `fallback` and the return type are `This::Item`.
    first_or(mut &this, fallback: This::Item) -> This::Item {
        match (this.next_one()) {
            Option::Some(v) => { return v; }
            Option::None    => { return fallback; }
        }
    }
}

type struct Counter {
    n:     i32;
    limit: i32;
}

implement trait Seq<i32> for struct Counter {
    next_one(mut &this) -> Option<i32> {
        if (this.n >= this.limit) { return Option::None; }
        const v: i32 = this.n;
        this.n = this.n + 1;
        return Option::Some(v);
    }
}

function main() -> i32 {
    mut c: Counter = Counter { n: 5, limit: 10 };
    // first_or drives the default method; Item = i32, so fallback is an i32.
    return c.first_or(99);   // expect 5 (n starts at 5, not exhausted)
}
