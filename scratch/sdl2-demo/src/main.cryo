// SDL2 stress-test demo for the Cryo vendor binding system.
//   - 850 vendored SDL functions, structs/enums/fn-pointers
//   - exercises the SDL_Event UNION via generated get/set accessors
//   - auto-terminates (~2.5s) so it never hangs a headless run
import vendor::SDL2;
import std::fmt;

function main() -> i32 {
    SDL2::SDL_SetMainReady();
    if (SDL2::SDL_Init(SDL2::SDL_INIT_VIDEO) != 0) {
        fmt::eprintln(f"SDL_Init failed: {SDL2::SDL_GetError() as string}");
        return 1;
    }

    const win: SDL2::SDL_Window* = SDL2::SDL_CreateWindow(
        "Cryo + SDL2 (vendored bindings)" as i8*,
        100, 100, 640, 480, 4u32);          // 4 = SDL_WINDOW_SHOWN
    if (win == null) {
        fmt::eprintln(f"CreateWindow failed: {SDL2::SDL_GetError() as string}");
        SDL2::SDL_Quit();
        return 1;
    }
    const ren: SDL2::SDL_Renderer* = SDL2::SDL_CreateRenderer(win, -1, 0u32);
    if (ren == null) {
        fmt::eprintln(f"CreateRenderer failed: {SDL2::SDL_GetError() as string}");
        SDL2::SDL_DestroyWindow(win);
        SDL2::SDL_Quit();
        return 1;
    }

    const QUIT:    u32 = SDL2::SDL_EventType::SDL_QUIT as u32;
    const KEYDOWN: u32 = SDL2::SDL_EventType::SDL_KEYDOWN as u32;
    const MOUSEMV: u32 = SDL2::SDL_EventType::SDL_MOUSEMOTION as u32;
    const USEREV:  u32 = SDL2::SDL_EventType::SDL_USEREVENT as u32;

    // Round-trip a synthetic event THROUGH the SDL_Event union to prove the
    // generated reinterpret accessors carry real overlaid data: write the
    // user-event view with `set_user`, push it onto SDL's queue, then read it
    // back below via `user()`.  Works headless (no window focus needed).
    mut seed: SDL2::SDL_Event = SDL2::SDL_Event { _storage: [0u8; 56] };
    seed.set_user(SDL2::SDL_UserEvent {
        type_: USEREV, timestamp: 0u32, windowID: 0u32,
        code: 12345, data1: null, data2: null });
    fmt::println(f"union write: set_user(code=12345) -> e.type_()={seed.type_()} (want {USEREV})");
    SDL2::SDL_PushEvent(&seed);

    const start: u32 = SDL2::SDL_GetTicks();
    mut running: boolean = true;
    mut frames: i64 = 0;
    mut keydowns: i64 = 0;
    mut mousemoves: i64 = 0;
    mut roundtrip_code: i32 = -1;

    while (running) {
        mut e: SDL2::SDL_Event = SDL2::SDL_Event { _storage: [0u8; 56] };
        while (SDL2::SDL_PollEvent(&e) != 0) {
            const et: u32 = e.type_();                 // <-- union accessor (the type tag)
            if (et == QUIT) {
                running = false;
            } else if (et == USEREV) {
                const ue: SDL2::SDL_UserEvent = e.user();   // <-- union reinterpret read
                roundtrip_code = ue.code;
            } else if (et == KEYDOWN) {
                keydowns += 1;
                const ke: SDL2::SDL_KeyboardEvent = e.key();   // <-- union reinterpret accessor
                const sym: i32 = ke.keysym.sym;
                fmt::println(f"  keydown: sym={sym} ({SDL2::SDL_GetKeyName(sym) as string})");
                if (sym == 27) { running = false; }            // ESC
            } else if (et == MOUSEMV) {
                mousemoves += 1;
            }
        }

        const elapsed: u32 = SDL2::SDL_GetTicks() - start;
        const c: u8 = ((elapsed / 8u32) % 256u32) as u8;
        SDL2::SDL_SetRenderDrawColor(ren, c, 64u8, (255u32 - c as u32) as u8, 255u8);
        SDL2::SDL_RenderClear(ren);
        SDL2::SDL_RenderPresent(ren);
        SDL2::SDL_Delay(16u32);
        frames += 1;
        if (elapsed > 2500u32) { running = false; }
    }

    const rt_ok: string = if (roundtrip_code == 12345) { "OK" } else { "FAIL" };
    fmt::println(f"union read : e.user().code={roundtrip_code} (want 12345) -> {rt_ok}");
    fmt::println(f"done: {frames} frames, {keydowns} keydowns, {mousemoves} mouse-moves");
    SDL2::SDL_DestroyRenderer(ren);
    SDL2::SDL_DestroyWindow(win);
    SDL2::SDL_Quit();
    return 0;
}
