type trait Seq {
    type Item;
    get(&this) -> This::Item;
    get_or(&this, fallback: This::Item) -> This::Item {
        return this.get();
    }
}
type struct Box { v: i32; }
implement trait Seq<i32> for struct Box {
    get(&this) -> i32 { return this.v; }
}
function main() -> i32 {
    const b: Box = Box { v: 5 };
    return b.get_or(99);
}
