// Stage 3 adapter test: a generic adapter that projects `I::Item` — the shape
// the stdlib iterator adapters take after migration (MapIter<I,O> etc.).
// `First<I>` forwards its inner iterator, binding `type Item = I::Item` and
// returning `Option<I::Item>`. When monomorphized (I = IntSeq), `I::Item` must
// reduce to i32 (IntSeq's Item binding).

import core::option;

type trait Seq {
    type Item;
    next_one(mut &this) -> Option<This::Item>;
}

type struct IntSeq {
    n:   i32;
    lim: i32;
}

implement trait Seq<i32> for struct IntSeq {
    next_one(mut &this) -> Option<i32> {
        if (this.n >= this.lim) { return Option::None; }
        const v: i32 = this.n;
        this.n = this.n + 1;
        return Option::Some(v);
    }
}

type struct First<I> {
    inner: I;
}

implement<I> trait Seq for struct First<I> where I: Seq {
    type Item = I::Item;
    next_one(mut &this) -> Option<I::Item> {
        return this.inner.next_one();
    }
}

function main() -> i32 {
    mut s: IntSeq = IntSeq { n: 7, lim: 10 };
    mut f: First<IntSeq> = First<IntSeq> { inner: s };
    match (f.next_one()) {
        Option::Some(v) => { return v; }   // expect 7
        Option::None    => { return 0; }
    }
}
