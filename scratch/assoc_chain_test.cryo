// Chained adapters: First<First<IntSeq>> — projection through a projection.
// I::Item where I is itself an adapter whose Item is a projection.
import core::option;

type trait Seq {
    type Item;
    next_one(mut &this) -> Option<This::Item>;
}

type struct IntSeq { n: i32; lim: i32; }
implement trait Seq<i32> for struct IntSeq {
    next_one(mut &this) -> Option<i32> {
        if (this.n >= this.lim) { return Option::None; }
        const v: i32 = this.n; this.n = this.n + 1; return Option::Some(v);
    }
}

type struct First<I> { inner: I; }
implement<I> trait Seq for struct First<I> where I: Seq {
    type Item = I::Item;
    next_one(mut &this) -> Option<I::Item> {
        return this.inner.next_one();
    }
}

function main() -> i32 {
    mut s: IntSeq = IntSeq { n: 4, lim: 10 };
    mut f1: First<IntSeq> = First<IntSeq> { inner: s };
    mut f2: First<First<IntSeq>> = First<First<IntSeq>> { inner: f1 };
    match (f2.next_one()) {
        Option::Some(v) => { return v; }   // expect 4
        Option::None    => { return 0; }
    }
}
