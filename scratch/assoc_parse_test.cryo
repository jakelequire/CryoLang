// Stage 1 parse smoke test for associated types.
// Exercises: `type Item;` decl, `This::Item` projection in a return type,
// positional-sugar impl header `Seq<i32>`, and the `type Item = T;` body form.
// Resolution is not implemented yet (Stage 3), so this is expected to fail at
// type-resolution; the gate is that it PARSES (no E01xx parse errors).

type trait Seq {
    type Item;
    get(&this) -> This::Item;
}

type struct IntBox {
    v: i32;
}

implement trait Seq<i32> for struct IntBox {
    get(&this) -> i32 { return this.v; }
}

type struct LongBox {
    v: i64;
}

implement trait Seq for struct LongBox {
    type Item = i64;
    get(&this) -> i64 { return this.v; }
}

function main() -> i32 {
    const b: IntBox = IntBox { v: 7 };
    return b.get();
}
