/// Round-3 consumer: exercises the bindable round-3 surface (by-value-returning
/// methods, a typedef'd param, an opaque handle API, and a void out-param fn).
/// Importing this module also forces the whole generated binding to PARSE — so
/// if the bindgen emitted an invalid decl (e.g. a raw `operator+` method name),
/// the build fails here.
namespace Round3::Consumer;

import vendor::Round3;
import std::fmt;

mut FAILS: i32 = 0;
function ck(cond: boolean, label: string) -> void {
    if (!cond) { FAILS = FAILS + 1; fmt::eprintf("FAIL: %s\n", label); }
}

function main() -> int {
    const v: Round3::Vec3 = Round3::Vec3 { x: 1.0, y: 2.0, z: 3.0 };
    ck(v.length_sq() == 14.0, "Vec3::length_sq");

    mut o: Round3::Vec3 = Round3::Vec3 { x: 10.0, y: 20.0, z: 30.0 };
    const s: Round3::Vec3 = v.add(&o);
    ck(s.x == 11.0 && s.y == 22.0 && s.z == 33.0, "Vec3::add by-value return");

    mut ex: Round3::Vec3 = Round3::Vec3 { x: 1.0, y: 0.0, z: 0.0 };
    mut ey: Round3::Vec3 = Round3::Vec3 { x: 0.0, y: 1.0, z: 0.0 };
    const cz: Round3::Vec3 = ex.cross(&ey);   // x cross y = z
    ck(cz.x == 0.0 && cz.y == 0.0 && cz.z == 1.0, "Vec3::cross");

    // typedef'd parameter name (Point3 == Vec3)
    ck(Round3::point3_x(&v) == 1.0, "point3_x via typedef");

    // opaque handle API (Engine is forward-declared -> opaque pointer)
    const e: Round3::Engine* = Round3::engine_create(10 as i32);
    ck(Round3::engine_tick(e) == 11 as i32, "engine_tick (opaque handle)");
    Round3::engine_destroy(e);

    // void return + pointer out-params
    mut lo: i32 = 0 as i32;
    mut hi: i32 = 0 as i32;
    Round3::split_halves(7 as i32, &lo, &hi);
    ck(lo == 3 as i32 && hi == 4 as i32, "split_halves out-params");

    if (FAILS != 0 as i32) { fmt::eprintf("ROUND3: %d FAILED\n", FAILS); return 1; }
    fmt::printf("ROUND3 OK: bindable surface links + runs.\n");
    return 0;
}
