// Stage 6 repro: combinator default returning an adapter parameterized by This,
// with a (This::Item)->B param, called on an adapter CALL-EXPR receiver
// (c.take(2).map(dbl)). Exercises both Stage-6 compiler fixes:
//   1) projecting ::Item off a where-clause-only adapter (TakeSq),
//   2) recovering the InstantiatedType wrapper for a concrete spec receiver.
import core::option;
type trait Seq {
    type Item;
    next(mut &this) -> Option<This::Item>;
    map<B>(this, f: (This::Item) -> B) -> MapSq<This, B> { return MapSq::new(this, f); }
    take(this, n: u64) -> TakeSq<This> { return TakeSq::new(this, n); }
}
type struct Counter { n: i32; lim: i32; }
implement trait Seq<i32> for struct Counter {
    next(mut &this) -> Option<i32> {
        if (this.n >= this.lim) { return Option::None; }
        const v: i32 = this.n; this.n = this.n + 1; return Option::Some(v);
    }
}
type struct TakeSq<I> { inner: I; remaining: u64;
    static new(inner: I, n: u64) -> TakeSq<I> { return TakeSq<I> { inner: inner, remaining: n }; }
}
implement<I, A> trait Seq<A> for struct TakeSq<I> where I: Seq<A> {
    next(mut &this) -> Option<A> {
        if (this.remaining == 0) { return Option::None; }
        this.remaining = this.remaining - 1;
        return this.inner.next();
    }
}
type struct MapSq<I, O> { inner: I; f: (I::Item) -> O;
    static new(inner: I, f: (I::Item) -> O) -> MapSq<I, O> { return MapSq<I, O> { inner: inner, f: f }; }
}
implement<I, O> trait Seq<O> for struct MapSq<I, O> where I: Seq {
    next(mut &this) -> Option<O> {
        return match (this.inner.next()) {
            Option::Some(v) => { Option::Some(this.f(v)) }
            Option::None    => { Option::None }
        };
    }
}
function dbl(x: i32) -> i32 { return x * 2; }
function main() -> i32 {
    mut c: Counter = Counter { n: 1, lim: 5 };       // 1,2,3,4
    mut m: MapSq<TakeSq<Counter>, i32> = c.take(2).map(dbl);  // 1,2 -> 2,4
    mut sum: i32 = 0;
    loop {
        match (m.next()) {
            Option::Some(v) => { sum = sum + v; }
            Option::None    => { break; }
        }
    }
    return sum;   // expect 6
}
