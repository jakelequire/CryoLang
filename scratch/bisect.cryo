import core::option;
type trait Seq { type Item; next_one(mut &this) -> Option<This::Item>; }
type struct First<I> { inner: I; }
implement<I> trait Seq<I::Item> for struct First<I> where I: Seq {
    next_one(mut &this) -> Option<I::Item> { return Option::None; }
}
