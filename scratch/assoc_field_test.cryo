// Projection in a STRUCT FIELD type — the MapIter<I,O> { f: (I::Item)->O } shape.
import core::option;

type trait Seq {
    type Item;
    next_one(mut &this) -> Option<This::Item>;
}

type struct IntSeq { n: i32; lim: i32; }
implement trait Seq<i32> for struct IntSeq {
    next_one(mut &this) -> Option<i32> {
        if (this.n >= this.lim) { return Option::None; }
        const v: i32 = this.n; this.n = this.n + 1; return Option::Some(v);
    }
}

// Adapter storing a mapping fn whose INPUT is the inner element type I::Item.
type struct MapSeq<I, O> {
    inner: I;
    f:     (I::Item) -> O;
}

implement<I, O> trait Seq<O> for struct MapSeq<I, O> where I: Seq {
    next_one(mut &this) -> Option<O> {
        return match (this.inner.next_one()) {
            Option::Some(v) => { Option::Some(this.f(v)) }
            Option::None    => { Option::None }
        };
    }
}

function dbl(x: i32) -> i32 { return x * 2; }

function main() -> i32 {
    mut s: IntSeq = IntSeq { n: 3, lim: 9 };
    mut m: MapSeq<IntSeq, i32> = MapSeq<IntSeq, i32> { inner: s, f: dbl };
    match (m.next_one()) {
        Option::Some(v) => { return v; }   // expect 3*2 = 6
        Option::None    => { return 0; }
    }
}
