# cpp-demo — §4 de-risk probe for the C++ binding generator.
#
# Binds three C++ entities (a namespace free function, a non-virtual const
# method, and a static member) by their MANGLED symbols via `![link(...)]`,
# linking against the local `lib/libcpptest.a` (built with `g++` + `ar`).  No
# C++ shim, no generator — this is the by-hand proof that Strategy A is viable.
#
# `static = ["lib/libcpptest.a"]` is the verbatim archive path; `stdc++` is the
# C++ runtime every C++ object needs (here it is technically unused, but it is
# what the vendor registry will auto-inject for a real C++ lib).
[project]
project_name = "cpp_demo"
output_dir   = "build"
target_type  = "executable"
source_dir   = "src"
entry_point  = "src/main.cryo"

[compiler]

[dependencies]

[link]
static = ["lib/libcpptest.a"]
system = ["stdc++"]
