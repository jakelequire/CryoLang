/// Consumer of the GENERATED C++ bindings (no hand-written FFI): everything
/// under `CppTest::` comes from `cryo vendor`'s libclang walk of `cpptest.hpp`.
/// Exercises the full Phase-1 bindable surface end-to-end (parse -> emit ->
/// resolve -> link -> RUN), with a focus on the ABI-tricky cases: enum-by-value
/// params, a static factory returning a struct by value, and an instance method
/// returning a 16-byte aggregate by value.
namespace CppConsumer::Main;

import vendor::CppTest;
import std::fmt;

function check(cond: boolean, label: string) -> boolean {
    if (!cond) { fmt::eprintf("FAIL: %s\n", label); }
    return cond;
}

function main() -> int {
    mut ok: boolean = true;

    // --- namespace free functions, varied scalar types -------------------
    ok = check(CppTest::add(2 as i32, 3 as i32) == 5 as i32, "add") && ok;
    ok = check(CppTest::sub_long(10 as i64, 3 as i64) == 7 as i64, "sub_long") && ok;
    ok = check(CppTest::scale(2.5, 4.0) == 10.0, "scale") && ok;
    ok = check(CppTest::is_even(4 as i32), "is_even(4)") && ok;
    ok = check(!CppTest::is_even(5 as i32), "is_even(5)") && ok;
    // nested namespace `demo::math::mul`, flattened under CppTest
    ok = check(CppTest::mul(6 as i32, 7 as i32) == 42 as i32, "math::mul") && ok;

    // pointer param + return: clamp a below-floor value up to the floor.
    mut pv: i32 = 3 as i32;
    const pret: i32* = CppTest::clamp_ptr(&pv, 10 as i32);
    ok = check(pv == 10 as i32, "clamp_ptr mutates") && ok;
    ok = check(*pret == 10 as i32, "clamp_ptr returns ptr") && ok;

    // C enum passed BY VALUE (Color -> u32 underlying).
    ok = check(CppTest::color_code(CppTest::Color::ColGreen) == 10 as u32, "color_code green") && ok;
    ok = check(CppTest::color_code(CppTest::Color::ColBlue) == 20 as u32, "color_code blue") && ok;

    // --- Point: const method + static ------------------------------------
    mut p: CppTest::Point = CppTest::Point { x: 40 as i32, y: 2 as i32 };
    ok = check(p.sum() == 42 as i32, "Point::sum") && ok;
    ok = check(CppTest::Point::origin_x() == 0 as i32, "Point::origin_x") && ok;

    // --- Box: int& / const int& reference methods ------------------------
    mut b: CppTest::Box = CppTest::Box { v: 7 as i32 };
    mut nv: i32 = 99 as i32;
    b.set(&nv);
    ok = check(*b.get() == 99 as i32, "Box ref get/set") && ok;

    // --- Counter: mutating methods + static factory returning BY VALUE ---
    mut c: CppTest::Counter = CppTest::Counter::make(5 as i32);   // struct-by-value return
    ok = check(c.value() == 5 as i32, "Counter::make by-value return") && ok;
    c.inc();
    c.add_n(4 as i32);
    ok = check(c.value() == 10 as i32, "Counter mutating methods") && ok;

    // --- Vec2: const-ref struct param + 16-byte aggregate BY VALUE -------
    const v: CppTest::Vec2 = CppTest::Vec2 { x: 3.0, y: 4.0 };
    mut vcopy: CppTest::Vec2 = CppTest::Vec2 { x: 3.0, y: 4.0 };
    ok = check(v.dot(&vcopy) == 25.0, "Vec2::dot (const-ref param)") && ok;
    const scaled: CppTest::Vec2 = v.scaled(2.0);                  // returns Vec2 by value
    ok = check(scaled.x == 6.0 && scaled.y == 8.0, "Vec2::scaled by-value return") && ok;

    if (!ok) { fmt::eprintf("VENDOR C++: one or more checks FAILED\n"); return 1; }
    fmt::printf("VENDOR C++ OK: %d-feature bindable surface links + runs.\n", 18 as i32);
    return 0;
}
