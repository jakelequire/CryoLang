/// Consumer of the GENERATED C++ bindings (no hand-written FFI): everything
/// under `CppTest::` comes from `cryo vendor`'s libclang walk of `cpptest.hpp`.
///   - `CppTest::add`            -> namespace function `demo::add`
///   - `p.sum()` / `Point::origin_x()` -> real Cryo methods on the bound class
namespace CppConsumer::Main;

import vendor::CppTest;
import std::fmt;

function main() -> int {
    const s: i32 = CppTest::add(2 as i32, 3 as i32);          // expect 5
    mut p: CppTest::Point = CppTest::Point { x: 40 as i32, y: 2 as i32 };
    const ps: i32 = p.sum();                                  // expect 42 (method)
    const ox: i32 = CppTest::Point::origin_x();               // expect 0  (static)

    // Box exercises C++ reference params/returns (int& / const int& -> i32*).
    mut b: CppTest::Box = CppTest::Box { v: 7 as i32 };
    mut nv: i32 = 99 as i32;
    b.set(&nv);                                               // v = 99
    const got: i32 = *b.get();                                // expect 99

    fmt::printf("CppTest::add(2,3) = %d\n", s);
    fmt::printf("p.sum() = %d, Point::origin_x() = %d\n", ps, ox);
    fmt::printf("Box after set(99): get() = %d\n", got);

    if (s != 5 as i32)   { fmt::eprintf("FAIL add\n");      return 1; }
    if (ps != 42 as i32) { fmt::eprintf("FAIL sum\n");      return 2; }
    if (ox != 0 as i32)  { fmt::eprintf("FAIL origin_x\n"); return 3; }
    if (got != 99 as i32){ fmt::eprintf("FAIL Box ref\n");  return 4; }
    fmt::printf("VENDOR C++ OK: generated bindings link + run.\n");
    return 0;
}
