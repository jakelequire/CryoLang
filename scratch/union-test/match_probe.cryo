type union Value {
    i: i64;
    f: f64;
    tag: i32;
}

// match on a union FIELD value
function classify(v: Value*) -> i32 {
    match (v.i) {
        0 => { return 100; }
        1 => { return 200; }
        _ => { return 999; }
    }
}

// static match on a generic union's type param
type union Holder<T> {
    val: T;
    raw: i64;

    kind_code(&this) -> i32 {
        static match (T) {
            i64 => { return 1; }
            f64 => { return 2; }
            _   => { return 0; }
        }
    }
}

function main() -> i32 {
    mut v: Value = Value { i: 1 };
    printf("classify=%d\n", classify(&v));

    mut h: Holder<f64> = Holder<f64> { val: 3.14 };
    printf("kind=%d\n", h.kind_code());
    return 0;
}
