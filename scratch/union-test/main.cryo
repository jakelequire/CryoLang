// Smoke test for first-class `type union`.

type union Value {
    i: i64;
    f: f64;
    bytes: u8;

    static from_int(n: i64) -> Value {
        return Value { i: n };
    }

    get_i(&this) -> i64 {
        return this.i;
    }
}

// Generic union
type union Either<A, B> {
    a: A;
    b: B;
}

function main() -> i32 {
    mut v: Value = Value { i: 42 };
    printf("i = %lld\n", v.get_i());

    // reinterpret: write float, read raw int bits back
    v.f = 1.5;
    printf("f = %f\n", v.f);

    mut v2: Value = Value::from_int(7);
    printf("from_int = %lld\n", v2.i);

    mut e: Either<i64, f64> = Either<i64, f64> { a: 100 };
    printf("either.a = %lld\n", e.a);

    // size = max(member) ; i64/f64 => 8 bytes
    printf("sizeof(Value) = %llu\n", sizeof(Value));
    return 0;
}
