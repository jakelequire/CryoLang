/// llvm-demo — uses the vendored LLVM-C bindings (923 functions) to BUILD an
/// LLVM module in memory: an `add(i32, i32)` function, verified and printed as
/// textual IR.  The Cryo compiler self-hosts on this same LLVM-C API — so this
/// is the compiler driving its own backend through the vendor system.
namespace LlvmDemo::Main;

import LLVM;
import std::fmt;

function main() -> int {
    const m: LLVM::LLVMModuleRef = LLVM::LLVMModuleCreateWithName("cryo_demo");

    // i32 add(i32, i32)
    const i32t: LLVM::LLVMTypeRef = LLVM::LLVMInt32Type();
    mut params: LLVM::LLVMTypeRef[2] = [i32t, i32t];
    const fnty: LLVM::LLVMTypeRef = LLVM::LLVMFunctionType(i32t, &params[0], 2u32, 0);
    const fn: LLVM::LLVMValueRef = LLVM::LLVMAddFunction(m, "add", fnty);

    // entry: %sum = add %0, %1 ; ret %sum
    const bb: LLVM::LLVMBasicBlockRef = LLVM::LLVMAppendBasicBlock(fn, "entry");
    const b: LLVM::LLVMBuilderRef = LLVM::LLVMCreateBuilder();
    LLVM::LLVMPositionBuilderAtEnd(b, bb);
    const a0: LLVM::LLVMValueRef = LLVM::LLVMGetParam(fn, 0u32);
    const a1: LLVM::LLVMValueRef = LLVM::LLVMGetParam(fn, 1u32);
    const sum: LLVM::LLVMValueRef = LLVM::LLVMBuildAdd(b, a0, a1, "sum");
    LLVM::LLVMBuildRet(b, sum);

    // Verify and print.
    mut err: i8* = null;
    const bad: i32 = LLVM::LLVMVerifyModule(
        m, LLVM::LLVMVerifierFailureAction::LLVMReturnStatusAction, &err);

    const ir: i8* = LLVM::LLVMPrintModuleToString(m);
    fmt::printf("=== Cryo built this LLVM IR via the vendored LLVM-C API (verify=%s) ===\n%s",
        if (bad == 0) { "ok" } else { "FAIL" }, ir as string);

    LLVM::LLVMDisposeBuilder(b);
    LLVM::LLVMDisposeModule(m);
    return bad;
}
