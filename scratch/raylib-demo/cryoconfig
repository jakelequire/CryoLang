# raylib-demo — a standalone scratch project to try the vendored raylib bindings.
#
# Note the deliberately EMPTY [link] section: -lraylib (plus the per-OS
# opengl32/gdi32/winmm set) is injected automatically from the vendor registry
# entry's link metadata. The single `import vendor::RayLib` in src/main.cryo is
# the whole integration surface — no hand-written bindings, no manual link flags.
#
# Prereq: raylib has been registered once with
#   cryo vendor C:/Programming/3rd-party/raylib

[project]
project_name = "raylib_demo"
output_dir   = "build"
target_type  = "executable"
source_dir   = "src"
entry_point  = "src/main.cryo"

[compiler]

[dependencies]
