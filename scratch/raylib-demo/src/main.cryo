/// raylib-demo — a first-window raylib demo driven entirely by vendored,
/// auto-generated bindings.
///
/// Everything under `RayLib::` (the `Color`/`Vector2`/`Rectangle` structs and
/// the `InitWindow` / `BeginDrawing` / ... functions) comes from the `.cryo`
/// bindings `cryo vendor` produced from raylib's headers — nothing here is
/// hand-written FFI, and the cryoconfig declares no link flags.  The single
/// `import vendor::RayLib` is the whole integration surface.
namespace RaylibDemo::Main;

import vendor::RayLib;

function main() -> int {
    RayLib::InitWindow(800, 450, "Cryo + raylib — vendored bindings");
    RayLib::SetTargetFPS(60);

    // raylib ships its palette as compound-literal `#define`s, e.g.
    //   #define RAYWHITE (Color){ 245, 245, 245, 255 }
    // The vendor binding generator now lowers these straight to struct-literal
    // consts (`const RAYWHITE: Color = Color { r: 245, ... }`), so the palette
    // is usable directly as `RayLib::<NAME>` — no hand-built Color values.
    while (!RayLib::WindowShouldClose()) {
        RayLib::BeginDrawing();
        RayLib::ClearBackground(RayLib::RAYWHITE);
        RayLib::DrawText("Congrats! You created your first Cryo window.",
                         150, 180, 20, RayLib::DARKGRAY);
        RayLib::DrawRectangle(330, 220, 140, 60, RayLib::MAROON);   // by-value Color
        RayLib::EndDrawing();
    }

    RayLib::CloseWindow();
    return 0;
}
