namespace NegConst;

import std::core::intrinsics;

// B1 regression: negative integer module-level const globals must carry
// their real value, not silently become 0.
const NEG_I32:  i32 = -5;
const NEG_I64:  i64 = -100;
const POS_I32:  i32 = 7;
const EOF:      i32 = -1;
const AT_FDCWD: i32 = -100;
// Exercise the folder's binary/shift/bitwise ops (sign-independent).
const FLAGS:    u32 = (1 << 4) | (1 << 2);   // 20
const NEG_EXPR: i32 = 0 - 42;                // -42

function main() -> int {
    intrinsics::printf("%d %d %d %d %d %d %d\n",
        NEG_I32, NEG_I64, POS_I32, EOF, AT_FDCWD, FLAGS as i32, NEG_EXPR);
    return 0;
}
