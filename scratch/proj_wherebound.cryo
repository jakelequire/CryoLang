import core::option;
type trait Seq { type Item; next(mut &this) -> Option<This::Item>; }
type struct Counter { n: i32; lim: i32; }
implement trait Seq<i32> for struct Counter {
    next(mut &this) -> Option<i32> { return Option::None; }
}
// where-clause-only adapter: Item bound to A via `where I: Seq<A>`
type struct TakeSq<I> { inner: I; }
implement<I, A> trait Seq<A> for struct TakeSq<I> where I: Seq<A> {
    next(mut &this) -> Option<A> { return this.inner.next(); }
}
// Now an adapter that PROJECTS ::Item off a where-clause-only adapter via a field.
type struct Wrap<J, O> { inner: J; f: (J::Item) -> O; }
implement<J, O> trait Seq<O> for struct Wrap<J, O> where J: Seq {
    next(mut &this) -> Option<O> {
        return match (this.inner.next()) {
            Option::Some(v) => { Option::Some(this.f(v)) }
            Option::None    => { Option::None }
        };
    }
}
function dbl(x: i32) -> i32 { return x * 2; }
function main() -> i32 {
    mut c: Counter = Counter { n: 1, lim: 5 };
    mut t: TakeSq<Counter> = TakeSq<Counter> { inner: c };
    // direct struct literal (no static new) projecting TakeSq<Counter>::Item
    mut w: Wrap<TakeSq<Counter>, i32> = Wrap<TakeSq<Counter>, i32> { inner: t, f: dbl };
    return 0;
}
