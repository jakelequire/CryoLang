import core::option;
type trait Seq { type Item; next_one(mut &this) -> Option<This::Item>; }
type struct IntSeq { n: i32; lim: i32; }
implement trait Seq<i32> for struct IntSeq {
    next_one(mut &this) -> Option<i32> { return Option::None; }
}
type struct First<I> { inner: I; }
// impl WITHOUT a projection in the binding: bind Item to a fixed type
implement<I> trait Seq<i32> for struct First<I> where I: Seq {
    next_one(mut &this) -> Option<i32> { return Option::None; }
}
function main() -> i32 {
    mut s: IntSeq = IntSeq { n: 4, lim: 10 };
    mut f1: First<IntSeq> = First<IntSeq> { inner: s };
    mut f2: First<First<IntSeq>> = First<First<IntSeq>> { inner: f1 };
    return 0;
}
