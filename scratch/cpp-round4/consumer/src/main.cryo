/// Round-4 consumer: multi-header vendor library + enum gaps + const char*
/// + a nested-struct param lowered to an opaque blob.
namespace Round4::Consumer;

import vendor::Round4;
import std::fmt;

mut FAILS: i32 = 0;
function ck(cond: boolean, label: string) -> void {
    if (!cond) { FAILS = FAILS + 1; fmt::eprintf("FAIL: %s\n", label); }
}

function main() -> int {
    // header 1: struct method + enum with a gap / implicit values
    const r: Round4::Rect = Round4::Rect { w: 3 as i32, h: 4 as i32 };
    ck(r.area() == 12 as i32, "Rect::area (header 1)");
    ck(Round4::quad_code(Round4::Quadrant::Q3) == 10 as i32, "enum gap Q3 == 10");
    ck(Round4::quad_code(Round4::Quadrant::Q2) == 1 as i32, "enum implicit Q2 == 1");

    // header 2: const char* in (cstr_len) and out (pick_word), chained.
    ck(Round4::cstr_len("hello" as i8*) == 5 as u32, "cstr_len(const char*)");
    const w: i8* = Round4::pick_word(1 as i32);            // "beta"
    ck(Round4::cstr_len(w) == 4 as u32, "pick_word returns usable const char*");

    // nested struct Config::Entry came across as an opaque u32[2] blob
    // ({key, val}); construct the blob and pass a pointer to it.
    mut e: u32[2] = [10 as u32, 20 as u32];
    ck(Round4::entry_sum(&e) == 30 as i32, "nested-struct-as-blob param");

    const cfg: Round4::Config = Round4::Config { n: 21 as i32 };
    ck(cfg.doubled_n() == 42 as i32, "Config::doubled_n (header 2)");

    if (FAILS != 0 as i32) { fmt::eprintf("ROUND4: %d FAILED\n", FAILS); return 1; }
    fmt::printf("ROUND4 OK: multi-header bindable surface links + runs.\n");
    return 0;
}
