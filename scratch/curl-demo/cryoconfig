# curl-demo — scratch project for the generated libcurl bindings.  Fetches a
# local file over curl's file:// protocol (deterministic, no network, headless),
# exercising the VARIADIC curl_easy_setopt and a Cryo function passed as curl's
# C write-callback.  Binding lives in bindings/Curl.cryo (source_paths); -lcurl
# is what the vendor registry would otherwise inject.
[project]
project_name = "curl_demo"
output_dir   = "build"
target_type  = "executable"
source_dir   = "src"
source_paths = ["bindings"]
entry_point  = "src/main.cryo"
[compiler]
[dependencies]
[link]
system = ["curl"]
