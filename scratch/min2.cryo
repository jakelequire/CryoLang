import core::option;
type trait Seq {
    type Item;
    next_one(mut &this) -> Option<This::Item>;
}
type struct Box { v: i32; }
implement trait Seq<i32> for struct Box {
    next_one(mut &this) -> Option<i32> { return Option::Some(this.v); }
}
function main() -> i32 {
    mut b: Box = Box { v: 5 };
    match (b.next_one()) {
        Option::Some(x) => { return x; }
        Option::None => { return 0; }
    }
}
