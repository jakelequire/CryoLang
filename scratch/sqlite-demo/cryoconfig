# sqlite-demo — a scratch project for inspecting (and running against) the Cryo
# bindings the binding generator produced from SQLite's `sqlite3.h`.
#
# The generated binding lives in `bindings/Sqlite.cryo` (namespace `Sqlite`),
# added as an extra source root via `source_paths` so `import Sqlite` resolves
# to it WITHOUT going through the global vendor registry — this project is
# self-contained for inspection.  (`cryo vendor` + `import vendor::Sqlite` is the
# normal path; here the file is checked in so you can read it.)
#
# `[link] system = ["sqlite3"]` is what the vendor registry would otherwise
# inject automatically; the binding's `extern "C"` symbols resolve against the
# system libsqlite3.

[project]
project_name = "sqlite_demo"
output_dir   = "build"
target_type  = "executable"
source_dir   = "src"
source_paths = ["bindings"]
entry_point  = "src/main.cryo"

[compiler]

[dependencies]

[link]
system = ["sqlite3"]
