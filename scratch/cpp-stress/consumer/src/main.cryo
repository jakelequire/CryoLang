/// Stress consumer for the generated `vendor::CppStress` C++ bindings.
/// Every value is checked against the C++ semantics so an ABI/layout mismatch
/// (wrong field offset, wrong by-value/sret lowering) shows up as a FAIL rather
/// than a silent wrong answer.
namespace CppStress::Consumer;

import vendor::CppStress;
import std::fmt;

mut FAILS: i32 = 0;
function ck(cond: boolean, label: string) -> void {
    if (!cond) { FAILS = FAILS + 1; fmt::eprintf("FAIL: %s\n", label); }
}
function ckf(cond: boolean, label: string) -> void {
    if (!cond) { FAILS = FAILS + 1; fmt::eprintf("FAIL: %s\n", label); }
}

function main() -> int {
    // ---- scalars ----
    ck(CppStress::s8(1 as i8) == 2 as i8, "s8");
    ck(CppStress::s16(100 as i16) == 101 as i16, "s16");
    ck(CppStress::s32(5 as i32) == 6 as i32, "s32");
    ck(CppStress::s64(5000000000 as i64) == 5000000001 as i64, "s64");
    ck(CppStress::u8(254 as u8) == 255 as u8, "u8");
    ck(CppStress::u16(65534 as u16) == 65535 as u16, "u16");
    ck(CppStress::u32(10 as u32) == 11 as u32, "u32");
    ck(CppStress::u64(18000000000 as u64) == 18000000001 as u64, "u64");
    ckf(CppStress::f32(3.5 as f32) == (7.0 as f32), "f32");
    ckf(CppStress::f64(3.5) == 7.0, "f64");
    ck(CppStress::flip(true) == false, "flip");

    // ---- layout fidelity ----
    ck(CppStress::mixed_size() == 24 as i64, "Mixed sizeof == 24");
    const m: CppStress::Mixed = CppStress::Mixed { a: 1 as i8, b: 777 as i32, c: 2 as i8, d: 3.25 };
    ck(CppStress::mixed_b(&m) == 777 as i32, "Mixed.b offset");
    ckf(CppStress::mixed_d(&m) == 3.25, "Mixed.d offset");

    mut w: CppStress::WithArr = CppStress::WithArr { xs: [10 as i32, 20 as i32, 30 as i32, 40 as i32], n: 3 as i32 };
    ck(CppStress::witharr_sum(&w) == 60 as i32, "WithArr fixed-array field");

    const o: CppStress::Outer = CppStress::Outer {
        in_: CppStress::Inner { u: 1 as i32, v: 2 as i32 }, tag: 3 as i32 };
    ck(CppStress::outer_mix(&o) == 123 as i32, "Outer nested-struct field");

    // ---- struct-by-value ABI at each size class ----
    const a8: CppStress::S8 = CppStress::S8 { a: 3 as i32, b: 4 as i32 };
    ck(CppStress::s8_sum(a8) == 7 as i32, "S8 by-value param");
    const made8: CppStress::S8 = CppStress::s8_make(11 as i32, 22 as i32);
    ck(made8.a == 11 as i32 && made8.b == 22 as i32, "S8 by-value return");

    const a16: CppStress::S16 = CppStress::S16 { x: 1.5, y: 2.5 };
    ckf(CppStress::s16_sum(a16) == 4.0, "S16 SSE by-value param");
    const sc16: CppStress::S16 = CppStress::s16_scale(a16, 2.0);
    ckf(sc16.x == 3.0 && sc16.y == 5.0, "S16 SSE by-value return");

    const m24: CppStress::S24 = CppStress::s24_make(1.0, 2.0, 3.0);   // sret
    ckf(m24.x == 1.0 && m24.y == 2.0 && m24.z == 3.0, "S24 sret return");
    const b24: CppStress::S24 = CppStress::S24 { x: 10.0, y: 20.0, z: 30.0 };
    const sum24: CppStress::S24 = CppStress::s24_add(m24, b24);       // memory params + sret
    ckf(sum24.x == 11.0 && sum24.y == 22.0 && sum24.z == 33.0, "S24 memory-param + sret");

    const m32: CppStress::S32 = CppStress::s32_make(1 as i64, 2 as i64, 3 as i64, 4 as i64); // sret
    ck(m32.a == 1 as i64 && m32.d == 4 as i64, "S32 sret return");
    ck(CppStress::s32_sum(m32) == 10 as i64, "S32 memory-param");

    // ---- enum class (i64 underlying, negative + large) ----
    ck(CppStress::mode_val(CppStress::Mode::Hi) == 5000000000 as i64, "enum class Hi");
    ck(CppStress::mode_val(CppStress::Mode::Lo) == -1000 as i64, "enum class Lo (negative)");
    const picked: CppStress::Mode = CppStress::mode_pick(1 as i32);
    ck(CppStress::mode_val(picked) == 5000000000 as i64, "enum class returned by value");

    // ---- round 2: mixed-class eightbytes / odd sizes / deep ns ----
    const ifv: CppStress::IF = CppStress::IF { a: 3 as i32, b: 2.5 as f32 };
    ckf(CppStress::if_combine(ifv) == 5.5, "IF mixed by-value param");
    const ifm: CppStress::IF = CppStress::if_make(3 as i32, 2.5 as f32);
    ckf(ifm.a == 3 as i32 && ifm.b == (2.5 as f32), "IF mixed by-value return");

    const div: CppStress::DI = CppStress::DI { x: 1.5, n: 4 as i32 };
    ckf(CppStress::di_combine(div) == 5.5, "DI SSE+INTEGER param");
    const dim: CppStress::DI = CppStress::di_make(1.5, 4 as i32);
    ckf(dim.x == 1.5 && dim.n == 4 as i32, "DI SSE+INTEGER return");

    const iidv: CppStress::IID = CppStress::IID { a: 1 as i32, b: 2 as i32, c: 3.5 };
    ckf(CppStress::iid_combine(iidv) == 6.5, "IID INTEGER+SSE param");

    const i3m: CppStress::I3 = CppStress::i3_make(1 as i32, 2 as i32, 3 as i32);
    ck(i3m.a == 1 as i32 && i3m.c == 3 as i32, "I3 12-byte return");
    ck(CppStress::i3_sum(i3m) == 6 as i32, "I3 12-byte param");

    ck(CppStress::deep(10 as i32) == 343 as i32, "a::b::c::deep (3-level ns)");

    // `long` round-trips for values inside its width.  KNOWN LIMITATION: the
    // bindgen maps C++ `long` to i64 unconditionally, but `long` is 32-bit on
    // Win64 (mingw, LLP64) — so a value above 2^32 TRUNCATES on Windows here.
    // We test a 32-bit-safe value; the >2^32 case needs target-aware libclang
    // data-model selection (tracked as a known cross-platform gap).
    ck(CppStress::echo_long(123456 as i64) == 123456 as i64, "echo_long (32-bit-safe)");

    // ---- mixed class binding (public non-virtual members only) ----
    // NB: `Poly` is polymorphic (has a virtual method) → correctly skipped by
    // the bindgen (its vtable layout isn't reproducible), so it is intentionally
    // NOT referenced here; `Life`/`Priv` are non-polymorphic and still bind.
    const life: CppStress::Life = CppStress::Life { v: 42 as i32 };
    ck(life.get() == 42 as i32, "Life::get (sibling of skipped ctor/dtor)");
    const priv: CppStress::Priv = CppStress::Priv { n: 3 as i32 };
    ck(priv.ok() == 10 as i32, "Priv::ok (sibling of private member)");

    if (FAILS != 0 as i32) { fmt::eprintf("STRESS: %d checks FAILED\n", FAILS); return 1; }
    fmt::printf("CPP-STRESS OK: all checks passed.\n");
    return 0;
}
