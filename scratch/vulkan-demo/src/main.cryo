/// vulkan-demo — drives the generated `Vk` bindings (17k lines, 972 structs)
/// against the real Vulkan loader, headlessly: query the instance API version
/// and the count of available instance extensions.  No GPU/display required.
namespace VulkanDemo::Main;

import Vk;
import std::fmt;

function main() -> int {
    // Instance-level API version (works with no physical device present).
    mut version: u32 = 0;
    const r1: VkResult = Vk::vkEnumerateInstanceVersion(&version);
    if (r1 != Vk::VkResult::VK_SUCCESS) {
        fmt::eprintf("vkEnumerateInstanceVersion failed (%d)\n", r1 as i32);
        return 1;
    }
    // VK_API_VERSION_* are macros (dropped); decode the packed u32 by hand.
    const major: u32 = (version >> 22u32) & 127u32;
    const minor: u32 = (version >> 12u32) & 1023u32;
    const patch: u32 = version & 4095u32;

    // How many instance extensions does the loader expose?
    mut ext_count: u32 = 0;
    const r2: VkResult = Vk::vkEnumerateInstanceExtensionProperties(null, &ext_count, null);
    if (r2 != Vk::VkResult::VK_SUCCESS) {
        fmt::eprintf("vkEnumerateInstanceExtensionProperties failed (%d)\n", r2 as i32);
        return 1;
    }

    fmt::printf("Vulkan loader: API %u.%u.%u, %u instance extension(s) available\n",
        major, minor, patch, ext_count);
    return 0;
}
