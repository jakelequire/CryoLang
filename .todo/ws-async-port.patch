+/// client handshake, and hand back the upgraded connection. The socket is
+/// consumed — the `WebSocket` owns it from here.
+async function connect(sock: TcpStream, host: Str, path: Str)
+        -> Result<WebSocket<TcpStream>, IoError> {
+    mut ws: WebSocket<TcpStream> =
