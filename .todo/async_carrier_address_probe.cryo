// Discriminating probe: a CARRIED AGGREGATE local publishes a pointer into its
// own storage, then suspends. A third party writes 55 through that pointer while
// the future is parked. Post-fix the resumed state reads 55; with the
// take/hand-back carrier it reads 0, because the value was moved out of the
// stack slot the pointer named.
//
// Nothing here takes an address syntactically, so the frame-address rejection
// cannot see it - which is exactly why it compiles today and is wrong today.
//
// Acceptance test for the in-place carrier (ASYNC_IMPL.md phase 2, increment 4):
//
//   carried_cell_saw=55   after the carrier lives in its field
//   carried_cell_saw=0    today, and under the pinned compiler
//   cell_drops=1          in BOTH cases - a changed drop count is a regression
//
// A test that passes under both the old and the new compiler proves nothing, so
// run it under `bin/cryo` (the pin) as well as the freshly built compiler:
//
//   CRYO_STDLIB=$PWD/stdlib compiler/build/cryo build \
//       .todo/async_carrier_address_probe.cryo --opt-level=0 -o /tmp/probe && /tmp/probe
//
// Not wired into `make test`: it is knowingly red, and there is no expected-fail
// registry for unit tests (`known_fail_canary` is a whole project run with
// `fails: true`). Promote it into `tests/tests/lang/` once it reads 55.
namespace Probe;

import fmt;
import std::future;

mut g_slot: i64* = null;
mut g_drops: i64 = 0;

type struct Cell {
    canary: i64;

    static new() -> Cell { return Cell { canary: 0 }; }

    publish(mut &this) -> void { g_slot = &this.canary; }

    read(&this) -> i64 { return this.canary; }

    drop(mut &this) -> void { g_drops = g_drops + 1; }
}

type struct Ticks {
    left: i64;

    static new(n: i64) -> Ticks { return Ticks { left: n }; }
}

implement trait Future for struct Ticks {
    type Output = i64;

    poll(mut &this, cx: Context*) -> Poll<i64> {
        if (this.left > 0) {
            this.left = this.left - 1;
            return Poll::Pending;
        }
        return Poll::Ready(0);
    }
}

async function carried_cell() -> i64 {
    mut c: Cell = Cell::new();
    c.publish();
    const _z: i64 = await Ticks::new(1);
    return c.read();
}

function drive_writing<F>(f: F) -> i64
where F: Future<i64> {
    mut fut: F = f;
    mut cx: Context = Context::new(Waker::noop());
    loop {
        match (fut.poll(&cx)) {
            Poll::Ready(v) => { return v; }
            Poll::Pending => {
                if (g_slot != null) { *g_slot = 55; }
            }
        }
    }
}

function main() -> int {
    g_slot = null;
    g_drops = 0;
    const seen: i64 = drive_writing(carried_cell());
    eprintln(f"carried_cell_saw={seen}");
    eprintln(f"cell_drops={g_drops}");
    return 0;
}
