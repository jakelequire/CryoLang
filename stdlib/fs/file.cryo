///! File: Read/Write over a file descriptor.
///!
///! Opening a file returns a `File` that implements both `Read` and
///! `Write`. Callers compose with `fmt::Formatter` or read-all
///! helpers without caring that the destination is a file.
///!
///! `File` wraps a raw `i32` fd. The obligations are the POSIX ones:
///! every `open` pairs with a `drop` (which `close`s), and no
///! `File::drop` should be skipped or double-invoked.

namespace std::fs::file;

import std::core::intrinsics;
import std::core::option;
import std::core::result::{ Result };
import std::core::slice::{ Slice };
import std::core::drop::{ Drop };
import std::io::error::{ IoError, IoErrorKind };
import std::io::fd;
import std::io::traits::{ Read, Seek, SeekFrom, Write };
import std::collections::string::{ String };
import std::collections::str::{ Str };
import std::collections::array::{ Array };
import std::ffi::libc;
import std::sys::syscall;
import std::fs::path::{ Path };
import std::fs::metadata::{ Metadata, metadata };
import std::core::mem;

// POSIX `open` flags and `lseek` whence values live in `ffi::libc`
// (`O_RDONLY`/`O_WRONLY`/`O_RDWR`/`O_CREAT`/... and `Whence::SEEK_*`).

// Default mode for newly created files: 0644.
public const DEFAULT_CREATE_MODE: u32 = 420;

// OpenOptions: what you're asking the OS for

public type struct OpenOptions {
    private read: boolean;
    private write: boolean;
    private append: boolean;
    private truncate: boolean;
    private create: boolean;
    private create_new: boolean;
    private share_read: boolean;
    private share_write: boolean;
    private share_delete: boolean;

    public static new() -> OpenOptions {
        return OpenOptions {
            read: false,
            write: false,
            append: false,
            truncate: false,
            create: false,
            create_new: false,
            share_read: true,
            share_write: true,
            share_delete: false
        };
    }

    /// What other opens of the same file may do while this one is open:
    /// read it, write it, or delete or rename it.  The default shares
    /// reading and writing but not deleting.  Only Windows enforces sharing;
    /// elsewhere this does nothing.
    public share(mut &this, read: boolean, write: boolean, deletion: boolean) -> OpenOptions {
        this.share_read = read;
        this.share_write = write;
        this.share_delete = deletion;
        return this;
    }

    public read(mut &this, value: boolean) -> OpenOptions {
        this.read = value;
        return this;
    }

    public write(mut &this, value: boolean) -> OpenOptions {
        this.write = value;
        return this;
    }

    public append(mut &this, value: boolean) -> OpenOptions {
        this.append = value;
        return this;
    }

    public truncate(mut &this, value: boolean) -> OpenOptions {
        this.truncate = value;
        return this;
    }

    public create(mut &this, value: boolean) -> OpenOptions {
        this.create = value;
        return this;
    }

    public create_new(mut &this, value: boolean) -> OpenOptions {
        this.create_new = value;
        return this;
    }

    public open(&this, p: Path) -> Result<File, IoError> {
        return File::open_with(p, this);
    }

    /// Flatten the options into the platform's descriptor flags: POSIX
    /// `open`'s, or on Windows `_open_osfhandle`'s.  The flags and their
    /// values are OS-specific, so the bit assembly lives in the per-OS
    /// `open_flags_for` helpers below; a method body can't be
    /// `![target(...)]`-gated, but a free function can.
    private to_flags(&this) -> i32 {
        return open_flags_for(this);
    }
}

// POSIX `open` flags: glibc/Linux values, straight from `<fcntl.h>` (the
// constants in `ffi::libc`). Close-on-exec by default so a concurrent
// `fork`+`exec` (e.g. via `process::Command`) does not leak this fd into
// the child; callers that need it to survive an exec can `dup` it.
![target(unix)]
private function open_flags_for(o: &OpenOptions) -> i32 {
    mut flags: i32 = 0;
    if (o.read && o.write) { flags = libc::O_RDWR; }
    else if (o.write) { flags = libc::O_WRONLY; }
    else { flags = libc::O_RDONLY; }
    if (o.append) { flags = flags | libc::O_APPEND; }
    if (o.truncate) { flags = flags | libc::O_TRUNC; }
    if (o.create) { flags = flags | libc::O_CREAT; }
    if (o.create_new) { flags = flags | libc::O_CREAT | libc::O_EXCL; }
    flags = flags | libc::O_CLOEXEC;
    return flags;
}

// The CRT's `_open` cannot ask for delete sharing, so Windows opens through
// `CreateFileA` and wraps the HANDLE in a CRT descriptor; these are the
// flags `_open_osfhandle` takes for that.  Without `_O_TEXT` the descriptor
// is binary, so the CRT does no CRLF translation.
![target(windows)]
private function open_flags_for(o: &OpenOptions) -> i32 {
    mut flags: i32 = 0;
    if (!o.write) { flags = libc::O_RDONLY; }
    if (o.append) { flags = flags | libc::O_APPEND; }
    return flags;
}

![target(unix)]
private function open_descriptor(c_path: &String, options: &OpenOptions) -> Result<i32, IoError> {
    const raw_fd: i32 = libc::open(c_path.as_ptr(), options.to_flags(), DEFAULT_CREATE_MODE);
    if (raw_fd < 0) {
        return Result::Err(IoError::from_errno(libc::errno()));
    }
    return Result::Ok(raw_fd);
}

// Access and creation follow the POSIX flags: reading unless only writing
// was asked for, and `create`, `truncate` and `create_new` choose the same
// dispositions `O_CREAT`, `O_TRUNC` and `O_EXCL` would.  The handle is not
// inheritable, the analog of close-on-exec.
![target(windows)]
private function open_descriptor(c_path: &String, options: &OpenOptions) -> Result<i32, IoError> {
    mut access: u32 = 0;
    if (options.read || !options.write) { access = access | syscall::GENERIC_READ; }
    if (options.write) { access = access | syscall::GENERIC_WRITE; }
    mut share: u32 = 0;
    if (options.share_read)   { share = share | syscall::FILE_SHARE_READ; }
    if (options.share_write)  { share = share | syscall::FILE_SHARE_WRITE; }
    if (options.share_delete) { share = share | syscall::FILE_SHARE_DELETE; }
    mut disposition: u32 = syscall::OPEN_EXISTING;
    if (options.create_new) { disposition = syscall::CREATE_NEW; }
    else if (options.create && options.truncate) { disposition = syscall::CREATE_ALWAYS; }
    else if (options.create) { disposition = syscall::OPEN_ALWAYS; }
    else if (options.truncate) { disposition = syscall::TRUNCATE_EXISTING; }
    const handle: u8* = syscall::CreateFileA(c_path.as_ptr(), access, share, null,
        disposition, syscall::FILE_ATTRIBUTE_NORMAL, null);
    // INVALID_HANDLE_VALUE, compared as a local -1.
    if ((handle as i64) == -1) {
        return Result::Err(IoError::last_os_error());
    }
    const raw_fd: i32 = libc::_open_osfhandle(handle as i64, options.to_flags());
    if (raw_fd < 0) {
        const failure: IoError = IoError::from_errno(libc::errno());
        syscall::CloseHandle(handle);
        return Result::Err(failure);
    }
    return Result::Ok(raw_fd);
}

public type struct File {
    private fd: i32;

    /// Open `p` for reading. Fails with `NotFound`, `PermissionDenied`,
    /// or a mapped `errno`-derived kind on failure.
    public static open(p: Path) -> Result<File, IoError> {
        mut options: OpenOptions = OpenOptions::new();
        options = options.read(true);
        return File::open_with(p, &options);
    }

    /// Create (or truncate) `p` for writing.
    public static create(p: Path) -> Result<File, IoError> {
        mut options: OpenOptions = OpenOptions::new();
        options = options.write(true).create(true).truncate(true);
        return File::open_with(p, &options);
    }

    public static open_with(p: Path, options: &OpenOptions) -> Result<File, IoError> {
        mut c_path: String = String::with_null(p.as_str());
        return Result::Ok(File { fd: open_descriptor(&c_path, options)? });
    }

    /// Hand the descriptor over to the caller, who must close it, and leave
    /// this `File` closed: its drop no longer closes anything.  Use it to
    /// pass the file to something that takes ownership, such as `Stdio::Fd`.
    public into_descriptor(mut &this) -> i32 {
        const descriptor: i32 = this.fd;
        this.fd = -1;
        return descriptor;
    }
}

/// `Seek` over the file descriptor: a `SeekFrom` is one `lseek` with the
/// matching whence, returning the new absolute position.
implement trait Seek for struct File {
    seek(mut &this, from: SeekFrom) -> Result<i64, IoError> {
        const pos: i64 = match (from) {
            SeekFrom::Start(offset)   => { libc::lseek(this.fd, offset, libc::Whence::SEEK_SET) }
            SeekFrom::Current(offset) => { libc::lseek(this.fd, offset, libc::Whence::SEEK_CUR) }
            SeekFrom::End(offset)     => { libc::lseek(this.fd, offset, libc::Whence::SEEK_END) }
        };
        if (pos < 0) {
            return Result::Err(IoError::from_errno(libc::errno()));
        }
        return Result::Ok(pos);
    }

    /// Current byte offset from the start of the file, without moving:
    /// one `lseek`, where the trait's default goes through `seek`.
    stream_position(mut &this) -> Result<i64, IoError> {
        return this.seek(SeekFrom::Current(0));
    }
}

/// Close the file descriptor. Ownership obligation: every `File` must
/// have `drop` called before going out of scope. Calling more than once
/// is a bug the kernel may not catch; the second `close` could race
/// against an unrelated `open` that reused the same fd.
implement trait Drop for struct File {
    drop(mut &this) -> void {
        if (this.fd >= 0) {
            fd::close_fd(this.fd);
            this.fd = -1;
        }
    }
}

implement trait Read for struct File {
    read(mut &this, buffer: u8*, length: i64) -> Result<i64, IoError> {
        return fd::read_fd(this.fd, buffer, length);
    }
}

implement trait Write for struct File {
    write_some(mut &this, bytes: Slice<u8>) -> Result<i64, IoError> {
        return fd::write_fd(this.fd, bytes);
    }

    flush(mut &this) -> Result<(), IoError> {
        // `write(2)` is unbuffered at the syscall layer. `fsync` is a
        // caller concern; most writes don't need durability
        // guarantees and `fsync` is expensive.
        return Result::Ok(());
    }
}

// Convenience helpers

/// Read the entire contents of `p` into a fresh `Array<u8>`. Panics
/// on allocation failure; caller handles I/O failure via the Result.
public function read(p: Path) -> Result<Array<u8>, IoError> {
    const handle: File = File::open(p)?;
    mut file: File = handle;
    mut out: Array<u8> = Array::new();
    mut chunk: [u8; 4096];
    loop {
        const n: i64 = file.read(&chunk[0], 4096)?;
        if (n == 0) { break; }
        out.append(Slice::<u8>::from_raw(&chunk[0], n));
    }
    return Result::Ok(out);
}

/// Write `bytes` to `p`, creating or truncating.
public function write(p: Path, bytes: Slice<u8>) -> Result<(), IoError> {
    const handle: File = File::create(p)?;
    mut file: File = handle;
    return file.write(bytes);
}

/// Read the entire contents of `p` into a fresh `String`. The bytes are
/// taken verbatim; no UTF-8 validation is performed (the caller is
/// responsible for that if it matters). Panics on allocation failure;
/// I/O failure surfaces through the `Result`.
public function read_to_string(p: Path) -> Result<String, IoError> {
    mut data: Array<u8> = read(p)?;
    mut out: String = String::from_str(Str::from(data.as_slice()));
    mem::drop(data);
    return Result::Ok(out);
}

/// Copy the contents of `from` to `to`, returning the number of bytes
/// copied. `to` is created if missing and truncated if it already
/// exists; the source's Unix permission bits are then applied to it,
/// mirroring `cp` (and `std::fs::copy`). `from` must be a regular file -
/// copying a directory (or other non-regular entry) fails with
/// `InvalidInput`. On an I/O failure mid-copy the partially written
/// destination is left in place and the error is returned as-is.
public function copy(from: Path, to: Path) -> Result<i64, IoError> {
    const info: Metadata = metadata::metadata(from)?;
    if (!info.is_file()) {
        return Result::Err(IoError::new(IoErrorKind::InvalidInput, 0));
    }

    const src_handle: File = File::open(from)?;
    mut src: File = src_handle;
    const dst_handle: File = File::create(to)?;
    mut dst: File = dst_handle;

    mut total: i64 = 0;
    mut chunk: [u8; 65536];
    loop {
        const n: i64 = src.read(&chunk[0], 65536)?;
        if (n == 0) { break; }
        dst.write(Slice::<u8>::from_raw(&chunk[0], n))?;
        total = total + n;
    }

    // Mirror the source's permission bits onto the destination.  Unix
    // mode bits are a libc concept; Windows has no analog (file access
    // is governed by ACLs through a separate API surface), so the
    // Windows side accepts the default attributes the `create` above
    // produced and returns success.  On Windows the
    // contents are copied, the ACLs are not.
    mirror_permissions(&dst, info)?;
    return Result::Ok(total);
}

![target(unix)]
private function mirror_permissions(dst: &File, info: Metadata) -> Result<(), IoError> {
    if (libc::fchmod(dst.fd, info.permissions()) != 0) {
        return Result::Err(IoError::last_os_error());
    }
    return Result::Ok(());
}

![target(windows)]
private function mirror_permissions(dst: &File, info: Metadata) -> Result<(), IoError> {
    return Result::Ok(());
}
