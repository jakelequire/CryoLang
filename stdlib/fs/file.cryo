///! File: Read/Write over a file descriptor.
///!
///! Opening a file returns a `File` that implements both `Read` and
///! `Write`. Callers compose with `fmt::Formatter` or read-all
///! helpers without caring that the destination is a file.
///!
///! `File` wraps a raw `i32` fd. The obligations are the POSIX ones:
///! every `open` pairs with a `drop` (which `close`s), and no
///! `File::drop` should be skipped or double-invoked.

namespace std::fs::file;

import core::intrinsics;
import core::option;
import core::result;
import core::slice;
import core::drop;
import io::error;
import io::fd;
import io::traits;
import collections::string;
import collections::str;
import ffi::libc;
import fs::path;
import fs::metadata;

// POSIX `open` flags and `lseek` whence values live in `ffi::libc`
// (`O_RDONLY`/`O_WRONLY`/`O_RDWR`/`O_CREAT`/... and `Whence::SEEK_*`).

// Default mode for newly created files: 0644.
const DEFAULT_CREATE_MODE: u32 = 420;

// OpenOptions: what you're asking the OS for

type struct OpenOptions {
    read: boolean;
    write: boolean;
    append: boolean;
    truncate: boolean;
    create: boolean;
    create_new: boolean;

    static new() -> OpenOptions {
        return OpenOptions {
            read: false,
            write: false,
            append: false,
            truncate: false,
            create: false,
            create_new: false
        };
    }

    read(mut &this, value: boolean) -> OpenOptions {
        this.read = value;
        return this;
    }

    write(mut &this, value: boolean) -> OpenOptions {
        this.write = value;
        return this;
    }

    append(mut &this, value: boolean) -> OpenOptions {
        this.append = value;
        return this;
    }

    truncate(mut &this, value: boolean) -> OpenOptions {
        this.truncate = value;
        return this;
    }

    create(mut &this, value: boolean) -> OpenOptions {
        this.create = value;
        return this;
    }

    create_new(mut &this, value: boolean) -> OpenOptions {
        this.create_new = value;
        return this;
    }

    open(&this, p: Path) -> Result<File, IoError> {
        return File::open_with(p, this);
    }

    /// Flatten the options into the platform `open`/`_open` flags bitmask.
    /// The actual flag *values* are OS-specific (glibc and MSVCRT disagree
    /// on `O_CREAT`/`O_TRUNC`/`O_APPEND`/`O_EXCL`), so the bit assembly
    /// lives in the per-OS `open_flags_for` helpers below; a method body
    /// can't be `![target(...)]`-gated, but a free function can.
    to_flags(&this) -> i32 {
        return open_flags_for(this);
    }
}

// POSIX `open` flags: glibc/Linux values, straight from `<fcntl.h>` (the
// constants in `ffi::libc`). Close-on-exec by default so a concurrent
// `fork`+`exec` (e.g. via `process::Command`) does not leak this fd into
// the child; callers that need it to survive an exec can `dup` it.
![target(unix)]
private function open_flags_for(o: &OpenOptions) -> i32 {
    mut flags: i32 = 0;
    if (o.read && o.write) { flags = libc::O_RDWR; }
    else if (o.write) { flags = libc::O_WRONLY; }
    else { flags = libc::O_RDONLY; }
    if (o.append) { flags = flags | libc::O_APPEND; }
    if (o.truncate) { flags = flags | libc::O_TRUNC; }
    if (o.create) { flags = flags | libc::O_CREAT; }
    if (o.create_new) { flags = flags | libc::O_CREAT | libc::O_EXCL; }
    flags = flags | libc::O_CLOEXEC;
    return flags;
}

// MSVCRT `_open` flags. The CRT uses a different bit layout than glibc:
// `_O_CREAT`=0x100, `_O_TRUNC`=0x200, `_O_APPEND`=0x08, `_O_EXCL`=0x400 -
// glibc's `O_CREAT`=0x40 is MSVCRT's `_O_TEMPORARY`, so reusing the unix
// values made `File::create` open delete-on-close and never create the
// file. The access-mode bits (`_O_RDONLY`=0/`_O_WRONLY`=1/`_O_RDWR`=2)
// happen to agree with glibc. `_O_BINARY` is OR'd in so the CRT does NOT
// do CRLF translation (text mode would corrupt binary writes), and
// `_O_NOINHERIT` is the close-on-exec analog (the handle is not inherited
// by child processes).
![target(windows)]
private function open_flags_for(o: &OpenOptions) -> i32 {
    mut flags: i32 = 0;
    if (o.read && o.write) { flags = 0x02; }       // _O_RDWR
    else if (o.write) { flags = 0x01; }            // _O_WRONLY
    else { flags = 0x00; }                         // _O_RDONLY
    if (o.append) { flags = flags | 0x08; }        // _O_APPEND
    if (o.truncate) { flags = flags | 0x200; }     // _O_TRUNC
    if (o.create) { flags = flags | 0x100; }       // _O_CREAT
    if (o.create_new) { flags = flags | 0x100 | 0x400; } // _O_CREAT | _O_EXCL
    flags = flags | 0x8000;                        // _O_BINARY
    flags = flags | 0x80;                          // _O_NOINHERIT
    return flags;
}

type struct File {
    fd: i32;

    /// Open `p` for reading. Fails with `NotFound`, `PermissionDenied`,
    /// or a mapped `errno`-derived kind on failure.
    static open(p: Path) -> Result<File, IoError> {
        mut options: OpenOptions = OpenOptions::new();
        options = options.read(true);
        return File::open_with(p, &options);
    }

    /// Create (or truncate) `p` for writing.
    static create(p: Path) -> Result<File, IoError> {
        mut options: OpenOptions = OpenOptions::new();
        options = options.write(true).create(true).truncate(true);
        return File::open_with(p, &options);
    }

    static open_with(p: Path, options: &OpenOptions) -> Result<File, IoError> {
        mut c_path: String = String::from_str_c(p.as_str());
        const raw_fd: i32 = libc::open(c_path.as_ptr(), options.to_flags(), DEFAULT_CREATE_MODE);
        if (raw_fd < 0) {
            return Result::Err(IoError::from_errno(libc::errno()));
        }
        return Result::Ok(File { fd: raw_fd });
    }

    /// Seek to `offset` bytes from the start. Returns the new absolute
    /// position.
    seek_set(mut &this, offset: i64) -> Result<u64, IoError> {
        const pos: i64 = libc::lseek(this.fd, offset, libc::Whence::SEEK_SET);
        if (pos < 0) {
            return Result::Err(IoError::from_errno(libc::errno()));
        }
        return Result::Ok(pos as u64);
    }

    /// Seek by `offset` bytes relative to the current position
    /// (`offset` may be negative). Returns the new absolute position.
    seek_cur(mut &this, offset: i64) -> Result<u64, IoError> {
        const pos: i64 = libc::lseek(this.fd, offset, libc::Whence::SEEK_CUR);
        if (pos < 0) {
            return Result::Err(IoError::from_errno(libc::errno()));
        }
        return Result::Ok(pos as u64);
    }

    /// Seek to `offset` bytes relative to the end of the file (`offset`
    /// is usually <= 0). Returns the new absolute position.
    seek_end(mut &this, offset: i64) -> Result<u64, IoError> {
        const pos: i64 = libc::lseek(this.fd, offset, libc::Whence::SEEK_END);
        if (pos < 0) {
            return Result::Err(IoError::from_errno(libc::errno()));
        }
        return Result::Ok(pos as u64);
    }

    /// Current byte offset from the start of the file, without moving.
    stream_position(mut &this) -> Result<u64, IoError> {
        return this.seek_cur(0);
    }

}

/// Close the file descriptor. Ownership obligation: every `File` must
/// have `drop` called before going out of scope. Calling more than once
/// is a bug the kernel may not catch; the second `close` could race
/// against an unrelated `open` that reused the same fd.
implement trait Drop for struct File {
    drop(mut &this) -> void {
        if (this.fd >= 0) {
            fd::close_fd(this.fd);
            this.fd = -1;
        }
    }
}

implement trait Read for struct File {
    read(mut &this, buffer: u8*, length: u64) -> Result<u64, IoError> {
        return fd::read_fd(this.fd, buffer, length);
    }
}

implement trait Write for struct File {
    write_some(mut &this, bytes: Slice<u8>) -> Result<u64, IoError> {
        return fd::write_fd(this.fd, bytes);
    }

    flush(mut &this) -> Result<(), IoError> {
        // `write(2)` is unbuffered at the syscall layer. `fsync` is a
        // caller concern; most writes don't need durability
        // guarantees and `fsync` is expensive.
        return Result::Ok(());
    }
}

// Convenience helpers

/// Read the entire contents of `p` into a fresh `Array<u8>`. Panics
/// on allocation failure; caller handles I/O failure via the Result.
function read(p: Path) -> Result<Array<u8>, IoError> {
    const handle: File = File::open(p)?;
    mut file: File = handle;
    mut out: Array<u8> = Array::new();
    mut chunk: u8[4096];
    loop {
        const n: u64 = file.read(&chunk[0], 4096)?;
        if (n == 0) { break; }
        mut i: u64 = 0;
        while (i < n) {
            out.push(chunk[i]);
            i++;
        }
    }
    return Result::Ok(out);
}

/// Write `bytes` to `p`, creating or truncating.
function write(p: Path, bytes: Slice<u8>) -> Result<(), IoError> {
    const handle: File = File::create(p)?;
    mut file: File = handle;
    return file.write(bytes);
}

/// Read the entire contents of `p` into a fresh `String`. The bytes are
/// taken verbatim; no UTF-8 validation is performed (the caller is
/// responsible for that if it matters). Panics on allocation failure;
/// I/O failure surfaces through the `Result`.
function read_to_string(p: Path) -> Result<String, IoError> {
    mut data: Array<u8> = read(p)?;
    mut out: String = String::from_str(Str::from(data.as_slice()));
    data.drop();
    return Result::Ok(out);
}

/// Copy the contents of `from` to `to`, returning the number of bytes
/// copied. `to` is created if missing and truncated if it already
/// exists; the source's Unix permission bits are then applied to it,
/// mirroring `cp` (and `std::fs::copy`). `from` must be a regular file -
/// copying a directory (or other non-regular entry) fails with
/// `InvalidInput`. On an I/O failure mid-copy the partially written
/// destination is left in place and the error is returned as-is.
function copy(from: Path, to: Path) -> Result<u64, IoError> {
    const info: Metadata = metadata::metadata(from)?;
    if (!info.is_file()) {
        return Result::Err(IoError::new(IoErrorKind::InvalidInput, 0));
    }

    const src_handle: File = File::open(from)?;
    mut src: File = src_handle;
    const dst_handle: File = File::create(to)?;
    mut dst: File = dst_handle;

    mut total: u64 = 0;
    mut chunk: u8[65536];
    loop {
        const n: u64 = src.read(&chunk[0], 65536)?;
        if (n == 0) { break; }
        dst.write(Slice<u8>::from_raw(&chunk[0], n))?;
        total = total + n;
    }

    // Mirror the source's permission bits onto the destination.  Unix
    // mode bits are a libc concept; Windows has no analog (file access
    // is governed by ACLs through a separate API surface), so the
    // Windows side accepts the default attributes the `create` above
    // produced and returns success.  Same behaviour as
    // `std::fs::copy` on Rust for Windows: contents copied, ACLs not.
    mirror_permissions(&dst, info)?;
    return Result::Ok(total);
}

![target(unix)]
private function mirror_permissions(dst: &File, info: Metadata) -> Result<(), IoError> {
    if (libc::fchmod(dst.fd, info.permissions()) != 0) {
        return Result::Err(IoError::from_errno(libc::errno()));
    }
    return Result::Ok(());
}

![target(windows)]
private function mirror_permissions(dst: &File, info: Metadata) -> Result<(), IoError> {
    return Result::Ok(());
}
