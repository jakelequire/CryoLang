///! Directory iteration and whole-path operations.
///!
///! `read_dir(p)` returns a `ReadDir` iterator over `DirEntry` values
///! (skipping `.` and `..`). The remaining free functions wrap the
///! single-syscall path operations: `create_dir`, `remove_file`,
///! `remove_dir`, `rename`, and `canonicalize`, plus the recursive
///! `create_dir_all` (mkdir -p) and `remove_dir_all` (rm -r). All
///! report failure through `IoError` mapped from `errno`.

namespace std::fs::dir;

import core::option;
import core::result;
import core::iter;
import core::drop;
import collections::string;
import collections::str;
import io::error;
import ffi::libc;
import ffi::syscall;
import fs::path;
import fs::metadata;

// `d_type` values we classify (others fall through to FileType::Other).
// We normalise both platforms onto these so `DirEntry` stays uniform.
const DT_DIR: u8 = 4;
const DT_REG: u8 = 8;
const DT_LNK: u8 = 10;

// `struct dirent` field offset for `d_type` on Linux x86_64 / glibc.
const DIRENT_OFF_TYPE_LINUX: u64 = 18;

// Win32 `GetFileAttributes` result bits used to classify entries; mingw's
// `struct dirent` has no `d_type`, so on Windows we stat each entry instead.
const FILE_ATTRIBUTE_DIRECTORY:    u32 = 0x10;
const FILE_ATTRIBUTE_REPARSE_POINT: u32 = 0x400;
const INVALID_FILE_ATTRIBUTES:     u32 = 0xFFFFFFFF;

// `d_name` byte-offset within `struct dirent`: glibc lays it after the 8-byte
// d_ino, 8-byte d_off, 2-byte d_reclen and 1-byte d_type (offset 19); mingw's
// shorter layout (4-byte d_ino, two u16s) puts it at offset 8.
![target(linux)]
function dirent_name_offset() -> u64 { return 19; }
![target(windows)]
function dirent_name_offset() -> u64 { return 8; }

// Classify an entry. On Linux the kernel fills `d_type` in the dirent, so we
// read it directly (some filesystems report DT_UNKNOWN -> FileType::Other).
// mingw provides no `d_type`, so on Windows we resolve via the entry's Win32
// file attributes (`<base>/<name>`); `base` is the directory `read_dir` opened.
![target(linux)]
function dirent_dtype(ent: u8*, base: Str, name: Str) -> u8 {
    return *((ent + DIRENT_OFF_TYPE_LINUX) as u8*);
}
![target(windows)]
function dirent_dtype(ent: u8*, base: Str, name: Str) -> u8 {
    // Build a NUL-terminated `<base>/<name>` (GetFileAttributesA accepts
    // forward slashes) and read its attributes.
    mut full: String = String::from_str(base);
    full.push('/' as u8);
    full.push(name);
    full.push(0 as u8);
    const attrs: u32 = syscall::GetFileAttributesA(full.as_ptr());
    full.drop();
    if (attrs == INVALID_FILE_ATTRIBUTES)       { return 0; }      // DT_UNKNOWN
    if ((attrs & FILE_ATTRIBUTE_REPARSE_POINT) != 0) { return DT_LNK; }
    if ((attrs & FILE_ATTRIBUTE_DIRECTORY) != 0)     { return DT_DIR; }
    return DT_REG;
}

// Default mode for a newly created directory: 0755.
const DEFAULT_DIR_MODE: u32 = 493;

/// One entry returned by `ReadDir`. Owns its name; drop releases it.
type struct DirEntry {
    entry_name: String;
    dtype:      u8;

    /// The entry's file name (no directory components). Borrows this
    /// entry's storage.
    name(&this) -> Str {
        return this.entry_name.as_str();
    }

    /// File type from the dirent `d_type` field. Some filesystems
    /// report `DT_UNKNOWN`; call `metadata` on the full path for an
    /// authoritative answer in that case.
    file_type(&this) -> FileType {
        if (this.dtype == DT_DIR) { return FileType::Dir; }
        if (this.dtype == DT_REG) { return FileType::File; }
        if (this.dtype == DT_LNK) { return FileType::Symlink; }
        return FileType::Other;
    }

    is_dir(&this) -> boolean { return this.dtype == DT_DIR; }
    is_file(&this) -> boolean { return this.dtype == DT_REG; }
}

implement trait Drop for struct DirEntry {
    drop(mut &this) -> void {
        this.entry_name.drop();
    }
}

/// Forward iterator over the entries of a directory. Yields owned
/// `DirEntry` values, skipping `.` and `..`. Closes the underlying
/// `DIR*` on drop. Order is filesystem-defined.
type struct ReadDir {
    dirp: void*;
    // Directory path this iterator was opened on; needed to resolve an
    // entry's type on Windows (where the dirent carries no `d_type`).
    base: String;
}

implement trait Iterator<DirEntry> for struct ReadDir {
    next(mut &this) -> Option<DirEntry> {
        if (this.dirp == null) { return Option::None; }
        loop {
            const ent: u8* = libc::readdir(this.dirp);
            if (ent == null) { return Option::None; }
            const name_ptr: u8* = ent + dirent_name_offset();
            const name_view: Str = Str::from_raw(name_ptr, libc::strlen(name_ptr));
            if (is_dot_or_dotdot(name_view)) {
                continue;
            }
            // Resolve the type after the name (Windows needs the name to stat).
            const dtype: u8 = dirent_dtype(ent, this.base.as_str(), name_view);
            return Option::Some(DirEntry {
                entry_name: String::from_str(name_view),
                dtype: dtype
            });
        }
    }
}

implement trait Drop for struct ReadDir {
    drop(mut &this) -> void {
        if (this.dirp != null) {
            libc::closedir(this.dirp);
            this.dirp = null;
        }
        this.base.drop();
    }
}

/// True for the `.` and `..` pseudo-entries `readdir` reports.
function is_dot_or_dotdot(name: Str) -> boolean {
    if (name.length() == 1) {
        return name.equals(&Str::new("."));
    }
    if (name.length() == 2) {
        return name.equals(&Str::new(".."));
    }
    return false;
}

/// Open `p` for iteration. The returned `ReadDir` must be dropped to
/// close the directory handle.
function read_dir(p: Path) -> Result<ReadDir, IoError> {
    mut c_path: String = String::from_str_c(p.as_str());
    const dirp: void* = libc::opendir(c_path.as_ptr());
    const err: i32 = libc::errno();
    c_path.drop();
    if (dirp == null) {
        return Result::Err(IoError::from_errno(err));
    }
    return Result::Ok(ReadDir { dirp: dirp, base: String::from_str(p.as_str()) });
}

/// Create a single directory (mode 0755). Fails if it already exists or
/// a parent component is missing; use `create_dir_all` for the latter.
function create_dir(p: Path) -> Result<(), IoError> {
    mut c_path: String = String::from_str_c(p.as_str());
    const rc: i32 = libc::mkdir(c_path.as_ptr(), DEFAULT_DIR_MODE);
    const err: i32 = libc::errno();
    c_path.drop();
    if (rc != 0) {
        return Result::Err(IoError::from_errno(err));
    }
    return Result::Ok(());
}

/// Recursively create `p` and any missing parent directories, like
/// `mkdir -p`. Succeeds if `p` already exists as a directory. Each
/// created component uses mode 0755. A concurrent creator racing on
/// the same path is tolerated (an `AlreadyExists` that resolves to a
/// directory is success); any other failure is returned as-is.
function create_dir_all(p: Path) -> Result<(), IoError> {
    if (metadata::is_dir(p)) { return Result::Ok(()); }
    match (p.parent()) {
        Option::Some(parent) => {
            if (parent.as_str().length() > 0 && !metadata::is_dir(parent)) {
                create_dir_all(parent)?;
            }
        }
        Option::None => { }
    }
    match (create_dir(p)) {
        Result::Ok(_) => { return Result::Ok(()); }
        Result::Err(e) => {
            match (e.kind) {
                IoErrorKind::AlreadyExists => {
                    if (metadata::is_dir(p)) { return Result::Ok(()); }
                    return Result::Err(e);
                }
                _ => { return Result::Err(e); }
            }
        }
    }
}

/// Remove a file (or symlink). `unlink(2)`.
function remove_file(p: Path) -> Result<(), IoError> {
    mut c_path: String = String::from_str_c(p.as_str());
    const rc: i32 = libc::unlink(c_path.as_ptr());
    const err: i32 = libc::errno();
    c_path.drop();
    if (rc != 0) {
        return Result::Err(IoError::from_errno(err));
    }
    return Result::Ok(());
}

/// Recursively remove `p` and everything under it, like `rm -r` on a
/// directory. `p` must be a real directory. Entries that are symlinks
/// are unlinked, not followed (a symlink reports a non-directory
/// `d_type`, so it routes to `remove_file`). Returns the first
/// failure. Relies on the directory's `d_type`; the supported Linux
/// filesystems (ext4, btrfs, xfs, tmpfs) report entry types correctly.
function remove_dir_all(p: Path) -> Result<(), IoError> {
    mut rd: ReadDir = read_dir(p)?;
    loop {
        match (rd.next()) {
            Option::Some(entry) => {
                mut child: PathBuf = PathBuf::from_str(p.as_str());
                child.push(entry.name());
                if (entry.is_dir()) {
                    remove_dir_all(child.as_path())?;
                } else {
                    remove_file(child.as_path())?;
                }
            }
            Option::None => { break; }
        }
    }
    // Close the handle before removing the now-empty directory.
    rd.drop();
    return remove_dir(p);
}

/// Remove an empty directory. `rmdir(2)`.
function remove_dir(p: Path) -> Result<(), IoError> {
    mut c_path: String = String::from_str_c(p.as_str());
    const rc: i32 = libc::rmdir(c_path.as_ptr());
    const err: i32 = libc::errno();
    c_path.drop();
    if (rc != 0) {
        return Result::Err(IoError::from_errno(err));
    }
    return Result::Ok(());
}

/// Rename / move `from` to `to`. `rename(2)` (atomic within a
/// filesystem; fails with `EXDEV` across filesystems).
function rename(from: Path, to: Path) -> Result<(), IoError> {
    mut c_from: String = String::from_str_c(from.as_str());
    mut c_to: String = String::from_str_c(to.as_str());
    const rc: i32 = libc::rename(c_from.as_ptr(), c_to.as_ptr());
    const err: i32 = libc::errno();
    c_to.drop();
    c_from.drop();
    if (rc != 0) {
        return Result::Err(IoError::from_errno(err));
    }
    return Result::Ok(());
}

/// Resolve `p` to an absolute, symlink-free canonical path
/// (`realpath(3)`). The result fits in `PATH_MAX` (4096) bytes.
///
/// Windows has no `realpath`; it uses `GetFullPathNameA`, which makes the
/// path absolute and lexically normalises `.`/`..` but does NOT resolve
/// symlinks or require the target to exist (close enough for path work, and
/// it keeps `fs::dir` linkable on Windows — the POSIX `realpath` symbol does
/// not exist in the mingw CRT).
![target(unix)]
function canonicalize(p: Path) -> Result<PathBuf, IoError> {
    mut c_path: String = String::from_str_c(p.as_str());
    mut buf: u8[4096];
    const res: u8* = libc::realpath(c_path.as_ptr(), &buf[0]);
    const err: i32 = libc::errno();
    c_path.drop();
    if (res == null) {
        return Result::Err(IoError::from_errno(err));
    }
    const view: Str = Str::from_raw(&buf[0], libc::strlen(&buf[0]));
    return Result::Ok(PathBuf::from_str(view));
}
![target(windows)]
function canonicalize(p: Path) -> Result<PathBuf, IoError> {
    mut c_path: String = String::from_str_c(p.as_str());
    mut buf: u8[4096];
    const n: u32 = syscall::GetFullPathNameA(c_path.as_ptr(), 4096, &buf[0], null);
    c_path.drop();
    if (n == 0 || n >= 4096) {
        return Result::Err(IoError::new(IoErrorKind::Other, 0));
    }
    const view: Str = Str::from_raw(&buf[0], n as u64);
    return Result::Ok(PathBuf::from_str(view));
}
