///! Path / PathBuf: filesystem paths as length-typed UTF-8.
///!
///! `Path` borrows; `PathBuf` owns. Both are byte sequences with no
///! NUL terminator; crossing into libc uses a NUL-terminated `String`
///! built with `String::with_null`.
///!
///! Path syntax is per-target. On Unix `/` separates and a leading `/`
///! is absolute - the whole path is one flat sequence of segments. On
///! Windows both `/` and `\` separate, and a path may open with a ROOT
///! that is not a segment and must never be split off or reordered:
///!
///!   `C:\dir\file`     drive-absolute  - root `C:\`
///!   `C:dir`           drive-relative  - root `C:`, resolved against the
///!                                       drive's own working directory
///!   `\dir`            rooted          - root `\`, but drive-relative, so
///!                                       NOT absolute
///!   `\\server\share`  UNC             - root is the whole `\\server\share`
///!
///! Every operation below is defined in terms of that root: `parent` and
///! `file_name` stop at it, `pop` cannot climb above it, and `push` of a
///! rooted segment replaces rather than appends. Verbatim `\\?\` prefixes
///! parse as UNC, which keeps them intact but does not give them their
///! special "no normalisation" meaning.
///!
///! `push` writes `/` on every target. Windows accepts `/` throughout the
///! Win32 file APIs, and the toolchain builds paths with `/` elsewhere, so
///! emitting it keeps one convention; `\` is still understood on input.

namespace std::fs::path;

import std::core::option::{ Option };
import std::core::result::{ Result };
import std::core::slice::{ Slice };
import std::core::drop::{ Drop };
import std::core::mem;
import std::collections::str::{ Str };
import std::collections::string::{ String };
import std::collections::array::{ Array };
import std::alloc::allocator::{ Allocator, GlobalAlloc };
import std::io::error::{ IoError, IoErrorKind, IoOperation };
import std::encoding::utf16::{ Utf16 };
import std::fs::metadata::{ Metadata };
import std::ffi::libc;
import std::sys::syscall;

private const SEPARATOR:     u8 = 0x2F;  // '/'
private const BACKSLASH:     u8 = 0x5C;  // '\'
private const COLON:         u8 = 0x3A;  // ':'
private const DOT:           u8 = 0x2E;  // '.'

// Whether this target uses Windows path syntax. A compile-time constant
// rather than duplicated per-target method bodies: the parsing RULES differ,
// the traversal logic does not.
![target(windows)]
private const WINDOWS_SYNTAX: boolean = true;
![target(unix)]
private const WINDOWS_SYNTAX: boolean = false;

// Path: borrowed

public type struct Path {
    private inner: Str;

    /// Borrow a `Str` as a `Path`.  Marked `![implicit]`, so a `Str` passed
    /// where a `Path` is wanted converts at the call site:
    /// `File::open(name)` with `name: Str`.  The borrowed bytes must
    /// outlive the `Path`.
    ![implicit]
    public static from(source: Str) -> Path {
        return Path { inner: source };
    }

    /// Borrow a NUL-terminated `string` (a literal, say) as a `Path`; the
    /// NUL is not part of the path.  Marked `![implicit]`, so
    /// `File::read_text("config.toml")` needs no wrapping.
    ![implicit]
    public static new(text: string) -> Path {
        return Path { inner: Str::new(text) };
    }

    public as_str(&this) -> Str {
        return this.inner;
    }

    ![inline]
    public length(&this) -> i64 {
        return this.inner.length();
    }

    public is_empty(&this) -> boolean {
        return this.inner.is_empty();
    }

    /// Whether `byte` separates segments on this target.
    public static is_separator(byte: u8) -> boolean {
        if (byte == SEPARATOR) { return true; }
        if (WINDOWS_SYNTAX) { return byte == BACKSLASH; }
        return false;
    }

    /// Length of `source`'s leading root, including its trailing separator
    /// when one is present; 0 when the path is fully relative.
    ///
    /// This is the floor for every traversal here: bytes below it are not a
    /// segment and splitting them would change which volume the path names.
    public static root_len(source: Str) -> i64 {
        const bytes: &Slice<u8> = source.as_bytes();
        const n: i64 = bytes.length();
        if (n == 0) { return 0; }

        if (!WINDOWS_SYNTAX) {
            if (Path::is_separator(bytes[0])) { return 1; }
            return 0;
        }

        // UNC `\\server\share`: two separators, a server, then a share. The
        // share is part of the root - `\\server` alone names no filesystem,
        // so `parent` must not hand it back as if it did.
        if (n >= 2 && Path::is_separator(bytes[0]) && Path::is_separator(bytes[1])) {
            mut i: i64 = 2;
            // server
            while (i < n && !Path::is_separator(bytes[i])) { i = i + 1; }
            if (i < n) { i = i + 1; }                        // separator after server
            // share
            while (i < n && !Path::is_separator(bytes[i])) { i = i + 1; }
            if (i < n) { i = i + 1; }                        // trailing separator
            return i;
        }

        // `C:\` (drive-absolute) or `C:` (drive-relative).
        if (n >= 2 && bytes[0].is_alpha() && bytes[1] == COLON) {
            if (n >= 3 && Path::is_separator(bytes[2])) { return 3; }
            return 2;
        }

        // A bare leading separator roots the path on the current drive.
        if (Path::is_separator(bytes[0])) { return 1; }
        return 0;
    }

    /// Whether `source` resolves without reference to a working DIRECTORY.
    ///
    /// `C:dir` is the one rooted form that does not: it names a path relative
    /// to whatever directory that drive is currently sitting in, so it is
    /// reported relative. Everything else with a root - `/dir`, `\dir`,
    /// `C:\dir`, `\\server\share` - is absolute.
    ///
    /// `\dir` is absolute here although it names no drive. Calling it relative
    /// would need every caller to join through a prefix-aware
    /// `join`; with a plain `push`, the usual caller idiom
    /// `if (!p.is_absolute()) { p = cwd.push(p) }` would prepend a second
    /// root to `\dir` and produce nonsense. Reporting root-anchored paths as
    /// absolute keeps that idiom correct, and keeps a `/`-style path - which
    /// this toolchain passes around on every target - answering the same way
    /// everywhere.
    public static is_absolute_str(source: Str) -> boolean {
        const bytes: &Slice<u8> = source.as_bytes();
        const n: i64 = bytes.length();
        if (n == 0) { return false; }

        if (WINDOWS_SYNTAX && n >= 2 && bytes[0].is_alpha() && bytes[1] == COLON) {
            return n >= 3 && Path::is_separator(bytes[2]);
        }
        return Path::is_separator(bytes[0]);
    }

    /// Index of the last separator at or after `floor`, or `None`. Searching
    /// from `floor` is what keeps the root's own separators from being
    /// mistaken for segment breaks. On Windows either separator counts, so
    /// the later of the two answers.
    public static last_separator(source: Str, floor: i64) -> Option<i64> {
        const segments: Str = source.sub_bytes(floor, source.length());
        mut found: Option<i64> = segments.rfind_byte(SEPARATOR);
        if (WINDOWS_SYNTAX) {
            match (segments.rfind_byte(BACKSLASH)) {
                Option::Some(back) => {
                    if (back > found.unwrap_or(-1)) { found = Option::Some(back); }
                }
                Option::None => { }
            }
        }
        match (found) {
            Option::Some(at) => { return Option::Some(at + floor); }
            Option::None     => { return Option::None; }
        }
    }

    /// Whether this path is absolute; see `is_absolute_str`.
    public is_absolute(&this) -> boolean {
        return Path::is_absolute_str(this.inner);
    }

    /// Whether `base` is this path or one of its ancestors, comparing whole
    /// components: `/a/b/c` starts with `/a/b`, but `/a/bc` does not.  The
    /// bytes are compared as written, with no normalisation, so `a/./b` does
    /// not start with `a/b`.  An empty `base` names no directory, so no path
    /// starts with it.
    public starts_with(&this, base: Path) -> boolean {
        const base_length: i64 = base.inner.length();
        if (base_length == 0 || !this.inner.starts_with(&base.inner)) { return false; }
        if (this.inner.length() == base_length) { return true; }
        // `base` ending in a separator, or being this path's whole root
        // (`C:` before `C:dir`), already ends at a component boundary.
        const base_bytes: &Slice<u8> = base.inner.as_bytes();
        if (Path::is_separator(base_bytes[base_length - 1])) { return true; }
        if (Path::root_len(this.inner) == base_length) { return true; }
        return Path::is_separator(this.inner.as_bytes()[base_length]);
    }

    /// Last path segment, or `None` if the path ends with a separator, is
    /// empty, or is nothing but a root. Does not consult the filesystem.
    public file_name(&this) -> Option<Str> {
        const n: i64 = this.inner.length();
        const root: i64 = Path::root_len(this.inner);
        if (n == 0 || n <= root) { return Option::None; }

        match (Path::last_separator(this.inner, root)) {
            Option::Some(k) => {
                // Trailing separator: the path names a directory, not a file.
                if (k == n - 1) { return Option::None; }
                return Option::Some(this.inner.sub_bytes(k + 1, n));
            }
            // No separator past the root: everything after the root is the name.
            Option::None => { return Option::Some(this.inner.sub_bytes(root, n)); }
        }
    }

    /// Path minus its final segment, or `None` if there is no parent - a
    /// single relative segment, a bare root, or empty. A rooted path whose
    /// last segment is stripped yields the root itself, never "". Trailing
    /// separators name no segment: the parent of `a/b/` is `a`, as of `a/b`.
    public parent(&this) -> Option<Path> {
        const root: i64 = Path::root_len(this.inner);
        const bytes: &Slice<u8> = this.inner.as_bytes();
        mut n: i64 = this.inner.length();
        while (n > root && Path::is_separator(bytes[n - 1])) { n = n - 1; }
        if (n == 0 || n <= root) { return Option::None; }
        const segments: Str = this.inner.sub_bytes(0, n);

        match (Path::last_separator(segments, root)) {
            Option::Some(k) => {
                // Cutting at the separator keeps the root's trailing separator
                // when the split lands on it, so `/x` yields `/` and `C:\x`
                // yields `C:\` rather than the volume-changing `C:`.
                return Option::Some(Path { inner: this.inner.sub_bytes(0, k) });
            }
            Option::None => { }
        }
        // No separator past the root. A rooted path falls back to its root;
        // a single relative segment has no parent to give.
        if (root > 0) {
            return Option::Some(Path { inner: this.inner.sub_bytes(0, root) });
        }
        return Option::None;
    }

    /// Extension of the final component: the bytes after its last `.`, or
    /// `None`. It consults only the file
    /// name - `parent().extension()` cannot leak in a dot from a directory:
    ///
    ///   `foo.rs`     -> Some("rs")
    ///   `foo.tar.gz` -> Some("gz")     (last dot only)
    ///   `foo.`       -> Some("")       (trailing dot, empty extension)
    ///   `foo`        -> None           (no dot)
    ///   `.bashrc`    -> None           (leading dot is not an extension)
    ///   `..`         -> None           (not a name with an extension)
    ///   `a/b`        -> None           (path ends in a directory, no name)
    ///
    /// A leading dot only disqualifies when it is the ONLY dot: `.foo.rs`
    /// still has extension `rs`.
    public extension(&this) -> Option<Str> {
        match (this.file_name()) {
            Option::None => { return Option::None; }
            Option::Some(name) => {
                // `..` carries a dot at index 1 but names no extension.
                if (name == Str::new("..")) { return Option::None; }
                match (name.rfind_byte(DOT)) {
                    // A dot only at index 0 (dotfile) is no extension.
                    Option::Some(dot) => {
                        if (dot == 0) { return Option::None; }
                        return Option::Some(name.sub_bytes(dot + 1, name.length()));
                    }
                    Option::None => { return Option::None; }
                }
            }
        }
    }

    /// Append `segment` to a COPY of this path, leaving the borrowed path
    /// untouched. The non-mutating twin of `PathBuf::push`, and it inherits
    /// `push`'s root semantics: a `segment` carrying its own root - `/etc`,
    /// `C:\dir`, `\\server\share` - replaces rather than extends:
    /// `join("/etc")` is `/etc` whatever the path was.
    public join(&this, segment: Str) -> PathBuf {
        mut buf: PathBuf = PathBuf::from(this.inner);
        buf.push(segment);
        return buf;
    }

    /// The final component without its extension, or `None` when there is
    /// no final component (see `file_name`):
    ///
    ///   `notes.txt`   -> Some("notes")
    ///   `a.tar.gz`    -> Some("a.tar")    (only the last extension goes)
    ///   `.bashrc`     -> Some(".bashrc")  (a leading dot is no extension)
    ///   `Makefile`    -> Some("Makefile")
    public stem(&this) -> Option<Str> {
        match (this.file_name()) {
            Option::None => { return Option::None; }
            Option::Some(name) => {
                match (this.extension()) {
                    Option::Some(extension) => {
                        return Option::Some(name.sub_bytes(0, name.length() - extension.length() - 1));
                    }
                    Option::None => { return Option::Some(name); }
                }
            }
        }
    }

    /// A copy of this path whose final component carries `extension`
    /// instead of its own: `a/notes.txt` with `md` is `a/notes.md`, and
    /// `a/notes` with `md` is `a/notes.md`. An empty `extension` removes
    /// the extension. A path with no final component (`a/`, `/`) is copied
    /// unchanged.
    public with_extension(&this, extension: Str) -> PathBuf {
        match (this.stem()) {
            Option::None => { return PathBuf::from(this.inner); }
            Option::Some(stem) => {
                const name_start: i64 = this.inner.length() - this.file_name().unwrap().length();
                mut result: PathBuf = PathBuf::from(this.inner.sub_bytes(0, name_start + stem.length()));
                if (!extension.is_empty()) {
                    result.inner.push_byte(DOT);
                    result.inner.push(extension);
                }
                return result;
            }
        }
    }

    // What is at this path, whatever kind of entry it is. Each failure names
    // the path.

    /// Whether anything exists at this path. A failure to look - a
    /// directory on the way that cannot be searched - also answers `false`;
    /// `metadata` says which it was.
    public exists(&this) -> boolean {
        return Metadata::of(*this).is_ok();
    }

    /// Whether this path names a regular file, following a final symlink.
    public is_file(&this) -> boolean {
        match (Metadata::of(*this)) {
            Result::Ok(found) => { return found.is_file(); }
            Result::Err(_)    => { return false; }
        }
    }

    /// Whether this path names a directory, following a final symlink.
    public is_directory(&this) -> boolean {
        match (Metadata::of(*this)) {
            Result::Ok(found) => { return found.is_directory(); }
            Result::Err(_)    => { return false; }
        }
    }

    /// What is at this path, following a final symlink.
    public metadata(&this) -> Result<Metadata, IoError> {
        return Metadata::of(*this);
    }

    /// What is at this path, reporting a final symlink as itself.
    public symlink_metadata(&this) -> Result<Metadata, IoError> {
        return Metadata::of_link(*this);
    }

    /// Move whatever is at this path - a file or a directory - to `target`,
    /// replacing a file already there. Atomic within one filesystem; across
    /// two it fails, and the entry must be copied instead.
    ![target(unix)]
    public rename_to(&this, target: Path) -> Result<(), IoError> {
        mut c_from: String = String::with_null(this.inner);
        mut c_to: String = String::with_null(target.inner);
        const rc: i32 = libc::rename(c_from.as_ptr(), c_to.as_ptr());
        const err: i32 = libc::errno();
        mem::drop(c_to);
        mem::drop(c_from);
        if (rc != 0) {
            return Result::Err(IoError::from_errno(err).with_context(IoOperation::Rename, *this));
        }
        return Result::Ok(());
    }
    ![target(windows)]
    public rename_to(&this, target: Path) -> Result<(), IoError> {
        const wide_from: Array<u16> = Utf16::encode(this.inner);
        const wide_to: Array<u16> = Utf16::encode(target.inner);
        if (syscall::MoveFileExW(wide_from.as_ptr(), wide_to.as_ptr(),
                syscall::MOVEFILE_REPLACE_EXISTING) == 0) {
            return Result::Err(IoError::last_os_error().with_context(IoOperation::Rename, *this));
        }
        return Result::Ok(());
    }

    /// This path made absolute and free of `.`, `..` and symlinks
    /// (`realpath(3)`). The entry must exist.
    ///
    /// Windows makes the path absolute and resolves `.` and `..` lexically
    /// (`GetFullPathNameW`), without resolving symlinks or requiring the
    /// entry to exist, and keeps a `subst` drive as written. Its separators
    /// come back as `/`, as `join` writes them, so one file has one
    /// canonical spelling on every host.
    ![target(unix)]
    public canonicalize(&this) -> Result<PathBuf, IoError> {
        mut c_path: String = String::with_null(this.inner);
        mut buffer: [u8; 4096];
        const resolved: u8* = libc::realpath(c_path.as_ptr(), &buffer[0]);
        const err: i32 = libc::errno();
        mem::drop(c_path);
        if (resolved == null) {
            return Result::Err(IoError::from_errno(err).with_context(IoOperation::Canonicalize, *this));
        }
        return Result::Ok(PathBuf::from(Str::from_raw(&buffer[0], libc::strlen(&buffer[0]) as i64)));
    }
    ![target(windows)]
    public canonicalize(&this) -> Result<PathBuf, IoError> {
        const wide: Array<u16> = Utf16::encode(this.inner);
        mut buffer: [u16; 4096];
        const count: u32 = syscall::GetFullPathNameW(wide.as_ptr(), 4096, &buffer[0], null);
        if (count == 0 || count >= 4096) {
            return Result::Err(IoError::last_os_error().with_context(IoOperation::Canonicalize, *this));
        }
        for (mut i: i64 = 0; i < (count as i64); i++) {
            if (buffer[i] == (BACKSLASH as u16)) { buffer[i] = SEPARATOR as u16; }
        }
        match (Utf16::decode(Slice::<u16>::from_raw(&buffer[0], count as i64))) {
            Result::Ok(text) => {
                const owned: PathBuf = PathBuf { inner: text };
                return Result::Ok(owned);
            }
            Result::Err(_) => {
                return Result::Err(IoError::new(IoErrorKind::InvalidData, 0).with_context(IoOperation::Canonicalize, *this));
            }
        }
    }
}

// PathBuf: owned

public type struct PathBuf<A = GlobalAlloc> {
    private inner: String<A>;

    public static new() -> PathBuf {
        return PathBuf { inner: String::new() };
    }

    /// Own a copy of a `Str` (or, implicitly, a NUL-terminated `string`
    /// via `Str`'s `![implicit]` `new`).  The bytes are copied into the
    /// owned buffer, so `source` need not outlive the result.
    public static from(source: Str) -> PathBuf {
        return PathBuf { inner: String::from_str(source) };
    }

    public as_path(&this) -> Path {
        return Path::from(this.inner.as_str());
    }

    ![inline]
    public length(&this) -> i64 {
        return this.inner.length();
    }

    public is_empty(&this) -> boolean {
        return this.inner.is_empty();
    }

    /// Append `segment`, inserting a separator if needed. A segment carrying
    /// a root of its own - `/etc`, `C:\dir`, `\dir`, `\\server\share` -
    /// replaces the current path rather than extending it, since appending
    /// one path's root inside another would name nothing.
    public push(mut &this, segment: Str) -> void {
        if (Path::root_len(segment) > 0) {
            this.inner.clear();
            this.inner.push(segment);
            return;
        }
        if (!this.inner.is_empty()) {
            const last: u8 = this.inner.as_str().as_bytes()[this.inner.length() - 1];
            if (!Path::is_separator(last)) {
                this.inner.push_byte(SEPARATOR);
            }
        }
        this.inner.push(segment);
    }

    /// Remove the last segment. Returns `true` if anything was popped;
    /// `false` at a bare root or an empty path, so this cannot climb out
    /// of the volume the path names.
    public pop(mut &this) -> boolean {
        match (this.as_path().parent()) {
            Option::Some(parent) => {
                // Rewind the String's length in place; the backing
                // buffer keeps its capacity so subsequent `push` is
                // cheap.  Reassigning
                // `this.inner = String::from_str(parent.as_str())`
                // here would allocate a fresh buffer and silently leak
                // this one, since the overwrite skips `inner.drop()`.
                const new_len: i64 = parent.length();
                this.inner.truncate(new_len);
                return true;
            }
            Option::None => { return false; }
        }
    }

    /// Append `segment` to a COPY of this path and return it, leaving `self`
    /// intact. `push` mutates in place; `join` is the owning, non-mutating
    /// twin. Same root semantics as `push` (a rooted `segment` replaces).
    public join(&this, segment: Str) -> PathBuf {
        return this.as_path().join(segment);
    }

    /// Extension of the final component; see `Path::extension`.
    public extension(&this) -> Option<Str> {
        return this.as_path().extension();
    }

    /// Consume the PathBuf and return its bytes as an owned, NUL-terminated
    /// raw `string`, leaking the allocation so the caller owns it with no
    /// borrow lifetime. Mirrors `String::into_raw` for handing an owned
    /// C-string across the raw-`string` boundary.
    public into_raw(mut this) -> string {
        const { inner }: PathBuf<A> = this;
        return inner.into_raw();
    }

}

// `Path` is a borrowed view: its `inner: Str` is a non-owning (bytes, len)
// slice, so there is nothing to release, and it deliberately implements no
// `Drop`. An empty `Drop` would still mark `Path` as needing a destructor,
// which makes a by-value `Path` parameter (e.g. `File::create(p: Path)`)
// look like an ownership-consuming move and falsely reject later reuse of
// the argument. Only `PathBuf` owns a heap `String` and needs a destructor.

/// The owned String backing is released by its field after this body.
implement<A> trait Drop for struct PathBuf<A>
where A: Allocator {
    drop(mut &this) -> void { }
}
