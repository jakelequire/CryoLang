///! File metadata: a typed `Metadata` snapshot of a path's type, size,
///! and modification time.
///!
///! POSIX: `stat(2)` / `lstat(2)`.  `struct stat` is opaque across glibc
///! versions, so it is read as a 144-byte buffer (`SIZEOF_STAT`) and the
///! needed fields are pulled out by their Linux x86_64 offsets:
///! `st_mode` @ 24 (u32), `st_size` @ 48 (u64), `st_mtim.tv_sec` @ 88
///! (i64).  A future per-arch split would gate these offsets the way
///! `sys::syscall` gates its numbers.
///!
///! Windows: the Win32 file API, NOT msvcrt's `stat` shims - msvcrt lays
///! `struct stat` out completely differently from glibc, so decoding it
///! with the offsets above would return garbage.  `metadata` opens an
///! attribute-only handle (`CreateFileA` with access 0 +
///! `FILE_FLAG_BACKUP_SEMANTICS` so directories open too) and reads
///! `GetFileInformationByHandle`, which
///! follows symlinks like `stat(2)`.  `symlink_metadata` uses
///! `GetFileAttributesExA`, which reports the reparse point itself like
///! `lstat(2)`.  Windows has no POSIX permission bits, so `raw_mode` is
///! SYNTHESIZED there: type bits from the file attributes plus 0644/0444
///! (files, by read-only attribute) or 0755/0555 (directories).

namespace std::fs::metadata;

import std::core::option;
import std::core::result::{ Result };
import std::collections::string::{ String };
import std::collections::str;
import std::io::error::{ IoError };
import std::ffi::libc;
import std::sys::syscall;
import std::sys::syscall::{ FILETIME };
import std::time::clock::{ SystemTime };
import std::fs::path::{ Path };
import std::core::mem;

// `struct stat` field byte-offsets on Linux x86_64 / glibc.
private const STAT_OFF_MODE:      u64 = 24;
private const STAT_OFF_SIZE:      u64 = 48;
private const STAT_OFF_MTIME_SEC: u64 = 88;

// WIN32_FILE_ATTRIBUTE_DATA byte-offsets (`GetFileAttributesExA` output):
//   dwFileAttributes u32 @ 0, ftCreationTime FILETIME @ 4,
//   ftLastAccessTime @ 12, ftLastWriteTime @ 20,
//   nFileSizeHigh u32 @ 28, nFileSizeLow u32 @ 32.  36 bytes total.
private const WFAD_OFF_ATTRS:     u64 = 0;
private const WFAD_OFF_WTIME:     u64 = 20;
private const WFAD_OFF_SIZE_HIGH: u64 = 28;
private const WFAD_OFF_SIZE_LOW:  u64 = 32;

// BY_HANDLE_FILE_INFORMATION byte-offsets (`GetFileInformationByHandle`):
//   dwFileAttributes u32 @ 0, ftCreationTime FILETIME @ 4,
//   ftLastAccessTime @ 12, ftLastWriteTime @ 20,
//   dwVolumeSerialNumber u32 @ 28, nFileSizeHigh u32 @ 32,
//   nFileSizeLow u32 @ 36, nNumberOfLinks u32 @ 40,
//   nFileIndexHigh u32 @ 44, nFileIndexLow u32 @ 48.  52 bytes total.
private const BHFI_OFF_ATTRS:     u64 = 0;
private const BHFI_OFF_WTIME:     u64 = 20;
private const BHFI_OFF_SIZE_HIGH: u64 = 32;
private const BHFI_OFF_SIZE_LOW:  u64 = 36;

// Synthesized POSIX permission bits for Windows entries (no octal
// literals in Cryo; values are 0644 / 0444 / 0755 / 0555 / 0777).
private const WIN_PERM_FILE_RW: u32 = 420;
private const WIN_PERM_FILE_RO: u32 = 292;
private const WIN_PERM_DIR_RW:  u32 = 493;
private const WIN_PERM_DIR_RO:  u32 = 365;
private const WIN_PERM_LINK:    u32 = 511;

/// The broad category of a filesystem entry.
public type enum FileType {
    File;
    Dir;
    Symlink;
    Other;
}

implement enum FileType {
    /// Classify from a `st_mode` value (the `S_IFMT` bits).
    public static from_mode(mode: u32) -> FileType {
        const masked: u32 = mode & libc::S_IFMT;
        if (masked == libc::S_IFREG) { return FileType::File; }
        if (masked == libc::S_IFDIR) { return FileType::Dir; }
        if (masked == libc::S_IFLNK) { return FileType::Symlink; }
        return FileType::Other;
    }
}

/// A snapshot of a path's metadata. POD (no owned resources), freely
/// copied; no `drop` needed.
public type struct Metadata {
    private raw_mode:   u32;
    private byte_size:  u64;
    private mtime_sec:  i64;

    public file_type(&this) -> FileType {
        return FileType::from_mode(this.raw_mode);
    }

    public is_file(&this) -> boolean {
        return (this.raw_mode & libc::S_IFMT) == libc::S_IFREG;
    }

    public is_dir(&this) -> boolean {
        return (this.raw_mode & libc::S_IFMT) == libc::S_IFDIR;
    }

    public is_symlink(&this) -> boolean {
        return (this.raw_mode & libc::S_IFMT) == libc::S_IFLNK;
    }

    /// Size in bytes (meaningful for regular files).
    public length(&this) -> i64 {
        return this.byte_size as i64;
    }

    /// Full `st_mode` (type bits + permission bits).  On Windows the
    /// permission bits are synthesized from the read-only attribute
    /// (see the module header), not real ACLs.
    public mode(&this) -> u32 {
        return this.raw_mode;
    }

    /// Unix permission bits (the low 12 bits of `st_mode`).  Synthesized
    /// on Windows; see the module header.
    public permissions(&this) -> u32 {
        return this.raw_mode & 0xFFF;
    }

    /// Last-modification time in whole seconds since the Unix epoch.
    public modified_secs(&this) -> i64 {
        return this.mtime_sec;
    }
}

/// Decode a filled `struct stat` buffer into a `Metadata`.
![target(linux)]
private function decode_stat(buf: u8*) -> Metadata {
    const mode: u32 = *((buf + STAT_OFF_MODE) as u32*);
    const size: u64 = *((buf + STAT_OFF_SIZE) as u64*);
    const mtime: i64 = *((buf + STAT_OFF_MTIME_SEC) as i64*);
    return Metadata { raw_mode: mode, byte_size: size, mtime_sec: mtime };
}

/// The FILETIME at `at` as whole seconds since the Unix epoch.  A time
/// before 1970 maps to 0, because a zero FILETIME is what some virtual
/// filesystems report for "unknown".
![target(windows)]
private function filetime_unix_secs(at: u8*) -> i64 {
    const secs: i64 = SystemTime::from_filetime(*(at as FILETIME*)).unix_secs();
    if (secs < 0) { return 0; }
    return secs;
}

/// Synthesize a POSIX `st_mode` from Win32 file attributes.
/// `as_link` selects the symlink type bits; the caller decides it from
/// `FILE_ATTRIBUTE_REPARSE_POINT` on the no-follow path (the follow
/// path never reports a link, mirroring `stat(2)`).
![target(windows)]
private function mode_from_attrs(attrs: u32, as_link: boolean) -> u32 {
    if (as_link) {
        return libc::S_IFLNK | WIN_PERM_LINK;
    }
    const readonly: boolean =
        (attrs & syscall::FILE_ATTRIBUTE_READONLY) != 0;
    if ((attrs & syscall::FILE_ATTRIBUTE_DIRECTORY) != 0) {
        if (readonly) { return libc::S_IFDIR | WIN_PERM_DIR_RO; }
        return libc::S_IFDIR | WIN_PERM_DIR_RW;
    }
    if (readonly) { return libc::S_IFREG | WIN_PERM_FILE_RO; }
    return libc::S_IFREG | WIN_PERM_FILE_RW;
}

/// Handle-free attribute query (`GetFileAttributesExA`).  Reports the
/// final path component ITSELF: a symlink/junction shows up as
/// `FileType::Symlink` with the reparse point's own size/mtime, which is
/// exactly `lstat(2)` semantics.  Also the fallback for `metadata` when
/// a share-mode conflict blocks opening a handle.
![target(windows)]
private function attr_metadata(p: Path) -> Result<Metadata, IoError> {
    mut c_path: String = String::with_null(p.as_str());
    mut buf: [u8; 36];
    const ok: i32 = syscall::GetFileAttributesExA(
        c_path.as_ptr(), syscall::GetFileExInfoStandard, &buf[0]);
    const gle: u32 = syscall::GetLastError();
    mem::drop(c_path);
    if (ok == 0) {
        return Result::Err(IoError::from_windows_error(gle));
    }
    const bp: u8* = &buf[0];
    const attrs:   u32 = *((bp + WFAD_OFF_ATTRS) as u32*);
    const sz_hi:   u32 = *((bp + WFAD_OFF_SIZE_HIGH) as u32*);
    const sz_lo:   u32 = *((bp + WFAD_OFF_SIZE_LOW) as u32*);
    const is_link: boolean =
        (attrs & syscall::FILE_ATTRIBUTE_REPARSE_POINT) != 0;
    return Result::Ok(Metadata {
        raw_mode:  mode_from_attrs(attrs, is_link),
        byte_size: ((sz_hi as u64) << 32) | (sz_lo as u64),
        mtime_sec: filetime_unix_secs(bp + WFAD_OFF_WTIME),
    });
}

/// Metadata for `p`, following symlinks (`stat(2)`).
![target(linux)]
public function metadata(p: Path) -> Result<Metadata, IoError> {
    mut c_path: String = String::with_null(p.as_str());
    mut buf: [u8; 144];
    const rc: i32 = libc::stat(c_path.as_ptr(), &buf[0]);
    const err: i32 = libc::errno();
    mem::drop(c_path);
    if (rc != 0) {
        return Result::Err(IoError::from_errno(err));
    }
    return Result::Ok(decode_stat(&buf[0]));
}

/// Metadata for `p`, following symlinks.  Opens an attribute-only
/// handle (access 0, all share modes, `FILE_FLAG_BACKUP_SEMANTICS` so
/// directories open too) and reads `GetFileInformationByHandle`;
/// `CreateFileA` without `FILE_FLAG_OPEN_REPARSE_POINT` resolves a
/// final symlink to its target, mirroring `stat(2)`.
![target(windows)]
public function metadata(p: Path) -> Result<Metadata, IoError> {
    mut c_path: String = String::with_null(p.as_str());
    const share: u32 = syscall::FILE_SHARE_READ
        | syscall::FILE_SHARE_WRITE
        | syscall::FILE_SHARE_DELETE;
    const h: u8* = syscall::CreateFileA(c_path.as_ptr(), 0, share,
        null, syscall::OPEN_EXISTING,
        syscall::FILE_FLAG_BACKUP_SEMANTICS, null);
    // Capture the error BEFORE dropping the path: `drop` frees heap
    // memory and any intervening API call may overwrite the thread's
    // last-error slot.
    const open_err: u32 = syscall::GetLastError();
    mem::drop(c_path);
    // Compare against a local -1: `INVALID_HANDLE_VALUE` is `(HANDLE)-1`.
    if ((h as i64) == -1) {
        const code: u32 = open_err;
        if (code == syscall::ERROR_SHARING_VIOLATION
                || code == syscall::ERROR_ACCESS_DENIED) {
            // Another process holds the file with a conflicting share
            // mode (or ACLs block handle opens); the attributes are
            // still queryable without a handle.  The fallback does not
            // follow a final symlink - acceptable degradation for a
            // locked reparse point.
            return attr_metadata(p);
        }
        return Result::Err(IoError::from_windows_error(code));
    }
    mut buf: [u8; 52];
    const ok: i32 = syscall::GetFileInformationByHandle(h, &buf[0]);
    const gle: u32 = syscall::GetLastError();
    syscall::CloseHandle(h);
    if (ok == 0) {
        return Result::Err(IoError::from_windows_error(gle));
    }
    const bp: u8* = &buf[0];
    const attrs: u32 = *((bp + BHFI_OFF_ATTRS) as u32*);
    const sz_hi: u32 = *((bp + BHFI_OFF_SIZE_HIGH) as u32*);
    const sz_lo: u32 = *((bp + BHFI_OFF_SIZE_LOW) as u32*);
    return Result::Ok(Metadata {
        raw_mode:  mode_from_attrs(attrs, false),
        byte_size: ((sz_hi as u64) << 32) | (sz_lo as u64),
        mtime_sec: filetime_unix_secs(bp + BHFI_OFF_WTIME),
    });
}

/// Metadata for `p` without following a final symlink.  On POSIX this is
/// `lstat(2)`; on Windows it is the handle-free attribute query, which
/// reports the reparse point itself (see `attr_metadata`).
![target(linux)]
public function symlink_metadata(p: Path) -> Result<Metadata, IoError> {
    mut c_path: String = String::with_null(p.as_str());
    mut buf: [u8; 144];
    const rc: i32 = libc::lstat(c_path.as_ptr(), &buf[0]);
    const err: i32 = libc::errno();
    mem::drop(c_path);
    if (rc != 0) {
        return Result::Err(IoError::from_errno(err));
    }
    return Result::Ok(decode_stat(&buf[0]));
}

![target(windows)]
public function symlink_metadata(p: Path) -> Result<Metadata, IoError> {
    return attr_metadata(p);
}

/// True if `p` exists (any type). Uses `access(2)` with `F_OK` (0).
/// A non-existence answer is not distinguished from a permission error
/// on an intermediate directory; use `metadata` if you need the reason.
public function exists(p: Path) -> boolean {
    mut c_path: String = String::with_null(p.as_str());
    const rc: i32 = libc::access(c_path.as_ptr(), 0);
    mem::drop(c_path);
    return rc == 0;
}

/// True if `p` exists and is a regular file.
public function is_file(p: Path) -> boolean {
    match (metadata(p)) {
        Result::Ok(m)  => { return m.is_file(); }
        Result::Err(_) => { return false; }
    }
}

/// True if `p` exists and is a directory.
public function is_dir(p: Path) -> boolean {
    match (metadata(p)) {
        Result::Ok(m)  => { return m.is_dir(); }
        Result::Err(_) => { return false; }
    }
}
