///! fs: files, directories and paths.
///!
///!     import std::fs::{ Directory, File, Path };
///!
///!     const text: String = File::read_text("config.toml")?;
///!     File::write_text("copy.toml", text.as_str())?;
///!     if (!Path::from("build").is_directory()) { Directory::create_all("build/cache")?; }
///!
///! Each operation lives on the type it is about:
///!
///!   - `File` - one file: open it (`open`, `create`, `OpenOptions`) and
///!     read, write and seek through the `Read`/`Write`/`Seek` traits, or
///!     do the whole job in one call (`read_text`, `read_bytes`,
///!     `write_text`, `write_bytes`, `append_text`, `copy`, `remove`).
///!   - `Directory` - one directory: `create`, `create_all`, `remove`,
///!     `remove_all`, and `entries`, which lists it.
///!   - `Path` - the text naming an entry, and what is at it whatever its
///!     kind: `exists`, `is_file`, `is_directory`, `metadata`,
///!     `rename_to`, `canonicalize`. `PathBuf` owns one.
///!
///! A `string` literal or a `Str` converts to a `Path` where one is
///! wanted, so a path rarely needs spelling as `Path::from(...)` in a call.
///! Every failure is an `IoError` that names the path it happened at.
///!
///! Paths are length-typed UTF-8. They cross to the OS as a NUL-terminated
///! `String` on POSIX, and as UTF-16 (`encoding::utf16`) through the
///! wide-character calls on Windows.

namespace std::fs;

module {
    fs::path;
    fs::file;
    fs::metadata;
    fs::directory;
}

export std::fs::path::{ Path, PathBuf };
export std::fs::file::{ File, OpenOptions };
export std::fs::directory::{ Directory, DirectoryEntries, DirectoryEntry };
export std::fs::metadata::{ FileType, Metadata };
