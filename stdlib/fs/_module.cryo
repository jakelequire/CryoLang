///! fs: filesystem access.
///!
///! `Path` is a borrowed view of a filesystem path; `PathBuf` owns
///! one. `File` opens a path and surfaces `Read` + `Write` so code
///! that already targets the I/O traits works against files without
///! file-specific glue.
///!
///! Paths are length-typed UTF-8. `ffi::cstr::CString` is used at
///! the C boundary when calling `open(2)` / `stat(2)`.

namespace std::fs;

public module fs::path;
public module fs::file;
