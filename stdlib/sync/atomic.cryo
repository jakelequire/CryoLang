///! Atomic primitives for concurrent code.
///!
///! A single generic `Atomic<T>` wraps one cell of integer-typed storage and
///! exposes load, store, fetch_add/sub/and/or/xor, swap, and
///! compare_exchange - all driven by the compiler's atomic intrinsics, which
///! lower directly to LLVM's `atomicrmw` / `cmpxchg` / atomic `load` / `store`
///! instructions.  No libc, no spin loops, no calls.
///!
///! `T` is dispatched at compile time with `static match (T)`: each method
///! body keeps only the arm for the concrete `T` (the rest are pruned before
///! type-checking), so `Atomic<u32>::load` lowers to exactly the `u32` atomic
///! and nothing else.  LLVM does not distinguish signed/unsigned for atomic
///! integer memory ops, so the signed (`i32`/`i64`) and `boolean` arms bitcast
///! onto the same unsigned intrinsics.
///!
///! Supported `T`: `u8`, `u32`, `u64`, `i32`, `i64`, `boolean`.  Instantiating
///! `Atomic<T>` with any other type - or calling `fetch_add`/`fetch_sub` on
///! `Atomic<boolean>` - is a compile error (E0645): the absence of a matching
///! `static match` arm IS the type constraint (no trait bound needed).
///!
///! Every operation takes an `MemoryOrder` describing the memory-model
///! constraints around it.  When in doubt, `SeqCst` is the always-safe
///! choice; `Relaxed` is correct for counters where only the final value
///! matters; `Acquire` / `Release` pair to form the standard happens-before
///! edge.  A load cannot use `Release`.
///!
///! Atomic cells are intentionally **not** `Copy`: mutation through a shared
///! pointer must be controlled, and bitwise-copying an atomic would silently
///! break that invariant.  Wrap in `Arc<Atomic<T>>` to share across threads.

namespace std::sync::atomic;

import core::intrinsics;
import core::result;

/// Memory-ordering for an atomic operation.
///
/// Values mirror LLVM's `AtomicMemoryOrder` enum exactly (Relaxed=2,
/// Acquire=4, Release=5, AcqRel=6, SeqCst=7), so the conversion to
/// the compiler intrinsic's `u32` argument is a direct mapping.
///
/// - `Relaxed`: no ordering constraints, only atomicity. Cheapest;
///   correct for hit counters and similar usage where the observed
///   sequence of values doesn't matter.
/// - `Acquire`: on loads/RMW, prevents reordering of *later* memory
///   accesses across this op.  Pairs with `Release` on the producer
///   side to form a happens-before edge.
/// - `Release`: on stores/RMW, prevents reordering of *earlier*
///   memory accesses across this op.  Pairs with `Acquire`.
/// - `AcqRel`: combined `Acquire + Release`; for RMW ops only.
/// - `SeqCst`: full sequential-consistency.  All threads observe
///   the same global order of `SeqCst` ops on every cell.
type enum MemoryOrder : u32 {
    Relaxed = 2;
    Acquire = 4;
    Release = 5;
    AcqRel  = 6;
    SeqCst  = 7;
}

implement enum MemoryOrder {
    static to_u32(order: MemoryOrder) -> u32 {
        return match (order) {
            MemoryOrder::Relaxed => { 2u32 }
            MemoryOrder::Acquire => { 4u32 }
            MemoryOrder::Release => { 5u32 }
            MemoryOrder::AcqRel  => { 6u32 }
            MemoryOrder::SeqCst  => { 7u32 }
        };
    }
}

/// Insert a memory fence with the given ordering.  Equivalent to
/// `atomicrmw xchg` on a dummy location with no actual ops, but
/// generated as a real LLVM `fence` instruction.
///
/// The fence is emitted with the requested ordering.  A fence only
/// accepts `Acquire`/`Release`/`AcqRel`/`SeqCst`; a weaker request
/// (`Relaxed`) is a no-op fence and is clamped up to `SeqCst` rather
/// than producing invalid IR.
function fence(order: MemoryOrder) -> void {
    atomic_fence(MemoryOrder::to_u32(order));
}

/// Like `fence`, but only constrains the compiler's reordering, not
/// the CPU's.  Today this lowers to the same SeqCst LLVM fence as
/// `fence` (the conservative path); the distinction is preserved for
/// future refinement.  Use this when communicating with code inside
/// the same thread (e.g., signal handlers, longjmp paths).
function compiler_fence(order: MemoryOrder) -> void {
    atomic_fence(MemoryOrder::to_u32(order));
}


/// A single atomic cell of type `T`.  See the module docs for the supported
/// `T` and the compile-time dispatch model.
type struct Atomic<T> {
    value: T;

    /// Construct an `Atomic<T>` initialized to `initial`.  Stack-allocated;
    /// callers wishing to share between threads should wrap in
    /// `Arc<Atomic<T>>` or place inside a heap-pinned container.
    static new(initial: T) -> Atomic<T> {
        return Atomic<T> { value: initial };
    }

    load(&this, order: MemoryOrder) -> T {
        return static match (T) {
            u8      => { atomic_load_u8(&this.value, MemoryOrder::to_u32(order)) }
            u32     => { atomic_load_u32(&this.value, MemoryOrder::to_u32(order)) }
            u64     => { atomic_load_u64(&this.value, MemoryOrder::to_u32(order)) }
            i32     => { atomic_load_u32(&this.value as u32*, MemoryOrder::to_u32(order)) as i32 }
            i64     => { atomic_load_u64(&this.value as u64*, MemoryOrder::to_u32(order)) as i64 }
            boolean => { atomic_load_u8(&this.value as u8*, MemoryOrder::to_u32(order)) != 0u8 }
        };
    }

    store(mut &this, val: T, order: MemoryOrder) -> void {
        static match (T) {
            u8      => { atomic_store_u8(&this.value, val, MemoryOrder::to_u32(order)); }
            u32     => { atomic_store_u32(&this.value, val, MemoryOrder::to_u32(order)); }
            u64     => { atomic_store_u64(&this.value, val, MemoryOrder::to_u32(order)); }
            i32     => { atomic_store_u32(&this.value as u32*, val as u32, MemoryOrder::to_u32(order)); }
            i64     => { atomic_store_u64(&this.value as u64*, val as u64, MemoryOrder::to_u32(order)); }
            boolean => {
                const b: u8 = if (val) { 1u8 } else { 0u8 };
                atomic_store_u8(&this.value as u8*, b, MemoryOrder::to_u32(order));
            }
        }
    }

    /// Atomically add `val` to the cell and return the previous value.
    ///
    /// On `Atomic<boolean>` this operates on the 0/1 `u8` backing; it is
    /// included only so `Atomic<boolean>` instantiates (whole-struct
    /// monomorphization specializes every method), and `fetch_and`/`fetch_or`/
    /// `fetch_xor` are the meaningful boolean RMW ops.
    fetch_add(mut &this, val: T, order: MemoryOrder) -> T {
        return static match (T) {
            u8  => { atomic_add_u8(&this.value, val, MemoryOrder::to_u32(order)) }
            u32 => { atomic_add_u32(&this.value, val, MemoryOrder::to_u32(order)) }
            u64 => { atomic_add_u64(&this.value, val, MemoryOrder::to_u32(order)) }
            i32 => { atomic_add_u32(&this.value as u32*, val as u32, MemoryOrder::to_u32(order)) as i32 }
            i64 => { atomic_add_u64(&this.value as u64*, val as u64, MemoryOrder::to_u32(order)) as i64 }
            boolean => {
                const b: u8 = if (val) { 1u8 } else { 0u8 };
                atomic_add_u8(&this.value as u8*, b, MemoryOrder::to_u32(order)) != 0u8
            }
        };
    }

    /// Atomically subtract `val` from the cell and return the previous value.
    /// See `fetch_add` for the `Atomic<boolean>` caveat.
    fetch_sub(mut &this, val: T, order: MemoryOrder) -> T {
        return static match (T) {
            u8  => { atomic_sub_u8(&this.value, val, MemoryOrder::to_u32(order)) }
            u32 => { atomic_sub_u32(&this.value, val, MemoryOrder::to_u32(order)) }
            u64 => { atomic_sub_u64(&this.value, val, MemoryOrder::to_u32(order)) }
            i32 => { atomic_sub_u32(&this.value as u32*, val as u32, MemoryOrder::to_u32(order)) as i32 }
            i64 => { atomic_sub_u64(&this.value as u64*, val as u64, MemoryOrder::to_u32(order)) as i64 }
            boolean => {
                const b: u8 = if (val) { 1u8 } else { 0u8 };
                atomic_sub_u8(&this.value as u8*, b, MemoryOrder::to_u32(order)) != 0u8
            }
        };
    }

    /// AND the cell with `val`.  Returns the previous value.
    fetch_and(mut &this, val: T, order: MemoryOrder) -> T {
        return static match (T) {
            u8  => { atomic_and_u8(&this.value, val, MemoryOrder::to_u32(order)) }
            u32 => { atomic_and_u32(&this.value, val, MemoryOrder::to_u32(order)) }
            u64 => { atomic_and_u64(&this.value, val, MemoryOrder::to_u32(order)) }
            i32 => { atomic_and_u32(&this.value as u32*, val as u32, MemoryOrder::to_u32(order)) as i32 }
            i64 => { atomic_and_u64(&this.value as u64*, val as u64, MemoryOrder::to_u32(order)) as i64 }
            boolean => {
                const b: u8 = if (val) { 1u8 } else { 0u8 };
                atomic_and_u8(&this.value as u8*, b, MemoryOrder::to_u32(order)) != 0u8
            }
        };
    }

    /// OR the cell with `val`.  Returns the previous value.
    fetch_or(mut &this, val: T, order: MemoryOrder) -> T {
        return static match (T) {
            u8  => { atomic_or_u8(&this.value, val, MemoryOrder::to_u32(order)) }
            u32 => { atomic_or_u32(&this.value, val, MemoryOrder::to_u32(order)) }
            u64 => { atomic_or_u64(&this.value, val, MemoryOrder::to_u32(order)) }
            i32 => { atomic_or_u32(&this.value as u32*, val as u32, MemoryOrder::to_u32(order)) as i32 }
            i64 => { atomic_or_u64(&this.value as u64*, val as u64, MemoryOrder::to_u32(order)) as i64 }
            boolean => {
                const b: u8 = if (val) { 1u8 } else { 0u8 };
                atomic_or_u8(&this.value as u8*, b, MemoryOrder::to_u32(order)) != 0u8
            }
        };
    }

    /// XOR the cell with `val`.  Returns the previous value.
    fetch_xor(mut &this, val: T, order: MemoryOrder) -> T {
        return static match (T) {
            u8  => { atomic_xor_u8(&this.value, val, MemoryOrder::to_u32(order)) }
            u32 => { atomic_xor_u32(&this.value, val, MemoryOrder::to_u32(order)) }
            u64 => { atomic_xor_u64(&this.value, val, MemoryOrder::to_u32(order)) }
            i32 => { atomic_xor_u32(&this.value as u32*, val as u32, MemoryOrder::to_u32(order)) as i32 }
            i64 => { atomic_xor_u64(&this.value as u64*, val as u64, MemoryOrder::to_u32(order)) as i64 }
            boolean => {
                const b: u8 = if (val) { 1u8 } else { 0u8 };
                atomic_xor_u8(&this.value as u8*, b, MemoryOrder::to_u32(order)) != 0u8
            }
        };
    }

    /// Atomically replace the cell's value with `val` and return the
    /// previous value.
    swap(mut &this, val: T, order: MemoryOrder) -> T {
        return static match (T) {
            u8  => { atomic_swap_u8(&this.value, val, MemoryOrder::to_u32(order)) }
            u32 => { atomic_swap_u32(&this.value, val, MemoryOrder::to_u32(order)) }
            u64 => { atomic_swap_u64(&this.value, val, MemoryOrder::to_u32(order)) }
            i32 => { atomic_swap_u32(&this.value as u32*, val as u32, MemoryOrder::to_u32(order)) as i32 }
            i64 => { atomic_swap_u64(&this.value as u64*, val as u64, MemoryOrder::to_u32(order)) as i64 }
            boolean => {
                const b: u8 = if (val) { 1u8 } else { 0u8 };
                atomic_swap_u8(&this.value as u8*, b, MemoryOrder::to_u32(order)) != 0u8
            }
        };
    }

    /// Atomic compare-and-swap.  Returns `Ok(prev)` with `prev == current`
    /// when the swap happens; `Err(actual)` with the observed value when the
    /// comparison fails.
    compare_exchange(mut &this, current: T, next: T, succ: MemoryOrder, fail: MemoryOrder) -> Result<T, T> {
        static match (T) {
            u8 => {
                mut ok: boolean = false;
                const loaded: u8 = atomic_cmpxchg_u8(
                    &this.value, current, next,
                    MemoryOrder::to_u32(succ), MemoryOrder::to_u32(fail), &ok);
                if (ok) { return Result::Ok(loaded); }
                return Result::Err(loaded);
            }
            u32 => {
                mut ok: boolean = false;
                const loaded: u32 = atomic_cmpxchg_u32(
                    &this.value, current, next,
                    MemoryOrder::to_u32(succ), MemoryOrder::to_u32(fail), &ok);
                if (ok) { return Result::Ok(loaded); }
                return Result::Err(loaded);
            }
            u64 => {
                mut ok: boolean = false;
                const loaded: u64 = atomic_cmpxchg_u64(
                    &this.value, current, next,
                    MemoryOrder::to_u32(succ), MemoryOrder::to_u32(fail), &ok);
                if (ok) { return Result::Ok(loaded); }
                return Result::Err(loaded);
            }
            i32 => {
                mut ok: boolean = false;
                const loaded: u32 = atomic_cmpxchg_u32(
                    &this.value as u32*, current as u32, next as u32,
                    MemoryOrder::to_u32(succ), MemoryOrder::to_u32(fail), &ok);
                if (ok) { return Result::Ok(loaded as i32); }
                return Result::Err(loaded as i32);
            }
            i64 => {
                mut ok: boolean = false;
                const loaded: u64 = atomic_cmpxchg_u64(
                    &this.value as u64*, current as u64, next as u64,
                    MemoryOrder::to_u32(succ), MemoryOrder::to_u32(fail), &ok);
                if (ok) { return Result::Ok(loaded as i64); }
                return Result::Err(loaded as i64);
            }
            boolean => {
                const cur_b: u8  = if (current) { 1u8 } else { 0u8 };
                const next_b: u8 = if (next)    { 1u8 } else { 0u8 };
                mut ok: boolean = false;
                const loaded: u8 = atomic_cmpxchg_u8(
                    &this.value as u8*, cur_b, next_b,
                    MemoryOrder::to_u32(succ), MemoryOrder::to_u32(fail), &ok);
                if (ok) { return Result::Ok(loaded != 0u8); }
                return Result::Err(loaded != 0u8);
            }
        }
    }
}

/// Empty `Drop` makes `Atomic<T>` non-`Copy`; mutation through a shared
/// pointer must remain explicit, never silent.
implement trait Drop for struct Atomic<T> {
    drop(mut &this) -> void { }
}
