///! Atomic primitives for concurrent code.
///!
///! A single generic `Atomic<T>` wraps one cell of integer-typed storage and
///! exposes load, store, fetch_add/sub/and/or/xor, swap, and
///! compare_exchange - all driven by the compiler's atomic intrinsics, which
///! lower directly to LLVM's `atomicrmw` / `cmpxchg` / atomic `load` / `store`
///! instructions.  No libc, no spin loops, no calls.
///!
///! `T` is dispatched at compile time with `static match (T)`: each method
///! body keeps only the arm for the concrete `T` (the rest are pruned before
///! type-checking), so `Atomic<u32>::load` lowers to exactly the `u32` atomic
///! and nothing else.  LLVM does not distinguish signed/unsigned for atomic
///! integer memory ops, so the signed (`i32`/`i64`) and `boolean` arms bitcast
///! onto the same unsigned intrinsics.
///!
///! Supported `T`: `u8`, `u32`, `u64`, `i32`, `i64`, `boolean`.  Instantiating
///! `Atomic<T>` with any other type is a compile error (E0645): the absence
///! of a matching `static match` arm IS the type constraint (no trait bound
///! needed).  `fetch_add` and `fetch_sub` are an integer cell's alone
///! (`where T: Integer`): on `Atomic<boolean>` they are refused, since
///! arithmetic on the 0/1 backing byte would store a byte that is neither.
///!
///! Every operation takes an `MemoryOrder` describing the memory-model
///! constraints around it.  When in doubt, `SeqCst` is the always-safe
///! choice; `Relaxed` is correct for counters where only the final value
///! matters; `Acquire` / `Release` pair to form the standard happens-before
///! edge.  A load cannot use `Release`.
///!
///! Every operation takes `&this`: an atomic is updated in place through a
///! shared reference, so threads and closures that borrow one cell all
///! update that cell - scoped threads can count into an atomic local of
///! their caller.  Atomic cells are intentionally **not** `Copy`: a bitwise
///! copy would be a second cell, and an update to it would be lost.  Wrap in
///! `Arc<Atomic<T>>` to share one with threads that outlive its owner.

namespace std::sync::atomic;

import std::core::intrinsics;
import std::core::result::{ Result };
import std::core::drop::{ Drop };

/// Memory-ordering for an atomic operation.
///
/// Values mirror LLVM's `AtomicMemoryOrder` enum exactly (Relaxed=2,
/// Acquire=4, Release=5, AcqRel=6, SeqCst=7), so the conversion to
/// the compiler intrinsic's `u32` argument is a direct mapping.
///
/// - `Relaxed`: no ordering constraints, only atomicity. Cheapest;
///   correct for hit counters and similar usage where the observed
///   sequence of values doesn't matter.
/// - `Acquire`: on loads/RMW, prevents reordering of *later* memory
///   accesses across this op.  Pairs with `Release` on the producer
///   side to form a happens-before edge.
/// - `Release`: on stores/RMW, prevents reordering of *earlier*
///   memory accesses across this op.  Pairs with `Acquire`.
/// - `AcqRel`: combined `Acquire + Release`; for RMW ops only.
/// - `SeqCst`: full sequential-consistency.  All threads observe
///   the same global order of `SeqCst` ops on every cell.
public type enum MemoryOrder : u32 {
    Relaxed = 2;
    Acquire = 4;
    Release = 5;
    AcqRel  = 6;
    SeqCst  = 7;
}

implement enum MemoryOrder {
    /// The ordering's number as the compiler's atomic intrinsics take it,
    /// the same as its discriminant: `Relaxed` 2, `Acquire` 4, `Release` 5,
    /// `AcqRel` 6, `SeqCst` 7.
    public static to_u32(order: MemoryOrder) -> u32 {
        return match (order) {
            MemoryOrder::Relaxed => { 2 }
            MemoryOrder::Acquire => { 4 }
            MemoryOrder::Release => { 5 }
            MemoryOrder::AcqRel  => { 6 }
            MemoryOrder::SeqCst  => { 7 }
        };
    }
}

/// Insert a memory fence with the given ordering.  Equivalent to
/// `atomicrmw xchg` on a dummy location with no actual ops, but
/// generated as a real LLVM `fence` instruction.
///
/// The fence is emitted with the requested ordering.  A fence only
/// accepts `Acquire`/`Release`/`AcqRel`/`SeqCst`; a weaker request
/// (`Relaxed`) is a no-op fence and is clamped up to `SeqCst` rather
/// than producing invalid IR.
public function fence(order: MemoryOrder) -> void {
    // LLVM's `fence` instruction rejects Relaxed/Monotonic. Relaxed (2) is
    // the only sub-Acquire ordering in MemoryOrder, and a Relaxed fence is a
    // semantic no-op, so clamp it up to SeqCst (7) rather than emit invalid
    // IR. Acquire/Release/AcqRel/SeqCst pass through unchanged.
    mut ord: u32 = MemoryOrder::to_u32(order);
    if (ord < 4) { ord = 7; }
    intrinsics::atomic_fence(ord);
}

/// Like `fence`, but intended only to constrain the compiler's
/// reordering, not the CPU's.  Today this conservatively lowers to a
/// real LLVM `fence` at the requested ordering (so it also bars CPU
/// reordering); the lighter semantics are preserved in the signature
/// for future refinement.  Use this when communicating with code inside
/// the same thread (e.g., signal handlers, longjmp paths).
public function compiler_fence(order: MemoryOrder) -> void {
    // Same Relaxed-clamp as `fence`: LLVM's `fence` rejects the sub-Acquire
    // ordering, so a Relaxed request becomes SeqCst rather than invalid IR.
    mut ord: u32 = MemoryOrder::to_u32(order);
    if (ord < 4) { ord = 7; }
    intrinsics::atomic_fence(ord);
}


/// A single atomic cell of type `T`.  See the module docs for the supported
/// `T` and the compile-time dispatch model.
public type struct Atomic<T> {
    private value: T;

    /// Construct an `Atomic<T>` initialized to `initial`.  Stack-allocated;
    /// callers wishing to share between threads should wrap in
    /// `Arc<Atomic<T>>` or place inside a heap-pinned container.
    public static new(initial: T) -> Atomic<T> {
        return Atomic::<T> { value: initial };
    }

    /// Atomically read the cell's value. `order` is `Relaxed`, `Acquire`
    /// or `SeqCst`; `Release` and `AcqRel` order writes and are not
    /// orderings a load can have.
    ///
    /// ```cryo
    /// import std::sync::atomic::{ Atomic, MemoryOrder };
    ///
    /// const ready: Atomic<boolean> = Atomic::new(false);
    /// ready.store(true, MemoryOrder::Release);
    /// const seen: boolean = ready.load(MemoryOrder::Acquire);   // true
    /// ```
    public load(&this, order: MemoryOrder) -> T {
        return static match (T) {
            u8      => { intrinsics::atomic_load_u8(&this.value, MemoryOrder::to_u32(order)) }
            u32     => { intrinsics::atomic_load_u32(&this.value, MemoryOrder::to_u32(order)) }
            u64     => { intrinsics::atomic_load_u64(&this.value, MemoryOrder::to_u32(order)) }
            i32     => { intrinsics::atomic_load_u32(&this.value as const u32*, MemoryOrder::to_u32(order)) as i32 }
            i64     => { intrinsics::atomic_load_u64(&this.value as const u64*, MemoryOrder::to_u32(order)) as i64 }
            boolean => { intrinsics::atomic_load_u8(&this.value as const u8*, MemoryOrder::to_u32(order)) != 0 }
        };
    }

    /// Atomically replace the cell's value with `val`. `order` is
    /// `Relaxed`, `Release` or `SeqCst`; `Acquire` and `AcqRel` order reads
    /// and are not orderings a store can have. Use `swap` to get the old
    /// value back.
    public store(&this,val: T, order: MemoryOrder) -> void {
        static match (T) {
            u8      => { intrinsics::atomic_store_u8(&this.value, val, MemoryOrder::to_u32(order)); }
            u32     => { intrinsics::atomic_store_u32(&this.value, val, MemoryOrder::to_u32(order)); }
            u64     => { intrinsics::atomic_store_u64(&this.value, val, MemoryOrder::to_u32(order)); }
            i32     => { intrinsics::atomic_store_u32(&this.value as u32*, val as u32, MemoryOrder::to_u32(order)); }
            i64     => { intrinsics::atomic_store_u64(&this.value as u64*, val as u64, MemoryOrder::to_u32(order)); }
            boolean => {
                const b: u8 = if (val) { 1 } else { 0 };
                intrinsics::atomic_store_u8(&this.value as u8*, b, MemoryOrder::to_u32(order));
            }
        }
    }

    /// Atomically add `val` to the cell and return the previous value.  An
    /// integer cell's alone: `Atomic<boolean>` has no `fetch_add`.
    public fetch_add(&this,val: T, order: MemoryOrder) -> T where T: Integer {
        return static match (T) {
            u8  => { intrinsics::atomic_add_u8(&this.value, val, MemoryOrder::to_u32(order)) }
            u32 => { intrinsics::atomic_add_u32(&this.value, val, MemoryOrder::to_u32(order)) }
            u64 => { intrinsics::atomic_add_u64(&this.value, val, MemoryOrder::to_u32(order)) }
            i32 => { intrinsics::atomic_add_u32(&this.value as u32*, val as u32, MemoryOrder::to_u32(order)) as i32 }
            i64 => { intrinsics::atomic_add_u64(&this.value as u64*, val as u64, MemoryOrder::to_u32(order)) as i64 }
            // No cell holds another integer: `load` and `store` refuse it.
            _   => { unreachable() }
        };
    }

    /// Atomically subtract `val` from the cell and return the previous
    /// value.  An integer cell's alone: `Atomic<boolean>` has no
    /// `fetch_sub`.
    public fetch_sub(&this,val: T, order: MemoryOrder) -> T where T: Integer {
        return static match (T) {
            u8  => { intrinsics::atomic_sub_u8(&this.value, val, MemoryOrder::to_u32(order)) }
            u32 => { intrinsics::atomic_sub_u32(&this.value, val, MemoryOrder::to_u32(order)) }
            u64 => { intrinsics::atomic_sub_u64(&this.value, val, MemoryOrder::to_u32(order)) }
            i32 => { intrinsics::atomic_sub_u32(&this.value as u32*, val as u32, MemoryOrder::to_u32(order)) as i32 }
            i64 => { intrinsics::atomic_sub_u64(&this.value as u64*, val as u64, MemoryOrder::to_u32(order)) as i64 }
            // No cell holds another integer: `load` and `store` refuse it.
            _   => { unreachable() }
        };
    }

    /// AND the cell with `val`.  Returns the previous value.
    public fetch_and(&this,val: T, order: MemoryOrder) -> T {
        return static match (T) {
            u8  => { intrinsics::atomic_and_u8(&this.value, val, MemoryOrder::to_u32(order)) }
            u32 => { intrinsics::atomic_and_u32(&this.value, val, MemoryOrder::to_u32(order)) }
            u64 => { intrinsics::atomic_and_u64(&this.value, val, MemoryOrder::to_u32(order)) }
            i32 => { intrinsics::atomic_and_u32(&this.value as u32*, val as u32, MemoryOrder::to_u32(order)) as i32 }
            i64 => { intrinsics::atomic_and_u64(&this.value as u64*, val as u64, MemoryOrder::to_u32(order)) as i64 }
            boolean => {
                const b: u8 = if (val) { 1 } else { 0 };
                intrinsics::atomic_and_u8(&this.value as u8*, b, MemoryOrder::to_u32(order)) != 0
            }
        };
    }

    /// OR the cell with `val`.  Returns the previous value.
    public fetch_or(&this,val: T, order: MemoryOrder) -> T {
        return static match (T) {
            u8  => { intrinsics::atomic_or_u8(&this.value, val, MemoryOrder::to_u32(order)) }
            u32 => { intrinsics::atomic_or_u32(&this.value, val, MemoryOrder::to_u32(order)) }
            u64 => { intrinsics::atomic_or_u64(&this.value, val, MemoryOrder::to_u32(order)) }
            i32 => { intrinsics::atomic_or_u32(&this.value as u32*, val as u32, MemoryOrder::to_u32(order)) as i32 }
            i64 => { intrinsics::atomic_or_u64(&this.value as u64*, val as u64, MemoryOrder::to_u32(order)) as i64 }
            boolean => {
                const b: u8 = if (val) { 1 } else { 0 };
                intrinsics::atomic_or_u8(&this.value as u8*, b, MemoryOrder::to_u32(order)) != 0
            }
        };
    }

    /// XOR the cell with `val`.  Returns the previous value.
    public fetch_xor(&this,val: T, order: MemoryOrder) -> T {
        return static match (T) {
            u8  => { intrinsics::atomic_xor_u8(&this.value, val, MemoryOrder::to_u32(order)) }
            u32 => { intrinsics::atomic_xor_u32(&this.value, val, MemoryOrder::to_u32(order)) }
            u64 => { intrinsics::atomic_xor_u64(&this.value, val, MemoryOrder::to_u32(order)) }
            i32 => { intrinsics::atomic_xor_u32(&this.value as u32*, val as u32, MemoryOrder::to_u32(order)) as i32 }
            i64 => { intrinsics::atomic_xor_u64(&this.value as u64*, val as u64, MemoryOrder::to_u32(order)) as i64 }
            boolean => {
                const b: u8 = if (val) { 1 } else { 0 };
                intrinsics::atomic_xor_u8(&this.value as u8*, b, MemoryOrder::to_u32(order)) != 0
            }
        };
    }

    /// Atomically replace the cell's value with `val` and return the
    /// previous value.
    public swap(&this,val: T, order: MemoryOrder) -> T {
        return static match (T) {
            u8  => { intrinsics::atomic_swap_u8(&this.value, val, MemoryOrder::to_u32(order)) }
            u32 => { intrinsics::atomic_swap_u32(&this.value, val, MemoryOrder::to_u32(order)) }
            u64 => { intrinsics::atomic_swap_u64(&this.value, val, MemoryOrder::to_u32(order)) }
            i32 => { intrinsics::atomic_swap_u32(&this.value as u32*, val as u32, MemoryOrder::to_u32(order)) as i32 }
            i64 => { intrinsics::atomic_swap_u64(&this.value as u64*, val as u64, MemoryOrder::to_u32(order)) as i64 }
            boolean => {
                const b: u8 = if (val) { 1 } else { 0 };
                intrinsics::atomic_swap_u8(&this.value as u8*, b, MemoryOrder::to_u32(order)) != 0
            }
        };
    }

    /// Atomic compare-and-swap.  Returns `Ok(prev)` with `prev == current`
    /// when the swap happens; `Err(actual)` with the observed value when the
    /// comparison fails.
    public compare_exchange(&this,current: T, next: T, succ: MemoryOrder, fail: MemoryOrder) -> Result<T, T> {
        static match (T) {
            u8 => {
                mut ok: boolean = false;
                const loaded: u8 = intrinsics::atomic_cmpxchg_u8(
                    &this.value, current, next,
                    MemoryOrder::to_u32(succ), MemoryOrder::to_u32(fail), &ok);
                if (ok) { return Result::Ok(loaded); }
                return Result::Err(loaded);
            }
            u32 => {
                mut ok: boolean = false;
                const loaded: u32 = intrinsics::atomic_cmpxchg_u32(
                    &this.value, current, next,
                    MemoryOrder::to_u32(succ), MemoryOrder::to_u32(fail), &ok);
                if (ok) { return Result::Ok(loaded); }
                return Result::Err(loaded);
            }
            u64 => {
                mut ok: boolean = false;
                const loaded: u64 = intrinsics::atomic_cmpxchg_u64(
                    &this.value, current, next,
                    MemoryOrder::to_u32(succ), MemoryOrder::to_u32(fail), &ok);
                if (ok) { return Result::Ok(loaded); }
                return Result::Err(loaded);
            }
            i32 => {
                mut ok: boolean = false;
                const loaded: u32 = intrinsics::atomic_cmpxchg_u32(
                    &this.value as u32*, current as u32, next as u32,
                    MemoryOrder::to_u32(succ), MemoryOrder::to_u32(fail), &ok);
                if (ok) { return Result::Ok(loaded as i32); }
                return Result::Err(loaded as i32);
            }
            i64 => {
                mut ok: boolean = false;
                const loaded: u64 = intrinsics::atomic_cmpxchg_u64(
                    &this.value as u64*, current as u64, next as u64,
                    MemoryOrder::to_u32(succ), MemoryOrder::to_u32(fail), &ok);
                if (ok) { return Result::Ok(loaded as i64); }
                return Result::Err(loaded as i64);
            }
            boolean => {
                const cur_b: u8  = if (current) { 1 } else { 0 };
                const next_b: u8 = if (next)    { 1 } else { 0 };
                mut ok: boolean = false;
                const loaded: u8 = intrinsics::atomic_cmpxchg_u8(
                    &this.value as u8*, cur_b, next_b,
                    MemoryOrder::to_u32(succ), MemoryOrder::to_u32(fail), &ok);
                if (ok) { return Result::Ok(loaded != 0); }
                return Result::Err(loaded != 0);
            }
        }
    }
}

/// Empty `Drop` makes `Atomic<T>` non-`Copy`, so a closure borrows the cell
/// it captures instead of updating a copy.
implement<T> trait Drop for struct Atomic<T> {
    drop(mut &this) -> void { }
}
