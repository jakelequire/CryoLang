    fetch_xor(mut &this, val: i64, order: MemoryOrder) -> i64 {
        const prev: u64 = atomic_xor_u64(&this.value as u64*, val as u64, MemoryOrder::to_u32(order));
        return prev as i64;
    }

    swap(mut &this, val: i64, order: MemoryOrder) -> i64 {
        const prev: u64 = atomic_swap_u64(&this.value as u64*, val as u64, MemoryOrder::to_u32(order));
        return prev as i64;
    }

    compare_exchange(mut &this, current: i64, next: i64, succ: MemoryOrder, fail: MemoryOrder) -> Result<i64, i64> {
        mut ok: boolean = false;
        const loaded: u64 = atomic_cmpxchg_u64(
            &this.value as u64*, current as u64, next as u64,
            MemoryOrder::to_u32(succ), MemoryOrder::to_u32(fail), &ok
        );
        if (ok) { return Result::Ok(loaded as i64); }
        return Result::Err(loaded as i64);
    }
}

implement trait Drop for struct AtomicI64 {
    drop(mut &this) -> void { }
}


/// Atomic boolean cell.  Backed by `u8` atomics: `false = 0`, `true = 1`.
type struct AtomicBool {
    value: boolean;

    static new(initial: boolean) -> AtomicBool {
        return AtomicBool { value: initial };
    }

    load(&this, order: MemoryOrder) -> boolean {
        const raw: u8 = atomic_load_u8(&this.value as u8*, MemoryOrder::to_u32(order));
        return raw != 0u8;
    }

    store(mut &this, val: boolean, order: MemoryOrder) -> void {
        const b: u8 = if (val) { 1u8 } else { 0u8 };
        atomic_store_u8(&this.value as u8*, b, MemoryOrder::to_u32(order));
    }

    /// AND the boolean cell with `val`.  Returns the previous value.
    fetch_and(mut &this, val: boolean, order: MemoryOrder) -> boolean {
        const b: u8 = if (val) { 1u8 } else { 0u8 };
        const prev: u8 = atomic_and_u8(&this.value as u8*, b, MemoryOrder::to_u32(order));
        return prev != 0u8;
    }

    /// OR the boolean cell with `val`.  Returns the previous value.
    fetch_or(mut &this, val: boolean, order: MemoryOrder) -> boolean {
        const b: u8 = if (val) { 1u8 } else { 0u8 };
        const prev: u8 = atomic_or_u8(&this.value as u8*, b, MemoryOrder::to_u32(order));
        return prev != 0u8;
    }

    /// XOR the boolean cell with `val`.  Returns the previous value.
    fetch_xor(mut &this, val: boolean, order: MemoryOrder) -> boolean {
        const b: u8 = if (val) { 1u8 } else { 0u8 };
        const prev: u8 = atomic_xor_u8(&this.value as u8*, b, MemoryOrder::to_u32(order));
        return prev != 0u8;
    }

    swap(mut &this, val: boolean, order: MemoryOrder) -> boolean {
        const b: u8 = if (val) { 1u8 } else { 0u8 };
        const prev: u8 = atomic_swap_u8(&this.value as u8*, b, MemoryOrder::to_u32(order));
        return prev != 0u8;
    }

    compare_exchange(mut &this, current: boolean, next: boolean, succ: MemoryOrder, fail: MemoryOrder) -> Result<boolean, boolean> {
        const cur_b: u8  = if (current) { 1u8 } else { 0u8 };
        const next_b: u8 = if (next)    { 1u8 } else { 0u8 };
        mut ok: boolean = false;
        const loaded: u8 = atomic_cmpxchg_u8(
            &this.value as u8*, cur_b, next_b,
            MemoryOrder::to_u32(succ), MemoryOrder::to_u32(fail), &ok
        );
        if (ok) { return Result::Ok(loaded != 0u8); }
        return Result::Err(loaded != 0u8);
    }
}

implement trait Drop for struct AtomicBool {
    drop(mut &this) -> void { }
}
