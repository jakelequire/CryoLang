///! std::sync::channel: multi-producer, single-consumer channels.
///!
///! `Channel::unbounded::<T>()` and `Channel::bounded::<T>(capacity)` open a
///! channel and return both of its ends together, its `Sender<T>` first.
///! Each `Sender<T>` is independently owned and movable into its own thread,
///! and is cloned for more producers. Values of any type `T` - including
///! owned data like `String` - are moved through the FIFO queue.
///!
///!   ```cryo
///!   const { first: tx, second: rx }: Pair<channel::Sender<i32>, channel::Receiver<i32>> =
///!       channel::Channel::unbounded::<i32>();
///!   // move `tx` into a worker thread; keep `rx` here
///!   const h = thread::spawn(move () -> i32 {
///!       tx.send(42);
///!       return 0;       // `tx` is released with the closure as the thread ends
///!   });
///!   match (rx.receive()) { Result::Ok(v) => { use(v); } Result::Err(_) => {} }
///!   h.join().unwrap();
///!   ```
///!
///! ## Capacity
///!
///! An unbounded channel queues every value sent. A bounded one holds at
///! most `capacity` values: `send` on a full channel blocks until the
///! receiver takes one, or returns the value in `Err(SendError)` if the
///! receiver is dropped meanwhile. `try_send` never waits: on a full
///! channel it hands the value back in `Err(TrySendError::Full)`.
///!
///! ## Iterating
///!
///! A `Receiver<T>` is an `Iterator<T>`: `for (value in rx)` takes each
///! value as it arrives and ends once every sender has dropped.
///!
///! ## Disconnection
///!
///! When every `Sender` has been dropped, a blocked `receive()` returns
///! `Err(ReceiveError::Disconnected)` and `try_receive()` returns
///! `Err(TryReceiveError::Disconnected)`. A disconnected channel stays
///! disconnected: a sender is made only with the channel or by cloning a
///! live one. When the `Receiver` is dropped, `send()` returns
///! `Err(SendError)` and `try_send()` `Err(TrySendError::Disconnected)`
///! (each handing the value back) instead of queueing into a channel no
///! one will drain.
///!
///! ## Implementation
///!
///! A heap `ChannelInner<T>` holds a `Mutex` over the channel's state - a
///! raw singly-linked node queue with its length, plus a live-sender count
///! and a total-handle refcount - a `ConditionVariable` the receiver waits on, and one
///! a sender waits on for room. The inner is reclaimed when the last handle
///! (sender or receiver) drops. Values move out of dequeued nodes through
///! raw pointers, so the move-checker treats each as a clean transfer
///! (no aliasing, no double-free).

namespace std::sync::channel;

import std::core::intrinsics;
import std::core::pointer::{ NonNull };
import std::core::result::{ Result };
import std::core::option;
import std::core::option::{ Option };
import std::core::iter::{ Iterator };
import std::core::drop::{ Drop };
import std::alloc::layout::{ Layout };
import std::alloc::allocator::{ GlobalAllocator };
import std::collections::pair::{ Pair };
import std::collections::str::{ Str };
import std::core::error::{ Error };
import std::core::mem;
import std::fmt::display::{ Debug, Display, Formatter };
import std::fmt::error::{ FormatError };
import std::sync::mutex::{ Mutex, MutexGuard };
import std::sync::condition_variable::{ ConditionVariable };
import std::time::clock::{ Instant };
import std::time::duration::{ Duration };


/// A queued value plus a raw link to the next node. Allocated per `send`,
/// freed when the value is dequeued (or when the channel is torn down).
private type struct ChannelNode<T> {
    private next:  mut ChannelNode<T>*;
    private value: T;
}

/// The queue and the handle counts, reached only through the channel's lock.
private type struct ChannelState<T> {
    private head:     mut ChannelNode<T>*;   // dequeue end (null when empty)
    private tail:     mut ChannelNode<T>*;   // enqueue end
    private length:   i64;            // values queued
    private capacity: i64;            // most values queued at once; `i64::MAX` when unbounded
    private senders:  i64;            // live Sender handles
    private refs:     i64;            // live Sender + Receiver handles
    private rx_open:  boolean;        // receiver still alive

    /// Unlink and return the oldest queued node, or null when the queue is
    /// empty.
    private pop(mut &this) -> mut ChannelNode<T>* {
        const node: mut ChannelNode<T>* = this.head;
        if (node == null) { return null; }
        this.head = (*node).next;
        if (this.head == null) { this.tail = null; }
        this.length = this.length - 1;
        return node;
    }

    /// Move `value` into the fresh `node` and queue it at the enqueue end.
    private push(mut &this, node: mut ChannelNode<T>*, value: T) -> void {
        (*node).next = null;
        // Move `value` into the node through a raw pointer so no drop is
        // synthesized on the uninitialized destination.
        const slot: mut T* = &(*node).value;
        *slot = value;
        if (this.tail == null) {
            this.head = node;
            this.tail = node;
        } else {
            (*this.tail).next = node;
            this.tail = node;
        }
        this.length = this.length + 1;
    }
}

/// Allocate an uninitialized queue node, or return null when no memory
/// could be had.
private function allocate_node<T>() -> mut ChannelNode<T>* {
    mut alloc: GlobalAllocator = GlobalAllocator::new();
    match (alloc.allocate(Layout::of::<ChannelNode<T>>())) {
        Result::Ok(raw) => { return raw.cast::<ChannelNode<T>>().as_pointer(); }
        Result::Err(_)  => { return null; }
    }
}

/// Shared channel state, reached through a raw pointer by every handle.
private type struct ChannelInner<T> {
    private state: Mutex<ChannelState<T>>;
    private ready: ConditionVariable;   // the receiver waits here for a value or the last sender
    private room:  ConditionVariable;   // a sender waits here for a full queue to shrink or the receiver to go
}


/// Allocate + initialize a fresh `ChannelInner<T>` holding at most
/// `capacity` values, with its two handles: one `Sender` and the `Receiver`.
private function new_inner<T>(capacity: i64) -> mut ChannelInner<T>* {
    mut alloc: GlobalAllocator = GlobalAllocator::new();
    mut inner: mut ChannelInner<T>* = null;
    match (alloc.allocate(Layout::of::<ChannelInner<T>>())) {
        Result::Ok(raw) => { inner = raw.cast::<ChannelInner<T>>().as_pointer(); }
        Result::Err(_)  => { core::panic("channel::Channel: allocation failed", intrinsics::location()); }
    }
    inner.state = Mutex::new(ChannelState::<T> {
        head: null, tail: null, length: 0, capacity: capacity,
        senders: 1, refs: 2, rx_open: true
    });
    inner.ready = ConditionVariable::new();
    inner.room = ConditionVariable::new();
    return inner;
}

/// Release the lock and condition variable and free the inner box. Called
/// by the last handle to drop; the queue is expected empty (the receiver
/// drains it on its way out).
private function free_inner<T>(inner: mut ChannelInner<T>*) -> void {
    pointer::drop_in_place::<ChannelInner<T>>(inner);
    mut alloc: GlobalAllocator = GlobalAllocator::new();
    alloc.deallocate(NonNull::new(inner as mut u8*), Layout::of::<ChannelInner<T>>());
}


/// Error returned by `Sender::send` when the receiver has been dropped.
/// Carries the value back so the caller does not lose it.
public type struct SendError<T> {
    public value: T;
}

/// `the receiver has been dropped`; the value it carries is not printed.
implement<T> trait Display for struct SendError<T> {
    fmt(&this, f: mut &Formatter) -> Result<(), FormatError> {
        return f.write_str(Str::new("the receiver has been dropped"));
    }
}

/// `SendError`; the value it carries is not printed.
implement<T> trait Debug for struct SendError<T> {
    fmt(&this, f: mut &Formatter) -> Result<(), FormatError> {
        return f.write_str(Str::new("SendError"));
    }
}

implement<T> trait Error for struct SendError<T> { }

/// Why `Sender::try_send` did not queue its value. Each variant carries
/// the value back so the caller does not lose it.
public type enum TrySendError<T> {
    /// The channel already holds as many values as it can, or no memory
    /// could be had for one more.
    Full(T);
    /// The receiver has been dropped.
    Disconnected(T);
}

/// `the channel is full` or `the receiver has been dropped`; the value it
/// carries is not printed.
implement<T> trait Display for enum TrySendError<T> {
    fmt(&this, f: mut &Formatter) -> Result<(), FormatError> {
        match (&this) {
            TrySendError::Full(_)         => { return f.write_str(Str::new("the channel is full")); }
            TrySendError::Disconnected(_) => { return f.write_str(Str::new("the receiver has been dropped")); }
        }
    }
}

/// `TrySendError::Full` or `TrySendError::Disconnected`; the value it
/// carries is not printed.
implement<T> trait Debug for enum TrySendError<T> {
    fmt(&this, f: mut &Formatter) -> Result<(), FormatError> {
        match (&this) {
            TrySendError::Full(_)         => { return f.write_str(Str::new("TrySendError::Full")); }
            TrySendError::Disconnected(_) => { return f.write_str(Str::new("TrySendError::Disconnected")); }
        }
    }
}

implement<T> trait Error for enum TrySendError<T> { }

/// Error returned by a blocking `Receiver::receive`.
public type enum ReceiveError with [Eq, Clone, Debug] {
    Disconnected;   // all senders dropped and the queue is empty
}

/// `every sender has been dropped`.
implement trait Display for enum ReceiveError {
    fmt(&this, f: mut &Formatter) -> Result<(), FormatError> {
        return f.write_str(Str::new("every sender has been dropped"));
    }
}

implement trait Error for enum ReceiveError { }

/// Error returned by the non-blocking `Receiver::try_receive`.
public type enum TryReceiveError with [Eq, Clone, Debug] {
    Empty;          // no value ready, but senders remain
    Disconnected;   // all senders dropped and the queue is empty
}

/// `no value is ready` or `every sender has been dropped`.
implement trait Display for enum TryReceiveError {
    fmt(&this, f: mut &Formatter) -> Result<(), FormatError> {
        match (&this) {
            TryReceiveError::Empty        => { return f.write_str(Str::new("no value is ready")); }
            TryReceiveError::Disconnected => { return f.write_str(Str::new("every sender has been dropped")); }
        }
    }
}

implement trait Error for enum TryReceiveError { }

/// Why `Receiver::receive_timeout` returned no value.
public type enum ReceiveTimeoutError with [Eq, Clone, Debug] {
    /// The time ran out with no value sent and a sender still alive.
    Timeout;
    /// Every sender has dropped and the queue is empty.
    Disconnected;
}

/// `the time ran out` or `every sender has been dropped`.
implement trait Display for enum ReceiveTimeoutError {
    fmt(&this, f: mut &Formatter) -> Result<(), FormatError> {
        match (&this) {
            ReceiveTimeoutError::Timeout      => { return f.write_str(Str::new("the time ran out")); }
            ReceiveTimeoutError::Disconnected => { return f.write_str(Str::new("every sender has been dropped")); }
        }
    }
}

implement trait Error for enum ReceiveTimeoutError { }

/// The sending half of a channel. Cloneable for multiple producers.
public type struct Sender<T> {
    private inner: mut ChannelInner<T>*;

    /// Enqueue `value`, first waiting for room when a bounded channel is
    /// full. Returns `Err(SendError{value})` if the receiver has been
    /// dropped (the value is handed back unconsumed).
    public send(&this, value: T) -> Result<(), SendError<T>> {
        const inner: ChannelInner<T>* = this.inner;
        mut held: MutexGuard<ChannelState<T>, GlobalAllocator> = inner.state.lock();
        const state: mut ChannelState<T>* = held.as_mutable_pointer();
        while (state.rx_open && state.length >= state.capacity) {
            inner.room.wait(&inner.state, &held);
        }
        if (!state.rx_open) {
            return Result::Err(SendError::<T> { value: value });
        }
        const node: mut ChannelNode<T>* = allocate_node::<T>();
        if (node == null) {
            return Result::Err(SendError::<T> { value: value });
        }
        state.push(node, value);
        // Wake one blocked receiver (there is at most one).
        inner.ready.notify_one();
        mem::drop(held);
        return Result::Ok(());
    }

    /// Enqueue `value` without waiting. Returns `Err(Full(value))` when a
    /// bounded channel already holds its capacity (or no memory could be
    /// had for the value), `Err(Disconnected(value))` when the receiver has
    /// been dropped; either hands the value back unconsumed.
    public try_send(&this, value: T) -> Result<(), TrySendError<T>> {
        const inner: ChannelInner<T>* = this.inner;
        mut held: MutexGuard<ChannelState<T>, GlobalAllocator> = inner.state.lock();
        const state: mut ChannelState<T>* = held.as_mutable_pointer();
        if (!state.rx_open) {
            return Result::Err(TrySendError::Disconnected(value));
        }
        if (state.length >= state.capacity) {
            return Result::Err(TrySendError::Full(value));
        }
        const node: mut ChannelNode<T>* = allocate_node::<T>();
        if (node == null) {
            return Result::Err(TrySendError::Full(value));
        }
        state.push(node, value);
        inner.ready.notify_one();
        mem::drop(held);
        return Result::Ok(());
    }

    /// Create another sender on the same channel (multi-producer).
    public clone(&this) -> Sender<T> {
        const inner: mut ChannelInner<T>* = this.inner;
        mut held: MutexGuard<ChannelState<T>, GlobalAllocator> = inner.state.lock();
        const state: mut ChannelState<T>* = held.as_mutable_pointer();
        state.senders = state.senders + 1;
        state.refs    = state.refs + 1;
        mem::drop(held);
        return Sender::<T> { inner: inner };
    }

    /// Explicitly drop this sender now (rather than at scope end). Useful
    /// after moving a sender into a thread body, where the value must be
    /// released before the body returns.
    public close(mut this) -> void {
        const { inner }: Sender<T> = this;
        release_sender::<T>(inner);
    }
}

/// Decrement the sender/handle counts; wake the receiver if this was the
/// last sender (so a blocked `receive` observes disconnection); free the
/// inner if this was the last handle of any kind.
private function release_sender<T>(inner: mut ChannelInner<T>*) -> void {
    mut held: MutexGuard<ChannelState<T>, GlobalAllocator> = inner.state.lock();
    const state: mut ChannelState<T>* = held.as_mutable_pointer();
    state.senders = state.senders - 1;
    if (state.senders == 0) {
        inner.ready.notify_all();
    }
    state.refs = state.refs - 1;
    const last: boolean = state.refs == 0;
    mem::drop(held);
    if (last) { free_inner::<T>(inner); }
}

implement<T> trait Drop for struct Sender<T> {
    drop(mut &this) -> void {
        if (this.inner == null) { return; }
        release_sender::<T>(this.inner);
        this.inner = null;
    }
}


/// The receiving half of a channel. Not cloneable (single consumer).
public type struct Receiver<T> {
    private inner: mut ChannelInner<T>*;

    /// Block until a value is available and return it, or return
    /// `Err(Disconnected)` once every sender has dropped and the queue is
    /// drained.
    public receive(&this) -> Result<T, ReceiveError> {
        const inner: ChannelInner<T>* = this.inner;
        mut held: MutexGuard<ChannelState<T>, GlobalAllocator> = inner.state.lock();
        const state: mut ChannelState<T>* = held.as_mutable_pointer();
        while (state.head == null && state.senders > 0) {
            inner.ready.wait(&inner.state, &held);
        }
        const node: mut ChannelNode<T>* = state.pop();
        // A value taken is room made: wake a sender waiting on a full queue.
        if (node != null) { inner.room.notify_one(); }
        mem::drop(held);
        if (node == null) {
            // No value and no senders left.
            return Result::Err(ReceiveError::Disconnected);
        }
        // Move the value out of the node, then free the node without running
        // the slot's destructor, so the value is owned exactly once.
        const slot: T* = &(*node).value;
        mut value: T;
        unsafe { value = *slot; }
        mut alloc: GlobalAllocator = GlobalAllocator::new();
        alloc.deallocate(NonNull::new(node as mut u8*), Layout::of::<ChannelNode<T>>());
        return Result::Ok(value);
    }

    /// Wait no longer than `duration` for a value and return it.
    /// `Err(Timeout)` when the time runs out first, `Err(Disconnected)`
    /// once every sender has dropped and the queue is drained.
    public receive_timeout(&this, duration: Duration) -> Result<T, ReceiveTimeoutError> {
        const deadline: Instant = Instant::now().saturating_add(&duration);
        const inner: ChannelInner<T>* = this.inner;
        mut held: MutexGuard<ChannelState<T>, GlobalAllocator> = inner.state.lock();
        const state: mut ChannelState<T>* = held.as_mutable_pointer();
        while (state.head == null && state.senders > 0) {
            const remaining: Duration = deadline.saturating_duration_since(&Instant::now());
            if (remaining.is_zero()) {
                return Result::Err(ReceiveTimeoutError::Timeout);
            }
            inner.ready.wait_timeout(&inner.state, &held, remaining);
        }
        const node: mut ChannelNode<T>* = state.pop();
        if (node != null) { inner.room.notify_one(); }
        mem::drop(held);
        if (node == null) {
            return Result::Err(ReceiveTimeoutError::Disconnected);
        }
        // Moved out and released as in `receive`.
        const slot: T* = &(*node).value;
        mut value: T;
        unsafe { value = *slot; }
        mut alloc: GlobalAllocator = GlobalAllocator::new();
        alloc.deallocate(NonNull::new(node as mut u8*), Layout::of::<ChannelNode<T>>());
        return Result::Ok(value);
    }

    /// Non-blocking receive. Returns `Err(Empty)` if no value is ready but
    /// senders remain, `Err(Disconnected)` if the channel is drained and
    /// all senders have dropped.
    public try_receive(&this) -> Result<T, TryReceiveError> {
        const inner: ChannelInner<T>* = this.inner;
        mut held: MutexGuard<ChannelState<T>, GlobalAllocator> = inner.state.lock();
        const state: mut ChannelState<T>* = held.as_mutable_pointer();
        const node: mut ChannelNode<T>* = state.pop();
        if (node == null) {
            if (state.senders == 0) { return Result::Err(TryReceiveError::Disconnected); }
            return Result::Err(TryReceiveError::Empty);
        }
        inner.room.notify_one();
        mem::drop(held);
        // Same balance as `receive`: the node is released without running the
        // slot's destructor, so the value is owned exactly once.
        const slot: T* = &(*node).value;
        mut value: T;
        unsafe { value = *slot; }
        mut alloc: GlobalAllocator = GlobalAllocator::new();
        alloc.deallocate(NonNull::new(node as mut u8*), Layout::of::<ChannelNode<T>>());
        return Result::Ok(value);
    }
}

implement<T> trait Drop for struct Receiver<T> {
    drop(mut &this) -> void {
        if (this.inner == null) { return; }
        const inner: mut ChannelInner<T>* = this.inner;
        mut held: MutexGuard<ChannelState<T>, GlobalAllocator> = inner.state.lock();
        const state: mut ChannelState<T>* = held.as_mutable_pointer();
        state.rx_open = false;
        // Drain and drop any values still queued: with the receiver gone
        // they would otherwise leak.
        mut node: mut ChannelNode<T>* = state.pop();
        while (node != null) {
            const slot: T* = &(*node).value;
            pointer::drop_in_place::<T>(slot);
            mut a: GlobalAllocator = GlobalAllocator::new();
            a.deallocate(NonNull::new(node as mut u8*), Layout::of::<ChannelNode<T>>());
            node = state.pop();
        }
        // A sender waiting for room would wait for ever: wake every one, to
        // find the receiver gone.
        inner.room.notify_all();
        state.refs = state.refs - 1;
        const last: boolean = state.refs == 0;
        mem::drop(held);
        if (last) { free_inner::<T>(inner); }
        this.inner = null;
    }
}

/// A receiver iterates the values sent, in order, waiting for each as
/// `receive` does; the iteration ends once every sender has dropped and
/// the queue is drained. `for (value in receiver)` takes the receiver.
implement<T> trait Iterator<T> for struct Receiver<T> {
    next(mut &this) -> Option<T> {
        match (this.receive()) {
            Result::Ok(value) => { return Option::Some(value); }
            Result::Err(_)    => { return Option::None; }
        }
    }
}


/// Opens channels. A channel's two ends come out together, its `Sender<T>`
/// first; more senders are clones of that one:
///
///   ```cryo
///   const { first: tx, second: rx }: Pair<channel::Sender<i32>, channel::Receiver<i32>> =
///       channel::Channel::unbounded::<i32>();
///   thread::spawn(move () -> i32 { tx.send(1); return 0; });
///   match (rx.receive()) { Result::Ok(v) => {} Result::Err(_) => {} }
///   ```
///
/// Panics only on allocation / lock-initialization failure.
public type struct Channel {
    /// A channel that queues every value sent.
    public static unbounded<T>() -> Pair<Sender<T>, Receiver<T>> {
        return Channel::open::<T>(i64::MAX);
    }

    /// A channel holding at most `capacity` values: `send` on a full one
    /// waits for the receiver to take a value. Panics when `capacity` is
    /// less than 1.
    public static bounded<T>(capacity: i64) -> Pair<Sender<T>, Receiver<T>> {
        if (capacity < 1) {
            core::panic("channel::Channel::bounded: the capacity must be at least 1", intrinsics::location());
        }
        return Channel::open::<T>(capacity);
    }

    private static open<T>(capacity: i64) -> Pair<Sender<T>, Receiver<T>> {
        const inner: mut ChannelInner<T>* = new_inner::<T>(capacity);
        return Pair::<Sender<T>, Receiver<T>> {
            first: Sender::<T> { inner: inner }, second: Receiver::<T> { inner: inner }
        };
    }
}
