///! std::sync: synchronization primitives for concurrent code.
///!
///! Foundation:
///!   - `atomic`  : `MemoryOrder` + per-type `AtomicU8/U32/U64/I32/I64/Bool`
///!                 cells with `load`, `store`, `fetch_*`, `swap`,
///!                 `compare_exchange`.  Lowers to LLVM atomic IR with
///!                 no libc / runtime calls.  Named `MemoryOrder`
///!                 rather than `Ordering` to avoid clashing with
///!                 `std::core::cmp::Ordering`.
///!
///! Lock primitives (POSIX-backed; heap-pinned for address stability):
///!   - `error`   : `SyncError { kind, os_code }`, `SyncErrorKind`
///!                 (`WouldBlock`, `Timeout`, `OutOfResources`,
///!                 `InvalidState`, `Unsupported`, `Poisoned`, `Other`)
///!   - `mutex`   : `Mutex<T, A>`, `MutexGuard<T, A>` (RAII unlock).
///!                 `MutexGuard` is `!Send` by deny-list (the locking
///!                 thread must unlock).
///!   - `rwlock`  : `RwLock<T, A>`, `RwLockReadGuard<T, A>`,
///!                 `RwLockWriteGuard<T, A>`.  Both guards `!Send`.
///!   - `condvar` : `CondVar` with `wait(mutex, guard)`,
///!                 `notify_one`, `notify_all`.
///!   - `once`    : `Once::call_once(f)` (one-shot initialization).
///!   - `barrier` : `Barrier::new(count)`, `wait() -> BarrierWaitResult`
///!                 (one thread per cycle gets `is_leader == true`).
///!
///! `Arc<T, A>` (atomic reference counting) lives in `std::alloc::arc`
///! rather than here, mirroring `std::alloc::rc`.
///!
///! Deferred for v1.x follow-ups: `OnceCell<T>` (lazy initialization
///! of a value), `Lazy<T>` (sugar over `OnceCell`).  Use `Once` plus a
///! mutable global today.

namespace std::sync;

public module sync::atomic;
public module sync::error;
public module sync::mutex;
public module sync::rwlock;
public module sync::condvar;
public module sync::once;
public module sync::barrier;
public module sync::mpsc;
