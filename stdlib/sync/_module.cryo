///! std::sync: synchronization primitives for concurrent code.
///!
///! Foundation:
///!   - `atomic` : `MemoryOrder` + per-type `AtomicU8/U32/U64/I32/I64/Bool`
///!                cells with `load`, `store`, `fetch_*`, `swap`,
///!                `compare_exchange`.  Lowers to LLVM atomic IR with
///!                no libc / runtime calls.  Named `MemoryOrder` rather
///!                than `Ordering` to avoid clashing with
///!                `std::core::cmp::Ordering`.
///!
///! Sync types built atop `atomic` (lock primitives, `Once`, `Barrier`,
///! `Arc`) land in follow-on commits in this directory; until then,
///! the surface is the atomics layer alone.

namespace std::sync;

public module sync::atomic;
