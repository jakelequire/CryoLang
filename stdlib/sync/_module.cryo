///! std::sync: synchronization primitives for concurrent code.
///!
///! Foundation:
///!   - `atomic`  : `MemoryOrder` + a generic `Atomic<T>` cell
///!                 (T = u8/u32/u64/i32/i64/boolean) with `load`, `store`,
///!                 `fetch_*`, `swap`,
///!                 `compare_exchange`.  Lowers to LLVM atomic IR with
///!                 no libc / runtime calls.  Named `MemoryOrder`
///!                 rather than `Ordering` to avoid clashing with
///!                 `std::core::cmp::Ordering`.
///!
///! Lock primitives (POSIX-backed; heap-pinned for address stability):
///!   - `mutex`   : `Mutex<T, A>`, `MutexGuard<T, A>` (RAII unlock).
///!                 `MutexGuard` is `!Send` by deny-list (the locking
///!                 thread must unlock).
///!   - `read_write_lock` : `ReadWriteLock<T, A>`, `ReadWriteLockReadGuard<T, A>`,
///!                 `ReadWriteLockWriteGuard<T, A>`.  Both guards `!Send`.
///!   - `condition_variable` : `ConditionVariable` with `wait(mutex, guard)`,
///!                 `notify_one`, `notify_all`.
///!   - `once`    : `Once::call_once(f)` (one-shot initialization).
///!   - `barrier` : `Barrier::new(count)`, `wait() -> BarrierWaitResult`
///!                 (one thread per cycle gets `is_leader == true`).
///!
///! Error handling: blocking acquisition (`Mutex::lock`, `ReadWriteLock::read` /
///! `write`) returns the guard directly and panics only on a `pthread`
///! programmer error (`EINVAL` / `EDEADLK` from a destroyed or
///! recursively-locked lock) - an unrecoverable bug, not a runtime
///! condition. Use `try_lock` / `try_read` / `try_write` for the
///! non-blocking, non-panicking path.
///!
///! There is **no lock poisoning**. Under the unwinding strategy a thread
///! that panics while holding a guard releases the lock as it unwinds, and
///! the next thread to lock it gets the value as the panicking thread left
///! it, with whatever it changed before the panic. Under `--panic=abort` the
///! panic ends the process, so no thread is left to see the lock. A value
///! whose invariant a panic could leave half-done keeps its own record of
///! that (a flag set before the change and cleared after it).
///!
///! `Arc<T, A>` (atomic reference counting) lives in `std::alloc::arc`
///! rather than here, mirroring `std::alloc::rc`.
///!
///! Deferred for v1.x follow-ups: `OnceCell<T>` (lazy initialization
///! of a value), `Lazy<T>` (sugar over `OnceCell`).  Use `Once` plus a
///! mutable global today.
///!
///!     import std::sync::{ Atomic, MemoryOrder, Mutex };

namespace std::sync;

module {
    sync::atomic;
    sync::mutex;
    sync::read_write_lock;
    sync::condition_variable;
    sync::once;
    sync::barrier;
    sync::channel;
}

export std::sync::atomic::{ Atomic, MemoryOrder };
export std::sync::mutex::{ Mutex, MutexGuard };
export std::sync::read_write_lock::{ ReadWriteLock, ReadWriteLockReadGuard, ReadWriteLockWriteGuard };
export std::sync::condition_variable::{ ConditionVariable };
export std::sync::once::{ Once };
export std::sync::barrier::{ Barrier, BarrierWaitResult };
export std::sync::channel::{ Channel, ReceiveError, ReceiveTimeoutError, Receiver, SendError, Sender,
                             TryReceiveError, TrySendError };
