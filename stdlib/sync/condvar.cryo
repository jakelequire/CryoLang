///! CondVar: condition variable for blocking until a predicate holds.
///!
///! A `CondVar` is the synchronization primitive that lets a thread
///! atomically release a `Mutex<T>` and sleep until another thread
///! signals.  It is the standard producer/consumer primitive.
///!
///! Usage pattern:
///! ```cryo
///! // shared: Arc<Mutex<Queue>>, cond: Arc<CondVar>
///! mut guard: MutexGuard<Queue, GlobalAlloc> = shared.lock();
///! while (guard.as_ptr().is_empty()) {
///!     cond.wait(&shared, &mut guard);
///! }
///! // ... act on the queue ...
///! ```
///!
///! `wait()` atomically releases the lock, sleeps until another
///! thread calls `notify_one()` or `notify_all()`, then reacquires
///! the lock before returning.  The guard remains "locked" from the
///! caller's perspective - pthread does the unlock/relock internally.
///!
///! Cryo's lack of borrow-checker means the caller must take care
///! not to use the guarded value while inside `wait()`; doing so
///! reads through the guard while another thread holds the lock.
///!
///! `CondVar` is `Send + Sync` unconditionally (pthread condition
///! variables are designed for cross-thread use).

namespace std::sync::condvar;

import std::core::intrinsics;
import std::core::ptr::{ NonNull };
import std::core::result::{ Result };
import std::core::drop::{ Drop };
import std::alloc::layout::{ Layout };
import std::alloc::allocator::{ AllocError, AllocErrorKind, GlobalAlloc };
import std::core::option::{ Option };
import std::ffi::libc::{
    ClockId, ETIMEDOUT, clock_gettime, pthread_cond_broadcast, pthread_cond_destroy, pthread_cond_init,
    pthread_cond_signal, pthread_cond_timedwait, pthread_cond_wait, timespec
};
import std::time::duration::{ Duration };
import std::sys::syscall;
import std::sync::mutex::{ Mutex, MutexGuard };


// Per-OS condition-variable primitive.  pthread_cond_t (48 bytes on Linux
// x86_64) vs Win32 CONDITION_VARIABLE (8 bytes) both fit; a zero buffer is
// the valid init state for both.  The OS divergence lives in gated free
// functions (ConfigGating never sees method bodies) and the methods delegate.
//
// `wait` pairs the condvar with the Mutex's lock buffer.  On Windows that
// buffer holds the mutex's SRWLOCK, so the wait uses SleepConditionVariableSRW
// with Flags=0 (the mutex acquires it exclusively).
// Return convention follows pthread (0 == success).

![target(unix)]
private function cond_init_raw(buf: mut u8*) -> i32 { return pthread_cond_init(buf, null); }
![target(windows)]
private function cond_init_raw(buf: mut u8*) -> i32 { syscall::InitializeConditionVariable(buf); return 0; }

![target(unix)]
private function cond_wait_raw(cond: mut u8*, mtx: mut u8*) -> i32 { return pthread_cond_wait(cond, mtx); }
![target(windows)]
private function cond_wait_raw(cond: mut u8*, mtx: mut u8*) -> i32 {
    if (syscall::SleepConditionVariableSRW(cond, mtx, syscall::INFINITE, 0) != 0) { return 0; }
    return 1;
}

/// Wait on `cond` for no longer than `duration`: `Some(true)` when the
/// time ran out, `Some(false)` when woken, `None` when the wait failed. A
/// duration too long for the clock to state waits as long as it can.
![target(unix)]
private function cond_wait_timeout_raw(cond: mut u8*, mtx: mut u8*, duration: &Duration) -> Option<boolean> {
    mut deadline: timespec = timespec { tv_sec: 0, tv_nsec: 0 };
    clock_gettime(ClockId::CLOCK_REALTIME, &deadline);
    mut seconds: i64 = LONGEST_WAIT_SECONDS;
    match (i64::try_from(duration.as_secs())) {
        Result::Ok(whole) => { if (whole < seconds) { seconds = whole; } }
        Result::Err(_) => { }
    }
    deadline.tv_sec += seconds;
    deadline.tv_nsec += duration.subsec_nanos();
    if (deadline.tv_nsec >= 1000000000) {
        deadline.tv_sec += 1;
        deadline.tv_nsec -= 1000000000;
    }
    const status: i32 = pthread_cond_timedwait(cond, mtx, &deadline);
    if (status == 0) { return Option::Some(false); }
    if (status == ETIMEDOUT) { return Option::Some(true); }
    return Option::None;
}
![target(windows)]
private function cond_wait_timeout_raw(cond: mut u8*, mtx: mut u8*, duration: &Duration) -> Option<boolean> {
    // INFINITE would never time out, so the longest finite wait is one less.
    mut milliseconds: u32 = syscall::INFINITE - 1;
    match (u32::try_from(duration.as_millis_ceil())) {
        Result::Ok(whole) => { if (whole < milliseconds) { milliseconds = whole; } }
        Result::Err(_) => { }
    }
    if (syscall::SleepConditionVariableSRW(cond, mtx, milliseconds, 0) != 0) { return Option::Some(false); }
    if (syscall::GetLastError() == syscall::ERROR_TIMEOUT) { return Option::Some(true); }
    return Option::None;
}

/// The longest wait `cond_wait_timeout_raw` states as a deadline: about
/// 34,000 years, far inside what `tv_sec` holds from any present time.
![target(unix)]
private const LONGEST_WAIT_SECONDS: i64 = 1099511627776;

![target(unix)]
private function cond_signal_raw(buf: mut u8*) -> void { pthread_cond_signal(buf); }
![target(windows)]
private function cond_signal_raw(buf: mut u8*) -> void { syscall::WakeConditionVariable(buf); }

![target(unix)]
private function cond_broadcast_raw(buf: mut u8*) -> void { pthread_cond_broadcast(buf); }
![target(windows)]
private function cond_broadcast_raw(buf: mut u8*) -> void { syscall::WakeAllConditionVariable(buf); }

![target(unix)]
private function cond_destroy_raw(buf: mut u8*) -> void { pthread_cond_destroy(buf); }
![target(windows)]
private function cond_destroy_raw(buf: mut u8*) -> void { }


// 48-byte opaque pthread_cond_t buffer, heap-pinned for address
// stability (pthread cond variables, like mutexes, must not move
// after init).
private type struct CondVarInner {
    private pthread_buf: [u8; 48];
}


/// A condition variable: lets a thread holding a `Mutex` give up the lock
/// and sleep until another thread calls `notify_one` or `notify_all`. A
/// `pthread_cond_t` on unix; on Windows a `CONDITION_VARIABLE` waited on
/// with the mutex's SRW lock. Wakes can be spurious, so wait in a loop that
/// re-checks the condition. Use it with only one `Mutex`.
public type struct CondVar {
    private inner: mut CondVarInner*;

    /// Construct a fresh condition variable with default attributes.
    /// Panics on allocation failure or pthread init failure.
    public static new() -> CondVar {
        match (CondVar::try_new()) {
            Result::Ok(c)  => { return c; }
            Result::Err(_) => {
                core::panic("CondVar::new: allocation failed", intrinsics::location());
            }
        }
    }

    /// Construct a condition variable, or `Err` when it cannot be made:
    /// an `OutOfMemory` `AllocError` both when its storage cannot be
    /// allocated and when `pthread_cond_init` fails (unix; the Windows
    /// initialisation cannot fail).
    public static try_new() -> Result<CondVar, AllocError> {
        mut alloc: GlobalAlloc = GlobalAlloc::new();
        const header: Layout = Layout::of::<CondVarInner>();
        const raw: NonNull<u8> = alloc.allocate(header)?;
        const typed: NonNull<CondVarInner> = raw.cast::<CondVarInner>();
        const inner_ptr: mut CondVarInner* = typed.as_ptr();
        const buf_ptr: mut u8* = &inner_ptr.pthread_buf[0];
        const rc: i32 = cond_init_raw(buf_ptr);
        if (rc != 0) {
            alloc.deallocate(raw, header);
            return Result::Err(AllocError::new(AllocErrorKind::OutOfMemory, header));
        }
        return Result::Ok(CondVar { inner: inner_ptr });
    }

    /// Block the current thread until another thread signals this
    /// condition variable.  Atomically releases `mutex`, waits, and
    /// reacquires `mutex` before returning.  `guard` is not invalidated
    /// - its address still refers to the same `MutexInner` - but
    /// inspect the guarded value only after `wait` returns.
    ///
    /// The `guard` argument is taken by `mut &` to model the
    /// "borrow continues across the call" semantics; the guard is
    /// unchanged at the Cryo level (pthread internally unlocks /
    /// relocks the underlying buffer).
    public wait<T, A>(&this, mutex: &Mutex<T, A>, guard: mut &MutexGuard<T, A>) -> void {
        const cond_buf:  mut u8* = &this.inner.pthread_buf[0];
        const mutex_buf: mut u8* = mutex.raw_pthread_buf();
        const rc: i32 = cond_wait_raw(cond_buf, mutex_buf);
        if (rc != 0) {
            core::panic("CondVar::wait: cond_wait_raw failed", intrinsics::location());
        }
    }

    /// Wait as `wait` does, but for no longer than `duration`. Answers
    /// true when the wait ended because `duration` passed, false when the
    /// thread was woken. A wake can be spurious, as for `wait`, so check
    /// the condition waited for either way.
    public wait_timeout<T, A>(&this, mutex: &Mutex<T, A>, guard: mut &MutexGuard<T, A>, duration: Duration) -> boolean {
        const cond_buf:  mut u8* = &this.inner.pthread_buf[0];
        const mutex_buf: mut u8* = mutex.raw_pthread_buf();
        match (cond_wait_timeout_raw(cond_buf, mutex_buf, &duration)) {
            Option::Some(timed_out) => { return timed_out; }
            Option::None => {
                core::panic("CondVar::wait_timeout: the wait failed", intrinsics::location());
            }
        }
    }

    /// Wake up one thread waiting on this condition variable.  If no
    /// thread is currently waiting, the signal is lost (this is the
    /// standard pthread semantics; the producer should arrange for
    /// the consumer to check the predicate before sleeping).
    public notify_one(&this) -> void {
        const buf_ptr: mut u8* = &this.inner.pthread_buf[0];
        cond_signal_raw(buf_ptr);
    }

    /// Wake up every thread currently waiting on this condition
    /// variable.  Spurious wake-ups are possible regardless; the
    /// consumer must re-check the predicate after waking.
    public notify_all(&this) -> void {
        const buf_ptr: mut u8* = &this.inner.pthread_buf[0];
        cond_broadcast_raw(buf_ptr);
    }
}

implement trait Drop for struct CondVar {
    drop(mut &this) -> void {
        if (this.inner == null) { return; }
        const inner_ptr: mut CondVarInner* = this.inner;
        const buf_ptr: mut u8* = &inner_ptr.pthread_buf[0];
        cond_destroy_raw(buf_ptr);
        mut alloc: GlobalAlloc = GlobalAlloc::new();
        const header: Layout = Layout::of::<CondVarInner>();
        alloc.deallocate(NonNull::new(this.inner as mut u8*), header);
        this.inner = null;
    }
}
