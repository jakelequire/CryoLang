///! std::sync::mpsc: multi-producer, single-consumer channels.
///!
///! `channel<T>()` returns the owning `Receiver<T>`; mint producers with
///! `rx.sender()` (each `Sender<T>` is independently owned and movable
///! into its own thread, and is cloneable for further multi-producer
///! fan-out). Values of any type `T` - including owned data like
///! `String` - are moved through the unbounded FIFO queue.
///!
///!   ```cryo
///!   mut rx: mpsc::Receiver<i32> = mpsc::channel<i32>();
///!   const tx: mpsc::Sender<i32> = rx.sender();
///!   // move `tx` into a worker thread; keep `rx` here
///!   const h = thread::spawn<mpsc::Sender<i32>, i32>(tx, (s: mpsc::Sender<i32>) -> i32 {
///!       mut snd: mpsc::Sender<i32> = s;
///!       snd.send(42);
///!       snd.close();    // explicit drop of the moved-in sender
///!       return 0;
///!   });
///!   match (rx.recv()) { Result::Ok(v) => { use(v); } Result::Err(_) => {} }
///!   h.join();
///!   ```
///!
///! ## Disconnection
///!
///! When every `Sender` has been dropped, a blocked `recv()` returns
///! `Err(RecvError::Disconnected)` and `try_recv()` returns
///! `Err(TryRecvError::Disconnected)`. When the `Receiver` is dropped,
///! `send()` returns `Err(SendError)` (handing the value back) instead of
///! queueing into a channel no one will drain.
///!
///! ## Implementation
///!
///! A heap `ChannelInner<T>` holds a `Mutex` over the channel's state - a
///! raw singly-linked node queue plus a live-sender count and a
///! total-handle refcount - and a `CondVar` the receiver waits on. The inner is reclaimed when the last handle
///! (sender or receiver) drops. Values move out of dequeued nodes through
///! raw pointers, so the move-checker treats each as a clean transfer
///! (no aliasing, no double-free).

namespace std::sync::mpsc;

import std::core::intrinsics;
import std::core::ptr::{ NonNull };
import std::core::result::{ Result };
import std::core::option;
import std::core::drop::{ Drop };
import std::alloc::layout::{ Layout };
import std::alloc::allocator::{ GlobalAlloc };
import std::core::mem;
import std::sync::mutex::{ Mutex, MutexGuard };
import std::sync::condvar::{ CondVar };


/// A queued value plus a raw link to the next node. Allocated per `send`,
/// freed when the value is dequeued (or when the channel is torn down).
private type struct ChanNode<T> {
    private next:  ChanNode<T>*;
    private value: T;
}

/// The queue and the handle counts, reached only through the channel's lock.
private type struct ChannelState<T> {
    private head:    ChanNode<T>*;   // dequeue end (null when empty)
    private tail:    ChanNode<T>*;   // enqueue end
    private senders: i64;            // live Sender handles
    private refs:    i64;            // live Sender + Receiver handles
    private rx_open: boolean;        // receiver still alive

    /// Unlink and return the oldest queued node, or null when the queue is
    /// empty.
    private pop(mut &this) -> ChanNode<T>* {
        const node: ChanNode<T>* = this.head;
        if (node == null) { return null; }
        this.head = (*node).next;
        if (this.head == null) { this.tail = null; }
        return node;
    }
}

/// Shared channel state, reached through a raw pointer by every handle.
private type struct ChannelInner<T> {
    private state: Mutex<ChannelState<T>>;
    private ready: CondVar;   // the receiver waits here for a value or the last sender
}


/// Allocate + initialize a fresh `ChannelInner<T>` owned solely by the
/// receiver `channel` returns (no senders yet; one live handle).
private function new_inner<T>() -> ChannelInner<T>* {
    mut alloc: GlobalAlloc = GlobalAlloc::new();
    mut inner: ChannelInner<T>* = null;
    match (alloc.allocate(Layout::of::<ChannelInner<T>>())) {
        Result::Ok(raw) => { inner = raw.cast::<ChannelInner<T>>().as_ptr(); }
        Result::Err(_)  => { core::panic("mpsc::channel: allocation failed", intrinsics::location()); }
    }
    inner.state = Mutex::new(ChannelState::<T> {
        head: null, tail: null, senders: 0, refs: 1, rx_open: true   // one handle: the Receiver
    });
    inner.ready = CondVar::new();
    return inner;
}

/// Release the lock and condition variable and free the inner box. Called
/// by the last handle to drop; the queue is expected empty (the receiver
/// drains it on its way out).
private function free_inner<T>(inner: ChannelInner<T>*) -> void {
    ptr::drop_in_place::<ChannelInner<T>>(inner);
    mut alloc: GlobalAlloc = GlobalAlloc::new();
    alloc.deallocate(NonNull::new(inner as u8*), Layout::of::<ChannelInner<T>>());
}


/// Error returned by `Sender::send` when the receiver has been dropped.
/// Carries the value back so the caller does not lose it.
public type struct SendError<T> {
    public value: T;
}

/// Error returned by a blocking `Receiver::recv`.
public type enum RecvError {
    Disconnected;   // all senders dropped and the queue is empty
}

/// Error returned by the non-blocking `Receiver::try_recv`.
public type enum TryRecvError {
    Empty;          // no value ready, but senders remain
    Disconnected;   // all senders dropped and the queue is empty
}


/// The sending half of a channel. Cloneable for multiple producers.
public type struct Sender<T> {
    private inner: ChannelInner<T>*;

    /// Enqueue `value`. Returns `Err(SendError{value})` if the receiver
    /// has already been dropped (the value is handed back unconsumed).
    public send(&this, value: T) -> Result<(), SendError<T>> {
        const inner: ChannelInner<T>* = this.inner;
        const held: MutexGuard<ChannelState<T>, GlobalAlloc> = inner.state.lock();
        const state: ChannelState<T>* = held.as_ptr();
        if (!state.rx_open) {
            return Result::Err(SendError::<T> { value: value });
        }
        mut node: ChanNode<T>* = null;
        mut alloc: GlobalAlloc = GlobalAlloc::new();
        match (alloc.allocate(Layout::of::<ChanNode<T>>())) {
            Result::Ok(raw) => { node = raw.cast::<ChanNode<T>>().as_ptr(); }
            Result::Err(_)  => {
                return Result::Err(SendError::<T> { value: value });
            }
        }
        (*node).next = null;
        // Move `value` into the node through a raw pointer so no drop is
        // synthesized on the uninitialized destination.
        const slot: T* = &(*node).value;
        *slot = value;
        if (state.tail == null) {
            state.head = node;
            state.tail = node;
        } else {
            (*state.tail).next = node;
            state.tail = node;
        }
        // Wake one blocked receiver (there is at most one).
        inner.ready.notify_one();
        mem::drop(held);
        return Result::Ok(());
    }

    /// Create another sender on the same channel (multi-producer).
    public clone(&this) -> Sender<T> {
        const inner: ChannelInner<T>* = this.inner;
        const held: MutexGuard<ChannelState<T>, GlobalAlloc> = inner.state.lock();
        const state: ChannelState<T>* = held.as_ptr();
        state.senders = state.senders + 1;
        state.refs    = state.refs + 1;
        mem::drop(held);
        return Sender::<T> { inner: inner };
    }

    /// Explicitly drop this sender now (rather than at scope end). Useful
    /// after moving a sender into a thread body, where the value must be
    /// released before the body returns.
    public close(mut this) -> void {
        const { inner }: Sender<T> = this;
        release_sender::<T>(inner);
    }
}

/// Decrement the sender/handle counts; wake the receiver if this was the
/// last sender (so a blocked `recv` observes disconnection); free the
/// inner if this was the last handle of any kind.
private function release_sender<T>(inner: ChannelInner<T>*) -> void {
    const held: MutexGuard<ChannelState<T>, GlobalAlloc> = inner.state.lock();
    const state: ChannelState<T>* = held.as_ptr();
    state.senders = state.senders - 1;
    if (state.senders == 0) {
        inner.ready.notify_all();
    }
    state.refs = state.refs - 1;
    const last: boolean = state.refs == 0;
    mem::drop(held);
    if (last) { free_inner::<T>(inner); }
}

implement<T> trait Drop for struct Sender<T> {
    drop(mut &this) -> void {
        if (this.inner == null) { return; }
        release_sender::<T>(this.inner);
        this.inner = null;
    }
}


/// The receiving half of a channel, and the channel's owner. Not
/// cloneable (single consumer); mint producers with `sender()`.
public type struct Receiver<T> {
    private inner: ChannelInner<T>*;

    /// Create a new `Sender<T>` feeding this channel. Call once per
    /// producer (each returned sender is independently owned and may be
    /// moved into its own thread); clone an existing sender as an
    /// alternative. The channel stays open for `recv` as long as any
    /// sender is alive.
    public sender(&this) -> Sender<T> {
        const inner: ChannelInner<T>* = this.inner;
        const held: MutexGuard<ChannelState<T>, GlobalAlloc> = inner.state.lock();
        const state: ChannelState<T>* = held.as_ptr();
        state.senders = state.senders + 1;
        state.refs    = state.refs + 1;
        mem::drop(held);
        return Sender::<T> { inner: inner };
    }

    /// Block until a value is available and return it, or return
    /// `Err(Disconnected)` once every sender has dropped and the queue is
    /// drained.
    public recv(&this) -> Result<T, RecvError> {
        const inner: ChannelInner<T>* = this.inner;
        mut held: MutexGuard<ChannelState<T>, GlobalAlloc> = inner.state.lock();
        const state: ChannelState<T>* = held.as_ptr();
        while (state.head == null && state.senders > 0) {
            inner.ready.wait(&inner.state, &held);
        }
        const node: ChanNode<T>* = state.pop();
        mem::drop(held);
        if (node == null) {
            // No value and no senders left.
            return Result::Err(RecvError::Disconnected);
        }
        // Move the value out of the node, then free the node without running
        // the slot's destructor, so the value is owned exactly once.
        const slot: T* = &(*node).value;
        mut value: T;
        unsafe { value = *slot; }
        mut alloc: GlobalAlloc = GlobalAlloc::new();
        alloc.deallocate(NonNull::new(node as u8*), Layout::of::<ChanNode<T>>());
        return Result::Ok(value);
    }

    /// Non-blocking receive. Returns `Err(Empty)` if no value is ready but
    /// senders remain, `Err(Disconnected)` if the channel is drained and
    /// all senders have dropped.
    public try_recv(&this) -> Result<T, TryRecvError> {
        const inner: ChannelInner<T>* = this.inner;
        const held: MutexGuard<ChannelState<T>, GlobalAlloc> = inner.state.lock();
        const state: ChannelState<T>* = held.as_ptr();
        const node: ChanNode<T>* = state.pop();
        if (node == null) {
            if (state.senders == 0) { return Result::Err(TryRecvError::Disconnected); }
            return Result::Err(TryRecvError::Empty);
        }
        mem::drop(held);
        // Same balance as `recv`: the node is released without running the
        // slot's destructor, so the value is owned exactly once.
        const slot: T* = &(*node).value;
        mut value: T;
        unsafe { value = *slot; }
        mut alloc: GlobalAlloc = GlobalAlloc::new();
        alloc.deallocate(NonNull::new(node as u8*), Layout::of::<ChanNode<T>>());
        return Result::Ok(value);
    }
}

implement<T> trait Drop for struct Receiver<T> {
    drop(mut &this) -> void {
        if (this.inner == null) { return; }
        const inner: ChannelInner<T>* = this.inner;
        const held: MutexGuard<ChannelState<T>, GlobalAlloc> = inner.state.lock();
        const state: ChannelState<T>* = held.as_ptr();
        state.rx_open = false;
        // Drain and drop any values still queued: with the receiver gone
        // they would otherwise leak.
        mut node: ChanNode<T>* = state.pop();
        while (node != null) {
            const slot: T* = &(*node).value;
            ptr::drop_in_place::<T>(slot);
            mut a: GlobalAlloc = GlobalAlloc::new();
            a.deallocate(NonNull::new(node as u8*), Layout::of::<ChanNode<T>>());
            node = state.pop();
        }
        state.refs = state.refs - 1;
        const last: boolean = state.refs == 0;
        mem::drop(held);
        if (last) { free_inner::<T>(inner); }
        this.inner = null;
    }
}


/// Create an unbounded channel and return its `Receiver<T>` - the
/// channel's owning end. Mint one or more producers with `rx.sender()`
/// (each is independently owned and movable into its own thread):
///
///   ```cryo
///   mut rx: mpsc::Receiver<i32> = mpsc::channel<i32>();
///   const tx: mpsc::Sender<i32> = rx.sender();
///   thread::spawn<mpsc::Sender<i32>, i32>(tx, (s: mpsc::Sender<i32>) -> i32 {
///       mut snd: mpsc::Sender<i32> = s; snd.send(1); snd.close(); return 0;
///   });
///   match (rx.recv()) { Result::Ok(v) => {} Result::Err(_) => {} }
///   ```
///
/// Returning a single owned value (rather than a sender/receiver pair)
/// sidesteps the current restriction on moving owning fields out of an
/// aggregate (E0453); it also makes the receiver the unambiguous owner of
/// the channel's lifetime. Panics only on allocation / pthread-init
/// failure.
public function channel<T>() -> Receiver<T> {
    return Receiver::<T> { inner: new_inner::<T>() };
}
