///! std::sync::mpsc: multi-producer, single-consumer channels.
///!
///! `Channel::unbounded::<T>()` and `Channel::bounded::<T>(capacity)` open a
///! channel and return both of its ends together, its `Sender<T>` first.
///! Each `Sender<T>` is independently owned and movable into its own thread,
///! and is cloned for more producers. Values of any type `T` - including
///! owned data like `String` - are moved through the FIFO queue.
///!
///!   ```cryo
///!   const { first: tx, second: rx }: Pair<mpsc::Sender<i32>, mpsc::Receiver<i32>> =
///!       mpsc::Channel::unbounded::<i32>();
///!   // move `tx` into a worker thread; keep `rx` here
///!   const h = thread::spawn(move () -> i32 {
///!       tx.send(42);
///!       return 0;       // `tx` is released with the closure as the thread ends
///!   });
///!   match (rx.recv()) { Result::Ok(v) => { use(v); } Result::Err(_) => {} }
///!   h.join();
///!   ```
///!
///! ## Capacity
///!
///! An unbounded channel queues every value sent. A bounded one holds at
///! most `capacity` values: `send` on a full channel blocks until the
///! receiver takes one, or returns the value in `Err(SendError)` if the
///! receiver is dropped meanwhile.
///!
///! ## Disconnection
///!
///! When every `Sender` has been dropped, a blocked `recv()` returns
///! `Err(RecvError::Disconnected)` and `try_recv()` returns
///! `Err(TryRecvError::Disconnected)`. A disconnected channel stays
///! disconnected: a sender is made only with the channel or by cloning a
///! live one. When the `Receiver` is dropped, `send()` returns
///! `Err(SendError)` (handing the value back) instead of queueing into a
///! channel no one will drain.
///!
///! ## Implementation
///!
///! A heap `ChannelInner<T>` holds a `Mutex` over the channel's state - a
///! raw singly-linked node queue with its length, plus a live-sender count
///! and a total-handle refcount - a `CondVar` the receiver waits on, and one
///! a sender waits on for room. The inner is reclaimed when the last handle
///! (sender or receiver) drops. Values move out of dequeued nodes through
///! raw pointers, so the move-checker treats each as a clean transfer
///! (no aliasing, no double-free).

namespace std::sync::mpsc;

import std::core::intrinsics;
import std::core::ptr::{ NonNull };
import std::core::result::{ Result };
import std::core::option;
import std::core::drop::{ Drop };
import std::alloc::layout::{ Layout };
import std::alloc::allocator::{ GlobalAlloc };
import std::collections::pair::{ Pair };
import std::core::mem;
import std::sync::mutex::{ Mutex, MutexGuard };
import std::sync::condvar::{ CondVar };
import std::time::clock::{ Instant };
import std::time::duration::{ Duration };


/// A queued value plus a raw link to the next node. Allocated per `send`,
/// freed when the value is dequeued (or when the channel is torn down).
private type struct ChanNode<T> {
    private next:  mut ChanNode<T>*;
    private value: T;
}

/// The queue and the handle counts, reached only through the channel's lock.
private type struct ChannelState<T> {
    private head:     mut ChanNode<T>*;   // dequeue end (null when empty)
    private tail:     mut ChanNode<T>*;   // enqueue end
    private length:   i64;            // values queued
    private capacity: i64;            // most values queued at once; `i64::MAX` when unbounded
    private senders:  i64;            // live Sender handles
    private refs:     i64;            // live Sender + Receiver handles
    private rx_open:  boolean;        // receiver still alive

    /// Unlink and return the oldest queued node, or null when the queue is
    /// empty.
    private pop(mut &this) -> mut ChanNode<T>* {
        const node: mut ChanNode<T>* = this.head;
        if (node == null) { return null; }
        this.head = (*node).next;
        if (this.head == null) { this.tail = null; }
        this.length = this.length - 1;
        return node;
    }
}

/// Shared channel state, reached through a raw pointer by every handle.
private type struct ChannelInner<T> {
    private state: Mutex<ChannelState<T>>;
    private ready: CondVar;   // the receiver waits here for a value or the last sender
    private room:  CondVar;   // a sender waits here for a full queue to shrink or the receiver to go
}


/// Allocate + initialize a fresh `ChannelInner<T>` holding at most
/// `capacity` values, with its two handles: one `Sender` and the `Receiver`.
private function new_inner<T>(capacity: i64) -> mut ChannelInner<T>* {
    mut alloc: GlobalAlloc = GlobalAlloc::new();
    mut inner: mut ChannelInner<T>* = null;
    match (alloc.allocate(Layout::of::<ChannelInner<T>>())) {
        Result::Ok(raw) => { inner = raw.cast::<ChannelInner<T>>().as_ptr(); }
        Result::Err(_)  => { core::panic("mpsc::Channel: allocation failed", intrinsics::location()); }
    }
    inner.state = Mutex::new(ChannelState::<T> {
        head: null, tail: null, length: 0, capacity: capacity,
        senders: 1, refs: 2, rx_open: true
    });
    inner.ready = CondVar::new();
    inner.room = CondVar::new();
    return inner;
}

/// Release the lock and condition variable and free the inner box. Called
/// by the last handle to drop; the queue is expected empty (the receiver
/// drains it on its way out).
private function free_inner<T>(inner: mut ChannelInner<T>*) -> void {
    ptr::drop_in_place::<ChannelInner<T>>(inner);
    mut alloc: GlobalAlloc = GlobalAlloc::new();
    alloc.deallocate(NonNull::new(inner as mut u8*), Layout::of::<ChannelInner<T>>());
}


/// Error returned by `Sender::send` when the receiver has been dropped.
/// Carries the value back so the caller does not lose it.
public type struct SendError<T> {
    public value: T;
}

/// Error returned by a blocking `Receiver::recv`.
public type enum RecvError with [Eq, Clone] {
    Disconnected;   // all senders dropped and the queue is empty
}

/// Error returned by the non-blocking `Receiver::try_recv`.
public type enum TryRecvError with [Eq, Clone] {
    Empty;          // no value ready, but senders remain
    Disconnected;   // all senders dropped and the queue is empty
}


/// Why `Receiver::receive_timeout` returned no value.
public type enum ReceiveTimeoutError with [Eq, Clone] {
    /// The time ran out with no value sent and a sender still alive.
    Timeout;
    /// Every sender has dropped and the queue is empty.
    Disconnected;
}

/// The sending half of a channel. Cloneable for multiple producers.
public type struct Sender<T> {
    private inner: mut ChannelInner<T>*;

    /// Enqueue `value`, first waiting for room when a bounded channel is
    /// full. Returns `Err(SendError{value})` if the receiver has been
    /// dropped (the value is handed back unconsumed).
    public send(&this, value: T) -> Result<(), SendError<T>> {
        const inner: ChannelInner<T>* = this.inner;
        mut held: MutexGuard<ChannelState<T>, GlobalAlloc> = inner.state.lock();
        const state: mut ChannelState<T>* = held.as_mutable_ptr();
        while (state.rx_open && state.length >= state.capacity) {
            inner.room.wait(&inner.state, &held);
        }
        if (!state.rx_open) {
            return Result::Err(SendError::<T> { value: value });
        }
        mut node: mut ChanNode<T>* = null;
        mut alloc: GlobalAlloc = GlobalAlloc::new();
        match (alloc.allocate(Layout::of::<ChanNode<T>>())) {
            Result::Ok(raw) => { node = raw.cast::<ChanNode<T>>().as_ptr(); }
            Result::Err(_)  => {
                return Result::Err(SendError::<T> { value: value });
            }
        }
        (*node).next = null;
        // Move `value` into the node through a raw pointer so no drop is
        // synthesized on the uninitialized destination.
        const slot: mut T* = &(*node).value;
        *slot = value;
        if (state.tail == null) {
            state.head = node;
            state.tail = node;
        } else {
            (*state.tail).next = node;
            state.tail = node;
        }
        state.length = state.length + 1;
        // Wake one blocked receiver (there is at most one).
        inner.ready.notify_one();
        mem::drop(held);
        return Result::Ok(());
    }

    /// Create another sender on the same channel (multi-producer).
    public clone(&this) -> Sender<T> {
        const inner: mut ChannelInner<T>* = this.inner;
        mut held: MutexGuard<ChannelState<T>, GlobalAlloc> = inner.state.lock();
        const state: mut ChannelState<T>* = held.as_mutable_ptr();
        state.senders = state.senders + 1;
        state.refs    = state.refs + 1;
        mem::drop(held);
        return Sender::<T> { inner: inner };
    }

    /// Explicitly drop this sender now (rather than at scope end). Useful
    /// after moving a sender into a thread body, where the value must be
    /// released before the body returns.
    public close(mut this) -> void {
        const { inner }: Sender<T> = this;
        release_sender::<T>(inner);
    }
}

/// Decrement the sender/handle counts; wake the receiver if this was the
/// last sender (so a blocked `recv` observes disconnection); free the
/// inner if this was the last handle of any kind.
private function release_sender<T>(inner: mut ChannelInner<T>*) -> void {
    mut held: MutexGuard<ChannelState<T>, GlobalAlloc> = inner.state.lock();
    const state: mut ChannelState<T>* = held.as_mutable_ptr();
    state.senders = state.senders - 1;
    if (state.senders == 0) {
        inner.ready.notify_all();
    }
    state.refs = state.refs - 1;
    const last: boolean = state.refs == 0;
    mem::drop(held);
    if (last) { free_inner::<T>(inner); }
}

implement<T> trait Drop for struct Sender<T> {
    drop(mut &this) -> void {
        if (this.inner == null) { return; }
        release_sender::<T>(this.inner);
        this.inner = null;
    }
}


/// The receiving half of a channel. Not cloneable (single consumer).
public type struct Receiver<T> {
    private inner: mut ChannelInner<T>*;

    /// Block until a value is available and return it, or return
    /// `Err(Disconnected)` once every sender has dropped and the queue is
    /// drained.
    public recv(&this) -> Result<T, RecvError> {
        const inner: ChannelInner<T>* = this.inner;
        mut held: MutexGuard<ChannelState<T>, GlobalAlloc> = inner.state.lock();
        const state: mut ChannelState<T>* = held.as_mutable_ptr();
        while (state.head == null && state.senders > 0) {
            inner.ready.wait(&inner.state, &held);
        }
        const node: mut ChanNode<T>* = state.pop();
        // A value taken is room made: wake a sender waiting on a full queue.
        if (node != null) { inner.room.notify_one(); }
        mem::drop(held);
        if (node == null) {
            // No value and no senders left.
            return Result::Err(RecvError::Disconnected);
        }
        // Move the value out of the node, then free the node without running
        // the slot's destructor, so the value is owned exactly once.
        const slot: T* = &(*node).value;
        mut value: T;
        unsafe { value = *slot; }
        mut alloc: GlobalAlloc = GlobalAlloc::new();
        alloc.deallocate(NonNull::new(node as mut u8*), Layout::of::<ChanNode<T>>());
        return Result::Ok(value);
    }

    /// Wait no longer than `duration` for a value and return it.
    /// `Err(Timeout)` when the time runs out first, `Err(Disconnected)`
    /// once every sender has dropped and the queue is drained.
    public receive_timeout(&this, duration: Duration) -> Result<T, ReceiveTimeoutError> {
        const deadline: Instant = Instant::now().saturating_add(&duration);
        const inner: ChannelInner<T>* = this.inner;
        mut held: MutexGuard<ChannelState<T>, GlobalAlloc> = inner.state.lock();
        const state: mut ChannelState<T>* = held.as_mutable_ptr();
        while (state.head == null && state.senders > 0) {
            const remaining: Duration = deadline.saturating_duration_since(&Instant::now());
            if (remaining.is_zero()) {
                return Result::Err(ReceiveTimeoutError::Timeout);
            }
            inner.ready.wait_timeout(&inner.state, &held, remaining);
        }
        const node: mut ChanNode<T>* = state.pop();
        if (node != null) { inner.room.notify_one(); }
        mem::drop(held);
        if (node == null) {
            return Result::Err(ReceiveTimeoutError::Disconnected);
        }
        // Moved out and released as in `recv`.
        const slot: T* = &(*node).value;
        mut value: T;
        unsafe { value = *slot; }
        mut alloc: GlobalAlloc = GlobalAlloc::new();
        alloc.deallocate(NonNull::new(node as mut u8*), Layout::of::<ChanNode<T>>());
        return Result::Ok(value);
    }

    /// Non-blocking receive. Returns `Err(Empty)` if no value is ready but
    /// senders remain, `Err(Disconnected)` if the channel is drained and
    /// all senders have dropped.
    public try_recv(&this) -> Result<T, TryRecvError> {
        const inner: ChannelInner<T>* = this.inner;
        mut held: MutexGuard<ChannelState<T>, GlobalAlloc> = inner.state.lock();
        const state: mut ChannelState<T>* = held.as_mutable_ptr();
        const node: mut ChanNode<T>* = state.pop();
        if (node == null) {
            if (state.senders == 0) { return Result::Err(TryRecvError::Disconnected); }
            return Result::Err(TryRecvError::Empty);
        }
        inner.room.notify_one();
        mem::drop(held);
        // Same balance as `recv`: the node is released without running the
        // slot's destructor, so the value is owned exactly once.
        const slot: T* = &(*node).value;
        mut value: T;
        unsafe { value = *slot; }
        mut alloc: GlobalAlloc = GlobalAlloc::new();
        alloc.deallocate(NonNull::new(node as mut u8*), Layout::of::<ChanNode<T>>());
        return Result::Ok(value);
    }
}

implement<T> trait Drop for struct Receiver<T> {
    drop(mut &this) -> void {
        if (this.inner == null) { return; }
        const inner: mut ChannelInner<T>* = this.inner;
        mut held: MutexGuard<ChannelState<T>, GlobalAlloc> = inner.state.lock();
        const state: mut ChannelState<T>* = held.as_mutable_ptr();
        state.rx_open = false;
        // Drain and drop any values still queued: with the receiver gone
        // they would otherwise leak.
        mut node: mut ChanNode<T>* = state.pop();
        while (node != null) {
            const slot: T* = &(*node).value;
            ptr::drop_in_place::<T>(slot);
            mut a: GlobalAlloc = GlobalAlloc::new();
            a.deallocate(NonNull::new(node as mut u8*), Layout::of::<ChanNode<T>>());
            node = state.pop();
        }
        // A sender waiting for room would wait for ever: wake every one, to
        // find the receiver gone.
        inner.room.notify_all();
        state.refs = state.refs - 1;
        const last: boolean = state.refs == 0;
        mem::drop(held);
        if (last) { free_inner::<T>(inner); }
        this.inner = null;
    }
}


/// Opens channels. A channel's two ends come out together, its `Sender<T>`
/// first; more senders are clones of that one:
///
///   ```cryo
///   const { first: tx, second: rx }: Pair<mpsc::Sender<i32>, mpsc::Receiver<i32>> =
///       mpsc::Channel::unbounded::<i32>();
///   thread::spawn(move () -> i32 { tx.send(1); return 0; });
///   match (rx.recv()) { Result::Ok(v) => {} Result::Err(_) => {} }
///   ```
///
/// Panics only on allocation / lock-initialization failure.
public type struct Channel {
    /// A channel that queues every value sent.
    public static unbounded<T>() -> Pair<Sender<T>, Receiver<T>> {
        return Channel::open::<T>(i64::MAX);
    }

    /// A channel holding at most `capacity` values: `send` on a full one
    /// waits for the receiver to take a value. Panics when `capacity` is
    /// less than 1.
    public static bounded<T>(capacity: i64) -> Pair<Sender<T>, Receiver<T>> {
        if (capacity < 1) {
            core::panic("mpsc::Channel::bounded: the capacity must be at least 1", intrinsics::location());
        }
        return Channel::open::<T>(capacity);
    }

    private static open<T>(capacity: i64) -> Pair<Sender<T>, Receiver<T>> {
        const inner: mut ChannelInner<T>* = new_inner::<T>(capacity);
        return Pair::<Sender<T>, Receiver<T>> {
            first: Sender::<T> { inner: inner }, second: Receiver::<T> { inner: inner }
        };
    }
}
