///! Error type for the synchronization primitives.
///!
///! `SyncError` mirrors `io::error::IoError`'s shape: a closed enum of
///! logical kinds plus the raw POSIX errno code that produced the
///! error.  Returning a single error type from every sync method keeps
///! the surface tight; the `kind` field lets callers branch on the
///! interesting cases (a lock timeout vs an OS resource exhaustion).
///!
///! When std::thread lands, it can choose to share this type (the
///! POSIX errnos are the same on both surfaces) or introduce its own.

namespace std::sync::error;

import core::cmp;

/// Logical category of a sync-primitive failure.
type enum SyncErrorKind : i32 {
    /// A non-blocking call (`try_lock`, `try_recv`, ...) found the
    /// resource contended; the caller should back off and retry.
    WouldBlock     = 0;
    /// A `*_timedlock` / `wait_timeout` reached its deadline without
    /// acquiring or being signaled.
    Timeout        = 1;
    /// `pthread_mutex_init` / `pthread_cond_init` / etc. failed
    /// because the OS is out of memory or kernel-side handles.
    OutOfResources = 2;
    /// A method was called in a state that doesn't make sense
    /// (e.g. unlocking an unlocked mutex with `PTHREAD_MUTEX_ERRORCHECK`).
    InvalidState   = 3;
    /// The current platform lacks the requested primitive (e.g.
    /// `wait_timeout` on a build without `clock_gettime`).
    Unsupported    = 4;
    /// A condition variable was waited-on while a thread holding the
    /// lock panicked.  Currently never produced — Cryo's runtime has
    /// no panic-catch story across threads — but reserved for the
    /// future poisoning implementation.
    Poisoned       = 5;
    /// Anything else.  Inspect `os_code` for the platform errno.
    Other          = 6;
}

/// Failure value returned by every fallible sync method.
public type struct SyncError {
    kind: SyncErrorKind;
    /// The POSIX errno value that produced this error, or 0 when the
    /// failure is synthetic (e.g. construction-time `OutOfResources`).
    os_code: i32;

    static new(kind: SyncErrorKind, os_code: i32) -> SyncError {
        return SyncError { kind: kind, os_code: os_code };
    }

    /// Convert a POSIX errno value from a pthread call into a
    /// `SyncError`.  Maps the standard error codes to the relevant
    /// `SyncErrorKind`; unknown codes become `Other`.
    static from_errno(code: i32) -> SyncError {
        // EBUSY = 16, ETIMEDOUT = 110, EINVAL = 22, EAGAIN = 11
        // (Linux x86_64).  Same numbers as ffi::libc constants.
        if (code == 16) { return SyncError::new(SyncErrorKind::WouldBlock,     code); }
        if (code == 110) { return SyncError::new(SyncErrorKind::Timeout,        code); }
        if (code == 22) { return SyncError::new(SyncErrorKind::InvalidState,   code); }
        if (code == 11) { return SyncError::new(SyncErrorKind::WouldBlock,     code); }
        // ENOMEM = 12, EAGAIN reuse for resource exhaustion at init.
        if (code == 12) { return SyncError::new(SyncErrorKind::OutOfResources, code); }
        return SyncError::new(SyncErrorKind::Other, code);
    }

    kind_of(&this) -> SyncErrorKind {
        return this.kind;
    }

    os_code_of(&this) -> i32 {
        return this.os_code;
    }
}
