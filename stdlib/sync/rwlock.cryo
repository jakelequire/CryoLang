///! RwLock<T>: read/write reader-writer lock around a value.
///!
///! `RwLock<T, A>` allows many concurrent readers OR one exclusive
///! writer.  Use it instead of `Mutex<T>` when the guarded value is
///! read frequently and written rarely - the read path doesn't
///! serialize on the writer.
///!
///! Backed by POSIX `pthread_rwlock_t` (56 bytes on Linux x86_64),
///! held inside a heap-allocated `RwLockInner` for address
///! stability.  Like `Mutex`, the `RwLock<T, A>` handle is a movable
///! single-pointer wrapper.
///!
///! Two guard types correspond to the two access modes:
///!   - `RwLockReadGuard<T, A>` : shared read.  Multiple may exist.
///!   - `RwLockWriteGuard<T, A>` : exclusive write.  Mutually
///!     excludes all other guards.
///!
///! Both guards are **!Send** (the compiler enforces this via the
///! same deny-list mechanism used for `MutexGuard`).  `RwLock<T, A>`
///! itself is `Send + Sync` iff `T: Send + Sync` and `A: Send + Sync`
///! (a writer can mutate, so reading the value across threads
///! requires `T: Sync`).
///!
///! Like `Mutex`, panicking while holding a guard leaves the lock
///! held forever - no poisoning recovery in v1.

namespace std::sync::rwlock;

import core::intrinsics;
import core::ptr;
import core::result;
import core::option;
import core::drop;
import alloc::layout;
import alloc::allocator;
import ffi::libc;


// 56-byte opaque rwlock buffer + value + allocator.  Heap-pinned.
type struct RwLockInner<T, A> {
    pthread_buf: u8[56];
    value:       T;
    alloc:       A;
}


/// Shared-read guard.  Many of these may exist concurrently on the
/// same `RwLock`.  Calling `.as_ptr()` yields a pointer that should
/// be treated as `&T` (read-only); writing through it is a logic
/// error the type system doesn't catch (Cryo has no borrow checker).
type struct RwLockReadGuard<T, A> {
    inner: RwLockInner<T, A>*;

    as_ptr(&this) -> T* {
        return &this.inner.value;
    }
}

implement<T, A> trait Drop for struct RwLockReadGuard<T, A> {
    drop(mut &this) -> void {
        if (this.inner == null) { return; }
        const buf_ptr: u8* = &this.inner.pthread_buf[0];
        pthread_rwlock_unlock(buf_ptr);
        this.inner = null;
    }
}

/// Exclusive write guard.  At most one of these exists on a given
/// `RwLock`, and no `RwLockReadGuard` can co-exist with it.
type struct RwLockWriteGuard<T, A> {
    inner: RwLockInner<T, A>*;

    as_ptr(&this) -> T* {
        return &this.inner.value;
    }
}

implement<T, A> trait Drop for struct RwLockWriteGuard<T, A> {
    drop(mut &this) -> void {
        if (this.inner == null) { return; }
        const buf_ptr: u8* = &this.inner.pthread_buf[0];
        pthread_rwlock_unlock(buf_ptr);
        this.inner = null;
    }
}


type struct RwLock<T, A = GlobalAlloc> {
    inner: RwLockInner<T, A>*;

    static new(value: T) -> RwLock<T, GlobalAlloc> {
        match (RwLock::try_new(value)) {
            Result::Ok(r)  => { return r; }
            Result::Err(_) => {
                intrinsics::panic("RwLock::new: allocation failed", FILE, LINE);
            }
        }
    }

    static new_in(value: T, alloc: A) -> RwLock<T, A> {
        match (RwLock::try_new_in(value, alloc)) {
            Result::Ok(r)  => { return r; }
            Result::Err(_) => {
                intrinsics::panic("RwLock::new_in: allocation failed", FILE, LINE);
            }
        }
    }

    static try_new(value: T) -> Result<RwLock<T, GlobalAlloc>, AllocError> {
        mut alloc: GlobalAlloc = GlobalAlloc::new();
        const header: Layout = Layout::of<RwLockInner<T, GlobalAlloc>>();
        const raw: NonNull<u8> = alloc.allocate(header)?;
        const typed: NonNull<RwLockInner<T, GlobalAlloc>> =
            raw.cast<RwLockInner<T, GlobalAlloc>>();
        const inner_ptr: RwLockInner<T, GlobalAlloc>* = typed.as_ptr();
        const buf_ptr: u8* = &inner_ptr.pthread_buf[0];
        const rc: i32 = pthread_rwlock_init(buf_ptr, null);
        if (rc != 0) {
            alloc.deallocate(raw, header);
            return Result::Err(AllocError::new(AllocErrorKind::OutOfMemory, header));
        }
        inner_ptr.value = value;
        inner_ptr.alloc = alloc;
        return Result::Ok(RwLock<T, GlobalAlloc> { inner: inner_ptr });
    }

    static try_new_in(value: T, alloc: A) -> Result<RwLock<T, A>, AllocError> {
        mut a: A = alloc;
        const header: Layout = Layout::of<RwLockInner<T, A>>();
        const raw: NonNull<u8> = a.allocate(header)?;
        const typed: NonNull<RwLockInner<T, A>> = raw.cast<RwLockInner<T, A>>();
        const inner_ptr: RwLockInner<T, A>* = typed.as_ptr();
        const buf_ptr: u8* = &inner_ptr.pthread_buf[0];
        const rc: i32 = pthread_rwlock_init(buf_ptr, null);
        if (rc != 0) {
            a.deallocate(raw, header);
            return Result::Err(AllocError::new(AllocErrorKind::OutOfMemory, header));
        }
        inner_ptr.value = value;
        inner_ptr.alloc = a;
        return Result::Ok(RwLock<T, A> { inner: inner_ptr });
    }

    /// Acquire a shared read lock, blocking until available.
    read(&this) -> RwLockReadGuard<T, A> {
        const buf_ptr: u8* = &this.inner.pthread_buf[0];
        const rc: i32 = pthread_rwlock_rdlock(buf_ptr);
        if (rc != 0) {
            intrinsics::panic("RwLock::read: pthread_rwlock_rdlock failed", FILE, LINE);
        }
        return RwLockReadGuard<T, A> { inner: this.inner };
    }

    try_read(&this) -> Option<RwLockReadGuard<T, A>> {
        const buf_ptr: u8* = &this.inner.pthread_buf[0];
        const rc: i32 = pthread_rwlock_tryrdlock(buf_ptr);
        if (rc == 0) {
            return Option::Some(RwLockReadGuard<T, A> { inner: this.inner });
        }
        return Option::None;
    }

    /// Acquire the exclusive write lock, blocking until no other
    /// readers or writers hold it.
    write(&this) -> RwLockWriteGuard<T, A> {
        const buf_ptr: u8* = &this.inner.pthread_buf[0];
        const rc: i32 = pthread_rwlock_wrlock(buf_ptr);
        if (rc != 0) {
            intrinsics::panic("RwLock::write: pthread_rwlock_wrlock failed", FILE, LINE);
        }
        return RwLockWriteGuard<T, A> { inner: this.inner };
    }

    try_write(&this) -> Option<RwLockWriteGuard<T, A>> {
        const buf_ptr: u8* = &this.inner.pthread_buf[0];
        const rc: i32 = pthread_rwlock_trywrlock(buf_ptr);
        if (rc == 0) {
            return Option::Some(RwLockWriteGuard<T, A> { inner: this.inner });
        }
        return Option::None;
    }
}

implement<T, A> trait Drop for struct RwLock<T, A>
where T: Drop, A: Allocator {
    drop(mut &this) -> void {
        if (this.inner == null) { return; }
        const inner_ptr: RwLockInner<T, A>* = this.inner;
        const buf_ptr: u8* = &inner_ptr.pthread_buf[0];
        pthread_rwlock_destroy(buf_ptr);
        inner_ptr.value.drop();
        mut alloc: A = inner_ptr.alloc;
        const header: Layout = Layout::of<RwLockInner<T, A>>();
        alloc.deallocate(NonNull::new(this.inner as u8*), header);
        this.inner = null;
    }
}
