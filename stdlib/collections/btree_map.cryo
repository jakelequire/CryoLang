private type struct ValuesMutableIter<K, V> {
    private cursor: BTreeCursor<K, V>;
}

implement<K, V> trait Iterator<mut V*> for struct ValuesMutableIter<K, V> {
    next(mut &this) -> Option<mut V*> {
        match (this.cursor.next_front()) {
            Option::Some(at) => { return Option::Some(&at.first.values[at.second]); }
