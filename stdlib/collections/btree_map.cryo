}

/// Release every entry and every node.
implement<K, V, A> trait Drop for struct BTreeMap<K, V, A> where A: Allocator {
    drop(mut &this) -> void {
        this.clear();
    }
}

/// Deep copy: a fresh map owning clones of every key and value.
implement<K, V> trait Clone for struct BTreeMap<K, V, GlobalAlloc> where K: Ord + Clone, V: Clone {
    clone(&this) -> BTreeMap<K, V, GlobalAlloc> {
        mut out: BTreeMap<K, V, GlobalAlloc> = BTreeMap::<K, V, GlobalAlloc>::new();
        for (entry in this.entries()) {
            out.insert((*entry.first).clone(), (*entry.second).clone());
        }
        return out;
    }
}

/// A fresh empty map, allocating nothing until the first insert.
implement<K, V> trait Default for struct BTreeMap<K, V, GlobalAlloc> {
    static default() -> BTreeMap<K, V, GlobalAlloc> {
        return BTreeMap::<K, V, GlobalAlloc>::new();
    }
}

/// A map of every key-value pair an iterator yields: what `collect` builds
/// for `BTreeMap`. A later pair's value replaces an earlier one's for the
/// same key.
implement<K, V> trait FromIterator<Pair<K, V>> for struct BTreeMap<K, V, GlobalAlloc> where K: Ord {
    static from_iterator<I>(source: I) -> BTreeMap<K, V, GlobalAlloc> where I: Iterator<Pair<K, V>> {
        mut out: BTreeMap<K, V, GlobalAlloc> = BTreeMap::<K, V, GlobalAlloc>::new();
        for (pair in source) {
            out.insert(pair.first, pair.second);
        }
        return out;
    }
}
