///! HashSet<T, A>: unordered collection of unique values.
///!
///! A thin wrapper over `HashMap<T, ()>`. `T` must implement
///! `Hash + Eq`. The same chaining storage, the same default hasher,
///! the same growth behavior, plus convenience names (`contains`
///! instead of `contains_key`, `insert` that returns a `boolean`
///! instead of the replaced `()`).

namespace std::collections::hashset;

import core::option;
import core::result;
import core::hash;
import core::cmp;
import core::drop;
import core::iter;
import alloc::allocator;
import collections::hashmap;
import collections::pair;

type struct HashSet<T, A = GlobalAlloc> {
    map: HashMap<T, (), A>;

    static new() -> HashSet<T> {
        return HashSet<T> { map: HashMap::new() };
    }

    static new_in(alloc: A) -> HashSet<T, A> {
        return HashSet<T, A> { map: HashMap::new_in(alloc) };
    }

    static with_capacity(capacity: u64) -> HashSet<T> {
        return HashSet<T> { map: HashMap::with_capacity(capacity) };
    }

    length(&this) -> u64 {
        return this.map.length();
    }

    is_empty(&this) -> boolean {
        return this.map.is_empty();
    }

    /// True iff `value` is already a member.
    contains(&this, value: &T) -> boolean
    where T: Hash + Eq {
        return this.map.contains_key(value);
    }

    /// Insert `value`. Returns `true` if it wasn't already present,
    /// the common predicate for "this is a new one to look at."
    /// Panics on allocation failure; use `try_insert` to recover.
    insert(mut &this, value: T) -> boolean
    where T: Hash + Eq {
        match (this.map.insert(value, ())) {
            Option::Some(_) => { return false; }
            Option::None => { return true; }
        }
    }

    try_insert(mut &this, value: T) -> Result<boolean, AllocError>
    where T: Hash + Eq {
        match (this.map.try_insert(value, ())) {
            Result::Ok(previous) => {
                match (previous) {
                    Option::Some(_) => { return Result::Ok(false); }
                    Option::None => { return Result::Ok(true); }
                }
            }
            Result::Err(err) => { return Result::Err(err); }
        }
    }

    /// Remove `value`. Returns `true` if it was present.
    remove(mut &this, value: &T) -> boolean
    where T: Hash + Eq {
        match (this.map.remove(value)) {
            Option::Some(_) => { return true; }
            Option::None => { return false; }
        }
    }

    clear(mut &this) -> void {
        this.map.clear();
    }

    /// Iterate over every element. Yields each value by bitcopy; the
    /// iterator is a borrow-style view, so do not drop the yielded
    /// value for owning `T`. Same mutation-invalidation contract as
    /// `HashMap::iter`.
    iter(&this) -> HashSetIter<T> {
        return HashSetIter<T> { inner: this.map.iter() };
    }
}

// ============================================================================
// HashSetIter: projects HashMapIter<T, ()> onto its keys
// ============================================================================

type struct HashSetIter<T> {
    inner: HashMapIter<T, ()>;
}

implement<T> trait Iterator<T> for struct HashSetIter<T> {
    next(mut &this) -> Option<T> {
        match (this.inner.next()) {
            Option::Some(pair) => { return Option::Some(pair.first); }
            Option::None       => { return Option::None; }
        }
    }
}

/// Release every element and the backing table. Ownership obligation
/// matches `HashMap::drop`.
implement<T, A> trait Drop for struct HashSet<T, A>
where T: Drop, A: Allocator {
    drop(mut &this) -> void {
        this.map.drop();
    }
}
