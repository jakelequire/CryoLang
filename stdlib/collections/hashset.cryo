///! HashSet<T, A, H>: unordered collection of unique values.
///!
///! A thin wrapper over `HashMap<T, ()>`. `T` must implement
///! `Hash + Eq`. The same chaining storage, the same default hasher,
///! the same growth behavior, plus convenience names (`contains`
///! instead of `contains_key`, `insert` that returns a `boolean`
///! instead of the replaced `()`).

namespace std::collections::hashset;

import std::core::option::{ Option };
import std::core::result::{ Result };
import std::core::hash::{ Hash, Hasher, SipHasher };
import std::core::cmp::{ Eq };
import std::core::clone::{ Clone };
import std::core::default::{ Default };
import std::core::drop::{ Drop };
import std::core::iter::{ FromIterator, Iterator };
import std::alloc::allocator::{ AllocError, Allocator, GlobalAlloc };
import std::collections::hashmap::{ HashMap, HashMapIter, KeysRefIter };
import std::collections::pair;

public type struct HashSet<T, A = GlobalAlloc, H = SipHasher> {
    private map: HashMap<T, (), A, H>;

    public static new() -> HashSet<T, GlobalAlloc, H>
    where H: Default {
        return HashSet::<T, GlobalAlloc, H> { map: HashMap::<T, (), GlobalAlloc, H>::new() };
    }

    public static new_in(alloc: A) -> HashSet<T, A, H>
    where H: Default {
        return HashSet::<T, A, H> { map: HashMap::<T, (), A, H>::new_in(alloc) };
    }

    public static with_capacity(capacity: i64) -> HashSet<T, GlobalAlloc, H>
    where H: Default {
        return HashSet::<T, GlobalAlloc, H> { map: HashMap::<T, (), GlobalAlloc, H>::with_capacity(capacity) };
    }

    /// An empty set whose values are hashed starting from `hasher` (see
    /// `HashMap::with_hasher`).
    public static with_hasher(hasher: H) -> HashSet<T, GlobalAlloc, H> {
        return HashSet::<T, GlobalAlloc, H> { map: HashMap::<T, (), GlobalAlloc, H>::with_hasher(hasher) };
    }

    /// The hasher every value's hash starts from (see `HashMap.hasher`).
    public hasher(&this) -> H where H: Copy {
        return this.map.hasher();
    }

    ![inline]
    public length(&this) -> i64 {
        return this.map.length();
    }

    public is_empty(&this) -> boolean {
        return this.map.is_empty();
    }

    /// True if `value` is already a member.
    public contains(&this, value: &T) -> boolean
    where T: Hash + Eq, H: Hasher + Copy {
        return this.map.contains_key(value);
    }

    /// Insert `value`. Returns `true` if it wasn't already present,
    /// the common predicate for "this is a new one to look at."
    /// Panics on allocation failure; use `try_insert` to recover.
    public insert(mut &this, value: T) -> boolean
    where T: Hash + Eq, H: Hasher + Copy {
        match (this.map.insert(value, ())) {
            Option::Some(_) => { return false; }
            Option::None => { return true; }
        }
    }

    public try_insert(mut &this, value: T) -> Result<boolean, AllocError>
    where T: Hash + Eq, H: Hasher + Copy {
        const previous: Option<()> = this.map.try_insert(value, ())?;
        match (previous) {
            Option::Some(_) => { return Result::Ok(false); }
            Option::None => { return Result::Ok(true); }
        }
    }

    /// Remove `value`. Returns `true` if it was present.
    public remove(mut &this, value: &T) -> boolean
    where T: Hash + Eq, H: Hasher + Copy {
        match (this.map.remove(value)) {
            Option::Some(_) => { return true; }
            Option::None => { return false; }
        }
    }

    public clear(mut &this) -> void {
        this.map.clear();
    }

    /// Iterate over every element. Yields each value by bitcopy, so it
    /// is gated on `T: Copy` (mirrors `HashMap::iter`): a yielded owning
    /// value would alias set-owned storage and double-free on drop.
    /// Same mutation-invalidation contract as `HashMap::iter`.
    public iter(&this) -> implement Iterator<T>
    where T: Copy {
        return HashSetIter::<T> { inner: this.map.iter() };
    }

    /// Iterate over every element by shared borrow, yielding `T*`. Unlike
    /// `iter`, this is sound for **any** `T` (owning or Copy) because it hands
    /// out borrows, never bitcopies - so it is the way to walk a
    /// `HashSet<String>` without cloning. Mirrors `Array::iter_ref` and
    /// `HashMap::keys_ref`. Same mutation-invalidation contract as `iter`.
    public iter_ref(&this) -> implement Iterator<T*> {
        return HashSetRefIter::<T> { inner: this.map.keys_ref() };
    }
}

// HashSetIter: projects HashMapIter<T, ()> onto its keys.
//
// `private`: produced only as the opaque `implement Iterator<T>` returned by
// `HashSet::iter`; never named outside this module. Wraps the internal
// `HashMapIter`.

private type struct HashSetIter<T> {
    private inner: HashMapIter<T, ()>;
}

// `where T: Copy`: the inner `HashMapIter<T, ()>::next` is now Copy-gated, so
// this body can only resolve it when `T: Copy`. `HashSetIter` is produced only
// by `HashSet::iter` (itself `where T: Copy`), so the bound is always met.
implement<T> trait Iterator<T> for struct HashSetIter<T>
where T: Copy {
    next(mut &this) -> Option<T> {
        match (this.inner.next()) {
            Option::Some(pair) => { return Option::Some(pair.first); }
            Option::None       => { return Option::None; }
        }
    }
}

// HashSetRefIter: the borrow-yielding analog of HashSetIter. Wraps the map's
// `KeysRefIter<T, ()>` (which yields `T*` and is itself ungated) and forwards
// its borrows unchanged, so `HashSet::iter_ref` is sound for any `T`.
//
// `private`: produced only as the opaque `implement Iterator<T*>` returned by
// `HashSet::iter_ref`; never named outside this module.

private type struct HashSetRefIter<T> {
    private inner: KeysRefIter<T, ()>;
}

implement<T> trait Iterator<T*> for struct HashSetRefIter<T> {
    next(mut &this) -> Option<T*> {
        return this.inner.next();
    }
}

/// The map field releases every element and the backing table after this
/// body. Ownership obligation matches `HashMap::drop`.
implement<T, A, H> trait Drop for struct HashSet<T, A, H>
where A: Allocator {
    drop(mut &this) -> void { }
}

/// A fresh empty set is `HashSet`'s canonical "zero value", so it can satisfy
/// a `Default` bound. Allocates nothing until the first insert.
implement<T, H> trait Default for struct HashSet<T, GlobalAlloc, H>
where H: Default {
    static default() -> HashSet<T, GlobalAlloc, H> {
        return HashSet::<T, GlobalAlloc, H>::new();
    }
}

/// A set of every value an iterator yields: what `collect` builds for
/// `HashSet`.
implement<T, H> trait FromIterator<T> for struct HashSet<T, GlobalAlloc, H>
where T: Hash + Eq, H: Hasher + Copy + Default {
    static from_iterator<I>(source: I) -> HashSet<T, GlobalAlloc, H> where I: Iterator<T> {
        mut out: HashSet<T, GlobalAlloc, H> = HashSet::<T, GlobalAlloc, H>::new();
        for (value in source) {
            out.insert(value);
        }
        return out;
    }
}

/// Deep copy: a fresh set that owns independent clones of every element,
/// mirroring `HashMap::Clone`. Walks by borrow (`iter_ref`) and clones each
/// element in, so it is sound for owning `T` (`HashSet<String>`); the copy
/// hashes with the original's hasher.
implement<T, H> trait Clone for struct HashSet<T, GlobalAlloc, H>
where T: Hash + Eq + Clone, H: Hasher + Copy {
    clone(&this) -> HashSet<T, GlobalAlloc, H> {
        mut out: HashSet<T, GlobalAlloc, H> = HashSet::<T, GlobalAlloc, H>::with_hasher(this.hasher());
        mut it: implement Iterator<T*> = this.iter_ref();
        loop {
            match (it.next()) {
                Option::Some(e) => { out.insert((*e).clone()); }
                Option::None    => { break; }
            }
        }
        return out;
    }
}
