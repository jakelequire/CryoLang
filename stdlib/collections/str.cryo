///! Str: a borrowed UTF-8 string slice.
///!
///! `Str` is `(bytes, length)` over UTF-8-encoded memory that the caller
///! guarantees outlives this view. No NUL terminator; the length is
///! authoritative. `String` (owned) exposes `as_str()` at the boundary
///! so algorithms that only read can be written once.
///!
///! Byte-level access is always safe: `length()` returns the byte
///! count, `as_bytes()` hands out the underlying `Slice<u8>`. Scalar
///! iteration requires a UTF-8 decoder; use `byte_at` and `as_bytes`
///! for byte-level operations.

namespace std::collections::str;

import core::intrinsics;
import core::option;
import core::result;
import core::slice;
import core::cmp;
import core::convert;
import core::hash;
import core::iter;
import collections::string;

type struct Str {
    bytes: u8*;
    length: u64;

    /// Construct from a NUL-terminated C-style string literal. 
    /// The caller certifies that `text` is valid UTF-8 and outlives this view. The
    /// NUL terminator is not included in the view.
    ![implicit]
    static new(text: string) -> Str {
        return Str { bytes: text as u8*, length: strlen(text) };
    }

    /// Construct from a raw pointer + length. The caller certifies that
    /// `[bytes, bytes + length)` is initialized UTF-8 and outlives this
    /// view.
    static from_raw(bytes: u8*, length: u64) -> Str {
        return Str { bytes: bytes, length: length };
    }

    /// Construct from a byte slice. The caller certifies the bytes are
    /// valid UTF-8; no check is performed.
    static from_bytes(slice: Slice<u8>) -> Str {
        return Str { bytes: slice.as_ptr(), length: slice.length() };
    }

    /// Wrap a NUL-terminated `string` (C-style literal or returned
    /// `i8*`/`u8*` cast to `string`) as a `Str`.  Length is computed
    /// once via `strlen`; the NUL itself is not part of the view.
    /// Use this whenever you'd otherwise be writing
    /// `Str::from_raw(lit as u8*, hand_counted_len)`.
    static from_cstr(text: string) -> Str {
        return Str { bytes: text as u8*, length: strlen(text) };
    }

    /// Byte length. For a UTF-8 string, `length() >= char_count`.
    length(&this) -> u64 {
        return this.length;
    }

    is_empty(&this) -> boolean {
        return this.length == 0;
    }

    /// Underlying byte view. Use this for byte-granularity algorithms
    /// (hashing, equality, substring search).
    as_bytes(&this) -> Slice<u8> {
        return Slice::from_raw(this.bytes, this.length);
    }

    /// Raw byte pointer. Valid as long as this `Str` is valid.
    as_ptr(&this) -> u8* {
        return this.bytes;
    }

    /// Bounds-checked byte lookup. For scalar iteration, use
    /// `as_bytes()` with a UTF-8 decoder.
    byte_at(&this, index: u64) -> Option<u8> {
        if (index >= this.length) {
            return Option::None;
        }
        return Option::Some(this.bytes[index]);
    }

    /// `[start, end)` byte sub-slice. Panics if the range is out of
    /// bounds or if `start > end`. **Not UTF-8-aware**; splitting
    /// inside a multi-byte scalar is the caller's responsibility.
    sub_bytes(&this, start: u64, end: u64) -> Str {
        if (start > end || end > this.length) {
            intrinsics::panic("Str::sub_bytes: out of range", FILE, LINE);
        }
        return Str {
            bytes: this.bytes + start,
            length: end - start
        };
    }

    /// Byte-wise equality. UTF-8 in canonical form compares as
    /// expected; non-canonical input compares byte-by-byte.
    equals(&this, other: &Str) -> boolean {
        if (this.length != other.length) {
            return false;
        }
        if (this.length == 0) {
            return true;
        }
        return intrinsics::memcmp(
            this.bytes as void*,
            other.bytes as void*,
            this.length
        ) == 0;
    }

    /// Return a new `String` with every ASCII uppercase byte folded to
    /// lowercase. Non-ASCII bytes are passed through unchanged.
    /// Requires `collections::string`; callers that only need `Str`
    /// can byte-scan manually, but most callers want this method.
    to_ascii_lowercase(&this) -> String {
        mut out: String = String::with_capacity(this.length);
        mut i: u64 = 0;
        while (i < this.length) {
            match (this.byte_at(i)) {
                Option::Some(byte) => {
                    mut b: u8 = byte;
                    if (b >= 0x41 && b <= 0x5A) { b = b + 32; }
                    out.push(b);
                }
                Option::None => { break; }
            }
            i++;
        }
        return out;
    }

    /// True if this string begins with `prefix` (byte-wise).
    starts_with(&this, prefix: &Str) -> boolean {
        const pl: u64 = prefix.length;
        if (pl > this.length) { return false; }
        if (pl == 0) { return true; }
        return intrinsics::memcmp(
            this.bytes as void*, prefix.bytes as void*, pl) == 0;
    }

    /// True if this string ends with `suffix` (byte-wise).
    ends_with(&this, suffix: &Str) -> boolean {
        const sl: u64 = suffix.length;
        if (sl > this.length) { return false; }
        if (sl == 0) { return true; }
        return intrinsics::memcmp(
            (this.bytes + (this.length - sl)) as void*,
            suffix.bytes as void*, sl) == 0;
    }

    /// Byte index of the first occurrence of `needle`, or `None`.
    /// An empty needle matches at index 0. O(n*m) naive scan; inputs in
    /// practice are short. **Not UTF-8-aware** (matches on bytes).
    find(&this, needle: &Str) -> Option<u64> {
        const nl: u64 = needle.length;
        if (nl == 0) { return Option::Some(0); }
        if (nl > this.length) { return Option::None; }
        mut i: u64 = 0;
        const stop: u64 = this.length - nl;
        while (i <= stop) {
            if (intrinsics::memcmp(
                    (this.bytes + i) as void*,
                    needle.bytes as void*, nl) == 0) {
                return Option::Some(i);
            }
            i = i + 1;
        }
        return Option::None;
    }

    /// True if `needle` appears anywhere in this string.
    contains(&this, needle: &Str) -> boolean {
        match (this.find(needle)) {
            Option::Some(_) => { return true; }
            Option::None    => { return false; }
        }
    }

    /// Borrowed sub-slice with leading ASCII whitespace removed.
    trim_start(&this) -> Str {
        mut start: u64 = 0;
        while (start < this.length && is_ascii_ws(this.bytes[start])) {
            start = start + 1;
        }
        return Str { bytes: this.bytes + start, length: this.length - start };
    }

    /// Borrowed sub-slice with trailing ASCII whitespace removed.
    trim_end(&this) -> Str {
        mut end: u64 = this.length;
        while (end > 0 && is_ascii_ws(this.bytes[end - 1])) {
            end = end - 1;
        }
        return Str { bytes: this.bytes, length: end };
    }

    /// Borrowed sub-slice with leading and trailing ASCII whitespace
    /// removed. ASCII whitespace is space, tab, LF, VT, FF, CR.
    trim(&this) -> Str {
        return this.trim_start().trim_end();
    }

    /// Return a new `String` with every ASCII lowercase byte folded to
    /// uppercase. Non-ASCII bytes pass through unchanged. Mirror of
    /// `to_ascii_lowercase`.
    to_ascii_uppercase(&this) -> String {
        mut out: String = String::with_capacity(this.length);
        mut i: u64 = 0;
        while (i < this.length) {
            mut b: u8 = this.bytes[i];
            if (b >= 0x61 && b <= 0x7A) { b = b - 32; }
            out.push(b);
            i++;
        }
        return out;
    }

    /// Iterator over the (non-overlapping) pieces between occurrences of
    /// the byte separator `sep`. A leading/trailing/doubled separator
    /// yields an empty piece, matching Rust's `str::split`. Each yielded
    /// `Str` borrows from this one. `split` on a one-byte separator is
    /// the common case; multi-byte separators are supported too.
    split(&this, sep: &Str) -> implement Iterator<Str> {
        return SplitIter {
            bytes: this.bytes,
            length: this.length,
            sep_bytes: sep.bytes,
            sep_length: sep.length,
            pos: 0,
            done: false,
        };
    }

    try_to_hex(&this) -> Result<u64, ConversionError> {
        if (this.length() == 0) {
            return Result::Err(ConversionError::new("empty input"));
        }
        if (this.length() > 16) {
            return Result::Err(ConversionError::new("hex overflow (>16 digits)"));
        }
        mut value: u64 = 0;
        mut i: u64 = 0;
        while (i < this.length()) {
            match (this.byte_at(i)) {
                Option::Some(byte) => {
                    mut digit: u64 = 0;
                    if (byte >= 0x30 && byte <= 0x39) {
                        digit = (byte - 0x30) as u64;
                    } else if (byte >= 0x41 && byte <= 0x46) {
                        digit = (byte - 0x41 + 10) as u64;
                    } else if (byte >= 0x61 && byte <= 0x66) {
                        digit = (byte - 0x61 + 10) as u64;
                    } else {
                        return Result::Err(ConversionError::new("non-hex byte"));
                    }
                    value = (value << 4) | digit;
                }
                Option::None => {
                    return Result::Err(ConversionError::new("byte_at out of range"));
                }
            }
            i++;
        }
        return Result::Ok(value);
    }
}

/// ASCII whitespace test used by `trim`: space, tab, LF, VT, FF, CR.
function is_ascii_ws(b: u8) -> boolean {
    return b == 0x20 || (b >= 0x09 && b <= 0x0D);
}

/// Lazy iterator over the pieces of a `Str` separated by a byte
/// sequence. Yields borrowed `Str` views; see `Str::split`. Borrows
/// from the source `Str`, which must outlive the iterator.
///
/// Stays `public`: `String::split` (`collections::string`) names it in its
/// return type, a cross-module reference a `private` marking would reject.
/// Reached only as the opaque `implement Iterator<Str>` that `Str::split`
/// returns.
type struct SplitIter {
    bytes:      u8*;
    length:     u64;
    sep_bytes:  u8*;
    sep_length: u64;
    pos:        u64;
    done:       boolean;
}

implement trait Iterator<Str> for struct SplitIter {
    next(mut &this) -> Option<Str> {
        if (this.done) { return Option::None; }
        // An empty separator does not split: yield the whole string once.
        if (this.sep_length == 0) {
            this.done = true;
            return Option::Some(Str { bytes: this.bytes, length: this.length });
        }
        if (this.sep_length <= this.length) {
            const stop: u64 = this.length - this.sep_length;
            mut i: u64 = this.pos;
            while (i <= stop) {
                if (intrinsics::memcmp(
                        (this.bytes + i) as void*,
                        this.sep_bytes as void*, this.sep_length) == 0) {
                    const piece: Str = Str {
                        bytes: this.bytes + this.pos, length: i - this.pos
                    };
                    this.pos = i + this.sep_length;
                    return Option::Some(piece);
                }
                i = i + 1;
            }
        }
        // No further separator: the final piece is the remaining tail.
        const tail: Str = Str {
            bytes: this.bytes + this.pos, length: this.length - this.pos
        };
        this.done = true;
        return Option::Some(tail);
    }
}

implement trait Eq for struct Str {
    equals(&this, other: &Str) -> boolean {
        if (this.length != other.length) {
            return false;
        }
        if (this.length == 0) {
            return true;
        }
        return intrinsics::memcmp(
            this.bytes as void*,
            other.bytes as void*,
            this.length
        ) == 0;
    }
}

implement trait Hash for struct Str {
    hash<H>(&this, hasher: mut &H) -> void
    where H: Hasher {
        hasher.write_bytes(this.as_bytes());
    }
}

// Decimal parsing: `TryFrom<Str>` for each integer width
//
// Call sites read `u16::try_from(s)` (with `s: Str`) and get back
// `Result<u16, ConversionError>`.  The resolver dispatches by arg type,
// so the `TryFrom<Str>` impl coexists with `TryFrom<i64>`,
// `TryFrom<u64>`, etc. on the same target.
//
// Hex parsing lives below in a separate `try_to_hex(&this)` method on Str
// since `TryFrom<Str>` can't distinguish decimal from hex on the same
// source type.

implement trait TryFrom<Str> for u64 {
    static try_from(source: Str) -> Result<u64, ConversionError> {
        if (source.length() == 0) {
            return Result::Err(ConversionError::new("empty input"));
        }
        mut value: u64 = 0;
        mut i: u64 = 0;
        while (i < source.length()) {
            match (source.byte_at(i)) {
                Option::Some(byte) => {
                    if (byte < 0x30 || byte > 0x39) {
                        return Result::Err(ConversionError::new("non-digit byte"));
                    }
                    const digit: u64 = (byte - 0x30) as u64;
                    // Overflow check: value * 10 + digit must fit in u64.
                    // u64::MAX / 10 == 1844674407370955161 (remainder 5).
                    if (value > 1844674407370955161) {
                        return Result::Err(ConversionError::new("overflow"));
                    }
                    if (value == 1844674407370955161 && digit > 5) {
                        return Result::Err(ConversionError::new("overflow"));
                    }
                    value = value * 10 + digit;
                }
                Option::None => {
                    return Result::Err(ConversionError::new("byte_at out of range"));
                }
            }
            i++;
        }
        return Result::Ok(value);
    }
}

implement trait TryFrom<Str> for u32 {
    static try_from(source: Str) -> Result<u32, ConversionError> {
        const value: u64 = u64::try_from(source)?;
        if (value > 4294967295) {
            return Result::Err(ConversionError::new("u32 overflow"));
        }
        return Result::Ok(value as u32);
    }
}

implement trait TryFrom<Str> for u16 {
    static try_from(source: Str) -> Result<u16, ConversionError> {
        const value: u64 = u64::try_from(source)?;
        if (value > 65535) {
            return Result::Err(ConversionError::new("u16 overflow"));
        }
        return Result::Ok(value as u16);
    }
}

implement trait TryFrom<Str> for u8 {
    static try_from(source: Str) -> Result<u8, ConversionError> {
        const value: u64 = u64::try_from(source)?;
        if (value > 255) {
            return Result::Err(ConversionError::new("u8 overflow"));
        }
        return Result::Ok(value as u8);
    }
}

// Signed decimal parsing.
//
// `i64::try_from` (over `Str`) is the canonical implementation;
// narrower signed widths delegate to it and re-check the range.
// Handles an optional leading `+` or `-`; treats an empty input or
// a sign with no digits as an error.
//
// `I64_MIN_MAGNITUDE` is the absolute value of `i64::MIN` (2^63). The
// literal must be hoisted into a named `u64` const because inline
// literals exceeding `i64::MAX` get sign-extended to negative when
// compared against a `u64` operand (Cryo bootstrap-codegen quirk;
// see `tests/lang/integer_literals.cryo`).

const I64_MIN_MAGNITUDE: u64 = 9223372036854775808;

implement trait TryFrom<Str> for i64 {
    static try_from(source: Str) -> Result<i64, ConversionError> {
        if (source.length() == 0) {
            return Result::Err(ConversionError::new("empty input"));
        }
        mut negative: boolean = false;
        mut start: u64 = 0;
        match (source.byte_at(0)) {
            Option::Some(byte) => {
                if (byte == 0x2D) { // '-'
                    negative = true;
                    start = 1;
                } else if (byte == 0x2B) { // '+'
                    start = 1;
                }
            }
            Option::None => {
                return Result::Err(ConversionError::new("byte_at out of range"));
            }
        }
        if (start == source.length()) {
            return Result::Err(ConversionError::new("sign with no digits"));
        }
        const digits: Str = source.sub_bytes(start, source.length());
        const magnitude: u64 = u64::try_from(digits)?;
        if (negative) {
            if (magnitude > I64_MIN_MAGNITUDE) {
                return Result::Err(ConversionError::new("i64 underflow"));
            }
            if (magnitude == I64_MIN_MAGNITUDE) {
                // i64::MIN.  Spelled via the static accessor for
                // readability; the inline literal
                // `-9223372036854775808` now resolves correctly in
                // every position (sema propagates the i64 type onto
                // the magnitude of a negated literal), so either form
                // is sound.
                return Result::Ok(i64::min_value());
            }
            return Result::Ok(0 - (magnitude as i64));
        }
        // Positive: magnitude must fit in i64::MAX.
        if (magnitude > 9223372036854775807) {
            return Result::Err(ConversionError::new("i64 overflow"));
        }
        return Result::Ok(magnitude as i64);
    }
}

implement trait TryFrom<Str> for i32 {
    static try_from(source: Str) -> Result<i32, ConversionError> {
        const value: i64 = i64::try_from(source)?;
        if (value < -2147483648 || value > 2147483647) {
            return Result::Err(ConversionError::new("i32 out of range"));
        }
        return Result::Ok(value as i32);
    }
}

implement trait TryFrom<Str> for i16 {
    static try_from(source: Str) -> Result<i16, ConversionError> {
        const value: i64 = i64::try_from(source)?;
        if (value < -32768 || value > 32767) {
            return Result::Err(ConversionError::new("i16 out of range"));
        }
        return Result::Ok(value as i16);
    }
}

implement trait TryFrom<Str> for i8 {
    static try_from(source: Str) -> Result<i8, ConversionError> {
        const value: i64 = i64::try_from(source)?;
        if (value < -128 || value > 127) {
            return Result::Err(ConversionError::new("i8 out of range"));
        }
        return Result::Ok(value as i8);
    }
}
