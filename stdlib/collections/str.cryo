///! Str: a borrowed UTF-8 string slice.
///!
///! `Str` is `(bytes, length)` over UTF-8-encoded memory that the caller
///! guarantees outlives this view. No NUL terminator; the length is
///! authoritative. `String` (owned) exposes `as_str()` at the boundary
///! so algorithms that only read can be written once.
///!
///! Byte-level access is always safe: `length()` returns the byte
///! count, `as_bytes()` hands out the underlying `&Slice<u8>`. Scalar
///! iteration requires a UTF-8 decoder; use `byte_at` and `as_bytes`
///! for byte-level operations.

namespace std::collections::str;

import std::core::intrinsics;
import std::core::option::{ Option };
import std::core::result::{ Result };
import std::core::slice::{ Slice };
import std::core::cmp::{ Eq, Ord, Ordering };
import std::core::convert::{ ConversionError, TryFrom };
import std::core::hash::{ Hash, Hasher };
import std::core::iter::{ Iterator };
import std::collections::string::{ String };
import std::collections::pair::{ Pair };
import std::ffi::libc;

public type struct Str {
    private bytes: u8*;
    private length: i64;

    /// Construct from a NUL-terminated C-style string literal.
    /// The caller certifies that `text` is valid UTF-8 and outlives this view. The
    /// NUL terminator is not included in the view.
    ![implicit]
    public static new(text: string) -> Str {
        return Str { bytes: text as u8*, length: libc::strlen(text) as i64 };
    }

    /// Construct from a raw pointer + length. The caller certifies that
    /// `[bytes, bytes + length)` is initialized UTF-8 and outlives this
    /// view, and that `length` is not negative.
    public static from_raw(bytes: u8*, length: i64) -> Str {
        return Str { bytes: bytes, length: length };
    }

    /// Construct a `Str` view from a text source, dispatched on `T` at
    /// compile time:
    ///   - `string` - a NUL-terminated C-string (literal or an
    ///                   `i8*`/`u8*` cast to `string`); length via
    ///                   `strlen`, the NUL is not part of the view.
    ///   - `&Slice<u8>` - an existing byte slice, borrowed verbatim.
    /// The caller certifies the bytes are valid UTF-8 and outlive the
    /// view.  For a raw pointer + length use `from_raw`; the `![implicit]`
    /// `new` remains the implicit `string` -> `Str` conversion.
    public static from<T>(src: T) -> Str {
        return static match (T) {
            string    => { Str { bytes: src as u8*, length: libc::strlen(src) as i64 } }
            &Slice<u8> => { Str { bytes: src.as_ptr(), length: src.length() } }
        };
    }

    /// Borrow `bytes` as a `Str` if they are well-formed UTF-8: the checked
    /// constructor, where `from` and `from_raw` take the caller's word for
    /// it. Overlong forms, surrogate halves, scalars above U+10FFFF and a
    /// sequence cut short are refused, and the error says where.
    public static from_utf8(bytes: &Slice<u8>) -> Result<Str, Utf8Error> {
        const start: u8* = bytes.as_ptr();
        const length: i64 = bytes.length();
        mut position: i64 = 0;
        while (position < length) {
            const step: Pair<u32, i64> = decode_scalar(start, length, position);
            // The decoder answers a malformed sequence with the replacement
            // scalar over ONE byte; a real U+FFFD in the text spans three.
            if (step.first == REPLACEMENT_SCALAR && step.second == 1) {
                return Result::Err(Utf8Error::found_at(start, length, position));
            }
            position = position + step.second;
        }
        return Result::Ok(Str { bytes: start, length: length });
    }

    /// Byte length. For a UTF-8 string, `length() >= char_count`.
    ![inline]
    public length(&this) -> i64 {
        return this.length;
    }

    public is_empty(&this) -> boolean {
        return this.length == 0;
    }

    /// Underlying byte view. Use this for byte-granularity algorithms
    /// (hashing, equality, substring search).
    public as_bytes(&this) -> &Slice<u8> {
        return Slice::from_raw(this.bytes, this.length);
    }

    /// Raw byte pointer. Valid as long as this `Str` is valid.
    public as_ptr(&this) -> u8* {
        return this.bytes;
    }

    /// Bounds-checked byte lookup; `None` for an index outside
    /// `[0, length)`, a negative one included. For scalar iteration, use
    /// `chars()`.
    public byte_at(&this, index: i64) -> Option<u8> {
        if (index < 0 || index >= this.length) {
            return Option::None;
        }
        return Option::Some(this.bytes[index]);
    }

    /// `[start, end)` byte sub-slice. Panics if `start` is negative, if
    /// `start > end`, or if `end > length`. **Not UTF-8-aware**; splitting
    /// inside a multi-byte scalar is the caller's responsibility.
    public sub_bytes(&this, start: i64, end: i64) -> Str {
        if (start < 0 || start > end || end > this.length) {
            core::panic("Str::sub_bytes: out of range", intrinsics::location());
        }
        return Str {
            bytes: this.bytes + start,
            length: end - start
        };
    }

    /// Return a new `String` with every ASCII uppercase byte folded to
    /// lowercase. Non-ASCII bytes are passed through unchanged.
    /// Requires `collections::string`; callers that only need `Str`
    /// can byte-scan manually, but most callers want this method.
    public to_ascii_lowercase(&this) -> String {
        mut out: String = String::with_capacity(this.length);
        mut i: i64 = 0;
        while (i < this.length) {
            match (this.byte_at(i)) {
                Option::Some(byte) => { out.push_byte(byte.to_ascii_lowercase()); }
                Option::None => { break; }
            }
            i++;
        }
        return out;
    }

    /// True if this string begins with `prefix` (byte-wise).
    public starts_with(&this, prefix: &Str) -> boolean {
        const pl: i64 = prefix.length();
        if (pl > this.length) { return false; }
        if (pl == 0) { return true; }
        return libc::memcmp(
            this.bytes as void*, prefix.bytes as void*, pl as u64) == 0;
    }

    /// True if this string ends with `suffix` (byte-wise).
    public ends_with(&this, suffix: &Str) -> boolean {
        const sl: i64 = suffix.length();
        if (sl > this.length) { return false; }
        if (sl == 0) { return true; }
        return libc::memcmp(
            (this.bytes + (this.length - sl)) as void*,
            suffix.bytes as void*, sl as u64) == 0;
    }

    /// Byte index of the first occurrence of `needle`, or `None`.
    /// An empty needle matches at index 0. O(n*m) naive scan; inputs in
    /// practice are short. **Not UTF-8-aware** (matches on bytes).
    public find(&this, needle: &Str) -> Option<i64> {
        const nl: i64 = needle.length();
        if (nl == 0) { return Option::Some(0); }
        if (nl > this.length) { return Option::None; }
        mut i: i64 = 0;
        const stop: i64 = this.length - nl;
        while (i <= stop) {
            if (libc::memcmp(
                    (this.bytes + i) as void*,
                    needle.bytes as void*, nl as u64) == 0) {
                return Option::Some(i);
            }
            i = i + 1;
        }
        return Option::None;
    }

    /// Byte index of the last occurrence of `needle`, or `None`. An empty
    /// needle matches at `length()`. **Not UTF-8-aware** (matches on bytes).
    public rfind(&this, needle: &Str) -> Option<i64> {
        const nl: i64 = needle.length();
        if (nl > this.length) { return Option::None; }
        mut i: i64 = this.length - nl;
        while (i >= 0) {
            if (libc::memcmp(
                    (this.bytes + i) as void*,
                    needle.bytes as void*, nl as u64) == 0) {
                return Option::Some(i);
            }
            i = i - 1;
        }
        return Option::None;
    }

    /// Index of the first `byte`, or `None`.
    public find_byte(&this, byte: u8) -> Option<i64> {
        mut i: i64 = 0;
        while (i < this.length) {
            if (this.bytes[i] == byte) { return Option::Some(i); }
            i = i + 1;
        }
        return Option::None;
    }

    /// Index of the last `byte`, or `None`.
    public rfind_byte(&this, byte: u8) -> Option<i64> {
        mut i: i64 = this.length - 1;
        while (i >= 0) {
            if (this.bytes[i] == byte) { return Option::Some(i); }
            i = i - 1;
        }
        return Option::None;
    }

    /// The text before and after the first `separator`, or `None` when it
    /// does not occur. Neither half includes the separator.
    public split_once(&this, separator: &Str) -> Option<Pair<Str, Str>> {
        match (this.find(separator)) {
            Option::Some(at) => {
                return Option::Some(Pair::new(this.sub_bytes(0, at),
                    this.sub_bytes(at + separator.length(), this.length)));
            }
            Option::None => { return Option::None; }
        }
    }

    /// The text before and after the last `separator`, or `None` when it
    /// does not occur. Neither half includes the separator.
    public rsplit_once(&this, separator: &Str) -> Option<Pair<Str, Str>> {
        match (this.rfind(separator)) {
            Option::Some(at) => {
                return Option::Some(Pair::new(this.sub_bytes(0, at),
                    this.sub_bytes(at + separator.length(), this.length)));
            }
            Option::None => { return Option::None; }
        }
    }

    /// The text after `prefix`, or `None` when this string does not begin
    /// with it. An empty prefix always matches.
    public strip_prefix(&this, prefix: &Str) -> Option<Str> {
        if (!this.starts_with(prefix)) { return Option::None; }
        return Option::Some(this.sub_bytes(prefix.length(), this.length));
    }

    /// The text before `suffix`, or `None` when this string does not end
    /// with it. An empty suffix always matches.
    public strip_suffix(&this, suffix: &Str) -> Option<Str> {
        if (!this.ends_with(suffix)) { return Option::None; }
        return Option::Some(this.sub_bytes(0, this.length - suffix.length()));
    }

    /// Length, in bytes, of the longest prefix this string shares with
    /// `other`. **Not UTF-8-aware**: the shared bytes can end inside a
    /// multi-byte scalar.
    public common_prefix_length(&this, other: &Str) -> i64 {
        mut i: i64 = 0;
        while (i < this.length && i < other.length && this.bytes[i] == other.bytes[i]) {
            i = i + 1;
        }
        return i;
    }

    /// A new `String` with every occurrence of `from` replaced by `to`,
    /// scanning left to right without overlap. An empty `from` matches
    /// nowhere, so the result is an unchanged copy.
    public replace(&this, from: &Str, to: &Str) -> String {
        mut out: String = String::with_capacity(this.length);
        mut rest: Str = Str { bytes: this.bytes, length: this.length };
        if (from.length() != 0) {
            loop {
                match (rest.split_once(from)) {
                    Option::Some(halves) => {
                        out.push(halves.first);
                        out.push(*to);
                        rest = halves.second;
                    }
                    Option::None => { break; }
                }
            }
        }
        out.push(rest);
        return out;
    }

    /// Equality with every ASCII letter's case ignored; every other byte
    /// must match exactly.
    public equals_case_insensitive(&this, other: &Str) -> boolean {
        if (this.length != other.length) { return false; }
        mut i: i64 = 0;
        while (i < this.length) {
            if (this.bytes[i].to_ascii_lowercase() != other.bytes[i].to_ascii_lowercase()) {
                return false;
            }
            i = i + 1;
        }
        return true;
    }

    /// True if `needle` appears anywhere in this string.
    public contains(&this, needle: &Str) -> boolean {
        match (this.find(needle)) {
            Option::Some(_) => { return true; }
            Option::None    => { return false; }
        }
    }

    /// Borrowed sub-slice with leading ASCII whitespace removed.
    public trim_start(&this) -> Str {
        mut start: i64 = 0;
        while (start < this.length && this.bytes[start].is_whitespace()) {
            start = start + 1;
        }
        return Str { bytes: this.bytes + start, length: this.length - start };
    }

    /// Borrowed sub-slice with trailing ASCII whitespace removed.
    public trim_end(&this) -> Str {
        mut end: i64 = this.length;
        while (end > 0 && this.bytes[end - 1].is_whitespace()) {
            end = end - 1;
        }
        return Str { bytes: this.bytes, length: end };
    }

    /// Borrowed sub-slice with leading and trailing ASCII whitespace
    /// removed. ASCII whitespace is space, tab, LF, VT, FF, CR.
    public trim(&this) -> Str {
        return this.trim_start().trim_end();
    }

    /// Return a new `String` with every ASCII lowercase byte folded to
    /// uppercase. Non-ASCII bytes pass through unchanged. Mirror of
    /// `to_ascii_lowercase`.
    public to_ascii_uppercase(&this) -> String {
        mut out: String = String::with_capacity(this.length);
        mut i: i64 = 0;
        while (i < this.length) {
            out.push_byte(this.bytes[i].to_ascii_uppercase());
            i++;
        }
        return out;
    }

    /// Iterator over the (non-overlapping) pieces between occurrences of
    /// the byte separator `sep`. A leading/trailing/doubled separator
    /// yields an empty piece. Each yielded
    /// `Str` borrows from this one. `split` on a one-byte separator is
    /// the common case; multi-byte separators are supported too.
    public split(&this, sep: &Str) -> implement Iterator<Str> {
        return SplitIter {
            bytes: this.bytes,
            length: this.length,
            sep_bytes: sep.bytes,
            sep_length: sep.length(),
            pos: 0,
            done: false,
            skip_empty: false,
        };
    }

    /// Iterator over the pieces between occurrences of `separator`, like
    /// `split`, without the empty ones: a leading, trailing or doubled
    /// separator yields nothing, and an empty string yields no piece.
    public split_nonempty(&this, separator: &Str) -> implement Iterator<Str> {
        return SplitIter {
            bytes: this.bytes,
            length: this.length,
            sep_bytes: separator.bytes,
            sep_length: separator.length(),
            pos: 0,
            done: false,
            skip_empty: true,
        };
    }

    /// Iterator over the Unicode scalar values of this string, decoding
    /// UTF-8 on the fly. Each scalar is yielded as a `u32` in the range
    /// `[0, char::MAX]`. This is the scalar-level counterpart to
    /// `byte_at`/`as_bytes`, which stay byte-level.
    ///
    /// Decoding is lenient: an invalid lead byte, a truncated or invalid
    /// continuation, an overlong encoding, or a surrogate / out-of-range
    /// scalar yields U+FFFD (the replacement character) and advances a
    /// single byte, so the iterator always terminates and never reads
    /// past the end of the view.
    public chars(&this) -> implement Iterator<u32> {
        return Chars { bytes: this.bytes, length: this.length, pos: 0 };
    }

    /// Iterator over `(byte_offset, scalar)` pairs: the same scalars as
    /// `chars`, each paired with the byte index at which it begins. The
    /// pair is `Pair<i64, u32>` (`p.first` is the byte offset, `p.second`
    /// the scalar). Byte offsets are into this view's bytes, so a
    /// four-byte scalar advances the next offset by four.
    public char_indices(&this) -> implement Iterator<Pair<i64, u32>> {
        return CharIndices { bytes: this.bytes, length: this.length, pos: 0 };
    }

    /// Iterator over the lines of this string: the pieces between `\n`
    /// bytes, each without its `\n` or a `\r` just before it. A final line
    /// break ends the last line rather than starting an empty one, so
    /// `"a\r\nb\n"` yields `"a"` and `"b"`, and an empty string yields no
    /// line. Each line borrows from this string.
    public lines(&this) -> implement Iterator<Str> {
        return Lines { bytes: this.bytes, length: this.length, position: 0 };
    }

    /// Iterator over the pieces of this string between runs of ASCII
    /// whitespace (space, tab, LF, VT, FF, CR). Leading, trailing and
    /// repeated whitespace yields no empty piece, so `"  a \t b "` yields
    /// `"a"` and `"b"`. Each piece borrows from this string.
    public split_whitespace(&this) -> implement Iterator<Str> {
        return WhitespaceSplit { bytes: this.bytes, length: this.length, position: 0 };
    }

    /// This string written `count` times over, as a new `String`. Zero or
    /// less gives the empty string. Panics when the length overflows `i64`.
    public repeat(&this, count: i64) -> String {
        if (count <= 0) { return String::new(); }
        const total: i64 = match (this.length.checked_multiply(count)) {
            Option::Some(n) => { n }
            Option::None => {
                core::panic("Str::repeat: length overflows i64", intrinsics::location())
            }
        };
        mut out: String = String::with_capacity(total);
        for (mut i: i64 = 0; i < count; i++) {
            out.push(*this);
        }
        return out;
    }

    /// Every piece `parts` yields, in order, with this string between each
    /// two: `Str::new(", ").join(names.iter())` gives `"a, b, c"`. No
    /// piece gives the empty string.
    public join<I>(&this, parts: I) -> String
    where I: Iterator<Str> {
        mut pieces: I = parts;
        mut out: String = String::new();
        mut first: boolean = true;
        loop {
            match (pieces.next()) {
                Option::Some(piece) => {
                    if (!first) { out.push(*this); }
                    out.push(piece);
                    first = false;
                }
                Option::None => { break; }
            }
        }
        return out;
    }

    /// The number of Unicode scalars in this string: what `chars` yields,
    /// so each byte that is not well-formed UTF-8 counts as one.
    public char_count(&this) -> i64 {
        mut count: i64 = 0;
        mut position: i64 = 0;
        while (position < this.length) {
            position = position + decode_scalar(this.bytes, this.length, position).second;
            count = count + 1;
        }
        return count;
    }

    /// Whether byte offset `index` falls between two scalars, where
    /// `sub_bytes` can cut without splitting one: the start, the end, and
    /// any byte that is not a UTF-8 continuation byte. An offset outside
    /// `[0, length]` is no boundary.
    public is_char_boundary(&this, index: i64) -> boolean {
        if (index == 0 || index == this.length) { return true; }
        if (index < 0 || index > this.length) { return false; }
        return (this.bytes[index] & 0xC0) != 0x80;
    }

    /// The value these bytes write as hexadecimal digits, every byte one.
    public try_to_hex(&this) -> Result<u64, ConversionError> {
        return this.digits_value(16);
    }

    /// The value these bytes write as digits of `radix`, every byte one,
    /// with the refusal saying which way they are not: empty, a byte that is
    /// no digit, or a value past `u64::MAX` - a run of digits that stops
    /// short on a byte that still starts a digit run stopped on overflow.
    private digits_value(&this, radix: u32) -> Result<u64, ConversionError> {
        if (this.length() == 0) {
            return Result::Err(ConversionError::new("empty input"));
        }
        const bytes: &Slice<u8> = this.as_bytes();
        match (u64::parse_radix_prefix(bytes, radix)) {
            Option::Some(parsed) => {
                if (parsed.1 == bytes.length()) { return Result::Ok(parsed.0); }
                const rest: &Slice<u8> = bytes.subslice(parsed.1, bytes.length());
                if (u64::parse_radix_prefix(rest, radix).is_some()) {
                    return Result::Err(ConversionError::new("overflow"));
                }
            }
            Option::None => { }
        }
        return Result::Err(ConversionError::new("non-digit byte"));
    }
}

/// Lazy iterator over the pieces of a `Str` separated by a byte
/// sequence. Yields borrowed `Str` views; see `Str::split` and
/// `Str::split_nonempty`. Borrows from the source `Str`, which must
/// outlive the iterator.
///
/// Public: `String::split` names it in its return type.
public type struct SplitIter {
    private bytes:      u8*;
    private length:     i64;
    private sep_bytes:  u8*;
    private sep_length: i64;
    private pos:        i64;
    private done:       boolean;
    private skip_empty: boolean;
}

implement trait Iterator<Str> for struct SplitIter {
    next(mut &this) -> Option<Str> {
        while (!this.done) {
            // A piece runs to the next separator. With none left it is the
            // remaining tail, and an empty separator does not split at all.
            mut end: i64 = -1;
            if (this.sep_length != 0 && this.sep_length <= this.length) {
                const stop: i64 = this.length - this.sep_length;
                mut i: i64 = this.pos;
                while (end < 0 && i <= stop) {
                    if (libc::memcmp(
                            (this.bytes + i) as void*,
                            this.sep_bytes as void*, this.sep_length as u64) == 0) {
                        end = i;
                    }
                    i = i + 1;
                }
            }
            const start: i64 = this.pos;
            if (end < 0) {
                end = this.length;
                this.done = true;
            } else {
                this.pos = end + this.sep_length;
            }
            if (!this.skip_empty || end > start) {
                return Option::Some(Str { bytes: this.bytes + start, length: end - start });
            }
        }
        return Option::None;
    }
}

/// Lazy iterator over the lines of a `Str`; see `Str::lines`.
internal type struct Lines {
    private bytes:    u8*;
    private length:   i64;
    private position: i64;
}

implement trait Iterator<Str> for struct Lines {
    next(mut &this) -> Option<Str> {
        if (this.position >= this.length) { return Option::None; }
        const start: i64 = this.position;
        mut end: i64 = start;
        while (end < this.length && this.bytes[end] != '\n' as u8) { end = end + 1; }
        this.position = end + 1;
        if (end < this.length && end > start && this.bytes[end - 1] == '\r' as u8) { end = end - 1; }
        return Option::Some(Str { bytes: this.bytes + start, length: end - start });
    }
}

/// Lazy iterator over the whitespace-separated pieces of a `Str`; see
/// `Str::split_whitespace`.
internal type struct WhitespaceSplit {
    private bytes:    u8*;
    private length:   i64;
    private position: i64;
}

implement trait Iterator<Str> for struct WhitespaceSplit {
    next(mut &this) -> Option<Str> {
        while (this.position < this.length && this.bytes[this.position].is_whitespace()) {
            this.position = this.position + 1;
        }
        if (this.position >= this.length) { return Option::None; }
        const start: i64 = this.position;
        while (this.position < this.length && !this.bytes[this.position].is_whitespace()) {
            this.position = this.position + 1;
        }
        return Option::Some(Str { bytes: this.bytes + start, length: this.position - start });
    }
}

/// Where a byte sequence stops being UTF-8; see `Str::from_utf8`.
public type struct Utf8Error {
    /// How many bytes from the start are well-formed UTF-8.
    public valid_up_to: i64;
    /// `Some(1)` when the byte at `valid_up_to` starts no well-formed
    /// sequence, so decoding resumes one byte later; `None` when the input
    /// ends part-way through a multi-byte sequence, which more input could
    /// still complete.
    public error_length: Option<i64>;

    /// What went wrong, as a borrowed `Str`; `Display` adds the position.
    public describe(&this) -> Str {
        if (this.error_length.is_none()) {
            return Str::new("incomplete UTF-8 sequence");
        }
        return Str::new("invalid UTF-8");
    }

    /// The error for the malformed sequence at `position`. A lead byte
    /// followed only by continuation bytes up to the end of the input is a
    /// sequence cut short rather than a malformed one.
    private static found_at(bytes: u8*, length: i64, position: i64) -> Utf8Error {
        const lead: u8 = bytes[position];
        mut needed: i64 = 0;
        if ((lead & 0xE0) == 0xC0) { needed = 1; }
        else if ((lead & 0xF0) == 0xE0) { needed = 2; }
        else if ((lead & 0xF8) == 0xF0) { needed = 3; }
        if (needed > 0 && position + 1 + needed > length) {
            mut next: i64 = position + 1;
            while (next < length && (bytes[next] & 0xC0) == 0x80) { next = next + 1; }
            if (next == length) {
                return Utf8Error { valid_up_to: position, error_length: Option::None };
            }
        }
        return Utf8Error { valid_up_to: position, error_length: Option::Some(1) };
    }
}

/// The Unicode replacement character U+FFFD, substituted for any byte
/// sequence that is not well-formed UTF-8 during scalar decoding.
private const REPLACEMENT_SCALAR: u32 = 0xFFFD;

/// Decode one UTF-8 scalar beginning at byte `pos` of `[bytes, bytes+length)`.
/// Returns `Pair { first: scalar, second: consumed }` where `consumed`
/// is the number of bytes the scalar occupied (always `>= 1`, so callers
/// that advance by it can never stall). Lenient per the `Str::chars`
/// contract: any malformed sequence decodes to U+FFFD consuming exactly
/// one byte. Precondition: `pos < length`.
private function decode_scalar(bytes: u8*, length: i64, pos: i64) -> Pair<u32, i64> {
    const lead: u8 = bytes[pos];

    // ASCII fast path: one byte, value is the scalar.
    if (lead < 0x80) {
        return Pair::<u32, i64> { first: lead as u32, second: 1 };
    }

    // Continuation count and initial scalar bits from the lead byte's
    // high prefix. `min` is the smallest scalar this length may legally
    // encode; a decoded value below it is an overlong form.
    mut needed: i64 = 0;
    mut scalar: u32 = 0;
    mut min: u32 = 0;
    if ((lead & 0xE0) == 0xC0) {
        needed = 1; scalar = (lead & 0x1F) as u32; min = 0x80;
    } else if ((lead & 0xF0) == 0xE0) {
        needed = 2; scalar = (lead & 0x0F) as u32; min = 0x800;
    } else if ((lead & 0xF8) == 0xF0) {
        needed = 3; scalar = (lead & 0x07) as u32; min = 0x10000;
    } else {
        // 10xxxxxx orphan continuation, or 11111xxx out of range.
        return Pair::<u32, i64> { first: REPLACEMENT_SCALAR, second: 1 };
    }

    // The continuation bytes must all be present within the view.
    if (pos + 1 + needed > length) {
        return Pair::<u32, i64> { first: REPLACEMENT_SCALAR, second: 1 };
    }

    mut i: i64 = 1;
    while (i <= needed) {
        const b: u8 = bytes[pos + i];
        if ((b & 0xC0) != 0x80) {
            return Pair::<u32, i64> { first: REPLACEMENT_SCALAR, second: 1 };
        }
        scalar = (scalar << 6) | ((b & 0x3F) as u32);
        i = i + 1;
    }

    // Reject overlong encodings, surrogate halves, and values above the
    // Unicode range - each is malformed UTF-8.
    if (scalar < min) {
        return Pair::<u32, i64> { first: REPLACEMENT_SCALAR, second: 1 };
    }
    if (scalar >= 0xD800 && scalar <= 0xDFFF) {
        return Pair::<u32, i64> { first: REPLACEMENT_SCALAR, second: 1 };
    }
    if (scalar > char::MAX as u32) {
        return Pair::<u32, i64> { first: REPLACEMENT_SCALAR, second: 1 };
    }

    return Pair::<u32, i64> { first: scalar, second: 1 + needed };
}

/// Lazy UTF-8 scalar iterator over a `Str`; see `Str::chars`. Borrows
/// from the source `Str`, which must outlive the iterator.
///
/// Public: `String::chars` names it in its return type.
public type struct Chars {
    private bytes:  u8*;
    private length: i64;
    private pos:    i64;
}

implement trait Iterator<u32> for struct Chars {
    next(mut &this) -> Option<u32> {
        if (this.pos >= this.length) { return Option::None; }
        const step: Pair<u32, i64> = decode_scalar(this.bytes, this.length, this.pos);
        this.pos = this.pos + step.second;
        return Option::Some(step.first);
    }
}

/// Lazy `(byte_offset, scalar)` iterator over a `Str`; see
/// `Str::char_indices`. Borrows from the source `Str`. Public:
/// `String::char_indices` names it in its return type.
public type struct CharIndices {
    private bytes:  u8*;
    private length: i64;
    private pos:    i64;
}

implement trait Iterator<Pair<i64, u32>> for struct CharIndices {
    next(mut &this) -> Option<Pair<i64, u32>> {
        if (this.pos >= this.length) { return Option::None; }
        const start: i64 = this.pos;
        const step: Pair<u32, i64> = decode_scalar(this.bytes, this.length, this.pos);
        this.pos = this.pos + step.second;
        return Option::Some(Pair::<i64, u32> { first: start, second: step.first });
    }
}

implement trait Eq for struct Str {
    /// Byte-wise equality. UTF-8 in canonical form compares as
    /// expected; non-canonical input compares byte-by-byte.
    equals(&this, other: &Str) -> boolean {
        if (this.length != other.length()) {
            return false;
        }
        if (this.length == 0) {
            return true;
        }
        return libc::memcmp(
            this.bytes as void*,
            other.bytes as void*,
            this.length as u64
        ) == 0;
    }
}

/// The length, then the bytes: a string's hash is prefix-free, so the
/// parts of a composite key cannot trade bytes and collide
/// (`["ab", "c"]` and `["a", "bc"]` hash apart). Consistent with `Eq`.
implement trait Hash for struct Str {
    hash<H>(&this, hasher: mut &H) -> void
    where H: Hasher {
        hasher.write_uint(this.length as u128, 8);
        hasher.write_bytes(this.as_bytes());
    }
}

/// Lexicographic byte order.  Compares the shared prefix byte-by-byte
/// (bytes as unsigned), and if one string is a prefix of the other the
/// shorter one sorts first.  For canonical UTF-8 this coincides with
/// Unicode-scalar order; non-canonical input orders by raw bytes.
/// Consistent with `Eq for Str` (equal length + equal bytes <=> Equal),
/// so `Str` is a valid `Ord` key and `Array<Str>::sort()` works.
implement trait Ord for struct Str {
    compare(&this, other: &Str) -> Ordering {
        mut min_len: i64 = this.length;
        if (other.length() < min_len) { min_len = other.length(); }
        mut i: i64 = 0;
        while (i < min_len) {
            const ca: u8 = this.bytes[i];
            const cb: u8 = other.bytes[i];
            if (ca < cb) { return Ordering::Less; }
            if (ca > cb) { return Ordering::Greater; }
            i = i + 1;
        }
        if (this.length < other.length()) { return Ordering::Less; }
        if (this.length > other.length()) { return Ordering::Greater; }
        return Ordering::Equal;
    }
}

// Decimal parsing: `TryFrom<Str>` for each integer width
//
// Call sites read `u16::try_from(s)` (with `s: Str`) and get back
// `Result<u16, ConversionError>`.  The resolver dispatches by arg type,
// so the `TryFrom<Str>` impl coexists with `TryFrom<i64>`,
// `TryFrom<u64>`, etc. on the same target.
//
// Hex parsing lives above in a separate `try_to_hex(&this)` method on Str
// since `TryFrom<Str>` can't distinguish decimal from hex on the same
// source type.

implement trait TryFrom<Str> for u64 {
    static try_from(source: Str) -> Result<u64, ConversionError> {
        return source.digits_value(10);
    }
}

implement trait TryFrom<Str> for u32 {
    static try_from(source: Str) -> Result<u32, ConversionError> {
        const value: u64 = u64::try_from(source)?;
        if (value > u32::MAX as u64) {
            return Result::Err(ConversionError::new("u32 overflow"));
        }
        return Result::Ok(value as u32);
    }
}

implement trait TryFrom<Str> for u16 {
    static try_from(source: Str) -> Result<u16, ConversionError> {
        const value: u64 = u64::try_from(source)?;
        if (value > u16::MAX as u64) {
            return Result::Err(ConversionError::new("u16 overflow"));
        }
        return Result::Ok(value as u16);
    }
}

implement trait TryFrom<Str> for u8 {
    static try_from(source: Str) -> Result<u8, ConversionError> {
        const value: u64 = u64::try_from(source)?;
        if (value > u8::MAX as u64) {
            return Result::Err(ConversionError::new("u8 overflow"));
        }
        return Result::Ok(value as u8);
    }
}

// Signed decimal parsing.
//
// `i64::try_from` (over `Str`) is the canonical implementation;
// narrower signed widths delegate to it and re-check the range.
// Handles an optional leading `+` or `-`; treats an empty input or
// a sign with no digits as an error.
//
// `I64_MIN_MAGNITUDE` is the absolute value of `i64::MIN` (2^63).

private const I64_MIN_MAGNITUDE: u64 = (i64::MAX as u64) + 1;

implement trait TryFrom<Str> for i64 {
    static try_from(source: Str) -> Result<i64, ConversionError> {
        if (source.length() == 0) {
            return Result::Err(ConversionError::new("empty input"));
        }
        mut negative: boolean = false;
        mut start: i64 = 0;
        match (source.byte_at(0)) {
            Option::Some(byte) => {
                if (byte == 0x2D) { // '-'
                    negative = true;
                    start = 1;
                } else if (byte == 0x2B) { // '+'
                    start = 1;
                }
            }
            Option::None => {
                return Result::Err(ConversionError::new("byte_at out of range"));
            }
        }
        if (start == source.length()) {
            return Result::Err(ConversionError::new("sign with no digits"));
        }
        const digits: Str = source.sub_bytes(start, source.length());
        const magnitude: u64 = u64::try_from(digits)?;
        if (negative) {
            if (magnitude > I64_MIN_MAGNITUDE) {
                return Result::Err(ConversionError::new("i64 underflow"));
            }
            if (magnitude == I64_MIN_MAGNITUDE) {
                return Result::Ok(i64::MIN);
            }
            return Result::Ok(0 - (magnitude as i64));
        }
        // Positive: magnitude must fit in i64::MAX.
        if (magnitude > i64::MAX as u64) {
            return Result::Err(ConversionError::new("i64 overflow"));
        }
        return Result::Ok(magnitude as i64);
    }
}

implement trait TryFrom<Str> for i32 {
    static try_from(source: Str) -> Result<i32, ConversionError> {
        const value: i64 = i64::try_from(source)?;
        if (value < i32::MIN as i64 || value > i32::MAX as i64) {
            return Result::Err(ConversionError::new("i32 out of range"));
        }
        return Result::Ok(value as i32);
    }
}

implement trait TryFrom<Str> for i16 {
    static try_from(source: Str) -> Result<i16, ConversionError> {
        const value: i64 = i64::try_from(source)?;
        if (value < i16::MIN as i64 || value > i16::MAX as i64) {
            return Result::Err(ConversionError::new("i16 out of range"));
        }
        return Result::Ok(value as i16);
    }
}

implement trait TryFrom<Str> for i8 {
    static try_from(source: Str) -> Result<i8, ConversionError> {
        const value: i64 = i64::try_from(source)?;
        if (value < i8::MIN as i64 || value > i8::MAX as i64) {
            return Result::Err(ConversionError::new("i8 out of range"));
        }
        return Result::Ok(value as i8);
    }
}
