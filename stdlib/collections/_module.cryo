///! collections: growable containers built on `alloc/`.
///!
///! Every container in this module owns heap storage and exposes a
///! manual `drop(mut &this)`. Allocator choice is a type parameter
///! with a `GlobalAlloc` default, so `Array<i32>` and
///! `Array<i32, MyArena>` are both spellable.
///!
///! This module provides: `Array`, `Deque` (a queue growable at both
///! ends), `BinaryHeap` (a priority queue handing out its greatest
///! element), `Str`, `String`, `HashMap`, `HashSet`, `BTreeMap` and
///! `BTreeSet` (kept in key order), `Pair`, and
///! `RawBuffer`, the allocator-backed storage `String` is built on, for a
///! container of your own.

namespace std::collections;

module {
    collections::raw_buffer;
    collections::array;
    collections::deque;
    collections::binary_heap;
    collections::str;
    collections::string;
    collections::hashmap;
    collections::hashset;
    collections::btree_map;
    collections::btree_set;
    collections::pair;
}
