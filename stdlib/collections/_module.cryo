///! collections — growable containers built on `alloc/`.
///!
///! Every container in this module owns heap storage and exposes a
///! manual `drop(mut &this)`. Allocator choice is a type parameter
///! with a `GlobalAlloc` default, so `Array<i32>` and
///! `Array<i32, MyArena>` are both spellable.
///!
///! This module provides: `Array`, `Str`, `String`, `HashMap`, `HashSet`.
///! `RawBuffer` is an internal building block used by `Array` and `String`.

namespace std::collections;

public module collections::raw_buffer;
public module collections::array;
public module collections::str;
public module collections::string;
public module collections::hashmap;
public module collections::hashset;
