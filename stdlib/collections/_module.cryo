///! collections: growable containers built on `alloc/`.
///!
///! Every container in this module owns heap storage and exposes a
///! manual `drop(mut &this)`. Allocator choice is a type parameter
///! with a `GlobalAllocator` default, so `Array<i32>` and
///! `Array<i32, MyArena>` are both spellable.
///!
///! This module provides: `Array`, `Deque` (a queue growable at both
///! ends), `BinaryHeap` (a priority queue handing out its greatest
///! element), `Str`, `String`, `HashMap`, `HashSet`, `BTreeMap` and
///! `BTreeSet` (kept in key order), and `RawBuffer`, the allocator-backed
///! storage `String` is built on, for a container of your own.  `Pair`,
///! the two values a map's entries and `zip` yield, is `core`'s:
///! `import std::core::{ Pair };`.
///!
///!     import std::collections::{ HashMap, HashSet };
///!
///! Each container is offered here by name; `RawBuffer` is reached at its
///! own module, `collections::raw_buffer`.

namespace std::collections;

module {
    collections::raw_buffer;
    collections::array;
    collections::deque;
    collections::binary_heap;
    collections::str;
    collections::string;
    collections::hashmap;
    collections::hashset;
    collections::btree_map;
    collections::btree_set;
}

export std::collections::array::{ Array };
export std::collections::deque::{ Deque };
export std::collections::binary_heap::{ BinaryHeap };
export std::collections::str::{ Str, Utf8Error };
export std::collections::string::{ String };
export std::collections::hashmap::{ HashMap };
export std::collections::hashset::{ HashSet };
export std::collections::btree_map::{ BTreeMap };
export std::collections::btree_set::{ BTreeSet };
