///! String: owned, heap-allocated, length-typed UTF-8.
///!
///! Mutable companion to `Str`. Byte buffer plus a length; no NUL
///! terminator, no implicit encoding assumptions beyond "the bytes
///! are valid UTF-8". UTF-8 in, UTF-8 out.
///!
///! Storage comes from `RawBuffer<u8, A>`; the doubling growth curve
///! lives there.

namespace std::collections::string;

import std::core::intrinsics;
import std::core::option::{ Option };
import std::core::result::{ Result };
import std::core::slice::{ Slice };
import std::alloc::allocator::{ AllocError, AllocErrorKind, Allocator, GlobalAlloc };
import std::collections::raw_buffer::{ RawBuffer };
import std::collections::str::{ CharIndices, Chars, SplitIter, Str };
import std::core::cmp::{ Eq, Ord, Ordering };
import std::core::hash::{ Hash, Hasher };
import std::core::drop::{ Drop };
import std::core::clone::{ Clone };
import std::core::default::{ Default };
import std::alloc::layout::{ Layout };
import std::fmt::display::{ Display, format_to_string };
import std::fmt::error::{ FmtError };
import std::ffi::libc;

private const INITIAL_CAPACITY: i64 = 8;

public type struct String<A = GlobalAlloc> {
    private buffer: RawBuffer<u8, A>;
    private length: i64;

    /// Empty string. No heap storage until the first `push_*` /
    /// `reserve`.
    public static new() -> String {
        return String {
            buffer: RawBuffer::new(),
            length: 0
        };
    }

    public static new_in(alloc: A) -> String<A> {
        return String::<A> {
            buffer: RawBuffer::new_in(alloc),
            length: 0
        };
    }

    /// Preallocate room for `capacity` bytes; a `capacity` of zero or
    /// less allocates nothing. Panics on allocation failure.
    public static with_capacity(capacity: i64) -> String {
        match (String::try_with_capacity_in(capacity, GlobalAlloc::new())) {
            Result::Ok(string) => { return string; }
            Result::Err(_) => {
                core::panic("String::with_capacity: allocation failed", intrinsics::location());
            }
        }
    }

    public static try_with_capacity_in(capacity: i64, alloc: A) -> Result<String<A>, AllocError> {
        mut string: String<A> = String::<A> {
            buffer: RawBuffer::new_in(alloc),
            length: 0
        };
        string.buffer.reserve_exact(0, capacity)?;
        return Result::Ok(string);
    }

    /// Construct from a `Str` by copying its bytes. Panics on
    /// allocation failure.
    public static from_str(source: Str) -> String {
        mut string: String = String::with_capacity(source.length());
        string.push(source);
        return string;
    }

    /// Construct an owned `String` from a `string` (Cryo's raw NUL-terminated
    /// C-string view) by copying its bytes.  Marked `![implicit]`: the compiler
    /// treats this as the constructor when a `string` flows into a `String`
    /// slot - a parameter (`println("text")`) or a typed binding
    /// (`mut s: String = "text"`).  The resulting `String` owns its buffer and
    /// moves into the destination.  Named for its source type (`string`), the
    /// mirror of `from_str` (which takes a `Str`); `with_null` is the inverse
    /// direction (produce a C-facing NUL-terminated buffer).
    ![implicit]
    public static from_string(text: string) -> String {
        return String::from_str(Str::from(text));
    }

    /// Construct a NUL-terminated copy of `source` for handing to C.
    /// The terminating NUL lives in the buffer (so `as_ptr()` yields a
    /// valid `const char*`) but is excluded from the logical length, so
    /// `as_str()` / `length()` see only `source`. Matches C semantics on
    /// an interior NUL: the C side stops reading at the first one.  This is
    /// the produce-*for*-C direction; `from_string` is the consume-*from*-C
    /// one.  Pairs with the `as_cstr()` borrow method.
    public static with_null(source: Str) -> String {
        mut string: String = String::with_capacity(source.length() + 1);
        string.push(source);
        string.push_byte(0 as u8);
        // Drop the terminator from the logical length; the byte stays in
        // the allocation at index `length`.
        string.length = string.length() - 1;
        return string;
    }

    /// Create a `String` from `item`, using the SAME compile-time
    /// `static match (T)` dispatch as `push` - the central `T`-generic
    /// constructor.  `String::from("hi")`, `String::from(65 as u32)`,
    /// `String::from(true)`, `String::from(some_str)` all route through `push`.
    /// Panics on allocation failure.
    public static from<T>(item: T) -> String {
        mut result: String = String::new();
        result.push(item);
        return result;
    }

    /// Append `item`'s `Display` text: a `String`, `Str` or `string`'s bytes
    /// verbatim (a `string`'s terminating NUL is not copied), a `char`
    /// UTF-8-encoded, an integer in decimal (`s.push(65 as u8)` appends
    /// `"65"`), and any other `Display` type as its `fmt` writes it, straight
    /// into the string.  To append a single *raw* byte (not its decimal
    /// text) use `push_byte`.  Panics on allocation failure; use `try_push`
    /// for the fallible form.
    public push<T>(mut &this, item: T) -> void
    where T: Display {
        match (this.try_push(item)) {
            Result::Ok(_) => { return; }
            Result::Err(_) => {
                core::panic("String::push: allocation failed", intrinsics::location());
            }
        }
    }

    /// Fallible `push`: returns `AllocError` instead of panicking.  Text is
    /// copied in directly; every other type is formatted into the string.
    public try_push<T>(mut &this, item: T) -> Result<(), AllocError>
    where T: Display {
        return static match (T) {
            String  => { this.push_view_bytes(item.as_str()) }
            Str     => { this.push_view_bytes(item) }
            string  => { this.push_view_bytes(Str::from(item)) }
            _       => { this.push_display(item) }
        };
    }

    /// Append one Unicode scalar, UTF-8-encoded; a value in the surrogate
    /// range is appended as the replacement character U+FFFD.  Panics on
    /// allocation failure.
    public push_char(mut &this, c: char) -> void {
        this.push(c);
    }

    /// Append `count` copies of the scalar `c`, UTF-8-encoded, growing the
    /// string once.  Zero or less appends nothing.  Panics on allocation
    /// failure, and when the total length overflows `i64`.
    public push_repeated(mut &this, c: char, count: i64) -> void {
        if (count <= 0) { return; }
        const start: i64 = this.length;
        this.push(c);
        const width: i64 = this.length - start;
        const additional: i64 = match (width.checked_multiply(count - 1)) {
            Option::Some(n) => { n }
            Option::None => {
                core::panic("String::push_repeated: length overflows i64", intrinsics::location())
            }
        };
        match (this.reserve_exact(additional)) {
            Result::Ok(_) => { }
            Result::Err(_) => {
                core::panic("String::push_repeated: allocation failed", intrinsics::location());
            }
        }
        for (mut i: i64 = 1; i < count; i++) {
            libc::memcpy(
                (this.buffer.ptr() + this.length) as void*,
                (this.buffer.ptr() + start) as void*,
                width as u64
            );
            this.length = this.length + width;
        }
    }

    /// Append a single **raw** byte (not its decimal text).  For byte-exact
    /// work: NUL terminators, control characters, binary buffers.  The caller
    /// is responsible for keeping the string valid UTF-8.  Panics on
    /// allocation failure; use `try_push_byte` for the fallible form.
    public push_byte(mut &this, byte: u8) -> void {
        match (this.try_push_byte(byte)) {
            Result::Ok(_) => { return; }
            Result::Err(_) => {
                core::panic("String::push_byte: allocation failed", intrinsics::location());
            }
        }
    }

    /// Fallible `push_byte`: append one raw byte, returning `AllocError`
    /// instead of panicking.
    public try_push_byte(mut &this, byte: u8) -> Result<(), AllocError> {
        return this.push_one_byte(byte);
    }

    public clear(mut &this) -> void {
        this.length = 0;
    }

    ![inline]
    public length(&this) -> i64 {
        return this.length;
    }

    ![inline]
    public capacity(&this) -> i64 {
        return this.buffer.capacity();
    }

    public is_empty(&this) -> boolean {
        return this.length == 0;
    }

    /// Borrow as a `Str`. Invalidated by the next mutating call.
    public as_str(&this) -> Str {
        return Str::from_raw(this.buffer.ptr(), this.length);
    }

    public as_bytes(&this) -> Slice<u8> {
        return Slice::from_raw(this.buffer.ptr(), this.length);
    }

    public as_ptr(&this) -> u8* {
        return this.buffer.ptr();
    }

    /// Borrow this String as a NUL-terminated C string (`u8*` /
    /// `const char*`) for handing to an `extern "C"` API.
    ///
    /// A String built by `push`/`from_str` carries no trailing NUL, so
    /// `as_ptr()` alone is not a valid C string. `as_cstr()` writes the
    /// terminator at index `length` - reserving one spare byte if the
    /// buffer is full - WITHOUT changing the logical length, mirroring
    /// the `with_null` invariant. The work is idempotent and zero-alloc
    /// once the spare byte exists.
    ///
    /// The returned pointer borrows this String's buffer: it is valid
    /// until the next mutating call (`push`, `clear`, drop) and must not
    /// be freed by the caller. Like C, an interior NUL ends the string
    /// early; the bytes are not otherwise validated.
    public as_cstr(mut &this) -> u8* {
        match (this.buffer.reserve(this.length, 1, INITIAL_CAPACITY)) {
            Result::Ok(_) => {
                this.buffer.ptr()[this.length] = 0 as u8;
                return this.buffer.ptr();
            }
            Result::Err(_) => {
                core::panic("String::as_cstr: allocation failed", intrinsics::location());
            }
        }
    }

    /// Consume the String and return its NUL-terminated buffer as a raw
    /// `string` (C-string view), leaking the allocation so the caller
    /// owns the bytes with no borrow lifetime. A NUL terminator is
    /// appended first. The owning companion of `Str::sub_bytes` etc. for
    /// handing an owned C-string across the FFI / raw-`string` boundary.
    public into_raw(mut this) -> string {
        this.push_byte(0 as u8);
        const { buffer, length }: String<A> = this;
        return buffer.into_raw() as string;
    }

    // ---- Borrowed-view convenience (delegate to `Str`) ----
    // These forward to the borrowed `as_str()` view so callers don't
    // write `s.as_str().starts_with(...)` everywhere. Returned `Str` /
    // `SplitIter` values borrow this String's buffer and are valid only
    // while it lives and is not mutated.

    public starts_with(&this, prefix: &Str) -> boolean {
        return this.as_str().starts_with(prefix);
    }

    public ends_with(&this, suffix: &Str) -> boolean {
        return this.as_str().ends_with(suffix);
    }

    public find(&this, needle: &Str) -> Option<i64> {
        return this.as_str().find(needle);
    }

    public contains(&this, needle: &Str) -> boolean {
        return this.as_str().contains(needle);
    }

    /// Borrowed sub-slice with surrounding ASCII whitespace removed.
    public trim(&this) -> Str {
        return this.as_str().trim();
    }

    /// Borrowed sub-slice with leading ASCII whitespace removed. Mirrors
    /// `Str::trim_start`, closing the `String` vs `Str` method asymmetry.
    public trim_start(&this) -> Str {
        return this.as_str().trim_start();
    }

    /// Borrowed sub-slice with trailing ASCII whitespace removed. Mirrors
    /// `Str::trim_end`.
    public trim_end(&this) -> Str {
        return this.as_str().trim_end();
    }

    public to_ascii_uppercase(&this) -> String {
        return this.as_str().to_ascii_uppercase();
    }

    /// Fresh `String` with every ASCII uppercase byte folded to lowercase.
    /// Mirrors `Str::to_ascii_lowercase` and the existing
    /// `String::to_ascii_uppercase`.
    public to_ascii_lowercase(&this) -> String {
        return this.as_str().to_ascii_lowercase();
    }

    /// Iterator over pieces separated by `sep` (borrows this String).
    public split(&this, sep: &Str) -> SplitIter {
        return this.as_str().split(sep);
    }

    /// Iterator over Unicode scalar values (`u32`), decoding UTF-8 on the
    /// fly. Borrows this String; see `Str::chars`.
    public chars(&this) -> Chars {
        return this.as_str().chars();
    }

    /// Iterator over `(byte_offset, scalar)` pairs. Borrows this String;
    /// see `Str::char_indices`.
    public char_indices(&this) -> CharIndices {
        return this.as_str().char_indices();
    }

    

    /// Shrink `length` to `new_length`. No reallocation; capacity
    /// is unchanged. Bytes beyond `new_length` are no longer
    /// considered part of the string; subsequent `push_*` calls
    /// will overwrite them.
    ///
    /// **Not UTF-8-aware.** Truncating inside a multi-byte scalar
    /// leaves a malformed suffix. Callers that care are responsible
    /// for aligning `new_length` to a scalar boundary.
    ///
    /// `new_length > this.length` is a no-op, matching the "losing
    /// data is a caller bug" shape of `clear` and `shrink_to_fit`.
    /// A negative `new_length` panics.
    public truncate(mut &this, new_length: i64) -> void {
        if (new_length < 0) {
            core::panic("String::truncate: negative length", intrinsics::location());
        }
        if (new_length < this.length) {
            this.length = new_length;
        }
    }

    /// Room for at least `additional` more bytes; zero or less is a no-op.
    public reserve(mut &this, additional: i64) -> Result<(), AllocError> {
        return this.buffer.reserve(this.length, additional, INITIAL_CAPACITY);
    }

    /// Room for exactly `additional` more bytes; zero or less is a no-op.
    public reserve_exact(mut &this, additional: i64) -> Result<(), AllocError> {
        return this.buffer.reserve_exact(this.length, additional);
    }

    public shrink_to_fit(mut &this) -> void {
        this.buffer.shrink_to(this.length);
    }
    
private:
    /// Append the bytes of a `Str` view verbatim (backs the `Str` / `string`
    /// arms of `try_push`).  Empty input is a no-op.
    push_view_bytes(mut &this, source: Str) -> Result<(), AllocError> {
        const add: i64 = source.length();
        if (add == 0) {
            return Result::Ok(());
        }
        this.buffer.reserve(this.length, add, INITIAL_CAPACITY)?;
        libc::memcpy(
            (this.buffer.ptr() + this.length) as void*,
            source.as_ptr() as void*,
            add as u64
        );
        this.length = this.length + add;
        return Result::Ok(());
    }

    /// Append a single raw byte to the buffer (backs `push_byte` and the
    /// internal C-string NUL terminators).
    push_one_byte(mut &this, byte: u8) -> Result<(), AllocError> {
        if (this.length == this.buffer.capacity()) {
            this.buffer.reserve(this.length, 1, INITIAL_CAPACITY)?;
        }
        this.buffer.ptr()[this.length] = byte;
        this.length++;
        return Result::Ok(());
    }

    /// Render `item`'s `Display` text and append it (backs every non-text
    /// arm of `try_push`).  Formats into a temporary `String` (always
    /// `GlobalAlloc`, so this works regardless of `A`) and copies the bytes
    /// in.  An in-memory sink only ever fails on allocation, so a `FmtError`
    /// is mapped back to an `AllocError`.
    push_display<D>(mut &this, item: D) -> Result<(), AllocError>
    where D: Display {
        match (format_to_string(&item)) {
            Result::Ok(rendered) => {
                const r: Result<(), AllocError> = this.push_view_bytes(rendered.as_str());
                return r;
            }
            Result::Err(fe) => {
                match (fe) {
                    FmtError::Alloc(ae) => { return Result::Err(ae); }
                    FmtError::Io(_) => {
                        // Unreachable for an in-memory String sink (no fd), but
                        // the match must be total; surface it as OOM.
                        return Result::Err(AllocError::new(
                            AllocErrorKind::OutOfMemory, Layout::new(1, 1)));
                    }
                }
            }
        }
    }
}

implement<A> trait Eq for struct String<A>
where A: Allocator {
    equals(&this, other: &String<A>) -> boolean {
        return this.as_str().equals(&other.as_str());
    }
}

/// Hashes as its `Str` view does, so a `String` and a `Str` with the same
/// bytes hash alike.
implement<A> trait Hash for struct String<A>
where A: Allocator {
    hash<H>(&this, hasher: mut &H) -> void
    where H: Hasher {
        this.as_str().hash(hasher);
    }
}

/// Lexicographic byte order, delegating to the borrowed `Str` view so the
/// comparison logic lives in exactly one place (`Ord for Str`). Consistent
/// with `Eq for String`, so an owned `String` is a valid `Ord` key and
/// `Array<String>::sort()` works.
implement<A> trait Ord for struct String<A>
where A: Allocator {
    compare(&this, other: &String<A>) -> Ordering {
        return this.as_str().compare(&other.as_str());
    }
}

/// Release the backing buffer. Ownership obligation: every String
/// must have `drop` called before going out of scope.
implement<A> trait Drop for struct String<A>
where A: Allocator {
    drop(mut &this) -> void {
        this.length = 0;
    }
}

/// Deep copy: allocate fresh storage and copy the bytes, yielding a
/// String that owns its buffer independently of `this`. Cloning the
/// empty string allocates nothing (`from_str` reserves `length` bytes).
implement trait Clone for struct String<GlobalAlloc> {
    clone(&this) -> String {
        return String::from_str(this.as_str());
    }
}

/// The empty string is `String`'s canonical "zero value". Allocates nothing
/// until first mutated, so `String` can satisfy a `Default` bound.
implement trait Default for struct String<GlobalAlloc> {
    static default() -> String {
        return String::new();
    }
}
