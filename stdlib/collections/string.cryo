///! String: owned, heap-allocated, length-typed UTF-8.
///!
///! Mutable companion to `Str`. Byte buffer plus a length; no NUL
///! terminator, no implicit encoding assumptions beyond "the bytes
///! are valid UTF-8". UTF-8 in, UTF-8 out.
///!
///! Storage comes from `RawBuffer<u8, A>`; the doubling growth curve
///! lives there.

namespace std::collections::string;

import core::intrinsics;
import core::option;
import core::result;
import core::slice;
import alloc::allocator;
import collections::raw_buffer;
import collections::str;
import core::cmp;
import core::hash;
import core::drop;
import core::clone;

const INITIAL_CAPACITY: u64 = 8;

type struct String<A = GlobalAlloc> {
    buffer: RawBuffer<u8, A>;
    length: u64;

    /// Empty string. No heap storage until the first `push_*` /
    /// `reserve`.
    static new() -> String {
        return String {
            buffer: RawBuffer::new(),
            length: 0
        };
    }

    static new_in(alloc: A) -> String<A> {
        return String<A> {
            buffer: RawBuffer::new_in(alloc),
            length: 0
        };
    }

    /// Preallocate room for `capacity` bytes. Panics on allocation
    /// failure.
    static with_capacity(capacity: u64) -> String {
        match (String::try_with_capacity_in(capacity, GlobalAlloc::new())) {
            Result::Ok(string) => { return string; }
            Result::Err(_) => {
                intrinsics::panic("String::with_capacity: allocation failed", FILE, LINE);
            }
        }
    }

    static try_with_capacity_in(capacity: u64, alloc: A) -> Result<String<A>, AllocError> {
        mut string: String<A> = String<A> {
            buffer: RawBuffer::new_in(alloc),
            length: 0
        };
        if (capacity == 0) {
            return Result::Ok(string);
        }
        string.buffer.reserve_exact(0, capacity)?;
        return Result::Ok(string);
    }

    /// Construct from a `Str` by copying its bytes. Panics on
    /// allocation failure.
    static from_str(source: Str) -> String {
        mut string: String = String::with_capacity(source.length());
        string.push(source);
        return string;
    }

    /// Construct a NUL-terminated copy of `source` for handing to C.
    /// The terminating NUL lives in the buffer (so `as_ptr()` yields a
    /// valid `const char*`) but is excluded from the logical length, so
    /// `as_str()` / `length()` see only `source`. Matches C semantics on
    /// an interior NUL: the C side stops reading at the first one.
    static from_str_c(source: Str) -> String {
        mut string: String = String::with_capacity(source.length() + 1);
        string.push(source);
        string.push(0 as u8);
        // Drop the terminator from the logical length; the byte stays in
        // the allocation at index `length`.
        string.length = string.length - 1;
        return string;
    }

    length(&this) -> u64 {
        return this.length;
    }

    capacity(&this) -> u64 {
        return this.buffer.capacity();
    }

    is_empty(&this) -> boolean {
        return this.length == 0;
    }

    /// Borrow as a `Str`. Invalidated by the next mutating call.
    as_str(&this) -> Str {
        return Str::from_raw(this.buffer.ptr(), this.length);
    }

    as_bytes(&this) -> Slice<u8> {
        return Slice::from_raw(this.buffer.ptr(), this.length);
    }

    as_ptr(&this) -> u8* {
        return this.buffer.ptr();
    }

    /// Consume the String and return its NUL-terminated buffer as a raw
    /// `string` (C-string view), leaking the allocation so the caller
    /// owns the bytes with no borrow lifetime. A NUL terminator is
    /// appended first. The owning companion of `Str::sub_bytes` etc. for
    /// handing an owned C-string across the FFI / raw-`string` boundary.
    into_raw(mut this) -> string {
        this.push(0 as u8);
        const { buffer, length }: String<A> = this;
        return buffer.into_raw() as string;
    }

    // ---- Borrowed-view convenience (delegate to `Str`) ----
    // These forward to the borrowed `as_str()` view so callers don't
    // write `s.as_str().starts_with(...)` everywhere. Returned `Str` /
    // `SplitIter` values borrow this String's buffer and are valid only
    // while it lives and is not mutated.

    starts_with(&this, prefix: &Str) -> boolean {
        return this.as_str().starts_with(prefix);
    }

    ends_with(&this, suffix: &Str) -> boolean {
        return this.as_str().ends_with(suffix);
    }

    find(&this, needle: &Str) -> Option<u64> {
        return this.as_str().find(needle);
    }

    contains(&this, needle: &Str) -> boolean {
        return this.as_str().contains(needle);
    }

    /// Borrowed sub-slice with surrounding ASCII whitespace removed.
    trim(&this) -> Str {
        return this.as_str().trim();
    }

    to_ascii_uppercase(&this) -> String {
        return this.as_str().to_ascii_uppercase();
    }

    /// Iterator over pieces separated by `sep` (borrows this String).
    split(&this, sep: &Str) -> SplitIter {
        return this.as_str().split(sep);
    }

    push(mut &this, source: Str) -> void {
        match (this.try_push(source)) {
            Result::Ok(_) => { return; }
            Result::Err(_) => {
                intrinsics::panic("String::push: allocation failed", FILE, LINE);
            }
        }
    }

    try_push(mut &this, source: Str) -> Result<(), AllocError> {
        const add: u64 = source.length();
        if (add == 0) {
            return Result::Ok(());
        }
        this.buffer.reserve(this.length, add, INITIAL_CAPACITY)?;
        intrinsics::memcpy(
            (this.buffer.ptr() + this.length) as void*,
            source.as_ptr() as void*,
            add
        );
        this.length = this.length + add;
        return Result::Ok(());
    }

    /// Append a NUL-terminated `string` (C-style literal or `i8*` cast
    /// to `string`).  Length is computed once via `strlen` and the
    /// bytes copied; the NUL itself is not appended.  Use this whenever
    /// you'd otherwise be writing `push(Str::from_raw(lit as u8*,
    /// hand_counted_len))`.
    push_cstr(mut &this, text: string) -> void {
        this.push(Str::from_cstr(text));
    }

    try_push_cstr(mut &this, text: string) -> Result<(), AllocError> {
        return this.try_push(Str::from_cstr(text));
    }

    /// Append a single byte. The caller is responsible for
    /// maintaining valid UTF-8.
    push(mut &this, byte: u8) -> void {
        match (this.try_push(byte)) {
            Result::Ok(_) => { return; }
            Result::Err(_) => {
                intrinsics::panic("String::push: allocation failed", FILE, LINE);
            }
        }
    }

    try_push(mut &this, byte: u8) -> Result<(), AllocError> {
        if (this.length == this.buffer.capacity()) {
            this.buffer.reserve(this.length, 1, INITIAL_CAPACITY)?;
        }
        this.buffer.ptr()[this.length] = byte;
        this.length++;
        return Result::Ok(());
    }

    clear(mut &this) -> void {
        this.length = 0;
    }

    /// Shrink `length` to `new_length`. No reallocation; capacity
    /// is unchanged. Bytes beyond `new_length` are no longer
    /// considered part of the string; subsequent `push_*` calls
    /// will overwrite them.
    ///
    /// **Not UTF-8-aware.** Truncating inside a multi-byte scalar
    /// leaves a malformed suffix. Callers that care are responsible
    /// for aligning `new_length` to a scalar boundary.
    ///
    /// `new_length > this.length` is a no-op, matching the "losing
    /// data is a caller bug" shape of `clear` and `shrink_to_fit`.
    truncate(mut &this, new_length: u64) -> void {
        if (new_length < this.length) {
            this.length = new_length;
        }
    }

    reserve(mut &this, additional: u64) -> Result<(), AllocError> {
        return this.buffer.reserve(this.length, additional, INITIAL_CAPACITY);
    }

    reserve_exact(mut &this, additional: u64) -> Result<(), AllocError> {
        return this.buffer.reserve_exact(this.length, additional);
    }

    shrink_to_fit(mut &this) -> void {
        this.buffer.shrink_to(this.length);
    }
}

implement<A> trait Eq for struct String<A>
where A: Allocator {
    equals(&this, other: &String<A>) -> boolean {
        return this.as_str().equals(&other.as_str());
    }
}

implement<A> trait Hash for struct String<A>
where A: Allocator {
    hash<H>(&this, hasher: mut &H) -> void
    where H: Hasher {
        hasher.write_bytes(this.as_bytes());
    }
}

/// Release the backing buffer. Ownership obligation: every String
/// must have `drop` called before going out of scope.
implement<A> trait Drop for struct String<A>
where A: Allocator {
    drop(mut &this) -> void {
        this.buffer.drop();
        this.length = 0;
    }
}

/// Deep copy: allocate fresh storage and copy the bytes, yielding a
/// String that owns its buffer independently of `this`. Cloning the
/// empty string allocates nothing (`from_str` reserves `length` bytes).
implement trait Clone for struct String {
    clone(&this) -> String {
        return String::from_str(this.as_str());
    }
}
