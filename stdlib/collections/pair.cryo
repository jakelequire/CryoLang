///! Pair<A, B> — an owned two-element tuple.
///!
///! `Pair<A, B>` is `(first: A, second: B)`.  It owns both members and
///! drops them in declaration order when itself dropped — `first`
///! before `second`.  Use it whenever you'd otherwise reach for two
///! parallel arrays or a fresh single-purpose struct to thread two
///! values together.
///!
///! Common idioms:
///!
///!   * Key-value entries: `Pair<string, Argument>[]` is a small
///!     associative list — cheaper than `HashMap` when the count is in
///!     the low tens and the keys don't need a `Hash` impl.
///!   * Multi-return without naming: `fn divmod() -> Pair<i64, i64>`.
///!   * Zipping: `Pair<T, U>` is the natural element type of a zip
///!     iterator over two sequences.
///!
///! The fields are public — `p.first` and `p.second` are the access
///! pattern; there are no getter wrappers.  Trait impls for `Drop` and
///! `Eq` are parametric: a `Pair` is `Drop` iff both members are, and
///! `Eq` iff both members are.

namespace std::collections::pair;

import core::cmp;
import core::drop;

type struct Pair<A, B> {
    first:  A;
    second: B;

    /// Construct a pair from its two members.  Both are moved in by
    /// value; if a member owns heap state, that ownership transfers to
    /// the pair and will be released when the pair itself is dropped.
    static new(first: A, second: B) -> Pair<A, B> {
        return Pair<A, B> { first: first, second: second };
    }
}

// ============================================================================
// Drop — parametric on the members.  Drops `first` before `second`,
// matching declaration order.  If both members are Copy (drop is a
// no-op for them) the call lowers to no IR.
// ============================================================================

implement<A, B> trait Drop for struct Pair<A, B>
where A: Drop, B: Drop {
    drop(mut &this) -> void {
        this.first.drop();
        this.second.drop();
    }
}

// ============================================================================
// Eq — componentwise equality.  Two pairs are equal iff both halves
// are equal under their respective `Eq` impls.
// ============================================================================

implement<A, B> trait Eq for struct Pair<A, B>
where A: Eq, B: Eq {
    equals(&this, other: &Pair<A, B>) -> boolean {
        if (!this.first.equals(&other.first)) { return false; }
        return this.second.equals(&other.second);
    }
}
