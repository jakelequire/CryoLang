///! BinaryHeap: a priority queue that always hands out its greatest element.
///!
///!     import std::collections::binary_heap::{ BinaryHeap };
///!
///!     mut heap: BinaryHeap<i64> = BinaryHeap::new();
///!     heap.push(3);
///!     heap.push(9);
///!     heap.push(4);
///!     const largest: Option<i64> = heap.pop();   // Some(9)
///!
///! The elements are kept in an `Array` laid out as a max-heap: the element
///! at index `i` is no less than those at `2i + 1` and `2i + 2`. `push` and
///! `pop` are O(log n); `peek` is O(1). For the smallest element first,
///! order the elements the other way round with a wrapper whose `Ord` is
///! reversed.

namespace std::collections::binary_heap;

import std::core::option::{ Option };
import std::core::cmp::{ Ord, Ordering };
import std::core::mem;
import std::alloc::allocator::{ Allocator, GlobalAlloc };
import std::collections::array::{ Array };

public type struct BinaryHeap<T, A = GlobalAlloc> where A: Allocator {
    private elements: Array<T, A>;

    /// An empty heap backed by `GlobalAlloc`.
    public static new() -> BinaryHeap<T, GlobalAlloc> {
        return BinaryHeap::<T, GlobalAlloc> { elements: Array::new() };
    }

    /// An empty heap that allocates through `alloc`.
    public static new_in(alloc: A) -> BinaryHeap<T, A> {
        return BinaryHeap::<T, A> { elements: Array::new_in(alloc) };
    }

    /// A heap holding the elements of `elements`, arranged in O(n).
    public static from_array(elements: Array<T, A>) -> BinaryHeap<T, A> where T: Ord {
        mut heap: BinaryHeap<T, A> = BinaryHeap::<T, A> { elements: elements };
        for (mut parent: i64 = heap.elements.length() / 2 - 1; parent >= 0; parent--) {
            heap.sift_down(parent, heap.elements.length());
        }
        return heap;
    }

    public length(&this) -> i64 {
        return this.elements.length();
    }

    public is_empty(&this) -> boolean {
        return this.elements.is_empty();
    }

    /// The greatest element, or `None` when empty.
    public peek(&this) -> Option<T*> {
        return this.elements.first();
    }

    /// Add `value`. Panics on allocation failure.
    public push(mut &this, value: T) -> void where T: Ord {
        this.elements.push(value);
        mut child: i64 = this.elements.length() - 1;
        while (child > 0) {
            const parent: i64 = (child - 1) / 2;
            if (!this.elements[parent].compare(&this.elements[child]).is_lt()) { break; }
            mem::swap::<T>(&this.elements[parent], &this.elements[child]);
            child = parent;
        }
    }

    /// Remove and return the greatest element, or `None` when empty.
    public pop(mut &this) -> Option<T> where T: Ord {
        const length: i64 = this.elements.length();
        if (length == 0) { return Option::None; }
        mem::swap::<T>(&this.elements[0], &this.elements[length - 1]);
        const greatest: Option<T> = this.elements.pop();
        this.sift_down(0, length - 1);
        return greatest;
    }

    /// The elements in ascending order. The heap is used up.
    public into_sorted(mut this) -> Array<T, A> where T: Ord {
        for (mut end: i64 = this.elements.length() - 1; end > 0; end--) {
            mem::swap::<T>(&this.elements[0], &this.elements[end]);
            this.sift_down(0, end);
        }
        const { elements }: BinaryHeap<T, A> = this;
        return elements;
    }

    /// Move the element at `root` down below every larger child, among the
    /// first `end` elements.
    private sift_down(mut &this, start: i64, end: i64) -> void where T: Ord {
        mut root: i64 = start;
        loop {
            mut child: i64 = 2 * root + 1;
            if (child >= end) { return; }
            if (child + 1 < end && this.elements[child].compare(&this.elements[child + 1]).is_lt()) {
                child += 1;
            }
            if (!this.elements[root].compare(&this.elements[child]).is_lt()) { return; }
            mem::swap::<T>(&this.elements[root], &this.elements[child]);
            root = child;
        }
    }
}
