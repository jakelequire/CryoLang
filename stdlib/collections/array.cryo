///! Array<T, A>: growable, heap-backed, contiguous sequence.
///!
///! `{ptr, length, capacity, alloc}` flat layout; first three fields
///! match the legacy `T[]` ABI the self-hosted compiler emits, so a
///! field declared as `string[]` and an `Array<string>::new()` agree
///! on every byte offset.  `RawBuffer<T, A>` (used by `String`) puts
///! capacity before length and is therefore unsuitable for `Array<T>`
///! during the bridge; Array inlines its own resize logic instead.
///!
///! Indexing, `push`, and `pop` operate at the end in amortized O(1);
///! `get` and `set` are O(1).  Algorithms that don't need ownership
///! take `Slice<T>`; call `as_slice()` at the boundary.
///!
///! Growth doubles capacity (min 4 on first allocation).

namespace std::collections::array;

import core::intrinsics;
import core::option;
import core::result;
import core::slice;
import core::mem;
import core::ptr;
import core::drop;
import core::clone;
import core::cmp;
import core::iter;
import alloc::layout;
import alloc::allocator;

/// First-allocation capacity. Small enough that near-empty arrays
/// don't waste memory; large enough to amortize the first few
/// pushes.
const INITIAL_CAPACITY: u64 = 4;


type struct Array<T, A = GlobalAlloc> {
    // Layout: { ptr, length, capacity, alloc }.  ABI-compatible with
    // the legacy `T[]` fat pointer the self-hosted compiler emits.
    ptr:      T*;
    length:   u64;
    capacity: u64;
    alloc:    A;

    /// Empty array backed by `GlobalAlloc`.
    static new() -> Array<T, GlobalAlloc> {
        return Array<T, GlobalAlloc> {
            ptr: null,
            length: 0,
            capacity: 0,
            alloc: GlobalAlloc::new()
        };
    }

    /// Empty array with a caller-supplied allocator.
    static new_in(alloc: A) -> Array<T, A> {
        return Array<T, A> {
            ptr: null,
            length: 0,
            capacity: 0,
            alloc: alloc
        };
    }

    /// Preallocate room for `capacity` elements. Panics on
    /// allocation failure; use `try_with_capacity_in` to recover.
    static with_capacity(capacity: u64) -> Array<T, GlobalAlloc> {
        match (Array::try_with_capacity_in(capacity, GlobalAlloc::new())) {
            Result::Ok(array) => { return array; }
            Result::Err(_) => {
                intrinsics::panic("Array::with_capacity: allocation failed", FILE, LINE);
            }
        }
    }

    static with_capacity_in(capacity: u64, alloc: A) -> Array<T, A> {
        match (Array::try_with_capacity_in(capacity, alloc)) {
            Result::Ok(array) => { return array; }
            Result::Err(_) => {
                intrinsics::panic("Array::with_capacity_in: allocation failed", FILE, LINE);
            }
        }
    }

    static try_with_capacity_in(capacity: u64, alloc: A) -> Result<Array<T, A>, AllocError> {
        mut array: Array<T, A> = Array<T, A> {
            ptr: null,
            length: 0,
            capacity: 0,
            alloc: alloc
        };
        if (capacity == 0) {
            return Result::Ok(array);
        }
        array.resize_storage(capacity)?;
        return Result::Ok(array);
    }

    length(&this) -> u64 {
        return this.length;
    }

    capacity(&this) -> u64 {
        return this.capacity;
    }

    is_empty(&this) -> boolean {
        return this.length == 0;
    }

    /// Bounds-checked read by value. Gated on `T: Copy`: the result is
    /// an independent bitwise duplicate while the array retains ownership
    /// of the stored element, so handing back a copy is only sound when
    /// `T` carries no `Drop` obligation. For owning `T`, borrow in place
    /// with `get_ref` (or move an element out with `swap_remove`/`pop`).
    get(&this, index: u64) -> Option<T> where T: Copy {
        if (index >= this.length) {
            return Option::None;
        }
        return Option::Some(this.ptr[index]);
    }

    /// Bounds-checked borrow. Returns a pointer to the element in place;
    /// the array keeps ownership, so this is sound for every `T` (Copy or
    /// owning). The pointer is invalidated by any reallocating method
    /// (`push`, `reserve`, `shrink_to_fit`).
    get_ref(&this, index: u64) -> Option<T*> {
        if (index >= this.length) {
            return Option::None;
        }
        return Option::Some(mem::offset(this.ptr, index as i64));
    }

    /// Raw pointer. Invalidated by any method that may reallocate
    /// (`push`, `reserve`, `shrink_to_fit`).
    as_ptr(&this) -> T* {
        return this.ptr;
    }

    /// Borrow the initialized prefix. Slice is invalidated by any
    /// reallocating method.
    as_slice(&this) -> Slice<T> {
        return Slice::from_raw(this.ptr, this.length);
    }

    /// Iterate over the elements in order, yielding each by value
    /// (bitwise copy). Gated on `T: Copy` for the same reason as `get`:
    /// a yielded owning value would alias storage the array still owns.
    /// For owning `T`, walk by index with `length()` + `get_ref`. The
    /// iterator is invalidated by any reallocating method on the array
    /// (`push`, `reserve`, `shrink_to_fit`).
    iter(&this) -> implement Iterator<T> where T: Copy {
        return SliceIter<T> { ptr: this.ptr, remaining: this.length };
    }

    /// Iterate by shared borrow, yielding `T*` for each element in
    /// order. Unlike `iter`, this is sound for every `T` (Copy or
    /// owning) because it hands out borrows, never copies. The pointers
    /// are invalidated by any reallocating method (`push`, `reserve`,
    /// `insert`, `shrink_to_fit`). This is the way to walk an
    /// `Array<String>` / `Array<Box<...>>` without cloning.
    iter_ref(&this) -> implement Iterator<T*> {
        return RefIter<T> { ptr: this.ptr, index: 0, length: this.length };
    }

    push(mut &this, value: T) -> void {
        match (this.try_push(value)) {
            Result::Ok(_) => { return; }
            Result::Err(_) => {
                intrinsics::panic("Array::push: allocation failed", FILE, LINE);
            }
        }
    }

    try_push(mut &this, value: T) -> Result<(), AllocError> {
        if (this.length == this.capacity) {
            this.reserve_grow(1)?;
        }
        this.ptr[this.length] = value;
        this.length = this.length + 1;
        return Result::Ok(());
    }

    pop(mut &this) -> Option<T> {
        if (this.length == 0) {
            return Option::None;
        }
        this.length = this.length - 1;
        return Option::Some(this.ptr[this.length]);
    }

    /// Overwrite the element at `index`, taking ownership of `value`.
    /// The previous occupant is dropped before the slot is reused: a
    /// raw slot store (`this.ptr[index] = value`) does NOT drop the
    /// destination, so for owning `T` (`String`, `Box<T>`, ...) the
    /// old element's resources would otherwise leak. The `where T: Drop`
    /// bound is satisfied by every type (POD types drop to no IR), so
    /// this restricts nothing. Panics on out-of-range.
    set(mut &this, index: u64, value: T) -> void
    where T: Drop {
        if (index >= this.length) {
            intrinsics::panic("Array::set: index out of range", FILE, LINE);
        }
        mut prev: T* = this.get_ref(index).unwrap();
        prev.drop();
        this.ptr[index] = value;
    }

    /// Remove at `index` by swapping in the last element. O(1) but
    /// doesn't preserve order. Panics on out-of-range.
    swap_remove(mut &this, index: u64) -> T {
        if (index >= this.length) {
            intrinsics::panic("Array::swap_remove: index out of range", FILE, LINE);
        }
        const removed: T = this.ptr[index];
        const last: u64 = this.length - 1;
        if (index != last) {
            this.ptr[index] = this.ptr[last];
        }
        this.length = last;
        return removed;
    }

    /// First element by shared borrow, or `None` if empty. Sound for
    /// every `T` (the array keeps ownership). Invalidated by any
    /// reallocating method.
    first(&this) -> Option<T*> {
        if (this.length == 0) { return Option::None; }
        return Option::Some(this.ptr);
    }

    /// Last element by shared borrow, or `None` if empty.
    last(&this) -> Option<T*> {
        if (this.length == 0) { return Option::None; }
        return Option::Some(mem::offset(this.ptr, (this.length - 1) as i64));
    }

    /// Index of the first element equal to `value`, or `None`. Linear
    /// scan; `T: Eq`.
    index_of(&this, value: &T) -> Option<u64> where T: Eq {
        mut i: u64 = 0;
        while (i < this.length) {
            if (this.ptr[i].equals(value)) {
                return Option::Some(i);
            }
            i = i + 1;
        }
        return Option::None;
    }

    /// True if some element equals `value`. `T: Eq`.
    contains(&this, value: &T) -> boolean where T: Eq {
        match (this.index_of(value)) {
            Option::Some(_) => { return true; }
            Option::None    => { return false; }
        }
    }

    /// Reverse the elements in place. Sound for owning `T`: each pair is
    /// exchanged with a three-step move (identical to `mem::swap`'s body,
    /// inlined here so the method stays self-contained — see note below).
    reverse(mut &this) -> void {
        if (this.length < 2) { return; }
        mut lo: u64 = 0;
        mut hi: u64 = this.length - 1;
        while (lo < hi) {
            // Inlined move-swap. `mem::swap` is deliberately NOT called:
            // the monomorphizer does not queue a cross-module generic
            // free function (`core::mem::swap<T>`) referenced from a
            // force-emitted method body, so calling it leaves an
            // undefined symbol for `Array<T>` instantiations that never
            // call `sort`. `mem::offset` is already emitted for every
            // `Array<T>` (used by `get_ref`), so it stays a call.
            const a: T* = mem::offset(this.ptr, lo as i64);
            const b: T* = mem::offset(this.ptr, hi as i64);
            const tmp: T = *a;
            *a = *b;
            *b = tmp;
            lo = lo + 1;
            hi = hi - 1;
        }
    }

    /// Insert `value` at `index`, shifting later elements right by one.
    /// `index == length` appends. Panics if `index > length`. Panics on
    /// allocation failure; use the `Result`-returning forms for recovery
    /// via `try_push` if you need fallibility on the common (append) path.
    insert(mut &this, index: u64, value: T) -> void {
        if (index > this.length) {
            intrinsics::panic("Array::insert: index out of range", FILE, LINE);
        }
        if (this.length == this.capacity) {
            match (this.reserve_grow(1)) {
                Result::Ok(_) => { }
                Result::Err(_) => {
                    intrinsics::panic("Array::insert: allocation failed", FILE, LINE);
                }
            }
        }
        const tail: u64 = this.length - index;
        if (tail > 0) {
            // Shift [index, length) right by one slot. memmove handles the
            // overlap; this relocates owning elements without aliasing.
            intrinsics::memmove(
                mem::offset(this.ptr, (index + 1) as i64) as void*,
                mem::offset(this.ptr, index as i64) as void*,
                tail * sizeof(T)
            );
        }
        this.ptr[index] = value;
        this.length = this.length + 1;
    }

    /// Remove and return the element at `index`, shifting later elements
    /// left by one to preserve order (O(n)). Panics if out of range. For
    /// O(1) removal when order doesn't matter, use `swap_remove`.
    remove(mut &this, index: u64) -> T {
        if (index >= this.length) {
            intrinsics::panic("Array::remove: index out of range", FILE, LINE);
        }
        const removed: T = this.ptr[index];
        const tail: u64 = this.length - index - 1;
        if (tail > 0) {
            // Shift [index+1, length) left by one over the vacated slot.
            intrinsics::memmove(
                mem::offset(this.ptr, index as i64) as void*,
                mem::offset(this.ptr, (index + 1) as i64) as void*,
                tail * sizeof(T)
            );
        }
        this.length = this.length - 1;
        return removed;
    }

    /// Shorten to at most `new_length`, dropping the truncated elements
    /// via `T::drop`. A no-op if `new_length >= length`. Keeps capacity.
    truncate(mut &this, new_length: u64) -> void
    where T: Drop {
        if (new_length >= this.length) { return; }
        mut i: u64 = new_length;
        while (i < this.length) {
            this.ptr[i].drop();
            i++;
        }
        this.length = new_length;
    }

    /// Drop every initialized element (the `[0, length)` prefix) via
    /// `T::drop`, then reset the length to zero while keeping the backing
    /// capacity.  Mirrors `drop`'s element teardown so `Array<String>`,
    /// `Array<Box<...>>`, and similar owning shapes don't leak their
    /// contents.  The `where T: Drop` bound makes the element drop sound
    /// (primitives' impls are no-ops).  Follow with `shrink_to_fit` to
    /// release the capacity, or `drop` when the array itself goes away.
    clear(mut &this) -> void
    where T: Drop {
        mut i: u64 = 0;
        while (i < this.length) {
            this.ptr[i].drop();
            i++;
        }
        this.length = 0;
    }

    /// Sort the array in place, ascending, by `T::compare`.
    ///
    /// Hybrid in-place quicksort: median-of-three pivot above a cutoff,
    /// insertion sort below.  O(n log n) average; O(n^2) adversarial
    /// worst case (pure quicksort, no introsort fallback in v1.0).
    /// **Not stable** - equal elements may be reordered.  No allocation.
    ///
    /// The bound is `T: Ord`; primitives, `String`, and any user type
    /// that implements `Ord` are accepted.  Owning `T`s are moved
    /// in place via `mem::swap` so the array's drop obligation stays
    /// intact (every initialised slot still gets dropped exactly once).
    sort(mut &this) -> void where T: Ord {
        if (this.length < 2) { return; }
        sort_range<T>(this.ptr, 0, this.length);
    }

    /// Sort in place using a user-supplied "less-than" predicate.
    /// Returns no value; mutates the array.  Same complexity and
    /// stability as `sort()`.  The predicate must impose a strict
    /// weak ordering (irreflexive, transitive, with the implied
    /// equivalence being transitive) or the result is unspecified.
    ///
    /// `less` is a function pointer; non-capturing lambdas convert
    /// implicitly.  Capturing closures passed in method position are
    /// rejected (E0458) in v1.0 - capture by indirection if you need
    /// state (`mut state: State*; (a, b) -> boolean { ... state.x ... }`)
    /// or pull the sort into a free function and use the free-function
    /// closure-arg path.
    sort_by(mut &this, less: (&T, &T) -> boolean) -> void {
        if (this.length < 2) { return; }
        sort_range_by<T>(this.ptr, 0, this.length, less);
    }

    /// Append every element of `source` to the end of this array.
    /// Panics on allocation failure; use `try_append` to recover.
    ///
    /// Gated on `T: Copy` for the same reason as `get`/`iter`: the bulk
    /// append is a bitwise `memcpy` out of the borrowed `source`, so for an
    /// owning `T` both arrays would end up owning the same heap buffers and
    /// double-free on drop. For owning `T`, append elements one at a time
    /// with `push` after cloning, or move them out of `source` by index.
    append(mut &this, source: Slice<T>) -> void where T: Copy {
        match (this.try_append(source)) {
            Result::Ok(_) => { return; }
            Result::Err(_) => {
                intrinsics::panic("Array::append: allocation failed", FILE, LINE);
            }
        }
    }

    /// Fallible bulk append. Reserves space for all elements first so
    /// partial copies are impossible; either all elements are appended
    /// or none are. Gated on `T: Copy` (see `append`): the append is a
    /// bitwise `memcpy` out of the borrowed `source`.
    try_append(mut &this, source: Slice<T>) -> Result<(), AllocError> where T: Copy {
        const add: u64 = source.length();
        if (add == 0) { return Result::Ok(()); }
        this.reserve_grow(add)?;
        intrinsics::memcpy(
            mem::offset(this.ptr, this.length as i64) as void*,
            source.as_ptr() as void*,
            add * sizeof(T)
        );
        this.length = this.length + add;
        return Result::Ok(());
    }

    reserve(mut &this, additional: u64) -> Result<(), AllocError> {
        return this.reserve_grow(additional);
    }

    reserve_exact(mut &this, additional: u64) -> Result<(), AllocError> {
        const required: u64 = this.length + additional;
        // A wrapped `length + additional` (sum < length) means the requested
        // capacity can't be represented in u64. Reject it rather than
        // under-sizing: `try_append` would otherwise see `required <=
        // capacity`, skip the realloc, and memcpy `additional` elements past
        // the end of the buffer. Mirrors RawBuffer::reserve_exact.
        if (required < this.length) {
            return Result::Err(AllocError::new(
                AllocErrorKind::OutOfMemory, Layout::array<T>(this.length)));
        }
        if (required <= this.capacity) {
            return Result::Ok(());
        }
        return this.resize_storage( required);
    }

    /// Internal: ensure at least `additional` more slots fit, doubling
    /// past `INITIAL_CAPACITY`.  Inline of what `RawBuffer::reserve`
    /// did before Array dropped its RawBuffer dependency.
    reserve_grow(mut &this, additional: u64) -> Result<(), AllocError> {
        const required: u64 = this.length + additional;
        // See reserve_exact: reject a wrapped `length + additional` rather than
        // under-allocating and overrunning the buffer in the caller's memcpy.
        if (required < this.length) {
            return Result::Err(AllocError::new(
                AllocErrorKind::OutOfMemory, Layout::array<T>(this.length)));
        }
        if (required <= this.capacity) {
            return Result::Ok(());
        }
        return this.resize_storage(next_capacity(this.capacity, required, INITIAL_CAPACITY));
    }

    shrink_to_fit(mut &this) -> void {
        const target: u64 = this.length;
        if (target >= this.capacity) { return; }
        if (target == 0) {
            if (this.ptr != null) {
                this.alloc.deallocate(
                    NonNull::new(this.ptr as u8*),
                    Layout::array<T>(this.capacity)
                );
            }
            this.ptr = null;
            this.capacity = 0;
            return;
        }
        match (this.resize_storage( target)) {
            Result::Ok(_) => { }
            Result::Err(_) => { }
        }
    }

    // Internal: backing-storage resize
    //
    // Method (not free function) so the monomorphizer specializes it
    // alongside the rest of Array<T, A>'s body when a downstream module
    // uses Array<X>::with_capacity / push / etc.  A free generic
    // `resize_array<T, A>(...)` would link as the unspecialized
    // GenericParam-named symbol from `try_with_capacity_in`'s callers.

    resize_storage(mut &this, new_capacity: u64) -> Result<(), AllocError> {
        if (new_capacity == this.capacity) {
            return Result::Ok(());
        }
        mut new_layout: Layout = Layout { size: 0, alignment: 0 };
        match (Layout::try_array<T>(new_capacity)) {
            Option::Some(l) => { new_layout = l; }
            Option::None    => {
                return Result::Err(AllocError::new(
                    AllocErrorKind::OutOfMemory, Layout::of<T>()));
            }
        }
        if (this.ptr == null) {
            const raw: NonNull<u8> = this.alloc.allocate(new_layout)?;
            this.ptr = raw.as_ptr() as T*;
            this.capacity = new_capacity;
            return Result::Ok(());
        }
        const old_layout: Layout = Layout::array<T>(this.capacity);
        const raw: NonNull<u8> = this.alloc.reallocate(
            NonNull::new(this.ptr as u8*),
            old_layout,
            new_layout
        )?;
        this.ptr = raw.as_ptr() as T*;
        this.capacity = new_capacity;
        return Result::Ok(());
    }
}

/// Release the backing storage. Drops every initialized element (the
/// `[0, length)` prefix) via `T::drop` before reclaiming the allocation,
/// so `Array<String>`, `Array<Box<...>>`, and similar owning shapes don't
/// leak. Ownership obligation: every Array must have `drop` called
/// before going out of scope. Primitive `T`s have no-op `Drop` impls,
/// so `Array<u32>` etc. still compile to a single deallocation.
implement<T, A> trait Drop for struct Array<T, A>
where T: Drop, A: Allocator {
    drop(mut &this) -> void {
        mut i: u64 = 0;
        while (i < this.length) {
            this.ptr[i].drop();
            i++;
        }
        if (this.ptr != null) {
            this.alloc.deallocate(
                NonNull::new(this.ptr as u8*),
                Layout::array<T>(this.capacity)
            );
        }
        this.ptr = null;
        this.length = 0;
        this.capacity = 0;
    }
}

/// Collect every element an iterator yields into a fresh `Array<T>`, in order.
/// `it` is consumed.  `T` is recovered from the iterator's `Iterator<T>` impl,
/// and the result element type is fixed by the expected type at the call site:
///
///   mut v: Array<i32> = from_iter(r.map(square));
///
/// A free function rather than an `Iterator::collect` trait default on purpose:
/// a non-self-returning default would be cloned into EVERY `Iterator` impl,
/// including the by-reference `RefIter<T>` over `Array<T>`, whose clone would
/// instantiate `Array<T>` -> `RefIter<T>` over it -> `Array<T*>` -> `Array<T**>`
/// -> ... a genuinely-new pointer level each round, diverging monomorphization
/// until OOM.  As a free function, only concrete call sites instantiate it, so
/// there is no divergence.
function from_iter<I, T>(it: I) -> Array<T> where I: Iterator<T> {
    mut iter: I = it;
    mut out: Array<T> = Array<T>::new();
    loop {
        match (iter.next()) {
            Option::Some(value) => { out.push(value); }
            Option::None => { break; }
        }
    }
    return out;
}

// Sort helpers ----------------------------------------------------------------
//
// Free functions rather than methods so they're reachable from both
// `sort()` and `sort_by()` without re-stating the where bound at every
// call site, and so recursive quicksort doesn't have to thread `mut &this`
// through the recursion.  Operate on a raw `T*` + `[lo, hi)` half-open
// range; the caller (`sort` / `sort_by`) is responsible for validating
// the range against the array's length before the first call.

/// Length cutoff for switching from quicksort to insertion sort. 16 is
/// the canonical value; small enough that insertion sort's O(n^2) is
/// faster than quicksort's per-element overhead, large enough to avoid
/// recursing all the way down.
const SORT_INSERTION_CUTOFF: u64 = 16;

function sort_range<T>(ptr: T*, lo: u64, hi: u64) -> void where T: Ord {
    if (hi - lo < SORT_INSERTION_CUTOFF) {
        sort_insertion<T>(ptr, lo, hi);
        return;
    }
    const pivot_idx: u64 = sort_partition<T>(ptr, lo, hi);
    sort_range<T>(ptr, lo, pivot_idx);
    sort_range<T>(ptr, pivot_idx + 1, hi);
}

function sort_insertion<T>(ptr: T*, lo: u64, hi: u64) -> void where T: Ord {
    mut i: u64 = lo + 1;
    while (i < hi) {
        mut j: u64 = i;
        // Walk j backwards while ptr[j-1] > ptr[j].  Stop at lo.
        while (j > lo) {
            const ord: Ordering = ptr[j - 1].compare(&ptr[j]);
            match (ord) {
                Ordering::Greater => {
                    mem::swap<T>(mem::offset(ptr, (j - 1) as i64),
                                 mem::offset(ptr,  j      as i64));
                    j = j - 1;
                }
                Ordering::Less    => { break; }
                Ordering::Equal   => { break; }
            }
        }
        i = i + 1;
    }
}

/// Median-of-three pivot: pick the median of `ptr[lo]`, `ptr[mid]`,
/// `ptr[hi-1]` as the pivot, move it to `ptr[hi-1]`, then partition
/// `[lo, hi-1)` around its value.  Returns the final pivot index.
function sort_partition<T>(ptr: T*, lo: u64, hi: u64) -> u64 where T: Ord {
    const mid: u64 = lo + (hi - lo) / 2;
    sort_order_pair<T>(ptr, lo,     mid);
    sort_order_pair<T>(ptr, lo,     hi - 1);
    sort_order_pair<T>(ptr, mid,    hi - 1);
    // After the three pair-orderings, ptr[lo] <= ptr[mid] <= ptr[hi-1].
    // Stash the median (ptr[mid]) at hi-1 as the pivot.
    mem::swap<T>(mem::offset(ptr, mid       as i64),
                 mem::offset(ptr, (hi - 1)  as i64));
    // Lomuto partition over [lo, hi-1) with pivot at ptr[hi-1].
    mut store: u64 = lo;
    mut k:     u64 = lo;
    while (k < hi - 1) {
        const ord: Ordering = ptr[k].compare(&ptr[hi - 1]);
        match (ord) {
            Ordering::Less    => {
                mem::swap<T>(mem::offset(ptr, store as i64),
                             mem::offset(ptr, k     as i64));
                store = store + 1;
            }
            Ordering::Equal   => { }
            Ordering::Greater => { }
        }
        k = k + 1;
    }
    mem::swap<T>(mem::offset(ptr, store    as i64),
                 mem::offset(ptr, (hi - 1) as i64));
    return store;
}

function sort_order_pair<T>(ptr: T*, i: u64, j: u64) -> void where T: Ord {
    const ord: Ordering = ptr[i].compare(&ptr[j]);
    match (ord) {
        Ordering::Greater => {
            mem::swap<T>(mem::offset(ptr, i as i64),
                         mem::offset(ptr, j as i64));
        }
        Ordering::Less  => { }
        Ordering::Equal => { }
    }
}

// `sort_by` helpers - identical shape to the Ord versions but route
// comparisons through a caller-supplied `less` predicate.  Duplicated
// rather than parameterised because Cryo's free-function generics can
// take a fn-typed parameter directly, and the duplication keeps the
// hot inner loops monomorphic and obvious.

function sort_range_by<T>(ptr: T*, lo: u64, hi: u64,
                          less: (&T, &T) -> boolean) -> void {
    if (hi - lo < SORT_INSERTION_CUTOFF) {
        sort_insertion_by<T>(ptr, lo, hi, less);
        return;
    }
    const pivot_idx: u64 = sort_partition_by<T>(ptr, lo, hi, less);
    sort_range_by<T>(ptr, lo, pivot_idx,    less);
    sort_range_by<T>(ptr, pivot_idx + 1, hi, less);
}

function sort_insertion_by<T>(ptr: T*, lo: u64, hi: u64,
                              less: (&T, &T) -> boolean) -> void {
    mut i: u64 = lo + 1;
    while (i < hi) {
        mut j: u64 = i;
        while (j > lo) {
            if (less(&ptr[j], &ptr[j - 1])) {
                mem::swap<T>(mem::offset(ptr, (j - 1) as i64),
                             mem::offset(ptr,  j      as i64));
                j = j - 1;
            } else {
                break;
            }
        }
        i = i + 1;
    }
}

function sort_partition_by<T>(ptr: T*, lo: u64, hi: u64,
                              less: (&T, &T) -> boolean) -> u64 {
    const mid: u64 = lo + (hi - lo) / 2;
    sort_order_pair_by<T>(ptr, lo,  mid,     less);
    sort_order_pair_by<T>(ptr, lo,  hi - 1,  less);
    sort_order_pair_by<T>(ptr, mid, hi - 1,  less);
    mem::swap<T>(mem::offset(ptr, mid       as i64),
                 mem::offset(ptr, (hi - 1)  as i64));
    mut store: u64 = lo;
    mut k:     u64 = lo;
    while (k < hi - 1) {
        if (less(&ptr[k], &ptr[hi - 1])) {
            mem::swap<T>(mem::offset(ptr, store as i64),
                         mem::offset(ptr, k     as i64));
            store = store + 1;
        }
        k = k + 1;
    }
    mem::swap<T>(mem::offset(ptr, store    as i64),
                 mem::offset(ptr, (hi - 1) as i64));
    return store;
}

function sort_order_pair_by<T>(ptr: T*, i: u64, j: u64,
                               less: (&T, &T) -> boolean) -> void {
    if (less(&ptr[j], &ptr[i])) {
        mem::swap<T>(mem::offset(ptr, i as i64),
                     mem::offset(ptr, j as i64));
    }
}

/// Deep copy: allocate a fresh buffer sized to `length` and clone each
/// element into it, so the two arrays own independent storage and their
/// elements are independent. Requires `T: Clone`.
implement<T> trait Clone for struct Array<T>
where T: Clone {
    clone(&this) -> Array<T> {
        mut out: Array<T> = Array<T>::with_capacity(this.length);
        mut i: u64 = 0;
        while (i < this.length) {
            out.push(this.ptr[i].clone());
            i++;
        }
        return out;
    }
}


/// Borrowing iterator over an `Array<T>`, yielding `T*` (a pointer to
/// each element in place). Created by `Array::iter_ref`; sound for
/// owning `T`. Invalidated by any reallocating method on the array.
///
/// `private`: this cursor is an implementation detail. Callers obtain it
/// only as the opaque `implement Iterator<T*>` returned by `iter_ref`, and
/// never name it.
private type struct RefIter<T> {
    ptr:    T*;
    index:  u64;
    length: u64;

    /// Adapt this by-reference iterator into a by-value one that yields
    /// each pointee `T` by bitwise copy: `arr.iter_ref().copied()`. Sound
    /// only when `T: Copy` (that bound lives on `CopiedIter`'s `Iterator`
    /// impl). Defined here, on the pointer-yielding cursor, rather than as
    /// an `Iterator` default — `copied` is meaningful only for iterators
    /// whose element is a pointer, and Cryo has no `where Item == T*`
    /// bound to gate a trait method on that condition.
    copied(this) -> implement Iterator<T> where T: Copy {
        // Struct-literal form of `CopiedIter::new(this)` so the opaque return
        // type can be inferred from the body (return-type inference resolves
        // the literal's `CopiedIter<RefIter<T>>` directly).
        return CopiedIter<RefIter<T>> { inner: this };
    }

    /// Like `copied`, but clones each pointee via `Clone` into an owned
    /// value: `strings.iter_ref().cloned()` walks an `Array<String>` by
    /// value, which the `Copy`-gated `iter()` can't.
    cloned(this) -> implement Iterator<T> where T: Clone {
        // Struct-literal form of `ClonedIter::new(this)`; see `copied`.
        return ClonedIter<RefIter<T>> { inner: this };
    }
}

implement<T> trait Iterator<T*> for struct RefIter<T> {
    next(mut &this) -> Option<T*> {
        if (this.index >= this.length) {
            return Option::None;
        }
        const elem: T* = mem::offset(this.ptr, this.index as i64);
        this.index = this.index + 1;
        return Option::Some(elem);
    }
}

/// Adapter dereferencing each `T*` yielded by `inner` into a `T` by bitwise
/// copy. Bridges the by-reference `RefIter` cursor to the by-value consumers,
/// so an owning collection needs no separate by-value iterator struct. The
/// element type `T` is recovered from the inner iterator via the
/// `where I: Iterator<T*>` bound (the monomorphizer peels the `T*`), so it is
/// not a struct parameter. Sound only when `T: Copy`.
///
/// `private`: produced only as the opaque `implement Iterator<T>` returned by
/// `RefIter::copied`; never named outside this module. Lives here, with the
/// `RefIter` it bridges, rather than in `core::iter`.
private type struct CopiedIter<I> {
    inner: I;

    static new(inner: I) -> CopiedIter<I> {
        return CopiedIter<I> { inner: inner };
    }
}

implement<I, T> trait Iterator<T> for struct CopiedIter<I>
where I: Iterator<T*>, T: Copy {
    next(mut &this) -> Option<T> {
        return match (this.inner.next()) {
            Option::Some(p) => { Option::Some(*p) }
            Option::None    => { Option::None }
        };
    }
}

/// Adapter cloning each `T*` yielded by `inner` into an owned `T` via `Clone`.
/// The owning-type counterpart of `CopiedIter`: this is what lets a `loop`/`for`
/// over `strings.iter_ref()` walk an `Array<String>` by value (each element an
/// independent clone) — something the `Copy`-gated `iter()` can't express.
///
/// `private`: same rationale as `CopiedIter`; produced only as the opaque
/// `implement Iterator<T>` returned by `RefIter::cloned`.
private type struct ClonedIter<I> {
    inner: I;

    static new(inner: I) -> ClonedIter<I> {
        return ClonedIter<I> { inner: inner };
    }
}

implement<I, T> trait Iterator<T> for struct ClonedIter<I>
where I: Iterator<T*>, T: Clone {
    next(mut &this) -> Option<T> {
        return match (this.inner.next()) {
            Option::Some(p) => { Option::Some((*p).clone()) }
            Option::None    => { Option::None }
        };
    }
}
