///! Array<T, A>: growable, heap-backed, contiguous sequence.
///!
///! `{ptr, length, capacity, alloc}` flat layout; first three fields
///! match the legacy `[T]` ABI the self-hosted compiler emits, so a
///! field declared as `[string]` and an `Array<string>::new()` agree
///! on every byte offset.  `RawBuffer<T, A>` (used by `String`) puts
///! capacity before length and is therefore unsuitable for `Array<T>`
///! during the bridge; Array inlines its own resize logic instead.
///!
///! Indexing, `push`, and `pop` operate at the end in amortized O(1);
///! `get` and `set` are O(1).  Algorithms that don't need ownership
///! take `&Slice<T>`, which a `&Array<T>` converts to.
///!
///! Growth doubles capacity (min 4 on first allocation).

namespace std::collections::array;

import std::core::intrinsics;
import std::core::option::{ Option };
import std::core::result::{ Result };
import std::core::slice::{ AsMutableSlice, AsSlice, Slice, SliceIndex, SliceIter, SliceRange };
import std::core::mem;
import std::core::ptr::{ NonNull };
import std::core::drop::{ Drop };
import std::core::clone::{ Clone };
import std::core::cmp::{ Eq, Ord, Ordering };
import std::core::hash::{ Hash, Hasher };
import std::core::default::{ Default };
import std::core::iter::{ FromIterator, Iterator };
import std::core::ops::{ Index, IndexMutable, IndexView, IndexViewMutable };
import std::alloc::layout::{ Layout };
import std::alloc::allocator::{
    AllocError, AllocErrorKind, Allocator, GlobalAlloc, next_capacity
};
import std::collections::raw_buffer::{ RawBuffer };
import std::ffi::libc;

/// First-allocation capacity. Small enough that near-empty arrays
/// don't waste memory; large enough to amortize the first few
/// pushes.
private const INITIAL_CAPACITY: i64 = 4;


/// A growable sequence of `T`s stored contiguously, owning its elements;
/// `A` is the allocator its storage comes from. Indexing out of range
/// panics; `get` answers `None` instead.
///
/// ```cryo
/// import std::collections::array::{ Array };
///
/// mut numbers: Array<i32> = Array::new();
/// numbers.push(3);
/// numbers.push(4);
/// const last: Option<i32> = numbers.pop();   // Some(4)
/// ```
![language("array")]
public type struct Array<T, A = GlobalAlloc> where A: Allocator {
    // Layout: { ptr, length, capacity, alloc }.  ABI-compatible with
    // the legacy `[T]` fat pointer the self-hosted compiler emits.
    private ptr:      mut T*;
    private length:   i64;
    private capacity: i64;
    private alloc:    A;

    /// Empty array backed by `GlobalAlloc`.
    public static new() -> Array<T, GlobalAlloc> {
        return Array::<T, GlobalAlloc> {
            ptr: null,
            length: 0,
            capacity: 0,
            alloc: GlobalAlloc::new()
        };
    }

    /// Empty array with a caller-supplied allocator.
    public static new_in(alloc: A) -> Array<T, A> {
        return Array::<T, A> {
            ptr: null,
            length: 0,
            capacity: 0,
            alloc: alloc
        };
    }

    /// Preallocate room for `capacity` elements; a `capacity` of zero or
    /// less allocates nothing. Panics on allocation failure; use
    /// `try_with_capacity_in` to recover.
    public static with_capacity(capacity: i64) -> Array<T, GlobalAlloc> {
        match (Array::<T, GlobalAlloc>::try_with_capacity_in(capacity, GlobalAlloc::new())) {
            Result::Ok(array) => { return array; }
            Result::Err(_) => {
                core::panic("Array::with_capacity: allocation failed", intrinsics::location());
            }
        }
    }

    /// An empty array with room for `capacity` elements, allocated through
    /// `alloc`. Panics on allocation failure; `try_with_capacity_in`
    /// returns the error instead.
    public static with_capacity_in(capacity: i64, alloc: A) -> Array<T, A> {
        match (Array::<T, A>::try_with_capacity_in(capacity, alloc)) {
            Result::Ok(array) => { return array; }
            Result::Err(_) => {
                core::panic("Array::with_capacity_in: allocation failed", intrinsics::location());
            }
        }
    }

    /// An empty array with room for `capacity` elements, allocated through
    /// `alloc`, or the `AllocError` when the storage cannot be had. A
    /// `capacity` of zero or less allocates nothing.
    public static try_with_capacity_in(capacity: i64, alloc: A) -> Result<Array<T, A>, AllocError> {
        mut array: Array<T, A> = Array::<T, A> {
            ptr: null,
            length: 0,
            capacity: 0,
            alloc: alloc
        };
        if (capacity <= 0) {
            return Result::Ok(array);
        }
        array.resize_storage(capacity)?;
        return Result::Ok(array);
    }

    /// The number of elements in the array.
    ![inline]
    public length(&this) -> i64 {
        return this.length;
    }

    /// How many elements fit before the array must grow its storage.
    ![inline]
    public capacity(&this) -> i64 {
        return this.capacity;
    }

    /// True when the array has no elements.
    public is_empty(&this) -> boolean {
        return this.length == 0;
    }

    /// Bounds-checked read by value; `None` for an index outside
    /// `[0, length)`, a negative one included. Gated on `T: Copy`: the
    /// result is an independent bitwise duplicate while the array retains
    /// ownership of the stored element, so handing back a copy is only
    /// sound when `T` carries no `Drop` obligation. For owning `T`, borrow
    /// in place with `get_ref` (or move an element out with
    /// `swap_remove`/`pop`).
    public get(&this, index: i64) -> Option<T> where T: Copy {
        if (index < 0 || index >= this.length) {
            return Option::None;
        }
        return Option::Some(this.ptr[index]);
    }

    /// Bounds-checked borrow; `None` for an index outside `[0, length)`.
    /// Returns a pointer to the element in place; the array keeps
    /// ownership, so this is sound for every `T` (Copy or owning). The
    /// pointer is invalidated by any reallocating method (`push`,
    /// `reserve`, `shrink_to_fit`).
    public get_ref(&this, index: i64) -> Option<T*> {
        if (index < 0 || index >= this.length) {
            return Option::None;
        }
        return Option::Some(mem::const_offset(this.ptr, index));
    }

    /// Read-only raw pointer to the first element. Invalidated by any
    /// method that may reallocate (`push`, `reserve`, `shrink_to_fit`).
    public as_ptr(&this) -> T* {
        return this.ptr;
    }

    /// Writable raw pointer to the first element, from an array held
    /// writably. Invalidated as `as_ptr` is.
    public as_mutable_ptr(mut &this) -> mut T* {
        return this.ptr;
    }

    /// Iterate over the elements in order, yielding each by value
    /// (bitwise copy). Gated on `T: Copy` for the same reason as `get`:
    /// a yielded owning value would alias storage the array still owns.
    /// For owning `T`, walk by index with `length()` + `get_ref`. The
    /// iterator is invalidated by any reallocating method on the array
    /// (`push`, `reserve`, `shrink_to_fit`).
    public iter(&this) -> implement Iterator<T> where T: Copy {
        return SliceIter::<T> { ptr: this.ptr, remaining: this.length };
    }

    /// Iterate by shared borrow, yielding `T*` for each element in
    /// order. Unlike `iter`, this is sound for every `T` (Copy or
    /// owning) because it hands out borrows, never copies. The pointers
    /// are invalidated by any reallocating method (`push`, `reserve`,
    /// `insert`, `shrink_to_fit`). This is the way to walk an
    /// `Array<String>` / `Array<Box<...>>` without cloning.
    public iter_ref(&this) -> implement Iterator<T*> {
        return RefIter::<T> { ptr: this.ptr, index: 0, length: this.length };
    }

    /// Add `value` after the last element, growing the storage when it is
    /// full. Panics on allocation failure; `try_push` returns the error
    /// instead.
    public push(mut &this, value: T) -> void {
        match (this.try_push(value)) {
            Result::Ok(_) => { return; }
            Result::Err(_) => {
                core::panic("Array::push: allocation failed", intrinsics::location());
            }
        }
    }

    /// `push` that returns `Err(AllocError)` instead of panicking when the
    /// storage cannot grow; the array is unchanged by a failed push.
    public try_push(mut &this, value: T) -> Result<(), AllocError> {
        if (this.length == this.capacity) {
            this.reserve_grow(1)?;
        }
        this.ptr[this.length] = value;
        this.length = this.length + 1;
        return Result::Ok(());
    }

    /// Remove the last element and return it, or `None` when the array is
    /// empty. The capacity is kept.
    public pop(mut &this) -> Option<T> {
        if (this.length == 0) {
            return Option::None;
        }
        this.length = this.length - 1;
        return Option::Some(this.ptr[this.length]);
    }

    /// Overwrite the element at `index`, taking ownership of `value`.
    /// The previous occupant is released in place before the slot is
    /// reused: a raw slot store (`this.ptr[index] = value`) does NOT drop
    /// the destination, so for owning `T` (`String`, `Box<T>`, ...) the
    /// old element's resources would otherwise leak. Panics on an index
    /// outside `[0, length)`.
    public set(mut &this, index: i64, value: T) -> void {
        if (index < 0 || index >= this.length) {
            core::panic("Array::set: index out of range", intrinsics::location());
        }
        mut prev: T* = this.get_ref(index).unwrap();
        ptr::drop_in_place::<T>(prev);
        this.ptr[index] = value;
    }

    /// Remove at `index` by swapping in the last element. O(1) but
    /// doesn't preserve order. Panics on an index outside `[0, length)`.
    public swap_remove(mut &this, index: i64) -> T {
        if (index < 0 || index >= this.length) {
            core::panic("Array::swap_remove: index out of range", intrinsics::location());
        }
        const removed: T = this.ptr[index];
        const last: i64 = this.length - 1;
        if (index != last) {
            this.ptr[index] = this.ptr[last];
        }
        this.length = last;
        return removed;
    }

    /// First element by shared borrow, or `None` if empty. Sound for
    /// every `T` (the array keeps ownership). Invalidated by any
    /// reallocating method.
    public first(&this) -> Option<T*> {
        if (this.length == 0) { return Option::None; }
        return Option::Some(this.ptr);
    }

    /// Last element by shared borrow, or `None` if empty.
    public last(&this) -> Option<T*> {
        if (this.length == 0) { return Option::None; }
        return Option::Some(mem::const_offset(this.ptr, this.length - 1));
    }

    /// Index of the first element equal to `value`, or `None`. Linear
    /// scan; `T: Eq`.
    public index_of(&this, value: &T) -> Option<i64> where T: Eq {
        mut i: i64 = 0;
        while (i < this.length) {
            if (this.ptr[i].equals(value)) {
                return Option::Some(i);
            }
            i = i + 1;
        }
        return Option::None;
    }

    /// True if some element equals `value`. `T: Eq`.
    public contains(&this, value: &T) -> boolean where T: Eq {
        match (this.index_of(value)) {
            Option::Some(_) => { return true; }
            Option::None    => { return false; }
        }
    }

    /// Reverse the elements in place. Sound for owning `T`: each pair is
    /// exchanged with a three-step move (identical to `mem::swap`'s body,
    /// inlined here so the method stays self-contained - see note below).
    public reverse(mut &this) -> void {
        if (this.length < 2) { return; }
        mut lo: i64 = 0;
        mut hi: i64 = this.length - 1;
        while (lo < hi) {
            // Inlined move-swap. `mem::swap` is deliberately NOT called:
            // the monomorphizer does not queue a cross-module generic
            // free function (`core::mem::swap<T>`) referenced from a
            // force-emitted method body, so calling it leaves an
            // undefined symbol for `Array<T>` instantiations that never
            // call `sort`. `mem::offset` is already emitted for every
            // `Array<T>` (used by `get_ref`), so it stays a call.
            const a: mut T* = mem::offset(this.ptr, lo);
            const b: mut T* = mem::offset(this.ptr, hi);
            // A permutation of two slots the array keeps owning: each value
            // read out is balanced by the store that immediately replaces it,
            // so the block covers all three statements.
            unsafe {
                const tmp: T = *a;
                *a = *b;
                *b = tmp;
            }
            lo = lo + 1;
            hi = hi - 1;
        }
    }

    /// Insert `value` at `index`, shifting later elements right by one.
    /// `index == length` appends. Panics if `index` is negative or
    /// `index > length`. Panics on allocation failure; use the
    /// `Result`-returning forms for recovery via `try_push` if you need
    /// fallibility on the common (append) path.
    public insert(mut &this, index: i64, value: T) -> void {
        if (index < 0 || index > this.length) {
            core::panic("Array::insert: index out of range", intrinsics::location());
        }
        if (this.length == this.capacity) {
            match (this.reserve_grow(1)) {
                Result::Ok(_) => { }
                Result::Err(_) => {
                    core::panic("Array::insert: allocation failed", intrinsics::location());
                }
            }
        }
        const tail: i64 = this.length - index;
        if (tail > 0) {
            // Shift [index, length) right by one slot. memmove handles the
            // overlap; this relocates owning elements without aliasing.
            libc::memmove(
                mem::offset(this.ptr, index + 1),
                mem::offset(this.ptr, index),
                (tail as u64) * sizeof(T)
            );
        }
        this.ptr[index] = value;
        this.length = this.length + 1;
    }

    /// Remove and return the element at `index`, shifting later elements
    /// left by one to preserve order (O(n)). Panics on an index outside
    /// `[0, length)`. For O(1) removal when order doesn't matter, use
    /// `swap_remove`.
    public remove(mut &this, index: i64) -> T {
        if (index < 0 || index >= this.length) {
            core::panic("Array::remove: index out of range", intrinsics::location());
        }
        const removed: T = this.ptr[index];
        const tail: i64 = this.length - index - 1;
        if (tail > 0) {
            // Shift [index+1, length) left by one over the vacated slot.
            libc::memmove(
                mem::offset(this.ptr, index),
                mem::offset(this.ptr, index + 1),
                (tail as u64) * sizeof(T)
            );
        }
        this.length = this.length - 1;
        return removed;
    }

    /// Shorten to at most `new_length`, releasing the truncated elements
    /// in place. A no-op if `new_length >= length`; a negative
    /// `new_length` panics. Keeps capacity.
    public truncate(mut &this, new_length: i64) -> void {
        if (new_length < 0) {
            core::panic("Array::truncate: negative length", intrinsics::location());
        }
        if (new_length >= this.length) { return; }
        mut i: i64 = new_length;
        while (i < this.length) {
            ptr::drop_in_place::<T>(&this.ptr[i]);
            i++;
        }
        this.length = new_length;
    }

    /// Release every initialized element (the `[0, length)` prefix) in
    /// place, then reset the length to zero while keeping the backing
    /// capacity.  Mirrors `drop`'s element teardown so `Array<String>`,
    /// `Array<Box<...>>`, and similar owning shapes don't leak their
    /// contents.  Follow with `shrink_to_fit` to release the capacity, or
    /// `drop` when the array itself goes away.
    public clear(mut &this) -> void {
        mut i: i64 = 0;
        while (i < this.length) {
            ptr::drop_in_place::<T>(&this.ptr[i]);
            i++;
        }
        this.length = 0;
    }

    /// Sort the array in place, ascending by `T`'s `Ord`. The sort is
    /// stable: equal elements keep the order they had. It takes
    /// O(n log n) comparisons on every input and allocates a buffer as
    /// long as the array; `sort_unstable` allocates nothing.
    public sort(mut &this) -> void where T: Ord {
        this.sort_by(T::compare);
    }

    /// Sort the array in place by `compare`, which says how its first
    /// argument orders against its second. Stable, as `sort` is. When
    /// `compare` is not a total order the elements end up in some order,
    /// each exactly once.
    public sort_by<F>(mut &this, compare: F) -> void where F: (&T, &T) -> Ordering {
        merge_sort::<T, F>(this.ptr, this.length, compare);
    }

    /// Sort the array in place, ascending by the key `key` gives each
    /// element. Stable, as `sort` is; `key` is called twice per comparison.
    public sort_by_key<K, F>(mut &this, key: F) -> void where F: (&T) -> K, K: Ord {
        this.sort_by((a: &T, b: &T) -> Ordering { return key(a).compare(&key(b)); });
    }

    /// Sort the array in place, ascending by `T`'s `Ord`, without
    /// allocating. Equal elements may change places. It takes
    /// O(n log n) comparisons on every input: a quicksort that turns to a
    /// heapsort for any range it has split too often.
    public sort_unstable(mut &this) -> void where T: Ord {
        this.sort_unstable_by(T::compare);
    }

    /// Sort the array in place by `compare`, as `sort_unstable` does.
    public sort_unstable_by<F>(mut &this, compare: F) -> void where F: (&T, &T) -> Ordering {
        introsort::<T, F>(this.ptr, this.length, compare);
    }

    /// Find `value` in an array sorted ascending: `Ok` with the index of
    /// an element equal to it, or `Err` with the index it would be
    /// inserted at to keep the order. On an unsorted array the answer is
    /// some index, not necessarily a meaningful one.
    public binary_search(&this, value: &T) -> Result<i64, i64> where T: Ord {
        return this.binary_search_by((element: &T) -> Ordering { return element.compare(value); });
    }

    /// Search an array sorted in the order `compare` describes. `compare`
    /// says how an element orders against the one sought: `Less` for an
    /// element before it, `Greater` for one after it. Answers as
    /// `binary_search` does.
    public binary_search_by<F>(&this, compare: F) -> Result<i64, i64> where F: (&T) -> Ordering {
        mut low: i64 = 0;
        mut high: i64 = this.length;
        while (low < high) {
            const middle: i64 = low + (high - low) / 2;
            match (compare(&this.ptr[middle])) {
                Ordering::Less => { low = middle + 1; }
                Ordering::Greater => { high = middle; }
                Ordering::Equal => { return Result::Ok(middle); }
            }
        }
        return Result::Err(low);
    }

    /// Keep only the elements `keep` answers true for, in their order,
    /// releasing the others.
    public retain<F>(mut &this, keep: F) -> void where F: (&T) -> boolean {
        mut kept: i64 = 0;
        for (mut index: i64 = 0; index < this.length; index++) {
            if (keep(&this.ptr[index])) {
                if (kept != index) {
                    mem::copy::<T>(mem::offset(this.ptr, kept), mem::offset(this.ptr, index), 1);
                }
                kept += 1;
            } else {
                ptr::drop_in_place::<T>(&this.ptr[index]);
            }
        }
        this.length = kept;
    }

    /// Release every element equal to the one before it, so each run of
    /// equal neighbours keeps only its first element. On a sorted array
    /// that leaves each value once.
    public dedup(mut &this) -> void where T: Eq {
        if (this.length < 2) { return; }
        mut kept: i64 = 1;
        for (mut index: i64 = 1; index < this.length; index++) {
            if (this.ptr[index].equals(&this.ptr[kept - 1])) {
                ptr::drop_in_place::<T>(&this.ptr[index]);
            } else {
                if (kept != index) {
                    mem::copy::<T>(mem::offset(this.ptr, kept), mem::offset(this.ptr, index), 1);
                }
                kept += 1;
            }
        }
        this.length = kept;
    }

    /// Append every element of `source` to the end of this array.
    /// Panics on allocation failure; use `try_append` to recover.
    ///
    /// Gated on `T: Copy` for the same reason as `get`/`iter`: the bulk
    /// append is a bitwise `memcpy` out of the borrowed `source`, so for an
    /// owning `T` both arrays would end up owning the same heap buffers and
    /// double-free on drop. For owning `T`, append elements one at a time
    /// with `push` after cloning, or move them out of `source` by index.
    public append(mut &this, source: &Slice<T>) -> void where T: Copy {
        match (this.try_append(source)) {
            Result::Ok(_) => { return; }
            Result::Err(_) => {
                core::panic("Array::append: allocation failed", intrinsics::location());
            }
        }
    }

    /// Fallible bulk append. Reserves space for all elements first so
    /// partial copies are impossible; either all elements are appended
    /// or none are. Gated on `T: Copy` (see `append`): the append is a
    /// bitwise `memcpy` out of the borrowed `source`.
    public try_append(mut &this, source: &Slice<T>) -> Result<(), AllocError> where T: Copy {
        const add: i64 = source.length();
        if (add == 0) { return Result::Ok(()); }
        this.reserve_grow(add)?;
        libc::memcpy(
            mem::offset(this.ptr, this.length),
            source.as_ptr(),
            (add as u64) * sizeof(T)
        );
        this.length = this.length + add;
        return Result::Ok(());
    }

    /// Set the length to exactly `new_length`, filling any new slots with
    /// `value`. Shrinking drops the elements above `new_length`, exactly as
    /// `truncate` does; growing leaves every slot initialized, so the whole
    /// `[0, new_length)` range is readable afterwards.
    ///
    /// This is how a fixed-size read buffer is built: an array only exposes
    /// `[0, length)`, so `with_capacity` alone yields nothing to read INTO.
    ///
    /// Gated on `T: Copy` for the same reason as `append` - each new slot is a
    /// bitwise copy of `value`, so for an owning `T` every one of them would own
    /// the same heap buffer and they would all free it.  A negative
    /// `new_length` panics, as in `truncate`.
    public resize(mut &this, new_length: i64, value: T) -> void where T: Copy {
        match (this.try_resize(new_length, value)) {
            Result::Ok(_)  => { return; }
            Result::Err(_) => {
                core::panic("Array::resize: allocation failed", intrinsics::location());
            }
        }
    }

    /// Fallible `resize`. Reserves the whole growth up front, so the array is
    /// either resized or left exactly as it was - never partially grown.
    public try_resize(mut &this, new_length: i64, value: T) -> Result<(), AllocError>
    where T: Copy {
        if (new_length <= this.length) {
            this.truncate(new_length);
            return Result::Ok(());
        }
        this.reserve_grow(new_length - this.length)?;
        mut i: i64 = this.length;
        while (i < new_length) {
            this.ptr[i] = value;
            i++;
        }
        this.length = new_length;
        return Result::Ok(());
    }

    /// Room for at least `additional` more elements; zero or less is a
    /// no-op.
    public reserve(mut &this, additional: i64) -> Result<(), AllocError> {
        return this.reserve_grow(additional);
    }

    /// Room for exactly `additional` more elements; zero or less is a
    /// no-op.
    public reserve_exact(mut &this, additional: i64) -> Result<(), AllocError> {
        if (additional <= 0) {
            return Result::Ok(());
        }
        const required: i64 = this.length + additional;
        // A `length + additional` that does not fit in an `i64` wraps below
        // `length`.  Reject it rather than under-sizing: `try_append` would
        // otherwise see `required <= capacity`, skip the realloc, and memcpy
        // `additional` elements past the end of the buffer.
        if (required < this.length) {
            return Result::Err(AllocError::new(
                AllocErrorKind::OutOfMemory, Layout::array::<T>(this.length)));
        }
        if (required <= this.capacity) {
            return Result::Ok(());
        }
        return this.resize_storage(required);
    }

    /// Ensure at least `additional` more slots fit, doubling past
    /// `INITIAL_CAPACITY`.
    private reserve_grow(mut &this, additional: i64) -> Result<(), AllocError> {
        if (additional <= 0) {
            return Result::Ok(());
        }
        const required: i64 = this.length + additional;
        // See reserve_exact: reject a `length + additional` that does not fit
        // rather than under-allocating and overrunning the caller's memcpy.
        if (required < this.length) {
            return Result::Err(AllocError::new(
                AllocErrorKind::OutOfMemory, Layout::array::<T>(this.length)));
        }
        if (required <= this.capacity) {
            return Result::Ok(());
        }
        return this.resize_storage(next_capacity(this.capacity, required, INITIAL_CAPACITY));
    }

    /// Give back the storage beyond the current length, so the capacity
    /// equals the length; an empty array releases all of it.
    public shrink_to_fit(mut &this) -> void {
        const target: i64 = this.length;
        if (target >= this.capacity) { return; }
        if (target == 0) {
            if (this.ptr != null) {
                this.alloc.deallocate(
                    NonNull::new(this.ptr as mut u8*),
                    Layout::array::<T>(this.capacity)
                );
            }
            this.ptr = null;
            this.capacity = 0;
            return;
        }
        match (this.resize_storage(target)) {
            Result::Ok(_) => { }
            Result::Err(_) => { }
        }
    }

    // Backing-storage resize.
    //
    // Method (not free function) so the monomorphizer specializes it
    // alongside the rest of Array<T, A>'s body when a downstream module
    // uses Array<X>::with_capacity / push / etc.  A free generic
    // `resize_array<T, A>(...)` would link as the unspecialized
    // GenericParam-named symbol from `try_with_capacity_in`'s callers.

    private resize_storage(mut &this, new_capacity: i64) -> Result<(), AllocError> {
        if (new_capacity == this.capacity) {
            return Result::Ok(());
        }
        const new_layout: Layout = match (Layout::try_array::<T>(new_capacity)) {
            Option::Some(l) => { l }
            Option::None    => {
                return Result::Err(AllocError::new(
                    AllocErrorKind::OutOfMemory, Layout::of::<T>()));
            }
        };

        if (this.ptr == null) {
            const raw: NonNull<u8> = this.alloc.allocate(new_layout)?;
            this.ptr = raw.as_ptr() as mut T*;
            this.capacity = new_capacity;
            return Result::Ok(());
        }
        const old_layout: Layout = Layout::array::<T>(this.capacity);
        const raw: NonNull<u8> = this.alloc.reallocate(
            NonNull::new(this.ptr as mut u8*),
            old_layout,
            new_layout
        )?;
        this.ptr = raw.as_ptr() as mut T*;
        this.capacity = new_capacity;
        return Result::Ok(());
    }
}

// The initialized prefix, as a slice. Invalidated by any reallocating
// method (`push`, `reserve`, `shrink_to_fit`).
implement<T, A> trait AsSlice<T> for struct Array<T, A> {
    as_slice(&this) -> &Slice<T> {
        return Slice::from_raw(this.ptr, this.length);
    }
}
implement<T, A> trait AsMutableSlice<T> for struct Array<T, A> {
    as_mutable_slice(mut &this) -> mut &Slice<T> {
        return Slice::from_raw_mutable(this.ptr, this.length);
    }
}

/// Release every initialized element (the `[0, length)` prefix) in place,
/// then the buffer.  An element is released by its own destructor and its
/// fields' glue, whichever it has; one that owns nothing releases as a
/// no-op, so every element type gets its buffer back.
implement<T, A> trait Drop for struct Array<T, A>
where A: Allocator {
    drop(mut &this) -> void {
        mut i: i64 = 0;
        while (i < this.length) {
            ptr::drop_in_place::<T>(&this.ptr[i]);
            i++;
        }
        if (this.ptr != null) {
            this.alloc.deallocate(
                NonNull::new(this.ptr as mut u8*),
                Layout::array::<T>(this.capacity)
            );
        }
        this.ptr = null;
        this.length = 0;
        this.capacity = 0;
    }
}

/// An array of every element an iterator yields, in order: what `collect`
/// builds for `Array<T>`.
implement<T> trait FromIterator<T> for struct Array<T, GlobalAlloc> {
    static from_iterator<I>(source: I) -> Array<T> where I: Iterator<T> {
        mut out: Array<T> = Array::<T>::new();
        for (value in source) {
            out.push(value);
        }
        return out;
    }
}

// Sorting ---------------------------------------------------------------------
//
// Both sorts work on `length` elements from `items` and take the comparison
// by value, calling it only in their own body: a capturing closure handed on
// to a second function would be moved there.

/// Below this many elements a range is put in order by insertion, which is
/// faster there than splitting it further.
private const SORT_INSERTION_CUTOFF: i64 = 16;

/// A stable bottom-up merge sort. Runs of `SORT_INSERTION_CUTOFF` elements
/// are put in order by insertion, then neighbouring runs are merged at
/// doubling widths. A merge moves its left run into a buffer and moves
/// elements back one at a time, taking the left run's element on a tie,
/// which is what keeps equal elements in order. Every move is a bitwise
/// one, so each element is owned exactly once throughout.
private function merge_sort<T, F>(items: mut T*, length: i64, compare: F) -> void where F: (&T, &T) -> Ordering {
    if (length < 2) { return; }
    for (mut start: i64 = 0; start < length; start += SORT_INSERTION_CUTOFF) {
        mut end: i64 = start + SORT_INSERTION_CUTOFF;
        if (end > length) { end = length; }
        for (mut index: i64 = start + 1; index < end; index++) {
            mut at: i64 = index;
            while (at > start && compare(&items[at - 1], &items[at]).is_gt()) {
                mem::swap::<T>(mem::offset(items, at - 1), mem::offset(items, at));
                at -= 1;
            }
        }
    }
    if (length <= SORT_INSERTION_CUTOFF) { return; }
    mut buffer: RawBuffer<T> = RawBuffer::new();
    match (buffer.reserve_exact(0, length)) {
        Result::Ok(_) => { }
        Result::Err(_) => { core::panic("Array::sort: allocation failed", intrinsics::location()); }
    }
    const spare: mut T* = buffer.ptr();
    for (mut width: i64 = SORT_INSERTION_CUTOFF; width < length; width *= 2) {
        for (mut low: i64 = 0; low + width < length; low += 2 * width) {
            const middle: i64 = low + width;
            mut high: i64 = middle + width;
            if (high > length) { high = length; }
            // Two runs already in order need no merge.
            if (!compare(&items[middle - 1], &items[middle]).is_gt()) { continue; }
            const left_length: i64 = middle - low;
            for (mut index: i64 = 0; index < left_length; index++) {
                mem::copy::<T>(mem::offset(spare, index), mem::offset(items, low + index), 1);
            }
            // While the left run is not used up, `out` stays below `right`:
            // the gap between them is the count of left elements still in
            // the buffer.
            mut left: i64 = 0;
            mut right: i64 = middle;
            mut out: i64 = low;
            while (left < left_length && right < high) {
                if (compare(&items[right], &spare[left]).is_lt()) {
                    mem::copy::<T>(mem::offset(items, out), mem::offset(items, right), 1);
                    right += 1;
                } else {
                    mem::copy::<T>(mem::offset(items, out), mem::offset(spare, left), 1);
                    left += 1;
                }
                out += 1;
            }
            // What is left of the right run is already in place.
            while (left < left_length) {
                mem::copy::<T>(mem::offset(items, out), mem::offset(spare, left), 1);
                left += 1;
                out += 1;
            }
        }
    }
}

/// An in-place quicksort that cannot go quadratic. A range is split around
/// the median of its first, middle and last elements; a range of
/// `SORT_INSERTION_CUTOFF` or fewer is put in order by insertion, and a
/// range that has been split twice log2(length) times without getting that
/// small is heapsorted instead. The smaller side of every split is sorted
/// first and the larger one waits in `pending`, so at most log2(length)
/// ranges wait at once: 63 for any `i64` length, three slots each.
private function introsort<T, F>(items: mut T*, length: i64, compare: F) -> void where F: (&T, &T) -> Ordering {
    if (length < 2) { return; }
    mut depth_limit: i64 = 0;
    for (mut remaining: i64 = length; remaining > 1; remaining /= 2) {
        depth_limit += 2;
    }
    mut pending: [i64; 192] = [0; 192];
    mut waiting: i64 = 0;
    mut low: i64 = 0;
    mut high: i64 = length;
    mut depth: i64 = depth_limit;
    loop {
        if (high - low <= SORT_INSERTION_CUTOFF) {
            for (mut index: i64 = low + 1; index < high; index++) {
                mut at: i64 = index;
                while (at > low && compare(&items[at - 1], &items[at]).is_gt()) {
                    mem::swap::<T>(mem::offset(items, at - 1), mem::offset(items, at));
                    at -= 1;
                }
            }
        } else if (depth == 0) {
            // A max-heap over [low, high): first built by sifting down
            // every parent, last to first, then emptied by swapping its
            // root to the end of the shrinking heap and sifting the new
            // root down.
            const size: i64 = high - low;
            mut heap_end: i64 = size;
            mut next_parent: i64 = size / 2;
            loop {
                mut root: i64 = 0;
                if (next_parent > 0) {
                    next_parent -= 1;
                    root = next_parent;
                } else {
                    heap_end -= 1;
                    if (heap_end <= 0) { break; }
                    mem::swap::<T>(mem::offset(items, low), mem::offset(items, low + heap_end));
                }
                loop {
                    mut child: i64 = 2 * root + 1;
                    if (child >= heap_end) { break; }
                    if (child + 1 < heap_end && compare(&items[low + child], &items[low + child + 1]).is_lt()) {
                        child += 1;
                    }
                    if (!compare(&items[low + root], &items[low + child]).is_lt()) { break; }
                    mem::swap::<T>(mem::offset(items, low + root), mem::offset(items, low + child));
                    root = child;
                }
            }
        } else {
            depth -= 1;
            // Order the first, middle and last elements, then park the
            // median at `high - 1` as the pivot and partition the rest
            // around it.
            const middle: i64 = low + (high - low) / 2;
            if (compare(&items[middle], &items[low]).is_lt()) {
                mem::swap::<T>(mem::offset(items, middle), mem::offset(items, low));
            }
            if (compare(&items[high - 1], &items[low]).is_lt()) {
                mem::swap::<T>(mem::offset(items, high - 1), mem::offset(items, low));
            }
            if (compare(&items[high - 1], &items[middle]).is_lt()) {
                mem::swap::<T>(mem::offset(items, high - 1), mem::offset(items, middle));
            }
            mem::swap::<T>(mem::offset(items, middle), mem::offset(items, high - 1));
            mut store: i64 = low;
            for (mut index: i64 = low; index < high - 1; index++) {
                if (compare(&items[index], &items[high - 1]).is_lt()) {
                    mem::swap::<T>(mem::offset(items, store), mem::offset(items, index));
                    store += 1;
                }
            }
            mem::swap::<T>(mem::offset(items, store), mem::offset(items, high - 1));
            if (store - low < high - store - 1) {
                pending[waiting] = store + 1;
                pending[waiting + 1] = high;
                pending[waiting + 2] = depth;
                high = store;
            } else {
                pending[waiting] = low;
                pending[waiting + 1] = store;
                pending[waiting + 2] = depth;
                low = store + 1;
            }
            waiting += 3;
            continue;
        }
        if (waiting == 0) { break; }
        waiting -= 3;
        low = pending[waiting];
        high = pending[waiting + 1];
        depth = pending[waiting + 2];
    }
}

/// Deep copy: allocate a fresh buffer sized to `length` and clone each
/// element into it, so the two arrays own independent storage and their
/// elements are independent. Requires `T: Clone`.
implement<T> trait Clone for struct Array<T, GlobalAlloc>
where T: Clone {
    clone(&this) -> Array<T> {
        mut out: Array<T> = Array::<T>::with_capacity(this.length);
        mut i: i64 = 0;
        while (i < this.length) {
            out.push(this.ptr[i].clone());
            i++;
        }
        return out;
    }
}

/// A fresh empty `Array` - the canonical "zero value" so `Array<T>` can be a
/// `T: Default` field / satisfy a `Default` bound. Allocates nothing.
implement<T> trait Default for struct Array<T, GlobalAlloc> {
    static default() -> Array<T> {
        return Array::<T>::new();
    }
}

// Eq / Hash carry the FULL `<T, A>` arity (like `Drop` above), not the
// defaulted-allocator `<T>` form `Clone` uses: a bare-name method call
// (`.equals()`) resolves against either, but a *trait bound* - `Array<i32>` as
// a `HashMap` key, or `T: Eq`/`T: Hash` on a fully-applied
// `Array<i32, GlobalAlloc>` - is only satisfied when the impl names the
// allocator param too.

/// Element-wise equality: equal length and every element equal in order.
implement<T, A> trait Eq for struct Array<T, A>
where T: Eq, A: Allocator {
    equals(&this, other: &Array<T, A>) -> boolean {
        if (this.length != other.length()) { return false; }
        mut i: i64 = 0;
        while (i < this.length) {
            if (!this.ptr[i].equals(&other.ptr[i])) { return false; }
            i = i + 1;
        }
        return true;
    }
}

/// Order-sensitive hash: fold the length first (so `[1, 2]` and `[1, 2, 0]`
/// differ) then each element in order. Consistent with `Eq` above.
implement<T, A> trait Hash for struct Array<T, A>
where T: Hash, A: Allocator {
    hash<H>(&this, hasher: mut &H) -> void
    where H: Hasher {
        this.length.hash(hasher);
        mut i: i64 = 0;
        while (i < this.length) {
            this.ptr[i].hash(hasher);
            i = i + 1;
        }
    }
}


/// Borrowing iterator over an `Array<T>`, yielding `T*` (a pointer to
/// each element in place). Created by `Array::iter_ref`; sound for
/// owning `T`. Invalidated by any reallocating method on the array.
///
/// `private`: this cursor is an implementation detail. Callers obtain it
/// only as the opaque `implement Iterator<T*>` returned by `iter_ref`, and
/// never name it.
private type struct RefIter<T> {
    private ptr:    T*;
    private index:  i64;
    private length: i64;

    /// Adapt this by-reference iterator into a by-value one that yields
    /// each pointee `T` by bitwise copy: `arr.iter_ref().copied()`. Sound
    /// only when `T: Copy` (that bound lives on `CopiedIter`'s `Iterator`
    /// impl). Defined here, on the pointer-yielding cursor, rather than as
    /// an `Iterator` default - `copied` is meaningful only for iterators
    /// whose element is a pointer, and Cryo has no `where Item == T*`
    /// bound to gate a trait method on that condition.
    public copied(this) -> implement Iterator<T> where T: Copy {
        // A struct literal, so return-type inference resolves the opaque
        // return to the literal's `CopiedIter<RefIter<T>>` directly.
        return CopiedIter::<RefIter<T>> { inner: this };
    }

    /// Like `copied`, but clones each pointee via `Clone` into an owned
    /// value: `strings.iter_ref().cloned()` walks an `Array<String>` by
    /// value, which the `Copy`-gated `iter()` can't.
    public cloned(this) -> implement Iterator<T> where T: Clone {
        // A struct literal; see `copied`.
        return ClonedIter::<RefIter<T>> { inner: this };
    }
}

implement<T> trait Iterator<T*> for struct RefIter<T> {
    next(mut &this) -> Option<T*> {
        if (this.index >= this.length) {
            return Option::None;
        }
        const elem: T* = mem::const_offset(this.ptr, this.index);
        this.index = this.index + 1;
        return Option::Some(elem);
    }
}

/// Adapter dereferencing each `T*` yielded by `inner` into a `T` by bitwise
/// copy. Bridges the by-reference `RefIter` cursor to the by-value consumers,
/// so an owning collection needs no separate by-value iterator struct. The
/// element type `T` is recovered from the inner iterator via the
/// `where I: Iterator<T*>` bound (the monomorphizer peels the `T*`), so it is
/// not a struct parameter. Sound only when `T: Copy`.
///
/// `private`: produced only as the opaque `implement Iterator<T>` returned by
/// `RefIter::copied`; never named outside this module. Lives here, with the
/// `RefIter` it bridges, rather than in `core::iter`.
private type struct CopiedIter<I> {
    private inner: I;
}

implement<I, T> trait Iterator<T> for struct CopiedIter<I>
where I: Iterator<T*>, T: Copy {
    next(mut &this) -> Option<T> {
        return match (this.inner.next()) {
            Option::Some(p) => { Option::Some(*p) }
            Option::None    => { Option::None }
        };
    }
}

/// Adapter cloning each `T*` yielded by `inner` into an owned `T` via `Clone`.
/// The owning-type counterpart of `CopiedIter`: this is what lets a `loop`/`for`
/// over `strings.iter_ref()` walk an `Array<String>` by value (each element an
/// independent clone) - something the `Copy`-gated `iter()` can't express.
///
/// `private`: same rationale as `CopiedIter`; produced only as the opaque
/// `implement Iterator<T>` returned by `RefIter::cloned`.
private type struct ClonedIter<I> {
    private inner: I;
}

implement<I, T> trait Iterator<T> for struct ClonedIter<I>
where I: Iterator<T*>, T: Clone {
    next(mut &this) -> Option<T> {
        return match (this.inner.next()) {
            Option::Some(p) => { Option::Some((*p).clone()) }
            Option::None    => { Option::None }
        };
    }
}

implement<T, A> struct Array<T, A> where A: Allocator {
    /// The element `xs[index]` names, in place: what `Index` and
    /// `IndexMutable` below answer with.  Panics on out-of-range, at the
    /// `xs[i]` that asked: this and both `index` methods report their
    /// caller's location.  Inline, as are both `index` methods: a call per
    /// element read would cost more than the read.
    ![inline]
    ![caller_location]
    private element_at<I>(&this, index: I) -> I::Output* where I: SliceIndex<T> {
        const element: I::Output* = index.element_in(this.ptr, this.length);
        if (element == null) {
            core::panic("Array: index out of range", intrinsics::location());
        }
        return element;
    }
}

// `xs[i]` read is `*(xs.index(i))` and written is
// `*(xs.index_mutable(i))`.  An index of any integer type is accepted, and
// each call binds `I` to the index's own type.
implement<T, A, I> trait Index<I> for struct Array<T, A> where A: Allocator, I: SliceIndex<T> {
    type Output = I::Output;
    ![inline]
    ![caller_location]
    index(&this, i: I) -> const I::Output* { return this.element_at(i); }
}
implement<T, A, I> trait IndexMutable<I> for struct Array<T, A> where A: Allocator, I: SliceIndex<T> {
    ![inline]
    ![caller_location]
    index_mutable(mut &this, i: I) -> mut I::Output* { return this.element_at(i); }
}

// `xs[r]` with a range `r` is the slice of the elements `r` names: read, a
// `&Slice<T>`, and written, a `mut &Slice<T>`, as `Slice` views them.
implement<T, A, R> trait IndexView<R> for struct Array<T, A> where A: Allocator, R: SliceRange {
    type View = &Slice<T>;
    ![inline]
    ![caller_location]
    view(&this, range: R) -> &Slice<T> { return this.as_slice().view(range); }
}
implement<T, A, R> trait IndexViewMutable<R> for struct Array<T, A> where A: Allocator, R: SliceRange {
    type ViewMutable = mut &Slice<T>;
    ![inline]
    ![caller_location]
    view_mutable(mut &this, range: R) -> mut &Slice<T> { return this.as_mutable_slice().view_mutable(range); }
}
