///! HashMap<K, V, A, H>: key-value map with amortized O(1) operations.
///!
///! Separate chaining over a bucket array: each bucket holds a linked
///! list of entries. Keys must implement `Hash + Eq`. Keys are hashed by
///! `H`, by default `SipHasher` (SipHash-1-3) under a key drawn per map
///! from a per-process random value, so which keys share a bucket cannot
///! be worked out by whoever chooses the keys. A map whose keys are
///! trusted can name a faster hasher, `HashMap<K, V, GlobalAlloc,
///! FnvHasher>`; `with_hasher` builds a map around a given hasher, for
///! a fixed key or a reproducible layout.
///!
///! Chaining was chosen over open addressing because it sidesteps the
///! problem of storing uninitialised key/value slots. The cost is one
///! heap allocation per entry; a flat Robin-Hood table is a potential
///! future optimisation.

namespace std::collections::hashmap;

import std::core::intrinsics;
import std::core::option::{ Option };
import std::core::result::{ Result };
import std::core::cmp::{ Eq };
import std::core::hash::{ Hash, Hasher, SipHasher };
import std::core::drop::{ Drop };
import std::core::clone::{ Clone };
import std::core::default::{ Default };
import std::core::iter::{ Iterator };
import std::core::ptr::{ NonNull };
import std::alloc::layout::{ Layout };
import std::alloc::allocator::{ AllocError, AllocErrorKind, Allocator, GlobalAlloc };
import std::collections::pair::{ Pair };
import std::random::secure::{ SecureRng };
import std::ffi::libc;

private const INITIAL_BUCKETS: u64 = 8;

// Per-process seed generator for the keys of default `SipHasher`s.
//
// A fresh `HashMap` hashes under a random key so an attacker who controls the
// keys cannot pre-compute a flood of entries that all land in one bucket (a
// hash-flooding DoS).
//
// The seed is drawn from the kernel CSPRNG ONCE per process, then advanced with
// a SplitMix64 step for each draw - distinct, well-mixed seeds without a
// `getrandom` syscall per `HashMap::new()`.
//
// The read-modify-write of the global state is not synchronized: a race between
// threads can at worst hand two maps the same seed or draw the OS seed twice
// (last write wins) - both benign, costing only a little per-map seed diversity.
private mut g_seed_initialized: boolean = false;
private mut g_seed_state:       u64     = 0;

// SplitMix64 constants: an odd increment (fractional golden ratio) plus the two
// finalizer multipliers.
private const SEED_GAMMA: u64 = 0x9E3779B97F4A7C15;
private const SEED_MIX_1: u64 = 0xBF58476D1CE4E5B9;
private const SEED_MIX_2: u64 = 0x94D049BB133111EB;

/// Return the next per-map seed, initializing the process seed from the kernel
/// CSPRNG on first use.
private function next_map_seed() -> u64 {
    if (!g_seed_initialized) {
        mut rng: SecureRng = SecureRng::new();
        g_seed_state = rng.next_64();
        g_seed_initialized = true;
    }
    g_seed_state = g_seed_state + SEED_GAMMA;
    mut z: u64 = g_seed_state;
    z = (z ^ (z >> 30)) * SEED_MIX_1;
    z = (z ^ (z >> 27)) * SEED_MIX_2;
    z = z ^ (z >> 31);
    return z;
}

// Entry: one node in a bucket's chain

public type struct Entry<K, V> {
    public hash: u64;
    public key: K;
    public value: V;
    public next: mut Entry<K, V>*;
}

public type struct HashMap<K, V, A = GlobalAlloc, H = SipHasher> where A: Allocator {
    private buckets: mut (mut Entry<K, V>*)*;
    private bucket_count: u64;
    private length: i64;
    private alloc: A;
    /// The hasher every key's hash starts from: copied, fed the key, and
    /// finished, so one map hashes every key the same way.
    private hasher: H;

    public static new() -> HashMap<K, V, GlobalAlloc, H>
    where H: Default {
        return HashMap::<K, V, GlobalAlloc, H>::with_hasher(H::default());
    }

    public static new_in(alloc: A) -> HashMap<K, V, A, H>
    where H: Default {
        return HashMap::<K, V, A, H>::with_hasher_in(H::default(), alloc);
    }

    /// An empty map whose keys are hashed starting from `hasher`: a fixed key,
    /// or a fixed layout and iteration order for a test.
    public static with_hasher(hasher: H) -> HashMap<K, V, GlobalAlloc, H> {
        return HashMap::<K, V, GlobalAlloc, H>::with_hasher_in(hasher, GlobalAlloc::new());
    }

    /// `with_hasher` in a caller-supplied allocator.
    public static with_hasher_in(hasher: H, alloc: A) -> HashMap<K, V, A, H> {
        return HashMap::<K, V, A, H> {
            buckets: null,
            bucket_count: 0,
            length: 0,
            alloc: alloc,
            hasher: hasher
        };
    }

    /// Preallocate for at least `capacity` entries at the default load
    /// factor. The actual bucket count is the smallest power of two
    /// that keeps the load factor below 1.0.
    public static with_capacity(capacity: i64) -> HashMap<K, V, GlobalAlloc, H>
    where H: Default {
        mut map: HashMap<K, V, GlobalAlloc, H> = HashMap::<K, V, GlobalAlloc, H>::new();
        if (capacity > 0) {
            const count: u64 = next_pow2(capacity as u64);
            match (map.resize_buckets(count)) {
                Result::Ok(_) => { }
                Result::Err(_) => {
                    core::panic("HashMap::with_capacity: allocation failed", intrinsics::location());
                }
            }
        }
        return map;
    }

    ![inline]
    public length(&this) -> i64 {
        return this.length;
    }

    public is_empty(&this) -> boolean {
        return this.length == 0;
    }

    /// Number of buckets currently allocated. Not the same as the
    /// number of entries the map can hold; chaining means every
    /// bucket can hold many entries.
    public bucket_count(&this) -> u64 {
        return this.bucket_count;
    }

    /// Return the head of the entry chain for bucket `index`. Returns
    /// null if the bucket is empty or `index` is out of range. The
    /// returned pointer is valid until the next mutation of the map.
    public get_bucket(&this, index: u64) -> Entry<K, V>* {
        if (this.buckets == null || index >= this.bucket_count) { return null; }
        return this.buckets[index];
    }

    /// Iterate over every entry, yielding `Pair<K, V>` (key first,
    /// value second). Iteration order is bucket-major and undefined
    /// across resizes; do not rely on it.
    ///
    /// Yielded keys and values are bitcopies of the live entries.
    /// Gated on `K: Copy, V: Copy` so an owning `K`/`V` can't be
    /// duplicated out (which would alias map-owned storage and
    /// double-free). To walk a map of owning types, traverse the
    /// buckets in place with `bucket_count()` + `get_bucket()`. The
    /// iterator is invalidated by any mutation that inserts, removes,
    /// or resizes; same contract as `as_ptr` / `get_ref`.
    public iter(&this) -> implement Iterator<Pair<K, V>>
    where K: Copy, V: Copy {
        return HashMapIter::<K, V> {
            buckets: this.buckets,
            bucket_count: this.bucket_count,
            bucket_index: 0,
            current: null
        };
    }

    /// Iterate over the keys, yielding each by value (bitwise copy).
    /// Gated on `K: Copy` for the same reason as `iter`. Order is
    /// bucket-major and unstable across resizes.
    public keys(&this) -> implement Iterator<K>
    where K: Copy {
        return KeysIter::<K, V> {
            buckets: this.buckets,
            bucket_count: this.bucket_count,
            bucket_index: 0,
            current: null
        };
    }

    /// Iterate over the values, yielding each by value (bitwise copy).
    /// Gated on `V: Copy`. Order is bucket-major and unstable.
    public values(&this) -> implement Iterator<V>
    where V: Copy {
        return ValuesIter::<K, V> {
            buckets: this.buckets,
            bucket_count: this.bucket_count,
            bucket_index: 0,
            current: null
        };
    }

    /// Iterate over every entry, yielding `Pair<K*, V*>` (borrowed key and
    /// value). Unlike `iter`, this is sound for **any** `K`/`V` (owning or
    /// Copy) because it hands out borrows, never bitcopies - so it is the way
    /// to walk a `HashMap<String, Foo>` without cloning. The pointers borrow
    /// map-owned storage and are invalidated by any mutation that inserts,
    /// removes, or resizes; same contract as `get_ref`. Order is bucket-major
    /// and unstable across resizes.
    public entries(&this) -> implement Iterator<Pair<K*, V*>> {
        return EntriesRefIter::<K, V> {
            buckets: this.buckets,
            bucket_count: this.bucket_count,
            bucket_index: 0,
            current: null
        };
    }

    /// Iterate over the keys by shared borrow, yielding `K*`. Sound for any
    /// `K` (owning or Copy); this is how to walk the keys of a
    /// `HashMap<String, V>` - the common case - without the `K: Copy` gate on
    /// `keys`. Same borrow/invalidation contract as `entries`.
    public keys_ref(&this) -> implement Iterator<K*> {
        return KeysRefIter::<K, V> {
            buckets: this.buckets,
            bucket_count: this.bucket_count,
            bucket_index: 0,
            current: null
        };
    }

    /// Iterate over the values by shared borrow, yielding `V*`. Sound for any
    /// `V` (owning or Copy). Same borrow/invalidation contract as `entries`;
    /// use this to read owning values in place without the `V: Copy` gate on
    /// `values`, and `values_mutable` to change them.
    public values_ref(&this) -> implement Iterator<V*> {
        return ValuesRefIter::<K, V> {
            buckets: this.buckets,
            bucket_count: this.bucket_count,
            bucket_index: 0,
            current: null
        };
    }

    /// Iterate over the values by writable borrow, yielding `mut V*`: the
    /// way to change owning values in place. Same invalidation contract as
    /// `entries`, and the same order as `values_ref`.
    public values_mutable(mut &this) -> implement Iterator<mut V*> {
        return ValuesMutableIter::<K, V> {
            buckets: this.buckets,
            bucket_count: this.bucket_count,
            bucket_index: 0,
            current: null
        };
    }

    public contains_key(&this, key: &K) -> boolean
    where K: Hash + Eq, H: Hasher + Copy {
        // Borrow rather than copy out, so this stays sound for owning V
        // (a `where V: Copy` on `get` would otherwise leak in here).
        return this.get_ref(key).is_some();
    }

    /// Look up a value by key, returning a bitwise copy. Gated on
    /// `V: Copy` for the same reason as `Array::get`: handing back a
    /// duplicate of an owning value would alias storage the map still
    /// owns, double-freeing on drop. For owning `V`, borrow in place
    /// with `get_ref` (or move it out with `remove`).
    public get(&this, key: &K) -> Option<V>
    where K: Hash + Eq, V: Copy, H: Hasher + Copy {
        if (this.bucket_count == 0) {
            return Option::None;
        }
        const h: u64 = hash_key(key, this.hasher);
        const index: u64 = h & (this.bucket_count - 1);
        mut node: Entry<K, V>* = this.buckets[index];
        loop {
            if (node == null) { break; }
            if (node.hash == h && node.key.equals(key)) {
                return Option::Some(node.value);
            }
            node = node.next;
        }
        return Option::None;
    }

    /// Like `get`, but returns a read-only borrow (raw pointer) into the
    /// entry's stored value rather than a copy.  Use when the value owns
    /// heap resources you don't want to clone; `get_mutable` is the
    /// borrow to change the stored value in place through.
    ///
    /// The returned pointer is valid until the next mutation that
    /// removes this key or drops the map.  `resize_buckets` is safe;
    /// it relinks bucket heads but never relocates entry storage,
    /// because each entry is its own heap allocation.
    public get_ref(&this, key: &K) -> Option<V*>
    where K: Hash + Eq, H: Hasher + Copy {
        if (this.bucket_count == 0) {
            return Option::None;
        }
        const h: u64 = hash_key(key, this.hasher);
        const index: u64 = h & (this.bucket_count - 1);
        mut node: Entry<K, V>* = this.buckets[index];
        loop {
            if (node == null) { break; }
            if (node.hash == h && node.key.equals(key)) {
                return Option::Some(&node.value);
            }
            node = node.next;
        }
        return Option::None;
    }

    /// Like `get_ref`, but the borrow is writable: change the stored
    /// value in place through it.  Valid for as long as `get_ref`'s.
    public get_mutable(mut &this, key: &K) -> Option<mut V*>
    where K: Hash + Eq, H: Hasher + Copy {
        if (this.bucket_count == 0) {
            return Option::None;
        }
        const h: u64 = hash_key(key, this.hasher);
        const index: u64 = h & (this.bucket_count - 1);
        mut node: mut Entry<K, V>* = this.buckets[index];
        loop {
            if (node == null) { break; }
            if (node.hash == h && node.key.equals(key)) {
                return Option::Some(&node.value);
            }
            node = node.next;
        }
        return Option::None;
    }

    /// Insert `key -> value`. Returns the previous value if the key was
    /// present, otherwise `None`. Panics on allocation failure; use
    /// `try_insert` to recover from OOM.
    public insert(mut &this, key: K, value: V) -> Option<V> 
    where K: Hash + Eq, H: Hasher + Copy {
        match (this.try_insert(key, value)) {
            Result::Ok(previous) => { return previous; }
            Result::Err(_) => {
                core::panic("HashMap::insert: allocation failed", intrinsics::location());
            }
        }
    }

    public try_insert(mut &this, key: K, value: V) -> Result<Option<V>, AllocError>
    where K: Hash + Eq, H: Hasher + Copy {
        if (this.bucket_count == 0) {
            this.resize_buckets(INITIAL_BUCKETS)?;
        } else if (this.length as u64 >= this.bucket_count) {
            this.resize_buckets(this.bucket_count * 2)?;
        }

        const h: u64 = hash_key(&key, this.hasher);
        const index: u64 = h & (this.bucket_count - 1);
        mut node: mut Entry<K, V>* = this.buckets[index];
        loop {
            if (node == null) { break; }
            if (node.hash == h && node.key.equals(&key)) {
                // Move the old value out and hand it back. Ownership transfers
                // cleanly because `node.value` is overwritten on the next line,
                // so the slot never co-owns the buffer now held by `previous`.
                const slot: V* = &node.value;
                mut previous: V;
                // Sound because of the store on the next line: the slot is
                // overwritten before anything can drop it, so `previous`
                // becomes the sole owner of what it held.
                unsafe { previous = *slot; }
                node.value = value;
                return Result::Ok(Option::Some(previous));
            }
            node = node.next;
        }

        // Not present: prepend a new node.
        const fresh: mut Entry<K, V>* = alloc_entry(this, h, key, value)?;
        fresh.next = this.buckets[index];
        this.buckets[index] = fresh;
        this.length = this.length + 1;
        return Result::Ok(Option::None);
    }

    /// Borrow the value for `key`, inserting `default` first if the key
    /// is absent. Returns a pointer to the (existing or freshly inserted)
    /// value, valid until the next mutation that removes this key or
    /// drops the map (a resize keeps entry storage in place). A single
    /// lookup, unlike `get_ref`-then-`insert`. Panics on allocation
    /// failure; the common case (key present) never allocates.
    ///
    /// When the key is already present, the passed `key` and `default`
    /// are unused and dropped automatically at return (drop insertion),
    /// matching `try_insert`'s handling of a duplicate key.
    public get_or_insert(mut &this, key: K, default: V) -> mut V*
    where K: Hash + Eq, H: Hasher + Copy {
        match (this.try_get_or_insert(key, default)) {
            Result::Ok(p)  => { return p; }
            Result::Err(_) => {
                core::panic("HashMap::get_or_insert: allocation failed", intrinsics::location());
            }
        }
    }

    /// Fallible `get_or_insert`: returns `Err(AllocError)` instead of
    /// panicking when a needed resize or entry allocation fails.
    public try_get_or_insert(mut &this, key: K, default: V) -> Result<mut V*, AllocError>
    where K: Hash + Eq, H: Hasher + Copy {
        if (this.bucket_count == 0) {
            this.resize_buckets(INITIAL_BUCKETS)?;
        } else if (this.length as u64 >= this.bucket_count) {
            this.resize_buckets(this.bucket_count * 2)?;
        }
        const h: u64 = hash_key(&key, this.hasher);
        const index: u64 = h & (this.bucket_count - 1);
        mut node: mut Entry<K, V>* = this.buckets[index];
        loop {
            if (node == null) { break; }
            if (node.hash == h && node.key.equals(&key)) {
                return Result::Ok(&node.value);
            }
            node = node.next;
        }
        // Mirror try_insert: call the generic `alloc_entry` via `?`. (The
        // `match`-on-generic-free-fn form also resolves now that the
        // monomorphizer recurses into match/if expressions during call
        // discovery, but stdlib is built by the *pinned* compiler, which
        // predates that fix - so keep the `?` form here until the pin is
        // refreshed. The fix is exercised by a stage-2-compiled test.)
        const fresh: mut Entry<K, V>* = alloc_entry(this, h, key, default)?;
        fresh.next = this.buckets[index];
        this.buckets[index] = fresh;
        this.length = this.length + 1;
        return Result::Ok(&fresh.value);
    }

    /// Remove the entry with matching key. Returns the removed
    /// value, or `None` if the key wasn't present.
    ///
    /// The stored key is released in place before the entry node is
    /// freed; ownership of `V` is transferred to the caller (who is
    /// responsible for dropping it when done).
    ///
    /// Implementation: indirect-pointer (cursor) traversal so both the
    /// head-removal and mid-chain-removal cases reduce to a single
    /// `*cursor = node.next` store.  This avoids the `previous.next =
    /// node.next` write-through-struct-pointer pattern that was
    /// unreliable in earlier codegen paths and documented in the
    /// drop_insertion pass as "bootstrap HashMap remove corruption".
    public remove(mut &this, key: &K) -> Option<V>
    where K: Hash + Eq, H: Hasher + Copy {
        if (this.bucket_count == 0) {
            return Option::None;
        }
        const h: u64 = hash_key(key, this.hasher);
        const index: u64 = h & (this.bucket_count - 1);

        // `cursor` always points to the pointer-slot that links to the
        // current node: either this.buckets[index] (for the head) or
        // prev_node.next (for interior entries).  Writing *cursor
        // correctly unlinks the node without a branch.
        mut cursor: mut (mut Entry<K, V>*)* = &this.buckets[index];
        loop {
            const node: mut Entry<K, V>* = *cursor;
            if (node == null) { break; }
            if (node.hash == h && node.key.equals(key)) {
                *cursor = node.next;               // unlink: single store
                // Move the value out (see `insert`): the node is freed just
                // below without running the slot's destructor, so `removed`
                // becomes the sole owner of the buffer.
                const slot: V* = &node.value;
                mut removed: V;
                // Sound because `free_entry` below releases the node without
                // running the slot's destructor, so `removed` becomes the sole
                // owner of what the slot held.
                unsafe { removed = *slot; }
                ptr::drop_in_place::<K>(&node.key);
                free_entry(this, node);
                this.length = this.length - 1;
                return Option::Some(removed);
            }
            cursor = &node.next;
        }
        return Option::None;
    }


    /// Drop every entry. Retains the bucket array so subsequent
    /// inserts don't re-pay the allocation.
    ///
    /// Releases each discarded entry's key and value in place before
    /// freeing the entry node.
    public clear(mut &this) -> void {
        if (this.buckets == null) { return; }
        mut i: u64 = 0;
        while (i < this.bucket_count) {
            mut node: mut Entry<K, V>* = this.buckets[i];
            loop {
                if (node == null) { break; }
                const next: mut Entry<K, V>* = node.next;
                ptr::drop_in_place::<K>(&node.key);
                ptr::drop_in_place::<V>(&node.value);
                free_entry(this, node);
                node = next;
            }
            this.buckets[i] = null;
            i++;
        }
        this.length = 0;
    }

    // Rehash / grow.

    private resize_buckets(mut &this, new_count: u64) -> Result<(), AllocError> {
        const new_layout: Layout = match (Layout::try_array::<Entry<K, V>*>(new_count as i64)) {
            Option::Some(l) => { l }
            Option::None    => {
                return Result::Err(AllocError::new(
                    AllocErrorKind::OutOfMemory, Layout::of::<Entry<K, V>*>()));
            }
        };
        const raw: NonNull<u8> = this.alloc.allocate(new_layout)?;
        const new_buckets: mut (mut Entry<K, V>*)* = raw.as_ptr() as mut (mut Entry<K, V>*)*;
        // Zero the bucket array; null pointers are "empty bucket".
        libc::memset(
            new_buckets,
            0,
            new_count * sizeof(Entry<K, V>*)
        );

        // Move every existing entry into the new table.
        mut i: u64 = 0;
        while (i < this.bucket_count) {
            mut node: mut Entry<K, V>* = this.buckets[i];
            loop {
                if (node == null) { break; }
                const next: mut Entry<K, V>* = node.next;
                const index: u64 = node.hash & (new_count - 1);
                node.next = new_buckets[index];
                new_buckets[index] = node;
                node = next;
            }
            i++;
        }

        if (this.buckets != null) {
            this.alloc.deallocate(
                NonNull::new(this.buckets as mut u8*),
                Layout::array::<Entry<K, V>*>(this.bucket_count as i64)
            );
        }
        this.buckets = new_buckets;
        this.bucket_count = new_count;
        return Result::Ok(());
    }
}

// HashMapIter: bucket-major forward iterator over a HashMap
//
// State machine: `current` walks the active chain; when it reaches null
// the iterator advances `bucket_index` until it finds a non-empty
// bucket or exhausts the table.  Holds raw pointers into the live map's
// storage, so any mutation that resizes or removes invalidates it.
//
// Produced as the opaque `implement Iterator<Pair<K, V>>` that `HashMap::iter`
// returns.  `internal` rather than `private` because `HashSetIter`, in the
// `collections::hashset` module, holds one as a field.
//
// The `Iterator` impl is Copy-gated directly, not only through
// `HashMap::iter`'s bound: `next()` bit-copies keys and values out, which for
// an owning `K`/`V` would alias map-owned storage (double-free), so for such
// types it does not exist.  `HashSetIter` over `HashMapIter<T, ()>` meets the
// gate, `()` being trivially `Copy`.

internal type struct HashMapIter<K, V> {
    private buckets: (mut Entry<K, V>*)*;
    private bucket_count: u64;
    private bucket_index: u64;
    private current: Entry<K, V>*;
}

implement<K, V> trait Iterator<Pair<K, V>> for struct HashMapIter<K, V>
where K: Copy, V: Copy {
    next(mut &this) -> Option<Pair<K, V>> {
        loop {
            if (this.current != null) {
                const entry: Entry<K, V>* = this.current;
                this.current = entry.next;
                return Option::Some(Pair::<K, V> {
                    first: entry.key,
                    second: entry.value
                });
            }
            if (this.bucket_index >= this.bucket_count) {
                return Option::None;
            }
            this.current = this.buckets[this.bucket_index];
            this.bucket_index = this.bucket_index + 1;
        }
    }
}

// KeysIter / ValuesIter: bucket-major projections of HashMapIter that
// yield only the key (resp. value) of each entry. Same state machine
// and invalidation contract as HashMapIter.
//
// `private`: produced only as the opaque `implement Iterator<K>` / `<V>`
// returned by `HashMap::keys` / `values`; never named outside this module.

private type struct KeysIter<K, V> {
    private buckets: (mut Entry<K, V>*)*;
    private bucket_count: u64;
    private bucket_index: u64;
    private current: Entry<K, V>*;
}

implement<K, V> trait Iterator<K> for struct KeysIter<K, V> {
    next(mut &this) -> Option<K> {
        loop {
            if (this.current != null) {
                const entry: Entry<K, V>* = this.current;
                this.current = entry.next;
                return Option::Some(entry.key);
            }
            if (this.bucket_index >= this.bucket_count) {
                return Option::None;
            }
            this.current = this.buckets[this.bucket_index];
            this.bucket_index = this.bucket_index + 1;
        }
    }
}

private type struct ValuesIter<K, V> {
    private buckets: (mut Entry<K, V>*)*;
    private bucket_count: u64;
    private bucket_index: u64;
    private current: Entry<K, V>*;
}

implement<K, V> trait Iterator<V> for struct ValuesIter<K, V> {
    next(mut &this) -> Option<V> {
        loop {
            if (this.current != null) {
                const entry: Entry<K, V>* = this.current;
                this.current = entry.next;
                return Option::Some(entry.value);
            }
            if (this.bucket_index >= this.bucket_count) {
                return Option::None;
            }
            this.current = this.buckets[this.bucket_index];
            this.bucket_index = this.bucket_index + 1;
        }
    }
}

// Borrow-yielding iterators: EntriesRefIter / KeysRefIter / ValuesRefIter /
// ValuesMutableIter.
//
// Same bucket-major state machine and invalidation contract as the by-value
// iterators above, but each `next()` hands out a borrow (`K*` / `V*` /
// `Pair<K*, V*>`, or `mut V*` for ValuesMutableIter) into the live entry
// rather than a bitcopy. That makes them UNGATED - no `K: Copy` /
// `V: Copy` - so they walk maps of owning types (`HashMap<String, Foo>`)
// that the Copy-gated `iter`/`keys`/`values` reject. The yielded pointers
// alias map-owned storage, so they are views, not values to move out of.
//
// `EntriesRefIter` mirrors `HashMapIter`; the projections mirror
// `KeysIter`/`ValuesIter`. `KeysRefIter` is `internal` because
// `HashSet::iter_ref` wraps it; the others are only produced as opaque
// `implement Iterator<...>` and stay private.

private type struct EntriesRefIter<K, V> {
    private buckets: (mut Entry<K, V>*)*;
    private bucket_count: u64;
    private bucket_index: u64;
    private current: Entry<K, V>*;
}

implement<K, V> trait Iterator<Pair<K*, V*>> for struct EntriesRefIter<K, V> {
    next(mut &this) -> Option<Pair<K*, V*>> {
        loop {
            if (this.current != null) {
                const entry: Entry<K, V>* = this.current;
                this.current = entry.next;
                return Option::Some(Pair::<K*, V*> {
                    first: &entry.key,
                    second: &entry.value
                });
            }
            if (this.bucket_index >= this.bucket_count) {
                return Option::None;
            }
            this.current = this.buckets[this.bucket_index];
            this.bucket_index = this.bucket_index + 1;
        }
    }
}

internal type struct KeysRefIter<K, V> {
    private buckets: (mut Entry<K, V>*)*;
    private bucket_count: u64;
    private bucket_index: u64;
    private current: Entry<K, V>*;
}

implement<K, V> trait Iterator<K*> for struct KeysRefIter<K, V> {
    next(mut &this) -> Option<K*> {
        loop {
            if (this.current != null) {
                const entry: Entry<K, V>* = this.current;
                this.current = entry.next;
                return Option::Some(&entry.key);
            }
            if (this.bucket_index >= this.bucket_count) {
                return Option::None;
            }
            this.current = this.buckets[this.bucket_index];
            this.bucket_index = this.bucket_index + 1;
        }
    }
}

private type struct ValuesRefIter<K, V> {
    private buckets: (mut Entry<K, V>*)*;
    private bucket_count: u64;
    private bucket_index: u64;
    private current: Entry<K, V>*;
}

implement<K, V> trait Iterator<V*> for struct ValuesRefIter<K, V> {
    next(mut &this) -> Option<V*> {
        loop {
            if (this.current != null) {
                const entry: Entry<K, V>* = this.current;
                this.current = entry.next;
                return Option::Some(&entry.value);
            }
            if (this.bucket_index >= this.bucket_count) {
                return Option::None;
            }
            this.current = this.buckets[this.bucket_index];
            this.bucket_index = this.bucket_index + 1;
        }
    }
}

private type struct ValuesMutableIter<K, V> {
    private buckets: (mut Entry<K, V>*)*;
    private bucket_count: u64;
    private bucket_index: u64;
    private current: mut Entry<K, V>*;
}

implement<K, V> trait Iterator<mut V*> for struct ValuesMutableIter<K, V> {
    next(mut &this) -> Option<mut V*> {
        loop {
            if (this.current != null) {
                const entry: mut Entry<K, V>* = this.current;
                this.current = entry.next;
                return Option::Some(&entry.value);
            }
            if (this.bucket_index >= this.bucket_count) {
                return Option::None;
            }
            this.current = this.buckets[this.bucket_index];
            this.bucket_index = this.bucket_index + 1;
        }
    }
}

// Hashing helper

private function hash_key<K, H>(key: &K, start: H) -> u64
where K: Hash, H: Hasher {
    mut hasher: H = start;
    key.hash(&hasher);
    return hasher.finish();
}

/// A default `SipHasher` is SipHash-1-3 under a key drawn from the process's
/// seed generator, so every default-hashed map hashes under its own key.
implement trait Default for struct SipHasher {
    static default() -> SipHasher {
        return SipHasher::with_keys_1_3(next_map_seed(), next_map_seed());
    }
}

// HashMap takes a `&K` and runs the `Hash` trait itself, so it does not use
// `hash_int`; a string's hash is `core::hash::digest`.

/// Murmur3 finalizer for u64 keys.
public function hash_int(value: u64) -> u64 {
    mut x: u64 = value;
    x = x ^ (x >> 33);
    x = x * 0xff51afd7ed558ccd;
    x = x ^ (x >> 33);
    x = x * 0xc4ceb9fe1a85ec53;
    x = x ^ (x >> 33);
    return x;
}

/// Round `n` up to the next power of two. Assumes `n > 0`.
private function next_pow2(n: u64) -> u64 {
    // 2^63 is the largest power of two representable in u64. For any larger
    // `n`, doubling `p` past 2^63 wraps to 0 and `0 < n` stays true forever
    // (an unbounded-CPU hang reachable from `HashMap::with_capacity` with an
    // untrusted size hint). Saturate instead; the caller's resize then fails
    // the allocation loudly rather than spinning.
    const MAX_POW2: u64 = (u64::MAX >> 1) + 1;
    if (n >= MAX_POW2) { return MAX_POW2; }
    mut p: u64 = 1;
    while (p < n) {
        p = p * 2;
    }
    return p;
}

// Entry allocation

private function alloc_entry<K, V, A, H>(map: mut &HashMap<K, V, A, H>,
                              h: u64,
                              key: K,
                              value: V) -> Result<Entry<K, V>*, AllocError>
where A: Allocator {
    const block: Layout = Layout::of::<Entry<K, V>>();
    const raw: NonNull<u8> = map.alloc.allocate(block)?;
    const entry: mut Entry<K, V>* = raw.as_ptr() as mut Entry<K, V>*;
    entry.hash = h;
    entry.key = key;
    entry.value = value;
    entry.next = null;
    return Result::Ok(entry);
}

private function free_entry<K, V, A, H>(map: mut &HashMap<K, V, A, H>, entry: mut Entry<K, V>*) -> void
where A: Allocator {
    const block: Layout = Layout::of::<Entry<K, V>>();
    map.alloc.deallocate(NonNull::new(entry as mut u8*), block);
}

/// Release every entry and the bucket array.  Releases every entry's key
/// and value in place before reclaiming its node, so
/// `HashMap<String, String>` and similar owning shapes don't leak.
/// Ownership obligation: every HashMap must have `drop` called before
/// going out of scope.
implement<K, V, A, H> trait Drop for struct HashMap<K, V, A, H>
where A: Allocator {
    drop(mut &this) -> void {
        this.clear();
        if (this.buckets != null) {
            this.alloc.deallocate(
                NonNull::new(this.buckets as mut u8*),
                Layout::array::<Entry<K, V>*>(this.bucket_count as i64)
            );
            this.buckets = null;
        }
        this.bucket_count = 0;
    }
}

/// Deep copy: build a fresh map and clone every key and value into it, so
/// the two maps own independent storage and independent entries; the copy
/// hashes with the original's hasher. Requires `K: Hash + Eq + Clone` and
/// `V: Clone`.
implement<K, V, H> trait Clone for struct HashMap<K, V, GlobalAlloc, H>
where K: Hash + Eq + Clone, V: Clone, H: Hasher + Copy {
    clone(&this) -> HashMap<K, V, GlobalAlloc, H> {
        mut out: HashMap<K, V, GlobalAlloc, H> = HashMap::<K, V, GlobalAlloc, H>::with_hasher(this.hasher);
        mut b: u64 = 0;
        while (b < this.bucket_count) {
            mut node: Entry<K, V>* = this.buckets[b];
            while (node != null) {
                out.insert(node.key.clone(), node.value.clone());
                node = node.next;
            }
            b = b + 1;
        }
        return out;
    }
}

/// A fresh empty map is `HashMap`'s canonical "zero value", so it can satisfy
/// a `Default` bound. Allocates no buckets until the first insert.
implement<K, V, H> trait Default for struct HashMap<K, V, GlobalAlloc, H>
where H: Default {
    static default() -> HashMap<K, V, GlobalAlloc, H> {
        return HashMap::<K, V, GlobalAlloc, H>::new();
    }
}
