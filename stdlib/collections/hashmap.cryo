///! HashMap<K, V, A>: key-value map with amortized O(1) operations.
///!
///! Separate chaining over a bucket array: each bucket holds a linked
///! list of entries. Keys must implement `Hash + Eq`. The hasher is
///! FNV-1a (`core::hash::DefaultHasher`) seeded per map from a
///! per-process random value, so bucket placement varies between runs
///! and adversarial keys cannot be pre-computed to flood one bucket.
///! FNV-1a is not collision-resistant, so this is hardening, not a
///! cryptographic guarantee; supply a custom hasher where that matters.
///! `with_seed` fixes the seed for tests needing reproducible layout.
///!
///! Chaining was chosen over open addressing because it sidesteps the
///! problem of storing uninitialised key/value slots. The cost is one
///! heap allocation per entry; a flat Robin-Hood table is a potential
///! future optimisation.

namespace std::collections::hashmap;

import core::intrinsics;
import core::option;
import core::result;
import core::cmp;
import core::hash;
import core::drop;
import core::clone;
import core::iter;
import alloc::layout;
import alloc::allocator;
import collections::pair;
import random::secure;

const INITIAL_BUCKETS: u64 = 8;

// Per-process HashMap seed generator (RandomState-style).
//
// A fresh `HashMap` adopts a random seed so an attacker who controls the keys
// cannot pre-compute a flood of entries that all land in one bucket (a
// hash-flooding DoS): the bucket a key maps to now varies unpredictably between
// processes. FNV-1a is not collision-resistant regardless, so this is hardening
// rather than a cryptographic guarantee; for adversarial workloads supply a
// custom `Hasher`.
//
// The seed is drawn from the kernel CSPRNG ONCE per process, then advanced with
// a SplitMix64 step for each map — distinct, well-mixed seeds without a
// `getrandom` syscall per `HashMap::new()` (the compiler alone builds thousands
// of maps). `DefaultHasher::new()` and `fnv1a_*` are deliberately left on the
// fixed FNV offset basis: the build fingerprint / manifest input hash fold
// through them and MUST stay reproducible across processes.
//
// The read-modify-write of the global state is not synchronized: a race between
// threads can at worst hand two maps the same seed or draw the OS seed twice
// (last write wins) — both benign, costing only a little per-map seed diversity.
mut g_seed_initialized: boolean = false;
mut g_seed_state:       u64     = 0;

// SplitMix64 constants: an odd increment (fractional golden ratio) plus the two
// finalizer multipliers.
const SEED_GAMMA: u64 = 0x9E3779B97F4A7C15;
const SEED_MIX_1: u64 = 0xBF58476D1CE4E5B9;
const SEED_MIX_2: u64 = 0x94D049BB133111EB;

/// Return the next per-map seed, initializing the process seed from the kernel
/// CSPRNG on first use.
function next_map_seed() -> u64 {
    if (!g_seed_initialized) {
        mut rng: SecureRng = SecureRng::new();
        g_seed_state = rng.next_u64();
        g_seed_initialized = true;
    }
    g_seed_state = g_seed_state + SEED_GAMMA;
    mut z: u64 = g_seed_state;
    z = (z ^ (z >> 30)) * SEED_MIX_1;
    z = (z ^ (z >> 27)) * SEED_MIX_2;
    z = z ^ (z >> 31);
    return z;
}

// Entry: one node in a bucket's chain

type struct Entry<K, V> {
    hash: u64;
    key: K;
    value: V;
    next: Entry<K, V>*;
}

type struct HashMap<K, V, A = GlobalAlloc> {
    buckets: Entry<K, V>**;
    bucket_count: u64;
    length: u64;
    alloc: A;
    /// Per-map hash seed (initial `DefaultHasher` state). Drawn from the
    /// process seed generator (`next_map_seed`) so bucket placement is
    /// unpredictable between runs; fixed via `with_seed*` for tests that
    /// need reproducible iteration/layout.
    seed: u64;

    static new() -> HashMap<K, V, GlobalAlloc> {
        return HashMap<K, V, GlobalAlloc> {
            buckets: null,
            bucket_count: 0,
            length: 0,
            alloc: GlobalAlloc::new(),
            seed: next_map_seed()
        };
    }

    static new_in(alloc: A) -> HashMap<K, V, A> {
        return HashMap<K, V, A> {
            buckets: null,
            bucket_count: 0,
            length: 0,
            alloc: alloc,
            seed: next_map_seed()
        };
    }

    /// Construct an empty map with an explicit, fixed hash seed instead of a
    /// random one. Intended for tests and any caller that needs reproducible
    /// bucket placement / iteration order; production code should prefer
    /// `new` so the seed stays unpredictable.
    static with_seed(seed: u64) -> HashMap<K, V, GlobalAlloc> {
        return HashMap<K, V, GlobalAlloc> {
            buckets: null,
            bucket_count: 0,
            length: 0,
            alloc: GlobalAlloc::new(),
            seed: seed
        };
    }

    /// `with_seed` in a caller-supplied allocator.
    static with_seed_in(seed: u64, alloc: A) -> HashMap<K, V, A> {
        return HashMap<K, V, A> {
            buckets: null,
            bucket_count: 0,
            length: 0,
            alloc: alloc,
            seed: seed
        };
    }

    /// Preallocate for at least `capacity` entries at the default load
    /// factor. The actual bucket count is the smallest power of two
    /// that keeps the load factor below 1.0.
    static with_capacity(capacity: u64) -> HashMap<K, V, GlobalAlloc> {
        mut map: HashMap<K, V, GlobalAlloc> = HashMap::new();
        if (capacity > 0) {
            const count: u64 = next_pow2(capacity);
            match (map.resize_buckets(count)) {
                Result::Ok(_) => { }
                Result::Err(_) => {
                    intrinsics::panic("HashMap::with_capacity: allocation failed", FILE, LINE);
                }
            }
        }
        return map;
    }

    length(&this) -> u64 {
        return this.length;
    }

    is_empty(&this) -> boolean {
        return this.length == 0;
    }

    /// Number of buckets currently allocated. Not the same as the
    /// number of entries the map can hold; chaining means every
    /// bucket can hold many entries.
    bucket_count(&this) -> u64 {
        return this.bucket_count;
    }

    /// Return the head of the entry chain for bucket `index`. Returns
    /// null if the bucket is empty or `index` is out of range. The
    /// returned pointer is valid until the next mutation of the map.
    get_bucket(&this, index: u64) -> Entry<K, V>* {
        if (this.buckets == null || index >= this.bucket_count) { return null; }
        return this.buckets[index];
    }

    /// Iterate over every entry, yielding `Pair<K, V>` (key first,
    /// value second). Iteration order is bucket-major and undefined
    /// across resizes; do not rely on it.
    ///
    /// Yielded keys and values are bitcopies of the live entries.
    /// Gated on `K: Copy, V: Copy` so an owning `K`/`V` can't be
    /// duplicated out (which would alias map-owned storage and
    /// double-free). To walk a map of owning types, traverse the
    /// buckets in place with `bucket_count()` + `get_bucket()`. The
    /// iterator is invalidated by any mutation that inserts, removes,
    /// or resizes; same contract as `as_ptr` / `get_ref`.
    iter(&this) -> implement Iterator<Pair<K, V>>
    where K: Copy, V: Copy {
        return HashMapIter<K, V> {
            buckets: this.buckets,
            bucket_count: this.bucket_count,
            bucket_index: 0,
            current: null
        };
    }

    /// Iterate over the keys, yielding each by value (bitwise copy).
    /// Gated on `K: Copy` for the same reason as `iter`. Order is
    /// bucket-major and unstable across resizes.
    keys(&this) -> implement Iterator<K>
    where K: Copy {
        return KeysIter<K, V> {
            buckets: this.buckets,
            bucket_count: this.bucket_count,
            bucket_index: 0,
            current: null
        };
    }

    /// Iterate over the values, yielding each by value (bitwise copy).
    /// Gated on `V: Copy`. Order is bucket-major and unstable.
    values(&this) -> implement Iterator<V>
    where V: Copy {
        return ValuesIter<K, V> {
            buckets: this.buckets,
            bucket_count: this.bucket_count,
            bucket_index: 0,
            current: null
        };
    }

    contains_key(&this, key: &K) -> boolean
    where K: Hash + Eq {
        // Borrow rather than copy out, so this stays sound for owning V
        // (a `where V: Copy` on `get` would otherwise leak in here).
        return this.get_ref(key).is_some();
    }

    /// Look up a value by key, returning a bitwise copy. Gated on
    /// `V: Copy` for the same reason as `Array::get`: handing back a
    /// duplicate of an owning value would alias storage the map still
    /// owns, double-freeing on drop. For owning `V`, borrow in place
    /// with `get_ref` (or move it out with `remove`).
    get(&this, key: &K) -> Option<V>
    where K: Hash + Eq, V: Copy {
        if (this.bucket_count == 0) {
            return Option::None;
        }
        const h: u64 = hash_key(key, this.seed);
        const index: u64 = h & (this.bucket_count - 1);
        mut node: Entry<K, V>* = this.buckets[index];
        loop {
            if (node == null) { break; }
            if (node.hash == h && node.key.equals(key)) {
                return Option::Some(node.value);
            }
            node = node.next;
        }
        return Option::None;
    }

    /// Like `get`, but returns a borrow (raw pointer) into the entry's
    /// stored value rather than a copy.  Use when the value owns heap
    /// resources you don't want to clone, or when callers need to
    /// mutate the stored value in place.
    ///
    /// The returned pointer is valid until the next mutation that
    /// removes this key or drops the map.  `resize_buckets` is safe;
    /// it relinks bucket heads but never relocates entry storage,
    /// because each entry is its own heap allocation.
    get_ref(&this, key: &K) -> Option<V*>
    where K: Hash + Eq {
        if (this.bucket_count == 0) {
            return Option::None;
        }
        const h: u64 = hash_key(key, this.seed);
        const index: u64 = h & (this.bucket_count - 1);
        mut node: Entry<K, V>* = this.buckets[index];
        loop {
            if (node == null) { break; }
            if (node.hash == h && node.key.equals(key)) {
                return Option::Some(&node.value);
            }
            node = node.next;
        }
        return Option::None;
    }

    /// Insert `key -> value`. Returns the previous value if the key was
    /// present, otherwise `None`. Panics on allocation failure; use
    /// `try_insert` to recover from OOM.
    insert(mut &this, key: K, value: V) -> Option<V> 
    where K: Hash + Eq {
        match (this.try_insert(key, value)) {
            Result::Ok(previous) => { return previous; }
            Result::Err(_) => {
                intrinsics::panic("HashMap::insert: allocation failed", FILE, LINE);
            }
        }
    }

    try_insert(mut &this, key: K, value: V) -> Result<Option<V>, AllocError>
    where K: Hash + Eq {
        if (this.bucket_count == 0) {
            this.resize_buckets(INITIAL_BUCKETS)?;
        } else if (this.length >= this.bucket_count) {
            this.resize_buckets(this.bucket_count * 2)?;
        }

        const h: u64 = hash_key(&key, this.seed);
        const index: u64 = h & (this.bucket_count - 1);
        mut node: Entry<K, V>* = this.buckets[index];
        loop {
            if (node == null) { break; }
            if (node.hash == h && node.key.equals(&key)) {
                // Move the old value out and hand it back. Read through a
                // pointer (not a direct field read) so the move-checker does
                // not mistake this for an aliasing copy: ownership transfers
                // cleanly because `node.value` is overwritten on the next line,
                // so the slot never co-owns the buffer now held by `previous`.
                const slot: V* = &node.value;
                const previous: V = *slot;
                node.value = value;
                return Result::Ok(Option::Some(previous));
            }
            node = node.next;
        }

        // Not present: prepend a new node.
        const fresh: Entry<K, V>* = alloc_entry(this, h, key, value)?;
        fresh.next = this.buckets[index];
        this.buckets[index] = fresh;
        this.length = this.length + 1;
        return Result::Ok(Option::None);
    }

    /// Borrow the value for `key`, inserting `default` first if the key
    /// is absent. Returns a pointer to the (existing or freshly inserted)
    /// value, valid until the next mutation that removes this key or
    /// drops the map (a resize keeps entry storage in place). A single
    /// lookup, unlike `get_ref`-then-`insert`. Panics on allocation
    /// failure; the common case (key present) never allocates.
    ///
    /// When the key is already present, the passed `key` and `default`
    /// are unused and dropped automatically at return (drop insertion),
    /// matching `try_insert`'s handling of a duplicate key.
    get_or_insert(mut &this, key: K, default: V) -> V*
    where K: Hash + Eq {
        match (this.try_get_or_insert(key, default)) {
            Result::Ok(p)  => { return p; }
            Result::Err(_) => {
                intrinsics::panic("HashMap::get_or_insert: allocation failed", FILE, LINE);
            }
        }
    }

    /// Fallible `get_or_insert`: returns `Err(AllocError)` instead of
    /// panicking when a needed resize or entry allocation fails.
    try_get_or_insert(mut &this, key: K, default: V) -> Result<V*, AllocError>
    where K: Hash + Eq {
        if (this.bucket_count == 0) {
            this.resize_buckets(INITIAL_BUCKETS)?;
        } else if (this.length >= this.bucket_count) {
            this.resize_buckets(this.bucket_count * 2)?;
        }
        const h: u64 = hash_key(&key, this.seed);
        const index: u64 = h & (this.bucket_count - 1);
        mut node: Entry<K, V>* = this.buckets[index];
        loop {
            if (node == null) { break; }
            if (node.hash == h && node.key.equals(&key)) {
                return Result::Ok(&node.value);
            }
            node = node.next;
        }
        // Mirror try_insert: call the generic `alloc_entry` via `?`. (The
        // `match`-on-generic-free-fn form also resolves now that the
        // monomorphizer recurses into match/if expressions during call
        // discovery, but stdlib is built by the *pinned* compiler, which
        // predates that fix — so keep the `?` form here until the pin is
        // refreshed. The fix is exercised by a stage-2-compiled test.)
        const fresh: Entry<K, V>* = alloc_entry(this, h, key, default)?;
        fresh.next = this.buckets[index];
        this.buckets[index] = fresh;
        this.length = this.length + 1;
        return Result::Ok(&fresh.value);
    }

    /// Remove the entry with matching key. Returns the removed
    /// value, or `None` if the key wasn't present.
    ///
    /// `K::drop()` is called on the stored key before the entry
    /// node is freed; ownership of `V` is transferred to the
    /// caller (who is responsible for dropping it when done).  The
    /// `where K: Drop` bound makes the K-drop sound across owning
    /// (`String`) and POD (`u32`, no-op) instantiations alike.
    ///
    /// Implementation: indirect-pointer (cursor) traversal so both the
    /// head-removal and mid-chain-removal cases reduce to a single
    /// `*cursor = node.next` store.  This avoids the `previous.next =
    /// node.next` write-through-struct-pointer pattern that was
    /// unreliable in earlier codegen paths and documented in the
    /// drop_insertion pass as "bootstrap HashMap remove corruption".
    remove(mut &this, key: &K) -> Option<V>
    where K: Hash + Eq + Drop {
        if (this.bucket_count == 0) {
            return Option::None;
        }
        const h: u64 = hash_key(key, this.seed);
        const index: u64 = h & (this.bucket_count - 1);

        // `cursor` always points to the pointer-slot that links to the
        // current node: either this.buckets[index] (for the head) or
        // prev_node.next (for interior entries).  Writing *cursor
        // correctly unlinks the node without a branch.
        mut cursor: Entry<K, V>** = &this.buckets[index];
        loop {
            const node: Entry<K, V>* = *cursor;
            if (node == null) { break; }
            if (node.hash == h && node.key.equals(key)) {
                *cursor = node.next;               // unlink: single store
                // Move the value out through a pointer (see `insert`): the node
                // is freed just below, so `removed` becomes the sole owner of
                // the buffer — no aliasing copy, no double free.
                const slot: V* = &node.value;
                const removed: V = *slot;
                node.key.drop();
                free_entry(this, node);
                this.length = this.length - 1;
                return Option::Some(removed);
            }
            cursor = &node.next;
        }
        return Option::None;
    }


    /// Drop every entry. Retains the bucket array so subsequent
    /// inserts don't re-pay the allocation.
    ///
    /// Calls `K::drop()` and `V::drop()` on each discarded entry
    /// before freeing the entry node.  The `where K: Drop, V: Drop`
    /// bound is what makes this sound: every K and V used in a
    /// HashMap must have a `Drop` impl (primitives' impls are
    /// no-ops, so `HashMap<u32, u64>` etc. still work).
    clear(mut &this) -> void
    where K: Drop, V: Drop {
        if (this.buckets == null) { return; }
        mut i: u64 = 0;
        while (i < this.bucket_count) {
            mut node: Entry<K, V>* = this.buckets[i];
            loop {
                if (node == null) { break; }
                const next: Entry<K, V>* = node.next;
                node.key.drop();
                node.value.drop();
                free_entry(this, node);
                node = next;
            }
            this.buckets[i] = null;
            i++;
        }
        this.length = 0;
    }

    // Internal: rehash / grow

    resize_buckets(mut &this, new_count: u64) -> Result<(), AllocError> {
        mut new_layout: Layout = Layout { size: 0, alignment: 0 };
        match (Layout::try_array<Entry<K, V>*>(new_count)) {
            Option::Some(l) => { new_layout = l; }
            Option::None    => {
                return Result::Err(AllocError::new(
                    AllocErrorKind::OutOfMemory, Layout::of<Entry<K, V>*>()));
            }
        }
        const raw: NonNull<u8> = this.alloc.allocate(new_layout)?;
        const new_buckets: Entry<K, V>** = raw.as_ptr() as Entry<K, V>**;
        // Zero the bucket array; null pointers are "empty bucket".
        intrinsics::memset(
            new_buckets as void*,
            0,
            new_count * sizeof(Entry<K, V>*)
        );

        // Move every existing entry into the new table.
        mut i: u64 = 0;
        while (i < this.bucket_count) {
            mut node: Entry<K, V>* = this.buckets[i];
            loop {
                if (node == null) { break; }
                const next: Entry<K, V>* = node.next;
                const index: u64 = node.hash & (new_count - 1);
                node.next = new_buckets[index];
                new_buckets[index] = node;
                node = next;
            }
            i++;
        }

        if (this.buckets != null) {
            this.alloc.deallocate(
                NonNull::new(this.buckets as u8*),
                Layout::array<Entry<K, V>*>(this.bucket_count)
            );
        }
        this.buckets = new_buckets;
        this.bucket_count = new_count;
        return Result::Ok(());
    }
}

// HashMapIter: bucket-major forward iterator over a HashMap
//
// State machine: `current` walks the active chain; when it reaches null
// the iterator advances `bucket_index` until it finds a non-empty
// bucket or exhausts the table.  Holds raw pointers into the live map's
// storage, so any mutation that resizes or removes invalidates it.
//
// Stays `public` (unlike KeysIter/ValuesIter): `HashSetIter` in the
// `collections::hashset` module holds one as a field, a cross-module
// reference that a `private` marking would (correctly) reject.
//
// A `public` struct with public fields is externally constructible via a
// struct literal, bypassing the `K: Copy, V: Copy` gate on `HashMap::iter`.
// The `Iterator` impl is therefore Copy-gated directly: without it, a caller
// could hand-build a `HashMapIter` over a map of owning values and `next()`
// would bit-copy them out, aliasing map-owned storage (double-free). With the
// gate, `next()` simply doesn't exist for non-`Copy` `K`/`V`. The legitimate
// producers (`HashMap::iter`, `HashSetIter` over `HashMapIter<T, ()>` where
// `()` is trivially `Copy`) are unaffected.

type struct HashMapIter<K, V> {
    buckets: Entry<K, V>**;
    bucket_count: u64;
    bucket_index: u64;
    current: Entry<K, V>*;
}

implement<K, V> trait Iterator<Pair<K, V>> for struct HashMapIter<K, V>
where K: Copy, V: Copy {
    next(mut &this) -> Option<Pair<K, V>> {
        loop {
            if (this.current != null) {
                const entry: Entry<K, V>* = this.current;
                this.current = entry.next;
                return Option::Some(Pair<K, V> {
                    first: entry.key,
                    second: entry.value
                });
            }
            if (this.bucket_index >= this.bucket_count) {
                return Option::None;
            }
            this.current = this.buckets[this.bucket_index];
            this.bucket_index = this.bucket_index + 1;
        }
    }
}

// KeysIter / ValuesIter: bucket-major projections of HashMapIter that
// yield only the key (resp. value) of each entry. Same state machine
// and invalidation contract as HashMapIter.
//
// `private`: produced only as the opaque `implement Iterator<K>` / `<V>`
// returned by `HashMap::keys` / `values`; never named outside this module.

private type struct KeysIter<K, V> {
    buckets: Entry<K, V>**;
    bucket_count: u64;
    bucket_index: u64;
    current: Entry<K, V>*;
}

implement<K, V> trait Iterator<K> for struct KeysIter<K, V> {
    next(mut &this) -> Option<K> {
        loop {
            if (this.current != null) {
                const entry: Entry<K, V>* = this.current;
                this.current = entry.next;
                return Option::Some(entry.key);
            }
            if (this.bucket_index >= this.bucket_count) {
                return Option::None;
            }
            this.current = this.buckets[this.bucket_index];
            this.bucket_index = this.bucket_index + 1;
        }
    }
}

private type struct ValuesIter<K, V> {
    buckets: Entry<K, V>**;
    bucket_count: u64;
    bucket_index: u64;
    current: Entry<K, V>*;
}

implement<K, V> trait Iterator<V> for struct ValuesIter<K, V> {
    next(mut &this) -> Option<V> {
        loop {
            if (this.current != null) {
                const entry: Entry<K, V>* = this.current;
                this.current = entry.next;
                return Option::Some(entry.value);
            }
            if (this.bucket_index >= this.bucket_count) {
                return Option::None;
            }
            this.current = this.buckets[this.bucket_index];
            this.bucket_index = this.bucket_index + 1;
        }
    }
}

// Hashing helper

function hash_key<K>(key: &K, seed: u64) -> u64
where K: Hash {
    // Start the fold from the map's seed rather than the fixed FNV offset
    // basis, so a map's bucket placement depends on its (random) seed.
    mut hasher: DefaultHasher = DefaultHasher::from_state(seed);
    key.hash(&hasher);
    return hasher.finish();
}

// Bridge shims: keep callers that pre-compute a u64 hash compiling.
//
// The new HashMap API takes a `&K` and runs the `Hash` trait internally,
// so these helpers are not used by HashMap itself.  They exist for the
// stdlib-next bridge: legacy compiler call sites of the form
//
//     const h: u64 = hash_int(name.id as u64);
//     map.insert(name.id, value);
//
// continue to compile (with `h` unused) instead of forcing a sweep of
// every dead binding in the same commit as the API migration.

/// FNV-1a hash for NUL-terminated `string` (raw C-string view).
/// Delegates to the canonical `core::hash::digest` (via `Hash for string`)
/// so the offset basis + prime live in exactly one place.
function hash_str(s: string) -> u64 {
    return digest(&s);
}

/// Murmur3 finalizer for u64 keys.
function hash_int(value: u64) -> u64 {
    mut x: u64 = value;
    x = x ^ (x >> 33);
    x = x * 0xff51afd7ed558ccd;
    x = x ^ (x >> 33);
    x = x * 0xc4ceb9fe1a85ec53;
    x = x ^ (x >> 33);
    return x;
}

/// Round `n` up to the next power of two. Assumes `n > 0`.
function next_pow2(n: u64) -> u64 {
    // 2^63 is the largest power of two representable in u64. For any larger
    // `n`, doubling `p` past 2^63 wraps to 0 and `0 < n` stays true forever
    // (an unbounded-CPU hang reachable from `HashMap::with_capacity` with an
    // untrusted size hint). Saturate instead; the caller's resize then fails
    // the allocation loudly rather than spinning.
    const MAX_POW2: u64 = 9223372036854775808;   // 2^63
    if (n >= MAX_POW2) { return MAX_POW2; }
    mut p: u64 = 1;
    while (p < n) {
        p = p * 2;
    }
    return p;
}

// Entry allocation

function alloc_entry<K, V, A>(map: mut &HashMap<K, V, A>,
                              h: u64,
                              key: K,
                              value: V) -> Result<Entry<K, V>*, AllocError>
where A: Allocator {
    const block: Layout = Layout::of<Entry<K, V>>();
    const raw: NonNull<u8> = map.alloc.allocate(block)?;
    const entry: Entry<K, V>* = raw.as_ptr() as Entry<K, V>*;
    entry.hash = h;
    entry.key = key;
    entry.value = value;
    entry.next = null;
    return Result::Ok(entry);
}

function free_entry<K, V, A>(map: mut &HashMap<K, V, A>, entry: Entry<K, V>*) -> void
where A: Allocator {
    const block: Layout = Layout::of<Entry<K, V>>();
    map.alloc.deallocate(NonNull::new(entry as u8*), block);
}

/// Release every entry and the bucket array.  Calls `K::drop()` and
/// `V::drop()` on every entry before reclaiming its node, so
/// `HashMap<String, String>` and similar owning shapes don't leak.
/// Ownership obligation: every HashMap must have `drop` called before
/// going out of scope.
implement<K, V, A> trait Drop for struct HashMap<K, V, A>
where K: Drop, V: Drop, A: Allocator {
    drop(mut &this) -> void {
        this.clear();
        if (this.buckets != null) {
            this.alloc.deallocate(
                NonNull::new(this.buckets as u8*),
                Layout::array<Entry<K, V>*>(this.bucket_count)
            );
            this.buckets = null;
        }
        this.bucket_count = 0;
    }
}

/// Deep copy: build a fresh map and clone every key and value into it, so
/// the two maps own independent storage and independent entries. Requires
/// `K: Hash + Eq + Clone` and `V: Clone`.
implement<K, V> trait Clone for struct HashMap<K, V>
where K: Hash + Eq + Clone, V: Clone {
    clone(&this) -> HashMap<K, V> {
        mut out: HashMap<K, V> = HashMap<K, V>::with_capacity(this.length);
        mut b: u64 = 0;
        while (b < this.bucket_count) {
            mut node: Entry<K, V>* = this.buckets[b];
            while (node != null) {
                out.insert(node.key.clone(), node.value.clone());
                node = node.next;
            }
            b = b + 1;
        }
        return out;
    }
}
