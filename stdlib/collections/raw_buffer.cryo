///! RawBuffer: the allocator-backed storage half of a growable
///! container.
///!
///! Owns `(ptr, capacity, allocator)` but tracks no length. Callers
///! (`Array`, `String`, future `Deque`, ...) keep their own length
///! and pass it into `reserve` / `shrink_to` so the buffer knows how
///! many bytes to preserve across a reallocation.
///!
///! Why this exists: before the dedupe pass, `Array<T, A>` and
///! `String<A>` each had ~80 lines of identical `reserve` / `grow`
///! / `resize_buffer` / `shrink_to_fit` machinery, differing only
///! in the element type. One bug in either copy was a bug that
///! could only half-propagate. `RawBuffer` makes that impossible.

namespace std::collections::raw_buffer;

import std::core::intrinsics;
import std::core::option;
import std::core::result;
import std::core::ptr;
import std::core::drop;
import std::alloc::layout;
import std::alloc::allocator;

type struct RawBuffer<T, A = GlobalAlloc> {
    ptr: T*;
    capacity: u64;
    alloc: A;

    /// Empty buffer backed by `GlobalAlloc`. No heap storage until
    /// the first `reserve` call.
    static new() -> RawBuffer<T> {
        return RawBuffer<T> {
            ptr: null,
            capacity: 0,
            alloc: GlobalAlloc::new()
        };
    }

    /// Empty buffer with a caller-supplied allocator. Ownership of
    /// `alloc` transfers to the buffer.
    static new_in(alloc: A) -> RawBuffer<T, A> {
        return RawBuffer<T, A> {
            ptr: null,
            capacity: 0,
            alloc: alloc
        };
    }

    ptr(&this) -> T* {
        return this.ptr;
    }

    /// Consume the buffer and return its raw pointer, suppressing the
    /// deallocating Drop. The caller owns the storage afterward (it is
    /// leaked unless later reclaimed). Mirrors `Box::into_raw`.
    into_raw(mut this) -> T* {
        const { ptr, capacity, alloc }: RawBuffer<T, A> = this;
        return ptr;
    }

    capacity(&this) -> u64 {
        return this.capacity;
    }

    /// Ensure at least `additional` more slots past `used` fit.
    /// Over-allocates along the doubling curve, seeded by
    /// `min_capacity` when the buffer is small (so empty-to-nonempty
    /// transitions don't start at a single slot).
    reserve(mut &this,
            used: u64,
            additional: u64,
            min_capacity: u64) -> Result<(), AllocError> {
        // Overflow-checked: a wrapped `used + additional` (sum < used) means
        // the requested capacity can't be represented in `u64`, so it can
        // never be satisfied - report it instead of silently under-sizing.
        const required: u64 = used + additional;
        if (required < used) {
            return Result::Err(AllocError::new(
                AllocErrorKind::OutOfMemory, Layout::array<T>(used)));
        }
        if (required <= this.capacity) {
            return Result::Ok(());
        }
        return this.resize(next_capacity(this.capacity, required, min_capacity));
    }

    /// Allocate exactly enough for `used + additional`. No over-
    /// allocation. Useful when the caller already knows the final
    /// size (e.g., `Array::with_capacity`).
    reserve_exact(mut &this,
                  used: u64,
                  additional: u64) -> Result<(), AllocError> {
        // See `reserve`: reject a wrapped `used + additional` rather than
        // under-allocating and overrunning the buffer in the caller's memcpy.
        const required: u64 = used + additional;
        if (required < used) {
            return Result::Err(AllocError::new(
                AllocErrorKind::OutOfMemory, Layout::array<T>(used)));
        }
        if (required <= this.capacity) {
            return Result::Ok(());
        }
        return this.resize(required);
    }

    /// Shrink capacity to `target`, which must be at least `used`.
    /// If shrinking fails, the buffer keeps its current capacity;
    /// losing capacity is fine, but losing data is not.
    shrink_to(mut &this, target: u64) -> void {
        if (target >= this.capacity) { return; }
        if (target == 0) {
            if (this.ptr != null) {
                this.alloc.deallocate(
                    NonNull::new(this.ptr as u8*),
                    Layout::array<T>(this.capacity)
                );
            }
            this.ptr = null;
            this.capacity = 0;
            return;
        }
        match (this.resize(target)) {
            Result::Ok(_) => { }
            Result::Err(_) => { }
        }
    }

    /// Reallocate to `new_capacity`. Assumes `new_capacity` is the value
    /// the caller wants; bounds against `used` are the caller's problem.
    /// A method (not a free function) so the monomorphizer specializes it
    /// alongside the rest of `RawBuffer<T, A>`'s body, mirroring
    /// `Array::resize_storage`.
    resize(mut &this, new_capacity: u64) -> Result<(), AllocError> {
        if (new_capacity == this.capacity) {
            return Result::Ok(());
        }
        mut new_layout: Layout = Layout { size: 0, alignment: 0 };
        match (Layout::try_array<T>(new_capacity)) {
            Option::Some(l) => { new_layout = l; }
            Option::None    => {
                return Result::Err(AllocError::new(
                    AllocErrorKind::OutOfMemory, Layout::of<T>()));
            }
        }
        if (this.ptr == null) {
            const raw: NonNull<u8> = this.alloc.allocate(new_layout)?;
            this.ptr = raw.as_ptr() as T*;
            this.capacity = new_capacity;
            return Result::Ok(());
        }
        const old_layout: Layout = Layout::array<T>(this.capacity);
        const raw: NonNull<u8> = this.alloc.reallocate(
            NonNull::new(this.ptr as u8*),
            old_layout,
            new_layout
        )?;
        this.ptr = raw.as_ptr() as T*;
        this.capacity = new_capacity;
        return Result::Ok(());
    }

}

/// Release the backing allocation. Storage-only; callers must have
/// already dropped any T-owned resources, since RawBuffer doesn't
/// know which prefix was initialized.
implement<T, A> trait Drop for struct RawBuffer<T, A>
where A: Allocator {
    drop(mut &this) -> void {
        if (this.ptr != null) {
            this.alloc.deallocate(
                NonNull::new(this.ptr as u8*),
                Layout::array<T>(this.capacity)
            );
        }
        this.ptr = null;
        this.capacity = 0;
    }
}
