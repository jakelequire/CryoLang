    return syscall(num, a, b, c, d);
}

![target(linux)]
function sys_call5(num: Syscall, a: i64, b: i64, c: i64, d: i64, e: i64) -> i64 {
    return syscall(num, a, b, c, d, e);
}

![target(linux)]
function sys_call6(num: Syscall, a: i64, b: i64, c: i64, d: i64, e: i64, f: i64) -> i64 {
    return syscall(num, a, b, c, d, e, f);
}


// ============================================================================
// ============================================================================
//
//                              WINDOWS x86_64
//
// ============================================================================
// ============================================================================
//
// Windows doesn't expose stable raw NT syscall numbers — they shift
// between Windows builds. The "system surface" callers should target
// is the Win32 API (and, for low-level needs, the NT API in ntdll).
// Both go through the standard PE import table, so they link cleanly
// even when the host is Linux (the `![target(windows)]` gate keeps
// them out of the Linux build).

// ----------------------------------------------------------------------------
// Win32 sentinel values & status constants
// ----------------------------------------------------------------------------
//
// `HANDLE` is `void*`; `INVALID_HANDLE_VALUE` is `(HANDLE)-1`. We
// expose the integer form so callers can compare an `i64` cast of
// the handle.

const INVALID_HANDLE_VALUE: i64 = -1;
const NULL_HANDLE:          u64 = 0;

// GetStdHandle handle ids
const STD_INPUT_HANDLE:  u32 = 4294967286;  // (DWORD)-10
const STD_OUTPUT_HANDLE: u32 = 4294967285;  // (DWORD)-11
const STD_ERROR_HANDLE:  u32 = 4294967284;  // (DWORD)-12

// CreateFile dwDesiredAccess
const GENERIC_READ:    u32 = 0x80000000;
const GENERIC_WRITE:   u32 = 0x40000000;
const GENERIC_EXECUTE: u32 = 0x20000000;
const GENERIC_ALL:     u32 = 0x10000000;

// CreateFile dwShareMode
const FILE_SHARE_READ:   u32 = 0x00000001;
const FILE_SHARE_WRITE:  u32 = 0x00000002;
const FILE_SHARE_DELETE: u32 = 0x00000004;

// CreateFile dwCreationDisposition
const CREATE_NEW:        u32 = 1;
const CREATE_ALWAYS:     u32 = 2;
const OPEN_EXISTING:     u32 = 3;
const OPEN_ALWAYS:       u32 = 4;
const TRUNCATE_EXISTING: u32 = 5;

// CreateFile dwFlagsAndAttributes (subset)
const FILE_ATTRIBUTE_READONLY:  u32 = 0x1;
const FILE_ATTRIBUTE_HIDDEN:    u32 = 0x2;
const FILE_ATTRIBUTE_SYSTEM:    u32 = 0x4;
const FILE_ATTRIBUTE_DIRECTORY: u32 = 0x10;
const FILE_ATTRIBUTE_ARCHIVE:   u32 = 0x20;
const FILE_ATTRIBUTE_NORMAL:    u32 = 0x80;
const FILE_ATTRIBUTE_TEMPORARY: u32 = 0x100;
const FILE_FLAG_WRITE_THROUGH:  u32 = 0x80000000;
const FILE_FLAG_OVERLAPPED:     u32 = 0x40000000;
const FILE_FLAG_NO_BUFFERING:   u32 = 0x20000000;
const FILE_FLAG_RANDOM_ACCESS:  u32 = 0x10000000;
const FILE_FLAG_SEQUENTIAL_SCAN: u32 = 0x08000000;
const FILE_FLAG_DELETE_ON_CLOSE: u32 = 0x04000000;

// SetFilePointer dwMoveMethod
const FILE_BEGIN:   u32 = 0;
const FILE_CURRENT: u32 = 1;
const FILE_END:     u32 = 2;

// VirtualAlloc flAllocationType
const MEM_COMMIT:      u32 = 0x1000;
const MEM_RESERVE:     u32 = 0x2000;
const MEM_DECOMMIT:    u32 = 0x4000;
const MEM_RELEASE:     u32 = 0x8000;
const MEM_RESET:       u32 = 0x80000;
const MEM_RESET_UNDO:  u32 = 0x1000000;
const MEM_LARGE_PAGES: u32 = 0x20000000;
const MEM_PHYSICAL:    u32 = 0x400000;
const MEM_TOP_DOWN:    u32 = 0x100000;

// VirtualAlloc / VirtualProtect flProtect
const PAGE_NOACCESS:          u32 = 0x01;
const PAGE_READONLY:          u32 = 0x02;
const PAGE_READWRITE:         u32 = 0x04;
const PAGE_WRITECOPY:         u32 = 0x08;
const PAGE_EXECUTE:           u32 = 0x10;
const PAGE_EXECUTE_READ:      u32 = 0x20;
const PAGE_EXECUTE_READWRITE: u32 = 0x40;
const PAGE_EXECUTE_WRITECOPY: u32 = 0x80;
const PAGE_GUARD:             u32 = 0x100;
const PAGE_NOCACHE:           u32 = 0x200;

// WaitForSingleObject / WaitForMultipleObjects return values
const WAIT_OBJECT_0:    u32 = 0;
const WAIT_ABANDONED_0: u32 = 0x80;
const WAIT_TIMEOUT:     u32 = 0x102;
const WAIT_FAILED:      u32 = 0xFFFFFFFF;
const INFINITE:         u32 = 0xFFFFFFFF;

// HeapCreate / HeapAlloc flags
const HEAP_NO_SERIALIZE:        u32 = 0x1;
const HEAP_GROWABLE:            u32 = 0x2;
const HEAP_GENERATE_EXCEPTIONS: u32 = 0x4;
const HEAP_ZERO_MEMORY:         u32 = 0x8;
const HEAP_REALLOC_IN_PLACE_ONLY: u32 = 0x10;

// CreateProcess dwCreationFlags
const CREATE_SUSPENDED:       u32 = 0x4;
const DETACHED_PROCESS:       u32 = 0x8;
const CREATE_NEW_CONSOLE:     u32 = 0x10;
const CREATE_NEW_PROCESS_GROUP: u32 = 0x200;
const CREATE_UNICODE_ENVIRONMENT: u32 = 0x400;
const CREATE_BREAKAWAY_FROM_JOB: u32 = 0x1000000;
const CREATE_NO_WINDOW:       u32 = 0x8000000;

// Common Windows error codes (GetLastError values). Full list at
// `<winerror.h>`; the most-checked subset:
const ERROR_SUCCESS:           u32 = 0;
const ERROR_FILE_NOT_FOUND:    u32 = 2;
const ERROR_PATH_NOT_FOUND:    u32 = 3;
const ERROR_ACCESS_DENIED:     u32 = 5;
const ERROR_INVALID_HANDLE:    u32 = 6;
const ERROR_NOT_ENOUGH_MEMORY: u32 = 8;
const ERROR_BAD_FORMAT:        u32 = 11;
const ERROR_INVALID_DATA:      u32 = 13;
const ERROR_NO_MORE_FILES:     u32 = 18;
const ERROR_HANDLE_EOF:        u32 = 38;
const ERROR_NOT_SUPPORTED:     u32 = 50;
const ERROR_FILE_EXISTS:       u32 = 80;
const ERROR_INVALID_PARAMETER: u32 = 87;
const ERROR_BROKEN_PIPE:       u32 = 109;
const ERROR_DISK_FULL:         u32 = 112;
const ERROR_INSUFFICIENT_BUFFER: u32 = 122;
const ERROR_INVALID_NAME:      u32 = 123;
const ERROR_ALREADY_EXISTS:    u32 = 183;
const ERROR_NO_DATA:           u32 = 232;
const ERROR_PIPE_BUSY:         u32 = 231;
const ERROR_MORE_DATA:         u32 = 234;
const ERROR_NO_MORE_ITEMS:     u32 = 259;
const ERROR_DIRECTORY:         u32 = 267;
const ERROR_OPERATION_ABORTED: u32 = 995;
const ERROR_IO_INCOMPLETE:     u32 = 996;
const ERROR_IO_PENDING:        u32 = 997;
const ERROR_TIMEOUT:           u32 = 1460;

// NTSTATUS macro returns. Negative when failed; the high two bits
// indicate severity.
const STATUS_SUCCESS:           i32 = 0;
const STATUS_PENDING:           i32 = 259;
const STATUS_BUFFER_OVERFLOW:   i32 = 0x80000005;
const STATUS_NO_MORE_FILES:     i32 = 0x80000006;
const STATUS_INVALID_HANDLE:    i32 = 0xC0000008;
const STATUS_INVALID_PARAMETER: i32 = 0xC000000D;
const STATUS_END_OF_FILE:       i32 = 0xC0000011;
const STATUS_ACCESS_DENIED:     i32 = 0xC0000022;

// FormatMessage dwFlags
const FORMAT_MESSAGE_ALLOCATE_BUFFER: u32 = 0x100;
const FORMAT_MESSAGE_IGNORE_INSERTS:  u32 = 0x200;
const FORMAT_MESSAGE_FROM_STRING:     u32 = 0x400;
const FORMAT_MESSAGE_FROM_HMODULE:    u32 = 0x800;
const FORMAT_MESSAGE_FROM_SYSTEM:     u32 = 0x1000;
const FORMAT_MESSAGE_ARGUMENT_ARRAY:  u32 = 0x2000;

// Console mode flags
const ENABLE_PROCESSED_INPUT:        u32 = 0x1;
const ENABLE_LINE_INPUT:             u32 = 0x2;
const ENABLE_ECHO_INPUT:             u32 = 0x4;
const ENABLE_WINDOW_INPUT:           u32 = 0x8;
const ENABLE_MOUSE_INPUT:            u32 = 0x10;
const ENABLE_INSERT_MODE:            u32 = 0x20;
const ENABLE_QUICK_EDIT_MODE:        u32 = 0x40;
const ENABLE_EXTENDED_FLAGS:         u32 = 0x80;
const ENABLE_PROCESSED_OUTPUT:       u32 = 0x1;
const ENABLE_WRAP_AT_EOL_OUTPUT:     u32 = 0x2;
const ENABLE_VIRTUAL_TERMINAL_PROCESSING: u32 = 0x4;
const ENABLE_VIRTUAL_TERMINAL_INPUT: u32 = 0x200;

// ----------------------------------------------------------------------------
// Win32 stable layout structs
// ----------------------------------------------------------------------------

/// 100-nanosecond intervals since 1601-01-01 UTC.
type struct FILETIME {
    dwLowDateTime:  u32;
    dwHighDateTime: u32;
}

type struct SYSTEMTIME {
    wYear:         u16;
    wMonth:        u16;
    wDayOfWeek:    u16;
    wDay:          u16;
    wHour:         u16;
    wMinute:       u16;
    wSecond:       u16;
    wMilliseconds: u16;
}

/// Sized-and-attributed object passed to CreateFile, CreateMutex, etc.
type struct SECURITY_ATTRIBUTES {
    nLength:              u32;
    lpSecurityDescriptor: u8*;
    bInheritHandle:       i32;
}

/// Overlapped I/O context (asynchronous file ops).
type struct OVERLAPPED {
    Internal:     u64;
    InternalHigh: u64;
    Offset:       u32;
    OffsetHigh:   u32;
    hEvent:       u8*;
}

/// CreateProcess startup parameters. `lpReserved`/`lpDesktop`/
/// `lpTitle` are typically null; size constants below.
type struct STARTUPINFOA {
    cb:              u32;
    lpReserved:      u8*;
    lpDesktop:       u8*;
    lpTitle:         u8*;
    dwX:             u32;
    dwY:             u32;
    dwXSize:         u32;
    dwYSize:         u32;
    dwXCountChars:   u32;
    dwYCountChars:   u32;
    dwFillAttribute: u32;
    dwFlags:         u32;
    wShowWindow:     u16;
    cbReserved2:     u16;
    lpReserved2:     u8*;
    hStdInput:       u8*;
    hStdOutput:      u8*;
    hStdError:       u8*;
}

type struct PROCESS_INFORMATION {
    hProcess:    u8*;
    hThread:     u8*;
    dwProcessId: u32;
    dwThreadId:  u32;
}

/// LARGE_INTEGER for file sizes and QueryPerformanceCounter.
type struct LARGE_INTEGER {
    QuadPart: i64;
}

/// Result from GetSystemInfo — partial; only the fields most callers
/// read are exposed. Full struct is 48 bytes.
type struct SYSTEM_INFO_PARTIAL {
    wProcessorArchitecture: u16;
    wReserved:              u16;
    dwPageSize:             u32;
    lpMinimumApplicationAddress: u8*;
    lpMaximumApplicationAddress: u8*;
    dwActiveProcessorMask:  u64;
    dwNumberOfProcessors:   u32;
    dwProcessorType:        u32;
    dwAllocationGranularity: u32;
    wProcessorLevel:        u16;
    wProcessorRevision:     u16;
}

// ----------------------------------------------------------------------------
// kernel32.dll — file I/O, process, thread, memory, sync, time, error
// ----------------------------------------------------------------------------

![target(windows)]
![link("kernel32")]
extern "C" {
    // File operations (ANSI / narrow)
    function CreateFileA(lpFileName: u8*, dwDesiredAccess: u32,
                         dwShareMode: u32, lpSecurityAttributes: u8*,
                         dwCreationDisposition: u32,
                         dwFlagsAndAttributes: u32,
                         hTemplateFile: u8*) -> u8*;
    function CreateFileW(lpFileName: u16*, dwDesiredAccess: u32,
                         dwShareMode: u32, lpSecurityAttributes: u8*,
                         dwCreationDisposition: u32,
                         dwFlagsAndAttributes: u32,
                         hTemplateFile: u8*) -> u8*;
    function ReadFile(hFile: u8*, lpBuffer: u8*,
                      nNumberOfBytesToRead: u32,
                      lpNumberOfBytesRead: u32*,
                      lpOverlapped: OVERLAPPED*) -> i32;
    function WriteFile(hFile: u8*, lpBuffer: u8*,
                       nNumberOfBytesToWrite: u32,
                       lpNumberOfBytesWritten: u32*,
                       lpOverlapped: OVERLAPPED*) -> i32;
    function FlushFileBuffers(hFile: u8*) -> i32;
    function SetFilePointer(hFile: u8*, lDistanceToMove: i32,
                            lpDistanceToMoveHigh: i32*,
                            dwMoveMethod: u32) -> u32;
    function SetFilePointerEx(hFile: u8*, liDistanceToMove: LARGE_INTEGER,
                              lpNewFilePointer: LARGE_INTEGER*,
                              dwMoveMethod: u32) -> i32;
    function SetEndOfFile(hFile: u8*) -> i32;
    function GetFileSize(hFile: u8*, lpFileSizeHigh: u32*) -> u32;
    function GetFileSizeEx(hFile: u8*, lpFileSize: LARGE_INTEGER*) -> i32;
    function GetFileType(hFile: u8*) -> u32;
    function GetFileTime(hFile: u8*, lpCreationTime: FILETIME*,
                         lpLastAccessTime: FILETIME*,
                         lpLastWriteTime: FILETIME*) -> i32;
    function SetFileTime(hFile: u8*, lpCreationTime: FILETIME*,
                         lpLastAccessTime: FILETIME*,
                         lpLastWriteTime: FILETIME*) -> i32;
    function GetFileInformationByHandle(hFile: u8*, lpInfo: u8*) -> i32;
    function GetFileAttributesA(lpFileName: u8*) -> u32;
    function GetFileAttributesW(lpFileName: u16*) -> u32;
    function SetFileAttributesA(lpFileName: u8*, dwAttrs: u32) -> i32;
    function DeleteFileA(lpFileName: u8*) -> i32;
    function DeleteFileW(lpFileName: u16*) -> i32;
    function MoveFileA(lpExistingFileName: u8*, lpNewFileName: u8*) -> i32;
    function MoveFileW(lpExistingFileName: u16*, lpNewFileName: u16*) -> i32;
    function MoveFileExA(lpExistingFileName: u8*, lpNewFileName: u8*,
                         dwFlags: u32) -> i32;
    function CopyFileA(lpExistingFileName: u8*, lpNewFileName: u8*,
                       bFailIfExists: i32) -> i32;
    function CopyFileW(lpExistingFileName: u16*, lpNewFileName: u16*,
                       bFailIfExists: i32) -> i32;
    function CreateDirectoryA(lpPathName: u8*, lpSecurityAttributes: u8*) -> i32;
    function CreateDirectoryW(lpPathName: u16*, lpSecurityAttributes: u8*) -> i32;
    function RemoveDirectoryA(lpPathName: u8*) -> i32;
    function RemoveDirectoryW(lpPathName: u16*) -> i32;
    function GetCurrentDirectoryA(nBufferLength: u32, lpBuffer: u8*) -> u32;
    function GetCurrentDirectoryW(nBufferLength: u32, lpBuffer: u16*) -> u32;
    function SetCurrentDirectoryA(lpPathName: u8*) -> i32;
    function SetCurrentDirectoryW(lpPathName: u16*) -> i32;
    function GetTempPathA(nBufferLength: u32, lpBuffer: u8*) -> u32;
    function GetTempFileNameA(lpPathName: u8*, lpPrefixString: u8*,
                              uUnique: u32, lpTempFileName: u8*) -> u32;
    function FindFirstFileA(lpFileName: u8*, lpFindFileData: u8*) -> u8*;
    function FindFirstFileW(lpFileName: u16*, lpFindFileData: u8*) -> u8*;
    function FindNextFileA(hFindFile: u8*, lpFindFileData: u8*) -> i32;
    function FindNextFileW(hFindFile: u8*, lpFindFileData: u8*) -> i32;
    function FindClose(hFindFile: u8*) -> i32;

    // Handle lifecycle
    function CloseHandle(hObject: u8*) -> i32;
    function DuplicateHandle(hSourceProcessHandle: u8*, hSourceHandle: u8*,
                             hTargetProcessHandle: u8*, lpTargetHandle: u8**,
                             dwDesiredAccess: u32, bInheritHandle: i32,
                             dwOptions: u32) -> i32;
    function GetHandleInformation(hObject: u8*, lpdwFlags: u32*) -> i32;
    function SetHandleInformation(hObject: u8*, dwMask: u32, dwFlags: u32) -> i32;

    // Process management
    function CreateProcessA(lpApplicationName: u8*, lpCommandLine: u8*,
                            lpProcessAttributes: u8*, lpThreadAttributes: u8*,
                            bInheritHandles: i32, dwCreationFlags: u32,
                            lpEnvironment: u8*, lpCurrentDirectory: u8*,
                            lpStartupInfo: STARTUPINFOA*,
                            lpProcessInformation: PROCESS_INFORMATION*) -> i32;
    function CreateProcessW(lpApplicationName: u16*, lpCommandLine: u16*,
                            lpProcessAttributes: u8*, lpThreadAttributes: u8*,
                            bInheritHandles: i32, dwCreationFlags: u32,
                            lpEnvironment: u8*, lpCurrentDirectory: u16*,
                            lpStartupInfo: u8*,
                            lpProcessInformation: PROCESS_INFORMATION*) -> i32;
    function GetCurrentProcess() -> u8*;
    function GetCurrentProcessId() -> u32;
    function OpenProcess(dwDesiredAccess: u32, bInheritHandle: i32,
                         dwProcessId: u32) -> u8*;
    function ExitProcess(uExitCode: u32) -> void;
    function TerminateProcess(hProcess: u8*, uExitCode: u32) -> i32;
    function GetExitCodeProcess(hProcess: u8*, lpExitCode: u32*) -> i32;
    function WaitForSingleObject(hHandle: u8*, dwMilliseconds: u32) -> u32;
    function WaitForMultipleObjects(nCount: u32, lpHandles: u8**,
                                    bWaitAll: i32, dwMilliseconds: u32) -> u32;
    function GetProcessTimes(hProcess: u8*, lpCreationTime: FILETIME*,
                             lpExitTime: FILETIME*,
                             lpKernelTime: FILETIME*,
                             lpUserTime: FILETIME*) -> i32;

    // Thread management
    function CreateThread(lpThreadAttributes: u8*, dwStackSize: u64,
                          lpStartAddress: void*, lpParameter: u8*,
                          dwCreationFlags: u32, lpThreadId: u32*) -> u8*;
    function GetCurrentThread() -> u8*;
    function GetCurrentThreadId() -> u32;
    function ExitThread(dwExitCode: u32) -> void;
    function TerminateThread(hThread: u8*, dwExitCode: u32) -> i32;
    function GetExitCodeThread(hThread: u8*, lpExitCode: u32*) -> i32;
    function ResumeThread(hThread: u8*) -> u32;
    function SuspendThread(hThread: u8*) -> u32;
    function SwitchToThread() -> i32;
    function Sleep(dwMilliseconds: u32) -> void;
    function SleepEx(dwMilliseconds: u32, bAlertable: i32) -> u32;
    function GetThreadPriority(hThread: u8*) -> i32;
    function SetThreadPriority(hThread: u8*, nPriority: i32) -> i32;

    // Memory — Virtual*
    function VirtualAlloc(lpAddress: u8*, dwSize: u64,
                          flAllocationType: u32, flProtect: u32) -> u8*;
    function VirtualAllocEx(hProcess: u8*, lpAddress: u8*, dwSize: u64,
                            flAllocationType: u32, flProtect: u32) -> u8*;
    function VirtualFree(lpAddress: u8*, dwSize: u64, dwFreeType: u32) -> i32;
    function VirtualFreeEx(hProcess: u8*, lpAddress: u8*, dwSize: u64,
                           dwFreeType: u32) -> i32;
    function VirtualProtect(lpAddress: u8*, dwSize: u64,
                            flNewProtect: u32, lpflOldProtect: u32*) -> i32;
    function VirtualQuery(lpAddress: u8*, lpBuffer: u8*, dwLength: u64) -> u64;
    function VirtualLock(lpAddress: u8*, dwSize: u64) -> i32;
    function VirtualUnlock(lpAddress: u8*, dwSize: u64) -> i32;

    // Memory — Heap
    function HeapCreate(flOptions: u32, dwInitialSize: u64,
                        dwMaximumSize: u64) -> u8*;
    function HeapDestroy(hHeap: u8*) -> i32;
    function HeapAlloc(hHeap: u8*, dwFlags: u32, dwBytes: u64) -> u8*;
    function HeapReAlloc(hHeap: u8*, dwFlags: u32, lpMem: u8*,
                         dwBytes: u64) -> u8*;
    function HeapFree(hHeap: u8*, dwFlags: u32, lpMem: u8*) -> i32;
    function HeapSize(hHeap: u8*, dwFlags: u32, lpMem: u8*) -> u64;
    function HeapValidate(hHeap: u8*, dwFlags: u32, lpMem: u8*) -> i32;
    function GetProcessHeap() -> u8*;
    function GetProcessHeaps(NumberOfHeaps: u32, ProcessHeaps: u8**) -> u32;

    // Synchronization
    function CreateMutexA(lpMutexAttributes: u8*, bInitialOwner: i32,
                          lpName: u8*) -> u8*;
    function CreateMutexW(lpMutexAttributes: u8*, bInitialOwner: i32,
                          lpName: u16*) -> u8*;
    function OpenMutexA(dwDesiredAccess: u32, bInheritHandle: i32,
                        lpName: u8*) -> u8*;
    function ReleaseMutex(hMutex: u8*) -> i32;

    function CreateEventA(lpEventAttributes: u8*, bManualReset: i32,
                          bInitialState: i32, lpName: u8*) -> u8*;
    function CreateEventW(lpEventAttributes: u8*, bManualReset: i32,
                          bInitialState: i32, lpName: u16*) -> u8*;
    function SetEvent(hEvent: u8*) -> i32;
    function ResetEvent(hEvent: u8*) -> i32;
    function PulseEvent(hEvent: u8*) -> i32;

    function CreateSemaphoreA(lpSemaphoreAttributes: u8*,
                              lInitialCount: i32, lMaximumCount: i32,
                              lpName: u8*) -> u8*;
    function ReleaseSemaphore(hSemaphore: u8*, lReleaseCount: i32,
                              lpPreviousCount: i32*) -> i32;

    // Critical sections — CRITICAL_SECTION is 40 bytes on x64; treat
    // as opaque buffer.
    function InitializeCriticalSection(lpCriticalSection: u8*) -> void;
    function InitializeCriticalSectionAndSpinCount(lpCriticalSection: u8*,
                                                    dwSpinCount: u32) -> i32;
    function DeleteCriticalSection(lpCriticalSection: u8*) -> void;
    function EnterCriticalSection(lpCriticalSection: u8*) -> void;
    function TryEnterCriticalSection(lpCriticalSection: u8*) -> i32;
    function LeaveCriticalSection(lpCriticalSection: u8*) -> void;

    // SRW locks — slim reader/writer
    function InitializeSRWLock(SRWLock: u8*) -> void;
    function AcquireSRWLockExclusive(SRWLock: u8*) -> void;
    function ReleaseSRWLockExclusive(SRWLock: u8*) -> void;
    function AcquireSRWLockShared(SRWLock: u8*) -> void;
    function ReleaseSRWLockShared(SRWLock: u8*) -> void;
    function TryAcquireSRWLockExclusive(SRWLock: u8*) -> i32;
    function TryAcquireSRWLockShared(SRWLock: u8*) -> i32;

    // Condition variables
    function InitializeConditionVariable(ConditionVariable: u8*) -> void;
    function SleepConditionVariableCS(ConditionVariable: u8*,
                                      CriticalSection: u8*,
                                      dwMilliseconds: u32) -> i32;
    function SleepConditionVariableSRW(ConditionVariable: u8*,
                                       SRWLock: u8*,
                                       dwMilliseconds: u32, Flags: u32) -> i32;
    function WakeConditionVariable(ConditionVariable: u8*) -> void;
    function WakeAllConditionVariable(ConditionVariable: u8*) -> void;

    // TLS
    function TlsAlloc() -> u32;
    function TlsFree(dwTlsIndex: u32) -> i32;
    function TlsGetValue(dwTlsIndex: u32) -> u8*;
    function TlsSetValue(dwTlsIndex: u32, lpTlsValue: u8*) -> i32;

    // DLL / module
    function LoadLibraryA(lpLibFileName: u8*) -> u8*;
    function LoadLibraryW(lpLibFileName: u16*) -> u8*;
    function LoadLibraryExA(lpLibFileName: u8*, hFile: u8*, dwFlags: u32) -> u8*;
    function FreeLibrary(hLibModule: u8*) -> i32;
    function GetProcAddress(hModule: u8*, lpProcName: u8*) -> void*;
    function GetModuleHandleA(lpModuleName: u8*) -> u8*;
    function GetModuleHandleW(lpModuleName: u16*) -> u8*;
    function GetModuleFileNameA(hModule: u8*, lpFilename: u8*, nSize: u32) -> u32;
    function GetModuleFileNameW(hModule: u8*, lpFilename: u16*, nSize: u32) -> u32;

    // Console
    function GetStdHandle(nStdHandle: u32) -> u8*;
    function SetStdHandle(nStdHandle: u32, hHandle: u8*) -> i32;
    function AllocConsole() -> i32;
    function AttachConsole(dwProcessId: u32) -> i32;
    function FreeConsole() -> i32;
    function GetConsoleMode(hConsoleHandle: u8*, lpMode: u32*) -> i32;
    function SetConsoleMode(hConsoleHandle: u8*, dwMode: u32) -> i32;
    function ReadConsoleA(hConsoleInput: u8*, lpBuffer: u8*,
                          nNumberOfCharsToRead: u32,
                          lpNumberOfCharsRead: u32*,
                          pInputControl: u8*) -> i32;
    function WriteConsoleA(hConsoleOutput: u8*, lpBuffer: u8*,
                           nNumberOfCharsToWrite: u32,
                           lpNumberOfCharsWritten: u32*,
                           lpReserved: u8*) -> i32;
    function WriteConsoleW(hConsoleOutput: u8*, lpBuffer: u16*,
                           nNumberOfCharsToWrite: u32,
                           lpNumberOfCharsWritten: u32*,
                           lpReserved: u8*) -> i32;

    // Time
    function GetSystemTime(lpSystemTime: SYSTEMTIME*) -> void;
    function GetLocalTime(lpSystemTime: SYSTEMTIME*) -> void;
    function SystemTimeToFileTime(lpSystemTime: SYSTEMTIME*,
                                  lpFileTime: FILETIME*) -> i32;
    function FileTimeToSystemTime(lpFileTime: FILETIME*,
                                  lpSystemTime: SYSTEMTIME*) -> i32;
    function GetSystemTimeAsFileTime(lpSystemTimeAsFileTime: FILETIME*) -> void;
    function GetSystemTimePreciseAsFileTime(lpSystemTimeAsFileTime: FILETIME*) -> void;
    function GetTickCount() -> u32;
    function GetTickCount64() -> u64;
    function QueryPerformanceCounter(lpPerformanceCount: LARGE_INTEGER*) -> i32;
    function QueryPerformanceFrequency(lpFrequency: LARGE_INTEGER*) -> i32;

    // Error reporting
    function GetLastError() -> u32;
    function SetLastError(dwErrCode: u32) -> void;
    function FormatMessageA(dwFlags: u32, lpSource: u8*,
                            dwMessageId: u32, dwLanguageId: u32,
                            lpBuffer: u8*, nSize: u32, Arguments: u8*) -> u32;
    function FormatMessageW(dwFlags: u32, lpSource: u8*,
                            dwMessageId: u32, dwLanguageId: u32,
                            lpBuffer: u16*, nSize: u32, Arguments: u8*) -> u32;

    // Pipes
    function CreatePipe(hReadPipe: u8**, hWritePipe: u8**,
                        lpPipeAttributes: u8*, nSize: u32) -> i32;
    function PeekNamedPipe(hNamedPipe: u8*, lpBuffer: u8*,
                           nBufferSize: u32, lpBytesRead: u32*,
                           lpTotalBytesAvail: u32*,
                           lpBytesLeftThisMessage: u32*) -> i32;
    function CreateNamedPipeA(lpName: u8*, dwOpenMode: u32,
                              dwPipeMode: u32, nMaxInstances: u32,
                              nOutBufferSize: u32, nInBufferSize: u32,
                              nDefaultTimeOut: u32,
                              lpSecurityAttributes: u8*) -> u8*;
    function ConnectNamedPipe(hNamedPipe: u8*, lpOverlapped: OVERLAPPED*) -> i32;
    function DisconnectNamedPipe(hNamedPipe: u8*) -> i32;
    function WaitNamedPipeA(lpNamedPipeName: u8*, nTimeOut: u32) -> i32;
    function SetNamedPipeHandleState(hNamedPipe: u8*, lpMode: u32*,
                                     lpMaxCollectionCount: u32*,
                                     lpCollectDataTimeout: u32*) -> i32;
    function TransactNamedPipe(hNamedPipe: u8*, lpInBuffer: u8*,
                               nInBufferSize: u32, lpOutBuffer: u8*,
                               nOutBufferSize: u32, lpBytesRead: u32*,
                               lpOverlapped: OVERLAPPED*) -> i32;

    // Environment
    function GetEnvironmentVariableA(lpName: u8*, lpBuffer: u8*, nSize: u32) -> u32;
    function GetEnvironmentVariableW(lpName: u16*, lpBuffer: u16*, nSize: u32) -> u32;
    function SetEnvironmentVariableA(lpName: u8*, lpValue: u8*) -> i32;
    function SetEnvironmentVariableW(lpName: u16*, lpValue: u16*) -> i32;
    function GetEnvironmentStrings() -> u8*;
    function GetEnvironmentStringsW() -> u16*;
    function FreeEnvironmentStringsA(penv: u8*) -> i32;
    function FreeEnvironmentStringsW(penv: u16*) -> i32;
    function ExpandEnvironmentStringsA(lpSrc: u8*, lpDst: u8*, nSize: u32) -> u32;
    function GetCommandLineA() -> u8*;
    function GetCommandLineW() -> u16*;

    // System info
    function GetSystemInfo(lpSystemInfo: u8*) -> void;
    function GetNativeSystemInfo(lpSystemInfo: u8*) -> void;
    function GetSystemDirectoryA(lpBuffer: u8*, uSize: u32) -> u32;
    function GetWindowsDirectoryA(lpBuffer: u8*, uSize: u32) -> u32;
    function GetComputerNameA(lpBuffer: u8*, nSize: u32*) -> i32;
    function GetVersion() -> u32;
    function GetVersionExA(lpVersionInformation: u8*) -> i32;
    function IsDebuggerPresent() -> i32;

    // UTF-16 / multibyte conversion (essential for narrow→wide
    // crossing when working with UTF-8 paths).
    function MultiByteToWideChar(CodePage: u32, dwFlags: u32,
                                 lpMultiByteStr: u8*, cbMultiByte: i32,
                                 lpWideCharStr: u16*, cchWideChar: i32) -> i32;
    function WideCharToMultiByte(CodePage: u32, dwFlags: u32,
                                 lpWideCharStr: u16*, cchWideChar: i32,
                                 lpMultiByteStr: u8*, cbMultiByte: i32,
                                 lpDefaultChar: u8*,
                                 lpUsedDefaultChar: i32*) -> i32;

    // Random
    function RtlGenRandom(RandomBuffer: u8*, RandomBufferLength: u32) -> i32;
}

// Code page constants for MultiByteToWideChar / WideCharToMultiByte
const CP_ACP:        u32 = 0;        // System default ANSI
const CP_OEMCP:      u32 = 1;        // System default OEM
const CP_UTF7:       u32 = 65000;
const CP_UTF8:       u32 = 65001;

// ----------------------------------------------------------------------------
// user32.dll — message boxes, basic windowing primitives
// ----------------------------------------------------------------------------

const MB_OK:              u32 = 0;
const MB_OKCANCEL:        u32 = 1;
const MB_ABORTRETRYIGNORE: u32 = 2;
const MB_YESNOCANCEL:     u32 = 3;
const MB_YESNO:           u32 = 4;
const MB_RETRYCANCEL:     u32 = 5;
const MB_ICONERROR:       u32 = 0x10;
const MB_ICONWARNING:     u32 = 0x30;
const MB_ICONINFORMATION: u32 = 0x40;

const IDOK:     i32 = 1;
const IDCANCEL: i32 = 2;
const IDABORT:  i32 = 3;
const IDRETRY:  i32 = 4;
const IDIGNORE: i32 = 5;
const IDYES:    i32 = 6;
const IDNO:     i32 = 7;

![target(windows)]
![link("user32")]
extern "C" {
    function MessageBoxA(hWnd: u8*, lpText: u8*, lpCaption: u8*,
                         uType: u32) -> i32;
    function MessageBoxW(hWnd: u8*, lpText: u16*, lpCaption: u16*,
                         uType: u32) -> i32;
    function GetForegroundWindow() -> u8*;
    function SetForegroundWindow(hWnd: u8*) -> i32;
    function FindWindowA(lpClassName: u8*, lpWindowName: u8*) -> u8*;
}

// ----------------------------------------------------------------------------
// advapi32.dll — registry, security
// ----------------------------------------------------------------------------

// HKEY predefined roots (cast as void* / u8*)
const HKEY_CLASSES_ROOT:     u64 = 0xFFFFFFFF80000000;
const HKEY_CURRENT_USER:     u64 = 0xFFFFFFFF80000001;
const HKEY_LOCAL_MACHINE:    u64 = 0xFFFFFFFF80000002;
const HKEY_USERS:            u64 = 0xFFFFFFFF80000003;
const HKEY_CURRENT_CONFIG:   u64 = 0xFFFFFFFF80000005;

// Registry access rights (subset)
const KEY_QUERY_VALUE:        u32 = 0x1;
const KEY_SET_VALUE:          u32 = 0x2;
const KEY_CREATE_SUB_KEY:     u32 = 0x4;
const KEY_ENUMERATE_SUB_KEYS: u32 = 0x8;
const KEY_NOTIFY:             u32 = 0x10;
const KEY_READ:               u32 = 0x20019;
const KEY_WRITE:              u32 = 0x20006;
const KEY_ALL_ACCESS:         u32 = 0xF003F;

// Registry value types
const REG_NONE:        u32 = 0;
const REG_SZ:          u32 = 1;
const REG_EXPAND_SZ:   u32 = 2;
const REG_BINARY:      u32 = 3;
const REG_DWORD:       u32 = 4;
const REG_DWORD_BIG_ENDIAN: u32 = 5;
const REG_MULTI_SZ:    u32 = 7;
const REG_QWORD:       u32 = 11;

![target(windows)]
![link("advapi32")]
extern "C" {
    function RegOpenKeyExA(hKey: u8*, lpSubKey: u8*, ulOptions: u32,
                           samDesired: u32, phkResult: u8**) -> i32;
    function RegOpenKeyExW(hKey: u8*, lpSubKey: u16*, ulOptions: u32,
                           samDesired: u32, phkResult: u8**) -> i32;
    function RegCloseKey(hKey: u8*) -> i32;
    function RegCreateKeyExA(hKey: u8*, lpSubKey: u8*, Reserved: u32,
                             lpClass: u8*, dwOptions: u32, samDesired: u32,
                             lpSecurityAttributes: u8*, phkResult: u8**,
                             lpdwDisposition: u32*) -> i32;
    function RegDeleteKeyA(hKey: u8*, lpSubKey: u8*) -> i32;
    function RegDeleteValueA(hKey: u8*, lpValueName: u8*) -> i32;
    function RegQueryValueExA(hKey: u8*, lpValueName: u8*, lpReserved: u32*,
                              lpType: u32*, lpData: u8*, lpcbData: u32*) -> i32;
    function RegSetValueExA(hKey: u8*, lpValueName: u8*, Reserved: u32,
                            dwType: u32, lpData: u8*, cbData: u32) -> i32;
    function RegEnumKeyExA(hKey: u8*, dwIndex: u32, lpName: u8*,
                           lpcchName: u32*, lpReserved: u32*,
                           lpClass: u8*, lpcchClass: u32*,
                           lpftLastWriteTime: FILETIME*) -> i32;
    function RegEnumValueA(hKey: u8*, dwIndex: u32, lpValueName: u8*,
                           lpcchValueName: u32*, lpReserved: u32*,
                           lpType: u32*, lpData: u8*, lpcbData: u32*) -> i32;
    function RegFlushKey(hKey: u8*) -> i32;
    function RegLoadKeyA(hKey: u8*, lpSubKey: u8*, lpFile: u8*) -> i32;
    function RegUnLoadKeyA(hKey: u8*, lpSubKey: u8*) -> i32;
}

// ----------------------------------------------------------------------------
// ntdll.dll — NT API. Stable across releases for the entries below
// (Microsoft-supported); other NT* functions are undocumented and can
// shift between builds.
// ----------------------------------------------------------------------------
//
// `OBJECT_ATTRIBUTES`, `UNICODE_STRING`, `IO_STATUS_BLOCK`, etc. are
// platform-stable. Treat as opaque byte buffers and pack manually;
// future helpers can land in a `nt::` submodule.

![target(windows)]
![link("ntdll")]
extern "C" {
    // Files / I/O — raw NT layer beneath CreateFile / ReadFile.
    function NtCreateFile(FileHandle: u8**, DesiredAccess: u32,
                          ObjectAttributes: u8*, IoStatusBlock: u8*,
                          AllocationSize: i64*, FileAttributes: u32,
                          ShareAccess: u32, CreateDisposition: u32,
                          CreateOptions: u32, EaBuffer: u8*,
                          EaLength: u32) -> i32;
    function NtOpenFile(FileHandle: u8**, DesiredAccess: u32,
                        ObjectAttributes: u8*, IoStatusBlock: u8*,
                        ShareAccess: u32, OpenOptions: u32) -> i32;
    function NtReadFile(FileHandle: u8*, Event: u8*, ApcRoutine: void*,
                        ApcContext: u8*, IoStatusBlock: u8*,
                        Buffer: u8*, Length: u32,
                        ByteOffset: i64*, Key: u32*) -> i32;
    function NtWriteFile(FileHandle: u8*, Event: u8*, ApcRoutine: void*,
                         ApcContext: u8*, IoStatusBlock: u8*,
                         Buffer: u8*, Length: u32,
                         ByteOffset: i64*, Key: u32*) -> i32;
    function NtClose(Handle: u8*) -> i32;
    function NtDeviceIoControlFile(FileHandle: u8*, Event: u8*,
                                   ApcRoutine: void*, ApcContext: u8*,
                                   IoStatusBlock: u8*,
                                   IoControlCode: u32,
                                   InputBuffer: u8*, InputBufferLength: u32,
                                   OutputBuffer: u8*,
                                   OutputBufferLength: u32) -> i32;
    function NtFsControlFile(FileHandle: u8*, Event: u8*,
                             ApcRoutine: void*, ApcContext: u8*,
                             IoStatusBlock: u8*,
                             FsControlCode: u32,
                             InputBuffer: u8*, InputBufferLength: u32,
                             OutputBuffer: u8*,
                             OutputBufferLength: u32) -> i32;

    // Memory
    function NtAllocateVirtualMemory(ProcessHandle: u8*, BaseAddress: u8**,
                                     ZeroBits: u64, RegionSize: u64*,
                                     AllocationType: u32, Protect: u32) -> i32;
    function NtFreeVirtualMemory(ProcessHandle: u8*, BaseAddress: u8**,
                                 RegionSize: u64*, FreeType: u32) -> i32;
    function NtProtectVirtualMemory(ProcessHandle: u8*, BaseAddress: u8**,
                                    RegionSize: u64*, NewProtect: u32,
                                    OldProtect: u32*) -> i32;
    function NtQueryVirtualMemory(ProcessHandle: u8*, BaseAddress: u8*,
                                  MemoryInformationClass: u32,
                                  MemoryInformation: u8*,
                                  MemoryInformationLength: u64,
                                  ReturnLength: u64*) -> i32;

    // Process / thread
    function NtTerminateProcess(ProcessHandle: u8*, ExitStatus: i32) -> i32;
    function NtQueryInformationProcess(ProcessHandle: u8*,
                                       ProcessInformationClass: u32,
                                       ProcessInformation: u8*,
                                       ProcessInformationLength: u32,
                                       ReturnLength: u32*) -> i32;
    function NtSuspendProcess(ProcessHandle: u8*) -> i32;
    function NtResumeProcess(ProcessHandle: u8*) -> i32;

    // System
    function NtQuerySystemInformation(SystemInformationClass: u32,
                                      SystemInformation: u8*,
                                      SystemInformationLength: u32,
                                      ReturnLength: u32*) -> i32;
    function NtDelayExecution(Alertable: i32, DelayInterval: i64*) -> i32;
    function NtYieldExecution() -> i32;

    // Events / synchronization
    function NtCreateEvent(EventHandle: u8**, DesiredAccess: u32,
                           ObjectAttributes: u8*, EventType: u32,
                           InitialState: i32) -> i32;
    function NtSetEvent(EventHandle: u8*, PreviousState: i32*) -> i32;
    function NtResetEvent(EventHandle: u8*, PreviousState: i32*) -> i32;
    function NtWaitForSingleObject(Handle: u8*, Alertable: i32,
                                   Timeout: i64*) -> i32;

    // Helpers
    function RtlNtStatusToDosError(Status: i32) -> u32;
    function RtlGetVersion(VersionInformation: u8*) -> i32;
}
