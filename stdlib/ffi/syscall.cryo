// Generic escape hatch — call any syscall by `Syscall` variant with
// up to six i64-shaped arguments. Useful for syscalls that don't yet
// have a typed wrapper above. Pre-cast non-i64 args at the call site.
![target(linux)]
function sys_call0(num: Syscall) -> i64 {
    return syscall(num);
}

![target(linux)]
function sys_call1(num: Syscall, a: i64) -> i64 {
    return syscall(num, a);
}

