///! ffi: the C ABI boundary.
///!
///! This is the only place in the stdlib where raw platform types are
///! allowed. Crossing into C land means translating length-typed Cryo
///! values into their C equivalents; crossing back means checking
///! pointers for null and restoring length information.
///!
///! Everything outside `ffi/` should work in `Str` / `String`. To hand
///! a string to C, build a NUL-terminated copy with `String::with_null`
///! and pass its `as_ptr()`; to read one back, use `Str::from`.

namespace std::ffi;

public module ffi::libc;
public module ffi::openssl;
