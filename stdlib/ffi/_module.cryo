///! ffi — the C ABI boundary.
///!
///! This is the only place in the stdlib where NUL-terminated strings
///! and raw platform types are allowed. Crossing into C land means
///! translating length-typed Cryo values into their C equivalents;
///! crossing back means checking pointers for null and restoring
///! length information.
///!
///! Everything outside `ffi/` should treat C strings as an
///! implementation detail and work in `Str` / `String`.

namespace std::ffi;

public module ffi::libc;
public module ffi::cstr;
public module ffi::syscall;
