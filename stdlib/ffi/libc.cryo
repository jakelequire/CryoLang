public const VREPRINT: u64 = 12;
public const VDISCARD: u64 = 13;
public const VWERASE:  u64 = 14;
public const VLNEXT:   u64 = 15;
public const VEOL2:    u64 = 16;

// c_iflag (OR'd)
public const IGNBRK:  u32 = 1;
public const BRKINT:  u32 = 2;
public const IGNPAR:  u32 = 4;
public const PARMRK:  u32 = 8;
public const INPCK:   u32 = 16;
