public const EINPROGRESS:     i32 = 115;
public const ESTALE:          i32 = 116;
public const EDQUOT:          i32 = 122;
public const ECANCELED:       i32 = 125;
public const EOWNERDEAD:      i32 = 130;
public const ENOTRECOVERABLE: i32 = 131;

// errno accessor: thread-local int* indirection.  glibc exposes it as
// `__errno_location`; msvcrt exposes the same shape as `_errno`.  Gated
// per-OS so neither symbol leaks into the wrong link line.
![target(linux)]
public extern "C" {
    function __errno_location() -> i32*;
    function perror(prefix: u8*) -> void;
}

![target(windows)]
public extern "C" {
    function _errno() -> i32*;
    function perror(prefix: u8*) -> void;
}

/// Current thread's `errno`. Thin convenience over the platform's
/// thread-local indirection; every `IoError::from_errno(...)` in the
/// stdlib funnels through here.
![target(linux)]
public function errno() -> i32 {
    return *__errno_location();
}

![target(windows)]
public function errno() -> i32 {
    return *_errno();
}

/// Overwrite the current thread's `errno`. Useful when the only way
/// to detect failure from a libc routine is to clear `errno` first
/// and inspect it on return (e.g. `strtol`, `readdir`).
![target(linux)]
public function set_errno(value: i32) -> void {
    *__errno_location() = value;
}

![target(windows)]
public function set_errno(value: i32) -> void {
    *_errno() = value;
}

// signal.h: signal numbers + raw operations
//
// `sigset_t` and `struct sigaction` layouts vary; pass them as opaque
// `u8*` buffers sized by the `SIZEOF_*` constants below. Signal
// numbers stay as flat `i32` constants because callers routinely
// build runtime values like `SIGRTMIN + n`.

public const SIGHUP:    i32 = 1;
public const SIGINT:    i32 = 2;
public const SIGQUIT:   i32 = 3;
public const SIGILL:    i32 = 4;
public const SIGTRAP:   i32 = 5;
public const SIGABRT:   i32 = 6;
public const SIGIOT:    i32 = 6;
public const SIGBUS:    i32 = 7;
public const SIGFPE:    i32 = 8;
public const SIGKILL:   i32 = 9;
public const SIGUSR1:   i32 = 10;
public const SIGSEGV:   i32 = 11;
public const SIGUSR2:   i32 = 12;
public const SIGPIPE:   i32 = 13;
public const SIGALRM:   i32 = 14;
public const SIGTERM:   i32 = 15;
public const SIGSTKFLT: i32 = 16;
public const SIGCHLD:   i32 = 17;
public const SIGCONT:   i32 = 18;
public const SIGSTOP:   i32 = 19;
public const SIGTSTP:   i32 = 20;
public const SIGTTIN:   i32 = 21;
public const SIGTTOU:   i32 = 22;
public const SIGURG:    i32 = 23;
public const SIGXCPU:   i32 = 24;
public const SIGXFSZ:   i32 = 25;
public const SIGVTALRM: i32 = 26;
public const SIGPROF:   i32 = 27;
public const SIGWINCH:  i32 = 28;
public const SIGIO:     i32 = 29;
public const SIGPOLL:   i32 = 29;
public const SIGPWR:    i32 = 30;
public const SIGSYS:    i32 = 31;

/// `how` argument to `sigprocmask` and `pthread_sigmask`. Mutually
/// exclusive, not bit flags.
public type enum SigprocmaskHow : i32 {
    SIG_BLOCK   = 0;
    SIG_UNBLOCK = 1;
    SIG_SETMASK = 2;
}

// signal() / sigaction handler sentinels, passed as void* via casts.
public const SIG_DFL: u64 = 0;
public const SIG_IGN: u64 = 1;
public const SIG_ERR: i64 = -1;

// sa_flags bits
public const SA_NOCLDSTOP: i32 = 1;
public const SA_NOCLDWAIT: i32 = 2;
public const SA_SIGINFO:   i32 = 4;
public const SA_ONSTACK:   i32 = 1 << 27;
public const SA_RESTART:   i32 = 1 << 28;
public const SA_NODEFER:   i32 = 1 << 30;
public const SA_RESETHAND: i32 = 1 << 31;

/// `sigset_t` is 128 bytes on Linux/glibc (1024-bit mask).
public const SIZEOF_SIGSET_T: u64 = 128;

/// `struct sigaction` on Linux x86_64 / glibc.
public const SIZEOF_SIGACTION: u64 = 152;

public extern "C" {
    function kill(pid: i32, sig: i32) -> i32;
    function killpg(pgrp: i32, sig: i32) -> i32;
    function raise(sig: i32) -> i32;
    function signal(sig: i32, handler: void*) -> void*;
    function sigaction(sig: i32, act: u8*, oldact: u8*) -> i32;
    function sigprocmask(how: SigprocmaskHow, set: u8*, oldset: u8*) -> i32;
    function sigpending(set: u8*) -> i32;
    function sigsuspend(mask: u8*) -> i32;
    function sigemptyset(set: u8*) -> i32;
    function sigfillset(set: u8*) -> i32;
    function sigaddset(set: u8*, sig: i32) -> i32;
    function sigdelset(set: u8*, sig: i32) -> i32;
    function sigismember(set: u8*, sig: i32) -> i32;
    function sigwait(set: u8*, sig: i32*) -> i32;
    function pause() -> i32;
    function strsignal(sig: i32) -> u8*;
    function psignal(sig: i32, prefix: u8*) -> void;
}

// fcntl.h: open() flags + fcntl() commands
//
// `O_*` and `F_*` are bit-flag and command sets; kept as constants.
// `fcntl` is a variadic command dispatcher; arg type depends on cmd.
//
// The `O_*` bit VALUES are OS-specific: glibc and MSVCRT lay them out
// differently (glibc's `O_CREAT`=0x40 is MSVCRT's `_O_TEMPORARY` -
// delete-on-close! - so reusing glibc values on Windows silently opens
// without creating).  Only the access-mode bits agree.  Each target gets
// its own faithful mirror of its C library's header; a flag that does not
// exist on a target is not defined for it, so misuse is a compile error
// rather than a silently-wrong bitmask.

public const O_RDONLY:    i32 = 0;
public const O_WRONLY:    i32 = 1;
public const O_RDWR:      i32 = 2;
public const O_ACCMODE:   i32 = 3;

// Linux/glibc `<fcntl.h>` values.
![target(unix)]
public const O_CREAT:     i32 = 64;
![target(unix)]
public const O_EXCL:      i32 = 128;
![target(unix)]
public const O_NOCTTY:    i32 = 256;
![target(unix)]
public const O_TRUNC:     i32 = 512;
![target(unix)]
public const O_APPEND:    i32 = 1024;
![target(unix)]
public const O_NONBLOCK:  i32 = 2048;
![target(unix)]
public const O_NDELAY:    i32 = 2048;     // == O_NONBLOCK
![target(unix)]
public const O_DSYNC:     i32 = 4096;
![target(unix)]
public const O_ASYNC:     i32 = 8192;
![target(unix)]
public const O_DIRECT:    i32 = 16384;
![target(unix)]
public const O_LARGEFILE: i32 = 32768;
![target(unix)]
public const O_DIRECTORY: i32 = 65536;
![target(unix)]
public const O_NOFOLLOW:  i32 = 131072;
![target(unix)]
public const O_NOATIME:   i32 = 262144;
![target(unix)]
public const O_CLOEXEC:   i32 = 524288;
![target(unix)]
public const O_SYNC:      i32 = 1052672;  // O_DSYNC | O_RSYNC
![target(unix)]
public const O_PATH:      i32 = 2097152;
![target(unix)]
public const O_TMPFILE:   i32 = 4259840;  // O_TMPFILE | O_DIRECTORY
// POSIX has no text/binary distinction; a zero `O_BINARY` lets portable
// callers write `flags | O_BINARY` unconditionally (the standard C idiom).
![target(unix)]
public const O_BINARY:    i32 = 0;

// MSVCRT `<fcntl.h>` (`_O_*`) values, spelled without the underscore so
// portable call sites read identically.  `O_NOINHERIT` is the CRT's
// close-on-exec analog (the fd's handle is not inherited by children);
// `O_TEMPORARY` is delete-on-close.  Text-mode translation (CRLF) applies
// unless `O_BINARY` is set - binary is what POSIX semantics expect.
![target(windows)]
public const O_APPEND:      i32 = 8;       // _O_APPEND
![target(windows)]
public const O_RANDOM:      i32 = 16;      // _O_RANDOM
![target(windows)]
public const O_SEQUENTIAL:  i32 = 32;      // _O_SEQUENTIAL
![target(windows)]
public const O_TEMPORARY:   i32 = 64;      // _O_TEMPORARY (delete-on-close)
![target(windows)]
public const O_NOINHERIT:   i32 = 128;     // _O_NOINHERIT
![target(windows)]
public const O_CREAT:       i32 = 256;     // _O_CREAT
![target(windows)]
public const O_TRUNC:       i32 = 512;     // _O_TRUNC
![target(windows)]
public const O_EXCL:        i32 = 1024;    // _O_EXCL
![target(windows)]
public const O_SHORT_LIVED: i32 = 4096;    // _O_SHORT_LIVED
![target(windows)]
public const O_TEXT:        i32 = 16384;   // _O_TEXT (CRLF translation)
![target(windows)]
public const O_BINARY:      i32 = 32768;   // _O_BINARY (no translation)

// fcntl() commands
public const F_DUPFD:         i32 = 0;
public const F_GETFD:         i32 = 1;
public const F_SETFD:         i32 = 2;
public const F_GETFL:         i32 = 3;
public const F_SETFL:         i32 = 4;
public const F_GETLK:         i32 = 5;
public const F_SETLK:         i32 = 6;
public const F_SETLKW:        i32 = 7;
public const F_SETOWN:        i32 = 8;
public const F_GETOWN:        i32 = 9;
public const F_SETSIG:        i32 = 10;
public const F_GETSIG:        i32 = 11;
public const F_DUPFD_CLOEXEC: i32 = 1030;

// File descriptor flags (F_GETFD/F_SETFD)
public const FD_CLOEXEC: i32 = 1;

/// `struct flock.l_type` lock type.
public type enum LockType : i16 {
    F_RDLCK = 0;
    F_WRLCK = 1;
    F_UNLCK = 2;
}

// AT_FDCWD and *at() flags
public const AT_FDCWD:            i32 = -100;
public const AT_SYMLINK_NOFOLLOW: i32 = 256;
public const AT_REMOVEDIR:        i32 = 512;
public const AT_EACCESS:          i32 = 512;
public const AT_SYMLINK_FOLLOW:   i32 = 1024;
public const AT_NO_AUTOMOUNT:     i32 = 2048;
public const AT_EMPTY_PATH:       i32 = 4096;

/// `posix_fadvise` access pattern. Mutually exclusive.
public type enum FadviseAdvice : i32 {
    POSIX_FADV_NORMAL     = 0;
    POSIX_FADV_RANDOM     = 1;
    POSIX_FADV_SEQUENTIAL = 2;
    POSIX_FADV_WILLNEED   = 3;
    POSIX_FADV_DONTNEED   = 4;
    POSIX_FADV_NOREUSE    = 5;
}

public extern "C" {
    function open(path: u8*, flags: i32, mode: u32) -> i32;
    function openat(dirfd: i32, path: u8*, flags: i32, mode: u32) -> i32;
    function creat(path: u8*, mode: u32) -> i32;
    function fcntl(fd: i32, cmd: i32, arg: i64) -> i32;
    function posix_fadvise(fd: i32, offset: i64, len: i64, advice: FadviseAdvice) -> i32;
    function posix_fallocate(fd: i32, offset: i64, len: i64) -> i32;
}

// sys/stat.h: file metadata + mode bits
//
// `struct stat` layout varies between glibc versions and architectures;
// treat it as a `[u8; SIZEOF_STAT]` buffer and pull fields out with the
// helpers in a high-level `fs::stat` module.

/// Size of `struct stat` on Linux x86_64 / glibc.
public const SIZEOF_STAT: u64 = 144;

// File-type masks (st_mode upper bits)
public const S_IFMT:   u32 = 0xF000;
public const S_IFSOCK: u32 = 0xC000;
public const S_IFLNK:  u32 = 0xA000;
public const S_IFREG:  u32 = 0x8000;
public const S_IFBLK:  u32 = 0x6000;
public const S_IFDIR:  u32 = 0x4000;
public const S_IFCHR:  u32 = 0x2000;
public const S_IFIFO:  u32 = 0x1000;

// Set-UID / set-GID / sticky bits
public const S_ISUID: u32 = 0x800;
public const S_ISGID: u32 = 0x400;
public const S_ISVTX: u32 = 0x200;

// Permission bits (mode values, in hex; Cryo lacks octal literals)
public const S_IRWXU: u32 = 0x1C0;  // 0700
public const S_IRUSR: u32 = 0x100;  // 0400
public const S_IWUSR: u32 = 0x80;   // 0200
public const S_IXUSR: u32 = 0x40;   // 0100

public const S_IRWXG: u32 = 0x38;   // 0070
public const S_IRGRP: u32 = 0x20;   // 0040
public const S_IWGRP: u32 = 0x10;   // 0020
public const S_IXGRP: u32 = 0x8;    // 0010

public const S_IRWXO: u32 = 0x7;    // 0007
public const S_IROTH: u32 = 0x4;    // 0004
public const S_IWOTH: u32 = 0x2;    // 0002
public const S_IXOTH: u32 = 0x1;    // 0001

public extern "C" {
    function stat(path: u8*, buf: u8*) -> i32;
    function lstat(path: u8*, buf: u8*) -> i32;
    function fstat(fd: i32, buf: u8*) -> i32;
    function fstatat(dirfd: i32, path: u8*, buf: u8*, flags: i32) -> i32;
    function mkdir(path: u8*, mode: u32) -> i32;
    function mkdirat(dirfd: i32, path: u8*, mode: u32) -> i32;
    function chmod(path: u8*, mode: u32) -> i32;
    function fchmod(fd: i32, mode: u32) -> i32;
    function fchmodat(dirfd: i32, path: u8*, mode: u32, flags: i32) -> i32;
    function umask(mask: u32) -> u32;
    function mkfifo(path: u8*, mode: u32) -> i32;
    function mkfifoat(dirfd: i32, path: u8*, mode: u32) -> i32;
    function mknod(path: u8*, mode: u32, dev: u64) -> i32;
    function mknodat(dirfd: i32, path: u8*, mode: u32, dev: u64) -> i32;
}

// `S_IS*` are C macros; reimplemented as plain Cryo functions over the
// `st_mode` field of `struct stat`.

public function S_ISREG(mode: u32) -> boolean  { return (mode & S_IFMT) == S_IFREG; }
public function S_ISDIR(mode: u32) -> boolean  { return (mode & S_IFMT) == S_IFDIR; }
public function S_ISCHR(mode: u32) -> boolean  { return (mode & S_IFMT) == S_IFCHR; }
public function S_ISBLK(mode: u32) -> boolean  { return (mode & S_IFMT) == S_IFBLK; }
public function S_ISFIFO(mode: u32) -> boolean { return (mode & S_IFMT) == S_IFIFO; }
public function S_ISLNK(mode: u32) -> boolean  { return (mode & S_IFMT) == S_IFLNK; }
public function S_ISSOCK(mode: u32) -> boolean { return (mode & S_IFMT) == S_IFSOCK; }

// sys/uio.h: scatter/gather I/O buffer

/// I/O vector for `readv` / `writev` / `preadv` / `pwritev`.
public type struct iovec {
    public iov_base: u8*;
    public iov_len:  u64;
}

// unistd.h: lseek() whence + access() mode + sysconf() names

/// Anchor for `lseek`'s `offset`. Mutually exclusive: these are
/// not bit flags.
public type enum Whence : i32 {
    SEEK_SET  = 0;
    SEEK_CUR  = 1;
    SEEK_END  = 2;
    SEEK_DATA = 3;
    SEEK_HOLE = 4;
}

// access() / faccessat() mode bits (OR'd)
public const F_OK: i32 = 0;
public const X_OK: i32 = 1;
public const W_OK: i32 = 2;
public const R_OK: i32 = 4;

// sysconf() / pathconf() names (Linux/glibc). Left as constants:
// the set is large and runtime-extensible across glibc versions.
public const _SC_PAGESIZE:         i32 = 30;
public const _SC_NPROCESSORS_CONF: i32 = 83;
public const _SC_NPROCESSORS_ONLN: i32 = 84;
public const _SC_OPEN_MAX:         i32 = 4;
public const _SC_CHILD_MAX:        i32 = 1;
public const _SC_CLK_TCK:          i32 = 2;
public const _SC_ARG_MAX:          i32 = 0;
public const _SC_HOST_NAME_MAX:    i32 = 180;
public const _SC_LOGIN_NAME_MAX:   i32 = 71;

// unistd.h: POSIX file / process operations

// Byte I/O + lseek widths are OS-dispatched.  POSIX `read`/`write` take a
// `size_t` count and return `ssize_t` (both 64-bit); MSVCRT's `_read`/
// `_write` take `unsigned int` and return `int`, and its `lseek` alias is
// the 32-bit `_lseek` (`long` return).  Declaring the CRT trio at POSIX
// widths reads garbage past bit 31 of the return register: an error `-1`
// zero-extends to 4294967295, which callers see as SUCCESS.  Windows gets
// faithful `_read`/`_write`/`_lseeki64` externs plus POSIX-shaped shims
// (same pattern as `isatty` below).
![target(unix)]
public extern "C" {
    function read(fd: i32, buffer: u8*, count: u64) -> i64;
    function write(fd: i32, buffer: u8*, count: u64) -> i64;
    function lseek(fd: i32, offset: i64, whence: Whence) -> i64;
}

![target(windows)]
public extern "C" {
    function _read(fd: i32, buffer: u8*, count: u32) -> i32;
    function _write(fd: i32, buffer: u8*, count: u32) -> i32;
    function _lseeki64(fd: i32, offset: i64, origin: i32) -> i64;
}

/// POSIX-shaped `read` over CRT `_read`.  The count is clamped to the
/// CRT's `INT_MAX` request ceiling - a short read is legal under the
/// POSIX contract, so callers loop as they already must.
![target(windows)]
public function read(fd: i32, buffer: u8*, count: u64) -> i64 {
    mut n: u32 = i32::MAX as u32;
    if (count < i32::MAX as u64) { n = count as u32; }
    return _read(fd, buffer, n) as i64;
}

/// POSIX-shaped `write` over CRT `_write`; same clamp, short writes legal.
![target(windows)]
public function write(fd: i32, buffer: u8*, count: u64) -> i64 {
    mut n: u32 = i32::MAX as u32;
    if (count < i32::MAX as u64) { n = count as u32; }
    return _write(fd, buffer, n) as i64;
}

/// POSIX-shaped `lseek` over CRT `_lseeki64` (the 64-bit offset entry
/// point; plain CRT `lseek` truncates offsets and returns to 32 bits).
![target(windows)]
public function lseek(fd: i32, offset: i64, whence: Whence) -> i64 {
    return _lseeki64(fd, offset, whence as i32);
}

public extern "C" {
    // Byte I/O (POSIX-only entry points; no MSVCRT equivalent)
    function pread(fd: i32, buffer: u8*, count: u64, offset: i64) -> i64;
    function pwrite(fd: i32, buffer: u8*, count: u64, offset: i64) -> i64;
    function readv(fd: i32, iov: iovec*, iovcnt: i32) -> i64;
