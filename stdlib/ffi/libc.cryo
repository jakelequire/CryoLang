public const EIDRM:           i32 = 43;
public const ECHRNG:          i32 = 44;
public const ENOSTR:          i32 = 60;
public const ENODATA:         i32 = 61;
public const ETIME:           i32 = 62;
public const ENOSR:           i32 = 63;
public const ENOLINK:         i32 = 67;
public const EPROTO:          i32 = 71;
public const EMULTIHOP:       i32 = 72;
