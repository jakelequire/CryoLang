public const EOVERFLOW:       i32 = 75;
public const EILSEQ:          i32 = 84;
public const ENOTSOCK:        i32 = 88;
public const EDESTADDRREQ:    i32 = 89;
public const EMSGSIZE:        i32 = 90;
public const EPROTOTYPE:      i32 = 91;
public const ENOPROTOOPT:     i32 = 92;
public const EPROTONOSUPPORT: i32 = 93;
public const ESOCKTNOSUPPORT: i32 = 94;
public const EOPNOTSUPP:      i32 = 95;
public const ENOTSUP:         i32 = 95;   // == EOPNOTSUPP on Linux
public const EPFNOSUPPORT:    i32 = 96;
public const EAFNOSUPPORT:    i32 = 97;
public const EADDRINUSE:      i32 = 98;
public const EADDRNOTAVAIL:   i32 = 99;
public const ENETDOWN:        i32 = 100;
public const ENETUNREACH:     i32 = 101;
public const ENETRESET:       i32 = 102;
public const ECONNABORTED:    i32 = 103;
public const ECONNRESET:      i32 = 104;
public const ENOBUFS:         i32 = 105;
public const EISCONN:         i32 = 106;
public const ENOTCONN:        i32 = 107;
public const ESHUTDOWN:       i32 = 108;
public const ETOOMANYREFS:    i32 = 109;
public const ETIMEDOUT:       i32 = 110;
public const ECONNREFUSED:    i32 = 111;
