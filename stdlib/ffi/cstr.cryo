///! CStr / CString: NUL-terminated strings at the C boundary.
///!
///! `CStr` borrows a NUL-terminated byte sequence owned by something
///! else (typically returned from a libc call). `CString` owns the
///! bytes and guarantees a single terminating NUL, with no interior
///! NULs.
///!
///! Outside `ffi/`, work in `Str` / `String`. Convert at the boundary
///! with `CString::from_str(source)` on the way out and
///! `cstr.to_str_lossy()` on the way back in.

namespace std::ffi::cstr;

import core::intrinsics;
import core::option;
import core::result;
import core::slice;
import core::drop;
import alloc::layout;
import alloc::allocator;
import collections::str;
import ffi::libc;

/// Returned when a source `Str` contains an interior NUL, as it can't
/// be turned into a valid `CString`.
type struct NulError {
    position: u64;
}

// CStr: borrowed view

type struct CStr {
    ptr: u8*;

    /// Wrap a raw pointer to a NUL-terminated byte sequence. The
    /// caller certifies the pointer is non-null, that a NUL terminator
    /// exists, and that the memory outlives this view.
    static from_ptr(ptr: u8*) -> CStr {
        if (ptr == null) {
            intrinsics::panic("CStr::from_ptr: null pointer", FILE, LINE);
        }
        return CStr { ptr: ptr };
    }

    /// Raw pointer for handing to C. Includes the NUL.
    as_ptr(&this) -> u8* {
        return this.ptr;
    }

    /// Length in bytes, excluding the terminating NUL. O(n),
    /// equivalent to `strlen`. Cache the result if you need it repeatedly.
    length(&this) -> u64 {
        return libc::strlen(this.ptr);
    }

    /// Bytes without the NUL terminator.
    to_bytes(&this) -> Slice<u8> {
        return Slice::from_raw(this.ptr, this.length());
    }

    /// Borrow as a `Str`. The returned view is valid as long as this
    /// `CStr` is valid. **The caller asserts the bytes are valid
    /// UTF-8**; no validation is performed. For untrusted input,
    /// validate the bytes with a dedicated validator before calling this.
    to_str_lossy(&this) -> Str {
        return Str::from_raw(this.ptr, this.length());
    }
}

// CString: owned

type struct CString<A = GlobalAlloc> {
    buffer: u8*;
    // Byte length including the trailing NUL.
    length: u64;
    alloc: A;

    /// Copy `source` into a fresh NUL-terminated buffer. Returns
    /// `Err(NulError)` if `source` contains an interior NUL: a C
    /// string can't represent that unambiguously. Panics on
    /// allocation failure; use `try_from_str` to recover from OOM.
    static from_str(source: Str) -> Result<CString, NulError> {
        match (CString::try_from_str_in(source, GlobalAlloc::new())) {
            Result::Ok(either) => { return either; }
            Result::Err(_) => {
                intrinsics::panic("CString::from_str: allocation failed", FILE, LINE);
            }
        }
    }

    static try_from_str_in(source: Str, alloc: A)
            -> Result<Result<CString<A>, NulError>, AllocError> {
        mut i: u64 = 0;
        while (i < source.length()) {
            match (source.byte_at(i)) {
                Option::Some(byte) => {
                    if (byte == 0) {
                        return Result::Ok(Result::Err(NulError { position: i }));
                    }
                }
                Option::None => { break; }
            }
            i++;
        }

        const total: u64 = source.length() + 1;
        mut local_alloc: A = alloc;
        const block: Layout = Layout::array<u8>(total);
        match (local_alloc.allocate(block)) {
            Result::Ok(raw) => {
                const buffer: u8* = raw.as_ptr();
                if (source.length() > 0) {
                    intrinsics::memcpy(
                        buffer as void*,
                        source.as_ptr() as void*,
                        source.length()
                    );
                }
                buffer[source.length()] = 0;
                return Result::Ok(Result::Ok(CString<A> {
                    buffer: buffer,
                    length: total,
                    alloc: local_alloc
                }));
            }
            Result::Err(err) => { return Result::Err(err); }
        }
    }

    /// Borrow as a `CStr`. Valid until the next mutation or `drop`.
    as_c_str(&this) -> CStr {
        return CStr::from_ptr(this.buffer);
    }

    /// Raw pointer for handing to C. Includes the NUL.
    as_ptr(&this) -> u8* {
        return this.buffer;
    }

    /// Byte length excluding the terminator.
    length(&this) -> u64 {
        return this.length - 1;
    }

}

/// Release the backing buffer. Ownership obligation: every `CString`
/// must have `drop` called before going out of scope.
implement<A> trait Drop for struct CString<A>
where A: Allocator {
    drop(mut &this) -> void {
        if (this.buffer != null) {
            this.alloc.deallocate(
                NonNull::new(this.buffer),
                Layout::array<u8>(this.length)
            );
        }
        this.buffer = null;
        this.length = 0;
    }
}
