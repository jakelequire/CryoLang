///! f-string interpolation runtime.
///!
///! These helpers are the desugar target for `f"...{expr}..."` string
///! interpolation. The parser lowers an f-string into a chain of nested
///! calls that thread an owned `String` builder left-to-right:
///!
///!   f"x = {x}, y = {y:?}"
///!
///! becomes
///!
///!   fmt_append_debug(
///!       fmt_append_lit(
///!           fmt_append_display(
///!               fmt_append_lit(fmt_new(), "x = "),
///!               &x),
///!           ", y = "),
///!       &y)
///!
///! Each helper takes the partial `String` by value (moving ownership in),
///! appends to it, and returns it, so the whole expression evaluates to a
///! single owned `String` with no intermediate temporaries to drop.
///!
///! The generic `fmt_append_display` / `fmt_append_debug` carry the
///! `Display` / `Debug` bound so bound-directed dispatch resolves the
///! nested `value.fmt(f)` to the right trait (this is exactly how
///! `format_to_string` / `format_debug_to_string` pick Display vs Debug).
///!
///! This module is in the prelude so `f"..."` works without an explicit
///! import, the same way `core::slice` / `core::ops` back the for-in and
///! range sugar.

namespace std::fmt::interp;

import core::result;
import collections::str;
import collections::string;
import fmt::display;
import fmt::spec;

/// Start a fresh interpolation buffer.  The innermost call in an
/// f-string desugar.
function fmt_new() -> String {
    return String::new();
}

/// Append a literal text chunk (the text between `{...}` holes).
function fmt_append_lit(out: String, text: string) -> String {
    mut s: String = out;
    s.push(text);
    return s;
}

/// Append a `{expr}` hole via `Display`.  In-memory `String` sinks never
/// fail to write, so a formatting error (which can only originate from a
/// user `Display` impl returning `Err`) is swallowed here rather than
/// propagated - an f-string evaluates to a plain `String`, not a `Result`.
function fmt_append_display<T>(out: String, value: &T) -> String
where T: Display {
    mut s: String = out;
    mut f: Formatter<String> = Formatter::new(&s);
    match (value.fmt(&f)) {
        Result::Ok(_)  => { }
        Result::Err(_) => { }
    }
    return s;
}

/// Append a `{expr:?}` hole via `Debug`.  Same error handling as
/// `fmt_append_display`.
function fmt_append_debug<T>(out: String, value: &T) -> String
where T: Debug {
    mut s: String = out;
    mut f: Formatter<String> = Formatter::new(&s);
    match (value.fmt(&f)) {
        Result::Ok(_)  => { }
        Result::Err(_) => { }
    }
    return s;
}

/// Append a `{expr:spec}` hole carrying a non-trivial format spec
/// (width / fill / align / precision / radix). `spec` is the raw spec
/// text after the colon; the compiler emits this helper only when that
/// text is a valid spec (a bare `{expr}` and a `{expr:?}` still lower to
/// `fmt_append_display` / `fmt_append_debug`).
///
/// The per-type dispatch lives here: `static match (T)` selects a body
/// builder (integer decimal/radix, float, or generic Display) from
/// `fmt::spec`; `fmt_pad` then applies the field width. Integers are
/// rendered at their own width so a radix of a negative or narrow value
/// shows the correct two's-complement digits.
function fmt_append_fmt<T>(out: String, value: &T, spec: string) -> String
where T: Display {
    mut s: String = out;
    const fs: FmtSpec = fmt_parse_spec(Str::new(spec));
    mut body: BodyText = static match (T) {
        u8    => { fmt_uint_body(*value as u64, &fs) }
        u16   => { fmt_uint_body(*value as u64, &fs) }
        u32   => { fmt_uint_body(*value as u64, &fs) }
        u64   => { fmt_uint_body(*value, &fs) }
        usize => { fmt_uint_body(*value as u64, &fs) }
        i8    => { fmt_sint_body(*value as i64, (*value as u8) as u64, &fs) }
        i16   => { fmt_sint_body(*value as i64, (*value as u16) as u64, &fs) }
        i32   => { fmt_sint_body(*value as i64, (*value as u32) as u64, &fs) }
        i64   => { fmt_sint_body(*value, *value as u64, &fs) }
        isize => { fmt_sint_body(*value as i64, *value as u64, &fs) }
        f32   => { fmt_float_body(*value as f64, &fs) }
        f64   => { fmt_float_body(*value, &fs) }
        _     => { fmt_display_body<T>(value, &fs) }
    };
    fmt_pad(&s, body.text.as_str(), body.head_len, &fs);
    body.drop();
    return s;
}
