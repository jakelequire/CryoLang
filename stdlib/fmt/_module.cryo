///! fmt: formatting values as text.
///!
///! `Display` produces human-readable output for end users.
///! `Debug` produces developer-readable output for diagnostics and
///! inspection. A `Formatter<W>` wraps any `FmtWrite` impl and gives
///! trait methods a stable surface to target.
///!
///! Sub-modules:
///!   - `error`   - `FmtError` wraps either an `IoError` or `AllocError`
///!   - `write`   - `FmtWrite` trait + stdlib impls (`Stdout`, `Stderr`, `String`)
///!   - `float`   - `f64.to_buf` / `to_buf_with`: decimal + scientific writer
///!   - `display` - `Display`, `Debug`, `Formatter<W>`,
///!                 `format_to_string`, `format_debug_to_string`
///!
///! The print family lives directly in this module, so `import std::fmt;`
///! brings it in.  Two flavours:
///!   - `format`  - C-style variadic (`%s`/`%d`) into a fresh string.
///!   - `printf` / `eprintf` - C-style variadic (`%s`/`%d`) to stdout/stderr.
///!   - `print` / `println` / `eprint` / `eprintln` - Display-based: take an
///!     owned `String` (typically an f-string `f"{x}"`), write it, and drop it.
///!   - `interp`  - f-string (`f"...{expr}..."`) desugar runtime
///!
///! Integer formatting (`to_decimal_buf`, `to_hex_buf`, `to_oct_buf`,
///! `to_bin_buf`) lives on the primitive types in `core::primitives`.
///! Integer parsing goes through `TryFrom<Str>` (defined in
///! `collections::str`): `u32::try_from(s)` with `s: Str` returns
///! `Result<u32, ConversionError>`.
///!
///! Format-string interpolation is written `f"{x} + {y}"` (an f-string):
///! the parser desugars each `{expr}` hole through `Display` and each
///! `{expr:?}` hole through `Debug`, building an owned `String`. The
///! desugar targets live in `interp`. The printf-style `printf`/`eprintf`
///! (C `%d`/`%s` specifiers) remain for raw variadic formatted output.

namespace std::fmt;

import std::core::intrinsics;
import std::ffi::libc;
import std::alloc::allocator;
import std::collections::string;

public module fmt::error;
public module fmt::write;
public module fmt::float;
public module fmt::display;
public module fmt::spec;
public module fmt::interp;

// print / println / eprint / eprintln: printf-style variadic output.
//
// These live at the `std::fmt` level (not in a sub-module) so that a
// plain `import std::fmt;` brings them into scope.  `printf("%s is %d",
// name, age)` forwards the variadic bucket to libc's `vprintf` (stdout).
// Format specifiers follow C `printf`: `%d`/`%i`, `%u`, `%s`, `%f`, `%x`,
// `%c`, `%p`, `%%`, plus width/precision.  The C variadic ABI performs no
// runtime type-checking, so a wrong specifier is undefined behaviour
// exactly as in C -- but when the format is a string literal the compiler
// checks each conversion's category against its argument at compile time
// (W0013): `%s` on a `String`, `%d` on a float, or too few arguments is
// flagged.  For fully type-safe, Display-based formatting, build a
// `String` via `format_to_string` (or an f-string) and the `Display`
// trait.

/// Format printf-style into a freshly allocated string.  Returns null when
/// the formatting or the allocation failed.
///
/// Single-pass by construction: `vasprintf` sizes and formats in one go.
/// A measure-then-format pair would need to read the variadic bucket twice,
/// and Cryo has no `va_copy` to give the second pass its own cursor - the
/// first pass leaves the va_list consumed.
///
/// The result is relocated out of `vasprintf`'s libc buffer into `GlobalAlloc`
/// storage (the active per-target arena while the compiler builds itself, plain
/// libc everywhere else) and the libc temp is released.  Callers overwhelmingly
/// leak the result, so a long-running host that recompiles per keystroke - the
/// LSP - reclaims them in bulk at the next arena reset instead of leaking them
/// to libc for the life of the process.  With the arena inactive `GlobalAlloc`
/// IS libc `malloc`, so a caller that frees the result still reaches a matching
/// free.
function format(fmt: string, args...) -> string {
    mut buf: u8* = null;
    const n: i32 = libc::vasprintf(&buf, fmt, args);
    // `n < 0` leaves `*ret` undefined, so `buf` must not be read or freed.
    if (n < 0) { return null; }
    const size: u64 = (n as u64) + 1;
    const out: void* = allocator::alloc(size, 1);
    if (out == null) {
        libc::free(buf as void*);
        return null;
    }
    libc::memcpy(out, buf as void*, size);
    libc::free(buf as void*);
    return out as string;
}

/// Write a printf-style formatted string to stdout.  Returns the number of
/// bytes written, or a negative value on error (libc `printf` convention).
/// Use this for genuinely variadic `%s`/`%d` output; for value formatting
/// prefer an f-string through `println` (Display-based) below.
function printf(fmt: string, args...) -> i32 {
    return libc::vprintf(fmt, args);
}

/// Write an already-formatted `String` (typically an f-string `f"{x}"`) to
/// stdout, then drop it.  Display-based counterpart to `printf`: the f-string
/// desugar already ran each `{expr}` through `Display`/`Debug`, so there is no
/// format string to interpret here (a `%` in the text is data, not a
/// directive).  We go through the real stdout (`printf "%.*s"`) so output
/// stays interleaved with `printf` rather than landing on a second FILE*.
function print(text: String) -> void {
    libc::printf("%.*s", text.length() as i32, text.as_ptr());
}

/// Like `print`, followed by a newline.
function println(text: String) -> void {
    libc::printf("%.*s", text.length() as i32, text.as_ptr());
    libc::putchar(0x0A);
}

// Lazily-opened stderr stream for the `eprint` family.  libc's `stderr`
// global FILE* isn't reachable by name from Cryo, so `fdopen(2)` yields an
// equivalent stream over fd 2.  Cached to avoid leaking a FILE per call; each
// write is flushed since this fdopen'd stream is fully-buffered (unlike a
// real tty stderr).
mut g_fmt_stderr: void*;

private function fmt_stderr_stream() -> void* {
    if (g_fmt_stderr == null) {
        g_fmt_stderr = libc::fdopen(2, "w");
    }
    return g_fmt_stderr;
}

/// Write a printf-style formatted string to stderr.  Same specifier rules as
/// `printf` (see above).  Returns the number of bytes `vfprintf` reported.
function eprintf(fmt: string, args...) -> i32 {
    const stream: void* = fmt_stderr_stream();
    const n: i32 = libc::vfprintf(stream, fmt, args);
    libc::fflush(stream);
    return n;
}

/// Write an already-formatted `String` (typically an f-string) to stderr,
/// then drop it.  Display-based counterpart to `eprintf`.
function eprint(text: String) -> void {
    const stream: void* = fmt_stderr_stream();
    libc::fprintf(stream, "%.*s", text.length() as i32, text.as_ptr());
    libc::fflush(stream);
}

/// Like `eprint`, followed by a newline.
function eprintln(text: String) -> void {
    const stream: void* = fmt_stderr_stream();
    libc::fprintf(stream, "%.*s", text.length() as i32, text.as_ptr());
    libc::fputc(0x0A, stream);
    libc::fflush(stream);
}
