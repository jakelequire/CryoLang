///! Floating-point formatting.
///!
///! Values in the "normal" magnitude range are written as fixed-point
///! decimal with six fractional digits. Anything beyond
///! |v| >= 1e16 or 0 < |v| < 1e-4 falls back to scientific notation
///! so no precision vanishes into a giant zero-prefix or trailing-zero
///! string.
///!
///! This is a first-cut formatter, correct for human-readable output
///! but **not round-trippable**. A round-trip `f64 -> str -> f64` needs
///! a Grisu or Ryu implementation; that's a follow-up.
///!
///! NaN / +/-Infinity / +/-0 are all handled explicitly. Negative zero
///! prints as `-0` so the sign isn't lost.
///!
///! The public API is `f64.to_buf(buffer)` / `f64.to_buf_with(buffer,
///! decimals)` / `f64.to_buf_roundtrip(buffer)`: extension methods on the
///! primitive, each writing at the front of a `mut &Slice<u8>` and
///! returning how many bytes it wrote, or `None`, writing nothing, when
///! the slice is shorter than the writer needs. Integer formatting
///! lives in `core::primitives`; this file is float-only because the
///! implementation needs `libm` (fabs / log10) which `core` deliberately
///! doesn't depend on.  Classification is libm-free (the `fpclass`
///! intrinsic).

namespace std::fmt::float;

import std::core::cmp;
import std::core::intrinsics;
import std::core::option::{ Option };
import std::core::primitives;
import std::core::slice::{ Slice };
import std::ffi::libc;

/// Parse a leading `f64` from `s` using C `strtod` semantics: skip
/// leading whitespace, read the longest valid float prefix (decimal or
/// scientific; no hex floats). Returns `None` when `s` has no numeric
/// prefix.  The single funnel every float-from-text caller routes
/// through, replacing scattered `sscanf("%lf")`.  Caller-supplied
/// strings must already be cleaned of digit separators (`_`), which
/// `strtod` - like `sscanf` - would stop at.
public function parse_f64(s: string) -> Option<f64> {
    if (s == null) { return Option::None; }
    mut end: u8* = null;
    const v: f64 = libc::strtod(s as u8*, &end);
    // `strtod` leaves `endptr == s` when it converts nothing.
    if (end == (s as u8*)) { return Option::None; }
    return Option::Some(v);
}

/// Default fractional digits for fixed-point output.
public const DEFAULT_DECIMALS: i64 = 6;

/// Above this magnitude, switch to scientific.
private const LARGE_THRESHOLD: f64 = 1.0e16;

/// Below this magnitude (and nonzero), switch to scientific.
private const SMALL_THRESHOLD: f64 = 1.0e-4;

/// The bytes every writer below needs at least: enough for any value
/// with up to 13 decimals, and for the round-trip form. Each decimal past
/// 13 needs one more.
public const F64_MAX_DIGITS: i64 = 32;

/// The fixed-point form's bytes before its decimals: a sign, up to 17
/// integer digits (16 below the scientific threshold, one more when
/// rounding carries) and the point. The scientific form is shorter.
private const FIXED_FORM_HEAD: i64 = 19;

/// Fractional places rounded by scaling into a `u64`. An f64 carries at
/// most 17 significant decimal digits, so places past this are written as
/// zeros; `10^17`, and the mantissa's carry check at `10^18`, still fit a
/// `u64`, where a larger power would saturate the conversion.
private const SCALED_DECIMALS: i64 = 17;

// Extension methods on f32: widen to f64 and delegate.
//
// `f32 -> f64` is a free widening cast (no precision loss), so the
// digit logic only lives in one place. Callers that need a true f32-
// specific shortest-round-trip representation will get one when the
// f64 path itself gains Grisu/Ryu; same future work, same code path.

implement f32 {
    /// `f64.to_buf` of this value widened to `f64`.
    public to_buf(&this, buffer: mut &Slice<u8>) -> Option<i64> {
        const v: f64 = this as f64;
        return v.to_buf(buffer);
    }

    /// `f64.to_buf_with` of this value widened to `f64`.
    public to_buf_with(&this, buffer: mut &Slice<u8>, decimals: i64) -> Option<i64> {
        const v: f64 = this as f64;
        return v.to_buf_with(buffer, decimals);
    }

    public is_negative_zero(&this) -> boolean {
        const v: f64 = this as f64;
        return v.is_negative_zero();
    }
}

// Extension methods on f64

implement f64 {
    /// IEEE 754: `-0.0` has bit pattern 0x8000_0000_0000_0000. The cheap
    /// check is `1.0 / v == -Infinity`, but we'd rather not divide; the
    /// direct comparison relies on `value == 0.0` being true for both
    /// +/-0 while the sign bit still drives the output branch.
    public is_negative_zero(&this) -> boolean {
        if (this != 0.0) { return false; }
        // `1.0 / 0.0` is +Infinity, `1.0 / -0.0` is -Infinity.
        return (1.0 / this) < 0.0;
    }

    /// Write `this` with `DEFAULT_DECIMALS` fractional digits at the front
    /// of `buffer`, and return how many bytes that took; `None`, writing
    /// nothing, when `buffer` is shorter than `F64_MAX_DIGITS`.
    public to_buf(&this, buffer: mut &Slice<u8>) -> Option<i64> {
        return this.to_buf_with(buffer, DEFAULT_DECIMALS);
    }

    /// As `to_buf`, with `decimals` fractional digits in the fixed-point
    /// form and in the scientific form's mantissa; zero or less writes
    /// none. `buffer` needs `F64_MAX_DIGITS` bytes, and one more for each
    /// decimal past 13; a shorter one is refused with `None`.
    public to_buf_with(&this, buffer: mut &Slice<u8>, decimals: i64) -> Option<i64> {
        return write_float(buffer, this, decimals, false);
    }

    /// Write `this` in scientific form whatever its magnitude, `decimals`
    /// digits after the mantissa's point: `1234.5` at 2 is `1.23e+3`, and
    /// zero is `0.00e+0`.  `buffer` needs what `to_buf_with` needs.
    internal to_scientific_buf(&this, buffer: mut &Slice<u8>, decimals: i64) -> Option<i64> {
        return write_float(buffer, this, decimals, true);
    }

    /// Write `this` as the SHORTEST decimal string that re-parses (via
    /// `strtod`) to the identical f64 bit value - i.e. a round-trippable
    /// representation. Tries 15, then 16, then 17 significant digits (every
    /// finite double round-trips at 17) and returns the first that reparses
    /// exactly, so typical values stay compact (`0.1`, not the noisy
    /// `0.10000000000000001`). Returns bytes written (excluding the NUL).
    ///
    /// This exists because `to_buf`'s fixed-6-decimal form silently TRUNCATES
    /// precision - `3.141592653589793` became `3.141593` - which made JSON
    /// serialization lossy despite advertising strtod round-tripping. JSON
    /// (and any caller that must preserve f64 values) should use this.
    /// A `buffer` shorter than `F64_MAX_DIGITS` is refused with `None`.
    /// Non-finite inputs (NaN/Inf) have no round-trippable form; callers
    /// handle them first, but as a guard we fall back to the debug spelling.
    public to_buf_roundtrip(&this, buffer: mut &Slice<u8>) -> Option<i64> {
        const value: f64 = this;
        if (!value.is_finite()) {
            return this.to_buf_with(buffer, DEFAULT_DECIMALS);
        }
        if (buffer.length() < F64_MAX_DIGITS) { return Option::None; }
        const out: mut u8* = buffer.as_mutable_ptr();
        mut n: i32 = libc::snprintf(out, 32, "%.15g" as u8*, value);
        if (n > 0 && libc::strtod(out, null) == value) { return Option::Some(n as i64); }
        n = libc::snprintf(out, 32, "%.16g" as u8*, value);
        if (n > 0 && libc::strtod(out, null) == value) { return Option::Some(n as i64); }
        n = libc::snprintf(out, 32, "%.17g" as u8*, value);
        if (n < 0) { return Option::Some(0); }
        return Option::Some(n as i64);
    }
}

// Private helpers

/// `value` with `decimals` fractional digits: in scientific form when
/// `scientific`, and otherwise when its magnitude is past the thresholds.
/// `None`, writing nothing, when `buffer` is shorter than the longest form
/// `decimals` allows, so the writers below never check a length.
private function write_float(buffer: mut &Slice<u8>, value: f64, decimals: i64, scientific: boolean) -> Option<i64> {
    const places: i64 = if (decimals > 0) { decimals } else { 0 };
    if (buffer.length() < cmp::max(F64_MAX_DIGITS, FIXED_FORM_HEAD + places)) {
        return Option::None;
    }
    const out: mut u8* = buffer.as_mutable_ptr();
    if (value.is_nan()) {
        return Option::Some(write_literal(out, "NaN", 3));
    }
    if (value.is_infinite()) {
        if (value < 0.0) {
            return Option::Some(write_literal(out, "-inf", 4));
        }
        return Option::Some(write_literal(out, "inf", 3));
    }

    mut cursor: i64 = 0;
    mut absolute: f64 = value;
    if (value < 0.0 || value.is_negative_zero()) {
        out[cursor] = 0x2D; // '-'
        cursor = cursor + 1;
        absolute = intrinsics::fabs64(value);
    }

    if (absolute == 0.0) {
        if (scientific) {
            cursor = cursor + write_fixed(out + cursor, 0.0, places);
            return Option::Some(cursor + write_literal(out + cursor, "e+0", 3));
        }
        out[cursor] = 0x30; // '0'
        return Option::Some(cursor + 1);
    }

    if (scientific || absolute >= LARGE_THRESHOLD || absolute < SMALL_THRESHOLD) {
        return Option::Some(cursor + write_scientific(out + cursor, absolute, places));
    }
    return Option::Some(cursor + write_fixed(out + cursor, absolute, places));
}

private function write_literal(buffer: mut u8*, literal: u8*, length: i64) -> i64 {
    libc::memcpy(buffer, literal as void*, length as u64);
    return length;
}

/// Fixed-point: integer part, `.`, zero-padded fraction. Assumes
/// `value >= 0` and is within LARGE/SMALL thresholds; caller has
/// routed NaN/Inf/zero/scientific cases already.
private function write_fixed(buffer: mut u8*, value: f64, decimals: i64) -> i64 {
    mut integer_part: u64 = value as u64;

    if (decimals == 0) {
        return integer_part.to_decimal_buf(buffer);
    }

    // Round the fractional part half-up at the requested precision rather
    // than truncating.  Truncation prints a representable value as a
    // *different* one (e.g. 3.14159 -> "3.141589", off by one in the last
    // digit).  When rounding rolls the fraction over to 1.0 (e.g.
    // 0.9999996 at 6 dp), carry into the integer part so the two halves
    // stay consistent.  The fixed-point path only runs for
    // |v| < 1e16, so the carry adds at most one integer digit and the
    // caller's `F64_MAX_DIGITS + decimals` bytes never overflow.
    const scaled_places: i64 = cmp::min(decimals, SCALED_DECIMALS);
    const scale: f64 = libc::pow(10.0, scaled_places as f64);
    const scale_u: u64 = scale as u64;
    mut frac_scaled: u64 = ((value - (integer_part as f64)) * scale + 0.5) as u64;
    if (frac_scaled >= scale_u) {
        frac_scaled = frac_scaled - scale_u;
        integer_part = integer_part + 1;
    }

    mut cursor: i64 = integer_part.to_decimal_buf(buffer);
    buffer[cursor] = 0x2E; // '.'
    cursor = cursor + 1;
    cursor = cursor + frac_scaled.to_decimal_padded_buf(buffer + cursor, scaled_places);
    for (mut place: i64 = scaled_places; place < decimals; place++) {
        buffer[cursor] = 0x30; // '0'
        cursor = cursor + 1;
    }
    return cursor;
}

/// Scientific: `<mantissa>e<sign><exponent>`. Assumes `value > 0`.
private function write_scientific(buffer: mut u8*, value: f64, decimals: i64) -> i64 {
    const exponent: i64 = libc::log10(value) as i64;
    // `log10` rounds toward nearest, not toward zero; if the floor
    // landed one step high we end up with mantissa < 1. Correct by
    // walking the exponent down.
    mut e: i64 = exponent;
    mut mantissa: f64 = value / libc::pow(10.0, e as f64);
    if (mantissa < 1.0) {
        e = e - 1;
        mantissa = value / libc::pow(10.0, e as f64);
    } else if (mantissa >= 10.0) {
        e = e + 1;
        mantissa = value / libc::pow(10.0, e as f64);
    }

    // `write_fixed` rounds the mantissa half-up at `decimals` places, which can
    // carry it up to 10.0 (e.g. 9.9999996 at 6 dp -> "10.000000"), printing
    // "10.0e20" instead of the normalized "1.0e21". Detect that carry at the
    // requested precision and bump the exponent so the mantissa renormalizes to
    // ~1.0 before formatting.
    const round_scale: f64 = libc::pow(10.0, cmp::min(decimals, SCALED_DECIMALS) as f64);
    if (((mantissa * round_scale) + 0.5) as u64 >= (10.0 * round_scale) as u64) {
        e = e + 1;
        mantissa = value / libc::pow(10.0, e as f64);
    }

    mut cursor: i64 = write_fixed(buffer, mantissa, decimals);
    buffer[cursor] = 0x65; // 'e'
    cursor = cursor + 1;

    mut exp_magnitude: u64 = 0;
    if (e < 0) {
        buffer[cursor] = 0x2D; // '-'
        cursor = cursor + 1;
        exp_magnitude = (0 - e) as u64;
    } else {
        buffer[cursor] = 0x2B; // '+'
        cursor = cursor + 1;
        exp_magnitude = e as u64;
    }
    cursor = cursor + exp_magnitude.to_decimal_buf(buffer + cursor);
    return cursor;
}

