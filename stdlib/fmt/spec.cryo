///! Format-spec parsing and rendering for f-string holes.
///!
///! An f-string hole may carry a spec after a colon: `f"{value:spec}"`.
///! The grammar:
///!
///!   spec := [[fill]align][#][0][width][.precision][type]
///!   align := '<' | '>' | '^'          (left, right, centre)
///!   type  := 'x' | 'X' | 'o' | 'b'    (lower/upper hex, octal, binary)
///!
///! `#` prefixes a radix with `0x`/`0o`/`0b`; a leading `0` zero-pads
///! (sign/prefix stay leftmost). `width` is a minimum field width in
///! Unicode scalars; `.precision` truncates a Display value to that many
///! scalars, or sets the fractional digits of a float.
///!
///! The parser (`fmt_parse_spec`) turns the spec string into a `FmtSpec`;
///! the render helpers here build the padded output. `fmt/interp.cryo`
///! owns the per-type dispatch (`static match (T)`) that picks the right
///! render helper - that is the only piece that must know `T`.

namespace std::fmt::spec;

import std::core::option::{ Option };
import std::core::result::{ Result };
import std::core::iter::{ Iterator };
import std::collections::str::{ Str };
import std::collections::string::{ String };
import std::collections::pair::{ Pair };
import std::fmt::display::{ Display, format_to_string, Formatter };
import std::fmt::error::{ FmtError };
import std::core::mem;

/// No radix: format the value in its natural (decimal / Display) form.
const RADIX_NONE:      u8 = 0;
const RADIX_HEX_LOWER: u8 = 1;
const RADIX_HEX_UPPER: u8 = 2;
const RADIX_OCT:       u8 = 3;
const RADIX_BIN:       u8 = 4;

/// Default alignment: left for text and numbers alike (a `0` flag or an
/// explicit `>`/`^` overrides it), whatever the value's type, so the
/// default never depends on what is formatted.
const ALIGN_DEFAULT: u8 = 0;
const ALIGN_LEFT:    u8 = 1;
const ALIGN_RIGHT:   u8 = 2;
const ALIGN_CENTER:  u8 = 3;

/// Space scalar - the default fill.
const FILL_SPACE: u32 = 0x20;
/// Zero scalar - the fill a `0` flag selects.
const FILL_ZERO:  u32 = 0x30;

/// A parsed format spec. Field defaults describe an empty spec (plain
/// Display, no padding).
type struct FmtSpec {
    fill:          u32;      // scalar fill char
    align:         u8;       // ALIGN_*
    alternate:     boolean;  // '#' - radix prefix
    zero_pad:      boolean;  // '0' - sign-aware zero fill
    width:         i64;      // minimum field width, in scalars
    has_precision: boolean;
    precision:     i64;
    radix:         u8;       // RADIX_*

    static empty() -> FmtSpec {
        return FmtSpec {
            fill: FILL_SPACE, align: ALIGN_DEFAULT, alternate: false,
            zero_pad: false, width: 0, has_precision: false, precision: 0,
            radix: RADIX_NONE,
        };
    }
}

/// True for the alignment sigils `<` `>` `^`.
function is_align_byte(b: u8) -> boolean {
    return b == 0x3C || b == 0x3E || b == 0x5E;
}

/// Map an alignment sigil byte to its `ALIGN_*` code.
function align_of_byte(b: u8) -> u8 {
    if (b == 0x3C) { return ALIGN_LEFT; }
    if (b == 0x3E) { return ALIGN_RIGHT; }
    return ALIGN_CENTER;   // '^'
}

/// Parse a spec string (the text after the `:` in a hole) into a
/// `FmtSpec`. The compiler has already validated the grammar, so this
/// walks it without re-checking; an unexpected byte is simply ignored.
function fmt_parse_spec(spec: Str) -> FmtSpec {
    mut s: FmtSpec = FmtSpec::empty();
    const n: i64 = spec.length();
    const bytes: u8* = spec.as_ptr();
    mut i: i64 = 0;

    // [fill]align  |  align
    if (n >= 2 && is_align_byte(bytes[1])) {
        s.fill = bytes[0] as u32;
        s.align = align_of_byte(bytes[1]);
        i = 2;
    } else if (n >= 1 && is_align_byte(bytes[0])) {
        s.align = align_of_byte(bytes[0]);
        i = 1;
    }

    // '#'
    if (i < n && bytes[i] == 0x23) {
        s.alternate = true;
        i = i + 1;
    }

    // leading '0' flag
    if (i < n && bytes[i] == 0x30) {
        s.zero_pad = true;
        i = i + 1;
    }

    // width digits
    while (i < n && bytes[i] >= 0x30 && bytes[i] <= 0x39) {
        s.width = s.width * 10 + ((bytes[i] - 0x30) as i64);
        i = i + 1;
    }

    // '.' precision
    if (i < n && bytes[i] == 0x2E) {
        i = i + 1;
        s.has_precision = true;
        s.precision = 0;
        while (i < n && bytes[i] >= 0x30 && bytes[i] <= 0x39) {
            s.precision = s.precision * 10 + ((bytes[i] - 0x30) as i64);
            i = i + 1;
        }
    }

    // type
    if (i < n) {
        const t: u8 = bytes[i];
        if (t == 0x78)      { s.radix = RADIX_HEX_LOWER; }   // 'x'
        else if (t == 0x58) { s.radix = RADIX_HEX_UPPER; }   // 'X'
        else if (t == 0x6F) { s.radix = RADIX_OCT; }         // 'o'
        else if (t == 0x62) { s.radix = RADIX_BIN; }         // 'b'
    }

    return s;
}

// ----------------------------------------------------------------------
// Body builders: render the value's digits/text (no field padding yet)
// and report how many leading bytes are sign/prefix (so a `0` flag can
// zero-fill after them). Padding is applied by `fmt_pad`.
// ----------------------------------------------------------------------

/// Radix prefix for `#`: `0x` / `0o` / `0b`. Empty for decimal or when
/// `alternate` is off.
function radix_prefix(spec: &FmtSpec) -> Str {
    if (!spec.alternate) { return Str::new(""); }
    if (spec.radix == RADIX_HEX_LOWER) { return Str::new("0x"); }
    if (spec.radix == RADIX_HEX_UPPER) { return Str::new("0x"); }
    if (spec.radix == RADIX_OCT)       { return Str::new("0o"); }
    if (spec.radix == RADIX_BIN)       { return Str::new("0b"); }
    return Str::new("");
}

/// The bytes a number's body needs at most: a sign or a two-byte radix
/// prefix and 64 binary digits, or a float written with a precision.
internal const NUMBER_BODY_BYTES: i64 = 72;

/// Write the magnitude `val` in the spec's radix into `out`; the number
/// of bytes written.
function radix_digits(val: u64, spec: &FmtSpec, out: u8*) -> i64 {
    if (spec.radix == RADIX_HEX_LOWER) { return val.to_hex_buf(out); }
    if (spec.radix == RADIX_HEX_UPPER) { return val.to_hex_upper_buf(out); }
    if (spec.radix == RADIX_OCT)       { return val.to_oct_buf(out); }
    if (spec.radix == RADIX_BIN)       { return val.to_bin_buf(out); }
    return val.to_decimal_buf(out);
}

/// Body for an unsigned integer, written into `out` (`NUMBER_BODY_BYTES`):
/// optional radix prefix + digits, the prefix its `head_len`.
function fmt_uint_body(val: u64, spec: &FmtSpec, out: u8*) -> BodyText {
    mut head: i64 = 0;
    if (spec.radix != RADIX_NONE) {
        const prefix: Str = radix_prefix(spec);
        for (mut i: i64 = 0; i < prefix.length(); i++) { out[i] = prefix.as_ptr()[i]; }
        head = prefix.length();
    }
    return BodyText::number(out, head + radix_digits(val, spec, out + head), head);
}

/// Body for a signed integer, written into `out` (`NUMBER_BODY_BYTES`).
/// Decimal keeps the sign; a radix formats the two's-complement bit
/// pattern `masked` (already narrowed to the value's own width by the
/// caller) with no sign: `-1i8` in hex is `ff`.
function fmt_sint_body(val: i64, masked: u64, spec: &FmtSpec, out: u8*) -> BodyText {
    if (spec.radix != RADIX_NONE) {
        return fmt_uint_body(masked, spec, out);
    }
    if (val >= 0) {
        return BodyText::number(out, (val as u64).to_decimal_buf(out), 0);
    }
    out[0] = 0x2D;   // '-'
    // Negate in u64 space so i64::MIN (whose magnitude overflows i64)
    // still yields the right digits.
    const magnitude: u64 = (0 - val) as u64;
    return BodyText::number(out, 1 + magnitude.to_decimal_buf(out + 1), 1);
}

/// Body for a float, written into `out` (`NUMBER_BODY_BYTES`). With a
/// precision, uses fixed fractional digits; without, the form `Display`
/// writes. The sign is part of the text, so `head_len` marks a leading
/// `-` for zero-fill.
function fmt_float_body(val: f64, spec: &FmtSpec, out: u8*) -> BodyText {
    const written: i64 = if (spec.has_precision) {
        val.to_buf_with(out, spec.precision as i64)
    } else {
        val.to_buf(out)
    };
    const head: i64 = if (written > 0 && out[0] == 0x2D) { 1 } else { 0 };
    return BodyText::number(out, written, head);
}

/// Body for any Display value that is not an integer or float: render it,
/// then truncate to `precision` scalars if one is set.
function fmt_display_body<T>(value: &T, spec: &FmtSpec) -> BodyText
where T: Display {
    mut out: String = String::new();
    match (format_to_string::<T>(value)) {
        Result::Ok(s)  => { mut tmp: String = s; out.push(tmp.as_str()); mem::drop(tmp); }
        Result::Err(_) => { }
    }
    mut length: i64 = out.length();
    if (spec.has_precision) {
        length = truncate_scalars(out.as_str(), spec.precision).length();
    }
    return BodyText { text: out, digits: null, length: length, head_len: 0 };
}

/// The rendered digits/text of a value plus the length of its leading
/// sign/radix-prefix run (bytes that a `0` flag must keep leftmost).  A
/// number's body is the first `length` bytes at `digits`, a buffer its
/// caller owns; any other value's is the first `length` bytes of `text`.
type struct BodyText {
    text:     String;
    digits:   u8*;
    length:   i64;
    head_len: i64;

    /// A number's body: `length` bytes at `digits`.
    static number(digits: u8*, length: i64, head_len: i64) -> BodyText {
        return BodyText { text: String::new(), digits: digits, length: length, head_len: head_len };
    }

    /// The body's text.
    as_str(&this) -> Str {
        if (this.digits != null) { return Str::from_raw(this.digits, this.length); }
        return this.text.as_str().sub_bytes(0, this.length);
    }
}

implement trait Drop for struct BodyText {
    drop(mut &this) -> void { }
}

/// Truncate `s` to at most `n` Unicode scalars, returning a borrowed
/// prefix.
function truncate_scalars(s: Str, n: i64) -> Str {
    mut seen: i64 = 0;
    mut ci: implement Iterator<Pair<i64, u32>> = s.char_indices();
    loop {
        match (ci.next()) {
            Option::Some(p) => {
                if (seen == n) {
                    return s.sub_bytes(0, p.first);
                }
                seen = seen + 1;
            }
            Option::None => { return s; }
        }
    }
}

/// Write `body` through `f`, padded to the spec's field width. `head_len`
/// is the leading sign/prefix run for sign-aware zero-fill.
function fmt_pad(f: mut &Formatter, body: Str, head_len: i64, spec: &FmtSpec) -> Result<(), FmtError> {
    const count: i64 = body.chars().count();
    if (count >= spec.width) { return f.write_str(body); }
    const padn: i64 = spec.width - count;

    // Resolve alignment and fill, honouring the `0` flag when no explicit
    // alignment was given.
    mut align: u8 = spec.align;
    mut fill: char = spec.fill as char;
    if (align == ALIGN_DEFAULT) {
        if (spec.zero_pad) { align = ALIGN_RIGHT; fill = FILL_ZERO as char; }
        else { align = ALIGN_LEFT; }
    }

    // How much of the fill goes before the body, and where in the body it
    // goes: after the sign/prefix run for a right-aligned zero-fill, which
    // keeps the sign/prefix leftmost.
    mut before: i64 = padn;
    if (align == ALIGN_LEFT) { before = 0; }
    if (align == ALIGN_CENTER) { before = padn / 2; }
    mut split: i64 = 0;
    if (align == ALIGN_RIGHT && spec.zero_pad && head_len > 0) { split = head_len; }

    if (split > 0) { f.write_str(body.sub_bytes(0, split))?; }
    for (mut k: i64 = 0; k < before; k++) { f.write_char(fill)?; }
    f.write_str(body.sub_bytes(split, body.length()))?;
    for (mut k: i64 = before; k < padn; k++) { f.write_char(fill)?; }
    return Result::Ok(());
}
