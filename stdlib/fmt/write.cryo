///! FmtWrite: the sink trait every formatter writes through.
///!
///! Parallels `io::Write` but with a distinct error type. A sink over a
///! byte stream reports failure as `IoError`; a heap-backed sink
///! (`String`) reports failure as `AllocError`. `FmtError` unifies both
///! so `Display` and `Debug` have a single return shape regardless of
///! where the bytes land.
///!
///! Every sink that wants to be a format target implements this trait.
///! A byte stream is written through `io::Write`, whose own `write` takes
///! text as well as bytes; the standard library's format target is
///! `String`, whose implementation lives here.

namespace std::fmt::write;

import std::core::result::{ Result };
import std::alloc::allocator::{ GlobalAlloc };
import std::collections::str::{ Str };
import std::collections::string::{ String };
import std::fmt::error::{ FmtError };
import std::fmt::display::{ Formatter };
import std::fmt::interp::{ Arguments };

type trait FmtWrite {
    /// Write `source` in full, returning when the whole view has been
    /// accepted by the sink or surfacing the first failure.  This is the
    /// ONE required method; everything else routes through it.  The
    /// argument is a `Str`, so the sink only ever sees valid UTF-8 - the
    /// invariant that lets a text container like `String` be a format
    /// target.  (A byte sink that isn't UTF-8-constrained is an
    /// `io::Write`, not an `FmtWrite`.)
    write_str(mut &this, source: Str) -> Result<(), FmtError>;

    /// Write a single Unicode scalar, UTF-8-encoded (1-4 bytes).  Routes
    /// through `write_str`; the formatter uses it for punctuation such as
    /// the quotes `Debug` puts around a string, and every `char` is
    /// written through it.
    write_char(mut &this, c: char) -> Result<(), FmtError> {
        mut buffer: [u8; 4];
        const length: i64 = encode_utf8(c as u32, &buffer[0]);
        return this.write_str(Str::from_raw(&buffer[0], length));
    }

    /// Write an f-string, `sink.write(f"x = {x}")`, formatting each hole
    /// straight into this sink: an f-string written here is the
    /// `Arguments` of its pieces, not a `String` (`fmt::Arguments`).
    write(mut &this, arguments: Arguments) -> Result<(), FmtError> {
        mut f: Formatter = Formatter::new(&this);
        return arguments.write_to(&f);
    }
}

/// Encode a Unicode scalar value as UTF-8 into `out`, which must hold at
/// least 4 bytes, and return the number of bytes written.  A value that is
/// not a scalar - a surrogate half (0xD800..=0xDFFF) or one past
/// `char::MAX` - is written as U+FFFD, the replacement character, so the
/// output is always well-formed UTF-8.
private function encode_utf8(scalar: u32, out: u8*) -> i64 {
    if (scalar < 0x80) {
        out[0] = scalar as u8;
        return 1;
    }
    if (scalar < 0x800) {
        out[0] = (0xC0 | (scalar >> 6)) as u8;
        out[1] = (0x80 | (scalar & 0x3F)) as u8;
        return 2;
    }
    if ((scalar >= 0xD800 && scalar <= 0xDFFF) || scalar > char::MAX as u32) {
        out[0] = 0xEF;
        out[1] = 0xBF;
        out[2] = 0xBD;
        return 3;
    }
    if (scalar < 0x10000) {
        out[0] = (0xE0 | (scalar >> 12)) as u8;
        out[1] = (0x80 | ((scalar >> 6) & 0x3F)) as u8;
        out[2] = (0x80 | (scalar & 0x3F)) as u8;
        return 3;
    }
    out[0] = (0xF0 | (scalar >> 18)) as u8;
    out[1] = (0x80 | ((scalar >> 12) & 0x3F)) as u8;
    out[2] = (0x80 | ((scalar >> 6) & 0x3F)) as u8;
    out[3] = (0x80 | (scalar & 0x3F)) as u8;
    return 4;
}

/// `String` as a format target. Errors bubble up as
/// `FmtError::Alloc`, not `FmtError::Io`; nothing here touches a
/// file descriptor.
implement trait FmtWrite for struct String<GlobalAlloc> {
    write_str(mut &this, source: Str) -> Result<(), FmtError> {
        match (this.try_push(source)) {
            Result::Ok(_) => { return Result::Ok(()); }
            Result::Err(err) => { return Result::Err(FmtError::Alloc(err)); }
        }
    }
}
