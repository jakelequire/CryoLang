///! FmtWrite: the sink trait every formatter writes through.
///!
///! Parallels `io::Write` but with a distinct error type. A byte-level
///! sink (`Stdout`, `File`, `TcpStream`, `BufWriter`) reports failure
///! as `IoError`; a heap-backed sink (`String`) reports failure as
///! `AllocError`. `FmtError` unifies both so `Display` and `Debug`
///! have a single return shape regardless of where the bytes land.
///!
///! Every sink that wants to be a format target implements this
///! trait. Stdlib impls live here rather than alongside each sink
///! because they all have the same two-line shape.

namespace std::fmt::write;

import core::option;
import core::result;
import core::slice;
import io::error;
import io::traits;
import io::stdio;
import alloc::allocator;
import collections::str;
import collections::string;
import fmt::error;

type trait FmtWrite {
    /// Write `source` in full, returning when the whole view has been
    /// accepted by the sink or surfacing the first failure.  This is the
    /// ONE required method; everything else routes through it.  The
    /// argument is a `Str`, so the sink only ever sees valid UTF-8 - the
    /// invariant that lets a text container like `String` be a format
    /// target.  (A byte sink that isn't UTF-8-constrained is an
    /// `io::Write`, not an `FmtWrite`.)
    write_str(mut &this, source: Str) -> Result<(), FmtError>;

    /// Write a single Unicode scalar, UTF-8-encoded (1-4 bytes).  Routes
    /// through `write_str`; the formatter uses it for punctuation such as
    /// the quotes `Debug` puts around a string.
    write_char(mut &this, c: char) -> Result<(), FmtError> {
        const cp: u32 = c as u32;
        mut buf: u8[4];
        mut n: u64 = 1;
        if (cp < 0x80) {
            buf[0] = cp as u8;
        } else if (cp < 0x800) {
            buf[0] = (0xC0 | (cp >> 6)) as u8;
            buf[1] = (0x80 | (cp & 0x3F)) as u8;
            n = 2;
        } else if (cp < 0x10000) {
            buf[0] = (0xE0 | (cp >> 12)) as u8;
            buf[1] = (0x80 | ((cp >> 6) & 0x3F)) as u8;
            buf[2] = (0x80 | (cp & 0x3F)) as u8;
            n = 3;
        } else {
            buf[0] = (0xF0 | (cp >> 18)) as u8;
            buf[1] = (0x80 | ((cp >> 12) & 0x3F)) as u8;
            buf[2] = (0x80 | ((cp >> 6) & 0x3F)) as u8;
            buf[3] = (0x80 | (cp & 0x3F)) as u8;
            n = 4;
        }
        return this.write_str(Str::from_raw(&buf[0], n));
    }
}

implement trait FmtWrite for struct Stdout {
    write_str(mut &this, source: Str) -> Result<(), FmtError> {
        match (this.write(source.as_bytes())) {
            Result::Ok(_) => { return Result::Ok(()); }
            Result::Err(err) => { return Result::Err(FmtError::Io(err)); }
        }
    }
}

implement trait FmtWrite for struct Stderr {
    write_str(mut &this, source: Str) -> Result<(), FmtError> {
        match (this.write(source.as_bytes())) {
            Result::Ok(_) => { return Result::Ok(()); }
            Result::Err(err) => { return Result::Err(FmtError::Io(err)); }
        }
    }
}

/// `String` as a format target. Errors bubble up as
/// `FmtError::Alloc`, not `FmtError::Io`; nothing here touches a
/// file descriptor.
implement trait FmtWrite for struct String {
    write_str(mut &this, source: Str) -> Result<(), FmtError> {
        match (this.try_push(source)) {
            Result::Ok(_) => { return Result::Ok(()); }
            Result::Err(err) => { return Result::Err(FmtError::Alloc(err)); }
        }
    }
}
