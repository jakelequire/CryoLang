///! FmtWrite — the sink trait every formatter writes through.
///!
///! Parallels `io::Write` but with a distinct error type. A byte-level
///! sink (`Stdout`, `File`, `TcpStream`, `BufWriter`) reports failure
///! as `IoError`; a heap-backed sink (`String`) reports failure as
///! `AllocError`. `FmtError` unifies both so `Display` and `Debug`
///! have a single return shape regardless of where the bytes land.
///!
///! Every sink that wants to be a format target implements this
///! trait. Stdlib impls live here rather than alongside each sink
///! because they all have the same two-line shape.

namespace std::fmt::write;

import core::option;
import core::result;
import core::slice;
import io::error;
import io::traits;
import io::stdio;
import alloc::allocator;
import collections::str;
import collections::string;
import fmt::error;

// ============================================================================
// Trait
// ============================================================================

type trait FmtWrite {
    /// Write every byte of `source`. Returns when the entire slice has
    /// been accepted by the sink or surfaces the first failure.
    write_str(mut &this, source: Str) -> Result<(), FmtError>;

    /// Raw-byte variant. UTF-8 in, UTF-8 out — callers use this for
    /// pre-formatted ASCII (integer digits, keyword bytes) without
    /// paying for a `Str` round trip. Default routes through
    /// `write_str`; writers can override if a direct byte path is
    /// cheaper.
    write_bytes(mut &this, bytes: Slice<u8>) -> Result<(), FmtError> {
        return this.write_str(Str::from_bytes(bytes));
    }

    /// Single byte. Override with a direct path where worthwhile.
    write_byte(mut &this, byte: u8) -> Result<(), FmtError> {
        const local: u8[1] = [byte];
        return this.write_bytes(Slice::from_raw(&local[0], 1));
    }
}

// ============================================================================
// Stdio impls
// ============================================================================

implement trait FmtWrite for struct Stdout {
    write_str(mut &this, source: Str) -> Result<(), FmtError> {
        match (this.write_all(source.as_bytes())) {
            Result::Ok(_) => { return Result::Ok(()); }
            Result::Err(err) => { return Result::Err(FmtError::Io(err)); }
        }
    }

    write_bytes(mut &this, bytes: Slice<u8>) -> Result<(), FmtError> {
        match (this.write_all(bytes)) {
            Result::Ok(_) => { return Result::Ok(()); }
            Result::Err(err) => { return Result::Err(FmtError::Io(err)); }
        }
    }
}

implement trait FmtWrite for struct Stderr {
    write_str(mut &this, source: Str) -> Result<(), FmtError> {
        match (this.write_all(source.as_bytes())) {
            Result::Ok(_) => { return Result::Ok(()); }
            Result::Err(err) => { return Result::Err(FmtError::Io(err)); }
        }
    }

    write_bytes(mut &this, bytes: Slice<u8>) -> Result<(), FmtError> {
        match (this.write_all(bytes)) {
            Result::Ok(_) => { return Result::Ok(()); }
            Result::Err(err) => { return Result::Err(FmtError::Io(err)); }
        }
    }
}

// ============================================================================
// String impl
// ============================================================================

/// `String` as a format target. Errors bubble up as
/// `FmtError::Alloc`, not `FmtError::Io` — nothing here touches a
/// file descriptor.
implement trait FmtWrite for struct String {
    write_str(mut &this, source: Str) -> Result<(), FmtError> {
        match (this.try_push_str(source)) {
            Result::Ok(_) => { return Result::Ok(()); }
            Result::Err(err) => { return Result::Err(FmtError::Alloc(err)); }
        }
    }

    write_bytes(mut &this, bytes: Slice<u8>) -> Result<(), FmtError> {
        return this.write_str(Str::from_bytes(bytes));
    }
}
