/// `Debug` for `char` wraps the character in single quotes and
/// escapes the same set `Debug<Str>` does, so `print('\n' as debug)`
/// is unambiguous.
implement trait Debug for char {
    fmt(&this, f: mut &Formatter) -> Result<(), FmtError> {
        f.write_char(0x27 as char)?; // '\''
        write_debug_scalar(f, this as u32, 0x27)?;
        return f.write_char(0x27 as char);
    }
}

/// `Debug for Str` wraps the content in double quotes and escapes
/// `"`, `\`, control bytes, and non-ASCII low codepoints so the
/// printed form is unambiguous and valid UTF-8 regardless of the
/// source. Round-trippable by a parser that understands `\n`,
/// `\r`, `\t`, `\\`, `\"`, `\xNN`.
implement trait Debug for struct Str {
    fmt(&this, f: mut &Formatter) -> Result<(), FmtError> {
        f.write_char(0x22 as char)?; // '"'
        const bytes: &Slice<u8> = this.as_bytes();
        const base: u8* = bytes.as_ptr();
        const len: i64 = bytes.length();
        // Emit maximal runs of non-escaped bytes as one `Str` each: a run
        // is a substring of the (valid-UTF-8) source, so it satisfies
        // `write_str`'s UTF-8 contract even where it spans multi-byte
        // scalars.  Only bytes that need escaping are handled one at a time.
        mut run_start: i64 = 0;
        mut i: i64 = 0;
        while (i < len) {
            match (bytes.get(i)) {
                Option::Some(byte) => {
                    // Escaped if `write_debug_byte` would not pass it
                    // through: backslash, the `"` delimiter, any control
                    // byte (< 0x20, covering \n \r \t \0), or DEL (0x7F).
                    if (byte == 0x5C || byte == 0x22 || byte < 0x20 || byte == 0x7F) {
                        if (i > run_start) {
                            f.write_str(Str::from_raw(base + run_start, i - run_start))?;
                        }
                        write_debug_byte(f, byte, 0x22)?;
                        run_start = i + 1;
                    }
                }
                Option::None => { break; }
            }
            i++;
        }
        if (len > run_start) {
            f.write_str(Str::from_raw(base + run_start, len - run_start))?;
        }
        return f.write_char(0x22 as char);
    }
}

implement trait Debug for struct String<GlobalAlloc> {
    fmt(&this, f: mut &Formatter) -> Result<(), FmtError> {
        const view: Str = this.as_str();
        return (Debug for Str)::fmt(&view, f);
    }
}

/// Escape a single byte for Debug output. `quote` is the surrounding
/// delimiter: a quote matching the delimiter is escaped, a quote
/// of the other flavor is passed through.
private function write_debug_byte(f: mut &Formatter,byte: u8, quote: u8) -> Result<(), FmtError> {
    if (byte == 0x5C) {
        return f.write_str(Str::new("\\\\"));
    }
    if (byte == quote) {
        if (quote == 0x22) {
            return f.write_str(Str::new("\\\""));
        }
        return f.write_str(Str::new("\\'"));
    }
    if (byte == 0x0A) {
        return f.write_str(Str::new("\\n"));
    }
    if (byte == 0x0D) {
        return f.write_str(Str::new("\\r"));
    }
    if (byte == 0x09) {
        return f.write_str(Str::new("\\t"));
    }
    if (byte == 0x00) {
        return f.write_str(Str::new("\\0"));
    }
    if (byte < 0x20 || byte == 0x7F) {
        // Other control byte: emit as \xNN so the dump is safe to
        // paste into a terminal without triggering escape sequences.
        mut escape: [u8; 4];
        escape[0] = 0x5C; // '\\'
        escape[1] = 0x78; // 'x'
        const byte_val: u64 = byte as u64;
        byte_val.to_hex_padded_buf(&escape[2], 2);
        return f.write_str(Str::from_raw(&escape[0], 4));
    }
    // Printable ASCII passes through verbatim.  `byte` is always < 0x80
    // here: `write_debug_scalar` only calls this for ASCII scalars, and
    // `Debug<Str>` batches its own non-escaped byte runs (which may be
    // multi-byte UTF-8) into `write_str`, never routing a high byte here.
    return f.write_char(byte as char);
}

/// Escape one Unicode scalar for Debug<char> output. Non-ASCII
/// scalars are emitted as `\u{XXXX}` to keep terminal output safe.
private function write_debug_scalar(f: mut &Formatter,scalar: u32, quote: u8) -> Result<(), FmtError> {
    if (scalar < 0x80) {
        return write_debug_byte(f, scalar as u8, quote);
    }
    f.write_str(Str::new("\\u{"))?;
    mut buffer: [u8; 8];
    const scalar_val: u64 = scalar as u64;
    const digits: i64 =scalar_val.to_hex_buf(&buffer[0]);
    f.write_str(Str::from_raw(&buffer[0], digits))?;
    return f.write_char(0x7D as char); // '}'
}

// Composite Display / Debug impls: Option, Result
//
// These recurse into the wrapped value's own `fmt`.  The recursion is
// trait-correct: inside `Display::fmt` a nested `.fmt()` dispatches to the
// element's `Display`; inside `Debug::fmt` it dispatches to `Debug` (the
// compiler's bound-directed dispatch threads the enclosing trait).  Each
// write short-circuits on error via the `?` operator.

implement<T> trait Display for enum Option<T>
where T: Display {
    fmt(&this, f: mut &Formatter) -> Result<(), FmtError> {
        match (&this) {
            Option::Some(value) => {
                f.write_str(Str::new("Some("))?;
                value.fmt(f)?;
                return f.write_str(Str::new(")"));
            }
            Option::None => {
                return f.write_str(Str::new("None"));
            }
        }
    }
}

/// Construct a `Result<(), FmtError>` error.  Defined OUTSIDE the
/// `implement ... for Result` blocks below because inside them the bare
/// `Result::Err` constructor binds to the Self enum (`Result<T, E>`)
/// rather than `Result<(), FmtError>`, producing a type mismatch.  As a
/// free function the name resolves unambiguously.
private function fmt_err(e: FmtError) -> Result<(), FmtError> {
    return Result::Err(e);
}

implement<T, E> trait Display for enum Result<T, E>
where T: Display, E: Display {
    fmt(&this, f: mut &Formatter) -> Result<(), FmtError> {
        match (&this) {
            Result::Ok(value) => {
                match (f.write_str(Str::new("Ok("))) {
                    Result::Ok(_) => { }
                    Result::Err(e) => { return fmt_err(e); }
                }
                match (value.fmt(f)) {
                    Result::Ok(_) => { }
                    Result::Err(e) => { return fmt_err(e); }
                }
                return f.write_str(Str::new(")"));
            }
            Result::Err(err) => {
                match (f.write_str(Str::new("Err("))) {
                    Result::Ok(_) => { }
                    Result::Err(e) => { return fmt_err(e); }
                }
                match (err.fmt(f)) {
                    Result::Ok(_) => { }
                    Result::Err(e) => { return fmt_err(e); }
                }
                return f.write_str(Str::new(")"));
            }
        }
    }
}

// Composite Display / Debug impls: Array, HashMap
//
// `Array<T>` renders as `[a, b, c]`; `HashMap<K, V>` as `{k: v, k2: v2}`.
// Elements are borrowed in place (Array via `get_ref`, HashMap via the
// public bucket walk) so these work for owning element types.  The nested
// `.fmt()` dispatches to the element's Display inside `Display::fmt` and to
// its Debug inside `Debug::fmt` (bound-directed dispatch).

implement<T, A> trait Display for struct Array<T, A>
where T: Display, A: Allocator {
    fmt(&this, f: mut &Formatter) -> Result<(), FmtError> {
        f.write_str(Str::new("["))?;
        const n: i64 = this.length();
        mut i: i64 = 0;
        while (i < n) {
            if (i > 0) {
                f.write_str(Str::new(", "))?;
            }
            match (this.get_ref(i)) {
                Option::Some(p) => {
                    p.fmt(f)?;
                }
                Option::None => { }
            }
            i = i + 1;
        }
        return f.write_str(Str::new("]"));
    }
}

implement<T, A> trait Debug for struct Array<T, A>
where T: Debug, A: Allocator {
    fmt(&this, f: mut &Formatter) -> Result<(), FmtError> {
        f.write_str(Str::new("["))?;
        const n: i64 = this.length();
        mut i: i64 = 0;
        while (i < n) {
            if (i > 0) {
                f.write_str(Str::new(", "))?;
            }
            match (this.get_ref(i)) {
                Option::Some(p) => {
                    p.fmt(f)?;
                }
                Option::None => { }
            }
            i = i + 1;
        }
        return f.write_str(Str::new("]"));
    }
}

implement<K, V, A, H> trait Display for struct HashMap<K, V, A, H>
where K: Display, V: Display, A: Allocator {
    fmt(&this, f: mut &Formatter) -> Result<(), FmtError> {
        f.write_str(Str::new("{"))?;
        const nb: u64 = this.bucket_count();
        mut bi: u64 = 0;
        mut first: boolean = true;
        while (bi < nb) {
            mut node: Entry<K, V>* = this.get_bucket(bi);
            while (node != null) {
                if (!first) {
                    f.write_str(Str::new(", "))?;
                }
                first = false;
                node.key.fmt(f)?;
                f.write_str(Str::new(": "))?;
                node.value.fmt(f)?;
                node = node.next;
            }
            bi = bi + 1;
        }
        return f.write_str(Str::new("}"));
    }
}

implement<K, V, A, H> trait Debug for struct HashMap<K, V, A, H>
where K: Debug, V: Debug, A: Allocator {
    fmt(&this, f: mut &Formatter) -> Result<(), FmtError> {
        f.write_str(Str::new("{"))?;
        const nb: u64 = this.bucket_count();
        mut bi: u64 = 0;
        mut first: boolean = true;
        while (bi < nb) {
            mut node: Entry<K, V>* = this.get_bucket(bi);
            while (node != null) {
                if (!first) {
                    f.write_str(Str::new(", "))?;
                }
                first = false;
                node.key.fmt(f)?;
                f.write_str(Str::new(": "))?;
                node.value.fmt(f)?;
                node = node.next;
            }
            bi = bi + 1;
        }
        return f.write_str(Str::new("}"));
    }
}

// HashSet renders as `{a, b, c}` (set notation). Elements are borrowed in
// place via `iter_ref` so this works for owning element types; order is
// bucket-major and unstable. Mirrors the `HashMap` impls above and closes the
// `HashSet` vs `HashMap` Display/Debug asymmetry.

implement<T, A, H> trait Display for struct HashSet<T, A, H>
where T: Display, A: Allocator {
    fmt(&this, f: mut &Formatter) -> Result<(), FmtError> {
        f.write_str(Str::new("{"))?;
        mut it: implement Iterator<T*> = this.iter_ref();
        mut first: boolean = true;
        loop {
            match (it.next()) {
                Option::Some(e) => {
                    if (!first) { f.write_str(Str::new(", "))?; }
                    first = false;
                    e.fmt(f)?;
                }
                Option::None => { break; }
            }
        }
        return f.write_str(Str::new("}"));
    }
}

implement<T, A, H> trait Debug for struct HashSet<T, A, H>
where T: Debug, A: Allocator {
    fmt(&this, f: mut &Formatter) -> Result<(), FmtError> {
        f.write_str(Str::new("{"))?;
        mut it: implement Iterator<T*> = this.iter_ref();
        mut first: boolean = true;
        loop {
            match (it.next()) {
                Option::Some(e) => {
                    if (!first) { f.write_str(Str::new(", "))?; }
                    first = false;
                    e.fmt(f)?;
                }
                Option::None => { break; }
            }
        }
        return f.write_str(Str::new("}"));
    }
}

// Pair renders as `(first, second)`. Members are borrowed in place so this
// works for owning member types. Closes the `Pair` Display/Debug gap (N3).

// The members are formatted through pointers (`&this.first`) rather than the
// bare value `this.first.fmt(f)`: dispatching `.fmt` on a generic *value* field
// is ambiguous between `Display` and `Debug` (E0154) even under the impl's
// `A: Display` bound, whereas the pointer form auto-derefs and resolves cleanly
// - the same shape `Array`/`HashMap` use for their elements.
implement<A, B> trait Display for struct Pair<A, B>
where A: Display, B: Display {
    fmt(&this, f: mut &Formatter) -> Result<(), FmtError> {
        f.write_str(Str::new("("))?;
        const fst: const A* = &this.first;
        fst.fmt(f)?;
        f.write_str(Str::new(", "))?;
        const snd: const B* = &this.second;
        snd.fmt(f)?;
        return f.write_str(Str::new(")"));
    }
}

implement<A, B> trait Debug for struct Pair<A, B>
where A: Debug, B: Debug {
    fmt(&this, f: mut &Formatter) -> Result<(), FmtError> {
        f.write_str(Str::new("("))?;
        const fst: const A* = &this.first;
        fst.fmt(f)?;
        f.write_str(Str::new(", "))?;
        const snd: const B* = &this.second;
        snd.fmt(f)?;
        return f.write_str(Str::new(")"));
    }
}

// format_to_string: format any Display into an owned String

/// Format `value` into a fresh heap-backed `String`. Caller owns the
/// result and is responsible for dropping it.
public function format_to_string<T>(value: &T) -> Result<String, FmtError>
where T: Display {
    mut out: String = String::new();
    mut f: Formatter = Formatter::new(&out);
    value.fmt(&f)?;
    return Result::Ok(out);
}

/// Same shape for `Debug`.
public function format_debug_to_string<T>(value: &T) -> Result<String, FmtError>
where T: Debug {
    mut out: String = String::new();
    mut f: Formatter = Formatter::new(&out);
    value.fmt(&f)?;
    return Result::Ok(out);
}

// Error-type Display / Debug impls
//
// Every stdlib error type exposes the convergent accessor `describe(&this)
// -> Str` (see the per-module error files).  These impls live here, above the
// whole error stack, so a low-level error module (`core::convert`,
// `alloc::allocator`, `fmt::error`, `io::error`) needn't take a dependency on
// the formatting layer just to be printable.  Both `Display` and `Debug`
// delegate to `describe`, so `println(f"{e}")` and `f"{e:?}"` both work and
// stay consistent with the accessor.  `TestError` keeps its own richer
// `Display` (in `test::error`) rather than delegating to `describe`.

/// `could not open config.toml: not found` when the error records the
/// operation and the path it failed on, the bare description otherwise.
implement trait Display for struct IoError {
    fmt(&this, f: mut &Formatter) -> Result<(), FmtError> {
        match (this.operation()) {
            Option::Some(operation) => {
                f.write_str(Str::new("could not "))?;
                f.write_str(Str::new(operation.verb()))?;
                match (this.path()) {
                    Option::Some(path) => {
                        f.write_str(Str::new(" "))?;
                        f.write_str(path.as_str())?;
                    }
                    Option::None => { }
                }
                f.write_str(Str::new(": "))?;
            }
            Option::None => { }
        }
        return f.write_str(this.describe());
    }
}
/// The kind's slug and the operating system's code, then the operation
/// and the path: `not_found (os 2): could not open config.toml`.
implement trait Debug for struct IoError {
    fmt(&this, f: mut &Formatter) -> Result<(), FmtError> {
        f.write_str(Str::new(this.kind.label()))?;
        f.write_str(Str::new(" (os "))?;
        write_i64(f, this.os_code as i64)?;
        f.write_str(Str::new(")"))?;
        match (this.operation()) {
            Option::Some(operation) => {
                f.write_str(Str::new(": could not "))?;
                f.write_str(Str::new(operation.verb()))?;
            }
            Option::None => { return Result::Ok(()); }
        }
        match (this.path()) {
            Option::Some(path) => {
                f.write_str(Str::new(" "))?;
                return f.write_str(path.as_str());
            }
            Option::None => { return Result::Ok(()); }
        }
    }
}

/// `invalid UTF-8 at byte 12`.
implement trait Display for struct Utf8Error {
    fmt(&this, f: mut &Formatter) -> Result<(), FmtError> {
        f.write_str(this.describe())?;
        f.write_str(Str::new(" at byte "))?;
        return write_i64(f, this.valid_up_to);
    }
}
implement trait Debug for struct Utf8Error {
    fmt(&this, f: mut &Formatter) -> Result<(), FmtError> {
        f.write_str(this.describe())?;
        f.write_str(Str::new(" at byte "))?;
        return write_i64(f, this.valid_up_to);
    }
}

