///! Display / Debug / Formatter.
///!
///! Every type that wants to be printable implements `Display` (for
///! user output) or `Debug` (for inspection). Both write through a
///! `Formatter<W>` that sits on top of any `FmtWrite` impl, so
///! formatting a value to `Stdout`, to a `String`, or to a file all
///! share the same code path.
///!
///! Ownership: `Formatter<W>` borrows the writer via a raw pointer.
///! The caller owns the underlying sink and is responsible for
///! dropping it. This lets a `Formatter<String>` hand the string
///! back without an `into_inner` gymnastics.

namespace std::fmt::display;

import core::intrinsics;
import core::option;
import core::result;
import core::slice;
import io::error;
import io::traits;
import io::stdio;
import collections::str;
import collections::string;
import collections::array;
import collections::hashmap;
import alloc::allocator;
import core::primitives;
import core::convert;
import fmt::float;
import fmt::error;
import fmt::write;
import json::error;
import random::error;

// Formatter

type struct Formatter<W> {
    writer: W*;

    /// Construct over any `FmtWrite` sink. The bound is restated on
    /// each instance method below; Cryo's monomorphizer doesn't
    /// carry where-clauses from a static factory into the surrounding
    /// impl block, so methods that route through `W` must declare the
    /// bound themselves.
    static new(writer: W*) -> Formatter<W>
    where W: FmtWrite {
        return Formatter<W> { writer: writer };
    }

    /// Write a `Str`. The usual path for fixed text and for
    /// pre-rendered ASCII (integer digits, escapes) wrapped as a `Str`.
    write_str(mut &this, source: Str) -> Result<(), FmtError>
    where W: FmtWrite {
        return this.writer.write_str(source);
    }

    /// Write a single Unicode scalar, UTF-8-encoded.
    write_char(mut &this, c: char) -> Result<(), FmtError>
    where W: FmtWrite {
        return this.writer.write_char(c);
    }

    /// Surface the underlying writer. For advanced composition where
    /// the caller wants to dispatch a second formatter against the
    /// same sink, or to flush mid-stream.
    get_writer(&this) -> W* {
        return this.writer;
    }
}

type trait Display {
    fmt<W>(&this, f: mut &Formatter<W>) -> Result<(), FmtError>
    where W: FmtWrite;
}

type trait Debug {
    fmt<W>(&this, f: mut &Formatter<W>) -> Result<(), FmtError>
    where W: FmtWrite;
}


private function write_u64<W>(f: mut &Formatter<W>, value: u64) -> Result<(), FmtError>
where W: FmtWrite {
    mut buffer: u8[20];
    const digits: u64 = value.to_decimal_buf(&buffer[0]);
    return f.write_str(Str::from_raw(&buffer[0], digits));
}

private function write_i64<W>(f: mut &Formatter<W>, value: i64) -> Result<(), FmtError>
where W: FmtWrite {
    mut buffer: u8[21];
    const digits: u64 = value.to_decimal_buf(&buffer[0]);
    return f.write_str(Str::from_raw(&buffer[0], digits));
}

private function write_u128<W>(f: mut &Formatter<W>, value: u128) -> Result<(), FmtError>
where W: FmtWrite {
    mut buffer: u8[39];
    const digits: u64 = value.to_decimal_buf(&buffer[0]);
    return f.write_str(Str::from_raw(&buffer[0], digits));
}

private function write_i128<W>(f: mut &Formatter<W>, value: i128) -> Result<(), FmtError>
where W: FmtWrite {
    mut buffer: u8[40];
    const digits: u64 = value.to_decimal_buf(&buffer[0]);
    return f.write_str(Str::from_raw(&buffer[0], digits));
}

/// Format `value` as lowercase hex through `f`.
private function write_u64_hex<W>(f: mut &Formatter<W>, value: u64) -> Result<(), FmtError>
where W: FmtWrite {
    mut buffer: u8[16];
    const digits: u64 = value.to_hex_buf(&buffer[0]);
    return f.write_str(Str::from_raw(&buffer[0], digits));
}

private function write_u64_hex_upper<W>(f: mut &Formatter<W>, value: u64) -> Result<(), FmtError>
where W: FmtWrite {
    mut buffer: u8[16];
    const digits: u64 = value.to_hex_upper_buf(&buffer[0]);
    return f.write_str(Str::from_raw(&buffer[0], digits));
}

private function write_u64_oct<W>(f: mut &Formatter<W>, value: u64) -> Result<(), FmtError>
where W: FmtWrite {
    mut buffer: u8[22];
    const digits: u64 = value.to_oct_buf(&buffer[0]);
    return f.write_str(Str::from_raw(&buffer[0], digits));
}

private function write_u64_bin<W>(f: mut &Formatter<W>, value: u64) -> Result<(), FmtError>
where W: FmtWrite {
    mut buffer: u8[64];
    const digits: u64 = value.to_bin_buf(&buffer[0]);
    return f.write_str(Str::from_raw(&buffer[0], digits));
}

/// Display-side wrapper for the float printer.
private function write_float64<W>(f: mut &Formatter<W>, value: f64) -> Result<(), FmtError>
where W: FmtWrite {
    mut buffer: u8[32];
    const digits: u64 = value.to_buf(&buffer[0]);
    return f.write_str(Str::from_raw(&buffer[0], digits));
}

// Primitive Display impls

implement trait Display for u8 {
    fmt<W>(&this, f: mut &Formatter<W>) -> Result<(), FmtError>
    where W: FmtWrite {
        return write_u64(f, this as u64);
    }
}
implement trait Display for u16 {
    fmt<W>(&this, f: mut &Formatter<W>) -> Result<(), FmtError>
    where W: FmtWrite {
        return write_u64(f, this as u64);
    }
}
