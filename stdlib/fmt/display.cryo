implement trait Debug for boolean {
    fmt<W>(&this, f: mut &Formatter<W>) -> Result<(), FmtError>
    where W: FmtWrite {
        if (this) {
            return f.write_str(Str::new("true"));
        }
        return f.write_str(Str::new("false"));
    }
}

/// `Debug` for `char` wraps the character in single quotes and
/// escapes the same set `Debug<Str>` does, so `print('\n' as debug)`
/// is unambiguous.
implement trait Debug for char {
    fmt<W>(&this, f: mut &Formatter<W>) -> Result<(), FmtError>
    where W: FmtWrite {
        f.write_byte(0x27)?; // '\''
        write_debug_scalar(f, this as u32, 0x27)?;
        return f.write_byte(0x27);
    }
}

/// `Debug for Str` wraps the content in double quotes and escapes
/// `"`, `\`, control bytes, and non-ASCII low codepoints so the
/// printed form is unambiguous and valid UTF-8 regardless of the
/// source. Round-trippable by a parser that understands `\n`,
/// `\r`, `\t`, `\\`, `\"`, `\xNN`.
implement trait Debug for struct Str {
    fmt<W>(&this, f: mut &Formatter<W>) -> Result<(), FmtError>
    where W: FmtWrite {
        f.write_byte(0x22)?; // '"'
        const bytes: Slice<u8> = this.as_bytes();
        mut i: u64 = 0;
        while (i < bytes.length()) {
            match (bytes.get(i)) {
                Option::Some(byte) => {
                    write_debug_byte(f, byte, 0x22)?;
                }
                Option::None => { break; }
            }
            i++;
        }
        return f.write_byte(0x22);
    }
}

implement trait Debug for struct String {
    fmt<W>(&this, f: mut &Formatter<W>) -> Result<(), FmtError>
    where W: FmtWrite {
        const view: Str = this.as_str();
        return view.fmt(f);
    }
}

/// Escape a single byte for Debug output. `quote` is the surrounding
/// delimiter: a quote matching the delimiter is escaped, a quote
/// of the other flavor is passed through.
function write_debug_byte<W>(f: mut &Formatter<W>, byte: u8, quote: u8) -> Result<(), FmtError>
where W: FmtWrite {
    if (byte == 0x5C) {
        return f.write_str(Str::new("\\\\"));
    }
    if (byte == quote) {
        if (quote == 0x22) {
            return f.write_str(Str::new("\\\""));
        }
        return f.write_str(Str::new("\\'"));
    }
    if (byte == 0x0A) {
        return f.write_str(Str::new("\\n"));
    }
    if (byte == 0x0D) {
        return f.write_str(Str::new("\\r"));
    }
    if (byte == 0x09) {
        return f.write_str(Str::new("\\t"));
    }
    if (byte == 0x00) {
        return f.write_str(Str::new("\\0"));
    }
    if (byte < 0x20 || byte == 0x7F) {
        // Other control byte: emit as \xNN so the dump is safe to
        // paste into a terminal without triggering escape sequences.
        mut escape: u8[4];
        escape[0] = 0x5C; // '\\'
        escape[1] = 0x78; // 'x'
        const byte_val: u64 = byte as u64;
        byte_val.to_hex_padded_buf(&escape[2], 2);
        return f.write_bytes(Slice::from_raw(&escape[0], 4));
    }
    // Printable ASCII and high bytes (UTF-8 continuation / leading)
    // pass through verbatim.
    return f.write_byte(byte);
}

/// Escape one Unicode scalar for Debug<char> output. Non-ASCII
/// scalars are emitted as `\u{XXXX}` to keep terminal output safe.
function write_debug_scalar<W>(f: mut &Formatter<W>, scalar: u32, quote: u8) -> Result<(), FmtError>
where W: FmtWrite {
    if (scalar < 0x80) {
        return write_debug_byte(f, scalar as u8, quote);
    }
    f.write_str(Str::new("\\u{"))?;
    mut buffer: u8[8];
    const scalar_val: u64 = scalar as u64;
    const digits: u64 = scalar_val.to_hex_buf(&buffer[0]);
    f.write_bytes(Slice::from_raw(&buffer[0], digits))?;
    return f.write_byte(0x7D); // '}'
}

// Composite Display / Debug impls: Option, Result
//
// These recurse into the wrapped value's own `fmt`.  The recursion is
// trait-correct: inside `Display::fmt` a nested `.fmt()` dispatches to the
// element's `Display`; inside `Debug::fmt` it dispatches to `Debug` (the
// compiler's bound-directed dispatch threads the enclosing trait).  Each
// write short-circuits on error via the `?` operator.

implement<T> trait Display for enum Option<T>
where T: Display {
    fmt<W>(&this, f: mut &Formatter<W>) -> Result<(), FmtError>
    where W: FmtWrite {
        match (&this) {
            Option::Some(value) => {
                f.write_str(Str::new("Some("))?;
                value.fmt(f)?;
                return f.write_str(Str::new(")"));
            }
            Option::None => {
                return f.write_str(Str::new("None"));
            }
        }
    }
}

implement<T> trait Debug for enum Option<T>
where T: Debug {
    fmt<W>(&this, f: mut &Formatter<W>) -> Result<(), FmtError>
    where W: FmtWrite {
        match (&this) {
            Option::Some(value) => {
                f.write_str(Str::new("Some("))?;
                value.fmt(f)?;
                return f.write_str(Str::new(")"));
            }
            Option::None => {
                return f.write_str(Str::new("None"));
            }
        }
    }
}

/// Construct a `Result<(), FmtError>` error.  Defined OUTSIDE the
/// `implement ... for Result` blocks below because inside them the bare
/// `Result::Err` constructor binds to the Self enum (`Result<T, E>`)
/// rather than `Result<(), FmtError>`, producing a type mismatch.  As a
/// free function the name resolves unambiguously.
private function fmt_err(e: FmtError) -> Result<(), FmtError> {
    return Result::Err(e);
}

implement<T, E> trait Display for enum Result<T, E>
where T: Display, E: Display {
    fmt<W>(&this, f: mut &Formatter<W>) -> Result<(), FmtError>
    where W: FmtWrite {
        match (&this) {
            Result::Ok(value) => {
                match (f.write_str(Str::new("Ok("))) {
                    Result::Ok(_) => { }
                    Result::Err(e) => { return fmt_err(e); }
                }
                match (value.fmt(f)) {
                    Result::Ok(_) => { }
                    Result::Err(e) => { return fmt_err(e); }
                }
                return f.write_str(Str::new(")"));
            }
            Result::Err(err) => {
                match (f.write_str(Str::new("Err("))) {
                    Result::Ok(_) => { }
                    Result::Err(e) => { return fmt_err(e); }
                }
                match (err.fmt(f)) {
                    Result::Ok(_) => { }
                    Result::Err(e) => { return fmt_err(e); }
                }
                return f.write_str(Str::new(")"));
            }
        }
    }
}

implement<T, E> trait Debug for enum Result<T, E>
where T: Debug, E: Debug {
    fmt<W>(&this, f: mut &Formatter<W>) -> Result<(), FmtError>
    where W: FmtWrite {
        match (&this) {
            Result::Ok(value) => {
                match (f.write_str(Str::new("Ok("))) {
                    Result::Ok(_) => { }
                    Result::Err(e) => { return fmt_err(e); }
                }
                match (value.fmt(f)) {
                    Result::Ok(_) => { }
                    Result::Err(e) => { return fmt_err(e); }
                }
                return f.write_str(Str::new(")"));
            }
            Result::Err(err) => {
                match (f.write_str(Str::new("Err("))) {
                    Result::Ok(_) => { }
                    Result::Err(e) => { return fmt_err(e); }
                }
                match (err.fmt(f)) {
                    Result::Ok(_) => { }
                    Result::Err(e) => { return fmt_err(e); }
                }
                return f.write_str(Str::new(")"));
            }
        }
    }
}

// Composite Display / Debug impls: Array, HashMap
//
// `Array<T>` renders as `[a, b, c]`; `HashMap<K, V>` as `{k: v, k2: v2}`.
// Elements are borrowed in place (Array via `get_ptr`, HashMap via the
// public bucket walk) so these work for owning element types.  The nested
// `.fmt()` dispatches to the element's Display inside `Display::fmt` and to
// its Debug inside `Debug::fmt` (bound-directed dispatch).

implement<T, A> trait Display for struct Array<T, A>
where T: Display, A: Allocator {
    fmt<W>(&this, f: mut &Formatter<W>) -> Result<(), FmtError>
    where W: FmtWrite {
        f.write_str(Str::new("["))?;
        const n: u64 = this.length();
        mut i: u64 = 0;
        while (i < n) {
            if (i > 0) {
                f.write_str(Str::new(", "))?;
            }
            match (this.get_ptr(i)) {
                Option::Some(p) => {
                    p.fmt(f)?;
                }
                Option::None => { }
            }
            i = i + 1;
        }
        return f.write_str(Str::new("]"));
    }
}

implement<T, A> trait Debug for struct Array<T, A>
where T: Debug, A: Allocator {
    fmt<W>(&this, f: mut &Formatter<W>) -> Result<(), FmtError>
    where W: FmtWrite {
        f.write_str(Str::new("["))?;
        const n: u64 = this.length();
        mut i: u64 = 0;
        while (i < n) {
            if (i > 0) {
                f.write_str(Str::new(", "))?;
            }
            match (this.get_ptr(i)) {
                Option::Some(p) => {
                    p.fmt(f)?;
                }
                Option::None => { }
            }
            i = i + 1;
        }
        return f.write_str(Str::new("]"));
    }
}

implement<K, V, A> trait Display for struct HashMap<K, V, A>
where K: Display, V: Display, A: Allocator {
    fmt<W>(&this, f: mut &Formatter<W>) -> Result<(), FmtError>
    where W: FmtWrite {
        f.write_str(Str::new("{"))?;
        const nb: u64 = this.bucket_count();
        mut bi: u64 = 0;
        mut first: boolean = true;
        while (bi < nb) {
            mut node: Entry<K, V>* = this.get_bucket(bi);
            while (node != null) {
                if (!first) {
                    f.write_str(Str::new(", "))?;
                }
                first = false;
                node.key.fmt(f)?;
                f.write_str(Str::new(": "))?;
                node.value.fmt(f)?;
                node = node.next;
            }
            bi = bi + 1;
        }
        return f.write_str(Str::new("}"));
    }
}

implement<K, V, A> trait Debug for struct HashMap<K, V, A>
where K: Debug, V: Debug, A: Allocator {
    fmt<W>(&this, f: mut &Formatter<W>) -> Result<(), FmtError>
    where W: FmtWrite {
        f.write_str(Str::new("{"))?;
        const nb: u64 = this.bucket_count();
        mut bi: u64 = 0;
        mut first: boolean = true;
        while (bi < nb) {
            mut node: Entry<K, V>* = this.get_bucket(bi);
            while (node != null) {
                if (!first) {
                    f.write_str(Str::new(", "))?;
                }
                first = false;
                node.key.fmt(f)?;
                f.write_str(Str::new(": "))?;
                node.value.fmt(f)?;
                node = node.next;
            }
            bi = bi + 1;
        }
        return f.write_str(Str::new("}"));
    }
}

// LineBuf: internal stack-buffered sink

/// Small non-owning buffered writer used by `print` / `println` to
/// coalesce an entire formatted value (and its trailing newline)
/// into one `write(2)` call. The buffer is caller-provided on the
/// stack; overflow flushes to the inner writer.
///
/// Not exposed publicly; `print`/`println` are the intended API.
/// Exists here rather than in `io::buf` because it's specifically
/// shaped around one-shot formatting, not general buffering.
type struct LineBuf<W> {
    writer: W*;
    buffer: u8*;
    capacity: u64;
    length: u64;

    static new(writer: W*, buffer: u8*, capacity: u64) -> LineBuf<W>
    where W: Write {
        return LineBuf<W> {
            writer: writer,
            buffer: buffer,
            capacity: capacity,
            length: 0
        };
    }

    /// Flush buffered bytes to the sink and reset.
    flush_buffer(mut &this) -> Result<(), IoError> {
        if (this.length == 0) {
            return Result::Ok(());
        }
        const bytes: Slice<u8> = Slice::from_raw(this.buffer, this.length);
        this.writer.write_all(bytes)?;
        this.length = 0;
        return Result::Ok(());
    }
}

implement<W> trait FmtWrite for struct LineBuf<W>
where W: Write {
    write_str(mut &this, source: Str) -> Result<(), FmtError> {
        return this.write_bytes(source.as_bytes());
    }

    write_bytes(mut &this, bytes: Slice<u8>) -> Result<(), FmtError> {
        const incoming: u64 = bytes.length();
        if (this.length + incoming > this.capacity) {
            match (this.flush_buffer()) {
                Result::Ok(_) => { }
                Result::Err(err) => { return Result::Err(FmtError::Io(err)); }
            }
            if (incoming >= this.capacity) {
                // Incoming chunk is larger than our inline buffer;
                // send it straight to the sink.
                match (this.writer.write_all(bytes)) {
                    Result::Ok(_) => { return Result::Ok(()); }
                    Result::Err(err) => { return Result::Err(FmtError::Io(err)); }
                }
            }
        }
        intrinsics::memcpy(
            (this.buffer + this.length) as void*,
            bytes.as_ptr() as void*,
            incoming
        );
        this.length = this.length + incoming;
        return Result::Ok(());
    }

    write_byte(mut &this, byte: u8) -> Result<(), FmtError> {
        if (this.length == this.capacity) {
            match (this.flush_buffer()) {
                Result::Ok(_) => { }
                Result::Err(err) => { return Result::Err(FmtError::Io(err)); }
            }
        }
        this.buffer[this.length] = byte;
        this.length = this.length + 1;
        return Result::Ok(());
    }
}

/// Local buffer size for print / println. Large enough that an
/// integer, a short string, a typed struct debug-dump, and a newline
/// fit without overflow in the common case.
const PRINT_BUFFER_SIZE: u64 = 256;

// print / println: printf-style variadic output
//
// `println("%s is %d", name, age)` forwards the variadic bucket to libc's
// `vprintf` (stdout) and appends a newline.  Format specifiers follow C
// `printf`: `%d`/`%i`, `%u`, `%s`, `%f`, `%x`, `%c`, `%p`, `%%`, plus
// width/precision.  They are NOT type-checked against the arguments (this is
// the C variadic ABI); a wrong specifier is undefined behaviour, exactly as
// in C.  For type-safe, Display-based formatting, build a `String` via
// `format_to_string` and the `Display` trait.

/// Write a printf-style formatted string to stdout.  Returns the number of
/// bytes written, or a negative value on error (libc `printf` convention).
function print(fmt: string, args...) -> i32 {
    return intrinsics::vprintf(fmt, args);
}

/// Like `print`, followed by a newline.
function println(fmt: string, args...) -> i32 {
    const n: i32 = intrinsics::vprintf(fmt, args);
    if (n < 0) { return n; }
    intrinsics::putchar(0x0A);
    return n + 1;
}

// Lazily-opened stderr stream for the `eprint` family.  libc's `stderr`
// global FILE* isn't reachable by name from Cryo, so `fdopen(2)` yields an
// equivalent stream over fd 2.  Cached to avoid leaking a FILE per call; each
// write is flushed since this fdopen'd stream is fully-buffered (unlike a
// real tty stderr).
mut g_fmt_stderr: void*;

private function fmt_stderr_stream() -> void* {
    if (g_fmt_stderr == null) {
        g_fmt_stderr = intrinsics::fdopen(2, "w");
    }
    return g_fmt_stderr;
}

/// Write a printf-style formatted string to stderr.  Same specifier rules as
/// `print` (see above).  Returns the number of bytes `vfprintf` reported.
function eprint(fmt: string, args...) -> i32 {
    const stream: void* = fmt_stderr_stream();
    const n: i32 = intrinsics::vfprintf(stream, fmt, args);
    intrinsics::fflush(stream);
    return n;
}

/// Like `eprint`, followed by a newline.
function eprintln(fmt: string, args...) -> i32 {
    const stream: void* = fmt_stderr_stream();
    const n: i32 = intrinsics::vfprintf(stream, fmt, args);
    intrinsics::fputc(0x0A, stream);
    intrinsics::fflush(stream);
    return n;
}

// format_to_string: format any Display into an owned String

/// Format `value` into a fresh heap-backed `String`. Caller owns the
/// result and is responsible for dropping it.
function format_to_string<T>(value: &T) -> Result<String, FmtError>
where T: Display {
    mut out: String = String::new();
    mut f: Formatter<String> = Formatter::new(&out);
    value.fmt(&f)?;
    return Result::Ok(out);
}

/// Same shape for `Debug`.
function format_debug_to_string<T>(value: &T) -> Result<String, FmtError>
where T: Debug {
    mut out: String = String::new();
    mut f: Formatter<String> = Formatter::new(&out);
    value.fmt(&f)?;
    return Result::Ok(out);
}
