///! Display / Debug / Formatter.
///!
///! Every type that wants to be printable implements `Display` (for
///! user output) or `Debug` (for inspection). Both write through a
///! `Formatter<W>` that sits on top of any `FmtWrite` impl, so
///! formatting a value to `Stdout`, to a `String`, or to a file all
///! share the same code path.
///!
///! Ownership: `Formatter<W>` borrows the writer via a raw pointer.
///! The caller owns the underlying sink and is responsible for
///! dropping it. This lets a `Formatter<String>` hand the string
///! back without an `into_inner` gymnastics.

namespace std::fmt::display;

import core::intrinsics;
import core::option;
import core::result;
import core::slice;
import io::error;
import io::traits;
import io::stdio;
import collections::str;
import collections::string;
import collections::array;
import collections::hashmap;
import alloc::allocator;
import core::primitives;
import fmt::float;
import fmt::error;
import fmt::write;

// Formatter

type struct Formatter<W> {
    writer: W*;

    /// Construct over any `FmtWrite` sink. The bound is restated on
    /// each instance method below; Cryo's monomorphizer doesn't
    /// carry where-clauses from a static factory into the surrounding
    /// impl block, so methods that route through `W` must declare the
    /// bound themselves.
    static new(writer: W*) -> Formatter<W>
    where W: FmtWrite {
        return Formatter<W> { writer: writer };
    }

    /// Write raw bytes. The low-level escape hatch every other method
    /// routes through.
    write_bytes(mut &this, bytes: Slice<u8>) -> Result<(), FmtError>
    where W: FmtWrite {
        return this.writer.write_bytes(bytes);
    }

    /// Write a `Str`. The usual path for fixed text.
    write_str(mut &this, source: Str) -> Result<(), FmtError>
    where W: FmtWrite {
        return this.writer.write_str(source);
    }

    /// Write a single byte.
    write_byte(mut &this, byte: u8) -> Result<(), FmtError>
    where W: FmtWrite {
        return this.writer.write_byte(byte);
    }

    /// Surface the underlying writer. For advanced composition where
    /// the caller wants to dispatch a second formatter against the
    /// same sink, or to flush mid-stream.
    get_writer(&this) -> W* {
        return this.writer;
    }
}

type trait Display {
    fmt<W>(&this, f: mut &Formatter<W>) -> Result<(), FmtError>
    where W: FmtWrite;
}

type trait Debug {
    fmt<W>(&this, f: mut &Formatter<W>) -> Result<(), FmtError>
    where W: FmtWrite;
}


private function write_u64<W>(f: mut &Formatter<W>, value: u64) -> Result<(), FmtError>
where W: FmtWrite {
    mut buffer: u8[20];
    const digits: u64 = value.to_decimal_buf(&buffer[0]);
    return f.write_bytes(Slice::from_raw(&buffer[0], digits));
}

private function write_i64<W>(f: mut &Formatter<W>, value: i64) -> Result<(), FmtError>
where W: FmtWrite {
    mut buffer: u8[21];
    const digits: u64 = value.to_decimal_buf(&buffer[0]);
    return f.write_bytes(Slice::from_raw(&buffer[0], digits));
}

/// Format `value` as lowercase hex through `f`.
private function write_u64_hex<W>(f: mut &Formatter<W>, value: u64) -> Result<(), FmtError>
where W: FmtWrite {
    mut buffer: u8[16];
    const digits: u64 = value.to_hex_buf(&buffer[0]);
    return f.write_bytes(Slice::from_raw(&buffer[0], digits));
}

private function write_u64_hex_upper<W>(f: mut &Formatter<W>, value: u64) -> Result<(), FmtError>
where W: FmtWrite {
    mut buffer: u8[16];
    const digits: u64 = value.to_hex_upper_buf(&buffer[0]);
    return f.write_bytes(Slice::from_raw(&buffer[0], digits));
}

private function write_u64_oct<W>(f: mut &Formatter<W>, value: u64) -> Result<(), FmtError>
where W: FmtWrite {
    mut buffer: u8[22];
    const digits: u64 = value.to_oct_buf(&buffer[0]);
    return f.write_bytes(Slice::from_raw(&buffer[0], digits));
}

private function write_u64_bin<W>(f: mut &Formatter<W>, value: u64) -> Result<(), FmtError>
where W: FmtWrite {
    mut buffer: u8[64];
    const digits: u64 = value.to_bin_buf(&buffer[0]);
    return f.write_bytes(Slice::from_raw(&buffer[0], digits));
}

/// Display-side wrapper for the float printer.
private function write_float64<W>(f: mut &Formatter<W>, value: f64) -> Result<(), FmtError>
where W: FmtWrite {
    mut buffer: u8[32];
    const digits: u64 = value.to_buf(&buffer[0]);
    return f.write_bytes(Slice::from_raw(&buffer[0], digits));
}

// Primitive Display impls

implement trait Display for u8 {
    fmt<W>(&this, f: mut &Formatter<W>) -> Result<(), FmtError>
    where W: FmtWrite {
        return write_u64(f, this as u64);
    }
}
implement trait Display for u16 {
    fmt<W>(&this, f: mut &Formatter<W>) -> Result<(), FmtError>
    where W: FmtWrite {
        return write_u64(f, this as u64);
    }
}
implement trait Display for u32 {
    fmt<W>(&this, f: mut &Formatter<W>) -> Result<(), FmtError>
    where W: FmtWrite {
        return write_u64(f, this as u64);
    }
}
implement trait Display for u64 {
    fmt<W>(&this, f: mut &Formatter<W>) -> Result<(), FmtError>
    where W: FmtWrite {
        return write_u64(f, this);
    }
}

implement trait Display for i8 {
    fmt<W>(&this, f: mut &Formatter<W>) -> Result<(), FmtError>
    where W: FmtWrite {
        return write_i64(f, this as i64);
    }
}
implement trait Display for i16 {
    fmt<W>(&this, f: mut &Formatter<W>) -> Result<(), FmtError>
    where W: FmtWrite {
        return write_i64(f, this as i64);
    }
}
implement trait Display for i32 {
    fmt<W>(&this, f: mut &Formatter<W>) -> Result<(), FmtError>
    where W: FmtWrite {
        return write_i64(f, this as i64);
    }
}
implement trait Display for i64 {
    fmt<W>(&this, f: mut &Formatter<W>) -> Result<(), FmtError>
    where W: FmtWrite {
        return write_i64(f, this);
    }
}

implement trait Display for f32 {
    fmt<W>(&this, f: mut &Formatter<W>) -> Result<(), FmtError>
    where W: FmtWrite {
        return write_float64(f, this as f64);
    }
}

implement trait Display for f64 {
    fmt<W>(&this, f: mut &Formatter<W>) -> Result<(), FmtError>
    where W: FmtWrite {
        return write_float64(f, this);
    }
}

implement trait Display for boolean {
    fmt<W>(&this, f: mut &Formatter<W>) -> Result<(), FmtError>
    where W: FmtWrite {
        if (this) {
            return f.write_str(Str::new("true"));
        }
        return f.write_str(Str::new("false"));
    }
}

implement trait Display for string {
    fmt<W>(&this, f: mut &Formatter<W>) -> Result<(), FmtError>
    where W: FmtWrite {
        const view: Str = Str::new(this);
        return f.write_str(view);
    }
}


/// `char` is a 4-byte Unicode scalar. Encode it as UTF-8; emitting
/// the low byte truncates non-ASCII scalars to garbage. Scalars in
/// the surrogate range (0xD800..=0xDFFF) are not legal Unicode; they
/// produce the replacement character U+FFFD.
implement trait Display for char {
    fmt<W>(&this, f: mut &Formatter<W>) -> Result<(), FmtError>
    where W: FmtWrite {
        mut buffer: u8[4];
        const length: u64 = encode_utf8(this as u32, &buffer[0]);
        return f.write_bytes(Slice::from_raw(&buffer[0], length));
    }
}

implement trait Display for struct Str {
    fmt<W>(&this, f: mut &Formatter<W>) -> Result<(), FmtError>
    where W: FmtWrite {
        return f.write_str(this);
    }
}

implement<A> trait Display for struct String<A>
where A: Allocator {
    fmt<W>(&this, f: mut &Formatter<W>) -> Result<(), FmtError>
    where W: FmtWrite {
        return f.write_str(this.as_str());
    }
}


// UTF-8 encoding for Display<char>

/// Encode a Unicode scalar value as UTF-8 into `out`. Returns the
/// number of bytes written (1-3 for valid scalars; 3 bytes for the
/// replacement character when given an invalid scalar). `out` must
/// hold at least 4 bytes.
function encode_utf8(scalar: u32, out: u8*) -> u64 {
    if (scalar < 0x80) {
        out[0] = scalar as u8;
        return 1;
    }
    if (scalar < 0x800) {
        out[0] = (0xC0 | (scalar >> 6)) as u8;
        out[1] = (0x80 | (scalar & 0x3F)) as u8;
        return 2;
    }
    if (scalar >= 0xD800 && scalar <= 0xDFFF) {
        // Surrogate halves are not valid Unicode scalars. Substitute
        // U+FFFD (the replacement character) so consumers still see
        // well-formed UTF-8.
        return write_replacement(out);
    }
    if (scalar < 0x10000) {
        out[0] = (0xE0 | (scalar >> 12)) as u8;
        out[1] = (0x80 | ((scalar >> 6) & 0x3F)) as u8;
        out[2] = (0x80 | (scalar & 0x3F)) as u8;
        return 3;
    }
    if (scalar <= 0x10FFFF) {
        out[0] = (0xF0 | (scalar >> 18)) as u8;
        out[1] = (0x80 | ((scalar >> 12) & 0x3F)) as u8;
        out[2] = (0x80 | ((scalar >> 6) & 0x3F)) as u8;
        out[3] = (0x80 | (scalar & 0x3F)) as u8;
        return 4;
    }
    return write_replacement(out);
}

function write_replacement(out: u8*) -> u64 {
    // U+FFFD encodes as 0xEF 0xBF 0xBD.
    out[0] = 0xEF;
    out[1] = 0xBF;
    out[2] = 0xBD;
    return 3;
}

