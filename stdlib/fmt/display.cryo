/// `Debug` for `char` wraps the character in single quotes and
/// escapes the same set `Debug<Str>` does, so `print('\n' as debug)`
/// is unambiguous.
implement trait Debug for char {
    fmt<W>(&this, f: mut &Formatter<W>) -> Result<(), FmtError>
    where W: FmtWrite {
        match (f.write_byte(0x27)) { // '\''
            Result::Ok(_) => { }
            Result::Err(err) => { return Result::Err(err); }
        }
        match (write_debug_scalar(f, this as u32, 0x27)) {
            Result::Ok(_) => { }
            Result::Err(err) => { return Result::Err(err); }
        }
        return f.write_byte(0x27);
    }
}

/// `Debug for Str` wraps the content in double quotes and escapes
/// `"`, `\`, control bytes, and non-ASCII low codepoints so the
/// printed form is unambiguous and valid UTF-8 regardless of the
/// source. Round-trippable by a parser that understands `\n`,
/// `\r`, `\t`, `\\`, `\"`, `\xNN`.
implement trait Debug for struct Str {
    fmt<W>(&this, f: mut &Formatter<W>) -> Result<(), FmtError>
    where W: FmtWrite {
        match (f.write_byte(0x22)) { // '"'
            Result::Ok(_) => { }
            Result::Err(err) => { return Result::Err(err); }
        }
        const bytes: Slice<u8> = this.as_bytes();
        mut i: u64 = 0;
        while (i < bytes.length()) {
            match (bytes.get(i)) {
                Option::Some(byte) => {
                    match (write_debug_byte(f, byte, 0x22)) {
                        Result::Ok(_) => { }
                        Result::Err(err) => { return Result::Err(err); }
                    }
                }
                Option::None => { break; }
            }
            i++;
        }
        return f.write_byte(0x22);
    }
}

implement trait Debug for struct String {
    fmt<W>(&this, f: mut &Formatter<W>) -> Result<(), FmtError>
    where W: FmtWrite {
        const view: Str = this.as_str();
        return view.fmt(f);
    }
}

/// Escape a single byte for Debug output. `quote` is the surrounding
/// delimiter — a quote matching the delimiter is escaped, a quote
/// of the other flavor is passed through.
function write_debug_byte<W>(f: mut &Formatter<W>, byte: u8, quote: u8) -> Result<(), FmtError>
where W: FmtWrite {
    if (byte == 0x5C) {
        return f.write_str(Str::from_raw("\\\\", 2));
    }
    if (byte == quote) {
        if (quote == 0x22) {
            return f.write_str(Str::from_raw("\\\"", 2));
        }
        return f.write_str(Str::from_raw("\\'", 2));
    }
    if (byte == 0x0A) {
        return f.write_str(Str::from_raw("\\n", 2));
    }
    if (byte == 0x0D) {
        return f.write_str(Str::from_raw("\\r", 2));
    }
    if (byte == 0x09) {
        return f.write_str(Str::from_raw("\\t", 2));
    }
    if (byte == 0x00) {
        return f.write_str(Str::from_raw("\\0", 2));
    }
    if (byte < 0x20 || byte == 0x7F) {
        // Other control byte — emit as \xNN so the dump is safe to
        // paste into a terminal without triggering escape sequences.
        mut escape: u8[4];
        escape[0] = 0x5C; // '\\'
        escape[1] = 0x78; // 'x'
        const byte_val: u64 = byte as u64;
        byte_val.to_hex_padded_buf(&escape[2], 2);
        return f.write_bytes(Slice::from_raw(&escape[0], 4));
    }
    // Printable ASCII and high bytes (UTF-8 continuation / leading)
    // pass through verbatim.
    return f.write_byte(byte);
}

/// Escape one Unicode scalar for Debug<char> output. Non-ASCII
/// scalars are emitted as `\u{XXXX}` to keep terminal output safe.
function write_debug_scalar<W>(f: mut &Formatter<W>, scalar: u32, quote: u8) -> Result<(), FmtError>
where W: FmtWrite {
    if (scalar < 0x80) {
        return write_debug_byte(f, scalar as u8, quote);
    }
    match (f.write_str(Str::from_raw("\\u{", 3))) {
        Result::Ok(_) => { }
        Result::Err(err) => { return Result::Err(err); }
    }
    mut buffer: u8[8];
    const scalar_val: u64 = scalar as u64;
    const digits: u64 = scalar_val.to_hex_buf(&buffer[0]);
    match (f.write_bytes(Slice::from_raw(&buffer[0], digits))) {
        Result::Ok(_) => { }
        Result::Err(err) => { return Result::Err(err); }
    }
    return f.write_byte(0x7D); // '}'
}

// ============================================================================
// LineBuf — internal stack-buffered sink
// ============================================================================

/// Small non-owning buffered writer used by `print` / `println` to
/// coalesce an entire formatted value (and its trailing newline)
/// into one `write(2)` call. The buffer is caller-provided on the
/// stack; overflow flushes to the inner writer.
///
/// Not exposed publicly — `print`/`println` are the intended API.
/// Exists here rather than in `io::buf` because it's specifically
/// shaped around one-shot formatting, not general buffering.
type struct LineBuf<W> {
    writer: W*;
    buffer: u8*;
    capacity: u64;
    length: u64;

    static new(writer: W*, buffer: u8*, capacity: u64) -> LineBuf<W>
    where W: Write {
        return LineBuf<W> {
            writer: writer,
            buffer: buffer,
            capacity: capacity,
            length: 0
        };
    }

    /// Flush buffered bytes to the sink and reset.
    flush_buffer(mut &this) -> Result<(), IoError> {
        if (this.length == 0) {
            return Result::Ok(());
        }
        const bytes: Slice<u8> = Slice::from_raw(this.buffer, this.length);
        match (this.writer.write_all(bytes)) {
            Result::Ok(_) => {
                this.length = 0;
                return Result::Ok(());
            }
            Result::Err(err) => { return Result::Err(err); }
        }
    }
}

implement<W> trait FmtWrite for struct LineBuf<W>
where W: Write {
    write_str(mut &this, source: Str) -> Result<(), FmtError> {
        return this.write_bytes(source.as_bytes());
    }

    write_bytes(mut &this, bytes: Slice<u8>) -> Result<(), FmtError> {
        const incoming: u64 = bytes.length();
        if (this.length + incoming > this.capacity) {
            match (this.flush_buffer()) {
                Result::Ok(_) => { }
                Result::Err(err) => { return Result::Err(FmtError::Io(err)); }
            }
            if (incoming >= this.capacity) {
                // Incoming chunk is larger than our inline buffer —
                // send it straight to the sink.
                match (this.writer.write_all(bytes)) {
                    Result::Ok(_) => { return Result::Ok(()); }
                    Result::Err(err) => { return Result::Err(FmtError::Io(err)); }
                }
            }
        }
        intrinsics::memcpy(
            (this.buffer + this.length) as void*,
            bytes.as_ptr() as void*,
            incoming
        );
        this.length = this.length + incoming;
        return Result::Ok(());
    }

    write_byte(mut &this, byte: u8) -> Result<(), FmtError> {
        if (this.length == this.capacity) {
            match (this.flush_buffer()) {
                Result::Ok(_) => { }
                Result::Err(err) => { return Result::Err(FmtError::Io(err)); }
            }
        }
        this.buffer[this.length] = byte;
        this.length = this.length + 1;
        return Result::Ok(());
    }
}

/// Local buffer size for print / println. Large enough that an
/// integer, a short string, a typed struct debug-dump, and a newline
/// fit without overflow in the common case.
const PRINT_BUFFER_SIZE: u64 = 256;

// ============================================================================
// print / println helpers
// ============================================================================

/// Format `value` to stdout. Collapses to one `write(2)` when the
/// formatted output fits in `PRINT_BUFFER_SIZE`; larger values flush
/// incrementally.
function print<T>(value: &T) -> Result<(), FmtError>
where T: Display {
    mut out: Stdout = stdout();
    mut buffer: u8[256];
    mut sink: LineBuf<Stdout> = LineBuf::new(&out, &buffer[0], PRINT_BUFFER_SIZE);
    mut f: Formatter<LineBuf<Stdout>> = Formatter::new(&sink);
    match (value.fmt(&f)) {
        Result::Ok(_) => { }
        Result::Err(err) => { return Result::Err(err); }
    }
    match (sink.flush_buffer()) {
        Result::Ok(_) => { return Result::Ok(()); }
        Result::Err(err) => { return Result::Err(FmtError::Io(err)); }
    }
}

/// Format `value` to stdout followed by a newline, in one syscall
/// when the output fits in `PRINT_BUFFER_SIZE`.
function println<T>(value: &T) -> Result<(), FmtError>
where T: Display {
    mut out: Stdout = stdout();
    mut buffer: u8[256];
    mut sink: LineBuf<Stdout> = LineBuf::new(&out, &buffer[0], PRINT_BUFFER_SIZE);
    mut f: Formatter<LineBuf<Stdout>> = Formatter::new(&sink);
    match (value.fmt(&f)) {
        Result::Ok(_) => { }
        Result::Err(err) => { return Result::Err(err); }
    }
    match (sink.write_byte(0x0A)) {
        Result::Ok(_) => { }
        Result::Err(err) => { return Result::Err(err); }
    }
    match (sink.flush_buffer()) {
        Result::Ok(_) => { return Result::Ok(()); }
        Result::Err(err) => { return Result::Err(FmtError::Io(err)); }
    }
}

function eprint<T>(value: &T) -> Result<(), FmtError>
where T: Display {
    mut out: Stderr = stderr();
    mut buffer: u8[256];
    mut sink: LineBuf<Stderr> = LineBuf::new(&out, &buffer[0], PRINT_BUFFER_SIZE);
    mut f: Formatter<LineBuf<Stderr>> = Formatter::new(&sink);
    match (value.fmt(&f)) {
        Result::Ok(_) => { }
        Result::Err(err) => { return Result::Err(err); }
    }
    match (sink.flush_buffer()) {
        Result::Ok(_) => { return Result::Ok(()); }
        Result::Err(err) => { return Result::Err(FmtError::Io(err)); }
    }
}

function eprintln<T>(value: &T) -> Result<(), FmtError>
where T: Display {
    mut out: Stderr = stderr();
    mut buffer: u8[256];
    mut sink: LineBuf<Stderr> = LineBuf::new(&out, &buffer[0], PRINT_BUFFER_SIZE);
    mut f: Formatter<LineBuf<Stderr>> = Formatter::new(&sink);
    match (value.fmt(&f)) {
        Result::Ok(_) => { }
        Result::Err(err) => { return Result::Err(err); }
    }
    match (sink.write_byte(0x0A)) {
        Result::Ok(_) => { }
        Result::Err(err) => { return Result::Err(err); }
    }
    match (sink.flush_buffer()) {
        Result::Ok(_) => { return Result::Ok(()); }
        Result::Err(err) => { return Result::Err(FmtError::Io(err)); }
    }
}

// ============================================================================
// format_to_string — format any Display into an owned String
// ============================================================================

/// Format `value` into a fresh heap-backed `String`. Caller owns the
/// result and is responsible for dropping it.
function format_to_string<T>(value: &T) -> Result<String, FmtError>
where T: Display {
    mut out: String = String::new();
    mut f: Formatter<String> = Formatter::new(&out);
    match (value.fmt(&f)) {
        Result::Ok(_) => { return Result::Ok(out); }
        Result::Err(err) => {
            return Result::Err(err);
        }
    }
}

/// Same shape for `Debug`.
function format_debug_to_string<T>(value: &T) -> Result<String, FmtError>
where T: Debug {
    mut out: String = String::new();
    mut f: Formatter<String> = Formatter::new(&out);
    match (value.fmt(&f)) {
        Result::Ok(_) => { return Result::Ok(out); }
        Result::Err(err) => {
            return Result::Err(err);
        }
    }
}
