///! Display / Debug / Formatter.
///!
///! Every type that wants to be printable implements `Display` (for
///! user output) or `Debug` (for inspection). Both write through a
///! `Formatter` that holds any `FmtWrite` sink as a trait object, so
///! formatting a value to `Stdout`, to a `String`, or to a file all
///! share one compiled `fmt`.
///!
///! Ownership: `Formatter` borrows the writer; the caller owns the
///! underlying sink and is responsible for dropping it, so a `String`
///! formatted into is the caller's own once the formatter is gone.

namespace std::fmt::display;

import std::core::intrinsics;
import std::core::option::{ Option };
import std::core::result::{ Result };
import std::core::slice::{ Slice };
import std::io::error::{ IoError };
import std::io::traits;
import std::io::stdio;
import std::collections::str::{ Str, Utf8Error };
import std::collections::string::{ String };
import std::collections::array::{ Array };
import std::collections::hashmap::{ Entry, HashMap };
import std::collections::hashset::{ HashSet };
import std::collections::pair::{ Pair };
import std::alloc::allocator::{ AllocError, Allocator, GlobalAlloc };
import std::core::primitives;
import std::core::convert::{ ConversionError };
import std::core::iter::{ Iterator };
import std::fmt::float;
import std::fmt::error::{ FmtError };
import std::fmt::write::{ FmtWrite };
import std::fmt::interp::{ Arguments };
import std::json::error::{ JsonError };
import std::random::error::{ RandomError };

// Formatter

![language("formatter")]
public type struct Formatter {
    private writer: virtual mut &FmtWrite;
    /// `debug_struct` and `debug_tuple` write one member per line.
    private pretty: boolean;
    /// How many `debug_struct` / `debug_tuple` builders are open, which is
    /// how far a pretty member line is indented.
    private depth: i64;

    /// Construct over any `FmtWrite` sink, which the formatter borrows
    /// as a trait object: every `fmt` is compiled once and writes to
    /// whatever sink it is given through the sink's table.
    public static new(writer: virtual mut &FmtWrite) -> Formatter {
        return Formatter { writer: writer, pretty: false, depth: 0 };
    }

    /// A formatter whose `debug_struct` and `debug_tuple` write one member
    /// per line, indented four spaces a level:
    ///
    ///     Point {
    ///         x: 1,
    ///         y: 2,
    ///     }
    public static pretty(writer: virtual mut &FmtWrite) -> Formatter {
        return Formatter { writer: writer, pretty: true, depth: 0 };
    }

    /// Whether this formatter writes `Debug` output one member per line.
    public is_pretty(&this) -> boolean { return this.pretty; }

    /// Begin the `Debug` text of a value with named fields:
    /// `f.debug_struct("Point").field("x", &this.x).field("y", &this.y).finish()`
    /// writes `Point { x: 1, y: 2 }`, and a value with no fields its name alone.
    public debug_struct(mut &this, name: string) -> DebugStruct {
        mut result: Result<(), FmtError> = this.write_str(Str::new(name));
        this.depth += 1;
        return DebugStruct { formatter: &this, result: result, has_fields: false };
    }

    /// Begin the `Debug` text of a value with unnamed members - a tuple
    /// struct or an enum variant's payload:
    /// `f.debug_tuple("Some").field(&value).finish()` writes `Some(1)`, and a
    /// value with no members its name alone.
    public debug_tuple(mut &this, name: string) -> DebugTuple {
        mut result: Result<(), FmtError> = this.write_str(Str::new(name));
        this.depth += 1;
        return DebugTuple { formatter: &this, result: result, has_fields: false };
    }

    /// The four-space indent of a pretty member line at the current depth.
    private write_indent(mut &this) -> Result<(), FmtError> {
        for (mut level: i64 = 0; level < this.depth; level++) {
            this.write_str(Str::new("    "))?;
        }
        return Result::Ok(());
    }

    /// Write a `Str`. The usual path for fixed text and for
    /// pre-rendered ASCII (integer digits, escapes) wrapped as a `Str`.
    public write_str(mut &this, source: Str) -> Result<(), FmtError> {
        return this.writer.write_str(source);
    }

    /// Write a single Unicode scalar, UTF-8-encoded.
    public write_char(mut &this, c: char) -> Result<(), FmtError> {
        return this.writer.write_char(c);
    }

    /// Write an f-string, `f.write(f"{a}..{b}")`, each hole formatted
    /// straight into the sink, as `FmtWrite.write` does.
    public write(mut &this, arguments: Arguments) -> Result<(), FmtError> {
        return arguments.write_to(this);
    }

    /// Surface the underlying writer. For advanced composition where
    /// the caller wants to dispatch a second formatter against the
    /// same sink, or to flush mid-stream.
    public get_writer(&this) -> virtual mut &FmtWrite {
        return this.writer;
    }
}

/// The builder `Formatter::debug_struct` begins.  Each `field` writes one
/// named member; `finish` closes the braces and gives the first error any
/// step met, after which the later steps write nothing.
public type struct DebugStruct {
    private formatter: mut &Formatter;
    private result: Result<(), FmtError>;
    private has_fields: boolean;

    /// Write the field `name` with `value`'s `Debug` text.
    public field<T>(mut this, name: string, value: &T) -> DebugStruct
    where T: Debug {
        if (this.result.is_ok()) {
            this.result = this.write_field(name, value);
        }
        this.has_fields = true;
        return this;
    }

    /// Close the value: ` }`, or on a pretty formatter `}` on a line of its
    /// own.  A value with no fields was written as its name alone.
    public finish(mut this) -> Result<(), FmtError> {
        this.formatter.depth -= 1;
        if (this.result.is_ok() && this.has_fields) { this.result = this.write_close(); }
        return this.result;
    }

    private write_close(mut &this) -> Result<(), FmtError> {
        if (this.formatter.pretty) {
            this.formatter.write_indent()?;
            return this.formatter.write_str(Str::new("}"));
        }
        return this.formatter.write_str(Str::new(" }"));
    }

    private write_field<T>(mut &this, name: string, value: &T) -> Result<(), FmtError>
    where T: Debug {
        if (this.formatter.pretty) {
            if (!this.has_fields) { this.formatter.write_str(Str::new(" {\n"))?; }
            this.formatter.write_indent()?;
        } else {
            const separator: string = if (this.has_fields) { ", " } else { " { " };
            this.formatter.write_str(Str::new(separator))?;
        }
        this.formatter.write_str(Str::new(name))?;
        this.formatter.write_str(Str::new(": "))?;
        value.fmt(this.formatter)?;
        if (this.formatter.pretty) { return this.formatter.write_str(Str::new(",\n")); }
        return Result::Ok(());
    }
}

/// The builder `Formatter::debug_tuple` begins.  Each `field` writes one
/// unnamed member; `finish` closes the parentheses and gives the first
/// error any step met, after which the later steps write nothing.
public type struct DebugTuple {
    private formatter: mut &Formatter;
    private result: Result<(), FmtError>;
    private has_fields: boolean;

    /// Write the next member, `value`'s `Debug` text.
    public field<T>(mut this, value: &T) -> DebugTuple
    where T: Debug {
        if (this.result.is_ok()) {
            this.result = this.write_field(value);
        }
        this.has_fields = true;
        return this;
    }

    /// Close the value: `)`, on a line of its own on a pretty formatter.
    /// A value with no members was written as its name alone.
    public finish(mut this) -> Result<(), FmtError> {
        this.formatter.depth -= 1;
        if (this.result.is_ok() && this.has_fields) { this.result = this.write_close(); }
        return this.result;
    }

    private write_close(mut &this) -> Result<(), FmtError> {
        if (this.formatter.pretty) { this.formatter.write_indent()?; }
        return this.formatter.write_str(Str::new(")"));
    }

    private write_field<T>(mut &this, value: &T) -> Result<(), FmtError>
    where T: Debug {
        if (this.formatter.pretty) {
            if (!this.has_fields) { this.formatter.write_str(Str::new("(\n"))?; }
            this.formatter.write_indent()?;
        } else {
            const separator: string = if (this.has_fields) { ", " } else { "(" };
            this.formatter.write_str(Str::new(separator))?;
        }
        value.fmt(this.formatter)?;
        if (this.formatter.pretty) { return this.formatter.write_str(Str::new(",\n")); }
        return Result::Ok(());
    }
}

public type trait Display {
    fmt(&this, f: mut &Formatter) -> Result<(), FmtError>;
}

![language("debug")]
public type trait Debug {
    fmt(&this, f: mut &Formatter) -> Result<(), FmtError>;
}


private function write_u64(f: mut &Formatter,value: u64) -> Result<(), FmtError> {
    mut buffer: [u8; 20];
    const digits: i64 =value.to_decimal_buf(&buffer[0]);
    return f.write_str(Str::from_raw(&buffer[0], digits));
}

private function write_i64(f: mut &Formatter,value: i64) -> Result<(), FmtError> {
    mut buffer: [u8; 21];
    const digits: i64 =value.to_decimal_buf(&buffer[0]);
    return f.write_str(Str::from_raw(&buffer[0], digits));
}

private function write_u128(f: mut &Formatter,value: u128) -> Result<(), FmtError> {
    mut buffer: [u8; 39];
    const digits: i64 =value.to_decimal_buf(&buffer[0]);
    return f.write_str(Str::from_raw(&buffer[0], digits));
}

private function write_i128(f: mut &Formatter,value: i128) -> Result<(), FmtError> {
    mut buffer: [u8; 40];
    const digits: i64 =value.to_decimal_buf(&buffer[0]);
    return f.write_str(Str::from_raw(&buffer[0], digits));
}


/// Display-side wrapper for the float printer.
private function write_float64(f: mut &Formatter,value: f64) -> Result<(), FmtError> {
    mut buffer: [u8; 32];
    const digits: i64 =value.to_buf(&buffer[0]);
    return f.write_str(Str::from_raw(&buffer[0], digits));
}

// Primitive Display impls

implement trait Display for u8 {
    fmt(&this, f: mut &Formatter) -> Result<(), FmtError> {
        return write_u64(f, this as u64);
    }
}
implement trait Display for u16 {
    fmt(&this, f: mut &Formatter) -> Result<(), FmtError> {
        return write_u64(f, this as u64);
    }
}
implement trait Display for u32 {
    fmt(&this, f: mut &Formatter) -> Result<(), FmtError> {
        return write_u64(f, this as u64);
    }
}
implement trait Display for u64 {
    fmt(&this, f: mut &Formatter) -> Result<(), FmtError> {
        return write_u64(f, this);
    }
}
implement trait Display for u128 {
    fmt(&this, f: mut &Formatter) -> Result<(), FmtError> {
        return write_u128(f, this);
    }
}

implement trait Display for i8 {
    fmt(&this, f: mut &Formatter) -> Result<(), FmtError> {
        return write_i64(f, this as i64);
    }
}
implement trait Display for i16 {
    fmt(&this, f: mut &Formatter) -> Result<(), FmtError> {
        return write_i64(f, this as i64);
    }
}
implement trait Display for i32 {
    fmt(&this, f: mut &Formatter) -> Result<(), FmtError> {
        return write_i64(f, this as i64);
    }
}
implement trait Display for i64 {
    fmt(&this, f: mut &Formatter) -> Result<(), FmtError> {
        return write_i64(f, this);
    }
}
implement trait Display for i128 {
    fmt(&this, f: mut &Formatter) -> Result<(), FmtError> {
        return write_i128(f, this);
    }
}
implement trait Display for usize {
    fmt(&this, f: mut &Formatter) -> Result<(), FmtError> {
        return write_u64(f, this as u64);
    }
}
implement trait Display for isize {
    fmt(&this, f: mut &Formatter) -> Result<(), FmtError> {
        return write_i64(f, this as i64);
    }
}

implement trait Display for f32 {
    fmt(&this, f: mut &Formatter) -> Result<(), FmtError> {
        return write_float64(f, this as f64);
    }
}

implement trait Display for f64 {
    fmt(&this, f: mut &Formatter) -> Result<(), FmtError> {
        return write_float64(f, this);
    }
}

implement trait Display for boolean {
    fmt(&this, f: mut &Formatter) -> Result<(), FmtError> {
        if (this) {
            return f.write_str(Str::new("true"));
        }
        return f.write_str(Str::new("false"));
    }
}

implement trait Display for string {
    fmt(&this, f: mut &Formatter) -> Result<(), FmtError> {
        const view: Str = Str::new(this);
        return f.write_str(view);
    }
}


/// `char` is a 4-byte Unicode scalar, written UTF-8-encoded by the sink's
/// `write_char`; a value in the surrogate range (0xD800..=0xDFFF) is not a
/// scalar and is written as the replacement character U+FFFD.
implement trait Display for char {
    fmt(&this, f: mut &Formatter) -> Result<(), FmtError> {
        return f.write_char(this);
    }
}

implement trait Display for struct Str {
    fmt(&this, f: mut &Formatter) -> Result<(), FmtError> {
        return f.write_str(this);
    }
}

implement<A> trait Display for struct String<A>
where A: Allocator {
    fmt(&this, f: mut &Formatter) -> Result<(), FmtError> {
        return f.write_str(this.as_str());
    }
}


