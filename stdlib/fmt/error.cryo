///! FormatError: the failure kind for formatted-text writes.
///!
///! `Display::fmt` and `Debug::fmt` target a `FormatWrite` sink, which
///! can fail two ways:
///!   - the underlying byte sink returned an `IoError` (fd write
///!     failed, socket closed, disk full, ...)
///!   - a heap-backed sink ran out of memory growing its buffer
///!
///! Collapsing both into `IoError::Other` would throw away kind
///! information; a format that failed because `String::push`
///! couldn't reallocate is not the same shape of problem as a
///! closed socket. Callers branch on the variant.

namespace std::fmt::error;

import std::core::convert::{ From };
import std::io::error::{ IoError };
import std::alloc::allocator::{ AllocError };
import std::collections::str::{ Str };

/// Why formatting a value failed: the sink refused the bytes, or a sink
/// that grows (a `String`) could not.
![language("format_error")]
public type enum FormatError {
    /// The byte sink rejected the write. `IoError` carries kind + errno.
    Io(IoError);
    /// A heap-backed sink (`String`, `Array<u8>`) could not grow.
    Alloc(AllocError);
}

implement enum FormatError {
    /// True when the sink refused the write (`Io`).
    public is_io(&this) -> boolean {
        match (&this) {
            FormatError::Io(_) => { return true; }
            FormatError::Alloc(_) => { return false; }
        }
    }

    /// True when a growing sink could not allocate (`Alloc`).
    public is_alloc(&this) -> boolean {
        match (&this) {
            FormatError::Io(_) => { return false; }
            FormatError::Alloc(_) => { return true; }
        }
    }

    /// A short, stable description of what went wrong, as a borrowed `Str`.
    /// The convergent accessor every stdlib error type exposes
    /// (`describe(&this) -> Str`); `Display`/`Debug` for `FormatError` delegate
    /// to it. Forwards to the wrapped error's own `describe`, so the variant
    /// (I/O vs allocation) is reflected without duplicating text here.
    public describe(&this) -> Str {
        match (&this) {
            FormatError::Io(e)    => { return e.describe(); }
            FormatError::Alloc(e) => { return e.describe(); }
        }
    }
}

/// Lift an `IoError` into the fmt layer. Used wherever a `FormatWrite`
/// impl forwards an `io::Write` error; `FormatError::from(io_err)` is
/// the conversion point.
implement trait From<IoError> for enum FormatError {
    static from(err: IoError) -> FormatError {
        return FormatError::Io(err);
    }
}

/// Lift an `AllocError` into the fmt layer. Used by heap-backed
/// `FormatWrite` impls (`String`'s, primarily).
implement trait From<AllocError> for enum FormatError {
    static from(err: AllocError) -> FormatError {
        return FormatError::Alloc(err);
    }
}

/// A failed write into a sink, seen by code that reports `IoError`: the
/// sink's own I/O error, or the allocation failure as an `IoError`.
implement trait From<FormatError> for struct IoError {
    static from(err: FormatError) -> IoError {
        match (err) {
            FormatError::Io(e)    => { return e; }
            FormatError::Alloc(e) => { return IoError::from(e); }
        }
    }
}
