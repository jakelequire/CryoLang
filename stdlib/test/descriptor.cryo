///! TestDescriptor: one row in the static test table.
///!
///! The compiler's `TestMainCodegen` pass synthesizes a static array of
///! `TestDescriptor` values and a `main(argc, argv)` that hands them
///! off to `std::test::runner::run_all`. This module owns the layout
///! the synthesized LLVM IR has to match.
///!
///! Layout stability matters: a change here forces a corresponding
///! change in `compiler/src/compiler/codegen/test_main_codegen.cryo`.
///! Both sides are in this repository, so the contract is checked at
///! build time; the synthesized IR uses the `TestDescriptor` struct
///! type emitted from this very file.

namespace std::test::descriptor;

import core::result;
import collections::str;
import test::error;

// ============================================================================
// TestDescriptor
// ============================================================================

/// One discovered `![test]` function plus its sibling-directive flags.
///
/// `name` is the human-readable fully-qualified name the runner prints
/// (e.g. `Tests::math::add_works`). It's a borrowed `Str` because the
/// underlying bytes live in the synthesized IR's read-only data
/// segment for the lifetime of the program.
///
/// `func` is the function pointer to the user's `![test]` function.
/// Calling it runs the test body; the returned `Result` decides the
/// outcome (combined with the runner's fork-status interpretation).
type struct TestDescriptor {
    name:         Str;
    func:         () -> Result<(), TestError>;
    ignored:      boolean;
    should_panic: boolean;
}
