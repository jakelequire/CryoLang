///! test: Cryo's built-in unit-test framework.
///!
///! Tests live in files under a project's `tests/` directory, with each
///! file's `namespace` declaration carrying `![config(testing)]`. Inside
///! such a file, every `![test]` function is auto-discovered by the
///! compiler and run by `cryo test`.
///!
///! ```cryo
///! ![config(testing)]
///! namespace MyApp::Tests::Math;
///!
///! import std::test::*;
///!
///! ![test]
///! function add_works() -> Result<(), TestError> {
///!     match (expect_eq(2 + 2, 4)) {
///!         Result::Ok(_) => { }
///!         Result::Err(e) => { return Result::Err(e); }
///!     }
///!     return Result::Ok(());
///! }
///!
///! ![test]
///! ![ignore]
///! function not_ready_yet() -> Result<(), TestError> {
///!     // Won't run unless `cryo test --ignored` is used.
///!     return Result::Ok(());
///! }
///!
///! ![test]
///! ![should_panic]
///! function out_of_range() -> Result<(), TestError> {
///!     // Passes only if the function panics or returns Err.
///!     intrinsics::panic("expected", FILE, LINE);
///!     return Result::Ok(());
///! }
///! ```
///!
///! Isolation
///! ---------
///!
///! Each test runs in its own forked child. A panic or `Err` return in
///! one test cannot affect any other. This is intentionally heavier
///! than running everything in-process: Cryo has no in-process panic
///! catch (`setjmp`/`longjmp`), so isolation by fork is the simplest
///! correct option.
///!
///! Sub-modules
///! -----------
///!
///!   * `error`       - `TestError` enum (`Failed` / `Other`) + Display
///!   * `descriptor`  - `TestDescriptor` struct (compiler-emitted layout)
///!   * `assert`      - `expect`, `expect_true` / `expect_false`,
///!                     `expect_eq` / `expect_ne`, `expect_close_f64`,
///!                     `expect_some` / `expect_none`, `expect_ok` /
///!                     `expect_err`, `bail`, `bail_other`
///!   * `runner`      - `run_all` entry point called by the synthesized
///!                     test main; CLI arg parsing; cargo-style output
///!
///! `std::test` is **not** added to the prelude; test files import what
///! they need explicitly. The synthesized test main does the same.

namespace std::test;

public module test::error;
public module test::descriptor;
public module test::assert;
public module test::runner;
