///! Assertion helpers for `![test]` functions.
///!
///! Tests have signature `function name() -> Result<(), TestError>`. The
///! helpers here return a `Result` matching that shape, so a failing
///! assertion propagates with the `?` operator:
///! `expect_eq(2 + 2, 4)?;`. (The explicit `match` form still works and is
///! shown below for readers new to `?`.)
///!
///! Families:
///!
///! * `expect(condition, message)` and `bail(message)`: the no-format
///!   path. Cheapest to call; the message is whatever the test author
///!   wrote verbatim. `expect_true` / `expect_false` are readability
///!   aliases.
///! * `expect_eq` / `expect_ne`: comparison helpers for `T: Eq + Display`.
///!   Build a "left vs. right" failure message so the diagnostic shows
///!   the actual values that disagreed.
///! * `expect_close_f64(a, b, tolerance)`: approximate equality for
///!   floats. Replaces the per-test `within(a, b, eps)` helper every
///!   math test used to roll on its own.
///! * `expect_some` / `expect_none`: check shape of an `Option<T>`
///!   without consuming it (takes `&Option<T>`). The caller still owns
///!   the option and decides whether to drop it.
///! * `expect_ok`   / `expect_err`: same idea for `Result<T, E>`.
///!
///! Idiomatic test code uses `?`:
///!
///! ```cryo
///! ![test] function add_works() -> Result<(), TestError> {
///!     expect_eq(2 + 2, 4)?;
///!     return Result::Ok(());
///! }
///! ```
///!
///! The explicit-`match` form is equivalent and remains valid:
///!
///! ```cryo
///! ![test] function add_works() -> Result<(), TestError> {
///!     match (expect_eq(2 + 2, 4)) {
///!         Result::Ok(_) => { }
///!         Result::Err(e) => { return Result::Err(e); }
///!     }
///!     return Result::Ok(());
///! }
///! ```

namespace std::test::assert;

import std::core::result;
import std::core::cmp;
import std::core::option;
import std::core::slice;
import std::collections::str;
import std::collections::string;
import std::fmt::display;
import std::fmt::error;
import std::test::error;
import std::ffi::libc;

// expect: boolean assertion

/// Return `Ok(())` if `condition` is true, `Err(TestError::Failed(msg))`
/// otherwise. The cheap, no-format assertion.
function expect(condition: boolean, message: Str) -> Result<(), TestError> {
    if (condition) {
        return Result::Ok(());
    }
    return Result::Err(TestError::failed(message));
}

// bail: unconditional failure

/// Always return `Err(TestError::Failed(message))`. Use this when the
/// failure condition is implicit in reaching this code path.
function bail(message: Str) -> Result<(), TestError> {
    return Result::Err(TestError::failed(message));
}

/// Same as `bail` but produces a `TestError::Other`, for non-assertion
/// failures (I/O setup, environment problems, etc.) that the runner
/// should display under "test error" rather than "assertion failed".
function bail_other(message: Str) -> Result<(), TestError> {
    return Result::Err(TestError::other(message));
}

// expect_eq / expect_ne: comparison assertions

/// `Ok(())` if `a.equals(&b)`, otherwise `Err` carrying a multi-line
/// "assertion `left == right` failed" message that Display-formats both
/// values. Allocates the message on the heap; on allocation failure
/// during message building, returns a generic fallback message.
function expect_eq<T>(a: T, b: T) -> Result<(), TestError>
where T: Eq + Display {
    if (a.equals(&b)) {
        return Result::Ok(());
    }
    return Result::Err(format_eq_error(&a, &b, "left == right"));
}

/// `Ok(())` if `!a.equals(&b)`, otherwise `Err` carrying a multi-line
/// "assertion `left != right` failed" message that Display-formats both
/// values. Allocates as `expect_eq` does.
function expect_ne<T>(a: T, b: T) -> Result<(), TestError>
where T: Eq + Display {
    if (!a.equals(&b)) {
        return Result::Ok(());
    }
    return Result::Err(format_eq_error(&a, &b, "left != right"));
}

/// Build the `assertion `<rel>` failed: left = X, right = Y` message
/// shared by `expect_eq` / `expect_ne`. The relation label parameter
/// is the user-facing rendering of the comparator (e.g. `left == right`).
///
/// Allocation failure during formatting falls back to a generic message
/// so the test still surfaces a structured failure rather than aborting.
function format_eq_error<T>(a: &T, b: &T, relation: string) -> TestError
where T: Display {
    mut buf: String = String::new();
    buf.push(Str::new("assertion `"));
    buf.push(Str::from_raw(relation, libc::strlen(relation)));
    buf.push(Str::new("` failed\n  left:  "));
    match (format_to_string(a)) {
        Result::Ok(mut left_str) => {
            buf.push(left_str.as_str());
        }
        Result::Err(_) => {
            buf.push(Str::new("<format error>"));
        }
    }
    buf.push(Str::new("\n  right: "));
    match (format_to_string(b)) {
        Result::Ok(mut right_str) => {
            buf.push(right_str.as_str());
        }
        Result::Err(_) => {
            buf.push(Str::new("<format error>"));
        }
    }
    return TestError::Failed(buf);
}

// expect_true / expect_false: readability aliases over `expect`

/// Same as `expect`. Exists so the spelling at the call site matches the
/// intent ("is this true?") rather than mentioning the word `expect`
/// twice in a row.
function expect_true(condition: boolean, message: Str) -> Result<(), TestError> {
    return expect(condition, message);
}

/// Mirror of `expect_true`. `expect_false(condition, msg)` is clearer
/// than `expect(!condition, msg)` at a call site dominated by negative
/// assertions.
function expect_false(condition: boolean, message: Str) -> Result<(), TestError> {
    if (!condition) {
        return Result::Ok(());
    }
    return Result::Err(TestError::failed(message));
}

// expect_close_f64: approximate float equality

/// `Ok(())` if `|a - b| <= tolerance`. Use this in place of `expect_eq`
/// whenever floats are involved; `expect_eq` would route through
/// `f64::equals`, which is exact-bit comparison and disagrees with every
/// useful definition of "approximately the same".
///
/// `tolerance` must be non-negative; passing a negative value will make
/// every comparison fail.
///
/// On failure the message renders the actual values and the tolerance.
function expect_close_f64(a: f64, b: f64, tolerance: f64) -> Result<(), TestError> {
    const diff: f64 = if (a > b) { a - b } else { b - a };
    if (diff <= tolerance) {
        return Result::Ok(());
    }
    mut buf: String = String::new();
    buf.push(Str::new("assertion `|left - right| <= tolerance` failed\n  left:      "));
    match (format_to_string(&a)) {
        Result::Ok(mut left_str) => { buf.push(left_str.as_str()); }
        Result::Err(_)           => { buf.push(Str::new("<format error>")); }
    }
    buf.push(Str::new("\n  right:     "));
    match (format_to_string(&b)) {
        Result::Ok(mut right_str) => { buf.push(right_str.as_str()); }
        Result::Err(_)            => { buf.push(Str::new("<format error>")); }
    }
    buf.push(Str::new("\n  tolerance: "));
    match (format_to_string(&tolerance)) {
        Result::Ok(mut tol_str) => { buf.push(tol_str.as_str()); }
        Result::Err(_)          => { buf.push(Str::new("<format error>")); }
    }
    return Result::Err(TestError::Failed(buf));
}

// expect_some / expect_none: Option shape checks (non-consuming)

/// `Ok(())` if `opt` is `Some(_)`. Takes a borrow so the test still owns
/// the option afterwards; important for `Option<T>` where `T: Drop`,
/// because the test author is responsible for dropping it.
function expect_some<T>(opt: &Option<T>, message: Str) -> Result<(), TestError> {
    if (opt.is_some()) {
        return Result::Ok(());
    }
    return Result::Err(TestError::failed(message));
}

/// `Ok(())` if `opt` is `None`.
function expect_none<T>(opt: &Option<T>, message: Str) -> Result<(), TestError> {
    if (opt.is_none()) {
        return Result::Ok(());
    }
    return Result::Err(TestError::failed(message));
}

// expect_ok / expect_err: Result shape checks (non-consuming)

/// `Ok(())` if `r` is `Ok(_)`. Takes a borrow so the caller still owns
/// the result.
function expect_ok<T, E>(r: &Result<T, E>, message: Str) -> Result<(), TestError> {
    if (r.is_ok()) {
        return Result::Ok(());
    }
    return Result::Err(TestError::failed(message));
}

/// `Ok(())` if `r` is `Err(_)`.
function expect_err<T, E>(r: &Result<T, E>, message: Str) -> Result<(), TestError> {
    if (r.is_err()) {
        return Result::Ok(());
    }
    return Result::Err(TestError::failed(message));
}
