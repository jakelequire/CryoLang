///! ChildRole: start a `![child_role]` function of this test binary as a
///! process of its own.
///!
///! A test that needs a real child - one in its own process group that
///! receives an interrupt, one whose exit status or output is the thing
///! under test - marks a function `![child_role]` beside its `![test]`
///! functions. The runner never runs a child role as a test; a test starts
///! it by name through `ChildRole::command` and drives the returned
///! `Command` like any other. The child runs that one function and exits 0
///! when it returns `Ok`, 1 when it returns `Err` (its message on stderr),
///! and through a panic's own exit otherwise.

namespace std::test::child_role;

import std::core::option::{ Option };
import std::core::result::{ Result };
import std::collections::str::{ Str };
import std::collections::string::{ String };
import std::env;
import std::process::command::{ Command };
import std::test::error::{ TestError };

public type struct ChildRole {
    /// A command that runs this test binary as the child role `name`, the
    /// role function's fully-qualified name (`Tests::Signals::waits_for_break`).
    /// A name no child role has makes the child print an error and exit 2.
    /// Fails only when the running executable's path cannot be read.
    public static command(name: Str) -> Result<Command, TestError> {
        const executable: Option<String> = env::current_exe();
        if (executable.is_none()) {
            return Result::Err(TestError::other(Str::new("the test binary's own path cannot be read")));
        }
        mut command: Command = Command::new(executable.unwrap().as_str());
        mut role: String = String::from_str(Str::new("--test-runner-role="));
        role.push(name);
        command.arg(role.as_str());
        return Result::Ok(command);
    }
}
