///! Test runner: fork-per-test driver.
///!
///! `run_all` is the entry point the compiler-synthesized test main
///! calls with the descriptor table built from every `![test]` function
///! in the project. Each test runs in its own forked child so a panic
///! or `Err` return in one test cannot take down the rest of the suite.
///!
///! Output is cargo-style human-readable; the trailing summary reports
///! counts and overall verdict. The default multi-threaded run streams a
///! LIVE feed: each result prints the instant it lands (in completion
///! order), and if the feed stalls the runner names the tests still in
///! flight - so a hang shows its culprit instead of a frozen screen. The
///! single-threaded path (`--jobs=1`) keeps the classic ordered
///! `test NAME ... ok` framing and honours `--format`.
///!
///! Argument parsing
///!
///!   cryo test [pattern] [flags]
///!
///!   pattern        Substring filter on the demangled test name. Only
///!                  tests whose name contains `pattern` are run.
///!   --exact        Treat `pattern` as an exact-match requirement.
///!   --ignored      Include `![ignore]`-marked tests instead of skipping.
///!   --list         Print each discovered test name and exit 0 without
///!                  running anything.
///!   -q, --quiet    Suppress per-test "ok" / "ignored" lines; only show
///!                  failures and the summary.
///!   --nocapture    Don't capture per-test output; let each test write its
///!                  stdout/stderr straight to the terminal (live, the
///!                  pre-capture behaviour). By default output is captured
///!                  and replayed only under failing tests. Also set via the
///!                  `CRYO_TEST_NOCAPTURE` environment variable.
///!   --show-output  Also print captured output for tests that pass, not
///!                  just failures. No effect with `--nocapture`.
///!   --timeout=N    Per-test wall-clock limit in seconds (default 60).
///!                  A test exceeding it is killed (SIGALRM in the child)
///!                  and reported as a timeout failure. `--timeout=0`
///!                  disables the watchdog. Also set via the
///!                  `CRYO_TEST_TIMEOUT` environment variable.
///!
///! Exit code is 0 if every selected test passed (or was expected to
///! panic and did). Any single failure -> 1.

namespace std::test::runner;

import core::intrinsics;
import core::option;
import core::result;
import core::slice;
import core::drop;
import core::mem;
import core::convert;
import collections::str;
import collections::string;
import collections::array;
import env;
import io::error;
import io::stdio;
import fmt::display;
import ffi::libc;
import ffi::syscall;
import process::child;
import process::command;
import sync::atomic;
import sync::mpsc;
import thread;
import test::descriptor;
import test::error;

// Output framing (ASCII only). 80-column rules used to set the header and
// summary apart from the per-test stream.

const RULE_HEAVY: string = "================================================================================";
const RULE_THIN:  string = "--------------------------------------------------------------------------------";

// ANSI SGR escape sequences. Only emitted when `color_active(opts)` is true;
// otherwise the bare `[PASS]` / `[FAIL]` / `[skip]` chips ship without codes.
const ANSI_GREEN:  string = "\x1B[32m";
const ANSI_RED:    string = "\x1B[31m";
const ANSI_YELLOW: string = "\x1B[33m";
const ANSI_DIM:    string = "\x1B[2m";
const ANSI_BOLD:   string = "\x1B[1m";
const ANSI_RESET:  string = "\x1B[0m";

// Live parallel feed tuning. `STALL_REPORT_SECS`: how long the feed may go
// without a single test completing before it prints the in-flight "still
// running" list, so a hang is named on screen before its per-test watchdog
// fires (or, with `--timeout=0`, at all). `STALL_POLL_MS`: how often the main
// thread wakes to look for new results while the queue is momentarily empty;
// it does NOT throttle throughput (ready results are drained back-to-back
// without sleeping). Elapsed idle time is measured by accumulating poll
// intervals rather than reading a clock, which keeps the runner free of any
// time-module dependency.
const STALL_REPORT_SECS: u64 = 10;
const STALL_POLL_MS:     u64 = 50;
const STALL_REPORT_MS:   u64 = 10000;   // STALL_REPORT_SECS * 1000

// TestFormat: how per-test results are laid out on stdout
//
//   * Plain   - current behaviour: one `test NAME ... ok` line per test.
//               No color. Default for end-user projects; CI-friendly.
//   * Pretty  - one block per `::`-prefixed namespace, indented leaves
//               with `[PASS]` / `[FAIL]` / `[skip]` chips. Colored on TTY.
//   * Compact - one line per namespace; results stream as `.` (pass),
//               `F` (fail), `s` (skip), `P` (did-not-panic). Failure
//               details printed after the streams, before the summary.

type enum TestFormat {
    Plain;
    Pretty;
    Compact;
}

// ColorMode: when to emit ANSI escapes. `Auto` checks stdout-is-TTY
// and honors `NO_COLOR` per https://no-color.org/.

type enum ColorMode {
    Auto;
    Always;
    Never;
}

// RunOptions: parsed CLI args

type struct RunOptions {
    /// Substring filter: empty means "match everything".
    filter:        String;
    exact:         boolean;
    include_ignored: boolean;
    list_only:     boolean;
    quiet:         boolean;
    format:        TestFormat;
    /// True if the user explicitly passed `--format=...`. Used to
    /// decide whether env-var or cryoconfig defaults can override.
    format_explicit: boolean;
    color:         ColorMode;
    color_explicit: boolean;
    /// Resolved once at the start of `run_all`: did `color` plus the
    /// TTY check land on "emit escapes". Reporters consult this flag
    /// rather than re-evaluating the policy on each test.
    color_active:  boolean;
    /// Per-test wall-clock limit in seconds. The child arms `alarm()`
    /// with this value before running; 0 disables the watchdog.
    timeout_secs:  u32;
    /// True if `--timeout=` was passed explicitly (suppresses the
    /// `CRYO_TEST_TIMEOUT` env default).
    timeout_explicit: boolean;
    /// Number of worker threads to drive tests in parallel. `0` means
    /// "auto" -> resolved to the online CPU count at the start of
    /// `run_all`. `1` forces the classic sequential path. Each worker
    /// still runs every test in its own child process, so parallelism
    /// does not weaken crash / `should_panic` isolation.
    jobs:          u32;
    /// True if `--jobs=`/`-j` was passed explicitly (suppresses the
    /// `CRYO_TEST_JOBS` env default).
    jobs_explicit: boolean;
    /// Capture each test's stdout+stderr into a per-test buffer instead of
    /// letting it stream to the terminal. On (the default) the buffer is
    /// replayed only for failing tests (cargo-style), so a green parallel
    /// run stays clean. `--nocapture` (or `CRYO_TEST_NOCAPTURE`) turns this
    /// off: the child inherits the parent's stdio and writes live, the
    /// pre-capture behaviour.
    capture:       boolean;
    /// Show captured output for *passing* tests too, not just failures.
    /// Set by `--show-output`. No effect when `capture` is off.
    show_output:   boolean;
    /// Re-exec child selector: `>= 0` means "run only descriptors[child_idx]
    /// and exit 0/1, no header/loop".  Set by the internal
    /// `--test-runner-child=<n>` flag the Windows runner passes when it
    /// CreateProcess-re-execs the test binary once per test (Windows has no
    /// `fork`, so each test runs in a fresh process selected by index).
    child_idx: i64;

    static default() -> RunOptions {
        return RunOptions {
            filter:          String::new(),
            exact:           false,
            include_ignored: false,
            list_only:       false,
            quiet:           false,
            format:          TestFormat::Plain,
            format_explicit: false,
            color:           ColorMode::Auto,
            color_explicit:  false,
            color_active:    false,
            timeout_secs:    60,
            timeout_explicit: false,
            jobs:            0,
            jobs_explicit:   false,
            capture:         true,
            show_output:     false,
            child_idx:       -1,
        };
    }

}

implement trait Drop for struct RunOptions {
    drop(mut &this) -> void {
        this.filter.drop();
    }
}

// TestOutcome: what happened when one test ran

type enum TestOutcome {
    /// Test passed: child exited 0 (or signaled, when `should_panic` is set).
    Pass;
    /// Test ran but failed: child returned `Err` (exit != 0) or
    /// panicked unexpectedly. Exit-code and signal carried through so
    /// the summary can show the cause.
    Fail(i32, i32, boolean);     // (code, signal, signaled)
    /// Test was marked `![ignore]` and the user did not pass `--ignored`.
    Skipped;
    /// `![should_panic]` was set but the test exited 0; that is itself
    /// a failure.
    DidNotPanic;
    /// The test exceeded the per-test wall-clock limit and was killed by
    /// the `alarm()` watchdog (SIGALRM). Always a failure, even under
    /// `![should_panic]`. Carries the configured limit in seconds.
    Timeout(u32);
    /// Couldn't `fork()` or `waitpid()`; runner-internal error.
    RunnerError(i32);            // errno
}

// TestRun: a finished test's outcome plus any captured output
//
// `run_one` returns this. `captured` holds the bytes the child wrote to its
// stdout+stderr when capture is enabled (empty otherwise, e.g. `--nocapture`
// or a pipe-setup failure that fell back to inherited stdio). The reporter
// replays `captured` under failing tests (or all tests with `--show-output`).

type struct TestRun {
    outcome:  TestOutcome;
    captured: String;

    /// Outcome with no captured bytes (capture off / nothing to show).
    static bare(outcome: TestOutcome) -> TestRun {
        return TestRun { outcome: outcome, captured: String::new() };
    }

    /// Move the captured buffer out, leaving an empty one behind so the
    /// remaining `TestRun` still drops cleanly. Swap-based to avoid a
    /// partial move out of a `Drop` aggregate (E0453).
    take_captured(mut &this) -> String {
        mut out: String = String::new();
        mem::swap<String>(&this.captured, &out);
        return out;
    }
}

implement trait Drop for struct TestRun {
    drop(mut &this) -> void {
        this.captured.drop();
    }
}

// Counters: running tally for the final summary

type struct Counters {
    passed:    u64;
    failed:    u64;
    ignored:   u64;
    filtered:  u64;

    static new() -> Counters {
        return Counters { passed: 0, failed: 0, ignored: 0, filtered: 0 };
    }
}

// Argument parsing

/// Parse argv (skipping argv[0] = program name) into a `RunOptions`.
/// Unknown flags emit a warning to stderr but do not abort; keeps the
/// runner forgiving while we shake out the surface.
function parse_options(argc: i32, argv: u8**) -> RunOptions {
    mut opts: RunOptions = RunOptions::default();
    if (argv == null) {
        apply_env_defaults(&opts);
        return opts;
    }
    mut i: i32 = 1;
    while (i < argc) {
        const raw: u8* = argv[i as u64];
        if (raw == null) { break; }
        const arg: Str = cstr_to_str(raw);
        if (arg.equals(&Str::new("--exact"))) {
            opts.exact = true;
        } else if (arg.equals(&Str::new("--ignored"))) {
            opts.include_ignored = true;
        } else if (arg.equals(&Str::new("--list"))) {
            opts.list_only = true;
        } else if (arg.equals(&Str::new("-q"))
                || arg.equals(&Str::new("--quiet"))) {
            opts.quiet = true;
        } else if (arg.equals(&Str::new("--nocapture"))
                || arg.equals(&Str::new("--no-capture"))) {
            opts.capture = false;
        } else if (arg.equals(&Str::new("--show-output"))) {
            opts.show_output = true;
        } else if (arg_starts_with(arg, "--format=")) {
            const v: Str = arg.sub_bytes(9, arg.length());
            if (apply_format(&opts, v)) {
                opts.format_explicit = true;
            }
        } else if (arg_starts_with(arg, "--color=")) {
            const v: Str = arg.sub_bytes(8, arg.length());
            if (apply_color(&opts, v)) {
                opts.color_explicit = true;
            }
        } else if (arg_starts_with(arg, "--timeout=")) {
            const v: Str = arg.sub_bytes(10, arg.length());
            if (apply_timeout(&opts, v)) {
                opts.timeout_explicit = true;
            }
        } else if (arg_starts_with(arg, "--jobs=")) {
            const v: Str = arg.sub_bytes(7, arg.length());
            if (apply_jobs(&opts, v)) {
                opts.jobs_explicit = true;
            }
        } else if (arg.equals(&Str::new("-j"))) {
            // `-j N`: the worker count is the following argument.
            if (i + 1 < argc) {
                const nraw: u8* = argv[(i + 1) as u64];
                if (nraw != null) {
                    if (apply_jobs(&opts, cstr_to_str(nraw))) {
                        opts.jobs_explicit = true;
                    }
                    i++; // consume the value
                }
            }
        } else if (arg_starts_with(arg, "-j")) {
            // `-jN`: attached worker count.
            const v: Str = arg.sub_bytes(2, arg.length());
            if (apply_jobs(&opts, v)) {
                opts.jobs_explicit = true;
            }
        } else if (arg_starts_with(arg, "--test-runner-child=")) {
            // Internal: the runner re-execs itself with this flag to run a
            // single test (by index) in a fresh process.
            const v: Str = arg.sub_bytes(20, arg.length());
            opts.child_idx = parse_index(v);
        } else if (arg.length() >= 1 && arg.as_ptr()[0] == 0x2D) { // '-'
            // Unknown flag: warn but keep going.
            intrinsics::printf("warning: unknown flag: %.*s\n",
                arg.length() as i32, arg.as_ptr());
        } else {
            // Positional -> filter pattern. Take the first one only;
            // additional positionals are warned and ignored.
            if (opts.filter.length() == 0) {
                opts.filter = String::from_str(arg);
            } else {
                intrinsics::printf("warning: ignoring extra positional argument\n");
            }
        }
        i++;
    }
    apply_env_defaults(&opts);
    return opts;
}

/// Parse a non-negative decimal index from `v`, or `-1` if empty or
/// non-numeric.  Used for the internal `--test-runner-child=<n>` selector.
function parse_index(v: Str) -> i64 {
    if (v.length() == 0) { return -1; }
    mut n: i64 = 0;
    mut i: u64 = 0;
    const p: u8* = v.as_ptr();
    while (i < v.length()) {
        const c: u8 = p[i];
        if (c < 0x30 || c > 0x39) { return -1; }   // not a digit
        n = n * 10 + ((c - 0x30) as i64);
        i = i + 1;
    }
    return n;
}

/// True if `arg` begins with `prefix` (byte-wise). Used for matching
/// `--format=...` and `--color=...` argv slots without allocating.
function arg_starts_with(arg: Str, prefix: string) -> boolean {
    const p: Str = Str::new(prefix);
    if (arg.length() < p.length()) { return false; }
    return arg.sub_bytes(0, p.length()).equals(&p);
}

/// Parse a TestFormat name and store it. Returns false on an unknown
/// value (caller decides whether to mark the option as explicit).
function apply_format(opts: mut &RunOptions, value: Str) -> boolean {
    if (value.equals(&Str::new("plain"))) {
        opts.format = TestFormat::Plain;
        return true;
    }
    if (value.equals(&Str::new("pretty"))) {
        opts.format = TestFormat::Pretty;
        return true;
    }
    if (value.equals(&Str::new("compact"))) {
        opts.format = TestFormat::Compact;
        return true;
    }
    intrinsics::printf("warning: unknown --format value: %.*s (expected plain|pretty|compact)\n",
        value.length() as i32, value.as_ptr());
    return false;
}

/// Parse a ColorMode name and store it. Returns false on an unknown
/// value.
function apply_color(opts: mut &RunOptions, value: Str) -> boolean {
    if (value.equals(&Str::new("auto"))) {
        opts.color = ColorMode::Auto;
        return true;
    }
    if (value.equals(&Str::new("always"))) {
        opts.color = ColorMode::Always;
        return true;
    }
    if (value.equals(&Str::new("never"))) {
        opts.color = ColorMode::Never;
        return true;
    }
    intrinsics::printf("warning: unknown --color value: %.*s (expected auto|always|never)\n",
        value.length() as i32, value.as_ptr());
    return false;
}

/// Parse a per-test timeout (whole seconds) and store it. Returns false
/// on a non-numeric / out-of-range value (caller leaves the default).
function apply_timeout(opts: mut &RunOptions, value: Str) -> boolean {
    match (u32::try_from(value)) {
        Result::Ok(secs) => {
            opts.timeout_secs = secs;
            return true;
        }
        Result::Err(_) => {
            intrinsics::printf("warning: invalid --timeout value: %.*s (expected a non-negative integer)\n",
                value.length() as i32, value.as_ptr());
            return false;
        }
    }
}

/// Parse a worker count (whole number) and store it. `0` keeps the
/// "auto = CPU count" default. Returns false on a non-numeric value
/// (caller leaves the default).
function apply_jobs(opts: mut &RunOptions, value: Str) -> boolean {
    match (u32::try_from(value)) {
        Result::Ok(n) => {
            opts.jobs = n;
            return true;
        }
        Result::Err(_) => {
            intrinsics::printf("warning: invalid --jobs value: %.*s (expected a non-negative integer)\n",
                value.length() as i32, value.as_ptr());
            return false;
        }
    }
}

/// Fill in any field the user didn't pass on the CLI from environment
/// variables. CLI > env > cryoconfig (via env, set by `cryo test`) > default.
///
///   CRYO_TEST_FORMAT  = plain|pretty|compact
///   CRYO_TEST_COLOR   = auto|always|never
///   CRYO_TEST_TIMEOUT = per-test timeout in seconds (0 disables)
///   CRYO_TEST_JOBS    = worker threads (0 = auto / CPU count)
///   NO_COLOR          = (any value) -> force ColorMode::Never
function apply_env_defaults(opts: mut &RunOptions) -> void {
    // CRYO_TEST_NOCAPTURE: presence (any value) forces capture off, the same
    // as passing `--nocapture`. A CLI `--nocapture` already set capture=false,
    // so this only adds the env path; there's no env to force capture back on.
    if (opts.capture) {
        const nc_opt: Option<String> = env::var(Str::new("CRYO_TEST_NOCAPTURE"));
        match (nc_opt) {
            Option::Some(mut s) => {
                opts.capture = false;
                s.drop();
            }
            Option::None => { }
        }
    }
    if (!opts.jobs_explicit) {
        const j_opt: Option<String> = env::var(Str::new("CRYO_TEST_JOBS"));
        match (j_opt) {
            Option::Some(mut s) => {
                apply_jobs(opts, s.as_str());
                s.drop();
            }
            Option::None => { }
        }
    }
    if (!opts.timeout_explicit) {
        const to_opt: Option<String> = env::var(Str::new("CRYO_TEST_TIMEOUT"));
        match (to_opt) {
            Option::Some(mut s) => {
                apply_timeout(opts, s.as_str());
                s.drop();
            }
            Option::None => { }
        }
    }
    if (!opts.format_explicit) {
        const fmt_opt: Option<String> = env::var(Str::new("CRYO_TEST_FORMAT"));
        match (fmt_opt) {
            Option::Some(mut s) => {
                apply_format(opts, s.as_str());
                s.drop();
            }
            Option::None => { }
        }
    }
    if (!opts.color_explicit) {
        const col_opt: Option<String> = env::var(Str::new("CRYO_TEST_COLOR"));
        match (col_opt) {
            Option::Some(mut s) => {
                apply_color(opts, s.as_str());
                s.drop();
            }
            Option::None => { }
        }
        // NO_COLOR convention: presence (even empty) forces colors off.
        // It wins over CRYO_TEST_COLOR=always when both are set in env,
        // but a CLI `--color=always` still overrides because the
        // explicit-flag short-circuits this whole block.
        const no_color: Option<String> = env::var(Str::new("NO_COLOR"));
        match (no_color) {
            Option::Some(mut s) => {
                opts.color = ColorMode::Never;
                s.drop();
            }
            Option::None => { }
        }
    }
}

/// View a NUL-terminated `u8*` as a `Str` without allocation.
function cstr_to_str(raw: u8*) -> Str {
    return Str::from_raw(raw, libc::strlen(raw));
}

// Color resolution + ANSI emission

/// Resolve `opts.color` into a concrete on/off decision for this run.
/// `Auto` -> on if stdout is a TTY (already gated by NO_COLOR at
/// parse time). Caller stores the result on `opts.color_active`.
function resolve_color_active(opts: &RunOptions) -> boolean {
    match (opts.color) {
        ColorMode::Always => { return true;  }
        ColorMode::Never  => { return false; }
        ColorMode::Auto   => { return is_tty(1); }
    }
    return false;
}

/// Print an ANSI escape if color is active for this run. No-op
/// otherwise; the callers stay branch-free.
function emit_ansi(active: boolean, code: string) -> void {
    if (active) {
        intrinsics::printf("%s", code);
    }
}

// Verdict chips (rendered colored on TTY, plain otherwise).
//
//   chip_pass  -> "[PASS]"  green
//   chip_fail  -> "[FAIL]"  red
//   chip_skip  -> "[skip]"  yellow
//
// These print the chip text only; the caller writes whatever spacing /
// trailing detail (panic reason, exit code) it wants.

function chip_pass(active: boolean) -> void {
    emit_ansi(active, ANSI_GREEN);
    intrinsics::printf("[PASS]");
    emit_ansi(active, ANSI_RESET);
}

function chip_fail(active: boolean) -> void {
    emit_ansi(active, ANSI_RED);
    intrinsics::printf("[FAIL]");
    emit_ansi(active, ANSI_RESET);
}

function chip_skip(active: boolean) -> void {
    emit_ansi(active, ANSI_YELLOW);
    intrinsics::printf("[skip]");
    emit_ansi(active, ANSI_RESET);
}

// Name splitting (for Pretty / Compact grouping)

/// Group prefix + leaf name extracted from a `::`-delimited test name.
///
///   "CryoTests::Lang::SendSyncAutoDerive::sync_accepts_primitives"
///         -> group = "CryoTests::Lang::SendSyncAutoDerive"
///            leaf  = "sync_accepts_primitives"
///
/// Tests with no `::` (rare in practice; the test runner-synthesized
/// names always carry the namespace) come back with an empty group
/// and the full name as the leaf.
type struct SplitName {
    group: Str;
    leaf:  Str;
}

function split_test_name(full: Str) -> SplitName {
    const len: u64 = full.length();
    if (len < 3) {
        return SplitName { group: Str::new(""), leaf: full };
    }
    const ptr: u8* = full.as_ptr();
    // Scan backwards for "::". The first match from the right is the
    // separator between group and leaf.
    mut i: u64 = len - 1;
    while (i >= 1) {
        if (ptr[i - 1] == 0x3A && ptr[i] == 0x3A) {
            return SplitName {
                group: full.sub_bytes(0, i - 1),
                leaf:  full.sub_bytes(i + 1, len),
            };
        }
        if (i == 1) { break; }
        i = i - 1;
    }
    return SplitName { group: Str::new(""), leaf: full };
}

// Filter matching

/// Does `name` match `filter` under the current `exact` mode? An empty
/// filter matches every test; useful for `cryo test` with no pattern.
function name_matches(name: Str, opts: &RunOptions) -> boolean {
    if (opts.filter.length() == 0) {
        return true;
    }
    const pat: Str = opts.filter.as_str();
    if (opts.exact) {
        return name.equals(&pat);
    }
    return contains_substring(name, pat);
}

/// Plain byte-wise substring search: O(n*m) but the inputs here are
/// short (test names are tens of bytes, patterns even shorter). No
/// dependency on a library scan helper.
function contains_substring(haystack: Str, needle: Str) -> boolean {
    const hl: u64 = haystack.length();
    const nl: u64 = needle.length();
    if (nl == 0) { return true; }
    if (nl > hl) { return false; }
    mut i: u64 = 0;
    const stop: u64 = hl - nl;
    while (i <= stop) {
        const window: Str = haystack.sub_bytes(i, i + nl);
        if (window.equals(&needle)) {
            return true;
        }
        i = i + 1;
    }
    return false;
}

// Worker-count detection

/// Number of online CPUs, used as the default worker count. Clamped to
/// at least 1 so the pool always makes progress.
![target(unix)]
function num_cpus() -> u32 {
    // _SC_NPROCESSORS_ONLN == 84 on Linux/glibc and the BSDs.
    const n: i64 = libc::sysconf(84);
    if (n <= 0i64) { return 1u32; }
    return n as u32;
}

![target(windows)]
function num_cpus() -> u32 {
    mut si: syscall::SYSTEM_INFO_PARTIAL = syscall::SYSTEM_INFO_PARTIAL {
        wProcessorArchitecture: 0u16, wReserved: 0u16, dwPageSize: 0u32,
        lpMinimumApplicationAddress: null, lpMaximumApplicationAddress: null,
        dwActiveProcessorMask: 0u64, dwNumberOfProcessors: 0u32,
        dwProcessorType: 0u32, dwAllocationGranularity: 0u32,
        wProcessorLevel: 0u16, wProcessorRevision: 0u16
    };
    syscall::GetSystemInfo(&si as u8*);
    if (si.dwNumberOfProcessors == 0u32) { return 1u32; }
    return si.dwNumberOfProcessors;
}

// Single-test execution

/// Run one test in its own child process and return the outcome the
/// parent should report. Blocks until the child exits.
///
/// Caller is responsible for the surrounding `test NAME ... ` /
/// `OUTCOME\n` framing AND for honouring the `ignored` flag; `run_one`
/// always actually runs the test.  When `--ignored` is passed the
/// runner deliberately wants to execute `![ignore]`-marked tests and
/// see their real outcome.
///
/// `idx` is the test's position in `descriptors`: the child re-execs the
/// test binary with `--test-runner-child=<idx>` so it runs exactly that
/// one test (`run_child_single`).  Both platforms use the re-exec model -
/// POSIX `fork`+`execv`, Windows `CreateProcess` - so `run_one` is safe to
/// call concurrently from worker threads: the child only `execv`s (an
/// async-signal-safe op) and never touches the forking thread's heap, so
/// there is no malloc-lock-at-fork deadlock.
/// Drain a readable fd fully into `out` (read until EOF). Used to siphon a
/// captured child's stdout+stderr off the pipe's read end. Retries on EINTR;
/// stops on EOF (0) or any hard error. The parent drains BEFORE `waitpid`, so
/// a child that fills the ~64KB pipe buffer can't deadlock against a parent
/// blocked in wait.
![target(unix)]
function drain_fd_into(fd: i32, out: mut &String) -> void {
    mut buf: u8[4096];
    loop {
        const n: i64 = libc::read(fd, &buf[0], 4096u64);
        if (n > 0i64) {
            out.push(Str::from_raw(&buf[0], n as u64));
        } else if (n == 0i64) {
            return;                                  // EOF: all write ends closed
        } else {
            if (libc::errno() == 4) { continue; }    // EINTR
            return;                                  // hard error; stop draining
        }
    }
}

![target(unix)]
function run_one(d: TestDescriptor, idx: u64, timeout_secs: u32,
                 capture: boolean) -> TestRun {
    // Drain libc-buffered stdio in the parent before fork so the child
    // doesn't inherit a half-full FILE buffer and re-emit it on flush.
    libc::fflush(null);

    // Resolve this executable's path so the child can re-exec it. All of
    // the allocation below happens in the PARENT, before fork; the child
    // path stays async-signal-safe (dup2/close/execv + _exit only).
    mut exe_buf: u8[4096];
    mut exe_path: String = String::with_null(Str::new("/proc/self/exe"));
    const exe_n: i64 = libc::readlink(exe_path.as_ptr(), &exe_buf[0], 4095u64);
    exe_path.drop();
    if (exe_n <= 0i64) {
        return TestRun::bare(TestOutcome::RunnerError(libc::errno()));
    }
    exe_buf[exe_n as u64] = 0u8; // readlink does not NUL-terminate.

    // `--timeout=<n>`: propagated so the re-exec'd child arms its own
    // SIGALRM watchdog (the POSIX child times itself out; the parent just
    // blocks in waitpid and classifies a SIGALRM kill as a timeout).
    mut timeout_arg: String = String::new();
    timeout_arg.push(Str::new("--timeout="));
    append_u64(&timeout_arg, timeout_secs as u64);
    timeout_arg.push_byte(0u8);

    // `--test-runner-child=<idx>`: selects the single test to run.
    mut child_arg: String = String::new();
    child_arg.push(Str::new("--test-runner-child="));
    append_u64(&child_arg, idx);
    child_arg.push_byte(0u8);

    mut argv: command::ArgvBuf = command::ArgvBuf::new();
    match (argv.push(&exe_buf[0]))         { Result::Ok(_) => { } Result::Err(_) => { } }
    match (argv.push(timeout_arg.as_ptr())) { Result::Ok(_) => { } Result::Err(_) => { } }
    match (argv.push(child_arg.as_ptr()))   { Result::Ok(_) => { } Result::Err(_) => { } }
    match (argv.push(null))                 { Result::Ok(_) => { } Result::Err(_) => { } }

    // Capture pipe: the child's stdout+stderr go to the write end, the parent
    // drains the read end. Created in the parent before fork; a pipe() failure
    // falls back to inherited stdio (rd/wr stay -1, captured stays empty).
    mut rd: i32 = -1;
    mut wr: i32 = -1;
    if (capture) {
        mut fds: i32[2];
        if (libc::pipe(&fds[0]) == 0) {
            rd = fds[0];
            wr = fds[1];
        }
    }

    const pid: i32 = libc::fork();
    if (pid < 0) {
        const e: i32 = libc::errno();
        if (rd >= 0) { libc::close(rd); }
        if (wr >= 0) { libc::close(wr); }
        argv.drop(); child_arg.drop(); timeout_arg.drop();
        return TestRun::bare(TestOutcome::RunnerError(e));
    }

    if (pid == 0) {
        // Child: async-signal-safe only. Point stdout+stderr at the pipe's
        // write end (dup2/close are signal-safe), then re-exec the test binary
        // to run exactly this test; `_exit(127)` if exec fails (parent reads it
        // as the standard "exec not found" code).
        if (wr >= 0) {
            libc::dup2(wr, 1);
            libc::dup2(wr, 2);
            libc::close(rd);
            libc::close(wr);
        }
        libc::execv(&exe_buf[0], argv.as_ptr());
        libc::_exit(127);
    }

    // Parent: close the write end so the read end sees EOF when the child
    // exits, then drain fully BEFORE reaping (the active read keeps the pipe
    // from backing up, so waitpid never deadlocks against a full buffer).
    mut captured: String = String::new();
    if (wr >= 0) { libc::close(wr); wr = -1; }
    if (rd >= 0) {
        drain_fd_into(rd, &captured);
        libc::close(rd);
        rd = -1;
    }

    // Wait for the child, retrying on EINTR.
    mut status: i32 = 0;
    loop {
        const rc: i32 = libc::waitpid(pid, &status, 0);
        if (rc >= 0) { break; }
        const err: i32 = libc::errno();
        if (err != 4) { // EINTR
            argv.drop(); child_arg.drop(); timeout_arg.drop();
            return TestRun { outcome: TestOutcome::RunnerError(err), captured: captured };
        }
    }

    argv.drop();
    child_arg.drop();
    timeout_arg.drop();

    const exit_status: ExitStatus = decode_wstatus(status);
    const outcome: TestOutcome = classify_outcome(exit_status, d.should_panic, timeout_secs);
    return TestRun { outcome: outcome, captured: captured };
}

/// Arm the per-test watchdog in a re-exec'd child. SIGALRM's default
/// disposition terminates the process; the parent sees the signal and
/// classifies it as a timeout. `alarm(0)` (timeout disabled) is a no-op
/// cancel. Windows has no in-child SIGALRM - the parent enforces the
/// timeout with WaitForSingleObject - so this is a no-op there.
![target(unix)]
function arm_watchdog(timeout_secs: u32) -> void {
    if (timeout_secs > 0u32) {
        libc::alarm(timeout_secs);
    }
}

![target(windows)]
function arm_watchdog(timeout_secs: u32) -> void { }

/// Re-exec child entry: run exactly one test by index and return its 0/1
/// exit code (127 for a bad index).  Each test runs in a fresh process
/// (POSIX `fork`+`execv`, Windows `CreateProcess`) selected via
/// `--test-runner-child=<idx>`.  On POSIX the child arms its own SIGALRM
/// watchdog (`arm_watchdog`); on Windows the parent enforces the timeout
/// with WaitForSingleObject.
function run_child_single(idx: u64, descriptors: TestDescriptor*, count: u64,
                          timeout_secs: u32) -> i32 {
    if (idx >= count) { return 127; }
    arm_watchdog(timeout_secs);
    const d: TestDescriptor = descriptors[idx];
    match (d.func()) {
        Result::Ok(_) => { return 0; }
        Result::Err(e) => {
            mut err: TestError = e;
            const view: Str = err.message_str();
            mut stderr_h: Stderr = stderr();
            match (stderr_h.write(view.as_bytes())) {
                Result::Ok(_)  => { }
                Result::Err(_) => { }
            }
            match (stderr_h.write(Slice<u8>::from_raw("\n", 1))) {
                Result::Ok(_)  => { }
                Result::Err(_) => { }
            }
            return 1;
        }
    }
}

/// Append a `u64` as decimal digits to a `String`.  Used to build the
/// `--test-runner-child=<idx>` argument for the Windows re-exec.
function append_u64(out: mut &String, x: u64) -> void {
    if (x == 0u64) { out.push_byte(0x30u8); return; }
    mut tmp: u8[24];
    mut ti: u64 = 0;
    mut v: u64 = x;
    while (v > 0u64) {
        tmp[ti] = ((v % 10u64) + 0x30u64) as u8;
        ti = ti + 1;
        v = v / 10u64;
    }
    while (ti > 0u64) {
        ti = ti - 1;
        out.push_byte(tmp[ti]);
    }
}

/// Windows: read a finished capture temp file's full contents into `out`.
/// The write handle must already be closed so the data is flushed and the
/// open doesn't hit a sharing violation.
![target(windows)]
function read_capture_file(path: &String, out: mut &String) -> void {
    const h: u8* = syscall::CreateFileA(path.as_ptr(), syscall::GENERIC_READ,
        syscall::FILE_SHARE_READ | syscall::FILE_SHARE_WRITE, null,
        syscall::OPEN_EXISTING, 0u32, null);
    if ((h as i64) == -1) { return; }   // local -1, not the cross-module const
    mut buf: u8[4096];
    loop {
        mut nread: u32 = 0u32;
        const ok: i32 = syscall::ReadFile(h, &buf[0], 4096u32, &nread, null);
        if (ok == 0) { break; }          // read error
        if (nread == 0u32) { break; }    // EOF
        out.push(Str::from_raw(&buf[0], nread as u64));
    }
    syscall::CloseHandle(h);
}

/// Windows: run one test in a fresh process.  No `fork`, so re-exec the test
/// binary (GetModuleFileNameA) with `--test-runner-child=<idx>`, wait with the
/// per-test timeout, and classify the exit code.  With `capture`, the child's
/// stdout+stderr are redirected to a per-test temp file (a file can't deadlock
/// on a full pipe buffer, so the parent's WaitForSingleObject timeout stays
/// intact); the file is read back after the child exits.  Without `capture`
/// stdio is inherited so output reaches the console live.  The timeout is
/// enforced here in the parent rather than by an in-child watchdog.
![target(windows)]
function run_one(d: TestDescriptor, idx: u64, timeout_secs: u32,
                 capture: boolean) -> TestRun {
    libc::fflush(null);

    mut exe_buf: u8[1024];
    const n: u32 = intrinsics::GetModuleFileNameA(null, &exe_buf[0] as i8*, 1024u32);
    if (n == 0u32 || n >= 1024u32) { return TestRun::bare(TestOutcome::RunnerError(0)); }
    exe_buf[n as u64] = 0u8;

    // Command line:  "<exe>" --test-runner-child=<idx>\0   (CreateProcessA may
    // modify the buffer, so it's an owned String).
    mut cmd: String = String::new();
    cmd.push_byte(34u8);
    mut k: u64 = 0;
    while (k < n as u64) { cmd.push_byte(exe_buf[k]); k = k + 1; }
    cmd.push_byte(34u8);
    cmd.push(Str::new(" --test-runner-child="));
    append_u64(&cmd, idx);
    cmd.push_byte(0u8);

    // Capture: redirect the child's stdout+stderr to a per-test temp file.
    // A setup failure falls back to inherited stdio (have_cap stays false).
    mut cap_handle: u8*     = null;
    mut cap_path:   String  = String::new();
    mut have_cap:   boolean = false;
    if (capture) {
        mut dir_buf: u8[512];
        const dl: u32 = syscall::GetTempPathA(512u32, &dir_buf[0]);
        if (dl > 0u32 && dl < 512u32) {
            mut name_buf: u8[512];
            mut prefix: String = String::with_null(Str::new("cyt"));
            // GetTempFileNameA creates a unique empty file and writes its full
            // NUL-terminated path into name_buf.
            const uniq: u32 = syscall::GetTempFileNameA(&dir_buf[0], prefix.as_ptr(),
                                                        0u32, &name_buf[0]);
            prefix.drop();
            if (uniq != 0u32) {
                mut sa: syscall::SECURITY_ATTRIBUTES = syscall::SECURITY_ATTRIBUTES {
                    nLength: 24u32, lpSecurityDescriptor: null, bInheritHandle: 1
                };
                const h: u8* = syscall::CreateFileA(&name_buf[0], syscall::GENERIC_WRITE,
                    syscall::FILE_SHARE_READ | syscall::FILE_SHARE_WRITE, &sa as u8*,
                    syscall::CREATE_ALWAYS, 0u32, null);
                if ((h as i64) != -1) {
                    cap_handle = h;
                    cap_path   = String::with_null(cstr_to_str(&name_buf[0]));
                    have_cap   = true;
                }
            }
        }
    }

    mut si: syscall::STARTUPINFOA = syscall::STARTUPINFOA {
        cb: 104u32, lpReserved: null, lpDesktop: null, lpTitle: null,
        dwX: 0u32, dwY: 0u32, dwXSize: 0u32, dwYSize: 0u32,
        dwXCountChars: 0u32, dwYCountChars: 0u32, dwFillAttribute: 0u32,
        dwFlags: 0u32, wShowWindow: 0u16, cbReserved2: 0u16,
        lpReserved2: null, hStdInput: null, hStdOutput: null, hStdError: null
    };
    mut inherit: i32 = 0;
    if (have_cap) {
        // USESTDHANDLES needs all three handles valid and inheritable; hand
        // the child our own stdin and the temp file for stdout+stderr.
        si.dwFlags    = syscall::STARTF_USESTDHANDLES;
        si.hStdInput  = syscall::GetStdHandle(syscall::STD_INPUT_HANDLE);
        si.hStdOutput = cap_handle;
        si.hStdError  = cap_handle;
        inherit = 1;
    }
    mut pi: syscall::PROCESS_INFORMATION = syscall::PROCESS_INFORMATION {
        hProcess: null, hThread: null, dwProcessId: 0u32, dwThreadId: 0u32
    };
    const ok: i32 = syscall::CreateProcessA(null, cmd.as_ptr(), null, null,
                                            inherit, 0u32, null, null, &si, &pi);
    cmd.drop();
    if (ok == 0) {
        if (have_cap) {
            syscall::CloseHandle(cap_handle);
            syscall::DeleteFileA(cap_path.as_ptr());
        }
        cap_path.drop();
        return TestRun::bare(TestOutcome::RunnerError(0));
    }
    syscall::CloseHandle(pi.hThread);

    const ms: u32 = if (timeout_secs > 0u32) { timeout_secs * 1000u32 } else { 0xFFFFFFFFu32 };
    const w: u32 = syscall::WaitForSingleObject(pi.hProcess, ms);
    if (w == 0x102u32) {   // WAIT_TIMEOUT
        syscall::TerminateProcess(pi.hProcess, 1u32);
        syscall::WaitForSingleObject(pi.hProcess, 0xFFFFFFFFu32);
        syscall::CloseHandle(pi.hProcess);
        mut cap_to: String = String::new();
        if (have_cap) {
            syscall::CloseHandle(cap_handle);
            read_capture_file(&cap_path, &cap_to);
            syscall::DeleteFileA(cap_path.as_ptr());
        }
        cap_path.drop();
        return TestRun { outcome: TestOutcome::Timeout(timeout_secs), captured: cap_to };
    }
    mut code: u32 = 0u32;
    syscall::GetExitCodeProcess(pi.hProcess, &code);
    syscall::CloseHandle(pi.hProcess);

    mut captured: String = String::new();
    if (have_cap) {
        // Close the write handle first so the file is flushed and the reader
        // doesn't trip a sharing violation, then read it back and delete it.
        syscall::CloseHandle(cap_handle);
        read_capture_file(&cap_path, &captured);
        syscall::DeleteFileA(cap_path.as_ptr());
    }
    cap_path.drop();

    // No signals on Windows: a plain normal-exit ExitStatus drives the same
    // classifier the POSIX path uses.
    const st: ExitStatus = ExitStatus { code: code as i32, signal: 0, signaled: false };
    const outcome: TestOutcome = classify_outcome(st, d.should_panic, timeout_secs);
    return TestRun { outcome: outcome, captured: captured };
}

/// Translate a child's exit status into a `TestOutcome`, applying the
/// `![should_panic]` inversion. Conventions:
///
///   * Normal exit code 0           -> test returned `Ok(())`.
///   * Normal exit code != 0        -> test returned `Err(...)`.
///   * Killed by signal             -> test panicked / aborted.
///
/// Without `should_panic`: only code 0 passes.
/// With    `should_panic`: any non-zero exit OR any signal passes; a
///                         clean code-0 exit is reported as DidNotPanic.
function classify_outcome(exit_status: ExitStatus, should_panic: boolean,
                          timeout_secs: u32) -> TestOutcome {
    // A SIGALRM kill is our watchdog firing: always a timeout failure,
    // even for `![should_panic]` tests (a hung test is not a panic).
    const SIGALRM: i32 = 14;
    if (exit_status.signaled && exit_status.signal == SIGALRM && timeout_secs > 0) {
        return TestOutcome::Timeout(timeout_secs);
    }
    const clean_zero: boolean = !exit_status.signaled && exit_status.code == 0;
    if (should_panic) {
        if (clean_zero) {
            return TestOutcome::DidNotPanic;
        }
        return TestOutcome::Pass;
    }
    if (clean_zero) {
        return TestOutcome::Pass;
    }
    return TestOutcome::Fail(exit_status.code, exit_status.signal, exit_status.signaled);
}

// Per-test framing

/// Print the leading `test NAME ... ` line. Matches cargo's output so
/// users coming from Rust feel at home. The trailing space lets the
/// outcome word land on the same line.
function print_test_prefix(name: Str) -> void {
    intrinsics::printf("test %.*s ... ", name.length() as i32, name.as_ptr());
}

/// Print the trailing outcome word (and newline). The child has
/// already written any failure detail to stderr; this just labels
/// what just happened.
function print_outcome(outcome: TestOutcome, was_should_panic: boolean) -> void {
    match (outcome) {
        TestOutcome::Pass => {
            if (was_should_panic) {
                intrinsics::printf("ok (panicked as expected)\n");
            } else {
                intrinsics::printf("ok\n");
            }
        }
        TestOutcome::Fail(code, signal, signaled) => {
            if (signaled) {
                intrinsics::printf("FAILED (panicked, signal %d)\n", signal);
            } else {
                intrinsics::printf("FAILED (exit %d)\n", code);
            }
        }
        TestOutcome::Skipped => {
            intrinsics::printf("ignored\n");
        }
        TestOutcome::DidNotPanic => {
            intrinsics::printf("FAILED (test did not panic as expected)\n");
        }
        TestOutcome::Timeout(secs) => {
            intrinsics::printf("FAILED (timed out after %u s)\n", secs);
        }
        TestOutcome::RunnerError(code) => {
            intrinsics::printf("FAILED (runner error: errno=%d)\n", code);
        }
    }
}

/// True if `outcome` should count toward the failed total.
function is_failure(outcome: TestOutcome) -> boolean {
    match (outcome) {
        TestOutcome::Fail(_, _, _)   => { return true;  }
        TestOutcome::DidNotPanic     => { return true;  }
        TestOutcome::Timeout(_)      => { return true;  }
        TestOutcome::RunnerError(_)  => { return true;  }
        _                            => { return false; }
    }
}

// Reporter state + format-aware dispatch
//
// `ReporterState` carries the "what group are we currently in" plus
// (in Compact mode only) the in-flight per-group dot stream and tally.
// The buffers are reused across groups via `String::clear()` so the
// per-group flush doesn't churn the allocator.

type struct ReporterState {
    /// True once we've printed at least one group header (Pretty) or
    /// started accumulating dots for one (Compact).
    has_group: boolean;
    /// Owned copy of the currently-active group name. `String::clear()`
    /// resets length without freeing capacity between groups.
    cur_group: String;
    /// Compact-only: per-group dot stream (`.` pass, `F` fail, `s`
    /// skip, `P` did-not-panic, `E` runner-error). Flushed and cleared
    /// when the group changes or the run ends.
    cur_dots: String;
    cur_ok:   u64;
    cur_fail: u64;
    cur_skip: u64;

    static new() -> ReporterState {
        return ReporterState {
            has_group: false,
            cur_group: String::new(),
            cur_dots:  String::new(),
            cur_ok:    0,
            cur_fail:  0,
            cur_skip:  0,
        };
    }
}

implement trait Drop for struct ReporterState {
    drop(mut &this) -> void {
        this.cur_group.drop();
        this.cur_dots.drop();
    }
}

// ---- Plain reporter (cargo-style, byte-identical to pre-1.0 output) ----

/// `test FULL::QUALIFIED::NAME ... ` - the original prefix line. The
/// trailing space lets the outcome word land on the same line.
function plain_begin_test(name: Str) -> void {
    intrinsics::printf("test %.*s ... ", name.length() as i32, name.as_ptr());
}

/// Outcome word + newline. Mirrors `print_outcome` but lives next to
/// the other Plain helpers so the three formats are siblings.
function plain_end_test(outcome: TestOutcome, was_should_panic: boolean) -> void {
    print_outcome(outcome, was_should_panic);
}

/// Ignored-test entry (one line, `... ignored`).
function plain_skipped(name: Str) -> void {
    plain_begin_test(name);
    plain_end_test(TestOutcome::Skipped, false);
}

// ---- Pretty reporter (grouped + indented + colored chips) ----

/// Emit the group header line if the group changed (or this is the
/// first group). A blank line separates adjacent groups.
function pretty_enter_group(state: mut &ReporterState, group: Str) -> void {
    if (state.has_group) {
        const cur: Str = state.cur_group.as_str();
        if (cur.equals(&group)) {
            return;
        }
        intrinsics::printf("\n");
    }
    // Empty group name (no `::` in the test name) -> render as `<root>`
    // so it's still visually distinct.
    if (group.length() == 0) {
        intrinsics::printf("<root>\n");
    } else {
        intrinsics::printf("%.*s\n", group.length() as i32, group.as_ptr());
    }
    state.cur_group.clear();
    state.cur_group.push(group);
    state.has_group = true;
}

/// `  leaf_name ... ` - indented in-flight prefix. Flushed before the
/// fork so a hang at least shows which test was in flight.
function pretty_begin_test(state: mut &ReporterState, name: Str) -> void {
    const sn: SplitName = split_test_name(name);
    pretty_enter_group(state, sn.group);
    intrinsics::printf("  %.*s ... ", sn.leaf.length() as i32, sn.leaf.as_ptr());
}

/// Verdict chip + trailing detail. Color-active state read from opts.
function pretty_end_test(opts: &RunOptions, outcome: TestOutcome,
                          was_should_panic: boolean) -> void {
    match (outcome) {
        TestOutcome::Pass => {
            chip_pass(opts.color_active);
            if (was_should_panic) {
                intrinsics::printf("  (panicked as expected)");
            }
            intrinsics::printf("\n");
        }
        TestOutcome::Fail(code, signal, signaled) => {
            chip_fail(opts.color_active);
            if (signaled) {
                intrinsics::printf("  (panicked, signal %d)\n", signal);
            } else {
                intrinsics::printf("  (exit %d)\n", code);
            }
        }
        TestOutcome::Skipped => {
            chip_skip(opts.color_active);
            intrinsics::printf("\n");
        }
        TestOutcome::DidNotPanic => {
            chip_fail(opts.color_active);
            intrinsics::printf("  (test did not panic as expected)\n");
        }
        TestOutcome::Timeout(secs) => {
            chip_fail(opts.color_active);
            intrinsics::printf("  (timed out after %u s)\n", secs);
        }
        TestOutcome::RunnerError(code) => {
            chip_fail(opts.color_active);
            intrinsics::printf("  (runner error: errno=%d)\n", code);
        }
    }
}

/// Indented `  leaf_name ... [skip]` for `![ignore]` without execution.
function pretty_skipped(state: mut &ReporterState, opts: &RunOptions, name: Str) -> void {
    pretty_begin_test(state, name);
    pretty_end_test(opts, TestOutcome::Skipped, false);
}

// ---- Compact reporter (one line per group, dot stream) ----

/// Flush the in-flight group: pad group name to a column, then the
/// dot stream, then a `N ok[, M fail[, K skip]]` summary.
function compact_flush_group(state: mut &ReporterState) -> void {
    if (!state.has_group) { return; }
    const gview: Str = state.cur_group.as_str();
    const glen:  u64 = gview.length();
    if (glen == 0) {
        intrinsics::printf("<root>");
    } else {
        intrinsics::printf("%.*s", glen as i32, gview.as_ptr());
    }
    // Pad to roughly column 50 so the dot streams align across groups.
    // For overlong group names, fall back to two spaces.
    const target: u64 = 50;
    const display: u64 = if (glen == 0) { 6 } else { glen };
    mut pad: u64 = if (display < target) { target - display } else { 2 };
    mut k: u64 = 0;
    while (k < pad) {
        intrinsics::printf(" ");
        k = k + 1;
    }
    const dview: Str = state.cur_dots.as_str();
    intrinsics::printf("%.*s", dview.length() as i32, dview.as_ptr());
    // Space + per-group summary.
    intrinsics::printf("   %llu ok", state.cur_ok);
    if (state.cur_fail > 0) { intrinsics::printf(", %llu fail", state.cur_fail); }
    if (state.cur_skip > 0) { intrinsics::printf(", %llu skip", state.cur_skip); }
    intrinsics::printf("\n");
    libc::fflush(null);
    // Reset for next group.
    state.cur_group.clear();
    state.cur_dots.clear();
    state.cur_ok = 0;
    state.cur_fail = 0;
    state.cur_skip = 0;
    state.has_group = false;
}

/// Switch into `group`, flushing the previous one if any.
function compact_enter_group(state: mut &ReporterState, group: Str) -> void {
    if (state.has_group) {
        const cur: Str = state.cur_group.as_str();
        if (cur.equals(&group)) { return; }
        compact_flush_group(state);
    }
    state.cur_group.push(group);
    state.has_group = true;
}

/// Setup before a test runs: ensure the group header is current.
/// Compact doesn't print anything per-test up front; the dot lands at
/// end_test time.
function compact_begin_test(state: mut &ReporterState, name: Str) -> void {
    const sn: SplitName = split_test_name(name);
    compact_enter_group(state, sn.group);
}

/// Append a dot/letter for this outcome and bump the per-group tally.
function compact_end_test(state: mut &ReporterState, outcome: TestOutcome) -> void {
    match (outcome) {
        TestOutcome::Pass => {
            state.cur_dots.push_byte(0x2E as u8); // '.'
            state.cur_ok = state.cur_ok + 1;
        }
        TestOutcome::Fail(_, _, _) => {
            state.cur_dots.push_byte(0x46 as u8); // 'F'
            state.cur_fail = state.cur_fail + 1;
        }
        TestOutcome::Skipped => {
            state.cur_dots.push_byte(0x73 as u8); // 's'
            state.cur_skip = state.cur_skip + 1;
        }
        TestOutcome::DidNotPanic => {
            state.cur_dots.push_byte(0x50 as u8); // 'P'
            state.cur_fail = state.cur_fail + 1;
        }
        TestOutcome::Timeout(_) => {
            state.cur_dots.push_byte(0x54 as u8); // 'T'
            state.cur_fail = state.cur_fail + 1;
        }
        TestOutcome::RunnerError(_) => {
            state.cur_dots.push_byte(0x45 as u8); // 'E'
            state.cur_fail = state.cur_fail + 1;
        }
    }
}

/// Ignored tests under Compact mode: enter the group, emit `s`, bump
/// the skip tally. No fork.
function compact_skipped(state: mut &ReporterState, name: Str) -> void {
    compact_begin_test(state, name);
    state.cur_dots.push_byte(0x73 as u8);
    state.cur_skip = state.cur_skip + 1;
}

// The format-dispatched reporter façade now lives as methods on
// `TestRunner` (`report_begin` / `report_end` / `report_skipped` /
// `report_finalize`); see the entry-point section below. The
// `plain_*` / `pretty_*` / `compact_*` helpers above stay free functions
// the methods delegate to.

// Parallel execution
//
// A worker pool runs tests concurrently while preserving the same
// process-per-test isolation the sequential path uses. Work is handed out
// by a lock-free atomic cursor; each worker ships events back over an mpsc
// channel. The main thread streams every result the moment it lands, so the
// feed is live: you watch tests complete in real time instead of staring at
// a frozen screen until the whole suite finishes.
//
// Each worker emits TWO events per test - a `Started` the instant it picks
// the test up, and a `Finished` carrying the outcome (and captured output).
// Tracking which `Started`s have no matching `Finished` lets the main thread
// name the tests still in flight when the feed stalls, so a hang points at
// its culprit before (or instead of) the per-test watchdog firing.
//
// Output order follows completion, not the descriptor table: with workers
// racing there is no meaningful single order to preserve, and a live feed is
// worth more than a deterministic-but-delayed replay. Each event prints as
// one self-contained line so concurrent workers never interleave a partial
// one. (`--jobs=1` still takes the sequential path, which keeps the classic
// ordered `test NAME ... ok` framing and honours `--format`.)

/// Which half of a test's lifecycle a `WorkerResult` reports.
type enum WorkerEventKind {
    /// A worker has just picked this test up and is about to run it. Carries
    /// no outcome; its only job is to mark the test in-flight so a stall can
    /// name it.
    Started;
    /// The test finished; `outcome` and `captured` are meaningful.
    Finished;
}

/// One lifecycle event for a test, addressed back to its slot in the
/// descriptor table. `captured` carries the child's output on a `Finished`
/// event (moved across the channel; `String` is structurally `Send`); it is
/// empty on `Started` and whenever capture is off.
type struct WorkerResult {
    idx:      u64;
    kind:     WorkerEventKind;
    outcome:  TestOutcome;
    captured: String;

    /// Move the captured buffer out (swap-based; see `TestRun::take_captured`).
    take_captured(mut &this) -> String {
        mut out: String = String::new();
        mem::swap<String>(&this.captured, &out);
        return out;
    }
}

implement trait Drop for struct WorkerResult {
    drop(mut &this) -> void {
        this.captured.drop();
    }
}

/// Everything a pool worker needs, moved into the thread by value. The
/// pointers alias state owned by `run_all_parallel`, which joins every
/// worker before returning, so they stay valid for the worker's lifetime.
/// `Send` is satisfied structurally: raw pointers and `mpsc::Sender` are
/// `Send`, and `WorkerResult` is plain data.
type struct WorkerCtx {
    counter:      Atomic<u64>*;          // shared work cursor
    runnable:     u64*;                  // runnable descriptor indices
    n_runnable:   u64;
    descriptors:  TestDescriptor*;
    timeout_secs: u32;
    capture:      boolean;
    sender:       mpsc::Sender<WorkerResult>;
}

/// Pool worker body. Pulls test indices off the shared cursor until the
/// runnable list is exhausted, running each in its own child process. For
/// each test it ships a `Started` event the instant it picks the test up and
/// a `Finished` event carrying the outcome once the child exits, so the main
/// thread can both stream results live and name the tests still in flight
/// during a stall. `ctx` (including its `Sender`) is dropped on return,
/// releasing this worker's sender so the channel can disconnect once every
/// worker has finished.
function test_worker(ctx: WorkerCtx) -> void {
    loop {
        const k: u64 = (*ctx.counter).fetch_add(1u64, MemoryOrder::Relaxed);
        if (k >= ctx.n_runnable) { break; }
        const idx: u64 = ctx.runnable[k];

        // Announce the test as in-flight before the (potentially hanging)
        // child runs, so a stall report can point at it.
        const start_ev: WorkerResult = WorkerResult {
            idx: idx, kind: WorkerEventKind::Started,
            outcome: TestOutcome::Pass, captured: String::new()
        };
        match (ctx.sender.send(start_ev)) {
            Result::Ok(_)  => { }
            Result::Err(_) => { }
        }

        const d: TestDescriptor = ctx.descriptors[idx];
        mut tr: TestRun = run_one(d, idx, ctx.timeout_secs, ctx.capture);
        const fin_ev: WorkerResult = WorkerResult {
            idx: idx, kind: WorkerEventKind::Finished,
            outcome: tr.outcome, captured: tr.take_captured()
        };
        tr.drop();
        match (ctx.sender.send(fin_ev)) {
            Result::Ok(_)  => { }
            Result::Err(_) => { }
        }
    }
}

/// Print the live feed's "still running" line: every test that has started
/// but not yet reported a result. Called when the feed stalls (no completion
/// for `stalled_secs`), so a hang names its culprit on screen before the
/// per-test watchdog fires - or at all, when `--timeout=0` disables it. The
/// list is capped so a wide stall on a large suite stays one readable line.
function print_in_flight(descriptors: TestDescriptor*, count: u64,
                         in_flight: &Array<boolean>, n_in_flight: u64,
                         stalled_secs: u64) -> void {
    intrinsics::printf("[stalled %llu s] still running (%llu): ",
        stalled_secs, n_in_flight);
    const cap: u64 = 12;
    mut shown: u64 = 0;
    mut i: u64 = 0;
    while (i < count) {
        match (in_flight.get_ref(i)) {
            Option::Some(b) => {
                if (*b) {
                    if (shown >= cap) {
                        intrinsics::printf(", ... and %llu more", n_in_flight - shown);
                        break;
                    }
                    if (shown > 0u64) { intrinsics::printf(", "); }
                    const d: TestDescriptor = descriptors[i];
                    intrinsics::printf("%.*s", d.name.length() as i32, d.name.as_ptr());
                    shown = shown + 1;
                }
            }
            Option::None => { }
        }
        i = i + 1;
    }
    intrinsics::printf("\n");
    libc::fflush(null);
}

// TestRunner: owns the run's configuration, tally, and reporter state and
// drives the whole suite. `run_all` (below) constructs one and delegates to
// `run`; the reporter façade and the sequential / parallel drivers are
// methods, so the threaded state travels with the object instead of being
// passed by reference through a pile of free functions.
//
// Target-gated primitives (`run_one`, `num_cpus`, `arm_watchdog`) and the
// pool worker body (`test_worker`) stay free functions: the first because
// `![target(...)]` variants can't be methods, the second because the worker
// is handed to `thread::spawn` as a plain function pointer. The live drain
// loop itself is a `TestRunner` method (`run_parallel`), so the tally and
// reporter travel with the object.

type struct TestRunner {
    opts:        RunOptions;
    counts:      Counters;
    rstate:      ReporterState;
    /// Static descriptor table baked into the executable by `TestMainCodegen`.
    /// Non-owning: valid for the lifetime of the call, never freed here.
    descriptors: TestDescriptor*;
    count:       u64;

    /// Take ownership of the parsed options and wrap the descriptor table.
    static new(opts: RunOptions, descriptors: TestDescriptor*, count: u64) -> TestRunner {
        return TestRunner {
            opts:        opts,
            counts:      Counters::new(),
            rstate:      ReporterState::new(),
            descriptors: descriptors,
            count:       count,
        };
    }

    // ---- Reporter façade (format-dispatched) ----

    /// In-flight prefix for a test about to run. Flushed so a hang at
    /// least shows which test was in flight.
    report_begin(mut &this, name: Str) -> void {
        const f: TestFormat = this.opts.format;
        match (f) {
            TestFormat::Plain   => { plain_begin_test(name); }
            TestFormat::Pretty  => { pretty_begin_test(&this.rstate, name); }
            TestFormat::Compact => { compact_begin_test(&this.rstate, name); }
        }
        libc::fflush(null);
    }

    /// Outcome word / chip / dot for a finished test.
    report_end(mut &this, outcome: TestOutcome, was_should_panic: boolean) -> void {
        const f: TestFormat = this.opts.format;
        match (f) {
            TestFormat::Plain   => { plain_end_test(outcome, was_should_panic); }
            TestFormat::Pretty  => { pretty_end_test(&this.opts, outcome, was_should_panic); }
            TestFormat::Compact => { compact_end_test(&this.rstate, outcome); }
        }
    }

    /// Report an `![ignore]`-skipped test without running it. The Pretty
    /// arm is split into begin + end so each call borrows a single field.
    report_skipped(mut &this, name: Str) -> void {
        const f: TestFormat = this.opts.format;
        match (f) {
            TestFormat::Plain   => { plain_skipped(name); }
            TestFormat::Pretty  => {
                pretty_begin_test(&this.rstate, name);
                pretty_end_test(&this.opts, TestOutcome::Skipped, false);
            }
            TestFormat::Compact => { compact_skipped(&this.rstate, name); }
        }
    }

    /// Compact mode flushes the last in-flight group; Plain/Pretty no-op.
    report_finalize(mut &this) -> void {
        const f: TestFormat = this.opts.format;
        match (f) {
            TestFormat::Plain   => { }
            TestFormat::Pretty  => { }
            TestFormat::Compact => { compact_flush_group(&this.rstate); }
        }
    }

    /// Should this test's captured output be replayed? Only when capture is
    /// on and there's something to show: every failing test, plus passing
    /// tests too under `--show-output`.
    should_show(&this, failed: boolean) -> boolean {
        if (!this.opts.capture) { return false; }
        return failed || this.opts.show_output;
    }

    /// Replay one test's captured stdout+stderr under a labelled rule.
    /// Caller has already decided this should print (see `should_show`) and
    /// that `captured` is non-empty.
    report_output(&this, name: Str, captured: &String) -> void {
        const v: Str = captured.as_str();
        intrinsics::printf("---- %.*s : output ----\n",
            name.length() as i32, name.as_ptr());
        intrinsics::printf("%.*s", v.length() as i32, v.as_ptr());
        // Guarantee the trailing rule starts on its own line even when the
        // test's last write had no newline.
        if (v.length() == 0u64 || v.as_ptr()[v.length() - 1u64] != 0x0Au8) {
            intrinsics::printf("\n");
        }
        intrinsics::printf("----\n");
    }

    /// One self-contained result line for the live parallel feed. The
    /// sequential reporters split a test across `begin` (prefix, no newline)
    /// and `end` (outcome word), which only reads correctly when one test
    /// runs at a time. Concurrent workers would interleave those halves, so
    /// the live feed instead prints the whole line atomically on completion:
    /// a fixed-width status token (color-coded when active), the
    /// fully-qualified name, then any detail. Format-independent - the
    /// grouped Pretty/Compact layouts need ordered, buffered results, which
    /// the live path deliberately does without.
    report_live_finish(&this, name: Str, outcome: TestOutcome,
                       was_should_panic: boolean) -> void {
        const active: boolean = this.opts.color_active;
        match (outcome) {
            TestOutcome::Pass => {
                emit_ansi(active, ANSI_GREEN);
                intrinsics::printf("ok  ");
                emit_ansi(active, ANSI_RESET);
                intrinsics::printf("  %.*s", name.length() as i32, name.as_ptr());
                if (was_should_panic) {
                    intrinsics::printf("  (panicked as expected)");
                }
                intrinsics::printf("\n");
            }
            TestOutcome::Fail(code, signal, signaled) => {
                emit_ansi(active, ANSI_RED);
                intrinsics::printf("FAIL");
                emit_ansi(active, ANSI_RESET);
                intrinsics::printf("  %.*s", name.length() as i32, name.as_ptr());
                if (signaled) {
                    intrinsics::printf("  (panicked, signal %d)\n", signal);
                } else {
                    intrinsics::printf("  (exit %d)\n", code);
                }
            }
            TestOutcome::Skipped => {
                emit_ansi(active, ANSI_YELLOW);
                intrinsics::printf("skip");
                emit_ansi(active, ANSI_RESET);
                intrinsics::printf("  %.*s\n", name.length() as i32, name.as_ptr());
            }
            TestOutcome::DidNotPanic => {
                emit_ansi(active, ANSI_RED);
                intrinsics::printf("FAIL");
                emit_ansi(active, ANSI_RESET);
                intrinsics::printf("  %.*s  (test did not panic as expected)\n",
                    name.length() as i32, name.as_ptr());
            }
            TestOutcome::Timeout(secs) => {
                emit_ansi(active, ANSI_RED);
                intrinsics::printf("FAIL");
                emit_ansi(active, ANSI_RESET);
                intrinsics::printf("  %.*s  (timed out after %u s)\n",
                    name.length() as i32, name.as_ptr(), secs);
            }
            TestOutcome::RunnerError(code) => {
                emit_ansi(active, ANSI_RED);
                intrinsics::printf("FAIL");
                emit_ansi(active, ANSI_RESET);
                intrinsics::printf("  %.*s  (runner error: errno=%d)\n",
                    name.length() as i32, name.as_ptr(), code);
            }
        }
        libc::fflush(null);
    }

    // ---- Drivers ----

    /// `--list`: print each matching test name and return without running.
    list(&this) -> void {
        mut i: u64 = 0;
        while (i < this.count) {
            const d: TestDescriptor = this.descriptors[i];
            if (name_matches(d.name, &this.opts)) {
                if (d.ignored) {
                    intrinsics::printf("%.*s: test, ignored\n",
                        d.name.length() as i32, d.name.as_ptr());
                } else if (d.should_panic) {
                    intrinsics::printf("%.*s: test, should_panic\n",
                        d.name.length() as i32, d.name.as_ptr());
                } else {
                    intrinsics::printf("%.*s: test\n",
                        d.name.length() as i32, d.name.as_ptr());
                }
            }
            i = i + 1;
        }
    }

    /// Sequential driver: the classic one-test-at-a-time path (`--jobs=1`,
    /// or a single matching test). Byte-for-byte the pre-parallel output.
    run_sequential(mut &this) -> void {
        mut i: u64 = 0;
        while (i < this.count) {
            const d: TestDescriptor = this.descriptors[i];

            if (!name_matches(d.name, &this.opts)) {
                this.counts.filtered = this.counts.filtered + 1;
                i = i + 1;
                continue;
            }

            if (d.ignored && !this.opts.include_ignored) {
                if (!this.opts.quiet) {
                    this.report_skipped(d.name);
                }
                this.counts.ignored = this.counts.ignored + 1;
                i = i + 1;
                continue;
            }

            // Always emit a prefix for runs we actually execute so the
            // user can see which test is in flight (helps debug a hang).
            this.report_begin(d.name);
            mut tr: TestRun = run_one(d, i, this.opts.timeout_secs, this.opts.capture);
            const outcome: TestOutcome = tr.outcome;
            const failed: boolean = is_failure(outcome);
            this.report_end(outcome, d.should_panic);
            if (this.should_show(failed) && tr.captured.length() > 0u64) {
                this.report_output(d.name, &tr.captured);
            }
            tr.drop();

            if (failed) {
                this.counts.failed = this.counts.failed + 1;
            } else {
                this.counts.passed = this.counts.passed + 1;
            }
            i = i + 1;
        }
    }

    /// Parallel driver (live): run matching tests across `jobs` workers and
    /// stream each result the instant it lands, in completion order. Filtered
    /// and ignored-skipped tests - which never reach a worker - are accounted
    /// for in a quick pre-pass; the rest run concurrently while the main
    /// thread drains events as fast as they arrive, sleeping only when the
    /// queue is momentarily empty. Tracking which started tests have not yet
    /// finished lets a stall (no completion for `STALL_REPORT_SECS`) print the
    /// names still in flight, so a hang is visible long before its watchdog.
    run_parallel(mut &this, jobs: u32, to_run: u64) -> void {
        // Pre-pass on the main thread: report + tally the tests that won't be
        // executed (filtered / ignored-skipped), and collect the runnable
        // indices. `in_flight[i]` tracks whether descriptor `i` is currently
        // running, for the stall report.
        mut runnable:  Array<u64>     = Array::with_capacity(to_run);
        mut in_flight: Array<boolean> = Array::with_capacity(this.count);
        mut i: u64 = 0;
        while (i < this.count) {
            in_flight.push(false);
            const d: TestDescriptor = this.descriptors[i];
            if (!name_matches(d.name, &this.opts)) {
                this.counts.filtered = this.counts.filtered + 1;
            } else if (d.ignored && !this.opts.include_ignored) {
                if (!this.opts.quiet) {
                    this.report_live_finish(d.name, TestOutcome::Skipped, false);
                }
                this.counts.ignored = this.counts.ignored + 1;
            } else {
                runnable.push(i);
            }
            i = i + 1;
        }

        const n_runnable: u64 = runnable.length();
        if (n_runnable == 0u64) {
            in_flight.drop();
            runnable.drop();
            return;
        }

        // Shared work cursor on the stack; workers borrow it by pointer and we
        // join them all before this frame returns (scoped-thread idiom).
        mut counter: Atomic<u64> = Atomic<u64>::new(0u64);
        const cptr: Atomic<u64>* = &counter;

        mut rx: mpsc::Receiver<WorkerResult> = mpsc::channel<WorkerResult>();

        {
            mut scope: thread::Scope = thread::Scope::new();
            mut w: u32 = 0;
            while (w < jobs) {
                const ctx: WorkerCtx = WorkerCtx {
                    counter:      cptr,
                    runnable:     runnable.as_ptr(),
                    n_runnable:   n_runnable,
                    descriptors:  this.descriptors,
                    timeout_secs: this.opts.timeout_secs,
                    capture:      this.opts.capture,
                    sender:       rx.sender(),
                };
                scope.spawn<WorkerCtx>(ctx, test_worker);
                w = w + 1;
            }

            // Live drain. Loop until every runnable test has reported a
            // `Finished`. Ready events are handled back-to-back; only an empty
            // queue sleeps, and only then do we consider a stall report. Idle
            // time is tracked by accumulating poll intervals (`idle_ms`),
            // reset whenever any event lands; `next_report_ms` re-arms one
            // interval ahead so a persistent hang reprints every
            // `STALL_REPORT_SECS` with a rising count.
            mut finished:       u64 = 0;
            mut n_in_flight:    u64 = 0;
            mut idle_ms:        u64 = 0;
            mut next_report_ms: u64 = STALL_REPORT_MS;
            loop {
                if (finished >= n_runnable) { break; }
                match (rx.try_recv()) {
                    Result::Ok(mut ev) => {
                        match (ev.kind) {
                            WorkerEventKind::Started => {
                                in_flight.set(ev.idx, true);
                                n_in_flight = n_in_flight + 1;
                            }
                            WorkerEventKind::Finished => {
                                in_flight.set(ev.idx, false);
                                if (n_in_flight > 0u64) {
                                    n_in_flight = n_in_flight - 1;
                                }
                                const d: TestDescriptor = this.descriptors[ev.idx];
                                const outcome: TestOutcome = ev.outcome;
                                const failed: boolean = is_failure(outcome);
                                this.report_live_finish(d.name, outcome, d.should_panic);
                                if (this.should_show(failed) && ev.captured.length() > 0u64) {
                                    this.report_output(d.name, &ev.captured);
                                }
                                if (failed) {
                                    this.counts.failed = this.counts.failed + 1;
                                } else {
                                    this.counts.passed = this.counts.passed + 1;
                                }
                                finished = finished + 1;
                            }
                        }
                        ev.drop();
                        // Progress: clear the idle timer and re-arm the report.
                        idle_ms = 0u64;
                        next_report_ms = STALL_REPORT_MS;
                    }
                    Result::Err(e) => {
                        match (e) {
                            // All senders dropped before every result arrived:
                            // workers are gone, nothing more is coming.
                            TryRecvError::Disconnected => { break; }
                            TryRecvError::Empty => {
                                idle_ms = idle_ms + STALL_POLL_MS;
                                if (n_in_flight > 0u64 && idle_ms >= next_report_ms) {
                                    print_in_flight(this.descriptors, this.count,
                                        &in_flight, n_in_flight, idle_ms / 1000u64);
                                    next_report_ms = next_report_ms + STALL_REPORT_MS;
                                }
                                thread::sleep_ms(STALL_POLL_MS);
                            }
                        }
                    }
                }
            }

            scope.join_all();
        }

        in_flight.drop();
        runnable.drop();
    }

    /// Print the framed run header.
    print_header(&this, jobs: u32, to_run: u64, parallel: boolean) -> void {
        intrinsics::printf("\n%s\n", RULE_HEAVY);
        if (to_run == 1) {
            intrinsics::printf("  CRYO TESTS  /  unit  --  running 1 test\n");
        } else if (parallel) {
            intrinsics::printf("  CRYO TESTS  /  unit  --  running %llu tests on %u threads (live, completion order)\n",
                to_run, jobs);
        } else {
            intrinsics::printf("  CRYO TESTS  /  unit  --  running %llu tests\n", to_run);
        }
        intrinsics::printf("%s\n\n", RULE_HEAVY);
    }

    /// Print the framed trailing summary block.
    print_summary(&this) -> void {
        const verdict: string = if (this.counts.failed == 0) { "PASS" } else { "FAIL" };
        intrinsics::printf("\n%s\n", RULE_HEAVY);
        intrinsics::printf("  unit test summary\n");
        intrinsics::printf("%s\n", RULE_THIN);
        intrinsics::printf("    %-9s%6llu\n", "passed",   this.counts.passed);
        intrinsics::printf("    %-9s%6llu\n", "failed",   this.counts.failed);
        intrinsics::printf("    %-9s%6llu\n", "ignored",  this.counts.ignored);
        intrinsics::printf("    %-9s%6llu\n", "filtered", this.counts.filtered);
        intrinsics::printf("%s\n", RULE_THIN);
        if (this.opts.color_active && this.counts.failed == 0) {
            intrinsics::printf("    result   %s%s%s\n", ANSI_GREEN, verdict, ANSI_RESET);
        } else if (this.opts.color_active && this.counts.failed > 0) {
            intrinsics::printf("    result   %s%s%s\n", ANSI_RED, verdict, ANSI_RESET);
        } else {
            intrinsics::printf("    result   %s\n", verdict);
        }
        intrinsics::printf("%s\n", RULE_HEAVY);
    }

    /// Drive the whole suite: resolve the worker count, honour `--list`,
    /// print the header, run (sequential or parallel), finalize the
    /// reporter, and print the summary. Returns the process exit code.
    run(mut &this) -> i32 {
        // Resolve the worker count: explicit `--jobs`/`CRYO_TEST_JOBS`, else
        // the online CPU count. Clamp to at least 1.
        mut jobs: u32 = this.opts.jobs;
        if (jobs == 0u32) { jobs = num_cpus(); }
        if (jobs == 0u32) { jobs = 1u32; }

        // Pre-pass: count how many descriptors match the filter so the
        // `running N tests` header is honest.
        mut to_run: u64 = 0;
        mut i: u64 = 0;
        while (i < this.count) {
            const d: TestDescriptor = this.descriptors[i];
            if (name_matches(d.name, &this.opts)) {
                to_run = to_run + 1;
            }
            i = i + 1;
        }

        if (this.opts.list_only) {
            // `--list`: print names, exit 0. No runs, no header.
            this.list();
            return 0;
        }

        // A worker pool only pays off with more than one test to spread.
        const parallel: boolean = jobs > 1u32 && to_run > 1u64;

        this.print_header(jobs, to_run, parallel);

        if (parallel) {
            this.run_parallel(jobs, to_run);
        } else {
            this.run_sequential();
        }
        // Compact mode: flush the last in-flight group line. Plain/Pretty
        // are no-ops here.
        this.report_finalize();

        this.print_summary();
        return if (this.counts.failed == 0) { 0 } else { 1 };
    }
}

implement trait Drop for struct TestRunner {
    drop(mut &this) -> void {
        this.rstate.drop();
        this.opts.drop();
    }
}

// Entry point: called by the compiler-synthesized test main

/// Run every test in `descriptors` that matches `argc/argv` filtering,
/// printing cargo-style output. Returns 0 if every selected test
/// passed; 1 otherwise.
///
/// `descriptors` is a static array baked into the executable by the
/// compiler's `TestMainCodegen` pass. `count` is the number of entries.
/// Both must be valid for the duration of the call. This free function
/// keeps the exact signature the compiler synthesizes a call to; it
/// constructs a `TestRunner` and delegates.
function run_all(argc: i32, argv: u8**,
                 descriptors: TestDescriptor*, count: u64) -> i32 {
    mut opts: RunOptions = parse_options(argc, argv);
    // Pin color decision now so reporters don't re-evaluate per test.
    opts.color_active = resolve_color_active(&opts);

    // Re-exec child path: run only the selected test and exit 0/1, with no
    // header or driver loop.  The parent process classifies the exit code.
    // (Both POSIX fork+execv and Windows CreateProcess re-exec land here.)
    if (opts.child_idx >= 0) {
        return run_child_single(opts.child_idx as u64, descriptors, count,
                                opts.timeout_secs);
    }

    mut runner: TestRunner = TestRunner::new(opts, descriptors, count);
    return runner.run();
}
