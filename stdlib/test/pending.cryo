///! `PendingThenReady<T>`: a test's future that is pending a set number of
///! times and then ready, to drive the suspend and resume paths of async code
///! without any I/O or threads.

namespace std::test::pending;

import std::core::option::{ Option };
import std::future::poll::{ Poll };
import std::future::waker::{ Context };
import std::future::traits::{ Future };
import std::core::intrinsics;

/// A future that reports `Pending` for its first `pending_count` polls and then
/// completes with `value`. Exercises the suspend/resume path end-to-end under a
/// driver without any I/O or threads.
public type struct PendingThenReady<T> {
    private remaining: u32;
    private value:     Option<T>;

    /// A future that returns `Pending` from its first `pending_count` polls
    /// and completes with `value` on the next; a `pending_count` of 0 makes
    /// it ready at once. Its `Pending` polls do not wake the context's waker,
    /// so it completes only under a driver that polls again unprompted.
    public static new(pending_count: u32, value: T) -> PendingThenReady<T> {
        return PendingThenReady::<T> { remaining: pending_count, value: Option::Some(value) };
    }
}

implement<T> trait Future<T> for struct PendingThenReady<T> {
    poll(mut &this, cx: Context*) -> Poll<T> {
        if (this.remaining > 0) {
            this.remaining = this.remaining - 1;
            return Poll::Pending;
        }
        match (this.value.take()) {
            Option::Some(v) => { return Poll::Ready(v); }
            Option::None    => { panic("test::PendingThenReady polled after completion", intrinsics::location()); }
        }
    }
}
