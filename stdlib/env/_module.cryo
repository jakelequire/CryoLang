///! env — process environment and arguments.
///!
///! `args()` returns the argv the process was launched with; `var`
///! and `set_var` read and write environment variables; `exit`
///! terminates the process with a status code.
///!
///! Argv comes from the C runtime. We expose a `raw_argc`/`raw_argv`
///! intrinsic pair — cryoc wires these to the actual
///! `main(argc, argv)` it generates. Until that wiring is established,
///! `args()` returns an empty array rather than lying about what's
///! present.

namespace std::env;

import core::intrinsics;
import core::option;
import core::result;
import core::slice;
import collections::array;
import collections::str;
import collections::string;
import ffi::cstr;
import ffi::libc;

/// Filled in by the C runtime before `main` runs. These are weak
/// defaults; cryoc overrides them with the real argv/argc when it
/// emits `main`.
mut argc_global: i32 = 0;
mut argv_global: u8** = null;

/// Called by the generated `main` entry point to publish argv/argc.
/// Ordinary code should never call this.
function set_args(argc: i32, argv: u8**) -> void {
    argc_global = argc;
    argv_global = argv;
}

/// Program arguments as UTF-8 strings. The first element is the
/// program name. Returns an empty array if the runtime hasn't
/// published argv yet. Panics on allocation failure.
function args() -> Array<String> {
    mut out: Array<String> = Array::new();
    if (argv_global == null) { return out; }
    mut i: i32 = 0;
    while (i < argc_global) {
        const raw: u8* = argv_global[i as u64];
        if (raw == null) { break; }
        const view: CStr = CStr::from_ptr(raw);
        out.push(String::from_str(view.to_str_lossy()));
        i++;
    }
    return out;
}

/// Read the environment variable `name`. Returns `None` if unset.
/// The returned `String` owns a copy of the value.
function var(name: Str) -> Option<String> {
    match (CString::from_str(name)) {
        Result::Ok(c_name) => {
            mut c_local: CString = c_name;
            const raw: u8* = libc::getenv(c_local.as_ptr());
            if (raw == null) { return Option::None; }
            const view: CStr = CStr::from_ptr(raw);
            return Option::Some(String::from_str(view.to_str_lossy()));
        }
        Result::Err(_) => {
            // `name` contained an interior NUL — the env var can't
            // exist by that name. Treat as "not set".
            return Option::None;
        }
    }
}

/// Set `name = value`, overwriting any existing binding. Returns
/// `true` if the underlying call succeeded.
function set_var(name: Str, value: Str) -> boolean {
    match (CString::from_str(name)) {
        Result::Ok(c_name) => {
            mut n: CString = c_name;
            match (CString::from_str(value)) {
                Result::Ok(c_value) => {
                    mut v: CString = c_value;
                    const rc: i32 = libc::setenv(n.as_ptr(), v.as_ptr(), 1);
                    return rc == 0;
                }
                Result::Err(_) => {
                    return false;
                }
            }
        }
        Result::Err(_) => { return false; }
    }
}

function remove_var(name: Str) -> boolean {
    match (CString::from_str(name)) {
        Result::Ok(c_name) => {
            mut n: CString = c_name;
            const rc: i32 = libc::unsetenv(n.as_ptr());
            return rc == 0;
        }
        Result::Err(_) => { return false; }
    }
}

/// Exit the process with `code`. Does not return — anything written
/// to an unflushed buffered writer is lost unless the writer was
/// explicitly flushed first.
function process_exit(code: i32) -> void {
    libc::exit(code);
}
