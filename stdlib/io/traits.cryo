///! Read / Write: the two traits every byte sink or source
///! implements.
///!
///! Both report failure as `Result<_, IoError>`. The byte count in
///! `read` / `write_some` is the number actually transferred: fewer
///! than requested is normal (a partial read at EOF, a partial write
///! due to a full pipe). Callers that need an all-or-nothing transfer
///! use `write` / `read_exact`, which loop internally.
///!
///! The default methods here (`read_all`, `read_exact`, `read_line`,
///! `read_to_end`, `write`) are written once against the required
///! `read` / `write_some` so every sink or source inherits them for
///! free. `write` is generic over the payload (`Slice<u8>` / `Str` /
///! C-`string` / `u8`), dispatched at compile time with `static match`.

namespace std::io::traits;

import core::intrinsics;
import core::option;
import core::result;
import core::slice;
import io::error;
import collections::str;
import collections::string;
import collections::array;
import alloc::allocator;

/// Initial capacity bump for `read_to_end` when the caller hasn't
/// pre-reserved. Large enough that a one-call read from a small file
/// doesn't grow; small enough that tiny reads don't over-commit.
const READ_TO_END_CHUNK: u64 = 4096;

/// ASCII line feed. Terminator for `read_line`.
const BYTE_LF: u8 = 0x0A;

type trait Read {
    /// Fill up to `length` bytes starting at `buffer`. Returns the
    /// number of bytes actually read. Zero means EOF; a value less
    /// than `length` means the underlying source had no more bytes
    /// available at this moment (not necessarily EOF; callers decide
    /// whether to retry).
    read(mut &this, buffer: u8*, length: u64) -> Result<u64, IoError>;

    /// Read until the buffer is full or the source returns 0 (EOF).
    /// Returns the total bytes read; short returns mean EOF reached.
    /// Retries on `Interrupted`.
    read_all(mut &this, buffer: u8*, length: u64) -> Result<u64, IoError> {
        mut total: u64 = 0;
        while (total < length) {
            match (this.read(buffer + total, length - total)) {
                Result::Ok(n) => {
                    if (n == 0) { return Result::Ok(total); }
                    total = total + n;
                }
                Result::Err(err) => {
                    match (err.kind) {
                        IoErrorKind::Interrupted => { }
                        _ => { return Result::Err(err); }
                    }
                }
            }
        }
        return Result::Ok(total);
    }

    /// Read a single byte. `None` means EOF: the source is empty
    /// and no more reads will yield data. Retries on `Interrupted`.
    read_byte(mut &this) -> Result<Option<u8>, IoError> {
        mut byte: u8 = 0;
        loop {
            match (this.read(&byte, 1)) {
                Result::Ok(n) => {
                    if (n == 0) { return Result::Ok(Option::None); }
                    return Result::Ok(Option::Some(byte));
                }
                Result::Err(err) => {
                    match (err.kind) {
                        IoErrorKind::Interrupted => { }
                        _ => { return Result::Err(err); }
                    }
                }
            }
        }
    }

    /// Read a single UTF-8 Unicode scalar and return its codepoint.
    /// `None` is EOF before the first byte of the scalar. A partial
    /// scalar (first byte read, continuation missing) fails with
    /// `UnexpectedEof`; a malformed leading byte or continuation
    /// fails with `InvalidData`. Surrogates (0xD800..=0xDFFF)
    /// likewise fail with `InvalidData`; they are not valid Unicode
    /// scalars.
    read_char(mut &this) -> Result<Option<u32>, IoError> {
        mut lead: u8 = 0;
        const maybe: Option<u8> = this.read_byte()?;
        match (maybe) {
            Option::None => { return Result::Ok(Option::None); }
            Option::Some(byte) => { lead = byte; }
        }

        // ASCII fast path.
        if (lead < 0x80) {
            return Result::Ok(Option::Some(lead as u32));
        }

        // Decide continuation count and starting scalar bits from
        // the leading byte's high prefix.
        mut needed: u64 = 0;
        mut scalar: u32 = 0;
        if ((lead & 0xE0) == 0xC0) {
            needed = 1;
            scalar = (lead & 0x1F) as u32;
        } else if ((lead & 0xF0) == 0xE0) {
            needed = 2;
            scalar = (lead & 0x0F) as u32;
        } else if ((lead & 0xF8) == 0xF0) {
            needed = 3;
            scalar = (lead & 0x07) as u32;
        } else {
            // 10xxxxxx (orphan continuation) or 11111xxx (out of range).
            return Result::Err(IoError::new(IoErrorKind::InvalidData, 0));
        }

        mut continuation: u8[3];
        this.read_exact(&continuation[0], needed)?;
        mut i: u64 = 0;
        while (i < needed) {
            const byte: u8 = continuation[i];
            if ((byte & 0xC0) != 0x80) {
                return Result::Err(IoError::new(IoErrorKind::InvalidData, 0));
            }
            scalar = (scalar << 6) | ((byte & 0x3F) as u32);
            i++;
        }

        // Reject surrogates and values above the Unicode range.
        if (scalar >= 0xD800 && scalar <= 0xDFFF) {
            return Result::Err(IoError::new(IoErrorKind::InvalidData, 0));
        }
        if (scalar > 0x10FFFF) {
            return Result::Err(IoError::new(IoErrorKind::InvalidData, 0));
        }
        return Result::Ok(Option::Some(scalar));
    }

    /// Read bytes into `out` until `delimiter` is seen or EOF. The
    /// delimiter byte is included in `out`. Returns the number of
    /// bytes appended.
    ///
    /// Byte-level; the loop runs `read(..., 1)` so the stop point is
    /// precise. Use `BufReader::read_until` for a fast-path version
    /// over a buffered source.
    read_until(mut &this, delimiter: u8, out: mut &Array<u8>) -> Result<u64, IoError> {
        const start: u64 = out.length();
        loop {
            const maybe: Option<u8> = this.read_byte()?;
            match (maybe) {
                Option::None => { return Result::Ok(out.length() - start); }
                Option::Some(byte) => {
                    match (out.try_push(byte)) {
                        Result::Ok(_) => { }
                        Result::Err(_) => {
                            return Result::Err(IoError::new(IoErrorKind::OutOfMemory, 0));
                        }
                    }
                    if (byte == delimiter) {
                        return Result::Ok(out.length() - start);
                    }
                }
            }
        }
    }

    /// Read exactly `length` bytes. A short read at EOF is a failure,
    /// reported as `UnexpectedEof`. Use this when the caller knows the
    /// precise number of bytes that must be present.
    read_exact(mut &this, buffer: u8*, length: u64) -> Result<(), IoError> {
        const n: u64 = this.read_all(buffer, length)?;
        if (n < length) {
            return Result::Err(IoError::new(IoErrorKind::UnexpectedEof, 0));
        }
        return Result::Ok(());
    }

    /// Read every remaining byte into `out`, growing the array as
    /// needed. Returns the number of bytes appended. EOF terminates
    /// the loop; other errors abort and surface.
    ///
    /// Unbounded: a pathological source (e.g., `/dev/zero`) will
    /// exhaust memory. Callers that need a ceiling wrap the source in
    /// a limiting adapter or cap `out.capacity()` before calling.
    read_to_end(mut &this, out: mut &Array<u8>) -> Result<u64, IoError> {
        const start: u64 = out.length();
        mut scratch: u8[READ_TO_END_CHUNK];
        loop {
            match (this.read(&scratch[0], READ_TO_END_CHUNK)) {
                Result::Ok(n) => {
                    if (n == 0) {
                        return Result::Ok(out.length() - start);
                    }
                    match (out.try_append(Slice<u8>::from_raw(&scratch[0], n))) {
                        Result::Ok(_) => { }
                        Result::Err(_) => {
                            return Result::Err(IoError::new(IoErrorKind::OutOfMemory, 0));
                        }
                    }
                }
                Result::Err(err) => {
                    match (err.kind) {
                        IoErrorKind::Interrupted => { }
                        _ => { return Result::Err(err); }
                    }
                }
            }
        }
    }

    /// Read every remaining byte into `out` as UTF-8. Convenience
    /// wrapper around `read_to_end` for the common "slurp text from
    /// this source" case. The bytes are **not** validated; the
    /// caller certifies the source is UTF-8 (or accepts the
    /// consequences of invalid continuation bytes in a `String`).
    read_to_string(mut &this, out: mut &String) -> Result<u64, IoError> {
        mut scratch: u8[READ_TO_END_CHUNK];
        mut total: u64 = 0;
        loop {
            match (this.read(&scratch[0], READ_TO_END_CHUNK)) {
                Result::Ok(n) => {
                    if (n == 0) { return Result::Ok(total); }
                    match (out.try_push(Str::from_raw(&scratch[0], n))) {
                        Result::Ok(_) => { }
                        Result::Err(_) => {
                            return Result::Err(IoError::new(IoErrorKind::OutOfMemory, 0));
                        }
                    }
                    total = total + n;
                }
                Result::Err(err) => {
                    match (err.kind) {
                        IoErrorKind::Interrupted => { }
                        _ => { return Result::Err(err); }
                    }
                }
            }
        }
    }

    /// Read bytes into `out` until a `\n` or EOF. The newline byte is
    /// included in `out`. Returns the number of bytes appended (0 only
    /// if the very first read hit EOF).
    ///
    /// **Byte-level**, not UTF-8-aware: the loop runs `read(..., 1)` so
    /// the boundary check is precise. Sources that are expensive to
    /// byte-read (sockets, files) should be wrapped in `BufReader`
    /// from `io::buf`; its `read_line` override is the fast path.
    read_line(mut &this, out: mut &String) -> Result<u64, IoError> {
        const start: u64 = out.length();
        mut byte: u8 = 0;
        loop {
            match (this.read(&byte, 1)) {
                Result::Ok(n) => {
                    if (n == 0) { return Result::Ok(out.length() - start); }
                    // Append the RAW byte: `try_push(u8)` would format it as
                    // decimal text (that arm is for numeric display), which is
                    // never what a byte-level line reader wants.
                    match (out.try_push_byte(byte)) {
                        Result::Ok(_) => { }
                        Result::Err(_) => {
                            return Result::Err(IoError::new(IoErrorKind::OutOfMemory, 0));
                        }
                    }
                    if (byte == BYTE_LF) {
                        return Result::Ok(out.length() - start);
                    }
                }
                Result::Err(err) => {
                    match (err.kind) {
                        IoErrorKind::Interrupted => { }
                        _ => { return Result::Err(err); }
                    }
                }
            }
        }
    }
}

type trait Write {
    /// Low-level primitive: write up to `bytes.length()` bytes, returning
    /// the number actually written (may be less than requested on a slow
    /// sink). Every implementor provides this; the generic `write` loops
    /// over it to deliver every byte.
    write_some(mut &this, bytes: Slice<u8>) -> Result<u64, IoError>;

    /// Push any buffered bytes to the underlying sink. Unbuffered
    /// writers override with a no-op.
    flush(mut &this) -> Result<(), IoError>;

    /// Write `data` in full, retrying short writes and `Interrupted`
    /// errors. Generic over the payload, dispatched at compile time via
    /// `static match`: a raw byte `Slice<u8>`, a `Str` view, a
    /// NUL-terminated C `string`, or a single `u8`. Fails with `WriteZero`
    /// if the sink repeatedly refuses progress; better to surface that
    /// than spin.
    write<T>(mut &this, data: T) -> Result<(), IoError> {
        mut remaining: Slice<u8> = static match (T) {
            Slice<u8> => { data }
            Str       => { data.as_bytes() }
            string    => { Str::new(data).as_bytes() }
            u8        => { Slice<u8>::from_raw(&data, 1) }
        };
        while (!remaining.is_empty()) {
            match (this.write_some(remaining)) {
                Result::Ok(n) => {
                    if (n == 0) {
                        return Result::Err(IoError::new(IoErrorKind::WriteZero, 0));
                    }
                    remaining = remaining.subslice(n, remaining.length());
                }
                Result::Err(err) => {
                    match (err.kind) {
                        IoErrorKind::Interrupted => { }
                        _ => { return Result::Err(err); }
                    }
                }
            }
        }
        return Result::Ok(());
    }
}
