///! IoError: the failure kind for every fallible I/O operation.
///!
///! Modeled as an enum with a small closed set of kinds because
///! callers mostly branch on the kind, not the text. A free-form
///! `Other` variant exists for platform-specific errors that don't
///! fit the taxonomy.
///!
///! An error from an operation that named a path carries that path, so a
///! report reads `not found: config.toml` rather than a bare kind. The
///! path is owned, which makes `IoError` a value that moves.
///!
///! The errno table is per-OS gated. `from_errno` is fed msvcrt's C-runtime
///! errno on Windows (file/process I/O) and glibc errno on Linux; the base
///! codes (1-34) are identical on both, but the socket-range codes differ
///! (e.g. EADDRINUSE is 98 on glibc, 100 on msvcrt), so those are gated.
///! `from_windows_error` maps a Windows system error code, and
///! `last_os_error` reads the calling thread's last error from whichever
///! of the two the OS keeps. `from_wsa` maps a Winsock error code, which
///! Windows reports for sockets apart from `GetLastError`.
///! macOS/BSD are out of scope.

namespace std::io::error;

import std::core::option::{ Option };
import std::collections::str;
import std::core::convert::{ From };
import std::alloc::allocator::{ AllocError };
import std::fs::path::{ Path, PathBuf };
import std::ffi::libc;
import std::sys::syscall;

// errno constants shared by Linux glibc and Windows msvcrt (identical values).
private const ENOENT:        i32 = 2;
private const EINTR:         i32 = 4;
private const EIO:           i32 = 5;
private const EBADF:         i32 = 9;
private const EAGAIN:        i32 = 11; // same value as EWOULDBLOCK on Linux
private const ENOMEM:        i32 = 12;
private const EACCES:        i32 = 13;
private const EEXIST:        i32 = 17;
private const ENOTDIR:       i32 = 20;
private const EISDIR:        i32 = 21;
private const EINVAL:        i32 = 22;
private const ENOSPC:        i32 = 28;
private const EROFS:         i32 = 30;
private const EPIPE:         i32 = 32;

// Socket-range codes and ENOTEMPTY: glibc and msvcrt assign different
// numbers. Gated so each target maps its own values to the right
// `IoErrorKind`.
![target(linux)]
private const ENOTEMPTY:     i32 = 39;
![target(linux)]
private const EADDRINUSE:    i32 = 98;
![target(linux)]
private const EADDRNOTAVAIL: i32 = 99;
![target(linux)]
private const ECONNABORTED:  i32 = 103;
![target(linux)]
private const ECONNRESET:    i32 = 104;
![target(linux)]
private const ENOTCONN:      i32 = 107;
![target(linux)]
private const ETIMEDOUT:     i32 = 110;
![target(linux)]
private const ECONNREFUSED:  i32 = 111;

![target(windows)]
private const ENOTEMPTY:     i32 = 41;
![target(windows)]
private const EADDRINUSE:    i32 = 100;
![target(windows)]
private const EADDRNOTAVAIL: i32 = 101;
![target(windows)]
private const ECONNABORTED:  i32 = 106;
![target(windows)]
private const ECONNRESET:    i32 = 108;
![target(windows)]
private const ENOTCONN:      i32 = 128;
![target(windows)]
private const ETIMEDOUT:     i32 = 138;
![target(windows)]
private const ECONNREFUSED:  i32 = 107;

public type enum IoErrorKind {
    NotFound;
    PermissionDenied;
    AlreadyExists;
    /// A path component that had to be a directory is not one.
    NotADirectory;
    /// A directory was named where a file was wanted.
    IsADirectory;
    /// A directory to be removed still has entries.
    DirectoryNotEmpty;
    /// The device or volume has no space left.
    StorageFull;
    /// The filesystem is mounted, or the medium is, read-only.
    ReadOnlyFilesystem;
    /// The file descriptor or handle names no open file.
    InvalidDescriptor;
    ConnectionRefused;
    ConnectionReset;
    ConnectionAborted;
    NotConnected;
    AddrInUse;
    AddrNotAvailable;
    BrokenPipe;
    Interrupted;
    InvalidInput;
    /// The bytes do not have the form the operation needs, such as text
    /// that is not UTF-8.
    InvalidData;
    TimedOut;
    WriteZero;
    UnexpectedEof;
    WouldBlock;
    OutOfMemory;
    /// The operation is recognized but not implemented on this build
    /// (e.g. a feature stubbed pending implementation, or a platform
    /// the stdlib doesn't support yet).  Distinct from `InvalidInput`
    /// (caller's fault) and `Other` (unmapped errno).
    Unsupported;
    /// A platform-specific errno that doesn't map to any of the above.
    /// `os_code` is the authoritative detail.
    Other;
}

implement enum IoErrorKind {
    /// Short, stable diagnostic slug: `"not_found"`, `"permission_denied"`,
    /// etc. Mirrors `JsonErrorKind::label`. Returns a static string literal
    /// (no allocation, nothing to drop).
    public label(&this) -> string {
        return match (this) {
            IoErrorKind::NotFound           => { "not_found"            }
            IoErrorKind::PermissionDenied   => { "permission_denied"    }
            IoErrorKind::AlreadyExists      => { "already_exists"       }
            IoErrorKind::NotADirectory      => { "not_a_directory"      }
            IoErrorKind::IsADirectory       => { "is_a_directory"       }
            IoErrorKind::DirectoryNotEmpty  => { "directory_not_empty"  }
            IoErrorKind::StorageFull        => { "storage_full"         }
            IoErrorKind::ReadOnlyFilesystem => { "read_only_filesystem" }
            IoErrorKind::InvalidDescriptor  => { "invalid_descriptor"   }
            IoErrorKind::ConnectionRefused  => { "connection_refused"   }
            IoErrorKind::ConnectionReset    => { "connection_reset"     }
            IoErrorKind::ConnectionAborted  => { "connection_aborted"   }
            IoErrorKind::NotConnected       => { "not_connected"        }
            IoErrorKind::AddrInUse          => { "addr_in_use"          }
            IoErrorKind::AddrNotAvailable   => { "addr_not_available"   }
            IoErrorKind::BrokenPipe         => { "broken_pipe"          }
            IoErrorKind::Interrupted        => { "interrupted"          }
            IoErrorKind::InvalidInput       => { "invalid_input"        }
            IoErrorKind::InvalidData        => { "invalid_data"         }
            IoErrorKind::TimedOut           => { "timed_out"            }
            IoErrorKind::WriteZero          => { "write_zero"           }
            IoErrorKind::UnexpectedEof      => { "unexpected_eof"       }
            IoErrorKind::WouldBlock         => { "would_block"          }
            IoErrorKind::OutOfMemory        => { "out_of_memory"        }
            IoErrorKind::Unsupported        => { "unsupported"          }
            IoErrorKind::Other              => { "other"                }
        };
    }

    /// What went wrong, as a phrase a person reads: `"not found"`,
    /// `"permission denied"`. A static string literal.
    public description(&this) -> string {
        return match (this) {
            IoErrorKind::NotFound           => { "not found"                         }
            IoErrorKind::PermissionDenied   => { "permission denied"                 }
            IoErrorKind::AlreadyExists      => { "already exists"                    }
            IoErrorKind::NotADirectory      => { "not a directory"                   }
            IoErrorKind::IsADirectory       => { "is a directory"                    }
            IoErrorKind::DirectoryNotEmpty  => { "directory not empty"               }
            IoErrorKind::StorageFull        => { "no space left on the device"       }
            IoErrorKind::ReadOnlyFilesystem => { "read-only filesystem"              }
            IoErrorKind::InvalidDescriptor  => { "invalid file descriptor"           }
            IoErrorKind::ConnectionRefused  => { "connection refused"                }
            IoErrorKind::ConnectionReset    => { "connection reset"                  }
            IoErrorKind::ConnectionAborted  => { "connection aborted"                }
            IoErrorKind::NotConnected       => { "not connected"                     }
            IoErrorKind::AddrInUse          => { "address in use"                    }
            IoErrorKind::AddrNotAvailable   => { "address not available"             }
            IoErrorKind::BrokenPipe         => { "broken pipe"                       }
            IoErrorKind::Interrupted        => { "interrupted"                       }
            IoErrorKind::InvalidInput       => { "invalid input"                     }
            IoErrorKind::InvalidData        => { "invalid data"                      }
            IoErrorKind::TimedOut           => { "timed out"                         }
            IoErrorKind::WriteZero          => { "the sink accepted no bytes"        }
            IoErrorKind::UnexpectedEof      => { "unexpected end of file"            }
            IoErrorKind::WouldBlock         => { "the operation would block"         }
            IoErrorKind::OutOfMemory        => { "out of memory"                     }
            IoErrorKind::Unsupported        => { "unsupported"                       }
            IoErrorKind::Other              => { "operating system error"            }
        };
    }
}

public type struct IoError {
    public kind: IoErrorKind;
    /// The operating system's own code for the failure - an `errno`, or a
    /// Windows system error code - or 0 if not applicable. Useful for
    /// diagnostics; callers should branch on `kind`.
    public os_code: i32;
    private failed_path: Option<PathBuf>;

    public static new(kind: IoErrorKind, os_code: i32) -> IoError {
        return IoError { kind: kind, os_code: os_code, failed_path: Option::None };
    }

    /// What went wrong, as a borrowed `Str`: the kind's description
    /// (`"not found"`), without the path. This is the convergent accessor
    /// every stdlib error type exposes (`describe(&this) -> Str`). `Display`
    /// prints it followed by the path, when there is one. Borrows a static
    /// string literal, so the view outlives any `IoError`.
    public describe(&this) -> str::Str {
        return str::Str::new(this.kind.description());
    }

    /// The path the failed operation named, if it named one.
    public path(&this) -> Option<Path> {
        return match (this.failed_path.as_ref()) {
            Option::Some(owned) => { Option::Some(owned.as_path()) }
            Option::None        => { Option::None }
        };
    }

    /// This error, naming `path` as the one the operation failed on. An
    /// error that already names a path keeps it: the innermost operation
    /// knows best which path it could not reach.
    public with_path(mut this, path: Path) -> IoError {
        if (this.failed_path.is_none()) {
            this.failed_path = Option::Some(PathBuf::from(path.as_str()));
        }
        return this;
    }

    /// Map a POSIX `errno` to an `IoError`. Unknown codes fold to
    /// `Other` with the numeric code preserved in `os_code`.
    public static from_errno(code: i32) -> IoError {
        const kind: IoErrorKind = match (code) {
            ENOENT        => { IoErrorKind::NotFound }
            EINTR         => { IoErrorKind::Interrupted }
            EIO           => { IoErrorKind::Other }
            EBADF         => { IoErrorKind::InvalidDescriptor }
            EAGAIN        => { IoErrorKind::WouldBlock }
            ENOMEM        => { IoErrorKind::OutOfMemory }
            EACCES        => { IoErrorKind::PermissionDenied }
            EEXIST        => { IoErrorKind::AlreadyExists }
            ENOTDIR       => { IoErrorKind::NotADirectory }
            EISDIR        => { IoErrorKind::IsADirectory }
            EINVAL        => { IoErrorKind::InvalidInput }
            ENOSPC        => { IoErrorKind::StorageFull }
            EROFS         => { IoErrorKind::ReadOnlyFilesystem }
            EPIPE         => { IoErrorKind::BrokenPipe }
            ENOTEMPTY     => { IoErrorKind::DirectoryNotEmpty }
            EADDRINUSE    => { IoErrorKind::AddrInUse }
            EADDRNOTAVAIL => { IoErrorKind::AddrNotAvailable }
            ECONNABORTED  => { IoErrorKind::ConnectionAborted }
            ECONNRESET    => { IoErrorKind::ConnectionReset }
            ENOTCONN      => { IoErrorKind::NotConnected }
            ETIMEDOUT     => { IoErrorKind::TimedOut }
            ECONNREFUSED  => { IoErrorKind::ConnectionRefused }
            _             => { IoErrorKind::Other }
        };
        return IoError::new(kind, code);
    }

    /// Map a Windows system error code (what `GetLastError` reports) to
    /// an `IoError`. Unknown codes fold to `Other` with the code preserved
    /// in `os_code`. A pure mapping, available on every target.
    public static from_windows_error(code: u32) -> IoError {
        const kind: IoErrorKind = match (code) {
            syscall::ERROR_FILE_NOT_FOUND | syscall::ERROR_PATH_NOT_FOUND
                | syscall::ERROR_INVALID_NAME => { IoErrorKind::NotFound }
            syscall::ERROR_ACCESS_DENIED | syscall::ERROR_SHARING_VIOLATION => {
                IoErrorKind::PermissionDenied
            }
            syscall::ERROR_FILE_EXISTS | syscall::ERROR_ALREADY_EXISTS => {
                IoErrorKind::AlreadyExists
            }
            syscall::ERROR_DIRECTORY         => { IoErrorKind::NotADirectory }
            syscall::ERROR_DIR_NOT_EMPTY     => { IoErrorKind::DirectoryNotEmpty }
            syscall::ERROR_DISK_FULL | syscall::ERROR_HANDLE_DISK_FULL => {
                IoErrorKind::StorageFull
            }
            syscall::ERROR_WRITE_PROTECT     => { IoErrorKind::ReadOnlyFilesystem }
            syscall::ERROR_INVALID_HANDLE    => { IoErrorKind::InvalidDescriptor }
            syscall::ERROR_NOT_ENOUGH_MEMORY => { IoErrorKind::OutOfMemory }
            syscall::ERROR_INVALID_PARAMETER => { IoErrorKind::InvalidInput }
            syscall::ERROR_INVALID_DATA      => { IoErrorKind::InvalidData }
            syscall::ERROR_BROKEN_PIPE       => { IoErrorKind::BrokenPipe }
            syscall::ERROR_HANDLE_EOF        => { IoErrorKind::UnexpectedEof }
            syscall::ERROR_NOT_SUPPORTED     => { IoErrorKind::Unsupported }
            _                                => { IoErrorKind::Other }
        };
        return IoError::new(kind, code as i32);
    }

    /// Map a Winsock error code (what `WSAGetLastError`, or a socket's
    /// `SO_ERROR`, reports) to an `IoError`. Unknown codes fold to `Other`
    /// with the code preserved in `os_code`. A pure mapping, available on
    /// every target.
    public static from_wsa(code: i32) -> IoError {
        const kind: IoErrorKind = match (code) {
            syscall::WSAEWOULDBLOCK  => { IoErrorKind::WouldBlock }
            syscall::WSAEINTR        => { IoErrorKind::Interrupted }
            syscall::WSAECONNREFUSED => { IoErrorKind::ConnectionRefused }
            syscall::WSAECONNRESET   => { IoErrorKind::ConnectionReset }
            syscall::WSAECONNABORTED => { IoErrorKind::ConnectionAborted }
            syscall::WSAETIMEDOUT    => { IoErrorKind::TimedOut }
            syscall::WSAEADDRINUSE   => { IoErrorKind::AddrInUse }
            syscall::WSAENOTCONN     => { IoErrorKind::NotConnected }
            _                        => { IoErrorKind::Other }
        };
        return IoError::new(kind, code);
    }

    /// The calling thread's last operating-system error: `errno` on POSIX
    /// targets, `GetLastError` on Windows. Read it straight after the
    /// failing call, before anything else can overwrite it. A Windows
    /// C-runtime call reports through `errno` instead; map that with
    /// `from_errno`.
    ![target(unix)]
    public static last_os_error() -> IoError {
        return IoError::from_errno(libc::errno());
    }
    ![target(windows)]
    public static last_os_error() -> IoError {
        return IoError::from_windows_error(syscall::GetLastError());
    }
}

/// An allocation that failed inside an I/O operation (a buffer that could
/// not grow) is that operation's `OutOfMemory`.
implement trait From<AllocError> for struct IoError {
    static from(err: AllocError) -> IoError {
        return IoError::new(IoErrorKind::OutOfMemory, 0);
    }
}
