///! IoError: the failure kind for every fallible I/O operation.
///!
///! Modeled as an enum with a small closed set of kinds because
///! callers mostly branch on the kind, not the text. A free-form
///! `Other` variant exists for platform-specific errors that don't
///! fit the taxonomy.
///!
///! The errno table is per-OS gated. `from_errno` is fed msvcrt's C-runtime
///! errno on Windows (file/process I/O) and glibc errno on Linux; the base
///! codes (1-34) are identical on both, but the socket-range codes differ
///! (e.g. EADDRINUSE is 98 on glibc, 100 on msvcrt), so those are gated.
///! Socket errors on Windows do NOT pass through here - `net::sys` maps
///! `WSAGetLastError()` WSAE* codes directly. macOS/BSD are out of scope.

namespace std::io::error;

// errno constants shared by Linux glibc and Windows msvcrt (identical values).
const ENOENT:        i32 = 2;
const EINTR:         i32 = 4;
const EIO:           i32 = 5;
const EAGAIN:        i32 = 11; // same value as EWOULDBLOCK on Linux
const ENOMEM:        i32 = 12;
const EACCES:        i32 = 13;
const EEXIST:        i32 = 17;
const EINVAL:        i32 = 22;
const EPIPE:         i32 = 32;

// Socket-range codes: glibc and msvcrt assign different numbers. Gated so
// each target maps its own values to the right `IoErrorKind`.
![target(linux)]
const EADDRINUSE:    i32 = 98;
![target(linux)]
const EADDRNOTAVAIL: i32 = 99;
![target(linux)]
const ECONNABORTED:  i32 = 103;
![target(linux)]
const ECONNRESET:    i32 = 104;
![target(linux)]
const ENOTCONN:      i32 = 107;
![target(linux)]
const ETIMEDOUT:     i32 = 110;
![target(linux)]
const ECONNREFUSED:  i32 = 111;

![target(windows)]
const EADDRINUSE:    i32 = 100;
![target(windows)]
const EADDRNOTAVAIL: i32 = 101;
![target(windows)]
const ECONNABORTED:  i32 = 106;
![target(windows)]
const ECONNRESET:    i32 = 108;
![target(windows)]
const ENOTCONN:      i32 = 128;
![target(windows)]
const ETIMEDOUT:     i32 = 138;
![target(windows)]
const ECONNREFUSED:  i32 = 107;

type enum IoErrorKind {
    NotFound;
    PermissionDenied;
    AlreadyExists;
    ConnectionRefused;
    ConnectionReset;
    ConnectionAborted;
    NotConnected;
    AddrInUse;
    AddrNotAvailable;
    BrokenPipe;
    Interrupted;
    InvalidInput;
    InvalidData;
    TimedOut;
    WriteZero;
    UnexpectedEof;
    WouldBlock;
    OutOfMemory;
    /// The operation is recognized but not implemented on this build
    /// (e.g. a feature stubbed pending implementation, or a platform
    /// the stdlib doesn't support yet).  Distinct from `InvalidInput`
    /// (caller's fault) and `Other` (unmapped errno).
    Unsupported;
    /// A platform-specific errno that doesn't map to any of the above.
    /// `os_code` is the authoritative detail.
    Other;
}

implement enum IoErrorKind {
    /// Short, stable diagnostic slug: `"not_found"`, `"permission_denied"`,
    /// etc. Mirrors `JsonErrorKind::label`. Returns a static string literal
    /// (no allocation, nothing to drop).
    label(&this) -> string {
        return match (this) {
            IoErrorKind::NotFound          => { "not_found"           }
            IoErrorKind::PermissionDenied  => { "permission_denied"   }
            IoErrorKind::AlreadyExists     => { "already_exists"      }
            IoErrorKind::ConnectionRefused => { "connection_refused"  }
            IoErrorKind::ConnectionReset   => { "connection_reset"    }
            IoErrorKind::ConnectionAborted => { "connection_aborted"  }
            IoErrorKind::NotConnected      => { "not_connected"       }
            IoErrorKind::AddrInUse         => { "addr_in_use"         }
            IoErrorKind::AddrNotAvailable  => { "addr_not_available"  }
            IoErrorKind::BrokenPipe        => { "broken_pipe"         }
            IoErrorKind::Interrupted       => { "interrupted"         }
            IoErrorKind::InvalidInput      => { "invalid_input"       }
            IoErrorKind::InvalidData       => { "invalid_data"        }
            IoErrorKind::TimedOut          => { "timed_out"           }
            IoErrorKind::WriteZero         => { "write_zero"          }
            IoErrorKind::UnexpectedEof     => { "unexpected_eof"      }
            IoErrorKind::WouldBlock        => { "would_block"         }
            IoErrorKind::OutOfMemory       => { "out_of_memory"       }
            IoErrorKind::Unsupported       => { "unsupported"         }
            IoErrorKind::Other             => { "other"               }
        };
    }
}

type struct IoError {
    kind: IoErrorKind;
    /// `errno` from the underlying syscall, or 0 if not applicable.
    /// Useful for diagnostics; callers should branch on `kind`.
    os_code: i32;

    static new(kind: IoErrorKind, os_code: i32) -> IoError {
        return IoError { kind: kind, os_code: os_code };
    }

    /// Short, stable diagnostic slug for this error's kind (e.g.
    /// `"not_found"`). The numeric OS code lives in `os_code` for callers
    /// that want to print it alongside. Returns a static string literal.
    label(&this) -> string {
        return this.kind.label();
    }

    /// Map a POSIX `errno` to an `IoError`. Unknown codes fold to
    /// `Other` with the numeric code preserved in `os_code`.
    static from_errno(code: i32) -> IoError {
        return match (code) {
            ENOENT        => { IoError { kind: IoErrorKind::NotFound,          os_code: code } }
            EINTR         => { IoError { kind: IoErrorKind::Interrupted,       os_code: code } }
            EIO           => { IoError { kind: IoErrorKind::Other,             os_code: code } }
            EAGAIN        => { IoError { kind: IoErrorKind::WouldBlock,        os_code: code } }
            ENOMEM        => { IoError { kind: IoErrorKind::OutOfMemory,       os_code: code } }
            EACCES        => { IoError { kind: IoErrorKind::PermissionDenied,  os_code: code } }
            EEXIST        => { IoError { kind: IoErrorKind::AlreadyExists,     os_code: code } }
            EINVAL        => { IoError { kind: IoErrorKind::InvalidInput,      os_code: code } }
            EPIPE         => { IoError { kind: IoErrorKind::BrokenPipe,        os_code: code } }
            EADDRINUSE    => { IoError { kind: IoErrorKind::AddrInUse,         os_code: code } }
            EADDRNOTAVAIL => { IoError { kind: IoErrorKind::AddrNotAvailable,  os_code: code } }
            ECONNABORTED  => { IoError { kind: IoErrorKind::ConnectionAborted, os_code: code } }
            ECONNRESET    => { IoError { kind: IoErrorKind::ConnectionReset,   os_code: code } }
            ENOTCONN      => { IoError { kind: IoErrorKind::NotConnected,      os_code: code } }
            ETIMEDOUT     => { IoError { kind: IoErrorKind::TimedOut,          os_code: code } }
            ECONNREFUSED  => { IoError { kind: IoErrorKind::ConnectionRefused, os_code: code } }
            _             => { IoError { kind: IoErrorKind::Other,             os_code: code } }
        }
    }
}
