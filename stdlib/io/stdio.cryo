///! Standard streams: `stdin`, `stdout`, `stderr`.
///!
///! Three thin handles over POSIX file descriptors 0, 1, 2. Each
///! implements `Read` or `Write` (or both conceptually, in the case
///! of `/dev/tty`-backed terminal I/O), inheriting every default
///! method on those traits (`read_line`, `read_to_string`,
///! `read_to_end`, `write`, etc.) without repeat
///! boilerplate per handle.
///!
///! No buffering at this layer. `stdout()` and `stderr()` translate
///! to raw `write(2)` calls. Callers who want buffering compose it
///! explicitly:
///!
///! ```cryo
///! mut out: Stdout = stdout();
///! mut buffered: LineWriter<Stdout> = LineWriter::new(&out);
///! // ... use buffered ...
///! buffered.drop();  // flushes before releasing the heap buffer
///! ```
///!
///! That composition stays honest: the base types are cheap
///! (zero-sized, free to construct, free to copy) and the buffering
///! cost appears where it actually happens.
///!
///! # What lives on the handles vs. on `Read` / `Write`
///!
///! The handles add only the things that are genuinely
///! stdio-specific: `is_tty`, `as_fd`, and (on `Stdin`) the
///! interactive shortcuts `line` and `prompt`. Everything else
///! (`read_byte`, `read_char`, `read_until`, `read_line`,
///! `read_to_string`, `write`) lives
///! on the `Read` / `Write` traits as defaults, because `Stdin` is
///! not special in its byte-pumping behaviour. A `File` or a
///! `TcpStream` or a `BufReader` gets the same methods for free.
///!
///! # Locking
///!
///! Cryo now has threads (`std::thread`), so concurrent writers to the
///! same stream can interleave. The bare handles (`stdout()`, etc.)
///! issue one unsynchronized `write(2)`/`read(2)` per call and do NOT
///! serialize across threads.
///!
///! To order output from multiple threads, acquire a lock guard:
///!
///! ```cryo
///! mut out: StdoutLock = stdout().lock();   // blocks other lockers
///! out.write(part_a)?;
///! out.write(part_b)?;                   // a/b are adjacent
///! out.drop();                               // releases the lock
///! ```
///!
///! `Stdout::lock()`, `Stderr::lock()`, and `Stdin::lock()` each return
///! an RAII guard backed by a process-global mutex (one per stream, so
///! a blocking stdin read does not stall stdout writers). The guard
///! implements `Write` (`StdoutLock`/`StderrLock`) or `Read`
///! (`StdinLock`) and releases the lock on `drop`. A guard must be
///! dropped on the thread that created it (a POSIX mutex is unlocked by
///! its locking thread); do not move one across a thread boundary.
///! Locking only serializes other `lock()` callers — code mixing a bare
///! handle with a lock guard on the same stream is still unordered.

namespace std::io::stdio;

import core::intrinsics;
import core::option;
import core::result;
import core::slice;
import collections::str;
import collections::string;
import io::error;
import io::fd;
import io::traits;
import ffi::libc;
import ffi::syscall;

// FD constants

const STDIN_FD:  i32 = 0;
const STDOUT_FD: i32 = 1;
const STDERR_FD: i32 = 2;

// Process-global locks for the three standard streams.
//
// 40-byte buffer is `sizeof(pthread_mutex_t)` on Linux x86_64 (also
// matches `sync::mutex::MutexInner.pthread_buf`).  On Windows a
// `SRWLOCK` is one pointer (8 bytes), so the same buffer holds it
// with room to spare.  A zero-filled buffer is the valid initial
// state on BOTH platforms - `PTHREAD_MUTEX_INITIALIZER` and
// `SRWLOCK_INIT` are both all-zero - so the BSS-zeroed globals are
// ready to use without an explicit init call.
//
// Each stream has its own lock so that a thread blocked in a `Stdin`
// read does not stall `Stdout` writers. The locks guard only the
// `lock()`-based API; the bare handles still issue one unsynchronized
// `write(2)`/`WriteFile` per call (see the module doc).
mut g_stdin_lock:  u8[40];
mut g_stdout_lock: u8[40];
mut g_stderr_lock: u8[40];

// Per-OS lock/unlock helpers - the lock primitives differ between
// platforms and ConfigGating only handles file-scope declarations
// (not struct method bodies), so the divergence sits in free
// functions and the public `lock()` methods just delegate.

![target(unix)]
private function stream_lock(slot: u8*) -> void {
    if (libc::pthread_mutex_lock(slot) != 0) {
        intrinsics::panic("stdio: pthread_mutex_lock failed", FILE, LINE);
    }
}

![target(unix)]
private function stream_unlock(slot: u8*) -> void {
    libc::pthread_mutex_unlock(slot);
}

![target(windows)]
private function stream_lock(slot: u8*) -> void {
    syscall::AcquireSRWLockExclusive(slot);
}

![target(windows)]
private function stream_unlock(slot: u8*) -> void {
    syscall::ReleaseSRWLockExclusive(slot);
}

// Line-ending primitives

/// ASCII line feed byte. Emitted by every `println` path in the stdlib.
const LINE_FEED: u8 = 0x0A;

/// Single-byte newline slice. Callers use this for explicit
/// "terminate this line" writes without constructing a one-element
/// stack array at each site.
const NEWLINE_BYTES: u8* = "\n";
const NEWLINE: Str = Str::new("\n");

// is_tty: thin wrapper over intrinsics::isatty (which carries the
// Windows `_isatty` shim; the bare `libc::isatty` symbol has no msvcrt
// alias, so route through the intrinsic to stay cross-platform).

/// True if `fd` is a terminal. Used to choose line-buffered vs
/// block-buffered output, to enable ANSI color, or to gate
/// interactive prompts. `libc::isatty` returns 1 for terminals and 0
/// (with errno set) for everything else; we treat any non-1 as
/// "not a TTY" rather than surfacing the errno distinction.
function is_tty(fd: i32) -> boolean {
    return intrinsics::isatty(fd) == 1;
}

/// Handle to process standard input. Construction is free; all
/// instances dispatch to file descriptor 0. Unbuffered: a line
/// read that needs minimum syscalls should wrap this in a
/// `BufReader<Stdin>` from `io::buf`.
type struct Stdin {
    /// True if stdin is attached to a terminal. False when piped,
    /// redirected, or closed.
    is_tty(&this) -> boolean {
        return intrinsics::isatty(STDIN_FD) == 1;
    }

    /// Underlying file descriptor. Exposed for interop with code
    /// that still needs to pass fd 0 to a system call directly.
    as_fd(&this) -> i32 {
        return STDIN_FD as i32;
    }

    /// Acquire the process-global stdin lock, blocking until it is
    /// free. The returned `StdinLock` reads through fd 0 and releases
    /// the lock on `drop`. See the module doc for the ownership rules.
    lock(&this) -> StdinLock {
        stream_lock(&g_stdin_lock[0]);
        return StdinLock { };
    }

    /// Read one line of input and return it as an owned `String`
    /// with the trailing `\n` (and a preceding `\r`, if any)
    /// stripped. `None` means EOF before any bytes were read.
    ///
    /// This is the handle-level shortcut for the common "ask the
    /// user a thing" pattern; stripping newlines is what callers
    /// almost always want and forgetting to do so is a common bug.
    /// Callers who need the raw line go through the `Read` trait's
    /// `read_line` instead.
    line(mut &this) -> Result<Option<String>, IoError> {
        mut buffer: String = String::new();
        const n: u64 = this.read_line(&buffer)?;
        if (n == 0) {
            return Result::Ok(Option::None);
        }
        mut trimmed: u64 = buffer.length();
        if (trimmed > 0) {
            match (buffer.as_bytes().get(trimmed - 1)) {
                Option::Some(byte) => {
                    if (byte == 0x0A) {
                        trimmed = trimmed - 1;
                        if (trimmed > 0) {
                            match (buffer.as_bytes().get(trimmed - 1)) {
                                Option::Some(prev) => {
                                    if (prev == 0x0D) {
                                        trimmed = trimmed - 1;
                                    }
                                }
                                Option::None => { }
                            }
                        }
                    }
                }
                Option::None => { }
            }
        }
        buffer.truncate(trimmed);
        return Result::Ok(Option::Some(buffer));
    }

    /// Write `prompt_msg` to **stderr** and read one line from
    /// stdin, trailing newline stripped. The prompt goes to stderr
    /// (not stdout) so piping the program's output doesn't capture
    /// the prompt text, the convention every well-behaved CLI
    /// follows.
    ///
    /// `None` if the user closed stdin (Ctrl-D) before typing.
    prompt(mut &this, prompt_msg: Str) -> Result<Option<String>, IoError> {
        mut err_handle: Stderr = stderr();
        err_handle.write(prompt_msg.as_bytes())?;
        err_handle.flush()?;
        return this.line();
    }
}

/// Handle for process standard input.
function stdin() -> Stdin {
    return Stdin { };
}

implement trait Read for struct Stdin {
    read(mut &this, buffer: u8*, length: u64) -> Result<u64, IoError> {
        return fd::read_fd(STDIN_FD, buffer, length);
    }
}

/// Handle to process standard output. Unbuffered; wrap in
/// `LineWriter<Stdout>` or `BufWriter<Stdout>` from `io::buf` for
/// the common "coalesce many small writes" case.
type struct Stdout {
    is_tty(&this) -> boolean {
        return intrinsics::isatty(STDOUT_FD) == 1;
    }

    as_fd(&this) -> i32 {
        return STDOUT_FD as i32;
    }

    /// Acquire the process-global stdout lock, blocking until it is
    /// free. The returned `StdoutLock` writes through fd 1 and releases
    /// the lock on `drop`. See the module doc for the ownership rules.
    lock(&this) -> StdoutLock {
        stream_lock(&g_stdout_lock[0]);
        return StdoutLock { };
    }
}

function stdout() -> Stdout {
    return Stdout { };
}

implement trait Write for struct Stdout {
    write_some(mut &this, bytes: Slice<u8>) -> Result<u64, IoError> {
        return fd::write_fd(STDOUT_FD, bytes);
    }

    flush(mut &this) -> Result<(), IoError> {
        // `write(2)` is unbuffered at this layer. A buffered wrapper
        // is where `flush` does work.
        return Result::Ok(());
    }
}

/// Handle to process standard error. Unbuffered by convention so
/// diagnostics appear immediately; do **not** wrap in `BufWriter`
/// unless you also guarantee a flush on every path that might
/// panic or `exit`.
type struct Stderr {
    is_tty(&this) -> boolean {
        return intrinsics::isatty(STDERR_FD) == 1;
    }

    as_fd(&this) -> i32 {
        return STDERR_FD as i32;
    }

    /// Acquire the process-global stderr lock, blocking until it is
    /// free. The returned `StderrLock` writes through fd 2 and releases
    /// the lock on `drop`. See the module doc for the ownership rules.
    lock(&this) -> StderrLock {
        stream_lock(&g_stderr_lock[0]);
        return StderrLock { };
    }
}

function stderr() -> Stderr {
    return Stderr { };
}

implement trait Write for struct Stderr {
    write_some(mut &this, bytes: Slice<u8>) -> Result<u64, IoError> {
        return fd::write_fd(STDERR_FD, bytes);
    }

    flush(mut &this) -> Result<(), IoError> {
        return Result::Ok(());
    }
}

// Stream lock guards
//
// Each guard is a zero-field RAII token: it owns the process-global
// lock for one stream and releases it on `drop`. Because it carries a
// `Drop` impl it is move-only (never `Copy`), so the lock is released
// exactly once. Do not move a guard to another thread: a POSIX mutex
// must be unlocked by the thread that locked it.

/// RAII guard over the stdin lock; reads through fd 0. Get one from
/// `stdin().lock()`. Inherits the `Read` trait defaults (`read_line`,
/// `read_to_string`, ...).
type struct StdinLock { }

implement trait Read for struct StdinLock {
    read(mut &this, buffer: u8*, length: u64) -> Result<u64, IoError> {
        return fd::read_fd(STDIN_FD, buffer, length);
    }
}

implement trait Drop for struct StdinLock {
    drop(mut &this) -> void {
        stream_unlock(&g_stdin_lock[0]);
    }
}

/// RAII guard over the stdout lock; writes through fd 1. Get one from
/// `stdout().lock()`. Inherits the `Write` trait default `write` (generic
/// over the payload).
type struct StdoutLock { }

implement trait Write for struct StdoutLock {
    write_some(mut &this, bytes: Slice<u8>) -> Result<u64, IoError> {
        return fd::write_fd(STDOUT_FD, bytes);
    }

    flush(mut &this) -> Result<(), IoError> {
        return Result::Ok(());
    }
}

implement trait Drop for struct StdoutLock {
    drop(mut &this) -> void {
        stream_unlock(&g_stdout_lock[0]);
    }
}

/// RAII guard over the stderr lock; writes through fd 2. Get one from
/// `stderr().lock()`.
type struct StderrLock { }

implement trait Write for struct StderrLock {
    write_some(mut &this, bytes: Slice<u8>) -> Result<u64, IoError> {
        return fd::write_fd(STDERR_FD, bytes);
    }

    flush(mut &this) -> Result<(), IoError> {
        return Result::Ok(());
    }
}

implement trait Drop for struct StderrLock {
    drop(mut &this) -> void {
        stream_unlock(&g_stderr_lock[0]);
    }
}
