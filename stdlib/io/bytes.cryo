///! Fixed-width integers to and from bytes, in a stated byte order.
///!
///! `ByteReader` walks a borrowed `&Slice<u8>` front to back, decoding one
///! integer per call; a read that needs more bytes than remain fails with
///! `UnexpectedEof` and leaves the position where it was. `ByteWriter`
///! appends encoded integers to an `Array<u8>` it borrows, or writes them
///! into a fixed region it is given.
///!
///! Every method names its order in full - `big_endian` (most significant
///! byte first, the network order of the wire protocols) or
///! `little_endian` (least significant first) - so a call site says which
///! layout it reads or writes, whatever the host's own order is. The
///! integer type is the method's type argument, and its width is the
///! number of bytes: `reader.read_big_endian::<u32>()` takes 4,
///! `writer.write_little_endian::<u16>(port)` writes 2. A one-byte type
///! reads and writes the same either way. A signed type is written as its
///! two's-complement bytes and read back from them.
///!
///! ```cryo
///! mut out: Array<u8> = Array::new();
///! mut writer: ByteWriter = ByteWriter::new(&out);
///! writer.write_big_endian::<u16>(443);
///! writer.write_little_endian::<i32>(-2);
///!
///! mut reader: ByteReader = ByteReader::new(out.as_slice());
///! const port: u16 = reader.read_big_endian::<u16>()?;     // 443
///! const delta: i32 = reader.read_little_endian::<i32>()?; // -2
///! ```

namespace std::io::bytes;

import std::core::intrinsics;
import std::core::marker::{ Integer };
import std::core::result::{ Result };
import std::core::slice::{ Slice };
import std::collections::array::{ Array };
import std::io::error::{ IoError, IoErrorKind };

/// Decodes integers from a borrowed byte slice, advancing past each one.
public type struct ByteReader {
    private bytes: &Slice<u8>;
    private position: i64;

    /// A reader at the first byte of `bytes`. The slice is borrowed: its
    /// storage must outlive the reader.
    public static new(bytes: &Slice<u8>) -> ByteReader {
        return ByteReader { bytes: bytes, position: 0 };
    }

    /// The offset of the next byte a read takes.
    public position(&this) -> i64 {
        return this.position;
    }

    /// Move to the absolute offset `position`. An offset past the end is
    /// allowed, and every read from there fails; a negative one panics.
    public set_position(mut &this, position: i64) -> void {
        if (position < 0) {
            core::panic("ByteReader::set_position: out of range", intrinsics::location());
        }
        this.position = position;
    }

    /// The number of bytes left to read, 0 at or past the end.
    public remaining(&this) -> i64 {
        if (this.position >= this.bytes.length()) { return 0; }
        return this.bytes.length() - this.position;
    }

    /// The next `T`, most significant byte first: as many bytes as `T` is
    /// wide. Like every read here, it fails with `UnexpectedEof`, and does
    /// not move, when too few bytes remain.
    public read_big_endian<T>(mut &this) -> Result<T, IoError> where T: Integer {
        const value: u128 = this.read_bytes(ByteReader::width::<T>(), true)?;
        return Result::Ok(ByteReader::narrow::<T>(value));
    }

    /// The next `T`, least significant byte first: as many bytes as `T` is
    /// wide. Fails with `UnexpectedEof`, without moving, when too few
    /// bytes remain.
    public read_little_endian<T>(mut &this) -> Result<T, IoError> where T: Integer {
        const value: u128 = this.read_bytes(ByteReader::width::<T>(), false)?;
        return Result::Ok(ByteReader::narrow::<T>(value));
    }

    /// How many bytes a `T` takes.
    private static width<T>() -> i64 where T: Integer {
        return static match (T) {
            u8 | i8                    => { 1 }
            u16 | i16                  => { 2 }
            u32 | i32                  => { 4 }
            u64 | i64 | usize | isize  => { 8 }
            u128 | i128                => { 16 }
        };
    }

    /// The low bytes of `value` as a `T`: a signed `T` reads them as two's
    /// complement.
    private static narrow<T>(value: u128) -> T where T: Integer {
        return static match (T) {
            u8    => { value as u8 }
            i8    => { value as i8 }
            u16   => { value as u16 }
            i16   => { value as i16 }
            u32   => { value as u32 }
            i32   => { value as i32 }
            u64   => { value as u64 }
            i64   => { value as i64 }
            usize => { value as usize }
            isize => { value as isize }
            u128  => { value }
            i128  => { value as i128 }
        };
    }

    /// Claim the next `count` bytes and return the offset of the first,
    /// or fail with `UnexpectedEof`, without moving, when fewer remain.
    private take(mut &this, count: i64) -> Result<i64, IoError> {
        if (this.remaining() < count) {
            return Result::Err(IoError::new(IoErrorKind::UnexpectedEof, 0));
        }
        const start: i64 = this.position;
        this.position = start + count;
        return Result::Ok(start);
    }

    /// The next `count` bytes, at most 16, as one number: the first byte
    /// most significant when `big_endian`, least significant otherwise.
    private read_bytes(mut &this, count: i64, big_endian: boolean) -> Result<u128, IoError> {
        const start: i64 = this.take(count)?;
        mut value: u128 = 0;
        for (mut i: i64 = 0; i < count; i++) {
            const at: i64 = if (big_endian) { start + i } else { start + count - 1 - i };
            value = (value << 8) | (this.bytes[at] as u128);
        }
        return Result::Ok(value);
    }
}

/// Encodes integers onto the end of a borrowed `Array<u8>` (`new`), or
/// into a fixed region of memory from its first byte (`over`). A write
/// panics if the array cannot grow, as `Array.push` does, or if it would
/// pass the end of the region.
public type struct ByteWriter {
    /// The array `new` appends to; null for a writer made by `over`.
    private array: mut Array<u8>*;
    /// The region `over` writes into; empty for a writer made by `new`.
    private region: mut &Slice<u8>;
    private written: i64;

    /// A writer appending to `out`, after whatever it already holds.
    public static new(out: mut &Array<u8>) -> ByteWriter {
        return ByteWriter {
            array:   out as mut Array<u8>*,
            region:  Slice::<u8>::from_raw_mutable(null, 0),
            written: 0,
        };
    }

    /// A writer into `region`, from its first byte: a header packed into
    /// a buffer a C call reads, a digest's output block.
    public static over(region: mut &Slice<u8>) -> ByteWriter {
        return ByteWriter { array: null, region: region, written: 0 };
    }

    /// How many bytes this writer has written - into a region, the offset
    /// of the next write.
    public position(&this) -> i64 {
        return this.written;
    }

    /// Write `value` most significant byte first, as many bytes as `T` is
    /// wide. Like every write here, it panics when a writer made by `over`
    /// runs past the end of its region.
    public write_big_endian<T>(mut &this, value: T) -> void where T: Integer {
        static match (T) {
            u8    => { this.put(value); }
            i8    => { this.put(value as u8); }
            u16   => { this.put_big_endian(value as u64, 2); }
            i16   => { this.put_big_endian(value as u64, 2); }
            u32   => { this.put_big_endian(value as u64, 4); }
            i32   => { this.put_big_endian(value as u64, 4); }
            u64   => { this.put_big_endian(value, 8); }
            i64   => { this.put_big_endian(value as u64, 8); }
            usize => { this.put_big_endian(value as u64, 8); }
            isize => { this.put_big_endian(value as u64, 8); }
            u128  => {
                this.put_big_endian((value >> 64) as u64, 8);
                this.put_big_endian(value as u64, 8);
            }
            i128  => {
                this.put_big_endian(((value as u128) >> 64) as u64, 8);
                this.put_big_endian(value as u64, 8);
            }
        }
    }

    /// Write `value` least significant byte first, as many bytes as `T` is
    /// wide.
    public write_little_endian<T>(mut &this, value: T) -> void where T: Integer {
        static match (T) {
            u8    => { this.put(value); }
            i8    => { this.put(value as u8); }
            u16   => { this.put_little_endian(value as u64, 2); }
            i16   => { this.put_little_endian(value as u64, 2); }
            u32   => { this.put_little_endian(value as u64, 4); }
            i32   => { this.put_little_endian(value as u64, 4); }
            u64   => { this.put_little_endian(value, 8); }
            i64   => { this.put_little_endian(value as u64, 8); }
            usize => { this.put_little_endian(value as u64, 8); }
            isize => { this.put_little_endian(value as u64, 8); }
            u128  => {
                this.put_little_endian(value as u64, 8);
                this.put_little_endian((value >> 64) as u64, 8);
            }
            i128  => {
                this.put_little_endian(value as u64, 8);
                this.put_little_endian(((value as u128) >> 64) as u64, 8);
            }
        }
    }

    /// The low `count` bytes of `value`, most significant first.
    private put_big_endian(mut &this, value: u64, count: u64) -> void {
        mut shift: u64 = count * 8;
        while (shift > 0) {
            shift = shift - 8;
            this.put((value >> shift) as u8);
        }
    }

    /// The low `count` bytes of `value`, least significant first.
    private put_little_endian(mut &this, value: u64, count: u64) -> void {
        mut rest: u64 = value;
        for (mut i: u64 = 0; i < count; i++) {
            this.put(rest as u8);
            rest = rest >> 8;
        }
    }

    private put(mut &this, value: u8) -> void {
        if (this.array != null) {
            this.array.push(value);
        } else {
            if (this.written >= this.region.length()) {
                core::panic("ByteWriter: write past the end of its region", intrinsics::location());
            }
            const at: mut u8* = this.region.as_mutable_pointer();
            at[this.written] = value;
        }
        this.written = this.written + 1;
    }
}
