///! io: byte-level input/output.
///!
///! `Read` and `Write` are the traits every byte sink or source
///! implements; `Seek` (with `SeekFrom`) repositions a seekable one.
///! `IoError` is the failure channel; callers get `Result<T, IoError>`
///! from every fallible call. `io::cursor::Cursor` is an in-memory
///! `Read + Write + Seek` byte buffer for tests and payload building.
///!
///! Standard streams live in `io::stdio`: `Stdin` / `Stdout` /
///! `Stderr` handles over fd 0/1/2, `is_tty(fd)` plus per-handle
///! `is_tty()`, and free functions `write_stdout` / `write_stderr`
///! (bypass the formatter, safe for panic handlers). File I/O is a
///! layer up in `fs::file`, which implements `Read + Write` on top
///! of libc. `io::buf` provides `BufWriter`, `LineWriter`, and
///! `BufReader`: wrappers that coalesce many small syscalls into
///! few large ones and provide fast `read_line` / `fill_buf` paths.

namespace std::io;

public module io::error;
public module io::fd;
public module io::traits;
public module io::stdio;
public module io::buf;
public module io::cursor;
