///! math: numeric operations on floats and integers.
///!
///! Transcendentals (`sin`, `exp`, `pow`, ...) are thin wrappers over
///! libm and inherit its platform behavior (rounding mode, errno on
///! domain errors, subnormal handling); we don't re-derive those IEEE
///! 754 corner cases in Cryo. Classification and the cheap ops
///! (`fabs`, `floor`, `round`, `copysign`, `sqrt`, `mul_add`, ...) are
///! Cryo-owned compiler intrinsics lowered to LLVM float intrinsics -
///! same results as the libm functions of the same name, but no libm
///! dependency and no errno. Naming follows C: `sqrt`, `ln`, `sin`,
///! `atan2`.
///!
///! Operations that are meaningful at more than one width are a single
///! generic dispatched on `T` at compile time (`sqrt`, `fabs`, `min`, `max`,
///! `clamp`, `abs`, `checked_abs`) rather than a family of type-suffixed
///! names. f64 stays the default, so an unannotated float literal argument
///! still picks the double-precision form; `sqrt<f32>(x)` or an f32-typed
///! argument selects single precision. The remaining transcendentals are
///! f64-only because libm is.

namespace std::math;

import ffi::libc;
import core::option;
import core::intrinsics;
import core::mem;

// --- constants ---------------------------------------------------------

const PI: f64     = 3.141592653589793;
const TAU: f64    = 6.283185307179586;
const E: f64      = 2.718281828459045;
const PHI: f64    = 1.618033988749895;   // golden ratio
const SQRT_2: f64 = 1.4142135623730951;
const SQRT_3: f64 = 1.7320508075688772;
const LN_2: f64   = 0.6931471805599453;
const LN_10: f64  = 2.302585092994046;
const LOG2_E: f64  = 1.4426950408889634;
const LOG10_E: f64 = 0.4342944819032518;

// IEEE-754 limits. `*_MIN` is the most-negative finite value (== -*_MAX);
// `*_MIN_POSITIVE` is the smallest positive normal.
const F64_EPSILON: f64      = 2.220446049250313e-16;
const F64_MAX: f64          = 1.7976931348623157e308;
const F64_MIN: f64          = -1.7976931348623157e308;
const F64_MIN_POSITIVE: f64 = 2.2250738585072014e-308;
const F32_EPSILON: f32      = 1.1920929e-7;
const F32_MAX: f32          = 3.4028235e38;
const F32_MIN: f32          = -3.4028235e38;
const F32_MIN_POSITIVE: f32 = 1.1754944e-38;

// --- non-finite values -------------------------------------------------
//
// Provided as functions rather than `const`s: the values are produced by
// IEEE overflow / invalid operations (`F64_MAX * 2` -> +inf, `inf - inf`
// -> NaN) rather than spellable literals, and computing them at use-site
// sidesteps any compile-time constant folding.

function infinity() -> f64 { return F64_MAX * 2.0; }
function neg_infinity() -> f64 { return 0.0 - infinity(); }
function nan() -> f64 { const inf: f64 = infinity(); return inf - inf; }

// --- roots & powers ----------------------------------------------------

/// Square root, at the precision of `T` (f64 by default; `sqrt<f32>(x)` or an
/// f32 argument selects the single-precision intrinsic).
function sqrt<T>(value: T) -> T {
    static match (T) {
        f32 => { return intrinsics::sqrt32(value); }
        _   => { return intrinsics::sqrt64(value); }
    }
}
function cbrt(value: f64) -> f64 { return libc::cbrt(value); }
function pow(base: f64, exponent: f64) -> f64 { return libc::pow(base, exponent); }

/// sqrt(x^2 + y^2) without spurious overflow/underflow: libm's `hypot`
/// scales by the larger operand, so `hypot(3e200, 4e200) == 5e200`
/// (the naive `sqrt(x*x + y*y)` overflows to +inf there).
function hypot(x: f64, y: f64) -> f64 { return libc::hypot(x, y); }

/// `base` raised to an integer power via binary exponentiation (libm has
/// no `powi`). Negative `exp` returns the reciprocal; `powi(_, 0) == 1.0`,
/// including `powi(0.0, 0) == 1.0`.
function powi(base: f64, exp: i64) -> f64 {
    if (exp == 0) { return 1.0; }
    mut e: i64 = exp;
    mut neg: boolean = false;
    if (e < 0) { neg = true; e = 0 - e; }
    mut result: f64 = 1.0;
    mut b: f64 = base;
    while (e > 0) {
        if ((e & 1) == 1) { result = result * b; }
        b = b * b;
        e = e >> 1;
    }
    if (neg) { return 1.0 / result; }
    return result;
}

/// Fused multiply-add: `a * b + c` computed with a single rounding (IEEE
/// fma), more accurate than performing the multiply and add separately.
function mul_add(a: f64, b: f64, c: f64) -> f64 { return intrinsics::fma64(a, b, c); }

// --- exponential & logarithm -------------------------------------------

function exp(value: f64) -> f64 { return libc::exp(value); }
function exp2(value: f64) -> f64 { return libc::exp2(value); }
function ln(value: f64) -> f64 { return libc::log(value); }
function log2(value: f64) -> f64 { return libc::log2(value); }
function log10(value: f64) -> f64 { return libc::log10(value); }

/// `ln(1 + value)`, accurate for `value` near 0 (IEEE log1p).
function log1p(value: f64) -> f64 { return libc::log1p(value); }

/// `exp(value) - 1`, accurate for `value` near 0 (IEEE expm1).
function expm1(value: f64) -> f64 { return libc::expm1(value); }

/// Logarithm of `value` in an arbitrary `base`.
function log(value: f64, base: f64) -> f64 {
    return libc::log(value) / libc::log(base);
}

// --- trigonometry ------------------------------------------------------

function sin(value: f64) -> f64 { return libc::sin(value); }
function cos(value: f64) -> f64 { return libc::cos(value); }
function tan(value: f64) -> f64 { return libc::tan(value); }
function asin(value: f64) -> f64 { return libc::asin(value); }
function acos(value: f64) -> f64 { return libc::acos(value); }
function atan(value: f64) -> f64 { return libc::atan(value); }
function atan2(y: f64, x: f64) -> f64 { return libc::atan2(y, x); }

function sinh(value: f64) -> f64 { return libc::sinh(value); }
function cosh(value: f64) -> f64 { return libc::cosh(value); }
function tanh(value: f64) -> f64 { return libc::tanh(value); }

/// Convert degrees to radians and back.
function to_radians(degrees: f64) -> f64 { return degrees * (PI / 180.0); }
function to_degrees(radians: f64) -> f64 { return radians * (180.0 / PI); }

// --- rounding ----------------------------------------------------------

function floor(value: f64) -> f64 { return intrinsics::floor64(value); }
function ceil(value: f64) -> f64 { return intrinsics::ceil64(value); }

/// Round to the nearest integer, halfway cases away from zero
/// (`round(2.5) == 3.0`, `round(-2.5) == -3.0`) - C `round` semantics,
/// not the current-rounding-mode `rint`/`nearbyint`.
function round(value: f64) -> f64 { return intrinsics::round64(value); }
function trunc(value: f64) -> f64 { return intrinsics::ftrunc64(value); }

/// Fractional part, with the sign of `value` (`fract(-2.25) == -0.25`).
function fract(value: f64) -> f64 { return value - intrinsics::ftrunc64(value); }

// --- sign & absolute value ---------------------------------------------

/// Floating-point absolute value, at the precision of `T`.
function fabs<T>(value: T) -> T {
    static match (T) {
        f32 => { return intrinsics::fabs32(value); }
        _   => { return intrinsics::fabs64(value); }
    }
}

/// `magnitude` with the sign of `sign` (IEEE copysign).
function copysign(magnitude: f64, sign: f64) -> f64 {
    return intrinsics::copysign64(magnitude, sign);
}

/// Floating-point remainder of `x / y` (IEEE fmod).
function fmod(x: f64, y: f64) -> f64 { return libc::fmod(x, y); }

/// +1.0 / -1.0 for non-zero values; preserves +0.0, -0.0, and NaN.
function signum(value: f64) -> f64 {
    if (value > 0.0) { return 1.0; }
    if (value < 0.0) { return 0.0 - 1.0; }
    return value;
}

/// Integer absolute value: cheap enough to be intrinsic-free.
///
/// WARNING: two's-complement has no positive counterpart for the most-negative
/// value, so `abs(i64::MIN)` and `abs(i32::MIN)` overflow and return the SAME
/// negative input (the standard C/Rust `abs` footgun). Feeding that result to
/// a size/index computation silently corrupts it. When the input may be the
/// minimum, use `checked_abs`, which returns `None` on overflow instead of a
/// wrong (negative) value.
function abs<T>(value: T) -> T {
    if (value < 0) { return 0 - value; }
    return value;
}

/// Non-overflowing absolute value: `None` for the most-negative value of `T`
/// (whose magnitude is not representable), `Some(|value|)` otherwise. The
/// overflow is detected without naming the MIN constant: only MIN negates to
/// a still-negative value under two's complement.
function checked_abs<T>(value: T) -> Option<T> {
    if (value < 0) {
        const neg: T = 0 - value;
        if (neg < 0) { return Option::None; }
        return Option::Some(neg);
    }
    return Option::Some(value);
}

// --- min / max / clamp -------------------------------------------------
//
// One generic per operation, dispatched on `T` at compile time.
//
// Float `min`/`max` are NaN-transparent (IEEE minNum/maxNum: a NaN operand
// is ignored and the other returned; both-NaN yields NaN). This differs
// from `cmp::min`/`cmp::max`, which order NaN under the total bit-order.
// `clamp` keeps plain comparisons for every type, so a NaN `value`
// propagates (it is not silently pulled into range) - which is why it needs
// no per-type dispatch at all.

/// Smaller of `a` and `b`. NaN-transparent for the float types.
function min<T>(a: T, b: T) -> T {
    static match (T) {
        f64 => { return libc::fmin(a, b); }
        // libm exposes no `fminf` binding here, so NaN handling is by hand:
        // `x != x` is true iff x is NaN (the `!=` operator is IEEE, distinct
        // from the bitwise `Eq` trait).
        f32 => {
            if (a != a) { return b; }
            if (b != b) { return a; }
            if (a < b) { return a; }
            return b;
        }
        _ => { if (a < b) { return a; } return b; }
    }
}

/// Larger of `a` and `b`. NaN-transparent for the float types.
function max<T>(a: T, b: T) -> T {
    static match (T) {
        f64 => { return libc::fmax(a, b); }
        f32 => {
            if (a != a) { return b; }
            if (b != b) { return a; }
            if (a > b) { return a; }
            return b;
        }
        _ => { if (a > b) { return a; } return b; }
    }
}

/// `value` confined to `[lo, hi]`. NaN-propagating for the float types: a NaN
/// `value` compares false against both bounds and falls through unchanged.
function clamp<T>(value: T, lo: T, hi: T) -> T {
    if (value < lo) { return lo; }
    if (value > hi) { return hi; }
    return value;
}

// --- classification ----------------------------------------------------
//
// IEEE-754 class tests via the `fpclass` intrinsic (LLVM `llvm.is.fpclass`):
// pure bit-class predicates with no libm dependency and no FP exceptions,
// so they are platform-independent - no per-OS libc name gymnastics.  Each
// `test` literal selects which classes count as true; the bit meanings are
// documented on `intrinsics::fpclass`.

/// IEEE-754 value categories, as returned by `classify`.
type enum FpCategory {
    Nan;
    Infinite;
    Zero;
    Subnormal;
    Normal;
}

/// True if `value` is NaN (quiet or signaling).
function is_nan(value: f64) -> boolean { return intrinsics::fpclass(value, 0x003); }

/// True if `value` is positive or negative infinity.
function is_infinite(value: f64) -> boolean { return intrinsics::fpclass(value, 0x204); }

/// True if `value` is finite - neither NaN nor infinite.  Includes +/-0
/// and subnormals.
function is_finite(value: f64) -> boolean { return intrinsics::fpclass(value, 0x1F8); }

/// True if `value` is a normal number: finite, nonzero, and not subnormal.
function is_normal(value: f64) -> boolean { return intrinsics::fpclass(value, 0x108); }

/// True if `value`'s IEEE-754 sign bit is set.  Unlike the class tests this
/// reports the raw sign bit, so it is true for -0.0 and negative NaNs too.
/// A single bit read - no libm.
function is_sign_negative(value: f64) -> boolean {
    return (mem::transmute<f64, u64>(value) >> 63) != 0;
}

/// Classify `value` into its IEEE-754 category.
function classify(value: f64) -> FpCategory {
    if (intrinsics::fpclass(value, 0x003)) { return FpCategory::Nan; }
    if (intrinsics::fpclass(value, 0x204)) { return FpCategory::Infinite; }
    if (intrinsics::fpclass(value, 0x060)) { return FpCategory::Zero; }
    if (intrinsics::fpclass(value, 0x090)) { return FpCategory::Subnormal; }
    return FpCategory::Normal;
}

// --- integer helpers ---------------------------------------------------

/// Greatest common divisor (Euclid). `gcd(0, 0) == 0`.
function gcd(a: u64, b: u64) -> u64 {
    mut x: u64 = a;
    mut y: u64 = b;
    while (y != 0) {
        const t: u64 = y;
        y = x % y;
        x = t;
    }
    return x;
}

/// Least common multiple. `lcm(_, 0) == 0`.
function lcm(a: u64, b: u64) -> u64 {
    if (a == 0 || b == 0) { return 0; }
    return (a / gcd(a, b)) * b;
}

/// True if `value` is a power of two (zero is not).
function is_power_of_two(value: u64) -> boolean {
    return value != 0 && (value & (value - 1)) == 0;
}

/// Smallest power of two >= `value`. `next_power_of_two(0) == 1`.
function next_power_of_two(value: u64) -> u64 {
    if (value <= 1) { return 1; }
    mut n: u64 = value - 1;
    n = n | (n >> 1);
    n = n | (n >> 2);
    n = n | (n >> 4);
    n = n | (n >> 8);
    n = n | (n >> 16);
    n = n | (n >> 32);
    return n + 1;
}

/// Round `value` up to the next multiple of `align`. An `align` of 0 or 1
/// returns `value` unchanged. Used for memory/field layout where `align` is
/// a power of two, but works for any non-zero alignment. Consolidates the
/// `align_up` helper the compiler's type-layout pass hand-rolls.
function align_up(value: u64, align: u64) -> u64 {
    if (align <= 1) { return value; }
    const rem: u64 = value % align;
    if (rem == 0) { return value; }
    return value + (align - rem);
}

/// Round `value` down to the previous multiple of `align`. An `align` of 0
/// or 1 returns `value` unchanged.
function align_down(value: u64, align: u64) -> u64 {
    if (align <= 1) { return value; }
    return value - (value % align);
}
