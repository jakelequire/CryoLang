///! math: numeric operations on floats and integers.
///!
///! Float functions are thin wrappers over libm and inherit its
///! platform behavior (rounding mode, errno on domain errors,
///! subnormal handling); we don't re-derive the IEEE 754 corner cases
///! in Cryo. Naming follows C: `sqrt`, `ln`, `sin`, `atan2`. f64 is the
///! default; an `_f32` suffix marks a single-precision variant, and
///! integer variants carry an `_i64` / `_u64` / `_i32` suffix (the
///! plain name is the f64 form).

namespace std::math;

import ffi::libc;

// --- constants ---------------------------------------------------------

const PI: f64     = 3.141592653589793;
const TAU: f64    = 6.283185307179586;
const E: f64      = 2.718281828459045;
const PHI: f64    = 1.618033988749895;   // golden ratio
const SQRT_2: f64 = 1.4142135623730951;
const SQRT_3: f64 = 1.7320508075688772;
const LN_2: f64   = 0.6931471805599453;
const LN_10: f64  = 2.302585092994046;
const LOG2_E: f64  = 1.4426950408889634;
const LOG10_E: f64 = 0.4342944819032518;

// IEEE-754 limits. `*_MIN` is the most-negative finite value (== -*_MAX);
// `*_MIN_POSITIVE` is the smallest positive normal.
const F64_EPSILON: f64      = 2.220446049250313e-16;
const F64_MAX: f64          = 1.7976931348623157e308;
const F64_MIN: f64          = -1.7976931348623157e308;
const F64_MIN_POSITIVE: f64 = 2.2250738585072014e-308;
const F32_EPSILON: f32      = 1.1920929e-7;
const F32_MAX: f32          = 3.4028235e38;
const F32_MIN: f32          = -3.4028235e38;
const F32_MIN_POSITIVE: f32 = 1.1754944e-38;
const F32_MIN_POSITIVE: f32 = 1.1754944e-38;

// --- non-finite values -------------------------------------------------
//
// Provided as functions rather than `const`s: the values are produced by
// IEEE overflow / invalid operations (`F64_MAX * 2` -> +inf, `inf - inf`
// -> NaN) rather than spellable literals, and computing them at use-site
// sidesteps any compile-time constant folding.

function infinity() -> f64 { return F64_MAX * 2.0; }
function neg_infinity() -> f64 { return 0.0 - infinity(); }
function nan() -> f64 { const inf: f64 = infinity(); return inf - inf; }

// --- roots & powers ----------------------------------------------------

function sqrt(value: f64) -> f64 { return libc::sqrt(value); }
function sqrt_f32(value: f32) -> f32 { return libc::sqrtf(value); }
function cbrt(value: f64) -> f64 { return libc::cbrt(value); }
function pow(base: f64, exponent: f64) -> f64 { return libc::pow(base, exponent); }

/// sqrt(x^2 + y^2) without spurious overflow/underflow: libm's `hypot`
/// scales by the larger operand, so `hypot(3e200, 4e200) == 5e200`
/// (the naive `sqrt(x*x + y*y)` overflows to +inf there).
function hypot(x: f64, y: f64) -> f64 { return libc::hypot(x, y); }

/// `base` raised to an integer power via binary exponentiation (libm has
/// no `powi`). Negative `exp` returns the reciprocal; `powi(_, 0) == 1.0`,
/// including `powi(0.0, 0) == 1.0`.
function powi(base: f64, exp: i64) -> f64 {
    if (exp == 0) { return 1.0; }
    mut e: i64 = exp;
    mut neg: boolean = false;
    if (e < 0) { neg = true; e = 0 - e; }
    mut result: f64 = 1.0;
    mut b: f64 = base;
    while (e > 0) {
        if ((e & 1) == 1) { result = result * b; }
        b = b * b;
        e = e >> 1;
    }
    if (neg) { return 1.0 / result; }
    return result;
}

/// Fused multiply-add: `a * b + c` computed with a single rounding (IEEE
/// fma), more accurate than performing the multiply and add separately.
function mul_add(a: f64, b: f64, c: f64) -> f64 { return libc::fma(a, b, c); }

// --- exponential & logarithm -------------------------------------------

function exp(value: f64) -> f64 { return libc::exp(value); }
function exp2(value: f64) -> f64 { return libc::exp2(value); }
function ln(value: f64) -> f64 { return libc::log(value); }
function log2(value: f64) -> f64 { return libc::log2(value); }
function log10(value: f64) -> f64 { return libc::log10(value); }

/// `ln(1 + value)`, accurate for `value` near 0 (IEEE log1p).
function log1p(value: f64) -> f64 { return libc::log1p(value); }

/// `exp(value) - 1`, accurate for `value` near 0 (IEEE expm1).
function expm1(value: f64) -> f64 { return libc::expm1(value); }

/// Logarithm of `value` in an arbitrary `base`.
function log(value: f64, base: f64) -> f64 {
    return libc::log(value) / libc::log(base);
}

// --- trigonometry ------------------------------------------------------

function sin(value: f64) -> f64 { return libc::sin(value); }
function cos(value: f64) -> f64 { return libc::cos(value); }
function tan(value: f64) -> f64 { return libc::tan(value); }
function asin(value: f64) -> f64 { return libc::asin(value); }
function acos(value: f64) -> f64 { return libc::acos(value); }
function atan(value: f64) -> f64 { return libc::atan(value); }
function atan2(y: f64, x: f64) -> f64 { return libc::atan2(y, x); }

function sinh(value: f64) -> f64 { return libc::sinh(value); }
function cosh(value: f64) -> f64 { return libc::cosh(value); }
function tanh(value: f64) -> f64 { return libc::tanh(value); }

/// Convert degrees to radians and back.
function to_radians(degrees: f64) -> f64 { return degrees * (PI / 180.0); }
function to_degrees(radians: f64) -> f64 { return radians * (180.0 / PI); }

// --- rounding ----------------------------------------------------------

function floor(value: f64) -> f64 { return libc::floor(value); }
function ceil(value: f64) -> f64 { return libc::ceil(value); }
function round(value: f64) -> f64 { return libc::round(value); }
function trunc(value: f64) -> f64 { return libc::trunc(value); }

/// Fractional part, with the sign of `value` (`fract(-2.25) == -0.25`).
function fract(value: f64) -> f64 { return value - libc::trunc(value); }

// --- sign & absolute value ---------------------------------------------

function fabs(value: f64) -> f64 { return libc::fabs(value); }
function fabs_f32(value: f32) -> f32 { return libc::fabsf(value); }

/// `magnitude` with the sign of `sign` (IEEE copysign).
function copysign(magnitude: f64, sign: f64) -> f64 {
    return libc::copysign(magnitude, sign);
}

/// Floating-point remainder of `x / y` (IEEE fmod).
function fmod(x: f64, y: f64) -> f64 { return libc::fmod(x, y); }

/// +1.0 / -1.0 for non-zero values; preserves +0.0, -0.0, and NaN.
function signum(value: f64) -> f64 {
    if (value > 0.0) { return 1.0; }
    if (value < 0.0) { return 0.0 - 1.0; }
    return value;
}

// Integer absolute value: cheap enough to be intrinsic-free.
function abs_i64(value: i64) -> i64 { if (value < 0) { return 0 - value; } return value; }
function abs_i32(value: i32) -> i32 { if (value < 0) { return 0 - value; } return value; }

// --- min / max / clamp -------------------------------------------------
//
// The plain names operate on f64; integer variants carry a type suffix.
// Free-function overloading is avoided deliberately (it tickles the
// generic-codegen path), so each width gets its own name.
//
// Float `min`/`max` are NaN-transparent (IEEE minNum/maxNum via libm: a
// NaN operand is ignored and the other returned; both-NaN yields NaN).
// This differs from `cmp::min`/`cmp::max`, which order NaN under the
// total bit-order. `clamp` keeps plain comparisons, so a NaN `value`
// propagates (it is not silently pulled into range).

function min(a: f64, b: f64) -> f64 { return libc::fmin(a, b); }
function max(a: f64, b: f64) -> f64 { return libc::fmax(a, b); }
function clamp(value: f64, lo: f64, hi: f64) -> f64 {
    if (value < lo) { return lo; }
    if (value > hi) { return hi; }
    return value;
}

// f32 min/max/clamp. libm exposes no `fminf`/`fmaxf` binding here, so NaN
// handling is by hand: `x != x` is true iff x is NaN (the `!=` operator is
// IEEE, distinct from the bitwise `Eq` trait). min/max are NaN-transparent
// like the f64 forms; clamp is NaN-propagating like f64 `clamp`.
function min_f32(a: f32, b: f32) -> f32 {
    if (a != a) { return b; }
    if (b != b) { return a; }
    if (a < b) { return a; }
    return b;
}
function max_f32(a: f32, b: f32) -> f32 {
    if (a != a) { return b; }
    if (b != b) { return a; }
    if (a > b) { return a; }
    return b;
}
function clamp_f32(value: f32, lo: f32, hi: f32) -> f32 {
    if (value < lo) { return lo; }
    if (value > hi) { return hi; }
    return value;
}

function min_i64(a: i64, b: i64) -> i64 { if (a < b) { return a; } return b; }
function max_i64(a: i64, b: i64) -> i64 { if (a > b) { return a; } return b; }
function clamp_i64(value: i64, lo: i64, hi: i64) -> i64 {
    if (value < lo) { return lo; }
    if (value > hi) { return hi; }
    return value;
}

function min_u64(a: u64, b: u64) -> u64 { if (a < b) { return a; } return b; }
function max_u64(a: u64, b: u64) -> u64 { if (a > b) { return a; } return b; }
function clamp_u64(value: u64, lo: u64, hi: u64) -> u64 {
    if (value < lo) { return lo; }
    if (value > hi) { return hi; }
    return value;
}

// --- classification ----------------------------------------------------
//
// `isnan` / `isinf` in libc are macros; the underlying primitive
// implementations are exposed under different names per platform:
//   - glibc:    `__isnan`, `__isinf`, `__finite`
//   - msvcrt:   `_isnan`, `_finite`  (no `_isinf` export - derive it)
// Both surfaces live in `ffi::libc` behind their own `![target(...)]`
// gates.

![target(linux)]
function is_nan(value: f64) -> boolean { return libc::__isnan(value) != 0; }

![target(linux)]
function is_infinite(value: f64) -> boolean { return libc::__isinf(value) != 0; }

![target(linux)]
function is_finite(value: f64) -> boolean {
    return libc::__finite(value) != 0;
}

![target(windows)]
function is_nan(value: f64) -> boolean { return libc::_isnan(value) != 0; }

![target(windows)]
function is_finite(value: f64) -> boolean { return libc::_finite(value) != 0; }

// msvcrt has no direct `_isinf`; `!finite && !nan` is the standard
// derivation and matches what C99's `isinf` macro is defined to do
// for any value that compares unequal to itself only when NaN.
![target(windows)]
function is_infinite(value: f64) -> boolean {
    return !is_finite(value) && !is_nan(value);
}

// --- integer helpers ---------------------------------------------------

/// Greatest common divisor (Euclid). `gcd(0, 0) == 0`.
function gcd(a: u64, b: u64) -> u64 {
    mut x: u64 = a;
    mut y: u64 = b;
    while (y != 0) {
        const t: u64 = y;
        y = x % y;
        x = t;
    }
    return x;
}

/// Least common multiple. `lcm(_, 0) == 0`.
function lcm(a: u64, b: u64) -> u64 {
    if (a == 0 || b == 0) { return 0; }
    return (a / gcd(a, b)) * b;
}

/// True if `value` is a power of two (zero is not).
function is_power_of_two(value: u64) -> boolean {
    return value != 0 && (value & (value - 1)) == 0;
}

/// Smallest power of two >= `value`. `next_power_of_two(0) == 1`.
function next_power_of_two(value: u64) -> u64 {
    if (value <= 1) { return 1; }
    mut n: u64 = value - 1;
    n = n | (n >> 1);
    n = n | (n >> 2);
    n = n | (n >> 4);
    n = n | (n >> 8);
    n = n | (n >> 16);
    n = n | (n >> 32);
    return n + 1;
}
