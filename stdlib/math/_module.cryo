///! math: numeric operations on floats and integers.
///!
///! Transcendentals (`sin`, `exp`, `pow`, ...) are thin wrappers over
///! libm and inherit its platform behavior (rounding mode, errno on
///! domain errors, subnormal handling); we don't re-derive those IEEE
///! 754 corner cases in Cryo. Classification and the cheap ops
///! (`floor`, `round`, `copysign`, `mul_add`, ...) are Cryo-owned compiler
///! intrinsics lowered to LLVM float intrinsics - same results as the libm
///! functions of the same name, but no libm dependency and no errno. Naming
///! follows C: `ln`, `sin`, `atan2`.
///!
///! The transcendentals are f64-only because libm is.
///!
///! `sqrt` is a method of each float type (`(2.0).sqrt()`), and `abs`,
///! `checked_abs` and `clamp` of each numeric primitive (`(-5 as i32).abs()`,
///! `x.abs()` on a float, which clears the sign bit, `x.clamp(lo, hi)`), in
///! `core::primitives`: their bodies are a different intrinsic or compare
///! with and negate from a literal `0` per type, which no trait bound on a
///! `T` licenses.

namespace std::math;

import std::ffi::libc;
import std::core::intrinsics;

// --- constants ---------------------------------------------------------

public const PI: f64     = 3.141592653589793;
public const TAU: f64    = 6.283185307179586;
public const E: f64      = 2.718281828459045;
public const PHI: f64    = 1.618033988749895;   // golden ratio
public const SQRT_2: f64 = 1.4142135623730951;
public const SQRT_3: f64 = 1.7320508075688772;
public const LN_2: f64   = 0.6931471805599453;
public const LN_10: f64  = 2.302585092994046;
public const LOG2_E: f64  = 1.4426950408889634;
public const LOG10_E: f64 = 0.4342944819032518;

// The float types' own limits and non-finite values are constants of the
// types, in `core::primitives`: `f64::EPSILON`, `f32::MAX`, `f64::INFINITY`,
// `f64::NAN`.

// --- roots & powers ----------------------------------------------------

public function cbrt(value: f64) -> f64 { return libc::cbrt(value); }
public function pow(base: f64, exponent: f64) -> f64 { return libc::pow(base, exponent); }

/// sqrt(x^2 + y^2) without spurious overflow/underflow: libm's `hypot`
/// scales by the larger operand, so `hypot(3e200, 4e200) == 5e200`
/// (the naive `sqrt(x*x + y*y)` overflows to +inf there).
public function hypot(x: f64, y: f64) -> f64 { return libc::hypot(x, y); }

/// `base` raised to an integer power via binary exponentiation (libm has
/// no `powi`). Negative `exp` returns the reciprocal; `powi(_, 0) == 1.0`,
/// including `powi(0.0, 0) == 1.0`.
public function powi(base: f64, exp: i64) -> f64 {
    if (exp == 0) { return 1.0; }
    mut e: i64 = exp;
    mut neg: boolean = false;
    if (e < 0) { neg = true; e = 0 - e; }
    mut result: f64 = 1.0;
    mut b: f64 = base;
    while (e > 0) {
        if ((e & 1) == 1) { result = result * b; }
        b = b * b;
        e = e >> 1;
    }
    if (neg) { return 1.0 / result; }
    return result;
}

/// Fused multiply-add: `a * b + c` computed with a single rounding (IEEE
/// fma), more accurate than performing the multiply and add separately.
public function mul_add(a: f64, b: f64, c: f64) -> f64 { return intrinsics::fma64(a, b, c); }

// --- exponential & logarithm -------------------------------------------

public function exp(value: f64) -> f64 { return libc::exp(value); }
public function exp2(value: f64) -> f64 { return libc::exp2(value); }
public function ln(value: f64) -> f64 { return libc::log(value); }
public function log2(value: f64) -> f64 { return libc::log2(value); }
public function log10(value: f64) -> f64 { return libc::log10(value); }

/// `ln(1 + value)`, accurate for `value` near 0 (IEEE log1p).
public function log1p(value: f64) -> f64 { return libc::log1p(value); }

/// `exp(value) - 1`, accurate for `value` near 0 (IEEE expm1).
public function expm1(value: f64) -> f64 { return libc::expm1(value); }

/// Logarithm of `value` in an arbitrary `base`.
public function log(value: f64, base: f64) -> f64 {
    return libc::log(value) / libc::log(base);
}

// --- trigonometry ------------------------------------------------------

public function sin(value: f64) -> f64 { return libc::sin(value); }
public function cos(value: f64) -> f64 { return libc::cos(value); }
public function tan(value: f64) -> f64 { return libc::tan(value); }
public function asin(value: f64) -> f64 { return libc::asin(value); }
public function acos(value: f64) -> f64 { return libc::acos(value); }
public function atan(value: f64) -> f64 { return libc::atan(value); }
public function atan2(y: f64, x: f64) -> f64 { return libc::atan2(y, x); }

public function sinh(value: f64) -> f64 { return libc::sinh(value); }
public function cosh(value: f64) -> f64 { return libc::cosh(value); }
public function tanh(value: f64) -> f64 { return libc::tanh(value); }

/// Convert degrees to radians and back.
public function to_radians(degrees: f64) -> f64 { return degrees * (PI / 180.0); }
public function to_degrees(radians: f64) -> f64 { return radians * (180.0 / PI); }

// --- rounding ----------------------------------------------------------

public function floor(value: f64) -> f64 { return intrinsics::floor64(value); }
public function ceil(value: f64) -> f64 { return intrinsics::ceil64(value); }

/// Round to the nearest integer, halfway cases away from zero
/// (`round(2.5) == 3.0`, `round(-2.5) == -3.0`) - C `round` semantics,
/// not the current-rounding-mode `rint`/`nearbyint`.
public function round(value: f64) -> f64 { return intrinsics::round64(value); }
public function trunc(value: f64) -> f64 { return intrinsics::ftrunc64(value); }

/// Fractional part, with the sign of `value` (`fract(-2.25) == -0.25`).
public function fract(value: f64) -> f64 { return value - intrinsics::ftrunc64(value); }

// --- sign & absolute value ---------------------------------------------

/// `magnitude` with the sign of `sign` (IEEE copysign).
public function copysign(magnitude: f64, sign: f64) -> f64 {
    return intrinsics::copysign64(magnitude, sign);
}

/// Floating-point remainder of `x / y` (IEEE fmod).
public function fmod(x: f64, y: f64) -> f64 { return libc::fmod(x, y); }

/// +1.0 / -1.0 for non-zero values; preserves +0.0, -0.0, and NaN.
public function signum(value: f64) -> f64 {
    if (value > 0.0) { return 1.0; }
    if (value < 0.0) { return 0.0 - 1.0; }
    return value;
}

// --- min / max ---------------------------------------------------------
//
// `cmp::min`, `cmp::max` and `cmp::clamp` order any `Ord` type, a NaN
// under the total bit-order.  `f32.min`/`max` and `f64.min`/`max` ignore a
// NaN operand instead (IEEE minNum/maxNum).

// --- classification ----------------------------------------------------
//
// A float classifies itself: `f64.is_nan`, `is_infinite`, `is_finite`,
// `is_normal`, `is_sign_negative` and `classify`.

/// IEEE-754 value categories, as returned by `f64.classify`.
public type enum FpCategory {
    Nan;
    Infinite;
    Zero;
    Subnormal;
    Normal;
}

// --- integer helpers ---------------------------------------------------

/// Greatest common divisor (Euclid). `gcd(0, 0) == 0`.
public function gcd(a: u64, b: u64) -> u64 {
    mut x: u64 = a;
    mut y: u64 = b;
    while (y != 0) {
        const t: u64 = y;
        y = x % y;
        x = t;
    }
    return x;
}

/// Least common multiple. `lcm(_, 0) == 0`.
public function lcm(a: u64, b: u64) -> u64 {
    if (a == 0 || b == 0) { return 0; }
    return (a / gcd(a, b)) * b;
}

/// True if `value` is a power of two (zero is not).
public function is_power_of_two(value: u64) -> boolean {
    return value != 0 && (value & (value - 1)) == 0;
}

/// Smallest power of two >= `value`. `next_power_of_two(0) == 1`.
public function next_power_of_two(value: u64) -> u64 {
    if (value <= 1) { return 1; }
    mut n: u64 = value - 1;
    n = n | (n >> 1);
    n = n | (n >> 2);
    n = n | (n >> 4);
    n = n | (n >> 8);
    n = n | (n >> 16);
    n = n | (n >> 32);
    return n + 1;
}

/// Round `value` up to the next multiple of `align`. An `align` of 0 or 1
/// returns `value` unchanged. Used for memory/field layout where `align` is
/// a power of two, but works for any non-zero alignment. Consolidates the
/// `align_up` helper the compiler's type-layout pass hand-rolls.
public function align_up(value: u64, align: u64) -> u64 {
    if (align <= 1) { return value; }
    const rem: u64 = value % align;
    if (rem == 0) { return value; }
    return value + (align - rem);
}

/// Round `value` down to the previous multiple of `align`. An `align` of 0
/// or 1 returns `value` unchanged.
public function align_down(value: u64, align: u64) -> u64 {
    if (align <= 1) { return value; }
    return value - (value % align);
}
