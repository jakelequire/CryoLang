///! math: float operations.
///!
///! Thin wrappers over libm. Every function delegates to the C
///! implementation and inherits its platform behavior (rounding
///! mode, errno on domain errors, subnormal handling). We don't
///! re-derive the IEEE 754 corner cases in Cryo.
///!
///! The naming follows C (`sqrt`, `sinh`, `atan2`). f64 is the
///! default; f32 versions live alongside with an `f32` suffix only
///! when the C name already carries one (`sqrtf` → `sqrt_f32`).

namespace std::math;

import ffi::libc;

// ============================================================================
// Constants
// ============================================================================

const PI: f64 = 3.141592653589793;
const TAU: f64 = 6.283185307179586;
const E: f64 = 2.718281828459045;
const SQRT_2: f64 = 1.4142135623730951;
const LN_2: f64 = 0.6931471805599453;
const LN_10: f64 = 2.302585092994046;

// ============================================================================
// f64 entrypoints (thin aliases over libm for naming symmetry)
// ============================================================================

function square_root(value: f64) -> f64 { return libc::sqrt(value); }
function cube_root(value: f64) -> f64 { return libc::cbrt(value); }
function power(base: f64, exponent: f64) -> f64 { return libc::pow(base, exponent); }

function natural_log(value: f64) -> f64 { return libc::log(value); }
function log_base2(value: f64) -> f64 { return libc::log2(value); }
function log_base10(value: f64) -> f64 { return libc::log10(value); }
function exponential(value: f64) -> f64 { return libc::exp(value); }

function sine(value: f64) -> f64 { return libc::sin(value); }
function cosine(value: f64) -> f64 { return libc::cos(value); }
function tangent(value: f64) -> f64 { return libc::tan(value); }

function absolute(value: f64) -> f64 { return libc::fabs(value); }
function absolute_f32(value: f32) -> f32 { return libc::fabsf(value); }

function hypot(x: f64, y: f64) -> f64 {
    return libc::sqrt(x * x + y * y);
}

// Integer absolute: cheap enough to be intrinsic-free.
function abs_i32(value: i32) -> i32 {
    if (value < 0) { return 0 - value; }
    return value;
}

function abs_i64(value: i64) -> i64 {
    if (value < 0) { return 0 - value; }
    return value;
}

// ============================================================================
// Classification
// ============================================================================

// `isnan` / `isinf` in libc are macros; the underlying primitive
// implementations (`__isnan`, `__isinf`) live in `ffi::libc` alongside
// the rest of libm.

function is_nan(value: f64) -> boolean {
    return libc::__isnan(value) != 0;
}

function is_infinite(value: f64) -> boolean {
    return libc::__isinf(value) != 0;
}

function is_finite(value: f64) -> boolean {
    return !is_nan(value) && !is_infinite(value);
}
