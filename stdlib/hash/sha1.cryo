///! SHA-1 (RFC 3174).
///!
///! Cryptographically broken for collision resistance - present because
///! protocols that predate that break name it, as the WebSocket handshake
///! (RFC 6455) does for its `Sec-WebSocket-Accept` value. Do not use it for
///! security; `Sha256` is the digest to reach for.
///!
///! `Sha1` hashes a message that arrives in pieces: `update` with each piece
///! in order, then `finish` for the digest. `Sha1::digest` hashes one message
///! held whole. Either way the digest is a `Sha1Digest`, its 20 bytes in the
///! order the standard writes them, shown as 40 lowercase hexadecimal digits.

namespace std::hash::sha1;

import std::collections::string::{ String };
import std::core::cmp::{ Eq };
import std::core::result::{ Result };
import std::core::slice::{ Slice };
import std::encoding::hex;
import std::fmt::display::{ Display, Formatter };
import std::fmt::error::{ FormatError };

/// Bytes in a digest.
public const DIGEST_LENGTH: i64 = 20;

/// Bytes in the block the compression function consumes.
const BLOCK_LENGTH: i64 = 64;

/// A SHA-1 digest: the hash's 20 bytes, most significant byte of the first
/// word first.
public type struct Sha1Digest with [Eq] {
    private bytes: [u8; 20];

    /// The digest's bytes.
    public as_bytes(&this) -> &Slice<u8> {
        return this.bytes.as_slice();
    }

    /// The digest as 40 lowercase hexadecimal digits.
    public to_hex(&this) -> String {
        return hex::encode(this.as_bytes());
    }
}

implement trait Display for struct Sha1Digest {
    fmt(&this, f: mut &Formatter) -> Result<(), FormatError> {
        const text: String = this.to_hex();
        return f.write_str(text.as_str());
    }
}

/// A SHA-1 computation in progress: the message so far, fed in order by
/// `update`, and closed by `finish`.
public type struct Sha1 {
    private state:          [u32; 5];
    /// The bytes of a block not yet complete, `buffered` of them.
    private block:          [u8; 64];
    private buffered:       i64;
    /// Bytes of message fed so far.
    private message_length: u64;

    /// A computation over the empty message.
    public static new() -> Sha1 {
        return Sha1 {
            state: [0x67452301, 0xEFCDAB89, 0x98BADCFE, 0x10325476, 0xC3D2E1F0],
            block: [0; 64],
            buffered: 0,
            message_length: 0,
        };
    }

    /// The digest of `data`, held whole.
    public static digest(data: &Slice<u8>) -> Sha1Digest {
        mut hasher: Sha1 = Sha1::new();
        hasher.update(data);
        return hasher.finish();
    }

    /// Append `data` to the message.
    public update(mut &this, data: &Slice<u8>) -> void {
        const length: i64 = data.length();
        const p: u8* = data.as_pointer();
        this.message_length += length as u64;
        mut i: i64 = 0;
        if (this.buffered > 0) {
            while (i < length && this.buffered < BLOCK_LENGTH) {
                this.block[this.buffered] = p[i];
                this.buffered++;
                i++;
            }
            if (this.buffered < BLOCK_LENGTH) { return; }
            Sha1::compress(&this.state, this.block.as_slice());
            this.buffered = 0;
        }
        while (length - i >= BLOCK_LENGTH) {
            Sha1::compress(&this.state, data.subslice(i, i + BLOCK_LENGTH));
            i += BLOCK_LENGTH;
        }
        while (i < length) {
            this.block[this.buffered] = p[i];
            this.buffered++;
            i++;
        }
    }

    /// Close the message and give its digest.
    public finish(mut this) -> Sha1Digest {
        const bit_length: u64 = this.message_length * 8;
        // A one bit, zeros up to 8 bytes short of a block boundary, then
        // the message's length in bits, big-endian.
        mut padding: [u8; 72] = [0; 72];
        padding[0] = 0x80;
        const zeros_to: i64 = if (this.buffered < 56) { 56 } else { 120 };
        const padding_length: i64 = zeros_to - this.buffered;
        for (mut b: i64 = 0; b < 8; b++) {
            padding[padding_length + b] = ((bit_length >> ((56 - b * 8) as u64)) & 0xFF) as u8;
        }
        this.update(padding.as_slice().subslice(0, padding_length + 8));
        mut digest: Sha1Digest = Sha1Digest { bytes: [0; 20] };
        for (mut w: i64 = 0; w < 5; w++) {
            const word: u32 = this.state[w];
            digest.bytes[w * 4]     = ((word >> 24) & 0xFF) as u8;
            digest.bytes[w * 4 + 1] = ((word >> 16) & 0xFF) as u8;
            digest.bytes[w * 4 + 2] = ((word >> 8) & 0xFF) as u8;
            digest.bytes[w * 4 + 3] = (word & 0xFF) as u8;
        }
        return digest;
    }

    /// Fold one 64-byte block into `state`.
    private static compress(state: mut &[u32; 5], block: &Slice<u8>) -> void {
        const p: u8* = block.as_pointer();
        mut schedule: [u32; 80] = [0; 80];
        for (mut t: i64 = 0; t < 16; t++) {
            schedule[t] = ((p[t * 4] as u32) << 24)
                        | ((p[t * 4 + 1] as u32) << 16)
                        | ((p[t * 4 + 2] as u32) << 8)
                        |  (p[t * 4 + 3] as u32);
        }
        for (mut t: i64 = 16; t < 80; t++) {
            const mixed: u32 = schedule[t - 3] ^ schedule[t - 8] ^ schedule[t - 14] ^ schedule[t - 16];
            schedule[t] = mixed.rotate_left(1);
        }
        mut a: u32 = state[0];
        mut b: u32 = state[1];
        mut c: u32 = state[2];
        mut d: u32 = state[3];
        mut e: u32 = state[4];
        for (mut t: i64 = 0; t < 80; t++) {
            // Each quarter of the rounds mixes b, c and d by its own
            // function, under its own constant.
            mut mixed: u32 = 0;
            mut constant: u32 = 0;
            if (t < 20) {
                mixed = (b & c) | ((~b) & d);
                constant = 0x5A827999;
            } else if (t < 40) {
                mixed = b ^ c ^ d;
                constant = 0x6ED9EBA1;
            } else if (t < 60) {
                mixed = (b & c) | (b & d) | (c & d);
                constant = 0x8F1BBCDC;
            } else {
                mixed = b ^ c ^ d;
                constant = 0xCA62C1D6;
            }
            const temp: u32 = a.rotate_left(5).wrapping_add(mixed).wrapping_add(e).wrapping_add(constant).wrapping_add(schedule[t]);
            e = d;
            d = c;
            c = b.rotate_left(30);
            b = a;
            a = temp;
        }
        state[0] = state[0].wrapping_add(a);
        state[1] = state[1].wrapping_add(b);
        state[2] = state[2].wrapping_add(c);
        state[3] = state[3].wrapping_add(d);
        state[4] = state[4].wrapping_add(e);
    }
}
