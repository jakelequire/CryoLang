///! hash: message digests.
///!
///! `sha256` is FIPS 180-4 and `sha1` is RFC 3174, the latter for
///! protocols that name it, such as the WebSocket handshake, and not as a
///! security primitive. Each has one shape: `Sha256` (`Sha1`) hashes a
///! message that arrives in pieces, `Sha256::digest` (`Sha1::digest`) one
///! held whole, and either gives a `Sha256Digest` (`Sha1Digest`). The
///! `Hash` trait and the hashers a hash table keys with are `core::hash`:
///! they allocate nothing and are the language's, where these are digests
///! of a whole message.

namespace std::hash;

module {
    hash::sha1;
    hash::sha256;
}

export std::hash::sha1::{ Sha1, Sha1Digest };
export std::hash::sha256::{ Sha256, Sha256Digest };
