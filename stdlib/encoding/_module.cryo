///! encoding: byte <-> text codecs.
///!
///! Self-contained, dependency-free implementations. `base64` is RFC 4648
///! (standard and URL-safe alphabets, padded or not); `percent` is RFC
///! 3986's percent-encoding; `sha1` is RFC 3174 (provided for the
///! WebSocket handshake, not as a security primitive); `sha256` is FIPS
///! 180-4; `hex` writes bytes as lowercase hexadecimal. Every decoder
///! reports a `DecodeError` naming the input byte it stopped at.

namespace std::encoding;

module {
    encoding::base64;
    encoding::error;
    encoding::hex;
    encoding::percent;
    encoding::sha1;
    encoding::sha256;
    encoding::utf16;
}
