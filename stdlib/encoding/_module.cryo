///! encoding: byte <-> text codecs.
///!
///! Self-contained, dependency-free implementations. `json` is RFC 8259
///! JSON, a directory module of its own; `base64` is RFC 4648
///! (standard and URL-safe alphabets, padded or not); `percent` is RFC
///! 3986's percent-encoding; `hex` writes bytes as lowercase hexadecimal.
///! Every decoder reports a `DecodeError` naming the input byte it stopped
///! at. `utf16` converts text for the Windows wide-character calls; `utf8`
///! reads one Unicode scalar at a byte position, strictly. The digests are
///! hashes, not encodings: they are `std::hash`.

namespace std::encoding;

module {
    encoding::base64;
    encoding::error;
    encoding::hex;
    encoding::json;
    encoding::percent;
    encoding::utf16;
    encoding::utf8;
}

export std::encoding::base64::{ Base64 };
export std::encoding::error::{ DecodeError, DecodeErrorKind };
export std::encoding::percent::{ PercentEncoding };
export std::encoding::utf16::{ Utf16 };
export std::encoding::utf8::{ DecodedScalar, Utf8 };
