///! encoding: byte <-> text codecs.
///!
///! Self-contained, dependency-free implementations. `base64` is RFC
///! 4648; `sha1` is RFC 3174 (provided for the WebSocket handshake, not
///! as a security primitive); `sha256` is FIPS 180-4; `hex` writes bytes
///! as lowercase hexadecimal.

namespace std::encoding;

module {
    encoding::base64;
    encoding::hex;
    encoding::sha1;
    encoding::sha256;
    encoding::utf16;
}
