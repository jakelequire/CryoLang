///! Hexadecimal text for bytes: two lowercase digits per byte, most
///! significant nibble first (`[0x0f, 0xa0]` is `0fa0`).

namespace std::encoding::hex;

import std::collections::string::{ String };
import std::core::slice::{ Slice };

const DIGITS: string = "0123456789abcdef";

/// `bytes` as lowercase hexadecimal, two digits per byte.
public function encode(bytes: &Slice<u8>) -> String {
    const length: i64 = bytes.length();
    mut text: String = String::with_capacity(length * 2);
    const p: u8* = bytes.as_ptr();
    for (mut i: i64 = 0; i < length; i++) {
        const byte: u8 = p[i];
        text.push_byte(DIGITS[(byte >> 4) as i64] as u8);
        text.push_byte(DIGITS[(byte & 0x0F) as i64] as u8);
    }
    return text;
}
