///! The error every decoder in `std::encoding` returns: what was wrong with
///! the input, and the byte offset in the input where it was found.

namespace std::encoding::error;

import std::collections::str::{ Str };
import std::core::result::{ Result };
import std::core::error::{ Error };
import std::fmt::display::{ Debug, Display, Formatter };
import std::fmt::error::{ FormatError };

/// What a decoder found wrong with its input.
public type enum DecodeErrorKind with [Eq, Debug] {
    /// A byte that is not part of the encoding's alphabet.
    InvalidCharacter;
    /// An input whose length no complete encoding can have.
    InvalidLength;
    /// Padding where the encoding allows none, or more of it than it allows.
    InvalidPadding;
    /// A `%` that two hexadecimal digits do not follow.
    InvalidEscape;
    /// Decoded bytes that are not well-formed UTF-8, where text was wanted.
    InvalidUtf8;
}

/// A decoding failure: its kind, and the byte offset in the input text at
/// which the decoder found it.
public type struct DecodeError with [Eq, Debug] {
    /// The byte offset in the input where decoding failed.
    public position: i64;
    /// What was wrong there.
    public kind: DecodeErrorKind;

    /// An error of `kind` found at byte `position` of the input.
    public static new(kind: DecodeErrorKind, position: i64) -> DecodeError {
        return DecodeError { position: position, kind: kind };
    }

    /// What went wrong, without the position; `Display` adds it.
    public describe(&this) -> Str {
        match (this.kind) {
            DecodeErrorKind::InvalidCharacter => { return Str::new("invalid character"); }
            DecodeErrorKind::InvalidLength => { return Str::new("invalid length"); }
            DecodeErrorKind::InvalidPadding => { return Str::new("invalid padding"); }
            DecodeErrorKind::InvalidEscape => { return Str::new("invalid percent escape"); }
            DecodeErrorKind::InvalidUtf8 => { return Str::new("decoded bytes are not UTF-8"); }
        }
    }
}

implement trait Error for struct DecodeError { }

implement trait Display for struct DecodeError {
    fmt(&this, f: mut &Formatter) -> Result<(), FormatError> {
        return f.write(f"{this.describe()} at byte {this.position}");
    }
}
