///! Base64 (RFC 4648) - standard alphabet, with padding.
///!
///! `encode` is what the WebSocket handshake needs (random key and the
///! SHA-1 accept value); `decode` rounds it out for general use.

namespace std::encoding::base64;

import std::core::option::{ Option };
import std::core::slice::{ Slice };
import std::collections::array::{ Array };
import std::collections::string::{ String };
import std::collections::str::{ Str };
import std::core::mem;

private const PAD: u8 = 0x3D;   // '='

/// Encode `len` bytes at `data` to a padded base64 `String`.
public function encode(data: u8*, len: i64) -> String {
    // The alphabet is a LOCAL const: a module-level `const Str = Str::new(..)`
    // reads back empty at runtime (fragile static init), which would make
    // the lookup index an empty table.
    const table: Slice<u8> = Str::new("ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/").as_bytes();
    mut out: String = String::with_capacity((len + 2) / 3 * 4);

    mut i: i64 = 0;
    while (i + 3 <= len) {
        const n: u32 = ((data[i] as u32) << 16)
                     | ((data[i + 1] as u32) << 8)
                     |  (data[i + 2] as u32);
        out.push_byte(table[(n >> 18) & 0x3F]);
        out.push_byte(table[(n >> 12) & 0x3F]);
        out.push_byte(table[(n >> 6)  & 0x3F]);
        out.push_byte(table[(n)       & 0x3F]);
        i = i + 3;
    }

    const rest: i64 = len - i;
    if (rest == 1) {
        const n: u32 = (data[i] as u32) << 16;
        out.push_byte(table[(n >> 18) & 0x3F]);
        out.push_byte(table[(n >> 12) & 0x3F]);
        out.push_byte(PAD);
        out.push_byte(PAD);
    }
    if (rest == 2) {
        const n: u32 = ((data[i] as u32) << 16) | ((data[i + 1] as u32) << 8);
        out.push_byte(table[(n >> 18) & 0x3F]);
        out.push_byte(table[(n >> 12) & 0x3F]);
        out.push_byte(table[(n >> 6)  & 0x3F]);
        out.push_byte(PAD);
    }
    return out;
}

/// Decode a base64 `Str`. Returns `None` on any invalid character or a
/// malformed length. Whitespace is not tolerated.
public function decode(source: Str) -> Option<Array<u8>> {
    const len: i64 = source.length();
    if (len % 4 != 0) { return Option::None; }
    mut out: Array<u8> = Array::<u8>::new();
    if (len == 0) { return Option::Some(out); }

    const bytes: Slice<u8> = source.as_bytes();
    mut i: i64 = 0;
    while (i < len) {
        mut acc: u32 = 0;
        mut pads: u32 = 0;
        mut j: i64 = 0;
        while (j < 4) {
            const ch: u8 = bytes[i + j];
            acc = acc << 6;
            if (ch == PAD) {
                pads = pads + 1;
            } else {
                match (decode_sym(ch)) {
                    Option::Some(v) => {
                        if (pads != 0) { mem::drop(out); return Option::None; } // pad mid-group
                        acc = acc | (v as u32);
                    }
                    Option::None => { mem::drop(out); return Option::None; }
                }
            }
            j++;
        }
        // Padding is only valid in the FINAL group, and at most two `=`.
        // Without this, `AB==CDEF` (pad before a later group) or `A===`
        // (3+ pads) would decode instead of being rejected per RFC 4648.
        if (pads != 0) {
            if (i + 4 < len) { mem::drop(out); return Option::None; }   // pad before final group
            if (pads > 2)    { mem::drop(out); return Option::None; }   // at most 2 pad chars
        }
        out.push(((acc >> 16) & 0xFF) as u8);
        if (pads < 2) { out.push(((acc >> 8) & 0xFF) as u8); }
        if (pads < 1) { out.push((acc & 0xFF) as u8); }
        i = i + 4;
    }
    return Option::Some(out);
}

/// Map a base64 character back to its 6-bit value, or `None`.
private function decode_sym(ch: u8) -> Option<u8> {
    if (ch >= 0x41 && ch <= 0x5A) { return Option::Some(ch - 0x41); }        // A-Z -> 0..25
    if (ch >= 0x61 && ch <= 0x7A) { return Option::Some(ch - 0x61 + 26); }   // a-z -> 26..51
    if (ch >= 0x30 && ch <= 0x39) { return Option::Some(ch - 0x30 + 52); }   // 0-9 -> 52..61
    if (ch == 0x2B) { return Option::Some(62); }                            // '+'
    if (ch == 0x2F) { return Option::Some(63); }                            // '/'
    return Option::None;
}
