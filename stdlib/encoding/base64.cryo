///! Base64 (RFC 4648): bytes as text drawn from a 64-character alphabet,
///! four characters for every three bytes.
///!
///! A `Base64` value names one of the four variants RFC 4648 defines: the
///! standard alphabet (`+` and `/`) or the URL- and filename-safe one (`-`
///! and `_`), each with or without the `=` padding that rounds the text up
///! to a multiple of four characters.
///!
///! ```cryo
///! import std::collections::str::{ Str };
///! import std::collections::string::{ String };
///! import std::encoding::base64::{ Base64 };
///!
///! const text: String = Base64::url_safe_unpadded().encode(Str::new("hi?").as_bytes());   // "aGk_"
///! ```

namespace std::encoding::base64;

import std::collections::array::{ Array };
import std::collections::str::{ Str };
import std::collections::string::{ String };
import std::core::option::{ Option };
import std::core::result::{ Result };
import std::core::slice::{ Slice };
import std::encoding::error::{ DecodeError, DecodeErrorKind };

/// The padding character, `=`.
private const PAD: u8 = 0x3D;

/// One base64 variant: an alphabet, and whether encoded text is padded.
/// Cheap to copy; make one with `standard`, `standard_unpadded`,
/// `url_safe` or `url_safe_unpadded`.
public type struct Base64 {
    /// The 64 characters, in the order of the values they stand for.
    private alphabet: Str;
    /// Whether `encode` pads to a multiple of four and `decode` requires it.
    private padded: boolean;

    /// The standard alphabet (`+`, `/`), padded with `=`.
    public static standard() -> Base64 {
        return Base64 { alphabet: Str::new("ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"), padded: true };
    }

    /// The standard alphabet, with no padding.
    public static standard_unpadded() -> Base64 {
        return Base64 { alphabet: Str::new("ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"), padded: false };
    }

    /// The URL- and filename-safe alphabet (`-`, `_`), padded with `=`.
    public static url_safe() -> Base64 {
        return Base64 { alphabet: Str::new("ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-_"), padded: true };
    }

    /// The URL- and filename-safe alphabet, with no padding: the form a
    /// URL or a token carries, since `=` itself needs escaping there.
    public static url_safe_unpadded() -> Base64 {
        return Base64 { alphabet: Str::new("ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-_"), padded: false };
    }

    /// The length of the text `encode` makes from `byte_count` bytes.
    public encoded_length(&this, byte_count: i64) -> i64 {
        if (this.padded) { return (byte_count + 2) / 3 * 4; }
        const rest: i64 = byte_count % 3;
        if (rest == 0) { return byte_count / 3 * 4; }
        return byte_count / 3 * 4 + rest + 1;
    }

    /// `bytes` as base64 text in this variant.
    public encode(&this, bytes: &Slice<u8>) -> String {
        mut text: String = String::with_capacity(this.encoded_length(bytes.length()));
        this.encode_into(bytes, &text);
        return text;
    }

    /// Append `bytes` as base64 text in this variant to `out`.
    public encode_into(&this, bytes: &Slice<u8>, out: mut &String) -> void {
        const table: &Slice<u8> = this.alphabet.as_bytes();
        const length: i64 = bytes.length();
        mut i: i64 = 0;
        while (i + 3 <= length) {
            const group: u32 = ((bytes[i] as u32) << 16) | ((bytes[i + 1] as u32) << 8) | (bytes[i + 2] as u32);
            out.push_byte(table[(group >> 18) & 0x3F]);
            out.push_byte(table[(group >> 12) & 0x3F]);
            out.push_byte(table[(group >> 6) & 0x3F]);
            out.push_byte(table[group & 0x3F]);
            i = i + 3;
        }
        const rest: i64 = length - i;
        if (rest == 0) { return; }
        mut group: u32 = (bytes[i] as u32) << 16;
        if (rest == 2) { group = group | ((bytes[i + 1] as u32) << 8); }
        out.push_byte(table[(group >> 18) & 0x3F]);
        out.push_byte(table[(group >> 12) & 0x3F]);
        if (rest == 2) { out.push_byte(table[(group >> 6) & 0x3F]); }
        if (this.padded) {
            out.push_byte(PAD);
            if (rest == 1) { out.push_byte(PAD); }
        }
    }

    /// The bytes `text` encodes in this variant. A padded variant requires
    /// the padding; an unpadded one refuses it. Whitespace is not skipped,
    /// and the error names the first byte that is wrong.
    public decode(&this, text: Str) -> Result<Array<u8>, DecodeError> {
        const bytes: &Slice<u8> = text.as_bytes();
        const length: i64 = bytes.length();
        mut data_length: i64 = length;
        if (this.padded) {
            if (length % 4 != 0) {
                return Result::Err(DecodeError::new(DecodeErrorKind::InvalidLength, length));
            }
            while (data_length > 0 && data_length > length - 2 && bytes[data_length - 1] == PAD) {
                data_length = data_length - 1;
            }
        }
        if (data_length % 4 == 1) {
            return Result::Err(DecodeError::new(DecodeErrorKind::InvalidLength, data_length));
        }
        mut out: Array<u8> = Array::<u8>::with_capacity(data_length / 4 * 3 + 2);
        mut accumulator: u32 = 0;
        mut bits: u32 = 0;
        for (mut i: i64 = 0; i < data_length; i++) {
            const byte: u8 = bytes[i];
            match (this.value_of(byte)) {
                Option::Some(value) => {
                    accumulator = (accumulator << 6) | (value as u32);
                    bits = bits + 6;
                    if (bits >= 8) {
                        bits = bits - 8;
                        out.push(((accumulator >> bits) & 0xFF) as u8);
                    }
                }
                Option::None => {
                    if (byte == PAD) {
                        return Result::Err(DecodeError::new(DecodeErrorKind::InvalidPadding, i));
                    }
                    return Result::Err(DecodeError::new(DecodeErrorKind::InvalidCharacter, i));
                }
            }
        }
        return Result::Ok(out);
    }

    /// The 6-bit value `byte` stands for in this variant's alphabet.
    private value_of(&this, byte: u8) -> Option<u8> {
        if (byte >= 0x41 && byte <= 0x5A) { return Option::Some(byte - 0x41); }
        if (byte >= 0x61 && byte <= 0x7A) { return Option::Some(byte - 0x61 + 26); }
        if (byte >= 0x30 && byte <= 0x39) { return Option::Some(byte - 0x30 + 52); }
        const table: &Slice<u8> = this.alphabet.as_bytes();
        if (byte == table[62]) { return Option::Some(62); }
        if (byte == table[63]) { return Option::Some(63); }
        return Option::None;
    }
}
