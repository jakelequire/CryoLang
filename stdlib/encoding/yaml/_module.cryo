///! yaml: YAML 1.2 text with the core schema, read into and written from
///! the shared data model `std::encoding::value::Value`.
///!
///! `Yaml::parse(text)` reads the one document a `Str` holds into a
///! `Result<Value, YamlError>`; `Yaml::parse_all(text)` reads every
///! document of a stream separated by `---`. `Yaml::to_text(&value)` writes
///! flow style on one line and `Yaml::to_pretty_text(&value)` block style,
///! indented by two spaces; `write_text` and `write_pretty_text` append to
///! a `String` the caller owns instead.
///!
///! The reader takes a safe subset of YAML 1.2: block and flow collections,
///! plain, quoted and block scalars, comments, several documents, and
///! anchors and aliases, whose expansion is bounded. Tags outside the core
///! schema, complex keys, the merge key `<<` and directives are refused,
///! each with a `YamlErrorKind` of its own. A plain scalar's type is the
///! core schema's, so `yes` and `no` are text, not booleans. A key is text
///! whatever its spelling.
///!
///! A type that reads and writes `Value` through `ToValue` and `FromValue`
///! reads and writes YAML too: `Yaml::parse` gives the `Value` its
///! `from_value` takes.
///!
///! Sub-modules:
///!   - `error`      - `YamlError`, `YamlErrorKind`
///!   - `parser`     - the reader behind `Yaml::parse` (with `MAX_DEPTH`
///!                    and `MAX_EXPANDED_NODES`)
///!   - `serializer` - the writer behind `Yaml`'s text writers

namespace std::encoding::yaml;

import std::core::result::{ Result };
import std::collections::array::{ Array };
import std::collections::string::{ String };
import std::collections::str::{ Str };
import std::encoding::value::model::{ Value };
import std::encoding::yaml::parser::{ Parser };
import std::encoding::yaml::serializer::{ Writer };

module {
    encoding::yaml::error;
    encoding::yaml::parser;
    encoding::yaml::serializer;
}

export std::encoding::yaml::error::{ YamlError, YamlErrorKind };

/// The YAML text format: reading a `Value` from YAML text and writing one
/// as YAML text.
public type struct Yaml {
    /// Read the one document `text` holds: `Value::Null` for text with no
    /// document, and `YamlErrorKind::MultipleDocuments` for text with more
    /// than one. The `YamlError` points at the first byte the reader could
    /// not take.
    public static parse(text: Str) -> Result<Value, YamlError> {
        return Parser::read_document(text);
    }

    /// Read every document `text` holds, in order: those separated by
    /// `---` and ended by `...`. Each document's anchors are its own.
    public static parse_all(text: Str) -> Result<Array<Value>, YamlError> {
        return Parser::read_documents(text);
    }

    /// `value` in flow style on one line: `{name: cryo, tags: [1, 2]}`.
    public static to_text(value: &Value) -> String {
        mut out: String = String::new();
        Writer::write_flow(&out, value, 0);
        return out;
    }

    /// `value` in block style: a mapping's entries and a sequence's items
    /// one per line, nested ones indented by two spaces, the text ending
    /// with a line break. An empty collection is written `{}` or `[]`.
    public static to_pretty_text(value: &Value) -> String {
        mut out: String = String::new();
        Writer::write_block(&out, value);
        return out;
    }

    /// Append `value` in flow style to `out`, as `to_text` writes it.
    public static write_text(out: mut &String, value: &Value) -> void {
        Writer::write_flow(out, value, 0);
    }

    /// Append `value` in block style to `out`, as `to_pretty_text` writes
    /// it.
    public static write_pretty_text(out: mut &String, value: &Value) -> void {
        Writer::write_block(out, value);
    }
}
