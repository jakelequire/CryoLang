///! UTF-16: the text encoding the Windows wide-character (`*W`) calls take.
///!
///! `Utf16::encode` turns UTF-8 text into NUL-terminated UTF-16 units, the
///! form every `*W` path and name parameter expects; `Utf16::decode` turns
///! units an OS call wrote back into a `String`. Both are plain Cryo, with no
///! OS dependency, so they build and behave the same on every target.

namespace std::encoding::utf16;

import std::core::option::{ Option };
import std::core::result::{ Result };
import std::core::slice::{ Slice };
import std::core::iter::{ Iterator };
import std::collections::array::{ Array };
import std::collections::string::{ String };
import std::collections::str::{ Str, Utf8Error };

private const SURROGATE_HIGH_FIRST: u32 = 0xD800;
private const SURROGATE_LOW_FIRST:  u32 = 0xDC00;
private const SURROGATE_LAST:       u32 = 0xDFFF;
private const SUPPLEMENTARY_FIRST:  u32 = 0x10000;

/// The UTF-16 codec. Stateless; its operations are statics.
public type struct Utf16 {
    /// `text` as UTF-16 code units followed by one NUL unit, ready to pass
    /// to a wide-character call. A malformed byte in `text` encodes as
    /// U+FFFD, as `Str::chars` reads it.
    public static encode(text: Str) -> Array<u16> {
        mut units: Array<u16> = Array::<u16>::with_capacity(text.length() + 1);
        for (scalar in text.chars()) {
            if (scalar < SUPPLEMENTARY_FIRST) {
                units.push(scalar as u16);
            } else {
                const offset: u32 = scalar - SUPPLEMENTARY_FIRST;
                units.push((SURROGATE_HIGH_FIRST + (offset >> 10)) as u16);
                units.push((SURROGATE_LOW_FIRST + (offset & 0x3FF)) as u16);
            }
        }
        units.push(0);
        return units;
    }

    /// The text in `units`, which end at the slice's end (a NUL unit, if
    /// present, is text like any other). A surrogate that is not half of a
    /// pair is refused: the error's `valid_up_to` is the index of the unit,
    /// and its `error_length` is `None` when the input ends on a high
    /// surrogate whose pair could still follow.
    public static decode(units: &Slice<u16>) -> Result<String, Utf8Error> {
        mut text: String = String::with_capacity(units.length());
        const count: i64 = units.length();
        mut index: i64 = 0;
        while (index < count) {
            const unit: u32 = units[index] as u32;
            if (unit < SURROGATE_HIGH_FIRST || unit > SURROGATE_LAST) {
                text.push_char(unit as char);
                index = index + 1;
                continue;
            }
            if (unit >= SURROGATE_LOW_FIRST) {
                return Result::Err(Utf8Error { valid_up_to: index, error_length: Option::Some(1) });
            }
            if (index + 1 == count) {
                return Result::Err(Utf8Error { valid_up_to: index, error_length: Option::None });
            }
            const low: u32 = units[index + 1] as u32;
            if (low < SURROGATE_LOW_FIRST || low > SURROGATE_LAST) {
                return Result::Err(Utf8Error { valid_up_to: index, error_length: Option::Some(1) });
            }
            const scalar: u32 = SUPPLEMENTARY_FIRST
                + ((unit - SURROGATE_HIGH_FIRST) << 10) + (low - SURROGATE_LOW_FIRST);
            text.push_char(scalar as char);
            index = index + 2;
        }
        return Result::Ok(text);
    }
}
