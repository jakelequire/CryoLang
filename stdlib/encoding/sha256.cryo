///! SHA-256 (FIPS 180-4).
///!
///! `Sha256` hashes a message that arrives in pieces: `update` with each
///! piece in order, then `finish` for the digest. `Sha256::digest` hashes
///! one message held whole. Either way the digest is a `Sha256Digest`, its
///! 32 bytes in the order the standard writes them, shown as 64 lowercase
///! hexadecimal digits.

namespace std::encoding::sha256;

import std::collections::str::{ Str };
import std::collections::string::{ String };
import std::core::cmp::{ Eq };
import std::core::result::{ Result };
import std::core::slice::{ Slice };
import std::encoding::hex;
import std::fmt::display::{ Display, Formatter };
import std::fmt::error::{ FmtError };

/// Bytes in a digest.
public const DIGEST_LENGTH: i64 = 32;

/// Bytes in the block the compression function consumes.
const BLOCK_LENGTH: i64 = 64;

/// A SHA-256 digest: the hash's 32 bytes, most significant byte of the
/// first word first.
public type struct Sha256Digest with [Eq] {
    private bytes: [u8; 32];

    /// The digest's bytes.
    public as_bytes(&this) -> &Slice<u8> {
        return this.bytes.as_slice();
    }

    /// The digest as 64 lowercase hexadecimal digits.
    public to_hex(&this) -> String {
        return hex::encode(this.as_bytes());
    }
}

implement trait Display for struct Sha256Digest {
    fmt(&this, f: mut &Formatter) -> Result<(), FmtError> {
        const text: String = this.to_hex();
        return f.write_str(text.as_str());
    }
}

/// A SHA-256 computation in progress: the message so far, fed in order by
/// `update`, and closed by `finish`.
public type struct Sha256 {
    private state:          [u32; 8];
    /// The bytes of a block not yet complete, `buffered` of them.
    private block:          [u8; 64];
    private buffered:       i64;
    /// Bytes of message fed so far.
    private message_length: u64;

    /// A computation over the empty message.
    public static new() -> Sha256 {
        return Sha256 {
            state: [0x6A09E667, 0xBB67AE85, 0x3C6EF372, 0xA54FF53A,
                    0x510E527F, 0x9B05688C, 0x1F83D9AB, 0x5BE0CD19],
            block: [0; 64],
            buffered: 0,
            message_length: 0,
        };
    }

    /// The digest of `data`, held whole.
    public static digest(data: &Slice<u8>) -> Sha256Digest {
        mut hasher: Sha256 = Sha256::new();
        hasher.update(data);
        return hasher.finish();
    }

    /// Append `data` to the message.
    public update(mut &this, data: &Slice<u8>) -> void {
        const length: i64 = data.length();
        const p: u8* = data.as_ptr();
        this.message_length += length as u64;
        mut i: i64 = 0;
        if (this.buffered > 0) {
            while (i < length && this.buffered < BLOCK_LENGTH) {
                this.block[this.buffered] = p[i];
                this.buffered++;
                i++;
            }
            if (this.buffered < BLOCK_LENGTH) { return; }
            Sha256::compress(&this.state, this.block.as_slice());
            this.buffered = 0;
        }
        while (length - i >= BLOCK_LENGTH) {
            Sha256::compress(&this.state, data.subslice(i, i + BLOCK_LENGTH));
            i += BLOCK_LENGTH;
        }
        while (i < length) {
            this.block[this.buffered] = p[i];
            this.buffered++;
            i++;
        }
    }

    /// Close the message and give its digest.
    public finish(mut this) -> Sha256Digest {
        const bit_length: u64 = this.message_length * 8;
        // A one bit, zeros up to 8 bytes short of a block boundary, then
        // the message's length in bits, big-endian.
        mut padding: [u8; 72] = [0; 72];
        padding[0] = 0x80;
        const zeros_to: i64 = if (this.buffered < 56) { 56 } else { 120 };
        const padding_length: i64 = zeros_to - this.buffered;
        for (mut b: i64 = 0; b < 8; b++) {
            padding[padding_length + b] = ((bit_length >> ((56 - b * 8) as u64)) & 0xFF) as u8;
        }
        this.update(padding.as_slice().subslice(0, padding_length + 8));
        mut digest: Sha256Digest = Sha256Digest { bytes: [0; 32] };
        for (mut w: i64 = 0; w < 8; w++) {
            const word: u32 = this.state[w];
            digest.bytes[w * 4]     = ((word >> 24) & 0xFF) as u8;
            digest.bytes[w * 4 + 1] = ((word >> 16) & 0xFF) as u8;
            digest.bytes[w * 4 + 2] = ((word >> 8) & 0xFF) as u8;
            digest.bytes[w * 4 + 3] = (word & 0xFF) as u8;
        }
        return digest;
    }

    /// Fold one 64-byte block into `state`.
    private static compress(state: mut &[u32; 8], block: &Slice<u8>) -> void {
        const round_constants: [u32; 64] = [
            0x428A2F98, 0x71374491, 0xB5C0FBCF, 0xE9B5DBA5, 0x3956C25B, 0x59F111F1, 0x923F82A4, 0xAB1C5ED5,
            0xD807AA98, 0x12835B01, 0x243185BE, 0x550C7DC3, 0x72BE5D74, 0x80DEB1FE, 0x9BDC06A7, 0xC19BF174,
            0xE49B69C1, 0xEFBE4786, 0x0FC19DC6, 0x240CA1CC, 0x2DE92C6F, 0x4A7484AA, 0x5CB0A9DC, 0x76F988DA,
            0x983E5152, 0xA831C66D, 0xB00327C8, 0xBF597FC7, 0xC6E00BF3, 0xD5A79147, 0x06CA6351, 0x14292967,
            0x27B70A85, 0x2E1B2138, 0x4D2C6DFC, 0x53380D13, 0x650A7354, 0x766A0ABB, 0x81C2C92E, 0x92722C85,
            0xA2BFE8A1, 0xA81A664B, 0xC24B8B70, 0xC76C51A3, 0xD192E819, 0xD6990624, 0xF40E3585, 0x106AA070,
            0x19A4C116, 0x1E376C08, 0x2748774C, 0x34B0BCB5, 0x391C0CB3, 0x4ED8AA4A, 0x5B9CCA4F, 0x682E6FF3,
            0x748F82EE, 0x78A5636F, 0x84C87814, 0x8CC70208, 0x90BEFFFA, 0xA4506CEB, 0xBEF9A3F7, 0xC67178F2
        ];
        const p: u8* = block.as_ptr();
        mut schedule: [u32; 64] = [0; 64];
        for (mut t: i64 = 0; t < 16; t++) {
            schedule[t] = ((p[t * 4] as u32) << 24)
                        | ((p[t * 4 + 1] as u32) << 16)
                        | ((p[t * 4 + 2] as u32) << 8)
                        |  (p[t * 4 + 3] as u32);
        }
        for (mut t: i64 = 16; t < 64; t++) {
            const w15: u32 = schedule[t - 15];
            const w2: u32 = schedule[t - 2];
            const s0: u32 = w15.rotate_right(7) ^ w15.rotate_right(18) ^ (w15 >> 3);
            const s1: u32 = w2.rotate_right(17) ^ w2.rotate_right(19) ^ (w2 >> 10);
            schedule[t] = schedule[t - 16] + s0 + schedule[t - 7] + s1;
        }
        mut a: u32 = state[0];
        mut b: u32 = state[1];
        mut c: u32 = state[2];
        mut d: u32 = state[3];
        mut e: u32 = state[4];
        mut f: u32 = state[5];
        mut g: u32 = state[6];
        mut h: u32 = state[7];
        for (mut t: i64 = 0; t < 64; t++) {
            const sum1: u32 = e.rotate_right(6) ^ e.rotate_right(11) ^ e.rotate_right(25);
            const choice: u32 = (e & f) ^ ((~e) & g);
            const temp1: u32 = h + sum1 + choice + round_constants[t] + schedule[t];
            const sum0: u32 = a.rotate_right(2) ^ a.rotate_right(13) ^ a.rotate_right(22);
            const majority: u32 = (a & b) ^ (a & c) ^ (b & c);
            const temp2: u32 = sum0 + majority;
            h = g;
            g = f;
            f = e;
            e = d + temp1;
            d = c;
            c = b;
            b = a;
            a = temp1 + temp2;
        }
        state[0] = state[0] + a;
        state[1] = state[1] + b;
        state[2] = state[2] + c;
        state[3] = state[3] + d;
        state[4] = state[4] + e;
        state[5] = state[5] + f;
        state[6] = state[6] + g;
        state[7] = state[7] + h;
    }
}
