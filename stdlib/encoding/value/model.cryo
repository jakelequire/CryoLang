///! Value: tagged union over the six kinds of the shared data model.
///!
///! `Null`, `Bool`, `Number`, `String`, `Array`, `Object`. The enum is
///! recursive through `Array<Value>` and `Object` (whose value
///! storage is also `Array<Value>`). Each owning variant holds heap
///! storage; `drop` recursively frees the tree.
///!
///! `Number` preserves the source kind (Int/UInt/Float) so an
///! integer parsed from `42` round-trips as `42`, not `42.0`. Lossy
///! conversion to `f64` is opt-in via `as_f64()`.
///!
///! Object access is O(1) average via a hash index; insertion order is
///! preserved (parallel `keys` array) so serialization is deterministic.

namespace std::encoding::value::model;

import std::core::option::{ Option };
import std::core::result::{ Result };
import std::core::hash;
import std::core::cmp;
import std::core::drop::{ Drop };
import std::core::convert::{ ConversionError, TryFrom };
import std::collections::array::{ Array };
import std::collections::hashmap::{ HashMap };
import std::collections::string::{ String };
import std::collections::str::{ Str };
import std::fmt::display::{ Debug, Display, Formatter };
import std::fmt::error::{ FormatError };
import std::encoding::json::{ Json };

/// JSON's single number type, split by source representation so
/// integers round-trip exactly. `Int` covers signed values that fit
/// `i64`; `UInt` carries values in `(i64::MAX, u64::MAX]`; everything
/// else (decimals, exponents, NaN-shaped inputs the parser accepts as
/// floats) is `Float`.
public type enum Number with [Debug] {
    Int(i64);
    UInt(u64);
    Float(f64);
}

implement enum Number {
    /// Try to view as a signed 64-bit integer.
    /// `UInt` values that exceed `i64::MAX` and any `Float` with a
    /// fractional component return `None`.
    public as_i64(&this) -> Option<i64> {
        match (this) {
            Number::Int(v)   => { return Option::Some(v); }
            Number::UInt(v)  => {
                if (v <= i64::MAX as u64) { return Option::Some(v as i64); }
                return Option::None;
            }
            Number::Float(v) => {
                const t: f64 = v as i64 as f64;
                if (t == v && v >= i64::MIN as f64 && v <= i64::MAX as f64) {
                    return Option::Some(v as i64);
                }
                return Option::None;
            }
        }
    }

    /// Try to view as an unsigned 64-bit integer.
    public as_u64(&this) -> Option<u64> {
        match (this) {
            Number::Int(v)   => {
                if (v >= 0) { return Option::Some(v as u64); }
                return Option::None;
            }
            Number::UInt(v)  => { return Option::Some(v); }
            Number::Float(v) => {
                const t: f64 = v as u64 as f64;
                if (t == v && v >= 0.0) { return Option::Some(v as u64); }
                return Option::None;
            }
        }
    }

    /// Always-succeeds f64 view. `Int`/`UInt` values larger than 2^53
    /// lose precision in the conversion.
    public as_f64(&this) -> f64 {
        return match (this) {
            Number::Int(v)   => { v as f64 }
            Number::UInt(v)  => { v as f64 }
            Number::Float(v) => { v }
        };
    }
}

/// JSON object. Insertion-ordered keys + parallel value array; a
/// HashMap from `String` to slot index gives O(1) lookup. Owns its keys
/// and values, and releases them when it goes out of scope.
///
/// The string keys are owned. The `index` HashMap stores `String`
/// keys (cloned from the parallel `keys` array) so lookup is by
/// caller-supplied `Str` without forcing an allocation per probe.
![language("json_object")]
public type struct Object {
    private keys:   Array<String>;
    private values: Array<Value>;
    private index:  HashMap<String, i64>;

    /// An object with no entries.
    public static new() -> Object {
        return Object {
            keys:   Array::<String>::new(),
            values: Array::<Value>::new(),
            index:  HashMap::<String, i64>::new(),
        };
    }

    /// An object with no entries and room for `capacity` of them before
    /// its storage grows.
    public static with_capacity(capacity: i64) -> Object {
        return Object {
            keys:   Array::<String>::with_capacity(capacity),
            values: Array::<Value>::with_capacity(capacity),
            index:  HashMap::<String, i64>::with_capacity(capacity),
        };
    }

    /// The number of entries; a key inserted twice counts once.
    ![inline]
    public length(&this) -> i64 {
        return this.keys.length();
    }

    /// Whether the object has no entries.
    public is_empty(&this) -> boolean {
        return this.keys.length() == 0;
    }

    /// Insert or overwrite the entry for `key`. Takes ownership of
    /// both the key `String` and the `value`. If the key already
    /// exists, the previous value is dropped and the slot reused.
    ///
    /// ## Duplicate-key policy (stable)
    ///
    /// Last value wins. When a document (or repeated `insert`) supplies
    /// the same key more than once, the final occurrence's value is the
    /// one retained; earlier values are dropped. The key keeps its
    /// ORIGINAL insertion position (the existing slot is updated in
    /// place, not re-appended), so iteration order is the order of first
    /// appearance; RFC 8259 section 4 permits it. The parser does NOT reject
    /// duplicate keys - this is a guaranteed, stable part of the API.
    public insert(mut &this, key: String, value: Value) -> void {
        match (this.index.get(&key)) {
            Option::Some(slot) => {
                // Key already present: overwrite in place. `Array::set`
                // drops the previous occupant before reusing the slot,
                // so the old value's heap payload is released for us. The
                // duplicate `key` is dropped at scope exit by synthesis.
                this.values.set(slot, value);
                mut _duplicate_key: String = key;
                return;
            }
            Option::None => { }
        }
        const slot: i64 = this.keys.length();
        // The HashMap and the keys array each take ownership of their
        // own copy of the string. Cloning here keeps the lifetimes
        // independent; the index can outlive a value mutation.
        mut key_for_index: String = String::from_str(key.as_str());
        this.keys.push(key);
        this.values.push(value);
        this.index.insert(key_for_index, slot);
    }

    /// Insert with a raw NUL-terminated `string` (C-string) key,
    /// interned to an owned `String` internally. The ergonomic shortcut
    /// for the common `insert(String::from_str(Str::from(k)), v)`.
    public put(mut &this, key: string, value: Value) -> void {
        this.insert(String::from_str(Str::from(key)), value);
    }

    /// Look up a value by key. Returns a read-only borrowed pointer that
    /// is valid until the next mutating operation.
    public get(&this, key: Str) -> Option<Value*> {
        // The HashMap stores String keys; we wrap the borrowed Str in
        // a temporary String for the lookup. `String::from_str` does
        // copy; small price for the API ergonomics. A v1.x
        // optimization is to teach HashMap to take borrowed keys.
        mut probe: String = String::from_str(key);
        const slot: i64 = this.index.get(&probe)?;
        return this.values.get_reference(slot);
    }

    /// Like `get`, but the borrow is writable: change the value in place
    /// through it.  Valid until the next mutating operation.
    public get_mutable(mut &this, key: Str) -> Option<mut Value*> {
        mut probe: String = String::from_str(key);
        const slot: i64 = this.index.get(&probe)?;
        return Option::Some(this.values.index_mutable(slot));
    }

    /// Borrow the key at `index`. Returns `None` if `index` is outside
    /// `[0, length)`.
    public key_at(&this, index: i64) -> Option<Str> {
        if (index < 0 || index >= this.keys.length()) { return Option::None; }
        return Option::Some(this.keys[index].as_str());
    }

    /// Borrow the value at `index`, or `None` outside `[0, length)`.
    public value_at(&this, index: i64) -> Option<Value*> {
        return this.values.get_reference(index);
    }

    /// Whether the object has an entry for `key`.
    public contains(&this, key: Str) -> boolean {
        return this.get(key).is_some();
    }

}

/// One JSON value. Recursive through `Array` and `Object`.
![language("json_value")]
public type enum Value {
    Null;
    Bool(boolean);
    Number(Number);
    String(String);
    Array(Array<Value>);
    Object(Object);
}

implement enum Value {
    /// The JSON boolean `b`: `true` or `false`.
    public static boolean_value(b: boolean) -> Value { return Value::Bool(b); }
    /// The JSON number `n`, kept as a signed integer (`Number::Int`) so
    /// it is written back without a fraction.
    public static integer_value(n: i64) -> Value { return Value::Number(Number::Int(n)); }
    /// The JSON number `n`, kept as an unsigned integer (`Number::UInt`)
    /// so it is written back exactly, values above `i64::MAX` included.
    public static unsigned_integer_value(n: u64) -> Value { return Value::Number(Number::UInt(n)); }

    /// JSON string value from a text `src`. `static match (T)` restricts
    /// the accepted types to a borrowed `Str` or a raw NUL-terminated
    /// `string` (C-string), copying either into an owned `String`. The
    /// match deliberately admits no numeric/boolean arm: those go through
    /// `integer_value` / `unsigned_integer_value` / `boolean_value` or a `Number` variant,
    /// so a number never silently becomes a JSON *string*.
    public static from<T>(src: T) -> Value {
        // Build the owned String in each arm via a CONCRETE constructor
        // (never the generic `String::from`, whose inner type argument would
        // stay abstract under monomorphization), then wrap once outside the
        // dispatch.  The `static match` is used in STATEMENT position
        // (assigning `owned`) and the enclosing value returns a local - the
        // same "build a local, return the local" shape as `String::from`.
        // This keeps `from` compilable by a bootstrap compiler that predates
        // the drop-insertion fix for aggregate-yielding static-match arms.
        mut owned: String = String::new();
        static match (T) {
            Str    => { owned = String::from_str(src); }
            string => { owned = String::from_str(Str::new(src)); }
        }
        return Value::String(owned);
    }

    /// JSON array of strings from a raw `[string]`. Each element is
    /// escaped at serialize time.
    public static string_array(items: &[string]) -> Value {
        mut arr: Array<Value> = Array::<Value>::new();
        for (mut i: i64 = 0; i < items.length(); i++) {
            arr.push(Value::from(items[i]));
        }
        return Value::Array(arr);
    }

    // Variant queries

    /// Whether this is the JSON `null`.
    public is_null(&this)   -> boolean { return match (this) { Value::Null => { true } _ => { false } }; }
    /// Whether this is a JSON boolean.
    public is_boolean(&this) -> boolean { return match (this) { Value::Bool(_) => { true } _ => { false } }; }
    /// Whether this is a JSON number, integer or not.
    public is_number(&this) -> boolean { return match (this) { Value::Number(_) => { true } _ => { false } }; }
    /// Whether this is a JSON string.
    public is_string(&this) -> boolean { return match (this) { Value::String(_) => { true } _ => { false } }; }
    /// Whether this is a JSON array.
    public is_array(&this)  -> boolean { return match (this) { Value::Array(_) => { true } _ => { false } }; }
    /// Whether this is a JSON object.
    public is_object(&this) -> boolean { return match (this) { Value::Object(_) => { true } _ => { false } }; }

    // Path access: chain through nested objects/arrays.
    //
    // Note: there is intentionally no `as_object`/`as_array` returning a
    // `Object*`/`Array<Value>*`.  A match binding for an inline
    // enum payload aliases a temporary, so returning a pointer to the
    // payload struct dangles.  Work with composites through `get` / `at` /
    // `length` (which return `Value*` into stable heap storage, or a
    // scalar) instead - that is the sound, supported surface.

    /// `obj.get("key")` for object variants; `None` for everything else.
    public get(&this, key: Str) -> Option<Value*> {
        return match (&this) {
            Value::Object(obj) => { obj.get(key) }
            _                      => { Option::None }
        };
    }

    /// Array index access; `None` outside `[0, length)` or on a non-array.
    public at(&this, index: i64) -> Option<Value*> {
        match (&this) {
            Value::Array(arr) => { return arr.get_reference(index); }
            _ => { return Option::None; }
        }
    }

    /// Number of children (object entries / array elements). 0 for
    /// scalars.
    ![inline]
    public length(&this) -> i64 {
        return match (&this) {
            Value::Array(arr)  => { arr.length() }
            Value::Object(obj) => { obj.length() }
            _                      => { 0 }
        };
    }

}

/// Typed scalar extraction from a `Value`, dispatched on the
/// requested type `T`.  `json.as::<i64>()` yields `Some` when the value is
/// a number representable as `i64`, else `None`; likewise `as::<boolean>`,
/// `as::<u64>`, `as::<f64>`, and `as::<Str>` (a borrow into the value's
/// owned string, valid for the Value's lifetime).
///
/// It routes through the open `TryFrom<&Value>` abstraction, so any
/// `T` a caller teaches `TryFrom<&Value>` (see below) is readable via
/// `as::<T>()` too, with no change here.  A conversion error - wrong
/// variant, or a number out of range for `T` - becomes `None`; use
/// `T::try_from(&json)` directly when the reason matters.
public type trait Extract {
    /// The value read as a `T`, or `None` when `T::try_from` refuses it:
    /// the wrong variant, or a number that `T` cannot hold exactly
    /// (`as::<f64>()` takes any number, rounding an integer beyond 2^53).
    ///
    /// ```cryo
    /// import std::core::option::{ Option };
    /// import std::encoding::value::{ Value, Extract };
    ///
    /// const count: Value = Value::integer_value(42);
    /// const number: i64 = count.as::<i64>().unwrap();     // 42
    /// const flag: Option<boolean> = count.as::<boolean>(); // None
    /// ```
    as<T>(&this) -> Option<T> where T: TryFrom<&Value> {
        return match (T::try_from(this)) {
            Result::Ok(v)  => { Option::Some(v) }
            Result::Err(_) => { Option::None }
        };
    }
}

implement trait Extract for Value { }

// TryFrom<&Value>: extract typed scalars from a Value borrow.
//
// Each implementation says "here is how to extract a `T` from a
// `Value` borrow." Implementations return `Err(ConversionError)`
// when the variant doesn't match (e.g. asking for `i64` from a
// `Bool`) or when the value can't be represented as `T` without loss
// (`UInt(u64::MAX)` requested as `i64`).
//
// Third-party types can implement `TryFrom<&Value>` to slot into
// generic `T::try_from(&json)` getters without touching the stdlib.

implement trait TryFrom<&Value> for boolean {
    static try_from(value: &Value) -> Result<boolean, ConversionError> {
        return match (value) {
            Value::Bool(b) => { Result::Ok(b) }
            _                  => {
                Result::Err(ConversionError::new("Value is not a Bool"))
            }
        };
    }
}

implement trait TryFrom<&Value> for i64 {
    static try_from(value: &Value) -> Result<i64, ConversionError> {
        match (value) {
            Value::Number(n) => {
                match (n.as_i64()) {
                    Option::Some(x) => { return Result::Ok(x); }
                    Option::None    => { }
                }
            }
            _ => { }
        }
        return Result::Err(ConversionError::new(
            "Value is not representable as i64"));
    }
}

implement trait TryFrom<&Value> for u64 {
    static try_from(value: &Value) -> Result<u64, ConversionError> {
        match (value) {
            Value::Number(n) => {
                match (n.as_u64()) {
                    Option::Some(x) => { return Result::Ok(x); }
                    Option::None    => { }
                }
            }
            _ => { }
        }
        return Result::Err(ConversionError::new(
            "Value is not representable as u64"));
    }
}

implement trait TryFrom<&Value> for f64 {
    static try_from(value: &Value) -> Result<f64, ConversionError> {
        return match (value) {
            Value::Number(n) => { Result::Ok(n.as_f64()) }
            _                    => {
                Result::Err(ConversionError::new("Value is not a Number"))
            }
        };
    }
}

/// `Str` is a non-owning view into the Value's owned `String`.
/// Valid for the lifetime of the parent `Value`.
implement trait TryFrom<&Value> for Str {
    static try_from(value: &Value) -> Result<Str, ConversionError> {
        return match (value) {
            Value::String(s) => { Result::Ok(s.as_str()) }
            _                    => {
                Result::Err(ConversionError::new("Value is not a String"))
            }
        };
    }
}

/// The keys, values and index are released by their fields after this
/// body. `Array<T>::drop` and `HashMap<K, V>::drop` release their
/// elements, so nothing iterates by hand here.
implement trait Drop for struct Object {
    drop(mut &this) -> void { }
}

/// The `String` / `Array` / `Object` payload is released after this body,
/// and `Array<Value>::drop` releases each element.
implement trait Drop for enum Value {
    drop(mut &this) -> void { }
}

/// The compact JSON text, as `Json::to_text` writes it:
/// `{"name":"cryo","tags":[1,2]}`.
implement trait Display for enum Value {
    fmt(&this, f: mut &Formatter) -> Result<(), FormatError> {
        const text: String = Json::to_text(this);
        return f.write_str(text.as_str());
    }
}

/// The tree, each node named by its variant:
/// `Object({"tags": Array([Number(Int(1))])})`.
implement trait Debug for enum Value {
    fmt(&this, f: mut &Formatter) -> Result<(), FormatError> {
        match (&this) {
            Value::Null => { return f.write_str(Str::new("Null")); }
            Value::Bool(value) => { return f.debug_tuple("Bool").field(value).finish(); }
            Value::Number(value) => { return f.debug_tuple("Number").field(value).finish(); }
            Value::String(value) => { return f.debug_tuple("String").field(value).finish(); }
            Value::Array(value) => { return f.debug_tuple("Array").field(value).finish(); }
            Value::Object(value) => { return f.debug_tuple("Object").field(value).finish(); }
        }
    }
}

/// The entries in insertion order, each value as its tree:
/// `{"name": String("cryo")}`.
implement trait Debug for struct Object {
    fmt(&this, f: mut &Formatter) -> Result<(), FormatError> {
        f.write_str(Str::new("{"))?;
        for (mut i: i64 = 0; i < this.length(); i++) {
            if (i > 0) { f.write_str(Str::new(", "))?; }
            match (this.key_at(i)) {
                Option::Some(key) => { (Debug for Str)::fmt(&key, f)?; }
                Option::None => { }
            }
            f.write_str(Str::new(": "))?;
            match (this.value_at(i)) {
                Option::Some(value) => { (Debug for Value)::fmt(value, f)?; }
                Option::None => { }
            }
        }
        return f.write_str(Str::new("}"));
    }
}
