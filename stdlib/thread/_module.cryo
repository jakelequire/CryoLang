///! std::thread: native OS threads.
///!
///! Spawn a thread with `thread::spawn(body)`: `body` is a callable taking
///! no arguments - a `move` closure, a non-capturing lambda or a named
///! function - and it is moved into the new thread. The returned
///! `JoinHandle<T>` hands back the body's `T` result via `join()`:
///!
///!   ```cryo
///!   const n: i32 = 21;
///!   const h = thread::spawn(move () -> i32 { return n * 2; });
///!   const r: i32 = h.join();   // 42
///!   ```
///!
///! Owned data (String, Box, Array, ...) can be moved across the thread
///! boundary in either direction - into the thread as a capture of a
///! `move` closure, and back out through the returned `T`. The
///! move-checker tracks the transfer, so there is no aliasing and no
///! double-free.
///!
///! The body must be `Send`, and so must its result. A closure written
///! without `move` borrows from the spawning function, which may return
///! while the thread still runs, so it is refused; the fix writes `move`.
///!
///! ## Implementation
///!
///! Each spawn heap-allocates a `Payload<F,T>` (the body) and a
///! `Shared<T>` control block (an atomic state byte plus storage for the
///! result). The OS thread runs a monomorphized `thread_trampoline<F,T>`,
///! which moves the body out, frees the payload, runs the body, stores the
///! result, and hands the control block off to `join`/`detach` via a
///! lock-free two-actor handshake on the state byte, freeing the payload on
///! every path (spawn-failure included) so the control block never leaks.
///!
///! ## Lifecycle
///!
///! A `JoinHandle<T>` must be `join()`ed (waits, returns `T`) or
///! `detach()`ed (fire-and-forget). Dropping a handle without either is
///! equivalent to `detach()`. `is_finished()` polls without consuming.
///! `try_spawn` is the fallible variant (returns `Result` instead of
///! panicking on OS thread-creation failure).
///!
///! ## Scoped threads
///!
///! `thread::scope(body)` runs `body` with a scope handle, `s`, and joins
///! every thread spawned through `s.spawn(...)` before it returns. A scoped
///! thread may therefore borrow the variables of the function that called
///! `scope`: a closure written without `move` is accepted by `s.spawn` when
///! everything it borrows is `Sync`.
///!
///!   ```cryo
///!   const words: [String] = [String::from("a"), String::from("bc")];
///!   const total: Mutex<i64> = Mutex::<i64>::new(0);
///!   thread::scope((s: mut &thread::Scope) -> void {
///!       s.spawn(() -> void { mut g = total.lock(); *g.as_mutable_ptr() += words[0].length() as i64; });
///!       s.spawn(() -> void { mut g = total.lock(); *g.as_mutable_ptr() += words[1].length() as i64; });
///!   });
///!   // both threads are joined here; `total` holds 3
///!   ```
///!
///! The handle never leaves the scope's body: it may only be a `&Scope` /
///! `mut &Scope` local or parameter, or be used by a closure written without
///! `move`, and it is not `Send`, so a scoped thread cannot spawn through it.
///!
///! Sub-modules:
///!   - `local` : `ThreadLocal<T>`, per-thread storage.

namespace std::thread;

import std::core::intrinsics;
import std::core::ptr::{ NonNull };
import std::core::result::{ Result };
import std::core::drop::{ Drop };
import std::alloc::layout::{ Layout };
import std::alloc::allocator::{ GlobalAlloc };
import std::collections::array;
import std::collections::str::{ Str };
import std::core::error::{ Error };
import std::fmt::display::{ Debug, Display, Formatter };
import std::fmt::error::{ FmtError };
import std::ffi::libc::{
    pthread_attr_destroy, pthread_attr_init, pthread_attr_setstacksize,
    pthread_create, pthread_detach, pthread_equal, pthread_join, pthread_self,
    pthread_setname_np, sched_yield
};
import std::time::clock;
import std::time::duration::{ Duration };
import std::sys::syscall::{ SYSTEM_INFO_PARTIAL };
import std::sync::atomic::{ Atomic, MemoryOrder };

module thread::local;


// ---------------------------------------------------------------------------
// Per-OS thread primitives.  ConfigGating only evaluates file-scope
// declarations (never struct method bodies or generic instantiations), so
// every pthread/Win32 call lives in one of these gated free functions and the
// rest of the module is platform-agnostic.
//
// `JoinHandle`/`Scope` store `tid: u64`.  On POSIX that holds a `pthread_t`;
// on Windows it holds the thread HANDLE returned by `CreateThread` (a pointer
// widened to u64).  `os_join`/`os_detach` reinterpret it per platform.  Note
// `thread::current()` returns the Win32 thread *id* (GetCurrentThreadId),
// which is a different namespace from a HANDLE - comparing a `current()` id
// against a `JoinHandle::id()` is not meaningful on Windows (a known v1 gap).
// ---------------------------------------------------------------------------

![target(unix)]
private function os_join(tid: u64) -> void {
    mut ret: mut u8* = null;
    pthread_join(tid, &ret);
}
![target(windows)]
private function os_join(tid: u64) -> void {
    const h: u8* = tid as u8*;
    syscall::WaitForSingleObject(h, syscall::INFINITE);
    syscall::CloseHandle(h);
}

![target(unix)]
private function os_detach(tid: u64) -> void { pthread_detach(tid); }
![target(windows)]
private function os_detach(tid: u64) -> void { syscall::CloseHandle(tid as u8*); }

![target(unix)]
private function os_thread_equal(a: u64, b: u64) -> boolean { return pthread_equal(a, b) != 0; }
![target(windows)]
private function os_thread_equal(a: u64, b: u64) -> boolean { return a == b; }

![target(unix)]
private function os_thread_self() -> u64 { return pthread_self(); }
![target(windows)]
private function os_thread_self() -> u64 { return syscall::GetCurrentThreadId() as u64; }

![target(unix)]
private function os_yield() -> void { sched_yield(); }
![target(windows)]
private function os_yield() -> void { syscall::SwitchToThread(); }


// Best-effort OS-visible thread name.  POSIX has pthread_setname_np; Windows
// has SetThreadDescription, which takes a UTF-16 string applied to a thread
// HANDLE (`tid` holds the CreateThread HANDLE on Windows).  Naming is
// best-effort - a failure (or an old Windows without the API) never affects
// correctness.
![target(linux)]
private function os_set_thread_name(tid: u64, name: u8*) -> void { pthread_setname_np(tid, name); }
![target(windows)]
private function os_set_thread_name(tid: u64, name: u8*) -> void {
    // The Builder caps names at MAX_THREAD_NAME (15) bytes, so a 16-wchar
    // buffer (incl. the NUL) always holds the UTF-16 form.  `-1` length tells
    // MultiByteToWideChar the input is NUL-terminated (and to NUL-terminate
    // the output).
    mut wbuf: [u16; 16];
    mut i: u64 = 0;
    while (i < 16) { wbuf[i] = 0; i = i + 1; }
    const n: i32 = syscall::MultiByteToWideChar(syscall::CP_UTF8, 0,
                                                name, -1, &wbuf[0], 16);
    if (n <= 0) { return; }
    syscall::SetThreadDescription(tid as u8*, &wbuf[0]);
}


// ---------------------------------------------------------------------------
// Control-block state machine (single atomic byte, two actors: the spawned
// thread and the JoinHandle). Each actor performs exactly one `swap`; the
// actor that observes the OTHER has already finished owns the teardown.
// ---------------------------------------------------------------------------

/// Neither actor has reached its terminal point yet.
private const STATE_LIVE:        u8 = 0;
/// The spawned thread finished and stored its result.
private const STATE_THREAD_DONE: u8 = 1;
/// The handle detached (or dropped); the result will never be read.
private const STATE_DETACHED:    u8 = 2;


/// Heap control block shared between the spawned thread and the
/// `JoinHandle`. Outlives the thread so `join` can read the result after
/// the thread exits. `result` storage is uninitialized until the thread
/// writes it; the state machine guarantees no actor reads or drops it
/// before the write happens-before.
private type struct Shared<T> {
    private state:  Atomic<u8>;
    private result: T;
}

/// Heap input to the spawned thread: the body to run and a pointer to the
/// shared control block. Consumed (and freed) by the trampoline as soon as
/// the thread starts.
private type struct Payload<F, T> {
    private body:   F;
    private shared: mut Shared<T>*;
}


/// The thread body: moves the body out, runs it, publishes the result, and
/// performs the completion half of the join/detach handshake. Platform-
/// agnostic; the gated `thread_trampoline` wrappers below adapt the C entry
/// ABI (pthread returns `void*`, Win32's LPTHREAD_START_ROUTINE returns
/// `DWORD`/`u32`) around this shared logic.
private function thread_body<F, T>(arg: mut u8*) -> void where F: () -> T {
    const p: Payload<F, T>* = arg as Payload<F, T>*;
    const shared: mut Shared<T>* = (*p).shared;
    // Writing the result through a raw `T*` avoids drop-synthesis on the
    // (uninitialized) destination.
    const rptr: mut T* = &(*shared).result;
    mut alloc: GlobalAlloc = GlobalAlloc::new();
    // A take: the body is read out of the payload, and the payload box is
    // released raw right after, without dropping what it held, so `body` is
    // the only owner of what it captured from here on; it is released when
    // this block ends.
    unsafe {
        const body: F = (*p).body;
        alloc.deallocate(NonNull::new(arg), Layout::of::<Payload<F, T>>());
        *rptr = body();
    }

    // Handshake: announce completion. If the handle already detached, no
    // one will ever read the result, so we own teardown here.
    const prev: u8 = (*shared).state.swap(STATE_THREAD_DONE, MemoryOrder::AcqRel);
    if (prev == STATE_DETACHED) {
        ptr::drop_in_place::<T>(rptr);
        alloc.deallocate(NonNull::new(shared as mut u8*), Layout::of::<Shared<T>>());
    }
}

/// The C entry point handed to the OS thread creator. One monomorphization
/// per `(F,T)`.
![target(unix)]
private function thread_trampoline<F, T>(arg: mut u8*) -> u8* where F: () -> T {
    thread_body::<F, T>(arg);
    return null;
}
![target(windows)]
private function thread_trampoline<F, T>(arg: mut u8*) -> u32 where F: () -> T {
    thread_body::<F, T>(arg);
    return 0;
}

/// Create an OS thread running `entry(arg)`, where `entry` is a trampoline
/// of the platform's entry ABI, and return its joinable id (a pthread id,
/// or the thread's HANDLE on Windows).  `stack_bytes == 0` requests the OS
/// default stack.  A failure is the OS's own reason for it.
![target(unix)]
private function os_create_thread(entry: void*, arg: u8*, stack_bytes: u64) -> Result<u64, SpawnError> {
    mut tbuf: [u8; 8] = [0; 8];
    if (stack_bytes == 0) {
        const rc: i32 = pthread_create(&tbuf[0], null, entry, arg);
        if (rc != 0) { return Result::Err(SpawnError::from_errno(rc)); }
        return Result::Ok(*(&tbuf[0] as u64*));
    }
    mut attr: [u8; 56] = [0; 56];
    const init_rc: i32 = pthread_attr_init(&attr[0]);
    if (init_rc != 0) { return Result::Err(SpawnError::from_errno(init_rc)); }
    const size_rc: i32 = pthread_attr_setstacksize(&attr[0], stack_bytes);
    if (size_rc != 0) {
        pthread_attr_destroy(&attr[0]);
        return Result::Err(SpawnError::from_errno(size_rc));
    }
    const rc: i32 = pthread_create(&tbuf[0], &attr[0], entry, arg);
    pthread_attr_destroy(&attr[0]);
    if (rc != 0) { return Result::Err(SpawnError::from_errno(rc)); }
    return Result::Ok(*(&tbuf[0] as u64*));
}
![target(windows)]
private function os_create_thread(entry: void*, arg: u8*, stack_bytes: u64) -> Result<u64, SpawnError> {
    // A requested size is the stack's reservation, committed as the thread
    // touches it, so a large stack costs address space rather than memory.
    mut flags: u32 = 0;
    if (stack_bytes != 0) { flags = syscall::STACK_SIZE_PARAM_IS_A_RESERVATION; }
    const h: u8* = syscall::CreateThread(null, stack_bytes, entry, arg, flags, null);
    if (h != null) { return Result::Ok(h as u64); }
    const code: u32 = syscall::GetLastError();
    if (code == syscall::ERROR_NOT_ENOUGH_MEMORY || code == syscall::ERROR_OUTOFMEMORY) {
        return Result::Err(SpawnError::OutOfMemory);
    }
    if (code == syscall::ERROR_ACCESS_DENIED) { return Result::Err(SpawnError::PermissionDenied); }
    if (code == syscall::ERROR_MAX_THRDS_REACHED) { return Result::Err(SpawnError::ResourceLimit); }
    return Result::Err(SpawnError::Other);
}


/// Tear down a control block from the handle side (detach or drop).
/// Mirrors the trampoline's handshake: announce detachment, and if the
/// thread has already finished, reclaim the result and the block here.
private function reap_detached<T>(tid: u64, shared: mut Shared<T>*) -> void {
    // Let the OS reclaim the thread's own resources when it exits.
    os_detach(tid);
    const prev: u8 = (*shared).state.swap(STATE_DETACHED, MemoryOrder::AcqRel);
    if (prev == STATE_THREAD_DONE) {
        // Thread already finished and left the result for us; drop it.
        const rptr: T* = &(*shared).result;
        ptr::drop_in_place::<T>(rptr);
        mut alloc: GlobalAlloc = GlobalAlloc::new();
        alloc.deallocate(NonNull::new(shared as mut u8*), Layout::of::<Shared<T>>());
    }
    // Otherwise the thread is still running and will reclaim the block
    // when it observes STATE_DETACHED.
}


/// Handle to a spawned thread. Carries the OS thread id and the shared
/// control block. `T` is the body's return type; the body's own type is
/// erased (it was consumed on the thread).
public type struct JoinHandle<T> {
    private tid:    u64;
    private shared: mut Shared<T>*;

    /// Block until the thread finishes and return its result. Consumes
    /// the handle; the control block is freed here.
    public join(mut this) -> T {
        const { tid, shared }: JoinHandle<T> = this;
        os_join(tid);
        // Thread has exited and left the result (it observed STATE_LIVE,
        // so it did not tear down). Move the result out, then free the
        // block without dropping the (now-moved-from) result storage.
        const rptr: T* = &(*shared).result;
        // Destructive read: `deallocate` releases the block as raw bytes and
        // runs no drop glue over `result`, so the value moved out here has
        // exactly one owner.  The read and the free are a single sequence.
        unsafe {
            const out: T = *rptr;
            mut alloc: GlobalAlloc = GlobalAlloc::new();
            alloc.deallocate(NonNull::new(shared as mut u8*), Layout::of::<Shared<T>>());
            return out;
        }
    }

    /// Detach: give up the ability to join. The thread runs to
    /// completion independently; its result is dropped. Consumes the
    /// handle.
    public detach(mut this) -> void {
        const { tid, shared }: JoinHandle<T> = this;
        reap_detached::<T>(tid, shared);
    }

    /// True once the thread has finished running its body. Does not
    /// consume the handle and never blocks.
    public is_finished(&this) -> boolean {
        return (*this.shared).state.load(MemoryOrder::Acquire) != STATE_LIVE;
    }

    /// The spawned thread's id.
    public id(&this) -> ThreadId {
        return ThreadId { raw: this.tid };
    }
}

/// Dropping a handle without `join`/`detach` detaches the thread, so the
/// thread and its control block are still reclaimed. `join`/`detach`
/// destructure `this`, suppressing this path.
implement<T> trait Drop for struct JoinHandle<T> {
    drop(mut &this) -> void {
        if (this.shared == null) { return; }
        reap_detached::<T>(this.tid, this.shared);
        this.shared = null;
    }
}


// ---------------------------------------------------------------------------
// spawn
// ---------------------------------------------------------------------------

/// Spawn a thread that runs `body()` and returns a handle to its `T`
/// result. `body` is moved into the new thread: a `move` closure, a
/// non-capturing lambda or a named function. Panics on allocation or
/// thread-creation failure; use `try_spawn` for a fallible spawn.
///
/// Thread-safety: `spawn` requires `F: Send` (the body and everything it
/// owns) and `T: Send` (the result handed back through
/// `JoinHandle::join`). Both are computed structurally - primitives, raw
/// pointers, references, and the standard containers built on them
/// (`Box`, `Arc`, `Array`, `String`, `mpsc::Sender`, ...) are `Send`. The
/// bound rejects a closure written without `move`, which borrows from the
/// spawning function, and the types on the thread-safety deny-list
/// (`Rc<T>` and the lock guards).
public function spawn<F, T>(body: F) -> JoinHandle<T>
where F: () -> T + Send, T: Send {
    match (spawn_with_attr::<F, T>(body, 0)) {
        Result::Ok(h)  => { return h; }
        Result::Err(_) => {
            core::panic("thread::spawn: failed to create thread", intrinsics::location());
        }
    }
}

/// Fallible spawn with an optional stack size (`0` == OS default). The
/// per-OS thread creator (`os_create_thread`) applies it - via a
/// `pthread_attr_t` on POSIX, or `CreateThread`'s `dwStackSize` on Windows.
public function spawn_with_attr<F, T>(body: F, stack_bytes: u64) -> Result<JoinHandle<T>, SpawnError>
where F: () -> T + Send, T: Send {
    mut alloc: GlobalAlloc = GlobalAlloc::new();

    mut shared: mut Shared<T>* = null;
    match (alloc.allocate(Layout::of::<Shared<T>>())) {
        Result::Ok(raw) => { shared = raw.cast::<Shared<T>>().as_ptr(); }
        Result::Err(_)  => { return Result::Err(SpawnError::OutOfMemory); }
    }
    (*shared).state = Atomic::<u8>::new(STATE_LIVE);

    mut p: mut Payload<F, T>* = null;
    match (alloc.allocate(Layout::of::<Payload<F, T>>())) {
        Result::Ok(raw) => { p = raw.cast::<Payload<F, T>>().as_ptr(); }
        Result::Err(_)  => {
            alloc.deallocate(NonNull::new(shared as mut u8*), Layout::of::<Shared<T>>());
            return Result::Err(SpawnError::OutOfMemory);
        }
    }
    (*p).body   = body;
    (*p).shared = shared;

    match (os_create_thread(thread_trampoline::<F, T> as void*, p as u8*, stack_bytes)) {
        Result::Ok(tid) => { return Result::Ok(JoinHandle::<T> { tid: tid, shared: shared }); }
        Result::Err(e)  => {
            // The thread never started, so we still own both boxes. The
            // body was moved in; release it in place so what it owns is not
            // leaked, then free both boxes.
            ptr::drop_in_place::<F>(&(*p).body);
            alloc.deallocate(NonNull::new(p as mut u8*), Layout::of::<Payload<F, T>>());
            alloc.deallocate(NonNull::new(shared as mut u8*), Layout::of::<Shared<T>>());
            return Result::Err(e);
        }
    }
}


/// Why a spawn failed.
public type enum SpawnError with [Eq, Clone, Debug] {
    OutOfMemory;
    PermissionDenied;   // EPERM
    ResourceLimit;      // EAGAIN
    Other;
}

implement enum SpawnError {
    /// Map a `pthread_create` errno return to a `SpawnError`.
    public static from_errno(rc: i32) -> SpawnError {
        return match (rc) {
            1  => { SpawnError::PermissionDenied }  // EPERM
            11 => { SpawnError::ResourceLimit }     // EAGAIN
            12 => { SpawnError::OutOfMemory }       // ENOMEM
            _  => { SpawnError::Other }
        };
    }
}

/// `could not start a thread: out of memory`, and so on for each reason.
implement trait Display for enum SpawnError {
    fmt(&this, f: mut &Formatter) -> Result<(), FmtError> {
        f.write_str(Str::new("could not start a thread"))?;
        match (&this) {
            SpawnError::OutOfMemory      => { return f.write_str(Str::new(": out of memory")); }
            SpawnError::PermissionDenied => { return f.write_str(Str::new(": permission denied")); }
            SpawnError::ResourceLimit    => { return f.write_str(Str::new(": a resource limit was reached")); }
            SpawnError::Other            => { return Result::Ok(()); }
        }
    }
}

implement trait Error for enum SpawnError { }


/// Fallible spawn: like `spawn`, but returns `Err(SpawnError)` instead of
/// panicking when the OS cannot create the thread (e.g. `EAGAIN` under a
/// thread-count limit). The body's `T` is still delivered through the
/// returned handle's `join()`.
///
///   ```cryo
///   match (thread::try_spawn(move () -> i32 { return work(arg); })) {
///       Result::Ok(h)  => { use(h.join()); }
///       Result::Err(e) => { /* back off / report */ }
///   }
///   ```
public function try_spawn<F, T>(body: F) -> Result<JoinHandle<T>, SpawnError>
where F: () -> T + Send, T: Send {
    return spawn_with_attr::<F, T>(body, 0);
}

// ---------------------------------------------------------------------------
// Builder: configurable spawning (stack size + OS thread name)
// ---------------------------------------------------------------------------

// The OS thread name is capped at 15 bytes plus a NUL by
// `pthread_setname_np` (POSIX); the stack size is applied by
// `os_create_thread`.  The 15-byte limit is shared by both platforms - it is
// the POSIX maximum, and well within Windows' SetThreadDescription bound.
/// The longest thread name `Builder::name` keeps, in bytes: 15, the most
/// `pthread_setname_np` accepts before its terminating NUL. A longer name
/// is cut to its first 15 bytes on every platform.
public const MAX_THREAD_NAME: u64 = 15;

/// A configurable thread spawn: set a stack size and/or an OS-visible
/// thread name, then `spawn` (panics on failure) or `try_spawn` (returns
/// a `Result`). Configuration is applied through a `pthread_attr_t`; the
/// name is set with `pthread_setname_np` once the thread is running.
///
///   ```cryo
///   const n: i32 = 21;
///   const one_mebibyte: u64 = 1 << 20;
///   const h = thread::Builder::new()
///       .stack_size(one_mebibyte)          // 1 MiB stack
///       .name(Str::new("worker"))
///       .spawn(move () -> i32 { return n * 2; });
///   const r: i32 = h.join();               // 42
///   ```
///
/// POD: a `Builder` owns no resources (the name lives in a fixed inline
/// buffer), so it is copied by value and needs no `drop`. The same
/// `F: Send` / `T: Send` thread-safety bounds as `spawn` apply.
public type struct Builder {
    private stack_bytes: u64;       // 0 -> OS default stack size
    private name_buf:    [u8; 16];    // NUL-terminated C string for pthread_setname_np
    private name_len:    u64;       // 0 -> no name set

    /// A builder with default attributes: OS-default stack, no name.
    public static new() -> Builder {
        mut nb: [u8; 16];
        mut i: u64 = 0;
        while (i < 16) { nb[i] = 0; i = i + 1; }
        return Builder { stack_bytes: 0, name_buf: nb, name_len: 0 };
    }

    /// Set the new thread's stack size in bytes. The OS rounds up to a
    /// page and enforces a platform minimum (`PTHREAD_STACK_MIN`); a size
    /// below it surfaces as a spawn error rather than a silent clamp.
    public stack_size(mut this, bytes: u64) -> Builder {
        this.stack_bytes = bytes;
        return this;
    }

    /// Set the OS-visible thread name, truncated to 15 bytes (the
    /// `pthread_setname_np` limit). Shows up in `/proc/<pid>/task/*/comm`,
    /// `ps -T`, `top -H`, and debuggers.
    public name(mut this, n: Str) -> Builder {
        mut len: u64 = n.length() as u64;
        if (len > MAX_THREAD_NAME) { len = MAX_THREAD_NAME; }
        const src: u8* = n.as_ptr();
        mut i: u64 = 0;
        while (i < len) {
            this.name_buf[i] = src[i];
            i = i + 1;
        }
        this.name_buf[len] = 0;   // NUL-terminate
        this.name_len = len;
        return this;
    }

    /// Spawn with the configured attributes, panicking on failure. Use
    /// `try_spawn` for a fallible spawn.
    public spawn<F, T>(this, body: F) -> JoinHandle<T>
    where F: () -> T + Send, T: Send {
        match (this.try_spawn::<F, T>(body)) {
            Result::Ok(h)  => { return h; }
            Result::Err(_) => {
                core::panic("thread::Builder::spawn: failed to create thread", intrinsics::location());
            }
        }
    }

    /// Spawn with the configured attributes, returning `Err(SpawnError)`
    /// if the OS rejects the configuration (e.g. an out-of-range stack
    /// size) or cannot create the thread.
    public try_spawn<F, T>(this, body: F) -> Result<JoinHandle<T>, SpawnError>
    where F: () -> T + Send, T: Send {
        // The stack size is applied inside `os_create_thread` (a
        // `pthread_attr_t` on POSIX, `dwStackSize` on Windows), so the
        // builder just forwards the configured size.
        mut result: Result<JoinHandle<T>, SpawnError> =
            spawn_with_attr::<F, T>(body, this.stack_bytes);

        match (result) {
            Result::Ok(h) => {
                if (this.name_len > 0) {
                    // Best-effort: a naming failure does not invalidate the
                    // live thread.
                    os_set_thread_name(h.tid, &this.name_buf[0]);
                }
                return Result::Ok(h);
            }
            Result::Err(e) => { return Result::Err(e); }
        }
    }
}


// ---------------------------------------------------------------------------
// Thread identity and scheduling utilities.
// ---------------------------------------------------------------------------

/// An opaque OS thread identity. Compare with `==` via `equals`.
public type struct ThreadId {
    private raw: u64;

    /// True when both ids name the same thread (`pthread_equal` on unix).
    /// On Windows `JoinHandle.id` holds the thread's handle and
    /// `thread::current().id()` its numeric id, so an id from one never
    /// equals an id from the other, even for the same thread.
    public equals(&this, other: &ThreadId) -> boolean {
        return os_thread_equal(this.raw, other.raw);
    }
}

/// A handle to a running thread (currently just its identity). Returned
/// by `thread::current()`.
public type struct Thread {
    private id_: ThreadId;

    /// The thread's id: its `pthread_t` on unix, its numeric thread id
    /// (`GetCurrentThreadId`) on Windows.
    public id(&this) -> ThreadId {
        return this.id_;
    }
}

/// The thread invoking this call.
public function current() -> Thread {
    return Thread { id_: ThreadId { raw: os_thread_self() } };
}

/// Yield the remainder of the current timeslice to the scheduler.
public function yield_now() -> void {
    os_yield();
}

/// Sleep the current thread for at least `nanos` nanoseconds, as
/// `time::clock::sleep` does.
public function sleep(nanos: u64) -> void {
    clock::sleep(Duration::from_nanos(nanos));
}

/// Sleep for at least `millis` milliseconds.
public function sleep_ms(millis: u64) -> void {
    sleep(millis * 1000000);
}


// ---------------------------------------------------------------------------
// Scoped threads: fork-join parallelism with auto-join at scope end.
// ---------------------------------------------------------------------------

/// Scoped-thread body: moves the body out of its box, frees the box, runs
/// the body. Scoped bodies return no value, so there is no result/handshake
/// machinery. The gated `scope_trampoline` wrappers adapt the C entry ABI.
private function scope_body<F>(arg: mut u8*) -> void where F: () -> void {
    // A take, as in `thread_body`: the box is released raw right after, so
    // `body` is the only owner of what it captured.
    unsafe {
        const body: F = *(arg as F*);
        mut alloc: GlobalAlloc = GlobalAlloc::new();
        alloc.deallocate(NonNull::new(arg), Layout::of::<F>());
        body();
    }
}

![target(unix)]
private function scope_trampoline<F>(arg: mut u8*) -> u8* where F: () -> void {
    scope_body::<F>(arg);
    return null;
}
![target(windows)]
private function scope_trampoline<F>(arg: mut u8*) -> u32 where F: () -> void {
    scope_body::<F>(arg);
    return 0;
}

/// Run `body` with a thread scope and join every thread it spawned through
/// the scope before returning `body`'s result. The threads may borrow the
/// variables of the caller, which outlive them. A panic unwinding out of
/// `body` still joins them, when the scope is released.
public function scope<F, R>(body: F) -> R where F: (mut &Scope) -> R {
    mut s: Scope = Scope { tids: [] };
    const result: R = body(&s);
    s.join_all();
    return result;
}

/// A thread scope, the handle `thread::scope` gives its body. Every thread
/// spawned through it is joined before `scope` returns, so a scoped thread
/// may borrow what outlives the scope's body.
![language("thread_scope")]
public type struct Scope {
    private tids: [u64];

    /// Spawn a scoped thread running `body()`; `body` is moved into it. The
    /// thread is recorded and joined before `thread::scope` returns. Panics
    /// on allocation or thread-creation failure. `F: Send` holds for a
    /// closure written without `move` when everything it borrows is `Sync`;
    /// a deny-listed type (`Rc`, a lock guard, the scope itself) is not.
    public spawn<F>(mut &this, body: F) -> void
    where F: () -> void + Send {
        mut alloc: GlobalAlloc = GlobalAlloc::new();
        mut p: mut F* = null;
        match (alloc.allocate(Layout::of::<F>())) {
            Result::Ok(raw) => { p = raw.cast::<F>().as_ptr(); }
            Result::Err(_)  => { core::panic("Scope::spawn: alloc failed", intrinsics::location()); }
        }
        *p = body;
        match (os_create_thread(scope_trampoline::<F> as void*, p as u8*, 0)) {
            Result::Ok(tid) => { this.tids.push(tid); }
            Result::Err(_)  => { core::panic("Scope::spawn: thread creation failed", intrinsics::location()); }
        }
    }

    /// Join every thread spawned so far, blocking until all have
    /// finished. Idempotent: clears the recorded set, so a later
    /// drop/join is a no-op.
    public join_all(mut &this) -> void {
        const n: i64 = this.tids.length() as i64;
        for (mut i: i64 = 0; i < n; i = i + 1) {
            os_join(this.tids[i]);
        }
        this.tids.clear();
    }
}

/// Joins any not-yet-joined scoped threads, guaranteeing none outlives
/// the data it may have borrowed; the tid buffer is released by its field
/// after this body.
implement trait Drop for struct Scope {
    drop(mut &this) -> void {
        this.join_all();
    }
}


// ---------------------------------------------------------------------------
// available_parallelism
// ---------------------------------------------------------------------------

/// The number of online logical processors (`sysconf` of
/// `_SC_NPROCESSORS_ONLN`) - the natural default size for a worker pool.
/// Clamped to at least 1 so a pool always makes progress: returns 1 if the
/// query fails. Counts the machine's processors, not a CPU-affinity mask
/// the process may be restricted to.
![target(unix)]
public function available_parallelism() -> u32 {
    // _SC_NPROCESSORS_ONLN is 84 on Linux; other unix systems number it
    // differently, and this call passes the Linux value.
    const n: i64 = libc::sysconf(84);
    if (n <= 0) { return 1; }
    return n as u32;
}

/// The number of logical processors `GetSystemInfo` reports - the natural
/// default size for a worker pool - or 1 if it reports none. On a machine
/// with more than one processor group this counts the calling thread's
/// group only.
///
/// ```cryo
/// import std::thread;
///
/// const workers: u32 = thread::available_parallelism();   // at least 1
/// ```
![target(windows)]
public function available_parallelism() -> u32 {
    mut si: syscall::SYSTEM_INFO_PARTIAL = syscall::SYSTEM_INFO_PARTIAL {
        wProcessorArchitecture: 0, wReserved: 0, dwPageSize: 0,
        lpMinimumApplicationAddress: null, lpMaximumApplicationAddress: null,
        dwActiveProcessorMask: 0, dwNumberOfProcessors: 0,
        dwProcessorType: 0, dwAllocationGranularity: 0,
        wProcessorLevel: 0, wProcessorRevision: 0
    };
    syscall::GetSystemInfo(&si as mut u8*);
    if (si.dwNumberOfProcessors == 0) { return 1; }
    return si.dwNumberOfProcessors;
}
