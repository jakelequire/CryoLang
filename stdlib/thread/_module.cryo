///! std::thread: thread spawning and per-thread storage.
///!
///! Sub-modules:
///!   - `local`  : `ThreadLocal<T>` backed by `pthread_key_create` /
///!                `pthread_setspecific`.  Lazy per-thread init via a
///!                `() -> T` function pointer; explicit `clear()` for
///!                cleanup.
///!
///! `thread::spawn`, `JoinHandle<T>`, and `Builder` land alongside
///! the closure-`move` carve-out — they need to take ownership of
///! captured state to be useful.

namespace std::thread;

public module thread::local;
