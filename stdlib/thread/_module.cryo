///! std::thread: native OS threads.
///!
///! Spawn a thread with `thread::spawn(ctx, body)`: `ctx` is moved into
///! the new thread and handed to `body`, a `(C) -> T` function (a named
///! function or a non-capturing lambda). The returned `JoinHandle<T>`
///! hands back the body's `T` result via `join()`:
///!
///!   ```cryo
///!   const h = thread::spawn<i32, i32>(21, (n: i32) -> i32 { return n * 2; });
///!   const r: i32 = h.join();   // 42
///!   ```
///!
///! Owned data (String, Box, Vec, ...) can be moved across the thread
///! boundary in either direction - into the thread through `ctx`, and
///! back out through the returned `T`. The move-checker tracks the
///! transfer, so there is no aliasing and no double-free.
///!
///! ## Why an explicit context instead of a capturing closure
///!
///! A capturing closure passed to a generic `(C) -> T` parameter does
///! not yet compile (see build-logs/threading_compiler_gaps.md, GAP 2/3).
///! Passing the captured state explicitly through `ctx` is the sound
///! design that works today; once the closure-capture carve-out lands,
///! `spawn(move || ...)` becomes sugar over this.
///!
///! ## Implementation
///!
///! Each spawn heap-allocates a `Payload<C,T>` (the body fn-pointer plus
///! the moved-in `ctx`) and a `Shared<T>` control block (an atomic state
///! byte plus storage for the result). `pthread_create` runs a
///! monomorphized `thread_trampoline<C,T>` - a real named generic
///! function, made addressable by the function-reference fix (GAP 1) -
///! which moves `ctx` out, runs `body`, stores the result, frees the
///! payload, and hands the control block off to `join`/`detach` via a
///! lock-free two-actor handshake on the state byte. No leaks on any
///! path; verified valgrind-clean.
///!
///! ## Lifecycle
///!
///! A `JoinHandle<T>` must be `join()`ed (waits, returns `T`) or
///! `detach()`ed (fire-and-forget). Dropping a handle without either is
///! equivalent to `detach()`. `is_finished()` polls without consuming.
///! `try_spawn` is the fallible variant (returns `Result` instead of
///! panicking on OS thread-creation failure).
///!
///! Sub-modules:
///!   - `local` : `ThreadLocal<T>`, per-thread storage.

namespace std::thread;

import core::intrinsics;
import core::ptr;
import core::result;
import core::drop;
import alloc::layout;
import alloc::allocator;
import collections::array;
import collections::str;
import ffi::libc;
import ffi::syscall;
import sync::atomic;

public module thread::local;


// ---------------------------------------------------------------------------
// Per-OS thread primitives.  ConfigGating only evaluates file-scope
// declarations (never struct method bodies or generic instantiations), so
// every pthread/Win32 call lives in one of these gated free functions and the
// rest of the module is platform-agnostic.
//
// `JoinHandle`/`Scope` store `tid: u64`.  On POSIX that holds a `pthread_t`;
// on Windows it holds the thread HANDLE returned by `CreateThread` (a pointer
// widened to u64).  `os_join`/`os_detach` reinterpret it per platform.  Note
// `thread::current()` returns the Win32 thread *id* (GetCurrentThreadId),
// which is a different namespace from a HANDLE - comparing a `current()` id
// against a `JoinHandle::id()` is not meaningful on Windows (a known v1 gap).
// ---------------------------------------------------------------------------

![target(unix)]
private function os_join(tid: u64) -> void {
    mut ret: u8* = null;
    pthread_join(tid, &ret);
}
![target(windows)]
private function os_join(tid: u64) -> void {
    const h: u8* = tid as u8*;
    syscall::WaitForSingleObject(h, 0xFFFFFFFFu32);   // INFINITE
    syscall::CloseHandle(h);
}

![target(unix)]
private function os_detach(tid: u64) -> void { pthread_detach(tid); }
![target(windows)]
private function os_detach(tid: u64) -> void { syscall::CloseHandle(tid as u8*); }

![target(unix)]
private function os_thread_equal(a: u64, b: u64) -> boolean { return pthread_equal(a, b) != 0; }
![target(windows)]
private function os_thread_equal(a: u64, b: u64) -> boolean { return a == b; }

![target(unix)]
private function os_thread_self() -> u64 { return pthread_self(); }
![target(windows)]
private function os_thread_self() -> u64 { return syscall::GetCurrentThreadId() as u64; }

![target(unix)]
private function os_yield() -> void { sched_yield(); }
![target(windows)]
private function os_yield() -> void { syscall::SwitchToThread(); }

![target(unix)]
private function os_sleep_nanos(nanos: u64) -> void {
    mut req: timespec = timespec { tv_sec: (nanos / 1000000000u64) as i64,
                                   tv_nsec: (nanos % 1000000000u64) as i64 };
    mut rem: timespec = timespec { tv_sec: 0i64, tv_nsec: 0i64 };
    while (nanosleep(&req, &rem) != 0) {
        req = rem;   // EINTR: resume with the kernel's remaining time.
    }
}
![target(windows)]
private function os_sleep_nanos(nanos: u64) -> void {
    // Sleep takes whole milliseconds; round up so a sub-ms request still
    // yields a non-zero sleep (>= 1ms) rather than busy-returning.
    mut ms: u64 = (nanos + 999999u64) / 1000000u64;
    if (ms == 0u64 && nanos > 0u64) { ms = 1u64; }
    syscall::Sleep(ms as u32);
}

// Best-effort OS-visible thread name.  POSIX has pthread_setname_np; the
// Windows equivalent (SetThreadDescription) needs a wide string and is not
// wired up, so naming is a no-op there (it never affects correctness).
![target(unix)]
private function os_set_thread_name(tid: u64, name: u8*) -> void { pthread_setname_np(tid, name); }
![target(windows)]
private function os_set_thread_name(tid: u64, name: u8*) -> void { }


// ---------------------------------------------------------------------------
// Control-block state machine (single atomic byte, two actors: the spawned
// thread and the JoinHandle). Each actor performs exactly one `swap`; the
// actor that observes the OTHER has already finished owns the teardown.
// ---------------------------------------------------------------------------

/// Neither actor has reached its terminal point yet.
const STATE_LIVE:        u8 = 0u8;
/// The spawned thread finished and stored its result.
const STATE_THREAD_DONE: u8 = 1u8;
/// The handle detached (or dropped); the result will never be read.
const STATE_DETACHED:    u8 = 2u8;


/// Heap control block shared between the spawned thread and the
/// `JoinHandle`. Outlives the thread so `join` can read the result after
/// the thread exits. `result` storage is uninitialized until the thread
/// writes it; the state machine guarantees no actor reads or drops it
/// before the write happens-before.
type struct Shared<T> {
    state:  Atomic<u8>;
    result: T;
}

/// Heap input to the spawned thread: the body to run plus the moved-in
/// context and a pointer to the shared control block. Consumed (and
/// freed) by the trampoline as soon as the thread starts.
type struct Payload<C, T> {
    body:   (C) -> T;
    ctx:    C;
    shared: Shared<T>*;
}


/// The thread body: moves `ctx` out, runs `body`, publishes the result, and
/// performs the completion half of the join/detach handshake. Platform-
/// agnostic; the gated `thread_trampoline` wrappers below adapt the C entry
/// ABI (pthread returns `void*`, Win32's LPTHREAD_START_ROUTINE returns
/// `DWORD`/`u32`) around this shared logic.
function thread_body<C, T>(arg: u8*) -> void {
    const p: Payload<C, T>* = arg as Payload<C, T>*;
    const body:   (C) -> T  = (*p).body;
    const shared: Shared<T>* = (*p).shared;
    // Move the context out of the payload, then release the payload box;
    // `ctx` now solely owns whatever heap state it carried.
    const c: C = (*p).ctx;
    mut alloc: GlobalAlloc = GlobalAlloc::new();
    alloc.deallocate(NonNull::new(arg), Layout::of<Payload<C, T>>());

    // Run the user body and publish the result. Writing through a raw
    // `T*` avoids drop-synthesis on the (uninitialized) destination.
    const rptr: T* = &(*shared).result;
    *rptr = body(c);

    // Handshake: announce completion. If the handle already detached, no
    // one will ever read the result, so we own teardown here.
    const prev: u8 = (*shared).state.swap(STATE_THREAD_DONE, MemoryOrder::AcqRel);
    if (prev == STATE_DETACHED) {
        (*rptr).drop();
        alloc.deallocate(NonNull::new(shared as u8*), Layout::of<Shared<T>>());
    }
}

/// The C entry point handed to the OS thread creator. One monomorphization
/// per `(C,T)`, addressable thanks to the generic function-reference fix.
![target(unix)]
function thread_trampoline<C, T>(arg: u8*) -> u8* { thread_body<C, T>(arg); return null; }
![target(windows)]
function thread_trampoline<C, T>(arg: u8*) -> u32 { thread_body<C, T>(arg); return 0u32; }

/// Create an OS thread running `thread_trampoline<C,T>(arg)`, writing the
/// joinable id/handle into `tbuf` (8 bytes).  `stack_bytes == 0` requests
/// the OS default stack.  Returns 0 on success, non-zero on failure.
![target(unix)]
private function os_create_thread<C, T>(tbuf: u8*, arg: u8*, stack_bytes: u64) -> i32 {
    const tramp_fn: (u8*) -> u8* = thread_trampoline<C, T>;
    if (stack_bytes == 0u64) {
        return pthread_create(tbuf, null, tramp_fn as void*, arg);
    }
    mut attr: u8[56];
    mut i: u64 = 0u64;
    while (i < 56u64) { attr[i] = 0u8; i = i + 1u64; }
    if (pthread_attr_init(&attr[0]) != 0) { return 11; }   // EAGAIN
    if (pthread_attr_setstacksize(&attr[0], stack_bytes) != 0) {
        pthread_attr_destroy(&attr[0]);
        return 22;   // EINVAL (out-of-range stack)
    }
    const rc: i32 = pthread_create(tbuf, &attr[0], tramp_fn as void*, arg);
    pthread_attr_destroy(&attr[0]);
    return rc;
}
![target(windows)]
private function os_create_thread<C, T>(tbuf: u8*, arg: u8*, stack_bytes: u64) -> i32 {
    const tramp_fn: (u8*) -> u32 = thread_trampoline<C, T>;
    // dwStackSize = 0 means "default"; CreateThread takes the size directly,
    // so no attribute object is needed.
    const h: u8* = syscall::CreateThread(null, stack_bytes, tramp_fn as void*,
                                         arg, 0u32, null);
    if (h == null) { return 11; }   // surface as a resource-limit error
    *(tbuf as u64*) = h as u64;     // store the HANDLE as the joinable id
    return 0;
}


/// Tear down a control block from the handle side (detach or drop).
/// Mirrors the trampoline's handshake: announce detachment, and if the
/// thread has already finished, reclaim the result and the block here.
function reap_detached<T>(tid: u64, shared: Shared<T>*) -> void {
    // Let the OS reclaim the thread's own resources when it exits.
    os_detach(tid);
    const prev: u8 = (*shared).state.swap(STATE_DETACHED, MemoryOrder::AcqRel);
    if (prev == STATE_THREAD_DONE) {
        // Thread already finished and left the result for us; drop it.
        const rptr: T* = &(*shared).result;
        (*rptr).drop();
        mut alloc: GlobalAlloc = GlobalAlloc::new();
        alloc.deallocate(NonNull::new(shared as u8*), Layout::of<Shared<T>>());
    }
    // Otherwise the thread is still running and will reclaim the block
    // when it observes STATE_DETACHED.
}


/// Handle to a spawned thread. Carries the OS thread id and the shared
/// control block. `T` is the body's return type; the context type `C` is
/// erased (its storage was consumed on the thread).
type struct JoinHandle<T> {
    tid:    u64;
    shared: Shared<T>*;

    /// Block until the thread finishes and return its result. Consumes
    /// the handle; the control block is freed here.
    join(mut this) -> T {
        const { tid, shared }: JoinHandle<T> = this;
        os_join(tid);
        // Thread has exited and left the result (it observed STATE_LIVE,
        // so it did not tear down). Move the result out, then free the
        // block without dropping the (now-moved-from) result storage.
        const rptr: T* = &(*shared).result;
        const out: T = *rptr;
        mut alloc: GlobalAlloc = GlobalAlloc::new();
        alloc.deallocate(NonNull::new(shared as u8*), Layout::of<Shared<T>>());
        return out;
    }

    /// Detach: give up the ability to join. The thread runs to
    /// completion independently; its result is dropped. Consumes the
    /// handle.
    detach(mut this) -> void {
        const { tid, shared }: JoinHandle<T> = this;
        reap_detached<T>(tid, shared);
    }

    /// True once the thread has finished running its body. Does not
    /// consume the handle and never blocks.
    is_finished(&this) -> boolean {
        return (*this.shared).state.load(MemoryOrder::Acquire) != STATE_LIVE;
    }

    /// The spawned thread's id.
    id(&this) -> ThreadId {
        return ThreadId { raw: this.tid };
    }
}

/// Dropping a handle without `join`/`detach` detaches the thread, so the
/// thread and its control block are still reclaimed. `join`/`detach`
/// destructure `this`, suppressing this path.
implement<T> trait Drop for struct JoinHandle<T> {
    drop(mut &this) -> void {
        if (this.shared == null) { return; }
        reap_detached<T>(this.tid, this.shared);
        this.shared = null;
    }
}


// ---------------------------------------------------------------------------
// spawn
// ---------------------------------------------------------------------------

/// Spawn a thread that runs `body(ctx)` and returns a handle to its
/// `T` result. `ctx` is moved into the new thread. `body` must be a
/// function pointer or non-capturing lambda. Panics on allocation or
/// `pthread_create` failure; use `try_spawn` for a fallible spawn.
///
/// Thread-safety: `spawn` requires `C: Send` (the moved context) and
/// `T: Send` (the result handed back through `JoinHandle::join`). Both
/// are computed structurally — primitives, raw pointers, references, and
/// the standard containers built on them (`Box`, `Arc`, `Array`,
/// `String`, `mpsc::Sender`, ...) are `Send`, so the scoped-thread
/// idiom of moving a raw pointer (e.g. `AtomicU8*`) into the body still
/// compiles. The bound statically rejects the genuinely-unsafe types on
/// the thread-safety deny-list (`Rc<T>` and the lock guards), closing the
/// "move a non-thread-safe value into a thread" hole.
function spawn<C, T>(ctx: C, body: (C) -> T) -> JoinHandle<T>
where C: Send, T: Send {
    match (spawn_with_attr<C, T>(ctx, body, 0u64)) {
        Result::Ok(h)  => { return h; }
        Result::Err(_) => {
            intrinsics::panic("thread::spawn: failed to create thread", FILE, LINE);
        }
    }
}

/// Fallible spawn with an optional stack size (`0` == OS default). The
/// per-OS thread creator (`os_create_thread`) applies it - via a
/// `pthread_attr_t` on POSIX, or `CreateThread`'s `dwStackSize` on Windows.
function spawn_with_attr<C, T>(ctx: C, body: (C) -> T,
                               stack_bytes: u64) -> Result<JoinHandle<T>, SpawnError>
where C: Send, T: Send {
    mut alloc: GlobalAlloc = GlobalAlloc::new();

    mut shared: Shared<T>* = null;
    match (alloc.allocate(Layout::of<Shared<T>>())) {
        Result::Ok(raw) => { shared = raw.cast<Shared<T>>().as_ptr(); }
        Result::Err(_)  => { return Result::Err(SpawnError::OutOfMemory); }
    }
    // Struct literal, not `Atomic<u8>::new(STATE_LIVE)`: a generic static-method
    // call with an explicit type arg on the RHS of a pointer field-assignment
    // mis-resolves the type arg inside a generic body (see arc.cryo / memory).
    (*shared).state = Atomic<u8> { value: STATE_LIVE };

    mut p: Payload<C, T>* = null;
    match (alloc.allocate(Layout::of<Payload<C, T>>())) {
        Result::Ok(raw) => { p = raw.cast<Payload<C, T>>().as_ptr(); }
        Result::Err(_)  => {
            alloc.deallocate(NonNull::new(shared as u8*), Layout::of<Shared<T>>());
            return Result::Err(SpawnError::OutOfMemory);
        }
    }
    (*p).body   = body;
    (*p).ctx    = ctx;
    (*p).shared = shared;

    mut tbuf: u8[8] = [0u8; 8];
    const rc: i32 = os_create_thread<C, T>(&tbuf[0], p as u8*, stack_bytes);
    if (rc != 0) {
        // The thread never started, so we still own both boxes. The
        // payload's `ctx` was moved in; reclaim it so owned state inside
        // it is released rather than leaked, then free both boxes.
        const cback: C = (*p).ctx;
        cback.drop();
        alloc.deallocate(NonNull::new(p as u8*), Layout::of<Payload<C, T>>());
        alloc.deallocate(NonNull::new(shared as u8*), Layout::of<Shared<T>>());
        return Result::Err(SpawnError::from_errno(rc));
    }
    return Result::Ok(JoinHandle<T> { tid: *(&tbuf[0] as u64*), shared: shared });
}


/// Why a spawn failed.
type enum SpawnError {
    OutOfMemory;
    PermissionDenied;   // EPERM
    ResourceLimit;      // EAGAIN
    Other;
}

implement enum SpawnError {
    /// Map a `pthread_create` errno return to a `SpawnError`.
    static from_errno(rc: i32) -> SpawnError {
        return match (rc) {
            1  => { SpawnError::PermissionDenied }  // EPERM
            11 => { SpawnError::ResourceLimit }     // EAGAIN
            12 => { SpawnError::OutOfMemory }       // ENOMEM
            _  => { SpawnError::Other }
        };
    }
}


/// Fallible spawn: like `spawn`, but returns `Err(SpawnError)` instead of
/// panicking when the OS cannot create the thread (e.g. `EAGAIN` under a
/// thread-count limit). The body's `T` is still delivered through the
/// returned handle's `join()`.
///
///   ```cryo
///   match (thread::try_spawn<i32, i32>(arg, body)) {
///       Result::Ok(h)  => { use(h.join()); }
///       Result::Err(e) => { /* back off / report */ }
///   }
///   ```
function try_spawn<C, T>(ctx: C, body: (C) -> T) -> Result<JoinHandle<T>, SpawnError>
where C: Send, T: Send {
    return spawn_with_attr<C, T>(ctx, body, 0u64);
}

// ---------------------------------------------------------------------------
// Builder: configurable spawning (stack size + OS thread name)
// ---------------------------------------------------------------------------

// The OS thread name is capped at 15 bytes plus a NUL by
// `pthread_setname_np` (POSIX); the stack size is applied by
// `os_create_thread`.  The name limit is shared by both platforms (Windows
// ignores the name today).
const MAX_THREAD_NAME: u64 = 15;

/// A configurable thread spawn: set a stack size and/or an OS-visible
/// thread name, then `spawn` (panics on failure) or `try_spawn` (returns
/// a `Result`). Configuration is applied through a `pthread_attr_t`; the
/// name is set with `pthread_setname_np` once the thread is running.
///
///   ```cryo
///   const h = thread::Builder::new()
///       .stack_size(1u64 << 20)            // 1 MiB stack
///       .name(Str::new("worker"))
///       .spawn<i32, i32>(21, (n: i32) -> i32 { return n * 2; });
///   const r: i32 = h.join();               // 42
///   ```
///
/// POD: a `Builder` owns no resources (the name lives in a fixed inline
/// buffer), so it is copied by value and needs no `drop`. The same
/// `C: Send` / `T: Send` thread-safety bounds as `spawn` apply.
type struct Builder {
    stack_bytes: u64;       // 0 -> OS default stack size
    name_buf:    u8[16];    // NUL-terminated C string for pthread_setname_np
    name_len:    u64;       // 0 -> no name set

    /// A builder with default attributes: OS-default stack, no name.
    static new() -> Builder {
        mut nb: u8[16];
        mut i: u64 = 0u64;
        while (i < 16u64) { nb[i] = 0u8; i = i + 1u64; }
        return Builder { stack_bytes: 0u64, name_buf: nb, name_len: 0u64 };
    }

    /// Set the new thread's stack size in bytes. The OS rounds up to a
    /// page and enforces a platform minimum (`PTHREAD_STACK_MIN`); a size
    /// below it surfaces as a spawn error rather than a silent clamp.
    stack_size(mut this, bytes: u64) -> Builder {
        this.stack_bytes = bytes;
        return this;
    }

    /// Set the OS-visible thread name, truncated to 15 bytes (the
    /// `pthread_setname_np` limit). Shows up in `/proc/<pid>/task/*/comm`,
    /// `ps -T`, `top -H`, and debuggers.
    name(mut this, n: Str) -> Builder {
        mut len: u64 = n.length();
        if (len > MAX_THREAD_NAME) { len = MAX_THREAD_NAME; }
        const src: u8* = n.as_ptr();
        mut i: u64 = 0u64;
        while (i < len) {
            this.name_buf[i] = src[i];
            i = i + 1u64;
        }
        this.name_buf[len] = 0u8;   // NUL-terminate
        this.name_len = len;
        return this;
    }

    /// Spawn with the configured attributes, panicking on failure. Use
    /// `try_spawn` for a fallible spawn.
    spawn<C, T>(this, ctx: C, body: (C) -> T) -> JoinHandle<T>
    where C: Send, T: Send {
        match (this.try_spawn<C, T>(ctx, body)) {
            Result::Ok(h)  => { return h; }
            Result::Err(_) => {
                intrinsics::panic("thread::Builder::spawn: failed to create thread", FILE, LINE);
            }
        }
    }

    /// Spawn with the configured attributes, returning `Err(SpawnError)`
    /// if the OS rejects the configuration (e.g. an out-of-range stack
    /// size) or cannot create the thread.
    try_spawn<C, T>(this, ctx: C, body: (C) -> T) -> Result<JoinHandle<T>, SpawnError>
    where C: Send, T: Send {
        // The stack size is applied inside `os_create_thread` (a
        // `pthread_attr_t` on POSIX, `dwStackSize` on Windows), so the
        // builder just forwards the configured size.
        mut result: Result<JoinHandle<T>, SpawnError> =
            spawn_with_attr<C, T>(ctx, body, this.stack_bytes);

        match (result) {
            Result::Ok(h) => {
                if (this.name_len > 0u64) {
                    // Best-effort: a naming failure (or an unsupported
                    // platform, e.g. Windows) does not invalidate the live
                    // thread.
                    os_set_thread_name(h.tid, &this.name_buf[0]);
                }
                return Result::Ok(h);
            }
            Result::Err(e) => { return Result::Err(e); }
        }
    }
}


// ---------------------------------------------------------------------------
// Thread identity and scheduling utilities.
// ---------------------------------------------------------------------------

/// An opaque OS thread identity. Compare with `==` via `equals`.
type struct ThreadId {
    raw: u64;

    equals(&this, other: &ThreadId) -> boolean {
        return os_thread_equal(this.raw, other.raw);
    }
}

/// A handle to a running thread (currently just its identity). Returned
/// by `thread::current()`.
type struct Thread {
    id_: ThreadId;

    id(&this) -> ThreadId {
        return this.id_;
    }
}

/// The thread invoking this call.
function current() -> Thread {
    return Thread { id_: ThreadId { raw: os_thread_self() } };
}

/// Yield the remainder of the current timeslice to the scheduler.
function yield_now() -> void {
    os_yield();
}

/// Sleep the current thread for at least `nanos` nanoseconds. On POSIX this
/// restarts across signal interruptions (EINTR) so the full duration
/// elapses; on Windows it rounds up to whole milliseconds.
function sleep(nanos: u64) -> void {
    os_sleep_nanos(nanos);
}

/// Sleep for at least `millis` milliseconds.
function sleep_ms(millis: u64) -> void {
    sleep(millis * 1000000u64);
}


// ---------------------------------------------------------------------------
// Scoped threads: fork-join parallelism with auto-join at scope end.
// ---------------------------------------------------------------------------

/// Heap input to a scoped thread: a void-returning body plus its moved-in
/// context. Freed by the scope trampoline once the body has been invoked.
type struct ScopePayload<C> {
    body: (C) -> void;
    ctx:  C;
}

/// Scoped-thread body: moves the context out, frees the payload, runs the
/// body. Scoped bodies return no value, so there is no result/handshake
/// machinery. The gated `scope_trampoline` wrappers adapt the C entry ABI.
function scope_body<C>(arg: u8*) -> void {
    const p: ScopePayload<C>* = arg as ScopePayload<C>*;
    const body: (C) -> void = (*p).body;
    const c: C = (*p).ctx;
    mut alloc: GlobalAlloc = GlobalAlloc::new();
    alloc.deallocate(NonNull::new(arg), Layout::of<ScopePayload<C>>());
    body(c);
}

![target(unix)]
function scope_trampoline<C>(arg: u8*) -> u8* { scope_body<C>(arg); return null; }
![target(windows)]
function scope_trampoline<C>(arg: u8*) -> u32 { scope_body<C>(arg); return 0u32; }

/// Create an OS thread running `scope_trampoline<C>(arg)`, writing the
/// joinable id/handle into `tbuf`. Returns 0 on success.
![target(unix)]
private function os_create_scope_thread<C>(tbuf: u8*, arg: u8*) -> i32 {
    const t: (u8*) -> u8* = scope_trampoline<C>;
    return pthread_create(tbuf, null, t as void*, arg);
}
![target(windows)]
private function os_create_scope_thread<C>(tbuf: u8*, arg: u8*) -> i32 {
    const t: (u8*) -> u32 = scope_trampoline<C>;
    const h: u8* = syscall::CreateThread(null, 0u64, t as void*, arg, 0u32, null);
    if (h == null) { return 11; }
    *(tbuf as u64*) = h as u64;
    return 0;
}

/// A thread scope. Every thread spawned through it is guaranteed to be
/// joined before the scope is torn down (explicitly via `join_all()` or
/// automatically when the `Scope` drops), so scoped bodies may safely
/// borrow data that outlives the scope - pass a pointer to it through the
/// body's context:
///
///   ```cryo
///   mut counter: i64 = 0i64;
///   mut s: thread::Scope = thread::Scope::new();
///   s.spawn<i64*>(&counter, (p: i64*) -> void { *p = *p + 1i64; });
///   s.spawn<i64*>(&counter, (p: i64*) -> void { *p = *p + 10i64; });
///   s.join_all();   // both threads finished; `counter` safe to read
///   ```
///
/// (Cryo has no borrow checker, so the join-before-teardown discipline -
/// not the type system - is what keeps borrowed data alive; do not let a
/// scope outlive what its threads point at.)
type struct Scope {
    tids: u64[];

    /// Create an empty scope.
    static new() -> Scope {
        return Scope { tids: [] };
    }

    /// Spawn a scoped thread running `body(ctx)`. `ctx` is moved in (often
    /// a pointer into scope-outliving state). The thread is recorded and
    /// joined by `join_all()` / the scope's drop. Panics on allocation or
    /// thread-creation failure. `C: Send` — a raw pointer into the scope's
    /// state qualifies (raw pointers are `Send`); a deny-listed type
    /// (`Rc`, a lock guard) does not.
    spawn<C>(mut &this, ctx: C, body: (C) -> void) -> void
    where C: Send {
        mut alloc: GlobalAlloc = GlobalAlloc::new();
        mut p: ScopePayload<C>* = null;
        match (alloc.allocate(Layout::of<ScopePayload<C>>())) {
            Result::Ok(raw) => { p = raw.cast<ScopePayload<C>>().as_ptr(); }
            Result::Err(_)  => { intrinsics::panic("Scope::spawn: alloc failed", FILE, LINE); }
        }
        (*p).body = body;
        (*p).ctx  = ctx;
        mut tbuf: u8[8] = [0u8; 8];
        const rc: i32 = os_create_scope_thread<C>(&tbuf[0], p as u8*);
        if (rc != 0) { intrinsics::panic("Scope::spawn: thread creation failed", FILE, LINE); }
        this.tids.push(*(&tbuf[0] as u64*));
    }

    /// Join every thread spawned so far, blocking until all have
    /// finished. Idempotent: clears the recorded set, so a later
    /// drop/join is a no-op.
    join_all(mut &this) -> void {
        const n: i64 = this.tids.length() as i64;
        for (mut i: i64 = 0; i < n; i = i + 1) {
            os_join(this.tids[i]);
        }
        this.tids.clear();
    }
}

/// Joins any not-yet-joined scoped threads, guaranteeing none outlives
/// the data it may have borrowed, then releases the tid buffer. (A struct
/// with an explicit `Drop` does not get field glue auto-run, so the
/// owning `tids` array is dropped here explicitly.)
implement trait Drop for struct Scope {
    drop(mut &this) -> void {
        this.join_all();
        this.tids.drop();
    }
}
