// Linux flag constants used by syscalls (often differ from libc forms)
//
// `clone`/`clone3` share-flags. OR'd into the clone_args.flags field.

const CLONE_VM:             u64 = 0x00000100;
const CLONE_FS:             u64 = 0x00000200;
const CLONE_FILES:          u64 = 0x00000400;
const CLONE_SIGHAND:        u64 = 0x00000800;
const CLONE_PIDFD:          u64 = 0x00001000;
const CLONE_PTRACE:         u64 = 0x00002000;
const CLONE_VFORK:          u64 = 0x00004000;
const CLONE_PARENT:         u64 = 0x00008000;
const CLONE_THREAD:         u64 = 0x00010000;
const CLONE_NEWNS:          u64 = 0x00020000;
const CLONE_SYSVSEM:        u64 = 0x00040000;
const CLONE_SETTLS:         u64 = 0x00080000;
const CLONE_PARENT_SETTID:  u64 = 0x00100000;
const CLONE_CHILD_CLEARTID: u64 = 0x00200000;
const CLONE_DETACHED:       u64 = 0x00400000;
const CLONE_UNTRACED:       u64 = 0x00800000;
const CLONE_CHILD_SETTID:   u64 = 0x01000000;
const CLONE_NEWCGROUP:      u64 = 0x02000000;
const CLONE_NEWUTS:         u64 = 0x04000000;
const CLONE_NEWIPC:         u64 = 0x08000000;
const CLONE_NEWUSER:        u64 = 0x10000000;
const CLONE_NEWPID:         u64 = 0x20000000;
const CLONE_NEWNET:         u64 = 0x40000000;
const CLONE_IO:             u64 = 0x80000000;

// `futex` operations (low byte of `op`)
const FUTEX_WAIT:           i32 = 0;
const FUTEX_WAKE:           i32 = 1;
const FUTEX_FD:             i32 = 2;
const FUTEX_REQUEUE:        i32 = 3;
const FUTEX_CMP_REQUEUE:    i32 = 4;
const FUTEX_WAKE_OP:        i32 = 5;
const FUTEX_LOCK_PI:        i32 = 6;
const FUTEX_UNLOCK_PI:      i32 = 7;
const FUTEX_TRYLOCK_PI:     i32 = 8;
const FUTEX_WAIT_BITSET:    i32 = 9;
const FUTEX_WAKE_BITSET:    i32 = 10;
const FUTEX_WAIT_REQUEUE_PI: i32 = 11;
const FUTEX_CMP_REQUEUE_PI: i32 = 12;
const FUTEX_PRIVATE_FLAG:   i32 = 128;
const FUTEX_CLOCK_REALTIME: i32 = 256;

// `getrandom` flags
const GRND_NONBLOCK: u32 = 1;
const GRND_RANDOM:   u32 = 2;
const GRND_INSECURE: u32 = 4;

// `prctl` operations (PR_*), covered selectively; full list in
// `<linux/prctl.h>`. The commonly-needed subset:
const PR_SET_PDEATHSIG: i32 = 1;
const PR_GET_PDEATHSIG: i32 = 2;
const PR_SET_DUMPABLE:  i32 = 4;
const PR_GET_DUMPABLE:  i32 = 3;
const PR_SET_NAME:      i32 = 15;
const PR_GET_NAME:      i32 = 16;
const PR_SET_SECCOMP:   i32 = 22;
const PR_GET_SECCOMP:   i32 = 21;
const PR_SET_NO_NEW_PRIVS: i32 = 38;
const PR_GET_NO_NEW_PRIVS: i32 = 39;

// `seccomp` operations
const SECCOMP_SET_MODE_STRICT: u32 = 0;
const SECCOMP_SET_MODE_FILTER: u32 = 1;
const SECCOMP_GET_ACTION_AVAIL: u32 = 2;
const SECCOMP_GET_NOTIF_SIZES: u32 = 3;

// `pidfd_open` flags (none yet defined; future PIDFD_NONBLOCK lives at 0x800)
const PIDFD_NONBLOCK: u32 = 2048;     // == O_NONBLOCK

// Linux raw-syscall entry point
//
// `syscall()` is libc's variadic trampoline that loads the syscall
// number into `rax` and the up-to-six arguments into the syscall ABI
// registers (rdi, rsi, rdx, r10, r8, r9). Return value is `rax`;
// negative `errno` values become libc errno + return -1; the
// trampoline does the translation.

![target(linux)]
extern "C" {
    function syscall(number: Syscall, ...) -> i64;
}

// Typed Linux syscall wrappers
//
// Every wrapper forwards through `syscall()` with the matching `*`
// number, casting arguments to `i64` for the variadic call. Return
// types follow the kernel ABI: usually `i64` for ssize_t-shaped
// results, `i32` for int-shaped ones. Errors surface via libc errno
// (set by the syscall trampoline on negative kernel return).

![target(linux)]
function sys_read(fd: i32, buf: u8*, count: u64) -> i64 {
    return syscall(Syscall::read, fd as i64, buf as i64, count as i64);
}

![target(linux)]
function sys_write(fd: i32, buf: u8*, count: u64) -> i64 {
    return syscall(Syscall::write, fd as i64, buf as i64, count as i64);
}

![target(linux)]
function sys_open(path: u8*, flags: i32, mode: u32) -> i32 {
    return syscall(Syscall::open, path as i64, flags as i64, mode as i64) as i32;
}

![target(linux)]
function sys_close(fd: i32) -> i32 {
    return syscall(Syscall::close, fd as i64) as i32;
}

![target(linux)]
function sys_lseek(fd: i32, offset: i64, whence: i32) -> i64 {
    return syscall(Syscall::lseek, fd as i64, offset, whence as i64);
}

![target(linux)]
function sys_mmap(addr: u8*, length: u64, prot: i32,
                  flags: i32, fd: i32, offset: i64) -> u8* {
    return syscall(Syscall::mmap, addr as i64, length as i64,
                   prot as i64, flags as i64,
                   fd as i64, offset) as u8*;
}

![target(linux)]
function sys_munmap(addr: u8*, length: u64) -> i32 {
    return syscall(Syscall::munmap, addr as i64, length as i64) as i32;
}

![target(linux)]
function sys_mprotect(addr: u8*, length: u64, prot: i32) -> i32 {
    return syscall(Syscall::mprotect, addr as i64, length as i64, prot as i64) as i32;
}

![target(linux)]
function sys_brk(addr: u8*) -> u8* {
    return syscall(Syscall::brk, addr as i64) as u8*;
}

![target(linux)]
function sys_pipe2(pipefd: i32*, flags: i32) -> i32 {
    return syscall(Syscall::pipe2, pipefd as i64, flags as i64) as i32;
}

![target(linux)]
function sys_dup(oldfd: i32) -> i32 {
    return syscall(Syscall::dup, oldfd as i64) as i32;
}

![target(linux)]
function sys_dup2(oldfd: i32, newfd: i32) -> i32 {
    return syscall(Syscall::dup2, oldfd as i64, newfd as i64) as i32;
}

![target(linux)]
function sys_dup3(oldfd: i32, newfd: i32, flags: i32) -> i32 {
    return syscall(Syscall::dup3, oldfd as i64, newfd as i64, flags as i64) as i32;
}

![target(linux)]
function sys_fcntl(fd: i32, cmd: i32, arg: i64) -> i32 {
    return syscall(Syscall::fcntl, fd as i64, cmd as i64, arg) as i32;
}

![target(linux)]
function sys_ioctl(fd: i32, request: u64, arg: u8*) -> i32 {
    return syscall(Syscall::ioctl, fd as i64, request as i64, arg as i64) as i32;
}

![target(linux)]
function sys_fork() -> i32 {
    return syscall(Syscall::fork) as i32;
}

![target(linux)]
function sys_vfork() -> i32 {
    return syscall(Syscall::vfork) as i32;
}

![target(linux)]
function sys_execve(path: u8*, argv: u8**, envp: u8**) -> i32 {
    return syscall(Syscall::execve, path as i64, argv as i64, envp as i64) as i32;
}

![target(linux)]
function sys_exit(status: i32) -> void {
    syscall(Syscall::exit, status as i64);
}

![target(linux)]
function sys_exit_group(status: i32) -> void {
    syscall(Syscall::exit_group, status as i64);
}

![target(linux)]
function sys_wait4(pid: i32, wstatus: i32*, options: i32, rusage: u8*) -> i32 {
    return syscall(Syscall::wait4, pid as i64, wstatus as i64,
                   options as i64, rusage as i64) as i32;
}

![target(linux)]
function sys_waitid(idtype: i32, id: u32, infop: u8*, options: i32) -> i32 {
    return syscall(Syscall::waitid, idtype as i64, id as i64,
                   infop as i64, options as i64) as i32;
}

![target(linux)]
function sys_kill(pid: i32, sig: i32) -> i32 {
    return syscall(Syscall::kill, pid as i64, sig as i64) as i32;
}

![target(linux)]
function sys_tkill(tid: i32, sig: i32) -> i32 {
    return syscall(Syscall::tkill, tid as i64, sig as i64) as i32;
