///! syscall: raw system-call bindings, gated per platform.
///!
///! Two distinct surfaces live in this module, each gated with
///! `![target(...)]` so the other platform's symbols never reach
///! the linker:
///!
///!   - Linux x86_64: the full `*` number table, typed wrappers for the
///!     common-case syscalls (via the libc `syscall(number, ...)`
///!     trampoline), and the `sys_call0..6` generic entry points, which
///!     issue the raw `syscall` instruction via inline asm - no libc
///!     involvement (see the block comment at `sys_call0`).
///!   - Windows x86_64: the Win32 system surface (kernel32.dll,
///!     user32.dll, advapi32.dll, etc.) plus a small NT API surface
///!     (ntdll.dll) for programs that want to skip Win32.
///!
///! ## When to reach for this vs `ffi::libc`
///!
///! Reach for `ffi::libc` first; its functions go through glibc's
///! well-tested wrappers and are portable across Unix variants. Drop
///! down to `sys::syscall` only when:
///!
///!   - You need a syscall not exposed by libc (`gettid`, `pidfd_open`,
///!     `io_uring_setup`, `bpf`, `userfaultfd`, `clone3`, ...).
///!   - You're writing a stub libc and want to avoid recursion.
///!   - You need bit-exact control over which syscall a code path
///!     issues (kernel-fuzzing, eBPF tracers, sandbox enforcement).
///!   - You're on Windows and want the Win32 surface directly rather
///!     than through a libc personality.
///!
///! ## Architecture & ABI
///!
///! Linux numbers (`*`) are the x86_64 ABI from
///! `<asm/unistd_64.h>`. arm64/i386/riscv64 use different numbers;
///! a future per-arch split will gate the `*` block.
///!
///! Windows bindings target the x64 ABI (Microsoft x64 calling
///! convention). x86 stdcall is not supported.
///!
///! ## Numeric values
///!
///! Constants are just integers; they have no link-time presence,
///! so the `*` and Win32 constants are declared unconditionally.
///! Only the `extern "C"` blocks (and the typed wrappers that call
///! into them) carry `![target(...)]` gates.

namespace std::sys::syscall;

import std::ffi::libc;

//
//                              LINUX x86_64
//

// *: Linux x86_64 syscall numbers (from `<asm/unistd_64.h>`)
//
// Stable kernel ABI: numbers are append-only across Linux releases.
// Numbers up to ~451 (as of Linux 6.x) are covered; gaps in the
// numbering correspond to retired syscalls that we omit. New syscalls
// added by later kernels can be appended without renumbering.

/// Linux x86_64 syscall identifier. Mutually exclusive: the kernel
/// dispatches on the integer value in `rax`. Pass to `syscall()` or
/// `sys_callN(...)`; the `i64` backing matches glibc's
/// `long syscall(long, ...)` ABI exactly.
type enum Syscall : i64 {
    read                    = 0;
    write                   = 1;
    open                    = 2;
    close                   = 3;
    stat                    = 4;
    fstat                   = 5;
    lstat                   = 6;
    poll                    = 7;
    lseek                   = 8;
    mmap                    = 9;
    mprotect                = 10;
    munmap                  = 11;
    brk                     = 12;
    rt_sigaction            = 13;
    rt_sigprocmask          = 14;
    rt_sigreturn            = 15;
    ioctl                   = 16;
    pread64                 = 17;
    pwrite64                = 18;
    readv                   = 19;
    writev                  = 20;
    access                  = 21;
    pipe                    = 22;
    select                  = 23;
    sched_yield             = 24;
    mremap                  = 25;
    msync                   = 26;
    mincore                 = 27;
    madvise                 = 28;
    shmget                  = 29;
    shmat                   = 30;
