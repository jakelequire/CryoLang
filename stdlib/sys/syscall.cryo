// ntdll.dll: NT API. Stable across releases for the entries below
// (Microsoft-supported); other NT* functions are undocumented and can
// shift between builds.
//
// `OBJECT_ATTRIBUTES`, `UNICODE_STRING`, `IO_STATUS_BLOCK`, etc. are
// platform-stable. Treat as opaque byte buffers and pack manually;
// future helpers can land in a `nt::` submodule.

![target(windows)]
![link("ntdll")]
extern "C" {
    // Files / I/O: raw NT layer beneath CreateFile / ReadFile.
    // (`-> u32` is the NTSTATUS return; see the `STATUS_*` constants.)
    function NtCreateFile(FileHandle: u8**, DesiredAccess: u32,
                          ObjectAttributes: u8*, IoStatusBlock: u8*,
                          AllocationSize: i64*, FileAttributes: u32,
                          ShareAccess: u32, CreateDisposition: u32,
                          CreateOptions: u32, EaBuffer: u8*,
                          EaLength: u32) -> u32;
    function NtOpenFile(FileHandle: u8**, DesiredAccess: u32,
                        ObjectAttributes: u8*, IoStatusBlock: u8*,
                        ShareAccess: u32, OpenOptions: u32) -> u32;
    function NtReadFile(FileHandle: u8*, Event: u8*, ApcRoutine: void*,
                        ApcContext: u8*, IoStatusBlock: u8*,
                        Buffer: u8*, Length: u32,
                        ByteOffset: i64*, Key: u32*) -> u32;
    function NtWriteFile(FileHandle: u8*, Event: u8*, ApcRoutine: void*,
                         ApcContext: u8*, IoStatusBlock: u8*,
                         Buffer: u8*, Length: u32,
                         ByteOffset: i64*, Key: u32*) -> u32;
    function NtClose(Handle: u8*) -> u32;
    function NtDeviceIoControlFile(FileHandle: u8*, Event: u8*,
                                   ApcRoutine: void*, ApcContext: u8*,
                                   IoStatusBlock: u8*,
                                   IoControlCode: u32,
                                   InputBuffer: u8*, InputBufferLength: u32,
                                   OutputBuffer: u8*,
                                   OutputBufferLength: u32) -> u32;
    function NtFsControlFile(FileHandle: u8*, Event: u8*,
                             ApcRoutine: void*, ApcContext: u8*,
                             IoStatusBlock: u8*,
                             FsControlCode: u32,
                             InputBuffer: u8*, InputBufferLength: u32,
                             OutputBuffer: u8*,
                             OutputBufferLength: u32) -> u32;

    // Memory
    function NtAllocateVirtualMemory(ProcessHandle: u8*, BaseAddress: u8**,
                                     ZeroBits: u64, RegionSize: u64*,
                                     AllocationType: u32, Protect: u32) -> u32;
    function NtFreeVirtualMemory(ProcessHandle: u8*, BaseAddress: u8**,
                                 RegionSize: u64*, FreeType: u32) -> u32;
    function NtProtectVirtualMemory(ProcessHandle: u8*, BaseAddress: u8**,
                                    RegionSize: u64*, NewProtect: u32,
                                    OldProtect: u32*) -> u32;
    function NtQueryVirtualMemory(ProcessHandle: u8*, BaseAddress: u8*,
                                  MemoryInformationClass: u32,
                                  MemoryInformation: u8*,
                                  MemoryInformationLength: u64,
                                  ReturnLength: u64*) -> u32;

    // Process / thread
    function NtTerminateProcess(ProcessHandle: u8*, ExitStatus: i32) -> u32;
    function NtQueryInformationProcess(ProcessHandle: u8*,
                                       ProcessInformationClass: u32,
                                       ProcessInformation: u8*,
                                       ProcessInformationLength: u32,
                                       ReturnLength: u32*) -> u32;
    function NtSuspendProcess(ProcessHandle: u8*) -> u32;
    function NtResumeProcess(ProcessHandle: u8*) -> u32;

    // System
    function NtQuerySystemInformation(SystemInformationClass: u32,
                                      SystemInformation: u8*,
                                      SystemInformationLength: u32,
                                      ReturnLength: u32*) -> u32;
    function NtDelayExecution(Alertable: i32, DelayInterval: i64*) -> u32;
    function NtYieldExecution() -> u32;

    // Events / synchronization
    function NtCreateEvent(EventHandle: u8**, DesiredAccess: u32,
                           ObjectAttributes: u8*, EventType: u32,
                           InitialState: i32) -> u32;
    function NtSetEvent(EventHandle: u8*, PreviousState: i32*) -> u32;
    function NtResetEvent(EventHandle: u8*, PreviousState: i32*) -> u32;
    function NtWaitForSingleObject(Handle: u8*, Alertable: i32,
                                   Timeout: i64*) -> u32;

    // Helpers
    function RtlNtStatusToDosError(Status: u32) -> u32;
    function RtlGetVersion(VersionInformation: u8*) -> u32;
}


// ---------------------------------------------------------------------------
// ws2_32.dll: Winsock 2.  The BSD-socket surface used by std::net.
//
// SOCKET is an opaque UINT_PTR (u64), not an int fd; INVALID_SOCKET is
// (SOCKET)(~0).  Lengths are `int` (i32) here, not POSIX socklen_t/ssize_t,
// and errors come from WSAGetLastError() rather than errno.  net::sys wraps
// all of this behind a uniform i32-fd interface (SOCKET values fit i32 in
// practice; net::sys casts at the boundary).  WSAStartup must run once before
// any other call.  ws2_32 is NOT auto-linked by mingw - the windows-gnu
// link line adds -lws2_32 (see codegen/passes.cryo).
// ---------------------------------------------------------------------------
![target(windows)]
const INVALID_SOCKET: u64 = 18446744073709551615;   // (SOCKET)(~0)
![target(windows)]
const SOCKET_ERROR:   i32 = -1;
// WSAGetLastError codes that net::sys maps (the rest fold to Other).
![target(windows)]
const WSAEINTR:        i32 = 10004;
![target(windows)]
const WSAEWOULDBLOCK:  i32 = 10035;
![target(windows)]
const WSAEADDRINUSE:   i32 = 10048;
![target(windows)]
const WSAECONNRESET:   i32 = 10054;
![target(windows)]
const WSAECONNREFUSED: i32 = 10061;
![target(windows)]
const WSAETIMEDOUT:    i32 = 10060;
![target(windows)]
const WSAECONNABORTED: i32 = 10053;
![target(windows)]
const WSAENOTCONN:     i32 = 10057;
// FIONBIO for ioctlsocket (non-blocking toggle).
![target(windows)]
const FIONBIO: i32 = -2147195266;   // 0x8004667E

// getsockopt level and options used to read a non-blocking connect's outcome.
// SO_ERROR latches the failure code; SO_CONNECT_TIME reports how many seconds
// the socket has been connected, or SO_CONNECT_TIME_NEVER while the handshake
// is still outstanding - together they separate "failed", "connected" and
// "still waiting" without disturbing the connection attempt.
![target(windows)]
const SOL_SOCKET: i32 = 65535;              // 0xFFFF
![target(windows)]
const SO_ERROR: i32 = 4103;                 // 0x1007
![target(windows)]
const SO_CONNECT_TIME: i32 = 28684;         // 0x700C
![target(windows)]
const SO_CONNECT_TIME_NEVER: u32 = 0xFFFFFFFF;

// ---------------------------------------------------------------------------
// I/O completion ports + AFD polling: the Windows readiness backend.
//
// Windows has no epoll. What it has is IOCP (completion notification) and, under
// Winsock, the `\Device\Afd` driver every socket is built on. Issuing the
// undocumented `IOCTL_AFD_POLL` against an AFD handle asks "tell me when this
// socket becomes readable/writable" and completes through an IOCP — readiness
// notification built out of completion machinery. It is what `wepoll` and Rust's
// `mio` do, and it is the only way to get true epoll-equivalent readiness for
// sockets on Windows.
//
// The NT-level entry points are undocumented but stable since Windows Vista.
// Structures are handled as byte buffers with explicit offsets, the same way
// this library treats `sockaddr` — Cryo does not model C struct layout, and
// these have strict ABI offsets.
// ---------------------------------------------------------------------------

// IOCTL_AFD_POLL, and the poll event bits AFD reports.
![target(windows)]
const IOCTL_AFD_POLL: u32 = 0x00012024;

![target(windows)]
const AFD_POLL_RECEIVE:           u32 = 0x0001;
![target(windows)]
const AFD_POLL_RECEIVE_EXPEDITED: u32 = 0x0002;
![target(windows)]
const AFD_POLL_SEND:              u32 = 0x0004;
![target(windows)]
const AFD_POLL_DISCONNECT:        u32 = 0x0008;
![target(windows)]
const AFD_POLL_ABORT:             u32 = 0x0010;
![target(windows)]
const AFD_POLL_LOCAL_CLOSE:       u32 = 0x0020;
![target(windows)]
const AFD_POLL_ACCEPT:            u32 = 0x0080;
![target(windows)]
const AFD_POLL_CONNECT_FAIL:      u32 = 0x0100;

// Byte sizes of the NT structures the reactor builds by hand (x86_64).
![target(windows)]
const SIZEOF_IO_STATUS_BLOCK:   u64 = 16;   // Status/Pointer union + Information
![target(windows)]
const SIZEOF_OVERLAPPED:        u64 = 32;   // Internal, InternalHigh, Pointer, hEvent
![target(windows)]
const SIZEOF_AFD_POLL_INFO:     u64 = 32;   // Timeout, NumberOfHandles, Exclusive, 1 handle
![target(windows)]
const SIZEOF_OBJECT_ATTRIBUTES: u64 = 48;
![target(windows)]
const SIZEOF_UNICODE_STRING:    u64 = 16;
![target(windows)]
const SIZEOF_OVERLAPPED_ENTRY:  u64 = 32;   // key, overlapped, internal, bytes

// NtCreateFile arguments for opening the AFD device. `STATUS_SUCCESS` /
// `STATUS_PENDING` are declared with the rest of the NT status codes above.
![target(windows)]
const SYNCHRONIZE:      u32 = 0x00100000;
![target(windows)]
const FILE_SHARE_RW:    u32 = 3;            // FILE_SHARE_READ | FILE_SHARE_WRITE
![target(windows)]
const FILE_OPEN:        u32 = 1;

// Ask Winsock for the base handle underneath a socket: layered service
// providers can wrap a socket, and AFD must be pointed at the real one.
![target(windows)]
const SIO_BASE_HANDLE:  u32 = 0x48000022;

// Completion-port key reserved for the wake-up post, which carries no overlapped.
![target(windows)]
const IOCP_KICK_KEY:    u64 = 1;

![target(windows)]
![link("kernel32")]
extern "C" {
    /// Create a port, or associate `FileHandle` with an existing one. Creating
    /// passes INVALID_HANDLE_VALUE and a null port.
    function CreateIoCompletionPort(FileHandle: u8*, ExistingCompletionPort: u8*,
                                    CompletionKey: u64,
                                    NumberOfConcurrentThreads: u32) -> u8*;
    /// Drain up to `ulCount` completions in one call.
    function GetQueuedCompletionStatusEx(CompletionPort: u8*,
                                         lpCompletionPortEntries: u8*,
                                         ulCount: u32, ulNumEntriesRemoved: u32*,
                                         dwMilliseconds: u32, fAlertable: i32) -> i32;
    /// Queue a synthetic completion — the reactor's wake-up mechanism.
    function PostQueuedCompletionStatus(CompletionPort: u8*,
                                        dwNumberOfBytesTransferred: u32,
                                        dwCompletionKey: u64, lpOverlapped: u8*) -> i32;
}

// `NtCreateFile` (which opens `\Device\Afd` — an NT path CreateFile cannot
// reach) and `NtDeviceIoControlFile` (which issues the poll IOCTL) are declared
// with the rest of the NT layer above. With a null Event on an IOCP-associated
// handle, the IOCTL's `ApcContext` becomes the completion's `lpOverlapped`,
// which is how the reactor recognizes which poll finished.

![target(windows)]
![link("ws2_32")]
extern "C" {
    function WSAIoctl(s: u64, dwIoControlCode: u32,
                      lpvInBuffer: u8*, cbInBuffer: u32,
                      lpvOutBuffer: u8*, cbOutBuffer: u32,
                      lpcbBytesReturned: u32*, lpOverlapped: u8*,
                      lpCompletionRoutine: u8*) -> i32;
}

![target(windows)]
![link("ws2_32")]
extern "C" {
    // Lifecycle.  lpWSAData points at a >=408-byte WSADATA buffer.
    function WSAStartup(wVersionRequested: u16, lpWSAData: u8*) -> i32;
    function WSACleanup() -> i32;
    function WSAGetLastError() -> i32;

    // Socket lifecycle.  Returns a SOCKET (u64); INVALID_SOCKET on failure.
    function socket(af: i32, sock_type: i32, protocol: i32) -> u64;
    function closesocket(s: u64) -> i32;
    function ioctlsocket(s: u64, cmd: i32, argp: u32*) -> i32;

    // Connection setup.  `namelen`/`addrlen` are `int`, not socklen_t.
    function bind(s: u64, addr: u8*, namelen: i32) -> i32;
    function listen(s: u64, backlog: i32) -> i32;
    function accept(s: u64, addr: u8*, addrlen: i32*) -> u64;
    function connect(s: u64, name: u8*, namelen: i32) -> i32;
    function getsockname(s: u64, name: u8*, namelen: i32*) -> i32;
    function shutdown(s: u64, how: i32) -> i32;

    // Data transfer.  `len` is `int`; the return is `int` (bytes or -1).
    function send(s: u64, buf: u8*, len: i32, flags: i32) -> i32;
    function recv(s: u64, buf: u8*, len: i32, flags: i32) -> i32;
    function sendto(s: u64, buf: u8*, len: i32, flags: i32,
                    to: u8*, tolen: i32) -> i32;
    function recvfrom(s: u64, buf: u8*, len: i32, flags: i32,
                      from: u8*, fromlen: i32*) -> i32;

    // Options.  optval/optlen as bytes; level/optname numeric.
    function setsockopt(s: u64, level: i32, optname: i32,
                        optval: u8*, optlen: i32) -> i32;
    function getsockopt(s: u64, level: i32, optname: i32,
                        optval: u8*, optlen: i32*) -> i32;

    // Name resolution (Winsock getaddrinfo mirrors the POSIX shape; the
    // addrinfo struct's ai_addr/ai_canonname fields are swapped vs glibc -
    // net::dns reads ai_addr at the per-OS offset).
    function getaddrinfo(node: u8*, service: u8*, hints: u8*, res: u8**) -> i32;
    function freeaddrinfo(res: u8*) -> void;
}
