// Generic escape hatch: call any syscall by `Syscall` variant with up to
// six i64-shaped arguments. Useful for syscalls that don't yet have a
// typed wrapper above. Pre-cast non-i64 args at the call site.
//
// ## Contract: the RAW KERNEL convention
//
// `sys_callN` returns the kernel's result register untranslated: a value
// in `[-4095, -1]` is `-errno` (`-EINTR` == -4, `-ENOENT` == -2, ...);
// anything else is the success value. libc's `errno` is NOT set. This
// differs from the typed `sys_*` wrappers above, which go through libc's
// `syscall()` trampoline and use its `-1`-plus-`errno` convention.
// Callers of syscalls whose success values can be "negative" as i64
// (`mmap` may return addresses above `i64` sign range on some future
// arch) must apply the `-4095..-1` window themselves, exactly as with a
// raw kernel return.
//
// ## Implementation (Low-Level Plan Stage 2)
//
// The `syscall` instruction issued directly via inline asm - no libc
// involvement. Landed behind a `native_syscalls` migration switch, proven
// (object inspection, differential gate, dual-OS selfhost fixed point),
// then the libc-trampoline arm and the switch were deleted: on Linux the
// kernel syscall interface IS the stable ABI, so this is simply the
// implementation. x86-64 kernel ABI: number in `rax`, args in
// `rdi`/`rsi`/`rdx`/`r10`/`r8`/`r9` (NOT `rcx` - the instruction
// itself overwrites `rcx` with the return RIP and `r11` with
// RFLAGS, which is why both are clobbered), result in `rax`. The
// `memory` clobber orders the call against surrounding loads/stores
// since the kernel reads/writes user memory through pointer args the
// optimizer cannot see. The `mov reg, ${x:"reg"}` lines assemble to
// self-moves (a pinned operand substitutes as its register name);
// they exist to BIND each value to its ABI register - LLVM places
// the values before the block runs.

![target(linux)]
function sys_call0(num: Syscall) -> i64 {
    const n: i64 = num as i64;
    mut ret: i64 = 0;
    ![arch(x86_64, intel)]
    ![clobber(rcx, r11, memory)]
    asm {
        mov rax, ${n:"rax"}
        syscall
        mov ${=ret:"rax"}, rax
    }
    return ret;
}

![target(linux)]
function sys_call1(num: Syscall, a: i64) -> i64 {
    const n: i64 = num as i64;
    mut ret: i64 = 0;
    ![arch(x86_64, intel)]
    ![clobber(rcx, r11, memory)]
    asm {
        mov rax, ${n:"rax"}
        mov rdi, ${a:"rdi"}
        syscall
        mov ${=ret:"rax"}, rax
    }
    return ret;
}

![target(linux)]
function sys_call2(num: Syscall, a: i64, b: i64) -> i64 {
    const n: i64 = num as i64;
    mut ret: i64 = 0;
    ![arch(x86_64, intel)]
    ![clobber(rcx, r11, memory)]
    asm {
        mov rax, ${n:"rax"}
        mov rdi, ${a:"rdi"}
        mov rsi, ${b:"rsi"}
        syscall
        mov ${=ret:"rax"}, rax
    }
    return ret;
}

![target(linux)]
function sys_call3(num: Syscall, a: i64, b: i64, c: i64) -> i64 {
    const n: i64 = num as i64;
    mut ret: i64 = 0;
    ![arch(x86_64, intel)]
    ![clobber(rcx, r11, memory)]
