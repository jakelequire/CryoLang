///! std — the Cryo standard library.
///!
///! This file is the root manifest: it declares every module in the stdlib
///! and places a short description beside each. Each module's own `_module.cryo`
///! repeats the sub-module list with more context; this file gives the
///! 30-second overview that helps you decide where to look.
///!
///! # Design principles
///!
///! - **No magic numbers.** Every numeric constant is named; bare literals
///!   in source code are a sign of missing abstraction.
///! - **No NUL-terminated strings outside `ffi/`.** All other modules work
///!   in length-typed `Str` and `String` values. The translation to and from
///!   C strings happens at the boundary in `ffi::cstr`.
///! - **`Result` for fallible operations, `panic` for broken invariants.**
///!   Callers get `Result<T, E>` whenever failure is expected; a function
///!   panics only when the contract truly cannot be preserved.
///! - **Explicit resource management.** Every owning type exposes a
///!   `drop(mut &this)` method. The doc comment on each type identifies
///!   who is responsible for calling it.
///! - **Allocator-generic containers.** `Array<T>`, `HashMap<K,V>`, etc.
///!   default to `GlobalAlloc` but accept any type implementing `Allocator`.
///!
///! # Module hierarchy
///!
///! ```
///! std
///! ├── prelude        — names auto-imported into every file
///! ├── core           — language foundations (no heap, no I/O)
///! ├── alloc          — heap allocation primitives
///! ├── collections    — growable containers
///! ├── io             — byte-level I/O traits and standard streams
///! ├── fmt            — Display/Debug traits and integer formatting
///! ├── json           — RFC 8259 JSON parser and serializer
///! ├── fs             — filesystem: paths and files
///! ├── ffi            — the C ABI boundary (NUL-string helpers)
///! ├── env            — process environment and arguments
///! ├── math           — libm float operations
///! ├── net            — TCP sockets and HTTP/1.1
///! │   └── http       — HTTP method, status, headers, request/response,
///! │                    connection-per-request server and client
///! ├── process        — subprocess spawning (fork + execve, POSIX)
///! └── test           — built-in unit-test framework (see `cryo test`)
///! ```
namespace std;

// ============================================================================
// Prelude
// ============================================================================

/// Names automatically imported into every Cryo source file.
///
/// The set is deliberately small — every name here competes for user
/// attention. Currently re-exports:
///   • `core::panic`  — `panic(message, file, line) -> !`
///   • `core::option` — `Option<T>` (`Some` / `None`)
///   • `core::result` — `Result<T, E>` (`Ok` / `Err`)
public module prelude;

// ============================================================================
// core — language foundations
// ============================================================================

/// Language foundations. Nothing in `core` allocates or performs I/O;
/// all higher-level modules build on what lives here.
///
/// Sub-modules:
///   • `intrinsics`  — compiler-backed `memcpy`, `memset`, `sizeof`, `alignof`
///   • `panic`       — `panic(message, file, line) -> !`
///   • `primitives`  — `min_value`, `max_value`, `BITS` for every numeric type
///   • `option`      — `Option<T>` (`Some` / `None`)
///   • `result`      — `Result<T, E>` (`Ok` / `Err`)
///   • `error`       — `CrError { code, message }` lightweight error value
///   • `slice`       — `Slice<T>` borrowed contiguous view; `SliceIter<T>`
///   • `ptr`         — `NonNull<T>` guaranteed non-null pointer
///   • `mem`         — `copy`, `zero`, `swap`, `offset`, `transmute`, align helpers
///   • `marker`      — `Sized`, `Send`, `Sync` (bound-only, no methods)
///   • `clone`       — `Clone` trait; primitive impls
///   • `default`     — `Default` trait; primitive impls (zero / false / '\0')
///   • `cmp`         — `Ordering`, `Eq`, `Ord`; `min`, `max`, `clamp`
///   • `convert`     — `From`, `Into`, `TryFrom`, `TryInto`, `ConversionError`
///   • `iter`        — `Iterator<Item>`, `IntoIterator`
///   • `ops`         — `Range<T>`, `RangeInclusive<T>`, `Step`
///   • `hash`        — `Hasher`, `Hash`, `DefaultHasher` (FNV-1a)
public module core;

// ============================================================================
// alloc — heap allocation
// ============================================================================

/// Heap allocation primitives. Every type in `alloc` owns storage and
/// must have `drop(mut &this)` called before going out of scope.
///
/// Sub-modules:
///   • `layout`     — `Layout { size, align }`; `new<T>()`, `array<T>(n)`
///   • `allocator`  — `Allocator` trait; `AllocError`; `AllocErrorKind`
///                    (`OutOfMemory`, `Exhausted`, `InvalidLayout`); `GlobalAlloc`
///   • `box`        — `Box<T>` unique heap ownership
///   • `arena`      — bump allocator (64 KiB chunks, `reset`, `drop`)
///   • `pool`       — fixed-slot slab allocator; layout mismatch → `InvalidLayout`
///   • `rc`         — `Rc<T>` single-threaded reference-counted pointer
public module alloc;

// ============================================================================
// collections — growable containers
// ============================================================================

/// Growable containers built on `alloc`. Every container owns heap
/// storage and exposes a manual `drop`. Allocator choice is a type
/// parameter with a `GlobalAlloc` default.
///
/// Sub-modules:
///   • `raw_buffer` — `RawBuffer<T, A>` untyped backing store (internal)
///   • `array`      — `Array<T, A>` contiguous growable sequence;
///                    `push`, `pop`, `push_slice`, `try_push_slice`, …
///   • `str`        — `Str` borrowed length-typed UTF-8 slice;
///                    `to_ascii_lowercase`, `equals`, `starts_with`, …;
///                    implements `Eq + Hash`
///   • `string`     — `String` owned growable UTF-8; implements `Eq + Hash`
///   • `hashmap`    — `HashMap<K, V, A>` separate-chaining hash table;
///                    `K: Hash + Eq`; `get_bucket` for bucket traversal
///   • `hashset`    — `HashSet<T, A>` backed by `HashMap<T, ()>`
///   • `pair`       — `Pair<A, B>` owned two-element tuple; `Drop`/`Eq`
///                    parametric on the members.  Small associative
///                    lists are typically `Pair<K, V>[]`
public module collections;

// ============================================================================
// io — byte-level input / output
// ============================================================================

/// Byte-level I/O. Every byte source or sink implements `Read` or
/// `Write`; `IoError` is the failure channel for all I/O operations.
///
/// Sub-modules:
///   • `error`  — `IoError { kind, os_code }`; `IoErrorKind` enum;
///               `from_errno(code)` maps POSIX errno; named errno
///               constants (EINTR, EACCES, EPIPE, …)
///   • `fd`     — `read_fd`, `write_fd`, `close_fd` retry-on-EINTR
///               wrappers (POSIX flag constants and `errno()` live
///               in `ffi::libc`)
///   • `traits` — `Read` and `Write` traits; defaults for `read_byte`,
///               `read_char` (UTF-8 decode), `read_until`, `read_line`,
///               `read_exact`, `read_all`, `read_to_end`,
///               `read_to_string`; `write_all`, `write_str`, `write_line`
///   • `stdio`  — `Stdin`/`Stdout`/`Stderr` handles; `is_tty()`,
///               `as_fd()` on each; `Stdin::line()` owning-read +
///               newline-strip; `Stdin::prompt(msg)` (prompt to
///               stderr, read one line); `isatty(fd)` / `is_tty(fd)`
///               free fn; `NEWLINE` / `LINE_FEED` constants
///   • `buf`    — `BufWriter<W>`, `LineWriter<W>`, `BufReader<R>`
///               (coalesce small reads/writes into one syscall each)
public module io;

// ============================================================================
// fmt — text formatting
// ============================================================================

/// Human- and developer-readable text formatting.
///
/// Sub-modules:
///   • `error`    — `FmtError { Io(IoError) | Alloc(AllocError) }`
///   • `write`    — `FmtWrite` trait; impls for `Stdout`, `Stderr`, `String`
///   • `integer`  — `write_u64_decimal/_hex/_oct/_bin` (no heap);
///                  padded variants; `parse_u64/_u32/_u16/_u8/_hex`
///   • `float`    — `write_f64` decimal + scientific-notation writer
///   • `display`  — `Display` and `Debug` traits; `Formatter<W>` borrowing
///                  its sink; `print`, `println`, `eprint`, `eprintln`
///                  (single-syscall on values up to 256 bytes);
///                  `format_to_string`, `format_debug_to_string`
public module fmt;

// ============================================================================
// json — RFC 8259 JSON parser and serializer
// ============================================================================

/// JSON value model, parser, and serializer. Foundational for any
/// Cryo program that speaks JSON-RPC, REST, or persists configuration
/// in JSON form. Not auto-imported — `import std::json;` explicitly.
///
/// Sub-modules:
///   • `error`      — `JsonError`, `JsonErrorKind`
///   • `value`      — `JsonValue`, `JsonNumber`, `JsonObject`
///   • `parser`     — `parse(text) -> Result<JsonValue, JsonError>`,
///                    `MAX_DEPTH`
///   • `serializer` — `stringify`, `stringify_pretty`, `write_value`,
///                    `write_pretty`
public module json;

// ============================================================================
// fs — filesystem
// ============================================================================

/// Filesystem access. `File` implements `Read + Write` so any code
/// already targeting the I/O traits works against files without glue.
///
/// Sub-modules:
///   • `path`  — `Path` (borrowed), `PathBuf` (owned);
///              `extension`, `file_name`, `parent`, `join`, `is_absolute`
///   • `file`  — `OpenOptions` builder; `File` (`Read + Write`);
///              convenience `read(path)` and `write(path, bytes)`;
///              `O_CREAT/EXCL/TRUNC/APPEND`; `SEEK_SET/CUR/END`
public module fs;

// ============================================================================
// ffi — C ABI boundary
// ============================================================================

/// The C ABI boundary. The only place in the stdlib where NUL-terminated
/// strings and raw platform types are allowed. Every other module works
/// in `Str` / `String`; FFI helpers translate at the boundary.
///
/// Sub-modules:
///   • `libc`  — single home for every `extern "C"` the stdlib needs;
///              `read`, `write`, `open`, `fork`, `socket`, `sqrt`, …,
///              plus the POSIX constants (`O_*`, `AF_*`, `SOCK_*`,
///              `SO_*`, `W*`, `STD*_FILENO`) and the `Whence` /
///              `ShutdownHow` enums. Modules consume via
///              `import ffi::libc;`.
///   • `cstr`  — `CStr` (borrowed `*u8`), `CString` (owned),
///              `NulError`; `CString::from_str(s)` → `Result<CString, NulError>`
public module ffi;

// ============================================================================
// env — process environment
// ============================================================================

/// Process environment and argument access.
/// `args() -> Array<Str>`, `var(name) -> Option<Str>`,
/// `set_var(name, value)`, `exit(code) -> !`.
public module env;

// ============================================================================
// math — libm float operations
// ============================================================================

/// Thin wrappers over libm. Inherits platform behavior (rounding mode,
/// errno on domain errors, subnormal handling). Naming follows C:
/// `sqrt`, `cbrt`, `pow`, `exp`, `ln`, `log2`, `log10`,
/// `sin`, `cos`, `tan`, `asin`, `acos`, `atan`, `atan2`,
/// `sinh`, `cosh`, `tanh`, `floor`, `ceil`, `round`, `trunc`, `fabs`.
/// f32 variants use C's `*f` names surfaced as `*_f32` (e.g. `sqrt_f32`).
public module math;

// ============================================================================
// net — network primitives and HTTP
// ============================================================================

/// Network primitives (IP addresses, sockets, TCP) and an HTTP/1.1
/// layer. TLS, UDP, HTTP/2, and WebSocket are explicitly out of scope.
///
/// Sub-modules:
///   • `ip`          — `IpV4Addr`, `IpV6Addr`, `IpAddr`
///   • `socket_addr` — `SocketAddr { ip, port }`; `parse_v4`
///   • `tcp`         — `TcpStream` (`Read + Write`), `TcpListener`
///   • `http`        — HTTP/1.1 layer (see below)
///
/// `http` sub-modules:
///   • `http::method`   — `Method` enum (`Get`, `Post`, `Put`, …)
///   • `http::status`   — `StatusCode`; named constructors; `reason_phrase`
///   • `http::headers`  — `Headers` case-insensitive map; `write_to`
///                        serializes all headers as `name: value\r\n`
///   • `http::request`  — `Request`; `parse`, `write_to`;
///                        `HTTP_VERSION`, `MAX_HEADER_LINE`, `MAX_BODY`
///   • `http::response` — `Response`; `text`, `json`, `set_body`,
///                        `write_to` (complete HTTP/1.1 message)
///   • `http::server`   — `serve(addr, handler)` connection-per-request
///   • `http::client`   — `Client::get/post`; `send(addr, req)`
public module net;

// ============================================================================
// process — subprocess spawning
// ============================================================================

/// POSIX subprocess spawning (`fork + execve`). Windows is not yet supported.
///
/// Sub-modules:
///   • `signal`  — `Signal { number }`; `hup`, `int`, `quit`, `kill`, `term`
///   • `child`   — `ExitStatus`, `Child`; `wait`, `try_wait`, `kill`;
///                `ChildStdin` (`Write`), `ChildStdout`/`ChildStderr` (`Read`)
///   • `command` — `Command` builder (`arg`, `env`, `stdin`, `stdout`, …);
///                `spawn`, `output`, `status`;
///                `Stdio` (`Inherit`, `Null`, `Piped`, `Fd`);
///                `Output { status, stdout, stderr }`
public module process;

// ============================================================================
// test — built-in unit-test framework
// ============================================================================

/// Cryo's built-in unit-test framework. Tests live in `<project>/tests/`
/// files whose `namespace` is marked `![config(testing)]`; functions
/// inside marked with `![test]` are discovered by the compiler and run
/// fork-per-test by `cryo test`. See `stdlib/test/_module.cryo` for the
/// full surface.
///
/// Sub-modules:
///   • `error`      — `TestError { Failed(String) | Other(String) }`;
///                   `Display` impl
///   • `descriptor` — `TestDescriptor { name, func, ignored, should_panic }`
///                   (layout matched by the compiler-synthesized test main)
///   • `assert`     — `expect(cond, msg)`, `expect_eq`, `expect_ne`,
///                   `bail`, `bail_other`
///   • `runner`     — `run_all(argc, argv, descriptors, count) -> i32`;
///                   `RunOptions`; `TestOutcome`
public module test;
