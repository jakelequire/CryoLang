///! WebSocket opening handshake (RFC 6455 section 4).
///!
///! The client sends an HTTP/1.1 GET with `Upgrade: websocket` and a
///! random `Sec-WebSocket-Key`; the server replies `101` with
///! `Sec-WebSocket-Accept = base64(sha1(key + GUID))`. These helpers
///! compute those two values; the HTTP exchange itself lives in `conn`.

namespace std::net::ws::handshake;

import std::collections::array::{ Array };
import std::collections::string::{ String };
import std::collections::str::{ Str };
import std::encoding::sha1::{ sha1 };
import std::encoding::base64::{ Base64 };
import std::random::secure::{ SecureRng };
import std::random::source::{ RandomSource };
import std::core::mem;

/// 16 random bytes from the OS CSPRNG, base64-encoded - the client's
/// `Sec-WebSocket-Key`.
public function generate_key() -> String {
    mut raw: [u8; 16];
    SecureRng::new().fill(&raw);
    return Base64::standard().encode(raw.as_slice());
}

/// `Sec-WebSocket-Accept` for a given client key: `base64(sha1(key + GUID))`.
public function compute_accept(client_key: Str) -> String {
    // The fixed GUID every WebSocket endpoint mixes into the accept hash.
    // Inlined as a LOCAL const: a module-level `const Str = Str::new(..)`
    // reads back empty at runtime, which would silently drop the GUID and
    // produce the wrong accept value.
    const ws_guid: Str = Str::new("258EAFA5-E914-47DA-95CA-C5AB0DC85B11");
    mut buf: Array<u8> = Array::<u8>::with_capacity(client_key.length() + ws_guid.length());
    buf.append(client_key.as_bytes());
    buf.append(ws_guid.as_bytes());

    mut digest: [u8; 20];
    sha1::sha1(buf.as_ptr(), buf.length(), &digest[0]);
    mem::drop(buf);

    return Base64::standard().encode(digest.as_slice());
}
