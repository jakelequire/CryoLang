///! net::ws: WebSocket (RFC 6455) client + server.
///!
///! Non-blocking throughout, over one buffered connection: `WebSocket<S>`
///! owns a `BufStream<S>`, so the same code speaks ws:// over `TcpStream`
///! and wss:// over `TlsStream`. The handshake is HTTP/1.1 Upgrade; framing
///! covers text/binary messages, fragmentation reassembly, and the control
///! frames (Ping/Pong/Close). SHA-1 + base64 for the accept key are
///! pure-Cryo (`std::encoding`), so plain ws:// pulls in no crypto
///! dependency.

namespace std::net::ws;

module {
    net::ws::frame;
    net::ws::handshake;
    net::ws::conn;
}
