///! net::addr::url: a parser for absolute URLs.
///!
///! `Url::parse` breaks `scheme://[user@]host[:port][/path][?query][#fragment]`
///! into its parts. It is a BORROWING view, like `Str` and `Path`: every field
///! is a slice into the `source` string, so parsing allocates nothing and the
///! `Url` carries no destructor - the caller must keep `source` alive for as
///! long as the `Url` is used.
///!
///! Scope for a first parser:
///!   - Requires an absolute URL with a `scheme://` (relative URLs error).
///!   - `host` is taken verbatim; an IPv6 literal `[::1]` is unwrapped to its
///!     inner address (`::1`).  Any `user[:pass]@` userinfo is skipped, not
///!     exposed.
///!   - `port` is the explicit port when present, else the scheme's default
///!     (`http`/`ws` -> 80, `https`/`wss` -> 443, `ftp` -> 21), else 0.
///!   - `path` is always non-empty: an absent path reads as `/`.
///!   - No percent-decoding, no normalisation - parts are returned as written.

namespace std::net::addr::url;

import std::core::option::{ Option };
import std::core::result::{ Result };
import std::core::convert;
import std::collections::str::{ Str };
import std::collections::pair::{ Pair };
import std::fmt::display::{ Display, Formatter };
import std::fmt::error::{ FmtError };

private const COLON:    u8 = 0x3A;  // ':'
private const SLASH:    u8 = 0x2F;  // '/'
private const QUESTION: u8 = 0x3F;  // '?'
private const HASH:     u8 = 0x23;  // '#'
private const AT:       u8 = 0x40;  // '@'
private const RBRACKET: u8 = 0x5D;  // ']'

/// Why a URL failed to parse.
public type enum UrlError {
    /// No `scheme://` - the input is not an absolute URL.
    MissingScheme;
    /// A `://` with nothing before it.
    EmptyScheme;
    /// The authority had no host (`scheme:///path`, `scheme://:80`).
    EmptyHost;
    /// A `:port` that was empty, non-numeric, or out of `u16` range.
    InvalidPort;
}

implement enum UrlError {
    /// A short human-readable reason, for diagnostics.
    public message(&this) -> Str {
        match (&this) {
            UrlError::MissingScheme => { return Str::new("missing scheme://"); }
            UrlError::EmptyScheme   => { return Str::new("empty scheme"); }
            UrlError::EmptyHost     => { return Str::new("empty host"); }
            UrlError::InvalidPort   => { return Str::new("invalid port"); }
        }
    }
}

/// Length of `s`'s leading run that stops at the first `/`, `?`, or `#` -
/// i.e. where the authority ends and the path/query/fragment begins.
private function authority_end(s: Str) -> i64 {
    const n: i64 = s.length();
    mut i: i64 = 0;
    while (i < n) {
        match (s.byte_at(i)) {
            Option::Some(b) => {
                if (b == SLASH || b == QUESTION || b == HASH) { return i; }
            }
            Option::None => { return i; }
        }
        i = i + 1;
    }
    return n;
}

/// The well-known default port for `scheme`, or 0 if none is known.
private function default_port(scheme: Str) -> u16 {
    if (scheme.equals_case_insensitive(&Str::new("http")))  { return 80; }
    if (scheme.equals_case_insensitive(&Str::new("https"))) { return 443; }
    if (scheme.equals_case_insensitive(&Str::new("ws")))    { return 80; }
    if (scheme.equals_case_insensitive(&Str::new("wss")))   { return 443; }
    if (scheme.equals_case_insensitive(&Str::new("ftp")))   { return 21; }
    return 0;
}

public type struct Url {
    public scheme:   Str;
    public host:     Str;
    public port:     u16;
    public path:     Str;            // never empty; "/" when the URL had no path
    public query:    Option<Str>;    // without the leading '?'
    public fragment: Option<Str>;    // without the leading '#'

    /// Parse an absolute URL. See the module docs for the accepted shape.
    public static parse(source: Str) -> Result<Url, UrlError> {
        // 1. Split off the scheme at "://".
        const scheme_and_rest: Pair<Str, Str> = match (source.split_once(&Str::new("://"))) {
            Option::Some(parts) => { parts }
            Option::None        => { return Result::Err(UrlError::MissingScheme); }
        };
        const scheme: Str = scheme_and_rest.first;
        if (scheme.is_empty()) { return Result::Err(UrlError::EmptyScheme); }
        const after: Str = scheme_and_rest.second;

        // 2. Authority is up to the first '/', '?' or '#'.
        const ae: i64 = authority_end(after);
        const authority: Str = after.sub_bytes(0, ae);
        const rest: Str = after.sub_bytes(ae, after.length());

        // 3. Drop any `user[:pass]@` userinfo; the host is what follows.
        mut host_port: Str = authority;
        match (authority.rfind_byte(AT)) {
            Option::Some(at) => { host_port = authority.sub_bytes(at + 1, authority.length()); }
            Option::None     => { }
        }

        // 4. Split host and optional port.
        mut host: Str = host_port;
        mut port: u16 = default_port(scheme);
        if (host_port.starts_with(&Str::new("["))) {
            // IPv6 literal `[addr]` with an optional `:port` after `]`.
            const close: i64 = match (host_port.find_byte(RBRACKET)) {
                Option::Some(i) => { i }
                Option::None    => { return Result::Err(UrlError::EmptyHost); }
            };
            host = host_port.sub_bytes(1, close);
            const tail: Str = host_port.sub_bytes(close + 1, host_port.length());
            if (!tail.is_empty()) {
                if (!tail.starts_with(&Str::new(":"))) { return Result::Err(UrlError::InvalidPort); }
                match (Url::parse_port(tail.sub_bytes(1, tail.length()))) {
                    Result::Ok(p)  => { port = p; }
                    Result::Err(e) => { return Result::Err(e); }
                }
            }
        } else {
            match (host_port.rsplit_once(&Str::new(":"))) {
                Option::Some(parts) => {
                    host = parts.first;
                    match (Url::parse_port(parts.second)) {
                        Result::Ok(p)  => { port = p; }
                        Result::Err(e) => { return Result::Err(e); }
                    }
                }
                Option::None => { }
            }
        }
        if (host.is_empty()) { return Result::Err(UrlError::EmptyHost); }

        // 5. Split rest into path / ?query / #fragment. Fragment is everything
        //    after the first '#'; query is between the first '?' and that '#'.
        mut pre_frag: Str = rest;
        mut fragment: Option<Str> = Option::None;
        match (rest.split_once(&Str::new("#"))) {
            Option::Some(parts) => {
                pre_frag = parts.first;
                fragment = Option::Some(parts.second);
            }
            Option::None => { }
        }

        mut path: Str = pre_frag;
        mut query: Option<Str> = Option::None;
        match (pre_frag.split_once(&Str::new("?"))) {
            Option::Some(parts) => {
                path = parts.first;
                query = Option::Some(parts.second);
            }
            Option::None => { }
        }
        if (path.is_empty()) { path = Str::new("/"); }

        return Result::Ok(Url {
            scheme:   scheme,
            host:     host,
            port:     port,
            path:     path,
            query:    query,
            fragment: fragment
        });
    }

    /// Parse a non-empty decimal port into a `u16`.
    private static parse_port(digits: Str) -> Result<u16, UrlError> {
        if (digits.is_empty()) { return Result::Err(UrlError::InvalidPort); }
        match (u16::try_from(digits)) {
            Result::Ok(p)  => { return Result::Ok(p); }
            Result::Err(_) => { return Result::Err(UrlError::InvalidPort); }
        }
    }
}

/// `scheme://host[:port]path[?query][#fragment]`: the URL as parsed, less
/// the userinfo the parser does not keep.  An IPv6 host is written in
/// brackets, and the port only when it is not the scheme's default, so a
/// URL written without one reads back without one.
implement trait Display for struct Url {
    fmt(&this, f: mut &Formatter) -> Result<(), FmtError> {
        f.write_str(this.scheme)?;
        f.write_str(Str::new("://"))?;
        const bracketed: boolean = this.host.find_byte(COLON).is_some();
        if (bracketed) { f.write_str(Str::new("["))?; }
        f.write_str(this.host)?;
        if (bracketed) { f.write_str(Str::new("]"))?; }
        if (this.port != default_port(this.scheme)) {
            f.write_str(Str::new(":"))?;
            (Display for u16)::fmt(&this.port, f)?;
        }
        f.write_str(this.path)?;
        match (this.query) {
            Option::Some(query) => {
                f.write_str(Str::new("?"))?;
                f.write_str(query)?;
            }
            Option::None => { }
        }
        match (this.fragment) {
            Option::Some(fragment) => {
                f.write_str(Str::new("#"))?;
                f.write_str(fragment)?;
            }
            Option::None => { }
        }
        return Result::Ok(());
    }
}
