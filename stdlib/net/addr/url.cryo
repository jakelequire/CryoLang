///! net::addr::url: a parser for absolute URLs.
///!
///! `Url::parse` breaks `scheme://[user@]host[:port][/path][?query][#fragment]`
///! into its parts. It is a BORROWING view, like `Str` and `Path`: every field
///! is a slice into the `source` string, so parsing allocates nothing and the
///! `Url` carries no destructor - the caller must keep `source` alive for as
///! long as the `Url` is used.
///!
///! Scope for a first parser:
///!   - Requires an absolute URL with a `scheme://` (relative URLs error).
///!   - `host` is taken verbatim; an IPv6 literal `[::1]` is unwrapped to its
///!     inner address (`::1`).  Any `user[:pass]@` userinfo is skipped, not
///!     exposed.
///!   - `port` is the explicit port when present, else the scheme's default
///!     (`http`/`ws` -> 80, `https`/`wss` -> 443, `ftp` -> 21), else 0.
///!   - `path` is always non-empty: an absent path reads as `/`.
///!   - No percent-decoding, no normalisation - parts are returned as written.

namespace std::net::addr::url;

import std::core::option::{ Option };
import std::core::result::{ Result };
import std::core::convert;
import std::core::primitives;
import std::collections::array::{ Array };
import std::collections::str::{ Str };
import std::collections::string::{ String };
import std::collections::pair::{ Pair };
import std::core::error::{ Error };
import std::fmt::display::{ Display, Debug, Formatter };
import std::fmt::error::{ FmtError };

private const COLON:    u8 = 0x3A;  // ':'
private const SLASH:    u8 = 0x2F;  // '/'
private const QUESTION: u8 = 0x3F;  // '?'
private const HASH:     u8 = 0x23;  // '#'
private const AT:       u8 = 0x40;  // '@'
private const LBRACKET: u8 = 0x5B;  // '['
private const RBRACKET: u8 = 0x5D;  // ']'
private const PLUS:     u8 = 0x2B;  // '+'
private const MINUS:    u8 = 0x2D;  // '-'
private const DOT:      u8 = 0x2E;  // '.'

/// Why a URL failed to parse.
public type enum UrlError with [Eq, Clone, Debug] {
    /// No `scheme://` - the input is not an absolute URL.
    MissingScheme;
    /// A `://` with nothing before it.
    EmptyScheme;
    /// The authority had no host (`scheme:///path`, `scheme://:80`).
    EmptyHost;
    /// A `:port` that was empty, non-numeric, or out of `u16` range.
    InvalidPort;
}

implement enum UrlError {
    /// A short human-readable reason, for diagnostics.
    public message(&this) -> Str {
        match (&this) {
            UrlError::MissingScheme => { return Str::new("missing scheme://"); }
            UrlError::EmptyScheme   => { return Str::new("empty scheme"); }
            UrlError::EmptyHost     => { return Str::new("empty host"); }
            UrlError::InvalidPort   => { return Str::new("invalid port"); }
        }
    }
}

implement trait Display for enum UrlError {
    fmt(&this, f: mut &Formatter) -> Result<(), FmtError> {
        return f.write_str(this.message());
    }
}

implement trait Error for enum UrlError { }

/// Length of `s`'s leading run that stops at the first `/`, `?`, or `#` -
/// i.e. where the authority ends and the path/query/fragment begins.
private function authority_end(s: Str) -> i64 {
    const n: i64 = s.length();
    mut i: i64 = 0;
    while (i < n) {
        match (s.byte_at(i)) {
            Option::Some(b) => {
                if (b == SLASH || b == QUESTION || b == HASH) { return i; }
            }
            Option::None => { return i; }
        }
        i = i + 1;
    }
    return n;
}

/// The well-known default port for `scheme`, or 0 if none is known.
private function default_port(scheme: Str) -> u16 {
    if (scheme.equals_case_insensitive(&Str::new("http")))  { return 80; }
    if (scheme.equals_case_insensitive(&Str::new("https"))) { return 443; }
    if (scheme.equals_case_insensitive(&Str::new("ws")))    { return 80; }
    if (scheme.equals_case_insensitive(&Str::new("wss")))   { return 443; }
    if (scheme.equals_case_insensitive(&Str::new("ftp")))   { return 21; }
    return 0;
}

/// An absolute URL split into its parts, each a view into the text it was
/// parsed from (keep that text alive while the `Url` is used). `port` is the
/// scheme's default when the URL names none, and 0 for a scheme with no
/// known default; `path` is `/` when the URL has none; `query` and
/// `fragment` exclude their `?` and `#`. See the module documentation for
/// what `parse` accepts.
///
/// ```cryo
/// import std::collections::str::{ Str };
/// import std::net::addr::url::{ Url };
///
/// const url: Url = Url::parse(Str::new("https://example.com/search?q=cryo")).unwrap();
/// // url.host is "example.com", url.port is 443, url.path is "/search",
/// // url.query is Some("q=cryo")
/// ```
public type struct Url {
    public scheme:   Str;
    public host:     Str;
    public port:     u16;
    public path:     Str;            // never empty; "/" when the URL had no path
    public query:    Option<Str>;    // without the leading '?'
    public fragment: Option<Str>;    // without the leading '#'

    /// Parse an absolute URL. See the module docs for the accepted shape.
    public static parse(source: Str) -> Result<Url, UrlError> {
        // 1. Split off the scheme at "://".
        const scheme_and_rest: Pair<Str, Str> = match (source.split_once(&Str::new("://"))) {
            Option::Some(parts) => { parts }
            Option::None        => { return Result::Err(UrlError::MissingScheme); }
        };
        const scheme: Str = scheme_and_rest.first;
        if (scheme.is_empty()) { return Result::Err(UrlError::EmptyScheme); }
        const after: Str = scheme_and_rest.second;

        // 2. Authority is up to the first '/', '?' or '#'.
        const ae: i64 = authority_end(after);
        const authority: Str = after.sub_bytes(0, ae);
        const rest: Str = after.sub_bytes(ae, after.length());

        // 3. Drop any `user[:pass]@` userinfo; the host is what follows.
        mut host_port: Str = authority;
        match (authority.rfind_byte(AT)) {
            Option::Some(at) => { host_port = authority.sub_bytes(at + 1, authority.length()); }
            Option::None     => { }
        }

        // 4. Split host and optional port.
        mut host: Str = host_port;
        mut port: u16 = default_port(scheme);
        if (host_port.starts_with(&Str::new("["))) {
            // IPv6 literal `[addr]` with an optional `:port` after `]`.
            const close: i64 = match (host_port.find_byte(RBRACKET)) {
                Option::Some(i) => { i }
                Option::None    => { return Result::Err(UrlError::EmptyHost); }
            };
            host = host_port.sub_bytes(1, close);
            const tail: Str = host_port.sub_bytes(close + 1, host_port.length());
            if (!tail.is_empty()) {
                if (!tail.starts_with(&Str::new(":"))) { return Result::Err(UrlError::InvalidPort); }
                match (Url::parse_port(tail.sub_bytes(1, tail.length()))) {
                    Result::Ok(p)  => { port = p; }
                    Result::Err(e) => { return Result::Err(e); }
                }
            }
        } else {
            match (host_port.rsplit_once(&Str::new(":"))) {
                Option::Some(parts) => {
                    host = parts.first;
                    match (Url::parse_port(parts.second)) {
                        Result::Ok(p)  => { port = p; }
                        Result::Err(e) => { return Result::Err(e); }
                    }
                }
                Option::None => { }
            }
        }
        if (host.is_empty()) { return Result::Err(UrlError::EmptyHost); }

        // 5. Split rest into path / ?query / #fragment. Fragment is everything
        //    after the first '#'; query is between the first '?' and that '#'.
        mut pre_frag: Str = rest;
        mut fragment: Option<Str> = Option::None;
        match (rest.split_once(&Str::new("#"))) {
            Option::Some(parts) => {
                pre_frag = parts.first;
                fragment = Option::Some(parts.second);
            }
            Option::None => { }
        }

        mut path: Str = pre_frag;
        mut query: Option<Str> = Option::None;
        match (pre_frag.split_once(&Str::new("?"))) {
            Option::Some(parts) => {
                path = parts.first;
                query = Option::Some(parts.second);
            }
            Option::None => { }
        }
        if (path.is_empty()) { path = Str::new("/"); }

        return Result::Ok(Url {
            scheme:   scheme,
            host:     host,
            port:     port,
            path:     path,
            query:    query,
            fragment: fragment
        });
    }

    /// `host[:port]`, the form a request's `Host` header carries: an IPv6
    /// host in brackets, the port only when it is not the scheme's default.
    public authority(&this) -> String {
        mut out: String = String::new();
        const bracketed: boolean = this.host.find_byte(COLON).is_some();
        if (bracketed) { out.push_byte(LBRACKET); }
        out.push(this.host);
        if (bracketed) { out.push_byte(RBRACKET); }
        if (this.port != default_port(this.scheme)) {
            out.push_byte(COLON);
            out.push(this.port);
        }
        return out;
    }

    /// The path and, when there is one, `?query`: the target an HTTP request
    /// line names. The fragment is never part of it.
    public path_and_query(&this) -> String {
        mut out: String = String::from_str(this.path);
        match (this.query) {
            Option::Some(query) => {
                out.push_byte(QUESTION);
                out.push(query);
            }
            Option::None => { }
        }
        return out;
    }

    /// Resolve `reference` against this URL, as a link or a `Location`
    /// header is resolved against the page it came from, and return the
    /// absolute URL it names.
    ///
    /// A reference with its own scheme is returned as written; `//host/p`
    /// keeps this URL's scheme; `/p` keeps the scheme and authority; `?q`
    /// keeps the path too; `#f` replaces only the fragment; anything else is
    /// relative to the directory of this URL's path. `.` and `..` segments
    /// of a path built that way are removed, and `..` never climbs above
    /// the root.
    ///
    /// ```cryo
    /// import std::collections::str::{ Str };
    /// import std::collections::string::{ String };
    /// import std::net::addr::url::{ Url };
    ///
    /// const base: Url = Url::parse(Str::new("http://example.com/a/b?x=1")).unwrap();
    /// const next: String = base.join(Str::new("../c"));    // http://example.com/c
    /// ```
    public join(&this, reference: Str) -> String {
        if (Url::has_scheme(reference)) { return String::from_str(reference); }
        mut out: String = String::from_str(this.scheme);
        out.push_byte(COLON);
        if (reference.starts_with(&Str::new("//"))) {
            out.push(reference);
            return out;
        }
        out.push(Str::new("//"));
        out.push(this.authority().as_str());
        if (reference.is_empty() || reference.starts_with(&Str::new("#"))) {
            out.push(this.path_and_query().as_str());
            out.push(reference);
            return out;
        }
        if (reference.starts_with(&Str::new("?"))) {
            out.push(this.path);
            out.push(reference);
            return out;
        }
        // The reference's own path ends where its query or fragment begins.
        const path_end: i64 = Url::path_length(reference);
        const reference_path: Str = reference.sub_bytes(0, path_end);
        mut merged: String = String::new();
        if (!reference_path.starts_with(&Str::new("/"))) {
            const directory_end: i64 = match (this.path.rfind_byte(SLASH)) {
                Option::Some(i) => { i + 1 }
                Option::None    => { 0 }
            };
            merged.push(this.path.sub_bytes(0, directory_end));
        }
        merged.push(reference_path);
        Url::push_without_dot_segments(&out, merged.as_str());
        out.push(reference.sub_bytes(path_end, reference.length()));
        return out;
    }

    /// Whether `text` begins with `scheme:`: a letter, then letters, digits,
    /// `+`, `-` or `.`, then a colon.
    private static has_scheme(text: Str) -> boolean {
        mut i: i64 = 0;
        while (i < text.length()) {
            const b: u8 = text.byte_at(i).unwrap();
            if (b == COLON) { return i > 0; }
            const letter: boolean = b.is_alpha();
            if (!letter && (i == 0 || !(b.is_digit() || b == PLUS || b == MINUS || b == DOT))) {
                return false;
            }
            i = i + 1;
        }
        return false;
    }

    /// Length of `reference`'s path: up to its first `?` or `#`.
    private static path_length(reference: Str) -> i64 {
        mut i: i64 = 0;
        while (i < reference.length()) {
            const b: u8 = reference.byte_at(i).unwrap();
            if (b == QUESTION || b == HASH) { return i; }
            i = i + 1;
        }
        return reference.length();
    }

    /// Append the absolute `path` to `out` with its `.` and `..` segments
    /// removed. A path ending in one of them keeps a trailing slash.
    private static push_without_dot_segments(out: mut String*, path: Str) -> void {
        mut kept: Array<Str> = Array::new();
        mut trailing_slash: boolean = false;
        for (segment in path.sub_bytes(1, path.length()).split(&Str::new("/"))) {
            trailing_slash = false;
            if (segment.equals(&Str::new("."))) {
                trailing_slash = true;
            } else if (segment.equals(&Str::new(".."))) {
                kept.pop();
                trailing_slash = true;
            } else {
                kept.push(segment);
            }
        }
        for (segment in kept.iter()) {
            out.push_byte(SLASH);
            out.push(segment);
        }
        if (trailing_slash || kept.is_empty()) { out.push_byte(SLASH); }
    }

    /// Parse a non-empty decimal port into a `u16`.
    private static parse_port(digits: Str) -> Result<u16, UrlError> {
        if (digits.is_empty()) { return Result::Err(UrlError::InvalidPort); }
        match (u16::try_from(digits)) {
            Result::Ok(p)  => { return Result::Ok(p); }
            Result::Err(_) => { return Result::Err(UrlError::InvalidPort); }
        }
    }
}

/// `scheme://host[:port]path[?query][#fragment]`: the URL as parsed, less
/// the userinfo the parser does not keep.  An IPv6 host is written in
/// brackets, and the port only when it is not the scheme's default, so a
/// URL written without one reads back without one.
implement trait Display for struct Url {
    fmt(&this, f: mut &Formatter) -> Result<(), FmtError> {
        f.write_str(this.scheme)?;
        f.write_str(Str::new("://"))?;
        f.write_str(this.authority().as_str())?;
        f.write_str(this.path)?;
        match (this.query) {
            Option::Some(query) => {
                f.write_str(Str::new("?"))?;
                f.write_str(query)?;
            }
            Option::None => { }
        }
        match (this.fragment) {
            Option::Some(fragment) => {
                f.write_str(Str::new("#"))?;
                f.write_str(fragment)?;
            }
            Option::None => { }
        }
        return Result::Ok(());
    }
}
