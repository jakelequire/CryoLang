///! SocketAddr: (IP, port).
///!
///! Used everywhere a listener binds or a client connects. `parse_v4`
///! accepts `a.b.c.d:port`. The bracketed `[v6]:port` form has no
///! parser here: read the address with `IpV6Addr::parse` and pair it
///! with the port through `new`.

namespace std::net::addr::socket_addr;

import std::core::option::{ Option };
import std::core::result::{ Result };
import std::core::convert;
import std::collections::str::{ Str };
import std::net::addr::ip::{ IpAddr, IpV4Addr, IpV6Addr };
import std::fmt::display::{ Display, Formatter };
import std::fmt::error::{ FormatError };

/// An IP address and a port: the endpoint a socket binds or connects to.
/// Printed as `a.b.c.d:port`, or `[v6]:port` for IPv6.
///
/// ```cryo
/// import std::collections::str::{ Str };
/// import std::net::addr::ip::{ IpAddr, IpV6Addr };
/// import std::net::addr::socket_addr::{ SocketAddr };
///
/// const v4: SocketAddr = SocketAddr::parse_v4(Str::new("127.0.0.1:8080")).unwrap();
/// const v6: SocketAddr = SocketAddr::new(IpAddr::V6(IpV6Addr::localhost()), 8080);
/// // v4.port == 8080; v6 prints as `[::1]:8080`
/// ```
public type struct SocketAddr {
    public ip: IpAddr;
    public port: u16;

    /// The endpoint `ip`:`port`.
    public static new(ip: IpAddr, port: u16) -> SocketAddr {
        return SocketAddr { ip: ip, port: port };
    }

    /// `0.0.0.0:port`: bind on every IPv4 interface.
    public static any_v4(port: u16) -> SocketAddr {
        return SocketAddr {
            ip: IpAddr::V4(IpV4Addr::unspecified()),
            port: port
        };
    }

    /// `127.0.0.1:port`: bind/connect on the loopback interface.
    public static localhost_v4(port: u16) -> SocketAddr {
        return SocketAddr {
            ip: IpAddr::V4(IpV4Addr::localhost()),
            port: port
        };
    }

    /// `[::]:port`: bind on every IPv6 interface.
    public static any_v6(port: u16) -> SocketAddr {
        return SocketAddr {
            ip: IpAddr::V6(IpV6Addr::unspecified()),
            port: port
        };
    }

    /// `[::1]:port`: bind/connect on the IPv6 loopback interface.
    public static localhost_v6(port: u16) -> SocketAddr {
        return SocketAddr {
            ip: IpAddr::V6(IpV6Addr::localhost()),
            port: port
        };
    }

    /// Parse `a.b.c.d:port`. Returns `None` if the address or port
    /// is malformed or the port is out of range (u16).
    public static parse_v4(source: Str) -> Option<SocketAddr> {
        // Find the ':' separator from the right so IPv6 (with colons
        // in the address) fails cleanly here rather than silently
        // misparsing.
        mut colon: i64 = source.length();
        mut i: i64 = 0;
        while (i < source.length()) {
            match (source.byte_at(i)) {
                Option::Some(byte) => {
                    if (byte == 0x3A) { colon = i; }
                }
                Option::None => { return Option::None; }
            }
            i++;
        }
        if (colon == source.length()) { return Option::None; }

        const addr_part: Str = source.sub_bytes(0, colon);
        const port_part: Str = source.sub_bytes(colon + 1, source.length());

        match (IpV4Addr::parse_opt(addr_part)) {
            Option::Some(v4) => {
                match (u16::try_from(port_part)) {
                    Result::Ok(port) => {
                        return Option::Some(SocketAddr {
                            ip: IpAddr::V4(v4),
                            port: port
                        });
                    }
                    Result::Err(_) => { return Option::None; }
                }
            }
            Option::None => { return Option::None; }
        }
    }
}

/// `a.b.c.d:port`, or an IPv6 address in brackets with the port outside
/// them (RFC 3986), `[::1]:port`.
implement trait Display for struct SocketAddr {
    fmt(&this, f: mut &Formatter) -> Result<(), FormatError> {
        match (&this.ip) {
            IpAddr::V4(v4) => {
                (Display for IpV4Addr)::fmt(&v4, f)?;
            }
            IpAddr::V6(v6) => {
                f.write_str(Str::new("["))?;
                (Display for IpV6Addr)::fmt(&v6, f)?;
                f.write_str(Str::new("]"))?;
            }
        }
        f.write_str(Str::new(":"))?;
        return (Display for u16)::fmt(&this.port, f);
    }
}
