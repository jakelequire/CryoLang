///! sockaddr_in packing/unpacking + socket-option helpers.
///!
///! Both `net::socket::tcp` and `net::socket::udp` translate between Cryo's
///! `SocketAddr` and the platform `struct sockaddr_in`; this module is
///! the shared, single home for that conversion plus the `timeval`
///! packing behind `SO_RCVTIMEO` / `SO_SNDTIMEO`.
///!
///! `sockaddr_in` is packed by hand: 16 bytes, family + port + addr
///! + 8 bytes padding, port/addr in network byte order. That avoids
///! needing cryoc to model C struct layouts for every sockaddr
///! variant. The inverse, `unpack_sockaddr_in`, reads those same
///! offsets back out of a kernel-filled buffer (e.g. from `recvfrom`
///! or `getsockname`).

namespace std::net::addr::sockaddr;

import std::core::option;
import std::core::result::{ Result };
import std::core::slice::{ Slice };
import std::io::error::{ IoError };
import std::io::bytes::{ ByteReader, ByteWriter };
import std::net::addr::ip::{ IpAddr, IpV4Addr, IpV6Addr };
import std::net::addr::socket_addr::{ SocketAddr };

// `SO_RCVTIMEO`/`SO_SNDTIMEO` settings live in `net::sys::set_timeout`: the
// option format - `struct timeval` vs a Windows DWORD - and the SO_* constant
// values are platform-specific, so they belong with the other gated socket
// primitives.

/// AF_INET6 family value (host byte order): 10 on Linux glibc, 23 on
/// Win32 Winsock. The `sockaddr_in6` layout is otherwise identical
/// (28 bytes) on both, so only this value differs per OS.
![target(unix)]
private function af_inet6() -> u16 { return 10; }
![target(windows)]
private function af_inet6() -> u16 { return 23; }

/// Pack a `SocketAddr` into a `sockaddr_in` (16 bytes, IPv4) or
/// `sockaddr_in6` (28 bytes, IPv6) buffer. Returns the number of bytes
/// written. The caller must supply a buffer of at least 28 bytes so the
/// v6 path fits.
public function pack_sockaddr_in(out: u8*, addr: &SocketAddr) -> Result<u32, IoError> {
    match (addr.ip) {
        IpAddr::V4(v4) => {
            mut w: ByteWriter = ByteWriter::over(Slice::<u8>::from_raw(out, 16));
            // sin_family = AF_INET, host byte order (low byte first on
            // our little-endian targets)
            w.write_u16_little_endian(2);
            // sin_port and sin_addr, network byte order
            w.write_u16_big_endian(addr.port);
            w.write_u8(v4.a);
            w.write_u8(v4.b);
            w.write_u8(v4.c);
            w.write_u8(v4.d);
            // 8 bytes of sin_zero padding
            w.write_u64_little_endian(0);
            return Result::Ok(16);
        }
        IpAddr::V6(v6) => {
            mut w: ByteWriter = ByteWriter::over(Slice::<u8>::from_raw(out, 28));
            // sin6_family = AF_INET6, host byte order
            w.write_u16_little_endian(af_inet6());
            // sin6_port, network byte order
            w.write_u16_big_endian(addr.port);
            // sin6_flowinfo = 0
            w.write_u32_little_endian(0);
            // sin6_addr: 16 bytes, already network order in `segments`
            mut j: i64 = 0;
            while (j < 16) { w.write_u8(v6.segments[j]); j++; }
            // sin6_scope_id = 0
            w.write_u32_little_endian(0);
            return Result::Ok(28);
        }
    }
}

/// Read an IPv4 `sockaddr_in` back out of a kernel-filled buffer (the
/// `recvfrom` source address, or `getsockname`'s local address). Reads
/// `sin_port` (offset 2, big-endian) and `sin_addr` (offset 4, network
/// order). The family at offset 0 is assumed `AF_INET`; the socket
/// layer only ever creates v4 sockets, so a v6 reply can't appear here.
public function unpack_sockaddr_in(buf: u8*) -> SocketAddr {
    // The family and port of either family's layout, so the read cannot run short.
    mut fields: ByteReader = ByteReader::new(Slice::from_raw(buf, 4));
    fields.set_position(2);
    const port: u16 = fields.read_u16_big_endian().unwrap();
    const v4: IpV4Addr = IpV4Addr::new(buf[4], buf[5], buf[6], buf[7]);
    return SocketAddr::new(IpAddr::V4(v4), port);
}

/// Unpack either a v4 `sockaddr_in` or a v6 `sockaddr_in6` from a
/// kernel-filled buffer, dispatching on the family at offset 0. Used by
/// `getsockname`-style readback where the socket may be either family.
/// The buffer must be at least 28 bytes for the v6 case.
public function unpack_sockaddr(buf: u8*) -> SocketAddr {
    // The family is in host order (little-endian on every supported
    // target), the port in network order.
    mut fields: ByteReader = ByteReader::new(Slice::from_raw(buf, 4));
    const fam: u16 = fields.read_u16_little_endian().unwrap();
    if (fam == af_inet6()) {
        const port: u16 = fields.read_u16_big_endian().unwrap();
        return SocketAddr::new(IpAddr::V6(IpV6Addr::from_buf(&buf[8])), port);
    }
    return unpack_sockaddr_in(buf);
}
