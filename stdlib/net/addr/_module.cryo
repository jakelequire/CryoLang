///! net::addr: addressing primitives.
///!
///! The values that name a network endpoint, independent of any socket or
///! protocol:
///!
///!   - `ip`          - `IpAddr` (v4 / v6) and its parsers.
///!   - `socket_addr` - `SocketAddr`, an `(IpAddr, port)` pair.
///!   - `url`         - `Url::parse` for absolute URLs.
///!
///! `sockaddr`, internal to the standard library, packs a `SocketAddr`
///! into the C `sockaddr` storage the socket calls take and reads one back.

namespace std::net::addr;

module {
    net::addr::ip;
    net::addr::socket_addr;
    net::addr::url;
}

internal module net::addr::sockaddr;
