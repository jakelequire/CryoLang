///! net::tls: TLS over TCP via system OpenSSL.
///!
///! `TlsConnector` (client) and `TlsAcceptor` (server) mint
///! `TlsStream`s - encrypted byte streams implementing `io::Read` +
///! `io::Write`, so the existing HTTP and WebSocket layers run over
///! them unchanged. This is a thin, safe binding over `libssl`, not a
///! reimplementation of TLS.
///!
///! Linking: any binary using this module must add `ssl` and `crypto`
///! to its project `cryoconfig` `link_libs`. See `ffi::openssl`.

namespace std::net::tls;

public module net::tls::stream;
public module net::tls::context;
