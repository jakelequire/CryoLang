///! TLS contexts: `TlsConnector` (client) and `TlsAcceptor` (server).
///!
///! Both own an `SSL_CTX` - the shared configuration and certificate
///! store - and mint per-connection `TlsStream`s from it. A connector
///! is a fluent builder: `TlsConnector::new()?.with_alpn_h2()` etc.
///! One context can produce many streams; `SSL_new` reference-counts
///! the `SSL_CTX`, so a stream outlives the connector if it has to.
///!
///! Handshakes are async. `connect` / `accept` run one to completion; the
///! `start_connect` / `start_accept` pair stops one step short and hands back
///! the `TlsHandshake` future, for a caller that has to own it (to select over
///! it, or to give it a deadline). There is no blocking form: driving a
///! handshake by spinning on `WANT_READ`/`WANT_WRITE` burns a thread per
///! connection, and a bidirectional handshake on blocking sockets cannot run
///! both sides on one thread at all.

namespace std::net::tls::context;

import std::core::option;
import std::core::result::{ Result };
import std::core::slice::{ Slice };
import std::core::convert;
import std::core::primitives;
import std::collections::array::{ Array };
import std::collections::str::{ Str };
import std::collections::string::{ String };
import std::io::error::{ IoError, IoErrorKind };
import std::ffi::libc;
import std::ffi::openssl;
import std::sys::syscall;
import std::net::socket::tcp::{ TcpStream };
import std::net::tls::stream::{ TlsStream };
import std::net::tls::future::{ TlsHandshake };
import std::core::mem;

/// The client side of TLS: one OpenSSL context holding the trust store, the
/// verification setting and the ALPN offer, from which `connect` makes a
/// `TlsStream` over each connected `TcpStream`. Peer certificate and
/// hostname verification are on unless `danger_accept_invalid_certs` turns
/// them off. Frees the context on `drop`; streams already made keep it alive.
///
/// ```cryo
/// import std::core::result::{ Result };
/// import std::collections::str::{ Str };
/// import std::io::error::{ IoError };
/// import std::net::socket::tcp::{ TcpStream };
/// import std::net::tls::context::{ TlsConnector };
/// import std::net::tls::stream::{ TlsStream };
///
/// // `socket` is already connected to example.com:443 (see `TcpConnect`).
/// async function secure(socket: TcpStream) -> Result<TlsStream, IoError> {
///     const connector: TlsConnector = TlsConnector::new()?.with_alpn_h2();
///     return await connector.connect(socket, Str::new("example.com"));
/// }
/// ```
public type struct TlsConnector {
    private ctx: void*;
    private verify: boolean;

    /// New client context trusting the system's roots, with peer
    /// verification on by default.
    ///
    /// On Unix the system's roots are OpenSSL's default verify paths, the OS
    /// CA bundle. On Windows a server's chain is built and checked by Windows
    /// itself, which trusts the roots Windows trusts - fetching one the
    /// machine does not hold yet, as it does for any program - so a site
    /// whose root no copy of the local store has yet still verifies.
    public static new() -> Result<TlsConnector, IoError> {
        ignore_sigpipe();
        const method: void* = openssl::TLS_client_method();
        const ctx: void* = openssl::SSL_CTX_new(method);
        if (ctx == null) {
            return Result::Err(IoError::new(IoErrorKind::Other, 0));
        }
        if (openssl::SSL_CTX_set_default_verify_paths(ctx) != 1) {
            openssl::SSL_CTX_free(ctx);
            return Result::Err(IoError::new(IoErrorKind::Other, 0));
        }
        os_configure_verification(ctx);
        return Result::Ok(TlsConnector { ctx: ctx, verify: true });
    }

    /// Trust the certificates in `pem` - one or more PEM `CERTIFICATE`
    /// blocks - as roots, alongside the system store: a private CA, or a
    /// self-signed server's own certificate. `InvalidData` when `pem` holds
    /// no certificate, or one OpenSSL refuses; the certificates before it
    /// stay trusted.
    ///
    /// ```cryo
    /// import std::fs::{ File };
    /// import std::fs::path::{ Path };
    /// import std::collections::array::{ Array };
    /// import std::net::tls::context::{ TlsConnector };
    ///
    /// mut connector: TlsConnector = TlsConnector::new().unwrap();
    /// const pem: Array<u8> = File::read_bytes(Path::new("ca.pem")).unwrap();
    /// connector.add_root_certificate(pem.as_slice()).unwrap();
    /// ```
    public add_root_certificate(mut &this, pem: &Slice<u8>) -> Result<(), IoError> {
        const length: i32 = match (i32::try_from(pem.length())) {
            Result::Ok(n)  => { n }
            Result::Err(_) => { return Result::Err(IoError::new(IoErrorKind::InvalidData, 0)); }
        };
        const bio: void* = openssl::BIO_new_mem_buf(pem.as_ptr(), length);
        if (bio == null) {
            return Result::Err(IoError::new(IoErrorKind::OutOfMemory, 0));
        }
        const store: void* = openssl::SSL_CTX_get_cert_store(this.ctx);
        mut added: i64 = 0;
        mut refused: boolean = false;
        loop {
            const certificate: void* = openssl::PEM_read_bio_X509(bio, null, null, null);
            if (certificate == null) { break; }
            refused = openssl::X509_STORE_add_cert(store, certificate) != 1;
            openssl::X509_free(certificate);
            if (refused) { break; }
            added = added + 1;
        }
        openssl::BIO_free(bio);
        // Reading past the last block leaves a "no start line" error queued.
        openssl::ERR_clear_error();
        if (refused || added == 0) {
            return Result::Err(IoError::new(IoErrorKind::InvalidData, 0));
        }
        return Result::Ok(());
    }

    /// Disable certificate + hostname verification. Named to be ugly on
    /// purpose: only for self-signed test servers or pinned-out-of-band
    /// peers. Fluent: returns the connector.
    public danger_accept_invalid_certs(mut this) -> TlsConnector {
        this.verify = false;
        return this;
    }

    /// Advertise HTTP/2 (and HTTP/1.1) via ALPN. Read the negotiated
    /// result back with `TlsStream::negotiated_alpn`. Fluent.
    public with_alpn_h2(mut this) -> TlsConnector {
        // Wire form: each protocol name is one length byte + the name.
        //   0x02 "h2"   0x08 "http/1.1"   = 13 bytes.
        mut wire: [u8; 13];
        wire[0] = 2;  wire[1] = 0x68; wire[2] = 0x32;                            // "h2"
        wire[3] = 8;  wire[4] = 0x68; wire[5] = 0x74; wire[6] = 0x74;            // "htt"
        wire[7] = 0x70; wire[8] = 0x2F; wire[9] = 0x31; wire[10] = 0x2E;         // "p/1."
        wire[11] = 0x31; wire[12] = 0x31;                                        // "11"
        openssl::SSL_CTX_set_alpn_protos(this.ctx, &wire[0], 13);
        return this;
    }

    /// Wrap an established `TcpStream` in TLS, performing the client handshake
    /// with SNI set to `hostname` (also the name verified against the peer
    /// certificate when verification is on). Consumes the `TcpStream`; on
    /// failure it is closed before returning.
    ///
    /// Each `WANT_READ`/`WANT_WRITE` becomes a reactor registration rather than
    /// a spin, so the handshake shares its thread with every other task.
    public async connect(&this, stream: TcpStream, hostname: Str) -> Result<TlsStream, IoError> {
        const hs: TlsHandshake = this.start_connect(stream, hostname)?;
        return await hs;
    }

    /// Set the socket non-blocking and mint the `SSL*` with the SNI and
    /// verification wiring, handing back the future that drives the handshake.
    ///
    /// Everything up to the first `SSL_connect` happens here rather than on the
    /// first poll, so a setup failure is reported to the caller directly instead
    /// of having to be carried inside the future. Callers wanting the whole
    /// handshake in one step want `connect`; this exists for a caller that has
    /// to own the future itself (to select over it, or to time it out).
    public start_connect(&this, stream: TcpStream, hostname: Str) -> Result<TlsHandshake, IoError> {
        mut inner: TcpStream = stream;
        match (inner.set_nonblocking(true)) {
            Result::Ok(_)  => { }
            Result::Err(e) => { mem::drop(inner); return Result::Err(e); }
        }
        const ssl: void* = openssl::SSL_new(this.ctx);
        if (ssl == null) {
            mem::drop(inner);
            return Result::Err(IoError::new(IoErrorKind::Other, 0));
        }
        openssl::SSL_set_fd(ssl, inner.raw_fd());

        // A name OpenSSL refuses (empty, or longer than 255 bytes) is a
        // refused connection: going on would send no server name, and with
        // verification on would check the chain but never the name.
        mut host_c: String = String::with_null(hostname);
        mut named: boolean = openssl::ssl_set_sni(ssl, host_c.as_ptr()) == 1;
        if (named && this.verify) {
            named = openssl::SSL_set1_host(ssl, host_c.as_ptr()) == 1;
            openssl::SSL_set_verify(ssl, openssl::SSL_VERIFY_PEER, null);
        }
        mem::drop(host_c);
        if (!named) {
            openssl::SSL_free(ssl);
            mem::drop(inner);
            return Result::Err(IoError::new(IoErrorKind::InvalidInput, 0));
        }
        return Result::Ok(TlsHandshake::start(TlsStream::from_parts(ssl, inner),
                                              true, this.verify));
    }
}

implement trait Drop for struct TlsConnector {
    /// Release the context. Streams already minted keep their own
    /// reference and remain valid.
    drop(mut &this) -> void {
        if (this.ctx != null) {
            openssl::SSL_CTX_free(this.ctx);
            this.ctx = null;
        }
    }
}

/// The server side of TLS: one OpenSSL context holding the server's
/// certificate chain and private key, from which `accept` makes a
/// `TlsStream` over each accepted `TcpStream`. It does not ask clients for
/// certificates and offers no ALPN protocol. Frees the context on `drop`;
/// streams already made keep it alive.
public type struct TlsAcceptor {
    private ctx: void*;

    /// New server context from a PEM certificate chain and private key
    /// (paths on disk). Fails `InvalidInput` if either file is missing
    /// or the key doesn't match the certificate.
    public static new(cert_path: Str, key_path: Str) -> Result<TlsAcceptor, IoError> {
        ignore_sigpipe();
        const method: void* = openssl::TLS_server_method();
        const ctx: void* = openssl::SSL_CTX_new(method);
        if (ctx == null) {
            return Result::Err(IoError::new(IoErrorKind::Other, 0));
        }

        mut cert_c: String = String::with_null(cert_path);
        mut key_c: String = String::with_null(key_path);

        mut ok: boolean = true;
        if (openssl::SSL_CTX_use_certificate_file(ctx, cert_c.as_ptr(),
                openssl::SSL_FILETYPE_PEM) != 1) { ok = false; }
        if (ok && openssl::SSL_CTX_use_PrivateKey_file(ctx, key_c.as_ptr(),
                openssl::SSL_FILETYPE_PEM) != 1) { ok = false; }
        if (ok && openssl::SSL_CTX_check_private_key(ctx) != 1) { ok = false; }

        mem::drop(cert_c);
        mem::drop(key_c);

        if (!ok) {
            openssl::SSL_CTX_free(ctx);
            return Result::Err(IoError::new(IoErrorKind::InvalidInput, 0));
        }
        return Result::Ok(TlsAcceptor { ctx: ctx });
    }

    /// Complete the server handshake over an accepted `TcpStream`.
    /// Consumes it; closes it on failure.
    public async accept(&this, stream: TcpStream) -> Result<TlsStream, IoError> {
        const hs: TlsHandshake = this.start_accept(stream)?;
        return await hs;
    }

    /// Mint the `SSL*` and hand back the handshake future, the server-side
    /// mirror of `start_connect`. A socket handed over by `TcpAccept` is
    /// already non-blocking, but it is set here rather than assumed.
    public start_accept(&this, stream: TcpStream) -> Result<TlsHandshake, IoError> {
        mut inner: TcpStream = stream;
        match (inner.set_nonblocking(true)) {
            Result::Ok(_)  => { }
            Result::Err(e) => { mem::drop(inner); return Result::Err(e); }
        }
        const ssl: void* = openssl::SSL_new(this.ctx);
        if (ssl == null) {
            mem::drop(inner);
            return Result::Err(IoError::new(IoErrorKind::Other, 0));
        }
        openssl::SSL_set_fd(ssl, inner.raw_fd());
        return Result::Ok(TlsHandshake::start(TlsStream::from_parts(ssl, inner),
                                              false, false));
    }
}

implement trait Drop for struct TlsAcceptor {
    drop(mut &this) -> void {
        if (this.ctx != null) {
            openssl::SSL_CTX_free(this.ctx);
            this.ctx = null;
        }
    }
}

/// Hand the verification of a server's chain to Windows: OpenSSL's default
/// verify paths there name its own build directory, and a copy of the ROOT
/// store holds only the roots Windows has already fetched.
![target(windows)]
private function os_configure_verification(ctx: void*) -> void {
    openssl::SSL_CTX_set_cert_verify_callback(ctx, windows_verify_server as void*, null);
}

/// On Unix OpenSSL verifies against the default verify paths, the system's
/// roots: nothing to configure.
![target(unix)]
private function os_configure_verification(_ctx: void*) -> void { }

/// OpenSSL's chain verification on Windows. The chain Windows builds from
/// the server's certificate, with the intermediates the server sent, must
/// meet the TLS server policy, and the certificate must name the host the
/// connection asked for. A chain Windows does not trust is asked of
/// OpenSSL's own verification against the context's store, which holds the
/// roots `add_root_certificate` added and checks the name itself. Returns 1
/// to accept the server; a refusal leaves its reason on `store_context`,
/// where `SSL_get_verify_result` reads it.
![target(windows)]
private function windows_verify_server(store_context: void*, _argument: void*) -> i32 {
    const leaf: void* = openssl::X509_STORE_CTX_get0_cert(store_context);
    if (leaf == null || !windows_trusts(leaf, openssl::X509_STORE_CTX_get0_untrusted(store_context))) {
        return openssl::X509_verify_cert(store_context);
    }
    // The connection names a host, or an IP address when the name it was
    // given is one.
    const parameters: void* = openssl::X509_STORE_CTX_get0_param(store_context);
    const host: u8* = openssl::X509_VERIFY_PARAM_get0_host(parameters, 0);
    if (host != null && openssl::X509_check_host(leaf, host, 0, 0, null) != 1) {
        openssl::X509_STORE_CTX_set_error(store_context, openssl::X509_V_ERR_HOSTNAME_MISMATCH);
        return 0;
    }
    const address: mut u8* = openssl::X509_VERIFY_PARAM_get1_ip_asc(parameters);
    if (address != null) {
        const named: boolean = openssl::X509_check_ip_asc(leaf, address, 0) == 1;
        openssl::CRYPTO_free(address, null, 0);
        if (!named) {
            openssl::X509_STORE_CTX_set_error(store_context, openssl::X509_V_ERR_IP_ADDRESS_MISMATCH);
            return 0;
        }
    }
    openssl::X509_STORE_CTX_set_error(store_context, 0);
    return 1;
}

/// Whether Windows builds a chain it trusts from `leaf`, taking issuers
/// from `intermediates` (an OpenSSL stack of certificates, or null), and
/// the chain meets the TLS server policy. An intermediate Windows cannot
/// read is left out, so the chain is built without it.
![target(windows)]
private function windows_trusts(leaf: void*, intermediates: void*) -> boolean {
    const store: void* = syscall::CertOpenStore(syscall::CERT_STORE_PROV_MEMORY, 0, 0, 0, null);
    if (store == null) { return false; }
    const count: i32 = if (intermediates == null) { 0 } else { openssl::OPENSSL_sk_num(intermediates) };
    for (mut i: i32 = 0; i < count; i++) {
        const issuer: Array<u8> = certificate_der(openssl::OPENSSL_sk_value(intermediates, i));
        syscall::CertAddEncodedCertificateToStore(store, syscall::CERTIFICATE_ENCODING,
            issuer.as_ptr(), issuer.length() as u32, syscall::CERT_STORE_ADD_ALWAYS, null);
    }
    const leaf_der: Array<u8> = certificate_der(leaf);
    const certificate: void* = syscall::CertCreateCertificateContext(syscall::CERTIFICATE_ENCODING,
        leaf_der.as_ptr(), leaf_der.length() as u32);
    mut trusted: boolean = false;
    if (certificate != null) {
        const parameters: syscall::CertificateChainParameters = syscall::CertificateChainParameters {
            size: sizeof(syscall::CertificateChainParameters) as u32,
            requested_usage: syscall::CertificateUsageMatch {
                match_type: 0,
                usage: syscall::CertificateEnhancedKeyUsage { identifier_count: 0, identifiers: null }
            }
        };
        mut chain: void* = null;
        if (syscall::CertGetCertificateChain(null, certificate, null, store, &parameters, 0, null, &chain) != 0) {
            const server: syscall::SslChainPolicyParameters = syscall::SslChainPolicyParameters {
                size: sizeof(syscall::SslChainPolicyParameters) as u32,
                authentication_type: syscall::AUTHTYPE_SERVER,
                ignored_checks: 0,
                server_name: null
            };
            const policy: syscall::CertificateChainPolicyParameters = syscall::CertificateChainPolicyParameters {
                size: sizeof(syscall::CertificateChainPolicyParameters) as u32,
                flags: 0,
                extra: &server
            };
            mut status: syscall::CertificateChainPolicyStatus = syscall::CertificateChainPolicyStatus {
                size: sizeof(syscall::CertificateChainPolicyStatus) as u32,
                error: 0, chain_index: 0, element_index: 0, extra: null
            };
            trusted = syscall::CertVerifyCertificateChainPolicy(syscall::CERT_CHAIN_POLICY_SSL,
                chain, &policy, &status) != 0 && status.error == 0;
            syscall::CertFreeCertificateChain(chain);
        }
        syscall::CertFreeCertificateContext(certificate);
    }
    syscall::CertCloseStore(store, 0);
    return trusted;
}

/// `certificate`'s DER encoding; empty when OpenSSL cannot encode it.
![target(windows)]
private function certificate_der(certificate: void*) -> Array<u8> {
    mut bytes: Array<u8> = Array::<u8>::new();
    const length: i32 = openssl::i2d_X509(certificate, null);
    if (length <= 0) { return bytes; }
    bytes.resize(length as i64, 0);
    mut cursor: mut u8* = bytes.as_mutable_ptr();
    if (openssl::i2d_X509(certificate, &cursor) != length) { bytes.clear(); }
    return bytes;
}

/// Ignore `SIGPIPE` process-wide. OpenSSL writes through a plain socket
/// BIO, so a write to a peer that has closed raises `SIGPIPE` and kills
/// the process by default; with it ignored, the write returns `EPIPE`
/// and surfaces as a normal `BrokenPipe` `IoError` instead. Idempotent;
/// every TLS context sets it on construction (the standard approach,
/// matching libcurl).
private function ignore_sigpipe() -> void {
    libc::signal(libc::SIGPIPE, libc::SIG_IGN as void*);
}

