///! HTTP method.

namespace std::net::http::method;

import core::option;
import core::result;
import core::convert;
import collections::str;

type enum Method {
    Get;
    Head;
    Post;
    Put;
    Delete;
    Connect;
    Options;
    Trace;
    Patch;
}

implement enum Method {
    /// Uppercase wire form.
    as_str(&this) -> Str {
        return match (&this) {
            Method::Get     => { Str::new("GET") }
            Method::Head    => { Str::new("HEAD") }
            Method::Post    => { Str::new("POST") }
            Method::Put     => { Str::new("PUT") }
            Method::Delete  => { Str::new("DELETE") }
            Method::Connect => { Str::new("CONNECT") }
            Method::Options => { Str::new("OPTIONS") }
            Method::Trace   => { Str::new("TRACE") }
            Method::Patch   => { Str::new("PATCH") }
        }
    }

    /// Parse the uppercase wire form. Returns `Err(ConversionError)` on
    /// unknown methods rather than inventing a variant; the caller decides
    /// whether to 405 or to treat as a bad request. The error is
    /// describable/printable - consistent with the other stdlib parsers. Use
    /// `parse_opt` for the detail-free variant.
    static parse(source: Str) -> Result<Method, ConversionError> {
        match (Method::parse_opt(source)) {
            Option::Some(m) => { return Result::Ok(m); }
            Option::None    => { return Result::Err(ConversionError::new("unknown HTTP method")); }
        }
    }

    /// Detail-free variant of `parse`: `None` on unknown methods.
    static parse_opt(source: Str) -> Option<Method> {
        // Match against each variant's wire form. The names live once,
        // in `as_str`; this stays in sync with it by construction.
        const all: Method[] = [
            Method::Get, Method::Head, Method::Post, Method::Put,
            Method::Delete, Method::Connect, Method::Options,
            Method::Trace, Method::Patch
        ];
        for (mut i: u64 = 0; i < all.length; i++) {
            if (source.equals(&all[i].as_str())) {
                return Option::Some(all[i]);
            }
        }
        return Option::None;
    }
}
