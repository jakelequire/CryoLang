///! HTTP method.

namespace std::net::http::method;

import core::option;
import collections::str;

type enum Method {
    Get;
    Head;
    Post;
    Put;
    Delete;
    Connect;
    Options;
    Trace;
    Patch;
}

implement enum Method {
    /// Uppercase wire form.
    as_str(&this) -> Str {
        return match (&this) {
            Method::Get     => { Str::from_raw("GET", 3) }
            Method::Head    => { Str::from_raw("HEAD", 4) }
            Method::Post    => { Str::from_raw("POST", 4) }
            Method::Put     => { Str::from_raw("PUT", 3) }
            Method::Delete  => { Str::from_raw("DELETE", 6) }
            Method::Connect => { Str::from_raw("CONNECT", 7) }
            Method::Options => { Str::from_raw("OPTIONS", 7) }
            Method::Trace   => { Str::from_raw("TRACE", 5) }
            Method::Patch   => { Str::from_raw("PATCH", 5) }
        }
    }

    /// Parse the uppercase wire form. Returns `None` on unknown
    /// methods rather than inventing a variant — the caller decides
    /// whether to 405 or to treat as a bad request.
    static parse(source: Str) -> Option<Method> {
        if (source.equals(&Str::from_raw("GET", 3))) {
            return Option::Some(Method::Get);
        }
        if (source.equals(&Str::from_raw("HEAD", 4))) {
            return Option::Some(Method::Head);
        }
        if (source.equals(&Str::from_raw("POST", 4))) {
            return Option::Some(Method::Post);
        }
        if (source.equals(&Str::from_raw("PUT", 3))) {
            return Option::Some(Method::Put);
        }
        if (source.equals(&Str::from_raw("DELETE", 6))) {
            return Option::Some(Method::Delete);
        }
        if (source.equals(&Str::from_raw("CONNECT", 7))) {
            return Option::Some(Method::Connect);
        }
        if (source.equals(&Str::from_raw("OPTIONS", 7))) {
            return Option::Some(Method::Options);
        }
        if (source.equals(&Str::from_raw("TRACE", 5))) {
            return Option::Some(Method::Trace);
        }
        if (source.equals(&Str::from_raw("PATCH", 5))) {
            return Option::Some(Method::Patch);
        }
        return Option::None;
    }
}
