///! HTTP method.

namespace std::net::http::method;

import core::option;
import collections::str;

type enum Method {
    Get;
    Head;
    Post;
    Put;
    Delete;
    Connect;
    Options;
    Trace;
    Patch;
}

implement enum Method {
    /// Uppercase wire form.
    as_str(&this) -> Str {
        return match (&this) {
            Method::Get     => { Str::new("GET") }
            Method::Head    => { Str::new("HEAD") }
            Method::Post    => { Str::new("POST") }
            Method::Put     => { Str::new("PUT") }
            Method::Delete  => { Str::new("DELETE") }
            Method::Connect => { Str::new("CONNECT") }
            Method::Options => { Str::new("OPTIONS") }
            Method::Trace   => { Str::new("TRACE") }
            Method::Patch   => { Str::new("PATCH") }
        }
    }

    /// Parse the uppercase wire form. Returns `None` on unknown
    /// methods rather than inventing a variant — the caller decides
    /// whether to 405 or to treat as a bad request.
    static parse(source: Str) -> Option<Method> {
        if (source.equals(&Str::new("GET"))) {
            return Option::Some(Method::Get);
        }
        if (source.equals(&Str::new("HEAD"))) {
            return Option::Some(Method::Head);
        }
        if (source.equals(&Str::new("POST"))) {
            return Option::Some(Method::Post);
        }
        if (source.equals(&Str::new("PUT"))) {
            return Option::Some(Method::Put);
        }
        if (source.equals(&Str::new("DELETE"))) {
            return Option::Some(Method::Delete);
        }
        if (source.equals(&Str::new("CONNECT"))) {
            return Option::Some(Method::Connect);
        }
        if (source.equals(&Str::new("OPTIONS"))) {
            return Option::Some(Method::Options);
        }
        if (source.equals(&Str::new("TRACE"))) {
            return Option::Some(Method::Trace);
        }
        if (source.equals(&Str::new("PATCH"))) {
            return Option::Some(Method::Patch);
        }
        return Option::None;
    }
}
