///! http: HTTP/1.1 with keep-alive.
///!
///! Enough to stand up a handler-based server and to make client
///! requests without external dependencies. The server supports
///! persistent connections (capped at `MAX_REQUESTS_PER_CONNECTION`
///! per stream) with per-connection read timeouts and `Connection:
///! close` opt-out. HTTP/2 lives in the sibling `net::http2` module;
///! TLS is `net::tls` (with `net::https` on top). Out of scope here:
///! chunked transfer-encoding and HTTP/1.1 pipelining. See
///! `net/_module.cryo` for the rationale.

namespace std::net::http;

public module net::http::method;
public module net::http::status;
public module net::http::headers;
public module net::http::request;
public module net::http::response;
public module net::http::conn;
public module net::http::router;
public module net::http::server;
public module net::http::client;

// Structure above, reachability here: `import std::net::http;` alone reaches
// the names below, instead of nine imports at every call site.
export std::net::http::method;
export std::net::http::status;
export std::net::http::headers;
export std::net::http::request;
export std::net::http::response;
export std::net::http::conn;
export std::net::http::router;
export std::net::http::server;
export std::net::http::client;
