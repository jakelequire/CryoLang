///! HTTP status codes.
///!
///! `StatusCode` is a u16 wrapper so users can't accidentally pass a
///! random integer where a status is expected. Common codes are
///! constructor aliases (`StatusCode::ok()`); custom codes go
///! through `from_u16`.

namespace std::net::http::status;

import collections::str;

type struct StatusCode {
    code: u16;

    static from_u16(code: u16) -> StatusCode {
        return StatusCode { code: code };
    }

    as_u16(&this) -> u16 {
        return this.code;
    }

    // ---- 1xx informational ----
    static continue_() -> StatusCode { return StatusCode { code: 100 }; }
    static switching_protocols() -> StatusCode { return StatusCode { code: 101 }; }

    // ---- 2xx success ----
    static ok() -> StatusCode { return StatusCode { code: 200 }; }
    static created() -> StatusCode { return StatusCode { code: 201 }; }
    static accepted() -> StatusCode { return StatusCode { code: 202 }; }
    static no_content() -> StatusCode { return StatusCode { code: 204 }; }

    // ---- 3xx redirection ----
    static moved_permanently() -> StatusCode { return StatusCode { code: 301 }; }
    static found() -> StatusCode { return StatusCode { code: 302 }; }
    static not_modified() -> StatusCode { return StatusCode { code: 304 }; }
    static temporary_redirect() -> StatusCode { return StatusCode { code: 307 }; }
    static permanent_redirect() -> StatusCode { return StatusCode { code: 308 }; }

    // ---- 4xx client error ----
    static bad_request() -> StatusCode { return StatusCode { code: 400 }; }
    static unauthorized() -> StatusCode { return StatusCode { code: 401 }; }
    static forbidden() -> StatusCode { return StatusCode { code: 403 }; }
    static not_found() -> StatusCode { return StatusCode { code: 404 }; }
    static method_not_allowed() -> StatusCode { return StatusCode { code: 405 }; }
    static conflict() -> StatusCode { return StatusCode { code: 409 }; }
    static length_required() -> StatusCode { return StatusCode { code: 411 }; }
    static payload_too_large() -> StatusCode { return StatusCode { code: 413 }; }
    static unsupported_media_type() -> StatusCode { return StatusCode { code: 415 }; }
    static too_many_requests() -> StatusCode { return StatusCode { code: 429 }; }

    // ---- 5xx server error ----
    static internal_server_error() -> StatusCode { return StatusCode { code: 500 }; }
    static not_implemented() -> StatusCode { return StatusCode { code: 501 }; }
    static bad_gateway() -> StatusCode { return StatusCode { code: 502 }; }
    static service_unavailable() -> StatusCode { return StatusCode { code: 503 }; }
    static gateway_timeout() -> StatusCode { return StatusCode { code: 504 }; }

    is_informational(&this) -> boolean { return this.code >= 100 && this.code < 200; }
    is_success(&this) -> boolean { return this.code >= 200 && this.code < 300; }
    is_redirection(&this) -> boolean { return this.code >= 300 && this.code < 400; }
    is_client_error(&this) -> boolean { return this.code >= 400 && this.code < 500; }
    is_server_error(&this) -> boolean { return this.code >= 500 && this.code < 600; }

    /// Canonical reason phrase for the common codes. Unknown codes
    /// return `"Unknown"` — a caller that cares about round-tripping
    /// a custom phrase should track its own mapping.
    reason_phrase(&this) -> Str {
        return match (this.code) {
            100 => { Str::from_raw("Continue", 8) }
            101 => { Str::from_raw("Switching Protocols", 19) }
            200 => { Str::from_raw("OK", 2) }
            201 => { Str::from_raw("Created", 7) }
            202 => { Str::from_raw("Accepted", 8) }
            204 => { Str::from_raw("No Content", 10) }
            301 => { Str::from_raw("Moved Permanently", 17) }
            302 => { Str::from_raw("Found", 5) }
            304 => { Str::from_raw("Not Modified", 12) }
            307 => { Str::from_raw("Temporary Redirect", 18) }
            308 => { Str::from_raw("Permanent Redirect", 18) }
            400 => { Str::from_raw("Bad Request", 11) }
            401 => { Str::from_raw("Unauthorized", 12) }
            403 => { Str::from_raw("Forbidden", 9) }
            404 => { Str::from_raw("Not Found", 9) }
            405 => { Str::from_raw("Method Not Allowed", 18) }
            409 => { Str::from_raw("Conflict", 8) }
            411 => { Str::from_raw("Length Required", 15) }
            413 => { Str::from_raw("Payload Too Large", 17) }
            415 => { Str::from_raw("Unsupported Media Type", 22) }
            429 => { Str::from_raw("Too Many Requests", 17) }
            500 => { Str::from_raw("Internal Server Error", 21) }
            501 => { Str::from_raw("Not Implemented", 15) }
            502 => { Str::from_raw("Bad Gateway", 11) }
            503 => { Str::from_raw("Service Unavailable", 19) }
            504 => { Str::from_raw("Gateway Timeout", 15) }
            _   => { Str::from_raw("Unknown", 7) }
        }
    }
}
