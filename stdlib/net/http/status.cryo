///! HTTP status codes.
///!
///! `StatusCode` is a u16 wrapper so users can't accidentally pass a
///! random integer where a status is expected. Common codes are
///! constructor aliases (`StatusCode::ok()`); custom codes go
///! through `from_u16`.

namespace std::net::http::status;

import std::collections::str::{ Str };
import std::core::result::{ Result };
import std::fmt::display::{ Display, Formatter };
import std::fmt::error::{ FmtError };

/// An HTTP response status code: the three-digit number on a response's
/// status line. A code is built from a named constructor for the common
/// ones or from `from_u16` for any other; the `is_*` methods classify it
/// by its hundreds digit, and `Display` writes the bare number.
///
/// ```cryo
/// import std::net::http::status::{ StatusCode };
/// import std::fmt::{ println };
///
/// const status: StatusCode = StatusCode::not_found();
/// println(f"{status} {status.reason_phrase()}");    // 404 Not Found
/// const custom: StatusCode = StatusCode::from_u16(418);
/// println(f"{custom.is_client_error()}");            // true
/// ```
public type struct StatusCode {
    private code: u16;

    /// The status with code `code`. Any value is accepted: nothing checks
    /// that it is in the 100-599 range or is a registered code.
    public static from_u16(code: u16) -> StatusCode {
        return StatusCode { code: code };
    }

    /// The numeric code, `404` for Not Found.
    public as_u16(&this) -> u16 {
        return this.code;
    }

    // ---- 1xx informational ----
    /// 100 Continue.
    public static continue_() -> StatusCode { return StatusCode { code: 100 }; }
    /// 101 Switching Protocols.
    public static switching_protocols() -> StatusCode { return StatusCode { code: 101 }; }

    // ---- 2xx success ----
    /// 200 OK.
    public static ok() -> StatusCode { return StatusCode { code: 200 }; }
    /// 201 Created.
    public static created() -> StatusCode { return StatusCode { code: 201 }; }
    /// 202 Accepted.
    public static accepted() -> StatusCode { return StatusCode { code: 202 }; }
    /// 204 No Content.
    public static no_content() -> StatusCode { return StatusCode { code: 204 }; }

    // ---- 3xx redirection ----
    /// 301 Moved Permanently.
    public static moved_permanently() -> StatusCode { return StatusCode { code: 301 }; }
    /// 302 Found.
    public static found() -> StatusCode { return StatusCode { code: 302 }; }
    /// 304 Not Modified.
    public static not_modified() -> StatusCode { return StatusCode { code: 304 }; }
    /// 307 Temporary Redirect.
    public static temporary_redirect() -> StatusCode { return StatusCode { code: 307 }; }
    /// 308 Permanent Redirect.
    public static permanent_redirect() -> StatusCode { return StatusCode { code: 308 }; }

    // ---- 4xx client error ----
    /// 400 Bad Request.
    public static bad_request() -> StatusCode { return StatusCode { code: 400 }; }
    /// 401 Unauthorized.
    public static unauthorized() -> StatusCode { return StatusCode { code: 401 }; }
    /// 403 Forbidden.
    public static forbidden() -> StatusCode { return StatusCode { code: 403 }; }
    /// 404 Not Found.
    public static not_found() -> StatusCode { return StatusCode { code: 404 }; }
    /// 405 Method Not Allowed.
    public static method_not_allowed() -> StatusCode { return StatusCode { code: 405 }; }
    /// 409 Conflict.
    public static conflict() -> StatusCode { return StatusCode { code: 409 }; }
    /// 411 Length Required.
    public static length_required() -> StatusCode { return StatusCode { code: 411 }; }
    /// 413 Payload Too Large.
    public static payload_too_large() -> StatusCode { return StatusCode { code: 413 }; }
    /// 415 Unsupported Media Type.
    public static unsupported_media_type() -> StatusCode { return StatusCode { code: 415 }; }
    /// 429 Too Many Requests.
    public static too_many_requests() -> StatusCode { return StatusCode { code: 429 }; }

    // ---- 5xx server error ----
    /// 500 Internal Server Error.
    public static internal_server_error() -> StatusCode { return StatusCode { code: 500 }; }
    /// 501 Not Implemented.
    public static not_implemented() -> StatusCode { return StatusCode { code: 501 }; }
    /// 502 Bad Gateway.
    public static bad_gateway() -> StatusCode { return StatusCode { code: 502 }; }
    /// 503 Service Unavailable.
    public static service_unavailable() -> StatusCode { return StatusCode { code: 503 }; }
    /// 504 Gateway Timeout.
    public static gateway_timeout() -> StatusCode { return StatusCode { code: 504 }; }

    /// Whether the code is in 100-199.
    public is_informational(&this) -> boolean { return this.code >= 100 && this.code < 200; }
    /// Whether the code is in 200-299.
    public is_success(&this) -> boolean { return this.code >= 200 && this.code < 300; }
    /// Whether the code is in 300-399.
    public is_redirection(&this) -> boolean { return this.code >= 300 && this.code < 400; }
    /// Whether the code is in 400-499.
    public is_client_error(&this) -> boolean { return this.code >= 400 && this.code < 500; }
    /// Whether the code is in 500-599.
    public is_server_error(&this) -> boolean { return this.code >= 500 && this.code < 600; }

    /// Canonical reason phrase for the common codes. Unknown codes
    /// return `"Unknown"`; a caller that cares about round-tripping
    /// a custom phrase should track its own mapping.
    public reason_phrase(&this) -> Str {
        return match (this.code) {
            100 => { Str::new("Continue") }
            101 => { Str::new("Switching Protocols") }
            200 => { Str::new("OK") }
            201 => { Str::new("Created") }
            202 => { Str::new("Accepted") }
            204 => { Str::new("No Content") }
            301 => { Str::new("Moved Permanently") }
            302 => { Str::new("Found") }
            304 => { Str::new("Not Modified") }
            307 => { Str::new("Temporary Redirect") }
            308 => { Str::new("Permanent Redirect") }
            400 => { Str::new("Bad Request") }
            401 => { Str::new("Unauthorized") }
            403 => { Str::new("Forbidden") }
            404 => { Str::new("Not Found") }
            405 => { Str::new("Method Not Allowed") }
            409 => { Str::new("Conflict") }
            411 => { Str::new("Length Required") }
            413 => { Str::new("Payload Too Large") }
            415 => { Str::new("Unsupported Media Type") }
            429 => { Str::new("Too Many Requests") }
            500 => { Str::new("Internal Server Error") }
            501 => { Str::new("Not Implemented") }
            502 => { Str::new("Bad Gateway") }
            503 => { Str::new("Service Unavailable") }
            504 => { Str::new("Gateway Timeout") }
            _   => { Str::new("Unknown") }
        }
    }
}

/// The code in decimal, `404`, as the status line carries it; the reason
/// phrase is `reason_phrase`.
implement trait Display for struct StatusCode {
    fmt(&this, f: mut &Formatter) -> Result<(), FmtError> {
        return (Display for u16)::fmt(&this.code, f);
    }
}
