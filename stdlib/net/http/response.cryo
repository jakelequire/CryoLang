///! HTTP response.
///!
///! Built by handlers, written to any `Write`. The client side parses
///! one from a `Read` the same way the server parses a `Request`.

namespace std::net::http::response;

import core::intrinsics;
import core::drop;
import core::option;
import core::result;
import core::slice;
import io::error;
import io::traits;
import collections::array;
import collections::str;
import collections::string;
import core::convert;
import core::primitives;
import net::http::status;
import net::http::headers;
import net::http::request;

// Hard cap against a runaway/attacker-controlled `Content-Length`.  A
// malicious server could otherwise make the client pre-allocate (or
// panic-abort on) gigabytes before a single body byte arrives - a remote
// DoS.  Mirrors `request::MAX_BODY` (16 MiB) on the server side.
const MAX_BODY: u64 = 16777216;
/// Cap on the number of response header lines (slow memory-exhaustion DoS
/// guard). Mirrors `request::MAX_HEADER_COUNT`.
const MAX_HEADER_COUNT: u64 = 100;

type struct Response {
    status: StatusCode;
    version: String;
    headers: Headers;
    body: Array<u8>;

    static new(status: StatusCode) -> Response {
        return Response {
            status: status,
            version: String::from_str(request::HTTP_VERSION),
            headers: Headers::new(),
            body: Array::new()
        };
    }

    /// Convenience: `Response::text(StatusCode::ok(), "hello")` with
    /// Content-Type text/plain; charset=utf-8 and Content-Length set.
    static text(status: StatusCode, body: Str) -> Response {
        mut resp: Response = Response::new(status);
        resp.headers.insert(
            Str::new("Content-Type"),
            Str::new("text/plain; charset=utf-8")
        );
        mut bytes: Array<u8> = Array::with_capacity(body.length());
        bytes.append(body.as_bytes());
        resp.set_body(bytes);
        return resp;
    }

    /// Convenience for JSON: sets Content-Type and Content-Length.
    /// The caller is responsible for producing valid JSON; no
    /// validation is performed.
    static json(status: StatusCode, body: Array<u8>) -> Response {
        mut resp: Response = Response::new(status);
        resp.headers.insert(
            Str::new("Content-Type"),
            Str::new("application/json")
        );
        resp.set_body(body);
        return resp;
    }

    /// Install `body` and set Content-Length to match. Ownership of
    /// the array transfers to the response.
    set_body(mut &this, body: Array<u8>) -> void {
        mut old: Array<u8> = this.body;
        this.body = body;
        mut buffer: u8[24];
        const body_len: u64 = this.body.length();
        const digits: u64 = body_len.to_decimal_buf(&buffer[0]);
        this.headers.insert(
            Str::new("Content-Length"),
            Str::from_raw(&buffer[0], digits)
        );
    }

    /// Write to any `Write` impl, typically a `TcpStream`.
    write_to<W>(&this, writer: mut &W) -> Result<(), IoError>
    where W: Write {
        const crlf: Slice<u8> = Slice::from_raw("\r\n", 2);
        const sp: Slice<u8> = Slice::from_raw(" ", 1);
        const http11: Slice<u8> = Slice::from_raw("HTTP/1.1", 8);

        // Status line: HTTP/1.1 <code> <reason>CRLF
        writer.write(http11)?;
        writer.write(sp)?;
        // StatusCode wraps a full u16, whose largest decimal form is
        // "65535" (5 digits). `to_decimal_buf` writes exactly as many
        // digits as the value needs, so the buffer must hold 5.
        mut code_buf: u8[5];
        const code_val: u64 = this.status.as_u16() as u64;
        const code_digits: u64 = code_val.to_decimal_buf(&code_buf[0]);
        writer.write(Slice<u8>::from_raw(&code_buf[0], code_digits))?;
        writer.write(sp)?;
        writer.write(this.status.reason_phrase().as_bytes())?;
        writer.write(crlf)?;

        // Headers: emit every stored header as `name: value\r\n`.
        this.headers.write_to(writer)?;

        // Blank line separating headers from body.
        writer.write(crlf)?;
        if (!this.body.is_empty()) {
            writer.write(this.body.as_slice())?;
        }
        return Result::Ok(());
    }

    /// Parse a Status-Line (`HTTP/x.y SP code SP reason`, no CRLF) into
    /// a response with empty headers and no body. A missing code or a
    /// non-numeric one is `InvalidData`. The reason phrase is advisory
    /// and discarded; the code is what callers dispatch on.
    ///
    /// Split out from the message parse so the grammar has exactly one
    /// implementation: the blocking `parse` below and the connection's
    /// `read_response` differ only in how they obtain the line.
    static from_status_line(line: Str) -> Result<Response, IoError> {
        mut first_sp: u64 = line.length();
        mut second_sp: u64 = line.length();
        mut i: u64 = 0;
        while (i < line.length()) {
            match (line.byte_at(i)) {
                Option::Some(byte) => {
                    if (byte == 0x20) {
                        if (first_sp == line.length()) { first_sp = i; }
                        else if (second_sp == line.length()) { second_sp = i; break; }
                    }
                }
                Option::None => { break; }
            }
            i++;
        }
        if (first_sp == line.length()) {
            return Result::Err(IoError::new(IoErrorKind::InvalidData, 0));
        }
        // A status line with no reason phrase ("HTTP/1.1 204") is legal;
        // the code then runs to the end of the line.
        const code_end: u64 = second_sp;

        const version_str: Str = line.sub_bytes(0, first_sp);
        const code_str: Str = line.sub_bytes(first_sp + 1, code_end);

        mut code: u16 = 0;
        match (u16::try_from(code_str)) {
            Result::Ok(value) => { code = value; }
            Result::Err(_) => {
                return Result::Err(IoError::new(IoErrorKind::InvalidData, 0));
            }
        }

        return Result::Ok(Response {
            status: StatusCode::from_u16(code),
            version: String::from_str(version_str),
            headers: Headers::new(),
            body: Array::new()
        });
    }

    /// Append the whole message — status line, headers, blank line,
    /// body — to `out`, normally the connection's `pending()` buffer.
    ///
    /// Synchronous for the same reason as `Request::encode_into`: a
    /// whole response is assembled without a suspension point, so the
    /// layer above suspends exactly once, in the following `flush`.
    encode_into(&this, out: Array<u8>*) -> Result<(), IoError> {
        const crlf: Slice<u8> = Slice::from_raw("\r\n", 2);
        const sp: Slice<u8> = Slice::from_raw(" ", 1);
        const http11: Slice<u8> = Slice::from_raw("HTTP/1.1", 8);

        headers::push_all(out, http11)?;
        headers::push_all(out, sp)?;
        // StatusCode wraps a full u16, whose largest decimal form is
        // "65535" (5 digits). `to_decimal_buf` writes exactly as many
        // digits as the value needs, so the buffer must hold 5.
        mut code_buf: u8[5];
        const code_val: u64 = this.status.as_u16() as u64;
        const code_digits: u64 = code_val.to_decimal_buf(&code_buf[0]);
        headers::push_all(out, Slice<u8>::from_raw(&code_buf[0], code_digits))?;
        headers::push_all(out, sp)?;
        headers::push_all(out, this.status.reason_phrase().as_bytes())?;
        headers::push_all(out, crlf)?;

        this.headers.encode_into(out)?;

        headers::push_all(out, crlf)?;
        if (!this.body.is_empty()) {
            headers::push_all(out, this.body.as_slice())?;
        }
        return Result::Ok(());
    }

    /// Parse a response from a `Read`. Used by the HTTP client.
    static parse<R>(reader: mut &R) -> Result<Response, IoError>
    where R: Read {
        mut status_line: String = String::new();
        request::read_line(reader, &status_line, 8192)?;

        mut resp: Response = Response::from_status_line(status_line.as_str())?;

        mut header_count: u64 = 0;
        loop {
            mut header_line: String = String::new();
            request::read_line(reader, &header_line, 8192)?;
            if (header_line.is_empty()) {
                break;
            }
            if (!resp.headers.parse_line(header_line.as_str())) {
                return Result::Err(IoError::new(IoErrorKind::InvalidData, 0));
            }
            header_count = header_count + 1;
            if (header_count > MAX_HEADER_COUNT) {
                return Result::Err(IoError::new(IoErrorKind::InvalidData, 0));
            }
        }

        // Body (Content-Length sized only).
        match (resp.headers.get(Str::new("content-length"))) {
            Option::Some(mut value) => {
                match (u64::try_from(value.as_str())) {
                    Result::Ok(len) => {
                        if (len > MAX_BODY) {
                            // Reject up front; never size a buffer to an
                            // untrusted peer's declared length.
                            return Result::Err(IoError::new(IoErrorKind::InvalidData, 0));
                        }
                        mut body: Array<u8> = Array::with_capacity(len);
                        mut remaining: u64 = len;
                        mut chunk: u8[4096];
                        while (remaining > 0) {
                            mut take: u64 = 4096;
                            if (take > remaining) { take = remaining; }
                            const n: u64 = reader.read(&chunk[0], take)?;
                            if (n == 0) {
                                return Result::Err(IoError::new(IoErrorKind::UnexpectedEof, 0));
                            }
                            mut j: u64 = 0;
                            while (j < n) { body.push(chunk[j]); j = j + 1; }
                            remaining = remaining - n;
                        }
                        resp.body = body;
                    }
                    Result::Err(_) => {
                        return Result::Err(IoError::new(IoErrorKind::InvalidData, 0));
                    }
                }
            }
            Option::None => { }
        }

        return Result::Ok(resp);
    }

}

implement trait Drop for struct Response {
    drop(mut &this) -> void {
        this.version.drop();
        this.headers.drop();
        this.body.drop();
    }
}
