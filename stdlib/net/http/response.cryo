///! HTTP response.
///!
///! Built by handlers and appended to a buffer with `encode_into`. The
///! client side reads one off a buffered connection with the async
///! `BufStream::read_response` (in `conn`), the same way the server reads a
///! `Request`.

namespace std::net::http::response;

import std::core::intrinsics;
import std::core::drop::{ Drop };
import std::core::mem;
import std::core::option::{ Option };
import std::core::result::{ Result };
import std::core::slice::{ Slice };
import std::io::error::{ IoError, IoErrorKind };
import std::io::traits;
import std::collections::array::{ Array };
import std::collections::str::{ Str };
import std::collections::string::{ String };
import std::core::convert;
import std::core::primitives;
import std::net::http::status::{ StatusCode };
import std::net::http::headers::{ Headers };
import std::net::http::request;

// Hard cap against a runaway/attacker-controlled `Content-Length`.  A
// malicious server could otherwise make the client pre-allocate (or
// panic-abort on) gigabytes before a single body byte arrives - a remote
// DoS.  Mirrors `request::MAX_BODY` (16 MiB) on the server side.
/// The largest response body, in bytes, the HTTP/1.1 reader accepts:
/// 16777216 (16 MiB). A declared `Content-Length` above it is refused with
/// `InvalidData` before any of the body is read; a chunked body, or one
/// that runs to the end of the connection, is refused as soon as it passes
/// it.
public const MAX_BODY: i64 = 16777216;
/// Cap on the number of response header lines (slow memory-exhaustion DoS
/// guard). Mirrors `request::MAX_HEADER_COUNT`.
public const MAX_HEADER_COUNT: u64 = 100;

/// An HTTP/1.1 response: status, version text, headers and body. A handler
/// builds one with `new`, `text` or `json`; a client receives one from
/// `BufStream::read_response`. `encode_into` writes the status line from
/// `status` and its reason phrase, always as `HTTP/1.1`.
///
/// ```cryo
/// import std::collections::array::{ Array };
/// import std::collections::str::{ Str };
/// import std::net::http::response::{ Response };
/// import std::net::http::status::{ StatusCode };
///
/// const response: Response = Response::text(StatusCode::ok(), Str::new("hi"));
/// mut wire: Array<u8> = Array::new();
/// response.encode_into(&wire).expect("encode");
/// // HTTP/1.1 200 OK, content-type: text/plain; charset=utf-8,
/// // content-length: 2, a blank line, then hi
/// ```
public type struct Response {
    public status: StatusCode;
    public version: String;
    public headers: Headers;
    public body: Array<u8>;

    /// A response with `status`, version `HTTP/1.1`, no headers and an
    /// empty body. No `Content-Length` is set until `set_body` is called.
    public static new(status: StatusCode) -> Response {
        return Response {
            status: status,
            version: String::from_str(request::HTTP_VERSION),
            headers: Headers::new(),
            body: Array::new()
        };
    }

    /// Convenience: `Response::text(StatusCode::ok(), "hello")` with
    /// Content-Type text/plain; charset=utf-8 and Content-Length set.
    public static text(status: StatusCode, body: Str) -> Response {
        mut resp: Response = Response::new(status);
        resp.headers.insert(
            Str::new("Content-Type"),
            Str::new("text/plain; charset=utf-8")
        );
        mut bytes: Array<u8> = Array::with_capacity(body.length());
        bytes.append(body.as_bytes());
        resp.set_body(bytes);
        return resp;
    }

    /// Convenience for JSON: sets Content-Type and Content-Length.
    /// The caller is responsible for producing valid JSON; no
    /// validation is performed.
    public static json(status: StatusCode, body: Array<u8>) -> Response {
        mut resp: Response = Response::new(status);
        resp.headers.insert(
            Str::new("Content-Type"),
            Str::new("application/json")
        );
        resp.set_body(body);
        return resp;
    }

    /// Install `body` and set Content-Length to match. Ownership of
    /// the array transfers to the response.
    public set_body(mut &this, body: Array<u8>) -> void {
        mut displaced: Array<u8> = body;
        mem::swap(&displaced, &this.body);
        mut length: Array<u8> = Array::<u8>::new();
        length.write(f"{this.body.length()}").expect("Response::set_body: allocation failed");
        this.headers.insert(Str::new("Content-Length"), Str::from_raw(length.as_ptr(), length.length()));
    }

    /// Parse a Status-Line (`HTTP/x.y SP code SP reason`, no CRLF) into
    /// a response with empty headers and no body. A missing code or a
    /// non-numeric one is `InvalidData`. The reason phrase is advisory
    /// and discarded; the code is what callers dispatch on.
    ///
    /// Split out from the message read so the grammar has exactly one
    /// implementation: `BufStream::read_response` obtains the line and this
    /// turns it into a response.
    public static from_status_line(line: Str) -> Result<Response, IoError> {
        mut first_sp: i64 = line.length();
        mut second_sp: i64 = line.length();
        mut i: i64 = 0;
        while (i < line.length()) {
            match (line.byte_at(i)) {
                Option::Some(byte) => {
                    if (byte == 0x20) {
                        if (first_sp == line.length()) { first_sp = i; }
                        else if (second_sp == line.length()) { second_sp = i; break; }
                    }
                }
                Option::None => { break; }
            }
            i++;
        }
        if (first_sp == line.length()) {
            return Result::Err(IoError::new(IoErrorKind::InvalidData, 0));
        }
        // A status line with no reason phrase ("HTTP/1.1 204") is legal;
        // the code then runs to the end of the line.
        const code_end: i64 = second_sp;

        const version_str: Str = line.sub_bytes(0, first_sp);
        const code_str: Str = line.sub_bytes(first_sp + 1, code_end);

        mut code: u16 = 0;
        match (u16::try_from(code_str)) {
            Result::Ok(value) => { code = value; }
            Result::Err(_) => {
                return Result::Err(IoError::new(IoErrorKind::InvalidData, 0));
            }
        }

        return Result::Ok(Response {
            status: StatusCode::from_u16(code),
            version: String::from_str(version_str),
            headers: Headers::new(),
            body: Array::new()
        });
    }

    /// Append the whole message — status line, headers, blank line,
    /// body — to `out`, normally the connection's `pending()` buffer.
    ///
    /// Synchronous for the same reason as `Request::encode_into`: a
    /// whole response is assembled without a suspension point, so the
    /// layer above suspends exactly once, in the following `flush`.
    public encode_into(&this, out: mut &Array<u8>) -> Result<(), IoError> {
        const crlf: &Slice<u8> = Slice::from_raw("\r\n", 2);
        out.write(f"HTTP/1.1 {this.status} {this.status.reason_phrase()}\r\n")?;

        this.headers.encode_into(out)?;

        out.try_append(crlf)?;
        if (!this.body.is_empty()) {
            out.try_append(this.body.as_slice())?;
        }
        return Result::Ok(());
    }

}

implement trait Drop for struct Response {
    drop(mut &this) -> void { }
}
