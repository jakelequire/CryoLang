///! HTTP server: non-blocking, one connection at a time, HTTP/1.1
///! keep-alive within a connection.
///!
///! `.run()` is an `async` method and needs an `Executor` (its reactor is
///! what the accept and the per-connection reads register with). Connections
///! are still served one at a time: this layer is on the async transport, not
///! yet concurrent across connections.
///!
///! Two public entry-points:
///!
///!   `HttpServer::new(addr, handler)`          - raw function-pointer handler;
///!                                               routing and method checking
///!                                               all live inside the handler.
///!
///!   `HttpServer::with_router(addr, &router)`  - delegates every request to a
///!                                               `Router` for structured
///!                                               method- and path-based
///!                                               dispatch. The router must
///!                                               outlive the server (declare
///!                                               both in the same scope).
///!
///! Attach an optional startup callback with `.with_ready(cb)` before
///! calling `.run()`. `cb` fires once after the socket binds successfully,
///! before the first `accept`; use it to log the listening address or
///! signal a readiness probe.
///!
///! `.with_read_timeout(secs)` caps how long one request may take to arrive,
///! which is what keeps a peer dribbling a request out a byte at a time from
///! pinning the connection — and, since connections are served one at a time,
///! the accept loop behind it. `secs == 0` disables the cap.
///!
///! A read that hits the cap is abandoned, and abandoning an in-flight read
///! closes the connection: the transport is left holding a closed placeholder
///! while the read future owns the real socket. The cap is therefore a hard
///! close, not a recoverable error, so nothing after it can reply on that
///! socket.
///!
///! `.run()` never completes normally, returning only on a fatal
///! listener-level error (e.g. EMFILE). Per-connection failures (parse
///! errors, client hangups, write errors) are swallowed; instrument the
///! handler or router callbacks for request-level telemetry.
///!
///! Each accepted connection is reused for follow-up requests until
///! the client sends `Connection: close`, the HTTP version is below
///! 1.1 (which defaults to close), the read times out, or the
///! `MAX_REQUESTS_PER_CONNECTION` cap is hit.  Pipelining is not
///! supported: one request, one response, sequential.
namespace std::net::http::server;

import core::option;
import core::result;
import io::error;
import io::traits;
import io::buf;
import collections::array;
import collections::str;
import collections::string;
import net::addr::socket_addr;
import net::socket::tcp;
import net::http::request;
import net::http::response;
import net::http::status;
import net::http::conn;
import net::http::router;
import future::poll;
import future::waker;
import future::traits;
import future::combinator;
import time::duration;

/// Hard cap on requests served per accepted connection.  Without this
/// a misbehaving client could hold a connection open indefinitely with
/// trivial keep-alive traffic and exhaust server file descriptors.
const MAX_REQUESTS_PER_CONNECTION: u64 = 100;

/// Default per-connection read cap.  Long enough for slow consumer networks
/// but short enough that a single slow-loris peer can't pin the accept loop.
const DEFAULT_READ_TIMEOUT_SECS: i64 = 30;

/// A configured HTTP server ready to bind and run.
///
/// ```
/// // Raw handler: all routing logic lives in the handler function.
/// mut s: HttpServer = HttpServer::new(addr, my_handler);
/// s.with_ready(on_ready);
/// s.run();
///
/// // Router-backed: structured method + path dispatch.
/// mut r: Router = Router::new();
/// r.get(Str::new("/"), handle_root);
/// r.get(Str::new("/users/:id"), handle_user);
///
/// mut s: HttpServer = HttpServer::with_router(addr, &r);
/// s.with_ready(on_ready);
/// s.run();
/// r.drop();
/// ```
type struct HttpServer {
    addr:     SocketAddr;
    /// Set when built with `new`. `None` when using a Router.
    handler:  Option<(Request) -> Response>;
    /// Non-null when built with `with_router`. Takes priority over `handler`.
    /// Owned by the caller; the Router must outlive this server.
    router:   Router*;
    on_ready: Option<() -> void>;
    /// Deadline applied to each request read (whole seconds).  Zero
    /// disables; defaults to `DEFAULT_READ_TIMEOUT_SECS`.
    read_timeout_secs: i64;

    /// Build a server with a raw handler function. The handler receives
    /// every request and must produce a `Response`; all routing logic
    /// lives inside the handler.
    static new(addr: SocketAddr, handler: (Request) -> Response) -> HttpServer {
        return HttpServer {
            addr:              addr,
            handler:           Option::Some(handler),
            router:            null,
            on_ready:          Option::None,
            read_timeout_secs: DEFAULT_READ_TIMEOUT_SECS
        };
    }

    /// Build a server backed by a `Router`. Pass `&router`; the
    /// router must outlive the server (declare both in the same scope).
    static with_router(addr: SocketAddr, router: mut &Router) -> HttpServer {
        return HttpServer {
            addr:              addr,
            handler:           Option::None,
            router:            router,
            on_ready:          Option::None,
            read_timeout_secs: DEFAULT_READ_TIMEOUT_SECS
        };
    }

    // configuration

    /// Attach a ready callback and return `this` for chaining. `cb` is
    /// called once after the socket binds successfully, before the first
    /// `accept`. Use it to log the listening address, write a pid-file,
    /// or signal an external health-check.
    with_ready(mut &this, cb: () -> void) -> &HttpServer {
        this.on_ready = Option::Some(cb);
        return &this;
    }

    /// Override the per-connection read timeout.  `secs == 0` disables;
    /// the default is `DEFAULT_READ_TIMEOUT_SECS`.
    ///
    /// Reaching the cap closes the connection outright rather than answering
    /// with a 408 -- see the module doc for why a timed-out read cannot reply.
    with_read_timeout(mut &this, secs: i64) -> &HttpServer {
        this.read_timeout_secs = secs;
        return &this;
    }

    // lifecycle

    /// Bind to `this.addr` and serve requests forever. Returns `Err`
    /// only on a fatal listener error (e.g. EMFILE, ENFILE).
    async run(mut &this) -> Result<(), IoError> {
        const l: TcpListener = TcpListener::bind(this.addr)?;
        return await this.run_on(l);
    }

    /// Serve on a listener the caller already bound, which is the form to
    /// reach for when the port matters and `this.addr` cannot name it: bind
    /// to port 0, read the assigned port off `local_addr`, then hand the
    /// listener over. Binding here and reporting the port afterwards would
    /// mean racing another process for the port in between.
    ///
    /// `TcpAccept` consumes the listener and hands it back with the
    /// connection it produced, so the loop reclaims it each time round
    /// rather than borrowing it across the suspension.
    async run_on(mut &this, listener: TcpListener) -> Result<(), IoError> {
        mut l: TcpListener = listener;
        match (this.on_ready) {
            Option::Some(cb) => { cb(); }
            Option::None     => { }
        }
        loop {
            mut accepted: TcpAccepted = await TcpAccept::start(l);
            l = accepted.take_listener();
            match (accepted.take_result()) {
                Result::Ok(stream) => {
                    // The connection is MOVED into the exchange rather than
                    // lent to it: a future may not hold the address of a
                    // local in the frame that spawned it, and moving it in
                    // makes it that future's own storage.
                    await this.serve_connection(BufStream<TcpStream>::of(stream));
                }
                Result::Err(err) => { return Result::Err(err); }
            }
        }
    }

    // internals

    /// Route `req` to the router (if set) or the raw handler.
    /// Consumes the request regardless of which path is taken.
    dispatch(&this, req: Request) -> Response {
        if (this.router != null) {
            return this.router.dispatch(req);
        }
        match (this.handler) {
            Option::Some(h) => { return (h)(req); }
            Option::None    => {
                mut req_drop: Request = req;
                return Response::text(
                    StatusCode::internal_server_error(),
                    Str::new("no handler configured")
                );
            }
        }
    }

    /// Serve requests on `conn` until the client (or this server) signals
    /// close, a read exceeds the cap, or `MAX_REQUESTS_PER_CONNECTION` is
    /// reached.  A parse failure on the FIRST request writes a canned 400;
    /// failures on follow-up requests are taken as "peer gave up" and close
    /// silently.  Write failures (peer gone) end the connection.  The accept
    /// loop always continues.
    ///
    /// Takes the connection BY VALUE. The framing reads are methods on it and
    /// a future may only re-address its own RECEIVER between polls, so the
    /// connection has to be storage this future owns rather than the accept
    /// loop's local.
    ///
    /// One buffer serves the WHOLE connection, and it persists across
    /// keep-alive iterations: bytes of the NEXT request that arrived in the
    /// same fill as the previous body are still there to be parsed, not lost.
    async serve_connection(mut &this, conn: BufStream<TcpStream>) -> void {
        mut c: BufStream<TcpStream> = conn;
        mut served: u64 = 0;
        loop {
            served = served + 1;

            // The read is capped so one peer dribbling a request out a byte at
            // a time cannot pin this connection (and, since connections are
            // served one at a time, the accept loop behind it) forever.
            // `read_timeout_secs == 0` disables the cap.
            //
            // Hitting the cap ABANDONS the read, and abandoning an in-flight
            // read closes the connection: the transport is left holding a
            // closed placeholder while the read future owns the real socket.
            // The cap is therefore a hard close, not a recoverable error --
            // nothing after it can reply on this socket, so the timeout arm
            // returns rather than trying to write a 408.
            mut got: Result<Request, IoError> =
                Result::Err(IoError::new(IoErrorKind::TimedOut, 0));
            if (this.read_timeout_secs > 0) {
                const capped: Result<Result<Request, IoError>, Elapsed> =
                    await Futures::timeout(
                        Duration::from_secs(this.read_timeout_secs as u64),
                        c.read_request());
                match (capped) {
                    Result::Ok(inner) => { got = inner; }
                    Result::Err(_)    => { return; }
                }
            } else {
                got = await c.read_request();
            }

            match (got) {
                Result::Ok(req) => {
                    mut request_local: Request = req;
                    const keep_alive: boolean = should_keep_alive(&request_local, served);
                    mut response: Response = this.dispatch(request_local);
                    if (!keep_alive) {
                        response.headers.insert(
                            Str::new("Connection"),
                            Str::new("close")
                        );
                    }
                    // Encoding is synchronous, so a whole response is
                    // assembled with no suspension inside it and the
                    // connection suspends exactly once, in `flush`.
                    match (response.encode_into(c.pending())) {
                        Result::Ok(_)  => { }
                        Result::Err(_) => { return; }
                    }
                    match (await c.flush()) {
                        Result::Ok(_)  => { }
                        Result::Err(_) => { return; }
                    }
                    if (!keep_alive) { return; }
                }
                Result::Err(_) => {
                    // Only a malformed FIRST request is worth answering; a
                    // failure later reads as the peer having given up.
                    if (served == 1) {
                        mut bad: Response = Response::text(
                            StatusCode::bad_request(),
                            Str::new("Bad Request")
                        );
                        match (bad.encode_into(c.pending())) {
                            Result::Ok(_)  => { }
                            Result::Err(_) => { return; }
                        }
                        match (await c.flush()) {
                            Result::Ok(_)  => { }
                            Result::Err(_) => { }
                        }
                    }
                    return;
                }
            }
        }
    }
}

/// Decide whether to reuse this connection for another request.
///
/// HTTP/1.1 defaults to keep-alive; the client opts out with
/// `Connection: close`.  The per-connection cap also forces close.
/// HTTP/1.0 isn't distinguished here; every served version that
/// reaches us is treated as 1.1; downgrades go through the keep-alive
/// default and rely on the client to send `Connection: close` if it
/// can't reuse the socket.
function should_keep_alive(req: &Request, served: u64) -> boolean {
    if (served >= MAX_REQUESTS_PER_CONNECTION) {
        return false;
    }
    match (req.headers.get(Str::new("connection"))) {
        Option::Some(mut conn) => {
            mut lowered: String = conn.as_str().to_ascii_lowercase();
            return !lowered.as_str().equals(Str::new("close"));
        }
        Option::None => { return true; }
    }
}
