///! HTTP server — blocking, connection-per-request.
///!
///! Two public entry-points:
///!
///!   `HttpServer::new(addr, handler)`          — raw function-pointer handler;
///!                                               routing and method checking
///!                                               all live inside the handler.
///!
///!   `HttpServer::with_router(addr, &router)`  — delegates every request to a
///!                                               `Router` for structured
///!                                               method- and path-based
///!                                               dispatch. The router must
///!                                               outlive the server (declare
///!                                               both in the same scope).
///!
///! Attach an optional startup callback with `.with_ready(cb)` before
///! calling `.run()`. `cb` fires once after the socket binds successfully,
///! before the first `accept` — use it to log the listening address or
///! signal a readiness probe.
///!
///! `.run()` blocks indefinitely, returning only on a fatal listener-level
///! error (e.g. EMFILE). Per-connection failures (parse errors, client
///! hangups, write errors) are swallowed — instrument the handler or router
///! callbacks for request-level telemetry.
///!
///! Connection-per-request is intentional: no keep-alive, no pipelining,
///! trivial to reason about, sufficient for dev servers and simple tooling.

namespace std::net::http::server;

import core::option;
import core::result;
import io::error;
import net::socket_addr;
import net::tcp;
import net::http::request;
import net::http::response;
import net::http::status;
import net::http::router;

// ============================================================================
// HttpServer
// ============================================================================

/// A configured HTTP server ready to bind and run.
///
/// ```
/// // Raw handler — all routing logic lives in the handler function.
/// mut s: HttpServer = HttpServer::new(addr, my_handler);
/// s.with_ready(on_ready);
/// s.run();
///
/// // Router-backed — structured method + path dispatch.
/// mut r: Router = Router::new();
/// r.get(Str::from_raw("/", 1), handle_root);
/// r.get(Str::from_raw("/users/:id", 10), handle_user);
///
/// mut s: HttpServer = HttpServer::with_router(addr, &r);
/// s.with_ready(on_ready);
/// s.run();
/// r.drop();
/// ```
type struct HttpServer {
    addr:     SocketAddr;
    /// Set when built with `new`. `None` when using a Router.
    handler:  Option<(Request) -> Response>;
    /// Non-null when built with `with_router`. Takes priority over `handler`.
    /// Owned by the caller — the Router must outlive this server.
    router:   Router*;
    on_ready: Option<() -> void>;

    // ── construction ─────────────────────────────────────────────────────────

    /// Build a server with a raw handler function. The handler receives
    /// every request and must produce a `Response`; all routing logic
    /// lives inside the handler.
    static new(addr: SocketAddr, handler: (Request) -> Response) -> HttpServer {
        return HttpServer {
            addr:     addr,
            handler:  Option::Some(handler),
            router:   null,
            on_ready: Option::None
        };
    }

    /// Build a server backed by a `Router`. Pass `&router` — the
    /// router must outlive the server (declare both in the same scope).
    static with_router(addr: SocketAddr, router: mut &Router) -> HttpServer {
        return HttpServer {
            addr:     addr,
            handler:  Option::None,
            router:   router,
            on_ready: Option::None
        };
    }

    // ── configuration ────────────────────────────────────────────────────────

    /// Attach a ready callback and return `this` for chaining. `cb` is
    /// called once after the socket binds successfully, before the first
    /// `accept`. Use it to log the listening address, write a pid-file,
    /// or signal an external health-check.
    with_ready(mut &this, cb: () -> void) -> &HttpServer {
        this.on_ready = Option::Some(cb);
        return &this;
    }

    // ── lifecycle ────────────────────────────────────────────────────────────

    /// Bind to `this.addr` and serve requests forever. Returns `Err`
    /// only on a fatal listener error (e.g. EMFILE, ENFILE).
    run(mut &this) -> Result<(), IoError> {
        match (TcpListener::bind(this.addr)) {
            Result::Ok(listener) => {
                mut l: TcpListener = listener;
                match (this.on_ready) {
                    Option::Some(cb) => { cb(); }
                    Option::None     => { }
                }
                loop {
                    match (l.accept()) {
                        Result::Ok(stream) => {
                            mut s: TcpStream = stream;
                            this.handle_connection(&s);
                            s.drop();
                        }
                        Result::Err(err) => {
                            l.drop();
                            return Result::Err(err);
                        }
                    }
                }
            }
            Result::Err(err) => { return Result::Err(err); }
        }
    }

    // ── internals ────────────────────────────────────────────────────────────

    /// Route `req` to the router (if set) or the raw handler.
    /// Consumes the request regardless of which path is taken.
    dispatch(&this, req: Request) -> Response {
        if (this.router != null) {
            return this.router.dispatch(req);
        }
        match (this.handler) {
            Option::Some(h) => { return (h)(req); }
            Option::None    => {
                mut req_drop: Request = req;
                req_drop.drop();
                return Response::text(
                    StatusCode::internal_server_error(),
                    Str::from_raw("no handler configured", 20)
                );
            }
        }
    }

    /// Parse one request, dispatch it, write the response. A parse
    /// failure writes a canned 400; a write failure (peer gone) is
    /// silently dropped. The accept loop always continues.
    handle_connection(&this, stream: mut &TcpStream) -> void {
        match (Request::parse(stream)) {
            Result::Ok(req) => {
                mut request_local: Request = req;
                mut response: Response = this.dispatch(request_local);
                match (response.write_to(stream)) {
                    Result::Ok(_) => { }
                    Result::Err(_) => { }
                }
                response.drop();
            }
            Result::Err(_) => {
                mut bad: Response = Response::text(
                    StatusCode::bad_request(),
                    Str::from_raw("Bad Request", 11)
                );
                match (bad.write_to(stream)) {
                    Result::Ok(_) => { }
                    Result::Err(_) => { }
                }
                bad.drop();
            }
        }
    }
}
