///! HTTP request.
///!
///! A `Request` is parsed from any `Read` (typically a `TcpStream`)
///! or built by a client and written to any `Write`. The parser is
///! intentionally basic: request line + headers until CRLF-CRLF +
///! a body framed by `Content-Length` or the chunked transfer coding
///! (`conn` reads both).

namespace std::net::http::request;

import std::core::intrinsics;
import std::core::drop::{ Drop };
import std::core::mem;
import std::core::option::{ Option };
import std::core::result::{ Result };
import std::core::slice::{ Slice };
import std::io::error::{ IoError, IoErrorKind };
import std::io::traits;
import std::collections::array::{ Array };
import std::collections::str::{ Str };
import std::collections::string::{ String };
import std::collections::hashmap::{ HashMap };
import std::core::convert;
import std::core::primitives;
import std::net::http::method::{ Method };
import std::net::http::headers::{ Headers };

/// `"HTTP/1.1"`, the version `Request::new` and `Response::new` store. It is
/// the only version written on the wire: the encoders emit it literally
/// whatever a message's `version` field holds.
public const HTTP_VERSION: Str = Str::new("HTTP/1.1");
/// The longest line, in bytes, the HTTP/1.1 reader buffers while looking
/// for its end: 8192. It caps the request line, the status line, each
/// header and trailer line and each chunk-size line, in both directions;
/// a peer that sends a longer one is refused with `InvalidData`.
public const MAX_HEADER_LINE: i64 = 8192;
/// The largest request body, in bytes, the HTTP/1.1 reader accepts:
/// 16777216 (16 MiB). A declared `Content-Length` above it is refused with
/// `InvalidData` before any of the body is read; a chunked body is refused
/// as soon as its chunks would pass it.
public const MAX_BODY: i64 = 16777216;  // 16 MiB; hard cap against runaway Content-Length
/// Cap on the number of header lines. Each line is already bounded by
/// MAX_HEADER_LINE, but without a count cap the parse loop grows the Headers
/// map without bound on a peer that sends endless header lines (slow
/// memory-exhaustion DoS). 100 mirrors common server defaults.
public const MAX_HEADER_COUNT: u64 = 100;

/// An HTTP/1.1 request: method, target path, version text, headers, body,
/// and the path parameters a `Router` captured. A server receives one from
/// `BufStream::read_request`; a client builds one with `new` and the
/// `with_*` builders and writes it with `encode_into`.
///
/// ```cryo
/// import std::collections::array::{ Array };
/// import std::collections::str::{ Str };
/// import std::net::http::method::{ Method };
/// import std::net::http::request::{ Request };
///
/// mut body: Array<u8> = Array::new();
/// body.append(Str::new("hello").as_bytes());
/// const request: Request = Request::new(Method::Post, Str::new("/items"))
///     .with_header(Str::new("Content-Type"), Str::new("text/plain"))
///     .with_body(body);
/// mut wire: Array<u8> = Array::new();
/// request.encode_into(&wire).expect("encode");
/// // POST /items HTTP/1.1, content-type: text/plain, content-length: 5,
/// // a blank line, then hello
/// ```
public type struct Request with [Clone] {
    public method:  Method;
    public path:    String;
    public version: String;
    public headers: Headers;
    public body:    Array<u8>;
    /// Path parameters captured by the router (`/users/:id` -> `id`).
    /// Empty for requests dispatched without a `Router`.
    public params:  HashMap<String, String>;

    /// Construct a minimal request. Clients build on top of this with
    /// `with_header` / `with_body`.
    public static new(method: Method, path: Str) -> Request {
        return Request {
            method:  method,
            path:    String::from_str(path),
            version: String::from_str(HTTP_VERSION),
            headers: Headers::new(),
            body:    Array::new(),
            params:  HashMap::new()
        };
    }

    /// Look up a path parameter captured by the router (e.g., `:id`
    /// in `/users/:id`). Returns an owned copy of the captured segment
    /// The caller is responsible for dropping it. Returns `None`
    /// when the parameter was not captured (no router, or pattern did
    /// not include a segment with that name).
    public param(&this, name: Str) -> Option<String> {
        mut key: String = String::from_str(name);
        // Deep-clone the captured value: a bitwise `HashMap::get` would
        // hand back an alias of the map's heap buffer and double-free.
        match (this.params.get_ref(&key)) {
            Option::Some(stored) => {
                return Option::Some(String::from_str((*stored).as_str()));
            }
            Option::None => { return Option::None; }
        }
    }

    /// Builder: insert a header and return the request so calls chain.
    /// Consumes and returns `this` (the owning fields are moved, not
    /// copied): `Request::new(m, p).with_header(n, v).with_body(b)`.
    public with_header(mut this, name: Str, value: Str) -> Request {
        this.headers.insert(name, value);
        return this;
    }

    /// Builder: set the body (and Content-Length) and return the request.
    public with_body(mut this, body: Array<u8>) -> Request {
        this.set_body(body);
        return this;
    }

    /// Replace the body and set Content-Length accordingly.
    public set_body(mut &this, body: Array<u8>) -> void {
        mut displaced: Array<u8> = body;
        mem::swap(&displaced, &this.body);
        mut length: Array<u8> = Array::<u8>::new();
        length.write(f"{this.body.length()}").expect("Request::set_body: allocation failed");
        this.headers.insert(Str::new("Content-Length"), Str::from_raw(length.as_ptr(), length.length()));
    }

    /// Parse a Request-Line (`METHOD SP PATH SP VERSION`, no CRLF) into
    /// a request with empty headers and no body. Malformed input is
    /// `InvalidData`, which a server surfaces as 400.
    ///
    /// Split out from the message parse so the grammar has exactly one
    /// implementation: the blocking `parse` below and the connection's
    /// `read_request` differ only in how they obtain the line.
    public static from_request_line(line: Str) -> Result<Request, IoError> {
        mut first_sp: i64 = line.length();
        mut second_sp: i64 = line.length();
        mut i: i64 = 0;
        while (i < line.length()) {
            match (line.byte_at(i)) {
                Option::Some(byte) => {
                    if (byte == 0x20) {
                        if (first_sp == line.length()) { first_sp = i; }
                        else if (second_sp == line.length()) { second_sp = i; break; }
                    }
                }
                Option::None => { break; }
            }
            i++;
        }
        if (first_sp == line.length() || second_sp == line.length()) {
            return Result::Err(IoError::new(IoErrorKind::InvalidData, 0));
        }

        const method_str: Str = line.sub_bytes(0, first_sp);
        const path_str: Str = line.sub_bytes(first_sp + 1, second_sp);
        const version_str: Str = line.sub_bytes(second_sp + 1, line.length());

        mut parsed_method: Method = Method::Get;
        match (Method::parse(method_str)) {
            Result::Ok(m) => { parsed_method = m; }
            Result::Err(_) => {
                return Result::Err(IoError::new(IoErrorKind::InvalidData, 0));
            }
        }

        return Result::Ok(Request {
            method:  parsed_method,
            path:    String::from_str(path_str),
            version: String::from_str(version_str),
            headers: Headers::new(),
            body:    Array::new(),
            params:  HashMap::new()
        });
    }

    /// Append the whole message — request line, headers, blank line,
    /// body — to `out`, normally the connection's `pending()` buffer.
    ///
    /// Synchronous by design: an entire request is assembled with no
    /// suspension point inside it, so a caller sending one suspends
    /// exactly once, in the following `flush`. That is also what makes
    /// a partially-encoded message impossible to put on the wire — an
    /// `OutOfMemory` here leaves `out` short, and nothing has been sent.
    public encode_into(&this, out: mut &Array<u8>) -> Result<(), IoError> {
        const crlf: &Slice<u8> = Slice::from_raw("\r\n", 2);
        const sp: &Slice<u8> = Slice::from_raw(" ", 1);
        // HTTP/1.1 is the only version this stdlib emits, so it is
        // written as a literal rather than read from `this.version`: a
        // `Request` built field by field need not hold a valid `String`
        // for the version.  `HTTP_VERSION` is computed before `main`,
        // and `Request::new` stores it, but the encoder does not rely on
        // the field.  Servers ignore the textual version anyway for
        // dispatch purposes.
        const http11: &Slice<u8> = Slice::from_raw("HTTP/1.1", 8);

        out.try_append(this.method.as_str().as_bytes())?;
        out.try_append(sp)?;
        out.try_append(this.path.as_bytes())?;
        out.try_append(sp)?;
        out.try_append(http11)?;
        out.try_append(crlf)?;

        this.headers.encode_into(out)?;

        out.try_append(crlf)?;
        if (!this.body.is_empty()) {
            out.try_append(this.body.as_slice())?;
        }
        return Result::Ok(());
    }

}

implement trait Drop for struct Request {
    drop(mut &this) -> void { }
}

