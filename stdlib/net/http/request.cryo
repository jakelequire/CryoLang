///! HTTP request.
///!
///! A `Request` is parsed from any `Read` (typically a `TcpStream`)
///! or built by a client and written to any `Write`. The parser is
///! intentionally basic: request line + headers until CRLF-CRLF +
///! body sized by `Content-Length`. Chunked transfer-encoding is
///! not supported.

namespace std::net::http::request;

import core::intrinsics;
import core::drop;
import core::option;
import core::result;
import core::slice;
import io::error;
import io::traits;
import collections::array;
import collections::str;
import collections::string;
import collections::hashmap;
import core::convert;
import core::primitives;
import net::http::method;
import net::http::headers;

const HTTP_VERSION: Str = Str::new("HTTP/1.1");
const MAX_HEADER_LINE: u64 = 8192;
const MAX_BODY: u64 = 16777216;  // 16 MiB; hard cap against runaway Content-Length
/// Cap on the number of header lines. Each line is already bounded by
/// MAX_HEADER_LINE, but without a count cap the parse loop grows the Headers
/// map without bound on a peer that sends endless header lines (slow
/// memory-exhaustion DoS). 100 mirrors common server defaults.
const MAX_HEADER_COUNT: u64 = 100;

type struct Request {
    method:  Method;
    path:    String;
    version: String;
    headers: Headers;
    body:    Array<u8>;
    /// Path parameters captured by the router (`/users/:id` -> `id`).
    /// Empty for requests dispatched without a `Router`.
    params:  HashMap<String, String>;

    /// Construct a minimal request. Clients build on top of this with
    /// `with_header` / `with_body`.
    static new(method: Method, path: Str) -> Request {
        return Request {
            method:  method,
            path:    String::from_str(path),
            version: String::from_str(HTTP_VERSION),
            headers: Headers::new(),
            body:    Array::new(),
            params:  HashMap::new()
        };
    }

    /// Look up a path parameter captured by the router (e.g., `:id`
    /// in `/users/:id`). Returns an owned copy of the captured segment
    /// The caller is responsible for dropping it. Returns `None`
    /// when the parameter was not captured (no router, or pattern did
    /// not include a segment with that name).
    param(&this, name: Str) -> Option<String> {
        mut key: String = String::from_str(name);
        // Deep-clone the captured value: a bitwise `HashMap::get` would
        // hand back an alias of the map's heap buffer and double-free.
        match (this.params.get_ref(&key)) {
            Option::Some(stored) => {
                return Option::Some(String::from_str((*stored).as_str()));
            }
            Option::None => { return Option::None; }
        }
    }

    /// Builder: insert a header and return the request so calls chain.
    /// Consumes and returns `this` (the owning fields are moved, not
    /// copied): `Request::new(m, p).with_header(n, v).with_body(b)`.
    with_header(mut this, name: Str, value: Str) -> Request {
        this.headers.insert(name, value);
        return this;
    }

    /// Builder: set the body (and Content-Length) and return the request.
    with_body(mut this, body: Array<u8>) -> Request {
        this.set_body(body);
        return this;
    }

    /// Replace the body and set Content-Length accordingly.
    set_body(mut &this, body: Array<u8>) -> void {
        mut old: Array<u8> = this.body;
        this.body = body;
        mut buffer: u8[24];
        const body_len: u64 = this.body.length();
        const digits: u64 = body_len.to_decimal_buf(&buffer[0]);
        this.headers.insert(
            Str::new("Content-Length"),
            Str::from_raw(&buffer[0], digits)
        );
    }

    /// Parse a Request-Line (`METHOD SP PATH SP VERSION`, no CRLF) into
    /// a request with empty headers and no body. Malformed input is
    /// `InvalidData`, which a server surfaces as 400.
    ///
    /// Split out from the message parse so the grammar has exactly one
    /// implementation: the blocking `parse` below and the connection's
    /// `read_request` differ only in how they obtain the line.
    static from_request_line(line: Str) -> Result<Request, IoError> {
        mut first_sp: u64 = line.length();
        mut second_sp: u64 = line.length();
        mut i: u64 = 0;
        while (i < line.length()) {
            match (line.byte_at(i)) {
                Option::Some(byte) => {
                    if (byte == 0x20) {
                        if (first_sp == line.length()) { first_sp = i; }
                        else if (second_sp == line.length()) { second_sp = i; break; }
                    }
                }
                Option::None => { break; }
            }
            i++;
        }
        if (first_sp == line.length() || second_sp == line.length()) {
            return Result::Err(IoError::new(IoErrorKind::InvalidData, 0));
        }

        const method_str: Str = line.sub_bytes(0, first_sp);
        const path_str: Str = line.sub_bytes(first_sp + 1, second_sp);
        const version_str: Str = line.sub_bytes(second_sp + 1, line.length());

        mut parsed_method: Method = Method::Get;
        match (Method::parse(method_str)) {
            Result::Ok(m) => { parsed_method = m; }
            Result::Err(_) => {
                return Result::Err(IoError::new(IoErrorKind::InvalidData, 0));
            }
        }

        return Result::Ok(Request {
            method:  parsed_method,
            path:    String::from_str(path_str),
            version: String::from_str(version_str),
            headers: Headers::new(),
            body:    Array::new(),
            params:  HashMap::new()
        });
    }

    /// Parse from a `Read` impl. Consumes bytes up to and including
    /// the body (if any). Fails with `InvalidData` on malformed
    /// input; that's a protocol error the server surfaces as 400.
    static parse<R>(reader: mut &R) -> Result<Request, IoError>
    where R: Read {
        mut line: String = String::new();
        read_line(reader, &line, MAX_HEADER_LINE)?;

        mut req: Request = Request::from_request_line(line.as_str())?;

        // Header block: lines until an empty one.  The loop body owns
        // each `header_line` String; auto-drop synthesis emits the
        // per-iteration drop at scope exit.
        mut header_count: u64 = 0;
        loop {
            mut header_line: String = String::new();
            read_line(reader, &header_line, MAX_HEADER_LINE)?;
            if (header_line.is_empty()) {
                break;
            }
            if (!req.headers.parse_line(header_line.as_str())) {
                return Result::Err(IoError::new(IoErrorKind::InvalidData, 0));
            }
            header_count = header_count + 1;
            if (header_count > MAX_HEADER_COUNT) {
                return Result::Err(IoError::new(IoErrorKind::InvalidData, 0));
            }
        }

        // Body, sized by Content-Length. No Content-Length means no
        // body for this parser; chunked encoding is out of scope.
        match (req.headers.get(Str::new("content-length"))) {
            Option::Some(mut value) => {
                match (u64::try_from(value.as_str())) {
                    Result::Ok(len) => {
                        if (len > MAX_BODY) {
                            return Result::Err(IoError::new(IoErrorKind::InvalidData, 0));
                        }
                        mut body: Array<u8> = Array::with_capacity(len);
                        // Read exactly len bytes.
                        mut remaining: u64 = len;
                        mut buffer: u8[4096];
                        while (remaining > 0) {
                            mut take: u64 = 4096;
                            if (take > remaining) { take = remaining; }
                            const n: u64 = reader.read(&buffer[0], take)?;
                            if (n == 0) {
                                return Result::Err(IoError::new(IoErrorKind::UnexpectedEof, 0));
                            }
                            mut j: u64 = 0;
                            while (j < n) { body.push(buffer[j]); j = j + 1; }
                            remaining = remaining - n;
                        }
                        req.body = body;
                    }
                    Result::Err(_) => {
                        return Result::Err(IoError::new(IoErrorKind::InvalidData, 0));
                    }
                }
            }
            Option::None => { }
        }

        return Result::Ok(req);
    }

    /// Append the whole message — request line, headers, blank line,
    /// body — to `out`, normally the connection's `pending()` buffer.
    ///
    /// Synchronous by design: an entire request is assembled with no
    /// suspension point inside it, so a caller sending one suspends
    /// exactly once, in the following `flush`. That is also what makes
    /// a partially-encoded message impossible to put on the wire — an
    /// `OutOfMemory` here leaves `out` short, and nothing has been sent.
    encode_into(&this, out: Array<u8>*) -> Result<(), IoError> {
        const crlf: Slice<u8> = Slice::from_raw("\r\n", 2);
        const sp: Slice<u8> = Slice::from_raw(" ", 1);
        // HTTP/1.1 is the only version this stdlib emits.  Going
        // through `this.version` would force every callsite to keep a
        // valid `String` for the version field, but module-level const
        // init for `HTTP_VERSION` is fragile (the bytes can come back
        // empty after `String::from_str`), so write the constant
        // directly.  Servers ignore the textual version anyway for
        // dispatch purposes.
        const http11: Slice<u8> = Slice::from_raw("HTTP/1.1", 8);

        headers::push_all(out, this.method.as_str().as_bytes())?;
        headers::push_all(out, sp)?;
        headers::push_all(out, this.path.as_bytes())?;
        headers::push_all(out, sp)?;
        headers::push_all(out, http11)?;
        headers::push_all(out, crlf)?;

        this.headers.encode_into(out)?;

        headers::push_all(out, crlf)?;
        if (!this.body.is_empty()) {
            headers::push_all(out, this.body.as_slice())?;
        }
        return Result::Ok(());
    }

    /// Write to a `Write` impl. Emits request line, headers, CRLF,
    /// body.
    write_to<W>(&this, writer: mut &W) -> Result<(), IoError>
    where W: Write {
        const crlf: Slice<u8> = Slice::from_raw("\r\n", 2);
        const sp: Slice<u8> = Slice::from_raw(" ", 1);
        // HTTP/1.1 is the only version this stdlib emits.  Going
        // through `this.version` would force every callsite to keep a
        // valid `String` for the version field, but module-level const
        // init for `HTTP_VERSION` is fragile (the bytes can come back
        // empty after `String::from_str`), so write the constant
        // directly.  Servers ignore the textual version anyway for
        // dispatch purposes.
        const http11: Slice<u8> = Slice::from_raw("HTTP/1.1", 8);

        writer.write(this.method.as_str().as_bytes())?;
        writer.write(sp)?;
        writer.write(this.path.as_bytes())?;
        writer.write(sp)?;
        writer.write(http11)?;
        writer.write(crlf)?;

        // Headers: emit every stored header as `name: value\r\n`.
        // Without this, `Client::post`-style callers that set
        // `Content-Type` (or any other header) ended up sending bare
        // request-line + body; the headers were silently dropped on
        // the wire.  Mirrors `Response::write_to` exactly.
        this.headers.write_to(writer)?;

        // Blank line separating headers from body.
        writer.write(crlf)?;
        if (!this.body.is_empty()) {
            writer.write(this.body.as_slice())?;
        }
        return Result::Ok(());
    }

}

implement trait Drop for struct Request {
    drop(mut &this) -> void {
        this.path.drop();
        this.version.drop();
        this.headers.drop();
        this.body.drop();
        this.params.drop();
    }
}

// Shared helpers (also used by response.cryo)

/// Read bytes into `out` until CRLF. Trailing CRLF is consumed but
/// not appended. Returns `InvalidData` if the line exceeds `max`.
///
/// PERF (v1.0, known limitation): this reads one byte per `read(2)`
/// syscall, so parsing a request with N header bytes costs N syscalls.
/// The correct fix is to drive parsing through a buffered reader that
/// fills a 4-8 KiB buffer and scans for CRLF in memory; the wrinkle is
/// that the body reader (`Content-Length` bytes) must continue from the
/// SAME buffer so leftover bytes after the header block are not lost.
/// That shared-buffer refactor is deferred to avoid destabilising the
/// request/response framing; framing is correct today, just syscall-heavy.
function read_line<R>(reader: mut &R,
                      out: mut &String,
                      max: u64) -> Result<(), IoError>
where R: Read {
    mut last_was_cr: boolean = false;
    mut total: u64 = 0;
    mut buf: u8[1];
    loop {
        const n: u64 = reader.read(&buf[0], 1)?;
        if (n == 0) {
            return Result::Err(IoError::new(IoErrorKind::UnexpectedEof, 0));
        }
        const byte: u8 = buf[0];
        if (last_was_cr && byte == 0x0A) {
            // drop the CR we provisionally appended
            // (`last_was_cr` is set only after we pushed one)
            return Result::Ok(());
        }
        if (last_was_cr) {
            out.push_byte(0x0D as u8);
            total = total + 1;
        }
        if (byte == 0x0D) {
            last_was_cr = true;
        } else {
            out.push_byte(byte);
            total = total + 1;
            last_was_cr = false;
        }
        if (total > max) {
            return Result::Err(IoError::new(IoErrorKind::InvalidData, 0));
        }
    }
}
