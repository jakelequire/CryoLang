///! HTTP client: simple one-shot requests over plain TCP.
///!
///! Opens a fresh connection, sends the request, reads one response,
///! closes. Keep-alive, connection pooling, retries, and redirect
///! following are caller concerns on top.
///!
///! The client takes a `SocketAddr` and a path directly; there's no
///! URL parser included. Callers that need `https://host:port/path`
///! resolve host and scheme themselves until a URL parsing module is
///! available.

namespace std::net::http::client;

import std::core::intrinsics;
import std::core::option;
import std::core::result;
import std::core::slice;
import std::io::error;
import std::io::traits;
import std::io::buf;
import std::collections::array;
import std::collections::str;
import std::collections::string;
import std::core::primitives;
import std::net::addr::ip;
import std::net::addr::socket_addr;
import std::net::socket::tcp;
import std::net::http::method;
import std::net::http::request;
import std::net::http::response;
import std::net::http::headers;
import std::net::http::conn;
import std::future::poll;
import std::future::waker;
import std::future::traits;

type struct Client {
    static new() -> Client {
        return Client { };
    }

    /// `GET addr/path`. Sets Host to `addr`'s address:port.
    async get(&this, addr: SocketAddr, path: Str) -> Result<Response, IoError> {
        mut req: Request = Request::new(Method::Get, path);
        apply_host_header(&req, &addr);
        return await send(addr, req);
    }

    /// `POST addr/path` with body bytes. Sets Host and passes the
    /// supplied Content-Type through unchanged; if the caller didn't
    /// set one, the server may fall back to octet-stream.
    async post(&this,
               addr: SocketAddr,
               path: Str,
               content_type: Str,
               body: Array<u8>) -> Result<Response, IoError> {
        mut req: Request = Request::new(Method::Post, path);
        apply_host_header(&req, &addr);
        req.headers.insert(
            Str::new("Content-Type"),
            content_type
        );
        req.set_body(body);
        return await send(addr, req);
    }
}

/// Open a connection, send the request, read one response, close.
/// Emits `Connection: close` (RFC 7230 section 6.1) so the server knows this
/// is a one-shot exchange and can free its half of the socket as soon
/// as the response is written.  Without this header, servers that
/// default to HTTP/1.1 keep-alive will sit holding the connection open
/// until their idle timeout fires.
///
/// The whole request is encoded into the connection's outgoing buffer
/// first and flushed once, so sending costs one suspension however many
/// headers it carries. The response then comes back through the SAME
/// buffer that the flush drained, which is what lets the header block
/// and a Content-Length body be read without losing bytes that arrived
/// in the same fill.
async function send(addr: SocketAddr, req: Request) -> Result<Response, IoError> {
    mut request_local: Request = req;
    request_local.headers.insert(
        Str::new("Connection"),
        Str::new("close")
    );

    mut sock: TcpStream = (await TcpConnect::start(addr))?;
    mut c: BufStream<TcpStream> = BufStream<TcpStream>::of(sock);

    request_local.encode_into(c.pending())?;
    (await c.flush())?;
    // Half-close so a server that reads to EOF sees the request end.
    // Not required for a Content-Length-framed request, and a failure
    // here is not one the caller can act on: the bytes are already sent.
    match (c.transport().shutdown_write()) {
        Result::Ok(_) => { }
        Result::Err(_) => { }
    }

    return await c.read_response();
}

/// Write `host: ip:port` into the request headers. IPv4 renders as
/// `a.b.c.d:port`; an IPv6 literal is bracketed per RFC 3986: `[h:h:...]:port`.
function apply_host_header(req: mut &Request, addr: &SocketAddr) -> void {
    mut buffer: String = String::with_capacity(48);
    match (addr.ip) {
        IpAddr::V4(v4) => {
            push_u8_decimal(&buffer, v4.a);
            buffer.push_byte(0x2E as u8);
            push_u8_decimal(&buffer, v4.b);
            buffer.push_byte(0x2E as u8);
            push_u8_decimal(&buffer, v4.c);
            buffer.push_byte(0x2E as u8);
            push_u8_decimal(&buffer, v4.d);
            buffer.push_byte(0x3A as u8);
            push_u16_decimal(&buffer, addr.port);
        }
        IpAddr::V6(v6) => {
            // RFC 3986: bracket the literal, with `:port` outside the brackets.
            buffer.push_byte(0x5B as u8);                  // '['
            push_v6_hextets(&buffer, &v6);
            buffer.push_byte(0x5D as u8);                  // ']'
            buffer.push_byte(0x3A as u8);
            push_u16_decimal(&buffer, addr.port);
        }
    }
    req.headers.insert(Str::new("Host"), buffer.as_str());
}

/// Eight colon-separated lowercase hex groups, no `::` compression (the
/// uncompressed form is valid inside a bracketed Host).
function push_v6_hextets(buffer: mut &String, v6: &IpV6Addr) -> void {
    mut g: u64 = 0;
    while (g < 8) {
        if (g > 0) { buffer.push_byte(0x3A as u8); }       // ':'
        push_u16_hex(buffer, v6.group_at(g));
        g = g + 1;
    }
}

/// Lowercase hex of `value`, no leading zeros (at least one digit).
function push_u16_hex(buffer: mut &String, value: u16) -> void {
    if (value == 0) { buffer.push_byte(0x30 as u8); return; }
    mut tmp: u8[4];
    mut n: u64 = 0;
    mut v: u16 = value;
    while (v > 0) {
        const nib: u8 = (v & 0xF) as u8;
        if (nib < 10) { tmp[n] = 0x30 + nib; }
        else { tmp[n] = 0x61 + (nib - 10); }
        n = n + 1;
        v = v >> 4;
    }
    mut i: u64 = n;
    while (i > 0) { i = i - 1; buffer.push_byte(tmp[i]); }
}

function push_u8_decimal(buffer: mut &String, value: u8) -> void {
    mut temp: u8[4];
    const v: u64 = value as u64;
    const digits: u64 = v.to_decimal_buf(&temp[0]);
    mut i: u64 = 0;
    while (i < digits) {
        buffer.push_byte(temp[i]);
        i++;
    }
}

function push_u16_decimal(buffer: mut &String, value: u16) -> void {
    mut temp: u8[8];
    const v: u64 = value as u64;
    const digits: u64 = v.to_decimal_buf(&temp[0]);
    mut i: u64 = 0;
    while (i < digits) {
        buffer.push_byte(temp[i]);
        i++;
    }
}
