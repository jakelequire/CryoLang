///! HTTP client: simple one-shot requests over plain TCP.
///!
///! Opens a fresh connection, sends the request, reads one response,
///! closes. Keep-alive, connection pooling, retries, and redirect
///! following are caller concerns on top.
///!
///! The client takes a `SocketAddr` and a path directly; there's no
///! URL parser included. Callers that need `https://host:port/path`
///! resolve host and scheme themselves until a URL parsing module is
///! available.

namespace std::net::http::client;

import core::intrinsics;
import core::option;
import core::result;
import core::slice;
import io::error;
import io::traits;
import collections::array;
import collections::str;
import collections::string;
import core::primitives;
import net::socket_addr;
import net::tcp;
import net::http::method;
import net::http::request;
import net::http::response;
import net::http::headers;

type struct Client {
    static new() -> Client {
        return Client { };
    }

    /// `GET addr/path`. Sets Host to `addr`'s address:port.
    get(&this, addr: SocketAddr, path: Str) -> Result<Response, IoError> {
        mut req: Request = Request::new(Method::Get, path);
        apply_host_header(&req, &addr);
        return send(addr, req);
    }

    /// `POST addr/path` with body bytes. Sets Host and passes the
    /// supplied Content-Type through unchanged; if the caller didn't
    /// set one, the server may fall back to octet-stream.
    post(&this,
         addr: SocketAddr,
         path: Str,
         content_type: Str,
         body: Array<u8>) -> Result<Response, IoError> {
        mut req: Request = Request::new(Method::Post, path);
        apply_host_header(&req, &addr);
        req.headers.insert(
            Str::new("Content-Type"),
            content_type
        );
        req.set_body(body);
        return send(addr, req);
    }
}

/// Open a connection, write the request, parse one response, close.
/// Emits `Connection: close` (RFC 7230 section 6.1) so the server knows this
/// is a one-shot exchange and can free its half of the socket as soon
/// as the response is written.  Without this header, servers that
/// default to HTTP/1.1 keep-alive will sit holding the connection open
/// until their idle timeout fires.
function send(addr: SocketAddr, req: Request) -> Result<Response, IoError> {
    mut request_local: Request = req;
    request_local.headers.insert(
        Str::new("Connection"),
        Str::new("close")
    );
    mut s: TcpStream = TcpStream::connect(addr)?;
    request_local.write_to(&s)?;
    match (s.shutdown_write()) {
        Result::Ok(_) => { }
        Result::Err(_) => { }
    }
    return Response::parse(&s);
}

/// Write `host: ip:port` into the request headers. Rendered in
/// `a.b.c.d:port` form because that's what we can produce without a
/// real display-formatter for IpAddr yet.
function apply_host_header(req: mut &Request, addr: &SocketAddr) -> void {
    mut buffer: String = String::with_capacity(32);
    match (addr.ip) {
        IpAddr::V4(v4) => {
            push_u8_decimal(&buffer, v4.a);
            buffer.push_byte(0x2E);
            push_u8_decimal(&buffer, v4.b);
            buffer.push_byte(0x2E);
            push_u8_decimal(&buffer, v4.c);
            buffer.push_byte(0x2E);
            push_u8_decimal(&buffer, v4.d);
        }
        IpAddr::V6(_) => {
            // IPv6 display formatting is not yet implemented;
            // emit a placeholder so the
            // header is well-formed and the server doesn't reject
            // the request on missing Host.
            buffer.push_str(Str::new("::"));
        }
    }
    buffer.push_byte(0x3A);
    push_u16_decimal(&buffer, addr.port);
    req.headers.insert(Str::new("Host"), buffer.as_str());
}

function push_u8_decimal(buffer: mut &String, value: u8) -> void {
    mut temp: u8[4];
    const v: u64 = value as u64;
    const digits: u64 = v.to_decimal_buf(&temp[0]);
    mut i: u64 = 0;
    while (i < digits) {
        buffer.push_byte(temp[i]);
        i++;
    }
}

function push_u16_decimal(buffer: mut &String, value: u16) -> void {
    mut temp: u8[8];
    const v: u64 = value as u64;
    const digits: u64 = v.to_decimal_buf(&temp[0]);
    mut i: u64 = 0;
    while (i < digits) {
        buffer.push_byte(temp[i]);
        i++;
    }
}
