///! HTTP client: simple one-shot requests over plain TCP.
///!
///! Opens a fresh connection, sends the request, reads one response,
///! closes. Keep-alive, connection pooling, retries, and redirect
///! following are caller concerns on top.
///!
///! The client takes a `SocketAddr` and a path directly; there's no
///! URL parser included. Callers that need `https://host:port/path`
///! resolve host and scheme themselves until a URL parsing module is
///! available.

namespace std::net::http::client;

import core::intrinsics;
import core::option;
import core::result;
import core::slice;
import io::error;
import io::traits;
import io::buf;
import collections::array;
import collections::str;
import collections::string;
import core::primitives;
import net::ip;
import net::socket_addr;
import net::tcp;
import net::http::method;
import net::http::request;
import net::http::response;
import net::http::headers;

type struct Client {
    static new() -> Client {
        return Client { };
    }

    /// `GET addr/path`. Sets Host to `addr`'s address:port.
    get(&this, addr: SocketAddr, path: Str) -> Result<Response, IoError> {
        mut req: Request = Request::new(Method::Get, path);
        apply_host_header(&req, &addr);
        return send(addr, req);
    }

    /// `POST addr/path` with body bytes. Sets Host and passes the
    /// supplied Content-Type through unchanged; if the caller didn't
    /// set one, the server may fall back to octet-stream.
    post(&this,
         addr: SocketAddr,
         path: Str,
         content_type: Str,
         body: Array<u8>) -> Result<Response, IoError> {
        mut req: Request = Request::new(Method::Post, path);
        apply_host_header(&req, &addr);
        req.headers.insert(
            Str::new("Content-Type"),
            content_type
        );
        req.set_body(body);
        return send(addr, req);
    }
}

/// Open a connection, write the request, parse one response, close.
/// Emits `Connection: close` (RFC 7230 section 6.1) so the server knows this
/// is a one-shot exchange and can free its half of the socket as soon
/// as the response is written.  Without this header, servers that
/// default to HTTP/1.1 keep-alive will sit holding the connection open
/// until their idle timeout fires.
function send(addr: SocketAddr, req: Request) -> Result<Response, IoError> {
    mut request_local: Request = req;
    request_local.headers.insert(
        Str::new("Connection"),
        Str::new("close")
    );
    mut s: TcpStream = TcpStream::connect(addr)?;
    request_local.write_to(&s)?;
    match (s.shutdown_write()) {
        Result::Ok(_) => { }
        Result::Err(_) => { }
    }
    // Buffer the response read: header scanning and the Content-Length
    // body both pull through one buffer, so a typical response costs a
    // few syscalls instead of one per header byte. `br` borrows `s`
    // (frees only its own buffer on drop); `s` is closed by its own Drop.
    mut br: BufReader<TcpStream> = BufReader::new(&s);
    return Response::parse(&br);
}

/// Send a request over an already-established stream and parse one
/// response. Generic over any `Read + Write` transport, so it serves
/// both plain `TcpStream` and `TlsStream` (the HTTPS path in
/// `net::https`). Adds `Connection: close` for the same one-shot reason
/// as `send`; the caller owns the stream and closes it afterward.
function send_over<S>(stream: S*, req: Request) -> Result<Response, IoError>
where S: Read + Write {
    mut request_local: Request = req;
    request_local.headers.insert(
        Str::new("Connection"),
        Str::new("close")
    );
    request_local.write_to(stream)?;
    // Buffer the response read so header scanning and the Content-Length
    // body pull through one buffer. `br` borrows `stream` and frees only
    // its own buffer on drop; the stream is the caller's to close.
    mut br: BufReader<S> = BufReader::new(stream);
    return Response::parse(&br);
}

/// Write `host: ip:port` into the request headers. IPv4 renders as
/// `a.b.c.d:port`; an IPv6 literal is bracketed per RFC 3986: `[h:h:...]:port`.
function apply_host_header(req: mut &Request, addr: &SocketAddr) -> void {
    mut buffer: String = String::with_capacity(48);
    match (addr.ip) {
        IpAddr::V4(v4) => {
            push_u8_decimal(&buffer, v4.a);
            buffer.push(0x2E);
            push_u8_decimal(&buffer, v4.b);
            buffer.push(0x2E);
            push_u8_decimal(&buffer, v4.c);
            buffer.push(0x2E);
            push_u8_decimal(&buffer, v4.d);
            buffer.push(0x3A);
            push_u16_decimal(&buffer, addr.port);
        }
        IpAddr::V6(v6) => {
            // RFC 3986: bracket the literal, with `:port` outside the brackets.
            buffer.push(0x5B);                  // '['
            push_v6_hextets(&buffer, &v6);
            buffer.push(0x5D);                  // ']'
            buffer.push(0x3A);
            push_u16_decimal(&buffer, addr.port);
        }
    }
    req.headers.insert(Str::new("Host"), buffer.as_str());
}

/// Eight colon-separated lowercase hex groups, no `::` compression (the
/// uncompressed form is valid inside a bracketed Host).
function push_v6_hextets(buffer: mut &String, v6: &IpV6Addr) -> void {
    mut g: u64 = 0;
    while (g < 8) {
        if (g > 0) { buffer.push(0x3A); }       // ':'
        push_u16_hex(buffer, v6.group_at(g));
        g = g + 1;
    }
}

/// Lowercase hex of `value`, no leading zeros (at least one digit).
function push_u16_hex(buffer: mut &String, value: u16) -> void {
    if (value == 0u16) { buffer.push(0x30); return; }
    mut tmp: u8[4];
    mut n: u64 = 0;
    mut v: u16 = value;
    while (v > 0u16) {
        const nib: u8 = (v & 0xF) as u8;
        if (nib < 10u8) { tmp[n] = 0x30u8 + nib; }
        else { tmp[n] = 0x61u8 + (nib - 10u8); }
        n = n + 1;
        v = v >> 4;
    }
    mut i: u64 = n;
    while (i > 0) { i = i - 1; buffer.push(tmp[i]); }
}

function push_u8_decimal(buffer: mut &String, value: u8) -> void {
    mut temp: u8[4];
    const v: u64 = value as u64;
    const digits: u64 = v.to_decimal_buf(&temp[0]);
    mut i: u64 = 0;
    while (i < digits) {
        buffer.push(temp[i]);
        i++;
    }
}

function push_u16_decimal(buffer: mut &String, value: u16) -> void {
    mut temp: u8[8];
    const v: u64 = value as u64;
    const digits: u64 = v.to_decimal_buf(&temp[0]);
    mut i: u64 = 0;
    while (i < digits) {
        buffer.push(temp[i]);
        i++;
    }
}
