///! HTTP client: simple one-shot requests over plain TCP.
///!
///! Opens a fresh connection, sends the request, reads one response,
///! closes. Keep-alive, connection pooling, retries, and redirect
///! following are caller concerns on top.
///!
///! The client takes a `SocketAddr` and a path directly; there's no
///! URL parser included. Callers that need `https://host:port/path`
///! resolve host and scheme themselves until a URL parsing module is
///! available.

namespace std::net::http::client;

import std::core::intrinsics;
import std::core::option;
import std::core::result::{ Result };
import std::core::slice;
import std::io::error::{ IoError };
import std::io::traits;
import std::io::buf::{ BufStream };
import std::collections::array::{ Array };
import std::collections::str::{ Str };
import std::collections::string::{ String };
import std::core::primitives;
import std::net::addr::socket_addr::{ SocketAddr };
import std::net::socket::tcp::{ TcpConnect, TcpStream };
import std::net::http::method::{ Method };
import std::net::http::request::{ Request };
import std::net::http::response::{ Response };
import std::net::http::headers;
import std::net::http::conn;
import std::future::poll;
import std::future::waker;
import std::future::traits;

public type struct Client {
    public static new() -> Client {
        return Client { };
    }

    /// `GET addr/path`. Sets Host to `addr`'s address:port.
    public async get(&this, addr: SocketAddr, path: Str) -> Result<Response, IoError> {
        mut req: Request = Request::new(Method::Get, path);
        const host: String = f"{addr}";
        req.headers.insert(Str::new("Host"), host.as_str());
        return await send(addr, req);
    }

    /// `POST addr/path` with body bytes. Sets Host and passes the
    /// supplied Content-Type through unchanged; if the caller didn't
    /// set one, the server may fall back to octet-stream.
    public async post(&this,
               addr: SocketAddr,
               path: Str,
               content_type: Str,
               body: Array<u8>) -> Result<Response, IoError> {
        mut req: Request = Request::new(Method::Post, path);
        const host: String = f"{addr}";
        req.headers.insert(Str::new("Host"), host.as_str());
        req.headers.insert(
            Str::new("Content-Type"),
            content_type
        );
        req.set_body(body);
        return await send(addr, req);
    }
}

/// Open a connection, send the request, read one response, close.
/// Emits `Connection: close` (RFC 7230 section 6.1) so the server knows this
/// is a one-shot exchange and can free its half of the socket as soon
/// as the response is written.  Without this header, servers that
/// default to HTTP/1.1 keep-alive will sit holding the connection open
/// until their idle timeout fires.
///
/// The whole request is encoded into the connection's outgoing buffer
/// first and flushed once, so sending costs one suspension however many
/// headers it carries. The response then comes back through the SAME
/// buffer that the flush drained, which is what lets the header block
/// and a Content-Length body be read without losing bytes that arrived
/// in the same fill.
public async function send(addr: SocketAddr, req: Request) -> Result<Response, IoError> {
    mut request_local: Request = req;
    request_local.headers.insert(
        Str::new("Connection"),
        Str::new("close")
    );

    mut sock: TcpStream = (await TcpConnect::start(addr))?;
    mut c: BufStream<TcpStream> = BufStream::<TcpStream>::of(sock);

    request_local.encode_into(c.pending())?;
    (await c.flush())?;
    // Half-close so a server that reads to EOF sees the request end.
    // Not required for a Content-Length-framed request, and a failure
    // here is not one the caller can act on: the bytes are already sent.
    match (c.transport().shutdown_write()) {
        Result::Ok(_) => { }
        Result::Err(_) => { }
    }

    return await c.read_response();
}

