///! HTTP headers: case-insensitive name/value map.
///!
///! Names are canonicalized to lowercase on insert so case-insensitive
///! lookup is just `HashMap::get` with a lowercase key. Values are
///! stored verbatim; folding, whitespace collapsing, and multi-value
///! comma-splitting are caller concerns.

namespace std::net::http::headers;

import core::intrinsics;
import core::drop;
import core::option;
import core::result;
import core::hash;
import core::cmp;
import core::slice;
import io::error;
import io::traits;
import collections::str;
import collections::string;
import collections::hashmap;
import collections::array;
import core::convert;
import core::primitives;

type struct Headers {
    inner: HashMap<String, String>;

    static new() -> Headers {
        return Headers { inner: HashMap::new() };
    }

    length(&this) -> u64 {
        return this.inner.length();
    }

    is_empty(&this) -> boolean {
        return this.inner.is_empty();
    }

    /// Insert or replace. Name is normalized to lowercase; CR/LF bytes are
    /// stripped from both name and value before storing. Ownership of both
    /// values transfers to the headers map.
    ///
    /// The strip is a header-injection defense: `write_to` re-emits every
    /// entry verbatim as `name: value\r\n`, so an embedded CRLF in a
    /// caller-supplied value (e.g. a `Content-Type`) or an HTTP/2-decoded
    /// header folded into an HTTP/1 response would split the message
    /// (request smuggling / response splitting). Request-line parsing is
    /// already CRLF-safe (the line is CRLF-delimited), so this is a no-op
    /// there.
    insert(mut &this, name: Str, value: Str) -> void {
        mut clean_name: String = strip_crlf(name);
        mut key: String = clean_name.as_str().to_ascii_lowercase();
        clean_name.drop();
        mut val: String = strip_crlf(value);
        this.inner.insert(key, val);
    }

    /// Case-insensitive lookup. Returns a deep-cloned owned copy of the
    /// stored value (header values are small, so copy-on-read is cheap),
    /// so the caller owns it independently of the map and must drop it.
    get(&this, name: Str) -> Option<String> {
        mut key: String = name.to_ascii_lowercase();
        // Borrow the stored value, then clone its bytes into a fresh
        // String. A bitwise `HashMap::get` here would alias the map's
        // heap buffer and double-free.
        match (this.inner.get_ref(&key)) {
            Option::Some(stored) => {
                return Option::Some(String::from_str((*stored).as_str()));
            }
            Option::None => { return Option::None; }
        }
    }

    contains(&this, name: Str) -> boolean {
        mut key: String = name.to_ascii_lowercase();
        return this.inner.contains_key(&key);
    }

    remove(mut &this, name: Str) -> boolean {
        mut key: String = name.to_ascii_lowercase();
        // `HashMap::remove` calls `K::drop()` on the stored key via the
        // `where K: Drop` bound; our local probe key + the popped value
        // are released by drop synthesis at scope exit.
        match (this.inner.remove(&key)) {
            Option::Some(mut value) => { return true; }
            Option::None => { return false; }
        }
    }

    /// Parse a single `Name: Value` header line (no CRLF). Used by
    /// the request parser. Returns `None` on malformed input; the
    /// caller turns that into a 400.
    parse_line(mut &this, line: Str) -> boolean {
        mut colon: u64 = line.length();
        mut i: u64 = 0;
        while (i < line.length()) {
            match (line.byte_at(i)) {
                Option::Some(byte) => {
                    if (byte == 0x3A) { colon = i; break; }
                }
                Option::None => { return false; }
            }
            i++;
        }
        if (colon == line.length()) { return false; }
        const name_part: Str = line.sub_bytes(0, colon);
        // Skip any leading whitespace in the value.
        mut start: u64 = colon + 1;
        while (start < line.length()) {
            match (line.byte_at(start)) {
                Option::Some(byte) => {
                    if (byte != 0x20 && byte != 0x09) { break; }
                }
                Option::None => { return false; }
            }
            start = start + 1;
        }
        const value_part: Str = line.sub_bytes(start, line.length());
        this.insert(name_part, value_part);
        return true;
    }

    /// Content-Length as a number. `Ok(None)` means the header is
    /// absent, which for this parser means "no body". A present but
    /// non-numeric value is `InvalidData` rather than a silent `None`:
    /// a peer that sends `Content-Length: abc` has framed the message
    /// wrongly, and guessing at zero would leave its body bytes in the
    /// buffer to be read as the next message.
    ///
    /// The caller applies its own ceiling; the two directions cap the
    /// body independently.
    content_length(&this) -> Result<Option<u64>, IoError> {
        match (this.get(Str::new("content-length"))) {
            Option::Some(mut value) => {
                match (u64::try_from(value.as_str())) {
                    Result::Ok(len) => { return Result::Ok(Option::Some(len)); }
                    Result::Err(_)  => {
                        return Result::Err(IoError::new(IoErrorKind::InvalidData, 0));
                    }
                }
            }
            Option::None => { return Result::Ok(Option::None); }
        }
    }

    /// Append every stored header to `out` as HTTP/1.1 field lines,
    /// `name: value\r\n` per entry. The caller appends the trailing
    /// blank-line CRLF that separates headers from the message body.
    ///
    /// Synchronous, and that is the point: a message is built into the
    /// connection's outgoing buffer with no suspension point anywhere
    /// inside it, so the layer above suspends exactly once, in `flush`.
    encode_into(&this, out: Array<u8>*) -> Result<(), IoError> {
        const colon_sp: Slice<u8> = Slice::from_raw(": ", 2);
        const crlf: Slice<u8> = Slice::from_raw("\r\n", 2);
        const count: u64 = this.inner.bucket_count();
        mut i: u64 = 0;
        while (i < count) {
            mut node: hashmap::Entry<String, String>* = this.inner.get_bucket(i);
            loop {
                if (node == null) { break; }
                push_all(out, node.key.as_bytes())?;
                push_all(out, colon_sp)?;
                push_all(out, node.value.as_bytes())?;
                push_all(out, crlf)?;
                node = node.next;
            }
            i++;
        }
        return Result::Ok(());
    }

}

/// Append `bytes` to `out`, reporting a failed grow as `OutOfMemory`.
///
/// Every HTTP message encoder builds into a caller-supplied `Array<u8>`
/// — normally the connection's `pending()` buffer — so this one-line
/// translation from the allocator's error to `IoError` is shared by all
/// of them rather than restated at each of the couple of dozen appends.
function push_all(out: Array<u8>*, bytes: Slice<u8>) -> Result<(), IoError> {
    match (out.try_append(bytes)) {
        Result::Ok(_)  => { return Result::Ok(()); }
        Result::Err(_) => {
            return Result::Err(IoError::new(IoErrorKind::OutOfMemory, 0));
        }
    }
}

/// Copy `s` into a fresh String with CR (0x0D) and LF (0x0A) bytes removed.
/// See `Headers::insert` for why header names/values must never carry an
/// embedded line terminator.
function strip_crlf(s: Str) -> String {
    mut out: String = String::with_capacity(s.length());
    mut i: u64 = 0;
    while (i < s.length()) {
        match (s.byte_at(i)) {
            Option::Some(b) => {
                if (b != 0x0D && b != 0x0A) { out.push_byte(b); }
            }
            Option::None => { }
        }
        i = i + 1;
    }
    return out;
}

/// Drop every stored header.  `HashMap::drop` requires `K: Drop,
/// V: Drop` and calls `K::drop()` / `V::drop()` on every entry, so
/// each stored `String` key and value is reclaimed automatically.
implement trait Drop for struct Headers {
    drop(mut &this) -> void {
        this.inner.drop();
    }
}
