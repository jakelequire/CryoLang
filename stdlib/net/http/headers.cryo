///! HTTP headers: an ordered list of name/value fields.
///!
///! A name may appear more than once (`Set-Cookie` does, routinely), so the
///! fields are kept in the order they arrived or were added, repeats and
///! all. Names are compared without regard to ASCII case and stored in
///! lowercase; values are stored verbatim.
///!
///! ```cryo
///! import std::collections::str::{ Str };
///! import std::net::http::headers::{ Headers };
///!
///! mut headers: Headers = Headers::new();
///! headers.append(Str::new("Set-Cookie"), Str::new("a=1"));
///! headers.append(Str::new("Set-Cookie"), Str::new("b=2"));
///! for (cookie in headers.get_all(Str::new("set-cookie"))) { /* a=1, then b=2 */ }
///! ```

namespace std::net::http::headers;

import std::core::drop::{ Drop };
import std::core::option::{ Option };
import std::core::result::{ Result };
import std::core::slice::{ Slice };
import std::io::error::{ IoError, IoErrorKind };
import std::collections::str::{ Str };
import std::collections::string::{ String };
import std::collections::pair::{ Pair };
import std::core::iter::{ Iterator };
import std::collections::array::{ Array };
import std::core::primitives;

/// One header field: its lowercase name and its value.
private type struct HeaderField with [Clone] {
    private name: String;
    private value: String;
}

public type struct Headers with [Clone] {
    private fields: Array<HeaderField>;

    public static new() -> Headers {
        return Headers { fields: Array::new() };
    }

    /// The number of fields, a repeated name counted once per value.
    ![inline]
    public length(&this) -> i64 {
        return this.fields.length();
    }

    public is_empty(&this) -> boolean {
        return this.fields.is_empty();
    }

    /// Every field by shared borrow, in order, yielding the lowercase name
    /// and the value as stored. The pointers borrow the headers' own
    /// storage and are invalidated by any `append`, `insert` or `remove`.
    public entries(&this) -> implement Iterator<Pair<String*, String*>> {
        return HeaderEntries { fields: &this.fields, index: 0 };
    }

    /// Add `name: value` after the fields already present, keeping any
    /// earlier values of the same name. The name is stored in lowercase;
    /// CR and LF bytes are stripped from both before storing.
    ///
    /// The strip is a header-injection defense: `encode_into` re-emits every
    /// field verbatim as `name: value\r\n`, so an embedded CRLF in a
    /// caller-supplied value (e.g. a `Content-Type`) or an HTTP/2-decoded
    /// header folded into an HTTP/1 response would split the message
    /// (request smuggling / response splitting). Request-line parsing is
    /// already CRLF-safe (the line is CRLF-delimited), so this is a no-op
    /// there.
    public append(mut &this, name: Str, value: Str) -> void {
        const clean_name: String = strip_crlf(name);
        this.fields.push(HeaderField {
            name: clean_name.as_str().to_ascii_lowercase(),
            value: strip_crlf(value)
        });
    }

    /// Set `name` to `value` alone: every earlier value of the name is
    /// removed, then the field is appended.
    public insert(mut &this, name: Str, value: Str) -> void {
        this.remove(name);
        this.append(name, value);
    }

    /// The first value of `name`, compared without regard to case. The
    /// view borrows the headers' storage and is invalidated by any
    /// `append`, `insert` or `remove`.
    public get(&this, name: Str) -> Option<Str> {
        for (field in this.fields.iter_ref()) {
            if (field.name.as_str().equals_case_insensitive(&name)) {
                return Option::Some(field.value.as_str());
            }
        }
        return Option::None;
    }

    /// Every value of `name`, in order, compared without regard to case.
    /// The views borrow the headers' storage, as `get`'s does.
    public get_all(&this, name: Str) -> implement Iterator<Str> {
        return HeaderValues { fields: &this.fields, name: name, index: 0 };
    }

    public contains(&this, name: Str) -> boolean {
        return this.get(name).is_some();
    }

    /// Remove every value of `name`. True when there was one.
    public remove(mut &this, name: Str) -> boolean {
        const before: i64 = this.fields.length();
        this.fields.retain((field: &HeaderField) -> boolean {
            return !field.name.as_str().equals_case_insensitive(&name);
        });
        return this.fields.length() != before;
    }

    /// Parse a single `Name: Value` header line (no CRLF) and append it.
    /// Used by the request and response parsers. Returns `false` on
    /// malformed input; the caller turns that into a 400.
    public parse_line(mut &this, line: Str) -> boolean {
        match (line.split_once(&Str::new(":"))) {
            Option::Some(parts) => {
                this.append(parts.first, parts.second.trim_start());
                return true;
            }
            Option::None => { return false; }
        }
    }

    /// Content-Length as a number. `Ok(None)` means the header is absent.
    /// A value that is not a number is `InvalidData` rather than a silent
    /// `None`: a peer that sends `Content-Length: abc` has framed the
    /// message wrongly, and guessing at zero would leave its body bytes in
    /// the buffer to be read as the next message. Repeats of one value
    /// fold to it; two different values are `InvalidData`, since either
    /// reading would leave the peer and this parser disagreeing about
    /// where the message ends.
    ///
    /// The caller applies its own ceiling; the two directions cap the
    /// body independently.
    public content_length(&this) -> Result<Option<i64>, IoError> {
        mut found: Option<i64> = Option::None;
        for (value in this.get_all(Str::new("content-length"))) {
            mut length: i64 = 0;
            match (u64::try_from(value)) {
                Result::Ok(parsed) => {
                    if (parsed > i64::MAX as u64) {
                        return Result::Err(IoError::new(IoErrorKind::InvalidData, 0));
                    }
                    length = parsed as i64;
                }
                Result::Err(_) => { return Result::Err(IoError::new(IoErrorKind::InvalidData, 0)); }
            }
            match (found) {
                Option::Some(earlier) => {
                    if (earlier != length) {
                        return Result::Err(IoError::new(IoErrorKind::InvalidData, 0));
                    }
                }
                Option::None => { found = Option::Some(length); }
            }
        }
        return Result::Ok(found);
    }

    /// Append every field to `out` as HTTP/1.1 field lines, `name: value\r\n`
    /// each, in order. The caller appends the trailing blank-line CRLF that
    /// separates headers from the message body.
    ///
    /// Synchronous, and that is the point: a message is built into the
    /// connection's outgoing buffer with no suspension point anywhere
    /// inside it, so the layer above suspends exactly once, in `flush`.
    public encode_into(&this, out: mut Array<u8>*) -> Result<(), IoError> {
        const colon_sp: &Slice<u8> = Slice::from_raw(": ", 2);
        const crlf: &Slice<u8> = Slice::from_raw("\r\n", 2);
        for (field in this.fields.iter_ref()) {
            out.try_append(field.name.as_bytes())?;
            out.try_append(colon_sp)?;
            out.try_append(field.value.as_bytes())?;
            out.try_append(crlf)?;
        }
        return Result::Ok(());
    }
}

/// Copy `s` into a fresh String with CR (0x0D) and LF (0x0A) bytes removed.
/// See `Headers::append` for why header names/values must never carry an
/// embedded line terminator.
private function strip_crlf(s: Str) -> String {
    mut out: String = String::with_capacity(s.length());
    for (byte in s.as_bytes().iter()) {
        if (byte != 0x0D && byte != 0x0A) { out.push_byte(byte); }
    }
    return out;
}

/// The cursor behind `Headers::entries`.
private type struct HeaderEntries {
    private fields: const Array<HeaderField>*;
    private index: i64;
}

implement trait Iterator<Pair<String*, String*>> for struct HeaderEntries {
    next(mut &this) -> Option<Pair<String*, String*>> {
        match (this.fields.get_ref(this.index)) {
            Option::Some(field) => {
                this.index = this.index + 1;
                return Option::Some(Pair::<String*, String*> { first: &field.name, second: &field.value });
            }
            Option::None => { return Option::None; }
        }
    }
}

/// The cursor behind `Headers::get_all`. `name` borrows the caller's text.
private type struct HeaderValues {
    private fields: const Array<HeaderField>*;
    private name: Str;
    private index: i64;
}

implement trait Iterator<Str> for struct HeaderValues {
    next(mut &this) -> Option<Str> {
        loop {
            match (this.fields.get_ref(this.index)) {
                Option::Some(field) => {
                    this.index = this.index + 1;
                    if (field.name.as_str().equals_case_insensitive(&this.name)) {
                        return Option::Some(field.value.as_str());
                    }
                }
                Option::None => { return Option::None; }
            }
        }
    }
}

implement trait Drop for struct Headers {
    drop(mut &this) -> void { }
}
