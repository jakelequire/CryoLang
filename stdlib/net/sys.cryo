///! net::sys: per-OS socket primitives behind a uniform interface.
///!
///! POSIX BSD sockets and Winsock are close but not identical: Winsock's
///! SOCKET is an opaque `u64` (not an int fd), its lengths are `int` (not
///! socklen_t/ssize_t), its `SO_*`/`SOL_SOCKET` constants have different
///! numeric values, `SO_RCVTIMEO`/`SO_SNDTIMEO` take a DWORD of milliseconds
///! (not a `struct timeval`), errors come from `WSAGetLastError()` (not
///! errno), close is `closesocket`, and it needs a one-time `WSAStartup`.
///!
///! Every one of those differences is hidden here so `net::socket::tcp` / `net::socket::udp`
///! / `net::dns` stay platform-agnostic.  Sockets are exposed as a plain
///! `i32` fd on both platforms: SOCKET values fit `i32` in practice (and
///! under wine), and these wrappers cast at the boundary.  ConfigGating only
///! sees file-scope declarations, so the divergence lives in these gated
///! free functions.

namespace std::net::sys;

import core::result;
import io::error;
import io::fd;
import ffi::libc;
import sys::syscall;

// ---- one-time Winsock init -------------------------------------------------
// WSAStartup is reference-counted and idempotent, so calling it once per
// socket creation is harmless (we never WSACleanup; Winsock stays loaded for
// the process lifetime, which is what a long-lived server wants anyway).
![target(unix)]
function net_init() -> void { }
![target(windows)]
function net_init() -> void {
    mut wsadata: u8[512];                       // >= sizeof(WSADATA)
    syscall::WSAStartup(0x0202u16, &wsadata[0]); // request Winsock 2.2
}

// ---- socket creation -------------------------------------------------------
// AF_INET=2, SOCK_STREAM=1, SOCK_DGRAM=2, IPPROTO_TCP=6, IPPROTO_UDP=17 on
// both platforms.  POSIX adds SOCK_CLOEXEC so a concurrent fork+exec doesn't
// leak the fd; Windows handles are non-inheritable by default, so no flag.
![target(unix)]
function os_socket_tcp() -> i32 {
    return libc::socket(libc::AddressFamily::AF_INET,
                        libc::SOCK_STREAM | libc::SOCK_CLOEXEC,
                        libc::Protocol::IPPROTO_IP);
}
![target(windows)]
function os_socket_tcp() -> i32 {
    net_init();
    const s: u64 = syscall::socket(2, 1, 0);
    if (s == syscall::INVALID_SOCKET) { return -1; }
    return s as i32;
}

// AF_INET6 TCP socket (family 10 on Linux, 23 on Windows). The caller
// (net::socket::tcp) selects this vs os_socket_tcp() per the address family, so
// sys stays free of net::ip / net::socket_addr imports.
![target(unix)]
function os_socket_tcp6() -> i32 {
    return libc::socket(libc::AddressFamily::AF_INET6,
                        libc::SOCK_STREAM | libc::SOCK_CLOEXEC,
                        libc::Protocol::IPPROTO_IP);
}
![target(windows)]
function os_socket_tcp6() -> i32 {
    net_init();
    const s: u64 = syscall::socket(23, 1, 0);
    if (s == syscall::INVALID_SOCKET) { return -1; }
    return s as i32;
}

![target(unix)]
function os_socket_udp() -> i32 {
    return libc::socket(libc::AddressFamily::AF_INET,
                        libc::SOCK_DGRAM | libc::SOCK_CLOEXEC,
                        libc::Protocol::IPPROTO_UDP);
}
![target(windows)]
function os_socket_udp() -> i32 {
    net_init();
    const s: u64 = syscall::socket(2, 2, 17);
    if (s == syscall::INVALID_SOCKET) { return -1; }
    return s as i32;
}

// ---- connection setup ------------------------------------------------------
![target(unix)]
function os_connect(fd: i32, addr: u8*, len: u32) -> i32 { return libc::connect(fd, addr, len); }
![target(windows)]
function os_connect(fd: i32, addr: u8*, len: u32) -> i32 { return syscall::connect(fd as u64, addr, len as i32); }

![target(unix)]
function os_bind(fd: i32, addr: u8*, len: u32) -> i32 { return libc::bind(fd, addr, len); }
![target(windows)]
function os_bind(fd: i32, addr: u8*, len: u32) -> i32 { return syscall::bind(fd as u64, addr, len as i32); }

![target(unix)]
function os_listen(fd: i32, backlog: i32) -> i32 { return libc::listen(fd, backlog); }
![target(windows)]
function os_listen(fd: i32, backlog: i32) -> i32 { return syscall::listen(fd as u64, backlog); }

// Returns the accepted fd, or -1 on error.
![target(unix)]
function os_accept(fd: i32, addr: u8*, addrlen: u32*) -> i32 {
    return libc::accept4(fd, addr, addrlen, libc::SOCK_CLOEXEC);
}
![target(windows)]
function os_accept(fd: i32, addr: u8*, addrlen: u32*) -> i32 {
    const s: u64 = syscall::accept(fd as u64, addr, addrlen as i32*);
    if (s == syscall::INVALID_SOCKET) { return -1; }
    return s as i32;
}

![target(unix)]
function os_getsockname(fd: i32, addr: u8*, addrlen: u32*) -> i32 { return libc::getsockname(fd, addr, addrlen); }
![target(windows)]
function os_getsockname(fd: i32, addr: u8*, addrlen: u32*) -> i32 { return syscall::getsockname(fd as u64, addr, addrlen as i32*); }

// SHUT_RD=0 / SHUT_WR=1 / SHUT_RDWR=2 match SD_RECEIVE/SD_SEND/SD_BOTH.
![target(unix)]
function os_shutdown(fd: i32, how: i32) -> i32 { return libc::shutdown(fd, how as libc::ShutdownHow); }
![target(windows)]
function os_shutdown(fd: i32, how: i32) -> i32 { return syscall::shutdown(fd as u64, how); }

// ---- data transfer ---------------------------------------------------------
![target(unix)]
function os_send(fd: i32, buf: u8*, len: u64) -> i64 { return libc::send(fd, buf, len, 0); }
![target(windows)]
function os_send(fd: i32, buf: u8*, len: u64) -> i64 { return syscall::send(fd as u64, buf, len as i32, 0) as i64; }

![target(unix)]
function os_recv(fd: i32, buf: u8*, len: u64) -> i64 { return libc::recv(fd, buf, len, 0); }
![target(windows)]
function os_recv(fd: i32, buf: u8*, len: u64) -> i64 { return syscall::recv(fd as u64, buf, len as i32, 0) as i64; }

![target(unix)]
function os_sendto(fd: i32, buf: u8*, len: u64, addr: u8*, addrlen: u32) -> i64 {
    return libc::sendto(fd, buf, len, 0, addr, addrlen);
}
![target(windows)]
function os_sendto(fd: i32, buf: u8*, len: u64, addr: u8*, addrlen: u32) -> i64 {
    return syscall::sendto(fd as u64, buf, len as i32, 0, addr, addrlen as i32) as i64;
}

![target(unix)]
function os_recvfrom(fd: i32, buf: u8*, len: u64, addr: u8*, addrlen: u32*) -> i64 {
    return libc::recvfrom(fd, buf, len, 0, addr, addrlen);
}
![target(windows)]
function os_recvfrom(fd: i32, buf: u8*, len: u64, addr: u8*, addrlen: u32*) -> i64 {
    return syscall::recvfrom(fd as u64, buf, len as i32, 0, addr, addrlen as i32*) as i64;
}

// ---- close -----------------------------------------------------------------
![target(unix)]
function os_close_sock(fd: i32) -> void { fd::close_fd(fd); }
![target(windows)]
function os_close_sock(fd: i32) -> void { syscall::closesocket(fd as u64); }

// ---- socket options (semantic; the SO_* constants differ per OS) -----------
// SOL_SOCKET: 1 (POSIX) vs 0xFFFF (Winsock); SO_REUSEADDR 2 vs 4;
// SO_BROADCAST 6 vs 32; SO_RCVTIMEO 20 vs 0x1006; SO_SNDTIMEO 21 vs 0x1005.
![target(unix)]
function os_set_reuseaddr(fd: i32) -> i32 {
    mut one: i32 = 1;
    return libc::setsockopt(fd, libc::SocketLevel::SOL_SOCKET, libc::SO_REUSEADDR, &one as u8*, 4);
}
![target(windows)]
function os_set_reuseaddr(fd: i32) -> i32 {
    mut one: i32 = 1;
    return syscall::setsockopt(fd as u64, 65535, 4, &one as u8*, 4);
}

![target(unix)]
function os_set_broadcast(fd: i32, on: boolean) -> i32 {
    mut v: i32 = if (on) { 1 } else { 0 };
    return libc::setsockopt(fd, libc::SocketLevel::SOL_SOCKET, libc::SO_BROADCAST, &v as u8*, 4);
}
![target(windows)]
function os_set_broadcast(fd: i32, on: boolean) -> i32 {
    mut v: i32 = if (on) { 1 } else { 0 };
    return syscall::setsockopt(fd as u64, 65535, 32, &v as u8*, 4);
}

// ---- non-blocking mode + in-flight connect status --------------------------
// Async I/O needs sockets that report "would block" instead of sleeping the
// calling thread: the reactor does the waiting. POSIX toggles a file-status
// flag; Winsock has a dedicated ioctl and no way to read the mode back.

![target(unix)]
function os_set_nonblocking(fd: i32, on: boolean) -> i32 {
    const cur: i32 = libc::fcntl(fd, libc::F_GETFL, 0 as i64);
    if (cur < 0) { return -1; }
    const next: i32 = if (on) { cur | libc::O_NONBLOCK } else { cur & ~libc::O_NONBLOCK };
    return libc::fcntl(fd, libc::F_SETFL, next as i64);
}
![target(windows)]
function os_set_nonblocking(fd: i32, on: boolean) -> i32 {
    mut v: u32 = if (on) { 1 } else { 0 };
    return syscall::ioctlsocket(fd as u64, syscall::FIONBIO, &v);
}

/// How an in-flight non-blocking connect is progressing. `Failed` carries the
/// error the caller should surface; the socket is left open either way, so the
/// caller owns closing it.
type enum ConnectStatus {
    Connected;
    Pending;
    Failed(IoError);
}

/// Ask an in-flight non-blocking connect how it went, without blocking.
///
/// POSIX answers by re-issuing the `connect`: it reports `EISCONN` once the
/// handshake lands, `EINPROGRESS`/`EALREADY` while it is outstanding, and the
/// real failure otherwise, so the packed sockaddr is replayed here.
![target(unix)]
function os_connect_status(fd: i32, addr: u8*, addrlen: u32) -> ConnectStatus {
    if (os_connect(fd, addr, addrlen) >= 0) { return ConnectStatus::Connected; }
    const e: IoError = last_io_error();
    if (e.os_code == libc::EISCONN) { return ConnectStatus::Connected; }
    if (e.os_code == libc::EINPROGRESS || e.os_code == libc::EALREADY) {
        return ConnectStatus::Pending;
    }
    match (e.kind) {
        IoErrorKind::Interrupted => { return ConnectStatus::Pending; }
        _                        => { }
    }
    return ConnectStatus::Failed(e);
}

/// Winsock cannot be asked the same way: a repeat `connect` on a socket whose
/// attempt already failed does not report that failure - it restarts the
/// attempt and clears the latched `SO_ERROR`, so a poll loop built on re-issuing
/// `connect` only ever sees WSAEWOULDBLOCK/WSAEALREADY and waits forever. The
/// status is read off the socket instead, leaving the attempt untouched:
/// `SO_ERROR` is the outcome once it is non-zero, and until then
/// `SO_CONNECT_TIME` distinguishes an established connection from one still in
/// flight (the socket never becomes writable when the peer refuses).
![target(windows)]
function os_connect_status(fd: i32, addr: u8*, addrlen: u32) -> ConnectStatus {
    const se: i32 = os_sock_error(fd);
    if (se > 0) { return ConnectStatus::Failed(io_error_from_wsa(se)); }
    if (os_sock_connected(fd)) { return ConnectStatus::Connected; }
    return ConnectStatus::Pending;
}

/// True once the handshake has completed. `SO_CONNECT_TIME` reads back
/// `SO_CONNECT_TIME_NEVER` until then; an unreadable option is reported as
/// not-yet-connected so the caller keeps waiting rather than inventing success.
![target(windows)]
function os_sock_connected(fd: i32) -> boolean {
    mut secs: u32 = 0;
    mut len: i32 = 4;
    if (syscall::getsockopt(fd as u64, syscall::SOL_SOCKET, syscall::SO_CONNECT_TIME,
                            &secs as u8*, &len) != 0) {
        return false;
    }
    return secs != syscall::SO_CONNECT_TIME_NEVER;
}

/// The latched error on `fd` (`SO_ERROR`): non-zero is a failed operation, zero
/// means nothing has failed *yet* - for a connect still in flight it is zero
/// too, so zero alone does not mean connected. Returns -1 if the option itself
/// could not be read.
![target(unix)]
function os_sock_error(fd: i32) -> i32 {
    mut v: i32 = 0;
    mut len: u32 = 4;
    if (libc::getsockopt(fd, libc::SocketLevel::SOL_SOCKET, libc::SO_ERROR,
                         &v as u8*, &len) != 0) {
        return -1;
    }
    return v;
}
![target(windows)]
function os_sock_error(fd: i32) -> i32 {
    mut v: i32 = 0;
    mut len: i32 = 4;
    if (syscall::getsockopt(fd as u64, syscall::SOL_SOCKET, syscall::SO_ERROR,
                            &v as u8*, &len) != 0) {
        return -1;
    }
    return v;
}

// SO_RCVTIMEO/SO_SNDTIMEO: POSIX wants a 16-byte `struct timeval` (two host-
// order i64s); Winsock wants a 4-byte DWORD of milliseconds.
![target(unix)]
function os_set_timeout(fd: i32, is_recv: boolean, secs: i64, usecs: i64) -> i32 {
    mut buf: u8[16];
    pack_i64_le(&buf[0], secs);
    pack_i64_le(&buf[8], usecs);
    const opt: i32 = if (is_recv) { libc::SO_RCVTIMEO } else { libc::SO_SNDTIMEO };
    return libc::setsockopt(fd, libc::SocketLevel::SOL_SOCKET, opt, &buf[0], 16);
}
![target(windows)]
function os_set_timeout(fd: i32, is_recv: boolean, secs: i64, usecs: i64) -> i32 {
    const ms: u32 = (secs * 1000 + usecs / 1000) as u32;
    mut buf: u8[4];
    buf[0] = (ms)       as u8;
    buf[1] = (ms >> 8)  as u8;
    buf[2] = (ms >> 16) as u8;
    buf[3] = (ms >> 24) as u8;
    const opt: i32 = if (is_recv) { 4102 } else { 4101 };   // 0x1006 / 0x1005
    return syscall::setsockopt(fd as u64, 65535, opt, &buf[0], 4);
}

// Little-endian pack of an i64 into 8 bytes (host order on the LE targets we
// support).  Local to net::sys so the timeout helpers don't pull in a higher
// layer.
function pack_i64_le(out: u8*, value: i64) -> void {
    const v: u64 = value as u64;
    out[0] = (v)       as u8;
    out[1] = (v >> 8)  as u8;
    out[2] = (v >> 16) as u8;
    out[3] = (v >> 24) as u8;
    out[4] = (v >> 32) as u8;
    out[5] = (v >> 40) as u8;
    out[6] = (v >> 48) as u8;
    out[7] = (v >> 56) as u8;
}

// ---- errors ----------------------------------------------------------------
// The last socket error as an IoError: errno on POSIX, WSAGetLastError on
// Windows (its WSAE* codes are mapped to the matching IoErrorKind; the rest
// fold to Other with the raw code preserved).
![target(unix)]
function last_io_error() -> IoError { return IoError::from_errno(libc::errno()); }
![target(windows)]
function last_io_error() -> IoError { return io_error_from_wsa(syscall::WSAGetLastError()); }

/// Classify a Winsock error code. Split from `last_io_error` because a connect
/// failure is read back from `SO_ERROR` rather than `WSAGetLastError()`, and
/// both paths must produce the same `IoErrorKind` for the same code.
![target(windows)]
function io_error_from_wsa(e: i32) -> IoError {
    if (e == syscall::WSAEWOULDBLOCK)  { return IoError::new(IoErrorKind::WouldBlock, e); }
    if (e == syscall::WSAEINTR)        { return IoError::new(IoErrorKind::Interrupted, e); }
    if (e == syscall::WSAECONNREFUSED) { return IoError::new(IoErrorKind::ConnectionRefused, e); }
    if (e == syscall::WSAECONNRESET)   { return IoError::new(IoErrorKind::ConnectionReset, e); }
    if (e == syscall::WSAECONNABORTED) { return IoError::new(IoErrorKind::ConnectionAborted, e); }
    if (e == syscall::WSAETIMEDOUT)    { return IoError::new(IoErrorKind::TimedOut, e); }
    if (e == syscall::WSAEADDRINUSE)   { return IoError::new(IoErrorKind::AddrInUse, e); }
    if (e == syscall::WSAENOTCONN)     { return IoError::new(IoErrorKind::NotConnected, e); }
    return IoError::new(IoErrorKind::Other, e);
}

// ---- name resolution -------------------------------------------------------
// getaddrinfo/freeaddrinfo exist on both (Winsock needs WSAStartup first).
![target(unix)]
function os_getaddrinfo(node: u8*, service: u8*, hints: u8*, res: u8**) -> i32 {
    return libc::getaddrinfo(node, service, hints, res);
}
![target(windows)]
function os_getaddrinfo(node: u8*, service: u8*, hints: u8*, res: u8**) -> i32 {
    net_init();
    return syscall::getaddrinfo(node, service, hints, res);
}

![target(unix)]
function os_freeaddrinfo(res: u8*) -> void { libc::freeaddrinfo(res); }
![target(windows)]
function os_freeaddrinfo(res: u8*) -> void { syscall::freeaddrinfo(res); }

// `struct addrinfo.ai_addr` sits at byte 24 on glibc but byte 32 on Windows
// (Windows orders ai_canonname before ai_addr).  net::dns reads ai_addr at
// this offset.  ai_family@4 and ai_next@40 match on both.
![target(linux)]
function ai_addr_offset() -> u64 { return 24; }
![target(windows)]
function ai_addr_offset() -> u64 { return 32; }

// ---- stream read/write (recv/send with EINTR retry) ------------------------
// Platform-agnostic: built on the gated os_recv/os_send + last_io_error.
// `net::socket::tcp`'s Read/Write impls delegate here (read()/write() on a CRT fd do
// NOT work on a Windows SOCKET, so sockets must go through recv/send on both
// platforms).
function sock_read(fd: i32, buf: u8*, len: u64) -> Result<u64, IoError> {
    loop {
        const n: i64 = os_recv(fd, buf, len);
        if (n >= 0) { return Result::Ok(n as u64); }
        const err: IoError = last_io_error();
        match (err.kind) {
            IoErrorKind::Interrupted => { }
            _ => { return Result::Err(err); }
        }
    }
}

function sock_write(fd: i32, buf: u8*, len: u64) -> Result<u64, IoError> {
    loop {
        const n: i64 = os_send(fd, buf, len);
        if (n >= 0) { return Result::Ok(n as u64); }
        const err: IoError = last_io_error();
        match (err.kind) {
            IoErrorKind::Interrupted => { }
            _ => { return Result::Err(err); }
        }
    }
}

// Apply a receive/send timeout, returning a Result (the raw helper returns an
// rc).  Shared by tcp/udp `set_*_timeout`.
function set_timeout(fd: i32, is_recv: boolean, secs: i64, usecs: i64) -> Result<(), IoError> {
    if (os_set_timeout(fd, is_recv, secs, usecs) < 0) {
        return Result::Err(last_io_error());
    }
    return Result::Ok(());
}

// getaddrinfo hint flags.  POSIX AI_ADDRCONFIG (skip families with no
// configured interface) is 0x20; the Windows value differs, so the Windows
// path passes 0 (standard resolution, all families) rather than risk a
// wrong flag bit.
![target(unix)]
function dns_hint_flags() -> u32 { return libc::AI_ADDRCONFIG as u32; }
![target(windows)]
function dns_hint_flags() -> u32 { return 0; }
