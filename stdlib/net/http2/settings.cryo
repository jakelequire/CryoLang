///! HTTP/2 SETTINGS parameters (RFC 7540 section 6.5).
///!
///! A SETTINGS frame payload is a sequence of 6-octet entries: a 16-bit
///! identifier followed by a 32-bit value. `Settings` holds the
///! parameters this stdlib cares about, seeded with the protocol
///! defaults; unknown identifiers are ignored on parse, as required.

namespace std::net::http2::settings;

import std::core::option::{ Option };
import std::core::slice::{ Slice };
import std::collections::array::{ Array };
import std::io::bytes::{ ByteReader, ByteWriter };

public const SETTINGS_HEADER_TABLE_SIZE:      u16 = 0x1;
public const SETTINGS_ENABLE_PUSH:            u16 = 0x2;
public const SETTINGS_MAX_CONCURRENT_STREAMS: u16 = 0x3;
public const SETTINGS_INITIAL_WINDOW_SIZE:    u16 = 0x4;
public const SETTINGS_MAX_FRAME_SIZE:         u16 = 0x5;
public const SETTINGS_MAX_HEADER_LIST_SIZE:   u16 = 0x6;

public type struct Settings {
    public header_table_size:      u32;
    public enable_push:            u32;
    public max_concurrent_streams: u32;
    public initial_window_size:    u32;
    public max_frame_size:         u32;
    public max_header_list_size:   u32;

    /// Protocol defaults (RFC 7540 section 6.5.2). "Unlimited" parameters use
    /// the u32 maximum as a sentinel.
    public static defaults() -> Settings {
        return Settings {
            header_table_size:      4096,
            enable_push:            1,
            max_concurrent_streams: u32::MAX,
            initial_window_size:    65535,
            max_frame_size:         16384,
            max_header_list_size:   u32::MAX
        };
    }

    /// Apply a single parsed (identifier, value). Unknown identifiers
    /// are ignored.
    public apply_one(mut &this, id: u16, value: u32) -> void {
        if (id == SETTINGS_HEADER_TABLE_SIZE)      { this.header_table_size = value; }
        else if (id == SETTINGS_ENABLE_PUSH)            { this.enable_push = value; }
        else if (id == SETTINGS_MAX_CONCURRENT_STREAMS) { this.max_concurrent_streams = value; }
        else if (id == SETTINGS_INITIAL_WINDOW_SIZE)    { this.initial_window_size = value; }
        else if (id == SETTINGS_MAX_FRAME_SIZE) {
            // RFC 7540 section 6.5.2: SETTINGS_MAX_FRAME_SIZE must be within
            // [2^14, 2^24-1] = [16384, 16777215]. A peer sending an
            // out-of-range value (e.g. 0) would otherwise be stored verbatim
            // and make send_body / send_header_block compute a zero per-frame
            // budget and loop forever -- a one-frame remote DoS. Reject the
            // bad value, keeping the last valid setting (the 16384 default).
            if (value >= 16384 && value <= 16777215) {
                this.max_frame_size = value;
            }
        }
        else if (id == SETTINGS_MAX_HEADER_LIST_SIZE)   { this.max_header_list_size = value; }
    }

    /// Parse a SETTINGS frame payload, applying every entry. Returns
    /// false if the payload length is not a multiple of 6.
    public apply_payload(mut &this, payload: Slice<u8>) -> boolean {
        if (payload.length() % 6 != 0) { return false; }
        mut entries: ByteReader = ByteReader::new(payload);
        while (entries.remaining() > 0) {
            // A whole number of entries remains, so neither read runs short.
            const id: u16 = entries.read_u16_big_endian().unwrap();
            const value: u32 = entries.read_u32_big_endian().unwrap();
            this.apply_one(id, value);
        }
        return true;
    }
}

/// Append a (identifier, value) entry to a SETTINGS payload buffer.
public function push_entry(out: mut &Array<u8>, id: u16, value: u32) -> void {
    mut entry: ByteWriter = ByteWriter::new(out);
    entry.write_u16_big_endian(id);
    entry.write_u32_big_endian(value);
}
