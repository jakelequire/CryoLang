///! HTTP/2 SETTINGS parameters (RFC 7540 section 6.5).
///!
///! A SETTINGS frame payload is a sequence of 6-octet entries: a 16-bit
///! identifier followed by a 32-bit value. `Settings` holds the
///! parameters this stdlib cares about, seeded with the protocol
///! defaults; unknown identifiers are ignored on parse, as required.

namespace std::net::http2::settings;

import std::core::option::{ Option };
import std::core::result::{ Result };
import std::core::slice::{ Slice };
import std::net::http2::frame;
import std::collections::array::{ Array };
import std::io::bytes::{ ByteReader, ByteWriter };

/// Identifier 0x1: the largest HPACK dynamic table, in bytes, the sender's
/// decoder accepts. Default 4096.
public const SETTINGS_HEADER_TABLE_SIZE:      u16 = 0x1;
/// Identifier 0x2: 1 when the sender accepts server push, 0 when it does
/// not. Default 1.
public const SETTINGS_ENABLE_PUSH:            u16 = 0x2;
/// Identifier 0x3: how many streams the sender lets its peer have open at
/// once. Unlimited by default.
public const SETTINGS_MAX_CONCURRENT_STREAMS: u16 = 0x3;
/// Identifier 0x4: the sender's initial flow-control window for each new
/// stream, in bytes. Default 65535.
public const SETTINGS_INITIAL_WINDOW_SIZE:    u16 = 0x4;
/// Identifier 0x5: the largest frame payload, in bytes, the sender accepts.
/// Default 16384; valid values are 16384 to 16777215.
public const SETTINGS_MAX_FRAME_SIZE:         u16 = 0x5;
/// Identifier 0x6: the largest header list, in bytes, the sender is
/// prepared to accept. Unlimited by default.
public const SETTINGS_MAX_HEADER_LIST_SIZE:   u16 = 0x6;

/// The largest flow-control window, and so the largest
/// `SETTINGS_INITIAL_WINDOW_SIZE`: 2^31 - 1.
public const MAX_WINDOW_SIZE:    u32 = 2147483647;
/// The smallest `SETTINGS_MAX_FRAME_SIZE`, 2^14, which is also its
/// default.
public const MIN_MAX_FRAME_SIZE: u32 = 16384;
/// The largest `SETTINGS_MAX_FRAME_SIZE`, 2^24 - 1.
public const MAX_MAX_FRAME_SIZE: u32 = 16777215;

/// The six SETTINGS parameters of one side of an HTTP/2 connection, one
/// field per identifier. Start from `defaults` and fold a received SETTINGS
/// payload in with `apply_payload`; build one to send with `push_entry`.
public type struct Settings {
    public header_table_size:      u32;
    public enable_push:            u32;
    public max_concurrent_streams: u32;
    public initial_window_size:    u32;
    public max_frame_size:         u32;
    public max_header_list_size:   u32;

    /// Protocol defaults (RFC 7540 section 6.5.2). "Unlimited" parameters use
    /// the u32 maximum as a sentinel.
    public static defaults() -> Settings {
        return Settings {
            header_table_size:      4096,
            enable_push:            1,
            max_concurrent_streams: u32::MAX,
            initial_window_size:    65535,
            max_frame_size:         16384,
            max_header_list_size:   u32::MAX
        };
    }

    /// Apply a single parsed (identifier, value). Unknown identifiers are
    /// ignored. A value the protocol forbids is refused with the error code
    /// the connection must end with, and stores nothing: `PROTOCOL_ERROR`
    /// for `SETTINGS_ENABLE_PUSH` other than 0 or 1 and for
    /// `SETTINGS_MAX_FRAME_SIZE` outside 16384 to 16777215, and
    /// `FLOW_CONTROL_ERROR` for `SETTINGS_INITIAL_WINDOW_SIZE` above
    /// 2^31 - 1.
    public apply_one(mut &this, id: u16, value: u32) -> Result<(), u32> {
        if (id == SETTINGS_HEADER_TABLE_SIZE) {
            this.header_table_size = value;
        } else if (id == SETTINGS_ENABLE_PUSH) {
            if (value > 1) { return Result::Err(frame::PROTOCOL_ERROR); }
            this.enable_push = value;
        } else if (id == SETTINGS_MAX_CONCURRENT_STREAMS) {
            this.max_concurrent_streams = value;
        } else if (id == SETTINGS_INITIAL_WINDOW_SIZE) {
            // A window past 2^31 - 1 cannot be tracked by the flow-control
            // arithmetic the protocol defines.
            if (value > MAX_WINDOW_SIZE) { return Result::Err(frame::FLOW_CONTROL_ERROR); }
            this.initial_window_size = value;
        } else if (id == SETTINGS_MAX_FRAME_SIZE) {
            // Stored, a 0 would give the senders a zero per-frame budget
            // and loop them forever.
            if (value < MIN_MAX_FRAME_SIZE || value > MAX_MAX_FRAME_SIZE) {
                return Result::Err(frame::PROTOCOL_ERROR);
            }
            this.max_frame_size = value;
        } else if (id == SETTINGS_MAX_HEADER_LIST_SIZE) {
            this.max_header_list_size = value;
        }
        return Result::Ok(());
    }

    /// Parse a SETTINGS frame payload, applying its entries in order.
    /// Refused with `FRAME_SIZE_ERROR` when the length is not a multiple
    /// of 6, and with `apply_one`'s code at the first value it refuses;
    /// the entries before that one stay applied.
    public apply_payload(mut &this, payload: &Slice<u8>) -> Result<(), u32> {
        if (payload.length() % 6 != 0) { return Result::Err(frame::FRAME_SIZE_ERROR); }
        mut entries: ByteReader = ByteReader::new(payload);
        while (entries.remaining() > 0) {
            // A whole number of entries remains, so neither read runs short.
            const id: u16 = entries.read_u16_big_endian().unwrap();
            const value: u32 = entries.read_u32_big_endian().unwrap();
            this.apply_one(id, value)?;
        }
        return Result::Ok(());
    }
}

/// Append a (identifier, value) entry to a SETTINGS payload buffer.
public function push_entry(out: mut &Array<u8>, id: u16, value: u32) -> void {
    mut entry: ByteWriter = ByteWriter::new(out);
    entry.write_u16_big_endian(id);
    entry.write_u32_big_endian(value);
}
