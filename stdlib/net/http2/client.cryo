///! HTTP/2 client.
///!
///! `connect` upgrades an established, buffered async transport to an HTTP/2
///! client connection (preface + SETTINGS), generic over the transport so it
///! serves h2c (`TcpStream`) and h2 (`TlsStream`) alike. It takes ownership of
///! the connection: the returned `Http2Connection` owns the transport for the
///! rest of its life, because a borrowed one could not survive a suspension.
///! Issue requests with `request`; reuse the connection for several sequential
///! requests.
///!
///! `Http2Client` is a convenience for one-shot h2c requests over plain
///! TCP: dial, handshake, one request/response, close.

namespace std::net::http2::client;

import std::core::option;
import std::core::result;
import std::io::error;
import std::io::traits;
import std::io::buf;
import std::collections::array;
import std::collections::str;
import std::net::addr::socket_addr;
import std::net::socket::tcp;
import std::net::http::method;
import std::net::http::request;
import std::net::http::response;
import std::net::http2::connection;
import std::future::poll;
import std::future::waker;
import std::future::traits;

/// Upgrade `conn` to an HTTP/2 client connection by performing the preface +
/// SETTINGS handshake. Takes ownership; the returned connection closes the
/// transport when dropped. A failed handshake releases it.
async function connect<S>(conn: BufStream<S>) -> Result<Http2Connection<S>, IoError>
where S: AsyncTransport {
    mut c: Http2Connection<S> = Http2Connection<S>::new_client(conn);
    (await c.handshake_client())?;
    return Result::Ok(c);
}

/// One-shot h2c (cleartext) requests over plain TCP.
type struct Http2Client {
    static new() -> Http2Client {
        return Http2Client { };
    }

    /// `GET` over h2c. `authority` is the `:authority` pseudo-header
    /// (host[:port]); `path` is the request target.
    async get(&this, addr: SocketAddr, authority: Str, path: Str) -> Result<Response, IoError> {
        mut req: Request = Request::new(Method::Get, path);
        return await one_shot(addr, authority, req);
    }

    /// `POST` over h2c with a body and Content-Type.
    async post(&this, addr: SocketAddr, authority: Str, path: Str,
               content_type: Str, body: Array<u8>) -> Result<Response, IoError> {
        mut req: Request = Request::new(Method::Post, path);
        req.headers.insert(Str::new("content-type"), content_type);
        req.set_body(body);
        return await one_shot(addr, authority, req);
    }
}

/// Dial `addr`, upgrade to h2c, run one request/response, close.
///
/// The connection is built synchronously from the accepted socket and then
/// awaited on as this future's own local, so the socket never has to be reached
/// through an address belonging to another frame. Dropping it at the end of the
/// function is what closes the connection — every exit path releases it.
async function one_shot(addr: SocketAddr, authority: Str, req: Request) -> Result<Response, IoError> {
    mut request_local: Request = req;
    mut sock: TcpStream = (await TcpConnect::start(addr))?;
    mut conn: Http2Connection<TcpStream> =
        Http2Connection<TcpStream>::new_client(BufStream<TcpStream>::of(sock));
    (await conn.handshake_client())?;
    return await conn.request(request_local, Str::new("http"), authority);
}
