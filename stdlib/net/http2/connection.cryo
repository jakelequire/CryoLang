///! HTTP/2 connection (RFC 7540).
///!
///! `Http2Connection<S>` drives the HTTP/2 protocol over any
///! `Read + Write` transport `S` (a `TcpStream` for h2c, a `TlsStream`
///! for h2). It owns the HPACK encoder/decoder, performs the connection
///! preface + SETTINGS handshake, and exposes `request` (client) and
///! `serve` (server). Requests and responses are the same `net::http`
///! `Request` / `Response` types used by the HTTP/1.1 layer, so handlers
///! and clients are written once.
///!
///! Scope: streams are processed sequentially within a connection (one
///! outstanding request/response at a time), which is the common keep-
///! alive pattern. Flow control is honoured on both directions for that
///! single active stream plus the connection window; true concurrent
///! multiplexing and server push are out of scope.

namespace std::net::http2::connection;

import core::option;
import core::result;
import core::slice;
import core::primitives;
import core::convert;
import core::mem;
import io::error;
import io::traits;
import collections::array;
import collections::string;
import collections::str;
import collections::hashmap;
import net::http::method;
import net::http::status;
import net::http::headers;
import net::http::request;
import net::http::response;
import net::http2::frame;
import net::http2::hpack;
import net::http2::settings;

/// The 24-octet client connection preface (RFC 7540 section 3.5).
const PREFACE_LEN: u64 = 24;

/// Values we advertise in our SETTINGS frame.
const LOCAL_HEADER_TABLE_SIZE:   u32 = 4096;
const LOCAL_ENABLE_PUSH:         u32 = 0;          // we never accept pushed streams
const LOCAL_INITIAL_WINDOW_SIZE: u32 = 1048576;    // 1 MiB receive window per stream
const LOCAL_MAX_FRAME_SIZE:      u32 = 16384;      // default; also our read cap
// Cap on an assembled header block (HEADERS + CONTINUATION fragments). A
// peer can otherwise stream CONTINUATION frames without END_HEADERS and
// grow the buffer without bound (a CONTINUATION flood); and HPACK can
// expand a small block into a large header list (a decompression bomb). We
// advertise this as SETTINGS_MAX_HEADER_LIST_SIZE and the decoder enforces
// the matching decoded-size ceiling (hpack::MAX_DECODED_HEADER_LIST).
const LOCAL_MAX_HEADER_LIST_SIZE: u32 = 262144;    // 256 KiB
// Cap on an assembled DATA body (the sum of all DATA frame payloads on a
// stream).  Without it a peer streams DATA frames without END_STREAM and
// grows the buffer without bound (a remote memory-exhaustion DoS), because
// `ack_data` replenishes the flow-control window after every frame.  Mirrors
// the HTTP/1.1 `MAX_BODY` cap (16 MiB).  Checked at the top of the read loop,
// so it overshoots by at most one frame before we stop replenishing and fail.
const LOCAL_MAX_BODY_SIZE: u64 = 16777216;         // 16 MiB

/// The connection-level flow-control window initial value is fixed at
/// 65535 octets (RFC 7540 section 6.9.2); it is not affected by SETTINGS.
const DEFAULT_CONNECTION_WINDOW: i64 = 65535;

/// A decoded request paired with the stream it arrived on. A plain
/// carrier with no destructor: `serve` always moves `req` out to the
/// handler, so the field is consumed exactly once.
type struct RequestOnStream {
    stream_id: u32;
    req:       Request;
}

type struct Http2Connection<S> {
    inner:                 S*;
    encoder:               HpackEncoder;
    decoder:               HpackDecoder;
    is_client:             boolean;
    next_stream_id:        u32;
    goaway_received:       boolean;
    // Peer parameters that bound what we send.
    remote_max_frame:      u64;
    remote_initial_window: i64;
    // Send-side flow-control windows for the single active stream.
    conn_send_window:      i64;
    stream_send_window:    i64;

    /// Release the HPACK encoder/decoder tables. The borrowed transport
    /// `inner` belongs to the caller and is not dropped here.
    drop(mut &this) -> void {
        this.encoder.drop();
        this.decoder.drop();
    }

    /// New client-side connection over `stream`. The caller owns the
    /// transport. Call `handshake` before issuing requests.
    static new_client(stream: S*) -> Http2Connection<S> {
        return Http2Connection<S> {
            inner:                 stream,
            encoder:               HpackEncoder::new(LOCAL_HEADER_TABLE_SIZE as u64),
            decoder:               HpackDecoder::new(LOCAL_HEADER_TABLE_SIZE as u64),
            is_client:             true,
            next_stream_id:        1,
            goaway_received:       false,
            remote_max_frame:      16384,
            remote_initial_window: 65535,
            conn_send_window:      DEFAULT_CONNECTION_WINDOW,
            stream_send_window:    65535
        };
    }

    /// New server-side connection over an accepted `stream`.
    static new_server(stream: S*) -> Http2Connection<S> {
        return Http2Connection<S> {
            inner:                 stream,
            encoder:               HpackEncoder::new(LOCAL_HEADER_TABLE_SIZE as u64),
            decoder:               HpackDecoder::new(LOCAL_HEADER_TABLE_SIZE as u64),
            is_client:             false,
            next_stream_id:        2,
            goaway_received:       false,
            remote_max_frame:      16384,
            remote_initial_window: 65535,
            conn_send_window:      DEFAULT_CONNECTION_WINDOW,
            stream_send_window:    65535
        };
    }

    // ---- handshake --------------------------------------------------------

    /// Client preface + SETTINGS exchange. Writes the magic and our
    /// SETTINGS, then reads frames (acking the peer's SETTINGS) until the
    /// peer's initial SETTINGS frame has been seen.
    handshake_client(mut &this) -> Result<(), IoError>
    where S: Read + Write {
        this.inner.write(preface_bytes())?;
        this.send_settings()?;
        return this.await_peer_settings();
    }

    /// Server side: validate the client preface, send our SETTINGS, then
    /// read frames (acking the peer's SETTINGS) until the client's
    /// initial SETTINGS frame has been seen.
    handshake_server(mut &this) -> Result<(), IoError>
    where S: Read + Write {
        mut magic: u8[24];
        this.inner.read_exact(&magic[0], PREFACE_LEN)?;
        const got: Slice<u8> = Slice::from_raw(&magic[0], PREFACE_LEN);
        if (!slice_eq(got, preface_bytes())) {
            return Result::Err(IoError::new(IoErrorKind::InvalidData, 0));
        }
        this.send_settings()?;
        return this.await_peer_settings();
    }

    await_peer_settings(mut &this) -> Result<(), IoError>
    where S: Read + Write {
        loop {
            mut fr: Frame = frame::read_frame(this.inner, LOCAL_MAX_FRAME_SIZE as u64)?;
            const is_settings: boolean = (fr.ftype == frame::FRAME_SETTINGS)
                                       && !fr.has_flag(frame::FLAG_ACK);
            match (this.process_control(&fr)) {
                Result::Ok(_)  => { }
                Result::Err(e) => { fr.drop(); return Result::Err(e); }
            }
            fr.drop();
            if (is_settings) { return Result::Ok(()); }
        }
    }

    /// Send our advertised SETTINGS frame.
    send_settings(mut &this) -> Result<(), IoError>
    where S: Read + Write {
        mut payload: Array<u8> = Array<u8>::new();
        settings::push_entry(&payload, settings::SETTINGS_HEADER_TABLE_SIZE, LOCAL_HEADER_TABLE_SIZE);
        settings::push_entry(&payload, settings::SETTINGS_ENABLE_PUSH, LOCAL_ENABLE_PUSH);
        settings::push_entry(&payload, settings::SETTINGS_INITIAL_WINDOW_SIZE, LOCAL_INITIAL_WINDOW_SIZE);
        settings::push_entry(&payload, settings::SETTINGS_MAX_FRAME_SIZE, LOCAL_MAX_FRAME_SIZE);
        settings::push_entry(&payload, settings::SETTINGS_MAX_HEADER_LIST_SIZE, LOCAL_MAX_HEADER_LIST_SIZE);
        const r: Result<(), IoError> =
            frame::write_frame(this.inner, frame::FRAME_SETTINGS, 0, 0, payload.as_slice());
        payload.drop();
        return r;
    }

    // ---- control-frame handling ------------------------------------------

    /// Handle a connection-level control frame. Returns true if the
    /// frame was fully handled here (SETTINGS, PING, WINDOW_UPDATE,
    /// GOAWAY, PRIORITY, PUSH_PROMISE); false for stream frames the
    /// caller must process (HEADERS, CONTINUATION, DATA, RST_STREAM).
    process_control(mut &this, fr: &Frame) -> Result<boolean, IoError>
    where S: Read + Write {
        if (fr.ftype == frame::FRAME_SETTINGS) {
            if (fr.has_flag(frame::FLAG_ACK)) { return Result::Ok(true); }
            mut s: Settings = Settings::defaults();
            s.apply_payload(fr.payload.as_slice());
            this.remote_max_frame = s.max_frame_size as u64;
            this.remote_initial_window = s.initial_window_size as i64;
            // Our encoder must not exceed the peer's decoder table size.
            this.encoder.set_capacity(s.header_table_size as u64);
            // Acknowledge.
            frame::write_frame(this.inner, frame::FRAME_SETTINGS, frame::FLAG_ACK, 0,
                               Slice::from_raw(null as u8*, 0))?;
            return Result::Ok(true);
        }
        if (fr.ftype == frame::FRAME_PING) {
            if (fr.has_flag(frame::FLAG_ACK)) { return Result::Ok(true); }
            frame::write_frame(this.inner, frame::FRAME_PING, frame::FLAG_ACK, 0,
                               fr.payload.as_slice())?;
            return Result::Ok(true);
        }
        if (fr.ftype == frame::FRAME_WINDOW_UPDATE) {
            const inc: i64 = read_u31(fr.payload.as_slice()) as i64;
            // RFC 7540 section 6.9.1: a 0 increment is a PROTOCOL_ERROR, and a flow-
            // control window must never exceed 2^31-1 (FLOW_CONTROL_ERROR).
            // The 0 check also rejects a short/truncated payload, for which
            // read_u31 returns 0.
            const WINDOW_MAX: i64 = 2147483647;   // 2^31 - 1
            if (inc == 0) {
                return Result::Err(IoError::new(IoErrorKind::InvalidData, 0));
            }
            if (fr.stream_id == 0) {
                this.conn_send_window = this.conn_send_window + inc;
                if (this.conn_send_window > WINDOW_MAX) {
                    return Result::Err(IoError::new(IoErrorKind::InvalidData, 0));
                }
            } else {
                this.stream_send_window = this.stream_send_window + inc;
                if (this.stream_send_window > WINDOW_MAX) {
                    return Result::Err(IoError::new(IoErrorKind::InvalidData, 0));
                }
            }
            return Result::Ok(true);
        }
        if (fr.ftype == frame::FRAME_GOAWAY) {
            this.goaway_received = true;
            return Result::Ok(true);
        }
        if (fr.ftype == frame::FRAME_PRIORITY || fr.ftype == frame::FRAME_PUSH_PROMISE) {
            return Result::Ok(true);   // ignored
        }
        return Result::Ok(false);
    }

    // ---- sending ----------------------------------------------------------

    /// Send a header block on `stream_id`, splitting into HEADERS +
    /// CONTINUATION frames to respect the peer's max frame size. Sets
    /// END_STREAM on the HEADERS frame when `end_stream` is set.
    send_header_block(mut &this, stream_id: u32, block: Slice<u8>, end_stream: boolean) -> Result<(), IoError>
    where S: Read + Write {
        const total: u64 = block.length();
        const max: u64 = this.remote_max_frame;
        if (total <= max) {
            mut flags: u8 = frame::FLAG_END_HEADERS;
            if (end_stream) { flags = flags | frame::FLAG_END_STREAM; }
            return frame::write_frame(this.inner, frame::FRAME_HEADERS, flags, stream_id, block);
        }
        // First fragment: HEADERS without END_HEADERS.
        mut first_flags: u8 = 0;
        if (end_stream) { first_flags = first_flags | frame::FLAG_END_STREAM; }
        frame::write_frame(this.inner, frame::FRAME_HEADERS, first_flags, stream_id,
                           block.subslice(0, max))?;
        mut pos: u64 = max;
        while (pos < total) {
            mut end: u64 = pos + max;
            if (end > total) { end = total; }
            const last: boolean = end >= total;
            const cflags: u8 = if (last) { frame::FLAG_END_HEADERS } else { 0 };
            frame::write_frame(this.inner, frame::FRAME_CONTINUATION, cflags, stream_id,
                               block.subslice(pos, end))?;
            pos = end;
        }
        return Result::Ok(());
    }

    /// Send a message body as DATA frames on `stream_id`, honouring the
    /// connection and stream send windows and the peer's max frame size.
    send_body(mut &this, stream_id: u32, body: Slice<u8>, end_stream: boolean) -> Result<(), IoError>
    where S: Read + Write {
        const total: u64 = body.length();
        if (total == 0) {
            if (end_stream) {
                return frame::write_frame(this.inner, frame::FRAME_DATA,
                                          frame::FLAG_END_STREAM, stream_id, Slice::from_raw(null as u8*, 0));
            }
            return Result::Ok(());
        }
        mut pos: u64 = 0;
        while (pos < total) {
            this.ensure_send_window()?;
            mut avail: u64 = this.remote_max_frame;
            const remaining: u64 = total - pos;
            if (remaining < avail) { avail = remaining; }
            if ((this.stream_send_window as u64) < avail) { avail = this.stream_send_window as u64; }
            if ((this.conn_send_window as u64) < avail) { avail = this.conn_send_window as u64; }

            const end: u64 = pos + avail;
            const last: boolean = end >= total;
            const flags: u8 = if (last && end_stream) { frame::FLAG_END_STREAM } else { 0 };
            frame::write_frame(this.inner, frame::FRAME_DATA, flags, stream_id,
                               body.subslice(pos, end))?;
            this.stream_send_window = this.stream_send_window - (avail as i64);
            this.conn_send_window = this.conn_send_window - (avail as i64);
            pos = end;
        }
        return Result::Ok(());
    }

    /// Block until both the stream and connection send windows are
    /// positive, processing incoming control frames (chiefly
    /// WINDOW_UPDATE) while we wait.
    ensure_send_window(mut &this) -> Result<(), IoError>
    where S: Read + Write {
        while (this.stream_send_window <= 0 || this.conn_send_window <= 0) {
            mut fr: Frame = frame::read_frame(this.inner, LOCAL_MAX_FRAME_SIZE as u64)?;
            match (this.process_control(&fr)) {
                Result::Ok(_)  => { }
                Result::Err(e) => { fr.drop(); return Result::Err(e); }
            }
            fr.drop();
        }
        return Result::Ok(());
    }

    /// Replenish our receive windows after consuming `n` octets of DATA.
    ack_data(mut &this, stream_id: u32, n: u64) -> Result<(), IoError>
    where S: Read + Write {
        if (n == 0) { return Result::Ok(()); }
        mut conn: u8[4];
        write_u31(&conn[0], n as u32);
        frame::write_frame(this.inner, frame::FRAME_WINDOW_UPDATE, 0, 0,
                           Slice::from_raw(&conn[0], 4))?;
        mut strm: u8[4];
        write_u31(&strm[0], n as u32);
        return frame::write_frame(this.inner, frame::FRAME_WINDOW_UPDATE, 0, stream_id,
                                  Slice::from_raw(&strm[0], 4));
    }

    // ---- client request ---------------------------------------------------

    /// Issue one request and read its response. `scheme` is "http" (h2c)
    /// or "https" (h2); `authority` becomes the `:authority` pseudo-
    /// header. Consumes `req`.
    request(mut &this, req: Request, scheme: Str, authority: Str) -> Result<Response, IoError>
    where S: Read + Write {
        mut request_local: Request = req;
        const sid: u32 = this.next_stream_id;
        this.next_stream_id = this.next_stream_id + 2;
        this.stream_send_window = this.remote_initial_window;

        mut block: Array<u8> = Array<u8>::new();
        this.encode_request_headers(&block, &request_local, scheme, authority);
        const has_body: boolean = !request_local.body.is_empty();

        match (this.send_header_block(sid, block.as_slice(), !has_body)) {
            Result::Ok(_)  => { }
            Result::Err(e) => { block.drop(); request_local.drop(); return Result::Err(e); }
        }
        block.drop();

        if (has_body) {
            match (this.send_body(sid, request_local.body.as_slice(), true)) {
                Result::Ok(_)  => { }
                Result::Err(e) => { request_local.drop(); return Result::Err(e); }
            }
        }
        request_local.drop();
        return this.read_response(sid);
    }

    read_response(mut &this, sid: u32) -> Result<Response, IoError>
    where S: Read + Write {
        mut block: Array<u8> = Array<u8>::new();
        mut body: Array<u8> = Array<u8>::new();
        mut headers_done: boolean = false;
        mut stream_done: boolean = false;

        while (!(headers_done && stream_done)) {
            // Reject a CONTINUATION flood / oversized header block, or a
            // runaway DATA body, before reading more (each overshoots by at
            // most one frame).
            if (block.length() > LOCAL_MAX_HEADER_LIST_SIZE as u64
                || body.length() > LOCAL_MAX_BODY_SIZE) {
                block.drop(); body.drop();
                return Result::Err(IoError::new(IoErrorKind::InvalidData, 0));
            }
            mut fr: Frame = match (frame::read_frame(this.inner, LOCAL_MAX_FRAME_SIZE as u64)) {
                Result::Ok(f)  => { f }
                Result::Err(e) => { block.drop(); body.drop(); return Result::Err(e); }
            };
            const handled: boolean = match (this.process_control(&fr)) {
                Result::Ok(h)  => { h }
                Result::Err(e) => { fr.drop(); block.drop(); body.drop(); return Result::Err(e); }
            };
            if (handled) { fr.drop(); continue; }

            if (fr.ftype == frame::FRAME_RST_STREAM && fr.stream_id == sid) {
                fr.drop(); block.drop(); body.drop();
                return Result::Err(IoError::new(IoErrorKind::ConnectionReset, 0));
            } else if (fr.ftype == frame::FRAME_HEADERS && fr.stream_id == sid) {
                block.append(header_fragment(&fr));
                if (fr.has_flag(frame::FLAG_END_HEADERS)) { headers_done = true; }
                if (fr.has_flag(frame::FLAG_END_STREAM))  { stream_done = true; }
                fr.drop();
            } else if (fr.ftype == frame::FRAME_CONTINUATION && fr.stream_id == sid) {
                block.append(fr.payload.as_slice());
                if (fr.has_flag(frame::FLAG_END_HEADERS)) { headers_done = true; }
                fr.drop();
            } else if (fr.ftype == frame::FRAME_DATA && fr.stream_id == sid) {
                body.append(data_fragment(&fr));
                const consumed: u64 = fr.payload.length();
                const end: boolean = fr.has_flag(frame::FLAG_END_STREAM);
                fr.drop();
                match (this.ack_data(sid, consumed)) {
                    Result::Ok(_)  => { }
                    Result::Err(e) => { block.drop(); body.drop(); return Result::Err(e); }
                }
                if (end) { stream_done = true; }
            } else {
                fr.drop();
            }
        }

        const built: Option<Response> = build_response(&this.decoder, block.as_slice(), body);
        block.drop();
        match (built) {
            Option::Some(resp) => { return Result::Ok(resp); }
            Option::None       => { return Result::Err(IoError::new(IoErrorKind::InvalidData, 0)); }
        }
    }

    // ---- server -----------------------------------------------------------

    /// Serve requests on this connection, dispatching each to `handler`,
    /// until the peer closes the connection or sends GOAWAY. Performs the
    /// server handshake first.
    serve(mut &this, handler: (Request) -> Response) -> Result<(), IoError>
    where S: Read + Write {
        this.handshake_server()?;
        loop {
            match (this.read_request()) {
                Result::Ok(maybe) => {
                    match (maybe) {
                        Option::Some(ros) => {
                            mut on_stream: RequestOnStream = ros;
                            const sid: u32 = on_stream.stream_id;
                            // Move the assembled request out, leaving a
                            // throwaway in its place for the struct's
                            // implicit destructor to reclaim.
                            mut req: Request = Request::new(Method::Get, Str::new("/"));
                            mem::swap(&req, &on_stream.req);
                            const resp: Response = (handler)(req);
                            this.send_response(sid, resp)?;
                        }
                        Option::None => { return Result::Ok(()); }
                    }
                }
                Result::Err(e) => { return Result::Err(e); }
            }
        }
    }

    /// Read frames until one stream completes (END_STREAM), returning the
    /// assembled request. `None` means the connection closed cleanly.
    read_request(mut &this) -> Result<Option<RequestOnStream>, IoError>
    where S: Read + Write {
        mut block: Array<u8> = Array<u8>::new();
        mut body: Array<u8> = Array<u8>::new();
        mut sid: u32 = 0;
        mut have_stream: boolean = false;
        mut headers_done: boolean = false;
        mut stream_done: boolean = false;

        while (!(have_stream && headers_done && stream_done)) {
            // Reject a CONTINUATION flood / oversized header block, or a
            // runaway DATA body, before reading more (each overshoots by at
            // most one frame).
            if (block.length() > LOCAL_MAX_HEADER_LIST_SIZE as u64
                || body.length() > LOCAL_MAX_BODY_SIZE) {
                block.drop(); body.drop();
                return Result::Err(IoError::new(IoErrorKind::InvalidData, 0));
            }
            mut fr: Frame = match (frame::read_frame(this.inner, LOCAL_MAX_FRAME_SIZE as u64)) {
                Result::Ok(f)  => { f }
                Result::Err(e) => {
                    block.drop(); body.drop();
                    if (e.kind == IoErrorKind::UnexpectedEof && !have_stream) {
                        return Result::Ok(Option::None);
                    }
                    return Result::Err(e);
                }
            };
            const handled: boolean = match (this.process_control(&fr)) {
                Result::Ok(h)  => { h }
                Result::Err(e) => { fr.drop(); block.drop(); body.drop(); return Result::Err(e); }
            };
            if (handled) {
                const closing: boolean = this.goaway_received && !have_stream;
                fr.drop();
                if (closing) { block.drop(); body.drop(); return Result::Ok(Option::None); }
                continue;
            }

            if (fr.ftype == frame::FRAME_HEADERS) {
                if (!have_stream) { sid = fr.stream_id; have_stream = true; }
                if (fr.stream_id == sid) {
                    block.append(header_fragment(&fr));
                    if (fr.has_flag(frame::FLAG_END_HEADERS)) { headers_done = true; }
                    if (fr.has_flag(frame::FLAG_END_STREAM))  { stream_done = true; }
                }
                fr.drop();
            } else if (fr.ftype == frame::FRAME_CONTINUATION && have_stream && fr.stream_id == sid) {
                block.append(fr.payload.as_slice());
                if (fr.has_flag(frame::FLAG_END_HEADERS)) { headers_done = true; }
                fr.drop();
            } else if (fr.ftype == frame::FRAME_DATA && have_stream && fr.stream_id == sid) {
                body.append(data_fragment(&fr));
                const consumed: u64 = fr.payload.length();
                const end: boolean = fr.has_flag(frame::FLAG_END_STREAM);
                fr.drop();
                match (this.ack_data(sid, consumed)) {
                    Result::Ok(_)  => { }
                    Result::Err(e) => { block.drop(); body.drop(); return Result::Err(e); }
                }
                if (end) { stream_done = true; }
            } else {
                fr.drop();
            }
        }

        const built: Option<Request> = build_request(&this.decoder, block.as_slice(), body);
        block.drop();
        match (built) {
            Option::Some(req) => {
                return Result::Ok(Option::Some(RequestOnStream { stream_id: sid, req: req }));
            }
            Option::None => { return Result::Err(IoError::new(IoErrorKind::InvalidData, 0)); }
        }
    }

    send_response(mut &this, sid: u32, resp: Response) -> Result<(), IoError>
    where S: Read + Write {
        mut response: Response = resp;
        this.stream_send_window = this.remote_initial_window;

        mut block: Array<u8> = Array<u8>::new();
        this.encode_response_headers(&block, &response);
        const has_body: boolean = !response.body.is_empty();

        match (this.send_header_block(sid, block.as_slice(), !has_body)) {
            Result::Ok(_)  => { }
            Result::Err(e) => { block.drop(); response.drop(); return Result::Err(e); }
        }
        block.drop();

        if (has_body) {
            match (this.send_body(sid, response.body.as_slice(), true)) {
                Result::Ok(_)  => { }
                Result::Err(e) => { response.drop(); return Result::Err(e); }
            }
        }
        response.drop();
        return Result::Ok(());
    }

    /// Send a GOAWAY with the given last-stream-id and error code, then
    /// stop. Best-effort; transport teardown is the caller's.
    send_goaway(mut &this, last_stream_id: u32, error_code: u32) -> Result<(), IoError>
    where S: Read + Write {
        mut payload: u8[8];
        write_u31(&payload[0], last_stream_id);
        payload[4] = (error_code >> 24) as u8;
        payload[5] = (error_code >> 16) as u8;
        payload[6] = (error_code >> 8) as u8;
        payload[7] = (error_code) as u8;
        return frame::write_frame(this.inner, frame::FRAME_GOAWAY, 0, 0,
                                  Slice::from_raw(&payload[0], 8));
    }

    // ---- header (de)serialization ----------------------------------------

    encode_request_headers(mut &this, out: mut &Array<u8>, req: &Request,
                           scheme: Str, authority: Str) -> void {
        this.encoder.encode_field(out, Str::new(":method"), req.method.as_str(), false);
        this.encoder.encode_field(out, Str::new(":scheme"), scheme, false);
        this.encoder.encode_field(out, Str::new(":path"), req.path.as_str(), false);
        this.encoder.encode_field(out, Str::new(":authority"), authority, false);
        this.encode_regular_headers(out, &req.headers);
    }

    encode_response_headers(mut &this, out: mut &Array<u8>, resp: &Response) -> void {
        mut buf: u8[5];
        const code: u64 = resp.status.as_u16() as u64;
        const digits: u64 = code.to_decimal_buf(&buf[0]);
        this.encoder.encode_field(out, Str::new(":status"), Str::from_raw(&buf[0], digits), false);
        this.encode_regular_headers(out, &resp.headers);
    }

    /// Emit every stored header except the HTTP/1-only connection-
    /// specific fields that are forbidden in HTTP/2 (RFC 7540 section 8.1.2.2).
    encode_regular_headers(mut &this, out: mut &Array<u8>, h: &Headers) -> void {
        const count: u64 = h.inner.bucket_count();
        mut i: u64 = 0;
        while (i < count) {
            mut node: hashmap::Entry<String, String>* = h.inner.get_bucket(i);
            loop {
                if (node == null) { break; }
                const name: Str = node.key.as_str();
                if (!is_skippable(name)) {
                    this.encoder.encode_field(out, name, node.value.as_str(), false);
                }
                node = node.next;
            }
            i++;
        }
    }
}

// ---- free helpers ---------------------------------------------------------

/// The connection preface octets. Built inline because a module-level
/// `const Str` initialised from a literal is unreliable at runtime.
function preface_bytes() -> Slice<u8> {
    const magic: Str = Str::new("PRI * HTTP/2.0\r\n\r\nSM\r\n\r\n");
    return magic.as_bytes();
}

/// Build a `Response` from a decoded header block and body. Consumes
/// `body`.
function build_response(decoder: mut &HpackDecoder, block: Slice<u8>, body: Array<u8>) -> Option<Response> {
    mut body_local: Array<u8> = body;
    mut fields: Array<HeaderField> = match (decoder.decode(block)) {
        Option::Some(f) => { f }
        Option::None    => { body_local.drop(); return Option::None; }
    };

    mut code: u16 = 0;
    mut have_status: boolean = false;
    mut i: u64 = 0;
    while (i < fields.length()) {
        match (fields.get_ref(i)) {
            Option::Some(f) => {
                if ((*f).name.as_str().equals(&Str::new(":status"))) {
                    match (u16::try_from((*f).value.as_str())) {
                        Result::Ok(v) => { code = v; have_status = true; }
                        Result::Err(_) => { }
                    }
                }
            }
            Option::None => { }
        }
        i++;
    }
    if (!have_status) { fields.drop(); body_local.drop(); return Option::None; }

    mut resp: Response = Response::new(StatusCode::from_u16(code));
    mut j: u64 = 0;
    while (j < fields.length()) {
        match (fields.get_ref(j)) {
            Option::Some(f) => {
                const name: Str = (*f).name.as_str();
                if (!is_pseudo(name)) {
                    resp.headers.insert(name, (*f).value.as_str());
                }
            }
            Option::None => { }
        }
        j++;
    }
    fields.drop();

    resp.set_body(body_local);
    return Option::Some(resp);
}

/// Build a `Request` from a decoded header block and body. Consumes
/// `body`.
function build_request(decoder: mut &HpackDecoder, block: Slice<u8>, body: Array<u8>) -> Option<Request> {
    mut body_local: Array<u8> = body;
    mut fields: Array<HeaderField> = match (decoder.decode(block)) {
        Option::Some(f) => { f }
        Option::None    => { body_local.drop(); return Option::None; }
    };

    mut method: Option<Method> = Option::None;
    mut path: Option<String> = Option::None;
    mut authority: Option<String> = Option::None;

    mut i: u64 = 0;
    while (i < fields.length()) {
        match (fields.get_ref(i)) {
            Option::Some(f) => {
                const name: Str = (*f).name.as_str();
                const value: Str = (*f).value.as_str();
                if (name.equals(&Str::new(":method"))) {
                    match (Method::parse(value)) {
                        Result::Ok(m)  => { method = Option::Some(m); }
                        Result::Err(_) => { }
                    }
                } else if (name.equals(&Str::new(":path"))) {
                    match (path) { Option::Some(mut p) => { p.drop(); } Option::None => { } }
                    path = Option::Some(String::from_str(value));
                } else if (name.equals(&Str::new(":authority"))) {
                    match (authority) { Option::Some(mut a) => { a.drop(); } Option::None => { } }
                    authority = Option::Some(String::from_str(value));
                }
            }
            Option::None => { }
        }
        i++;
    }

    mut chosen_method: Method = Method::Get;
    match (method) {
        Option::Some(m) => { chosen_method = m; }
        Option::None    => {
            cleanup_opt_string(path);
            cleanup_opt_string(authority);
            fields.drop(); body_local.drop();
            return Option::None;
        }
    }
    mut path_str: String = match (path) {
        Option::Some(p) => { p }
        Option::None    => {
            cleanup_opt_string(authority);
            fields.drop(); body_local.drop();
            return Option::None;
        }
    };

    mut req: Request = Request::new(chosen_method, path_str.as_str());
    path_str.drop();
    match (authority) {
        Option::Some(mut a) => {
            req.headers.insert(Str::new("host"), a.as_str());
            a.drop();
        }
        Option::None => { }
    }

    mut j: u64 = 0;
    while (j < fields.length()) {
        match (fields.get_ref(j)) {
            Option::Some(f) => {
                const name: Str = (*f).name.as_str();
                if (!is_pseudo(name)) {
                    req.headers.insert(name, (*f).value.as_str());
                }
            }
            Option::None => { }
        }
        j++;
    }
    fields.drop();

    req.set_body(body_local);
    return Option::Some(req);
}

function cleanup_opt_string(opt: Option<String>) -> void {
    match (opt) {
        Option::Some(mut s) => { s.drop(); }
        Option::None        => { }
    }
}

/// Extract the header-block fragment from a HEADERS frame, stripping any
/// padding and PRIORITY prefix.
function header_fragment(fr: &Frame) -> Slice<u8> {
    const p: Slice<u8> = fr.payload.as_slice();
    mut start: u64 = 0;
    mut end: u64 = p.length();
    if (fr.has_flag(frame::FLAG_PADDED)) {
        const pad: u64 = byte_at(p, 0) as u64;
        start = 1;
        if (end >= pad) { end = end - pad; } else { return Slice::from_raw(p.as_ptr(), 0); }
    }
    if (fr.has_flag(frame::FLAG_PRIORITY)) {
        start = start + 5;
    }
    if (start > end) { return Slice::from_raw(p.as_ptr(), 0); }
    return p.subslice(start, end);
}

/// Extract application data from a DATA frame, stripping any padding.
function data_fragment(fr: &Frame) -> Slice<u8> {
    const p: Slice<u8> = fr.payload.as_slice();
    mut start: u64 = 0;
    mut end: u64 = p.length();
    if (fr.has_flag(frame::FLAG_PADDED)) {
        const pad: u64 = byte_at(p, 0) as u64;
        start = 1;
        if (end >= pad) { end = end - pad; } else { return Slice::from_raw(p.as_ptr(), 0); }
    }
    if (start > end) { return Slice::from_raw(p.as_ptr(), 0); }
    return p.subslice(start, end);
}

/// True for `:`-prefixed pseudo-header names.
function is_pseudo(name: Str) -> boolean {
    match (name.byte_at(0)) {
        Option::Some(b) => { return b == 0x3A; }   // ':'
        Option::None    => { return false; }
    }
}

/// True for connection-specific header fields forbidden in HTTP/2, plus
/// `host` (mapped to `:authority`).
function is_skippable(name_lower: Str) -> boolean {
    if (name_lower.equals(&Str::new("host"))) { return true; }
    if (name_lower.equals(&Str::new("connection"))) { return true; }
    if (name_lower.equals(&Str::new("keep-alive"))) { return true; }
    if (name_lower.equals(&Str::new("proxy-connection"))) { return true; }
    if (name_lower.equals(&Str::new("transfer-encoding"))) { return true; }
    if (name_lower.equals(&Str::new("upgrade"))) { return true; }
    return false;
}

/// Read a 31-bit big-endian value (top reserved bit masked off) from the
/// first 4 bytes of `s`.
function read_u31(s: Slice<u8>) -> u32 {
    if (s.length() < 4) { return 0; }
    return (((byte_at(s, 0) & 0x7f) as u32) << 24)
         | ((byte_at(s, 1) as u32) << 16)
         | ((byte_at(s, 2) as u32) << 8)
         | (byte_at(s, 3) as u32);
}

/// Write a 31-bit big-endian value into 4 bytes (reserved bit clear).
function write_u31(out: u8*, value: u32) -> void {
    out[0] = ((value >> 24) & 0x7f) as u8;
    out[1] = (value >> 16) as u8;
    out[2] = (value >> 8) as u8;
    out[3] = (value) as u8;
}

function slice_eq(a: Slice<u8>, b: Slice<u8>) -> boolean {
    if (a.length() != b.length()) { return false; }
    mut i: u64 = 0;
    while (i < a.length()) {
        if (byte_at(a, i) != byte_at(b, i)) { return false; }
        i++;
    }
    return true;
}

function byte_at(s: Slice<u8>, index: u64) -> u8 {
    match (s.get(index)) {
        Option::Some(b) => { return b; }
        Option::None    => { return 0; }
    }
}
