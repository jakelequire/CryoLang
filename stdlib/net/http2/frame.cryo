///! HTTP/2 framing (RFC 7540 §4, §6).
///!
///! Every HTTP/2 frame is a 9-octet header — a 24-bit length, an 8-bit
///! type, an 8-bit flags field, and a 31-bit stream identifier (the top
///! reserved bit is cleared) — followed by `length` octets of payload.
///! `write_frame` and `read_frame` are generic over the `Write` / `Read`
///! transport, so they run unchanged over `TcpStream` (h2c) and
///! `TlsStream` (h2).

namespace std::net::http2::frame;

import core::option;
import core::result;
import core::slice;
import io::error;
import io::traits;
import collections::array;

/// Length of the fixed frame header.
const FRAME_HEADER_LEN: u64 = 9;

// Frame types (RFC 7540 §6).
const FRAME_DATA:          u8 = 0x0;
const FRAME_HEADERS:       u8 = 0x1;
const FRAME_PRIORITY:      u8 = 0x2;
const FRAME_RST_STREAM:    u8 = 0x3;
const FRAME_SETTINGS:      u8 = 0x4;
const FRAME_PUSH_PROMISE:  u8 = 0x5;
const FRAME_PING:          u8 = 0x6;
const FRAME_GOAWAY:        u8 = 0x7;
const FRAME_WINDOW_UPDATE: u8 = 0x8;
const FRAME_CONTINUATION:  u8 = 0x9;

// Frame flags (RFC 7540 §6). Several share a bit across frame types.
const FLAG_ACK:         u8 = 0x1;   // SETTINGS, PING
const FLAG_END_STREAM:  u8 = 0x1;   // DATA, HEADERS
const FLAG_END_HEADERS: u8 = 0x4;   // HEADERS, PUSH_PROMISE, CONTINUATION
const FLAG_PADDED:      u8 = 0x8;   // DATA, HEADERS, PUSH_PROMISE
const FLAG_PRIORITY:    u8 = 0x20;  // HEADERS

/// Absolute ceiling on a payload length we will buffer for a single
/// frame, independent of the negotiated SETTINGS_MAX_FRAME_SIZE. A
/// frame claiming more is rejected rather than risking an unbounded
/// allocation. Callers pass the negotiated limit to `read_frame`; this
/// is only the hard backstop.
const MAX_FRAME_PAYLOAD: u64 = 1048576;   // 1 MiB

/// One decoded frame. Owns its payload bytes; call `drop`.
type struct Frame {
    ftype:     u8;
    flags:     u8;
    stream_id: u32;
    payload:   Array<u8>;

    has_flag(&this, flag: u8) -> boolean {
        return (this.flags & flag) != 0;
    }

    drop(mut &this) -> void {
        this.payload.drop();
    }
}

/// Write a frame: 9-byte header then payload. The reserved high bit of
/// the stream identifier is always sent as 0.
function write_frame<W>(writer: mut &W, ftype: u8, flags: u8,
                        stream_id: u32, payload: Slice<u8>) -> Result<(), IoError>
where W: Write {
    const len: u64 = payload.length();
    mut hdr: u8[9];
    hdr[0] = (len >> 16) as u8;
    hdr[1] = (len >> 8) as u8;
    hdr[2] = (len) as u8;
    hdr[3] = ftype;
    hdr[4] = flags;
    hdr[5] = ((stream_id >> 24) & 0x7f) as u8;   // clear reserved bit
    hdr[6] = (stream_id >> 16) as u8;
    hdr[7] = (stream_id >> 8) as u8;
    hdr[8] = (stream_id) as u8;
    writer.write_all(Slice::from_raw(&hdr[0], 9))?;
    if (len > 0) {
        writer.write_all(payload)?;
    }
    return Result::Ok(());
}

/// Read one frame off `reader`, rejecting a payload longer than
/// `max_payload` (the negotiated SETTINGS_MAX_FRAME_SIZE) or the hard
/// backstop, whichever is smaller.
function read_frame<R>(reader: mut &R, max_payload: u64) -> Result<Frame, IoError>
where R: Read {
    mut hdr: u8[9];
    reader.read_exact(&hdr[0], FRAME_HEADER_LEN)?;

    const len: u64 = ((hdr[0] as u64) << 16) | ((hdr[1] as u64) << 8) | (hdr[2] as u64);
    const ftype: u8 = hdr[3];
    const flags: u8 = hdr[4];
    const stream_id: u32 = (((hdr[5] & 0x7f) as u32) << 24)
                         | ((hdr[6] as u32) << 16)
                         | ((hdr[7] as u32) << 8)
                         | (hdr[8] as u32);

    mut cap: u64 = max_payload;
    if (cap > MAX_FRAME_PAYLOAD) { cap = MAX_FRAME_PAYLOAD; }
    if (len > cap) {
        return Result::Err(IoError::new(IoErrorKind::InvalidData, 0));
    }

    mut payload: Array<u8> = Array<u8>::with_capacity(len);
    if (len > 0) {
        mut z: u64 = 0;
        while (z < len) { payload.push(0); z++; }
        match (reader.read_exact(payload.as_ptr(), len)) {
            Result::Ok(_)  => { }
            Result::Err(e) => { payload.drop(); return Result::Err(e); }
        }
    }
    return Result::Ok(Frame {
        ftype: ftype, flags: flags, stream_id: stream_id, payload: payload
    });
}
