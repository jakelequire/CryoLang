///! HTTP/2 framing (RFC 7540 section 4, section 6).
///!
///! Every HTTP/2 frame is a 9-octet header - a 24-bit length, an 8-bit
///! type, an 8-bit flags field, and a 31-bit stream identifier (the top
///! reserved bit is cleared) - followed by `length` octets of payload.
///!
///! Both directions are inherent methods on `BufStream<S>`, beside HTTP/1.1's
///! `read_request` and WebSocket's `read_frame`, and for the same reasons:
///!
///!   - **Reading is a method** because a parser written as a static taking
///!     `mut &BufStream<S>` cannot be called from an async caller holding the
///!     connection as a local — handing the address of a local to a future
///!     that outlives the current poll is refused (E0455), and only the
///!     RECEIVER is re-supplied on every poll.
///!   - **Queuing is synchronous.** A whole frame — header then payload — is
///!     built into `pending()` with no suspension point inside it, and the
///!     caller suspends exactly once, in `flush`. That is what lets a HEADERS
///!     block and its CONTINUATION fragments, or a DATA frame and the
///!     WINDOW_UPDATE that follows it, go out in one transport operation.
///!
///! The names carry the `h2_` prefix because `BufStream<S>` hosts the framing
///! for three protocols and each name has to be its own: `ws::frame` already
///! owns `read_frame` / `queue_frame` on this type.
///!
///! Written once for `BufStream<S>` over any async transport, so h2c over
///! `TcpStream` and h2 over `TlsStream` are served by the same code.
///!
///! No `buffered()` slice is held across an `await`: every header byte is
///! copied into a scalar before the next suspension, which is what makes the
///! parse safe against a fill that grows and moves the connection's buffer.

namespace std::net::http2::frame;

import std::core::option::{ Option };
import std::core::result::{ Result };
import std::core::slice::{ Slice };
import std::io::error::{ IoError, IoErrorKind };
import std::io::bytes::{ ByteReader, ByteWriter };
import std::io::traits::{ AsyncTransport };
import std::io::buf::{ BufStream };
import std::collections::array::{ Array };
import std::future::poll;
import std::future::waker;
import std::future::traits;

/// Length of the fixed frame header.
public const FRAME_HEADER_LEN: i64 = 9;

// Frame types (RFC 7540 section 6).
/// Frame type 0x0, DATA: a slice of a stream's body.
public const FRAME_DATA:          u8 = 0x0;
/// Frame type 0x1, HEADERS: opens a stream and carries the first fragment
/// of its HPACK-encoded header block.
public const FRAME_HEADERS:       u8 = 0x1;
/// Frame type 0x2, PRIORITY: a stream's dependency and weight.
public const FRAME_PRIORITY:      u8 = 0x2;
/// Frame type 0x3, RST_STREAM: ends one stream at once, with an error code.
public const FRAME_RST_STREAM:    u8 = 0x3;
/// Frame type 0x4, SETTINGS: connection parameters, or the acknowledgement
/// of the peer's when it carries `FLAG_ACK`.
public const FRAME_SETTINGS:      u8 = 0x4;
/// Frame type 0x5, PUSH_PROMISE: a stream the server intends to push.
public const FRAME_PUSH_PROMISE:  u8 = 0x5;
/// Frame type 0x6, PING: eight opaque bytes the peer echoes back with
/// `FLAG_ACK`.
public const FRAME_PING:          u8 = 0x6;
/// Frame type 0x7, GOAWAY: the sender is shutting the connection down.
public const FRAME_GOAWAY:        u8 = 0x7;
/// Frame type 0x8, WINDOW_UPDATE: grants more flow-control window to a
/// stream, or to the connection on stream 0.
public const FRAME_WINDOW_UPDATE: u8 = 0x8;
/// Frame type 0x9, CONTINUATION: a further fragment of a header block
/// begun by HEADERS or PUSH_PROMISE.
public const FRAME_CONTINUATION:  u8 = 0x9;

// Frame flags (RFC 7540 section 6). Several share a bit across frame types.
/// Flag 0x1 on SETTINGS and PING: the frame acknowledges the peer's.
/// It is the same bit as `FLAG_END_STREAM`.
public const FLAG_ACK:         u8 = 0x1;   // SETTINGS, PING
/// Flag 0x1 on DATA and HEADERS: the sender sends nothing more on this
/// stream. It is the same bit as `FLAG_ACK`.
public const FLAG_END_STREAM:  u8 = 0x1;   // DATA, HEADERS
/// Flag 0x4 on HEADERS, PUSH_PROMISE and CONTINUATION: this frame ends the
/// header block, and no CONTINUATION follows.
public const FLAG_END_HEADERS: u8 = 0x4;   // HEADERS, PUSH_PROMISE, CONTINUATION
/// Flag 0x8 on DATA, HEADERS and PUSH_PROMISE: the payload begins with a
/// pad-length byte and ends with that many bytes of padding.
public const FLAG_PADDED:      u8 = 0x8;   // DATA, HEADERS, PUSH_PROMISE
/// Flag 0x20 on HEADERS: the payload begins with a five-byte priority
/// block (stream dependency and weight) before the header fragment.
public const FLAG_PRIORITY:    u8 = 0x20;  // HEADERS

/// Absolute ceiling on a payload length we will buffer for a single
/// frame, independent of the negotiated SETTINGS_MAX_FRAME_SIZE. A
/// frame claiming more is rejected rather than risking an unbounded
/// allocation. Callers pass the negotiated limit to `read_h2_frame`;
/// this is only the hard backstop.
private const MAX_FRAME_PAYLOAD: i64 = 1048576;   // 1 MiB

/// One decoded frame. Owns its payload bytes; call `drop`.
public type struct Frame {
    public ftype:     u8;
    public flags:     u8;
    public stream_id: u32;
    public payload:   Array<u8>;

    /// Whether any bit of `flag` is set in the frame's flags. A flag's
    /// meaning depends on the frame type: `FLAG_ACK` and `FLAG_END_STREAM`
    /// are the same bit, so check `ftype` first.
    public has_flag(&this, flag: u8) -> boolean {
        return (this.flags & flag) != 0;
    }
}

implement trait Drop for struct Frame {
    drop(mut &this) -> void { }
}

/// HTTP/2 framing over a buffered async connection.
implement struct BufStream<S> {
    /// Queue one frame into the outgoing buffer: the 9-byte header, then the
    /// payload. The reserved high bit of the stream identifier is always sent
    /// as 0. The payload is not consumed. Nothing is sent until the caller
    /// flushes.
    public queue_h2_frame(mut &this, ftype: u8, flags: u8, stream_id: u32,
                          payload: &Slice<u8>) -> Result<(), IoError> {
        const len: i64 = payload.length();
        mut out: mut &Array<u8> = this.pending();

        mut header: ByteWriter = ByteWriter::new(out);
        // A 24-bit length: its top byte, then the low 16 bits.
        header.write_u8((len >> 16) as u8);
        header.write_u16_big_endian(len as u16);
        header.write_u8(ftype);
        header.write_u8(flags);
        header.write_u32_big_endian(stream_id & 0x7fffffff);   // clear reserved bit

        if (len > 0) {
            out.try_append(payload)?;
        }
        return Result::Ok(());
    }

    /// Read one frame, rejecting a payload longer than `max_payload` (the
    /// negotiated SETTINGS_MAX_FRAME_SIZE) or the hard backstop, whichever is
    /// smaller.
    ///
    /// The nine header bytes are copied into scalars and consumed before the
    /// payload's suspension, so no view into the connection's buffer is live
    /// when a fill can move it.
    public async read_h2_frame(mut &this, max_payload: i64) -> Result<Frame, IoError>
    where S: AsyncTransport {
        (await this.ensure(FRAME_HEADER_LEN))?;
        mut header: ByteReader = ByteReader::new(this.buffered());
        const length_high: u8 = header.read_u8()?;
        const length_low: u16 = header.read_u16_big_endian()?;
        const ftype: u8 = header.read_u8()?;
        const flags: u8 = header.read_u8()?;
        const stream_id: u32 = (header.read_u32_big_endian()?) & 0x7fffffff;
        this.consume(FRAME_HEADER_LEN);

        const len: i64 = ((length_high as i64) << 16) | (length_low as i64);

        mut cap: i64 = max_payload;
        if (cap > MAX_FRAME_PAYLOAD) { cap = MAX_FRAME_PAYLOAD; }
        if (len > cap) {
            return Result::Err(IoError::new(IoErrorKind::InvalidData, 0));
        }

        mut payload: Array<u8> = (await this.read_exact(len))?;
        return Result::Ok(Frame {
            ftype: ftype, flags: flags, stream_id: stream_id, payload: payload
        });
    }
}
