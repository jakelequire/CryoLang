///! HTTP/2 framing (RFC 7540 section 4, section 6).
///!
///! Every HTTP/2 frame is a 9-octet header - a 24-bit length, an 8-bit
///! type, an 8-bit flags field, and a 31-bit stream identifier (the top
///! reserved bit is cleared) - followed by `length` octets of payload.
///!
///! Both directions are inherent methods on `BufStream<S>`, beside HTTP/1.1's
///! `read_request` and WebSocket's `read_frame`, and for the same reasons:
///!
///!   - **Reading is a method** because a parser written as a static taking
///!     `mut &BufStream<S>` cannot be called from an async caller holding the
///!     connection as a local — handing the address of a local to a future
///!     that outlives the current poll is refused (E0455), and only the
///!     RECEIVER is re-supplied on every poll.
///!   - **Queuing is synchronous.** A whole frame — header then payload — is
///!     built into `pending()` with no suspension point inside it, and the
///!     caller suspends exactly once, in `flush`. That is what lets a HEADERS
///!     block and its CONTINUATION fragments, or a DATA frame and the
///!     WINDOW_UPDATE that follows it, go out in one transport operation.
///!
///! The names carry the `h2_` prefix because `BufStream<S>` hosts the framing
///! for three protocols and each name has to be its own: `ws::frame` already
///! owns `read_frame` / `queue_frame` on this type.
///!
///! Written once for `BufStream<S>` over any async transport, so h2c over
///! `TcpStream` and h2 over `TlsStream` are served by the same code.
///!
///! No `buffered()` slice is held across an `await`: every header byte is
///! copied into a scalar before the next suspension, which is what makes the
///! parse safe against a fill that grows and moves the connection's buffer.

namespace std::net::http2::frame;

import std::core::option;
import std::core::result;
import std::core::slice;
import std::io::error;
import std::io::traits;
import std::io::buf;
import std::collections::array;
import std::future::poll;
import std::future::waker;
import std::future::traits;

/// Length of the fixed frame header.
const FRAME_HEADER_LEN: u64 = 9;

// Frame types (RFC 7540 section 6).
const FRAME_DATA:          u8 = 0x0;
const FRAME_HEADERS:       u8 = 0x1;
const FRAME_PRIORITY:      u8 = 0x2;
const FRAME_RST_STREAM:    u8 = 0x3;
const FRAME_SETTINGS:      u8 = 0x4;
const FRAME_PUSH_PROMISE:  u8 = 0x5;
const FRAME_PING:          u8 = 0x6;
const FRAME_GOAWAY:        u8 = 0x7;
const FRAME_WINDOW_UPDATE: u8 = 0x8;
const FRAME_CONTINUATION:  u8 = 0x9;

// Frame flags (RFC 7540 section 6). Several share a bit across frame types.
const FLAG_ACK:         u8 = 0x1;   // SETTINGS, PING
const FLAG_END_STREAM:  u8 = 0x1;   // DATA, HEADERS
const FLAG_END_HEADERS: u8 = 0x4;   // HEADERS, PUSH_PROMISE, CONTINUATION
const FLAG_PADDED:      u8 = 0x8;   // DATA, HEADERS, PUSH_PROMISE
const FLAG_PRIORITY:    u8 = 0x20;  // HEADERS

/// Absolute ceiling on a payload length we will buffer for a single
/// frame, independent of the negotiated SETTINGS_MAX_FRAME_SIZE. A
/// frame claiming more is rejected rather than risking an unbounded
/// allocation. Callers pass the negotiated limit to `read_h2_frame`;
/// this is only the hard backstop.
const MAX_FRAME_PAYLOAD: u64 = 1048576;   // 1 MiB

/// One decoded frame. Owns its payload bytes; call `drop`.
type struct Frame {
    ftype:     u8;
    flags:     u8;
    stream_id: u32;
    payload:   Array<u8>;

    has_flag(&this, flag: u8) -> boolean {
        return (this.flags & flag) != 0;
    }

    drop(mut &this) -> void {
        this.payload.drop();
    }
}

/// HTTP/2 framing over a buffered async connection.
implement struct BufStream<S> {
    /// Queue one frame into the outgoing buffer: the 9-byte header, then the
    /// payload. The reserved high bit of the stream identifier is always sent
    /// as 0. The payload is not consumed. Nothing is sent until the caller
    /// flushes.
    queue_h2_frame(mut &this, ftype: u8, flags: u8, stream_id: u32,
                   payload: Slice<u8>) -> Result<(), IoError> {
        const len: u64 = payload.length();
        mut out: Array<u8>* = this.pending();

        out.push((len >> 16) as u8);
        out.push((len >> 8) as u8);
        out.push((len) as u8);
        out.push(ftype);
        out.push(flags);
        out.push(((stream_id >> 24) & 0x7f) as u8);   // clear reserved bit
        out.push((stream_id >> 16) as u8);
        out.push((stream_id >> 8) as u8);
        out.push((stream_id) as u8);

        if (len > 0) {
            match (out.try_append(payload)) {
                Result::Ok(_)  => { }
                Result::Err(_) => {
                    return Result::Err(IoError::new(IoErrorKind::OutOfMemory, 0));
                }
            }
        }
        return Result::Ok(());
    }

    /// Read one frame, rejecting a payload longer than `max_payload` (the
    /// negotiated SETTINGS_MAX_FRAME_SIZE) or the hard backstop, whichever is
    /// smaller.
    ///
    /// The nine header bytes are copied into scalars and consumed before the
    /// payload's suspension, so no view into the connection's buffer is live
    /// when a fill can move it.
    async read_h2_frame(mut &this, max_payload: u64) -> Result<Frame, IoError>
    where S: AsyncTransport {
        (await this.ensure(FRAME_HEADER_LEN))?;
        const hdr: Slice<u8> = this.buffered();
        const h0: u8    = frame_byte_at(hdr, 0);
        const h1: u8    = frame_byte_at(hdr, 1);
        const h2: u8    = frame_byte_at(hdr, 2);
        const ftype: u8 = frame_byte_at(hdr, 3);
        const flags: u8 = frame_byte_at(hdr, 4);
        const h5: u8    = frame_byte_at(hdr, 5);
        const h6: u8    = frame_byte_at(hdr, 6);
        const h7: u8    = frame_byte_at(hdr, 7);
        const h8: u8    = frame_byte_at(hdr, 8);
        this.consume(FRAME_HEADER_LEN);

        const len: u64 = ((h0 as u64) << 16) | ((h1 as u64) << 8) | (h2 as u64);
        const stream_id: u32 = (((h5 & 0x7f) as u32) << 24)
                             | ((h6 as u32) << 16)
                             | ((h7 as u32) << 8)
                             | (h8 as u32);

        mut cap: u64 = max_payload;
        if (cap > MAX_FRAME_PAYLOAD) { cap = MAX_FRAME_PAYLOAD; }
        if (len > cap) {
            return Result::Err(IoError::new(IoErrorKind::InvalidData, 0));
        }

        mut payload: Array<u8> = (await this.read_exact(len))?;
        return Result::Ok(Frame {
            ftype: ftype, flags: flags, stream_id: stream_id, payload: payload
        });
    }
}

/// Slice byte access without `Option` ceremony; callers stay in range. Named
/// apart from `connection`'s own accessor: that module imports this one, and a
/// bare leaf name resolved across both would be ambiguous.
function frame_byte_at(s: Slice<u8>, index: u64) -> u8 {
    match (s.get(index)) {
        Option::Some(b) => { return b; }
        Option::None    => { return 0; }
    }
}
