///! net::http2: HTTP/2 (RFC 7540) with HPACK header compression
///! (RFC 7541).
///!
///! A binary framing layer multiplexing many request/response streams
///! over one connection. `Http2Connection<S>` runs over any
///! `Read + Write` transport, so the same code speaks h2c (prior-
///! knowledge cleartext over `TcpStream`) and h2 (over `TlsStream` after
///! ALPN negotiates "h2"). `Http2Client` drives requests; `Http2Server`
///! accepts a connection and dispatches each stream to a handler.

namespace std::net::http2;

public module net::http2::huffman;
public module net::http2::hpack;
public module net::http2::settings;
public module net::http2::frame;
public module net::http2::connection;
public module net::http2::client;
public module net::http2::server;
