///! net: network primitives + HTTP.
///!
///! Standing up a TCP server or HTTP endpoint should not need
///! external dependencies. This module provides sockets and addresses
///! at the base, with an HTTP layer on top.
///!
///! Datagram and connection sockets, name resolution, HTTP/1.1 and
///! HTTP/2, TLS, and WebSocket ship in the box. Everything that can wait is a
///! future driven by an `Executor` — there is no blocking socket surface left.
///! `net::socket::udp` adds connectionless datagrams alongside
///! `net::socket::tcp`; `net::dns` resolves hostnames via `getaddrinfo`, which
///! blocks, so async callers await `dns::Resolve` and it runs on the executor's
///! blocking pool instead of stalling a worker; `net::tls` wraps a stream in
///! OpenSSL; `net::ws` speaks RFC 6455 over any
///! `Read + Write` transport (ws:// over TCP, wss:// over TLS);
///! `net::http2` adds HPACK (RFC 7541) + framing (RFC 7540) with a
///! client and server connection, generic over the transport.
///!
///! `net::addr::url` parses absolute URLs (`scheme://host:port/path?query#frag`)
///! into borrowed parts and resolves references against them (`Url.join`).
///! `net::http::client::Client` takes a `Url` and does the rest: resolving
///! the host, TCP or TLS by scheme, HTTP/1.1 or HTTP/2, timeouts and
///! redirects.
///!
///! Deliberately out of scope:
///!
///! - **Unix sockets.** Easy to add; no caller has needed them.
///! - **HTTP/1.1 pipelining.** The HTTP/1.1 server uses keep-alive
///!   (persistent connections, read timeouts, `Connection: close` opt-out);
///!   each request is still served sequentially within a connection.
///! - **URL percent-decoding / normalisation.** `net::addr::url` returns
///!   parts verbatim; it does not decode `%XX` escapes, and collapses `.`/`..`
///!   only in a path `Url.join` builds.
///! - **Unix-domain / raw sockets.** No caller has needed them yet.

namespace std::net;

// Addressing primitives - the values that name an endpoint (IpAddr,
// SocketAddr, the raw sockaddr bridge, and URL parsing).
module net::addr;

// Transport sockets - TCP streams and UDP datagrams.
module net::socket;

// Name resolution (getaddrinfo).
module net::dns;

// Security and application protocols, layered on the above.
module {
    net::tls;
    net::ws;
    net::http;
    net::http2;
}
