///! DNS resolution via `getaddrinfo`.
///!
///! `getaddrinfo` returns a heap-allocated linked list of
///! `struct addrinfo`; this module walks it by field offset (cryoc
///! doesn't model the C struct layout), copies out the addresses, and
///! calls `freeaddrinfo` before returning - the borrowed C memory never
///! escapes. Both IPv4 (`AF_INET`) and IPv6 (`AF_INET6`) results are
///! surfaced as `IpAddr`; the TCP socket layer (`net::socket::tcp`) dials both
///! families, so a v6 result is directly connectable.
///!
///! `struct addrinfo` offsets (Linux x86_64, from `man getaddrinfo`):
///!   ai_flags @0  ai_family @4  ai_socktype @8  ai_protocol @12
///!   ai_addrlen @16  ai_addr @24 (sockaddr*)  ai_canonname @32
///!   ai_next @40 (addrinfo*).
///!
///! ## Blocking and async
///!
///! `resolve` / `lookup` / `resolve_one` block the calling thread. `getaddrinfo`
///! has no non-blocking form on either platform and a name lookup is the
///! slowest, most latency-variable step in opening a connection, so calling one
///! of them from inside an `async` function stalls an executor worker for the
///! whole query — on a single-threaded `Executor`, the whole runtime.
///!
///! `Resolve` is the async spelling: it hands the same lookup to the executor's
///! `BlockingPool`, which runs it on a thread nobody polls on, and parks the
///! task until the answer arrives. Await that from async code; the blocking
///! entry points remain for synchronous programs, and are what the pool thread
///! ends up calling.

namespace std::net::dns;

import core::option;
import core::result;
import core::mem;
import core::ptr;
import core::drop;
import alloc::layout;
import alloc::allocator;
import collections::str;
import collections::string;
import collections::array;
import io::error;
import ffi::libc;
import net::addr::ip;
import net::addr::socket_addr;
import net::sys;
import future::poll;
import future::waker;
import future::traits;
import future::blocking;

// AF_INET is 2 on every platform; AF_INET6 differs (Linux/BSD = 10,
// Windows = 23). `getaddrinfo` reports the OS family value in `ai_family`,
// so the Windows value must match or every IPv6/AAAA result is dropped.
const AF_INET:  u32 = 2;
![target(unix)]
const AF_INET6: u32 = 10;
![target(windows)]
const AF_INET6: u32 = 23;

/// The addresses a hostname resolved to. Owns the backing `Array`;
/// call `drop` when done.
type struct ResolvedAddrs {
    addrs: Array<IpAddr>;

    /// Number of resolved addresses (>= 1 on a successful `resolve`).
    length(&this) -> u64 {
        return this.addrs.length();
    }

    /// The i-th resolved address, or `None` if out of range.
    get(&this, index: u64) -> Option<IpAddr> {
        return this.addrs.get(index);
    }

    /// The first IPv4 address in the result, paired with `port`, or `None` if
    /// the name resolved only to AAAA records. Callers that can dial a v6
    /// address should walk `get` instead; this exists for the layers that
    /// cannot yet.
    first_ipv4(&this, port: u16) -> Option<SocketAddr> {
        mut i: u64 = 0;
        while (i < this.addrs.length()) {
            match (this.addrs.get(i)) {
                Option::Some(ip) => {
                    if (ip.is_ipv4()) { return Option::Some(SocketAddr::new(ip, port)); }
                }
                Option::None => { }
            }
            i++;
        }
        return Option::None;
    }

    drop(mut &this) -> void {
        this.addrs.drop();
    }
}

/// Resolve `host` to every A / AAAA record the resolver returns, in
/// the order it returns them (already preference-sorted by glibc's
/// RFC 3484 rules). `host` may be a name or a numeric literal - a
/// numeric address resolves to itself. Fails with `NotFound` for an
/// unknown name, `WouldBlock` for a temporary resolver failure.
function resolve(host: Str) -> Result<ResolvedAddrs, IoError> {
    // getaddrinfo needs a NUL-terminated node string.
    mut host_c: String = String::with_null(host);

    // Zeroed `struct addrinfo` hints: AF_UNSPEC (both families),
    // SOCK_STREAM to collapse the per-socktype duplicate entries,
    // AI_ADDRCONFIG to skip families with no configured interface.
    mut hints: u8[48];
    mut z: u64 = 0;
    while (z < 48) { hints[z] = 0; z++; }
    write_u32(&hints[0], 0, sys::dns_hint_flags());        // ai_flags
    write_u32(&hints[0], 8, libc::SOCK_STREAM as u32);     // ai_socktype

    mut res: u8* = null;
    const rc: i32 = sys::os_getaddrinfo(host_c.as_ptr(), null, &hints[0], &res);
    if (rc != 0) {
        const err: IoError = eai_to_io(rc);
        host_c.drop();
        return Result::Err(err);
    }

    mut addrs: Array<IpAddr> = Array<IpAddr>::new();
    mut cur: u8* = res;
    while (cur != null) {
        const family: u32 = read_u32(cur, 4);
        const sa: u8* = read_ptr(cur, sys::ai_addr_offset());
        if (sa != null) {
            if (family == AF_INET) {
                // sockaddr_in: sin_addr at offset 4, network order.
                addrs.push(IpAddr::V4(IpV4Addr::new(sa[4], sa[5], sa[6], sa[7])));
            }
            if (family == AF_INET6) {
                // sockaddr_in6: sin6_addr (16 bytes) at offset 8.
                mut seg: u8[16];
                mut j: u64 = 0;
                while (j < 16) { seg[j] = sa[8 + j]; j++; }
                addrs.push(IpAddr::V6(IpV6Addr { segments: seg }));
            }
        }
        cur = read_ptr(cur, 40);   // ai_next
    }

    sys::os_freeaddrinfo(res);
    host_c.drop();

    if (addrs.is_empty()) {
        addrs.drop();
        return Result::Err(IoError::new(IoErrorKind::NotFound, 0));
    }
    return Result::Ok(ResolvedAddrs { addrs: addrs });
}

/// Resolve `host` and pair every address with `port`, ready to hand to
/// `TcpConnect::start` / `UdpSocket::connect`. The returned `Array`
/// must be dropped by the caller.
function lookup(host: Str, port: u16) -> Result<Array<SocketAddr>, IoError> {
    mut resolved: ResolvedAddrs = resolve(host)?;
    mut out: Array<SocketAddr> = Array<SocketAddr>::new();
    mut i: u64 = 0;
    while (i < resolved.length()) {
        match (resolved.get(i)) {
            Option::Some(ip) => { out.push(SocketAddr::new(ip, port)); }
            Option::None     => { }
        }
        i++;
    }
    resolved.drop();
    return Result::Ok(out);
}

/// Resolve `host` to a single address - the first (most-preferred)
/// record. The common case for "connect to this name".
function resolve_one(host: Str) -> Result<IpAddr, IoError> {
    mut resolved: ResolvedAddrs = resolve(host)?;
    const first: Option<IpAddr> = resolved.get(0);
    resolved.drop();
    match (first) {
        Option::Some(ip) => { return Result::Ok(ip); }
        Option::None     => { return Result::Err(IoError::new(IoErrorKind::NotFound, 0)); }
    }
}

/// The block a `Resolve` hands to the blocking pool: the pool's job header, the
/// request, and the slot the answer lands in.
///
/// `job` must be the first field — the pool is given its address and casts it
/// back to this type, which is only sound at offset 0. The block is owned by
/// whichever of {the pool, the future} lets go of it last, so `host` is an owned
/// copy rather than a borrowed `Str`: the future that asked for the lookup may
/// be long gone, along with whatever the `Str` pointed into, by the time a pool
/// thread reads it.
/// The answer is stored as its two halves rather than as a `Result`: only the
/// halves have a `drop` the teardown below can call, and a `Result` in a raw
/// block would need drop glue synthesized on a value the compiler cannot see is
/// initialized. `produced` says whether either half was written at all — the
/// pool can cancel a job before it ever runs — and `ok` says which one.
type struct ResolveJob {
    job:      BlockingJob;
    host:     String;
    addrs:    ResolvedAddrs;   // valid when `produced && ok`
    err:      IoError;         // valid when `produced && !ok`
    produced: boolean;
    ok:       boolean;
}

/// `run_fn` for a `ResolveJob`: the blocking lookup, on a pool thread. A bare
/// fn-ptr in the job's vtable, so it must be a free function.
///
/// `produced` is set last. Everything the collecting side reads is written
/// before it, and the pool publishes the job's terminal status under its lock
/// after this returns, which is what orders the two.
function resolve_job_run(raw: u8*) -> void {
    mut j: ResolveJob* = raw as ResolveJob*;
    match (resolve(j.host.as_str())) {
        Result::Ok(a)  => { j.addrs = a; j.ok = true;  }
        Result::Err(e) => { j.err   = e; j.ok = false; }
    }
    j.produced = true;
}

/// `drop_fn` for a `ResolveJob`: release the request, release an answer nobody
/// collected, and free the block. Runs on whichever side let go of the block
/// last. A collected answer leaves an empty `ResolvedAddrs` behind, so this
/// stays correct whether or not anyone was still waiting.
function resolve_job_free(raw: u8*) -> void {
    mut j: ResolveJob* = raw as ResolveJob*;
    j.host.drop();
    if (j.produced && j.ok) {
        j.addrs.drop();
    }
    mut alloc: GlobalAlloc = GlobalAlloc::new();
    alloc.deallocate(NonNull::new(raw), Layout::of<ResolveJob>());
}

/// Resolve `host` without stalling the executor: the lookup runs on the
/// `BlockingPool`'s threads and the task parks until it answers.
///
/// ## Cancellation
///
/// Dropping a `Resolve` in flight abandons the answer; it does NOT stop the
/// query, because `getaddrinfo` cannot be interrupted. The pool thread finishes
/// the lookup and releases the block itself, so nothing leaks — but a
/// `Futures::timeout` around one bounds how long the *task* waits, not how long
/// the thread is busy.
///
/// ## Driving without a pool
///
/// `BlockingPool::current()` is null on any thread that is not an executor
/// worker. Rather than park with nowhere to submit — which would hang — a
/// `Resolve` polled there performs the lookup inline and completes on that first
/// poll, so the spinning `future::block_on` driver still works. That is a
/// blocking call on the polling thread, which is exactly what that driver
/// already is. Run it on an `Executor` to get the offload.
type struct Resolve {
    host: Str;           // the request, until the job takes an owned copy
    job:  ResolveJob*;   // null before the first poll and once the result is taken

    /// Begin resolving `host`. Nothing is submitted until the first poll, so a
    /// `Resolve` that is never awaited costs nothing.
    static start(host: Str) -> Resolve {
        return Resolve { host: host, job: null };
    }

    /// Hand the block back to the pool's ownership rules and forget it. Shared
    /// by the completion path and `Drop`: `release` frees the block only if this
    /// was its last reference, so a lookup still running keeps it alive.
    private let_go(mut &this) -> void {
        if (this.job == null) { return; }
        const j: ResolveJob* = this.job;
        this.job = null;
        j.job.release();
    }
}

implement trait Future for struct Resolve {
    type Output = Result<ResolvedAddrs, IoError>;

    poll(mut &this, cx: Context*) -> Poll<Result<ResolvedAddrs, IoError>> {
        if (this.job == null) {
            mut pool: BlockingPool* = BlockingPool::current();
            if (pool == null) {
                return Poll::Ready(resolve(this.host));
            }
            mut alloc: GlobalAlloc = GlobalAlloc::new();
            mut j: ResolveJob* = null;
            match (alloc.allocate(Layout::of<ResolveJob>())) {
                Result::Ok(raw) => { j = raw.cast<ResolveJob>().as_ptr(); }
                Result::Err(_)  => {
                    return Poll::Ready(Result::Err(IoError::new(IoErrorKind::OutOfMemory, 0)));
                }
            }
            BlockingJob::init(&j.job, resolve_job_run, resolve_job_free);
            j.host     = String::from_str(this.host);
            j.produced = false;
            j.ok       = false;
            if (!pool.submit(&j.job)) {
                // The pool is shutting down or could not create a thread, so
                // nothing would ever run this job. Release the block (which
                // drops the request copy) and do the lookup here instead —
                // slow, but an answer rather than a hang.
                j.job.release();
                return Poll::Ready(resolve(this.host));
            }
            this.job = j;
        }
        // Arming re-reads the job's status under the pool's lock, so a lookup
        // that finished between polls is collected here rather than parked on
        // again — and a waker stored a moment before the answer landed cannot be
        // the one nobody fires.
        mut j: ResolveJob* = this.job;
        if (j.job.arm(cx.waker()) == JOB_PENDING) {
            return Poll::Pending;
        }
        // Finished. `Interrupted` stands for "the pool shut down before reaching
        // this job", the one terminal state that produces no answer at all.
        mut out: Result<ResolvedAddrs, IoError> =
            Result::Err(IoError::new(IoErrorKind::Interrupted, 0));
        if (j.produced) {
            if (j.ok) {
                // Swap rather than read: the block may outlive this future (a
                // pool thread could still be releasing it), and leaving an empty
                // `ResolvedAddrs` behind is what stops its teardown from
                // freeing the array twice.
                mut taken: ResolvedAddrs = ResolvedAddrs { addrs: Array<IpAddr>::new() };
                mem::swap<ResolvedAddrs>(&taken, &j.addrs);
                out = Result::Ok(taken);
            } else {
                out = Result::Err(j.err);
            }
        }
        this.let_go();
        return Poll::Ready(out);
    }
}

/// Abandoning a lookup releases this side's claim on the block. The query may
/// still be running on a pool thread, which is why this is a reference release
/// and not a free.
implement trait Drop for struct Resolve {
    drop(mut &this) -> void {
        this.let_go();
    }
}

/// Map a `getaddrinfo` `EAI_*` code to an `IoError`. `EAI_SYSTEM`
/// defers to the live `errno`; everything else folds to the nearest
/// kind with the raw code preserved.
function eai_to_io(code: i32) -> IoError {
    // If-chain rather than `match`: `EAI_*` are cross-module constants
    // (`ffi::libc`), and `match` patterns require local constants, so an
    // arm on `libc::EAI_NONAME` would silently never fire.
    if (code == libc::EAI_NONAME || code == libc::EAI_NODATA) {
        return IoError::new(IoErrorKind::NotFound, code);
    }
    if (code == libc::EAI_AGAIN) {
        return IoError::new(IoErrorKind::WouldBlock, code);
    }
    if (code == libc::EAI_MEMORY) {
        return IoError::new(IoErrorKind::OutOfMemory, code);
    }
    if (code == libc::EAI_FAMILY || code == libc::EAI_SOCKTYPE || code == libc::EAI_SERVICE) {
        return IoError::new(IoErrorKind::Unsupported, code);
    }
    if (code == libc::EAI_SYSTEM) {
        return sys::last_io_error();
    }
    return IoError::new(IoErrorKind::Other, code);
}

/// Read a little-endian `u32` field at `base + off`.
function read_u32(base: u8*, off: u64) -> u32 {
    return (base[off]       as u32)
         | ((base[off + 1]  as u32) << 8)
         | ((base[off + 2]  as u32) << 16)
         | ((base[off + 3]  as u32) << 24);
}

/// Read a little-endian pointer field (8 bytes) at `base + off` and
/// reinterpret it as a `u8*`. This is how the `addrinfo` chain is
/// walked: the kernel writes native-width pointers, we read them back.
function read_ptr(base: u8*, off: u64) -> u8* {
    mut v: u64 = 0;
    mut i: u64 = 0;
    while (i < 8) {
        v = v | ((base[off + i] as u64) << (i * 8));
        i++;
    }
    return v as u8*;
}

/// Write a little-endian `u32` field at `base + off`.
function write_u32(base: u8*, off: u64, value: u32) -> void {
    base[off]     = (value)       as u8;
    base[off + 1] = (value >> 8)  as u8;
    base[off + 2] = (value >> 16) as u8;
    base[off + 3] = (value >> 24) as u8;
}
