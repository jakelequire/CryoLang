///! net::socket: transport-layer sockets.
///!
///!   - `tcp`  - `TcpStream` / `TcpListener`, connection-oriented streams.
///!              `TcpStream` is an `io::AsyncTransport`, so a buffered
///!              connection over one is `BufferedStream<TcpStream>` — the same
///!              generic connection a TLS session gets.
///!   - `udp`  - `UdpSocket`, connectionless datagrams. Sends and receives
///!              are futures on the same readiness reactor; datagram
///!              boundaries are why it is not an `AsyncTransport`.
///!
///! Both operate on `net::address` values; name resolution is `net::dns`, and
///! the higher-level protocols (`net::http`, `net::tls`, `net::ws`, ...)
///! build on top of these.

namespace std::net::socket;

module {
    net::socket::tcp;
    net::socket::udp;
}

export std::net::socket::tcp::{ TcpListener, TcpStream };
export std::net::socket::udp::{ UdpSocket };
