///! net::socket: transport-layer sockets.
///!
///!   - `tcp`  - `TcpStream` / `TcpListener`, connection-oriented streams.
///!              `TcpStream` is an `io::AsyncTransport`, so a buffered
///!              connection over one is `BufConn<TcpStream>` — the same
///!              generic connection a TLS session gets.
///!   - `udp`  - `UdpSocket`, connectionless datagrams.
///!
///! Both operate on `net::addr` values; name resolution is `net::dns`, and
///! the higher-level protocols (`net::http`, `net::tls`, `net::ws`, ...)
///! build on top of these.

namespace std::net::socket;

public module net::socket::tcp;
public module net::socket::udp;
