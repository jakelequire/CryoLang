///! `TcpConn` — a TCP connection that owns its socket and buffers its bytes,
///! i.e. the concrete `AsyncRead` + `AsyncWrite` every protocol layer sits on.
///!
///! The async socket primitives (`TcpRead` / `TcpWrite`) take the socket AND the
///! buffer BY VALUE and hand both back in a `TcpIo`, because a future is moved
///! between polls and so cannot hold a pointer into anyone's frame. That makes
///! them sound but awkward to call directly: every operation is a move-out,
///! await, move-back. `TcpConn` is where that dance is written once.
///!
///! While a read or a write is in flight the connection holds a CLOSED
///! placeholder (`TcpStream::from_fd(-1)`) in place of its socket, and the real
///! socket belongs to the future. Dropping that future — cancelling the
///! operation — therefore closes the connection, which is the intended
///! semantics: nothing else holds the socket, and a half-consumed read cannot
///! be resumed against a peer that has already sent the bytes. A caller that
///! wants to keep a connection past a cancelled read must not cancel it.
///!
///! The read buffer is compacted (the consumed prefix dropped) at the START of
///! a fill, never at the end, so `buffered()`'s view never shifts underneath a
///! caller that is part-way through parsing a record.

namespace std::net::socket::conn;

import core::mem;
import core::option;
import core::result;
import core::slice;
import collections::array;
import io::error;
import io::async_traits;
import net::addr::socket_addr;
import net::socket::tcp;
import future::poll;
import future::waker;
import future::traits;

/// Bytes requested per `fill`. One page: large enough that a header block or a
/// small frame arrives in a single syscall, small enough that many idle
/// connections do not each pin a large buffer.
const FILL_CHUNK: u64 = 4096;

type struct TcpConn {
    stream:  TcpStream;
    rbuf:    Array<u8>;
    rpos:    u64;        // start of the unconsumed region within `rbuf`
    scratch: Array<u8>;  // reused fill buffer; empty while a fill is in flight
    wbuf:    Array<u8>;

    /// Adopt an already-connected socket. The socket must be non-blocking —
    /// `TcpConnect` and `TcpAccept` both leave it that way.
    static of(stream: TcpStream) -> TcpConn {
        return TcpConn {
            stream:  stream,
            rbuf:    Array<u8>::new(),
            rpos:    0,
            scratch: Array<u8>::new(),
            wbuf:    Array<u8>::new()
        };
    }

    /// Connect to `remote` and wrap the result.
    static async connect(remote: SocketAddr) -> Result<TcpConn, IoError> {
        match (await TcpConnect::start(remote)) {
            Result::Ok(s)  => { return Result::Ok(TcpConn::of(s)); }
            Result::Err(e) => { return Result::Err(e); }
        }
    }

    /// Drop the consumed prefix so a long-lived connection's buffer tracks what
    /// is live rather than everything ever read. Called only at the start of a
    /// fill: moving bytes at any other time would shift `buffered()` under a
    /// caller mid-parse. (Internal to the connection, but not `private` — the
    /// `AsyncRead` impl block is a separate scope and could not reach it.)
    compact(mut &this) -> void {
        if (this.rpos == 0) { return; }
        const live: u64 = this.rbuf.length() - this.rpos;
        if (live == 0) {
            this.rbuf.clear();
            this.rpos = 0;
            return;
        }
        const p: u8* = this.rbuf.as_ptr();
        mut i: u64 = 0;
        while (i < live) {
            p[i] = p[this.rpos + i];
            i = i + 1;
        }
        this.rbuf.truncate(live);
        this.rpos = 0;
    }

    /// The socket, for callers that need it directly (`shutdown_write`, socket
    /// options). Not for reading or writing — that would desynchronize the
    /// buffers.
    socket(mut &this) -> TcpStream* {
        return &this.stream;
    }
}

implement trait AsyncRead for struct TcpConn {
    async fill(mut &this) -> Result<u64, IoError> {
        this.compact();

        // An array exposes only `[0; length]`, so a capacity-only buffer has
        // nothing to read into: size it with `resize`.
        mut sc: Array<u8> = Array<u8>::new();
        mem::swap<Array<u8>>(&sc, &this.scratch);
        sc.resize(FILL_CHUNK, 0u8);

        mut s: TcpStream = TcpStream::from_fd(-1);
        mem::swap<TcpStream>(&s, &this.stream);

        mut io: TcpIo = await TcpRead::start(s, sc);

        // Put the socket back first: every exit below must leave the connection
        // holding its real socket rather than the placeholder.
        mut spare: TcpStream = io.take_stream();
        mem::swap<TcpStream>(&spare, &this.stream);

        mut got: Array<u8> = io.take_buf();
        const n: u64 = got.length();
        mut failed: boolean = false;
        mut err: IoError = IoError::new(IoErrorKind::Other, 0);
        match (io.outcome()) {
            Result::Ok(_)  => { }
            Result::Err(e) => { failed = true; err = e; }
        }
        if (!failed && n > 0) {
            match (this.rbuf.try_append(got.as_slice())) {
                Result::Ok(_)  => { }
                Result::Err(_) => {
                    failed = true;
                    err = IoError::new(IoErrorKind::OutOfMemory, 0);
                }
            }
        }
        // Keep the block for the next fill; `got` is left holding the old empty
        // scratch and released with the frame.
        got.clear();
        mem::swap<Array<u8>>(&got, &this.scratch);

        if (failed) { return Result::Err(err); }
        return Result::Ok(n);
    }

    buffered(&this) -> Slice<u8> {
        return Slice<u8>::from_raw(this.rbuf.as_ptr() + this.rpos,
                                   this.rbuf.length() - this.rpos);
    }

    consume(mut &this, count: u64) -> void {
        this.rpos = this.rpos + count;
    }
}

implement trait AsyncWrite for TcpConn {
    pending(mut &this) -> Array<u8>* {
        return &this.wbuf;
    }

    async flush(mut &this) -> Result<(), IoError> {
        while (this.wbuf.length() > 0) {
            mut out: Array<u8> = Array<u8>::new();
            mem::swap<Array<u8>>(&out, &this.wbuf);

            mut s: TcpStream = TcpStream::from_fd(-1);
            mem::swap<TcpStream>(&s, &this.stream);

            mut io: TcpIo = await TcpWrite::start(s, out);

            mut spare: TcpStream = io.take_stream();
            mem::swap<TcpStream>(&spare, &this.stream);

            // The write hands the buffer back UNTOUCHED, so a short write still
            // has every byte it has not sent yet; requeue the tail.
            mut sent_buf: Array<u8> = io.take_buf();
            mut moved: u64 = 0;
            mut failed: boolean = false;
            mut err: IoError = IoError::new(IoErrorKind::Other, 0);
            match (io.outcome()) {
                Result::Ok(k)  => { moved = k; }
                Result::Err(e) => { failed = true; err = e; }
            }
            // A sink that repeatedly refuses progress is reported rather than
            // spun on.
            if (!failed && moved == 0) {
                failed = true;
                err = IoError::new(IoErrorKind::WriteZero, 0);
            }

            mut rest: Array<u8> = Array<u8>::new();
            const total: u64 = sent_buf.length();
            const keep_from: u64 = if (failed) { 0 } else { moved };
            if (keep_from < total) {
                match (rest.try_append(sent_buf.as_slice().subslice(keep_from, total))) {
                    Result::Ok(_)  => { }
                    Result::Err(_) => {
                        failed = true;
                        err = IoError::new(IoErrorKind::OutOfMemory, 0);
                    }
                }
            }
            mem::swap<Array<u8>>(&rest, &this.wbuf);

            // On failure the unsent bytes are back in `wbuf`, so a caller that
            // can retry still has them.
            if (failed) { return Result::Err(err); }
        }
        return Result::Ok(());
    }
}

implement trait Drop for struct TcpConn {
    drop(mut &this) -> void {
        this.stream.drop();
        this.rbuf.drop();
        this.scratch.drop();
        this.wbuf.drop();
    }
}
