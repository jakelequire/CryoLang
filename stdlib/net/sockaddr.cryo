///! sockaddr_in packing/unpacking + socket-option helpers.
///!
///! Both `net::tcp` and `net::udp` translate between Cryo's
///! `SocketAddr` and the platform `struct sockaddr_in`; this module is
///! the shared, single home for that conversion plus the `timeval`
///! packing behind `SO_RCVTIMEO` / `SO_SNDTIMEO`.
///!
///! `sockaddr_in` is packed by hand: 16 bytes, family + port + addr
///! + 8 bytes padding, port/addr in network byte order. That avoids
///! needing cryoc to model C struct layouts for every sockaddr
///! variant. The inverse, `unpack_sockaddr_in`, reads those same
///! offsets back out of a kernel-filled buffer (e.g. from `recvfrom`
///! or `getsockname`).

namespace std::net::sockaddr;

import core::option;
import core::result;
import io::error;
import net::ip;
import net::socket_addr;

// `SO_RCVTIMEO`/`SO_SNDTIMEO` setting moved to `net::sys::set_timeout` (the
// option format - `struct timeval` vs a Windows DWORD - and the SO_* constant
// values are platform-specific, so they belong with the other gated socket
// primitives).

/// Pack a `SocketAddr` into a 16-byte `sockaddr_in` buffer. Returns
/// the number of bytes written (always 16 for IPv4), or an
/// `Unsupported` error for IPv6; the v6 path will want a 28-byte
/// `sockaddr_in6` packer, which isn't implemented yet.
function pack_sockaddr_in(out: u8*, addr: &SocketAddr) -> Result<u32, IoError> {
    match (addr.ip) {
        IpAddr::V4(v4) => {
            // sin_family = AF_INET, host byte order
            out[0] = 2;
            out[1] = 0;
            // sin_port, network byte order (big-endian)
            out[2] = (addr.port >> 8) as u8;
            out[3] = (addr.port & 0xFF) as u8;
            // sin_addr, network byte order
            out[4] = v4.a;
            out[5] = v4.b;
            out[6] = v4.c;
            out[7] = v4.d;
            // 8 bytes of sin_zero padding
            mut i: u64 = 8;
            while (i < 16) { out[i] = 0; i++; }
            return Result::Ok(16);
        }
        IpAddr::V6(_) => {
            return Result::Err(IoError::new(IoErrorKind::Unsupported, 0));
        }
    }
}

/// Read an IPv4 `sockaddr_in` back out of a kernel-filled buffer (the
/// `recvfrom` source address, or `getsockname`'s local address). Reads
/// `sin_port` (offset 2, big-endian) and `sin_addr` (offset 4, network
/// order). The family at offset 0 is assumed `AF_INET`; the socket
/// layer only ever creates v4 sockets, so a v6 reply can't appear here.
function unpack_sockaddr_in(buf: u8*) -> SocketAddr {
    const port: u16 = ((buf[2] as u16) << 8) | (buf[3] as u16);
    const v4: IpV4Addr = IpV4Addr::new(buf[4], buf[5], buf[6], buf[7]);
    return SocketAddr::new(IpAddr::V4(v4), port);
}
