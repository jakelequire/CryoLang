///! net::address: addressing primitives.
///!
///! The values that name a network endpoint, independent of any socket or
///! protocol:
///!
///!   - `ip`          - `IpAddress` (v4 / v6) and its parsers.
///!   - `socket_address` - `SocketAddress`, an `(IpAddress, port)` pair.
///!   - `url`         - `Url::parse` for absolute URLs.
///!
///! `socket_address_storage`, internal to the standard library, packs a `SocketAddress`
///! into the C `sockaddr` storage the socket calls take and reads one back.

namespace std::net::address;

module {
    net::address::ip;
    net::address::socket_address;
    net::address::url;
}

internal module net::address::socket_address_storage;

export std::net::address::ip::{ IpAddress, IpV4Address, IpV6Address };
export std::net::address::socket_address::{ SocketAddress };
export std::net::address::url::{ Url, UrlError };
