///! sockaddr_in packing/unpacking + socket-option helpers.
///!
///! Both `net::socket::tcp` and `net::socket::udp` translate between Cryo's
///! `SocketAddress` and the platform `struct sockaddr_in`; this module is
///! the shared, single home for that conversion plus the `timeval`
///! packing behind `SO_RCVTIMEO` / `SO_SNDTIMEO`.
///!
///! `sockaddr_in` is packed by hand: 16 bytes, family + port + addr
///! + 8 bytes padding, port/addr in network byte order. That avoids
///! needing cryoc to model C struct layouts for every sockaddr
///! variant. The inverse, `unpack_sockaddr_in`, reads those same
///! offsets back out of a kernel-filled buffer (e.g. from `recvfrom`
///! or `getsockname`).

namespace std::net::address::socket_address_storage;

import std::core::option;
import std::core::result::{ Result };
import std::core::slice::{ Slice };
import std::io::error::{ IoError, IoErrorKind };
import std::io::bytes::{ ByteReader, ByteWriter };
import std::net::address::ip::{ IpAddress, IpV4Address, IpV6Address };
import std::net::address::socket_address::{ SocketAddress };

// `SO_RCVTIMEO`/`SO_SNDTIMEO` settings live in `net::sys::set_timeout`: the
// option format - `struct timeval` vs a Windows DWORD - and the SO_* constant
// values are platform-specific, so they belong with the other gated socket
// primitives.

/// AF_INET6 family value (host byte order): 10 on Linux glibc, 23 on
/// Win32 Winsock. The `sockaddr_in6` layout is otherwise identical
/// (28 bytes) on both, so only this value differs per OS.
![target(unix)]
private function af_inet6() -> u16 { return 10; }
![target(windows)]
private function af_inet6() -> u16 { return 23; }

/// Pack a `SocketAddress` into a `sockaddr_in` (16 bytes, IPv4) or
/// `sockaddr_in6` (28 bytes, IPv6) at the front of `out`. Returns the
/// number of bytes written, or `InvalidInput` when `out` is shorter than
/// the address's layout; 28 bytes hold either.
internal function pack_sockaddr_in(out: mut &Slice<u8>, addr: &SocketAddress) -> Result<u32, IoError> {
    mut needed: i64 = 16;
    match (addr.ip) {
        IpAddress::V4(_) => { }
        IpAddress::V6(_) => { needed = 28; }
    }
    if (out.length() < needed) {
        return Result::Err(IoError::new(IoErrorKind::InvalidInput, 0));
    }
    match (addr.ip) {
        IpAddress::V4(v4) => {
            mut w: ByteWriter = ByteWriter::over(out.subslice_mutable(0, 16));
            // sin_family = AF_INET, host byte order (low byte first on
            // our little-endian targets)
            w.write_little_endian::<u16>(2);
            // sin_port and sin_addr, network byte order
            w.write_big_endian::<u16>(addr.port);
            w.write_big_endian::<u8>(v4.a);
            w.write_big_endian::<u8>(v4.b);
            w.write_big_endian::<u8>(v4.c);
            w.write_big_endian::<u8>(v4.d);
            // 8 bytes of sin_zero padding
            w.write_little_endian::<u64>(0);
            return Result::Ok(16);
        }
        IpAddress::V6(v6) => {
            mut w: ByteWriter = ByteWriter::over(out.subslice_mutable(0, 28));
            // sin6_family = AF_INET6, host byte order
            w.write_little_endian::<u16>(af_inet6());
            // sin6_port, network byte order
            w.write_big_endian::<u16>(addr.port);
            // sin6_flowinfo = 0
            w.write_little_endian::<u32>(0);
            // sin6_addr: 16 bytes, already network order in `segments`
            mut j: i64 = 0;
            while (j < 16) { w.write_big_endian::<u8>(v6.segments[j]); j++; }
            // sin6_scope_id = 0
            w.write_little_endian::<u32>(0);
            return Result::Ok(28);
        }
    }
}

/// Read an IPv4 `sockaddr_in` back out of a kernel-filled buffer (the
/// `recvfrom` source address, or `getsockname`'s local address). Reads
/// `sin_port` (offset 2, big-endian) and `sin_addr` (offset 4, network
/// order). The family at offset 0 is assumed `AF_INET`; the socket
/// layer only ever creates v4 sockets, so a v6 reply can't appear here.
/// Panics on a buffer shorter than the 8 bytes it reads.
internal function unpack_sockaddr_in(buffer: &Slice<u8>) -> SocketAddress {
    mut fields: ByteReader = ByteReader::new(buffer.subslice(0, 8));
    fields.set_position(2);
    const port: u16 = fields.read_big_endian::<u16>().unwrap();
    const a: u8 = fields.read_big_endian::<u8>().unwrap();
    const b: u8 = fields.read_big_endian::<u8>().unwrap();
    const c: u8 = fields.read_big_endian::<u8>().unwrap();
    const d: u8 = fields.read_big_endian::<u8>().unwrap();
    const v4: IpV4Address = IpV4Address::new(a, b, c, d);
    return SocketAddress::new(IpAddress::V4(v4), port);
}

/// Unpack either a v4 `sockaddr_in` or a v6 `sockaddr_in6` from a
/// kernel-filled buffer, dispatching on the family at offset 0. Used by
/// `getsockname`-style readback where the socket may be either family.
/// Panics on a buffer shorter than the family's layout (28 bytes for v6).
internal function unpack_sockaddr(buffer: &Slice<u8>) -> SocketAddress {
    // The family is in host order (little-endian on every supported
    // target), the port in network order.
    mut fields: ByteReader = ByteReader::new(buffer.subslice(0, 4));
    const fam: u16 = fields.read_little_endian::<u16>().unwrap();
    if (fam == af_inet6()) {
        const port: u16 = fields.read_big_endian::<u16>().unwrap();
        const v6: IpV6Address = IpV6Address::from_bytes(buffer.subslice(8, 24)).unwrap();
        return SocketAddress::new(IpAddress::V6(v6), port);
    }
    return unpack_sockaddr_in(buffer);
}
