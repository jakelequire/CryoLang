///! SocketAddress: (IP, port).
///!
///! Used everywhere a listener binds or a client connects. `parse_v4`
///! accepts `a.b.c.d:port`. The bracketed `[v6]:port` form has no
///! parser here: read the address with `IpV6Address::parse` and pair it
///! with the port through `new`.

namespace std::net::address::socket_address;

import std::core::option::{ Option };
import std::core::result::{ Result };
import std::core::convert;
import std::collections::str::{ Str };
import std::net::address::ip::{ IpAddress, IpV4Address, IpV6Address };
import std::fmt::display::{ Debug, Display, Formatter };
import std::fmt::error::{ FormatError };

/// An IP address and a port: the endpoint a socket binds or connects to.
/// Printed as `a.b.c.d:port`, or `[v6]:port` for IPv6.
///
/// ```cryo
/// import std::collections::str::{ Str };
/// import std::net::address::ip::{ IpAddress, IpV6Address };
/// import std::net::address::socket_address::{ SocketAddress };
///
/// const v4: SocketAddress = SocketAddress::parse_v4(Str::new("127.0.0.1:8080")).unwrap();
/// const v6: SocketAddress = SocketAddress::new(IpAddress::V6(IpV6Address::localhost()), 8080);
/// // v4.port == 8080; v6 prints as `[::1]:8080`
/// ```
public type struct SocketAddress {
    public ip: IpAddress;
    public port: u16;

    /// The endpoint `ip`:`port`.
    public static new(ip: IpAddress, port: u16) -> SocketAddress {
        return SocketAddress { ip: ip, port: port };
    }

    /// `0.0.0.0:port`: bind on every IPv4 interface.
    public static any_v4(port: u16) -> SocketAddress {
        return SocketAddress {
            ip: IpAddress::V4(IpV4Address::unspecified()),
            port: port
        };
    }

    /// `127.0.0.1:port`: bind/connect on the loopback interface.
    public static localhost_v4(port: u16) -> SocketAddress {
        return SocketAddress {
            ip: IpAddress::V4(IpV4Address::localhost()),
            port: port
        };
    }

    /// `[::]:port`: bind on every IPv6 interface.
    public static any_v6(port: u16) -> SocketAddress {
        return SocketAddress {
            ip: IpAddress::V6(IpV6Address::unspecified()),
            port: port
        };
    }

    /// `[::1]:port`: bind/connect on the IPv6 loopback interface.
    public static localhost_v6(port: u16) -> SocketAddress {
        return SocketAddress {
            ip: IpAddress::V6(IpV6Address::localhost()),
            port: port
        };
    }

    /// Parse `a.b.c.d:port`. Returns `None` if the address or port
    /// is malformed or the port is out of range (u16).
    public static parse_v4(source: Str) -> Option<SocketAddress> {
        // Find the ':' separator from the right so IPv6 (with colons
        // in the address) fails cleanly here rather than silently
        // misparsing.
        mut colon: i64 = source.length();
        mut i: i64 = 0;
        while (i < source.length()) {
            match (source.byte_at(i)) {
                Option::Some(byte) => {
                    if (byte == 0x3A) { colon = i; }
                }
                Option::None => { return Option::None; }
            }
            i++;
        }
        if (colon == source.length()) { return Option::None; }

        const addr_part: Str = source.byte_substring(0, colon);
        const port_part: Str = source.byte_substring(colon + 1, source.length());

        match (IpV4Address::parse_opt(addr_part)) {
            Option::Some(v4) => {
                match (u16::try_from(port_part)) {
                    Result::Ok(port) => {
                        return Option::Some(SocketAddress {
                            ip: IpAddress::V4(v4),
                            port: port
                        });
                    }
                    Result::Err(_) => { return Option::None; }
                }
            }
            Option::None => { return Option::None; }
        }
    }
}

/// `a.b.c.d:port`, or an IPv6 address in brackets with the port outside
/// them (RFC 3986), `[::1]:port`.
implement trait Display for struct SocketAddress {
    fmt(&this, f: mut &Formatter) -> Result<(), FormatError> {
        match (&this.ip) {
            IpAddress::V4(v4) => {
                (Display for IpV4Address)::fmt(&v4, f)?;
            }
            IpAddress::V6(v6) => {
                f.write_str(Str::new("["))?;
                (Display for IpV6Address)::fmt(&v6, f)?;
                f.write_str(Str::new("]"))?;
            }
        }
        f.write_str(Str::new(":"))?;
        return (Display for u16)::fmt(&this.port, f);
    }
}

/// The text form, `127.0.0.1:8080`, which already says everything the
/// value holds.
implement trait Debug for struct SocketAddress {
    fmt(&this, f: mut &Formatter) -> Result<(), FormatError> {
        return (Display for SocketAddress)::fmt(this, f);
    }
}
