///! SocketAddress: (IP, port).
///!
///! Used everywhere a listener binds or a client connects. `parse` reads
///! the text `Display` writes, `a.b.c.d:port` or `[v6]:port`, and says why
///! any other text is refused.

namespace std::net::address::socket_address;

import std::core::option::{ Option };
import std::core::result::{ Result };
import std::core::convert;
import std::core::convert::{ ConversionError };
import std::collections::str::{ Str };
import std::net::address::ip::{ IpAddress, IpV4Address, IpV6Address };
import std::fmt::display::{ Debug, Display, Formatter };
import std::fmt::error::{ FormatError };

/// An IP address and a port: the endpoint a socket binds or connects to.
/// Printed as `a.b.c.d:port`, or `[v6]:port` for IPv6.
///
/// ```cryo
/// import std::collections::str::{ Str };
/// import std::net::address::ip::{ IpAddress, IpV6Address };
/// import std::net::address::socket_address::{ SocketAddress };
///
/// const v4: SocketAddress = SocketAddress::parse("127.0.0.1:8080").unwrap();
/// const v6: SocketAddress = SocketAddress::new(IpAddress::V6(IpV6Address::localhost()), 8080);
/// // v4.port == 8080; v6 prints as `[::1]:8080`, which `parse` reads back
/// ```
public type struct SocketAddress {
    public ip: IpAddress;
    public port: u16;

    /// The endpoint `ip`:`port`.
    public static new(ip: IpAddress, port: u16) -> SocketAddress {
        return SocketAddress { ip: ip, port: port };
    }

    /// `0.0.0.0:port`: bind on every IPv4 interface.
    public static any_v4(port: u16) -> SocketAddress {
        return SocketAddress {
            ip: IpAddress::V4(IpV4Address::unspecified()),
            port: port
        };
    }

    /// `127.0.0.1:port`: bind/connect on the loopback interface.
    public static localhost_v4(port: u16) -> SocketAddress {
        return SocketAddress {
            ip: IpAddress::V4(IpV4Address::localhost()),
            port: port
        };
    }

    /// `[::]:port`: bind on every IPv6 interface.
    public static any_v6(port: u16) -> SocketAddress {
        return SocketAddress {
            ip: IpAddress::V6(IpV6Address::unspecified()),
            port: port
        };
    }

    /// `[::1]:port`: bind/connect on the IPv6 loopback interface.
    public static localhost_v6(port: u16) -> SocketAddress {
        return SocketAddress {
            ip: IpAddress::V6(IpV6Address::localhost()),
            port: port
        };
    }

    /// Parse an endpoint in the form `Display` writes: `a.b.c.d:port`, or
    /// an IPv6 address in brackets with the port after them, `[::1]:8080`
    /// (RFC 3986).  The port is a decimal number from 0 to 65535.  Refused,
    /// with what was wrong, when the text has neither form, its address
    /// does not parse, an IPv6 address is not in brackets, or the port is
    /// not such a number.
    public static parse(source: Str) -> Result<SocketAddress, ConversionError> {
        mut address: Str = source;
        mut port_text: Str = source;
        mut ip: Option<IpAddress> = Option::None;
        if (source.starts_with("[")) {
            match (source.split_once("]:")) {
                Option::Some(parts) => {
                    address = parts.first.byte_substring(1, parts.first.length());
                    port_text = parts.second;
                }
                Option::None => {
                    return Result::Err(ConversionError::new("an IPv6 socket address is written `[address]:port`"));
                }
            }
            match (IpV6Address::parse_opt(address)) {
                Option::Some(v6) => { ip = Option::Some(IpAddress::V6(v6)); }
                Option::None => { return Result::Err(ConversionError::new("invalid IPv6 address")); }
            }
        } else {
            match (source.split_once_from_end(":")) {
                Option::Some(parts) => {
                    address = parts.first;
                    port_text = parts.second;
                }
                Option::None => {
                    return Result::Err(ConversionError::new("a socket address is written `address:port`"));
                }
            }
            if (address.find_byte(0x3A).is_some()) {
                return Result::Err(ConversionError::new("an IPv6 socket address is written `[address]:port`"));
            }
            match (IpV4Address::parse_opt(address)) {
                Option::Some(v4) => { ip = Option::Some(IpAddress::V4(v4)); }
                Option::None => { return Result::Err(ConversionError::new("invalid IPv4 address")); }
            }
        }
        return match (u16::try_from(port_text)) {
            Result::Ok(port) => { Result::Ok(SocketAddress { ip: ip.unwrap(), port: port }) }
            Result::Err(_) => { Result::Err(ConversionError::new("the port is not a number from 0 to 65535")) }
        };
    }
}

/// `a.b.c.d:port`, or an IPv6 address in brackets with the port outside
/// them (RFC 3986), `[::1]:port`.
implement trait Display for struct SocketAddress {
    fmt(&this, f: mut &Formatter) -> Result<(), FormatError> {
        match (&this.ip) {
            IpAddress::V4(v4) => {
                (Display for IpV4Address)::fmt(&v4, f)?;
            }
            IpAddress::V6(v6) => {
                f.write_str(Str::new("["))?;
                (Display for IpV6Address)::fmt(&v6, f)?;
                f.write_str(Str::new("]"))?;
            }
        }
        f.write_str(Str::new(":"))?;
        return (Display for u16)::fmt(&this.port, f);
    }
}

/// The text form, `127.0.0.1:8080`, which already says everything the
/// value holds.
implement trait Debug for struct SocketAddress {
    fmt(&this, f: mut &Formatter) -> Result<(), FormatError> {
        return (Display for SocketAddress)::fmt(this, f);
    }
}
