///! TCP sockets.
///!
///! `TcpListener` binds an address and accepts connections;
///! `TcpStream` is a connected socket implementing `Read + Write`.
///! Both own a POSIX file descriptor and must have `drop` called
///! before going out of scope.
///!
///! `sockaddr_in` is packed by hand: 16 bytes, family + port + addr
///! + 8 bytes padding, port/addr in network byte order. That avoids
///! needing cryoc to model C struct layouts for every sockaddr
///! variant.

namespace std::net::tcp;

import core::option;
import core::result;
import core::slice;
import io::error;
import io::fd;
import io::traits;
import ffi::libc;
import net::ip;
import net::socket_addr;
import net::sockaddr;
import net::sys;

// Socket-domain / type / level / option / shutdown constants and
// the `ShutdownHow` enum live in `ffi::libc`. `sockaddr_in` packing
// and the `SO_*TIMEO` helper are shared with `net::udp` in
// `net::sockaddr`.

// Open a TCP socket of the family matching `addr` (AF_INET vs AF_INET6).
// Lives here, not in `net::sys`, so `sys` stays free of net::ip imports.
function tcp_socket_for(addr: &SocketAddr) -> i32 {
    match (addr.ip) {
        IpAddr::V4(_) => { return sys::os_socket_tcp(); }
        IpAddr::V6(_) => { return sys::os_socket_tcp6(); }
    }
}

// TcpStream: connected socket

type struct TcpStream {
    fd: i32;

    /// Connect to `remote` (IPv4 or IPv6). Fails with the mapped `errno`
    /// kind on refusal, timeout, or an unreachable host.
    static connect(remote: SocketAddr) -> Result<TcpStream, IoError> {
        // Pack first so an unsupported address family doesn't leak
        // a freshly-opened socket fd. 28 bytes holds a v6 sockaddr_in6.
        mut sockaddr_buf: u8[28];
        const len: u32 = sockaddr::pack_sockaddr_in(&sockaddr_buf[0], &remote)?;

        // `SOCK_CLOEXEC` opens the socket close-on-exec so a concurrent
        // `fork`+`exec` does not leak it into the child. The socket family
        // matches the address (AF_INET vs AF_INET6).
        const sock: i32 = tcp_socket_for(&remote);
        if (sock < 0) {
            return Result::Err(sys::last_io_error());
        }
        const rc: i32 = sys::os_connect(sock, &sockaddr_buf[0], len);
        if (rc < 0) {
            const err: IoError = sys::last_io_error();
            sys::os_close_sock(sock);
            return Result::Err(err);
        }
        return Result::Ok(TcpStream { fd: sock });
    }

    /// Wrap a raw file descriptor. The caller transfers ownership;
    /// `drop` will close it. Used by `TcpListener::accept`.
    static from_fd(sock: i32) -> TcpStream {
        return TcpStream { fd: sock };
    }

    /// Borrow the underlying file descriptor without transferring
    /// ownership. The `TcpStream` still closes it on `drop`. Used by
    /// `net::tls` to hand the fd to OpenSSL's socket BIO (which is
    /// created `BIO_NOCLOSE`, so the fd stays this stream's to close).
    raw_fd(&this) -> i32 {
        return this.fd;
    }

    /// Close the write half. Signals "no more from me" without tearing
    /// down the read path. Useful for protocols where the client
    /// sends then reads to EOF.
    shutdown_write(mut &this) -> Result<(), IoError> {
        if (sys::os_shutdown(this.fd, 1) < 0) {
            return Result::Err(sys::last_io_error());
        }
        return Result::Ok(());
    }

    /// Cap blocking-`read` latency.  After `secs` + `usecs` of no data
    /// the next `read()` returns `WouldBlock` (errno `EAGAIN`).  Pass
    /// 0/0 to clear an existing timeout.  Pairs with
    /// `set_write_timeout` for full slow-loris coverage.
    set_read_timeout(mut &this, secs: i64, usecs: i64) -> Result<(), IoError> {
        return sys::set_timeout(this.fd, true, secs, usecs);
    }

    /// Cap blocking-`write` latency.  After `secs` + `usecs` of no
    /// progress the next `write()` returns `WouldBlock` (errno
    /// `EAGAIN`).  Pass 0/0 to clear.
    set_write_timeout(mut &this, secs: i64, usecs: i64) -> Result<(), IoError> {
        return sys::set_timeout(this.fd, false, secs, usecs);
    }

    /// Close both halves. Ownership obligation: every TcpStream must
    /// have `drop` called before going out of scope.
    drop(mut &this) -> void {
        if (this.fd >= 0) {
            sys::os_close_sock(this.fd);
            this.fd = -1;
        }
    }
}

implement trait Read for struct TcpStream {
    read(mut &this, buffer: u8*, length: u64) -> Result<u64, IoError> {
        return sys::sock_read(this.fd, buffer, length);
    }
}

implement trait Write for struct TcpStream {
    write(mut &this, bytes: Slice<u8>) -> Result<u64, IoError> {
        return sys::sock_write(this.fd, bytes.as_ptr(), bytes.length());
    }

    flush(mut &this) -> Result<(), IoError> {
        return Result::Ok(());
    }
}

// TcpListener: bound + listening socket

type struct TcpListener {
    fd: i32;

    /// Bind + listen on `local` (IPv4 or IPv6). Sets `SO_REUSEADDR` so
    /// restarts don't wait out the TIME_WAIT window. Backlog defaults to
    /// 128, the same number Linux uses for `/proc/sys/net/core/somaxconn`
    /// these days.
    static bind(local: SocketAddr) -> Result<TcpListener, IoError> {
        // Pack first so an unsupported address family doesn't leak
        // a freshly-opened socket fd. 28 bytes holds a v6 sockaddr_in6.
        mut sockaddr_buf: u8[28];
        const len: u32 = sockaddr::pack_sockaddr_in(&sockaddr_buf[0], &local)?;

        // `SOCK_CLOEXEC` opens the listening socket close-on-exec so a
        // concurrent `fork`+`exec` does not leak it into the child. The
        // socket family matches the address (AF_INET vs AF_INET6).
        const sock: i32 = tcp_socket_for(&local);
        if (sock < 0) {
            return Result::Err(sys::last_io_error());
        }

        sys::os_set_reuseaddr(sock);

        if (sys::os_bind(sock, &sockaddr_buf[0], len) < 0) {
            const err: IoError = sys::last_io_error();
            sys::os_close_sock(sock);
            return Result::Err(err);
        }
        if (sys::os_listen(sock, 128) < 0) {
            const err: IoError = sys::last_io_error();
            sys::os_close_sock(sock);
            return Result::Err(err);
        }
        return Result::Ok(TcpListener { fd: sock });
    }

    /// Block until a connection arrives, then return the accepted
    /// `TcpStream`. The peer address is intentionally dropped; most
    /// callers ignore it; a `accept_with_peer` variant can surface it
    /// when a caller needs it.
    accept(mut &this) -> Result<TcpStream, IoError> {
        // 28 bytes / addrlen 28: a v6 listener's accept fills a 28-byte
        // sockaddr_in6, which must not truncate into a 16-byte buffer.
        mut sockaddr_buf: u8[28];
        mut addrlen: u32 = 28;
        loop {
            // `accept4` with `SOCK_CLOEXEC`: an accepted fd does NOT
            // inherit the listener's close-on-exec, so set it atomically
            // here to avoid leaking the connection into a forked child.
            const client_fd: i32 = sys::os_accept(this.fd, &sockaddr_buf[0], &addrlen);
            if (client_fd >= 0) {
                return Result::Ok(TcpStream::from_fd(client_fd));
            }
            const err: IoError = sys::last_io_error();
            match (err.kind) {
                IoErrorKind::Interrupted => { }
                _ => { return Result::Err(err); }
            }
        }
    }

    /// Close the listening socket. Ownership obligation: every
    /// TcpListener must have `drop` called before going out of scope.
    drop(mut &this) -> void {
        if (this.fd >= 0) {
            sys::os_close_sock(this.fd);
            this.fd = -1;
        }
    }
}
