///! TCP sockets.
///!
///! `TcpListener` binds an address and accepts connections;
///! `TcpStream` is a connected socket implementing `Read + Write`.
///! Both own a POSIX file descriptor and must have `drop` called
///! before going out of scope.
///!
///! `sockaddr_in` is packed by hand: 16 bytes, family + port + addr
///! + 8 bytes padding, port/addr in network byte order. That avoids
///! needing cryoc to model C struct layouts for every sockaddr
///! variant.

namespace std::net::tcp;

import core::option;
import core::result;
import core::slice;
import io::error;
import io::fd;
import io::traits;
import ffi::libc;
import net::ip;
import net::socket_addr;

// Socket-domain / type / level / option / shutdown constants and
// the `ShutdownHow` enum live in `ffi::libc`.

/// Apply a `SO_RCVTIMEO` / `SO_SNDTIMEO` to a socket fd.  Packs the
/// 16-byte `struct timeval` (host byte order, two `i64`s) into a
/// stack buffer rather than passing the struct by pointer; this keeps
/// the same shape as `pack_sockaddr_in` and avoids depending on the
/// compiler emitting `&struct as u8*` as a literal byte-addressable
/// pointer.
function apply_so_timeout(fd: i32, optname: i32, secs: i64, usecs: i64) -> Result<(), IoError> {
    mut buf: u8[16];
    pack_i64_le(&buf[0], secs);
    pack_i64_le(&buf[8], usecs);
    const rc: i32 = libc::setsockopt(fd,
                                      libc::SocketLevel::SOL_SOCKET,
                                      optname,
                                      &buf[0], 16);
    if (rc < 0) {
        return Result::Err(IoError::from_errno(libc::errno()));
    }
    return Result::Ok(());
}

/// Little-endian pack of an `i64` into 8 bytes at `out`.  Linux
/// x86_64 / arm64 are LE; the host-order assumption matches every
/// other libc struct field in this module.
function pack_i64_le(out: u8*, value: i64) -> void {
    const v: u64 = value as u64;
    out[0] = (v       ) as u8;
    out[1] = (v >> 8  ) as u8;
    out[2] = (v >> 16 ) as u8;
    out[3] = (v >> 24 ) as u8;
    out[4] = (v >> 32 ) as u8;
    out[5] = (v >> 40 ) as u8;
    out[6] = (v >> 48 ) as u8;
    out[7] = (v >> 56 ) as u8;
}

/// Pack a `SocketAddr` into a 16-byte `sockaddr_in` buffer. Returns
/// the number of bytes written (always 16 for IPv4), or an
/// `Unsupported` error for IPv6; the v6 path will want a 28-byte
/// `sockaddr_in6` packer, which isn't implemented yet.
function pack_sockaddr_in(out: u8*, addr: &SocketAddr) -> Result<u32, IoError> {
    match (addr.ip) {
        IpAddr::V4(v4) => {
            // sin_family = AF_INET, host byte order
            out[0] = 2;
            out[1] = 0;
            // sin_port, network byte order (big-endian)
            out[2] = (addr.port >> 8) as u8;
            out[3] = (addr.port & 0xFF) as u8;
            // sin_addr, network byte order
            out[4] = v4.a;
            out[5] = v4.b;
            out[6] = v4.c;
            out[7] = v4.d;
            // 8 bytes of sin_zero padding
            mut i: u64 = 8;
            while (i < 16) { out[i] = 0; i++; }
            return Result::Ok(16);
        }
        IpAddr::V6(_) => {
            return Result::Err(IoError::new(IoErrorKind::Unsupported, 0));
        }
    }
}

// TcpStream: connected socket

type struct TcpStream {
    fd: i32;

    /// Connect to `remote`. Fails with the mapped `errno` kind on
    /// refusal, timeout, or an unreachable host. Returns
    /// `IoErrorKind::Unsupported` for IPv6 addresses until v6
    /// packing lands.
    static connect(remote: SocketAddr) -> Result<TcpStream, IoError> {
        // Pack first so an unsupported address family doesn't leak
        // a freshly-opened socket fd.
        mut sockaddr_buf: u8[16];
        const len: u32 = match (pack_sockaddr_in(&sockaddr_buf[0], &remote)) {
            Result::Ok(n) => { n }
            Result::Err(e) => { return Result::Err(e); }
        };

        const sock: i32 = libc::socket(
            libc::AddressFamily::AF_INET,
            libc::SOCK_STREAM,
            libc::Protocol::IPPROTO_IP);
        if (sock < 0) {
            return Result::Err(IoError::from_errno(libc::errno()));
        }
        const rc: i32 = libc::connect(sock, &sockaddr_buf[0], len);
        if (rc < 0) {
            const err: IoError = IoError::from_errno(libc::errno());
            fd::close_fd(sock);
            return Result::Err(err);
        }
        return Result::Ok(TcpStream { fd: sock });
    }

    /// Wrap a raw file descriptor. The caller transfers ownership;
    /// `drop` will close it. Used by `TcpListener::accept`.
    static from_fd(sock: i32) -> TcpStream {
        return TcpStream { fd: sock };
    }

    /// Close the write half. Signals "no more from me" without tearing
    /// down the read path. Useful for protocols where the client
    /// sends then reads to EOF.
    shutdown_write(mut &this) -> Result<(), IoError> {
        if (libc::shutdown(this.fd, libc::ShutdownHow::SHUT_WR) < 0) {
            return Result::Err(IoError::from_errno(libc::errno()));
        }
        return Result::Ok(());
    }

    /// Cap blocking-`read` latency.  After `secs` + `usecs` of no data
    /// the next `read()` returns `WouldBlock` (errno `EAGAIN`).  Pass
    /// 0/0 to clear an existing timeout.  Pairs with
    /// `set_write_timeout` for full slow-loris coverage.
    set_read_timeout(mut &this, secs: i64, usecs: i64) -> Result<(), IoError> {
        return apply_so_timeout(this.fd, libc::SO_RCVTIMEO, secs, usecs);
    }

    /// Cap blocking-`write` latency.  After `secs` + `usecs` of no
    /// progress the next `write()` returns `WouldBlock` (errno
    /// `EAGAIN`).  Pass 0/0 to clear.
    set_write_timeout(mut &this, secs: i64, usecs: i64) -> Result<(), IoError> {
        return apply_so_timeout(this.fd, libc::SO_SNDTIMEO, secs, usecs);
    }

    /// Close both halves. Ownership obligation: every TcpStream must
    /// have `drop` called before going out of scope.
    drop(mut &this) -> void {
        if (this.fd >= 0) {
            fd::close_fd(this.fd);
            this.fd = -1;
        }
    }
}

implement trait Read for struct TcpStream {
    read(mut &this, buffer: u8*, length: u64) -> Result<u64, IoError> {
        return fd::read_fd(this.fd, buffer, length);
    }
}

implement trait Write for struct TcpStream {
    write(mut &this, bytes: Slice<u8>) -> Result<u64, IoError> {
        return fd::write_fd(this.fd, bytes);
    }

    flush(mut &this) -> Result<(), IoError> {
        return Result::Ok(());
    }
}

// TcpListener: bound + listening socket

type struct TcpListener {
    fd: i32;

    /// Bind + listen on `local`. Sets `SO_REUSEADDR` so restarts
    /// don't wait out the TIME_WAIT window. Backlog defaults to 128,
    /// the same number Linux uses for `/proc/sys/net/core/somaxconn`
    /// these days. Returns `IoErrorKind::Unsupported` for IPv6
    /// addresses until v6 packing lands.
    static bind(local: SocketAddr) -> Result<TcpListener, IoError> {
        // Pack first so an unsupported address family doesn't leak
        // a freshly-opened socket fd.
        mut sockaddr_buf: u8[16];
        const len: u32 = match (pack_sockaddr_in(&sockaddr_buf[0], &local)) {
            Result::Ok(n) => { n }
            Result::Err(e) => { return Result::Err(e); }
        };

        const sock: i32 = libc::socket(
            libc::AddressFamily::AF_INET,
            libc::SOCK_STREAM,
            libc::Protocol::IPPROTO_IP);
        if (sock < 0) {
            return Result::Err(IoError::from_errno(libc::errno()));
        }

        mut reuse: i32 = 1;
        libc::setsockopt(sock,
                         libc::SocketLevel::SOL_SOCKET,
                         libc::SO_REUSEADDR,
                         &reuse as u8*, 4);

        if (libc::bind(sock, &sockaddr_buf[0], len) < 0) {
            const err: IoError = IoError::from_errno(libc::errno());
            fd::close_fd(sock);
            return Result::Err(err);
        }
        if (libc::listen(sock, 128) < 0) {
            const err: IoError = IoError::from_errno(libc::errno());
            fd::close_fd(sock);
            return Result::Err(err);
        }
        return Result::Ok(TcpListener { fd: sock });
    }

    /// Block until a connection arrives, then return the accepted
    /// `TcpStream`. The peer address is intentionally dropped; most
    /// callers ignore it; a `accept_with_peer` variant can surface it
    /// when a caller needs it.
    accept(mut &this) -> Result<TcpStream, IoError> {
        mut sockaddr_buf: u8[16];
        mut addrlen: u32 = 16;
        loop {
            const client_fd: i32 = libc::accept(this.fd, &sockaddr_buf[0], &addrlen);
            if (client_fd >= 0) {
                return Result::Ok(TcpStream::from_fd(client_fd));
            }
            const err: IoError = IoError::from_errno(libc::errno());
            match (err.kind) {
                IoErrorKind::Interrupted => { }
                _ => { return Result::Err(err); }
            }
        }
    }

    /// Close the listening socket. Ownership obligation: every
    /// TcpListener must have `drop` called before going out of scope.
    drop(mut &this) -> void {
        if (this.fd >= 0) {
            fd::close_fd(this.fd);
            this.fd = -1;
        }
    }
}
