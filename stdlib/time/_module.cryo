///! std::time: durations, clocks, and civil time.
///!
///!   - `duration` - `Duration`, a normalized seconds + sub-second
///!     nanosecond span. Built and read in any unit, with checked /
///!     saturating / scaling arithmetic, and printable via `Display`
///!     (`1.5s`, `250ms`, `10ns`).
///!   - `clock` - `Instant` (monotonic, for measuring elapsed time),
///!     `SystemTime` (wall clock, for Unix timestamps), and `sleep`.
///!   - `datetime` - `DateTime`, a civil calendar reading (year / month /
///!     day / hour / ...) at a fixed `UtcOffset`, read and written as
///!     RFC 3339, with its weekday and `Duration` arithmetic.
///!
///! An `Instant` difference saturates at zero; a `SystemTime` or
///! `DateTime` one is `None` when the later reading came first.

namespace std::time;

module {
    time::duration;
    time::clock;
    time::datetime;
}
