///! std::time::clock: `Instant`, `SystemTime`, and `sleep`.
///!
///!   - `Instant` reads the monotonic clock: POSIX `CLOCK_MONOTONIC`
///!     via `clock_gettime`, or Windows `QueryPerformanceCounter`
///!     scaled by `QueryPerformanceFrequency`.  It only goes forward
///!     and is the right tool for measuring elapsed time.
///!   - `SystemTime` reads the wall clock: POSIX `CLOCK_REALTIME` or
///!     Windows `GetSystemTimePreciseAsFileTime` (FILETIME ticks
///!     since 1601-01-01, converted to Unix epoch).  Subject to NTP
///!     steps and manual changes, so NOT for elapsed-time measurement.
///!
///! `sleep(dur)` parks the current thread for at least `dur`.  POSIX
///! uses `nanosleep` with EINTR-restart; Windows uses `Sleep`
///! (millisecond resolution, rounded up).  All differences saturate at
///! zero rather than wrapping.
///!
///! The OS-divergent readings (`read_monotonic` / `read_realtime` /
///! `sleep_for`) live as free helpers below; the public `Instant::now`
///! / `SystemTime::now` / `sleep` simply delegate.  ConfigGating
///! currently strips at the free-function level, not inside struct
///! method bodies, so this is the cleanest way to keep one public
///! surface across platforms.

namespace std::time::clock;

import std::core::cmp::{ Eq, Ord, Ordering };
import std::core::option::{ Option };
import std::core::intrinsics;
import std::ffi::libc::{ ClockId, clock_gettime, nanosleep, timespec };
import std::sys::syscall::{ FILETIME, LARGE_INTEGER };
import std::time::duration::{ Duration };

private const NSEC_PER_SEC: i64 = 1000000000;

// Windows FILETIME epoch is 1601-01-01 UTC; Unix epoch is 1970-01-01.
// The difference is exactly 11644473600 seconds (134774 days * 86400)
// = 116444736000000000 100-ns ticks.  Subtract on every wall-clock read
// so SystemTime carries Unix-epoch-relative seconds on both platforms.
private const FILETIME_TO_UNIX_TICKS: i64 = 116444736000000000;
private const FILETIME_TICKS_PER_SEC: i64 = 10000000;       // 100-ns intervals
private const FILETIME_NS_PER_TICK:   i64 = 100;            // ns per 100-ns tick

/// Compute `(a_sec.a_nsec) - (b_sec.b_nsec)` as a `Duration`, borrowing
/// from the seconds when the nanoseconds underflow and clamping the whole
/// result to zero if it would go negative.
private function diff_saturating(a_sec: i64, a_nsec: i64,
                                 b_sec: i64, b_nsec: i64) -> Duration {
    mut sec:  i64 = a_sec - b_sec;
    mut nsec: i64 = a_nsec - b_nsec;
    if (nsec < 0) {
        sec  = sec - 1;
        nsec = nsec + NSEC_PER_SEC;
    }
    if (sec < 0) {
        return Duration::new(0, 0);
    }
    return Duration::new(sec as u64, nsec as u32);
}

// Instant: a monotonic-clock reading.

/// A measurement of the monotonic clock. Opaque: the fields are the raw
/// `timespec`, meaningful only relative to another `Instant`. POD.
public type struct Instant {
    private secs:  i64;
    private nanos: i64;

    /// Read the monotonic clock now.
    public static now() -> Instant {
        return read_monotonic();
    }

    /// The time elapsed from `earlier` to `this` (saturating at zero).
    public duration_since(&this, earlier: &Instant) -> Duration {
        return diff_saturating(this.secs, this.nanos, earlier.secs, earlier.nanos);
    }

    /// Alias for `duration_since`, naming the saturation explicitly.
    public saturating_duration_since(&this, earlier: &Instant) -> Duration {
        return diff_saturating(this.secs, this.nanos, earlier.secs, earlier.nanos);
    }

    /// The time elapsed from `this` until now (saturating at zero).
    public elapsed(&this) -> Duration {
        const cur: Instant = Instant::now();
        return diff_saturating(cur.secs, cur.nanos, this.secs, this.nanos);
    }

    /// This reading as raw monotonic nanoseconds, saturating at `i64::MAX`.
    /// The absolute value is meaningful only relative to another `Instant` -
    /// it counts from an unspecified epoch (typically system boot) - so use
    /// it for lightweight elapsed-time math where the difference of two
    /// readings is all that matters and carrying a `Duration` would be
    /// overkill.
    public as_nanos(&this) -> i64 {
        return this.secs.saturating_multiply(NSEC_PER_SEC).saturating_add(this.nanos);
    }

    /// `this + dur`, or `None` if the reading would overflow `i64`.
    public checked_add(&this, dur: &Duration) -> Option<Instant> {
        mut carry: i128 = 0;
        mut nsec:  i64 = this.nanos + (dur.subsec_nanos() as i64);
        if (nsec >= NSEC_PER_SEC) {
            carry = 1;
            nsec  = nsec - NSEC_PER_SEC;
        }
        // In `i128` the sum of an `i64`, a `u64` and the carry is exact.
        const total: i128 = (this.secs as i128) + (dur.as_secs() as i128) + carry;
        if (total > i64::MAX as i128) { return Option::None; }
        return Option::Some(Instant { secs: total as i64, nanos: nsec });
    }

    /// `this + dur`, or the latest reading an `Instant` can hold if the sum
    /// would overflow, so a deadline computed from an over-long duration
    /// lies in the far future rather than wrapping into the past.
    public saturating_add(&this, dur: &Duration) -> Instant {
        return this.checked_add(dur)
            .unwrap_or(Instant { secs: i64::MAX, nanos: NSEC_PER_SEC - 1 });
    }

    /// `this - dur`, or `None` if the reading would go below zero.
    public checked_sub(&this, dur: &Duration) -> Option<Instant> {
        const sub_secs: i64 = dur.as_secs() as i64;
        mut sec:  i64 = this.secs - sub_secs;
        mut nsec: i64 = this.nanos - (dur.subsec_nanos() as i64);
        if (nsec < 0) {
            sec  = sec - 1;
            nsec = nsec + NSEC_PER_SEC;
        }
        if (sec < 0) { return Option::None; }
        return Option::Some(Instant { secs: sec, nanos: nsec });
    }
}

implement trait Eq for struct Instant {
    equals(&this, other: &Instant) -> boolean {
        return this.secs == other.secs && this.nanos == other.nanos;
    }
}

implement trait Ord for struct Instant {
    compare(&this, other: &Instant) -> Ordering {
        if (this.secs < other.secs) { return Ordering::Less; }
        if (this.secs > other.secs) { return Ordering::Greater; }
        if (this.nanos < other.nanos) { return Ordering::Less; }
        if (this.nanos > other.nanos) { return Ordering::Greater; }
        return Ordering::Equal;
    }
}

// SystemTime: a wall-clock reading.

/// A measurement of the wall clock (`CLOCK_REALTIME`) as a raw
/// `timespec`. `duration_since_epoch()` yields a Unix timestamp. Subject
/// to NTP steps and manual changes; do not use for elapsed-time
/// measurement. POD.
public type struct SystemTime {
    private secs:  i64;
    private nanos: i64;

    /// Read the wall clock now.
    public static now() -> SystemTime {
        return read_realtime();
    }

    /// The Unix epoch (1970-01-01 00:00:00 UTC).
    public static unix_epoch() -> SystemTime {
        return SystemTime { secs: 0, nanos: 0 };
    }

    /// A wall-clock time from a whole-second Unix timestamp.
    public static from_unix_secs(secs: i64) -> SystemTime {
        return SystemTime { secs: secs, nanos: 0 };
    }

    /// A Windows `FILETIME` (100-ns ticks since 1601-01-01 UTC) as a
    /// wall-clock reading. Floor division keeps the nanoseconds in
    /// `0..1e9` for a time before 1970 too.
    internal static from_filetime(ft: FILETIME) -> SystemTime {
        // Widened through u64 so the high half does not sign-extend.
        const ticks: i64 = ((ft.dwHighDateTime as u64) << 32
                          | (ft.dwLowDateTime  as u64)) as i64;
        const unix_ticks: i64 = ticks - FILETIME_TO_UNIX_TICKS;
        return SystemTime {
            secs:  unix_ticks.divide_floor(FILETIME_TICKS_PER_SEC),
            nanos: unix_ticks.modulo_floor(FILETIME_TICKS_PER_SEC) * FILETIME_NS_PER_TICK,
        };
    }

    /// Whole seconds since the Unix epoch (may be negative before 1970).
    public unix_secs(&this) -> i64 { return this.secs; }

    /// Time since the Unix epoch. Saturates at zero for a clock set
    /// before 1970.
    public duration_since_epoch(&this) -> Duration {
        return diff_saturating(this.secs, this.nanos, 0, 0);
    }

    /// The time elapsed from `earlier` to `this` (saturating at zero).
    /// Only meaningful if the wall clock has not been stepped between the
    /// two readings.
    public duration_since(&this, earlier: &SystemTime) -> Duration {
        return diff_saturating(this.secs, this.nanos, earlier.secs, earlier.nanos);
    }

    /// `this + dur`, or `None` if the reading would overflow `i64`.
    public checked_add(&this, dur: &Duration) -> Option<SystemTime> {
        mut carry: i128 = 0;
        mut nsec:  i64 = this.nanos + (dur.subsec_nanos() as i64);
        if (nsec >= NSEC_PER_SEC) {
            carry = 1;
            nsec  = nsec - NSEC_PER_SEC;
        }
        // In `i128` the sum of an `i64`, a `u64` and the carry is exact,
        // so one range check answers for every reading, a negative one
        // included.
        const total: i128 = (this.secs as i128) + (dur.as_secs() as i128) + carry;
        if (total > i64::MAX as i128) { return Option::None; }
        return Option::Some(SystemTime { secs: total as i64, nanos: nsec });
    }
}

// sleep.

/// Park the current thread for at least `dur`.  POSIX path restarts
/// across EINTR using the kernel's remaining-time readout; Windows
/// `Sleep` is uninterruptible at the millisecond granularity it
/// accepts.  Sub-millisecond `dur` rounds UP to 1 ms on Windows so a
/// non-zero request always blocks.
public function sleep(dur: Duration) -> void {
    sleep_for(dur);
}


// Per-OS clock + sleep helpers

/// Read the monotonic clock into the shape `Instant` carries.
![target(linux)]
private function read_monotonic() -> Instant {
    mut ts: timespec = timespec { tv_sec: 0, tv_nsec: 0 };
    clock_gettime(ClockId::CLOCK_MONOTONIC, &ts);
    return Instant { secs: ts.tv_sec, nanos: ts.tv_nsec };
}

![target(windows)]
private function read_monotonic() -> Instant {
    // QueryPerformanceCounter returns ticks; QueryPerformanceFrequency
    // gives ticks-per-second.  Both write a LARGE_INTEGER (a single
    // i64 in QuadPart).  Convert to (secs, ns_within_second) without
    // overflowing i64: split the tick count into quotient + remainder
    // by the frequency before multiplying the remainder up to nanos.
    mut counter: LARGE_INTEGER = LARGE_INTEGER { QuadPart: 0 };
    mut freq:    LARGE_INTEGER = LARGE_INTEGER { QuadPart: 0 };
    syscall::QueryPerformanceCounter(&counter);
    syscall::QueryPerformanceFrequency(&freq);
    if (freq.QuadPart <= 0) {
        return Instant { secs: 0, nanos: 0 };
    }
    const secs: i64 = counter.QuadPart / freq.QuadPart;
    const rem:  i64 = counter.QuadPart % freq.QuadPart;
    const nanos: i64 = (rem * NSEC_PER_SEC) / freq.QuadPart;
    return Instant { secs: secs, nanos: nanos };
}

/// Read the wall clock into the shape `SystemTime` carries
/// (Unix-epoch-relative `secs` + sub-second `nanos`).
![target(linux)]
private function read_realtime() -> SystemTime {
    mut ts: timespec = timespec { tv_sec: 0, tv_nsec: 0 };
    clock_gettime(ClockId::CLOCK_REALTIME, &ts);
    return SystemTime { secs: ts.tv_sec, nanos: ts.tv_nsec };
}

![target(windows)]
private function read_realtime() -> SystemTime {
    mut ft: FILETIME = FILETIME { dwLowDateTime: 0, dwHighDateTime: 0 };
    syscall::GetSystemTimePreciseAsFileTime(&ft);
    return SystemTime::from_filetime(ft);
}

/// Block the current thread for at least `dur`.
![target(linux)]
private function sleep_for(dur: Duration) -> void {
    mut req: timespec = timespec { tv_sec:  dur.as_secs() as i64,
                                   tv_nsec: dur.subsec_nanos() as i64 };
    mut rem: timespec = timespec { tv_sec: 0, tv_nsec: 0 };
    while (nanosleep(&req, &rem) != 0) {
        req = rem;
    }
}

![target(windows)]
private function sleep_for(dur: Duration) -> void {
    // Sleep takes milliseconds as a u32, and u32::MAX means INFINITE, so a
    // longer span is slept in chunks of one less.
    const chunk_max: u64 = 0xFFFFFFFE;
    mut remaining: u64 = dur.as_millis_ceil();
    while (remaining > 0) {
        mut chunk: u64 = remaining;
        if (chunk > chunk_max) { chunk = chunk_max; }
        syscall::Sleep(chunk as u32);
        remaining = remaining - chunk;
    }
}
