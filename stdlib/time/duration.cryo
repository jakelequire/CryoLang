///! std::time::duration: `Duration`, a span of time.
///!
///! A `Duration` is whole seconds plus a sub-second nanosecond remainder,
///! always normalized so `nanos < 1_000_000_000`. It is POD: copied by
///! value, no owned resources. Build it from any unit, read it back in
///! any unit, do checked / saturating / scaling arithmetic, and print it
///! through `Display` (`1.5s`, `250ms`, `10ns`).

namespace std::time::duration;

import std::core::cmp::{ Eq, Ord, Ordering };
import std::core::intrinsics;
import std::core::option::{ Option };
import std::core::result::{ Result };
import std::core::slice;
import std::core::primitives;
import std::collections::str::{ Str };
import std::collections::string::{ String };
import std::fmt::display::{ Debug, Display, Formatter };
import std::fmt::error::{ FmtError };

/// A length of time: whole `secs` plus a sub-second `nanos` remainder
/// (`0 <= nanos < 1_000_000_000`). POD; copy-by-value, no `drop`.
public type struct Duration {
    private secs:  u64;
    private nanos: u32;

    public const NANOS_PER_SEC:   u64 = 1000000000;
    public const NANOS_PER_MILLI: u64 = 1000000;
    public const NANOS_PER_MICRO: u64 = 1000;
    public const MILLIS_PER_SEC:  u64 = 1000;
    public const MICROS_PER_SEC:  u64 = 1000000;
    public const SECS_PER_MINUTE: u64 = 60;
    public const SECS_PER_HOUR:   u64 = 3600;
    public const SECS_PER_DAY:    u64 = 86400;

    /// Construct from a `(seconds, nanoseconds)` pair, carrying any
    /// nanosecond overflow (`>= 1e9`) into the seconds field so the
    /// stored value is always normalized.
    public static new(secs: u64, nanos: u32) -> Duration {
        mut s: u64 = secs;
        mut n: u64 = nanos as u64;
        if (n >= Duration::NANOS_PER_SEC) {
            s = s + (n / Duration::NANOS_PER_SEC);
            n = n % Duration::NANOS_PER_SEC;
        }
        return Duration { secs: s, nanos: n as u32 };
    }

    /// The zero duration.
    public static zero() -> Duration {
        return Duration { secs: 0, nanos: 0 };
    }

    /// One second.
    public static second() -> Duration {
        return Duration { secs: 1, nanos: 0 };
    }

    /// One millisecond.
    public static millisecond() -> Duration {
        return Duration { secs: 0, nanos: Duration::NANOS_PER_MILLI as u32 };
    }

    /// One microsecond.
    public static microsecond() -> Duration {
        return Duration { secs: 0, nanos: Duration::NANOS_PER_MICRO as u32 };
    }

    /// One nanosecond.
    public static nanosecond() -> Duration {
        return Duration { secs: 0, nanos: 1 };
    }

    public static from_secs(secs: u64) -> Duration {
        return Duration { secs: secs, nanos: 0 };
    }

    public static from_millis(millis: u64) -> Duration {
        return Duration {
            secs:  millis / Duration::MILLIS_PER_SEC,
            nanos: ((millis % Duration::MILLIS_PER_SEC) * Duration::NANOS_PER_MILLI) as u32
        };
    }

    public static from_micros(micros: u64) -> Duration {
        return Duration {
            secs:  micros / Duration::MICROS_PER_SEC,
            nanos: ((micros % Duration::MICROS_PER_SEC) * Duration::NANOS_PER_MICRO) as u32
        };
    }

    public static from_nanos(nanos: u64) -> Duration {
        return Duration {
            secs:  nanos / Duration::NANOS_PER_SEC,
            nanos: (nanos % Duration::NANOS_PER_SEC) as u32
        };
    }

    /// Construct from a floating-point number of seconds. Negative
    /// inputs clamp to zero.
    public static from_secs_f64(secs: f64) -> Duration {
        if (secs <= 0.0) {
            return Duration { secs: 0, nanos: 0 };
        }
        const whole: u64 = secs as u64;
        const frac:  f64 = secs - (whole as f64);
        mut nanos: u64 = (frac * 1000000000.0) as u64;
        if (nanos >= Duration::NANOS_PER_SEC) { nanos = Duration::NANOS_PER_SEC - 1; }
        return Duration { secs: whole, nanos: nanos as u32 };
    }

    /// Whole seconds (the sub-second part is dropped).
    public as_secs(&this) -> u64 { return this.secs; }

    /// The sub-second remainder in nanoseconds (`< 1e9`).
    public subsec_nanos(&this) -> u32 { return this.nanos; }

    /// The sub-second remainder in whole milliseconds (`< 1000`).
    public subsec_millis(&this) -> u32 {
        return ((this.nanos as u64) / Duration::NANOS_PER_MILLI) as u32;
    }

    /// The sub-second remainder in whole microseconds (`< 1_000_000`).
    public subsec_micros(&this) -> u32 {
        return ((this.nanos as u64) / Duration::NANOS_PER_MICRO) as u32;
    }

    /// Total whole milliseconds.
    public as_millis(&this) -> u64 {
        return this.secs * Duration::MILLIS_PER_SEC + (this.nanos as u64) / Duration::NANOS_PER_MILLI;
    }

    /// Total whole microseconds.
    public as_micros(&this) -> u64 {
        return this.secs * Duration::MICROS_PER_SEC + (this.nanos as u64) / Duration::NANOS_PER_MICRO;
    }

    /// Total nanoseconds. Wraps for spans beyond ~584 years.
    public as_nanos(&this) -> u64 {
        return this.secs * Duration::NANOS_PER_SEC + (this.nanos as u64);
    }

    /// The whole span as floating-point seconds.
    public as_secs_f64(&this) -> f64 {
        return (this.secs as f64) + (this.nanos as f64) / 1000000000.0;
    }

    public is_zero(&this) -> boolean {
        return this.secs == 0 && this.nanos == 0;
    }

    /// `this + other`, or `None` if the seconds field would overflow.
    public checked_add(&this, other: &Duration) -> Option<Duration> {
        mut secs:  u64 = this.secs + other.secs;
        mut nanos: u64 = (this.nanos as u64) + (other.nanos as u64);
        if (this.secs > u64::MAX - other.secs) {
            return Option::None;
        }
        if (nanos >= Duration::NANOS_PER_SEC) {
            if (secs == u64::MAX) { return Option::None; }
            secs  = secs + 1;
            nanos = nanos - Duration::NANOS_PER_SEC;
        }
        return Option::Some(Duration { secs: secs, nanos: nanos as u32 });
    }

    /// `this - other`, or `None` when `other` is the larger.
    public checked_sub(&this, other: &Duration) -> Option<Duration> {
        if (this.secs < other.secs) { return Option::None; }
        if (this.secs == other.secs && this.nanos < other.nanos) {
            return Option::None;
        }
        mut secs:  u64 = this.secs - other.secs;
        mut nanos: i64 = (this.nanos as i64) - (other.nanos as i64);
        if (nanos < 0) {
            secs  = secs - 1;
            nanos = nanos + (Duration::NANOS_PER_SEC as i64);
        }
        return Option::Some(Duration { secs: secs, nanos: nanos as u32 });
    }

    /// `this + other`, saturating at the maximum representable span on
    /// overflow.
    public saturating_add(&this, other: &Duration) -> Duration {
        return match (this.checked_add(other)) {
            Option::Some(d) => { d }
            Option::None    => { Duration { secs: u64::MAX, nanos: 999999999 } }
        };
    }

    /// `this - other`, saturating at zero when `other` is the larger.
    public saturating_sub(&this, other: &Duration) -> Duration {
        return match (this.checked_sub(other)) {
            Option::Some(d) => { d }
            Option::None    => { Duration { secs: 0, nanos: 0 } }
        };
    }

    /// `this * factor`.
    public scale(&this, factor: u64) -> Duration {
        const total_nanos: u64 = (this.nanos as u64) * factor;
        const extra_secs:  u64 = total_nanos / Duration::NANOS_PER_SEC;
        const rem_nanos:   u32 = (total_nanos % Duration::NANOS_PER_SEC) as u32;
        return Duration { secs: this.secs * factor + extra_secs, nanos: rem_nanos };
    }

    /// `this * factor` for a floating-point factor.
    mul_f64(&this, factor: f64) -> Duration {
        return Duration::from_secs_f64(this.as_secs_f64() * factor);
    }

    /// `this / divisor`. Panics on division by zero.
    public divide(&this, divisor: u64) -> Duration {
        if (divisor == 0) {
            core::panic("Duration::divide: division by zero", intrinsics::location());
        }
        const secs:        u64 = this.secs / divisor;
        const rem_secs:    u64 = this.secs % divisor;
        const total_nanos: u64 = rem_secs * Duration::NANOS_PER_SEC + (this.nanos as u64);
        return Duration { secs: secs, nanos: (total_nanos / divisor) as u32 };
    }

    /// Render the most natural unit as an owned `String` (`1.5s`,
    /// `250ms`, `10ns`) - the same text as the `Display` impl, available
    /// directly without an f-string.
    public to_string(&this) -> String {
        return f"{this}";
    }

    /// Render the `Debug` form (`Duration { secs: S, nanos: N }`) as an
    /// owned `String`.
    public to_debug_string(&this) -> String {
        return f"{this:?}";
    }
}

implement trait Eq for struct Duration {
    equals(&this, other: &Duration) -> boolean {
        return this.secs == other.secs && this.nanos == other.nanos;
    }
}

implement trait Ord for struct Duration {
    compare(&this, other: &Duration) -> Ordering {
        if (this.secs < other.secs) { return Ordering::Less; }
        if (this.secs > other.secs) { return Ordering::Greater; }
        if (this.nanos < other.nanos) { return Ordering::Less; }
        if (this.nanos > other.nanos) { return Ordering::Greater; }
        return Ordering::Equal;
    }
}

// Display / Debug.

/// Write `nanos` as a 9-digit sub-second fraction with trailing zeros
/// trimmed (so `500_000_000` prints as `5`).
private function write_fraction(f: mut &Formatter, nanos: u32) -> Result<(), FmtError> {
    mut digits: [u8; 9];
    mut v: u32 = nanos;
    mut i: i32 = 8;
    while (i >= 0) {
        digits[i] = (48 + (v % 10)) as u8;   // '0' + d
        v = v / 10;
        i = i - 1;
    }
    mut len: u64 = 9;
    while (len > 1 && digits[len - 1] == 48) { len = len - 1; }
    return f.write_str(Str::from_raw(&digits[0], len));
}

implement trait Display for struct Duration {
    fmt(&this, f: mut &Formatter) -> Result<(), FmtError> {
        if (this.secs == 0) {
            if (this.nanos == 0) {
                return f.write_str(Str::new("0ns"));
            }
            const nanos: u64 = this.nanos as u64;
            if (nanos % Duration::NANOS_PER_MILLI == 0) {
                return f.write(f"{nanos / Duration::NANOS_PER_MILLI}ms");
            }
            if (nanos % Duration::NANOS_PER_MICRO == 0) {
                return f.write(f"{nanos / Duration::NANOS_PER_MICRO}us");
            }
            return f.write(f"{nanos}ns");
        }
        f.write(f"{this.secs}")?;
        if (this.nanos != 0) {
            f.write_str(Str::new("."))?;
            write_fraction(f, this.nanos)?;
        }
        return f.write_str(Str::new("s"));
    }
}

implement trait Debug for struct Duration {
    fmt(&this, f: mut &Formatter) -> Result<(), FmtError> {
        return f.write(f"Duration {{ secs: {this.secs}, nanos: {this.nanos} }}");
    }
}
