///! POSIX signal numbers.
///!
///! Numeric constants that match Linux x86_64. `Signal` wraps an
///! `i32` so the compiler catches "I passed a pid where a signal
///! was expected" mistakes. The common signals get named
///! constructors; arbitrary numbers go through `from_i32`.
///!
///! Receiving the interrupt and terminate signals is
///! `signal_handling::Signals`. Arbitrary handlers are not offered: a
///! handler runs where almost nothing in the library may be called.

namespace std::process::signal;

import std::core::option::{ Option };

public type enum SigNo : i32 {
    SIGHUP  = 1;
    SIGINT  = 2;
    SIGQUIT = 3;
    SIGILL  = 4;
    SIGTRAP = 5;
    SIGABRT = 6;
    SIGBUS  = 7;
    SIGFPE  = 8;
    SIGKILL = 9;
    SIGUSR1 = 10;
    SIGSEGV = 11;
    SIGUSR2 = 12;
    SIGPIPE = 13;
    SIGALRM = 14;
    SIGTERM = 15;
    SIGCHLD = 17;
    SIGCONT = 18;
    SIGSTOP = 19;
    SIGTSTP = 20;
}

implement enum SigNo {
    /// The signal numbered `value`, or `None` for a number that names
    /// none of these.
    public static from_i32(value: i32) -> Option<SigNo> {
        return match (value) {
            1  => { Option::Some(SigNo::SIGHUP) }
            2  => { Option::Some(SigNo::SIGINT) }
            3  => { Option::Some(SigNo::SIGQUIT) }
            4  => { Option::Some(SigNo::SIGILL) }
            5  => { Option::Some(SigNo::SIGTRAP) }
            6  => { Option::Some(SigNo::SIGABRT) }
            7  => { Option::Some(SigNo::SIGBUS) }
            8  => { Option::Some(SigNo::SIGFPE) }
            9  => { Option::Some(SigNo::SIGKILL) }
            10 => { Option::Some(SigNo::SIGUSR1) }
            11 => { Option::Some(SigNo::SIGSEGV) }
            12 => { Option::Some(SigNo::SIGUSR2) }
            13 => { Option::Some(SigNo::SIGPIPE) }
            14 => { Option::Some(SigNo::SIGALRM) }
            15 => { Option::Some(SigNo::SIGTERM) }
            17 => { Option::Some(SigNo::SIGCHLD) }
            18 => { Option::Some(SigNo::SIGCONT) }
            19 => { Option::Some(SigNo::SIGSTOP) }
            20 => { Option::Some(SigNo::SIGTSTP) }
            _  => { Option::None }
        };
    }
}

public type struct Signal {
    private value: SigNo;

    public static new(value: SigNo) -> Signal {
        return Signal { value: value };
    }

    /// The signal numbered `value`, or `None` for a number `SigNo` does
    /// not name.
    public static from_i32(value: i32) -> Option<Signal> {
        return match (SigNo::from_i32(value)) {
            Option::Some(number) => { Option::Some(Signal { value: number }) }
            Option::None         => { Option::None }
        };
    }

    /// Underlying signal number for the libc syscall.
    public as_i32(&this) -> i32 {
        return this.value as i32;
    }

    // POSIX signal numbers (Linux).
    public static hangup() -> Signal         { return Signal { value: SigNo::SIGHUP }; }
    public static interrupt() -> Signal      { return Signal { value: SigNo::SIGINT }; }
    public static quit() -> Signal           { return Signal { value: SigNo::SIGQUIT }; }
    public static illegal() -> Signal        { return Signal { value: SigNo::SIGILL }; }
    public static trap() -> Signal           { return Signal { value: SigNo::SIGTRAP }; }
    public static abort() -> Signal          { return Signal { value: SigNo::SIGABRT }; }
    public static bus() -> Signal            { return Signal { value: SigNo::SIGBUS }; }
    public static floating_point() -> Signal { return Signal { value: SigNo::SIGFPE }; }
    public static kill() -> Signal           { return Signal { value: SigNo::SIGKILL }; }
    public static user1() -> Signal          { return Signal { value: SigNo::SIGUSR1 }; }
    public static segfault() -> Signal       { return Signal { value: SigNo::SIGSEGV }; }
    public static user2() -> Signal          { return Signal { value: SigNo::SIGUSR2 }; }
    public static pipe() -> Signal           { return Signal { value: SigNo::SIGPIPE }; }
    public static alarm() -> Signal          { return Signal { value: SigNo::SIGALRM }; }
    public static terminate() -> Signal      { return Signal { value: SigNo::SIGTERM }; }
    public static child() -> Signal          { return Signal { value: SigNo::SIGCHLD }; }
    public static cont() -> Signal           { return Signal { value: SigNo::SIGCONT }; }
    public static stop() -> Signal           { return Signal { value: SigNo::SIGSTOP }; }
    public static tty_stop() -> Signal       { return Signal { value: SigNo::SIGTSTP }; }
}
