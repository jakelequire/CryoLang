///! POSIX signal numbers.
///!
///! Numeric constants that match Linux x86_64. `Signal` wraps an
///! `i32` so the compiler catches "I passed a pid where a signal
///! was expected" mistakes. The common signals get named
///! constructors; arbitrary numbers go through `from_i32`.
///!
///! Signal *handling* (installing a handler with `sigaction`) is
///! not modeled here. The moment a program installs handlers it
///! crosses into territory that interacts with every other stdlib
///! primitive (async-signal safety, reentrant mallocs, the whole
///! deal), and that's a separate design problem.

namespace std::process::signal;

type enum SigNo : i32 {
    SIGHUP  = 1;
    SIGINT  = 2;
    SIGQUIT = 3;
    SIGILL  = 4;
    SIGTRAP = 5;
    SIGABRT = 6;
    SIGBUS  = 7;
    SIGFPE  = 8;
    SIGKILL = 9;
    SIGUSR1 = 10;
    SIGSEGV = 11;
    SIGUSR2 = 12;
    SIGPIPE = 13;
    SIGALRM = 14;
    SIGTERM = 15;
    SIGCHLD = 17;
    SIGCONT = 18;
    SIGSTOP = 19;
    SIGTSTP = 20;
}

implement enum SigNo {
    static from_i32(value: i32) -> SigNo {
        return value as SigNo;
    }
}

type struct Signal {
    value: SigNo;

    static new(value: SigNo) -> Signal {
        return Signal { value: value };
    }

    static from_i32(value: i32) -> Signal {
        return Signal { value: SigNo::from_i32(value) };
    }

    /// Underlying signal number for the libc syscall.
    as_i32(&this) -> i32 {
        return this.value as i32;
    }

    // POSIX signal numbers (Linux).
    static hangup() -> Signal         { return Signal { value: SigNo::SIGHUP }; }
    static interrupt() -> Signal      { return Signal { value: SigNo::SIGINT }; }
    static quit() -> Signal           { return Signal { value: SigNo::SIGQUIT }; }
    static illegal() -> Signal        { return Signal { value: SigNo::SIGILL }; }
    static trap() -> Signal           { return Signal { value: SigNo::SIGTRAP }; }
    static abort() -> Signal          { return Signal { value: SigNo::SIGABRT }; }
    static bus() -> Signal            { return Signal { value: SigNo::SIGBUS }; }
    static floating_point() -> Signal { return Signal { value: SigNo::SIGFPE }; }
    static kill() -> Signal           { return Signal { value: SigNo::SIGKILL }; }
    static user1() -> Signal          { return Signal { value: SigNo::SIGUSR1 }; }
    static segfault() -> Signal       { return Signal { value: SigNo::SIGSEGV }; }
    static user2() -> Signal          { return Signal { value: SigNo::SIGUSR2 }; }
    static pipe() -> Signal           { return Signal { value: SigNo::SIGPIPE }; }
    static alarm() -> Signal          { return Signal { value: SigNo::SIGALRM }; }
    static terminate() -> Signal      { return Signal { value: SigNo::SIGTERM }; }
    static child() -> Signal          { return Signal { value: SigNo::SIGCHLD }; }
    static cont() -> Signal           { return Signal { value: SigNo::SIGCONT }; }
    static stop() -> Signal           { return Signal { value: SigNo::SIGSTOP }; }
    static tty_stop() -> Signal       { return Signal { value: SigNo::SIGTSTP }; }
}
