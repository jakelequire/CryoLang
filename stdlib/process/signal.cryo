///! POSIX signal numbers.
///!
///! Numeric constants that match Linux x86_64. `Signal` wraps an
///! `i32` so the compiler catches "I passed a pid where a signal
///! was expected" mistakes. The common signals get named
///! constructors; arbitrary numbers go through `from_i32`.
///!
///! Receiving the interrupt and terminate signals is
///! `signal_handling::Signals`. Arbitrary handlers are not offered: a
///! handler runs where almost nothing in the library may be called.

namespace std::process::signal;

import std::core::option::{ Option };

/// The signals this library names, each valued at its Linux number. On
/// Windows they are only numbers: `Child.send_signal` carries out `SIGKILL`
/// and `SIGINT`, `Signals` hands over `SIGINT` and `SIGTERM` for the console
/// events that stand for them, and nothing else uses the rest.
public type enum SigNo : i32 with [Eq] {
    SIGHUP  = 1;
    SIGINT  = 2;
    SIGQUIT = 3;
    SIGILL  = 4;
    SIGTRAP = 5;
    SIGABRT = 6;
    SIGBUS  = 7;
    SIGFPE  = 8;
    SIGKILL = 9;
    SIGUSR1 = 10;
    SIGSEGV = 11;
    SIGUSR2 = 12;
    SIGPIPE = 13;
    SIGALRM = 14;
    SIGTERM = 15;
    SIGCHLD = 17;
    SIGCONT = 18;
    SIGSTOP = 19;
    SIGTSTP = 20;
}

implement enum SigNo {
    /// The signal numbered `value`, or `None` for a number that names
    /// none of these.
    public static from_i32(value: i32) -> Option<SigNo> {
        return match (value) {
            1  => { Option::Some(SigNo::SIGHUP) }
            2  => { Option::Some(SigNo::SIGINT) }
            3  => { Option::Some(SigNo::SIGQUIT) }
            4  => { Option::Some(SigNo::SIGILL) }
            5  => { Option::Some(SigNo::SIGTRAP) }
            6  => { Option::Some(SigNo::SIGABRT) }
            7  => { Option::Some(SigNo::SIGBUS) }
            8  => { Option::Some(SigNo::SIGFPE) }
            9  => { Option::Some(SigNo::SIGKILL) }
            10 => { Option::Some(SigNo::SIGUSR1) }
            11 => { Option::Some(SigNo::SIGSEGV) }
            12 => { Option::Some(SigNo::SIGUSR2) }
            13 => { Option::Some(SigNo::SIGPIPE) }
            14 => { Option::Some(SigNo::SIGALRM) }
            15 => { Option::Some(SigNo::SIGTERM) }
            17 => { Option::Some(SigNo::SIGCHLD) }
            18 => { Option::Some(SigNo::SIGCONT) }
            19 => { Option::Some(SigNo::SIGSTOP) }
            20 => { Option::Some(SigNo::SIGTSTP) }
            _  => { Option::None }
        };
    }
}

/// A signal, sent with `Child.send_signal` and received with
/// `signal_handling::Signals`. Build one with a named constructor
/// (`Signal::kill()`), from a `SigNo` with `new`, or from a raw number with
/// `from_i32`.
///
/// On Windows, which has no signals, only two have an effect: sending
/// `kill` terminates the process and sending `interrupt` raises Ctrl-Break
/// in a child that leads its own console process group; sending any other
/// is refused with `Unsupported`. Each constructor says what its signal
/// does there.
///
/// ```cryo
/// import std::process::signal::{ Signal, SigNo };
///
/// const interrupt: Signal = Signal::interrupt();
/// // interrupt.as_i32() == 2, and Signal::new(SigNo::SIGINT) is the same signal
/// ```
public type struct Signal with [Eq] {
    private value: SigNo;

    /// The signal `value` names.
    public static new(value: SigNo) -> Signal {
        return Signal { value: value };
    }

    /// The signal numbered `value`, or `None` for a number `SigNo` does
    /// not name.
    public static from_i32(value: i32) -> Option<Signal> {
        return match (SigNo::from_i32(value)) {
            Option::Some(number) => { Option::Some(Signal { value: number }) }
            Option::None         => { Option::None }
        };
    }

    /// Underlying signal number for the libc syscall.
    public as_i32(&this) -> i32 {
        return this.value as i32;
    }

    // POSIX signal numbers (Linux).

    /// SIGHUP (1): the controlling terminal hung up; by default it ends the
    /// process. Windows: refused by `send_signal` (`Unsupported`).
    public static hangup() -> Signal         { return Signal { value: SigNo::SIGHUP }; }
    /// SIGINT (2): an interrupt from the keyboard (Ctrl-C); by default it
    /// ends the process. Windows: `send_signal` raises Ctrl-Break in a child
    /// spawned after `Command.group_descendants`, which reaches its whole
    /// console process group, and refuses any other child (`Unsupported`);
    /// `Signals` hands over Ctrl-C and Ctrl-Break as this signal.
    public static interrupt() -> Signal      { return Signal { value: SigNo::SIGINT }; }
    /// SIGQUIT (3): a quit from the keyboard (Ctrl-\); by default it ends the
    /// process with a core dump. Windows: refused by `send_signal`
    /// (`Unsupported`).
    public static quit() -> Signal           { return Signal { value: SigNo::SIGQUIT }; }
    /// SIGILL (4): the process executed an illegal instruction. Windows:
    /// refused by `send_signal` (`Unsupported`).
    public static illegal() -> Signal        { return Signal { value: SigNo::SIGILL }; }
    /// SIGTRAP (5): a breakpoint or trace trap, for debuggers. Windows:
    /// refused by `send_signal` (`Unsupported`).
    public static trap() -> Signal           { return Signal { value: SigNo::SIGTRAP }; }
    /// SIGABRT (6): an abort, as raised by `abort()`; by default it ends the
    /// process with a core dump. Windows: refused by `send_signal`
    /// (`Unsupported`).
    public static abort() -> Signal          { return Signal { value: SigNo::SIGABRT }; }
    /// SIGBUS (7): a bus error, such as a misaligned access or a touch of a
    /// mapped file past its end. Windows: refused by `send_signal`
    /// (`Unsupported`).
    public static bus() -> Signal            { return Signal { value: SigNo::SIGBUS }; }
    /// SIGFPE (8): an arithmetic fault, such as an integer division by zero.
    /// Windows: refused by `send_signal` (`Unsupported`).
    public static floating_point() -> Signal { return Signal { value: SigNo::SIGFPE }; }
    /// SIGKILL (9): ends the process at once; it cannot be caught or
    /// ignored. Windows: `send_signal` terminates the process, which exits
    /// with code 1. `Child.kill` sends this.
    public static kill() -> Signal           { return Signal { value: SigNo::SIGKILL }; }
    /// SIGUSR1 (10): user-defined, with no meaning of its own; by default it
    /// ends the process. Windows: refused by `send_signal` (`Unsupported`).
    public static user1() -> Signal          { return Signal { value: SigNo::SIGUSR1 }; }
    /// SIGSEGV (11): an invalid memory reference, a segmentation fault.
    /// Windows: refused by `send_signal` (`Unsupported`).
    public static segfault() -> Signal       { return Signal { value: SigNo::SIGSEGV }; }
    /// SIGUSR2 (12): user-defined, with no meaning of its own; by default it
    /// ends the process. Windows: refused by `send_signal` (`Unsupported`).
    public static user2() -> Signal          { return Signal { value: SigNo::SIGUSR2 }; }
    /// SIGPIPE (13): a write to a pipe or socket nobody reads any more; by
    /// default it ends the process. Windows: refused by `send_signal`
    /// (`Unsupported`).
    public static pipe() -> Signal           { return Signal { value: SigNo::SIGPIPE }; }
    /// SIGALRM (14): a timer set by `alarm` ran out; by default it ends the
    /// process. Windows: refused by `send_signal` (`Unsupported`).
    public static alarm() -> Signal          { return Signal { value: SigNo::SIGALRM }; }
    /// SIGTERM (15): a request to end, which the process may catch to shut
    /// down cleanly; by default it ends the process. Windows: refused by
    /// `send_signal` (`Unsupported`) - use `kill`; `Signals` hands over the
    /// console closing, logoff and shutdown as this signal.
    public static terminate() -> Signal      { return Signal { value: SigNo::SIGTERM }; }
    /// SIGCHLD (17): a child process stopped or exited; ignored by default.
    /// Windows: refused by `send_signal` (`Unsupported`).
    public static child() -> Signal          { return Signal { value: SigNo::SIGCHLD }; }
    /// SIGCONT (18): resume a stopped process. Windows: refused by
    /// `send_signal` (`Unsupported`).
    public static cont() -> Signal           { return Signal { value: SigNo::SIGCONT }; }
    /// SIGSTOP (19): stop the process until a SIGCONT; it cannot be caught
    /// or ignored. Windows: refused by `send_signal` (`Unsupported`).
    public static stop() -> Signal           { return Signal { value: SigNo::SIGSTOP }; }
    /// SIGTSTP (20): a stop from the terminal (Ctrl-Z), which the process may
    /// catch. Windows: refused by `send_signal` (`Unsupported`).
    public static tty_stop() -> Signal       { return Signal { value: SigNo::SIGTSTP }; }
}
