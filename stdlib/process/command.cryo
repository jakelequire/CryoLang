///! Command: builder for spawning a subprocess.
///!
///! The typical flow:
///!
///! ```cryo
///! mut cmd: Command = Command::new(Str::new("ls"));
///! cmd.arg(Str::new("-la"));
///! cmd.stdout(Stdio::Piped);
///! mut child: Child = cmd.spawn().unwrap();
///! // read from child.stdout, wait, etc.
///! cmd.drop();
///! ```
///!
///! Under the hood: fork(), adjust fds and env in the child, execvp.
///! If execvp fails the child `_exit(127)`s so the parent sees a
///! status of 127, the standard "exec not found" code.

namespace std::process::command;

import core::intrinsics;
import core::option;
import core::result;
import core::slice;
import core::drop;
import io::error;
import io::fd;
import io::traits;
import collections::array;
import collections::raw_buffer;
import collections::str;
import collections::string;
import alloc::allocator;
import ffi::libc;
import ffi::syscall;
import alloc::layout;
import process::child;

// ArgvBuf: owned grow-on-push buffer of `u8*` for execvp's argv.
//
// Wraps `RawBuffer<u8*>` plus a length. Avoids `Array<u8*>` because
// `Array<T>::drop` requires `T: Drop` and raw pointers can't sit on
// the impl-target side (the parser only accepts identifier/keyword/`()`).
// The pointers themselves are non-owning aliases into `argv_storage`'s
// NUL-terminated strings; drop just releases the slot array.

type struct ArgvBuf {
    buf:    RawBuffer<u8*>;
    length: u64;

    static new() -> ArgvBuf {
        return ArgvBuf { buf: RawBuffer::new(), length: 0 };
    }

    push(mut &this, p: u8*) -> Result<(), AllocError> {
        this.buf.reserve(this.length, 1, 8)?;
        this.buf.ptr()[this.length] = p;
        this.length = this.length + 1;
        return Result::Ok(());
    }

    get(&this, i: u64) -> u8* {
        return this.buf.ptr()[i];
    }

    as_ptr(&this) -> u8** {
        return this.buf.ptr();
    }

    drop(mut &this) -> void {
        this.buf.drop();
        this.length = 0;
    }
}

/// How a child's stdin / stdout / stderr is wired up.
type enum Stdio {
    /// Share the parent's fd (the default).
    Inherit;
    /// Redirect to / from `/dev/null`.
    Null;
    /// Create a pipe; the parent keeps its end in the resulting
    /// `Child::stdin` / `stdout` / `stderr`.
    Piped;
    /// Use a specific fd. Ownership transfers; the spawn closes
    /// the fd in the parent after duping it into the child.
    Fd(i32);
}

type struct EnvEntry {
    key: String;
    value: String;
}

type struct Command {
    program: String;
    args: Array<String>;
    envs: Array<EnvEntry>;
    clear_env_flag: boolean;
    cwd: Option<String>;
    stdin_cfg: Stdio;
    stdout_cfg: Stdio;
    stderr_cfg: Stdio;

    /// Start a new command targeting `program`. The program name is
    /// resolved against `$PATH` by `execvp` at spawn time; pass an
    /// absolute path to skip the lookup.
    static new(program: Str) -> Command {
        return Command {
            program: String::from_str(program),
            args: Array::new(),
            envs: Array::new(),
            clear_env_flag: false,
            cwd: Option::None,
            stdin_cfg: Stdio::Inherit,
            stdout_cfg: Stdio::Inherit,
            stderr_cfg: Stdio::Inherit
        };
    }

    arg(mut &this, value: Str) -> void {
        this.args.push(String::from_str(value));
    }

    env(mut &this, key: Str, value: Str) -> void {
        this.envs.push(EnvEntry {
            key: String::from_str(key),
            value: String::from_str(value)
        });
    }

    /// Don't inherit the parent's environment. Only the entries added
    /// with `env()` reach the child.
    env_clear(mut &this) -> void {
        this.clear_env_flag = true;
    }

    cwd(mut &this, path: Str) -> void {
        // Pattern-binding the prior payload to `mut old` makes synthesis
        // release it at the match-arm scope exit before we overwrite
        // `this.cwd`.
        match (this.cwd) {
            Option::Some(mut old) => { }
            Option::None => { }
        }
        this.cwd = Option::Some(String::from_str(path));
    }

    stdin(mut &this, setting: Stdio) -> void { this.stdin_cfg = setting; }
    stdout(mut &this, setting: Stdio) -> void { this.stdout_cfg = setting; }
    stderr(mut &this, setting: Stdio) -> void { this.stderr_cfg = setting; }

    // Spawning

    /// fork + configure fds/env + execvp. Returns a `Child` the
    /// caller must eventually `wait` on.
    spawn(&this) -> Result<Child, IoError> {
        return spawn_impl(this);
    }

    /// spawn + wait + collect stdout/stderr into arrays. Stdin is
    /// left `Inherit` (or whatever the caller set). Use this for the
    /// common "run this and tell me what it printed" case.
    output(&this) -> Result<Output, IoError> {
        // Force stdout + stderr to Piped so we can capture them.
        mut configured: Command = clone_command(this);
        configured.stdout_cfg = Stdio::Piped;
        configured.stderr_cfg = Stdio::Piped;
        const handle: Child = configured.spawn()?;
        mut c: Child = handle;
        return collect_output(&c);
    }

    /// spawn + wait. Stdin/out/err go wherever the caller configured
    /// (typically Inherit).
    status(&this) -> Result<ExitStatus, IoError> {
        const handle: Child = this.spawn()?;
        mut c: Child = handle;
        return c.wait();
    }

}

// Output: the result of `Command::output()`

type struct Output {
    status: ExitStatus;
    stdout: Array<u8>;
    stderr: Array<u8>;

    /// The child's decoded exit status.
    status(&this) -> ExitStatus {
        return this.status;
    }

    /// Captured stdout as a borrowed byte slice. Valid until this
    /// `Output` is dropped; copy out anything you need to keep.
    stdout(&this) -> Slice<u8> {
        return this.stdout.as_slice();
    }

    /// Captured stderr as a borrowed byte slice. Valid until this
    /// `Output` is dropped.
    stderr(&this) -> Slice<u8> {
        return this.stderr.as_slice();
    }
}

// Implementation

/// Pipe-pair struct. `read_end` is what the reader uses;
/// `write_end` is what the writer uses. Both `-1` means no pipe was
/// created (Stdio was Inherit/Null/Fd).
type struct PipePair {
    read_end: i32;
    write_end: i32;
}

function make_pipe_pair() -> PipePair {
    return PipePair { read_end: -1, write_end: -1 };
}

/// Call pipe(2) and populate `pair`. Returns an IoError on failure.
![target(unix)]
function create_pipe() -> Result<PipePair, IoError> {
    mut fds: i32[2];
    if (libc::pipe(&fds[0]) < 0) {
        return Result::Err(IoError::from_errno(libc::errno()));
    }
    return Result::Ok(PipePair { read_end: fds[0], write_end: fds[1] });
}

/// Build the pipe pair for a given Stdio setting. No-op for
/// Inherit/Null/Fd.
![target(unix)]
function prepare_stdio(setting: Stdio) -> Result<PipePair, IoError> {
    return match (setting) {
        Stdio::Piped => { create_pipe() }
        _            => { Result::Ok(make_pipe_pair()) }
    }
}

/// After fork, in the child: replace `target_fd` (0/1/2) according
/// to `setting`. Returns false if the remap failed.
![target(unix)]
function child_remap(setting: Stdio, pipe: &PipePair, target_fd: i32,
                     is_input: boolean) -> boolean {
    match (setting) {
        Stdio::Inherit => { return true; }
        Stdio::Null => {
            const flags: i32 = 0;
            mut nullfd: i32 = 0;
            if (is_input) {
                nullfd = libc::open("/dev/null", libc::O_RDONLY, 0);
            } else {
                nullfd = libc::open("/dev/null", libc::O_WRONLY, 0);
            }
            if (nullfd < 0) { return false; }
            if (libc::dup2(nullfd, target_fd) < 0) { return false; }
            fd::close_fd(nullfd);
            return true;
        }
        Stdio::Piped => {
            const src: i32 = (is_input ? pipe.read_end : pipe.write_end);
            if (libc::dup2(src, target_fd) < 0) { return false; }
            // Close both ends after dup2; the target_fd now refers
            // to whichever end we wanted.
            if (pipe.read_end >= 0) { fd::close_fd(pipe.read_end); }
            if (pipe.write_end >= 0) { fd::close_fd(pipe.write_end); }
            return true;
        }
        Stdio::Fd(raw) => {
            if (libc::dup2(raw, target_fd) < 0) { return false; }
            fd::close_fd(raw);
            return true;
        }
    }
}

/// Build an argv u8** buffer from (program, args). `storage` keeps the
/// NUL-terminated argument strings alive; the returned `ArgvBuf`
/// aliases the `as_ptr()` of each (the heap buffers stay put even when
/// `storage` reallocates, since only the String headers move).
function build_argv(program: &String,
                    args: &Array<String>,
                    storage: mut &Array<String>,
                    argv: mut &ArgvBuf) -> Result<(), IoError> {
    storage.push(String::from_str_c(program.as_str()));
    const slot: u8* = storage.get_ref(storage.length() - 1).unwrap().as_ptr();
    match (argv.push(slot)) {
        Result::Ok(_) => { }
        Result::Err(_) => {
            return Result::Err(IoError::new(IoErrorKind::OutOfMemory, 0));
        }
    }
    mut i: u64 = 0;
    while (i < args.length()) {
        match (args.get_ref(i)) {
            Option::Some(arg) => {
                storage.push(String::from_str_c(arg.as_str()));
                const arg_slot: u8* = storage.get_ref(storage.length() - 1).unwrap().as_ptr();
                match (argv.push(arg_slot)) {
                    Result::Ok(_) => { }
                    Result::Err(_) => {
                        return Result::Err(IoError::new(IoErrorKind::OutOfMemory, 0));
                    }
                }
            }
            Option::None => { break; }
        }
        i++;
    }
    match (argv.push(null)) {
        Result::Ok(_) => { }
        Result::Err(_) => {
            return Result::Err(IoError::new(IoErrorKind::OutOfMemory, 0));
        }
    }
    return Result::Ok(());
}

/// Apply env overrides inside the child. `clear_env` wipes the
/// inherited environment first. Called after fork, before exec.
![target(unix)]
function apply_env(clear_env: boolean,
                   envs: &Array<EnvEntry>) -> boolean {
    if (clear_env) {
        libc::clearenv();
    }
    mut i: u64 = 0;
    while (i < envs.length()) {
        match (envs.get_ref(i)) {
            Option::Some(entry) => {
                // NUL-terminated heap copies; this is post-fork, single-
                // threaded, so malloc is fine.  They drop at the end of
                // each iteration.
                mut key: String = String::from_str_c(entry.key.as_str());
                mut value: String = String::from_str_c(entry.value.as_str());
                if (libc::setenv(key.as_ptr(), value.as_ptr(), 1) < 0) {
                    return false;
                }
            }
            Option::None => { break; }
        }
        i++;
    }
    return true;
}

![target(unix)]
function spawn_impl(cmd: &Command) -> Result<Child, IoError> {
    // 1. Prepare pipes in the parent.
    mut stdin_pipe: PipePair = make_pipe_pair();
    stdin_pipe = prepare_stdio(cmd.stdin_cfg)?;
    mut stdout_pipe: PipePair = make_pipe_pair();
    match (prepare_stdio(cmd.stdout_cfg)) {
        Result::Ok(p) => { stdout_pipe = p; }
        Result::Err(err) => {
            close_pipe(&stdin_pipe);
            return Result::Err(err);
        }
    }
    mut stderr_pipe: PipePair = make_pipe_pair();
    match (prepare_stdio(cmd.stderr_cfg)) {
        Result::Ok(p) => { stderr_pipe = p; }
        Result::Err(err) => {
            close_pipe(&stdin_pipe);
            close_pipe(&stdout_pipe);
            return Result::Err(err);
        }
    }

    // 2. Build argv (parent-side; child inherits via fork COW).
    mut argv_storage: Array<String> = Array::new();
    mut argv: ArgvBuf = ArgvBuf::new();
    match (build_argv(&cmd.program, &cmd.args, &argv_storage, &argv)) {
        Result::Ok(_) => { }
        Result::Err(err) => {
            close_pipe(&stdin_pipe);
            close_pipe(&stdout_pipe);
            close_pipe(&stderr_pipe);
            return Result::Err(err);
        }
    }

    // 3. Prepare an optional NUL-terminated cwd path.
    mut cwd_cstr: Option<String> = Option::None;
    match (cmd.cwd) {
        Option::Some(path) => {
            cwd_cstr = Option::Some(String::from_str_c(path.as_str()));
        }
        Option::None => { }
    }

    // 4. fork.
    const pid: i32 = libc::fork();
    if (pid < 0) {
        const err: IoError = IoError::from_errno(libc::errno());
        close_pipe(&stdin_pipe);
        close_pipe(&stdout_pipe);
        close_pipe(&stderr_pipe);
        return Result::Err(err);
    }

    if (pid == 0) {
        // -------- child --------
        // Only async-signal-safe operations from here until exec or
        // _exit. setenv/chdir/dup2/close/open/execvp are all safe.
        if (!child_remap(cmd.stdin_cfg, &stdin_pipe, 0, true)) { libc::_exit(127); }
        if (!child_remap(cmd.stdout_cfg, &stdout_pipe, 1, false)) { libc::_exit(127); }
        if (!child_remap(cmd.stderr_cfg, &stderr_pipe, 2, false)) { libc::_exit(127); }

        // cwd change.
        match (cwd_cstr) {
            Option::Some(path) => {
                if (libc::chdir(path.as_ptr()) < 0) { libc::_exit(127); }
            }
            Option::None => { }
        }

        if (!apply_env(cmd.clear_env_flag, &cmd.envs)) { libc::_exit(127); }

        libc::execvp(argv.get(0), argv.as_ptr());
        // If we got here, exec failed.
        libc::_exit(127);
    }

    // -------- parent --------
    // Close the ends of each pipe that belong to the child.
    // For `Stdio::Fd`, ownership of the fd transferred to the spawn: the
    // child duped it into place (`child_remap`) before exec, so the parent
    // must close its own copy here. Without it the caller's fd leaks on
    // every `Fd`-configured spawn (the doc on `Stdio::Fd` promised this).
    match (cmd.stdin_cfg) {
        Stdio::Piped => {
            if (stdin_pipe.read_end >= 0) { fd::close_fd(stdin_pipe.read_end); }
            stdin_pipe.read_end = -1;
        }
        Stdio::Fd(raw) => {
            if (raw >= 0) { fd::close_fd(raw); }
        }
        _ => { }
    }
    match (cmd.stdout_cfg) {
        Stdio::Piped => {
            if (stdout_pipe.write_end >= 0) { fd::close_fd(stdout_pipe.write_end); }
            stdout_pipe.write_end = -1;
        }
        Stdio::Fd(raw) => {
            if (raw >= 0) { fd::close_fd(raw); }
        }
        _ => { }
    }
    match (cmd.stderr_cfg) {
        Stdio::Piped => {
            if (stderr_pipe.write_end >= 0) { fd::close_fd(stderr_pipe.write_end); }
            stderr_pipe.write_end = -1;
        }
        Stdio::Fd(raw) => {
            if (raw >= 0) { fd::close_fd(raw); }
        }
        _ => { }
    }

    mut stdin_handle: Option<ChildStdin> = Option::None;
    mut stdout_handle: Option<ChildStdout> = Option::None;
    mut stderr_handle: Option<ChildStderr> = Option::None;
    match (cmd.stdin_cfg) {
        Stdio::Piped => {
            stdin_handle = Option::Some(ChildStdin::from_fd(stdin_pipe.write_end));
        }
        _ => { }
    }
    match (cmd.stdout_cfg) {
        Stdio::Piped => {
            stdout_handle = Option::Some(ChildStdout::from_fd(stdout_pipe.read_end));
        }
        _ => { }
    }
    match (cmd.stderr_cfg) {
        Stdio::Piped => {
            stderr_handle = Option::Some(ChildStderr::from_fd(stderr_pipe.read_end));
        }
        _ => { }
    }

    // The argument strings + pointer array fall out of scope at function
    // exit; the synthesized drops release them.  The child has its own COW
    // copies, which are either replaced by exec or abandoned on _exit.
    return Result::Ok(Child::new(pid, 0u64, stdin_handle, stdout_handle, stderr_handle));
}

function close_pipe(pair: &PipePair) -> void {
    if (pair.read_end >= 0) { fd::close_fd(pair.read_end); }
    if (pair.write_end >= 0) { fd::close_fd(pair.write_end); }
}

implement trait Drop for struct EnvEntry {
    drop(mut &this) -> void {
        this.key.drop();
        this.value.drop();
    }
}

/// `Array<T>::drop` iterates elements via `where T: Drop`, so the
/// args/envs arrays release their owned `String`/`EnvEntry` contents
/// through their own drop calls.
implement trait Drop for struct Command {
    drop(mut &this) -> void {
        this.program.drop();
        this.args.drop();
        this.envs.drop();
        match (this.cwd) {
            Option::Some(mut path) => { }
            Option::None => { }
        }
        this.cwd = Option::None;
    }
}

implement trait Drop for struct Output {
    drop(mut &this) -> void {
        this.stdout.drop();
        this.stderr.drop();
    }
}

/// PipePair carries raw fds; the parent/child sides each close their
/// own end through `close_pipe` / `child_remap`. Dropping the struct
/// itself is a no-op.
implement trait Drop for struct PipePair {
    drop(mut &this) -> void {}
}

/// Shallow clone of `cmd` so `output()` can override stdout/stderr
/// without mutating the caller's Command. Copies owned strings.
function clone_command(cmd: &Command) -> Command {
    mut out: Command = Command {
        program: String::from_str(cmd.program.as_str()),
        args: Array::new(),
        envs: Array::new(),
        clear_env_flag: cmd.clear_env_flag,
        cwd: Option::None,
        stdin_cfg: cmd.stdin_cfg,
        stdout_cfg: cmd.stdout_cfg,
        stderr_cfg: cmd.stderr_cfg
    };
    mut i: u64 = 0;
    while (i < cmd.args.length()) {
        match (cmd.args.get_ref(i)) {
            Option::Some(arg) => { out.args.push(String::from_str(arg.as_str())); }
            Option::None => { break; }
        }
        i++;
    }
    mut j: u64 = 0;
    while (j < cmd.envs.length()) {
        match (cmd.envs.get_ref(j)) {
            Option::Some(entry) => {
                out.envs.push(EnvEntry {
                    key: String::from_str(entry.key.as_str()),
                    value: String::from_str(entry.value.as_str())
                });
            }
            Option::None => { break; }
        }
        j = j + 1;
    }
    match (cmd.cwd) {
        Option::Some(path) => {
            out.cwd = Option::Some(String::from_str(path.as_str()));
        }
        Option::None => { }
    }
    return out;
}

/// Drain a `Child`'s captured stdout/stderr into buffers, then
/// `wait()` for it. Used by `Command::output()`.
///
/// Reads both pipes interleaved via `poll(2)` over non-blocking fds.
/// The previous serial "drain stdout fully, then stderr" implementation
/// deadlocked any child that filled the 64-KiB stderr pipe buffer
/// before its stdout was fully consumed (kernel blocks the child's
/// write, child never exits, parent never finishes reading stdout,
/// parent never reaches the stderr read).
![target(unix)]
function collect_output(c: mut &Child) -> Result<Output, IoError> {
    mut stdout_buffer: Array<u8> = Array::new();
    mut stderr_buffer: Array<u8> = Array::new();
    mut chunk: u8[4096];

    // Extract raw fds (i32 is Copy, so reading `h.fd` through the match
    // arm doesn't consume the handle). Put each handle back into its
    // slot so the existing Drop impls close the fds when `c` drops.
    mut so_fd:   i32 = -1;
    mut so_open: boolean = false;
    match (c.stdout) {
        Option::Some(mut h) => {
            so_fd   = h.fd;
            so_open = true;
            set_nonblock(so_fd);
            c.stdout = Option::Some(h);
        }
        Option::None => { }
    }
    mut se_fd:   i32 = -1;
    mut se_open: boolean = false;
    match (c.stderr) {
        Option::Some(mut h) => {
            se_fd   = h.fd;
            se_open = true;
            set_nonblock(se_fd);
            c.stderr = Option::Some(h);
        }
        Option::None => { }
    }

    mut polls: libc::pollfd[2];
    while (so_open || se_open) {
        mut nfds:   u64 = 0;
        mut so_idx: i64 = -1;
        mut se_idx: i64 = -1;
        if (so_open) {
            polls[nfds].fd      = so_fd;
            polls[nfds].events  = libc::POLLIN;
            polls[nfds].revents = 0 as i16;
            so_idx = nfds as i64;
            nfds = nfds + 1;
        }
        if (se_open) {
            polls[nfds].fd      = se_fd;
            polls[nfds].events  = libc::POLLIN;
            polls[nfds].revents = 0 as i16;
            se_idx = nfds as i64;
            nfds = nfds + 1;
        }

        const pr: i32 = libc::poll(&polls[0], nfds, -1);
        if (pr < 0) {
            const err: IoError = IoError::from_errno(libc::errno());
            match (err.kind) {
                IoErrorKind::Interrupted => { continue; }
                _ => { return Result::Err(err); }
            }
        }

        if (so_idx >= 0) {
            const ev: i16 = polls[so_idx as u64].revents;
            const ready: i16 = ev & (libc::POLLIN | libc::POLLHUP | libc::POLLERR);
            if (ready != 0) {
                match (drain_nonblock(so_fd, &chunk[0], 4096, &stdout_buffer)) {
                    DrainOutcome::Eof       => { so_open = false; }
                    DrainOutcome::Again     => { }
                    DrainOutcome::Failed(e) => { return Result::Err(e); }
                }
            }
        }
        if (se_idx >= 0) {
            const ev: i16 = polls[se_idx as u64].revents;
            const ready: i16 = ev & (libc::POLLIN | libc::POLLHUP | libc::POLLERR);
            if (ready != 0) {
                match (drain_nonblock(se_fd, &chunk[0], 4096, &stderr_buffer)) {
                    DrainOutcome::Eof       => { se_open = false; }
                    DrainOutcome::Again     => { }
                    DrainOutcome::Failed(e) => { return Result::Err(e); }
                }
            }
        }
    }

    match (c.wait()) {
        Result::Ok(status) => {
            return Result::Ok(Output {
                status: status,
                stdout: stdout_buffer,
                stderr: stderr_buffer
            });
        }
        Result::Err(err) => {
            return Result::Err(err);
        }
    }
}

/// Best-effort: switch `fd` to non-blocking by OR'ing `O_NONBLOCK`
/// into its file-status flags. Failure is ignored - if the kernel
/// won't take the flag we fall back to whatever poll(2) decides.
![target(unix)]
function set_nonblock(fd: i32) -> void {
    const cur: i32 = libc::fcntl(fd, libc::F_GETFL, 0 as i64);
    if (cur < 0) { return; }
    libc::fcntl(fd, libc::F_SETFL, (cur | libc::O_NONBLOCK) as i64);
}

/// Outcome of one non-blocking drain cycle. `Eof` means the writer
/// has closed its end; `Again` means EAGAIN/EWOULDBLOCK - there are
/// no bytes available right now, wait on poll again.
type enum DrainOutcome {
    Eof;
    Again;
    Failed(IoError);
}

/// Read every available byte from `fd` into `buf`, returning the
/// stopping reason. `fd` must already be in non-blocking mode.
![target(unix)]
function drain_nonblock(fd: i32, chunk: u8*, chunk_len: u64, buf: mut &Array<u8>) -> DrainOutcome {
    loop {
        const n: i64 = libc::read(fd, chunk, chunk_len);
        if (n > 0) {
            mut i: u64 = 0;
            while (i < n as u64) { buf.push(chunk[i]); i = i + 1; }
            continue;
        }
        if (n == 0) { return DrainOutcome::Eof; }
        const err: IoError = IoError::from_errno(libc::errno());
        match (err.kind) {
            IoErrorKind::Interrupted => { continue; }
            IoErrorKind::WouldBlock  => { return DrainOutcome::Again; }
            _ => { return DrainOutcome::Failed(err); }
        }
    }
}


// ===========================================================================
// Windows (CreateProcess) implementation.
//
// Windows has no fork+exec: a process is created in one CreateProcessA call
// that takes a single mutable command-line STRING (not an argv array) plus a
// STARTUPINFO carrying inheritable std handles.  Pipe ends created with
// CreatePipe are bridged into CRT file descriptors via `_open_osfhandle`, so
// the existing fd-based ChildStdin/Stdout/Stderr + io::fd read/write/close
// machinery is reused unchanged.
//
// v1 scope: Inherit and Piped stdio (covers `output()` and the common
// inherit-spawn).  `Stdio::Null` and `Stdio::Fd` fall back to Inherit on
// Windows; `clear_env`/per-var env overrides and `cwd` beyond a plain path
// are not yet applied here.  `collect_output` drains stdout then stderr
// sequentially (blocking) rather than via poll, so a child that fills the
// stderr pipe buffer before its stdout is consumed could stall - fine for the
// typical bounded-output case.
// ===========================================================================

// Per-stream Windows stdio wiring produced by `win_setup_stdio`.
![target(windows)]
type struct WinStdio {
    child_handle: u8*;   // handle handed to the child via STARTUPINFO
    parent_fd:    i32;   // parent pipe end as a CRT fd, or -1
    extra_close:  u8*;   // child pipe end the parent must close post-spawn, or null
    ok:           boolean;

    drop(mut &this) -> void { }
}

// Append `arg` to `out` applying the standard CommandLineToArgvW quoting:
// wrap in double quotes when empty or containing space/tab/quote, doubling
// backslashes that precede a quote (or the closing quote) and escaping
// embedded quotes.
![target(windows)]
function win_append_quoted(out: mut &String, arg: &String) -> void {
    const p: u8* = arg.as_ptr();
    const n: u64 = arg.length();
    mut need: boolean = (n == 0u64);
    mut s: u64 = 0u64;
    while (s < n) {
        const c: u8 = p[s];
        if (c == 32u8 || c == 9u8 || c == 34u8) { need = true; }
        s = s + 1u64;
    }
    if (!need) {
        mut k: u64 = 0u64;
        while (k < n) { out.push(p[k]); k = k + 1u64; }
        return;
    }
    out.push(34u8);   // opening quote
    mut j: u64 = 0u64;
    while (j < n) {
        mut bs: u64 = 0u64;
        while (j < n && p[j] == 92u8) { bs = bs + 1u64; j = j + 1u64; }
        if (j == n) {
            mut d: u64 = 0u64;
            while (d < bs * 2u64) { out.push(92u8); d = d + 1u64; }
        } else if (p[j] == 34u8) {
            mut d: u64 = 0u64;
            while (d < bs * 2u64 + 1u64) { out.push(92u8); d = d + 1u64; }
            out.push(34u8);
            j = j + 1u64;
        } else {
            mut d: u64 = 0u64;
            while (d < bs) { out.push(92u8); d = d + 1u64; }
            out.push(p[j]);
            j = j + 1u64;
        }
    }
    out.push(34u8);   // closing quote
}

// Build the NUL-terminated command line "program arg1 arg2 ..." for
// CreateProcessA (which may modify the buffer in place).
![target(windows)]
function build_cmdline(cmd: &Command) -> String {
    mut cl: String = String::new();
    win_append_quoted(&cl, &cmd.program);
    mut i: u64 = 0u64;
    while (i < cmd.args.length()) {
        match (cmd.args.get_ref(i)) {
            Option::Some(a) => { cl.push(32u8); win_append_quoted(&cl, a); }
            Option::None    => { break; }
        }
        i = i + 1u64;
    }
    cl.push(0u8);   // NUL terminator (kept in the buffer)
    return cl;
}

// Append every byte of `s` to `blk` (no terminator).
![target(windows)]
function win_append_bytes(blk: &String, s: &String) -> void {
    const p: u8* = s.as_ptr();
    const n: u64 = s.length();
    mut i: u64 = 0u64;
    while (i < n) { blk.push(p[i]); i = i + 1u64; }
}

// True if the `KEY=VALUE\0` entry at `entry` has key exactly `key` (i.e. the
// bytes match and the entry's key ends right at the `=`).  Used to drop an
// inherited variable that the caller overrides.
![target(windows)]
function win_env_key_matches(entry: u8*, key: &String) -> boolean {
    const klen: u64 = key.length();
    const kp: u8* = key.as_ptr();
    mut i: u64 = 0u64;
    while (i < klen) {
        if (entry[i] != kp[i]) { return false; }
        i = i + 1u64;
    }
    return entry[klen] == 61u8;  // '='
}

// Build the ANSI environment block for CreateProcessA: a sequence of
// `KEY=VALUE\0` entries terminated by an extra `\0`.  Returns an empty
// String (caller passes null -> inherit verbatim) only when there is
// nothing to change.  When `clear_env_flag` is set the inherited block is
// skipped; otherwise inherited entries are copied except those the caller
// overrides (so overrides win), then the overrides are appended.  We use the
// ANSI block (no CREATE_UNICODE_ENVIRONMENT), matching CreateProcessA's
// `lpCommandLine`/`lpCurrentDirectory` ANSI strings.
![target(windows)]
function build_env_block(cmd: &Command) -> String {
    mut blk: String = String::new();

    if (!cmd.clear_env_flag) {
        const base: u8* = syscall::GetEnvironmentStrings();
        if (base != null) {
            mut i: u64 = 0u64;
            while (base[i] != 0u8) {        // until the block's double-NUL
                const start: u64 = i;
                mut overridden: boolean = false;
                mut e: u64 = 0u64;
                while (e < cmd.envs.length()) {
                    match (cmd.envs.get_ref(e)) {
                        Option::Some(en) => {
                            if (win_env_key_matches(&base[start], &en.key)) {
                                overridden = true;
                            }
                        }
                        Option::None => { }
                    }
                    e = e + 1u64;
                }
                // Copy (or skip) the whole `KEY=VALUE\0` entry.
                while (base[i] != 0u8) {
                    if (!overridden) { blk.push(base[i]); }
                    i = i + 1u64;
                }
                if (!overridden) { blk.push(0u8); }
                i = i + 1u64;              // step past the entry's NUL
            }
            syscall::FreeEnvironmentStringsA(base);
        }
    }

    // Append the caller's overrides as KEY=VALUE\0.
    mut e2: u64 = 0u64;
    while (e2 < cmd.envs.length()) {
        match (cmd.envs.get_ref(e2)) {
            Option::Some(en) => {
                win_append_bytes(&blk, &en.key);
                blk.push(61u8);           // '='
                win_append_bytes(&blk, &en.value);
                blk.push(0u8);
            }
            Option::None => { }
        }
        e2 = e2 + 1u64;
    }

    blk.push(0u8);  // block terminator (block ends in `\0\0`)
    return blk;
}

// Wire one std stream for the child.  Piped creates an inheritable pipe and
// bridges the parent end to a CRT fd; everything else inherits the parent's
// corresponding std handle.
![target(windows)]
function win_setup_stdio(setting: Stdio, std_id: u32, is_input: boolean) -> WinStdio {
    match (setting) {
        Stdio::Piped => {
            mut rd: u8* = null;
            mut wr: u8* = null;
            mut sa: syscall::SECURITY_ATTRIBUTES = syscall::SECURITY_ATTRIBUTES {
                nLength: 24u32, lpSecurityDescriptor: null, bInheritHandle: 1
            };
            if (syscall::CreatePipe(&rd, &wr, &sa as u8*, 0u32) == 0) {
                return WinStdio { child_handle: null, parent_fd: -1, extra_close: null, ok: false };
            }
            if (is_input) {
                // child reads `rd` (inheritable); parent writes `wr`.
                syscall::SetHandleInformation(wr, syscall::HANDLE_FLAG_INHERIT, 0u32);
                const f: i32 = _open_osfhandle(wr as i64, 0);
                return WinStdio { child_handle: rd, parent_fd: f, extra_close: rd, ok: true };
            }
            // child writes `wr` (inheritable); parent reads `rd`.
            syscall::SetHandleInformation(rd, syscall::HANDLE_FLAG_INHERIT, 0u32);
            const f: i32 = _open_osfhandle(rd as i64, 0);
            return WinStdio { child_handle: wr, parent_fd: f, extra_close: wr, ok: true };
        }
        Stdio::Null => {
            // Discard the child's stream by handing it an inheritable handle
            // on the null device (`NUL`), instead of the v1 behaviour of
            // inheriting the parent's std handle (which leaked the child's
            // output onto the parent's console).
            mut sa: syscall::SECURITY_ATTRIBUTES = syscall::SECURITY_ATTRIBUTES {
                nLength: 24u32, lpSecurityDescriptor: null, bInheritHandle: 1
            };
            mut nul_path: String = String::from_str_c(Str::new("NUL"));
            mut access: u32 = syscall::GENERIC_WRITE;
            if (is_input) { access = syscall::GENERIC_READ; }
            const h: u8* = syscall::CreateFileA(nul_path.as_ptr(), access,
                syscall::FILE_SHARE_READ | syscall::FILE_SHARE_WRITE,
                &sa as u8*, syscall::OPEN_EXISTING, 0u32, null);
            // CreateFileA returns INVALID_HANDLE_VALUE (-1) on failure. Compare
            // against a local -1, not syscall::INVALID_HANDLE_VALUE (a
            // cross-module const i64 that mis-evaluates; selfhost bug #1).
            if ((h as i64) == -1) {
                return WinStdio { child_handle: null, parent_fd: -1, extra_close: null, ok: false };
            }
            // Parent owns the NUL handle; close it after the child inherits it.
            return WinStdio { child_handle: h, parent_fd: -1, extra_close: h, ok: true };
        }
        _ => {
            // Inherit (and the v1 Fd fallback): hand the child our own
            // std handle; nothing for the parent to close or wrap.
            return WinStdio { child_handle: syscall::GetStdHandle(std_id),
                              parent_fd: -1, extra_close: null, ok: true };
        }
    }
}

![target(windows)]
function spawn_impl(cmd: &Command) -> Result<Child, IoError> {
    const sin:  WinStdio = win_setup_stdio(cmd.stdin_cfg,  syscall::STD_INPUT_HANDLE,  true);
    if (!sin.ok)  { return Result::Err(IoError::new(IoErrorKind::Other, 0)); }
    const sout: WinStdio = win_setup_stdio(cmd.stdout_cfg, syscall::STD_OUTPUT_HANDLE, false);
    if (!sout.ok) { return Result::Err(IoError::new(IoErrorKind::Other, 0)); }
    const serr: WinStdio = win_setup_stdio(cmd.stderr_cfg, syscall::STD_ERROR_HANDLE,  false);
    if (!serr.ok) { return Result::Err(IoError::new(IoErrorKind::Other, 0)); }

    mut cmdline: String = build_cmdline(cmd);

    mut cwd_cstr: String = String::new();
    mut cwd_ptr:  u8* = null;
    match (cmd.cwd) {
        Option::Some(path) => {
            cwd_cstr = String::from_str_c(path.as_str());
            cwd_ptr  = cwd_cstr.as_ptr();
        }
        Option::None => { }
    }

    mut si: syscall::STARTUPINFOA = syscall::STARTUPINFOA {
        cb: 104u32, lpReserved: null, lpDesktop: null, lpTitle: null,
        dwX: 0u32, dwY: 0u32, dwXSize: 0u32, dwYSize: 0u32,
        dwXCountChars: 0u32, dwYCountChars: 0u32, dwFillAttribute: 0u32,
        dwFlags: syscall::STARTF_USESTDHANDLES, wShowWindow: 0u16, cbReserved2: 0u16,
        lpReserved2: null,
        hStdInput: sin.child_handle, hStdOutput: sout.child_handle, hStdError: serr.child_handle
    };
    mut pi: syscall::PROCESS_INFORMATION = syscall::PROCESS_INFORMATION {
        hProcess: null, hThread: null, dwProcessId: 0u32, dwThreadId: 0u32
    };

    // Apply env overrides / env_clear via an explicit ANSI environment block.
    // When there's nothing to change, pass null so the child inherits the
    // parent's environment verbatim. `env_block` must outlive CreateProcessA
    // (which copies it); it drops at function exit.
    mut env_block: String = String::new();
    mut env_ptr: u8* = null;
    if (cmd.clear_env_flag || cmd.envs.length() > 0u64) {
        env_block = build_env_block(cmd);
        env_ptr = env_block.as_ptr();
    }

    const ok: i32 = syscall::CreateProcessA(null, cmdline.as_ptr(), null, null,
                                            1, 0u32, env_ptr, cwd_ptr, &si, &pi);

    // Parent closes the child's pipe ends now that they have been inherited.
    if (sin.extra_close  != null) { syscall::CloseHandle(sin.extra_close); }
    if (sout.extra_close != null) { syscall::CloseHandle(sout.extra_close); }
    if (serr.extra_close != null) { syscall::CloseHandle(serr.extra_close); }

    if (ok == 0) {
        if (sin.parent_fd  >= 0) { fd::close_fd(sin.parent_fd); }
        if (sout.parent_fd >= 0) { fd::close_fd(sout.parent_fd); }
        if (serr.parent_fd >= 0) { fd::close_fd(serr.parent_fd); }
        return Result::Err(IoError::new(IoErrorKind::Other, 0));
    }
    syscall::CloseHandle(pi.hThread);

    mut stdin_handle:  Option<ChildStdin>  = Option::None;
    mut stdout_handle: Option<ChildStdout> = Option::None;
    mut stderr_handle: Option<ChildStderr> = Option::None;
    if (sin.parent_fd  >= 0) { stdin_handle  = Option::Some(ChildStdin::from_fd(sin.parent_fd)); }
    if (sout.parent_fd >= 0) { stdout_handle = Option::Some(ChildStdout::from_fd(sout.parent_fd)); }
    if (serr.parent_fd >= 0) { stderr_handle = Option::Some(ChildStderr::from_fd(serr.parent_fd)); }

    return Result::Ok(Child::new(pi.dwProcessId as i32, pi.hProcess as u64,
                                 stdin_handle, stdout_handle, stderr_handle));
}

// Blocking drain of a CRT fd to EOF.
![target(windows)]
function win_drain(fd_no: i32, chunk: u8*, chunk_len: u64, buf: mut &Array<u8>) -> Result<(), IoError> {
    loop {
        match (fd::read_fd(fd_no, chunk, chunk_len)) {
            Result::Ok(n) => {
                if (n == 0u64) { return Result::Ok(()); }
                mut i: u64 = 0u64;
                while (i < n) { buf.push(chunk[i]); i = i + 1u64; }
            }
            Result::Err(e) => { return Result::Err(e); }
        }
    }
}

![target(windows)]
function collect_output(c: mut &Child) -> Result<Output, IoError> {
    mut stdout_buffer: Array<u8> = Array::new();
    mut stderr_buffer: Array<u8> = Array::new();
    mut chunk: u8[4096];

    mut so_fd: i32 = -1;
    match (c.stdout) {
        Option::Some(mut h) => { so_fd = h.fd; c.stdout = Option::Some(h); }
        Option::None => { }
    }
    mut se_fd: i32 = -1;
    match (c.stderr) {
        Option::Some(mut h) => { se_fd = h.fd; c.stderr = Option::Some(h); }
        Option::None => { }
    }

    if (so_fd >= 0) {
        match (win_drain(so_fd, &chunk[0], 4096, &stdout_buffer)) {
            Result::Ok(_)  => { }
            Result::Err(e) => { return Result::Err(e); }
        }
    }
    if (se_fd >= 0) {
        match (win_drain(se_fd, &chunk[0], 4096, &stderr_buffer)) {
            Result::Ok(_)  => { }
            Result::Err(e) => { return Result::Err(e); }
        }
    }

    match (c.wait()) {
        Result::Ok(status) => {
            return Result::Ok(Output { status: status, stdout: stdout_buffer, stderr: stderr_buffer });
        }
        Result::Err(err) => { return Result::Err(err); }
    }
}
