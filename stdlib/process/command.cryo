///! Command: builder for spawning a subprocess.
///!
///! The typical flow:
///!
///! ```cryo
///! import std::collections::str::{ Str };
///! import std::process::child::{ Child };
///! import std::process::command::{ Command, Stdio };
///!
///! mut cmd: Command = Command::new(Str::new("ls"));
///! cmd.arg(Str::new("-la")).current_directory(Str::new("/tmp")).stdout(Stdio::Piped);
///! mut child: Child = cmd.spawn().unwrap();
///! // read from child.stdout, wait, etc.
///! ```
///!
///! Under the hood: fork(), adjust fds and env in the child, execvp on
///! POSIX; one CreateProcess call on Windows. A program that cannot be
///! started is `spawn`'s error, naming the program (`could not start
///! tool: not found`), or the working directory when that was what
///! could not be entered - never a child that exits 127.

namespace std::process::command;

import std::core::intrinsics;
import std::core::option::{ Option };
import std::core::result::{ Result };
import std::core::slice::{ Slice };
import std::core::drop::{ Drop };
import std::core::mem;
import std::io::error::{ IoError, IoErrorKind, IoOperation };
import std::fs::path::{ Path };
import std::io::fd;
import std::io::fd::{ BorrowedFileDescriptor };
import std::io::traits::{ Read };
import std::core::iter::{ Iterator };
import std::collections::array::{ Array };
import std::collections::str::{ Str };
import std::collections::string::{ String };
import std::ffi::libc;
import std::sys::syscall::{ SECURITY_ATTRIBUTES, STARTUPINFOW, PROCESS_INFORMATION };
import std::encoding::utf16::{ Utf16 };
import std::alloc::layout;
import std::process::child::{
    Child, ChildStderr, ChildStdin, ChildStdout, ExitStatus, PipeDrain
};
import std::future::poll;
import std::future::waker;
import std::future::traits;
import std::future::combinator::{ Futures };

/// How a child's stdin / stdout / stderr is wired up.
public type enum Stdio {
    /// Share the parent's fd (the default).
    Inherit;
    /// Redirect to / from `/dev/null`.
    Null;
    /// Create a pipe; the parent keeps its end in the resulting
    /// `Child::stdin` / `stdout` / `stderr`.
    Piped;
    /// Use a specific fd. Ownership transfers; the spawn closes
    /// the fd in the parent after duping it into the child.
    Fd(i32);
    /// Stderr only: write to wherever the child's stdout goes, so a
    /// `Piped` stdout captures both streams, interleaved as written.
    /// Spawning with it on stdin or stdout fails with `InvalidInput`.
    SameAsStdout;
}

/// One change to the child's environment: `value` set, or `None` for a
/// variable removed. A command holds at most one entry per key.
private type struct EnvEntry {
    private key: String;
    private value: Option<String>;
}

/// A program to run and how to run it: its arguments, environment, working
/// directory and standard streams. Configure it with the chaining setters,
/// then start it with `spawn` (a running `Child`), `status` (wait for the
/// exit), `output` (wait and capture both streams), or their async
/// spellings `run` and `collect`. One command can be started any number of
/// times.
///
/// ```cryo
/// import std::collections::str::{ Str };
/// import std::process::command::{ Command, Output };
///
/// mut command: Command = Command::new(Str::new("git"));
/// command.arg(Str::new("--version"));
/// const output: Output = command.output().unwrap();
/// // output.status().success(), output.stdout() holds "git version ..."
/// ```
public type struct Command {
    private program: String;
    private args: Array<String>;
    private envs: Array<EnvEntry>;
    private clear_env_flag: boolean;
    private group_descendants_flag: boolean;
    private current_directory: Option<String>;
    private stdin_cfg: Stdio;
    private stdout_cfg: Stdio;
    private stderr_cfg: Stdio;

    /// Start a new command targeting `program`. The name is looked up at
    /// spawn time: against `$PATH` by `execvp` on POSIX, by
    /// `CreateProcessW`'s own search (which ends with `PATH`) on Windows.
    /// Pass an absolute path to skip the lookup.
    public static new(program: Str) -> Command {
        return Command {
            program: String::from_str(program),
            args: Array::new(),
            envs: Array::new(),
            clear_env_flag: false,
            group_descendants_flag: false,
            current_directory: Option::None,
            stdin_cfg: Stdio::Inherit,
            stdout_cfg: Stdio::Inherit,
            stderr_cfg: Stdio::Inherit
        };
    }

    // Every setter returns the command, so a configuration chains:
    // `command.arg(Str::new("-c")).arg(script).stdout(Stdio::Piped);`

    /// Add one argument after those already added.
    public arg(mut &this, value: Str) -> mut &Command {
        this.args.push(String::from_str(value));
        return &this;
    }

    /// Add every argument `values` yields, in order, after those already
    /// added.
    public args<I>(mut &this, values: I) -> mut &Command
    where I: Iterator<Str> {
        mut remaining: I = values;
        loop {
            match (remaining.next()) {
                Option::Some(value) => { this.args.push(String::from_str(value)); }
                Option::None => { break; }
            }
        }
        return &this;
    }

    /// Set the environment variable `key` to `value` in the child. Replaces
    /// an earlier `env` or `env_remove` of the same key.
    public env(mut &this, key: Str, value: Str) -> mut &Command {
        this.envs.retain((entry: &EnvEntry) -> boolean { return entry.key.as_str() != key; });
        this.envs.push(EnvEntry {
            key: String::from_str(key),
            value: Option::Some(String::from_str(value))
        });
        return &this;
    }

    /// Start the child without the variable `key`, even though the parent
    /// has it. Replaces an earlier `env` of the same key.
    public env_remove(mut &this, key: Str) -> mut &Command {
        this.envs.retain((entry: &EnvEntry) -> boolean { return entry.key.as_str() != key; });
        this.envs.push(EnvEntry { key: String::from_str(key), value: Option::None });
        return &this;
    }

    /// Don't inherit the parent's environment. Only the variables set
    /// with `env()` reach the child.
    public env_clear(mut &this) -> mut &Command {
        this.clear_env_flag = true;
        return &this;
    }

    /// Start the child as the root of a process tree of its own - a new
    /// process group on POSIX, a job object on Windows - that every
    /// process it starts joins, so `Child.kill_tree` ends them all.
    ///
    /// A descendant that leaves the tree on purpose (POSIX `setsid` or
    /// `setpgid`, a Windows job breakaway) is beyond its reach. On POSIX
    /// the new group is no longer the terminal's foreground group, so the
    /// terminal's Ctrl-C reaches the parent and not the child. On Windows
    /// the child also roots a new console process group: Ctrl-C is off in
    /// it, and Ctrl-Break, the interrupt a parent can send to that group
    /// alone, reaches the child and its tree.
    public group_descendants(mut &this) -> mut &Command {
        this.group_descendants_flag = true;
        return &this;
    }

    /// The directory the child starts in; without one it starts in the
    /// parent's current directory. A second call replaces the first.
    public current_directory(mut &this, path: Str) -> mut &Command {
        // A write through `mut &this` does not release what it replaces, so
        // the new directory is swapped in and the old one leaves in
        // `replaced`, released at the end of this body.
        mut replaced: Option<String> = Option::Some(String::from_str(path));
        mem::swap::<Option<String>>(&replaced, &this.current_directory);
        return &this;
    }

    /// How the child's standard input is wired up.
    public stdin(mut &this, setting: Stdio) -> mut &Command {
        this.stdin_cfg = setting;
        return &this;
    }

    /// How the child's standard output is wired up.
    public stdout(mut &this, setting: Stdio) -> mut &Command {
        this.stdout_cfg = setting;
        return &this;
    }

    /// How the child's standard error is wired up.
    public stderr(mut &this, setting: Stdio) -> mut &Command {
        this.stderr_cfg = setting;
        return &this;
    }

    // Spawning

    /// fork + configure fds/env + execvp on POSIX; one `CreateProcessW`
    /// call on Windows. Returns a `Child` the caller must eventually `wait`
    /// on.
    public spawn(&this) -> Result<Child, IoError> {
        const misplaced: boolean = match (this.stdin_cfg) {
            Stdio::SameAsStdout => { true }
            _                   => { false }
        } || match (this.stdout_cfg) {
            Stdio::SameAsStdout => { true }
            _                   => { false }
        };
        if (misplaced) {
            return Result::Err(IoError::new(IoErrorKind::InvalidInput, 0));
        }
        return spawn_impl(this);
    }

    /// spawn + wait + collect stdout/stderr into arrays. Stdin is
    /// left `Inherit` (or whatever the caller set). Use this for the
    /// common "run this and tell me what it printed" case.
    public output(&this) -> Result<Output, IoError> {
        // Force stdout + stderr to Piped so we can capture them.
        mut configured: Command = clone_command(this);
        configured.stdout_cfg = Stdio::Piped;
        configured.stderr_cfg = Stdio::Piped;
        const handle: Child = configured.spawn()?;
        mut c: Child = handle;
        return collect_output(&c);
    }

    /// spawn + wait. Stdin/out/err go wherever the caller configured
    /// (typically Inherit).
    public status(&this) -> Result<ExitStatus, IoError> {
        const handle: Child = this.spawn()?;
        mut c: Child = handle;
        return c.wait();
    }

    /// Spawn, capture both streams, and await the exit without blocking the
    /// calling thread: the async spelling of `output`.
    ///
    /// The two pipes are drained CONCURRENTLY. Draining one to EOF before
    /// starting the other deadlocks any child that fills the second pipe's
    /// buffer in the meantime — the kernel blocks the child's write, so the
    /// child never exits and the first pipe never reaches EOF. That is the same
    /// hazard the synchronous `output` interleaves its drains to avoid.
    ///
    /// The exit is awaited only after both pipes report EOF, which they do once
    /// the child has closed them. Ordering it that way keeps the blocking cost
    /// to the drains: on Windows a captured child occupies two pool threads
    /// while draining (one per pipe — its reactor cannot watch a pipe, see
    /// `PipeDrain`) and one while joining, never all three at once. On Linux
    /// the drains and the exit all sit on the reactor and occupy no pool thread
    /// at all. A program running N children concurrently should still size the
    /// pool for 2N on Windows.
    ///
    /// Cancelling mid-drain closes the captured pipes and leaves the child
    /// running — precisely the state `Child::drop` already handles.
    public async collect(&this) -> Result<Output, IoError> {
        mut configured: Command = clone_command(this);
        configured.stdout_cfg = Stdio::Piped;
        configured.stderr_cfg = Stdio::Piped;
        const handle: Child = configured.spawn()?;
        mut c: Child = handle;

        // Hand each descriptor to its drain, leaving the handle it came from
        // empty.  The handle stays in its slot so the `Child`'s teardown still
        // runs, but it closes nothing — the drain owns the descriptor now, and
        // closing it twice could land on a number an unrelated open has reused.
        mut so_fd: i32 = -1;
        if (c.stdout.is_some()) {
            so_fd = c.stdout.unwrap_ptr().into_descriptor();
        }
        mut se_fd: i32 = -1;
        if (c.stderr.is_some()) {
            se_fd = c.stderr.unwrap_ptr().into_descriptor();
        }

        mut drained: (Result<Array<u8>, IoError>, Result<Array<u8>, IoError>) =
            await Futures::join(PipeDrain::start(so_fd), PipeDrain::start(se_fd));

        // Swap each half out rather than reading `drained.0` / `drained.1`
        // directly: a tuple that owns a destructor still drops both fields at
        // scope exit, so moving one out would leave the tuple to free it a
        // second time. The placeholders left behind own nothing.
        mut r_out: Result<Array<u8>, IoError> = Result::Err(IoError::new(IoErrorKind::Other, 0));
        mut r_err: Result<Array<u8>, IoError> = Result::Err(IoError::new(IoErrorKind::Other, 0));
        mem::swap::<Result<Array<u8>, IoError>>(&r_out, &drained.0);
        mem::swap::<Result<Array<u8>, IoError>>(&r_err, &drained.1);

        mut out_buf: Array<u8> = Array::new();
        mut err_buf: Array<u8> = Array::new();
        mut failed:  Option<IoError> = Option::None;
        match (r_out) {
            Result::Ok(b)  => { out_buf = b; }
            Result::Err(e) => { failed = Option::Some(e); }
        }
        match (r_err) {
            Result::Ok(b)  => { err_buf = b; }
            Result::Err(e) => { failed = Option::Some(e); }
        }
        // Both halves are consumed before reporting either failure, so the
        // buffer belonging to the half that succeeded is released rather than
        // leaked on the error path.
        match (failed) {
            Option::Some(e) => {
                mem::drop(out_buf);
                mem::drop(err_buf);
                return Result::Err(e);
            }
            Option::None => { }
        }

        mut joined: Result<ExitStatus, IoError> = await c.join();
        match (joined) {
            Result::Ok(status) => {
                return Result::Ok(Output {
                    status: status,
                    stdout: out_buf,
                    stderr: err_buf
                });
            }
            Result::Err(e) => {
                mem::drop(out_buf);
                mem::drop(err_buf);
                return Result::Err(e);
            }
        }
    }

    /// Spawn and await the exit without capturing anything: the async spelling
    /// of `status`. Stdio goes wherever the caller configured it.
    ///
    /// A child whose output is left `Piped` and never drained can still fill a
    /// pipe buffer and stop making progress; use `collect` when anything is
    /// captured.
    public async run(&this) -> Result<ExitStatus, IoError> {
        const handle: Child = this.spawn()?;
        mut c: Child = handle;
        return await c.join();
    }

    /// Run `command` through the platform shell (`/bin/sh -c` on POSIX,
    /// `cmd /c` on Windows), inheriting stdio, and return the child's exit
    /// code (0 on success), or -1 if the shell could not be spawned or the
    /// child was killed by a signal. The cross-platform replacement for the
    /// raw `system(3)` intrinsic when a command genuinely needs shell
    /// semantics (pipes, redirects, glob expansion). For a plain program
    /// invocation, build the argv with `new`/`arg` and call `status` instead.
    ![target(unix)]
    public static shell(command: Str) -> i32 {
        mut c: Command = Command::new(Str::new("/bin/sh"));
        c.arg(Str::new("-c")).arg(command);
        return decode_shell_status(c.status());
    }

    // Windows: delegate to the C runtime's `system`, which drives `cmd /c`
    // with the correct command-line quoting.  Re-spawning `cmd /c <command>`
    // through `CreateProcess` argv instead mangles the embedded quotes of a
    // link/archiver command line (cmd's `/c` quote-stripping rules differ from
    // argv joining).  `system` returns the child's exit code directly (0 on
    // success), or -1 if the command interpreter could not be started.
    /// Run `command` through the platform shell (`/bin/sh -c` on POSIX,
    /// `cmd /c` on Windows, by way of the C runtime's `system`), inheriting
    /// stdio, and return the child's exit code (0 on success), or -1 if the
    /// shell could not be started. For a plain program invocation, build the
    /// argv with `new`/`arg` and call `status` instead.
    ![target(windows)]
    public static shell(command: Str) -> i32 {
        const text: String = String::with_null(command);
        return libc::system(text.as_ptr());
    }

}

/// Collapse a `status()` Result into a plain exit code: the child's code on
/// a normal exit (0 on success), or -1 on spawn failure / signal death.
/// Backs the POSIX `Command::shell` (the Windows one delegates to `system`).
![target(unix)]
private function decode_shell_status(r: Result<ExitStatus, IoError>) -> i32 {
    match (r) {
        Result::Ok(st) => {
            match (st.exit_code()) {
                Option::Some(code) => { return code; }
                Option::None       => { return -1; }
            }
        }
        Result::Err(_) => { return -1; }
    }
}

// Output: the result of `Command::output()`

/// What a finished child left behind, from `Command.output` or
/// `Command.collect`: its exit status and every byte it wrote to stdout
/// and to stderr.
public type struct Output {
    private status: ExitStatus;
    private stdout: Array<u8>;
    private stderr: Array<u8>;

    /// The child's decoded exit status.
    public status(&this) -> ExitStatus {
        return this.status;
    }

    /// Captured stdout as a borrowed byte slice. Valid until this
    /// `Output` is dropped; copy out anything you need to keep.
    public stdout(&this) -> &Slice<u8> {
        return this.stdout.as_slice();
    }

    /// Captured stderr as a borrowed byte slice. Valid until this
    /// `Output` is dropped.
    public stderr(&this) -> &Slice<u8> {
        return this.stderr.as_slice();
    }
}

// Implementation

/// Pipe-pair struct. `read_end` is what the reader uses;
/// `write_end` is what the writer uses. Both `-1` means no pipe was
/// created (Stdio was Inherit/Null/Fd).
private type struct PipePair {
    private read_end: i32;
    private write_end: i32;
}

![target(unix)]
private function make_pipe_pair() -> PipePair {
    return PipePair { read_end: -1, write_end: -1 };
}

/// Call pipe(2) and populate `pair`. Returns an IoError on failure.
![target(unix)]
private function create_pipe() -> Result<PipePair, IoError> {
    mut fds: [i32; 2];
    if (libc::pipe(&fds[0]) < 0) {
        return Result::Err(IoError::last_os_error());
    }
    return Result::Ok(PipePair { read_end: fds[0], write_end: fds[1] });
}

/// Build the pipe pair for a given Stdio setting. No-op for
/// Inherit/Null/Fd.
![target(unix)]
private function prepare_stdio(setting: Stdio) -> Result<PipePair, IoError> {
    return match (setting) {
        Stdio::Piped => { create_pipe() }
        _            => { Result::Ok(make_pipe_pair()) }
    }
}

/// After fork, in the child: replace `target_fd` (0/1/2) according
/// to `setting`. Returns false if the remap failed.
![target(unix)]
private function child_remap(setting: Stdio, pipe: &PipePair, target_fd: i32,
                     is_input: boolean) -> boolean {
    match (setting) {
        Stdio::Inherit => { return true; }
        Stdio::Null => {
            mut nullfd: i32 = 0;
            if (is_input) {
                nullfd = libc::open("/dev/null", libc::O_RDONLY, 0);
            } else {
                nullfd = libc::open("/dev/null", libc::O_WRONLY, 0);
            }
            if (nullfd < 0) { return false; }
            if (libc::dup2(nullfd, target_fd) < 0) { return false; }
            fd::close_fd(nullfd);
            return true;
        }
        Stdio::Piped => {
            const src: i32 = (is_input ? pipe.read_end : pipe.write_end);
            if (libc::dup2(src, target_fd) < 0) { return false; }
            // Close both ends after dup2; the target_fd now refers
            // to whichever end we wanted.
            if (pipe.read_end >= 0) { fd::close_fd(pipe.read_end); }
            if (pipe.write_end >= 0) { fd::close_fd(pipe.write_end); }
            return true;
        }
        Stdio::Fd(raw) => {
            if (libc::dup2(raw, target_fd) < 0) { return false; }
            fd::close_fd(raw);
            return true;
        }
        // Stdout is remapped before stderr, so fd 1 already names the
        // child's stdout here.
        Stdio::SameAsStdout => { return libc::dup2(1, target_fd) >= 0; }
    }
}

/// Build an argv u8** buffer from (program, args). `storage` keeps the
/// NUL-terminated argument strings alive; `argv`
/// aliases the `as_ptr()` of each (the heap buffers stay put even when
/// `storage` reallocates, since only the String headers move).  Only the
/// POSIX spawn hands the child an argv vector.
![target(unix)]
private function build_argv(program: &String,
                            args: &Array<String>,
                            storage: mut &Array<String>,
                            argv: mut &Array<u8*>) -> Result<(), IoError> {
    storage.push(String::with_null(program.as_str()));
    const slot: u8* = storage.get_ref(storage.length() - 1).unwrap().as_ptr();
    match (argv.try_push(slot)) {
        Result::Ok(_) => { }
        Result::Err(_) => {
            return Result::Err(IoError::new(IoErrorKind::OutOfMemory, 0));
        }
    }
    mut i: i64 = 0;
    while (i < args.length()) {
        match (args.get_ref(i)) {
            Option::Some(arg) => {
                storage.push(String::with_null(arg.as_str()));
                const arg_slot: u8* = storage.get_ref(storage.length() - 1).unwrap().as_ptr();
                match (argv.try_push(arg_slot)) {
                    Result::Ok(_) => { }
                    Result::Err(_) => {
                        return Result::Err(IoError::new(IoErrorKind::OutOfMemory, 0));
                    }
                }
            }
            Option::None => { break; }
        }
        i++;
    }
    match (argv.try_push(null)) {
        Result::Ok(_) => { }
        Result::Err(_) => {
            return Result::Err(IoError::new(IoErrorKind::OutOfMemory, 0));
        }
    }
    return Result::Ok(());
}

/// Build the child's environment overrides as NUL-terminated `KEY=VALUE`
/// C strings, entirely in the PARENT (before `fork`).  This is the
/// async-signal-safety counterpart to `build_argv`: the child must not
/// allocate or call `setenv`/`clearenv` (none are async-signal-safe, and
/// this stdlib ships `thread::spawn`, so a multi-threaded parent could
/// fork a child that deadlocks on the malloc lock).  `storage` keeps the
/// strings alive across the fork; `envp` aliases each one's `as_ptr()`
/// and is NUL-terminated so the child can hand it straight to `execvpe`
/// on the `clear_env` path.  The inherit path reads `storage` directly
/// via `putenv` (which stores the pointer without copying), and unsets
/// each NUL-terminated key in `removed`.
![target(unix)]
private function build_envp(envs: &Array<EnvEntry>,
                            storage: mut &Array<String>,
                            envp: mut &Array<u8*>,
                            removed: mut &Array<String>) -> Result<(), IoError> {
    mut i: i64 = 0;
    while (i < envs.length()) {
        match (envs.get_ref(i)) {
            Option::Some(entry) => {
                match (&entry.value) {
                    Option::Some(value) => {
                        // "KEY=VALUE\0" - one heap string, the terminator kept
                        // in the buffer for `as_ptr()` (C reads up to the
                        // first NUL).
                        mut joined: String = String::new();
                        joined.push(entry.key.as_str());
                        joined.push_byte('=' as u8);
                        joined.push(value.as_str());
                        joined.push_byte(0 as u8);
                        storage.push(joined);
                    }
                    Option::None => { removed.push(String::with_null(entry.key.as_str())); }
                }
            }
            Option::None => { break; }
        }
        i++;
    }
    // Pointer array for `execvpe`: one slot per pair + a NULL terminator.
    // Built after every push so `storage` no longer reallocates and the
    // aliased `as_ptr()` pointers stay valid (the char buffers are heap-
    // allocated separately from the moved String headers).
    mut j: i64 = 0;
    while (j < storage.length()) {
        const slot: u8* = storage.get_ref(j).unwrap().as_ptr();
        match (envp.try_push(slot)) {
            Result::Ok(_) => { }
            Result::Err(_) => {
                return Result::Err(IoError::new(IoErrorKind::OutOfMemory, 0));
            }
        }
        j++;
    }
    match (envp.try_push(null)) {
        Result::Ok(_) => { }
        Result::Err(_) => {
            return Result::Err(IoError::new(IoErrorKind::OutOfMemory, 0));
        }
    }
    return Result::Ok(());
}

![target(unix)]
private function spawn_impl(cmd: &Command) -> Result<Child, IoError> {
    // 1. Prepare pipes in the parent.
    mut stdin_pipe: PipePair = make_pipe_pair();
    stdin_pipe = prepare_stdio(cmd.stdin_cfg)?;
    mut stdout_pipe: PipePair = make_pipe_pair();
    match (prepare_stdio(cmd.stdout_cfg)) {
        Result::Ok(p) => { stdout_pipe = p; }
        Result::Err(err) => {
            close_pipe(&stdin_pipe);
            return Result::Err(err);
        }
    }
    mut stderr_pipe: PipePair = make_pipe_pair();
    match (prepare_stdio(cmd.stderr_cfg)) {
        Result::Ok(p) => { stderr_pipe = p; }
        Result::Err(err) => {
            close_pipe(&stdin_pipe);
            close_pipe(&stdout_pipe);
            return Result::Err(err);
        }
    }

    // 2. Build argv (parent-side; child inherits via fork COW).
    mut argv_storage: Array<String> = Array::new();
    mut argv: Array<u8*> = Array::new();
    match (build_argv(&cmd.program, &cmd.args, &argv_storage, &argv)) {
        Result::Ok(_) => { }
        Result::Err(err) => {
            close_pipe(&stdin_pipe);
            close_pipe(&stdout_pipe);
            close_pipe(&stderr_pipe);
            return Result::Err(err);
        }
    }

    // 3. Prepare an optional NUL-terminated cwd path.
    mut cwd_cstr: Option<String> = Option::None;
    match (&cmd.current_directory) {
        Option::Some(path) => {
            cwd_cstr = Option::Some(String::with_null(path.as_str()));
        }
        Option::None => { }
    }

    // 3b. Build the child environment in the parent (so the child needs no
    // malloc / setenv / clearenv - none are async-signal-safe).  `envp` is
    // only consumed on the clear-env path; the inherit path reads the
    // `envp_storage` strings directly via `putenv` below.
    mut envp_storage: Array<String> = Array::new();
    mut envp: Array<u8*> = Array::new();
    mut removed_keys: Array<String> = Array::new();
    match (build_envp(&cmd.envs, &envp_storage, &envp, &removed_keys)) {
        Result::Ok(_) => { }
        Result::Err(err) => {
            close_pipe(&stdin_pipe);
            close_pipe(&stdout_pipe);
            close_pipe(&stderr_pipe);
            return Result::Err(err);
        }
    }

    // 3c. The failure pipe: close-on-exec, so a successful exec closes the
    // child's write end and the parent reads end of file; a child that fails
    // before or at exec writes its step and `errno` there instead.
    mut failure_ends: [i32; 2];
    if (libc::pipe2(&failure_ends[0], libc::O_CLOEXEC) < 0) {
        const err: IoError = IoError::last_os_error();
        close_pipe(&stdin_pipe);
        close_pipe(&stdout_pipe);
        close_pipe(&stderr_pipe);
        return Result::Err(err);
    }
    const failure_pipe: PipePair = PipePair { read_end: failure_ends[0], write_end: failure_ends[1] };

    // 4. fork.
    const pid: i32 = libc::fork();
    if (pid < 0) {
        const err: IoError = IoError::last_os_error();
        close_pipe(&stdin_pipe);
        close_pipe(&stdout_pipe);
        close_pipe(&stderr_pipe);
        close_pipe(&failure_pipe);
        return Result::Err(err);
    }

    if (pid == 0) {
        // -------- child --------
        // Only async-signal-safe operations from here until exec or _exit:
        // chdir/dup2/close/open/putenv/execvp/execvpe are all safe.  The
        // environment was assembled in the parent (`build_envp`) precisely
        // so the child performs no allocation and never calls
        // setenv/clearenv (which are NOT async-signal-safe).
        fd::close_fd(failure_pipe.read_end);
        // The child leads a new group, so a signal to the group reaches
        // everything it starts.
        if (cmd.group_descendants_flag && libc::setpgid(0, 0) < 0) {
            report_spawn_failure(failure_pipe.write_end, SPAWN_STEP_SETUP);
        }
        if (!child_remap(cmd.stdin_cfg, &stdin_pipe, 0, true)) { report_spawn_failure(failure_pipe.write_end, SPAWN_STEP_SETUP); }
        if (!child_remap(cmd.stdout_cfg, &stdout_pipe, 1, false)) { report_spawn_failure(failure_pipe.write_end, SPAWN_STEP_SETUP); }
        if (!child_remap(cmd.stderr_cfg, &stderr_pipe, 2, false)) { report_spawn_failure(failure_pipe.write_end, SPAWN_STEP_SETUP); }

        // cwd change.
        match (cwd_cstr) {
            Option::Some(path) => {
                if (libc::chdir(path.as_ptr()) < 0) { report_spawn_failure(failure_pipe.write_end, SPAWN_STEP_DIRECTORY); }
            }
            Option::None => { }
        }

        // Apply the environment, then exec.
        //  - clear_env: replace the inherited environment wholesale by
        //    handing the parent-built `envp` to `execvpe` (PATH search,
        //    like execvp) - no clearenv, no per-var work in the child.
        //  - inherit + overrides: `putenv` each pre-built "KEY=VALUE"
        //    string (stored by pointer, not copied), then inherit the
        //    rest via `execvp`.  `putenv` may grow the environ array once
        //    when adding a key not already present; that single libc-
        //    internal alloc is the only residual on the inherit path and
        //    is unavoidable without enumerating the inherited environment
        //    (which the stdlib does not yet expose).
        //    A removed variable is `unsetenv`ed first; like `putenv` it
        //    edits the environ array in place.
        //  - inherit, no overrides: plain `execvp`.
        if (cmd.clear_env_flag) {
            libc::execvpe(argv[0], argv.as_ptr(), envp.as_ptr());
        } else {
            mut ri: i64 = 0;
            while (ri < removed_keys.length()) {
                libc::unsetenv(removed_keys.get_ref(ri).unwrap().as_ptr());
                ri = ri + 1;
            }
            mut ei: i64 = 0;
            while (ei < envp_storage.length()) {
                libc::putenv(envp_storage.get_ref(ei).unwrap().as_ptr());
                ei = ei + 1;
            }
            libc::execvp(argv[0], argv.as_ptr());
        }
        // If we got here, exec failed.
        report_spawn_failure(failure_pipe.write_end, SPAWN_STEP_EXEC);
    }

    // -------- parent --------
    // The child's write end closes here; the read below then sees end of
    // file once the child has exec'd (close-on-exec) or written a failure.
    fd::close_fd(failure_pipe.write_end);
    mut failure: [i32; 2];
    mut failure_read: i64 = 0;
    loop {
        failure_read = libc::read(failure_pipe.read_end, &failure[0] as mut u8*, 8);
        if (failure_read >= 0) { break; }
        if (libc::errno() != libc::EINTR) { break; }
    }
    fd::close_fd(failure_pipe.read_end);
    if (failure_read == 8) {
        // The child exited at once; reap it so no zombie is left behind.
        mut reaped_status: i32 = 0;
        while (libc::waitpid(pid, &reaped_status, 0) < 0 && libc::errno() == libc::EINTR) { }
        close_pipe(&stdin_pipe);
        close_pipe(&stdout_pipe);
        close_pipe(&stderr_pipe);
        match (cmd.stdin_cfg) { Stdio::Fd(raw) => { fd::close_fd(raw); } _ => { } }
        match (cmd.stdout_cfg) { Stdio::Fd(raw) => { fd::close_fd(raw); } _ => { } }
        match (cmd.stderr_cfg) { Stdio::Fd(raw) => { fd::close_fd(raw); } _ => { } }
        return Result::Err(spawn_error(cmd, IoError::from_errno(failure[1]), failure[0] == SPAWN_STEP_DIRECTORY));
    }
    // Close the ends of each pipe that belong to the child.
    // For `Stdio::Fd`, ownership of the fd transferred to the spawn: the
    // child duped it into place (`child_remap`) before exec, so the parent
    // must close its own copy here. Without it the caller's fd leaks on
    // every `Fd`-configured spawn (the doc on `Stdio::Fd` promised this).
    match (cmd.stdin_cfg) {
        Stdio::Piped => {
            if (stdin_pipe.read_end >= 0) { fd::close_fd(stdin_pipe.read_end); }
            stdin_pipe.read_end = -1;
        }
        Stdio::Fd(raw) => {
            if (raw >= 0) { fd::close_fd(raw); }
        }
        _ => { }
    }
    match (cmd.stdout_cfg) {
        Stdio::Piped => {
            if (stdout_pipe.write_end >= 0) { fd::close_fd(stdout_pipe.write_end); }
            stdout_pipe.write_end = -1;
        }
        Stdio::Fd(raw) => {
            if (raw >= 0) { fd::close_fd(raw); }
        }
        _ => { }
    }
    match (cmd.stderr_cfg) {
        Stdio::Piped => {
            if (stderr_pipe.write_end >= 0) { fd::close_fd(stderr_pipe.write_end); }
            stderr_pipe.write_end = -1;
        }
        Stdio::Fd(raw) => {
            if (raw >= 0) { fd::close_fd(raw); }
        }
        _ => { }
    }

    mut stdin_handle: Option<ChildStdin> = Option::None;
    mut stdout_handle: Option<ChildStdout> = Option::None;
    mut stderr_handle: Option<ChildStderr> = Option::None;
    match (cmd.stdin_cfg) {
        Stdio::Piped => {
            stdin_handle = Option::Some(ChildStdin::from_fd(stdin_pipe.write_end));
        }
        _ => { }
    }
    match (cmd.stdout_cfg) {
        Stdio::Piped => {
            stdout_handle = Option::Some(ChildStdout::from_fd(stdout_pipe.read_end));
        }
        _ => { }
    }
    match (cmd.stderr_cfg) {
        Stdio::Piped => {
            stderr_handle = Option::Some(ChildStderr::from_fd(stderr_pipe.read_end));
        }
        _ => { }
    }

    // The argument strings + pointer array fall out of scope at function
    // exit; the synthesized drops release them.  The child has its own COW
    // copies, which are either replaced by exec or abandoned on _exit.
    // A grouped child leads the group numbered by its own pid; it joined
    // it before exec, which the failure pipe's end of file follows.
    mut tree: u64 = 0;
    if (cmd.group_descendants_flag) { tree = pid as u64; }
    return Result::Ok(Child::new(pid, 0, tree, stdin_handle, stdout_handle, stderr_handle));
}

// The step a forked child failed at, written to the failure pipe before
// its `errno`.
private const SPAWN_STEP_SETUP:     i32 = 0;
private const SPAWN_STEP_DIRECTORY: i32 = 1;
private const SPAWN_STEP_EXEC:      i32 = 2;

/// In the forked child: write `step` and `errno` to the failure pipe and
/// exit. Only `write` and `_exit`, so it is async-signal-safe.
![target(unix)]
private function report_spawn_failure(failure_fd: i32, step: i32) -> void {
    mut report: [i32; 2] = [step, libc::errno()];
    libc::write(failure_fd, &report[0] as u8*, 8);
    libc::_exit(127);
}

/// A spawn failure as the caller reads it: the working directory when
/// entering it failed, otherwise the program.
private function spawn_error(cmd: &Command, error: IoError, in_directory: boolean) -> IoError {
    match (&cmd.current_directory) {
        Option::Some(directory) => {
            if (in_directory) {
                return error.with_context(IoOperation::Open, Path::from(directory.as_str()));
            }
        }
        Option::None => { }
    }
    return error.with_context(IoOperation::Spawn, Path::from(cmd.program.as_str()));
}

![target(unix)]
private function close_pipe(pair: &PipePair) -> void {
    if (pair.read_end >= 0) { fd::close_fd(pair.read_end); }
    if (pair.write_end >= 0) { fd::close_fd(pair.write_end); }
}

implement trait Drop for struct EnvEntry {
    drop(mut &this) -> void { }
}

/// The args/envs arrays, released by their fields after this body,
/// release their owned `String`/`EnvEntry` contents.
implement trait Drop for struct Command {
    drop(mut &this) -> void { }
}

implement trait Drop for struct Output {
    drop(mut &this) -> void { }
}

/// PipePair carries raw fds; the parent/child sides each close their
/// own end through `close_pipe` / `child_remap`. Dropping the struct
/// itself is a no-op.
implement trait Drop for struct PipePair {
    drop(mut &this) -> void {}
}

/// Shallow clone of `cmd` so `output()` can override stdout/stderr
/// without mutating the caller's Command. Copies owned strings.
private function clone_command(cmd: &Command) -> Command {
    mut out: Command = Command {
        program: String::from_str(cmd.program.as_str()),
        args: Array::new(),
        envs: Array::new(),
        clear_env_flag: cmd.clear_env_flag,
        group_descendants_flag: cmd.group_descendants_flag,
        current_directory: Option::None,
        stdin_cfg: cmd.stdin_cfg,
        stdout_cfg: cmd.stdout_cfg,
        stderr_cfg: cmd.stderr_cfg
    };
    mut i: i64 = 0;
    while (i < cmd.args.length()) {
        match (cmd.args.get_ref(i)) {
            Option::Some(arg) => { out.args.push(String::from_str(arg.as_str())); }
            Option::None => { break; }
        }
        i++;
    }
    mut j: i64 = 0;
    while (j < cmd.envs.length()) {
        match (cmd.envs.get_ref(j)) {
            Option::Some(entry) => {
                mut value: Option<String> = Option::None;
                match (&entry.value) {
                    Option::Some(text) => { value = Option::Some(String::from_str(text.as_str())); }
                    Option::None       => { }
                }
                out.envs.push(EnvEntry { key: String::from_str(entry.key.as_str()), value: value });
            }
            Option::None => { break; }
        }
        j = j + 1;
    }
    match (&cmd.current_directory) {
        Option::Some(path) => {
            out.current_directory = Option::Some(String::from_str(path.as_str()));
        }
        Option::None => { }
    }
    return out;
}

/// Drain a `Child`'s captured stdout/stderr into buffers, then
/// `wait()` for it. Used by `Command::output()`.
///
/// Reads both pipes interleaved via `poll(2)` over non-blocking fds.
/// The previous serial "drain stdout fully, then stderr" implementation
/// deadlocked any child that filled the 64-KiB stderr pipe buffer
/// before its stdout was fully consumed (kernel blocks the child's
/// write, child never exits, parent never finishes reading stdout,
/// parent never reaches the stderr read).
![target(unix)]
private function collect_output(c: mut &Child) -> Result<Output, IoError> {
    mut stdout_buffer: Array<u8> = Array::new();
    mut stderr_buffer: Array<u8> = Array::new();

    // The drain owns both descriptors and closes them before the wait, so
    // the handles left in `c` are empty.  Non-blocking is best-effort: if
    // the kernel won't take the flag, a drain blocks in `read` instead,
    // after poll(2) reported data.
    mut so_fd:   i32 = -1;
    mut so_open: boolean = false;
    if (c.stdout.is_some()) {
        so_fd   = c.stdout.unwrap_ptr().into_descriptor();
        so_open = true;
        mem::drop(fd::set_nonblocking(so_fd, true));
    }
    mut se_fd:   i32 = -1;
    mut se_open: boolean = false;
    if (c.stderr.is_some()) {
        se_fd   = c.stderr.unwrap_ptr().into_descriptor();
        se_open = true;
        mem::drop(fd::set_nonblocking(se_fd, true));
    }

    // A drain reads every byte available now: `read_to_end` stops at EOF
    // (the writer closed its end) or with `WouldBlock` (nothing more yet,
    // wait on poll again).
    mut so_pipe: BorrowedFileDescriptor = BorrowedFileDescriptor::new(so_fd);
    mut se_pipe: BorrowedFileDescriptor = BorrowedFileDescriptor::new(se_fd);
    mut polls: [libc::pollfd; 2];
    mut failure: Option<IoError> = Option::None;
    while ((so_open || se_open) && failure.is_none()) {
        mut nfds:   u64 = 0;
        mut so_idx: i64 = -1;
        mut se_idx: i64 = -1;
        if (so_open) {
            polls[nfds].fd      = so_fd;
            polls[nfds].events  = libc::POLLIN;
            polls[nfds].revents = 0 as i16;
            so_idx = nfds as i64;
            nfds = nfds + 1;
        }
        if (se_open) {
            polls[nfds].fd      = se_fd;
            polls[nfds].events  = libc::POLLIN;
            polls[nfds].revents = 0 as i16;
            se_idx = nfds as i64;
            nfds = nfds + 1;
        }

        const pr: i32 = libc::poll(&polls[0], nfds, -1);
        if (pr < 0) {
            const err: IoError = IoError::last_os_error();
            match (err.kind) {
                IoErrorKind::Interrupted => { continue; }
                _ => { failure = Option::Some(err); continue; }
            }
        }

        if (so_idx >= 0) {
            const ev: i16 = polls[so_idx as u64].revents;
            const ready: i16 = ev & (libc::POLLIN | libc::POLLHUP | libc::POLLERR);
            if (ready != 0) {
                match (so_pipe.read_to_end(&stdout_buffer)) {
                    Result::Ok(_)  => { so_open = false; }
                    Result::Err(e) => {
                        match (e.kind) {
                            IoErrorKind::WouldBlock => { }
                            _ => { failure = Option::Some(e); continue; }
                        }
                    }
                }
            }
        }
        if (se_idx >= 0) {
            const ev: i16 = polls[se_idx as u64].revents;
            const ready: i16 = ev & (libc::POLLIN | libc::POLLHUP | libc::POLLERR);
            if (ready != 0) {
                match (se_pipe.read_to_end(&stderr_buffer)) {
                    Result::Ok(_)  => { se_open = false; }
                    Result::Err(e) => {
                        match (e.kind) {
                            IoErrorKind::WouldBlock => { }
                            _ => { failure = Option::Some(e); }
                        }
                    }
                }
            }
        }
    }

    if (so_fd >= 0) { fd::close_fd(so_fd); }
    if (se_fd >= 0) { fd::close_fd(se_fd); }
    match (failure) {
        Option::Some(e) => { return Result::Err(e); }
        Option::None    => { }
    }

    match (c.wait()) {
        Result::Ok(status) => {
            return Result::Ok(Output {
                status: status,
                stdout: stdout_buffer,
                stderr: stderr_buffer
            });
        }
        Result::Err(err) => {
            return Result::Err(err);
        }
    }
}



// ===========================================================================
// Windows (CreateProcess) implementation.
//
// Windows has no fork+exec: a process is created in one CreateProcessW call
// that takes a single mutable command-line STRING (not an argv array) plus a
// STARTUPINFO carrying inheritable std handles.  Pipe ends created with
// CreatePipe are bridged into CRT file descriptors via `_open_osfhandle`, so
// the existing fd-based ChildStdin/Stdout/Stderr + io::fd read/write/close
// machinery is reused unchanged.
//
// Stdio: Inherit, Piped, Null (an inheritable `NUL` handle), and Fd (the
// caller's CRT fd is recovered to a Win32 HANDLE via `_get_osfhandle` and
// duplicated inheritable for the child) are all wired.  `clear_env` /
// per-var env overrides and `cwd` are applied (an explicit UTF-16 env block +
// `lpCurrentDirectory`); the command line, the block and the directory are
// all UTF-16, so non-ASCII arguments, variables and paths reach the child
// intact.  `collect_output` interleaves the stdout/stderr
// drains via `PeekNamedPipe` so neither full pipe buffer can deadlock the
// other (matching the POSIX `poll` path).
// ===========================================================================

// Per-stream Windows stdio wiring produced by `win_setup_stdio`.
![target(windows)]
private type struct WinStdio {
    private child_handle: u8*;   // handle handed to the child via STARTUPINFO
    private parent_fd:    i32;   // parent pipe end as a CRT fd, or -1
    private extra_close:  u8*;   // child pipe end the parent must close post-spawn, or null
    private close_fd:     i32;   // caller CRT fd to close post-spawn (Stdio::Fd ownership), or -1
}

![target(windows)]
implement trait Drop for struct WinStdio {
    drop(mut &this) -> void { }
}

// Append `arg` to `out` applying the standard CommandLineToArgvW quoting:
// wrap in double quotes when empty or containing space/tab/quote, doubling
// backslashes that precede a quote (or the closing quote) and escaping
// embedded quotes.
![target(windows)]
private function win_append_quoted(out: mut &String, arg: &String) -> void {
    const p: u8* = arg.as_ptr();
    const n: i64 = arg.length();
    mut need: boolean = (n == 0);
    mut s: i64 = 0;
    while (s < n) {
        const c: u8 = p[s];
        if (c == 32 || c == 9 || c == 34) { need = true; }
        s = s + 1;
    }
    if (!need) {
        mut k: i64 = 0;
        while (k < n) { out.push_byte(p[k]); k = k + 1; }
        return;
    }
    out.push_byte(34);   // opening quote
    mut j: i64 = 0;
    while (j < n) {
        mut bs: i64 = 0;
        while (j < n && p[j] == 92) { bs = bs + 1; j = j + 1; }
        if (j == n) {
            mut d: i64 = 0;
            while (d < bs * 2) { out.push_byte(92); d = d + 1; }
        } else if (p[j] == 34) {
            mut d: i64 = 0;
            while (d < bs * 2 + 1) { out.push_byte(92); d = d + 1; }
            out.push_byte(34);
            j = j + 1;
        } else {
            mut d: i64 = 0;
            while (d < bs) { out.push_byte(92); d = d + 1; }
            out.push_byte(p[j]);
            j = j + 1;
        }
    }
    out.push_byte(34);   // closing quote
}

// Build the NUL-terminated UTF-16 command line "program arg1 arg2 ..." for
// CreateProcessW (which may modify the buffer in place).
![target(windows)]
private function build_cmdline(cmd: &Command) -> Array<u16> {
    mut cl: String = String::new();
    win_append_quoted(&cl, &cmd.program);
    mut i: i64 = 0;
    while (i < cmd.args.length()) {
        match (cmd.args.get_ref(i)) {
            Option::Some(a) => { cl.push_byte(32); win_append_quoted(&cl, a); }
            Option::None    => { break; }
        }
        i = i + 1;
    }
    return Utf16::encode(cl.as_str());
}

// True if the `KEY=VALUE\0` entry at `entry` has key `key`, UTF-16 units
// without a NUL (the entry's key ends right at the `=`).  Windows variable
// names ignore ASCII case, so `Path` names the inherited `PATH`.  Used to
// drop an inherited variable the caller sets or removes.
![target(windows)]
private function win_env_key_matches(entry: u16*, key: &Slice<u16>) -> boolean {
    // Unit by unit, stopping at the first difference: the entry may be
    // shorter than `key`, and its NUL then differs before the block ends.
    const length: i64 = key.length();
    for (mut i: i64 = 0; i < length; i++) {
        mut a: u16 = entry[i];
        mut b: u16 = key[i];
        if (a >= 0x41 && a <= 0x5A) { a = a + 0x20; }   // 'A'-'Z' to 'a'-'z'
        if (b >= 0x41 && b <= 0x5A) { b = b + 0x20; }
        if (a != b) { return false; }
    }
    return entry[length] == 61;  // '='
}

// Build the UTF-16 environment block for CreateProcessW
// (CREATE_UNICODE_ENVIRONMENT): a sequence of `KEY=VALUE\0` entries
// terminated by an extra `\0`.  When `clear_env_flag` is set the inherited
// block is skipped; otherwise inherited entries are copied unit for unit
// except those the caller overrides (so overrides win), then the overrides
// are appended.
![target(windows)]
private function build_env_block(cmd: &Command) -> Array<u16> {
    mut blk: Array<u16> = Array::new();
    // Each override's key, encoded once, without its NUL.
    mut keys: Array<Array<u16>> = Array::new();
    for (mut e: i64 = 0; e < cmd.envs.length(); e++) {
        match (cmd.envs.get_ref(e)) {
            Option::Some(en) => {
                mut key: Array<u16> = Utf16::encode(en.key.as_str());
                key.truncate(key.length() - 1);
                keys.push(key);
            }
            Option::None => { }
        }
    }

    if (!cmd.clear_env_flag) {
        const base: u16* = syscall::GetEnvironmentStringsW();
        if (base != null) {
            mut i: u64 = 0;
            while (base[i] != 0) {        // until the block's double-NUL
                const start: u64 = i;
                mut overridden: boolean = false;
                for (mut e: i64 = 0; e < keys.length(); e++) {
                    if (win_env_key_matches(&base[start], keys[e].as_slice())) { overridden = true; }
                }
                // Copy (or skip) the whole `KEY=VALUE\0` entry.
                while (base[i] != 0) {
                    if (!overridden) { blk.push(base[i]); }
                    i = i + 1;
                }
                if (!overridden) { blk.push(0); }
                i = i + 1;              // step past the entry's NUL
            }
            syscall::FreeEnvironmentStringsW(base);
        }
    }

    // Append the caller's overrides as KEY=VALUE\0; a removed variable was
    // dropped above and is not appended.
    for (mut e: i64 = 0; e < cmd.envs.length(); e++) {
        match (cmd.envs.get_ref(e)) {
            Option::Some(en) => {
                match (&en.value) {
                    Option::Some(value) => {
                        const wide_value: Array<u16> = Utf16::encode(value.as_str());
                        blk.append(keys[e].as_slice());
                        blk.push(61);                // '='
                        blk.append(wide_value.as_slice());   // with its NUL
                    }
                    Option::None => { }
                }
            }
            Option::None => { }
        }
    }

    blk.push(0);  // block terminator (block ends in `\0\0`)
    return blk;
}

// Wire one std stream for the child.  Piped creates an inheritable pipe and
// bridges the parent end to a CRT fd; everything else inherits the parent's
// corresponding std handle.  A failure reports the error of the call that
// failed, read straight after it.
![target(windows)]
private function win_setup_stdio(setting: Stdio, std_id: u32, is_input: boolean) -> Result<WinStdio, IoError> {
    match (setting) {
        Stdio::Piped => {
            mut rd: u8* = null;
            mut wr: u8* = null;
            mut sa: syscall::SECURITY_ATTRIBUTES = syscall::SECURITY_ATTRIBUTES {
                nLength: 24, lpSecurityDescriptor: null, bInheritHandle: 1
            };
            if (syscall::CreatePipe(&rd, &wr, &sa as u8*, 0) == 0) {
                return Result::Err(IoError::last_os_error());
            }
            if (is_input) {
                // child reads `rd` (inheritable); parent writes `wr`.
                syscall::SetHandleInformation(wr, syscall::HANDLE_FLAG_INHERIT, 0);
                const f: i32 = libc::_open_osfhandle(wr as i64, 0);
                return Result::Ok(WinStdio { child_handle: rd, parent_fd: f, extra_close: rd, close_fd: -1 });
            }
            // child writes `wr` (inheritable); parent reads `rd`.
            syscall::SetHandleInformation(rd, syscall::HANDLE_FLAG_INHERIT, 0);
            const f: i32 = libc::_open_osfhandle(rd as i64, 0);
            return Result::Ok(WinStdio { child_handle: wr, parent_fd: f, extra_close: wr, close_fd: -1 });
        }
        Stdio::Null => {
            // Discard the child's stream by handing it an inheritable handle
            // on the null device (`NUL`); inheriting the parent's std handle
            // instead would leak the child's output onto the parent's
            // console.
            mut sa: syscall::SECURITY_ATTRIBUTES = syscall::SECURITY_ATTRIBUTES {
                nLength: 24, lpSecurityDescriptor: null, bInheritHandle: 1
            };
            mut nul_path: String = String::with_null(Str::new("NUL"));
            mut access: u32 = syscall::GENERIC_WRITE;
            if (is_input) { access = syscall::GENERIC_READ; }
            const h: u8* = syscall::CreateFileA(nul_path.as_ptr(), access,
                syscall::FILE_SHARE_READ | syscall::FILE_SHARE_WRITE,
                &sa as u8*, syscall::OPEN_EXISTING, 0, null);
            // CreateFileA returns INVALID_HANDLE_VALUE (-1) on failure. Compare
            // against a local -1, not syscall::INVALID_HANDLE_VALUE (a
            // cross-module const i64 that mis-evaluates).
            if ((h as i64) == -1) {
                return Result::Err(IoError::last_os_error());
            }
            // Parent owns the NUL handle; close it after the child inherits it.
            return Result::Ok(WinStdio { child_handle: h, parent_fd: -1, extra_close: h, close_fd: -1 });
        }
        Stdio::Fd(raw) => {
            // Recover the Win32 HANDLE backing the caller's CRT fd and
            // duplicate it as an inheritable handle for the child.  We never
            // mutate the caller's handle flags (DuplicateHandle is the robust
            // path); the duplicate is closed post-spawn and the
            // original fd is closed too, since `Stdio::Fd` transfers ownership.
            const src: i64 = libc::_get_osfhandle(raw);
            if (src == -1) {
                // A C-runtime call: it reports through `errno`.
                return Result::Err(IoError::from_errno(libc::errno()));
            }
            mut dup: u8* = null;
            const cur: u8* = syscall::GetCurrentProcess();
            if (syscall::DuplicateHandle(cur, src as u8*, cur, &dup, 0, 1,
                                         syscall::DUPLICATE_SAME_ACCESS) == 0) {
                return Result::Err(IoError::last_os_error());
            }
            // child inherits `dup`; parent closes both `dup` and the caller's fd.
            return Result::Ok(WinStdio { child_handle: dup, parent_fd: -1, extra_close: dup, close_fd: raw });
        }
        _ => {
            // Inherit: hand the child our own std handle; nothing for the
            // parent to close or wrap.
            return Result::Ok(WinStdio { child_handle: syscall::GetStdHandle(std_id),
                                         parent_fd: -1, extra_close: null, close_fd: -1 });
        }
    }
}

![target(windows)]
private function spawn_impl(cmd: &Command) -> Result<Child, IoError> {
    const sin:  WinStdio = win_setup_stdio(cmd.stdin_cfg,  syscall::STD_INPUT_HANDLE,  true)?;
    const sout: WinStdio = win_setup_stdio(cmd.stdout_cfg, syscall::STD_OUTPUT_HANDLE, false)?;
    // A merged stderr is handed the handle stdout's wiring already made;
    // that wiring owns it, so there is nothing more to close or wrap.
    const serr: WinStdio = match (cmd.stderr_cfg) {
        Stdio::SameAsStdout => {
            WinStdio { child_handle: sout.child_handle, parent_fd: -1, extra_close: null, close_fd: -1 }
        }
        _ => { win_setup_stdio(cmd.stderr_cfg, syscall::STD_ERROR_HANDLE, false)? }
    };

    mut cmdline: Array<u16> = build_cmdline(cmd);

    mut cwd_wide: Array<u16> = Array::new();
    mut cwd_ptr:  u16* = null;
    match (&cmd.current_directory) {
        Option::Some(path) => {
            cwd_wide = Utf16::encode(path.as_str());
            cwd_ptr  = cwd_wide.as_ptr();
        }
        Option::None => { }
    }

    mut si: syscall::STARTUPINFOW = syscall::STARTUPINFOW {
        cb: 104, lpReserved: null, lpDesktop: null, lpTitle: null,
        dwX: 0, dwY: 0, dwXSize: 0, dwYSize: 0,
        dwXCountChars: 0, dwYCountChars: 0, dwFillAttribute: 0,
        dwFlags: syscall::STARTF_USESTDHANDLES, wShowWindow: 0, cbReserved2: 0,
        lpReserved2: null,
        hStdInput: sin.child_handle, hStdOutput: sout.child_handle, hStdError: serr.child_handle
    };
    mut pi: syscall::PROCESS_INFORMATION = syscall::PROCESS_INFORMATION {
        hProcess: null, hThread: null, dwProcessId: 0, dwThreadId: 0
    };

    // Apply env overrides / env_clear via an explicit UTF-16 environment
    // block. When there's nothing to change, pass null so the child inherits
    // the parent's environment verbatim. `env_block` must outlive
    // CreateProcessW (which copies it); it drops at function exit.
    mut env_block: Array<u16> = Array::new();
    mut env_ptr: u16* = null;
    if (cmd.clear_env_flag || cmd.envs.length() > 0) {
        env_block = build_env_block(cmd);
        env_ptr = env_block.as_ptr();
    }

    // A grouped child starts suspended, so it is in its job before it can
    // start anything of its own, and as the root of a console process
    // group of its own, so a console control event can be sent to its tree
    // alone.
    mut creation_flags: u32 = syscall::CREATE_UNICODE_ENVIRONMENT;
    if (cmd.group_descendants_flag) {
        creation_flags = creation_flags | syscall::CREATE_SUSPENDED | syscall::CREATE_NEW_PROCESS_GROUP;
    }
    const ok: i32 = syscall::CreateProcessW(null, &cmdline[0], null, null,
                                            1, creation_flags, env_ptr, cwd_ptr, &si, &pi);
    // Read before the closes below can overwrite it; used only on failure.
    const create_error: IoError = IoError::last_os_error();

    // Parent closes the child's pipe ends now that they have been inherited.
    if (sin.extra_close  != null) { syscall::CloseHandle(sin.extra_close); }
    if (sout.extra_close != null) { syscall::CloseHandle(sout.extra_close); }
    if (serr.extra_close != null) { syscall::CloseHandle(serr.extra_close); }

    // `Stdio::Fd` transfers ownership: close the caller's fd in the parent
    // now that the child has inherited a duplicate (runs on success or
    // failure, mirroring the POSIX `Stdio::Fd` parent-close).
    if (sin.close_fd  >= 0) { fd::close_fd(sin.close_fd); }
    if (sout.close_fd >= 0) { fd::close_fd(sout.close_fd); }
    if (serr.close_fd >= 0) { fd::close_fd(serr.close_fd); }

    if (ok == 0) {
        if (sin.parent_fd  >= 0) { fd::close_fd(sin.parent_fd); }
        if (sout.parent_fd >= 0) { fd::close_fd(sout.parent_fd); }
        if (serr.parent_fd >= 0) { fd::close_fd(serr.parent_fd); }
        // CreateProcess reports a working directory it cannot enter as
        // ERROR_DIRECTORY.
        const in_directory: boolean = create_error.os_code == syscall::ERROR_DIRECTORY as i32;
        return Result::Err(spawn_error(cmd, create_error, in_directory));
    }

    mut job: u8* = null;
    if (cmd.group_descendants_flag) {
        job = syscall::CreateJobObjectA(null, null);
        if (job == null || syscall::AssignProcessToJobObject(job, pi.hProcess) == 0) {
            // The child has run nothing yet: end it rather than hand back a
            // child its caller asked to be able to end with its tree.
            const job_error: IoError = IoError::last_os_error();
            syscall::TerminateProcess(pi.hProcess, 1);
            if (job != null) { syscall::CloseHandle(job); }
            syscall::CloseHandle(pi.hThread);
            syscall::CloseHandle(pi.hProcess);
            if (sin.parent_fd  >= 0) { fd::close_fd(sin.parent_fd); }
            if (sout.parent_fd >= 0) { fd::close_fd(sout.parent_fd); }
            if (serr.parent_fd >= 0) { fd::close_fd(serr.parent_fd); }
            return Result::Err(spawn_error(cmd, job_error, false));
        }
        syscall::ResumeThread(pi.hThread);
    }
    syscall::CloseHandle(pi.hThread);

    mut stdin_handle:  Option<ChildStdin>  = Option::None;
    mut stdout_handle: Option<ChildStdout> = Option::None;
    mut stderr_handle: Option<ChildStderr> = Option::None;
    if (sin.parent_fd  >= 0) { stdin_handle  = Option::Some(ChildStdin::from_fd(sin.parent_fd)); }
    if (sout.parent_fd >= 0) { stdout_handle = Option::Some(ChildStdout::from_fd(sout.parent_fd)); }
    if (serr.parent_fd >= 0) { stderr_handle = Option::Some(ChildStderr::from_fd(serr.parent_fd)); }

    return Result::Ok(Child::new(pi.dwProcessId as i32, pi.hProcess as u64, job as u64,
                                 stdin_handle, stdout_handle, stderr_handle));
}


// Bytes immediately readable from a pipe-backed CRT fd without blocking, or
// -1 when the write end has closed (EOF: PeekNamedPipe fails with
// ERROR_BROKEN_PIPE) or the fd can't be peeked.  Drives the interleaved drain.
![target(windows)]
private function win_peek_avail(fd_no: i32) -> i64 {
    const h: i64 = libc::_get_osfhandle(fd_no);
    if (h == -1) { return -1; }
    mut avail: u32 = 0;
    const r: i32 = syscall::PeekNamedPipe(h as u8*, null, 0, null, &avail, null);
    if (r == 0) { return -1; }   // broken pipe => EOF
    return avail as i64;
}

// Drain both pipe-backed fds concurrently to EOF.  Each iteration peeks every
// still-open fd and reads only what's already buffered (so neither read can
// block), sleeping 1ms when neither has data ready.  This removes the
// sequential-drain deadlock: the child can keep filling its stderr pipe while
// we drain stdout, and vice-versa, instead of one full pipe wedging the other.
![target(windows)]
private function win_drain_interleaved(so_fd0: i32, se_fd0: i32,
                               chunk: mut u8*, chunk_len: i64,
                               so_buf: mut &Array<u8>,
                               se_buf: mut &Array<u8>) -> Result<(), IoError> {
    mut so: i32 = so_fd0;
    mut se: i32 = se_fd0;
    loop {
        if (so < 0 && se < 0) { return Result::Ok(()); }
        mut progressed: boolean = false;

        if (so >= 0) {
            const av: i64 = win_peek_avail(so);
            if (av < 0) {
                so = -1;
            } else if (av > 0) {
                mut want: i64 = chunk_len;
                if (av < want) { want = av; }
                match (fd::read_fd(so, chunk, want)) {
                    Result::Ok(n) => {
                        if (n == 0) { so = -1; }
                        else {
                            mut i: i64 = 0;
                            while (i < n) { so_buf.push(chunk[i]); i = i + 1; }
                            progressed = true;
                        }
                    }
                    Result::Err(e) => { return Result::Err(e); }
                }
            }
        }

        if (se >= 0) {
            const av: i64 = win_peek_avail(se);
            if (av < 0) {
                se = -1;
            } else if (av > 0) {
                mut want: i64 = chunk_len;
                if (av < want) { want = av; }
                match (fd::read_fd(se, chunk, want)) {
                    Result::Ok(n) => {
                        if (n == 0) { se = -1; }
                        else {
                            mut i: i64 = 0;
                            while (i < n) { se_buf.push(chunk[i]); i = i + 1; }
                            progressed = true;
                        }
                    }
                    Result::Err(e) => { return Result::Err(e); }
                }
            }
        }

        if (!progressed && (so >= 0 || se >= 0)) {
            syscall::Sleep(1);
        }
    }
}

![target(windows)]
private function collect_output(c: mut &Child) -> Result<Output, IoError> {
    mut stdout_buffer: Array<u8> = Array::new();
    mut stderr_buffer: Array<u8> = Array::new();
    mut chunk: [u8; 4096];

    // The drain owns both descriptors and closes them before the wait, so
    // the handles left in `c` are empty.
    mut so_fd: i32 = -1;
    if (c.stdout.is_some()) { so_fd = c.stdout.unwrap_ptr().into_descriptor(); }
    mut se_fd: i32 = -1;
    if (c.stderr.is_some()) { se_fd = c.stderr.unwrap_ptr().into_descriptor(); }

    mut failure: Option<IoError> = Option::None;
    if (so_fd >= 0 && se_fd >= 0) {
        // Both piped: interleave so neither full pipe buffer can wedge the
        // other (the sequential-drain deadlock).
        match (win_drain_interleaved(so_fd, se_fd, &chunk[0], 4096,
                                     &stdout_buffer, &stderr_buffer)) {
            Result::Ok(_)  => { }
            Result::Err(e) => { failure = Option::Some(e); }
        }
    } else if (so_fd >= 0) {
        // One stream has no second pipe to deadlock against: a blocking
        // drain to EOF.
        mut so_pipe: BorrowedFileDescriptor = BorrowedFileDescriptor::new(so_fd);
        match (so_pipe.read_to_end(&stdout_buffer)) {
            Result::Ok(_)  => { }
            Result::Err(e) => { failure = Option::Some(e); }
        }
    } else if (se_fd >= 0) {
        mut se_pipe: BorrowedFileDescriptor = BorrowedFileDescriptor::new(se_fd);
        match (se_pipe.read_to_end(&stderr_buffer)) {
            Result::Ok(_)  => { }
            Result::Err(e) => { failure = Option::Some(e); }
        }
    }

    if (so_fd >= 0) { fd::close_fd(so_fd); }
    if (se_fd >= 0) { fd::close_fd(se_fd); }
    match (failure) {
        Option::Some(e) => { return Result::Err(e); }
        Option::None    => { }
    }

    match (c.wait()) {
        Result::Ok(status) => {
            return Result::Ok(Output { status: status, stdout: stdout_buffer, stderr: stderr_buffer });
        }
        Result::Err(err) => { return Result::Err(err); }
    }
}
