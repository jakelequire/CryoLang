///! process::exec: a `system(3)`-shaped convenience over `Command`.
///!
///! `shell` exists so a caller that already has its own `Command` type in
///! scope (e.g. a CLI framework) can still shell out cross-platform without
///! importing `process::command` and colliding on the bare `Command` name.
///! It is a thin wrapper over `Command::shell`.

namespace std::process::exec;

import std::process::command;

/// Run `command` through the platform shell (`/bin/sh -c` on POSIX, the C
/// runtime's `system`/`cmd /c` on Windows), inheriting stdio, and return the
/// child's exit code (0 on success), or -1 if the shell could not be spawned
/// or the child was killed by a signal.  The cross-platform replacement for
/// the raw `system(3)` intrinsic when a command genuinely needs shell
/// semantics (pipes, redirects, glob expansion).
function shell(command: string) -> i32 {
    return Command::shell(command);
}
