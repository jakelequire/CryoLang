///! The `Future` trait.

namespace std::future::traits;

import std::future::poll::{ Poll };
import std::future::waker::{ Context };

/// An asynchronous computation. `poll` drives it one step: `Ready(v)` when the
/// value is available, `Pending` when it is not yet (the future has arranged,
/// via `cx`'s waker, to be polled again later).
///
/// `Output` is an associated type — each future produces exactly one result
/// type — mirroring `core::iter::Iterator`'s `Item`. A future never holds a
/// reference across a suspend point (the compiler forbids borrows across
/// `await`), so it contains no self-pointers and is always safe to move,
/// including between polls.
![language("future")]
public type trait Future {
    type Output;

    /// Advance the computation as far as it can go without blocking.
    /// Returns `Ready(value)` once, when the result exists; polling again
    /// after that is a contract violation (`Ready` and `PendingThenReady`
    /// panic on it). Returns `Pending` when it must wait, after arranging for
    /// a clone of `cx.waker()` to be woken when the wait can make progress,
    /// so that the future is polled again.
    ![language("future_poll")]
    poll(mut &this, cx: Context*) -> Poll<This::Output>;
}
