///! std::future::executor: a multi-threaded, poll-driven task executor.
///!
///! An `Executor` owns a mutex+condvar-guarded FIFO of ready tasks and a pool of
///! `pthread` workers that drive them by polling. A task is a heap-boxed,
///! type-erased future plus a manual vtable (`poll_fn`/`drop_fn`/`dispose_fn`),
///! so futures of different concrete types share one queue — the same
///! non-capturing-fn-ptr + `void*` erasure the `Waker`, `catch_unwind`, and
///! `thread::spawn` use. Each poll hands the future a `Waker` whose `wake()`
///! reschedules the task; a future that returns `Pending` after arranging to be
///! woken (today, by calling `cx.waker.wake()` itself — a real reactor arrives in
///! Phase 4) is re-enqueued and polled again.
///!
///! `Executor::new()` sizes the worker pool to the hardware thread count (use
///! `with_threads(n)` to pick a count). `spawn(fut)` returns a
///! `JoinHandle<Output>` and the workers begin driving it immediately;
///! `block_on(root)` spawns `root` and blocks the calling thread on a completion
///! condvar until a worker finishes it, then returns its value. `join`/`block_on`
///! never poll on the calling thread — the workers own all polling.
///!
///! Inside a task, `Task::spawn(fut)` spawns on the executor polling the
///! caller, which each worker publishes in a thread-local, and the task
///! `await`s the `JoinHandle` (a `Future`) rather than blocking a worker in
///! `join`.
///!
///! ## Concurrent-poll safety
///!
///! With ≥2 workers a task can be woken (by itself mid-poll, or later by another
///! thread) while a worker is already polling it. Polling one future from two
///! workers at once is a data race, so each task carries an atomic run-state —
///! `IDLE`/`SCHEDULED`/`RUNNING`/`NOTIFIED` — and a task is enqueued at most once
///! and polled by at most one worker: `wake()` moves `IDLE→SCHEDULED` (and
///! enqueues) or `RUNNING→NOTIFIED` (defers — the running worker reschedules); a
///! worker moves `SCHEDULED→RUNNING` to poll, then `RUNNING→IDLE` on a quiet
///! `Pending` or re-schedules on `NOTIFIED`. This is the standard
///! tokio/`async-task` machine. (It is a per-task *state machine*, not a
///! refcount: Phase-3 wakers never outlive a poll, so there is nothing to
///! reference-count yet — waker refcounting arrives with the Phase-4 reactor.)
///!
///! ## Task isolation
///!
///! Under `--panic=unwind` the poll boundary runs inside `intrinsics::try_catch`
///! (via the `run_poll` trampoline, mirroring `panic_unwind::run_catch_body`): a
///! panicking task is caught, finishes with outcome `PANICKED`, and its `join`
///! returns `Err(Panicked)` — its sibling tasks keep running. `try_catch` is a
///! compile error under the default `--panic=abort`, so the catch path is gated
///! `![config(panic_unwind)]`; under abort the boundary is a plain direct call
///! and a task panic aborts the whole process (the accepted degradation).
///!
///! ## Lifetime
///!
///! Task/handle lifetime is a two-actor handshake on a `TaskShared` control
///! block, exactly like `thread::spawn`: whichever of {the finishing task, the
///! joining/detaching handle} acts last frees the block. A `JoinHandle` dropped
///! without `join`/`detach` detaches (the task runs on, its result discarded);
///! `abort()` requests cancellation, and the task is reclaimed — its `Output`
///! never produced — the next time a worker reaches it. Dropping the `Executor`
///! signals shutdown, joins the workers, then reclaims any still-queued tasks.

namespace std::future::executor;

import std::core::intrinsics;
import std::core::pointer::{ NonNull };
import std::core::result::{ Result };
import std::core::drop::{ Drop };
import std::core::panic_unwind::{ PanicInfo };
import std::core::error::{ Error };
import std::collections::str::{ Str };
import std::collections::string::{ String };
import std::fmt::display::{ Debug, Display, Formatter };
import std::fmt::error::{ FormatError };
import std::alloc::layout::{ Layout };
import std::alloc::allocator::{ AllocationError, GlobalAllocator };
import std::alloc::arc::{ Arc };
import std::sync::atomic::{ Atomic, MemoryOrder };
import std::sync::mutex::{ Mutex, MutexGuard };
import std::sync::condition_variable::{ ConditionVariable };
import std::thread;
import std::thread::{ JoinHandle as ThreadJoinHandle };
import std::core::mem;
import std::collections::array;
import std::future::poll::{ Poll };
import std::future::waker::{ Context, Waker };
import std::future::traits::{ Future };
import std::future::reactor::{ Reactor };
import std::future::blocking::{ BLOCKING_DEFAULT_THREADS, BlockingJob, BlockingPool, JOB_PENDING };
import std::core::option::{ Option };


// Task outcome (published by the executor when a task finishes), read by a
// joining handle to build its result.
private const OUTCOME_PENDING:   u8 = 0;   // not finished
private const OUTCOME_READY:     u8 = 1;   // completed; `result` is stored
private const OUTCOME_CANCELLED: u8 = 2;   // aborted or unreschedulable; no result
private const OUTCOME_PANICKED:  u8 = 3;   // panicked while polling; `panic` is stored

// Two-actor handshake over the shared block: whoever swaps in last (observing
// the other side already gone) frees it. Mirrors `thread::spawn`'s state byte.
private const HS_LIVE:        u8 = 0;   // task running, handle live
private const HS_TASK_FIN:    u8 = 1;   // task finished (outcome published)
private const HS_HANDLE_GONE: u8 = 2;   // handle detached/dropped without joining

// Per-task run-state (atomic): governs which worker may poll a task and whether
// a wake must enqueue it. See the module doc "Concurrent-poll safety".
private const ST_IDLE:      u8 = 0;   // not queued, not running
private const ST_SCHEDULED: u8 = 1;   // linked in the ready queue
private const ST_RUNNING:   u8 = 2;   // a worker is polling it
private const ST_NOTIFIED:  u8 = 3;   // woken while RUNNING; reschedule after the poll


/// Non-generic control header, laid out at offset 0 of every `TaskShared<O>`, so
/// the type-erased executor reads/writes a task's outcome, handshake, cancel
/// flag, and (on the panic path) captured `PanicInfo` through a `TaskCtl*`
/// without knowing `O`.
private type struct TaskCtl {
    private outcome: Atomic<u8>;   // OUTCOME_*
    private hs:      Atomic<u8>;   // HS_*
    private cancel:  Atomic<u8>;   // 1 == abort requested by the handle
    private panic:   PanicInfo;    // valid only when outcome == OUTCOME_PANICKED
    // The waker of a task awaiting the handle, `Waker::noop()` when none is.
    // Read and written only under the executor's `done_lock`, the lock the
    // finishing task holds while it publishes HS_TASK_FIN: an awaiting poll
    // either sees the task finished or leaves a waker the finish takes.
    private joiner:  Waker;
}

/// The control block shared between a task and its `JoinHandle<O>`. Outlives the
/// task so `join` can read the result after the task finishes. `result` is
/// uninitialized until the task stores it on the READY path; the handshake
/// guarantees it is read/dropped exactly once and never before the store.
private type struct TaskShared<O> {
    private ctl:    TaskCtl;
    private result: O;
}

/// Handle-side teardown (detach or drop): announce the handle is gone, and if
/// the task already finished, reclaim the block here (dropping a stored result).
/// Otherwise the task frees it when it finishes and observes HS_HANDLE_GONE.
/// A waker an earlier `await` of the handle left is taken out first, under
/// `done_lock` as every touch of it is, and released after the unlock: nothing
/// will await the handle again.
///
/// A free generic function rather than a `TaskShared<O>` static method: a static
/// method on a generic owner reached only through another generic's instantiation
/// (here `JoinHandle<O>`) is not emitted by the monomorphizer (E0636 at codegen).
/// The free generic function is the proven form (mirrors `thread::reap_detached`).
private function detach_shared<O>(sh: mut TaskShared<O>*, exec: ExecInner*) -> void {
    const ctl: mut TaskCtl* = &sh.ctl;
    const held: MutexGuard<(), GlobalAllocator> = exec.done_lock.lock();
    const stale: Waker = Waker::take(&ctl.joiner);
    const prev: u8 = ctl.hs.swap(HS_HANDLE_GONE, MemoryOrder::AcqRel);
    mem::drop(held);
    mem::drop(stale);
    if (prev == HS_TASK_FIN) {
        const outcome: u8 = ctl.outcome.load(MemoryOrder::Acquire);
        mut alloc: GlobalAllocator = GlobalAllocator::new();
        if (outcome == OUTCOME_READY) {
            pointer::drop_in_place::<O>(&sh.result);
        }
        alloc.deallocate(NonNull::new(sh as mut u8*), Layout::of::<TaskShared<O>>());
    }
    // else: task still running; it frees the block when it observes GONE.
}

/// A heap-boxed, type-erased task on an executor's queue. The concrete future
/// lives in the `fut` box; `poll_fn`/`drop_fn`/`dispose_fn` are its
/// monomorphized vtable. `shared` points at the `TaskShared<O>` (and, at offset
/// 0, the `TaskCtl`). `next` links the ready queue; `exec` lets a `Waker` reach
/// the queue/condvars; `run_state` is the concurrent-poll guard (module doc).
private type struct ErasedTask {
    private poll_fn:    (mut u8*, mut u8*, Context*) -> u8;   // (fut, shared, cx) -> 1 Ready / 0 Pending
    private drop_fn:    (mut u8*) -> void;                     // drop the boxed future, free its box
    private dispose_fn: (mut u8*, u8) -> void;                 // (shared, drop_result) -> free the shared block
    private fut:        mut u8*;
    private shared:     mut u8*;
    private next:       mut ErasedTask*;
    private exec:       mut ExecInner*;
    private run_state:  Atomic<u8>;

    /// Build a ready-to-enqueue task around a boxed future + its shared control
    /// block. `run_state` starts SCHEDULED (the caller enqueues immediately) and
    /// `next` is unlinked; the vtable fn-ptrs are the future's monomorphized
    /// thunks. Returned by value and moved into an `Arc<ErasedTask>`, whose raw
    /// value pointer every `ErasedTask*` then is.
    private static new(poll_fn:    (mut u8*, mut u8*, Context*) -> u8,
               drop_fn:    (mut u8*) -> void,
               dispose_fn: (mut u8*, u8) -> void,
               fut:        mut u8*,
               shared:     mut u8*,
               exec:       mut ExecInner*) -> ErasedTask {
        return ErasedTask {
            poll_fn:    poll_fn,
            drop_fn:    drop_fn,
            dispose_fn: dispose_fn,
            fut:        fut,
            shared:     shared,
            next:       null,
            exec:       exec,
            run_state:  Atomic::<u8>::new(ST_SCHEDULED),
        };
    }

    /// Poll this task once. Returns true when the task re-enqueued itself — a
    /// self-wake during the poll transferred the scheduling reference back to
    /// the queue, so the caller must NOT release it — and false when it finished
    /// or parked, in which case the caller releases the scheduling reference via
    /// `task_decref`. The last release runs `ErasedTask::drop`, which finishes a
    /// still-unfinished (parked, never re-woken) task as CANCELLED before the
    /// box is freed. Honors a pending abort without polling. `&this` IS the heap
    /// box address, so the owning `Waker` carries it.
    private drive(mut &this) -> boolean {
        const ctl: mut TaskCtl* = this.shared as mut TaskCtl*;
        if (ctl.cancel.load(MemoryOrder::Acquire) == 1) {
            this.finish(OUTCOME_CANCELLED);
            return false;
        }
        // The poll's `Waker` owns one reference — bumped here, released when
        // `cx` drops at the end of this method — so any clone the future stores
        // is a genuine extra reference that keeps the task alive while parked.
        // The worker's scheduling reference outlives this method, so this bump
        // is never the last: `cx`'s drop cannot free the box mid-poll.
        task_incref(&this);
        mut cx: Context = Context::new(Waker::new(task_wake, waker_arc_clone,
                                                  waker_arc_drop, &this as mut u8*));
        mut pinfo: PanicInfo = PanicInfo { msg: "", file: "", line: 0 };
        const status: u8 = poll_boundary(this.poll_fn, this.fut, this.shared, &cx, &pinfo);
        if (status == 2) {
            ctl.panic = pinfo;
            this.finish(OUTCOME_PANICKED);
            return false;
        }
        if (status == 1) {
            this.finish(OUTCOME_READY);
            return false;
        }
        // Pending. A wake during the poll left the state NOTIFIED; reschedule,
        // transferring the scheduling reference back to the queue. Otherwise the
        // state is still RUNNING and the task parks: a stored waker will wake it,
        // or none will and the final `task_decref` cancels it via `ErasedTask::drop`.
        match (this.run_state.compare_exchange(ST_RUNNING, ST_IDLE,
                                               MemoryOrder::AcqRel, MemoryOrder::Acquire)) {
            Result::Ok(_) => {
                return false;
            }
            Result::Err(_) => {
                this.run_state.store(ST_SCHEDULED, MemoryOrder::Release);
                this.exec.enqueue(&this);
                return true;
            }
        }
    }

    /// Finish this task: drop its future, publish `outcome`, run the shared-block
    /// handshake, and wake any joiner. Does NOT free the task box (the owning
    /// `Arc<ErasedTask>` reclaims it when the last reference drops). Nulls `fut` after
    /// dropping the future so `ErasedTask::drop` knows finishing already ran and does
    /// not repeat it. On READY the future's `Output` was already moved into the
    /// shared block; on CANCELLED/PANICKED there is no result. Called at most
    /// once per task (from `drive`, or from `ErasedTask::drop` when `fut` is non-null).
    private finish(mut &this, outcome: u8) -> void {
        const ctl:  mut TaskCtl*      = this.shared as mut TaskCtl*;
        const exec: ExecInner*    = this.exec;
        const df:   (mut u8*) -> void = this.drop_fn;
        df(this.fut);
        this.fut = null;
        ctl.outcome.store(outcome, MemoryOrder::Release);
        // The awaiting task's waker is taken and HS_TASK_FIN published under
        // `done_lock`, which a polling handle holds while it reads the
        // handshake and stores its waker, so no await can store a waker after
        // the take and miss the wake. The swap is our last touch of the block
        // when the handle is live: the joiner then owns reading and freeing
        // it. The waker runs arbitrary code, so it is woken after the unlock.
        const held: MutexGuard<(), GlobalAllocator> = exec.done_lock.lock();
        const joiner: Waker = Waker::take(&ctl.joiner);
        const prev: u8 = ctl.hs.swap(HS_TASK_FIN, MemoryOrder::AcqRel);
        if (prev != HS_HANDLE_GONE) {
            // A joiner may be blocked on the completion condvar.
            exec.task_done.notify_all();
        }
        mem::drop(held);
        if (prev == HS_HANDLE_GONE) {
            // No handle will read the block: dispose it here (drop the stored
            // result only on READY).
            const disp: (mut u8*, u8) -> void = this.dispose_fn;
            mut drop_result: u8 = 0;
            if (outcome == OUTCOME_READY) { drop_result = 1; }
            disp(this.shared, drop_result);
        } else {
            joiner.wake();
        }
    }

}

/// Reclaim a task whose last reference is dropping. If it never finished
/// (`fut` still non-null — it parked and was never re-woken, or the executor is
/// tearing down), finish it as CANCELLED first so its future is dropped and any
/// joiner is released; a finished task (`fut` null) needs nothing more. The
/// `Arc<ErasedTask>` frees the box itself after this runs. Invoked by the `Arc` teardown
/// through `task_decref`, never directly.
implement trait Drop for struct ErasedTask {
    drop(mut &this) -> void {
        if (this.fut != null) {
            this.finish(OUTCOME_CANCELLED);
        }
    }
}

/// The executor whose worker is running on this thread: published by the
/// worker for the thread's lifetime, as the reactor and the blocking pool are,
/// so `Task::spawn` reaches the executor polling its caller. Null on any thread
/// that is not an executor worker.
![thread_local]
private mut g_current_executor: mut ExecInner* = null;

/// The ready queue and the shutdown flag, reached only through the executor's
/// queue lock.
private type struct ReadyQueue {
    private head:     mut ErasedTask*;    // dequeue end (null when empty)
    private tail:     mut ErasedTask*;    // enqueue end
    private shutdown: boolean;  // set at Executor drop

    /// Unlink and return the oldest queued task, or null when the queue is
    /// empty.
    private pop(mut &this) -> mut ErasedTask* {
        const t: mut ErasedTask* = this.head;
        if (t == null) { return null; }
        this.head = t.next;
        if (this.head == null) { this.tail = null; }
        t.next = null;
        return t;
    }
}

/// The shared executor state: a locked FIFO of ready tasks plus a second lock
/// and condition variable joiners block on. Heap-pinned so an `ErasedTask`'s `exec`
/// back-pointer and the worker threads reference a stable address.
private type struct ExecInner {
    private queue: Mutex<ReadyQueue>;
    private work_ready: ConditionVariable;     // workers wait here for work
    // Guards no data: a joiner's predicate is its task's handshake atomic, and
    // this lock only orders that check against the finishing worker's notify.
    private done_lock:  Mutex<()>;
    private task_done:  ConditionVariable;     // joiners wait here for a task to finish
    private reactor: mut Reactor*; // the I/O driver this pool's workers publish while polling
    private blocking: mut BlockingPool*;   // where workers offload calls the reactor cannot drive

    /// Link `task` at the tail of the ready queue and wake one worker. The
    /// caller has already set `task.run_state = ST_SCHEDULED`, so a concurrent
    /// `wake()` sees SCHEDULED and does not double-link.
    private enqueue(mut &this, task: mut ErasedTask*) -> void {
        mut held: MutexGuard<ReadyQueue, GlobalAllocator> = this.queue.lock();
        const queue: mut ReadyQueue* = held.as_mutable_pointer();
        task.next = null;
        if (queue.tail == null) {
            queue.head = task;
            queue.tail = task;
        } else {
            queue.tail.next = task;
            queue.tail = task;
        }
        this.work_ready.notify_one();
        mem::drop(held);
    }

    /// Block until a task is ready or shutdown is signaled. Returns the dequeued
    /// task (already transitioned to ST_RUNNING under the lock so no second
    /// worker can claim it), or null once shutdown is set (leaving any remaining
    /// queued tasks for `Executor::drop` to reclaim).
    private take(mut &this) -> mut ErasedTask* {
        mut held: MutexGuard<ReadyQueue, GlobalAllocator> = this.queue.lock();
        const queue: mut ReadyQueue* = held.as_mutable_pointer();
        while (queue.head == null && !queue.shutdown) {
            this.work_ready.wait(&this.queue, &held);
        }
        if (queue.shutdown) { return null; }
        const t: mut ErasedTask* = queue.pop();
        // Claim the task for this worker before releasing the lock, so a wake
        // between dequeue and poll takes the RUNNING→NOTIFIED path (deferred
        // reschedule) rather than re-linking an already-dequeued task.
        t.run_state.store(ST_RUNNING, MemoryOrder::Release);
        mem::drop(held);
        return t;
    }

    /// A pool worker's body: pull ready tasks and drive them until shutdown.
    /// The worker publishes its executor too, which is where `Task::spawn`
    /// puts what a polled future spawns.
    private work(mut &this) -> void {
        // Publish this pool's reactor and blocking pool for the thread's
        // lifetime: every future this worker polls reaches them through
        // `Reactor::current()` / `BlockingPool::current()`, so an I/O future
        // can park — and a future whose work has no readiness form can
        // offload it — without either driver being threaded through
        // `Context`, whose shape is fixed.
        Reactor::set_current(this.reactor);
        BlockingPool::set_current(this.blocking);
        g_current_executor = &this;
        loop {
            const task: mut ErasedTask* = this.take();
            if (task == null) { return; }
            // `drive` returns true when it re-enqueued the task (the
            // scheduling reference moved back to the queue), false when it
            // finished or parked — then release the scheduling reference this
            // worker held.
            const rescheduled: boolean = task.drive();
            if (!rescheduled) { task_decref(task); }
        }
    }

    /// Reclaim every still-queued task (called from `Executor::drop` after the
    /// workers have joined). Releasing each task's scheduling reference — the
    /// last reference for a never-driven task — runs `ErasedTask::drop`, which
    /// finishes it CANCELLED (its future's drop + the shared-block handshake)
    /// and frees the box; tasks never driven would otherwise leak their boxed
    /// futures. One task is unlinked per lock acquisition and released after
    /// the unlock: a future's drop can wake another task, which enqueues under
    /// this same lock, and that task is then drained in turn.
    private drain_cancelled(mut &this) -> void {
        loop {
            mut held: MutexGuard<ReadyQueue, GlobalAllocator> = this.queue.lock();
            const t: ErasedTask* = held.as_mutable_pointer().pop();
            mem::drop(held);
            if (t == null) { return; }
            task_decref(t);
        }
    }
}


/// Acquire one strong reference to `task`'s box. The owning waker's `clone_fn`
/// and the wake path (handing the ready queue its own reference) call this; it
/// pairs one-for-one with `task_decref`.
private function task_incref(task: ErasedTask*) -> void {
    Arc::<ErasedTask, GlobalAllocator>::increment_strong_count(task);
}

/// Release one strong reference to `task`'s box. The last release runs
/// `ErasedTask::drop` (finishing an unfinished task) and frees the box. Pairs with
/// `task_incref`, the initial `Arc::new` scheduling reference, and each stored
/// waker.
private function task_decref(task: ErasedTask*) -> void {
    Arc::<ErasedTask, GlobalAllocator>::decrement_strong_count(task);
}

/// `Waker` `clone_fn` for an owning task waker: acquire a reference and return
/// the same `ErasedTask*` handle, so the clone keeps the task alive until it drops. A
/// bare fn-ptr stored in the `Waker` vtable, so a free function.
private function waker_arc_clone(data: mut u8*) -> mut u8* {
    task_incref(data as ErasedTask*);
    return data;
}

/// `Waker` `drop_fn` for an owning task waker: release the reference the waker
/// held. A bare fn-ptr stored in the `Waker` vtable, so a free function.
private function waker_arc_drop(data: mut u8*) -> void {
    task_decref(data as ErasedTask*);
}

/// The waker callback: `data` is the `ErasedTask*`. Reschedule it via the atomic
/// run-state so it is enqueued at most once and never polled by two workers —
/// see the module doc. Must be a free function: it is stored in the `Waker`
/// vtable as a raw `(mut u8*) -> void` and invoked as `wake_fn(data)`, and Cryo
/// cannot take a static method's address as a fn-ptr value (it resolves to the
/// type, not the method) — nor could an instance method's `this`-ABI match.
private function task_wake(data: mut u8*) -> void {
    const task: mut ErasedTask* = data as mut ErasedTask*;
    loop {
        const s: u8 = task.run_state.load(MemoryOrder::Acquire);
        if (s == ST_IDLE) {
            match (task.run_state.compare_exchange(ST_IDLE, ST_SCHEDULED,
                                                   MemoryOrder::AcqRel, MemoryOrder::Acquire)) {
                // Waking a parked task hands the ready queue a fresh scheduling
                // reference (the waker keeps its own); the worker that later
                // drives it releases this one. Bump BEFORE enqueue so a worker
                // cannot dequeue-drive-and-decref it to zero before the bump.
                Result::Ok(_)  => { task_incref(task); task.exec.enqueue(task); return; }
                Result::Err(_) => { }   // lost the race; re-read and retry
            }
        } else if (s == ST_RUNNING) {
            match (task.run_state.compare_exchange(ST_RUNNING, ST_NOTIFIED,
                                                   MemoryOrder::AcqRel, MemoryOrder::Acquire)) {
                Result::Ok(_)  => { return; }   // the running worker will reschedule
                Result::Err(_) => { }
            }
        } else {
            // SCHEDULED or NOTIFIED: already pending a poll; nothing to do.
            return;
        }
    }
}


/// Context handed to the `try_catch` trampoline through one `void*`: the erased
/// poll call plus a slot for its status byte. All-`Copy` (fn-ptr + raw pointers),
/// so it owns nothing and is never dropped.  Only the unwinding poll boundary
/// uses it, so it is gated as that boundary is.
![config(panic_unwind)]
private type struct PollCtx {
    private poll_fn: (mut u8*, mut u8*, Context*) -> u8;
    private fut:     mut u8*;
    private shared:  mut u8*;
    private cx:      Context*;
    private status:  u8;
}

/// The void-returning trampoline `intrinsics::try_catch` invokes inside its
/// catch pad. Recovers the poll call from `data`, runs it, and stashes the
/// status. If the poll panics, control unwinds out before the store — straight
/// through this frame, which owns no droppable locals — to the catch pad. A bare
/// fn-ptr, so it must be a free function. Mirrors `panic_unwind::run_catch_body`.
/// Gated as the unwinding poll boundary, its only caller, is.
![config(panic_unwind)]
private function run_poll(data: mut u8*) -> void {
    const pc: mut PollCtx* = data as mut PollCtx*;
    const pf: (mut u8*, mut u8*, Context*) -> u8 = pc.poll_fn;
    pc.status = pf(pc.fut, pc.shared, pc.cx);
}

/// Poll boundary under the unwinding strategy: catch a panicking poll, report it
/// as status 2 and fill `out_panic`. Gated `![config(panic_unwind)]` because
/// `intrinsics::try_catch` and the `__cryo_panic_taken_*` accessors are a
/// compile error / undefined symbols under `--panic=abort`. Must be a file-scope
/// free function — ConfigGating strips declarations, not method bodies.
![config(panic_unwind)]
private function poll_boundary(poll_fn: (mut u8*, mut u8*, Context*) -> u8, fut: mut u8*, shared: mut u8*,
                       cx: Context*, out_panic: mut PanicInfo*) -> u8 {
    mut pc: PollCtx = PollCtx { poll_fn: poll_fn, fut: fut, shared: shared,
                               cx: cx, status: 0 };
    const tramp: (mut u8*) -> void = run_poll;
    const caught: boolean = intrinsics::try_catch(tramp as void*, &pc as mut void*);
    if (caught) {
        *out_panic = panic_unwind::taken_panic_info();
        return 2;
    }
    return pc.status;
}

/// Poll boundary under the abort strategy: a plain direct poll. A panicking poll
/// aborts the whole process (the accepted degradation — no per-task isolation
/// without unwinding). `out_panic` is unused here.
![config(not(panic_unwind))]
private function poll_boundary(poll_fn: (mut u8*, mut u8*, Context*) -> u8, fut: mut u8*, shared: mut u8*,
                       cx: Context*, out_panic: PanicInfo*) -> u8 {
    return poll_fn(fut, shared, cx);
}


/// Monomorphized poll thunk for a concrete future `F`: recover it from its box,
/// poll it, and on `Ready` store the value into the shared block's `result` slot
/// through a raw `O*` (no drop-synth on the uninitialized slot — the
/// `thread_body` idiom). Reports readiness as a byte (1 Ready, 0 Pending). A
/// vtable fn-ptr, addressed via the generic-function-reference mechanism (proven
/// by `thread::thread_trampoline`), so it must be a free function.
private function task_poll_thunk<F, O>(fut_raw: mut u8*, shared_raw: mut u8*, cx: Context*) -> u8
where F: Future<O> {
    const fut: F* = fut_raw as F*;
    match (fut.poll(cx)) {
        Poll::Ready(v) => {
            const sh: mut TaskShared<O>* = shared_raw as mut TaskShared<O>*;
            const rptr: mut O* = &sh.result;
            *rptr = v;
            return 1;
        }
        Poll::Pending => { return 0; }
    }
}

/// Monomorphized drop thunk for `F`: drop the future, free its box.
///
/// The future is moved out of its box into a local, whose scope-exit drop runs
/// whatever drop glue `F` has — an explicit `Drop` impl, per-field drops, or
/// nothing at all. Calling `.drop()` on the box directly would instead require
/// `F` to *declare* a `drop` method, which a hand-written future may but a
/// compiler-generated one (an `async function`'s state machine) never does. A
/// vtable fn-ptr, so a free function.
private function task_drop_thunk<F>(fut_raw: mut u8*) -> void {
    const fut: F* = fut_raw as F*;
    // Sound because the box is released below without running the pointee's
    // destructor, so taking the future out leaves exactly one owner.
    mut _owned: F;
    unsafe { _owned = *fut; }
    mut alloc: GlobalAllocator = GlobalAllocator::new();
    alloc.deallocate(NonNull::new(fut_raw), Layout::of::<F>());
    // `_owned` drops here, after its storage has been released.
}

/// Monomorphized dispose thunk for a shared block of result type `O`: optionally
/// drop the stored `result` (only valid on the READY path), then free the block.
/// The one shared-block op the type-erased executor cannot do without `O`, so it
/// is captured as a per-`O` vtable fn-ptr.
private function dispose_shared_thunk<O>(shared_raw: mut u8*, drop_result: u8) -> void {
    const sh: TaskShared<O>* = shared_raw as TaskShared<O>*;
    if (drop_result == 1) {
        pointer::drop_in_place::<O>(&sh.result);
    }
    mut alloc: GlobalAllocator = GlobalAllocator::new();
    alloc.deallocate(NonNull::new(shared_raw), Layout::of::<TaskShared<O>>());
}


/// Box `fut` + its shared control block, wrap them in an `ErasedTask` with the
/// monomorphized vtable, and enqueue it. Generic-function references
/// (`task_poll_thunk<F,O>` etc.) are taken here in a free generic function — the
/// proven addressable-generic-fn shape (cf. `thread::os_create_thread`) — so this
/// stays a free function rather than an `Executor` method body.
private function spawn_on<F, O>(inner: mut ExecInner*, fut: F) -> JoinHandle<O>
where F: Future<O> {
    mut alloc: GlobalAllocator = GlobalAllocator::new();

    mut sh: mut TaskShared<O>* = null;
    match (alloc.allocate(Layout::of::<TaskShared<O>>())) {
        Result::Ok(raw) => { sh = raw.cast::<TaskShared<O>>().as_pointer(); }
        Result::Err(_)  => { panic("Executor::spawn: shared allocation failed", intrinsics::location()); }
    }
    sh.ctl.outcome = Atomic::<u8>::new(OUTCOME_PENDING);
    sh.ctl.hs      = Atomic::<u8>::new(HS_LIVE);
    sh.ctl.cancel  = Atomic::<u8>::new(0);
    sh.ctl.panic   = PanicInfo { msg: "", file: "", line: 0 };
    sh.ctl.joiner  = Waker::noop();

    mut fbox: mut F* = null;
    match (alloc.allocate(Layout::of::<F>())) {
        Result::Ok(raw) => { fbox = raw.cast::<F>().as_pointer(); }
        Result::Err(_)  => {
            alloc.deallocate(NonNull::new(sh as mut u8*), Layout::of::<TaskShared<O>>());
            panic("Executor::spawn: future allocation failed", intrinsics::location());
        }
    }
    *fbox = fut;

    // Box the task inside an `Arc<ErasedTask>`: the strong count is the box's
    // lifetime. `Arc::new`'s initial count of 1 IS the scheduling reference,
    // handed to the ready queue by `into_raw` (which suppresses the handle's own
    // drop). The `ErasedTask*` it yields is what `task_incref`/`task_decref` take.
    mut arc_res: Result<Arc<ErasedTask, GlobalAllocator>, AllocationError> =
        Arc::try_new(ErasedTask::new(task_poll_thunk::<F, O>, task_drop_thunk::<F>,
                               dispose_shared_thunk::<O>, fbox as mut u8*, sh as mut u8*, inner));
    match (arc_res) {
        Result::Ok(arc) => {
            inner.enqueue(arc.into_raw());
        }
        Result::Err(_)  => {
            // `try_new` dropped the ErasedTask value; its `Drop` finished it CANCELLED
            // and dropped the boxed future, so only the shared block remains.
            alloc.deallocate(NonNull::new(sh as mut u8*), Layout::of::<TaskShared<O>>());
            panic("Executor::spawn: task allocation failed", intrinsics::location());
        }
    }

    return JoinHandle::<O> { shared: sh, exec: inner };
}


/// Why a `join` did not yield a value.
public type enum JoinError {
    Cancelled;              // the task was aborted, or could not make progress
    Panicked(PanicInfo);    // the task panicked (only under --panic=unwind)
}

/// `the task was cancelled`, or `the task panicked: ` and the panic's
/// message.
implement trait Display for enum JoinError {
    fmt(&this, f: mut &Formatter) -> Result<(), FormatError> {
        match (&this) {
            JoinError::Cancelled => { return f.write_str(Str::new("the task was cancelled")); }
            JoinError::Panicked(info) => {
                f.write_str(Str::new("the task panicked: "))?;
                return f.write_str(Str::new(info.msg));
            }
        }
    }
}

/// `Cancelled`, or `Panicked(` the panic's message and where it was raised
/// `)`.
implement trait Debug for enum JoinError {
    fmt(&this, f: mut &Formatter) -> Result<(), FormatError> {
        match (&this) {
            JoinError::Cancelled => { return f.write_str(Str::new("Cancelled")); }
            JoinError::Panicked(info) => {
                f.write_str(Str::new("Panicked("))?;
                f.write_str(Str::new(info.msg))?;
                f.write_str(Str::new(" at "))?;
                f.write_str(Str::new(info.file))?;
                f.write_str(Str::new(":"))?;
                const line: String = f"{info.line}";
                f.write_str(line.as_str())?;
                return f.write_str(Str::new(")"));
            }
        }
    }
}

implement trait Error for enum JoinError { }


/// A handle to a spawned task, yielding its `Output` via `join()`. Dropping a
/// handle without `join`/`detach` detaches (the task runs on, its result
/// discarded). `abort()` requests cancellation.
public type struct JoinHandle<O> {
    private shared: mut TaskShared<O>*;
    private exec:   ExecInner*;

    /// Block on the completion condvar until a worker finishes this task, then
    /// return its `Output` (or `Err` if it was aborted / could not complete /
    /// panicked). Consumes the handle and frees the block. Waiting on the
    /// handshake state (not merely `outcome`) guarantees the finishing worker is
    /// past its last touch of the block before we read+free it.
    ///
    /// `join` blocks the thread. Inside a task, `await` the handle instead:
    /// it is a `Future` of the same `Result`, and parks only the awaiting task.
    public join(mut this) -> Result<O, JoinError> {
        const ctl: TaskCtl* = &this.shared.ctl;
        mut held: MutexGuard<(), GlobalAllocator> = this.exec.done_lock.lock();
        while (ctl.hs.load(MemoryOrder::Acquire) != HS_TASK_FIN) {
            this.exec.task_done.wait(&this.exec.done_lock, &held);
        }
        mem::drop(held);
        return this.take_outcome();
    }

    /// Read the finished task's outcome out of the control block and free the
    /// block. Called once HS_TASK_FIN has been observed, when the finishing
    /// task no longer touches the block. Nulls `shared`, so the handle's
    /// `Drop`, and any later poll, find it consumed.
    private take_outcome(mut &this) -> Result<O, JoinError> {
        // Read the fields, then null `shared` to neutralize this handle's Drop
        // (it no-ops on a null `shared`) — the "consume" a destructure would give,
        // without a `: JoinHandle<O>` annotation (which misresolves to
        // `thread::JoinHandle` under `import thread`).
        const shared: mut TaskShared<O>* = this.shared;
        this.shared = null;
        const ctl: TaskCtl* = &shared.ctl;
        const outcome: u8 = ctl.outcome.load(MemoryOrder::Acquire);
        mut alloc: GlobalAllocator = GlobalAllocator::new();
        if (outcome == OUTCOME_READY) {
            // A take: the block is freed without dropping `result`, so the
            // value read out of it is its only owner.
            const rptr: O* = &shared.result;
            unsafe {
                const out: O = *rptr;
                alloc.deallocate(NonNull::new(shared as mut u8*), Layout::of::<TaskShared<O>>());
                return Result::Ok(out);
            }
        }
        if (outcome == OUTCOME_PANICKED) {
            const info: PanicInfo = ctl.panic;
            alloc.deallocate(NonNull::new(shared as mut u8*), Layout::of::<TaskShared<O>>());
            return Result::Err(JoinError::Panicked(info));
        }
        alloc.deallocate(NonNull::new(shared as mut u8*), Layout::of::<TaskShared<O>>());
        return Result::Err(JoinError::Cancelled);
    }

    /// Give up the ability to join. The task runs to completion independently;
    /// its result is dropped. Consumes the handle.
    public detach(mut this) -> void {
        const shared: mut TaskShared<O>* = this.shared;
        this.shared = null;   // consume: neutralize this handle's Drop
        detach_shared::<O>(shared, this.exec);
    }

    /// Request that the task be cancelled. It is reclaimed — its `Output` never
    /// produced — the next time a worker reaches it (a subsequent `join` then
    /// returns `Err(Cancelled)`). Does not consume the handle.
    public abort(&this) -> void {
        const ctl: mut TaskCtl* = &this.shared.ctl;
        ctl.cancel.store(1, MemoryOrder::Release);
    }

    /// True once the task has finished (completed, cancelled, or panicked).
    /// Never blocks and does not consume the handle.
    public is_finished(&this) -> boolean {
        const ctl: TaskCtl* = &this.shared.ctl;
        return ctl.outcome.load(MemoryOrder::Acquire) != OUTCOME_PENDING;
    }
}

/// Dropping a handle without `join`/`detach` detaches the task, so it and its
/// control block are still reclaimed. `join`/`detach` destructure `this`,
/// suppressing this path.
implement<O> trait Drop for struct JoinHandle<O> {
    drop(mut &this) -> void {
        if (this.shared == null) { return; }
        detach_shared::<O>(this.shared, this.exec);
        this.shared = null;
    }
}

/// Awaiting a handle parks the awaiting task until the spawned one finishes,
/// then yields what `join` would: the task's `Output`, or why there is none.
/// The handle is consumed by the `Ready` poll; polling it again panics.
implement<O> trait Future<Result<O, JoinError>> for struct JoinHandle<O> {
    poll(mut &this, cx: Context*) -> Poll<Result<O, JoinError>> {
        if (this.shared == null) {
            panic("JoinHandle polled after it completed", intrinsics::location());
        }
        const ctl: mut TaskCtl* = &this.shared.ctl;
        const held: MutexGuard<(), GlobalAllocator> = this.exec.done_lock.lock();
        if (ctl.hs.load(MemoryOrder::Acquire) != HS_TASK_FIN) {
            // The waker this replaces is the same task's from an earlier poll;
            // it is released after the unlock, as every waker is.
            const replaced: Waker = Waker::replace(&ctl.joiner, cx.waker());
            mem::drop(held);
            mem::drop(replaced);
            return Poll::Pending;
        }
        mem::drop(held);
        return Poll::Ready(this.take_outcome());
    }
}

/// The task-spawning entry points of the executor polling the caller.
///
/// Inside a task - an `async function main`, or any future an `Executor`
/// drives - `Task::spawn` starts another future on the same executor and
/// returns its `JoinHandle`, which the caller awaits:
///
/// ```cryo
/// import std::future::{ Task, JoinHandle };
///
/// async function double(x: i64) -> i64 { return x * 2; }
///
/// async function main() -> i32 {
///     const first: JoinHandle<i64> = Task::spawn(double(20));
///     const second: JoinHandle<i64> = Task::spawn(double(1));
///     const a: i64 = (await first).unwrap();
///     const b: i64 = (await second).unwrap();
///     return (a + b) as i32;   // 42
/// }
/// ```
///
/// There is no executor to find outside a task, so a call from any other
/// thread panics; code there holds the `Executor` and calls its `spawn`.
public type struct Task {
    /// Spawn `future` on the executor polling the caller, and return a handle
    /// to its `Output`. The executor's workers begin driving it at once.
    /// Panics when the calling thread is not one of an executor's workers,
    /// reporting the call's place.
    ![caller_location]
    public static spawn<F, O>(future: F) -> JoinHandle<O>
    where F: Future<O> {
        const inner: mut ExecInner* = g_current_executor;
        if (inner == null) {
            panic("Task::spawn called outside a task: no executor is polling this thread; spawn from inside an async function an Executor drives, or call Executor.spawn", intrinsics::location());
        }
        return spawn_on::<F, O>(inner, future);
    }

    /// Run `work` on the executor's blocking pool, a thread no task is polled
    /// on, and return a handle to what it returns. For work that blocks and
    /// has no future form - a long computation, a synchronous library call -
    /// which run inside a task would stall a worker, and on a one-worker
    /// executor every task, for its whole duration. Panics when the calling
    /// thread is not one of an executor's workers, reporting the call's place.
    ///
    /// Once started, `work` runs to its end: aborting the handle stops the
    /// wait, not the thread.
    ![caller_location]
    public static spawn_blocking<F, O>(work: F) -> JoinHandle<O>
    where F: () -> O + Send, O: Send {
        const inner: mut ExecInner* = g_current_executor;
        if (inner == null) {
            panic("Task::spawn_blocking called outside a task: no executor is polling this thread; spawn from inside an async function an Executor drives", intrinsics::location());
        }
        const offloaded: BlockingCallFuture<F, O> = BlockingCallFuture::<F, O> { work: Option::Some(work), call: null };
        return spawn_on::<BlockingCallFuture<F, O>, O>(inner, offloaded);
    }
}

/// A `Task::spawn_blocking` call's block, shared with the blocking pool: the
/// job header first, since the pool reaches the block through it; the work,
/// which a pool thread moves out and runs; and the work's result. `started`
/// says the work was moved out - a job the pool cancels never starts, and its
/// work is dropped unrun - `produced` that the result is written, and `taken`
/// that the awaiting future moved it out.
private type struct BlockingCall<F, O> {
    private job:      BlockingJob;
    private work:     F;
    private output:   O;
    private started:  boolean;
    private produced: boolean;
    private taken:    boolean;
}

/// `run_fn` for a `BlockingCall`: move the work out of the block, run it,
/// and store its result through a raw pointer (the slot is uninitialized, so
/// nothing may drop what it holds). `produced` is set last; the pool
/// publishes the job's status under its lock after this returns, which
/// orders every write here before the collecting side's read. A vtable
/// fn-ptr, so a free function.
private function blocking_call_run<F, O>(raw: mut u8*) -> void
where F: () -> O {
    const call: mut BlockingCall<F, O>* = raw as mut BlockingCall<F, O>*;
    call.started = true;
    const work_slot: F* = &call.work;
    mut work: F;
    // The block never drops `work` once `started` is set, so this is the
    // one owner.
    unsafe { work = *work_slot; }
    const result: O = work();
    const output_slot: mut O* = &call.output;
    *output_slot = result;
    call.produced = true;
}

/// `drop_fn` for a `BlockingCall`: drop the work if no thread started it,
/// drop a result nobody took, and free the block. Runs on whichever side
/// releases the block last. A vtable fn-ptr, so a free function.
private function blocking_call_free<F, O>(raw: mut u8*) -> void {
    const call: BlockingCall<F, O>* = raw as BlockingCall<F, O>*;
    if (!call.started) {
        pointer::drop_in_place::<F>(&call.work);
    }
    if (call.produced && !call.taken) {
        pointer::drop_in_place::<O>(&call.output);
    }
    mut alloc: GlobalAllocator = GlobalAllocator::new();
    alloc.deallocate(NonNull::new(raw), Layout::of::<BlockingCall<F, O>>());
}

/// Allocate a `BlockingCall` holding `work`, its job header prepared with the
/// block's vtable and its one reference held by the caller. A free generic
/// function, as `spawn_on` is, because it takes generic-function references
/// (`blocking_call_run::<F, O>`): taken in a method of a generic impl, they
/// lower to null pointers.
private function new_blocking_call<F, O>(work: F) -> mut BlockingCall<F, O>*
where F: () -> O {
    mut alloc: GlobalAllocator = GlobalAllocator::new();
    mut call: mut BlockingCall<F, O>* = null;
    match (alloc.allocate(Layout::of::<BlockingCall<F, O>>())) {
        Result::Ok(raw) => { call = raw.cast::<BlockingCall<F, O>>().as_pointer(); }
        Result::Err(_)  => { panic("Task::spawn_blocking: allocation failed", intrinsics::location()); }
    }
    BlockingJob::initialize(&call.job, blocking_call_run::<F, O>, blocking_call_free::<F, O>);
    const work_slot: mut F* = &call.work;
    *work_slot = work;
    call.started  = false;
    call.produced = false;
    call.taken    = false;
    return call;
}

/// The task `Task::spawn_blocking` spawns: its first poll hands the work to
/// the blocking pool, and it completes with the work's result once a pool
/// thread has run it. Holding the work until that first poll means a task
/// aborted before it ever runs submits nothing.
private type struct BlockingCallFuture<F, O> {
    private work: Option<F>;                 // until the first poll submits it
    private call: mut BlockingCall<F, O>*;   // null before that and once the result is taken

    /// Move the result out of the finished block and release this side's
    /// reference to it.
    private take_result(mut &this) -> O {
        const call: mut BlockingCall<F, O>* = this.call;
        this.call = null;
        const output_slot: O* = &call.output;
        mut result: O;
        // `taken` makes the block's teardown leave the result alone, so this
        // is its one owner.
        unsafe { result = *output_slot; }
        call.taken = true;
        call.job.release();
        return result;
    }
}

implement<F, O> trait Future<O> for struct BlockingCallFuture<F, O> where F: () -> O {
    poll(mut &this, cx: Context*) -> Poll<O> {
        if (this.call == null) {
            if (this.work.is_none()) {
                panic("Task::spawn_blocking's task polled after it completed", intrinsics::location());
            }
            const call: mut BlockingCall<F, O>* = new_blocking_call::<F, O>(this.work.take().unwrap());
            this.call = call;
            // Every worker publishes its executor's pool, and this future runs
            // only on a worker. A pool that is shutting down, or could not
            // create a thread, refuses the job: then it runs here, slowly, but
            // to an answer rather than a wait nothing ends.
            const pool: mut BlockingPool* = BlockingPool::current();
            if (!pool.submit(&call.job)) {
                blocking_call_run::<F, O>(call as mut u8*);
                return Poll::Ready(this.take_result());
            }
        }
        // Arming reads the job's status under the pool's lock, so a result
        // published between polls is collected now rather than waited for.
        if (this.call.job.arm(cx.waker()) == JOB_PENDING) {
            return Poll::Pending;
        }
        if (!this.call.produced) {
            panic("Task::spawn_blocking: the executor shut down before the work ran", intrinsics::location());
        }
        return Poll::Ready(this.take_result());
    }
}

/// A task dropped before its work finished releases this side's reference;
/// a pool thread still running the work keeps the block until it is done.
implement<F, O> trait Drop for struct BlockingCallFuture<F, O> {
    drop(mut &this) -> void {
        if (this.call == null) { return; }
        const call: mut BlockingCall<F, O>* = this.call;
        this.call = null;
        call.job.release();
    }
}


/// A multi-threaded, poll-driven task executor. Construct one, `spawn` futures
/// onto it (keeping the `JoinHandle` to await a result, or dropping it to
/// fire-and-forget), and `block_on` to drive a root future to its value. A pool
/// of worker threads does all polling; the calling thread only ever blocks on a
/// completion condvar.
![language("executor")]
public type struct Executor {
    private inner:   mut ExecInner*;
    private workers: [ThreadJoinHandle<()>];   // the pool's worker threads

    /// Create an executor whose pool is sized to the hardware parallelism.
    public static new() -> Executor {
        return Executor::with_threads(thread::available_parallelism());
    }

    /// Create an executor with exactly `n` worker threads (clamped to >= 1 so the
    /// pool always makes progress) and the default blocking-pool ceiling.
    public static with_threads(n: u32) -> Executor {
        return Executor::with_threads_and_blocking(n, BLOCKING_DEFAULT_THREADS);
    }

    /// Create an executor with `n` worker threads and a blocking pool that will
    /// grow to at most `blocking` threads.
    ///
    /// The two counts size unrelated things and should not be derived from each
    /// other: workers are CPU-bound pollers, so their count tracks hardware
    /// parallelism, while a blocking thread is asleep in a syscall and its count
    /// tracks how many uninterruptible calls are outstanding at once. A program
    /// that offloads more concurrent blocking work than `blocking` allows does
    /// not slow down evenly — the excess queues behind the running jobs.
    public static with_threads_and_blocking(n: u32, blocking: u32) -> Executor {
        mut count: u32 = n;
        if (count == 0) { count = 1; }
        mut alloc: GlobalAllocator = GlobalAllocator::new();
        mut inner: mut ExecInner* = null;
        match (alloc.allocate(Layout::of::<ExecInner>())) {
            Result::Ok(raw) => { inner = raw.cast::<ExecInner>().as_pointer(); }
            Result::Err(_)  => { panic("Executor::new: allocation failed", intrinsics::location()); }
        }
        inner.queue      = Mutex::new(ReadyQueue { head: null, tail: null, shutdown: false });
        inner.work_ready = ConditionVariable::new();
        inner.done_lock  = Mutex::new(());
        inner.task_done  = ConditionVariable::new();
        // Before any worker starts: each publishes these handles as it comes up.
        // The blocking pool starts empty — it creates its first thread only if
        // something actually offloads work — so this costs an allocation.
        inner.reactor  = Reactor::start();
        inner.blocking = BlockingPool::with_maximum(blocking);
        mut workers: [ThreadJoinHandle<()>] = [];
        for (mut i: u32 = 0; i < count; i = i + 1) {
            workers.push(thread::spawn(move () -> () { inner.work(); return (); }));
        }
        return Executor { inner: inner, workers: workers };
    }

    /// Spawn `fut` and return a handle to its `Output`. Workers begin driving it
    /// immediately.
    public spawn<F, O>(mut &this, fut: F) -> JoinHandle<O>
    where F: Future<O> {
        return spawn_on::<F, O>(this.inner, fut);
    }

    /// Spawn `fut` as fire-and-forget: it runs to completion and its result is
    /// discarded. Sugar for `spawn(fut).detach()`.
    public spawn_detached<F, O>(mut &this, fut: F) -> void
    where F: Future<O> {
        mut h: JoinHandle<O> = spawn_on::<F, O>(this.inner, fut);
        h.detach();
    }

    /// Spawn `root` and block the calling thread until a worker drives it to
    /// completion, then return its value. Panics if `root` was cancelled or
    /// could not complete; use `spawn(root).join()` for the `Result`.
    public block_on<F, O>(mut &this, root: F) -> O
    where F: Future<O> {
        mut h: JoinHandle<O> = spawn_on::<F, O>(this.inner, root);
        match (h.join()) {
            Result::Ok(v)  => { return v; }
            Result::Err(_) => { panic("Executor::block_on: root future did not complete", intrinsics::location()); }
        }
    }
}

/// Signal shutdown, join the workers, stop the two drivers, then reclaim any
/// tasks still queued (never driven) as CANCELLED so their futures' drops run
/// and no block leaks. Shutdown MUST be signaled before the workers are joined,
/// or the join would block forever waiting on threads that never leave `take()`.
///
/// The steps are ordered so nothing can be resurrected after it is reclaimed.
/// Joining the workers first stops all polling.
///
/// The blocking pool stops next, and before the reactor. Its threads cannot be
/// interrupted, so this waits out any call already in flight; cancelling what is
/// merely queued releases those jobs' wakers, which can be the last reference to
/// a task, whose future's drop may then cancel a reactor registration — so the
/// reactor has to still be standing when that happens.
///
/// Stopping the reactor then joins its thread — after which no wake can be
/// generated — and releases its registrations and timers, whose wakers are the
/// last reference to any task parked on I/O or a deadline, so those tasks are
/// finished and freed here (a task's drop deregisters, which the teardown
/// tolerates re-entrantly). Only then is the queue drained: draining before the
/// drivers stopped would leave a task woken in the interim sitting in the queue
/// forever.
///
/// Both driver blocks are freed last, after the drain rather than as part of
/// their stop. A task that readiness had already woken is still sitting in the
/// queue at that point, and dropping it runs its future's `Drop`, which cancels
/// against the reactor it registered with or lets go of a blocking job; those
/// have to find live (if empty) structures rather than freed memory.
implement trait Drop for struct Executor {
    drop(mut &this) -> void {
        if (this.inner == null) { return; }
        const inner: mut ExecInner* = this.inner;
        mut held: MutexGuard<ReadyQueue, GlobalAllocator> = inner.queue.lock();
        held.as_mutable_pointer().shutdown = true;
        mem::drop(held);
        inner.work_ready.notify_all();
        // Join every worker (each exits `take()` once it observes shutdown).
        // Must follow the shutdown+broadcast above, or the join would block
        // forever on threads still parked in `take()`.
        loop {
            match (this.workers.pop()) {
                Option::Some(worker) => { worker.join().unwrap(); }
                Option::None         => { break; }
            }
        }
        BlockingPool::stop(inner.blocking);
        Reactor::stop(inner.reactor);
        // No workers and no reactor thread remain. The reactor block stays
        // alive across this drain because a
        // queued task's future may still cancel a registration or timer against
        // it as it is dropped; `Reactor::free` releases it once that is past.
        inner.drain_cancelled();
        Reactor::free(inner.reactor);
        inner.reactor = null;
        BlockingPool::free(inner.blocking);
        inner.blocking = null;
        pointer::drop_in_place::<ExecInner>(inner);
        mut alloc: GlobalAllocator = GlobalAllocator::new();
        alloc.deallocate(NonNull::new(inner as mut u8*), Layout::of::<ExecInner>());
        this.inner = null;
    }
}
