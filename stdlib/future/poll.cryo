///! `Poll<T>`: the result of polling a `Future`.

namespace std::future::poll;

/// The result of polling a `Future`: either the final value, or a signal that
/// the value is not ready yet and the task should be re-polled after its
/// `Waker` fires.
type enum Poll<T> {
    Ready(T);
    Pending;
}

implement enum Poll<T> {
    /// True when this is `Ready`. The payload is inspected by reference, so the
    /// receiver keeps ownership of it.
    is_ready(&this) -> boolean {
        match (&this) {
            Poll::Ready(_) => { return true; }
            Poll::Pending  => { return false; }
        }
    }

    /// True when this is `Pending`.
    is_pending(&this) -> boolean {
        match (&this) {
            Poll::Ready(_) => { return false; }
            Poll::Pending  => { return true; }
        }
    }

    /// Move the `Ready` value out. Aborts on `Pending`. The compiler's async
    /// lowering calls this only after an `is_pending` check has already
    /// returned on the `Pending` path, so the `Pending` arm here is a
    /// should-never-happen guard rather than a reachable state.
    ///
    /// `![sink]`: the match-arm binding copies the payload out of the
    /// receiver, so the receiver is treated as moved at the call site -
    /// otherwise both the returned value and the still-live receiver would be
    /// dropped, double-freeing an owning payload.
    ![sink]
    into_ready(&this) -> T {
        match (&this) {
            Poll::Ready(value) => { return value; }
            Poll::Pending      => { panic("Poll::into_ready() called on a Pending value", FILE, LINE); }
        }
    }
}
