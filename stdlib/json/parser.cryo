///! Recursive-descent JSON parser.
///!
///! Single-pass over a borrowed `Str`. Tracks `(line, column, offset)`
///! for error reporting. RFC 8259 strict: no trailing commas, no
///! unquoted keys, no comments.
///!
///! `MAX_DEPTH` caps object/array nesting to prevent stack-blowup on
///! adversarial inputs. The default is generous for hand-authored data
///! and tight enough that a malicious 1 MB blob of `[[[...]]]` cannot
///! exhaust the stack.

namespace std::json::parser;

import std::core::option;
import std::core::result::{ Result };
import std::core::slice::{ Slice };
import std::collections::array::{ Array };
import std::collections::string::{ String };
import std::collections::str::{ Str };
import std::json::value::{ JsonNumber, JsonObject, JsonValue };
import std::json::error::{ JsonError, JsonErrorKind };
import std::fmt::float;
import std::ffi::libc;
import std::core::mem;

/// ASCII code points used by the parser. Names beat magic numbers.
private const HT:   u8 = 9;     // tab
private const LF:   u8 = 10;    // \n
private const CR:   u8 = 13;    // \r
private const SPACE: u8 = 32;
private const QUOTE: u8 = 34;   // "
private const PLUS:  u8 = 43;   // +
private const COMMA: u8 = 44;   // ,
private const MINUS: u8 = 45;   // -
private const DOT:   u8 = 46;   // .
private const ZERO:  u8 = 48;   // 0
private const COLON: u8 = 58;   // :
private const UPPER_E: u8 = 69; // E
private const LBRACK: u8 = 91;  // [
private const BACKSLASH: u8 = 92; // \
private const RBRACK: u8 = 93;  // ]
private const LOWER_B: u8 = 98; // b
private const LOWER_E: u8 = 101; // e
private const LOWER_F: u8 = 102; // f
private const LOWER_L: u8 = 108; // l
private const LOWER_N: u8 = 110; // n
private const LOWER_R: u8 = 114; // r
private const LOWER_S: u8 = 115; // s
private const LOWER_T: u8 = 116; // t
private const LOWER_U: u8 = 117; // u
private const LBRACE: u8 = 123; // {
private const RBRACE: u8 = 125; // }

/// Maximum nesting depth for arrays + objects, combined.  The serializer
/// bounds its recursion by the same cap.
internal const MAX_DEPTH: u64 = 256;

private type struct Parser {
    private src:    u8*;
    private len:    u64;
    private pos:    u64;
    private line:   u64;
    private column: u64;
    private depth:  u64;

    private static new(text: Str) -> Parser {
        return Parser {
            src:    text.as_ptr(),
            len:    text.length() as u64,
            pos:    0,
            line:   1,
            column: 1,
            depth:  0,
        };
    }

    // Cursor primitives

    private eof(&this) -> boolean {
        return this.pos >= this.len;
    }

    private peek(&this) -> u8 {
        if (this.pos >= this.len) { return 0; }
        return this.src[this.pos];
    }

    /// Advance one byte, updating line/column tracking. Caller must
    /// ensure `!eof()` first.
    private advance(mut &this) -> u8 {
        const b: u8 = this.src[this.pos];
        this.pos = this.pos + 1;
        if (b == LF) {
            this.line   = this.line + 1;
            this.column = 1;
        } else {
            this.column = this.column + 1;
        }
        return b;
    }

    /// Skip ASCII whitespace per RFC 8259: SP, HT, LF, CR.
    private skip_ws(mut &this) -> void {
        while (this.pos < this.len) {
            const b: u8 = this.src[this.pos];
            if (b == SPACE || b == HT || b == LF || b == CR) {
                this.advance();
            } else {
                return;
            }
        }
    }

    // Error helpers

    private err_eof(&this) -> JsonError {
        return JsonError::new(
            JsonErrorKind::UnexpectedEof,
            this.line, this.column, this.pos,
            String::from_str(Str::new("unexpected end of input"))
        );
    }

    private err_at(&this, kind: JsonErrorKind, msg: Str) -> JsonError {
        return JsonError::new(kind, this.line, this.column, this.pos, String::from_str(msg));
    }

    private err_unexpected(&this) -> JsonError {
        return JsonError::new(
            JsonErrorKind::UnexpectedChar,
            this.line, this.column, this.pos,
            String::from_str(Str::new("unexpected character"))
        );
    }

    // Top-level

    /// Parse a single value. Caller is responsible for the surrounding
    /// `skip_ws` and trailing-data check; `parse(text)` is the public
    /// entry point that handles those.
    private parse_value(mut &this) -> Result<JsonValue, JsonError> {
        if (this.eof()) { return Result::Err(this.err_eof()); }
        const b: u8 = this.peek();
        if (b == LBRACE) { return this.parse_object(); }
        if (b == LBRACK) { return this.parse_array();  }
        if (b == QUOTE)  { return this.parse_string_value(); }
        if (b == LOWER_T || b == LOWER_F) { return this.parse_bool(); }
        if (b == LOWER_N) { return this.parse_null(); }
        if (b == MINUS || b.is_digit()) { return this.parse_number(); }
        return Result::Err(this.err_unexpected());
    }

    // Keywords

    private parse_null(mut &this) -> Result<JsonValue, JsonError> {
        if (this.match_literal("null", 4)) {
            return Result::Ok(JsonValue::Null);
        }
        return Result::Err(this.err_at(
            JsonErrorKind::UnexpectedChar,
            Str::new("expected 'null'")
        ));
    }

    private parse_bool(mut &this) -> Result<JsonValue, JsonError> {
        if (this.peek() == LOWER_T) {
            if (this.match_literal("true", 4)) {
                return Result::Ok(JsonValue::Bool(true));
            }
            return Result::Err(this.err_at(
                JsonErrorKind::UnexpectedChar,
                Str::new("expected 'true'")
            ));
        }
        if (this.match_literal("false", 5)) {
            return Result::Ok(JsonValue::Bool(false));
        }
        return Result::Err(this.err_at(
            JsonErrorKind::UnexpectedChar,
            Str::new("expected 'false'")
        ));
    }

    /// Match a literal byte sequence. Returns true and advances past
    /// it on a match; returns false without advancing on a miss.
    private match_literal(mut &this, lit: string, lit_len: u64) -> boolean {
        if (this.pos + lit_len > this.len) { return false; }
        const lit_bytes: u8* = lit as u8*;
        mut i: u64 = 0;
        while (i < lit_len) {
            if (this.src[this.pos + i] != lit_bytes[i]) { return false; }
            i++;
        }
        i = 0;
        while (i < lit_len) { this.advance(); i++; }
        return true;
    }

    // Numbers

    private parse_number(mut &this) -> Result<JsonValue, JsonError> {
        const start: u64 = this.pos;
        mut negative: boolean = false;
        mut has_fraction: boolean = false;
        mut has_exponent: boolean = false;

        if (this.peek() == MINUS) {
            negative = true;
            this.advance();
            if (this.eof()) { return Result::Err(this.err_eof()); }
        }

        // Integer part
        if (this.peek() == ZERO) {
            this.advance();
            // After '0', either '.' or exponent or end of number (no leading zeros).
        } else {
            if (!this.peek().is_digit()) {
                return Result::Err(this.err_at(
                    JsonErrorKind::InvalidNumber,
                    Str::new("expected digit")
                ));
            }
            while (!this.eof() && this.peek().is_digit()) { this.advance(); }
        }

        // Fraction
        if (!this.eof() && this.peek() == DOT) {
            has_fraction = true;
            this.advance();
            if (this.eof()) {
                return Result::Err(this.err_at(
                    JsonErrorKind::InvalidNumber,
                    Str::new("expected digit after '.'")
                ));
            }
            if (!this.peek().is_digit()) {
                return Result::Err(this.err_at(
                    JsonErrorKind::InvalidNumber,
                    Str::new("expected digit after '.'")
                ));
            }
            while (!this.eof() && this.peek().is_digit()) { this.advance(); }
        }

        // Exponent
        if (!this.eof()) {
            const e: u8 = this.peek();
            if (e == LOWER_E || e == UPPER_E) {
                has_exponent = true;
                this.advance();
                if (this.eof()) {
                    return Result::Err(this.err_at(
                        JsonErrorKind::InvalidNumber,
                        Str::new("expected exponent digits")
                    ));
                }
                const sign: u8 = this.peek();
                if (sign == PLUS || sign == MINUS) { this.advance(); }
                if (this.eof()) {
                    return Result::Err(this.err_at(
                        JsonErrorKind::InvalidNumber,
                        Str::new("expected exponent digits")
                    ));
                }
                if (!this.peek().is_digit()) {
                    return Result::Err(this.err_at(
                        JsonErrorKind::InvalidNumber,
                        Str::new("expected exponent digits")
                    ));
                }
                while (!this.eof() && this.peek().is_digit()) { this.advance(); }
            }
        }

        const end: u64 = this.pos;
        const literal_len: u64 = end - start;

        if (has_fraction || has_exponent) {
            // Float path. Build a NUL-terminated copy on the heap and
            // hand it to libc strtod. Cryo doesn't expose a safe
            // arbitrary-precision float parser today; strtod is the
            // pragmatic choice for v1 (correct IEEE-754 nearest-rounding,
            // which preserves round-trip precision).
            //
            // LOCALE ASSUMPTION: `strtod` reads its radix character from
            // the active `LC_NUMERIC` locale. JSON's radix is always '.',
            // so this assumes the C/POSIX locale (the process default).
            // A program that calls `setlocale(LC_ALL, "")` into a locale
            // whose decimal separator is ',' (e.g. de_DE, fr_FR) would
            // make `strtod("3.14")` stop at the '.' and misparse JSON
            // numbers; such programs must reset `LC_NUMERIC` to "C" around
            // JSON parsing. A locale-independent `strtod_l`/`_strtod_l`
            // binding is the planned follow-up.
            const buf: u8* = libc::malloc(literal_len + 1);
            if (buf == null) {
                return Result::Err(this.err_at(
                    JsonErrorKind::OutOfMemory,
                    Str::new("allocation failed while parsing float literal")
                ));
            }
            libc::memcpy(buf as void*, (this.src + start) as void*, literal_len);
            buf[literal_len] = 0;
            const v: f64 = float::parse_f64(buf as string).unwrap_or(0.0);
            libc::free(buf as void*);
            return Result::Ok(JsonValue::Number(JsonNumber::Float(v)));
        }

        // Integer path: the magnitude is read as a u64 and negated at the
        // end; i64::MIN is exactly -2^63, which fits as u64 magnitude 2^63.
        // Every byte from the sign to `end` was scanned as a digit above,
        // so the only refusal left is overflow.
        const I64_MIN_MAG:  u64 = (i64::MAX as u64) + 1;   // |i64::MIN|
        const digits_start: u64 = if (negative) { start + 1 } else { start };
        const magnitude: option::Option<u64> = u64::parse_radix(
            Slice::from_raw(this.src + digits_start, (end - digits_start) as i64), 10);
        if (magnitude.is_none()) {
            return Result::Err(this.err_at(
                JsonErrorKind::InvalidNumber,
                Str::new("integer overflow")
            ));
        }
        const acc: u64 = magnitude.unwrap_or(0);

        if (negative) {
            if (acc > I64_MIN_MAG) {
                return Result::Err(this.err_at(
                    JsonErrorKind::InvalidNumber,
                    Str::new("integer overflow")
                ));
            }
            if (acc == I64_MIN_MAG) {
                return Result::Ok(JsonValue::Number(JsonNumber::Int(i64::MIN)));
            }
            const v: i64 = -(acc as i64);
            return Result::Ok(JsonValue::Number(JsonNumber::Int(v)));
        }

        if (acc <= i64::MAX as u64) {
            return Result::Ok(JsonValue::Number(JsonNumber::Int(acc as i64)));
        }
        return Result::Ok(JsonValue::Number(JsonNumber::UInt(acc)));
    }

    // Strings

    private parse_string_value(mut &this) -> Result<JsonValue, JsonError> {
        const s: String = this.parse_string_raw()?;
        return Result::Ok(JsonValue::String(s));
    }

    /// Parse a JSON string literal into an owned `String`. Assumes the
    /// cursor is on the opening quote; consumes through the closing
    /// quote. Decodes `\X` and `\uXXXX` escapes; surrogate pairs are
    /// recombined; invalid bytes inside `\u` produce InvalidUnicode.
    private parse_string_raw(mut &this) -> Result<String, JsonError> {
        if (this.peek() != QUOTE) {
            return Result::Err(this.err_at(
                JsonErrorKind::UnexpectedChar,
                Str::new("expected '\"'")
            ));
        }
        this.advance();
        mut out: String = String::new();
        while (true) {
            if (this.eof()) {
                return Result::Err(this.err_eof());
            }
            const b: u8 = this.peek();
            if (b == QUOTE) {
                this.advance();
                return Result::Ok(out);
            }
            if (b == BACKSLASH) {
                this.advance();
                if (this.eof()) {
                    return Result::Err(this.err_eof());
                }
                this.parse_escape(&out)?;
                continue;
            }
            // Reject unescaped control characters per RFC 8259 section 7.
            if (b < 0x20) {
                return Result::Err(this.err_at(
                    JsonErrorKind::UnexpectedChar,
                    Str::new("unescaped control character")
                ));
            }
            out.push_byte(b);
            this.advance();
        }
        // Unreachable
        return Result::Ok(out);
    }

    /// Decode one escape sequence, starting on the byte after `\`.
    /// Appends the decoded bytes to `out`.
    private parse_escape(mut &this, out: mut &String) -> Result<(), JsonError> {
        const c: u8 = this.advance();
        if (c == QUOTE)     { out.push_byte(QUOTE);     return Result::Ok(()); }
        if (c == BACKSLASH) { out.push_byte(BACKSLASH); return Result::Ok(()); }
        if (c == 47)        { out.push_byte(47 as u8);   return Result::Ok(()); }  // /
        if (c == LOWER_B)   { out.push_byte(0x08 as u8); return Result::Ok(()); }  // \b
        if (c == LOWER_F)   { out.push_byte(0x0C as u8); return Result::Ok(()); }  // \f
        if (c == LOWER_N)   { out.push_byte(LF);        return Result::Ok(()); }
        if (c == LOWER_R)   { out.push_byte(CR);        return Result::Ok(()); }
        if (c == LOWER_T)   { out.push_byte(HT);        return Result::Ok(()); }
        if (c == LOWER_U)   { return this.parse_unicode_escape(out); }
        return Result::Err(this.err_at(
            JsonErrorKind::InvalidEscape,
            Str::new("unknown escape")
        ));
    }

    /// Decode `\uXXXX[\uYYYY]?`. The opening `\u` has already been
    /// consumed; we start on the first hex digit. UTF-16 surrogate
    /// pairs are recombined into the corresponding scalar; lone
    /// surrogates produce InvalidUnicode.
    private parse_unicode_escape(mut &this, out: mut &String) -> Result<(), JsonError> {
        const hi: u32 = this.read_hex4()?;
        if (hi >= 0xD800 && hi <= 0xDBFF) {
            // High surrogate; must be followed by `\uYYYY`
            // with YYYY in the low surrogate range.
            if (this.pos + 1 >= this.len ||
                this.src[this.pos] != BACKSLASH ||
                this.src[this.pos + 1] != LOWER_U) {
                return Result::Err(this.err_at(
                    JsonErrorKind::InvalidUnicode,
                    Str::new("lone high surrogate")
                ));
            }
            this.advance();
            this.advance();
            const lo: u32 = this.read_hex4()?;
            if (lo < 0xDC00 || lo > 0xDFFF) {
                return Result::Err(this.err_at(
                    JsonErrorKind::InvalidUnicode,
                    Str::new("invalid low surrogate")
                ));
            }
            const cp: u32 = 0x10000 +
                (((hi - 0xD800) as u32) << 10) +
                ((lo - 0xDC00) as u32);
            out.push_char(cp as char);
            return Result::Ok(());
        }
        if (hi >= 0xDC00 && hi <= 0xDFFF) {
            return Result::Err(this.err_at(
                JsonErrorKind::InvalidUnicode,
                Str::new("lone low surrogate")
            ));
        }
        out.push_char(hi as char);
        return Result::Ok(());
    }

    /// Read exactly four hex digits and assemble them MSB-first.
    private read_hex4(mut &this) -> Result<u32, JsonError> {
        if (this.pos + 4 > this.len) {
            return Result::Err(this.err_at(
                JsonErrorKind::InvalidUnicode,
                Str::new("truncated \\u escape")
            ));
        }
        mut value: u64 = 0;
        mut digits: i64 = 0;
        match (u64::parse_radix_prefix(Slice::from_raw(this.src + this.pos, 4), 16)) {
            option::Option::Some(run) => { value = run.0; digits = run.1; }
            option::Option::None      => { }
        }
        // The error names the first byte that is no hex digit.
        for (mut i: i64 = 0; i < digits; i++) { this.advance(); }
        if (digits < 4) {
            return Result::Err(this.err_at(
                JsonErrorKind::InvalidUnicode,
                Str::new("non-hex digit in \\u escape")
            ));
        }
        return Result::Ok(value as u32);
    }

    // Arrays

    private parse_array(mut &this) -> Result<JsonValue, JsonError> {
        this.depth = this.depth + 1;
        if (this.depth > MAX_DEPTH) {
            return Result::Err(this.err_at(
                JsonErrorKind::DepthExceeded,
                Str::new("nesting too deep")
            ));
        }
        this.advance();   // consume '['
        mut arr: Array<JsonValue> = Array::<JsonValue>::new();
        this.skip_ws();

        // Empty array fast path.
        if (!this.eof() && this.peek() == RBRACK) {
            this.advance();
            this.depth = this.depth - 1;
            return Result::Ok(JsonValue::Array(arr));
        }

        while (true) {
            this.skip_ws();
            const v: JsonValue = this.parse_value()?;
            arr.push(v);
            this.skip_ws();
            if (this.eof()) {
                return Result::Err(this.err_eof());
            }
            const b: u8 = this.peek();
            if (b == COMMA) { this.advance(); continue; }
            if (b == RBRACK) {
                this.advance();
                this.depth = this.depth - 1;
                return Result::Ok(JsonValue::Array(arr));
            }
            return Result::Err(this.err_at(
                JsonErrorKind::UnexpectedChar,
                Str::new("expected ',' or ']'")
            ));
        }
        // Unreachable
        return Result::Ok(JsonValue::Array(arr));
    }

    // Objects

    private parse_object(mut &this) -> Result<JsonValue, JsonError> {
        this.depth = this.depth + 1;
        if (this.depth > MAX_DEPTH) {
            return Result::Err(this.err_at(
                JsonErrorKind::DepthExceeded,
                Str::new("nesting too deep")
            ));
        }
        this.advance();   // consume '{'
        mut obj: JsonObject = JsonObject::new();
        this.skip_ws();

        // Empty object fast path.
        if (!this.eof() && this.peek() == RBRACE) {
            this.advance();
            this.depth = this.depth - 1;
            return Result::Ok(JsonValue::Object(obj));
        }

        while (true) {
            this.skip_ws();
            if (this.eof()) {
                return Result::Err(this.err_eof());
            }
            if (this.peek() != QUOTE) {
                return Result::Err(this.err_at(
                    JsonErrorKind::KeyNotString,
                    Str::new("expected string key")
                ));
            }
            mut key: String = this.parse_string_raw()?;
            this.skip_ws();
            if (this.eof() || this.peek() != COLON) {
                return Result::Err(this.err_at(
                    JsonErrorKind::UnexpectedChar,
                    Str::new("expected ':'")
                ));
            }
            this.advance();
            this.skip_ws();
            const v: JsonValue = this.parse_value()?;
            obj.insert(key, v);
            this.skip_ws();
            if (this.eof()) {
                return Result::Err(this.err_eof());
            }
            const b: u8 = this.peek();
            if (b == COMMA) { this.advance(); continue; }
            if (b == RBRACE) {
                this.advance();
                this.depth = this.depth - 1;
                return Result::Ok(JsonValue::Object(obj));
            }
            return Result::Err(this.err_at(
                JsonErrorKind::UnexpectedChar,
                Str::new("expected ',' or '}'")
            ));
        }
        // Unreachable
        return Result::Ok(JsonValue::Object(obj));
    }
}

// Public entry point

/// Parse a complete JSON document. Returns the parsed value on success,
/// or a `JsonError` pointing at the first byte that failed to parse.
/// Trailing whitespace is allowed; trailing non-whitespace produces
/// `JsonErrorKind::TrailingData`.  Arrays and objects may nest at most
/// 256 deep, counted together; deeper input fails with
/// `JsonErrorKind::DepthExceeded`, so hostile input cannot exhaust the stack.
public function parse(text: Str) -> Result<JsonValue, JsonError> {
    mut p: Parser = Parser::new(text);
    p.skip_ws();
    const v: JsonValue = p.parse_value()?;
    p.skip_ws();
    if (p.pos < p.len) {
        // Drop the parsed tree before erroring: without this the entire value
        // (nested Strings/Arrays/objects + their HashMaps) leaks on every
        // trailing-data input - a remotely-triggerable leak for a server
        // parsing untrusted JSON.
        mut owned: JsonValue = v;
        mem::drop(owned);
        return Result::Err(JsonError::new(
            JsonErrorKind::TrailingData,
            p.line, p.column, p.pos,
            String::from_str(Str::new("trailing data after value"))
        ));
    }
    return Result::Ok(v);
}
