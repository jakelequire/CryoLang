///! json: RFC 8259 JSON parser and serializer.
///!
///! `JsonValue` is a tagged union over the six JSON types. `parse(text)`
///! consumes a `Str` and returns `Result<JsonValue, JsonError>`;
///! `stringify(v)` produces an owned `String` in compact form,
///! `stringify_pretty(v)` indents with two spaces.
///!
///! The parser is strict by RFC 8259: no trailing commas, no unquoted
///! keys, no comments. UTF-8 input is decoded into UTF-8 output; `\uXXXX`
///! escapes are decoded into the corresponding scalar value(s).
///!
///! Integer values up to `i64::MIN..=u64::MAX` round-trip exactly via
///! `JsonNumber::Int` / `JsonNumber::UInt`; values containing a `.` or
///! exponent become `JsonNumber::Float`. The `Number` variant therefore
///! preserves the source kind and lossy float conversion only happens
///! when the caller explicitly asks for `as_f64()`.
///!
///! Sub-modules:
///!   • `error`      - `JsonError`, `JsonErrorKind`
///!   • `value`      - `JsonValue`, `JsonNumber`, `JsonObject`
///!   • `parser`     - `Parser`, `parse(text)`, `MAX_DEPTH`
///!   • `serializer` - `write_value`, `write_pretty`, `stringify`,
///!                    `stringify_pretty`

namespace std::json;

public module json::error;
public module json::value;
public module json::parser;
public module json::serializer;
