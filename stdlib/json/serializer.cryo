///! JSON serializer.
///!
///! Two output shapes: compact (no whitespace) and pretty (2-space
///! indent, newlines between elements). Both write into a caller-owned
///! `String` so multiple values can be concatenated without
///! intermediate allocation.
///!
///! `stringify` and `stringify_pretty` are the convenience entry
///! points that allocate and return a fresh `String`.

namespace std::json::serializer;

import core::option;
import core::result;
import collections::array;
import collections::string;
import collections::str;
import core::primitives;
import fmt::float;
import json::value;

/// Mirrors the parser's nesting cap (`parser::MAX_DEPTH`). A parsed tree can
/// be at most this deep, so round-tripping is never truncated; only a
/// programmatically-built tree deeper than this is bounded here, to prevent
/// unbounded recursion (stack overflow) on adversarial input.
const MAX_DEPTH: u64 = 256;

/// Append a compact serialization of `v` to `out`. No whitespace
/// between tokens.
function write_value(out: mut &String, v: &JsonValue) -> void {
    write_value_inner(out, v, false, 0);
}

/// Append a pretty-printed serialization of `v` to `out`. Two-space
/// indent. Object entries and array elements appear one per line;
/// empty objects / arrays stay on a single line.
function write_pretty(out: mut &String, v: &JsonValue) -> void {
    write_value_inner(out, v, true, 0);
}

/// Allocate a fresh `String` containing the compact serialization.
function stringify(v: &JsonValue) -> String {
    mut out: String = String::new();
    write_value_inner(&out, v, false, 0);
    return out;
}

/// Allocate a fresh `String` containing the pretty serialization.
function stringify_pretty(v: &JsonValue) -> String {
    mut out: String = String::new();
    write_value_inner(&out, v, true, 0);
    return out;
}

// Recursive writer

function write_value_inner(out: mut &String, v: &JsonValue,
                           pretty: boolean, depth: u64) -> void {
    if (depth > MAX_DEPTH) {
        // Over-deep subtree: emit a valid `null` rather than recursing without
        // bound. Unreachable for any value the bundled parser produced (it
        // rejects nesting beyond MAX_DEPTH), so legitimate round-trips are
        // unaffected.
        write_lit(out, "null", 4);
        return;
    }
    match (v) {
        JsonValue::Null      => { write_lit(out, "null", 4); }
        JsonValue::Bool(b)   => {
            if (b) { write_lit(out, "true", 4); }
            else   { write_lit(out, "false", 5); }
        }
        JsonValue::Number(n) => { write_number(out, &n); }
        JsonValue::String(s) => { write_string(out, s.as_str()); }
        JsonValue::Array(arr) => {
            write_array(out, &arr, pretty, depth);
        }
        JsonValue::Object(obj) => {
            write_object(out, &obj, pretty, depth);
        }
    }
}

function write_array(out: mut &String, arr: &Array<JsonValue>,
                     pretty: boolean, depth: u64) -> void {
    if (arr.length() == 0) {
        out.push(91 as u8);   // [
        out.push(93 as u8);   // ]
        return;
    }
    out.push(91 as u8);
    if (pretty) { out.push(10 as u8); }
    mut i: u64 = 0;
    while (i < arr.length()) {
        if (pretty) { write_indent(out, depth + 1); }
        write_value_inner(out, &arr.ptr[i], pretty, depth + 1);
        if (i + 1 < arr.length()) {
            out.push(44 as u8);   // ,
        }
        if (pretty) { out.push(10 as u8); }
        i++;
    }
    if (pretty) { write_indent(out, depth); }
    out.push(93 as u8);
}

function write_object(out: mut &String, obj: &JsonObject,
                      pretty: boolean, depth: u64) -> void {
    if (obj.length() == 0) {
        out.push(123 as u8);  // {
        out.push(125 as u8);  // }
        return;
    }
    out.push(123 as u8);
    if (pretty) { out.push(10 as u8); }
    mut i: u64 = 0;
    while (i < obj.length()) {
        if (pretty) { write_indent(out, depth + 1); }
        match (obj.key_at(i)) {
            Option::Some(k) => { write_string(out, k); }
            Option::None    => { write_string(out, Str::new("")); }
        }
        out.push(58 as u8);   // :
        if (pretty) { out.push(32 as u8); }
        match (obj.value_at(i)) {
            Option::Some(vp) => {
                write_value_inner(out, vp, pretty, depth + 1);
            }
            Option::None => { write_lit(out, "null", 4); }
        }
        if (i + 1 < obj.length()) {
            out.push(44 as u8);
        }
        if (pretty) { out.push(10 as u8); }
        i++;
    }
    if (pretty) { write_indent(out, depth); }
    out.push(125 as u8);
}

function write_indent(out: mut &String, depth: u64) -> void {
    mut n: u64 = 0;
    const total: u64 = depth * 2;
    while (n < total) {
        out.push(32 as u8);   // space
        n++;
    }
}

function write_lit(out: mut &String, lit: string, lit_len: u64) -> void {
    const bytes: u8* = lit as u8*;
    mut i: u64 = 0;
    while (i < lit_len) {
        out.push(bytes[i]);
        i++;
    }
}

// Numbers

function write_number(out: mut &String, n: &JsonNumber) -> void {
    match (n) {
        JsonNumber::Int(v) => {
            mut buf: u8[24];
            const written: u64 = v.to_decimal_buf(&buf[0]);
            mut i: u64 = 0;
            while (i < written) {
                out.push(buf[i]);
                i++;
            }
        }
        JsonNumber::UInt(v) => {
            mut buf: u8[24];
            const written: u64 = v.to_decimal_buf(&buf[0]);
            mut i: u64 = 0;
            while (i < written) {
                out.push(buf[i]);
                i++;
            }
        }
        JsonNumber::Float(v) => {
            // JSON (RFC 8259 §6) has no representation for NaN or
            // infinity. The stdlib float writer formats those as the
            // literal text "NaN" / "inf" / "-inf" (a legitimate choice
            // for debug output) but emitting those bytes into a JSON
            // stream produces a document that no compliant parser will
            // accept. Map every non-finite value to JSON's `null` so
            // round-tripping through external systems stays valid.
            //
            // The finite check is inline: for any finite `v`, `v - v`
            // is `0.0`; for both NaN and ±Inf, `v - v` is NaN, and
            // `NaN == 0.0` is false. One arithmetic op, no imports.
            const finite: boolean = (v - v) == 0.0;
            if (!finite) {
                out.push(110 as u8); // 'n'
                out.push(117 as u8); // 'u'
                out.push(108 as u8); // 'l'
                out.push(108 as u8); // 'l'
            } else {
                // Use the shortest representation that re-parses (via strtod)
                // to the identical f64. The plain `to_buf` form is fixed at 6
                // decimals and SILENTLY TRUNCATES (`3.141592653589793` ->
                // `3.141593`), which broke the round-trip this serializer
                // promises. `to_buf_roundtrip` preserves the exact value while
                // staying compact for typical numbers.
                mut buf: u8[32];
                const written: u64 = v.to_buf_roundtrip(&buf[0]);
                mut i: u64 = 0;
                while (i < written) {
                    out.push(buf[i]);
                    i++;
                }
            }
        }
    }
}

// Strings

const QUOTE_BYTE: u8 = 34;
const BSLASH:     u8 = 92;

/// Write a JSON-escaped string literal: leading quote, escaped
/// content, trailing quote. UTF-8 bytes outside the ASCII control
/// range are passed through; bytes < 0x20 are emitted as `\uXXXX`.
function write_string(out: mut &String, s: Str) -> void {
    out.push(QUOTE_BYTE);
    const len: u64 = s.length();
    const ptr: u8* = s.as_ptr();
    mut i: u64 = 0;
    while (i < len) {
        const b: u8 = ptr[i];
        if (b == QUOTE_BYTE) {
            out.push(BSLASH);
            out.push(QUOTE_BYTE);
        } else if (b == BSLASH) {
            out.push(BSLASH);
            out.push(BSLASH);
        } else if (b == 0x08) {
            out.push(BSLASH); out.push(98 as u8);  // \b
        } else if (b == 0x09) {
            out.push(BSLASH); out.push(116 as u8); // \t
        } else if (b == 0x0A) {
            out.push(BSLASH); out.push(110 as u8); // \n
        } else if (b == 0x0C) {
            out.push(BSLASH); out.push(102 as u8); // \f
        } else if (b == 0x0D) {
            out.push(BSLASH); out.push(114 as u8); // \r
        } else if (b < 0x20) {
            // \u00XX for any other ASCII control character
            out.push(BSLASH);
            out.push(117 as u8);                        // u
            out.push(48 as u8);                         // 0
            out.push(48 as u8);                         // 0
            out.push(hex_nibble((b >> 4) & 0x0F));
            out.push(hex_nibble(b & 0x0F));
        } else {
            out.push(b);
        }
        i++;
    }
    out.push(QUOTE_BYTE);
}

function hex_nibble(n: u8) -> u8 {
    if (n < 10) { return 48 + n; }     // '0'..'9'
    return 87 + n;                       // 'a'..'f'  (97 - 10)
}
