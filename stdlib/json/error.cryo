///! JsonError — the failure kind for `json::parser`.
///!
///! Modeled as `(kind, line, column, offset, msg)`. Callers branch on
///! `kind` for programmatic decisions; `msg` carries human-readable
///! detail for diagnostics.
///!
///! Lines and columns are 1-indexed (matches editor conventions).
///! `offset` is a byte index into the source; useful for translating
///! to a different position model.

namespace std::json::error;

import core::drop;
import collections::string;
import collections::str;

// ============================================================================
// JsonErrorKind
// ============================================================================

/// Closed set of failure kinds the JSON parser produces. New kinds are
/// rare — most failures fold into one of these.
type enum JsonErrorKind {
    /// Reached end of input mid-value.
    UnexpectedEof;
    /// Encountered a byte that does not begin a valid token.
    UnexpectedChar;
    /// A number literal could not be parsed (overflow, malformed
    /// exponent, lone `-`, leading zeros, etc.).
    InvalidNumber;
    /// A `\X` escape inside a string is not one of the recognized
    /// escape sequences.
    InvalidEscape;
    /// A `\uXXXX` sequence is malformed or names an unpaired surrogate.
    InvalidUnicode;
    /// Object/array nesting exceeded `parser::MAX_DEPTH`.
    DepthExceeded;
    /// Garbage after the top-level value.
    TrailingData;
    /// Object key was not a string.
    KeyNotString;
}

implement enum JsonErrorKind {
    /// Short slug for diagnostics. `"unexpected_eof"`, `"invalid_number"`, etc.
    label(&this) -> string {
        return match (this) {
            JsonErrorKind::UnexpectedEof   => { "unexpected_eof"   }
            JsonErrorKind::UnexpectedChar  => { "unexpected_char"  }
            JsonErrorKind::InvalidNumber   => { "invalid_number"   }
            JsonErrorKind::InvalidEscape   => { "invalid_escape"   }
            JsonErrorKind::InvalidUnicode  => { "invalid_unicode"  }
            JsonErrorKind::DepthExceeded   => { "depth_exceeded"   }
            JsonErrorKind::TrailingData    => { "trailing_data"    }
            JsonErrorKind::KeyNotString    => { "key_not_string"   }
        };
    }
}

// ============================================================================
// JsonError
// ============================================================================

type struct JsonError {
    kind:   JsonErrorKind;
    /// 1-indexed line of the offending byte.
    line:   u64;
    /// 1-indexed column of the offending byte.
    column: u64;
    /// 0-indexed byte offset into the source.
    offset: u64;
    /// Human-readable detail. Owned — call `drop` before discarding.
    msg:    String;

    static new(kind: JsonErrorKind, line: u64, column: u64, offset: u64, msg: String) -> JsonError {
        return JsonError {
            kind:   kind,
            line:   line,
            column: column,
            offset: offset,
            msg:    msg,
        };
    }

}

implement trait Drop for struct JsonError {
    drop(mut &this) -> void {
        this.msg.drop();
    }
}
