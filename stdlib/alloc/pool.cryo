///! Pool: O(1) allocator for uniformly-sized slots.
///!
///! A Pool is configured at construction with a single slot layout and
///! refuses a request whose size differs from the slot's or whose
///! alignment is stricter. Freed slots are threaded onto an intrusive free
///! list, making both allocation and deallocation O(1). When the free list
///! is empty, the pool takes a new block from the C library
///! (`libc::aligned_alloc`, with its header from `libc::malloc`) and carves
///! `slots_per_block` fresh slots out of it.
///!
///! Use a Pool when you have many values of the same type with
///! churn-heavy lifetimes (game entities, AST nodes under frequent
///! edit, request objects). For mixed sizes use an Arena or
///! `GlobalAlloc`.

namespace std::alloc::pool;

import std::ffi::libc;
import std::core::mem;
import std::core::ptr::{ NonNull };
import std::core::option::{ Option };
import std::core::result::{ Result };
import std::core::drop::{ Drop };
import std::alloc::layout::{ Layout };
import std::alloc::allocator::{ Allocator, AllocError, AllocErrorKind };
import std::core::intrinsics;

/// Default block size: each block carves this many slots. Chosen to
/// amortize the malloc cost without sitting on a huge unused tail for
/// pools that grow slowly.
public const DEFAULT_SLOTS_PER_BLOCK: u64 = 64;

// FreeNode: intrusive free-list header stored in unused slots

private type struct FreeNode {
    private next: mut FreeNode*;
}

// Block: one contiguous backing allocation

private type struct Block {
    private data: mut u8*;
    private next: mut Block*;
}

/// An allocator of equal-sized slots, each described by the one `Layout`
/// the pool was made with. A freed slot goes onto a free list and is the
/// next one handed out; when the list is empty the pool takes a new block
/// of `slots_per_block` slots from the C library's aligned allocation.
/// Dropping the pool frees every block, invalidating every slot. As an
/// `Allocator` it serves only a layout of the slot's exact size and an
/// alignment no stricter than the slot's (`InvalidLayout` otherwise).
///
/// ```cryo
/// import std::alloc::pool::{ Pool };
/// import std::alloc::layout::{ Layout };
/// import std::core::ptr::{ NonNull };
///
/// mut pool: Pool = Pool::new(Layout::of::<u64>());
/// const slot: NonNull<u8> = pool.allocate_slot().unwrap();
/// pool.deallocate_slot(slot);
/// ```
public type struct Pool {
    private slot: Layout;
    private slots_per_block: u64;
    private free_list: mut FreeNode*;
    private blocks: mut Block*;

    /// Create a pool serving `slot`-sized allocations with the default
    /// block granularity. Panics if `slot.size() < sizeof(FreeNode*)`:
    /// the intrusive free list needs a pointer's worth of room in each
    /// slot.
    public static new(slot: Layout) -> Pool {
        return Pool::with_block_size(slot, DEFAULT_SLOTS_PER_BLOCK);
    }

    /// Create a pool with a custom number of slots per backing block.
    /// Larger blocks reduce malloc frequency at the cost of more unused
    /// tail memory for small pools.
    public static with_block_size(slot: Layout, slots_per_block: u64) -> Pool {
        if (slot.size() < sizeof(FreeNode*)) {
            core::panic("Pool: slot smaller than a pointer; free list cannot be stored", intrinsics::location());
        }
        if (slots_per_block == 0) {
            core::panic("Pool: slots_per_block must be non-zero", intrinsics::location());
        }
        return Pool {
            slot: slot,
            slots_per_block: slots_per_block,
            free_list: null,
            blocks: null
        };
    }

    /// Grab a free slot, carving a new block if the free list is empty.
    /// Returns `Err(OutOfMemory)` if the backing allocator refuses the
    /// block request.
    public allocate_slot(mut &this) -> Result<NonNull<u8>, AllocError> {
        if (this.free_list == null) {
            grow(this)?;
        }
        const node: mut FreeNode* = this.free_list;
        this.free_list = node.next;
        return Result::Ok(NonNull::new(node as mut u8*));
    }

    /// Return a slot to the pool. `ptr` must have come from a previous
    /// `allocate_slot` on **this** pool and must not have been freed.
    public deallocate_slot(mut &this, ptr: NonNull<u8>) -> void {
        const node: mut FreeNode* = ptr.as_ptr() as mut FreeNode*;
        node.next = this.free_list;
        this.free_list = node;
    }

}

// Allocator + Drop

/// Release every backing block. Ownership obligation: callers must
/// invoke `drop` before the pool goes out of scope. All slot pointers
/// are invalidated.
implement trait Drop for struct Pool {
    drop(mut &this) -> void {
        mut block: mut Block* = this.blocks;
        loop {
            if (block == null) { break; }
            const next: mut Block* = block.next;
            // `block.data` came from `aligned_alloc(slot.alignment(), ...)`, so
            // it must be released through the alignment-matched free (Windows
            // over-aligned blocks need `_aligned_free`).  The `Block` header
            // itself is a plain `malloc`.
            libc::aligned_free(block.data, this.slot.alignment());
            libc::free(block as mut void*);
            block = next;
        }
        this.blocks = null;
        this.free_list = null;
    }
}

implement trait Allocator for struct Pool {
    /// Accepts a layout of the slot's exact size and an alignment no
    /// stricter than the slot's. Any other request returns
    /// `Err(InvalidLayout)`.
    allocate(mut &this, block: Layout) -> Result<NonNull<u8>, AllocError> {
        if (block.size() != this.slot.size()
                || block.alignment() > this.slot.alignment()) {
            return Result::Err(AllocError::new(AllocErrorKind::InvalidLayout, block));
        }
        return this.allocate_slot();
    }

    deallocate(mut &this, ptr: NonNull<u8>, block: Layout) -> void {
        this.deallocate_slot(ptr);
    }
}

// Growth

/// Allocate a new backing block and thread its slots onto the free list.
private function grow(pool: mut &Pool) -> Result<(), AllocError> {
    const stride: u64 = pool.slot.padded_size();
    // Guard `stride * slots_per_block` against u64 overflow: a wrapped product
    // would aligned_alloc a too-small block, after which threading
    // `slots_per_block` FreeNodes across `data + i*stride` writes far past the
    // allocation. slots_per_block is caller-supplied (with_block_size), so a
    // pathological value must fail cleanly rather than corrupt the heap.
    const checked_bytes: Option<u64> = stride.checked_multiply(pool.slots_per_block);
    if (checked_bytes.is_none()) {
        return Result::Err(AllocError::new(AllocErrorKind::OutOfMemory, pool.slot));
    }
    const bytes: u64 = checked_bytes.unwrap_or(0);

    const header: mut void* = libc::malloc(sizeof(Block));
    if (header == null) {
        return Result::Err(AllocError::new(AllocErrorKind::OutOfMemory, pool.slot));
    }
    const data: mut u8* = libc::aligned_alloc(pool.slot.alignment(), bytes);
    if (data == null) {
        libc::free(header);
        return Result::Err(AllocError::new(AllocErrorKind::OutOfMemory, pool.slot));
    }

    const block: mut Block* = header as mut Block*;
    block.data = data;
    block.next = pool.blocks;
    pool.blocks = block;

    // Thread the freshly carved slots onto the free list in reverse
    // order, so the first slot handed out is the one at offset 0 (nicer
    // for cache locality and easier to reason about in tests).
    mut i: u64 = pool.slots_per_block;
    loop {
        if (i == 0) { break; }
        i--;
        const slot_addr: u64 = (block.data as u64) + (i * stride);
        const node: mut FreeNode* = slot_addr as mut FreeNode*;
        node.next = pool.free_list;
        pool.free_list = node;
    }
    return Result::Ok(());
}
