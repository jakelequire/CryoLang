///! Box<T, A>: single-owner heap allocation.
///!
///! A `Box<T, A>` owns exactly one heap-allocated value plus the
///! allocator instance that produced it.  Move semantics transfer
///! ownership; the final holder calls `drop`, which runs `T::drop()`
///! and returns the storage through `this.alloc`.
///!
///! `A` defaults to `GlobalAlloc`, so the bare `Box<T>` spelling keeps
///! its meaning across the stdlib.  Callers that want a different
///! allocator use the `*_in` constructors.

namespace std::alloc::box;

import std::core::intrinsics;
import std::core::ptr::{ NonNull };
import std::core::result::{ Result };
import std::core::drop::{ Drop };
import std::core::clone::{ Clone };
import std::core::ops::{ Deref, DerefMutable };
import std::alloc::layout::{ Layout };
import std::alloc::allocator::{ AllocError, Allocator, GlobalAlloc };

public type struct Box<T, A = GlobalAlloc> where A: Allocator {
    // Raw (nullable) so `drop` can null it and stay idempotent: a
    // double drop is a no-op rather than a double free. Non-null for the
    // whole live lifetime; only the post-drop husk holds null.
    private ptr:   T*;
    private alloc: A;

    /// Allocate heap storage via `GlobalAlloc` and move `value` into it.
    /// Panics if the allocator refuses the request; use `try_new` to
    /// recover from out-of-memory.
    public static new(value: T) -> Box<T, GlobalAlloc> {
        match (Box::try_new(value)) {
            Result::Ok(b) => { return b; }
            Result::Err(_) => {
                core::panic("Box::new: allocation failed", intrinsics::location());
            }
        }
    }

    /// Allocate with a caller-supplied allocator.  Panics on allocation
    /// failure; use `try_new_in` for fallible construction.
    public static new_in(value: T, alloc: A) -> Box<T, A> {
        match (Box::try_new_in(value, alloc)) {
            Result::Ok(b) => { return b; }
            Result::Err(_) => {
                core::panic("Box::new_in: allocation failed", intrinsics::location());
            }
        }
    }

    /// Fallible constructor backed by `GlobalAlloc`.  Returns
    /// `Err(AllocError)` if the allocator refuses the request (out of
    /// memory, zero-sized `T`, etc.).
    ///
    /// Inlined rather than dispatched to `try_new_in` because the
    /// bootstrap monomorphizer occasionally produces two arena-distinct
    /// copies of the same `Result<Box<T, GlobalAlloc>, AllocError>` when
    /// a generic `<T>` method calls a generic `<T, A>` method and binds
    /// `A = GlobalAlloc` at the call site (E0200 false positive).
    /// Keeping each non-`_in` static method self-contained sidesteps
    /// the issue without giving up the allocator-generic surface.
    public static try_new(value: T) -> Result<Box<T, GlobalAlloc>, AllocError> {
        mut alloc: GlobalAlloc = GlobalAlloc::new();
        const block: Layout = Layout::of::<T>();
        const raw: NonNull<u8> = alloc.allocate(block)?;
        const typed: NonNull<T> = raw.cast::<T>();
        const typed_ptr: T* = typed.as_ptr();
        *typed_ptr = value;
        return Result::Ok(Box::<T, GlobalAlloc> { ptr: typed_ptr, alloc: alloc });
    }

    /// Fallible constructor with a caller-supplied allocator.  The
    /// allocator instance is stored in the resulting `Box` and is used
    /// to free the storage on drop.
    public static try_new_in(value: T, alloc: A) -> Result<Box<T, A>, AllocError> {
        mut a: A = alloc;
        const block: Layout = Layout::of::<T>();
        const raw: NonNull<u8> = a.allocate(block)?;
        const typed: NonNull<T> = raw.cast::<T>();
        const typed_ptr: T* = typed.as_ptr();
        *typed_ptr = value;
        return Result::Ok(Box::<T, A> { ptr: typed_ptr, alloc: a });
    }

    /// Re-wrap a pointer previously produced by `into_raw` on a
    /// `Box<T, GlobalAlloc>`.  A pointer allocated by any other allocator
    /// yields a `Box` that frees it with the wrong one on drop; re-wrap
    /// such a pointer with `from_raw_in`, passing its allocator.  Panics
    /// on a null pointer.
    public static from_raw(raw: T*) -> Box<T, GlobalAlloc> {
        if (raw == null) {
            core::panic("Box::from_raw called with a null pointer", intrinsics::location());
        }
        return Box::<T, GlobalAlloc> {
            ptr:   raw,
            alloc: GlobalAlloc::new()
        };
    }

    /// Re-wrap a pointer previously produced by `into_raw` on a
    /// `Box<T, A>`, with the allocator that allocated it, which the box
    /// frees it through on drop.  Panics on a null pointer.
    public static from_raw_in(raw: T*, alloc: A) -> Box<T, A> {
        if (raw == null) {
            core::panic("Box::from_raw_in called with a null pointer", intrinsics::location());
        }
        return Box::<T, A> { ptr: raw, alloc: alloc };
    }

    /// Raw pointer to the owned value.  Valid for the lifetime of the
    /// `Box`; dereferencing after `drop` is undefined.
    public as_ptr(&this) -> T* {
        return this.ptr;
    }

    /// Borrow the boxed value. Sound for the lifetime of the `Box`. This
    /// is the ergonomic read/write accessor to prefer over `as_ptr`
    /// until language-level auto-deref lands: `*b.get_ref()` /
    /// `b.get_ref().field`.
    public get_ref(&this) -> T* {
        return this.ptr;
    }

    /// Mutable borrow of the boxed value. A `Box` is a unique owner, so
    /// this is always sound (unlike `Rc`/`Arc`, where mutation must be
    /// gated on uniqueness).
    public get_mut(mut &this) -> T* {
        return this.ptr;
    }

    /// Give up ownership and return the raw pointer.  The caller becomes
    /// responsible for freeing the memory (typically via `Box::from_raw`,
    /// or `Box::from_raw_in` for another allocator); dropping this box
    /// afterwards would double-free.
    ///
    /// Takes `this` by value (consumes the receiver) and destructures
    /// the Box so the move-checker treats it as fully consumed;
    /// auto-drop is suppressed on both caller and callee sides.  The
    /// allocator instance is destructured out and dropped at the end of
    /// this function; for `GlobalAlloc` that's a no-op.
    public into_raw(mut this) -> T* {
        const { ptr, alloc }: Box<T, A> = this;
        return ptr;
    }

}

/// Release the heap storage.  Releases the owned value in place first
/// (`ptr::drop_in_place`: its `Drop` implementation, its fields' glue, or
/// nothing for a `Copy` value), so that any resources held by `T` (heap
/// buffers, file descriptors, etc.) are released before the allocation is returned via
/// `this.alloc.deallocate(...)`.  The allocator instance itself lives in
/// the `Box` struct (caller's stack), not in the heap allocation we're
/// freeing.
///
/// Ownership obligation: every `Box` must have `drop` called exactly
/// once before it goes out of scope.
///
/// Note: `into_raw` transfers ownership of both the value and the
/// allocation to the caller, so T's drop is NOT called for that path.
implement<T, A> trait Drop for struct Box<T, A>
where A: Allocator {
    drop(mut &this) -> void {
        // Idempotent: a second drop of the same Box is a no-op rather
        // than a double free (matches the rest of the stdlib, whose Drop
        // impls all null their pointer). `into_raw` consumes the Box so
        // this path doesn't run after it.
        if (this.ptr == null) { return; }
        ptr::drop_in_place::<T>(this.ptr);
        const block: Layout = Layout::of::<T>();
        this.alloc.deallocate(NonNull::new(this.ptr as u8*), block);
        this.ptr = null;
    }
}

/// Deep copy: allocate a fresh box and clone the owned value into it, so
/// the two boxes own independent heap storage. Requires `T: Clone`.
implement<T> trait Clone for struct Box<T, GlobalAlloc>
where T: Clone {
    clone(&this) -> Box<T> {
        return Box::new((*this.ptr).clone());
    }
}

/// `*b` on a `Box<T>` reads its owned `T`.
implement<T, A> trait Deref for struct Box<T, A> {
    type Target = T;
    deref(&this) -> const T* {
        return this.ptr;
    }
}

/// `*b` written on a `mut` `Box<T>` writes its owned `T`.
implement<T, A> trait DerefMutable for struct Box<T, A> {
    deref_mutable(mut &this) -> T* {
        return this.ptr;
    }
}
