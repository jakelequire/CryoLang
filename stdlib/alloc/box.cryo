///! Box<T> — single-owner heap allocation.
///!
///! A `Box<T>` owns exactly one heap-allocated value. Move semantics
///! transfer ownership; the final holder calls `drop` to release.

namespace std::alloc::box;

import core::intrinsics;
import core::ptr;
import core::result;
import core::drop;
import alloc::layout;
import alloc::allocator;

type struct Box<T> {
    ptr: NonNull<T>;

    /// Allocate heap storage and move `value` into it. Panics if the
    /// allocator refuses the request — use `try_new` to recover from
    /// out-of-memory.
    static new(value: T) -> Box<T> {
        match (Box::try_new(value)) {
            Result::Ok(b) => { return b; }
            Result::Err(_) => {
                intrinsics::panic("Box::new: allocation failed", FILE, LINE);
            }
        }
    }

    /// Fallible constructor. Returns `Err(AllocError)` if the allocator
    /// refuses the request (out of memory, zero-sized `T`, etc.).
    static try_new(value: T) -> Result<Box<T>, AllocError> {
        mut alloc: GlobalAlloc = GlobalAlloc::new();
        const block: Layout = Layout::of<T>();
        match (alloc.allocate(block)) {
            Result::Ok(raw) => {
                const typed: NonNull<T> = raw.cast<T>();
                const typed_ptr: T* = typed.as_ptr();
                *typed_ptr = value;
                return Result::Ok(Box<T> { ptr: typed });
            }
            Result::Err(err) => { return Result::Err(err); }
        }
    }

    /// Re-wrap a pointer previously produced by `into_raw`. The pointer
    /// must have come from `Box::into_raw` (same type, same allocator)
    /// and must not have been freed.
    static from_raw(raw: T*) -> Box<T> {
        return Box<T> { ptr: NonNull::new(raw) };
    }


    /// Raw pointer to the owned value. The pointer is valid for the
    /// lifetime of the `Box`; dereferencing after `drop` is undefined.
    as_ptr(&this) -> T* {
        return this.ptr.as_ptr();
    }

    /// Give up ownership and return the raw pointer. The caller becomes
    /// responsible for freeing the memory (typically via
    /// `Box::from_raw`); dropping this box afterwards would double-free.
    ///
    /// Takes `this` by value (consumes the receiver) and destructures
    /// the Box so the move-checker treats it as fully consumed —
    /// auto-drop is suppressed on both caller and callee sides.
    into_raw(mut this) -> T* {
        const { ptr }: Box<T> = this;
        return ptr.as_ptr();
    }

    /// Bridge alias for `into_raw` — kept so legacy callers reading the
    /// new stdlib can still spell "leak this allocation."  Same behavior:
    /// give up ownership and return the raw pointer.
    leak(mut this) -> T* {
        const { ptr }: Box<T> = this;
        return ptr.as_ptr();
    }

}

/// Release the heap storage. Calls `T::drop()` on the owned value first
/// so that any resources held by `T` (heap buffers, file descriptors, etc.)
/// are released before the allocation is returned to the allocator.
/// Ownership obligation: every `Box` must have `drop` called exactly once
/// before it goes out of scope.
///
/// Note: `into_raw` and `leak` transfer ownership of both the value and
/// the allocation to the caller, so T's drop is NOT called for those paths.
implement<T> trait Drop for struct Box<T>
where T: Drop {
    drop(mut &this) -> void {
        // Drop the owned T in place through the raw pointer before the
        // allocation is freed.  `(*t_ptr).drop()` borrows the T in place
        // so T's drop impl runs on the heap-resident value, not on a copy.
        const t_ptr: T* = this.ptr.as_ptr();
        (*t_ptr).drop();
        // Release the allocation.
        mut alloc: GlobalAlloc = GlobalAlloc::new();
        const block: Layout = Layout::of<T>();
        alloc.deallocate(this.ptr.cast<u8>(), block);
    }
}
