///! alloc: heap allocation primitives.
///!
///! Everything that touches the heap lives here. Types in `alloc/` own
///! storage and expose a manual `drop(mut &this)` method; callers must
///! invoke it to release resources before the value goes out of scope.
///! Every owning type's doc comment identifies who is responsible for
///! that call.
///!
///! `GlobalAlloc` is the default allocator. Collections accept an
///! allocator type parameter (`Array<T, A = GlobalAlloc>`) so the
///! storage strategy is a caller decision, not hard-coded.

namespace std::alloc;

// Core allocator surface.
module {
    alloc::layout;
    alloc::allocator;
}

// Owning containers.
module alloc::box;

// Specialized allocators.  `arena` holds the bump allocator + the
// per-target global-arena hooks (allocator-free, so `allocator` can
// import it); `arena_alloc` carries `Arena`'s `Allocator`/`Drop` trait
// impls (which need `allocator`), kept separate to avoid an import cycle.
// `heap` is the mmap-backed process heap behind `GlobalAlloc`'s
// `[low_level] native_alloc` backend (allocator-free, same one-way-edge
// discipline as `arena`).
module {
    alloc::arena;
    alloc::arena_alloc;
    alloc::pool;
    alloc::heap;
}

// Reference counting.  `Rc<T>` is single-threaded; `Arc<T>` is
// thread-safe (atomic refcount).  Use Rc inside one thread, Arc
// when sharing across threads.
module {
    alloc::rc;
    alloc::arc;
}
