///! Layout: size + alignment of a memory block.
///!
///! Every `Allocator` call takes a `Layout`. Constructing a Layout
///! validates that alignment is a non-zero power of two, so downstream
///! allocators can rely on that invariant without repeating the check.

namespace std::alloc::layout;

import std::core::intrinsics;
import std::core::option;
import std::core::option::{ Option };

type struct Layout {
    size: u64;
    alignment: u64;

    /// Construct from raw size and alignment. Panics if `alignment` is
    /// zero or not a power of two; that's a caller bug, not a runtime
    /// condition to recover from. Size of zero is allowed; the allocator
    /// decides how to treat it.
    static new(size: u64, alignment: u64) -> Layout {
        if (alignment == 0) {
            core::panic("Layout::new: alignment must be non-zero", intrinsics::location());
        }
        if ((alignment & (alignment - 1)) != 0) {
            core::panic("Layout::new: alignment must be a power of two", intrinsics::location());
        }
        return Layout { size: size, alignment: alignment };
    }

    /// Layout of a single value of type `T`.
    static of<T>() -> Layout {
        return Layout { size: sizeof(T), alignment: alignof(T) };
    }

    /// Layout of `count` contiguous values of type `T`. Panics on a
    /// negative `count` and on multiplication overflow; the caller asked
    /// for more bytes than `u64` can describe, which no allocator can
    /// satisfy.
    static array<T>(count: i64) -> Layout {
        match (Layout::try_array::<T>(count)) {
            Option::Some(layout) => { return layout; }
            Option::None => {
                core::panic("Layout::array: negative count or size overflow", intrinsics::location());
            }
        }
    }

    /// Non-panicking `array`: returns `None` on a negative `count` or a
    /// multiplication overflow instead of aborting. Lets `try_*`
    /// constructors surface the failure as `Err` and honor the "`try_`
    /// never panics" contract. Returns `Option` (not
    /// `Result<_, AllocError>`) to keep this module free of an
    /// `alloc::layout` <-> `alloc::allocator` import cycle; the caller maps
    /// `None` to its own error type.
    static try_array<T>(count: i64) -> Option<Layout> {
        if (count < 0) {
            return Option::None;
        }
        const elem_size: u64 = sizeof(T);
        const elements: u64 = count as u64;
        const total: u64 = elem_size * elements;
        if (elements != 0 && total / elements != elem_size) {
            return Option::None;
        }
        return Option::Some(Layout { size: total, alignment: alignof(T) });
    }

    size(&this) -> u64 {
        return this.size;
    }

    alignment(&this) -> u64 {
        return this.alignment;
    }

    /// `size` rounded up to the next multiple of `alignment`. The stride
    /// to use when packing adjacent values of this layout in memory.
    padded_size(&this) -> u64 {
        const mask: u64 = this.alignment - 1;
        return (this.size + mask) & ~mask;
    }
}
