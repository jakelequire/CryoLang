///! Allocator: the trait every heap strategy implements.
///!
///! `GlobalAlloc` is the default implementation. Its memory operations are
///! delegated to the `backend_*` functions below — libc
///! (`aligned_alloc`/`aligned_free`/`realloc`) by default, or the
///! mmap-backed `alloc::heap` under the temporary `[low_level]
///! native_alloc` migration switch (Low-Level Plan Stage 3). An arena or
///! pool can plug in anywhere an `Allocator` is expected.
///!
///! Collections accept `A: Allocator` as a type parameter so the
///! storage strategy is a caller decision, not hard-coded in the
///! collection.

namespace std::alloc::allocator;

import core::intrinsics;
import ffi::libc;
import core::ptr;
import core::result;
import alloc::layout;
import collections::str;
// One-way edge: `arena` is allocator-free (its `Allocator`/`Drop` impls
// live in `arena_alloc`), so importing it here forms no cycle.  Brings the
// per-target global-arena routing hooks into scope; `GlobalAlloc` consults
// them so the compiler's whole `T[]`/`HashMap`/`Box`/`String` heap can be
// arena-backed and bulk-reclaimed between targets.  Null/inactive in every
// other program -> the branches below are never taken.
import alloc::arena;
// Same one-way-edge shape as `arena`: `heap` is allocator-free (raw
// `void*`/`u64` surface), so importing it here forms no cycle.  Supplies the
// `native_alloc` backend arms below.
import alloc::heap;

type enum AllocErrorKind {
    /// The underlying allocator returned null; the system is out of
    /// memory or hit an address-space limit.
    OutOfMemory;
    /// The allocator refuses zero-sized requests. Callers that want a
    /// non-null dangling pointer for a zero-sized type should handle
    /// the zero case themselves before calling `allocate`.
    ZeroSized;
    /// A bounded allocator (arena, pool) has no room for this request.
    Exhausted;
    /// The requested layout is incompatible with this allocator (e.g.,
    /// the size or alignment doesn't match a Pool's fixed slot). The
    /// caller passed the wrong allocator for the requested layout.
    InvalidLayout;
}

type struct AllocError {
    kind: AllocErrorKind;
    layout: Layout;

    static new(kind: AllocErrorKind, layout: Layout) -> AllocError {
        return AllocError { kind: kind, layout: layout };
    }

    /// A short, stable description of what went wrong, as a borrowed `Str`.
    /// The convergent accessor every stdlib error type exposes
    /// (`describe(&this) -> Str`); `Display`/`Debug` for `AllocError` delegate
    /// to it. The requested `layout` remains available as a field. Borrows a
    /// static string literal, so the view outlives any `AllocError`.
    describe(&this) -> Str {
        return match (this.kind) {
            AllocErrorKind::OutOfMemory   => { Str::new("out of memory") }
            AllocErrorKind::ZeroSized     => { Str::new("zero-sized allocation request") }
            AllocErrorKind::Exhausted     => { Str::new("allocator exhausted") }
            AllocErrorKind::InvalidLayout => { Str::new("layout incompatible with allocator") }
        };
    }
}

type trait Allocator {
    /// Return a pointer to at least `layout.size` bytes aligned to
    /// `layout.alignment`. The returned memory is uninitialized; the
    /// caller writes to it before any read.
    allocate(mut &this, layout: Layout) -> Result<NonNull<u8>, AllocError>;

    /// Return memory to the allocator. `ptr` must have come from a
    /// previous `allocate` on **this** allocator with a matching
    /// `layout`. Using the pointer after this call is undefined.
    deallocate(mut &this, ptr: NonNull<u8>, layout: Layout) -> void;

    /// Default implementation: allocate fresh memory, copy, free old.
    /// Allocators that can grow a block in place (real `realloc`)
    /// should override for the win.
    reallocate(mut &this,
               ptr: NonNull<u8>,
               old_layout: Layout,
               new_layout: Layout) -> Result<NonNull<u8>, AllocError> {
        const new_ptr: NonNull<u8> = this.allocate(new_layout)?;
        mut copy_size: u64 = old_layout.size();
        if (new_layout.size() < copy_size) {
            copy_size = new_layout.size();
        }
        intrinsics::memcpy(new_ptr.as_ptr(), ptr.as_ptr(), copy_size);
        this.deallocate(ptr, old_layout);
        return Result::Ok(new_ptr);
    }
}

// Alignment `realloc` is guaranteed to honor: `max_align_t`, which is 16
// bytes on every platform Cryo targets.  Anything stricter must be served by
// an explicit aligned alloc + copy, never plain `realloc`.
const MAX_REALLOC_ALIGN: u64 = 16;

/// Geometric growth-size for a contiguous buffer that must hold at least
/// `required` slots.  Doubles `current` (seeded by `min_capacity` so
/// empty-to-nonempty transitions don't start at a single slot) until it
/// reaches `required`.  Once doubling would overflow `u64` the curve has hit
/// its ceiling: return exactly `required` (already known to fit) rather than
/// wrapping to 0 and looping forever.  Shared by `Array::reserve_grow` and
/// `RawBuffer::reserve`, whose storage *layouts* differ (ABI-load-bearing)
/// but whose growth *curve* is identical.
function next_capacity(current: u64, required: u64, min_capacity: u64) -> u64 {
    const U64_MAX: u64 = (0 as u64) - (1 as u64);
    mut new_cap: u64 = current;
    if (new_cap < min_capacity) {
        new_cap = min_capacity;
    }
    while (new_cap < required) {
        if (new_cap > U64_MAX / 2) {
            return required;
        }
        new_cap = new_cap * 2;
    }
    return new_cap;
}

// Platform backend
//
// `GlobalAlloc`'s trait methods keep the policy (zero-size rejection, arena
// routing) and delegate the actual memory operations to these three
// config-gated functions.  Default: libc.  Under the temporary `[low_level]
// native_alloc` migration switch: the mmap-backed `alloc::heap`
// (Low-Level Plan Stage 3; the switch and the libc arms are deleted once
// the native heap is proven).  All three return null for "out of memory".

![config(not(native_alloc))]
function backend_alloc(layout: Layout) -> void* {
    return libc::aligned_alloc(layout.alignment(), layout.padded_size());
}

![config(native_alloc)]
function backend_alloc(layout: Layout) -> void* {
    return heap::alloc(layout.size(), layout.alignment());
}

![config(not(native_alloc))]
function backend_free(ptr: void*, layout: Layout) -> void {
    // Pair with `backend_alloc`'s `aligned_alloc`: over-aligned blocks
    // (Windows `_aligned_malloc`) need `_aligned_free`, selected by the
    // layout's alignment.  On POSIX this collapses to plain `free`.
    libc::aligned_free(ptr, layout.alignment());
}

![config(native_alloc)]
function backend_free(ptr: void*, layout: Layout) -> void {
    // The native heap recovers the block size from the pointer itself
    // (segment-header mask), so the layout carries no information it needs.
    heap::free(ptr);
}

![config(not(native_alloc))]
function backend_realloc(ptr: void*, old_layout: Layout,
                         new_layout: Layout) -> void* {
    // `realloc` only guarantees alignment up to `max_align_t`
    // (MAX_REALLOC_ALIGN = 16).  Any over-aligned type - a
    // `![align(32)]`/`![align(64)]` aggregate or a SIMD vector - must go
    // through allocate/copy/free even when its alignment is UNCHANGED on
    // grow; otherwise realloc may return a merely-16-aligned buffer and
    // every subsequent aligned load/store is UB.
    if (new_layout.alignment() > MAX_REALLOC_ALIGN) {
        const np: void* = backend_alloc(new_layout);
        if (np == null) { return null; }
        mut copy_size: u64 = old_layout.size();
        if (new_layout.size() < copy_size) {
            copy_size = new_layout.size();
        }
        intrinsics::memcpy(np, ptr, copy_size);
        backend_free(ptr, old_layout);
        return np;
    }
    return libc::realloc(ptr, new_layout.padded_size());
}

![config(native_alloc)]
function backend_realloc(ptr: void*, old_layout: Layout,
                         new_layout: Layout) -> void* {
    // The native heap handles over-alignment and in-place growth itself.
    return heap::realloc(ptr, old_layout.size(),
                                     new_layout.size(),
                                     new_layout.alignment());
}

// GlobalAlloc: the process-wide allocator

/// Zero-sized handle to the process-wide allocator. Construct with
/// `GlobalAlloc::new()`; all instances dispatch through the same
/// underlying backend.
type struct GlobalAlloc {
    static new() -> GlobalAlloc {
        return GlobalAlloc { };
    }
}

implement trait Allocator for struct GlobalAlloc {
    allocate(mut &this, layout: Layout) -> Result<NonNull<u8>, AllocError> {
        if (layout.size() == 0) {
            return Result::Err(AllocError::new(AllocErrorKind::ZeroSized, layout));
        }
        // Per-target arena routing.  Active only inside the compiler driver's
        // bracket (global null/inactive everywhere else -> branch not taken).
        if (GlobalArena::routing()) {
            const ap: void* = GlobalArena::take(layout.size(), layout.alignment());
            if (ap != null) {
                return Result::Ok(NonNull::new(ap as u8*));
            }
            return Result::Err(AllocError::new(AllocErrorKind::OutOfMemory, layout));
        }
        const raw: void* = backend_alloc(layout);
        if (raw == null) {
            return Result::Err(AllocError::new(AllocErrorKind::OutOfMemory, layout));
        }
        return Result::Ok(NonNull::new(raw as u8*));
    }

    deallocate(mut &this, ptr: NonNull<u8>, layout: Layout) -> void {
        // Arena-owned blocks are bulk-reclaimed at `reset`; never hand them
        // to the backend.  Consulted regardless of the active flag (the
        // central correctness rule: an arena pointer must not reach `free`).
        if (GlobalArena::holds(ptr.as_ptr() as void*)) {
            return;
        }
        backend_free(ptr.as_ptr() as void*, layout);
    }

    /// Override the default: both backends have a real `realloc` (libc's, or
    /// the native heap's same-class/in-place path) and we'd be silly not to
    /// use it.
    reallocate(mut &this,
               ptr: NonNull<u8>,
               old_layout: Layout,
               new_layout: Layout) -> Result<NonNull<u8>, AllocError> {
        if (new_layout.size() == 0) {
            return Result::Err(AllocError::new(AllocErrorKind::ZeroSized, new_layout));
        }
        // Arena-owned blocks grow inside the arena (frontier grow-in-place or
        // alloc-new + copy); never hand them to the backend.  Consulted
        // regardless of the active flag, same correctness rule as `deallocate`.
        if (GlobalArena::holds(ptr.as_ptr() as void*)) {
            const np: void* = GlobalArena::grow(
                ptr.as_ptr() as void*,
                old_layout.size(),
                new_layout.size(),
                new_layout.alignment());
            if (np != null) {
                return Result::Ok(NonNull::new(np as u8*));
            }
            return Result::Err(AllocError::new(AllocErrorKind::OutOfMemory, new_layout));
        }
        const raw: void* = backend_realloc(ptr.as_ptr() as void*,
                                           old_layout, new_layout);
        if (raw == null) {
            return Result::Err(AllocError::new(AllocErrorKind::OutOfMemory, new_layout));
        }
        return Result::Ok(NonNull::new(raw as u8*));
    }
}

// `new` / `delete` codegen lowering allocates through THIS pair rather than a
// parallel routing path: both delegate to the canonical `GlobalAlloc`, so a
// `new T()` shares the exact arena routing as every `T[]`/`Box`/`String`
// (the active per-target arena while the compiler builds itself, libc
// otherwise).  They add no allocation logic of their own - they only bridge
// codegen's raw `call`/`void*` world to the typed `Allocator` API.

/// Allocate `size` bytes aligned to `align` via `GlobalAlloc`.  Null/zero
/// guarded; returns null on OOM so the emitter's existing null-check on the
/// old `malloc` result is unchanged.
public function alloc(size: u64, align: u64) -> void* {
    mut sz: u64 = size;
    if (sz == 0) { sz = 1; }
    mut al: u64 = align;
    if (al == 0) { al = 16; }
    mut ga: GlobalAlloc = GlobalAlloc::new();
    const r: Result<NonNull<u8>, AllocError> = ga.allocate(Layout::new(sz, al));
    if (r.is_ok()) { return r.unwrap().as_ptr() as void*; }
    return null;
}

/// Free a block from `alloc` via `GlobalAlloc::deallocate`, which
/// already no-ops arena-owned pointers (bulk-reclaimed at the target
/// boundary) and frees libc-owned ones.  `align` must match the `new` site;
/// `deallocate` ignores the layout size, so a 1-byte placeholder is fine.
public function free(ptr: void*, align: u64) -> void {
    if (ptr == null) { return; }
    mut al: u64 = align;
    if (al == 0) { al = 16; }
    mut ga: GlobalAlloc = GlobalAlloc::new();
    ga.deallocate(NonNull::new(ptr as u8*), Layout::new(1u64, al));
}
