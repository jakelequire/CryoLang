///! Prelude: auto-imported into every Cryo source file.
///!
///! The prelude is deliberately small. Every name here competes for user
///! attention; adding to the prelude has a cost.
///!
///! `collections::array` is included not because users name `Array<T>` often,
///! but because the language desugars `[T]` to `Array<T>`. Without the
///! template loaded, the desugaring silently no-ops and `arr.push(x)` fails
///! at codegen with `no method 'push' found on type '[N]'`.

namespace std::prelude;

module {
    core::panic;
    core::option;
    core::result;
    core::primitives;
    core::common;
}
// `core::panic` holds `panic`, `assert`, `unreachable` and `todo`;
// `core::common` re-exports `Error` alone, which a program's own error type
// implements. `ErrorReport` and `BoxedError` are imported (`import
// std::core::{ ErrorReport };`). `std::core`
// itself (`core::_module`) is NOT here: its facade re-exports core's types
// from their own modules, and a name two prelude modules offer binds in
// neither, so `Option` would name nothing bare; the prelude takes core's
// modules one by one instead.
// `core::intrinsics` is NOT here: its functions are exported, and a prelude
// module's exports are bound bare in every file - `panic` would then name
// both the intrinsic and `core::panic`'s function.  An intrinsic is reached
// by path, `intrinsics::f`, after `import std::core::intrinsics;`.
// `VariadicArguments` is the compiler-assigned type of a function's `args...` bucket, so
// it must resolve in every module without an explicit import.
module {
    core::variadic_arguments;
    collections::array;
}
// The text types: `String` (owned), `Str` (a borrowed view) and `Utf8Error`
// (what `from_utf8` refuses with) are named by nearly every program that
// touches text.
module {
    collections::string;
    collections::str;
}
// `core::slice` is in the prelude so the compiler's for-in lowering can
// synthesize `Slice::from_raw(...)` for fixed-size array scrutinees
// (`for (x in arr) {}` where `arr: [T; N]`) without forcing every user
// file to write `import core::slice;`.
module core::slice;
// `core::ops` (`Range` / `RangeInclusive`) and `core::iter` (`Iterator`)
// back the for-in sugar: a range literal `a..b` desugars to `Range::new`,
// and the loop drives the scrutinee through `Iterator::next`. Both must
// resolve without an explicit import so `for (i in 0..5) {}` - the form
// shown in the docs and README - compiles out of the box.
module {
    core::ops;
    core::iter;
}
// An `implement trait Drop for X` head names the trait without importing it
// throughout the tree, and the same holds for the marker traits, `Eq`, and
// `Clone`. An impl head that cannot resolve its own trait name cannot say
// WHICH declaration it implements - dispatch by leaf answers only while that
// leaf is unique program-wide, which is not a property any program guarantees.
// These are also the traits the compiler itself reasons about by identity, so
// their spelling has to reach one declaration rather than whichever registered
// last.
module {
    core::drop;
    core::marker;
    core::cmp;
    core::clone;
}
// `alloc::box` and `alloc::rc` make `Box<T>` / `Rc<T>` visible without
// per-file imports; both are canonical owning smart pointers.
module {
    alloc::box;
    alloc::rc;
}
