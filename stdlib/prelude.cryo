///! Prelude: auto-imported into every Cryo source file.
///!
///! The prelude is deliberately small. Every name here competes for user
///! attention; adding to the prelude has a cost.
///!
///! `collections::array` is included not because users name `Array<T>` often,
///! but because the language desugars `T[]` to `Array<T>`. Without the
///! template loaded, the desugaring silently no-ops and `arr.push(x)` fails
///! at codegen with `no method 'push' found on type 'N[]'`.

namespace std::prelude;

public module core::_module;
public module core::option;
public module core::result;
public module core::primitives;
public module core::intrinsics;
// `VaArgs` is the compiler-assigned type of a function's `args...` bucket, so
// it must resolve in every module without an explicit import.
public module core::varargs;
public module collections::array;
// `core::slice` is in the prelude so the compiler's for-in lowering can
// synthesize `Slice::from_raw(...)` for fixed-size array scrutinees
// (`for (x in arr) {}` where `arr: T[N]`) without forcing every user
// file to write `import core::slice;`.
public module core::slice;
// `core::ops` (`Range` / `RangeInclusive`) and `core::iter` (`Iterator`)
// back the for-in sugar: a range literal `a..b` desugars to `Range::new`,
// and the loop drives the scrutinee through `Iterator::next`. Both must
// resolve without an explicit import so `for (i in 0..5) {}` - the form
// shown in the docs and README - compiles out of the box.
public module core::ops;
public module core::iter;
// `alloc::box` and `alloc::rc` make `Box<T>` / `Rc<T>` visible without
// per-file imports; both are canonical owning smart pointers.
public module alloc::box;
public module alloc::rc;