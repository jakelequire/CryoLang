///! Option — a value that may be absent.
///!
///! `Option<T>` replaces nullable pointers. The compiler forces callers to
///! handle the absent case before reaching the value.

namespace std::core::option;

import core::intrinsics;
import core::clone;
import core::cmp;
import core::result;

type enum Option<T> {
    Some(T);
    None;
}

implement enum Option<T> {
    is_some(&this) -> boolean {
        match (&this) {
            Option::Some(_) => { return true; }
            Option::None => { return false; }
        }
    }

    is_none(&this) -> boolean {
        match (&this) {
            Option::Some(_) => { return false; }
            Option::None => { return true; }
        }
    }

    /// Return the inner value, aborting on `None`. Prefer `unwrap_or` or
    /// a `match` in code that must not panic.
    unwrap(&this) -> T {
        match (&this) {
            Option::Some(value) => { return value; }
            Option::None => {
                intrinsics::panic("called Option::unwrap() on a None value", FILE, LINE);
            }
        }
    }

    /// Like `unwrap`, but with a caller-supplied message describing the
    /// invariant the caller believed held.
    expect(&this, message: string) -> T {
        match (&this) {
            Option::Some(value) => { return value; }
            Option::None => {
                intrinsics::panic(message, FILE, LINE);
            }
        }
    }

    unwrap_or(&this, default_value: T) -> T {
        match (&this) {
            Option::Some(value) => { return value; }
            Option::None => { return default_value; }
        }
    }

    /// Use this when the default is expensive and shouldn't be computed
    /// in the `Some` case.
    unwrap_or_else(&this, default_fn: () -> T) -> T {
        match (&this) {
            Option::Some(value) => { return value; }
            Option::None => { return default_fn(); }
        }
    }

    map<U>(&this, f: (T) -> U) -> Option<U> {
        match (&this) {
            Option::Some(value) => { return Option::Some(f(value)); }
            Option::None => { return Option::None; }
        }
    }

    /// Monadic bind — chain operations each of which may be absent.
    and_then<U>(&this, f: (T) -> Option<U>) -> Option<U> {
        match (&this) {
            Option::Some(value) => { return f(value); }
            Option::None => { return Option::None; }
        }
    }

    or_else(&this, f: () -> Option<T>) -> Option<T> {
        match (&this) {
            Option::Some(_) => { return this; }
            Option::None => { return f(); }
        }
    }

    /// Replace with `None` and return the previous value.
    take(mut &this) -> Option<T> {
        const previous: Option<T> = *this;
        *this = Option::None;
        return previous;
    }

    /// `Some(v)` -> `Ok(v)`; `None` -> `Err(err)`.
    ok_or<E>(&this, err: E) -> Result<T, E> {
        match (&this) {
            Option::Some(value) => { return Result::Ok(value); }
            Option::None => { return Result::Err(err); }
        }
    }

    ok_or_else<E>(&this, err_fn: () -> E) -> Result<T, E> {
        match (&this) {
            Option::Some(value) => { return Result::Ok(value); }
            Option::None => { return Result::Err(err_fn()); }
        }
    }

    /// True iff the option is `Some(x)` where `x.equals(&value)`.
    contains(&this, value: &T) -> boolean where T: Eq {
        match (&this) {
            Option::Some(inner) => { return inner.equals(value); }
            Option::None => { return false; }
        }
    }
}

// ============================================================================
// Trait impls
// ============================================================================

implement<T> trait Clone for enum Option<T>
where T: Clone {
    clone(&this) -> Option<T> {
        match (&this) {
            Option::Some(value) => { return Option::Some(value.clone()); }
            Option::None => { return Option::None; }
        }
    }
}

implement<T> trait Eq for enum Option<T>
where T: Eq {
    equals(&this, other: &Option<T>) -> boolean {
        match (&this) {
            Option::Some(a) => {
                match (other) {
                    Option::Some(b) => { return a.equals(b); }
                    Option::None => { return false; }
                }
            }
            Option::None => {
                match (other) {
                    Option::Some(_) => { return false; }
                    Option::None => { return true; }
                }
            }
        }
    }
}
