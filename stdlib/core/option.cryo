///! Option: a value that may be absent.
///!
///! `Option<T>` replaces nullable pointers. The compiler forces callers to
///! handle the absent case before reaching the value.

namespace std::core::option;

import std::core::intrinsics;
import std::core::clone;
import std::core::cmp;
import std::core::result;

type enum Option<T> {
    Some(T);
    None;
}

implement enum Option<T> {
    is_some(&this) -> boolean {
        match (&this) {
            Option::Some(_) => { return true; }
            Option::None => { return false; }
        }
    }

    is_none(&this) -> boolean {
        match (&this) {
            Option::Some(_) => { return false; }
            Option::None => { return true; }
        }
    }

    /// Borrow the contained value in place: `Some(v)` -> `Some(&v)`,
    /// `None` -> `None`. The pointer aliases the receiver's payload (no
    /// copy is made), so unlike the consuming accessors this is NOT
    /// `![sink]` - the receiver stays live and keeps ownership of `T`.
    /// The pointer is valid only while the receiver outlives it and is
    /// invalidated by anything that moves or overwrites the receiver.
    ///
    /// `as_ref` returns `Option<T*>`, a structurally larger `Option` than
    /// the receiver, so the compiler instantiates it lazily at call sites
    /// (a parameterless method that returns a superterm of its owner would
    /// otherwise monomorphize `Option<T>` -> `Option<T*>` -> ... forever).
    as_ref(&this) -> Option<T*> {
        match (&this) {
            Option::Some(value) => { return Option::Some(&value); }
            Option::None => { return Option::None; }
        }
    }

    /// Borrow the contained value in place, aborting on `None`. Like `as_ref`
    /// the pointer aliases the receiver's payload rather than copying it, so
    /// the receiver keeps ownership of `T` and this is NOT `![sink]`; the
    /// pointer is invalidated by anything that moves or overwrites the
    /// receiver.
    ///
    /// Returns a bare `T*` where `as_ref` returns `Option<T*>`. Beyond being
    /// less to unwrap, that keeps it usable where `as_ref` is not: `Option<T*>`
    /// is a structural superterm of the owner, so `as_ref` is materialized
    /// lazily at a call site and is absent from an `Option` whose payload type
    /// is synthesized rather than written. A pointer return is not a superterm.
    unwrap_ptr(&this) -> T* {
        match (&this) {
            Option::Some(value) => { return &value; }
            Option::None => {
                core::panic("called Option::unwrap_ptr() on a None value", FILE, LINE);
            }
        }
    }

    /// Return the inner value, aborting on `None`. Prefer `unwrap_or` or
    /// a `match` in code that must not panic.
    ///
    /// `![sink]`: the match-arm binding copies the payload out of
    /// the receiver, so the receiver must be treated as moved at the call
    /// site - otherwise both the returned value and the still-live receiver
    /// would be dropped, double-freeing an owning `T` (`String`, `Box`, ...).
    ![sink]
    unwrap(&this) -> T {
        match (&this) {
            Option::Some(value) => { return value; }
            Option::None => {
                core::panic("called Option::unwrap() on a None value", FILE, LINE);
            }
        }
    }

    /// Like `unwrap`, but with a caller-supplied message describing the
    /// invariant the caller believed held.
    ![sink]
    expect(&this, message: string) -> T {
        match (&this) {
            Option::Some(value) => { return value; }
            Option::None => {
                core::panic(message, FILE, LINE);
            }
        }
    }

    ![sink]
    unwrap_or(&this, default_value: T) -> T {
        match (&this) {
            Option::Some(value) => { return value; }
            Option::None => { return default_value; }
        }
    }

    /// Use this when the default is expensive and shouldn't be computed
    /// in the `Some` case.
    ![sink]
    unwrap_or_else(&this, default_fn: () -> T) -> T {
        match (&this) {
            Option::Some(value) => { return value; }
            Option::None => { return default_fn(); }
        }
    }

    ![sink]
    map<U>(&this, f: (T) -> U) -> Option<U> {
        match (&this) {
            Option::Some(value) => { return Option::Some(f(value)); }
            Option::None => { return Option::None; }
        }
    }

    /// Monadic bind: chain operations each of which may be absent.
    ![sink]
    and_then<U>(&this, f: (T) -> Option<U>) -> Option<U> {
        match (&this) {
            Option::Some(value) => { return f(value); }
            Option::None => { return Option::None; }
        }
    }

    ![sink]
    or_else(&this, f: () -> Option<T>) -> Option<T> {
        match (&this) {
            Option::Some(_) => { return this; }
            Option::None => { return f(); }
        }
    }

    /// Replace with `None` and return the previous value.
    take(mut &this) -> Option<T> {
        // A destructive read, not a copy: the `None` store leaves nothing here
        // for the receiver to release, so the returned value is the sole owner
        // of whatever the payload held. Without that store the read alone would
        // hand out a second claim on it.
        unsafe {
            const previous: Option<T> = *this;
            *this = Option::None;
            return previous;
        }
    }

    /// `Some(v)` -> `Ok(v)`; `None` -> `Err(err)`.
    ![sink]
    ok_or<E>(&this, err: E) -> Result<T, E> {
        match (&this) {
            Option::Some(value) => { return Result::Ok(value); }
            Option::None => { return Result::Err(err); }
        }
    }

    ![sink]
    ok_or_else<E>(&this, err_fn: () -> E) -> Result<T, E> {
        match (&this) {
            Option::Some(value) => { return Result::Ok(value); }
            Option::None => { return Result::Err(err_fn()); }
        }
    }

    /// True if the option is `Some(x)` where `x.equals(&value)`.
    contains(&this, value: &T) -> boolean where T: Eq {
        match (&this) {
            Option::Some(inner) => { return inner.equals(value); }
            Option::None => { return false; }
        }
    }
}

implement<T> trait Clone for enum Option<T>
where T: Clone {
    clone(&this) -> Option<T> {
        match (&this) {
            Option::Some(value) => { return Option::Some(value.clone()); }
            Option::None => { return Option::None; }
        }
    }
}

implement<T> trait Eq for enum Option<T>
where T: Eq {
    equals(&this, other: &Option<T>) -> boolean {
        match (&this) {
            Option::Some(a) => {
                match (other) {
                    Option::Some(b) => { return a.equals(b); }
                    Option::None => { return false; }
                }
            }
            Option::None => {
                match (other) {
                    Option::Some(_) => { return false; }
                    Option::None => { return true; }
                }
            }
        }
    }
}
