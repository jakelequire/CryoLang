///! Option: a value that may be absent.
///!
///! `Option<T>` replaces nullable pointers. The compiler forces callers to
///! handle the absent case before reaching the value.

namespace std::core::option;

import std::core::intrinsics;
import std::core::clone::{ Clone };
import std::core::cmp::{ Eq };
import std::core::default::{ Default };
import std::core::mem;
import std::core::result::{ Result };
import std::collections::pair::{ Pair };
import std::core::ops::{ ControlFlow, FromResidual, Try };
import std::fmt::display::{ Debug };

/// A value of type `T` that may be absent: `Some(value)` or `None`.
///
/// Match on it to reach the value, or use the accessors below:
///
/// ```cryo
/// import std::core::option::{ Option };
///
/// function half(n: i32) -> Option<i32> {
///     if (n % 2 != 0) { return Option::None; }
///     return Option::Some(n / 2);
/// }
///
/// match (half(10)) {
///     Option::Some(h) => { println(f"half is {h}"); }
///     Option::None    => { println("odd"); }
/// }
/// ```
![language("option")]
public type enum Option<T> with [Eq, Clone, Debug] {
    Some(T);
    None;
}

implement enum Option<T> {
    /// True when the option holds a value.
    public is_some(&this) -> boolean {
        match (&this) {
            Option::Some(_) => { return true; }
            Option::None => { return false; }
        }
    }

    /// True when the option holds no value.
    public is_none(&this) -> boolean {
        match (&this) {
            Option::Some(_) => { return false; }
            Option::None => { return true; }
        }
    }

    /// Borrow the contained value in place, read-only: `Some(v)` ->
    /// `Some(&v)`, `None` -> `None`. The pointer aliases the receiver's
    /// payload (no copy is made), so unlike the consuming accessors this is
    /// NOT `![sink]` - the receiver stays live and keeps ownership of `T`.
    /// The pointer is valid only while the receiver outlives it and is
    /// invalidated by anything that moves or overwrites the receiver.
    /// `as_mutable_ref` is the writable form.
    ///
    /// `as_ref` returns `Option<const T*>`, a structurally larger `Option`
    /// than the receiver, so the compiler instantiates it lazily at call
    /// sites (a parameterless method that returns a superterm of its owner
    /// would otherwise monomorphize `Option<T>` -> `Option<const T*>` -> ...
    /// forever).
    public as_ref(&this) -> Option<const T*> {
        match (&this) {
            Option::Some(value) => { return Option::Some(&value); }
            Option::None => { return Option::None; }
        }
    }

    /// Borrow the contained value in place, writable: `Some(v)` ->
    /// `Some(&v)`, `None` -> `None`. A write through the pointer changes the
    /// receiver's payload. Lazily instantiated for the same reason as
    /// `as_ref`.
    public as_mutable_ref(mut &this) -> Option<mut T*> {
        match (&this) {
            Option::Some(value) => { return Option::Some(&value); }
            Option::None => { return Option::None; }
        }
    }

    /// Borrow the contained value in place, aborting on `None`. Like `as_ref`
    /// the pointer aliases the receiver's payload rather than copying it, so
    /// the receiver keeps ownership of `T` and this is NOT `![sink]`; the
    /// pointer is invalidated by anything that moves or overwrites the
    /// receiver.
    ///
    /// Returns a bare `T*` where `as_mutable_ref` returns `Option<T*>`. Beyond
    /// being less to unwrap, that keeps it usable where `as_mutable_ref` is
    /// not: `Option<T*>` is a structural superterm of the owner, so
    /// `as_mutable_ref` is materialized
    /// lazily at a call site and is absent from an `Option` whose payload type
    /// is synthesized rather than written. A pointer return is not a superterm.
    ![language("option_unwrap_pointer")]
    public unwrap_ptr(mut &this) -> mut T* {
        match (&this) {
            Option::Some(value) => { return &value; }
            Option::None => {
                core::panic("called Option::unwrap_ptr() on a None value", intrinsics::location());
            }
        }
    }

    /// Return the inner value, aborting on `None`. Prefer `unwrap_or` or
    /// a `match` in code that must not panic.
    ///
    /// `![sink]`: the match-arm binding copies the payload out of
    /// the receiver, so the receiver must be treated as moved at the call
    /// site - otherwise both the returned value and the still-live receiver
    /// would be dropped, double-freeing an owning `T` (`String`, `Box`, ...).
    ![sink]
    ![language("option_unwrap")]
    public unwrap(&this) -> T {
        match (&this) {
            Option::Some(value) => { return value; }
            Option::None => {
                core::panic("called Option::unwrap() on a None value", intrinsics::location());
            }
        }
    }

    /// Like `unwrap`, but with a caller-supplied message describing the
    /// invariant the caller believed held.
    ![sink]
    public expect(&this, message: string) -> T {
        match (&this) {
            Option::Some(value) => { return value; }
            Option::None => {
                core::panic(message, intrinsics::location());
            }
        }
    }

    /// The value, or `default_value` when the option is `None`. Consumes
    /// the option; `default_value` is evaluated whether it is used or not
    /// (see `unwrap_or_else` to compute it only when needed).
    ![sink]
    public unwrap_or(&this, default_value: T) -> T {
        match (&this) {
            Option::Some(value) => { return value; }
            Option::None => { return default_value; }
        }
    }

    /// Use this when the default is expensive and shouldn't be computed
    /// in the `Some` case.
    ![sink]
    public unwrap_or_else<F>(&this, default_fn: F) -> T where F: () -> T {
        match (&this) {
            Option::Some(value) => { return value; }
            Option::None => { return default_fn(); }
        }
    }

    /// `Some(f(value))`, or `None` when the option is `None` (`f` is not
    /// called). Consumes the option.
    ///
    /// ```cryo
    /// const wide: Option<i64> = half(10).map((h: i32) -> i64 { return h as i64; });
    /// ```
    ![sink]
    public map<U, F>(&this, f: F) -> Option<U> where F: (T) -> U {
        match (&this) {
            Option::Some(value) => { return Option::Some(f(value)); }
            Option::None => { return Option::None; }
        }
    }

    /// Monadic bind: chain operations each of which may be absent.
    ![sink]
    public and_then<U, F>(&this, f: F) -> Option<U> where F: (T) -> Option<U> {
        match (&this) {
            Option::Some(value) => { return f(value); }
            Option::None => { return Option::None; }
        }
    }

    /// This option when it is `Some`; otherwise the option `f` returns.
    /// `f` is called only for `None`. Consumes the option.
    ![sink]
    public or_else<F>(&this, f: F) -> Option<T> where F: () -> Option<T> {
        match (&this) {
            Option::Some(_) => { return this; }
            Option::None => { return f(); }
        }
    }

    /// Replace with `None` and return the previous value.
    ![language("option_take")]
    public take(mut &this) -> Option<T> {
        // A destructive read, not a copy: the `None` store leaves nothing here
        // for the receiver to release, so the returned value is the sole owner
        // of whatever the payload held. Without that store the read alone would
        // hand out a second claim on it.
        unsafe {
            const previous: Option<T> = *this;
            *this = Option::None;
            return previous;
        }
    }

    /// Replace with `Some(value)` and return the previous value, `None`
    /// when there was none.  The returned value is the sole owner of what
    /// the option held, as `take`'s is; releasing it releases the value
    /// displaced.
    ![language("option_replace")]
    public replace(mut &this, value: T) -> Option<T> {
        unsafe {
            const previous: Option<T> = *this;
            *this = Option::Some(value);
            return previous;
        }
    }

    /// `Some(v)` -> `Ok(v)`; `None` -> `Err(err)`.
    ![sink]
    public ok_or<E>(&this, err: E) -> Result<T, E> {
        match (&this) {
            Option::Some(value) => { return Result::Ok(value); }
            Option::None => { return Result::Err(err); }
        }
    }

    /// `Ok(value)` for `Some(value)`; for `None`, `Err` holding the error
    /// `err_fn` returns. `err_fn` is called only for `None`. Consumes the
    /// option. Turns a missing value into an error `?` can return:
    ///
    /// ```cryo
    /// const h: i32 = half(n).ok_or_else(() -> Str { return Str::new("an odd number"); })?;
    /// ```
    ![sink]
    public ok_or_else<E, F>(&this, err_fn: F) -> Result<T, E> where F: () -> E {
        match (&this) {
            Option::Some(value) => { return Result::Ok(value); }
            Option::None => { return Result::Err(err_fn()); }
        }
    }

    /// True if the option is `Some(x)` where `x.equals(&value)`.
    public contains(&this, value: &T) -> boolean where T: Eq {
        match (&this) {
            Option::Some(inner) => { return inner.equals(value); }
            Option::None => { return false; }
        }
    }

    /// True when the option is `Some` and the predicate holds for the value.
    /// The value is lent to the predicate; the option keeps it.
    public is_some_and<P>(&this, predicate: P) -> boolean where P: (&T) -> boolean {
        match (&this) {
            Option::Some(value) => { return predicate(&value); }
            Option::None => { return false; }
        }
    }

    /// True when the option is `None`, or `Some` with a value the predicate
    /// holds for.
    public is_none_or<P>(&this, predicate: P) -> boolean where P: (&T) -> boolean {
        match (&this) {
            Option::Some(value) => { return predicate(&value); }
            Option::None => { return true; }
        }
    }

    /// The option itself when it is `Some` and the predicate holds for the
    /// value; `None` otherwise, releasing a refused value.
    ![sink]
    public filter<P>(&this, predicate: P) -> Option<T> where P: (&T) -> boolean {
        match (&this) {
            Option::Some(value) => {
                if (predicate(&value)) {
                    return Option::Some(value);
                }
                mem::drop(value);
                return Option::None;
            }
            Option::None => { return Option::None; }
        }
    }

    /// The function applied to the value, or `default_value` for `None`.
    ![sink]
    public map_or<U, F>(&this, default_value: U, f: F) -> U where F: (T) -> U {
        match (&this) {
            Option::Some(value) => { return f(value); }
            Option::None => { return default_value; }
        }
    }

    /// The function applied to the value, or `default_function`'s result for
    /// `None`; the default is computed only when it is needed.
    ![sink]
    public map_or_else<U, D, F>(&this, default_function: D, f: F) -> U where D: () -> U, F: (T) -> U {
        match (&this) {
            Option::Some(value) => { return f(value); }
            Option::None => { return default_function(); }
        }
    }

    /// `other` when this option is `Some`, `None` otherwise. This option's
    /// value is released either way.
    ![sink]
    public and<U>(&this, other: Option<U>) -> Option<U> {
        match (&this) {
            Option::Some(value) => {
                mem::drop(value);
                return other;
            }
            Option::None => { return Option::None; }
        }
    }

    /// This option when it is `Some`, `other` otherwise.
    ![sink]
    public or(&this, other: Option<T>) -> Option<T> {
        match (&this) {
            Option::Some(value) => { return Option::Some(value); }
            Option::None => { return other; }
        }
    }

    /// The one of the two options that is `Some`, when exactly one is;
    /// `None` when both or neither are, releasing both values.
    ![sink]
    public xor(&this, other: Option<T>) -> Option<T> {
        match (&this) {
            Option::Some(value) => {
                if (other.is_none()) {
                    return Option::Some(value);
                }
                mem::drop(value);
                return Option::None;
            }
            Option::None => { return other; }
        }
    }

    /// Both values as a `Pair` when both options are `Some`; `None`
    /// otherwise, releasing whichever value there was.
    ![sink]
    public zip<U>(&this, other: Option<U>) -> Option<Pair<T, U>> {
        match (&this) {
            Option::Some(value) => {
                match (other) {
                    Option::Some(other_value) => { return Option::Some(Pair::new(value, other_value)); }
                    Option::None => {
                        mem::drop(value);
                        return Option::None;
                    }
                }
            }
            Option::None => { return Option::None; }
        }
    }

    /// The value, or `T::default()` for `None`.
    ![sink]
    public unwrap_or_default(&this) -> T where T: Default {
        match (&this) {
            Option::Some(value) => { return value; }
            Option::None => { return T::default(); }
        }
    }

    /// Lend the value to `f` when there is one, then give the option back
    /// unchanged.
    ![sink]
    public inspect<F>(&this, f: F) -> Option<T> where F: (&T) -> void {
        match (&this) {
            Option::Some(value) => { f(&value); }
            Option::None => { }
        }
        return this;
    }
}

implement<T> enum Option<Option<T>> {
    /// The option a `Some` holds, or `None`: `Some(Some(4))` flattens to
    /// `Some(4)`, and `Some(None)` and `None` both to `None`. Consumes the
    /// option.
    ![sink]
    public flatten(&this) -> Option<T> {
        match (&this) {
            Option::Some(inner) => { return inner; }
            Option::None => { return Option::None; }
        }
    }
}

/// `?` on an `Option` goes on with the `Some` value and stops with `None`,
/// as an `Option<()>`.
implement<T> trait Try for enum Option<T> {
    type Output = T;
    type Residual = Option<()>;

    static from_output(output: T) -> Option<T> {
        return Option::Some(output);
    }

    branch(this) -> ControlFlow<Option<()>, T> {
        match (this) {
            Option::Some(value) => { return ControlFlow::Continue(value); }
            Option::None => { return ControlFlow::Break(Option::None); }
        }
    }
}

/// A function returning `Option<T>` returns `None` for the `None` a `?`
/// stopped with.
implement<T> trait FromResidual<Option<()>> for enum Option<T> {
    static from_residual(_residual: Option<()>) -> Option<T> {
        return Option::None;
    }
}
