///! Panic and assertions.
///!
///! Panic is the response to a broken invariant: a bug the program cannot
///! meaningfully recover from. Errors the caller is expected to handle go
///! through `Result`, not here.

namespace std::core::panic;

import core::intrinsics;

/// Abort the program with `message` and the source location. `file` and
/// `line` should be the compiler-provided `FILE` and `LINE`; the helpers
/// below do that automatically.
function panic(message: string, file: string, line: u32) -> void {
    intrinsics::panic(message, file, line);
}

/// Panic if `condition` is false. Always checked.
function assert(condition: boolean, message: string) -> void {
    if (!condition) {
        panic(message, FILE, LINE as u32);
    }
}

/// Mark a code path the programmer believes cannot be reached. If it ever
/// is, the program aborts with a clear message rather than executing
/// wrong code.
function unreachable() -> void {
    panic("entered unreachable code", FILE, LINE as u32);
}

/// Stub a function you'll implement later. Reading better than inlining
/// `panic("not yet implemented", FILE, LINE)` is its whole job.
function todo() -> void {
    panic("not yet implemented", FILE, LINE as u32);
}
