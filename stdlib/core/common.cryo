///! The core names the prelude binds one by one, from modules it does not
///! list whole.
///!
///! A prelude module binds every name it offers bare in every file, so a
///! module is listed in the prelude only when all of its names belong
///! there. `std::core::error` offers `ErrorReport` and `BoxedError` beside
///! `Error`, and only `Error` is a prelude name: this module re-exports it,
///! and the prelude lists this module.

namespace std::core::common;

export std::core::error::{ Error };
