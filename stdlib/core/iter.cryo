///! Iterator: a lazy sequence.
///!
///! `Iterator<Item>` has one required method: `next`. Every other method
///! is derived from it. Implementations drive the sequence; consumers
///! call `next` in a loop or use one of the defaults below.
///!
///! Lazy adapters live in this module: `map`, `filter`, `take`, `chain`,
///! `enumerate`, and `zip` each return a wrapper iterator (`MapIter`,
///! `FilterIter`, `TakeIter`, `ChainIter`, `EnumerateIter`, `ZipIter`) that
///! is itself an `Iterator`, so they compose. Eager consumers (`for_each`,
///! `fold`, `any`, `all`, `find`, `count`) and `for (x in iter)` drive the
///! chain. (One current limitation: re-adapting an opaque-typed iterator
///! *local* — `let it = ...; it.map(..)` — is restricted; chain directly off
///! the source. See `docs/cryo.md` §2.11.)

namespace std::core::iter;

import core::option;
import core::clone;
import collections::pair;

type trait Iterator<Item> {
    /// Advance the sequence and return the next value, or `None` when
    /// exhausted. Calling `next` again after `None` may return `None`
    /// forever or may panic; implementations should document which.
    next(mut &this) -> Option<Item>;

    /// Number of remaining elements. The default walks the iterator to
    /// count, consuming it. Implementations with O(1) knowledge of
    /// their length should override.
    count(mut &this) -> u64 {
        mut n: u64 = 0;
        loop {
            match (this.next()) {
                Option::Some(_) => { n++; }
                Option::None => { break; }
            }
        }
        return n;
    }

    /// Reduce the sequence to a single value. `initial` is the starting
    /// accumulator; `f` folds each element into it.
    fold<Acc>(mut &this, initial: Acc, f: (Acc, Item) -> Acc) -> Acc {
        mut acc: Acc = initial;
        loop {
            match (this.next()) {
                Option::Some(value) => { acc = f(acc, value); }
                Option::None => { break; }
            }
        }
        return acc;
    }

    /// Call `f` on each element, discarding the results. The natural
    /// way to consume an iterator purely for its side effects.
    for_each(mut &this, f: (Item) -> void) -> void {
        loop {
            match (this.next()) {
                Option::Some(value) => { f(value); }
                Option::None => { break; }
            }
        }
    }

    /// Yield at most the first `n` elements, then stop.
    take(this, n: u64) -> TakeIter<This> {
        return TakeIter::new(this, n);
    }

    /// Transform each element with `f`, yielding the results. `f` must be a
    /// non-capturing function (a plain `fn` or a non-capturing lambda).
    map<B>(this, f: (Item) -> B) -> MapIter<This, Item, B> {
        return MapIter::new(this, f);
    }

    /// Yield only the elements for which `pred` returns `true`. `pred` must be
    /// a non-capturing function.
    filter(this, pred: (Item) -> boolean) -> FilterIter<This, Item> {
        return FilterIter::new(this, pred);
    }

    /// Yield every element of `this`, then every element of `other`.  `other`
    /// must be an `Iterator` with the same `Item` type - the shared element
    /// type is enforced by `ChainIter`'s impl bounds.
    chain<J>(this, other: J) -> ChainIter<This, J> {
        return ChainIter::new(this, other);
    }

    /// Yield `(index, value)` pairs, the index counting up from 0 as a
    /// `u64`.  The pair is `Pair<u64, Item>`: `p.first` is the index,
    /// `p.second` the element.  (Cryo has no heterogeneous tuple literal,
    /// so `Pair` is the element type.)
    enumerate(this) -> EnumerateIter<This, Item> {
        return EnumerateIter::new(this);
    }

    /// Yield pairs `(a, b)` drawing `a` from `this` and `b` from `other`,
    /// stopping as soon as either iterator is exhausted.  The pair is
    /// `Pair<Item, B>` where `B` is `other`'s element type: `p.first` comes
    /// from `this`, `p.second` from `other`.  (Cryo has no heterogeneous
    /// tuple literal, so `Pair` is the element type.)
    zip<J>(this, other: J) -> ZipIter<This, J> {
        return ZipIter::new(this, other);
    }


    /// True if `pred` holds for at least one element. Short-circuits on
    /// the first match; consumes elements up to it.
    any(mut &this, pred: (Item) -> boolean) -> boolean {
        loop {
            match (this.next()) {
                Option::Some(value) => { if (pred(value)) { return true; } }
                Option::None => { return false; }
            }
        }
    }

    /// True if `pred` holds for every element. Short-circuits on the
    /// first failure; vacuously true for an empty iterator.
    all(mut &this, pred: (Item) -> boolean) -> boolean {
        loop {
            match (this.next()) {
                Option::Some(value) => { if (!pred(value)) { return false; } }
                Option::None => { return true; }
            }
        }
    }

    /// The first element for which `pred` holds, or `None`. Consumes
    /// elements up to and including the match.
    find(mut &this, pred: (Item) -> boolean) -> Option<Item> {
        loop {
            match (this.next()) {
                Option::Some(value) => {
                    if (pred(value)) { return Option::Some(value); }
                }
                Option::None => { return Option::None; }
            }
        }
    }
}

/// Adapter yielding at most `remaining` elements from `inner`.
type struct TakeIter<I> {
    inner: I;
    remaining: u64;

    static new(inner: I, n: u64) -> TakeIter<I> {
        return TakeIter<I> { inner: inner, remaining: n };
    }
}

implement<I, A> trait Iterator<A> for struct TakeIter<I>
where I: Iterator<A> {
    next(mut &this) -> Option<A> {
        if (this.remaining == 0) {
            return Option::None;
        }
        this.remaining = this.remaining - 1;
        return this.inner.next();
    }
}

/// Adapter applying `f` to each element of `inner`.  `A` is the inner
/// iterator's element type; `O` is the mapped result (Output) type.  Both
/// appear in the stored function's type, so they are struct parameters rather
/// than where-clause-only generics.
///
/// The result-type param is named `O`, NOT `B`, on purpose: the `map<B>`
/// trait default returns `MapIter<This, Item, B>`, so a struct param named
/// `B` would collide with the default's own generic `B`.  When `map` is
/// applied to a `MapIter` receiver (`r.map(f).map(g)`), the impl-spec
/// substituter rewrites every `B` in the inherited default - including its
/// own generic - to the receiver's concrete element, leaving `map`'s `B`
/// unbindable.  A distinct name keeps the default's generic independent of
/// the adapter's parameters.
type struct MapIter<I, A, O> {
    inner: I;
    f:     (A) -> O;

    static new(inner: I, f: (A) -> O) -> MapIter<I, A, O> {
        return MapIter<I, A, O> { inner: inner, f: f };
    }
}

implement<I, A, O> trait Iterator<O> for struct MapIter<I, A, O>
where I: Iterator<A> {
    next(mut &this) -> Option<O> {
        return match (this.inner.next()) {
            Option::Some(value) => { Option::Some(this.f(value)) }
            Option::None        => { Option::None }
        };
    }
}

/// Adapter yielding only the elements of `inner` for which `pred` holds.
type struct FilterIter<I, A> {
    inner: I;
    pred:  (A) -> boolean;

    static new(inner: I, pred: (A) -> boolean) -> FilterIter<I, A> {
        return FilterIter<I, A> { inner: inner, pred: pred };
    }
}

implement<I, A> trait Iterator<A> for struct FilterIter<I, A>
where I: Iterator<A> {
    next(mut &this) -> Option<A> {
        loop {
            match (this.inner.next()) {
                Option::Some(value) => {
                    if (this.pred(value)) {
                        return Option::Some(value);
                    }
                }
                Option::None => { return Option::None; }
            }
        }
    }
}

/// Adapter concatenating two iterators of the same element type: it drains
/// `first`, then `second`.  Both inner element types are pinned to the shared
/// `A` by the `where`-bounds.
type struct ChainIter<I, J> {
    first:      I;
    second:     J;
    first_done: boolean;

    static new(first: I, second: J) -> ChainIter<I, J> {
        return ChainIter<I, J> { first: first, second: second, first_done: false };
    }
}

implement<I, J, A> trait Iterator<A> for struct ChainIter<I, J>
where I: Iterator<A>, J: Iterator<A> {
    next(mut &this) -> Option<A> {
        if (!this.first_done) {
            match (this.first.next()) {
                Option::Some(value) => { return Option::Some(value); }
                Option::None        => { this.first_done = true; }
            }
        }
        return this.second.next();
    }
}

/// Adapter pairing each element of `inner` with its 0-based index.  The
/// element type `A` is carried as a struct parameter (not a where-clause-only
/// generic) so the `next` body's `Pair<u64, A>` literal substitutes through
/// the normal struct-param path.  `A` is also pinned to `inner`'s element by
/// the `where`-bound, which keeps the impl honest.
type struct EnumerateIter<I, A> {
    inner: I;
    index: u64;

    static new(inner: I) -> EnumerateIter<I, A> {
        return EnumerateIter<I, A> { inner: inner, index: 0 };
    }
}

implement<I, A> trait Iterator<Pair<u64, A>> for struct EnumerateIter<I, A>
where I: Iterator<A> {
    next(mut &this) -> Option<Pair<u64, A>> {
        match (this.inner.next()) {
            Option::Some(value) => {
                const i: u64 = this.index;
                this.index = this.index + 1;
                return Option::Some(Pair<u64, A> { first: i, second: value });
            }
            Option::None => { return Option::None; }
        }
    }
}

/// Adapter pairing two iterators positionally, yielding `Pair<A, O>` until
/// either side runs out.  Chain-shaped: the element types `A` (from `I`) and
/// `O` (from `J`) live only in the impl `where`-bounds, not as struct
/// parameters, so the receiver type only mentions the two inner iterators.
type struct ZipIter<I, J> {
    first:  I;
    second: J;

    static new(first: I, second: J) -> ZipIter<I, J> {
        return ZipIter<I, J> { first: first, second: second };
    }
}

implement<I, J, A, O> trait Iterator<Pair<A, O>> for struct ZipIter<I, J>
where I: Iterator<A>, J: Iterator<O> {
    next(mut &this) -> Option<Pair<A, O>> {
        match (this.first.next()) {
            Option::Some(a) => {
                match (this.second.next()) {
                    Option::Some(b) => {
                        return Option::Some(Pair<A, O> { first: a, second: b });
                    }
                    Option::None => { return Option::None; }
                }
            }
            Option::None => { return Option::None; }
        }
    }
}

// CopiedIter / ClonedIter — the by-reference -> by-value bridge adapters —
// live with the `RefIter` cursor they bridge, in
// `std::collections::array`, where they are `private`. They are the only
// users of that pattern; keeping them out of this module lets them stay
// unnameable outside `collections::array`.


