///! Iterator: a lazy sequence.
///!
///! `Iterator<Item>` has one required method: `next`. Every other method
///! is derived from it. Implementations drive the sequence; consumers
///! call `next` in a loop or use one of the defaults below.
///!
///! Adapters (`Map<I, F>`, `Filter<I, P>`, `Take<I>`, ...) are not
///! included in this module. Writing `loop { match iter.next() { ... } }`
///! or using `for_each` covers the common cases directly.

namespace std::core::iter;

import core::option;
import core::clone;

type trait Iterator<Item> {
    /// Advance the sequence and return the next value, or `None` when
    /// exhausted. Calling `next` again after `None` may return `None`
    /// forever or may panic; implementations should document which.
    next(mut &this) -> Option<Item>;

    /// Number of remaining elements. The default walks the iterator to
    /// count, consuming it. Implementations with O(1) knowledge of
    /// their length should override.
    count(mut &this) -> u64 {
        mut n: u64 = 0;
        loop {
            match (this.next()) {
                Option::Some(_) => { n++; }
                Option::None => { break; }
            }
        }
        return n;
    }

    /// Reduce the sequence to a single value. `initial` is the starting
    /// accumulator; `f` folds each element into it.
    fold<Acc>(mut &this, initial: Acc, f: (Acc, Item) -> Acc) -> Acc {
        mut acc: Acc = initial;
        loop {
            match (this.next()) {
                Option::Some(value) => { acc = f(acc, value); }
                Option::None => { break; }
            }
        }
        return acc;
    }

    /// Call `f` on each element, discarding the results. The natural
    /// way to consume an iterator purely for its side effects.
    for_each(mut &this, f: (Item) -> void) -> void {
        loop {
            match (this.next()) {
                Option::Some(value) => { f(value); }
                Option::None => { break; }
            }
        }
    }

    /// Yield at most the first `n` elements, then stop.
    take(this, n: u64) -> TakeIter<This> {
        return TakeIter::new(this, n);
    }

    /// Transform each element with `f`, yielding the results. `f` must be a
    /// non-capturing function (a plain `fn` or a non-capturing lambda).
    map<B>(this, f: (Item) -> B) -> MapIter<This, Item, B> {
        return MapIter::new(this, f);
    }

    /// Yield only the elements for which `pred` returns `true`. `pred` must be
    /// a non-capturing function.
    filter(this, pred: (Item) -> boolean) -> FilterIter<This, Item> {
        return FilterIter::new(this, pred);
    }


    /// True iff `pred` holds for at least one element. Short-circuits on
    /// the first match; consumes elements up to it.
    any(mut &this, pred: (Item) -> boolean) -> boolean {
        loop {
            match (this.next()) {
                Option::Some(value) => { if (pred(value)) { return true; } }
                Option::None => { return false; }
            }
        }
    }

    /// True iff `pred` holds for every element. Short-circuits on the
    /// first failure; vacuously true for an empty iterator.
    all(mut &this, pred: (Item) -> boolean) -> boolean {
        loop {
            match (this.next()) {
                Option::Some(value) => { if (!pred(value)) { return false; } }
                Option::None => { return true; }
            }
        }
    }

    /// The first element for which `pred` holds, or `None`. Consumes
    /// elements up to and including the match.
    find(mut &this, pred: (Item) -> boolean) -> Option<Item> {
        loop {
            match (this.next()) {
                Option::Some(value) => {
                    if (pred(value)) { return Option::Some(value); }
                }
                Option::None => { return Option::None; }
            }
        }
    }
}

/// Adapter yielding at most `remaining` elements from `inner`.
type struct TakeIter<I> {
    inner: I;
    remaining: u64;

    static new(inner: I, n: u64) -> TakeIter<I> {
        return TakeIter<I> { inner: inner, remaining: n };
    }
}

implement<I, A> trait Iterator<A> for struct TakeIter<I>
where I: Iterator<A> {
    next(mut &this) -> Option<A> {
        if (this.remaining == 0) {
            return Option::None;
        }
        this.remaining = this.remaining - 1;
        return this.inner.next();
    }
}

/// Adapter applying `f` to each element of `inner`.  `A` is the inner
/// iterator's element type; `B` is the mapped result type.  Both appear in
/// the stored function's type, so they are struct parameters rather than
/// where-clause-only generics.
type struct MapIter<I, A, B> {
    inner: I;
    f:     (A) -> B;

    static new(inner: I, f: (A) -> B) -> MapIter<I, A, B> {
        return MapIter<I, A, B> { inner: inner, f: f };
    }
}

implement<I, A, B> trait Iterator<B> for struct MapIter<I, A, B>
where I: Iterator<A> {
    next(mut &this) -> Option<B> {
        return match (this.inner.next()) {
            Option::Some(value) => { Option::Some(this.f(value)) }
            Option::None        => { Option::None }
        };
    }
}

/// Adapter yielding only the elements of `inner` for which `pred` holds.
type struct FilterIter<I, A> {
    inner: I;
    pred:  (A) -> boolean;

    static new(inner: I, pred: (A) -> boolean) -> FilterIter<I, A> {
        return FilterIter<I, A> { inner: inner, pred: pred };
    }
}

implement<I, A> trait Iterator<A> for struct FilterIter<I, A>
where I: Iterator<A> {
    next(mut &this) -> Option<A> {
        loop {
            match (this.inner.next()) {
                Option::Some(value) => {
                    if (this.pred(value)) {
                        return Option::Some(value);
                    }
                }
                Option::None => { return Option::None; }
            }
        }
    }
}

/// Adapter dereferencing each `T*` yielded by `inner` into a `T` by
/// bitwise copy. Bridges a by-reference cursor (`Array::iter_ref`) to
/// the by-value consumers, so an owning collection needs no separate
/// by-value iterator struct.
///
/// The element type `T` is recovered from the inner iterator via the
/// `where I: Iterator<T*>` bound — the monomorphizer peels the `T*` in
/// the bound against the concrete `I`'s element type (see
/// `derive_impl_where_generics` / `bind_where_arg_param`). So `T` is NOT
/// a struct parameter: `CopiedIter::new(arr.iter_ref())` is fully
/// inferred.
///
/// Constructed via `::new` rather than a fluent `.copied()` on
/// `Iterator`: a trait *default method* returning this adapter still
/// crashes the bootstrap compiler (it checks the adapter's
/// pointer-element bound in the abstract trait context, where `Self`'s
/// element isn't a pointer). Revisit the fluent form once the pin gains
/// associated-type-equality bounds (`where Item == T*`).
///
/// Sound only when `T: Copy` — the bound lives on this `Iterator` impl,
/// so a non-`Copy` pointee fails to resolve `next` (use `ClonedIter`).
type struct CopiedIter<I> {
    inner: I;

    static new(inner: I) -> CopiedIter<I> {
        return CopiedIter<I> { inner: inner };
    }
}

implement<I, T> trait Iterator<T> for struct CopiedIter<I>
where I: Iterator<T*>, T: Copy {
    next(mut &this) -> Option<T> {
        return match (this.inner.next()) {
            Option::Some(p) => { Option::Some(*p) }
            Option::None    => { Option::None }
        };
    }
}

/// Adapter cloning each `T*` yielded by `inner` into an owned `T` via
/// `Clone`. The owning-type counterpart of `CopiedIter`: this is what
/// lets a `loop`/`for` over `strings.iter_ref()` walk an `Array<String>`
/// by value (each element an independent clone) — something the
/// `Copy`-gated `iter()` can't express. Same `T`-inference and
/// explicit-construction rationale as `CopiedIter`.
type struct ClonedIter<I> {
    inner: I;

    static new(inner: I) -> ClonedIter<I> {
        return ClonedIter<I> { inner: inner };
    }
}

implement<I, T> trait Iterator<T> for struct ClonedIter<I>
where I: Iterator<T*>, T: Clone {
    next(mut &this) -> Option<T> {
        return match (this.inner.next()) {
            Option::Some(p) => { Option::Some((*p).clone()) }
            Option::None    => { Option::None }
        };
    }
}


