///! Iterator: a lazy sequence.
///!
///! `Iterator<Item>` has one required method: `next`. Every other method
///! is derived from it. Implementations drive the sequence; consumers
///! call `next` in a loop or use one of the defaults below.
///!
///! Adapters (`Map<I, F>`, `Filter<I, P>`, `Take<I>`, ...) are not
///! included in this module. Writing `loop { match iter.next() { ... } }`
///! or using `for_each` covers the common cases directly.

namespace std::core::iter;

import core::option;

type trait Iterator<Item> {
    /// Advance the sequence and return the next value, or `None` when
    /// exhausted. Calling `next` again after `None` may return `None`
    /// forever or may panic; implementations should document which.
    next(mut &this) -> Option<Item>;

    /// Number of remaining elements. The default walks the iterator to
    /// count, consuming it. Implementations with O(1) knowledge of
    /// their length should override.
    count(mut &this) -> u64 {
        mut n: u64 = 0;
        loop {
            match (this.next()) {
                Option::Some(_) => { n++; }
                Option::None => { break; }
            }
        }
        return n;
    }

    /// Reduce the sequence to a single value. `initial` is the starting
    /// accumulator; `f` folds each element into it.
    fold<Acc>(mut &this, initial: Acc, f: (Acc, Item) -> Acc) -> Acc {
        mut acc: Acc = initial;
        loop {
            match (this.next()) {
                Option::Some(value) => { acc = f(acc, value); }
                Option::None => { break; }
            }
        }
        return acc;
    }

    /// Call `f` on each element, discarding the results. The natural
    /// way to consume an iterator purely for its side effects.
    for_each(mut &this, f: (Item) -> void) -> void {
        loop {
            match (this.next()) {
                Option::Some(value) => { f(value); }
                Option::None => { break; }
            }
        }
    }

    /// Yield at most the first `n` elements, then stop.
    take(this, n: u64) -> TakeIter<This> {
        return TakeIter::new(this, n);
    }
}

/// Adapter yielding at most `remaining` elements from `inner`.
type struct TakeIter<I> {
    inner: I;
    remaining: u64;

    static new(inner: I, n: u64) -> TakeIter<I> {
        return TakeIter<I> { inner: inner, remaining: n };
    }
}

implement<I, A> trait Iterator<A> for struct TakeIter<I>
where I: Iterator<A> {
    next(mut &this) -> Option<A> {
        if (this.remaining == 0) {
            return Option::None;
        }
        this.remaining = this.remaining - 1;
        return this.inner.next();
    }
}
