///! Iterator: a lazy sequence.
///!
///! `Iterator<Item>` has one required method: `next`. Every other method
///! is derived from it. Implementations drive the sequence; consumers
///! call `next` in a loop or use one of the defaults below.
///!
///! Lazy adapters live in this module: `map`, `filter`, `take`, `skip`,
///! `chain`, `enumerate`, `zip`, `rev` and `flat_map` each return
///! `implement Iterator<...>`, a wrapper iterator that is itself an
///! `Iterator`, so they compose; `peekable` returns a `PeekableIter`, which
///! adds `peek`. Eager consumers (`for_each`,
///! `fold`, `any`, `all`, `find`, `count`, `collect`, `sum`) and
///! `for (x in iter)` drive the chain. The adapters resolve directly on any concrete `Iterator` receiver,
///! including a user struct that `implement`s `Iterator`
///! (`mut c: Counter = ...; c.take(3).map(f)`), not just stdlib iterators.
///! (Re-adapting an opaque-typed iterator *local* works when the
///! local's initialiser is a concrete static constructor
///! - `mut it: implement Iterator<i32> = Range<i32>::new(0,10); it.take(3)`;
///! a local initialised from a producer that itself returns an opaque
///! iterator - `let it = arr.iter(); it.map(..)` - is still restricted, so
///! chain directly off the source there. See `docs/cryo.md` section 2.11.)

namespace std::core::iter;

import std::core::option::{ Option };
import std::core::clone;
import std::core::cmp::{ Ord };
import std::collections::pair::{ Pair };

/// A source of values handed out one at a time by `next`, until it
/// returns `None`. `for (x in source)` drives one, and the adapter methods
/// below build new iterators from it:
///
/// ```cryo
/// import std::collections::array::{ Array };
///
/// const squares: Array<i32> = (1..=4).map((n: i32) -> i32 { return n * n; }).collect();
/// // squares holds 1, 4, 9, 16
/// ```
![language("iterator")]
public type trait Iterator {
    /// The element type this iterator yields. Each implementor binds it once
    /// (positional sugar: `implement Iterator<T> for X` => `Item = T`); refer
    /// to it as `This::Item` inside the trait and `X::Item` outside.
    type Item;

    /// Advance the sequence and return the next value, or `None` when
    /// exhausted. Calling `next` again after `None` may return `None`
    /// forever or may panic; implementations should document which.
    next(mut &this) -> Option<This::Item>;

    /// Number of remaining elements. The default walks the iterator to
    /// count, consuming it. Implementations with O(1) knowledge of
    /// their length should override.
    count(mut &this) -> i64 {
        mut n: i64 = 0;
        loop {
            match (this.next()) {
                Option::Some(_) => { n++; }
                Option::None => { break; }
            }
        }
        return n;
    }

    /// Reduce the sequence to a single value. `initial` is the starting
    /// accumulator; `f` folds each element into it.
    fold<Acc, F>(mut &this, initial: Acc, f: F) -> Acc where F: (Acc, This::Item) -> Acc {
        mut acc: Acc = initial;
        loop {
            match (this.next()) {
                Option::Some(value) => { acc = f(acc, value); }
                Option::None => { break; }
            }
        }
        return acc;
    }

    /// Call `f` on each element, discarding the results. The natural
    /// way to consume an iterator purely for its side effects.
    for_each<F>(mut &this, f: F) -> void where F: (This::Item) -> void {
        loop {
            match (this.next()) {
                Option::Some(value) => { f(value); }
                Option::None => { break; }
            }
        }
    }

    /// Yield at most the first `n` elements, then stop.  A negative `n`
    /// yields nothing, as `0` does.
    take(this, n: i64) -> implement Iterator<This::Item> {
        return TakeIter { inner: this, remaining: n };
    }

    /// Discard the first `n` elements, then yield the rest. An iterator with
    /// fewer than `n` elements is drained and yields nothing.  A negative `n`
    /// discards nothing, as `0` does.
    skip(this, n: i64) -> implement Iterator<This::Item> {
        return SkipIter { inner: this, remaining: n };
    }

    /// Transform each element with `f`, yielding the results. `f` is any
    /// callable - a function, or a closure, capturing or not - and the
    /// adapter holds it.
    map<B, F>(this, f: F) -> implement Iterator<B> where F: (This::Item) -> B {
        return MapIter::<This, F, B> { inner: this, f: f };
    }

    /// Yield only the elements for which `pred` returns `true`. `pred` is any
    /// callable, held by the adapter.  It BORROWS each element: the element it
    /// keeps is the one yielded, so it cannot also be handed to `pred`.
    filter<P>(this, pred: P) -> implement Iterator<This::Item> where P: (&This::Item) -> boolean {
        return FilterIter { inner: this, pred: pred };
    }

    /// Yield every element of `this`, then every element of `other`, an
    /// `Iterator` with the same `Item` type.
    chain<J>(this, other: J) -> implement Iterator<This::Item> where J: Iterator<This::Item> {
        return ChainIter { first: this, second: other, first_done: false };
    }

    /// Yield `(index, value)` pairs, the index counting up from 0 as an
    /// `i64`.  The pair is `Pair<i64, Item>`: `p.first` is the index,
    /// `p.second` the element.  (Cryo has no heterogeneous tuple literal,
    /// so `Pair` is the element type.)
    enumerate(this) -> implement Iterator<Pair<i64, This::Item>> {
        return EnumerateIter { inner: this, index: 0 };
    }

    /// Yield pairs `(a, b)` drawing `a` from `this` and `b` from `other`,
    /// stopping as soon as either iterator is exhausted.  The pair is
    /// `Pair<Item, B>` where `B` is `other`'s element type: `p.first` comes
    /// from `this`, `p.second` from `other`.  (Cryo has no heterogeneous
    /// tuple literal, so `Pair` is the element type.)
    zip<J>(this, other: J) -> implement Iterator<Pair<This::Item, J::Item>> where J: Iterator {
        return ZipIter { first: this, second: other };
    }

    /// Build a collection of every element, in order: the collection is the
    /// type wanted where the call stands,
    /// `const evens: Array<i64> = numbers.filter(is_even).collect();`.
    collect<C>(this) -> C where C: FromIterator<This::Item> {
        return C::from_iterator(this);
    }

    /// The sum of every element; an iterator with none sums to zero.
    sum<S>(this) -> S where S: Sum, This: Iterator<S> {
        return S::sum(this);
    }

    /// Yield the elements back to front.  Only an iterator that also yields
    /// from its back end, a `DoubleEndedIterator`, reverses.
    rev(this) -> implement Iterator<This::Item> where This: DoubleEndedIterator {
        return RevIter { inner: this };
    }

    /// Yield the same elements, with `peek` reading the next one without
    /// taking it.
    peekable(this) -> PeekableIter<This> {
        return PeekableIter::new(this);
    }

    /// Map each element to an iterator with `f`, and yield the elements of
    /// each of those in turn.
    flat_map<B, F>(this, f: F) -> implement Iterator<B::Item> where F: (This::Item) -> B, B: Iterator {
        return FlatMapIter::<This, F, B> { inner: this, f: f, current: Option::None };
    }


    /// True if `pred` holds for at least one element. Short-circuits on
    /// the first match; consumes elements up to it.
    any<P>(mut &this, pred: P) -> boolean where P: (This::Item) -> boolean {
        loop {
            match (this.next()) {
                Option::Some(value) => { if (pred(value)) { return true; } }
                Option::None => { return false; }
            }
        }
    }

    /// True if `pred` holds for every element. Short-circuits on the
    /// first failure; vacuously true for an empty iterator.
    all<P>(mut &this, pred: P) -> boolean where P: (This::Item) -> boolean {
        loop {
            match (this.next()) {
                Option::Some(value) => { if (!pred(value)) { return false; } }
                Option::None => { return true; }
            }
        }
    }

    /// The first element for which `pred` holds, or `None`. Consumes
    /// elements up to and including the match.  `pred` borrows each element,
    /// since the one it accepts is returned.
    find<P>(mut &this, pred: P) -> Option<This::Item> where P: (&This::Item) -> boolean {
        loop {
            match (this.next()) {
                Option::Some(value) => {
                    if (pred(value)) { return Option::Some(value); }
                }
                Option::None => { return Option::None; }
            }
        }
    }

    /// The smallest element by `Ord`, or `None` for an empty iterator.
    /// Consumes the iterator. On ties the FIRST minimal element wins (only a
    /// strictly smaller element displaces the running best), so `min` and
    /// `max` of equal elements differ. Available only where the element type is `Ord` - the
    /// `where This::Item: Ord` associated-type projection bound; adapters whose
    /// element is never `Ord` (e.g. `enumerate`/`zip`, which yield `Pair`) do
    /// not carry it.
    min(mut &this) -> Option<This::Item> where This::Item: Ord {
        match (this.next()) {
            Option::None => { return Option::None; }
            Option::Some(first) => {
                mut best: This::Item = first;
                loop {
                    match (this.next()) {
                        Option::Some(value) => {
                            if (value.compare(&best).is_lt()) { best = value; }
                        }
                        Option::None => { return Option::Some(best); }
                    }
                }
            }
        }
    }

    /// The largest element by `Ord`, or `None` for an empty iterator.
    /// Consumes the iterator. On ties the LAST maximal element wins (an
    /// equal-or-greater element displaces the running best), the mirror of
    /// `min`.
    max(mut &this) -> Option<This::Item> where This::Item: Ord {
        match (this.next()) {
            Option::None => { return Option::None; }
            Option::Some(first) => {
                mut best: This::Item = first;
                loop {
                    match (this.next()) {
                        Option::Some(value) => {
                            if (value.compare(&best).is_ge()) { best = value; }
                        }
                        Option::None => { return Option::Some(best); }
                    }
                }
            }
        }
    }
}

/// Adapter yielding at most `remaining` elements from `inner`.
internal type struct TakeIter<I> {
    private inner: I;
    private remaining: i64;
}

implement<I, A> trait Iterator<A> for struct TakeIter<I>
where I: Iterator<A> {
    next(mut &this) -> Option<A> {
        if (this.remaining <= 0) {
            return Option::None;
        }
        this.remaining = this.remaining - 1;
        return this.inner.next();
    }
}

/// Adapter that drops the first `remaining` elements of `inner` on the first
/// `next`, then passes the rest through. `remaining` counts DOWN as elements
/// are skipped; once it hits 0 the adapter is transparent.
internal type struct SkipIter<I> {
    private inner: I;
    private remaining: i64;
}

implement<I, A> trait Iterator<A> for struct SkipIter<I>
where I: Iterator<A> {
    next(mut &this) -> Option<A> {
        while (this.remaining > 0) {
            this.remaining = this.remaining - 1;
            match (this.inner.next()) {
                // Payload dropped by the `_` match, as in `count`.
                Option::Some(_) => { }
                Option::None    => { this.remaining = 0; return Option::None; }
            }
        }
        return this.inner.next();
    }
}

/// Adapter applying `f` to each element of `inner`.  The input element type is
/// the inner iterator's associated item `I::Item`; `Mapper` is the callback's
/// own type (a function type or a closure); `O` is the mapped result (Output)
/// type, which the callback's signature binds.
///
/// No parameter of an adapter shares a name with a generic of the trait's
/// defaults (`map<B>`, `fold<Acc, F>`, `any<P>`, ...).  When a default is
/// applied to an adapter receiver (`r.map(f).map(g)`), the impl-spec
/// substituter rewrites every name the adapter's parameters use in the
/// inherited default - its own generics included - to the receiver's
/// arguments, leaving the default's generic of that name unbindable.  So the
/// result-type parameter is `O`, not `B`.
internal type struct MapIter<I, Mapper, O> where I: Iterator, Mapper: (I::Item) -> O {
    private inner: I;
    private f:     Mapper;
}

implement<I, Mapper, O> trait Iterator<O> for struct MapIter<I, Mapper, O>
where I: Iterator, Mapper: (I::Item) -> O {
    next(mut &this) -> Option<O> {
        return match (this.inner.next()) {
            Option::Some(value) => { Option::Some(this.f(value)) }
            Option::None        => { Option::None }
        };
    }
}

/// Adapter yielding only the elements of `inner` for which `pred` holds.
internal type struct FilterIter<I, Predicate> where I: Iterator, Predicate: (&I::Item) -> boolean {
    private inner: I;
    private pred:  Predicate;
}

implement<I, Predicate> trait Iterator<I::Item> for struct FilterIter<I, Predicate>
where I: Iterator, Predicate: (&I::Item) -> boolean {
    next(mut &this) -> Option<I::Item> {
        loop {
            match (this.inner.next()) {
                Option::Some(value) => {
                    if (this.pred(value)) {
                        return Option::Some(value);
                    }
                }
                Option::None => { return Option::None; }
            }
        }
    }
}

/// Adapter concatenating two iterators of the same element type: it drains
/// `first`, then `second`.  Both inner element types are pinned to the shared
/// `A` by the `where`-bounds.
internal type struct ChainIter<I, J> {
    private first:      I;
    private second:     J;
    private first_done: boolean;
}

implement<I, J, A> trait Iterator<A> for struct ChainIter<I, J>
where I: Iterator<A>, J: Iterator<A> {
    next(mut &this) -> Option<A> {
        if (!this.first_done) {
            match (this.first.next()) {
                Option::Some(value) => { return Option::Some(value); }
                Option::None        => { this.first_done = true; }
            }
        }
        return this.second.next();
    }
}

/// Adapter pairing each element of `inner` with its 0-based index.  The
/// element type is the inner iterator's associated item `I::Item`; the yielded
/// item is `Pair<i64, I::Item>`.
internal type struct EnumerateIter<I> {
    private inner: I;
    private index: i64;
}

implement<I> trait Iterator<Pair<i64, I::Item>> for struct EnumerateIter<I>
where I: Iterator {
    next(mut &this) -> Option<Pair<i64, I::Item>> {
        match (this.inner.next()) {
            Option::Some(value) => {
                const i: i64 = this.index;
                this.index = this.index + 1;
                return Option::Some(Pair::<i64, I::Item> { first: i, second: value });
            }
            Option::None => { return Option::None; }
        }
    }
}

/// Adapter pairing two iterators positionally, yielding `Pair<A, O>` until
/// either side runs out.  Chain-shaped: the element types `A` (from `I`) and
/// `O` (from `J`) live only in the impl `where`-bounds, not as struct
/// parameters, so the receiver type only mentions the two inner iterators.
internal type struct ZipIter<I, J> {
    private first:  I;
    private second: J;
}

implement<I, J, A, O> trait Iterator<Pair<A, O>> for struct ZipIter<I, J>
where I: Iterator<A>, J: Iterator<O> {
    next(mut &this) -> Option<Pair<A, O>> {
        match (this.first.next()) {
            Option::Some(a) => {
                match (this.second.next()) {
                    Option::Some(b) => {
                        return Option::Some(Pair::<A, O> { first: a, second: b });
                    }
                    Option::None => { return Option::None; }
                }
            }
            Option::None => { return Option::None; }
        }
    }
}

/// A collection built from the elements of an iterator: what `collect`
/// builds.
public type trait FromIterator<T> {
    /// A collection holding every element `source` yields, in order.
    static from_iterator<I>(source: I) -> This where I: Iterator<T>;
}

/// A number that is the sum of an iterator's elements: what `sum` returns.
public type trait Sum {
    /// The sum of every element `source` yields; zero for none.
    static sum<I>(source: I) -> This where I: Iterator<This>;
}

implement trait Sum for i8    { static sum<I>(source: I) -> i8    where I: Iterator<i8>    { mut total: i8 = 0;    for (value in source) { total = total + value; } return total; } }
implement trait Sum for i16   { static sum<I>(source: I) -> i16   where I: Iterator<i16>   { mut total: i16 = 0;   for (value in source) { total = total + value; } return total; } }
implement trait Sum for i32   { static sum<I>(source: I) -> i32   where I: Iterator<i32>   { mut total: i32 = 0;   for (value in source) { total = total + value; } return total; } }
implement trait Sum for i64   { static sum<I>(source: I) -> i64   where I: Iterator<i64>   { mut total: i64 = 0;   for (value in source) { total = total + value; } return total; } }
implement trait Sum for i128  { static sum<I>(source: I) -> i128  where I: Iterator<i128>  { mut total: i128 = 0;  for (value in source) { total = total + value; } return total; } }
implement trait Sum for isize { static sum<I>(source: I) -> isize where I: Iterator<isize> { mut total: isize = 0; for (value in source) { total = total + value; } return total; } }
implement trait Sum for u8    { static sum<I>(source: I) -> u8    where I: Iterator<u8>    { mut total: u8 = 0;    for (value in source) { total = total + value; } return total; } }
implement trait Sum for u16   { static sum<I>(source: I) -> u16   where I: Iterator<u16>   { mut total: u16 = 0;   for (value in source) { total = total + value; } return total; } }
implement trait Sum for u32   { static sum<I>(source: I) -> u32   where I: Iterator<u32>   { mut total: u32 = 0;   for (value in source) { total = total + value; } return total; } }
implement trait Sum for u64   { static sum<I>(source: I) -> u64   where I: Iterator<u64>   { mut total: u64 = 0;   for (value in source) { total = total + value; } return total; } }
implement trait Sum for u128  { static sum<I>(source: I) -> u128  where I: Iterator<u128>  { mut total: u128 = 0;  for (value in source) { total = total + value; } return total; } }
implement trait Sum for usize { static sum<I>(source: I) -> usize where I: Iterator<usize> { mut total: usize = 0; for (value in source) { total = total + value; } return total; } }
implement trait Sum for f32   { static sum<I>(source: I) -> f32   where I: Iterator<f32>   { mut total: f32 = 0.0; for (value in source) { total = total + value; } return total; } }
implement trait Sum for f64   { static sum<I>(source: I) -> f64   where I: Iterator<f64>   { mut total: f64 = 0.0; for (value in source) { total = total + value; } return total; } }

/// An iterator that also yields from its back end.  `next` and `next_back`
/// draw from one sequence, so between them each element is yielded once.
public type trait DoubleEndedIterator : Iterator {
    /// The next element from the back end, or `None` when the two ends
    /// have met.
    next_back(mut &this) -> Option<This::Item>;
}

/// Adapter yielding `inner`'s elements back to front.  Its own back end is
/// `inner`'s front, so a reversed iterator reverses back.
internal type struct RevIter<I> {
    private inner: I;
}

implement<I> trait Iterator<I::Item> for struct RevIter<I>
where I: DoubleEndedIterator {
    next(mut &this) -> Option<I::Item> {
        return this.inner.next_back();
    }
}

implement<I> trait DoubleEndedIterator for struct RevIter<I>
where I: DoubleEndedIterator {
    next_back(mut &this) -> Option<I::Item> {
        return this.inner.next();
    }
}

/// Adapter that reads its next element without taking it.  The element
/// `peek` reads is held until `next` yields it.
public type struct PeekableIter<I> where I: Iterator {
    private inner: I;
    private peeked: Option<I::Item>;
    /// Whether `peeked` holds what `inner` yielded last, `None` included.
    private has_peeked: boolean;

    /// `inner`'s elements, with `peek` to look at the next one without
    /// drawing it; `inner.peekable()` makes the same.
    public static new(inner: I) -> PeekableIter<I> {
        return PeekableIter::<I> { inner: inner, peeked: Option::None, has_peeked: false };
    }

    /// The next element, borrowed, or `None` when there is none.  The element
    /// is still the one `next` yields.
    public peek(mut &this) -> Option<const I::Item*> {
        if (!this.has_peeked) {
            this.peeked = this.inner.next();
            this.has_peeked = true;
        }
        return this.peeked.as_ref();
    }
}

implement<I> trait Iterator<I::Item> for struct PeekableIter<I>
where I: Iterator {
    next(mut &this) -> Option<I::Item> {
        if (this.has_peeked) {
            this.has_peeked = false;
            return this.peeked.take();
        }
        return this.inner.next();
    }
}

/// Adapter mapping each element of `inner` to an iterator with `f` and
/// yielding that iterator's elements, then the next one's.  `U` is the
/// iterator `f` returns; the element type `O` it yields lives in the
/// implementation's bounds.
internal type struct FlatMapIter<I, Mapper, U> where I: Iterator, Mapper: (I::Item) -> U {
    private inner: I;
    private f:     Mapper;
    private current: Option<U>;
}

implement<I, Mapper, U, O> trait Iterator<O> for struct FlatMapIter<I, Mapper, U>
where I: Iterator, Mapper: (I::Item) -> U, U: Iterator<O> {
    next(mut &this) -> Option<O> {
        loop {
            match (this.current.as_mutable_ref()) {
                Option::Some(current) => {
                    match (current.next()) {
                        Option::Some(value) => { return Option::Some(value); }
                        Option::None => { }
                    }
                }
                Option::None => { }
            }
            match (this.inner.next()) {
                Option::Some(element) => { this.current = Option::Some(this.f(element)); }
                Option::None => { return Option::None; }
            }
        }
    }
}
