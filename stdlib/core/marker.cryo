///! Marker traits.
///!
///! Traits with no methods. Implementing one doesn't add behavior; it
///! tells the compiler and other generic code that the type has certain
///! semantics.
///!
///! Enforcement status (v1.0):
///!   - `Copy` is enforced by the move-checker (a `Copy` type really is
///!     duplicated bitwise; assignment does not move it out).
///!   - `Send` / `Sync` are computed structurally and ARE checked at any
///!     explicit `where T: Send` / `where T: Sync` bound. The thread
///!     entry points carry them: `thread::spawn` / `try_spawn` /
///!     `spawn_with_attr` require the body `F: Send` and its result
///!     `T: Send`, and `Scope::spawn` requires `F: Send`, so moving a
///!     non-`Send` value (an `Rc<T>`, a lock guard, a closure written
///!     without `move`) into another thread is a compile error. Raw
///!     pointers and the containers built on them (`Box`, `Arc`,
///!     `Array`, `String`, `mpsc::Sender`) are structurally `Send`, so
///!     the scoped raw-pointer idiom still compiles. The lock
///!     constructors do not yet carry `T: Send` bounds (a `Mutex<Rc<_>>`
///!     is still constructible); that is the remaining advisory edge.
///!   - The primitive traits (`Primitive`, `Numeric`, `Integer`,
///!     `SignedInteger`, `UnsignedInteger`, `Float`) are decided from the
///!     type by the compiler, and an `implement` of one is refused.

namespace std::core::marker;

/// Types whose values can be duplicated by a bitwise copy. Integers,
/// floats, pointers, and pure-POD structs qualify; anything that owns
/// resources (heap storage, file handles, refcount) does not.
///
/// A `Copy` type never needs an explicit `clone` call; assignment and
/// argument passing duplicate it implicitly. `Copy` is therefore a
/// stronger promise than `Clone`.
![language("copy")]
public type trait Copy { }

/// Types that are safe to transfer between threads. An owning value of
/// a `Send` type may cross a thread boundary without violating memory
/// safety.
![language("send")]
public type trait Send { }

/// Types that are safe to share between threads by shared reference.
/// `T: Sync` if `&T: Send`.
![language("sync")]
public type trait Sync { }

/// The built-in value types: every integer (`i8` to `i128`, `u8` to
/// `u128`, `isize`, `usize`), `f32`, `f64`, `boolean`, `char` and
/// `string`.
///
/// The primitive traits - this one, `Numeric`, `Integer`,
/// `SignedInteger`, `UnsignedInteger` and `Float` - are had by the
/// built-in types they name and by nothing else: the compiler decides
/// them from the type, and an `implement` of one is refused. A bound of
/// one therefore says exactly which types a generic accepts, and a
/// `static match` over a parameter it bounds must name every one of them
/// or have a `_` arm.
///
/// ```cryo
/// function describe<T>(value: T) -> string where T: Primitive {
///     return static match (T) {
///         boolean => { "a boolean" }
///         char    => { "a char" }
///         string  => { "a string" }
///         _       => { "a number" }
///     };
/// }
/// ```
![language("primitive")]
public type trait Primitive { }

/// The built-in number types: every integer and `f32`, `f64`.
![language("numeric")]
public type trait Numeric : Primitive { }

/// The built-in integer types: `i8`, `i16`, `i32`, `i64`, `i128`,
/// `isize`, `u8`, `u16`, `u32`, `u64`, `u128` and `usize`.
///
/// ```cryo
/// function width<T>() -> i32 where T: Integer {
///     return static match (T) {
///         i8 | u8                  => { 8 }
///         i16 | u16                => { 16 }
///         i32 | u32                => { 32 }
///         i64 | u64 | isize | usize => { 64 }
///         i128 | u128              => { 128 }
///     };
/// }
/// ```
![language("integer")]
public type trait Integer : Numeric { }

/// The built-in signed integer types: `i8`, `i16`, `i32`, `i64`, `i128`
/// and `isize`.
![language("signed_integer")]
public type trait SignedInteger : Integer { }

/// The built-in unsigned integer types: `u8`, `u16`, `u32`, `u64`,
/// `u128` and `usize`.
![language("unsigned_integer")]
public type trait UnsignedInteger : Integer { }

/// The built-in floating-point types: `f32` and `f64`.
![language("float")]
public type trait Float : Numeric { }
