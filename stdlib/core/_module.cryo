///! core: foundation of the stdlib.
///!
///! As a rule, `core/` neither allocates nor performs I/O; higher-level
///! modules build on what lives here. The one exception is a small set
///! of legacy `string` bridge methods in `primitives.cryo`
///! (`substring`/`append`) that call `malloc` to keep the self-hosted
///! compiler's older string-shaped code building; new code should use
///! `collections::String` instead.

namespace std::core;

import std::core::intrinsics;

module {
    core::intrinsics;
    core::primitives;
    core::option;
    core::result;
    core::panic_unwind;
    core::slice;
    core::ptr;
    core::mem;
}

module {
    core::marker;
    core::clone;
    core::default;
    core::cmp;
    core::convert;
    core::iter;
    core::ops;
    core::hash;
    core::drop;
    core::varargs;
}

// -- Panic and assertions --
//
// `panic` is typed `never`: the compiler treats the call as divergent
// structurally, with no special-casing on the symbol name.

/// Panic with `message`, reporting the place `loc`: `intrinsics::location()`
/// written at the call, or in a `![caller_location]` function its caller's.
/// The helpers below do that automatically.
public function panic(message: string, loc: intrinsics::Location) -> never {
    intrinsics::panic(message, loc);
}

/// Panic if `condition` is false. Always checked.
public function assert(condition: boolean, message: string) -> void {
    if (!condition) {
        panic(message, intrinsics::location());
    }
}

/// Mark a code path the programmer believes cannot be reached. If it ever
/// is, the program aborts with a clear message rather than executing
/// wrong code.
public function unreachable() -> never {
    panic("entered unreachable code", intrinsics::location());
}

/// Stub a function you'll implement later. Reading better than inlining
/// `panic("not yet implemented", ...)` with the place is its whole job.
public function todo() -> never {
    panic("not yet implemented", intrinsics::location());
}
