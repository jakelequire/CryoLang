///! core: foundation of the stdlib.
///!
///! As a rule, `core/` neither allocates nor performs I/O; higher-level
///! modules build on what lives here. The one exception is a small set
///! of legacy `string` bridge methods in `primitives.cryo`
///! (`substring`/`append`) that call `malloc` to keep the self-hosted
///! compiler's older string-shaped code building; new code should use
///! `collections::String` instead. `error::ErrorReport` owns text too: the
///! carrier every error converts into has to keep the messages of errors
///! that do not outlive it.
///!
///! This module is not in the prelude: the prelude takes the modules it
///! binds bare one by one (`core::panic` for `panic`, `assert`,
///! `unreachable` and `todo`, `core::option`, ...). The exports below are
///! the short import of core's types and traits,
///! `import std::core::{ Ordering, TryFrom, NonNull };`, and bind nothing
///! in a file that does not import them.

namespace std::core;

module {
    core::intrinsics;
    core::primitives;
    core::option;
    core::result;
    core::panic_unwind;
    core::slice;
    core::pointer;
    core::mem;
}

module {
    core::marker;
    core::error;
    core::clone;
    core::default;
    core::cmp;
    core::convert;
    core::iter;
    core::ops;
    core::hash;
    core::drop;
    core::pair;
    core::variadic_arguments;
    core::panic;
    core::common;
}

export std::core::option::{ Option };
export std::core::result::{ Result };
export std::core::error::{ Error, ErrorReport, BoxedError };
export std::core::cmp::{ Ordering, Eq, Ord };
export std::core::clone::{ Clone };
export std::core::default::{ Default };
export std::core::drop::{ Drop };
export std::core::pair::{ Pair };
export std::core::convert::{ From, Into, TryFrom, TryInto, ConversionError };
export std::core::hash::{ Hash, Hasher, SipHasher, FnvHasher, Fnv128Hasher };
export std::core::iter::{ Iterator, DoubleEndedIterator, FromIterator, Peekable, Product, Sum };
export std::core::marker::{
    Copy, Send, Sync, Primitive, Numeric, Integer, SignedInteger, UnsignedInteger, Float, Bitwise
};
export std::core::ops::{
    Range, RangeInclusive, RangeFrom, RangeTo, RangeFull, Bound, ControlFlow,
    Add, Sub, Mul, Div, Rem, Neg, Not, BitAnd, BitOr, BitXor, BitNot, Shl, Shr,
    Index, IndexMutable, Deref, DerefMutable
};
export std::core::pointer::{ NonNull };
export std::core::slice::{ Slice, AsSlice, AsMutableSlice };
