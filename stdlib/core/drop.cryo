///! Drop — explicit destructor.
///!
///! `Drop` is the trait every type implements when it owns heap state
///! (or any other resource that must be released).  The trait method is
///! `drop(mut &this) -> void`; calling it puts the value into a
///! "released" state and is the last operation performed on it.
///!
///! POD types (every primitive, plain bitwise-copyable structs) get
///! a trivial no-op `Drop` impl so generic containers can write
///! `where K: Drop, V: Drop` without locking out useful instantiations
///! like `HashMap<u32, V>`.  When the value carries no resource the
///! impl is empty and the call lowers to no IR.
///!
///! The owning collections (`Array`, `String`, `HashMap`, ...) still
///! expose an inherent `drop` method — that's what callers reach for
///! today.  Container code that needs to drop generic K/V uses the
///! trait so substitution can route through whichever impl the
///! concrete type provides.

namespace std::core::drop;

type trait Drop {
    drop(mut &this) -> void;
}

// ============================================================================
// Trivial impls for primitives — every primitive is bitwise copyable, so
// dropping it is a no-op.  These exist solely so generic bounds like
// `where T: Drop` are satisfied for primitive instantiations.
// ============================================================================

implement trait Drop for i8      { drop(mut &this) -> void {} }
implement trait Drop for i16     { drop(mut &this) -> void {} }
implement trait Drop for i32     { drop(mut &this) -> void {} }
implement trait Drop for i64     { drop(mut &this) -> void {} }
implement trait Drop for u8      { drop(mut &this) -> void {} }
implement trait Drop for u16     { drop(mut &this) -> void {} }
implement trait Drop for u32     { drop(mut &this) -> void {} }
implement trait Drop for u64     { drop(mut &this) -> void {} }
implement trait Drop for f32     { drop(mut &this) -> void {} }
implement trait Drop for f64     { drop(mut &this) -> void {} }
implement trait Drop for boolean { drop(mut &this) -> void {} }
implement trait Drop for char    { drop(mut &this) -> void {} }

// `string` is a borrowed null-terminated `i8*` — it never owns the
// pointed-to bytes, so dropping it is a no-op.  The owned counterpart
// (`String`, in `collections::string`) carries its own Drop impl that
// releases the heap buffer.
implement trait Drop for string  { drop(mut &this) -> void {} }

// NOTE: `implement trait Drop for () { ... }` is the right impl for the
// unit type — `HashSet<T>` (`HashMap<T, ()>` underneath) needs it to
// satisfy `where V: Drop`.  Parser support for `()` as an impl target
// is in place, but the codegen path for unit-type impls still leaves
// a dangling LLVM declaration, so the impl is omitted here pending
// that work.
