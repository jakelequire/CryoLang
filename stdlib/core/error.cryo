///! Error: the stdlib's general-purpose error value.
///!
///! A plain struct with a message and a numeric code, for code that just
///! needs *an* error to return. By design the stdlib has no single unifying
///! `Error` trait: each module defines its own precise error type
///! (`IoError`, `JsonError`, `ConversionError`, ...) and converts at its
///! boundaries. This struct is the catch-all for callers that don't need
///! that precision.

namespace std::core::error;

type struct Error {
    message: string;
    code: i32;

    /// Construct an error. `code` defaults to zero when the caller has
    /// nothing specific to report.
    static new(message: string, code: i32) -> Error {
        return Error { message: message, code: code };
    }
}
