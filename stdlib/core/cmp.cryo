///! Comparison: equality and ordering.
///!
///! `Eq` is equality. `Ord` extends it with a total ordering. Both are
///! expressed as methods rather than operators because Cryo does not
///! support operator overloading; generic code calls `.equals()` or
///! `.compare()` and the compiler resolves to the concrete impl.

namespace std::core::cmp;

import core::intrinsics;

// ============================================================================
// Ordering
// ============================================================================

type enum Ordering {
    Less;
    Equal;
    Greater;
}

implement enum Ordering {
    /// Flip the direction of the comparison. Useful when sorting by a
    /// reversed key without duplicating the comparator.
    reverse(&this) -> Ordering {
        match (&this) {
            Ordering::Less => { return Ordering::Greater; }
            Ordering::Equal => { return Ordering::Equal; }
            Ordering::Greater => { return Ordering::Less; }
        }
    }
}

// ============================================================================
// Eq: equality
// ============================================================================

/// Types that support value equality. `equals(a, b)` must be reflexive,
/// symmetric, and transitive; floating-point NaN violates reflexivity,
/// so `f32` and `f64` do **not** implement `Eq`. Use `PartialEq` for
/// those (which this stdlib does not yet model); float comparison goes
/// through `==` directly.
type trait Eq {
    equals(&this, other: &This) -> boolean;
}

implement trait Eq for i8      { equals(&this, other: &i8) -> boolean { return this == *other; } }
implement trait Eq for i16     { equals(&this, other: &i16) -> boolean { return this == *other; } }
implement trait Eq for i32     { equals(&this, other: &i32) -> boolean { return this == *other; } }
implement trait Eq for i64     { equals(&this, other: &i64) -> boolean { return this == *other; } }
implement trait Eq for u8      { equals(&this, other: &u8) -> boolean { return this == *other; } }
implement trait Eq for u16     { equals(&this, other: &u16) -> boolean { return this == *other; } }
implement trait Eq for u32     { equals(&this, other: &u32) -> boolean { return this == *other; } }
implement trait Eq for u64     { equals(&this, other: &u64) -> boolean { return this == *other; } }
implement trait Eq for boolean { equals(&this, other: &boolean) -> boolean { return this == *other; } }
implement trait Eq for char    { equals(&this, other: &char) -> boolean { return this == *other; } }

/// `string` is Cryo's NUL-terminated raw C-string view.  Two strings
/// are equal iff their bytes match up to and including the terminator.
implement trait Eq for string {
    equals(&this, other: &string) -> boolean {
        const a: u8* = this as u8*;
        const b: u8* = (*other) as u8*;
        if (a == b) { return true; }
        mut i: u64 = 0;
        while (true) {
            const ca: u8 = a[i];
            const cb: u8 = b[i];
            if (ca != cb) { return false; }
            if (ca == 0 as u8) { return true; }
            i = i + 1;
        }
        return true;
    }
}

// ============================================================================
// Ord: total ordering
// ============================================================================

/// Types that have a total order: every pair is `Less`, `Equal`, or
/// `Greater`. `compare` must be consistent with `equals`: if
/// `a.equals(b)` then `a.compare(b) == Equal`.
type trait Ord : Eq {
    compare(&this, other: &This) -> Ordering;
}

implement trait Ord for i8 {
    compare(&this, other: &i8) -> Ordering {
        if (this < *other) { return Ordering::Less; }
        if (this > *other) { return Ordering::Greater; }
        return Ordering::Equal;
    }
}

implement trait Ord for i16 {
    compare(&this, other: &i16) -> Ordering {
        if (this < *other) { return Ordering::Less; }
        if (this > *other) { return Ordering::Greater; }
        return Ordering::Equal;
    }
}

implement trait Ord for i32 {
    compare(&this, other: &i32) -> Ordering {
        if (this < *other) { return Ordering::Less; }
        if (this > *other) { return Ordering::Greater; }
        return Ordering::Equal;
    }
}

implement trait Ord for i64 {
    compare(&this, other: &i64) -> Ordering {
        if (this < *other) { return Ordering::Less; }
        if (this > *other) { return Ordering::Greater; }
        return Ordering::Equal;
    }
}

implement trait Ord for u8 {
    compare(&this, other: &u8) -> Ordering {
        if (this < *other) { return Ordering::Less; }
        if (this > *other) { return Ordering::Greater; }
        return Ordering::Equal;
    }
}

implement trait Ord for u16 {
    compare(&this, other: &u16) -> Ordering {
        if (this < *other) { return Ordering::Less; }
        if (this > *other) { return Ordering::Greater; }
        return Ordering::Equal;
    }
}

implement trait Ord for u32 {
    compare(&this, other: &u32) -> Ordering {
        if (this < *other) { return Ordering::Less; }
        if (this > *other) { return Ordering::Greater; }
        return Ordering::Equal;
    }
}

implement trait Ord for u64 {
    compare(&this, other: &u64) -> Ordering {
        if (this < *other) { return Ordering::Less; }
        if (this > *other) { return Ordering::Greater; }
        return Ordering::Equal;
    }
}

implement trait Ord for char {
    compare(&this, other: &char) -> Ordering {
        if (this < *other) { return Ordering::Less; }
        if (this > *other) { return Ordering::Greater; }
        return Ordering::Equal;
    }
}

// ============================================================================
// Free functions
// ============================================================================

function min<T>(a: T, b: T) -> T 
where T: Ord {
    return match (a.compare(&b)) {
        Ordering::Greater => { b }
        _ => { a }
    }
}

function max<T>(a: T, b: T) -> T 
where T: Ord {
    return match (a.compare(&b)) {
        Ordering::Less => { b }
        _ => { a }
    }
}

/// Constrain `value` to `[lo, hi]`. Panics if `lo > hi`; the caller
/// gave a nonsense range.
function clamp<T>(value: T, lo: T, hi: T) -> T 
where T: Ord {
    match (lo.compare(&hi)) {
        Ordering::Greater => {
            intrinsics::panic("cmp::clamp: lo > hi", FILE, LINE);
        }
        _ => { }
    }
    match (value.compare(&lo)) {
        Ordering::Less => { return lo; }
        _ => { }
    }
    match (value.compare(&hi)) {
        Ordering::Greater => { return hi; }
        _ => { }
    }
    return value;
}
