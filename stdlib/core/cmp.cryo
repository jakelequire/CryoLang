///! Comparison: equality and ordering.
///!
///! `Eq` is equality. `Ord` extends it with a total ordering. Both are
///! expressed as methods rather than operators because Cryo does not
///! support operator overloading; generic code calls `.equals()` or
///! `.compare()` and the compiler resolves to the concrete impl.

namespace std::core::cmp;

import core::intrinsics;
import core::mem;

type enum Ordering {
    Less;
    Equal;
    Greater;
}

implement enum Ordering {
    /// Flip the direction of the comparison. Useful when sorting by a
    /// reversed key without duplicating the comparator.
    reverse(&this) -> Ordering {
        match (&this) {
            Ordering::Less => { return Ordering::Greater; }
            Ordering::Equal => { return Ordering::Equal; }
            Ordering::Greater => { return Ordering::Less; }
        }
    }

    /// Ordering predicates backing the relational operators on `Ord` types.
    /// The compiler rewrites `a < b` into `a.compare(&b).is_lt()` (and `>`,
    /// `<=`, `>=` into `is_gt`/`is_le`/`is_ge`), so these keep the operator
    /// semantics in one place and let `Ord`-only types get `< > <= >=` for
    /// free once they implement `compare`.
    is_lt(&this) -> boolean {
        match (&this) { Ordering::Less => { return true; } _ => { return false; } }
    }
    is_gt(&this) -> boolean {
        match (&this) { Ordering::Greater => { return true; } _ => { return false; } }
    }
    is_le(&this) -> boolean {
        match (&this) { Ordering::Greater => { return false; } _ => { return true; } }
    }
    is_ge(&this) -> boolean {
        match (&this) { Ordering::Less => { return false; } _ => { return true; } }
    }
}

// Eq: equality

/// Types that support value equality. `equals(a, b)` must be reflexive,
/// symmetric, and transitive.
///
/// `f32` and `f64` implement `Eq` as **bitwise** equality (every bit of
/// the IEEE-754 representation must match), not the IEEE `==` operator.
/// This keeps `Eq` a true equivalence relation - reflexive even for NaN
/// (`nan.equals(&nan)` for the *same* bit pattern is `true`) - and
/// consistent with the total order in `Ord` below. Note the two
/// consequences: `(0.0).equals(&-0.0)` is `false` (different sign bit),
/// and two NaNs with different payloads are unequal. If you want IEEE
/// semantics (`0.0 == -0.0`, `nan != nan`), compare with `==` directly.
type trait Eq {
    equals(&this, other: &This) -> boolean;
}

implement trait Eq for i8      { equals(&this, other: &i8) -> boolean { return this == *other; } }
implement trait Eq for i16     { equals(&this, other: &i16) -> boolean { return this == *other; } }
implement trait Eq for i32     { equals(&this, other: &i32) -> boolean { return this == *other; } }
implement trait Eq for i64     { equals(&this, other: &i64) -> boolean { return this == *other; } }
implement trait Eq for u8      { equals(&this, other: &u8) -> boolean { return this == *other; } }
implement trait Eq for u16     { equals(&this, other: &u16) -> boolean { return this == *other; } }
implement trait Eq for u32     { equals(&this, other: &u32) -> boolean { return this == *other; } }
implement trait Eq for u64     { equals(&this, other: &u64) -> boolean { return this == *other; } }
implement trait Eq for i128    { equals(&this, other: &i128) -> boolean { return this == *other; } }
implement trait Eq for u128    { equals(&this, other: &u128) -> boolean { return this == *other; } }
implement trait Eq for usize   { equals(&this, other: &usize) -> boolean { return this == *other; } }
implement trait Eq for isize   { equals(&this, other: &isize) -> boolean { return this == *other; } }
implement trait Eq for boolean { equals(&this, other: &boolean) -> boolean { return this == *other; } }
implement trait Eq for char    { equals(&this, other: &char) -> boolean { return this == *other; } }

/// `string` is Cryo's NUL-terminated raw C-string view.  Two strings
/// are equal if their bytes match up to and including the terminator.
implement trait Eq for string {
    equals(&this, other: &string) -> boolean {
        const a: u8* = this as u8*;
        const b: u8* = (*other) as u8*;
        if (a == b) { return true; }
        mut i: u64 = 0;
        while (true) {
            const ca: u8 = a[i];
            const cb: u8 = b[i];
            if (ca != cb) { return false; }
            if (ca == 0 as u8) { return true; }
            i = i + 1;
        }
        return true;
    }
}

/// Floats use **bitwise** equality (see the `Eq` doc): reinterpret the
/// IEEE-754 bits as an unsigned integer and compare those. This makes
/// `equals` reflexive for a fixed NaN bit pattern and consistent with
/// `Ord` for floats below, at the cost of `0.0 != -0.0` and distinct
/// NaN payloads comparing unequal.
implement trait Eq for f32 {
    equals(&this, other: &f32) -> boolean {
        return mem::transmute<f32, u32>(this) == mem::transmute<f32, u32>(*other);
    }
}
implement trait Eq for f64 {
    equals(&this, other: &f64) -> boolean {
        return mem::transmute<f64, u64>(this) == mem::transmute<f64, u64>(*other);
    }
}

// Ord: total ordering

/// Types that have a total order: every pair is `Less`, `Equal`, or
/// `Greater`. `compare` must be consistent with `equals`: if
/// `a.equals(b)` then `a.compare(b) == Equal`.
type trait Ord : Eq {
    compare(&this, other: &This) -> Ordering;
}

implement trait Ord for i8 {
    compare(&this, other: &i8) -> Ordering {
        if (this < *other) { return Ordering::Less; }
        if (this > *other) { return Ordering::Greater; }
        return Ordering::Equal;
    }
}

implement trait Ord for i16 {
    compare(&this, other: &i16) -> Ordering {
        if (this < *other) { return Ordering::Less; }
        if (this > *other) { return Ordering::Greater; }
        return Ordering::Equal;
    }
}

implement trait Ord for i32 {
    compare(&this, other: &i32) -> Ordering {
        if (this < *other) { return Ordering::Less; }
        if (this > *other) { return Ordering::Greater; }
        return Ordering::Equal;
    }
}

implement trait Ord for i64 {
    compare(&this, other: &i64) -> Ordering {
        if (this < *other) { return Ordering::Less; }
        if (this > *other) { return Ordering::Greater; }
        return Ordering::Equal;
    }
}

implement trait Ord for u8 {
    compare(&this, other: &u8) -> Ordering {
        if (this < *other) { return Ordering::Less; }
        if (this > *other) { return Ordering::Greater; }
        return Ordering::Equal;
    }
}

implement trait Ord for u16 {
    compare(&this, other: &u16) -> Ordering {
        if (this < *other) { return Ordering::Less; }
        if (this > *other) { return Ordering::Greater; }
        return Ordering::Equal;
    }
}

implement trait Ord for u32 {
    compare(&this, other: &u32) -> Ordering {
        if (this < *other) { return Ordering::Less; }
        if (this > *other) { return Ordering::Greater; }
        return Ordering::Equal;
    }
}

implement trait Ord for u64 {
    compare(&this, other: &u64) -> Ordering {
        if (this < *other) { return Ordering::Less; }
        if (this > *other) { return Ordering::Greater; }
        return Ordering::Equal;
    }
}

implement trait Ord for i128 {
    compare(&this, other: &i128) -> Ordering {
        if (this < *other) { return Ordering::Less; }
        if (this > *other) { return Ordering::Greater; }
        return Ordering::Equal;
    }
}

implement trait Ord for u128 {
    compare(&this, other: &u128) -> Ordering {
        if (this < *other) { return Ordering::Less; }
        if (this > *other) { return Ordering::Greater; }
        return Ordering::Equal;
    }
}

implement trait Ord for usize {
    compare(&this, other: &usize) -> Ordering {
        if (this < *other) { return Ordering::Less; }
        if (this > *other) { return Ordering::Greater; }
        return Ordering::Equal;
    }
}

implement trait Ord for isize {
    compare(&this, other: &isize) -> Ordering {
        if (this < *other) { return Ordering::Less; }
        if (this > *other) { return Ordering::Greater; }
        return Ordering::Equal;
    }
}

implement trait Ord for char {
    compare(&this, other: &char) -> Ordering {
        if (this < *other) { return Ordering::Less; }
        if (this > *other) { return Ordering::Greater; }
        return Ordering::Equal;
    }
}

/// Lexicographic order over `string` (Cryo's NUL-terminated raw C-string
/// view): compare bytes as unsigned until they differ or a terminator is
/// reached.  Consistent with `Eq for string` above (equal bytes up to and
/// including the NUL <=> Equal).  A shorter string that is a prefix of a
/// longer one sorts first (its NUL byte, 0, is less than any real byte).
implement trait Ord for string {
    compare(&this, other: &string) -> Ordering {
        const a: u8* = this as u8*;
        const b: u8* = (*other) as u8*;
        if (a == b) { return Ordering::Equal; }
        mut i: u64 = 0;
        while (true) {
            const ca: u8 = a[i];
            const cb: u8 = b[i];
            if (ca < cb) { return Ordering::Less; }
            if (ca > cb) { return Ordering::Greater; }
            if (ca == 0 as u8) { return Ordering::Equal; }
            i = i + 1;
        }
        return Ordering::Equal;
    }
}

/// Total order over floats, matching Rust's `f64::total_cmp`. IEEE `<`
/// is *not* a total order (NaN is unordered, `-0.0 == 0.0`), so this
/// orders the raw bits instead: reinterpret as a signed integer, then
/// flip every bit but the sign for negatives. The result sorts:
///   -NaN < -inf < ... < -0.0 < +0.0 < ... < +inf < +NaN
/// i.e. negative NaNs first, positive NaNs last, the two zeros distinct.
/// This is consistent with the bitwise `Eq` above (equal bits <=> Equal).
implement trait Ord for f32 {
    compare(&this, other: &f32) -> Ordering {
        mut left: i32 = mem::transmute<f32, i32>(this);
        mut right: i32 = mem::transmute<f32, i32>(*other);
        left = left ^ ((((left >> 31) as u32) >> 1) as i32);
        right = right ^ ((((right >> 31) as u32) >> 1) as i32);
        if (left < right) { return Ordering::Less; }
        if (left > right) { return Ordering::Greater; }
        return Ordering::Equal;
    }
}
implement trait Ord for f64 {
    compare(&this, other: &f64) -> Ordering {
        mut left: i64 = mem::transmute<f64, i64>(this);
        mut right: i64 = mem::transmute<f64, i64>(*other);
        left = left ^ ((((left >> 63) as u64) >> 1) as i64);
        right = right ^ ((((right >> 63) as u64) >> 1) as i64);
        if (left < right) { return Ordering::Less; }
        if (left > right) { return Ordering::Greater; }
        return Ordering::Equal;
    }
}

function min<T>(a: T, b: T) -> T
where T: Ord {
    return match (a.compare(&b)) {
        Ordering::Greater => { b }
        _ => { a }
    }
}

function max<T>(a: T, b: T) -> T 
where T: Ord {
    return match (a.compare(&b)) {
        Ordering::Less => { b }
        _ => { a }
    }
}

/// Constrain `value` to `[lo, hi]`. Panics if `lo > hi`; the caller
/// gave a nonsense range.
function clamp<T>(value: T, lo: T, hi: T) -> T 
where T: Ord {
    match (lo.compare(&hi)) {
        Ordering::Greater => {
            intrinsics::panic("cmp::clamp: lo > hi", FILE, LINE);
        }
        _ => { }
    }
    match (value.compare(&lo)) {
        Ordering::Less => { return lo; }
        _ => { }
    }
    match (value.compare(&hi)) {
        Ordering::Greater => { return hi; }
        _ => { }
    }
    return value;
}
