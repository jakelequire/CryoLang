///! Looking a stored value up by another form of it.
///!
///! `Borrow<Q>` says that a value of this type can be read as a `Q` that
///! compares and hashes as the value itself does. The keyed collections
///! take their lookup key as any `Q` their key type borrows as, so a
///! `HashMap<String, V>` is asked with a `Str`, and every key type is
///! still asked with a reference to itself:
///!
///!   ```cryo
///!   mut ages: HashMap<String, i64> = HashMap::new();
///!   ages.insert(String::from("ada"), 36);
///!   const name: Str = "ada";
///!   ages.get(name);               // a Str: no String is made to ask
///!   ages.get(&String::from("ada"));
///!   ```
///!
///! An implementation must keep the two forms in step: `a == b` exactly
///! when `a.borrow() == b.borrow()`, and `a.borrow()` hashes and orders as
///! `a` does. A lookup that breaks this finds nothing, or the wrong entry.
namespace std::core::borrow;

/// A type whose values read as a `Q` that compares, hashes and orders as
/// they do: what a keyed collection's lookup takes in place of the key.
public type trait Borrow<Q> {
    /// This value read as a `Q`.
    borrow(&this) -> Q;
}

/// Every type borrows as a reference to itself, so a lookup by `&key`
/// works for every key type.
implement<T> trait Borrow<&T> for T {
    borrow(&this) -> &T { return &this; }
}
