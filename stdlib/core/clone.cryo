///! Clone: explicit duplication.
///!
///! `Clone` produces an independent copy of a value. Conceptually a type
///! that owns heap storage clones by allocating fresh storage and copying
///! the contents, while a POD type clones with a bitwise copy.
///!
///! This module implements `Clone` for the primitive scalar types (their
///! clone is a bitwise copy). `Option<T>` and `Result<T, E>` implement it
///! conditionally on their payloads (see `core::option` / `core::result`).
///! Heap-owning containers such as `Array`, `String`, and `Box` do not yet
///! implement `Clone`. Keeping `Clone` a distinct trait (rather than
///! deriving it from `Copy`) lets generic code ask for the weaker promise.

namespace std::core::clone;

type trait Clone {
    clone(&this) -> This;
}

implement trait Clone for i8      { clone(&this) -> i8      { return this; } }
implement trait Clone for i16     { clone(&this) -> i16     { return this; } }
implement trait Clone for i32     { clone(&this) -> i32     { return this; } }
implement trait Clone for i64     { clone(&this) -> i64     { return this; } }
implement trait Clone for u8      { clone(&this) -> u8      { return this; } }
implement trait Clone for u16     { clone(&this) -> u16     { return this; } }
implement trait Clone for u32     { clone(&this) -> u32     { return this; } }
implement trait Clone for u64     { clone(&this) -> u64     { return this; } }
implement trait Clone for f32     { clone(&this) -> f32     { return this; } }
implement trait Clone for f64     { clone(&this) -> f64     { return this; } }
implement trait Clone for boolean { clone(&this) -> boolean { return this; } }
implement trait Clone for char    { clone(&this) -> char    { return this; } }
