///! Slice<T>: a borrowed view into a contiguous sequence.
///!
///! `Slice<T>` is `(pointer, length)`. Algorithms operate on slices;
///! collections expose `as_slice()` so algorithms need only be written
///! once. A slice does not own its storage; the backing memory must
///! outlive every slice that refers to it.

namespace std::core::slice;

import std::core::intrinsics;
import std::core::cmp::{ Eq };
import std::core::ops::{ Index };
import std::core::iter::{ Iterator };
import std::core::option::{ Option };
import std::core::mem;

![language("slice")]
public type struct Slice<T> {
    private ptr: T*;
    private length: i64;

    /// Construct from a raw pointer and length. The caller certifies
    /// that `[ptr, ptr + length)` is valid initialized memory for as
    /// long as the slice exists, and that `length` is not negative.
    public static from_raw(ptr: T*, length: i64) -> Slice<T> {
        return Slice::<T> { ptr: ptr, length: length };
    }

    ![inline]
    public length(&this) -> i64 {
        return this.length;
    }

    public is_empty(&this) -> boolean {
        return this.length == 0;
    }

    /// Bounds-checked read by value; `None` for an index outside
    /// `[0, length)`, a negative one included. Gated on `T: Copy`: the
    /// result is an independent bitwise duplicate while the backing storage
    /// still owns the element, so this is only sound when `T` carries no
    /// `Drop` obligation. For owning `T`, borrow in place with `get_ref`.
    public get(&this, index: i64) -> Option<T> where T: Copy {
        if (index < 0 || index >= this.length) {
            return Option::None;
        }
        return Option::Some(this.ptr[index]);
    }

    /// Bounds-checked borrow; `None` for an index outside `[0, length)`.
    /// Returns a pointer to the element in place, sound for every `T`. The
    /// pointer is valid only while the backing storage outlives the slice.
    public get_ref(&this, index: i64) -> Option<T*> {
        if (index < 0 || index >= this.length) {
            return Option::None;
        }
        return Option::Some(mem::offset(this.ptr, index));
    }

    /// Raw pointer to the first element. Callers must respect `length`.
    public as_ptr(&this) -> T* {
        return this.ptr;
    }

    /// The sub-slice `[start, end)`. Panics if `start` is negative,
    /// `start > end`, or `end > length`.
    public subslice(&this, start: i64, end: i64) -> Slice<T> {
        if (start < 0 || start > end || end > this.length) {
            core::panic("Slice::subslice: out of range", intrinsics::location());
        }
        return Slice::<T> {
            ptr: mem::offset(this.ptr, start),
            length: end - start
        };
    }

    /// Return an iterator that yields each element by value (bitwise
    /// copy). Gated on `T: Copy` for the same reason as `get`; for
    /// owning `T`, walk by index with `length()` + `get_ref`.
    public iter(&this) -> implement Iterator<T> where T: Copy {
        return SliceIter::<T> { ptr: this.ptr, remaining: this.length };
    }

    /// The element `xs[index]` names, in place: what every `Index`
    /// implementation below answers with.  A negative signed index reads
    /// as a huge unsigned one, so it is out of range too.  Panics on
    /// out-of-range, at the `xs[i]` that asked: this and every `index`
    /// below report their caller's location.
    ![inline]
    ![caller_location]
    private element_at(&this, index: u64) -> T* {
        if (index >= this.length as u64) {
            core::panic("Slice: index out of range", intrinsics::location());
        }
        return mem::offset(this.ptr, index as i64);
    }
}

// `xs[i]` is `*(xs.index(i))`, a place, so these serve reads, writes and
// compound assignment alike; an index outside `[0, length)` panics.  One
// implementation per integer type: an index of any integer type is
// accepted, and the call is answered by the implementation whose `Idx` is
// the index's own type.
implement<T> trait Index<i8, T> for struct Slice<T> {
    ![inline]
    ![caller_location]
    index(&this, i: i8) -> T* { return this.element_at(i as u64); }
}
implement<T> trait Index<i16, T> for struct Slice<T> {
    ![inline]
    ![caller_location]
    index(&this, i: i16) -> T* { return this.element_at(i as u64); }
}
implement<T> trait Index<i32, T> for struct Slice<T> {
    ![inline]
    ![caller_location]
    index(&this, i: i32) -> T* { return this.element_at(i as u64); }
}
implement<T> trait Index<i64, T> for struct Slice<T> {
    ![inline]
    ![caller_location]
    index(&this, i: i64) -> T* { return this.element_at(i as u64); }
}
implement<T> trait Index<isize, T> for struct Slice<T> {
    ![inline]
    ![caller_location]
    index(&this, i: isize) -> T* { return this.element_at(i as u64); }
}
implement<T> trait Index<u8, T> for struct Slice<T> {
    ![inline]
    ![caller_location]
    index(&this, i: u8) -> T* { return this.element_at(i as u64); }
}
implement<T> trait Index<u16, T> for struct Slice<T> {
    ![inline]
    ![caller_location]
    index(&this, i: u16) -> T* { return this.element_at(i as u64); }
}
implement<T> trait Index<u32, T> for struct Slice<T> {
    ![inline]
    ![caller_location]
    index(&this, i: u32) -> T* { return this.element_at(i as u64); }
}
implement<T> trait Index<u64, T> for struct Slice<T> {
    ![inline]
    ![caller_location]
    index(&this, i: u64) -> T* { return this.element_at(i); }
}
implement<T> trait Index<usize, T> for struct Slice<T> {
    ![inline]
    ![caller_location]
    index(&this, i: usize) -> T* { return this.element_at(i as u64); }
}

// Two slices are equal when they have the same length and equal elements
// in order; where they point does not matter.
implement<T> trait Eq for struct Slice<T> where T: Eq {
    equals(&this, other: &Slice<T>) -> boolean {
        if (this.length != other.length()) { return false; }
        mut i: i64 = 0;
        while (i < this.length) {
            if (!this.ptr[i].equals(&other.ptr[i])) { return false; }
            i = i + 1;
        }
        return true;
    }
}

// SliceIter: forward iterator over a Slice<T>.
//
// Internal: both `Slice::iter` (this module) and `Array::iter`
// (`collections::array`) construct it, and no public signature names it -
// callers reach it only as the opaque `implement Iterator<T>` those methods
// return.

internal type struct SliceIter<T> {
    internal ptr: T*;
    internal remaining: i64;
}

implement<T> trait Iterator<T> for struct SliceIter<T> {
    next(mut &this) -> Option<T> {
        if (this.remaining == 0) {
            return Option::None;
        }
        const value: T = *this.ptr;
        this.ptr = mem::offset(this.ptr, 1);
        this.remaining = this.remaining - 1;
        return Option::Some(value);
    }

    /// Override the default; slice length is known O(1).
    count(mut &this) -> i64 {
        const n: i64 = this.remaining;
        this.remaining = 0;
        return n;
    }
}
