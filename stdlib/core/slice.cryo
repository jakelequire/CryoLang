///! Slice<T>: a borrowed view into a contiguous sequence.
///!
///! A slice is only ever borrowed: `&Slice<T>` reads the elements and
///! `mut &Slice<T>` writes them, and either is the two words
///! `(pointer, length)`. Algorithms take slice references; a container
///! hands its elements out through `AsSlice<T>` and `AsMutableSlice<T>`,
///! and a reference to such a container converts to a slice reference
///! where one is wanted, so algorithms need only be written once. A slice
///! does not own its storage; the backing memory must outlive every slice
///! that refers to it.

namespace std::core::slice;

import std::core::intrinsics;
import std::core::cmp::{ Eq, Ord, Ordering };
import std::core::hash::{ Hash, Hasher };
import std::core::ops::{ Index, IndexMutable, IndexView, IndexViewMutable,
                         Range, RangeInclusive, RangeFrom, RangeTo, RangeFull };
import std::core::iter::{ DoubleEndedIterator, Iterator };
import std::core::option::{ Option };
import std::core::mem;

/// A container whose elements can be read as a slice. Where a `&Slice<T>`
/// is wanted, a `&A` or `mut &A` of such a container is given as its
/// `as_slice()`.
![language("as_slice")]
public type trait AsSlice<T> {
    ![language("as_slice_as_slice")]
    as_slice(&this) -> &Slice<T>;
}

/// A container whose elements can be written through a slice. Where a
/// `mut &Slice<T>` is wanted, a `mut &A` of such a container is given as
/// its `as_mutable_slice()`.
![language("as_mutable_slice")]
public type trait AsMutableSlice<T> {
    ![language("as_mutable_slice_as_mutable_slice")]
    as_mutable_slice(mut &this) -> mut &Slice<T>;
}

/// The elements are reached through `ptr`, declared read-only: through a
/// `mut &Slice<T>` it reads as a writable pointer, through a `&Slice<T>`
/// as the read-only one it is.
![language("slice")]
public type struct Slice<T> {
    private ptr: T*;
    private length: i64;

    /// The `length` elements at `ptr`, to read. The caller certifies that
    /// `[ptr, ptr + length)` is valid initialized memory while the slice is
    /// used and that `length` is not negative.
    public static from_raw(ptr: const T*, length: i64) -> &Slice<T> {
        return &Slice::<T> { ptr: ptr, length: length };
    }

    /// The `length` elements at `ptr`, to read and write. The caller
    /// certifies what `from_raw` asks, and that nothing else reads or writes
    /// the elements while the slice is written through.
    public static from_raw_mutable(ptr: mut T*, length: i64) -> mut &Slice<T> {
        return &Slice::<T> { ptr: ptr, length: length };
    }

    ![inline]
    public length(&this) -> i64 {
        return this.length;
    }

    public is_empty(&this) -> boolean {
        return this.length == 0;
    }

    /// Bounds-checked read by value; `None` for an index outside
    /// `[0, length)`, a negative one included. Gated on `T: Copy`: the
    /// result is an independent bitwise duplicate while the backing storage
    /// still owns the element, so this is only sound when `T` carries no
    /// `Drop` obligation. For owning `T`, borrow in place with `get_ref`.
    public get(&this, index: i64) -> Option<T> where T: Copy {
        if (index < 0 || index >= this.length) {
            return Option::None;
        }
        return Option::Some(this.ptr[index]);
    }

    /// Bounds-checked borrow; `None` for an index outside `[0, length)`.
    /// Returns a pointer to the element in place, sound for every `T`. The
    /// pointer is valid only while the backing storage outlives the slice.
    public get_ref(&this, index: i64) -> Option<T*> {
        if (index < 0 || index >= this.length) {
            return Option::None;
        }
        return Option::Some(mem::const_offset(this.ptr, index));
    }

    /// Read-only raw pointer to the first element. Callers must respect
    /// `length`.
    public as_ptr(&this) -> T* {
        return this.ptr;
    }

    /// Writable raw pointer to the first element. Callers must respect
    /// `length`.
    public as_mutable_ptr(mut &this) -> mut T* {
        return this.ptr;
    }

    /// The sub-slice `[start, end)`, to read. Panics if `start` is negative,
    /// `start > end`, or `end > length`.
    public subslice(&this, start: i64, end: i64) -> &Slice<T> {
        if (start < 0 || start > end || end > this.length) {
            core::panic("Slice::subslice: out of range", intrinsics::location());
        }
        return Slice::from_raw(mem::const_offset(this.ptr, start), end - start);
    }

    /// The sub-slice `[start, end)`, to write. Panics as `subslice` does.
    public subslice_mutable(mut &this, start: i64, end: i64) -> mut &Slice<T> {
        if (start < 0 || start > end || end > this.length) {
            core::panic("Slice::subslice_mutable: out of range", intrinsics::location());
        }
        return Slice::from_raw_mutable(mem::offset(this.ptr, start), end - start);
    }

    /// Return an iterator that yields each element by value (bitwise
    /// copy). Gated on `T: Copy` for the same reason as `get`; for
    /// owning `T`, walk by index with `length()` + `get_ref`.
    public iter(&this) -> implement Iterator<T> where T: Copy {
        return SliceIter::<T> { ptr: this.ptr, remaining: this.length };
    }

    /// The element `xs[index]` names, in place: what `Index` and
    /// `IndexMutable` below answer with.  Panics on out-of-range, at the
    /// `xs[i]` that asked: this and both `index` methods report their
    /// caller's location.
    ![inline]
    ![caller_location]
    private element_at<I>(&this, index: I) -> I::Output* where I: SliceIndex<T> {
        const element: I::Output* = index.element_in(this.ptr, this.length);
        if (element == null) {
            core::panic("Slice: index out of range", intrinsics::location());
        }
        return element;
    }

    /// The positions `[start, end)` `range` names among the elements, for
    /// a view.  Panics where either is outside `[0, length]` or the range
    /// starts after its end, at the `xs[r]` that asked: this and every
    /// `view` report their caller's location.
    ![caller_location]
    internal range_bounds<R>(&this, range: &R) -> (i64, i64) where R: SliceRange {
        const positions: (i64, i64) = range.positions_in(this.length);
        if (positions[0] < 0) {
            core::panic("range start is out of bounds", intrinsics::location());
        }
        if (positions[1] < 0) {
            core::panic("range end is out of bounds", intrinsics::location());
        }
        if (positions[0] > positions[1]) {
            core::panic("range starts after its end", intrinsics::location());
        }
        return positions;
    }
}

/// An index `[]` takes on a `Slice<T>` or an `Array<T>`: each integer type,
/// naming one element.  Implemented here alone.
internal type trait SliceIndex<T> {
    /// What the index names.
    type Output;

    /// The element this index names among the `length` at `ptr`, or null
    /// when it is outside them; a negative index is outside every slice.
    element_in(this, ptr: T*, length: i64) -> This::Output*;
}

implement<T> trait SliceIndex<T> for i8 {
    type Output = T;
    ![inline]
    element_in(this, ptr: T*, length: i64) -> T* {
        if (this as u64 >= length as u64) { return null; }
        return &ptr[this];
    }
}
implement<T> trait SliceIndex<T> for i16 {
    type Output = T;
    ![inline]
    element_in(this, ptr: T*, length: i64) -> T* {
        if (this as u64 >= length as u64) { return null; }
        return &ptr[this];
    }
}
implement<T> trait SliceIndex<T> for i32 {
    type Output = T;
    ![inline]
    element_in(this, ptr: T*, length: i64) -> T* {
        if (this as u64 >= length as u64) { return null; }
        return &ptr[this];
    }
}
implement<T> trait SliceIndex<T> for i64 {
    type Output = T;
    ![inline]
    element_in(this, ptr: T*, length: i64) -> T* {
        if (this as u64 >= length as u64) { return null; }
        return &ptr[this];
    }
}
implement<T> trait SliceIndex<T> for isize {
    type Output = T;
    ![inline]
    element_in(this, ptr: T*, length: i64) -> T* {
        if (this as u64 >= length as u64) { return null; }
        return &ptr[this];
    }
}
implement<T> trait SliceIndex<T> for u8 {
    type Output = T;
    ![inline]
    element_in(this, ptr: T*, length: i64) -> T* {
        if (this as u64 >= length as u64) { return null; }
        return &ptr[this];
    }
}
implement<T> trait SliceIndex<T> for u16 {
    type Output = T;
    ![inline]
    element_in(this, ptr: T*, length: i64) -> T* {
        if (this as u64 >= length as u64) { return null; }
        return &ptr[this];
    }
}
implement<T> trait SliceIndex<T> for u32 {
    type Output = T;
    ![inline]
    element_in(this, ptr: T*, length: i64) -> T* {
        if (this as u64 >= length as u64) { return null; }
        return &ptr[this];
    }
}
implement<T> trait SliceIndex<T> for u64 {
    type Output = T;
    ![inline]
    element_in(this, ptr: T*, length: i64) -> T* {
        if (this >= length as u64) { return null; }
        return &ptr[this];
    }
}
implement<T> trait SliceIndex<T> for usize {
    type Output = T;
    ![inline]
    element_in(this, ptr: T*, length: i64) -> T* {
        if (this as u64 >= length as u64) { return null; }
        return &ptr[this];
    }
}

// `xs[i]` read is `*(xs.index(i))` and written is
// `*(xs.index_mutable(i))`; an index outside `[0, length)` panics.  An
// index of any integer type is accepted, and each call binds `I` to the
// index's own type.
implement<T, I> trait Index<I> for struct Slice<T> where I: SliceIndex<T> {
    type Output = I::Output;
    ![inline]
    ![caller_location]
    index(&this, i: I) -> const I::Output* { return this.element_at(i); }
}
implement<T, I> trait IndexMutable<I> for struct Slice<T> where I: SliceIndex<T> {
    ![inline]
    ![caller_location]
    index_mutable(mut &this, i: I) -> mut I::Output* { return this.element_at(i); }
}

/// A position a range names among the elements of a `Slice<T>`, an
/// `Array<T>` or a string: each integer type.  Implemented here alone.
internal type trait SlicePosition {
    /// This position among `length` elements, from `0` to `length`
    /// inclusive, or -1 when it is outside them; a negative position is
    /// outside every slice.
    position_in(&this, length: i64) -> i64;
}

implement trait SlicePosition for i8 {
    ![inline]
    position_in(&this, length: i64) -> i64 { if (this as u64 > length as u64) { return -1; } return this as i64; }
}
implement trait SlicePosition for i16 {
    ![inline]
    position_in(&this, length: i64) -> i64 { if (this as u64 > length as u64) { return -1; } return this as i64; }
}
implement trait SlicePosition for i32 {
    ![inline]
    position_in(&this, length: i64) -> i64 { if (this as u64 > length as u64) { return -1; } return this as i64; }
}
implement trait SlicePosition for i64 {
    ![inline]
    position_in(&this, length: i64) -> i64 { if (this as u64 > length as u64) { return -1; } return this; }
}
implement trait SlicePosition for isize {
    ![inline]
    position_in(&this, length: i64) -> i64 { if (this as u64 > length as u64) { return -1; } return this as i64; }
}
implement trait SlicePosition for u8 {
    ![inline]
    position_in(&this, length: i64) -> i64 { if (this as u64 > length as u64) { return -1; } return this as i64; }
}
implement trait SlicePosition for u16 {
    ![inline]
    position_in(&this, length: i64) -> i64 { if (this as u64 > length as u64) { return -1; } return this as i64; }
}
implement trait SlicePosition for u32 {
    ![inline]
    position_in(&this, length: i64) -> i64 { if (this as u64 > length as u64) { return -1; } return this as i64; }
}
implement trait SlicePosition for u64 {
    ![inline]
    position_in(&this, length: i64) -> i64 { if (this > length as u64) { return -1; } return this as i64; }
}
implement trait SlicePosition for usize {
    ![inline]
    position_in(&this, length: i64) -> i64 { if (this as u64 > length as u64) { return -1; } return this as i64; }
}

/// A range `[]` takes on a `Slice<T>`, an `Array<T>` or a string, viewing
/// part of it: `a..b`, `a..=b`, `a..`, `..b` and `..`, over each integer
/// type.  Implemented here alone.
internal type trait SliceRange {
    /// The positions `[start, end)` this range names among `length`
    /// elements, each -1 where it is outside them.
    positions_in(&this, length: i64) -> (i64, i64);
}

implement<I> trait SliceRange for struct Range<I> where I: SlicePosition {
    positions_in(&this, length: i64) -> (i64, i64) {
        return (this.start.position_in(length), this.end.position_in(length));
    }
}

/// The end names the last element, so it is a position only short of
/// `length`.
implement<I> trait SliceRange for struct RangeInclusive<I> where I: SlicePosition {
    positions_in(&this, length: i64) -> (i64, i64) {
        const last: i64 = this.end.position_in(length);
        const end: i64 = if (last < 0 || last == length) { -1 } else { last + 1 };
        return (this.start.position_in(length), end);
    }
}

implement<I> trait SliceRange for struct RangeFrom<I> where I: SlicePosition {
    positions_in(&this, length: i64) -> (i64, i64) {
        return (this.start.position_in(length), length);
    }
}

implement<I> trait SliceRange for struct RangeTo<I> where I: SlicePosition {
    positions_in(&this, length: i64) -> (i64, i64) {
        return (0, this.end.position_in(length));
    }
}

implement trait SliceRange for struct RangeFull {
    positions_in(&this, length: i64) -> (i64, i64) {
        return (0, length);
    }
}

// `xs[r]` with a range `r` is the part of the slice `r` names: read, it is
// `xs.view(r)`, a `&Slice<T>`, and written, `xs.view_mutable(r)`, a
// `mut &Slice<T>`.  A range reaching outside `[0, length]`, or starting
// after its end, panics.
implement<T, R> trait IndexView<R> for struct Slice<T> where R: SliceRange {
    type View = &Slice<T>;
    ![inline]
    ![caller_location]
    view(&this, range: R) -> &Slice<T> {
        const bounds: (i64, i64) = this.range_bounds(&range);
        return Slice::from_raw(mem::const_offset(this.ptr, bounds[0]), bounds[1] - bounds[0]);
    }
}
implement<T, R> trait IndexViewMutable<R> for struct Slice<T> where R: SliceRange {
    type ViewMutable = mut &Slice<T>;
    ![inline]
    ![caller_location]
    view_mutable(mut &this, range: R) -> mut &Slice<T> {
        const bounds: (i64, i64) = this.range_bounds(&range);
        return Slice::from_raw_mutable(mem::offset(this.ptr, bounds[0]), bounds[1] - bounds[0]);
    }
}

// Two slices are equal when they have the same length and equal elements
// in order; where they point does not matter.
implement<T> trait Eq for struct Slice<T> where T: Eq {
    equals(&this, other: &Slice<T>) -> boolean {
        if (this.length != other.length()) { return false; }
        mut i: i64 = 0;
        while (i < this.length) {
            if (!this.ptr[i].equals(&other.ptr[i])) { return false; }
            i = i + 1;
        }
        return true;
    }
}

// Slices order lexicographically: the first pair of unequal elements
// decides, and a slice that is a prefix of the other orders first.
implement<T> trait Ord for struct Slice<T> where T: Ord {
    compare(&this, other: &Slice<T>) -> Ordering {
        const shared: i64 = if (this.length < other.length()) { this.length } else { other.length() };
        mut i: i64 = 0;
        while (i < shared) {
            const order: Ordering = this.ptr[i].compare(&other.ptr[i]);
            match (order) {
                Ordering::Equal => { }
                _ => { return order; }
            }
            i = i + 1;
        }
        return this.length.compare(&other.length());
    }
}

// The length, then each element in order, as an `Array` hashes: two
// slices equal under `Eq` hash alike wherever they point, the length keeps
// adjacent slices from trading elements (`[1, 2]` then `[3]` against `[1]`
// then `[2, 3]`), and a slice hashes as the `Array` it views does.
implement<T> trait Hash for struct Slice<T> where T: Hash {
    hash<H>(&this, hasher: mut &H) -> void
    where H: Hasher {
        this.length.hash(hasher);
        mut i: i64 = 0;
        while (i < this.length) {
            this.ptr[i].hash(hasher);
            i = i + 1;
        }
    }
}

// SliceIter: forward iterator over a Slice<T>.
//
// Internal: both `Slice::iter` (this module) and `Array::iter`
// (`collections::array`) construct it, and no public signature names it -
// callers reach it only as the opaque `implement Iterator<T>` those methods
// return.

internal type struct SliceIter<T> {
    internal ptr: T*;
    internal remaining: i64;
}

implement<T> trait Iterator<T> for struct SliceIter<T> {
    next(mut &this) -> Option<T> {
        if (this.remaining == 0) {
            return Option::None;
        }
        const value: T = *this.ptr;
        this.ptr = mem::const_offset(this.ptr, 1);
        this.remaining = this.remaining - 1;
        return Option::Some(value);
    }

    /// Override the default; slice length is known O(1).
    count(mut &this) -> i64 {
        const n: i64 = this.remaining;
        this.remaining = 0;
        return n;
    }
}

/// The back end is the last of the `remaining` elements from `ptr`.
implement<T> trait DoubleEndedIterator for struct SliceIter<T> {
    next_back(mut &this) -> Option<T> {
        if (this.remaining == 0) {
            return Option::None;
        }
        this.remaining = this.remaining - 1;
        return Option::Some(*mem::const_offset(this.ptr, this.remaining));
    }
}
