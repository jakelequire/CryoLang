///! Slice<T>: a borrowed view into a contiguous sequence.
///!
///! `Slice<T>` is `(pointer, length)`. Algorithms operate on slices;
///! collections expose `as_slice()` so algorithms need only be written
///! once. A slice does not own its storage; the backing memory must
///! outlive every slice that refers to it.

namespace std::core::slice;

import core::intrinsics;
import core::iter;
import core::option;
import core::mem;

type struct Slice<T> {
    ptr: T*;
    length: u64;

    /// Construct from a raw pointer and length. The caller certifies
    /// that `[ptr, ptr + length)` is valid initialized memory for as
    /// long as the slice exists.
    static from_raw(ptr: T*, length: u64) -> Slice<T> {
        return Slice<T> { ptr: ptr, length: length };
    }

    length(&this) -> u64 {
        return this.length;
    }

    is_empty(&this) -> boolean {
        return this.length == 0;
    }

    /// Bounds-checked read by value. Gated on `T: Copy`: the result is
    /// an independent bitwise duplicate while the backing storage still
    /// owns the element, so this is only sound when `T` carries no `Drop`
    /// obligation. For owning `T`, borrow in place with `get_ref`.
    get(&this, index: u64) -> Option<T> where T: Copy {
        if (index >= this.length) {
            return Option::None;
        }
        return Option::Some(this.ptr[index]);
    }

    /// Bounds-checked borrow. Returns a pointer to the element in place,
    /// sound for every `T`. The pointer is valid only while the backing
    /// storage outlives the slice.
    get_ref(&this, index: u64) -> Option<T*> {
        if (index >= this.length) {
            return Option::None;
        }
        return Option::Some(mem::offset(this.ptr, index as i64));
    }

    /// Raw pointer to the first element. Callers must respect `length`.
    as_ptr(&this) -> T* {
        return this.ptr;
    }

    /// The sub-slice `[start, end)`. Panics if `start > end` or
    /// `end > length`.
    subslice(&this, start: u64, end: u64) -> Slice<T> {
        if (start > end || end > this.length) {
            intrinsics::panic("Slice::subslice: out of range", FILE, LINE);
        }
        return Slice<T> {
            ptr: mem::offset(this.ptr, start as i64),
            length: end - start
        };
    }

    /// Return an iterator that yields each element by value (bitwise
    /// copy). Gated on `T: Copy` for the same reason as `get`; for
    /// owning `T`, walk by index with `length()` + `get_ref`.
    iter(&this) -> SliceIter<T> where T: Copy {
        return SliceIter<T> { ptr: this.ptr, remaining: this.length };
    }
}

// SliceIter: forward iterator over a Slice<T>

type struct SliceIter<T> {
    ptr: T*;
    remaining: u64;
}

implement<T> trait Iterator<T> for struct SliceIter<T> {
    next(mut &this) -> Option<T> {
        if (this.remaining == 0) {
            return Option::None;
        }
        const value: T = *this.ptr;
        this.ptr = mem::offset(this.ptr, 1);
        this.remaining = this.remaining - 1;
        return Option::Some(value);
    }

    /// Override the default; slice length is known O(1).
    count(mut &this) -> u64 {
        const n: u64 = this.remaining;
        this.remaining = 0;
        return n;
    }
}
