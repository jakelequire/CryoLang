///! NonNull<T>: a pointer guaranteed non-null by construction.
///!
///! Higher-level owning pointers (`Box`, `Rc`, `Arc`) live in `alloc/`.

namespace std::core::ptr;

import core::intrinsics;
import core::mem;

type struct NonNull<T> {
    ptr: T*;

    /// Construct from a raw pointer, aborting if it's null. Check once
    /// at the ownership boundary so downstream code can rely on the
    /// invariant.
    static new(raw: T*) -> NonNull<T> {
        if (raw == null) {
            intrinsics::panic("NonNull::new called with a null pointer", FILE, LINE);
        }
        return NonNull<T> { ptr: raw };
    }

    as_ptr(&this) -> T* {
        return this.ptr;
    }

    /// Offset by `count` elements (not bytes). Negative values walk
    /// backwards.
    offset(&this, count: i64) -> NonNull<T> {
        return NonNull<T> { ptr: mem::offset(this.ptr, count) };
    }

    /// Reinterpret this pointer as pointing to a different type. The new
    /// type must share alignment requirements with `T`; the compiler
    /// cannot check this.
    cast<U>(&this) -> NonNull<U> {
        return NonNull<U> { ptr: this.ptr as U* };
    }
}
