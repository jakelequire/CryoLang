///! Methods on primitive types.
///!
///! Cryo lets `implement` blocks extend primitive types. This module uses
///! that sparingly, only for things that aren't already one-liners with
///! the built-in operators.
///!
///! Heavy numeric operations such as pow, log, and gcd are not defined
///! here; they belong in a dedicated numeric-operations module that spans
///! all widths through traits.
///!
///! ## Integer overflow contract (frozen for 1.0)
///!
///! Integer arithmetic on every width is silent two's-complement
///! **wrapping** on overflow - there is no trap and no diagnostic. This is
///! a deliberate, frozen part of the 1.0 surface; Cryo ships no
///! `checked_*` / `wrapping_*` / `saturating_*` family. Code that must
///! detect overflow has to range-check its operands first. The wrapping
///! `abs` methods below are one visible consequence (see each `abs`).
///!
///! ## Buffer-write formatting
///!
///! Integer-to-ASCII conversion lives as `to_decimal_buf` / `to_hex_buf` /
///! `to_oct_buf` / `to_bin_buf` methods on the unsigned types (and
///! `to_decimal_buf` on signed). They write into a caller-owned `u8*`
///! and return the number of bytes written. No heap traffic: the digit
///! loop runs in a stack scratch and copies in one shot. Float
///! formatting lives in `fmt::float` because it needs libm; layering
///! keeps libc out of `core`.

namespace std::core::primitives;

import std::core::intrinsics;
import std::alloc::allocator;

// Digit-count upper bounds: caller picks a buffer at least this big.

// Unsigned decimal: digits of the type's max value.
const U8_MAX_DECIMAL_DIGITS:  u64 = 3;   // "255"
const U16_MAX_DECIMAL_DIGITS: u64 = 5;   // "65535"
const U32_MAX_DECIMAL_DIGITS: u64 = 10;  // "4294967295"
const U64_MAX_DECIMAL_DIGITS: u64 = 20;  // "18446744073709551615"
const U128_MAX_DECIMAL_DIGITS: u64 = 39; // "340282366920938463463374607431768211455"

// Signed decimal: sign + magnitude digits.
const I8_MAX_DECIMAL_DIGITS:  u64 = 4;   // "-128"
const I16_MAX_DECIMAL_DIGITS: u64 = 6;   // "-32768"
const I32_MAX_DECIMAL_DIGITS: u64 = 11;  // "-2147483648"
const I64_MAX_DECIMAL_DIGITS: u64 = 20;  // "-9223372036854775808"
const I128_MAX_DECIMAL_DIGITS: u64 = 40; // "-170141183460469231731687303715884105728"

// Hex: 2 nibbles per byte of the type.
const U8_MAX_HEX_DIGITS:  u64 = 2;
const U16_MAX_HEX_DIGITS: u64 = 4;
const U32_MAX_HEX_DIGITS: u64 = 8;
const U64_MAX_HEX_DIGITS: u64 = 16;
const U128_MAX_HEX_DIGITS: u64 = 32;

// Octal: digits to represent the type's max value.
const U8_MAX_OCT_DIGITS:  u64 = 3;
const U16_MAX_OCT_DIGITS: u64 = 6;
const U32_MAX_OCT_DIGITS: u64 = 11;
const U64_MAX_OCT_DIGITS: u64 = 22;
const U128_MAX_OCT_DIGITS: u64 = 43;     // ceil(128 / 3)

// Binary: one digit per bit of the type.
const U8_MAX_BIN_DIGITS:  u64 = 8;
const U16_MAX_BIN_DIGITS: u64 = 16;
const U32_MAX_BIN_DIGITS: u64 = 32;
const U64_MAX_BIN_DIGITS: u64 = 64;
const U128_MAX_BIN_DIGITS: u64 = 128;

// Character classification. Each of these aggregates a range check
// readers otherwise have to squint at.
implement char {
    is_digit(&this) -> boolean {
        return this >= '0' && this <= '9';
    }

    is_alpha(&this) -> boolean {
        return (this >= 'A' && this <= 'Z') || (this >= 'a' && this <= 'z');
    }

    is_alphanumeric(&this) -> boolean {
        return this.is_alpha() || this.is_digit();
    }

    /// ASCII hexadecimal digit: `0`-`9`, `a`-`f`, or `A`-`F`.
    is_hex_digit(&this) -> boolean {
        return this.is_digit()
            || (this >= 'a' && this <= 'f')
            || (this >= 'A' && this <= 'F');
    }

    is_whitespace(&this) -> boolean {
        return this == ' ' || this == '\t' || this == '\n'
            || this == '\r' || this == '\v' || this == '\f';
    }

    /// True when the scalar is in the 7-bit ASCII range (0..=127).
    is_ascii(&this) -> boolean {
        return (this as u32) < 128;
    }

    /// ASCII fold to lowercase. Non-ASCII scalars pass through unchanged;
    /// full Unicode case folding requires a table beyond this module.
    to_ascii_lowercase(&this) -> char {
        if (this >= 'A' && this <= 'Z') {
            return (this as u32 + 32) as char;
        }
        return this;
    }

    /// ASCII fold to uppercase. Non-ASCII scalars pass through unchanged.
    to_ascii_uppercase(&this) -> char {
        if (this >= 'a' && this <= 'z') {
            return (this as u32 - 32) as char;
        }
        return this;
    }

    /// Numeric value of a hex digit (`0`-`9`, `a`-`f`, `A`-`F`), or -1 when
    /// `this` is not a hex digit. Consolidates the nibble-decode loops that
    /// the compiler hand-rolls in literal/char parsing.
    hex_value(&this) -> i32 {
        if (this >= '0' && this <= '9') { return (this as u32 - ('0' as u32)) as i32; }
        if (this >= 'a' && this <= 'f') { return (this as u32 - ('a' as u32) + 10) as i32; }
        if (this >= 'A' && this <= 'F') { return (this as u32 - ('A' as u32) + 10) as i32; }
        return -1;
    }

    /// True when `this` may begin a C identifier: an ASCII letter or `_`.
    is_c_ident_start(&this) -> boolean {
        return this.is_alpha() || this == '_';
    }

    /// True when `this` may continue a C identifier: letter, digit, or `_`.
    is_c_ident_char(&this) -> boolean {
        return this.is_alphanumeric() || this == '_';
    }
}

// Range bounds + abs for the signed integer widths. `abs` wraps at the
// type's min_value (two's complement has no positive counterpart for
// the most-negative value): `i8::min_value().abs()` is `-128`, not `128`.
// This is frozen behavior for 1.0 - there is no `checked_abs`. Narrower
// widths delegate to `i64`
// for the decimal-write digit loop so the implementation lives in one
// place (down in the `implement i64` block).
implement i8 {
    static min_value() -> i8 { return -128 as i8; }
    static max_value() -> i8 { return 127 as i8; }

    abs(&this) -> i8 {
        if (this < 0) { return -this as i8; }
        return this;
    }

    /// Buffer must hold at least `I8_MAX_DECIMAL_DIGITS` bytes.
    to_decimal_buf(&this, buffer: u8*) -> u64 {
        const v: i64 = this as i64;
        return v.to_decimal_buf(buffer);
    }
}

implement i16 {
    static min_value() -> i16 { return -32768; }
    static max_value() -> i16 { return 32767; }

    abs(&this) -> i16 {
        if (this < 0) { return -this as i16; }
        return this;
    }

    /// Buffer must hold at least `I16_MAX_DECIMAL_DIGITS` bytes.
    to_decimal_buf(&this, buffer: u8*) -> u64 {
        const v: i64 = this as i64;
        return v.to_decimal_buf(buffer);
    }
}

implement i32 {
    static min_value() -> i32 { return -2147483648; }
    static max_value() -> i32 { return 2147483647; }

    /// Wraps at `i32::min_value()`: the most-negative value has no
    /// positive counterpart in two's complement, so `i32::min_value().abs()`
    /// is itself. Frozen for 1.0 - there is no `checked_abs`.
    abs(&this) -> i32 {
        if (this < 0) { return -this; }
        return this;
    }

    /// Buffer must hold at least `I32_MAX_DECIMAL_DIGITS` bytes.
    to_decimal_buf(&this, buffer: u8*) -> u64 {
        const v: i64 = this as i64;
        return v.to_decimal_buf(buffer);
    }
}

implement i64 {
    static min_value() -> i64 { return -9223372036854775808; }
    static max_value() -> i64 { return 9223372036854775807; }

    abs(&this) -> i64 {
        if (this < 0) { return -this; }
        return this;
    }
}

// Unsigned range bounds + buffer-write formatting.  Narrower widths
// (`u8`, `u16`, `u32`) zero-extend to `u64` and delegate the digit loop
// to `u64`'s methods; the implementation lives in one place. Callers
// pick a smaller buffer per the `UN_MAX_*_DIGITS` constants above; the
// u64 implementation writes only the digits it needs.
implement u8 {
    static min_value() -> u8 { return 0 as u8; }
    static max_value() -> u8 { return 255 as u8; }

    to_decimal_buf(&this, buffer: u8*) -> u64 {
        const v: u64 = this as u64;
        return v.to_decimal_buf(buffer);
    }

    to_hex_buf(&this, buffer: u8*) -> u64 {
        const v: u64 = this as u64;
        return v.to_hex_buf(buffer);
    }

    to_hex_upper_buf(&this, buffer: u8*) -> u64 {
        const v: u64 = this as u64;
        return v.to_hex_upper_buf(buffer);
    }

    to_oct_buf(&this, buffer: u8*) -> u64 {
        const v: u64 = this as u64;
        return v.to_oct_buf(buffer);
    }

    to_bin_buf(&this, buffer: u8*) -> u64 {
        const v: u64 = this as u64;
        return v.to_bin_buf(buffer);
    }
}

implement u16 {
    static min_value() -> u16 { return 0 as u16; }
    static max_value() -> u16 { return 65535 as u16; }

    to_decimal_buf(&this, buffer: u8*) -> u64 {
        const v: u64 = this as u64;
        return v.to_decimal_buf(buffer);
    }

    to_hex_buf(&this, buffer: u8*) -> u64 {
        const v: u64 = this as u64;
        return v.to_hex_buf(buffer);
    }

    to_hex_upper_buf(&this, buffer: u8*) -> u64 {
        const v: u64 = this as u64;
        return v.to_hex_upper_buf(buffer);
    }

    to_oct_buf(&this, buffer: u8*) -> u64 {
        const v: u64 = this as u64;
        return v.to_oct_buf(buffer);
    }

    to_bin_buf(&this, buffer: u8*) -> u64 {
        const v: u64 = this as u64;
        return v.to_bin_buf(buffer);
    }
}

implement u32 {
    static min_value() -> u32 { return 0 as u32; }
    static max_value() -> u32 { return 4294967295; }

    to_decimal_buf(&this, buffer: u8*) -> u64 {
        const v: u64 = this as u64;
        return v.to_decimal_buf(buffer);
    }

    to_hex_buf(&this, buffer: u8*) -> u64 {
        const v: u64 = this as u64;
        return v.to_hex_buf(buffer);
    }

    to_hex_upper_buf(&this, buffer: u8*) -> u64 {
        const v: u64 = this as u64;
        return v.to_hex_upper_buf(buffer);
    }

    to_oct_buf(&this, buffer: u8*) -> u64 {
        const v: u64 = this as u64;
        return v.to_oct_buf(buffer);
    }

    to_bin_buf(&this, buffer: u8*) -> u64 {
        const v: u64 = this as u64;
        return v.to_bin_buf(buffer);
    }
}

implement u64 {
    static min_value() -> u64 { return 0 as u64; }
    static max_value() -> u64 { return 18446744073709551615; }

    // Buffer-write formatting. Each writes into a caller-owned `u8*` and
    // returns the number of bytes written. The caller picks the buffer
    // size from the `U64_MAX_*_DIGITS` constants above. This is the
    // canonical implementation; the narrower unsigned widths
    // (`u8`/`u16`/`u32`) above zero-extend to `u64` and reuse it.

    /// Write `this` in base 10 into `buffer`. Returns bytes written.
    /// `buffer` must hold at least `U64_MAX_DECIMAL_DIGITS` bytes.
    /// Builds the digits on a 20-byte stack scratch then copies in one
    /// shot; no heap traffic.
    to_decimal_buf(&this, buffer: u8*) -> u64 {
        if (this == 0) {
            buffer[0] = 0x30;
            return 1;
        }
        mut scratch: u8[20];
        mut cursor: u64 = 20;
        mut v: u64 = this;
        while (v > 0) {
            cursor = cursor - 1;
            scratch[cursor] = ((v % 10) as u8) + 0x30;
            v = v / 10;
        }
        const digits: u64 = 20 - cursor;
        intrinsics::memcpy(
            buffer as void*,
            (&scratch[0] + cursor) as void*,
            digits
        );
        return digits;
    }

    /// Decimal text on a fresh heap buffer (caller owns), mirroring C's
    /// `"%llu"`.  For a no-alloc path, write into your own buffer with
    /// `to_decimal_buf`.
    to_decimal_str(&this) -> string {
        mut buf: string = allocator::alloc(24, 1) as string;
        if ((buf as void*) == null) {
            core::panic("u64::to_decimal_str: allocation failed", FILE, LINE);
        }
        const n: u64 = this.to_decimal_buf(buf as u8*);
        buf[n] = 0;
        return buf;
    }

    /// Lowercase hex. Returns bytes written.
    /// `buffer` must hold at least `U64_MAX_HEX_DIGITS` bytes.
    to_hex_buf(&this, buffer: u8*) -> u64 {
        return u64::to_hex_buf_with_table(this, buffer, "0123456789abcdef" as u8*);
    }

    /// Uppercase variant.
    to_hex_upper_buf(&this, buffer: u8*) -> u64 {
        return u64::to_hex_buf_with_table(this, buffer, "0123456789ABCDEF" as u8*);
    }

    /// Internal: hex writer parameterised by the digit table. Stays as a
    /// static helper rather than another method to avoid passing the
    /// table through `&this`.
    static to_hex_buf_with_table(value: u64, buffer: u8*, digits_table: u8*) -> u64 {
        if (value == 0) {
            buffer[0] = 0x30;
            return 1;
        }
        mut scratch: u8[16];
        mut cursor: u64 = 16;
        mut v: u64 = value;
        while (v > 0) {
            cursor = cursor - 1;
            scratch[cursor] = digits_table[v & 0xF];
            v = v >> 4;
        }
        const digits: u64 = 16 - cursor;
        intrinsics::memcpy(
            buffer as void*,
            (&scratch[0] + cursor) as void*,
            digits
        );
        return digits;
    }

    /// Zero-padded fixed-width hex. Writes exactly `width` characters,
    /// truncating high nibbles if the value doesn't fit. Useful for
    /// pointer formatting (`width = 16`), hash dumps, binary protocols.
    to_hex_padded_buf(&this, buffer: u8*, width: u64) -> u64 {
        return u64::to_hex_padded_buf_with_table(this, buffer, width, "0123456789abcdef" as u8*);
    }

    /// Zero-padded fixed-width lowercase hex on a fresh heap buffer (caller
    /// owns): exactly `width` characters plus a NUL.  `width = 16` renders a
    /// full u64 (the pointer/hash-dump convention).
    to_hex_padded_str(&this, width: u64) -> string {
        mut buf: string = allocator::alloc(width + 1, 1) as string;
        if ((buf as void*) == null) {
            core::panic("u64::to_hex_padded_str: allocation failed", FILE, LINE);
        }
        const n: u64 = this.to_hex_padded_buf(buf as u8*, width);
        buf[n] = 0;
        return buf;
    }

    to_hex_padded_upper_buf(&this, buffer: u8*, width: u64) -> u64 {
        return u64::to_hex_padded_buf_with_table(this, buffer, width, "0123456789ABCDEF" as u8*);
    }

    static to_hex_padded_buf_with_table(value: u64, buffer: u8*, width: u64,
                                         digits_table: u8*) -> u64 {
        if (width == 0) { return 0; }
        mut v: u64 = value;
        mut i: u64 = width;
        while (i > 0) {
            i = i - 1;
            buffer[i] = digits_table[v & 0xF];
            v = v >> 4;
        }
        return width;
    }

    /// Base 8. `buffer` must hold at least `U64_MAX_OCT_DIGITS` bytes.
    to_oct_buf(&this, buffer: u8*) -> u64 {
        if (this == 0) {
            buffer[0] = 0x30;
            return 1;
        }
        mut scratch: u8[22];
        mut cursor: u64 = 22;
        mut v: u64 = this;
        while (v > 0) {
            cursor = cursor - 1;
            scratch[cursor] = ((v & 0x7) as u8) + 0x30;
            v = v >> 3;
        }
        const digits: u64 = 22 - cursor;
        intrinsics::memcpy(
            buffer as void*,
            (&scratch[0] + cursor) as void*,
            digits
        );
        return digits;
    }

    /// Base 2. `buffer` must hold at least `U64_MAX_BIN_DIGITS` bytes.
    to_bin_buf(&this, buffer: u8*) -> u64 {
        if (this == 0) {
            buffer[0] = 0x30;
            return 1;
        }
        mut scratch: u8[64];
        mut cursor: u64 = 64;
        mut v: u64 = this;
        while (v > 0) {
            cursor = cursor - 1;
            scratch[cursor] = ((v & 0x1) as u8) + 0x30;
            v = v >> 1;
        }
        const digits: u64 = 64 - cursor;
        intrinsics::memcpy(
            buffer as void*,
            (&scratch[0] + cursor) as void*,
            digits
        );
        return digits;
    }

    /// Zero-padded fixed-width decimal. Writes exactly `width` digits,
    /// truncating the high end if the value doesn't fit. Used for the
    /// fractional piece of a float where the digit count is known
    /// ahead of time.
    to_decimal_padded_buf(&this, buffer: u8*, width: u64) -> u64 {
        if (width == 0) { return 0; }
        mut v: u64 = this;
        mut i: u64 = width;
        while (i > 0) {
            i = i - 1;
            buffer[i] = ((v % 10) as u8) + 0x30;
            v = v / 10;
        }
        return width;
    }
}

implement i64 {
    /// Write signed `this` in base 10. Returns bytes written.
    /// `buffer` must hold at least `I64_MAX_DECIMAL_DIGITS` bytes.
    to_decimal_buf(&this, buffer: u8*) -> u64 {
        if (this < 0) {
            buffer[0] = 0x2D; // '-'
            // `-i64::MIN` overflows in i64 but wraps to the correct u64
            // magnitude.
            const magnitude: u64 = (0 - this) as u64;
            return 1 + magnitude.to_decimal_buf(buffer + 1);
        }
        const v: u64 = this as u64;
        return v.to_decimal_buf(buffer);
    }

    /// Decimal text on a fresh heap buffer (caller owns), mirroring C's
    /// `"%lld"`.  For a no-alloc path, write into your own buffer with
    /// `to_decimal_buf`.
    to_decimal_str(&this) -> string {
        mut buf: string = allocator::alloc(24, 1) as string;
        if ((buf as void*) == null) {
            core::panic("i64::to_decimal_str: allocation failed", FILE, LINE);
        }
        const n: u64 = this.to_decimal_buf(buf as u8*);
        buf[n] = 0;
        return buf;
    }
}

// 128-bit integers. `u128` is the canonical implementation (mirrors `u64`,
// just wider); `i128` handles the sign and delegates the magnitude to `u128`.
// Unlike the <=64-bit widths these can't widen-and-delegate to a smaller type,
// so the digit loop is written out here. 128-bit `/`, `%`, `<<`, `>>` lower to
// native LLVM ops except `/` and `%`, which lower to libgcc/compiler-rt
// (`__udivti3` / `__umodti3`); gcc links those by default.
implement u128 {
    static min_value() -> u128 { return 0 as u128; }
    static max_value() -> u128 {
        // 2^128 - 1, above u64::MAX so it must go through the 128-bit literal
        // path; bind to a typed const to pin the target width.
        const m: u128 = 340282366920938463463374607431768211455;
        return m;
    }

    /// Write `this` in base 10 into `buffer`. Returns bytes written.
    /// `buffer` must hold at least `U128_MAX_DECIMAL_DIGITS` bytes.
    to_decimal_buf(&this, buffer: u8*) -> u64 {
        if (this == 0) {
            buffer[0] = 0x30;
            return 1;
        }
        mut scratch: u8[39];
        mut cursor: u64 = 39;
        mut v: u128 = this;
        while (v > 0) {
            cursor = cursor - 1;
            scratch[cursor] = ((v % 10) as u8) + 0x30;
            v = v / 10;
        }
        const digits: u64 = 39 - cursor;
        intrinsics::memcpy(
            buffer as void*,
            (&scratch[0] + cursor) as void*,
            digits
        );
        return digits;
    }

    /// Decimal text on a fresh heap buffer (caller owns).  For a no-alloc
    /// path, write into your own buffer with `to_decimal_buf`.
    to_decimal_str(&this) -> string {
        mut buf: string = allocator::alloc(40, 1) as string;   // 39 digits + NUL
        if ((buf as void*) == null) {
            core::panic("u128::to_decimal_str: allocation failed", FILE, LINE);
        }
        const n: u64 = this.to_decimal_buf(buf as u8*);
        buf[n] = 0;
        return buf;
    }

    /// Lowercase hex. `buffer` must hold at least `U128_MAX_HEX_DIGITS` bytes.
    to_hex_buf(&this, buffer: u8*) -> u64 {
        return u128::to_hex_buf_with_table(this, buffer, "0123456789abcdef" as u8*);
    }

    /// Uppercase variant.
    to_hex_upper_buf(&this, buffer: u8*) -> u64 {
        return u128::to_hex_buf_with_table(this, buffer, "0123456789ABCDEF" as u8*);
    }

    static to_hex_buf_with_table(value: u128, buffer: u8*, digits_table: u8*) -> u64 {
        if (value == 0) {
            buffer[0] = 0x30;
            return 1;
        }
        mut scratch: u8[32];
        mut cursor: u64 = 32;
        mut v: u128 = value;
        while (v > 0) {
            cursor = cursor - 1;
            scratch[cursor] = digits_table[(v & 0xF) as u64];
            v = v >> 4;
        }
        const digits: u64 = 32 - cursor;
        intrinsics::memcpy(
            buffer as void*,
            (&scratch[0] + cursor) as void*,
            digits
        );
        return digits;
    }

    /// Base 8. `buffer` must hold at least `U128_MAX_OCT_DIGITS` bytes.
    to_oct_buf(&this, buffer: u8*) -> u64 {
        if (this == 0) {
            buffer[0] = 0x30;
            return 1;
        }
        mut scratch: u8[43];
        mut cursor: u64 = 43;
        mut v: u128 = this;
        while (v > 0) {
            cursor = cursor - 1;
            scratch[cursor] = ((v & 0x7) as u8) + 0x30;
            v = v >> 3;
        }
        const digits: u64 = 43 - cursor;
        intrinsics::memcpy(
            buffer as void*,
            (&scratch[0] + cursor) as void*,
            digits
        );
        return digits;
    }

    /// Base 2. `buffer` must hold at least `U128_MAX_BIN_DIGITS` bytes.
    to_bin_buf(&this, buffer: u8*) -> u64 {
        if (this == 0) {
            buffer[0] = 0x30;
            return 1;
        }
        mut scratch: u8[128];
        mut cursor: u64 = 128;
        mut v: u128 = this;
        while (v > 0) {
            cursor = cursor - 1;
            scratch[cursor] = ((v & 0x1) as u8) + 0x30;
            v = v >> 1;
        }
        const digits: u64 = 128 - cursor;
        intrinsics::memcpy(
            buffer as void*,
            (&scratch[0] + cursor) as void*,
            digits
        );
        return digits;
    }
}

implement i128 {
    static min_value() -> i128 {
        // -(2^127). Written as the negated magnitude; the magnitude (2^127) is
        // above u64::MAX so it routes through the 128-bit literal path.
        const m: i128 = -170141183460469231731687303715884105728;
        return m;
    }
    static max_value() -> i128 {
        const m: i128 = 170141183460469231731687303715884105727;
        return m;
    }

    /// Wraps at `i128::min_value()`: the most-negative value has no positive
    /// counterpart in two's complement, so `i128::min_value().abs()` is
    /// itself. Frozen for 1.0 - there is no `checked_abs`.
    abs(&this) -> i128 {
        if (this < 0) { return -this; }
        return this;
    }

    /// Write signed `this` in base 10. Returns bytes written.
    /// `buffer` must hold at least `I128_MAX_DECIMAL_DIGITS` bytes.
    to_decimal_buf(&this, buffer: u8*) -> u64 {
        if (this < 0) {
            buffer[0] = 0x2D; // '-'
            // `-i128::MIN` overflows in i128 but wraps to the correct u128
            // magnitude.
            const magnitude: u128 = (0 - this) as u128;
            return 1 + magnitude.to_decimal_buf(buffer + 1);
        }
        const v: u128 = this as u128;
        return v.to_decimal_buf(buffer);
    }

    /// Decimal text on a fresh heap buffer (caller owns).
    to_decimal_str(&this) -> string {
        mut buf: string = allocator::alloc(41, 1) as string;   // sign + 39 digits + NUL
        if ((buf as void*) == null) {
            core::panic("i128::to_decimal_str: allocation failed", FILE, LINE);
        }
        const n: u64 = this.to_decimal_buf(buf as u8*);
        buf[n] = 0;
        return buf;
    }
}

// Platform-width integers. `usize`/`isize` are distinct types whose width
// equals the target's pointer size (64-bit on every current Cryo target), so
// here they delegate to the same-width `u64`/`i64` machinery via a cast.  The
// `min_value`/`max_value` bounds therefore equal the u64/i64 bounds today; when
// a non-64-bit target lands they will track that target's width automatically
// (the compiler decides the width - see IntegerKind::bit_width).
implement usize {
    static min_value() -> usize { return 0 as usize; }
    static max_value() -> usize { return u64::max_value() as usize; }

    /// Write `this` in base 10. `buffer` must hold at least
    /// `U64_MAX_DECIMAL_DIGITS` bytes (on a 64-bit target).
    to_decimal_buf(&this, buffer: u8*) -> u64 {
        const v: u64 = this as u64;
        return v.to_decimal_buf(buffer);
    }

    to_decimal_str(&this) -> string {
        const v: u64 = this as u64;
        return v.to_decimal_str();
    }
}

implement isize {
    static min_value() -> isize { return i64::min_value() as isize; }
    static max_value() -> isize { return i64::max_value() as isize; }

    abs(&this) -> isize {
        if (this < 0) { return -this; }
        return this;
    }

    /// Write signed `this` in base 10. `buffer` must hold at least
    /// `I64_MAX_DECIMAL_DIGITS` bytes (on a 64-bit target).
    to_decimal_buf(&this, buffer: u8*) -> u64 {
        const v: i64 = this as i64;
        return v.to_decimal_buf(buffer);
    }

    to_decimal_str(&this) -> string {
        const v: i64 = this as i64;
        return v.to_decimal_str();
    }
}

// `f32` widens to `f64` for free (no precision loss going up). The
// formatting/numeric methods all delegate to the f64 implementation
// (which itself lives in `fmt::float` for `to_buf` / `to_buf_with`
// because that needs libm).
implement f32 {
    abs(&this) -> f32 {
        if (this < 0.0 as f32) { return -this; }
        return this;
    }

    is_nan(&this) -> boolean {
        return this != this;
    }
}

implement f64 {
    abs(&this) -> f64 {
        if (this < 0.0) { return -this; }
        return this;
    }

    /// `NaN != NaN`, so the cheapest portable check is self-comparison.
    is_nan(&this) -> boolean {
        return this != this;
    }
}

// Bridge methods on the raw `string` C-string view.
//
// New-stdlib code prefers `Str` and `String<A>` from `collections::str` /
// `collections::string`.  The methods below exist to keep the legacy-shaped
// self-hosted compiler building on the new stdlib without a parallel
// rewrite of every `text.length()` / `text.substring(...)` call site.

implement string {
    length(&this) -> u64 {
        if (this == null) { return 0; }
        return strlen(this);
    }

    is_empty(&this) -> boolean {
        return this.length() == 0;
    }

    // ---- C literal-token classifiers ----
    //
    // Classify the spelling of a single C literal token (as produced by a C
    // lexer / libclang `clang_tokenize`).  Used by C-header binding generation
    // to decide how an object-like `#define <literal>` lowers; kept here so the
    // C-lexing rules live next to `char::is_c_ident_char`.

    /// True when this token spelling is a C string or character literal
    /// (`"..."`, `'c'`, or an encoding-prefixed form: `L"..."`, `u'...'`, `U"..."`,
    /// `u8"..."`, `R"(...)"`).  Detected by the presence of a `"` or `'` quote: a
    /// well-formed C numeric literal never contains one, so this correctly
    /// accepts the prefixed forms too - a prefix-scan that bailed on the first
    /// digit would misread the `8` in `u8"..."` as a numeric literal.
    is_text_literal(&this) -> boolean {
        const len: u64 = strlen(this);
        for (mut i: u64 = 0; i < len; i++) {
            const c: char = this[i];
            if (c == '"' || c == '\'') { return true; }
        }
        return false;
    }

    /// True when this numeric-literal token spelling is a C floating-point
    /// constant.  A decimal float carries a `.` or a decimal exponent (`e`/`E`);
    /// a hexadecimal float (`0x...`) carries a `.` or a binary exponent (`p`/`P`).
    /// The hex case is handled distinctly because in hex the letters `e`/`E` are
    /// digits, not an exponent - and `p`/`P` is the *definitive* float marker, so
    /// a dot-less hex float such as `0x1p4` is correctly recognized (a `.`/`e`
    /// only scan would miss it and mis-bind it as an integer).
    /// Assumes a numeric literal - rule out string/char literals with
    /// `is_text_literal` first.
    is_float_literal(&this) -> boolean {
        const len: u64 = strlen(this);
        if (len == 0) { return false; }
        const is_hex: boolean = len >= 2 && this[0] == '0' && (this[1] == 'x' || this[1] == 'X');
        for (mut i: u64 = 0; i < len; i++) {
            const c: char = this[i];
            if (c == '.') { return true; }
            if (is_hex) {
                if (c == 'p' || c == 'P') { return true; }
            } else {
                if (c == 'e' || c == 'E') { return true; }
            }
        }
        return false;
    }

    /// True when this integer-literal token spelling carries an unsigned type
    /// suffix (`u`/`U`).  Only the trailing suffix run is inspected, stepping
    /// over any `l`/`L` length suffix, so `5u`, `0xFFul`, `10LU`, and `7llu` all
    /// report unsigned while `5`, `5l`, and `7ll` do not.
    is_unsigned_literal(&this) -> boolean {
        mut i: i64 = (strlen(this) as i64) - 1;
        while (i >= 0) {
            const c: char = this[i as u64];
            if (c == 'u' || c == 'U') { return true; }
            if (c == 'l' || c == 'L') { i -= 1; continue; }
            break;
        }
        return false;
    }

    /// `substring(start, len)`: extract `len` bytes starting at `start`,
    /// returning a freshly allocated NUL-terminated string.  Matches the
    /// legacy compiler's call convention (start, length), not (start, end).
    substring(&this, start: u32, len: u32) -> string {
        const total: u32 = this.length() as u32;
        if (start >= total || len == 0) { return ""; }
        mut take: u32 = len;
        if (start + take > total) {
            take = total - start;
        }
        mut buf: string = allocator::alloc((take + 1) as u64, 1) as string;
        if ((buf as void*) == null) {
            core::panic("string::substring: allocation failed", FILE, LINE);
        }
        memcpy(buf as void*, (this + (start as i64)) as void*, take as u64);
        buf[take] = 0;
        return buf;
    }

    /// Signed-offset slice: like `substring` but robust to the computed
    /// ranges cstring-style code produces.  A non-positive `len` (or an
    /// out-of-range `start`) yields ""; an over-long `len` is clamped to the
    /// remaining bytes, so callers never need to bounds-check first.  Walks
    /// the string once (one `strlen`) so it stays cheap in tokenizer-style
    /// hot loops.
    substr(&this, start: i64, len: i64) -> string {
        if (len <= 0 || start < 0) { return ""; }
        const total: i64 = strlen(this) as i64;
        if (start >= total) { return ""; }
        mut take: i64 = len;
        if (start + take > total) { take = total - start; }
        mut buf: string = allocator::alloc((take + 1) as u64, 1) as string;
        if ((buf as void*) == null) {
            core::panic("string::substr: allocation failed", FILE, LINE);
        }
        memcpy(buf as void*, (this + start) as void*, take as u64);
        buf[take] = 0;
        return buf;
    }

    /// Concatenate `other` onto a fresh heap-allocated copy of `this`,
    /// returning the new NUL-terminated string. Caller owns the result.
    append(&this, other: string) -> string {
        const len1: u64 = strlen(this);
        const len2: u64 = strlen(other);
        const total: u64 = len1 + len2 + 1;
        mut buf: string = allocator::alloc(total, 1) as string;
        if ((buf as void*) == null) {
            core::panic("string::append: allocation failed", FILE, LINE);
        }
        memcpy(buf as void*, this as void*, len1);
        memcpy((buf + len1) as void*, other as void*, len2);
        buf[len1 + len2] = 0;
        return buf;
    }

    /// Trim leading and trailing ASCII whitespace (space, tab, LF, CR),
    /// returning a freshly allocated string ("" when all whitespace).
    trim(&this) -> string {
        const len: i64 = this.length() as i64;
        if (len == 0) { return ""; }
        mut start: i64 = 0;
        while (start < len && string_is_ascii_ws(this[start])) { start += 1; }
        mut end: i64 = len - 1;
        while (end >= start && string_is_ascii_ws(this[end])) { end -= 1; }
        if (start > end) { return ""; }
        return this.substr(start, end - start + 1);
    }

    /// If `this` begins with `prefix`, return the remainder as a fresh
    /// string; otherwise return `this` unchanged (same buffer).
    strip_prefix(&this, prefix: string) -> string {
        const plen: u64 = strlen(prefix);
        const slen: u64 = strlen(this);
        if (slen < plen) { return this; }
        if (strncmp(this, prefix, plen) == 0) {
            return this.substr(plen as i64, (slen - plen) as i64);
        }
        return this;
    }

    /// True when `this` ends with `suffix` (byte-wise). An empty suffix always
    /// matches; a suffix longer than `this` never does.
    ends_with(&this, suffix: string) -> boolean {
        const sl: i64 = strlen(this) as i64;
        const fl: i64 = strlen(suffix) as i64;
        if (fl > sl) { return false; }
        mut i: i64 = 0;
        while (i < fl) {
            if (this[sl - fl + i] != suffix[i]) { return false; }
            i += 1;
        }
        return true;
    }

    /// Length, in bytes, of the longest common leading prefix of `this` and
    /// `other`. Useful for ranking candidates by shared-path overlap.
    common_prefix_len(&this, other: string) -> i64 {
        if (this == null || other == null) { return 0; }
        mut i: i64 = 0;
        while (this[i] != 0 && other[i] != 0 && this[i] == other[i]) { i += 1; }
        return i;
    }

    /// True when `needle` occurs anywhere in `this` (substring search).
    /// An empty needle always matches, mirroring C `strstr`.
    contains(&this, needle: string) -> boolean {
        return strstr(this, needle) != null;
    }

    /// Byte index of the first occurrence of `ch`, or -1 if absent.
    find_char(&this, ch: i8) -> i64 {
        const len: i64 = this.length() as i64;
        for (mut i: i64 = 0; i < len; i++) {
            if (this[i] == ch) { return i; }
        }
        return -1;
    }

    /// Byte index of the last occurrence of `ch`, or -1 if absent.
    rfind_char(&this, ch: i8) -> i64 {
        mut i: i64 = this.length() as i64 - 1;
        while (i >= 0) {
            if (this[i] == ch) { return i; }
            i -= 1;
        }
        return -1;
    }

    /// Parse `this` into an integer of the caller-chosen type `T`. Recognises
    /// an optional leading sign (signed `T` only), a `0x`/`0o`/`0b` radix
    /// prefix, and `_` digit separators; parsing stops at the first character
    /// invalid for the detected base. `T` is dispatched at compile time via
    /// `static match`, so each instantiation is exactly the right-width parser:
    /// `lexeme.parse_int<u64>()`, `version.parse_int<i64>()`.
    ///
    /// INFALLIBLE / DEFENSIVE: malformed input yields 0 and overflow wraps.
    /// When you need to *detect* bad input, use `T::try_from(Str)` (Result).
    /// Float parsing is deliberately not here - string->float needs libc and
    /// `core` stays libc-free (see module header).
    ///
    /// `T` is dispatched at compile time via `static match (T)`: each call keeps
    /// only the arm for the concrete `T` (the rest are pruned before
    /// type-checking), so the body is exactly the right-width parser and nothing
    /// else. Unsigned widths read the magnitude directly; signed widths go
    /// through `string_parse_radix_i64` (which sign-negates + wraps). The absence
    /// of a matching arm IS the type bound: `"1".parse_int<f32>()` is a compile
    /// error (E0645), no trait constraint needed.
    parse_int<T>(&this) -> T {
        return static match (T) {
            u8    => { string_parse_radix_u64(this, 0, false) as u8 }
            u16   => { string_parse_radix_u64(this, 0, false) as u16 }
            u32   => { string_parse_radix_u64(this, 0, false) as u32 }
            u64   => { string_parse_radix_u64(this, 0, false) }
            usize => { string_parse_radix_u64(this, 0, false) as usize }
            i8    => { string_parse_radix_i64(this) as i8 }
            i16   => { string_parse_radix_i64(this) as i16 }
            i32   => { string_parse_radix_i64(this) as i32 }
            i64   => { string_parse_radix_i64(this) }
            isize => { string_parse_radix_i64(this) as isize }
        };
    }

    /// Parse `this` as a C integer literal with `strtoull(s, null, 0)`
    /// semantics: an optional sign, then `0x`/`0X` hex, `0b`/`0B` binary,
    /// `0o`/`0O` or a bare leading `0` octal, else decimal; `_` separators are
    /// skipped and parsing stops at the first character invalid for the
    /// detected base (e.g. a `U`/`L` type suffix). Unlike `parse_int`, a bare
    /// leading `0` selects octal - matching C header `#define`s like `0755`.
    /// INFALLIBLE: malformed input yields 0 and overflow wraps.
    parse_c_uint(&this) -> u64 {
        return string_parse_radix_u64(this, 0, true);
    }

    /// Strip one pair of surrounding ASCII double quotes if both are
    /// present; otherwise return `this` unchanged (same buffer).
    strip_quotes(&this) -> string {
        const len: i64 = this.length() as i64;
        if (len >= 2 && this[0] == 34 && this[len - 1] == 34) {   // 34 = '"'
            return this.substr(1, len - 2);
        }
        return this;
    }

    /// The directory portion of a path: everything before the last `/` or
    /// `\` separator, or "." when there is no leading directory component.
    parent_dir(&this) -> string {
        const len: i64 = this.length() as i64;
        mut last_sep: i64 = -1;
        for (mut i: i64 = 0; i < len; i++) {
            if (this[i] == 47 || this[i] == 92) {     // '/' or '\'
                last_sep = i;
            }
        }
        if (last_sep <= 0) { return "."; }
        return this.substr(0, last_sep);
    }

    /// Byte-wise content equality, taking `other` BY VALUE so it accepts
    /// string literals directly (`name.eq("void")`). This is the ergonomic
    /// replacement for the `strcmp(a, b) == 0` idiom; the `Eq` trait's
    /// `equals(&string)` needs an lvalue and can't take a literal. Two nulls
    /// are equal; exactly one null is not.
    eq(&this, other: string) -> boolean {
        if (this == null) { return other == null; }
        if (other == null) { return false; }
        const la: u64 = strlen(this);
        if (la != strlen(other)) { return false; }
        return strncmp(this, other, la) == 0;
    }

    /// True when `this` begins with `prefix` (byte-wise). An empty prefix
    /// always matches; a prefix longer than `this` never does.
    starts_with(&this, prefix: string) -> boolean {
        if (this == null || prefix == null) { return false; }
        const plen: u64 = strlen(prefix);
        if (plen == 0) { return true; }
        if (strlen(this) < plen) { return false; }
        return strncmp(this, prefix, plen) == 0;
    }

    /// Byte index of the first occurrence of `needle`, or -1 when absent.
    /// An empty needle matches at 0.
    find(&this, needle: string) -> i64 {
        if (this == null || needle == null) { return -1; }
        const hit: i8* = strstr(this, needle);
        if (hit == null) { return -1; }
        return ptr_diff(hit as void*, this as void*);
    }

    /// Byte index of the last occurrence of `needle`, or -1 when absent.
    /// An empty needle matches at the end (the string's length).
    rfind(&this, needle: string) -> i64 {
        if (this == null || needle == null) { return -1; }
        const nlen: i64 = strlen(needle) as i64;
        const hlen: i64 = strlen(this) as i64;
        if (nlen == 0) { return hlen; }
        if (nlen > hlen) { return -1; }
        mut i: i64 = hlen - nlen;
        while (i >= 0) {
            if (strncmp(this + i, needle, nlen as u64) == 0) {
                return i;
            }
            i -= 1;
        }
        return -1;
    }

    /// Split on a single byte separator, returning each piece as a freshly
    /// allocated string. Adjacent separators yield empty pieces; the result
    /// always has (separator-count + 1) entries.
    split_char(&this, sep: i8) -> string[] {
        mut parts: string[] = [];
        if (this == null) { return parts; }
        const len: i64 = this.length() as i64;
        mut start: i64 = 0;
        for (mut i: i64 = 0; i < len; i++) {
            if (this[i] == sep) {
                parts.push(this.substr(start, i - start));
                start = i + 1;
            }
        }
        parts.push(this.substr(start, len - start));
        return parts;
    }

    /// Split on a multi-byte separator string. An empty separator yields the
    /// whole string as a single piece. Covers `::`-style segmentation.
    split(&this, sep: string) -> string[] {
        mut parts: string[] = [];
        if (this == null) { return parts; }
        const total: i64 = this.length() as i64;
        const slen: i64 = strlen(sep) as i64;
        if (slen == 0) { parts.push(this.substr(0, total)); return parts; }
        mut i: i64 = 0;
        mut seg_start: i64 = 0;
        while (i <= total - slen) {
            if (strncmp(this + i, sep, slen as u64) == 0) {
                parts.push(this.substr(seg_start, i - seg_start));
                i += slen;
                seg_start = i;
            } else {
                i += 1;
            }
        }
        parts.push(this.substr(seg_start, total - seg_start));
        return parts;
    }

    /// Like `split`, but drops empty pieces: leading, trailing, and
    /// consecutive separators produce no entry, and empty input yields an
    /// empty array. Useful for `::`-delimited names and `/`-delimited paths
    /// where blank segments are meaningless.
    split_nonempty(&this, sep: string) -> string[] {
        mut out: string[] = [];
        if (this == null) { return out; }
        const total: i64 = this.length() as i64;
        const slen: i64 = strlen(sep) as i64;
        if (slen == 0) {
            if (total > 0) { out.push(this.substr(0, total)); }
            return out;
        }
        mut i: i64 = 0;
        mut start: i64 = 0;
        while (i <= total - slen) {
            if (strncmp(this + i, sep, slen as u64) == 0) {
                if (i > start) { out.push(this.substr(start, i - start)); }
                i += slen;
                start = i;
            } else {
                i += 1;
            }
        }
        if (start < total) { out.push(this.substr(start, total - start)); }
        return out;
    }

    /// Replace every non-overlapping occurrence of `from` with `to`, returning
    /// a freshly allocated string. An empty `from` returns `this` unchanged.
    replace(&this, from: string, to: string) -> string {
        if (this == null) { return ""; }
        const flen: i64 = strlen(from) as i64;
        const total: i64 = this.length() as i64;
        if (flen == 0) { return this.substr(0, total); }
        mut result: string = "";
        mut i: i64 = 0;
        mut seg_start: i64 = 0;
        while (i <= total - flen) {
            if (strncmp(this + i, from, flen as u64) == 0) {
                result = result.append(this.substr(seg_start, i - seg_start));
                result = result.append(to);
                i += flen;
                seg_start = i;
            } else {
                i += 1;
            }
        }
        return result.append(this.substr(seg_start, total - seg_start));
    }

    /// ASCII-fold to lowercase, returning a freshly allocated string.
    to_ascii_lower(&this) -> string {
        if (this == null) { return ""; }
        const len: i64 = this.length() as i64;
        mut buf: string = allocator::alloc((len + 1) as u64, 1) as string;
        if ((buf as void*) == null) {
            core::panic("string::to_ascii_lower: allocation failed", FILE, LINE);
        }
        for (mut i: i64 = 0; i < len; i++) {
            mut c: char = this[i];
            if (c >= 65 && c <= 90) { c = (c + 32) as char; }     // 'A'..'Z' -> 'a'..'z'
            buf[i] = c;
        }
        buf[len] = 0;
        return buf;
    }

    /// ASCII-fold to uppercase, returning a freshly allocated string.
    to_ascii_upper(&this) -> string {
        if (this == null) { return ""; }
        const len: i64 = this.length() as i64;
        mut buf: string = allocator::alloc((len + 1) as u64, 1) as string;
        if ((buf as void*) == null) {
            core::panic("string::to_ascii_upper: allocation failed", FILE, LINE);
        }
        for (mut i: i64 = 0; i < len; i++) {
            mut c: char = this[i];
            if (c >= 97 && c <= 122) { c = (c - 32) as char; }    // 'a'..'z' -> 'A'..'Z'
            buf[i] = c;
        }
        buf[len] = 0;
        return buf;
    }

    /// The final path component: everything after the last `/` or `\`.
    basename(&this) -> string {
        const len: i64 = this.length() as i64;
        mut last_sep: i64 = -1;
        for (mut i: i64 = 0; i < len; i++) {
            if (this[i] == 47 || this[i] == 92) { last_sep = i; }   // '/' or '\'
        }
        return this.substr(last_sep + 1, len - (last_sep + 1));
    }

    /// The file stem: `basename` with its final `.ext` removed. A leading-dot
    /// name (e.g. `.gitignore`) is treated as having no extension.
    stem(&this) -> string {
        const base: string = this.basename();
        const blen: i64 = base.length() as i64;
        mut dot: i64 = -1;
        for (mut i: i64 = 0; i < blen; i++) {
            if (base[i] == 46) { dot = i; }     // '.'
        }
        if (dot <= 0) { return base; }
        return base.substr(0, dot);
    }

    /// The file extension without the dot, or "" when there is none. A
    /// leading-dot name (e.g. `.gitignore`) has no extension.
    extension(&this) -> string {
        const base: string = this.basename();
        const blen: i64 = base.length() as i64;
        mut dot: i64 = -1;
        for (mut i: i64 = 0; i < blen; i++) {
            if (base[i] == 46) { dot = i; }     // '.'
        }
        if (dot <= 0) { return ""; }
        return base.substr(dot + 1, blen - (dot + 1));
    }

    /// Join `seg` onto `this` with a single `/` separator. An empty `this`
    /// returns `seg`; an empty `seg` returns `this`; an absolute `seg`
    /// (leading separator) replaces `this` entirely.
    join(&this, seg: string) -> string {
        if (this == null || this.is_empty()) { return seg; }
        if (seg == null || seg.length() == 0) { return this; }
        if (seg[0] == 47 || seg[0] == 92) { return seg; }       // absolute
        const len: i64 = this.length() as i64;
        const last: char = this[len - 1];
        if (last == 47 || last == 92) { return this.append(seg); }
        return this.append("/").append(seg);
    }

    /// True when `this` lies within directory `dir`: equal to `dir`, or
    /// extending it across a path separator. Boundary-aware so `/a/bc` is
    /// NOT under `/a/b`.
    is_under(&this, dir: string) -> boolean {
        if (this == null || dir == null) { return false; }
        const dlen: i64 = dir.length() as i64;
        if (dlen == 0) { return false; }
        if (!this.starts_with(dir)) { return false; }
        const tlen: i64 = this.length() as i64;
        if (tlen == dlen) { return true; }
        const last: char = dir[dlen - 1];
        if (last == 47 || last == 92) { return true; }
        const nxt: char = this[dlen];
        return nxt == 47 || nxt == 92;
    }

    /// Append `suffix` unless it is empty or already present at the end.
    /// Used to add a platform executable suffix (e.g. `.exe`) idempotently.
    with_exe_suffix(&this, suffix: string) -> string {
        if (suffix == null || suffix.length() == 0) { return this; }
        if (this.ends_with(suffix)) { return this; }
        return this.append(suffix);
    }
}

/// ASCII whitespace test used by `string::trim`.
private function string_is_ascii_ws(b: i8) -> boolean {
    return b == 32 || b == 9 || b == 10 || b == 13;
}

/// Radix-aware parse core backing `string::parse_int<T>`. Starting at byte
/// `start`, accepts an optional leading sign, detects a `0x`/`0o`/`0b` prefix,
/// skips `_` separators, and accumulates until the first character invalid for
/// the detected base. A `-` negates and WRAPS into the unsigned result (so an
/// `i*` width recovers the right two's-complement value, and a `u*` width
/// recovers the wrapped magnitude - matching the historical literal parser).
/// Overflow wraps; "" or garbage yields 0.
private function string_parse_radix_u64(s: string, start: i64, c_octal: boolean) -> u64 {
    if (s == null) { return 0; }
    mut i: i64 = start;
    mut negate: boolean = false;
    if (s[i] == 45) { negate = true; i += 1; }              // '-'
    else if (s[i] == 43) { i += 1; }                        // '+'

    mut base: u64 = 10;
    if (s[i] == 48 && (s[i+1] == 120 || s[i+1] == 88))      { base = 16; i += 2; }  // 0x/0X
    else if (s[i] == 48 && (s[i+1] == 98 || s[i+1] == 66))  { base = 2;  i += 2; }  // 0b/0B
    else if (s[i] == 48 && (s[i+1] == 111 || s[i+1] == 79)) { base = 8;  i += 2; }  // 0o/0O
    // C `strtoull(base 0)`: a bare leading `0` followed by an octal digit is
    // octal (e.g. `0755`). Gated so the default parser keeps `007` == 7.
    else if (c_octal && s[i] == 48 && s[i+1] >= 48 && s[i+1] <= 55) { base = 8; i += 1; }

    mut acc: u64 = 0;
    while (s[i] != 0) {
        const c: char = s[i];
        if (c == 95) { i += 1; continue; }                  // '_'
        mut digit: u64 = 0;
        if (c >= 48 && c <= 57)        { digit = (c - 48) as u64; }
        else if (c >= 97 && c <= 102)  { digit = (c - 97 + 10) as u64; }
        else if (c >= 65 && c <= 70)   { digit = (c - 65 + 10) as u64; }
        else { break; }
        if (digit >= base) { break; }
        acc = acc * base + digit;
        i += 1;
    }
    if (negate) { return (0 - acc as i64) as u64; }
    return acc;
}

/// Signed view of the parse core: parse as wrapped-unsigned, reinterpret.
private function string_parse_radix_i64(s: string) -> i64 {
    return string_parse_radix_u64(s, 0, false) as i64;
}
