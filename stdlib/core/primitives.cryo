        buf[n] = 0;
        return buf;
    }

    /// Lowercase hex. `buffer` must hold at least `u128::MAX_HEX_DIGITS` bytes.
    to_hex_buf(&this, buffer: u8*) -> i64 {
        return u128::to_hex_buf_with_table(this, buffer, "0123456789abcdef" as u8*);
    }

    /// Uppercase variant.
    to_hex_upper_buf(&this, buffer: u8*) -> i64 {
        return u128::to_hex_buf_with_table(this, buffer, "0123456789ABCDEF" as u8*);
    }

    static to_hex_buf_with_table(value: u128, buffer: u8*, digits_table: u8*) -> i64 {
        if (value == 0) {
            buffer[0] = 0x30;
            return 1;
