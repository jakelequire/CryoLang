implement i128 {
    const MIN: i128 = -170141183460469231731687303715884105728;
    const MAX: i128 = 170141183460469231731687303715884105727;
    const BITS: u32 = 128;
    const MAX_DECIMAL_DIGITS: i64 = 40;    // "-170141183460469231731687303715884105728"

    /// Wraps at `i128::MIN`: the most-negative value has no positive
    /// counterpart in two's complement, so `i128::MIN.abs()` is
    /// itself; `checked_abs` answers `None` there.
    abs(&this) -> i128 {
        if (this < 0) { return -this; }
        return this;
    }

    /// `Some(|this|)`, or `None` for `MIN`, whose magnitude is not
    /// representable: only it negates to a value still negative.
    checked_abs(&this) -> Option<i128> {
        if (this < 0) {
            const neg: i128 = -this;
            if (neg < 0) { return Option::None; }
            return Option::Some(neg);
        }
        return Option::Some(this);
    }

    /// `this` confined to `[lo, hi]`.
    clamp(&this, lo: i128, hi: i128) -> i128 {
        if (this < lo) { return lo; }
        if (this > hi) { return hi; }
        return this;
    }

    /// `this + other`, or `None` where the sum leaves `i128`'s range.
    checked_add(&this, other: i128) -> Option<i128> {
        if ((other > 0 && this > i128::MAX - other) || (other < 0 && this < i128::MIN - other)) {
            return Option::None;
        }
        return Option::Some(this + other);
    }

    /// `this - other`, or `None` where the difference leaves `i128`'s range.
    checked_subtract(&this, other: i128) -> Option<i128> {
        if ((other < 0 && this > i128::MAX + other) || (other > 0 && this < i128::MIN + other)) {
            return Option::None;
        }
        return Option::Some(this - other);
    }

    /// `this * other`, or `None` where the product leaves `i128`'s range:
    /// a wrapped product divided by one operand does not give the other.
    checked_multiply(&this, other: i128) -> Option<i128> {
        if (this == 0 || other == 0) { return Option::Some(0); }
        if ((this == -1 && other == i128::MIN) || (other == -1 && this == i128::MIN)) {
            return Option::None;
        }
        const product: i128 = this * other;
        if (product / other != this) { return Option::None; }
        return Option::Some(product);
    }

    /// `this + other`, or the bound of `i128` the sum lies past.
    saturating_add(&this, other: i128) -> i128 {
        return this.checked_add(other).unwrap_or(if (other > 0) { i128::MAX } else { i128::MIN });
    }

    /// `this - other`, or the bound of `i128` the difference lies past.
    saturating_subtract(&this, other: i128) -> i128 {
        return this.checked_subtract(other).unwrap_or(if (other < 0) { i128::MAX } else { i128::MIN });
    }

    /// `this * other`, or the bound of `i128` the product lies past: the
    /// upper one when the operands' signs agree.
    saturating_multiply(&this, other: i128) -> i128 {
        return this.checked_multiply(other).unwrap_or(
            if ((this < 0) == (other < 0)) { i128::MAX } else { i128::MIN });
    }

    /// Write signed `this` in base 10. Returns bytes written.
    /// `buffer` must hold at least `i128::MAX_DECIMAL_DIGITS` bytes.
    to_decimal_buf(&this, buffer: u8*) -> i64 {
        if (this < 0) {
            buffer[0] = 0x2D; // '-'
            // `-i128::MIN` overflows in i128 but wraps to the correct u128
            // magnitude.
            const magnitude: u128 = (0 - this) as u128;
            return 1 + magnitude.to_decimal_buf(buffer + 1);
        }
        const v: u128 = this as u128;
        return v.to_decimal_buf(buffer);
    }

    /// Decimal text on a fresh heap buffer (caller owns).
    to_decimal_str(&this) -> string {
        mut buf: string = allocator::alloc(41, 1) as string;   // sign + 39 digits + NUL
        if ((buf as void*) == null) {
            core::panic("i128::to_decimal_str: allocation failed", intrinsics::location());
        }
        const n: i64 = this.to_decimal_buf(buf as u8*);
        buf[n] = 0;
        return buf;
    }
}

// Platform-width integers. `usize`/`isize` are distinct types whose width
// equals the target's pointer size (64-bit on every current Cryo target), so
// here they delegate to the same-width `u64`/`i64` machinery via a cast.  Their
// `MIN`, `MAX` and `BITS` are therefore the 64-bit ones, and a target of
// another pointer width changes them here.
implement usize {
    const MIN: usize = 0;
    const MAX: usize = u64::MAX as usize;
    const BITS: u32 = 64;

    /// `this` confined to `[lo, hi]`.
    clamp(&this, lo: usize, hi: usize) -> usize {
        if (this < lo) { return lo; }
        if (this > hi) { return hi; }
        return this;
    }

    /// `this + other`, or `None` where the sum passes `usize::MAX`.
    checked_add(&this, other: usize) -> Option<usize> {
        return match ((this as u64).checked_add(other as u64)) {
            Option::Some(sum) => { Option::Some(sum as usize) }
            Option::None      => { Option::None }
        };
    }

    /// `this - other`, or `None` where `other` is the larger.
    checked_subtract(&this, other: usize) -> Option<usize> {
        if (other > this) { return Option::None; }
        return Option::Some(this - other);
    }

    /// `this * other`, or `None` where the product passes `usize::MAX`.
    checked_multiply(&this, other: usize) -> Option<usize> {
        return match ((this as u64).checked_multiply(other as u64)) {
            Option::Some(product) => { Option::Some(product as usize) }
            Option::None          => { Option::None }
        };
    }

    /// `this + other`, or `usize::MAX` where the sum passes it.
    saturating_add(&this, other: usize) -> usize {
        return (this as u64).saturating_add(other as u64) as usize;
    }

    /// `this - other`, or `0` where `other` is the larger.
    saturating_subtract(&this, other: usize) -> usize {
        if (other > this) { return 0; }
        return this - other;
    }

    /// `this * other`, or `usize::MAX` where the product passes it.
    saturating_multiply(&this, other: usize) -> usize {
        return (this as u64).saturating_multiply(other as u64) as usize;
    }

    /// Write `this` in base 10. `buffer` must hold at least
    /// `u64::MAX_DECIMAL_DIGITS` bytes (on a 64-bit target).
    to_decimal_buf(&this, buffer: u8*) -> i64 {
        const v: u64 = this as u64;
        return v.to_decimal_buf(buffer);
    }

    to_decimal_str(&this) -> string {
        const v: u64 = this as u64;
        return v.to_decimal_str();
    }
}

implement isize {
    const MIN: isize = i64::MIN as isize;
    const MAX: isize = i64::MAX as isize;
    const BITS: u32 = 64;

    abs(&this) -> isize {
        if (this < 0) { return -this; }
        return this;
    }

    /// `Some(|this|)`, or `None` for `MIN`, whose magnitude is not
    /// representable: only it negates to a value still negative.
    checked_abs(&this) -> Option<isize> {
        if (this < 0) {
            const neg: isize = -this;
            if (neg < 0) { return Option::None; }
            return Option::Some(neg);
        }
        return Option::Some(this);
    }

    /// `this` confined to `[lo, hi]`.
    clamp(&this, lo: isize, hi: isize) -> isize {
        if (this < lo) { return lo; }
        if (this > hi) { return hi; }
        return this;
    }

    /// `this + other`, or `None` where the sum leaves `isize`'s range.
    checked_add(&this, other: isize) -> Option<isize> {
        return match ((this as i64).checked_add(other as i64)) {
            Option::Some(sum) => { Option::Some(sum as isize) }
            Option::None      => { Option::None }
        };
    }

    /// `this - other`, or `None` where the difference leaves `isize`'s range.
    checked_subtract(&this, other: isize) -> Option<isize> {
        return match ((this as i64).checked_subtract(other as i64)) {
            Option::Some(difference) => { Option::Some(difference as isize) }
            Option::None             => { Option::None }
        };
    }

    /// `this * other`, or `None` where the product leaves `isize`'s range.
    checked_multiply(&this, other: isize) -> Option<isize> {
        return match ((this as i64).checked_multiply(other as i64)) {
            Option::Some(product) => { Option::Some(product as isize) }
            Option::None          => { Option::None }
        };
    }

    /// `this + other`, or the bound of `isize` the sum lies past.
    saturating_add(&this, other: isize) -> isize {
        return (this as i64).saturating_add(other as i64) as isize;
    }

    /// `this - other`, or the bound of `isize` the difference lies past.
    saturating_subtract(&this, other: isize) -> isize {
        return (this as i64).saturating_subtract(other as i64) as isize;
    }

    /// `this * other`, or the bound of `isize` the product lies past.
    saturating_multiply(&this, other: isize) -> isize {
        return (this as i64).saturating_multiply(other as i64) as isize;
    }

    /// Write signed `this` in base 10. `buffer` must hold at least
    /// `i64::MAX_DECIMAL_DIGITS` bytes (on a 64-bit target).
    to_decimal_buf(&this, buffer: u8*) -> i64 {
        const v: i64 = this as i64;
        return v.to_decimal_buf(buffer);
    }

    to_decimal_str(&this) -> string {
        const v: i64 = this as i64;
        return v.to_decimal_str();
    }
}

// `f32` widens to `f64` for free (no precision loss going up). The
// formatting/numeric methods all delegate to the f64 implementation
// (which itself lives in `fmt::float` for `to_buf` / `to_buf_with`
// because that needs libm).
// IEEE-754 limits.  `MIN` is the most-negative finite value (`-MAX`) and
// `MIN_POSITIVE` the smallest positive normal one; the non-finite values are
// the quotients IEEE division gives them, folded where they are declared.
implement f32 {
    /// The difference between `1.0` and the next larger value.
    const EPSILON: f32 = 1.1920929e-7;
    const MAX: f32 = 3.4028235e38;
    const MIN: f32 = -3.4028235e38;
    const MIN_POSITIVE: f32 = 1.1754944e-38;
    const INFINITY: f32 = 1.0 / 0.0;
    const NEG_INFINITY: f32 = -1.0 / 0.0;
    const NAN: f32 = 0.0 / 0.0;

    /// Absolute value by clearing the sign bit, so `-0.0` gives `0.0` and a
    /// NaN keeps its payload with its sign cleared.
    abs(&this) -> f32 {
        return intrinsics::fabs32(this);
    }

    /// `this` confined to `[lo, hi]`, by plain comparisons: a NaN `this`
    /// compares false against both bounds and is returned unchanged.
    clamp(&this, lo: f32, hi: f32) -> f32 {
        if (this < lo) { return lo; }
        if (this > hi) { return hi; }
        return this;
    }

    is_nan(&this) -> boolean {
        return this != this;
    }

    // The class tests below read the IEEE-754 single-precision fields
    // directly: widening to `f64` keeps NaN and infinity but makes every
    // subnormal `f32` a normal `f64`.

    /// Positive or negative infinity: every exponent bit set, no fraction.
    is_infinite(&this) -> boolean {
        return (mem::transmute::<f32, u32>(this) & 0x7FFFFFFF) == 0x7F800000;
    }

    /// Neither NaN nor infinite; zeros and subnormals included.
    is_finite(&this) -> boolean {
        return (mem::transmute::<f32, u32>(this) & 0x7F800000) != 0x7F800000;
    }

    /// Finite, nonzero and not subnormal: an exponent neither all clear
    /// nor all set.
    is_normal(&this) -> boolean {
        const exponent: u32 = mem::transmute::<f32, u32>(this) & 0x7F800000;
        return exponent != 0 && exponent != 0x7F800000;
    }

    /// The raw IEEE-754 sign bit, so true for `-0.0` and a negative NaN too.
    is_sign_negative(&this) -> boolean {
        return (mem::transmute::<f32, u32>(this) >> 31) != 0;
    }

    /// The IEEE-754 category `this` falls in.
    classify(&this) -> FpCategory {
        const bits: u32 = mem::transmute::<f32, u32>(this);
        const exponent: u32 = bits & 0x7F800000;
        const fraction: u32 = bits & 0x007FFFFF;
        if (exponent == 0x7F800000) {
            return if (fraction == 0) { FpCategory::Infinite } else { FpCategory::Nan };
        }
        if (exponent == 0) {
            return if (fraction == 0) { FpCategory::Zero } else { FpCategory::Subnormal };
        }
        return FpCategory::Normal;
    }

    /// The smaller of `this` and `other`, a NaN ignored: a NaN operand
    /// gives the other, and two give NaN.  `cmp::min` orders a NaN instead.
    min(&this, other: f32) -> f32 {
        if (this != this) { return other; }
        if (other != other) { return this; }
        if (this < other) { return this; }
        return other;
    }

    /// The larger of `this` and `other`, a NaN ignored as `min` ignores it.
    max(&this, other: f32) -> f32 {
        if (this != this) { return other; }
        if (other != other) { return this; }
        if (this > other) { return this; }
        return other;
    }

    /// Square root, in single precision: NaN for a negative `this`.
    sqrt(&this) -> f32 {
        return intrinsics::sqrt32(this);
    }
}

implement f64 {
    /// The difference between `1.0` and the next larger value.
    const EPSILON: f64 = 2.220446049250313e-16;
    const MAX: f64 = 1.7976931348623157e308;
    const MIN: f64 = -1.7976931348623157e308;
    const MIN_POSITIVE: f64 = 2.2250738585072014e-308;
    const INFINITY: f64 = 1.0 / 0.0;
    const NEG_INFINITY: f64 = -1.0 / 0.0;
    const NAN: f64 = 0.0 / 0.0;

    /// Absolute value by clearing the sign bit, so `-0.0` gives `0.0` and a
    /// NaN keeps its payload with its sign cleared.
    abs(&this) -> f64 {
        return intrinsics::fabs64(this);
    }

    /// `this` confined to `[lo, hi]`, by plain comparisons: a NaN `this`
    /// compares false against both bounds and is returned unchanged.
    clamp(&this, lo: f64, hi: f64) -> f64 {
        if (this < lo) { return lo; }
        if (this > hi) { return hi; }
        return this;
    }

    /// `NaN != NaN`, so the cheapest portable check is self-comparison.
    is_nan(&this) -> boolean {
        return this != this;
    }

    // The class tests below read IEEE-754 bit classes through the `fpclass`
    // intrinsic: no libm, no floating-point exceptions. Each test literal
    // selects the classes that answer true, as documented on
    // `intrinsics::fpclass`.

    /// Positive or negative infinity.
    is_infinite(&this) -> boolean {
        return intrinsics::fpclass(this, 0x204);
    }

    /// Neither NaN nor infinite; zeros and subnormals included.
    is_finite(&this) -> boolean {
        return intrinsics::fpclass(this, 0x1F8);
    }

    /// Finite, nonzero and not subnormal.
    is_normal(&this) -> boolean {
        return intrinsics::fpclass(this, 0x108);
    }

    /// The raw IEEE-754 sign bit, so true for `-0.0` and a negative NaN too.
    is_sign_negative(&this) -> boolean {
        return (mem::transmute::<f64, u64>(this) >> 63) != 0;
    }

    /// The IEEE-754 category `this` falls in.
    classify(&this) -> FpCategory {
        if (intrinsics::fpclass(this, 0x003)) { return FpCategory::Nan; }
        if (intrinsics::fpclass(this, 0x204)) { return FpCategory::Infinite; }
        if (intrinsics::fpclass(this, 0x060)) { return FpCategory::Zero; }
        if (intrinsics::fpclass(this, 0x090)) { return FpCategory::Subnormal; }
        return FpCategory::Normal;
    }

    /// The smaller of `this` and `other`, a NaN ignored: a NaN operand
    /// gives the other, and two give NaN.  `cmp::min` orders a NaN instead.
    min(&this, other: f64) -> f64 {
        return libc::fmin(this, other);
    }

    /// The larger of `this` and `other`, a NaN ignored as `min` ignores it.
    max(&this, other: f64) -> f64 {
        return libc::fmax(this, other);
    }

    /// Square root: NaN for a negative `this`.
    sqrt(&this) -> f64 {
        return intrinsics::sqrt64(this);
    }
}

// Bridge methods on the raw `string` C-string view.
//
// New-stdlib code prefers `Str` and `String<A>` from `collections::str` /
// `collections::string`.  The methods below exist to keep the legacy-shaped
// self-hosted compiler building on the new stdlib without a parallel
// rewrite of every `text.length()` / `text.substring(...)` call site.

implement string {
    ![inline]
    length(&this) -> i64 {
        if (this == null) { return 0; }
        return libc::strlen(this) as i64;
    }

    is_empty(&this) -> boolean {
        return this.length() == 0;
    }

    /// `substring(start, len)`: extract `len` bytes starting at `start`,
    /// returning a freshly allocated NUL-terminated string.  Matches the
    /// legacy compiler's call convention (start, length), not (start, end).
    substring(&this, start: u32, len: u32) -> string {
        const total: u32 = this.length() as u32;
        if (start >= total || len == 0) { return ""; }
        mut take: u32 = len;
        if (start + take > total) {
            take = total - start;
        }
        mut buf: string = allocator::alloc((take + 1) as u64, 1) as string;
        if ((buf as void*) == null) {
            core::panic("string::substring: allocation failed", intrinsics::location());
        }
        libc::memcpy(buf as void*, (this + (start as i64)) as void*, take as u64);
        buf[take] = 0;
        return buf;
    }

    /// Signed-offset slice: like `substring` but robust to the computed
    /// ranges cstring-style code produces.  A non-positive `len` (or an
    /// out-of-range `start`) yields ""; an over-long `len` is clamped to the
    /// remaining bytes, so callers never need to bounds-check first.  It
    /// reads no further than `start + len`: a tokenizer slicing a token off
    /// the rest of a file pays for the token, not for the rest of the file.
    substr(&this, start: i64, len: i64) -> string {
        if (len <= 0 || start < 0) { return ""; }
        const total: i64 = libc::strnlen(this, (start + len) as u64) as i64;
        if (start >= total) { return ""; }
        mut take: i64 = len;
        if (start + take > total) { take = total - start; }
        mut buf: string = allocator::alloc((take + 1) as u64, 1) as string;
        if ((buf as void*) == null) {
            core::panic("string::substr: allocation failed", intrinsics::location());
        }
        libc::memcpy(buf as void*, (this + start) as void*, take as u64);
        buf[take] = 0;
        return buf;
    }

    /// Concatenate `other` onto a fresh heap-allocated copy of `this`,
    /// returning the new NUL-terminated string. Caller owns the result.
    append(&this, other: string) -> string {
        const len1: u64 = libc::strlen(this);
        const len2: u64 = libc::strlen(other);
        const total: u64 = len1 + len2 + 1;
        mut buf: string = allocator::alloc(total, 1) as string;
        if ((buf as void*) == null) {
            core::panic("string::append: allocation failed", intrinsics::location());
        }
        libc::memcpy(buf as void*, this as void*, len1);
        libc::memcpy((buf + len1) as void*, other as void*, len2);
        buf[len1 + len2] = 0;
        return buf;
    }

    /// Trim leading and trailing ASCII whitespace (space, tab, LF, VT, FF,
    /// CR), returning a freshly allocated string ("" when all whitespace).
    trim(&this) -> string {
        const len: i64 = this.length() as i64;
        if (len == 0) { return ""; }
        mut start: i64 = 0;
        while (start < len && (this[start] as u8).is_whitespace()) { start += 1; }
        mut end: i64 = len - 1;
        while (end >= start && (this[end] as u8).is_whitespace()) { end -= 1; }
        if (start > end) { return ""; }
        return this.substr(start, end - start + 1);
    }

    /// If `this` begins with `prefix`, return the remainder as a fresh
    /// string; otherwise return `this` unchanged (same buffer).
    strip_prefix(&this, prefix: string) -> string {
        const plen: u64 = libc::strlen(prefix);
        const slen: u64 = libc::strlen(this);
        if (slen < plen) { return this; }
        if (libc::strncmp(this, prefix, plen) == 0) {
            return this.substr(plen as i64, (slen - plen) as i64);
        }
        return this;
    }

    /// True when `this` ends with `suffix` (byte-wise). An empty suffix always
    /// matches; a suffix longer than `this` never does.
    ends_with(&this, suffix: string) -> boolean {
        const sl: i64 = libc::strlen(this) as i64;
        const fl: i64 = libc::strlen(suffix) as i64;
        if (fl > sl) { return false; }
        mut i: i64 = 0;
        while (i < fl) {
            if (this[sl - fl + i] != suffix[i]) { return false; }
            i += 1;
        }
        return true;
    }

    /// Length, in bytes, of the longest common leading prefix of `this` and
    /// `other`. Useful for ranking candidates by shared-path overlap.
    common_prefix_len(&this, other: string) -> i64 {
        if (this == null || other == null) { return 0; }
        mut i: i64 = 0;
        while (this[i] != 0 && other[i] != 0 && this[i] == other[i]) { i += 1; }
        return i;
    }

    /// True when `needle` occurs anywhere in `this` (substring search).
    /// An empty needle always matches, mirroring C `strstr`.
    contains(&this, needle: string) -> boolean {
        return libc::strstr(this, needle) != null;
    }

    /// Byte index of the first occurrence of `ch`, or -1 if absent.
    find_char(&this, ch: i8) -> i64 {
        const len: i64 = this.length() as i64;
        for (mut i: i64 = 0; i < len; i++) {
            if (this[i] == ch) { return i; }
        }
        return -1;
    }

    /// Byte index of the last occurrence of `ch`, or -1 if absent.
    rfind_char(&this, ch: i8) -> i64 {
        mut i: i64 = this.length() as i64 - 1;
        while (i >= 0) {
            if (this[i] == ch) { return i; }
            i -= 1;
        }
        return -1;
    }

    /// Parse `this` into an integer of the caller-chosen type `T`. Recognises
    /// an optional leading sign (signed `T` only), a `0x`/`0o`/`0b` radix
    /// prefix, and `_` digit separators; parsing stops at the first character
    /// invalid for the detected base. `T` is dispatched at compile time via
    /// `static match`, so each instantiation is exactly the right-width parser:
    /// `lexeme.parse_int<u64>()`, `version.parse_int<i64>()`.
    ///
    /// INFALLIBLE / DEFENSIVE: malformed input yields 0 and overflow wraps.
    /// When you need to *detect* bad input, use `T::try_from(Str)` (Result).
    /// Float parsing is deliberately not here - string->float needs libc and
    /// `core` stays libc-free (see module header).
    ///
    /// `T` is dispatched at compile time via `static match (T)`: each call keeps
    /// only the arm for the concrete `T` (the rest are pruned before
    /// type-checking), so the body is exactly the right-width parser and nothing
    /// else. Unsigned widths read the magnitude directly; signed widths go
    /// through `string_parse_radix_i64` (which sign-negates + wraps). The absence
    /// of a matching arm IS the type bound: `"1".parse_int<f32>()` is a compile
    /// error (E0645), no trait constraint needed.
    parse_int<T>(&this) -> T {
        return static match (T) {
            u8    => { string_parse_radix_u64(this) as u8 }
            u16   => { string_parse_radix_u64(this) as u16 }
            u32   => { string_parse_radix_u64(this) as u32 }
            u64   => { string_parse_radix_u64(this) }
            usize => { string_parse_radix_u64(this) as usize }
            i8    => { string_parse_radix_i64(this) as i8 }
            i16   => { string_parse_radix_i64(this) as i16 }
            i32   => { string_parse_radix_i64(this) as i32 }
            i64   => { string_parse_radix_i64(this) }
            isize => { string_parse_radix_i64(this) as isize }
        };
    }

    /// The directory portion of a path: everything before the last `/` or
    /// `\` separator, or "." when there is no leading directory component.
    parent_dir(&this) -> string {
        const len: i64 = this.length() as i64;
        mut last_sep: i64 = -1;
        for (mut i: i64 = 0; i < len; i++) {
            if (this[i] == 47 || this[i] == 92) {     // '/' or '\'
                last_sep = i;
            }
        }
        if (last_sep <= 0) { return "."; }
        return this.substr(0, last_sep);
    }

    /// Byte-wise content equality, taking `other` BY VALUE so it accepts
    /// string literals directly (`name.eq("void")`). This is the ergonomic
    /// replacement for the `strcmp(a, b) == 0` idiom; the `Eq` trait's
    /// `equals(&string)` needs an lvalue and can't take a literal. Two nulls
    /// are equal; exactly one null is not.
    eq(&this, other: string) -> boolean {
        if (this == null) { return other == null; }
        if (other == null) { return false; }
        const la: u64 = libc::strlen(this);
        if (la != libc::strlen(other)) { return false; }
        return libc::strncmp(this, other, la) == 0;
    }

    /// True when `this` begins with `prefix` (byte-wise). An empty prefix
    /// always matches; a prefix longer than `this` never does.
    starts_with(&this, prefix: string) -> boolean {
        if (this == null || prefix == null) { return false; }
        const plen: u64 = libc::strlen(prefix);
        if (plen == 0) { return true; }
        if (libc::strlen(this) < plen) { return false; }
        return libc::strncmp(this, prefix, plen) == 0;
    }

    /// Byte index of the first occurrence of `needle`, or -1 when absent.
    /// An empty needle matches at 0.
    find(&this, needle: string) -> i64 {
        if (this == null || needle == null) { return -1; }
        const hit: i8* = libc::strstr(this, needle) as i8*;
        if (hit == null) { return -1; }
        return intrinsics::ptr_diff(hit as void*, this as void*);
    }

    /// Byte index of the last occurrence of `needle`, or -1 when absent.
    /// An empty needle matches at the end (the string's length).
    rfind(&this, needle: string) -> i64 {
        if (this == null || needle == null) { return -1; }
        const nlen: i64 = libc::strlen(needle) as i64;
        const hlen: i64 = libc::strlen(this) as i64;
        if (nlen == 0) { return hlen; }
        if (nlen > hlen) { return -1; }
        mut i: i64 = hlen - nlen;
        while (i >= 0) {
            if (libc::strncmp(this + i, needle, nlen as u64) == 0) {
                return i;
            }
            i -= 1;
        }
        return -1;
    }

    /// Split on a single byte separator, returning each piece as a freshly
    /// allocated string. Adjacent separators yield empty pieces; the result
    /// always has (separator-count + 1) entries.
    split_char(&this, sep: i8) -> [string] {
        mut parts: [string] = [];
        if (this == null) { return parts; }
        const len: i64 = this.length() as i64;
        mut start: i64 = 0;
        for (mut i: i64 = 0; i < len; i++) {
            if (this[i] == sep) {
                parts.push(this.substr(start, i - start));
                start = i + 1;
            }
        }
        parts.push(this.substr(start, len - start));
        return parts;
    }

    /// Split on a multi-byte separator string. An empty separator yields the
    /// whole string as a single piece. Covers `::`-style segmentation.
    split(&this, sep: string) -> [string] {
        mut parts: [string] = [];
        if (this == null) { return parts; }
        const total: i64 = this.length() as i64;
        const slen: i64 = libc::strlen(sep) as i64;
        if (slen == 0) { parts.push(this.substr(0, total)); return parts; }
        mut i: i64 = 0;
        mut seg_start: i64 = 0;
        while (i <= total - slen) {
            if (libc::strncmp(this + i, sep, slen as u64) == 0) {
                parts.push(this.substr(seg_start, i - seg_start));
                i += slen;
                seg_start = i;
            } else {
                i += 1;
            }
        }
        parts.push(this.substr(seg_start, total - seg_start));
        return parts;
    }

    /// Like `split`, but drops empty pieces: leading, trailing, and
    /// consecutive separators produce no entry, and empty input yields an
    /// empty array. Useful for `::`-delimited names and `/`-delimited paths
    /// where blank segments are meaningless.
    split_nonempty(&this, sep: string) -> [string] {
        mut out: [string] = [];
        if (this == null) { return out; }
        const total: i64 = this.length() as i64;
        const slen: i64 = libc::strlen(sep) as i64;
        if (slen == 0) {
            if (total > 0) { out.push(this.substr(0, total)); }
            return out;
        }
        mut i: i64 = 0;
        mut start: i64 = 0;
        while (i <= total - slen) {
            if (libc::strncmp(this + i, sep, slen as u64) == 0) {
                if (i > start) { out.push(this.substr(start, i - start)); }
                i += slen;
                start = i;
            } else {
                i += 1;
            }
        }
        if (start < total) { out.push(this.substr(start, total - start)); }
        return out;
    }

    /// Replace every non-overlapping occurrence of `from` with `to`, returning
    /// a freshly allocated string. An empty `from` returns `this` unchanged.
    replace(&this, from: string, to: string) -> string {
        if (this == null) { return ""; }
        const flen: i64 = libc::strlen(from) as i64;
        const total: i64 = this.length() as i64;
        if (flen == 0) { return this.substr(0, total); }
        mut result: string = "";
        mut i: i64 = 0;
        mut seg_start: i64 = 0;
        while (i <= total - flen) {
            if (libc::strncmp(this + i, from, flen as u64) == 0) {
                result = result.append(this.substr(seg_start, i - seg_start));
                result = result.append(to);
                i += flen;
                seg_start = i;
            } else {
                i += 1;
            }
        }
        return result.append(this.substr(seg_start, total - seg_start));
    }

    /// ASCII-fold to lowercase, returning a freshly allocated string.
    to_ascii_lower(&this) -> string {
        if (this == null) { return ""; }
        const len: i64 = this.length() as i64;
        mut buf: string = allocator::alloc((len + 1) as u64, 1) as string;
        if ((buf as void*) == null) {
            core::panic("string::to_ascii_lower: allocation failed", intrinsics::location());
        }
        for (mut i: i64 = 0; i < len; i++) {
            const c: char = this[i];
            buf[i] = c.to_ascii_lowercase();
        }
        buf[len] = 0;
        return buf;
    }

    /// ASCII-fold to uppercase, returning a freshly allocated string.
    to_ascii_upper(&this) -> string {
        if (this == null) { return ""; }
        const len: i64 = this.length() as i64;
        mut buf: string = allocator::alloc((len + 1) as u64, 1) as string;
        if ((buf as void*) == null) {
            core::panic("string::to_ascii_upper: allocation failed", intrinsics::location());
        }
        for (mut i: i64 = 0; i < len; i++) {
            const c: char = this[i];
            buf[i] = c.to_ascii_uppercase();
        }
        buf[len] = 0;
        return buf;
    }

    /// The final path component: everything after the last `/` or `\`.
    basename(&this) -> string {
        const len: i64 = this.length() as i64;
        mut last_sep: i64 = -1;
        for (mut i: i64 = 0; i < len; i++) {
            if (this[i] == 47 || this[i] == 92) { last_sep = i; }   // '/' or '\'
        }
        return this.substr(last_sep + 1, len - (last_sep + 1));
    }

    /// The file stem: `basename` with its final `.ext` removed. A leading-dot
    /// name (e.g. `.gitignore`) is treated as having no extension.
    stem(&this) -> string {
        const base: string = this.basename();
        const blen: i64 = base.length() as i64;
        mut dot: i64 = -1;
        for (mut i: i64 = 0; i < blen; i++) {
            if (base[i] == 46) { dot = i; }     // '.'
        }
        if (dot <= 0) { return base; }
        return base.substr(0, dot);
    }

    /// The file extension without the dot, or "" when there is none. A
    /// leading-dot name (e.g. `.gitignore`) has no extension.
    extension(&this) -> string {
        const base: string = this.basename();
        const blen: i64 = base.length() as i64;
        mut dot: i64 = -1;
        for (mut i: i64 = 0; i < blen; i++) {
            if (base[i] == 46) { dot = i; }     // '.'
        }
        if (dot <= 0) { return ""; }
        return base.substr(dot + 1, blen - (dot + 1));
    }

    /// Join `seg` onto `this` with a single `/` separator. An empty `this`
    /// returns `seg`; an empty `seg` returns `this`; an absolute `seg`
    /// (leading separator) replaces `this` entirely.
    join(&this, seg: string) -> string {
        if (this == null || this.is_empty()) { return seg; }
        if (seg == null || seg.length() == 0) { return this; }
        if (seg[0] == 47 || seg[0] == 92) { return seg; }       // absolute
        const len: i64 = this.length() as i64;
        const last: char = this[len - 1];
        if (last == 47 || last == 92) { return this.append(seg); }
        return this.append("/").append(seg);
    }
}

/// Radix-aware parse core backing `string::parse_int<T>`. Accepts an
/// optional leading sign, detects a `0x`/`0o`/`0b` prefix,
/// skips `_` separators, and accumulates until the first character invalid for
/// the detected base. A `-` negates and WRAPS into the unsigned result (so an
/// `i*` width recovers the right two's-complement value, and a `u*` width
/// recovers the wrapped magnitude - matching the historical literal parser).
/// Overflow wraps; "" or garbage yields 0.
///
/// The digits are read a run at a time by `u64::parse_radix_prefix`; a run
/// ends at a `_` or before a digit that would overflow, and the next run
/// starts there.  Each run is folded in as `value * base^length + run`,
/// which wraps to exactly what folding its digits one at a time would.
private function string_parse_radix_u64(s: string) -> u64 {
    if (s == null) { return 0; }
    mut i: i64 = 0;
    mut negate: boolean = false;
    if (s[i] == 45) { negate = true; i += 1; }              // '-'
    else if (s[i] == 43) { i += 1; }                        // '+'

    mut base: u64 = 10;
    if (s[i] == 48 && (s[i+1] == 120 || s[i+1] == 88))      { base = 16; i += 2; }  // 0x/0X
    else if (s[i] == 48 && (s[i+1] == 98 || s[i+1] == 66))  { base = 2;  i += 2; }  // 0b/0B
    else if (s[i] == 48 && (s[i+1] == 111 || s[i+1] == 79)) { base = 8;  i += 2; }  // 0o/0O

    const length: i64 = s.length() as i64;
    mut acc: u64 = 0;
    while (i < length) {
        if (s[i] == 95) { i += 1; continue; }               // '_'
        match (u64::parse_radix_prefix(Slice::from_raw((s as u8*) + i, length - i), base as u32)) {
            Option::Some(run) => {
                mut scale: u64 = 1;
                for (mut k: i64 = 0; k < run.1; k++) { scale = scale * base; }
                acc = acc * scale + run.0;
                i += run.1;
            }
            Option::None => { break; }
        }
    }
    if (negate) { return (0 - acc as i64) as u64; }
    return acc;
}

/// Signed view of the parse core: parse as wrapped-unsigned, reinterpret.
private function string_parse_radix_i64(s: string) -> i64 {
    return string_parse_radix_u64(s) as i64;
}
