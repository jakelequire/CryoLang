///! Methods on primitive types.
///!
///! Cryo lets `implement` blocks extend primitive types. This module uses
///! that sparingly, only for things that aren't already one-liners with
///! the built-in operators.
///!
///! Heavy numeric operations such as pow, log, and gcd are not defined
///! here; they belong in a dedicated numeric-operations module that spans
///! all widths through traits.
///!
///! ## Integer overflow contract (frozen for 1.0)
///!
///! The arithmetic operators on every integer width are silent
///! two's-complement **wrapping** on overflow - there is no trap and no
///! diagnostic. Code that must detect overflow asks each width's
///! `checked_add`, `checked_subtract` and `checked_multiply`, which answer
///! `None` where the operator would wrap, or clamps with
///! `saturating_add`, `saturating_subtract` and `saturating_multiply`,
///! which answer the bound the true result lies past. The wrapping `abs`
///! methods below are one visible consequence of the operators (see each
///! `abs`); the signed widths' `checked_abs` answers `None` for the one
///! value `abs` wraps on.
///!
///! A width narrower than 64 bits computes in its 64-bit counterpart,
///! where the true result always fits, and range-checks it; `isize` and
///! `usize` delegate to `i64` and `u64`.
///!
///! `abs`, `checked_abs` and `clamp` are methods of each numeric type
///! rather than generic functions: their bodies compare with and negate
///! from a literal `0`, and no trait says a literal converts to `T`.
///!
///! ## Buffer-write formatting
///!
///! Integer-to-ASCII conversion lives as `to_decimal_buf` / `to_hex_buf` /
///! `to_oct_buf` / `to_bin_buf` methods on the unsigned types (and
///! `to_decimal_buf` on signed). They write into a caller-owned `u8*`
///! and return the number of bytes written. No heap traffic: the digit
///! loop runs in a stack scratch and copies in one shot. Float
///! formatting lives in `fmt::float` because it needs libm; layering
///! keeps libc out of `core`.

namespace std::core::primitives;

import std::core::intrinsics;
import std::core::option::{ Option };
import std::core::mem;
import std::core::slice::{ Slice };
import std::alloc::allocator;
import std::ffi::libc;
import std::math::{ FpCategory };

// Each integer type's `MAX_*_DIGITS` constants bound the digits its buffer
// writers produce, so a caller sizes a buffer by them: a signed type's
// decimal count includes the `-` of its `MIN`, and an unsigned type has a
// count for each base it writes.

// Character classification. Each of these aggregates a range check
// readers otherwise have to squint at.
implement char {
    const MIN: char = '\0';
    /// The largest Unicode scalar value, U+10FFFF.
    const MAX: char = '\u{10FFFF}';
    const BITS: u32 = 32;

    is_digit(&this) -> boolean {
        return this >= '0' && this <= '9';
    }

    is_alpha(&this) -> boolean {
        return (this >= 'A' && this <= 'Z') || (this >= 'a' && this <= 'z');
    }

    is_alphanumeric(&this) -> boolean {
        return this.is_alpha() || this.is_digit();
    }

    /// ASCII hexadecimal digit: `0`-`9`, `a`-`f`, or `A`-`F`.
    is_hex_digit(&this) -> boolean {
        return this.is_digit()
            || (this >= 'a' && this <= 'f')
            || (this >= 'A' && this <= 'F');
    }

    is_whitespace(&this) -> boolean {
        return this == ' ' || this == '\t' || this == '\n'
            || this == '\r' || this == '\v' || this == '\f';
    }

    /// True when the scalar is in the 7-bit ASCII range (0..=127).
    is_ascii(&this) -> boolean {
        return (this as u32) < 128;
    }

    /// ASCII fold to lowercase. Non-ASCII scalars pass through unchanged;
    /// full Unicode case folding requires a table beyond this module.
    to_ascii_lowercase(&this) -> char {
        if (this >= 'A' && this <= 'Z') {
            return (this as u32 + 32) as char;
        }
        return this;
    }

    /// ASCII fold to uppercase. Non-ASCII scalars pass through unchanged.
    to_ascii_uppercase(&this) -> char {
        if (this >= 'a' && this <= 'z') {
            return (this as u32 - 32) as char;
        }
        return this;
    }

    /// Numeric value of a hex digit (`0`-`9`, `a`-`f`, `A`-`F`), or -1 when
    /// `this` is not a hex digit. Consolidates the nibble-decode loops that
    /// the compiler hand-rolls in literal/char parsing.
    hex_value(&this) -> i32 {
        if (this >= '0' && this <= '9') { return (this as u32 - ('0' as u32)) as i32; }
        if (this >= 'a' && this <= 'f') { return (this as u32 - ('a' as u32) + 10) as i32; }
        if (this >= 'A' && this <= 'F') { return (this as u32 - ('A' as u32) + 10) as i32; }
        return -1;
    }
}

// Range bounds, width, abs, checked_abs and clamp for the signed integer
// widths.  `abs` wraps at the type's `MIN` (two's complement has no positive
// counterpart for the most-negative value): `i8::MIN.abs()` is `-128`, not
// `128`; `checked_abs` answers `None` there instead.  Narrower widths
// delegate to `i64` for the decimal-write digit loop so the implementation
// lives in one place (down in the `implement i64` block).
implement i8 {
    const MIN: i8 = -128;
    const MAX: i8 = 127;
    const BITS: u32 = 8;
    const MAX_DECIMAL_DIGITS: i64 = 4;     // "-128"

    abs(&this) -> i8 {
        if (this < 0) { return -this as i8; }
        return this;
    }

    /// `Some(|this|)`, or `None` for `MIN`, whose magnitude is not
    /// representable: only it negates to a value still negative.
    checked_abs(&this) -> Option<i8> {
        if (this < 0) {
            const neg: i8 = -this as i8;
            if (neg < 0) { return Option::None; }
            return Option::Some(neg);
        }
        return Option::Some(this);
    }

    /// `this` confined to `[lo, hi]`.
    clamp(&this, lo: i8, hi: i8) -> i8 {
        if (this < lo) { return lo; }
        if (this > hi) { return hi; }
        return this;
    }

    /// `this + other`, or `None` where the sum leaves `i8`'s range.
    checked_add(&this, other: i8) -> Option<i8> {
        const sum: i64 = (this as i64) + (other as i64);
        if (sum < i8::MIN as i64 || sum > i8::MAX as i64) { return Option::None; }
        return Option::Some(sum as i8);
    }

    /// `this - other`, or `None` where the difference leaves `i8`'s range.
    checked_subtract(&this, other: i8) -> Option<i8> {
        const difference: i64 = (this as i64) - (other as i64);
        if (difference < i8::MIN as i64 || difference > i8::MAX as i64) { return Option::None; }
        return Option::Some(difference as i8);
    }

    /// `this * other`, or `None` where the product leaves `i8`'s range.
    checked_multiply(&this, other: i8) -> Option<i8> {
        const product: i64 = (this as i64) * (other as i64);
        if (product < i8::MIN as i64 || product > i8::MAX as i64) { return Option::None; }
        return Option::Some(product as i8);
    }

    /// `this + other`, or the bound of `i8` the sum lies past.
    saturating_add(&this, other: i8) -> i8 {
        return ((this as i64) + (other as i64)).clamp(i8::MIN as i64, i8::MAX as i64) as i8;
    }

    /// `this - other`, or the bound of `i8` the difference lies past.
    saturating_subtract(&this, other: i8) -> i8 {
        return ((this as i64) - (other as i64)).clamp(i8::MIN as i64, i8::MAX as i64) as i8;
    }

    /// `this * other`, or the bound of `i8` the product lies past.
    saturating_multiply(&this, other: i8) -> i8 {
        return ((this as i64) * (other as i64)).clamp(i8::MIN as i64, i8::MAX as i64) as i8;
    }

    /// Buffer must hold at least `i8::MAX_DECIMAL_DIGITS` bytes.
    to_decimal_buf(&this, buffer: u8*) -> i64 {
        const v: i64 = this as i64;
        return v.to_decimal_buf(buffer);
    }
}

implement i16 {
    const MIN: i16 = -32768;
    const MAX: i16 = 32767;
    const BITS: u32 = 16;
    const MAX_DECIMAL_DIGITS: i64 = 6;     // "-32768"

    abs(&this) -> i16 {
        if (this < 0) { return -this as i16; }
        return this;
    }

    /// `Some(|this|)`, or `None` for `MIN`, whose magnitude is not
    /// representable: only it negates to a value still negative.
    checked_abs(&this) -> Option<i16> {
        if (this < 0) {
            const neg: i16 = -this as i16;
            if (neg < 0) { return Option::None; }
            return Option::Some(neg);
        }
        return Option::Some(this);
    }

    /// `this` confined to `[lo, hi]`.
    clamp(&this, lo: i16, hi: i16) -> i16 {
        if (this < lo) { return lo; }
        if (this > hi) { return hi; }
        return this;
    }

    /// `this + other`, or `None` where the sum leaves `i16`'s range.
    checked_add(&this, other: i16) -> Option<i16> {
        const sum: i64 = (this as i64) + (other as i64);
        if (sum < i16::MIN as i64 || sum > i16::MAX as i64) { return Option::None; }
        return Option::Some(sum as i16);
    }

    /// `this - other`, or `None` where the difference leaves `i16`'s range.
    checked_subtract(&this, other: i16) -> Option<i16> {
        const difference: i64 = (this as i64) - (other as i64);
        if (difference < i16::MIN as i64 || difference > i16::MAX as i64) { return Option::None; }
        return Option::Some(difference as i16);
    }

    /// `this * other`, or `None` where the product leaves `i16`'s range.
    checked_multiply(&this, other: i16) -> Option<i16> {
        const product: i64 = (this as i64) * (other as i64);
        if (product < i16::MIN as i64 || product > i16::MAX as i64) { return Option::None; }
        return Option::Some(product as i16);
    }

    /// `this + other`, or the bound of `i16` the sum lies past.
    saturating_add(&this, other: i16) -> i16 {
        return ((this as i64) + (other as i64)).clamp(i16::MIN as i64, i16::MAX as i64) as i16;
    }

    /// `this - other`, or the bound of `i16` the difference lies past.
    saturating_subtract(&this, other: i16) -> i16 {
        return ((this as i64) - (other as i64)).clamp(i16::MIN as i64, i16::MAX as i64) as i16;
    }

    /// `this * other`, or the bound of `i16` the product lies past.
    saturating_multiply(&this, other: i16) -> i16 {
        return ((this as i64) * (other as i64)).clamp(i16::MIN as i64, i16::MAX as i64) as i16;
    }

    /// Buffer must hold at least `i16::MAX_DECIMAL_DIGITS` bytes.
    to_decimal_buf(&this, buffer: u8*) -> i64 {
        const v: i64 = this as i64;
        return v.to_decimal_buf(buffer);
    }
}

implement i32 {
    const MIN: i32 = -2147483648;
    const MAX: i32 = 2147483647;
    const BITS: u32 = 32;
    const MAX_DECIMAL_DIGITS: i64 = 11;    // "-2147483648"

    /// Wraps at `i32::MIN`: the most-negative value has no
    /// positive counterpart in two's complement, so `i32::MIN.abs()`
    /// is itself; `checked_abs` answers `None` there.
    abs(&this) -> i32 {
        if (this < 0) { return -this; }
        return this;
    }

    /// `Some(|this|)`, or `None` for `MIN`, whose magnitude is not
    /// representable: only it negates to a value still negative.
    checked_abs(&this) -> Option<i32> {
        if (this < 0) {
            const neg: i32 = -this;
            if (neg < 0) { return Option::None; }
            return Option::Some(neg);
        }
        return Option::Some(this);
    }

    /// `this` confined to `[lo, hi]`.
    clamp(&this, lo: i32, hi: i32) -> i32 {
        if (this < lo) { return lo; }
        if (this > hi) { return hi; }
        return this;
    }

    /// `this + other`, or `None` where the sum leaves `i32`'s range.
    checked_add(&this, other: i32) -> Option<i32> {
        const sum: i64 = (this as i64) + (other as i64);
        if (sum < i32::MIN as i64 || sum > i32::MAX as i64) { return Option::None; }
        return Option::Some(sum as i32);
    }

    /// `this - other`, or `None` where the difference leaves `i32`'s range.
    checked_subtract(&this, other: i32) -> Option<i32> {
        const difference: i64 = (this as i64) - (other as i64);
        if (difference < i32::MIN as i64 || difference > i32::MAX as i64) { return Option::None; }
        return Option::Some(difference as i32);
    }

    /// `this * other`, or `None` where the product leaves `i32`'s range.
    checked_multiply(&this, other: i32) -> Option<i32> {
        const product: i64 = (this as i64) * (other as i64);
        if (product < i32::MIN as i64 || product > i32::MAX as i64) { return Option::None; }
        return Option::Some(product as i32);
    }

    /// `this + other`, or the bound of `i32` the sum lies past.
    saturating_add(&this, other: i32) -> i32 {
        return ((this as i64) + (other as i64)).clamp(i32::MIN as i64, i32::MAX as i64) as i32;
    }

    /// `this - other`, or the bound of `i32` the difference lies past.
    saturating_subtract(&this, other: i32) -> i32 {
        return ((this as i64) - (other as i64)).clamp(i32::MIN as i64, i32::MAX as i64) as i32;
    }

    /// `this * other`, or the bound of `i32` the product lies past.
    saturating_multiply(&this, other: i32) -> i32 {
        return ((this as i64) * (other as i64)).clamp(i32::MIN as i64, i32::MAX as i64) as i32;
    }

    /// Buffer must hold at least `i32::MAX_DECIMAL_DIGITS` bytes.
    to_decimal_buf(&this, buffer: u8*) -> i64 {
        const v: i64 = this as i64;
        return v.to_decimal_buf(buffer);
    }
}

implement i64 {
    const MIN: i64 = -9223372036854775808;
    const MAX: i64 = 9223372036854775807;
    const BITS: u32 = 64;
    const MAX_DECIMAL_DIGITS: i64 = 20;    // "-9223372036854775808"

    abs(&this) -> i64 {
        if (this < 0) { return -this; }
        return this;
    }

    /// `Some(|this|)`, or `None` for `MIN`, whose magnitude is not
    /// representable: only it negates to a value still negative.
    checked_abs(&this) -> Option<i64> {
        if (this < 0) {
            const neg: i64 = -this;
            if (neg < 0) { return Option::None; }
            return Option::Some(neg);
        }
        return Option::Some(this);
    }

    /// `this` confined to `[lo, hi]`.
    clamp(&this, lo: i64, hi: i64) -> i64 {
        if (this < lo) { return lo; }
        if (this > hi) { return hi; }
        return this;
    }

    /// `this + other`, or `None` where the sum leaves `i64`'s range.
    checked_add(&this, other: i64) -> Option<i64> {
        if ((other > 0 && this > i64::MAX - other) || (other < 0 && this < i64::MIN - other)) {
            return Option::None;
        }
        return Option::Some(this + other);
    }

    /// `this - other`, or `None` where the difference leaves `i64`'s range.
    checked_subtract(&this, other: i64) -> Option<i64> {
        if ((other < 0 && this > i64::MAX + other) || (other > 0 && this < i64::MIN + other)) {
            return Option::None;
        }
        return Option::Some(this - other);
    }

    /// `this * other`, or `None` where the product leaves `i64`'s range:
    /// a wrapped product divided by one operand does not give the other.
    checked_multiply(&this, other: i64) -> Option<i64> {
        if (this == 0 || other == 0) { return Option::Some(0); }
        if ((this == -1 && other == i64::MIN) || (other == -1 && this == i64::MIN)) {
            return Option::None;
        }
        const product: i64 = this * other;
        if (product / other != this) { return Option::None; }
        return Option::Some(product);
    }

    /// `this + other`, or the bound of `i64` the sum lies past.
    saturating_add(&this, other: i64) -> i64 {
        return this.checked_add(other).unwrap_or(if (other > 0) { i64::MAX } else { i64::MIN });
    }

    /// `this - other`, or the bound of `i64` the difference lies past.
    saturating_subtract(&this, other: i64) -> i64 {
        return this.checked_subtract(other).unwrap_or(if (other < 0) { i64::MAX } else { i64::MIN });
    }

    /// `this * other`, or the bound of `i64` the product lies past: the
    /// upper one when the operands' signs agree.
    saturating_multiply(&this, other: i64) -> i64 {
        return this.checked_multiply(other).unwrap_or(
            if ((this < 0) == (other < 0)) { i64::MAX } else { i64::MIN });
    }

    /// `this / other` rounded toward negative infinity, where `/` rounds
    /// toward zero: the two differ when the division is inexact and the
    /// operands' signs differ.
    divide_floor(&this, other: i64) -> i64 {
        const quotient: i64 = this / other;
        if (this % other != 0 && (this < 0) != (other < 0)) { return quotient - 1; }
        return quotient;
    }

    /// The remainder `divide_floor` leaves, `this - other *
    /// this.divide_floor(other)`: zero or of `other`'s sign, where `%`
    /// takes `this`'s sign.
    modulo_floor(&this, other: i64) -> i64 {
        const remainder: i64 = this % other;
        if (remainder != 0 && (remainder < 0) != (other < 0)) { return remainder + other; }
        return remainder;
    }
}

// Unsigned range bounds + buffer-write formatting.  Narrower widths
// (`u8`, `u16`, `u32`) zero-extend to `u64` and delegate the digit loop
// to `u64`'s methods; the implementation lives in one place. Callers
// pick a smaller buffer per the `UN_MAX_*_DIGITS` constants above; the
// u64 implementation writes only the digits it needs.
implement u8 {
    const MIN: u8 = 0;
    const MAX: u8 = 255;
    const BITS: u32 = 8;
    const MAX_DECIMAL_DIGITS: i64 = 3;     // "255"
    const MAX_HEX_DIGITS: i64 = 2;
    const MAX_OCT_DIGITS: i64 = 3;
    const MAX_BIN_DIGITS: i64 = 8;

    /// `this` confined to `[lo, hi]`.
    clamp(&this, lo: u8, hi: u8) -> u8 {
        if (this < lo) { return lo; }
        if (this > hi) { return hi; }
        return this;
    }

    /// `this + other`, or `None` where the sum passes `u8::MAX`.
    checked_add(&this, other: u8) -> Option<u8> {
        const sum: u64 = (this as u64) + (other as u64);
        if (sum > u8::MAX as u64) { return Option::None; }
        return Option::Some(sum as u8);
    }

    /// `this - other`, or `None` where `other` is the larger.
    checked_subtract(&this, other: u8) -> Option<u8> {
        if (other > this) { return Option::None; }
        return Option::Some(this - other);
    }

    /// `this * other`, or `None` where the product passes `u8::MAX`.
    checked_multiply(&this, other: u8) -> Option<u8> {
        const product: u64 = (this as u64) * (other as u64);
        if (product > u8::MAX as u64) { return Option::None; }
        return Option::Some(product as u8);
    }

    /// `this + other`, or `u8::MAX` where the sum passes it.
    saturating_add(&this, other: u8) -> u8 {
        return ((this as u64) + (other as u64)).clamp(0, u8::MAX as u64) as u8;
    }

    /// `this - other`, or `0` where `other` is the larger.
    saturating_subtract(&this, other: u8) -> u8 {
        if (other > this) { return 0; }
        return this - other;
    }

    /// `this * other`, or `u8::MAX` where the product passes it.
    saturating_multiply(&this, other: u8) -> u8 {
        return ((this as u64) * (other as u64)).clamp(0, u8::MAX as u64) as u8;
    }

    // ASCII classification of a byte, with the same meaning as `char`'s
    // methods of the same names: a byte of a multi-byte UTF-8 sequence is
    // 0x80 or above and answers false to every one of them.

    /// ASCII decimal digit: `0`-`9`.
    is_digit(&this) -> boolean {
        return this >= 0x30 && this <= 0x39;
    }

    /// ASCII letter: `A`-`Z` or `a`-`z`.
    is_alpha(&this) -> boolean {
        return (this >= 0x41 && this <= 0x5A) || (this >= 0x61 && this <= 0x7A);
    }

    /// ASCII hexadecimal digit: `0`-`9`, `a`-`f`, or `A`-`F`.
    is_hex_digit(&this) -> boolean {
        return this.is_digit()
            || (this >= 0x61 && this <= 0x66)
            || (this >= 0x41 && this <= 0x46);
    }

    /// ASCII whitespace: space, tab, LF, VT, FF, CR.
    is_whitespace(&this) -> boolean {
        return this == 0x20 || (this >= 0x09 && this <= 0x0D);
    }

    /// ASCII fold to lowercase. Every byte outside `A`-`Z` passes through
    /// unchanged.
    to_ascii_lowercase(&this) -> u8 {
        if (this >= 0x41 && this <= 0x5A) { return this + 32; }
        return this;
    }

    /// ASCII fold to uppercase. Every byte outside `a`-`z` passes through
    /// unchanged.
    to_ascii_uppercase(&this) -> u8 {
        if (this >= 0x61 && this <= 0x7A) { return this - 32; }
        return this;
    }

    to_decimal_buf(&this, buffer: u8*) -> i64 {
        const v: u64 = this as u64;
        return v.to_decimal_buf(buffer);
    }

    to_hex_buf(&this, buffer: u8*) -> i64 {
        const v: u64 = this as u64;
        return v.to_hex_buf(buffer);
    }

    to_hex_upper_buf(&this, buffer: u8*) -> i64 {
        const v: u64 = this as u64;
        return v.to_hex_upper_buf(buffer);
    }

    to_oct_buf(&this, buffer: u8*) -> i64 {
        const v: u64 = this as u64;
        return v.to_oct_buf(buffer);
    }

    to_bin_buf(&this, buffer: u8*) -> i64 {
        const v: u64 = this as u64;
        return v.to_bin_buf(buffer);
    }
}

implement u16 {
    const MIN: u16 = 0;
    const MAX: u16 = 65535;
    const BITS: u32 = 16;
    const MAX_DECIMAL_DIGITS: i64 = 5;     // "65535"
    const MAX_HEX_DIGITS: i64 = 4;
    const MAX_OCT_DIGITS: i64 = 6;
    const MAX_BIN_DIGITS: i64 = 16;

    /// `this` confined to `[lo, hi]`.
    clamp(&this, lo: u16, hi: u16) -> u16 {
        if (this < lo) { return lo; }
        if (this > hi) { return hi; }
        return this;
    }

    /// `this + other`, or `None` where the sum passes `u16::MAX`.
    checked_add(&this, other: u16) -> Option<u16> {
        const sum: u64 = (this as u64) + (other as u64);
        if (sum > u16::MAX as u64) { return Option::None; }
        return Option::Some(sum as u16);
    }

    /// `this - other`, or `None` where `other` is the larger.
    checked_subtract(&this, other: u16) -> Option<u16> {
        if (other > this) { return Option::None; }
        return Option::Some(this - other);
    }

    /// `this * other`, or `None` where the product passes `u16::MAX`.
    checked_multiply(&this, other: u16) -> Option<u16> {
        const product: u64 = (this as u64) * (other as u64);
        if (product > u16::MAX as u64) { return Option::None; }
        return Option::Some(product as u16);
    }

    /// `this + other`, or `u16::MAX` where the sum passes it.
    saturating_add(&this, other: u16) -> u16 {
        return ((this as u64) + (other as u64)).clamp(0, u16::MAX as u64) as u16;
    }

    /// `this - other`, or `0` where `other` is the larger.
    saturating_subtract(&this, other: u16) -> u16 {
        if (other > this) { return 0; }
        return this - other;
    }

    /// `this * other`, or `u16::MAX` where the product passes it.
    saturating_multiply(&this, other: u16) -> u16 {
        return ((this as u64) * (other as u64)).clamp(0, u16::MAX as u64) as u16;
    }

    to_decimal_buf(&this, buffer: u8*) -> i64 {
        const v: u64 = this as u64;
        return v.to_decimal_buf(buffer);
    }

    to_hex_buf(&this, buffer: u8*) -> i64 {
        const v: u64 = this as u64;
        return v.to_hex_buf(buffer);
    }

    to_hex_upper_buf(&this, buffer: u8*) -> i64 {
        const v: u64 = this as u64;
        return v.to_hex_upper_buf(buffer);
    }

    to_oct_buf(&this, buffer: u8*) -> i64 {
        const v: u64 = this as u64;
        return v.to_oct_buf(buffer);
    }

    to_bin_buf(&this, buffer: u8*) -> i64 {
        const v: u64 = this as u64;
        return v.to_bin_buf(buffer);
    }
}

implement u32 {
    const MIN: u32 = 0;
    const MAX: u32 = 4294967295;
    const BITS: u32 = 32;
    const MAX_DECIMAL_DIGITS: i64 = 10;    // "4294967295"
    const MAX_HEX_DIGITS: i64 = 8;
    const MAX_OCT_DIGITS: i64 = 11;
    const MAX_BIN_DIGITS: i64 = 32;

    /// `this` confined to `[lo, hi]`.
    clamp(&this, lo: u32, hi: u32) -> u32 {
        if (this < lo) { return lo; }
        if (this > hi) { return hi; }
        return this;
    }

    /// `this + other`, or `None` where the sum passes `u32::MAX`.
    checked_add(&this, other: u32) -> Option<u32> {
        const sum: u64 = (this as u64) + (other as u64);
        if (sum > u32::MAX as u64) { return Option::None; }
        return Option::Some(sum as u32);
    }

    /// `this - other`, or `None` where `other` is the larger.
    checked_subtract(&this, other: u32) -> Option<u32> {
        if (other > this) { return Option::None; }
        return Option::Some(this - other);
    }

    /// `this * other`, or `None` where the product passes `u32::MAX`.
    checked_multiply(&this, other: u32) -> Option<u32> {
        const product: u64 = (this as u64) * (other as u64);
        if (product > u32::MAX as u64) { return Option::None; }
        return Option::Some(product as u32);
    }

    /// `this + other`, or `u32::MAX` where the sum passes it.
    saturating_add(&this, other: u32) -> u32 {
        return ((this as u64) + (other as u64)).clamp(0, u32::MAX as u64) as u32;
    }

    /// `this - other`, or `0` where `other` is the larger.
    saturating_subtract(&this, other: u32) -> u32 {
        if (other > this) { return 0; }
        return this - other;
    }

    /// `this * other`, or `u32::MAX` where the product passes it.
    saturating_multiply(&this, other: u32) -> u32 {
        return ((this as u64) * (other as u64)).clamp(0, u32::MAX as u64) as u32;
    }

    /// The bits shifted left by `n` (modulo 32), those leaving the top
    /// re-entering at the bottom.
    rotate_left(&this, n: u32) -> u32 {
        return intrinsics::rotl32(this, n);
    }

    /// The bits shifted right by `n` (modulo 32), those leaving the bottom
    /// re-entering at the top.
    rotate_right(&this, n: u32) -> u32 {
        return intrinsics::rotr32(this, n);
    }

    to_decimal_buf(&this, buffer: u8*) -> i64 {
        const v: u64 = this as u64;
        return v.to_decimal_buf(buffer);
    }

    to_hex_buf(&this, buffer: u8*) -> i64 {
        const v: u64 = this as u64;
        return v.to_hex_buf(buffer);
    }

    to_hex_upper_buf(&this, buffer: u8*) -> i64 {
        const v: u64 = this as u64;
        return v.to_hex_upper_buf(buffer);
    }

    to_oct_buf(&this, buffer: u8*) -> i64 {
        const v: u64 = this as u64;
        return v.to_oct_buf(buffer);
    }

    to_bin_buf(&this, buffer: u8*) -> i64 {
        const v: u64 = this as u64;
        return v.to_bin_buf(buffer);
    }
}

implement u64 {
    const MIN: u64 = 0;
    const MAX: u64 = 18446744073709551615;
    const BITS: u32 = 64;
    const MAX_DECIMAL_DIGITS: i64 = 20;    // "18446744073709551615"
    const MAX_HEX_DIGITS: i64 = 16;
    const MAX_OCT_DIGITS: i64 = 22;
    const MAX_BIN_DIGITS: i64 = 64;

    /// `this` confined to `[lo, hi]`.
    clamp(&this, lo: u64, hi: u64) -> u64 {
        if (this < lo) { return lo; }
        if (this > hi) { return hi; }
        return this;
    }

    /// `this + other`, or `None` where the sum passes `u64::MAX`: a
    /// wrapped sum is smaller than either operand.
    checked_add(&this, other: u64) -> Option<u64> {
        const sum: u64 = this + other;
        if (sum < this) { return Option::None; }
        return Option::Some(sum);
    }

    /// `this - other`, or `None` where `other` is the larger.
    checked_subtract(&this, other: u64) -> Option<u64> {
        if (other > this) { return Option::None; }
        return Option::Some(this - other);
    }

    /// `this * other`, or `None` where the product passes `u64::MAX`.
    checked_multiply(&this, other: u64) -> Option<u64> {
        if (this != 0 && other > u64::MAX / this) { return Option::None; }
        return Option::Some(this * other);
    }

    /// `this + other`, or `u64::MAX` where the sum passes it.
    saturating_add(&this, other: u64) -> u64 {
        return this.checked_add(other).unwrap_or(u64::MAX);
    }

    /// `this - other`, or `0` where `other` is the larger.
    saturating_subtract(&this, other: u64) -> u64 {
        if (other > this) { return 0; }
        return this - other;
    }

    /// `this * other`, or `u64::MAX` where the product passes it.
    saturating_multiply(&this, other: u64) -> u64 {
        return this.checked_multiply(other).unwrap_or(u64::MAX);
    }

    /// The value `digits` writes in `radix`, every byte a digit of it:
    /// `0`-`9`, then `a`-`z` or `A`-`Z` for the digits from ten.  `None`
    /// when `digits` is empty, holds a byte that is no digit of `radix`,
    /// writes a value past `u64::MAX`, or `radix` is outside 2 to 36.  No
    /// sign, prefix or separator is read.
    static parse_radix(digits: Slice<u8>, radix: u32) -> Option<u64> {
        match (u64::parse_radix_prefix(digits, radix)) {
            Option::Some(parsed) => {
                if (parsed.1 == digits.length()) { return Option::Some(parsed.0); }
            }
            Option::None => { }
        }
        return Option::None;
    }

    /// The value of the digits of `radix` that `text` starts with, and the
    /// number of bytes they take.  The run ends at the first byte that is
    /// no digit, or before the first digit that would carry the value past
    /// `u64::MAX` - so a run that ends on a digit ended on overflow.
    /// `None` when `text` starts with no digit or `radix` is outside 2 to
    /// 36.
    static parse_radix_prefix(text: Slice<u8>, radix: u32) -> Option<(u64, i64)> {
        if (radix < 2 || radix > 36) { return Option::None; }
        const base: u64 = radix as u64;
        mut value: u64 = 0;
        mut length: i64 = 0;
        while (length < text.length()) {
            const byte: u8 = text[length];
            mut digit: u64 = base;
            if (byte >= '0' as u8 && byte <= '9' as u8) {
                digit = (byte - '0' as u8) as u64;
            } else if (byte >= 'a' as u8 && byte <= 'z' as u8) {
                digit = (byte - 'a' as u8) as u64 + 10;
            } else if (byte >= 'A' as u8 && byte <= 'Z' as u8) {
                digit = (byte - 'A' as u8) as u64 + 10;
            }
            if (digit >= base || value > (u64::MAX - digit) / base) { break; }
            value = value * base + digit;
            length += 1;
        }
        if (length == 0) { return Option::None; }
        return Option::Some((value, length));
    }

    /// The bits shifted left by `n` (modulo 64), those leaving the top
    /// re-entering at the bottom.
    rotate_left(&this, n: u32) -> u64 {
        return intrinsics::rotl64(this, n);
    }

    /// The bits shifted right by `n` (modulo 64), those leaving the bottom
    /// re-entering at the top.
    rotate_right(&this, n: u32) -> u64 {
        return intrinsics::rotr64(this, n);
    }

    // Buffer-write formatting. Each writes into a caller-owned `u8*` and
    // returns the number of bytes written. The caller picks the buffer
    // size from the `U64_MAX_*_DIGITS` constants above. This is the
    // canonical implementation; the narrower unsigned widths
    // (`u8`/`u16`/`u32`) above zero-extend to `u64` and reuse it.

    /// Write `this` in base 10 into `buffer`. Returns bytes written.
    /// `buffer` must hold at least `u64::MAX_DECIMAL_DIGITS` bytes.
    /// Builds the digits on a 20-byte stack scratch then copies in one
    /// shot; no heap traffic.
    to_decimal_buf(&this, buffer: u8*) -> i64 {
        if (this == 0) {
            buffer[0] = 0x30;
            return 1;
        }
        mut scratch: [u8; 20];
        mut cursor: i64 = 20;
        mut v: u64 = this;
        while (v > 0) {
            cursor = cursor - 1;
            scratch[cursor] = ((v % 10) as u8) + 0x30;
            v = v / 10;
        }
        const digits: i64 =20 - cursor;
        libc::memcpy(
            buffer as void*,
            (&scratch[0] + cursor) as void*,
            digits as u64
        );
        return digits;
    }

    /// Decimal text on a fresh heap buffer (caller owns), mirroring C's
    /// `"%llu"`.  For a no-alloc path, write into your own buffer with
    /// `to_decimal_buf`.
    to_decimal_str(&this) -> string {
        mut buf: string = allocator::alloc(24, 1) as string;
        if ((buf as void*) == null) {
            core::panic("u64::to_decimal_str: allocation failed", intrinsics::location());
        }
        const n: i64 = this.to_decimal_buf(buf as u8*);
        buf[n] = 0;
        return buf;
    }

    /// Lowercase hex. Returns bytes written.
    /// `buffer` must hold at least `u64::MAX_HEX_DIGITS` bytes.
    to_hex_buf(&this, buffer: u8*) -> i64 {
        return u64::to_hex_buf_with_table(this, buffer, "0123456789abcdef" as u8*);
    }

    /// Uppercase variant.
    to_hex_upper_buf(&this, buffer: u8*) -> i64 {
        return u64::to_hex_buf_with_table(this, buffer, "0123456789ABCDEF" as u8*);
    }

    /// Internal: hex writer parameterised by the digit table. Stays as a
    /// static helper rather than another method to avoid passing the
    /// table through `&this`.
    static to_hex_buf_with_table(value: u64, buffer: u8*, digits_table: u8*) -> i64 {
        if (value == 0) {
            buffer[0] = 0x30;
            return 1;
        }
        mut scratch: [u8; 16];
        mut cursor: i64 = 16;
        mut v: u64 = value;
        while (v > 0) {
            cursor = cursor - 1;
            scratch[cursor] = digits_table[v & 0xF];
            v = v >> 4;
        }
        const digits: i64 =16 - cursor;
        libc::memcpy(
            buffer as void*,
            (&scratch[0] + cursor) as void*,
            digits as u64
        );
        return digits;
    }

    /// Zero-padded fixed-width hex. Writes exactly `width` characters,
    /// truncating high nibbles if the value doesn't fit. Useful for
    /// pointer formatting (`width = 16`), hash dumps, binary protocols.
    to_hex_padded_buf(&this, buffer: u8*, width: i64) -> i64 {
        return u64::to_hex_padded_buf_with_table(this, buffer, width, "0123456789abcdef" as u8*);
    }

    /// Zero-padded fixed-width lowercase hex on a fresh heap buffer (caller
    /// owns): exactly `width` characters plus a NUL.  `width = 16` renders a
    /// full u64 (the pointer/hash-dump convention); a `width` of zero or
    /// less renders the empty string.
    to_hex_padded_str(&this, width: i64) -> string {
        const size: i64 = if (width > 0) { width } else { 0 };
        mut buf: string = allocator::alloc((size + 1) as u64, 1) as string;
        if ((buf as void*) == null) {
            core::panic("u64::to_hex_padded_str: allocation failed", intrinsics::location());
        }
        const n: i64 = this.to_hex_padded_buf(buf as u8*, size);
        buf[n] = 0;
        return buf;
    }

    to_hex_padded_upper_buf(&this, buffer: u8*, width: i64) -> i64 {
        return u64::to_hex_padded_buf_with_table(this, buffer, width, "0123456789ABCDEF" as u8*);
    }

    static to_hex_padded_buf_with_table(value: u64, buffer: u8*, width: i64,
                                         digits_table: u8*) -> i64 {
        if (width <= 0) { return 0; }
        mut v: u64 = value;
        mut i: i64 = width;
        while (i > 0) {
            i = i - 1;
            buffer[i] = digits_table[v & 0xF];
            v = v >> 4;
        }
        return width;
    }

    /// Base 8. `buffer` must hold at least `u64::MAX_OCT_DIGITS` bytes.
    to_oct_buf(&this, buffer: u8*) -> i64 {
        if (this == 0) {
            buffer[0] = 0x30;
            return 1;
        }
        mut scratch: [u8; 22];
        mut cursor: i64 = 22;
        mut v: u64 = this;
        while (v > 0) {
            cursor = cursor - 1;
            scratch[cursor] = ((v & 0x7) as u8) + 0x30;
            v = v >> 3;
        }
        const digits: i64 =22 - cursor;
        libc::memcpy(
            buffer as void*,
            (&scratch[0] + cursor) as void*,
            digits as u64
        );
        return digits;
    }

    /// Base 2. `buffer` must hold at least `u64::MAX_BIN_DIGITS` bytes.
    to_bin_buf(&this, buffer: u8*) -> i64 {
        if (this == 0) {
            buffer[0] = 0x30;
            return 1;
        }
        mut scratch: [u8; 64];
        mut cursor: i64 = 64;
        mut v: u64 = this;
        while (v > 0) {
            cursor = cursor - 1;
            scratch[cursor] = ((v & 0x1) as u8) + 0x30;
            v = v >> 1;
        }
        const digits: i64 =64 - cursor;
        libc::memcpy(
            buffer as void*,
            (&scratch[0] + cursor) as void*,
            digits as u64
        );
        return digits;
    }

    /// Zero-padded fixed-width decimal. Writes exactly `width` digits,
    /// truncating the high end if the value doesn't fit. Used for the
    /// fractional piece of a float where the digit count is known
    /// ahead of time.
    to_decimal_padded_buf(&this, buffer: u8*, width: i64) -> i64 {
        if (width <= 0) { return 0; }
        mut v: u64 = this;
        mut i: i64 = width;
        while (i > 0) {
            i = i - 1;
            buffer[i] = ((v % 10) as u8) + 0x30;
            v = v / 10;
        }
        return width;
    }
}

implement i64 {
    /// Write signed `this` in base 10. Returns bytes written.
    /// `buffer` must hold at least `i64::MAX_DECIMAL_DIGITS` bytes.
    to_decimal_buf(&this, buffer: u8*) -> i64 {
        if (this < 0) {
