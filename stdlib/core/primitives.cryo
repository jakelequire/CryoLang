        mut scratch: [u8; 39];
        mut cursor: i64 = 39;
        mut v: u128 = this;
        while (v > 0) {
            cursor = cursor - 1;
            scratch[cursor] = ((v % 10) as u8) + 0x30;
            v = v / 10;
