    const BITS: u32 = 128;
    const MAX_DECIMAL_DIGITS: i64 = 39;    // "340282366920938463463374607431768211455"
    const MAX_HEX_DIGITS: i64 = 32;
    const MAX_OCT_DIGITS: i64 = 43;        // ceil(128 / 3)
    const MAX_BIN_DIGITS: i64 = 128;

    /// `this` confined to `[lo, hi]`.
    clamp(&this, lo: u128, hi: u128) -> u128 {
        if (this < lo) { return lo; }
        if (this > hi) { return hi; }
        return this;
    }

    /// `this + other`, or `None` where the sum passes `u128::MAX`: a
    /// wrapped sum is smaller than either operand.
    checked_add(&this, other: u128) -> Option<u128> {
        const sum: u128 = this + other;
        if (sum < this) { return Option::None; }
        return Option::Some(sum);
    }

    /// `this - other`, or `None` where `other` is the larger.
    checked_subtract(&this, other: u128) -> Option<u128> {
        if (other > this) { return Option::None; }
        return Option::Some(this - other);
    }

    /// `this * other`, or `None` where the product passes `u128::MAX`.
    checked_multiply(&this, other: u128) -> Option<u128> {
        if (this != 0 && other > u128::MAX / this) { return Option::None; }
        return Option::Some(this * other);
    }

    /// `this + other`, or `u128::MAX` where the sum passes it.
    saturating_add(&this, other: u128) -> u128 {
        return this.checked_add(other).unwrap_or(u128::MAX);
    }

    /// `this - other`, or `0` where `other` is the larger.
    saturating_subtract(&this, other: u128) -> u128 {
        if (other > this) { return 0; }
        return this - other;
    }

    /// `this * other`, or `u128::MAX` where the product passes it.
    saturating_multiply(&this, other: u128) -> u128 {
        return this.checked_multiply(other).unwrap_or(u128::MAX);
    }

    /// Write `this` in base 10 into `buffer`. Returns bytes written.
    /// `buffer` must hold at least `u128::MAX_DECIMAL_DIGITS` bytes.
    to_decimal_buf(&this, buffer: u8*) -> i64 {
        if (this == 0) {
            buffer[0] = 0x30;
            return 1;
