    /// Decimal text on a fresh heap buffer (caller owns).  For a no-alloc
    /// path, write into your own buffer with `to_decimal_buf`.
    to_decimal_str(&this) -> string {
        mut buf: string = allocator::alloc(40, 1) as string;   // 39 digits + NUL
        if ((buf as void*) == null) {
            core::panic("u128::to_decimal_str: allocation failed", intrinsics::location());
