///! Methods on primitive types.
///!
///! Cryo lets `implement` blocks extend primitive types. This module uses
///! that sparingly — only for things that aren't already one-liners with
///! the built-in operators.
///!
///! Heavy numeric operations such as pow, log, gcd, and checked arithmetic
///! are not defined here; they belong in a dedicated numeric-operations
///! module that spans all widths through traits.
///!
///! ## Buffer-write formatting
///!
///! Integer-to-ASCII conversion lives as `to_decimal_buf` / `to_hex_buf` /
///! `to_oct_buf` / `to_bin_buf` methods on the unsigned types (and
///! `to_decimal_buf` on signed). They write into a caller-owned `u8*`
///! and return the number of bytes written. No heap traffic — the digit
///! loop runs in a stack scratch and copies in one shot. Float
///! formatting lives in `fmt::float` because it needs libm; layering
///! keeps libc out of `core`.

namespace std::core::primitives;

import core::intrinsics;

// ============================================================================
// Digit-count upper bounds — caller picks a buffer at least this big.
// ============================================================================

// Unsigned decimal: digits of the type's max value.
const U8_MAX_DECIMAL_DIGITS:  u64 = 3;   // "255"
const U16_MAX_DECIMAL_DIGITS: u64 = 5;   // "65535"
const U32_MAX_DECIMAL_DIGITS: u64 = 10;  // "4294967295"
const U64_MAX_DECIMAL_DIGITS: u64 = 20;  // "18446744073709551615"

// Signed decimal: sign + magnitude digits.
const I8_MAX_DECIMAL_DIGITS:  u64 = 4;   // "-128"
const I16_MAX_DECIMAL_DIGITS: u64 = 6;   // "-32768"
const I32_MAX_DECIMAL_DIGITS: u64 = 11;  // "-2147483648"
const I64_MAX_DECIMAL_DIGITS: u64 = 20;  // "-9223372036854775808"

// Hex: 2 nibbles per byte of the type.
const U8_MAX_HEX_DIGITS:  u64 = 2;
const U16_MAX_HEX_DIGITS: u64 = 4;
const U32_MAX_HEX_DIGITS: u64 = 8;
const U64_MAX_HEX_DIGITS: u64 = 16;

// Octal: digits to represent the type's max value.
const U8_MAX_OCT_DIGITS:  u64 = 3;
const U16_MAX_OCT_DIGITS: u64 = 6;
const U32_MAX_OCT_DIGITS: u64 = 11;
const U64_MAX_OCT_DIGITS: u64 = 22;

// Binary: one digit per bit of the type.
const U8_MAX_BIN_DIGITS:  u64 = 8;
const U16_MAX_BIN_DIGITS: u64 = 16;
const U32_MAX_BIN_DIGITS: u64 = 32;
const U64_MAX_BIN_DIGITS: u64 = 64;

// Character classification. Each of these aggregates a range check
// readers otherwise have to squint at.
implement char {
    is_digit(&this) -> boolean {
        return this >= '0' && this <= '9';
    }

    is_alpha(&this) -> boolean {
        return (this >= 'A' && this <= 'Z') || (this >= 'a' && this <= 'z');
    }

    is_alphanumeric(&this) -> boolean {
        return this.is_alpha() || this.is_digit();
    }

    is_whitespace(&this) -> boolean {
        return this == ' ' || this == '\t' || this == '\n'
            || this == '\r' || this == '\v' || this == '\f';
    }

    /// True when the scalar is in the 7-bit ASCII range (0..=127).
    is_ascii(&this) -> boolean {
        return (this as u32) < 128;
    }

    /// ASCII fold to lowercase. Non-ASCII scalars pass through unchanged
    /// — full Unicode case folding requires a table beyond this module.
    to_ascii_lowercase(&this) -> char {
        if (this >= 'A' && this <= 'Z') {
            return (this as u32 + 32) as char;
        }
        return this;
    }

    /// ASCII fold to uppercase. Non-ASCII scalars pass through unchanged.
    to_ascii_uppercase(&this) -> char {
        if (this >= 'a' && this <= 'z') {
            return (this as u32 - 32) as char;
        }
        return this;
    }
}

// Range bounds + abs for the signed integer widths. `abs` wraps at the
// type's min_value (two's complement has no positive counterpart for
// the most-negative value); when checked arithmetic lands, callers
// that care will use `checked_abs`. Narrower widths delegate to `i64`
// for the decimal-write digit loop so the implementation lives in one
// place (down in the `implement i64` block).
implement i8 {
    static min_value() -> i8 { return -128 as i8; }
    static max_value() -> i8 { return 127 as i8; }

    abs(&this) -> i8 {
        if (this < 0) { return -this as i8; }
        return this;
    }

    /// Buffer must hold at least `I8_MAX_DECIMAL_DIGITS` bytes.
    to_decimal_buf(&this, buffer: u8*) -> u64 {
        const v: i64 = this as i64;
        return v.to_decimal_buf(buffer);
    }
}

implement i16 {
    static min_value() -> i16 { return -32768; }
    static max_value() -> i16 { return 32767; }

    abs(&this) -> i16 {
        if (this < 0) { return -this as i16; }
        return this;
    }

    /// Buffer must hold at least `I16_MAX_DECIMAL_DIGITS` bytes.
    to_decimal_buf(&this, buffer: u8*) -> u64 {
        const v: i64 = this as i64;
        return v.to_decimal_buf(buffer);
    }
}

implement i32 {
    static min_value() -> i32 { return -2147483648; }
    static max_value() -> i32 { return 2147483647; }

    /// Wraps at `i32::min_value()` — the most-negative value has no
    /// positive counterpart in two's complement. When checked arithmetic
    /// lands, callers that care will use `checked_abs`.
    abs(&this) -> i32 {
        if (this < 0) { return -this; }
        return this;
    }

    /// Buffer must hold at least `I32_MAX_DECIMAL_DIGITS` bytes.
    to_decimal_buf(&this, buffer: u8*) -> u64 {
        const v: i64 = this as i64;
        return v.to_decimal_buf(buffer);
    }
}

implement i64 {
    static min_value() -> i64 { return -9223372036854775808; }
    static max_value() -> i64 { return 9223372036854775807; }

    abs(&this) -> i64 {
        if (this < 0) { return -this; }
        return this;
    }
}

// Unsigned range bounds + buffer-write formatting.  Narrower widths
// (`u8`, `u16`, `u32`) zero-extend to `u64` and delegate the digit loop
// to `u64`'s methods — the implementation lives in one place. Callers
// pick a smaller buffer per the `UN_MAX_*_DIGITS` constants above; the
// u64 implementation writes only the digits it needs.
implement u8 {
    static min_value() -> u8 { return 0 as u8; }
    static max_value() -> u8 { return 255 as u8; }

    to_decimal_buf(&this, buffer: u8*) -> u64 {
        const v: u64 = this as u64;
        return v.to_decimal_buf(buffer);
    }

    to_hex_buf(&this, buffer: u8*) -> u64 {
        const v: u64 = this as u64;
        return v.to_hex_buf(buffer);
    }

    to_hex_upper_buf(&this, buffer: u8*) -> u64 {
        const v: u64 = this as u64;
        return v.to_hex_upper_buf(buffer);
    }

    to_oct_buf(&this, buffer: u8*) -> u64 {
        const v: u64 = this as u64;
        return v.to_oct_buf(buffer);
    }

    to_bin_buf(&this, buffer: u8*) -> u64 {
        const v: u64 = this as u64;
        return v.to_bin_buf(buffer);
    }
}

implement u16 {
    static min_value() -> u16 { return 0 as u16; }
    static max_value() -> u16 { return 65535 as u16; }

    to_decimal_buf(&this, buffer: u8*) -> u64 {
        const v: u64 = this as u64;
        return v.to_decimal_buf(buffer);
    }

    to_hex_buf(&this, buffer: u8*) -> u64 {
        const v: u64 = this as u64;
        return v.to_hex_buf(buffer);
    }

    to_hex_upper_buf(&this, buffer: u8*) -> u64 {
        const v: u64 = this as u64;
        return v.to_hex_upper_buf(buffer);
    }

    to_oct_buf(&this, buffer: u8*) -> u64 {
        const v: u64 = this as u64;
        return v.to_oct_buf(buffer);
    }

    to_bin_buf(&this, buffer: u8*) -> u64 {
        const v: u64 = this as u64;
        return v.to_bin_buf(buffer);
    }
}

implement u32 {
    static min_value() -> u32 { return 0 as u32; }
    static max_value() -> u32 { return 4294967295; }

    to_decimal_buf(&this, buffer: u8*) -> u64 {
        const v: u64 = this as u64;
        return v.to_decimal_buf(buffer);
    }

    to_hex_buf(&this, buffer: u8*) -> u64 {
        const v: u64 = this as u64;
        return v.to_hex_buf(buffer);
    }

    to_hex_upper_buf(&this, buffer: u8*) -> u64 {
        const v: u64 = this as u64;
        return v.to_hex_upper_buf(buffer);
    }

    to_oct_buf(&this, buffer: u8*) -> u64 {
        const v: u64 = this as u64;
        return v.to_oct_buf(buffer);
    }

    to_bin_buf(&this, buffer: u8*) -> u64 {
        const v: u64 = this as u64;
        return v.to_bin_buf(buffer);
    }
}

implement u64 {
    static min_value() -> u64 { return 0 as u64; }
    static max_value() -> u64 { return 18446744073709551615; }

    // ------------------------------------------------------------------------
    // Buffer-write formatting. Each writes into a caller-owned `u8*` and
    // returns the number of bytes written. The caller picks the buffer
    // size from the `U64_MAX_*_DIGITS` constants above. This is the
    // canonical implementation — the narrower unsigned widths
    // (`u8`/`u16`/`u32`) above zero-extend to `u64` and reuse it.
    // ------------------------------------------------------------------------

    /// Write `this` in base 10 into `buffer`. Returns bytes written.
    /// `buffer` must hold at least `U64_MAX_DECIMAL_DIGITS` bytes.
    /// Builds the digits on a 20-byte stack scratch then copies in one
    /// shot — no heap traffic.
    to_decimal_buf(&this, buffer: u8*) -> u64 {
        if (this == 0) {
            buffer[0] = 0x30;
            return 1;
        }
        mut scratch: u8[20];
        mut cursor: u64 = 20;
        mut v: u64 = this;
        while (v > 0) {
            cursor = cursor - 1;
            scratch[cursor] = ((v % 10) as u8) + 0x30;
            v = v / 10;
        }
        const digits: u64 = 20 - cursor;
        intrinsics::memcpy(
            buffer as void*,
            (&scratch[0] + cursor) as void*,
            digits
        );
        return digits;
    }

    /// Lowercase hex. Returns bytes written.
    /// `buffer` must hold at least `U64_MAX_HEX_DIGITS` bytes.
    to_hex_buf(&this, buffer: u8*) -> u64 {
        return u64::to_hex_buf_with_table(this, buffer, "0123456789abcdef" as u8*);
    }

    /// Uppercase variant.
    to_hex_upper_buf(&this, buffer: u8*) -> u64 {
        return u64::to_hex_buf_with_table(this, buffer, "0123456789ABCDEF" as u8*);
    }

    /// Internal: hex writer parameterised by the digit table. Stays as a
    /// static helper rather than another method to avoid passing the
    /// table through `&this`.
    static to_hex_buf_with_table(value: u64, buffer: u8*, digits_table: u8*) -> u64 {
        if (value == 0) {
            buffer[0] = 0x30;
            return 1;
        }
        mut scratch: u8[16];
        mut cursor: u64 = 16;
        mut v: u64 = value;
        while (v > 0) {
            cursor = cursor - 1;
            scratch[cursor] = digits_table[v & 0xF];
            v = v >> 4;
        }
        const digits: u64 = 16 - cursor;
        intrinsics::memcpy(
            buffer as void*,
            (&scratch[0] + cursor) as void*,
            digits
        );
        return digits;
    }

    /// Zero-padded fixed-width hex. Writes exactly `width` characters,
    /// truncating high nibbles if the value doesn't fit. Useful for
    /// pointer formatting (`width = 16`), hash dumps, binary protocols.
    to_hex_padded_buf(&this, buffer: u8*, width: u64) -> u64 {
        return u64::to_hex_padded_buf_with_table(this, buffer, width, "0123456789abcdef" as u8*);
    }

    to_hex_padded_upper_buf(&this, buffer: u8*, width: u64) -> u64 {
        return u64::to_hex_padded_buf_with_table(this, buffer, width, "0123456789ABCDEF" as u8*);
    }

    static to_hex_padded_buf_with_table(value: u64, buffer: u8*, width: u64,
                                         digits_table: u8*) -> u64 {
        if (width == 0) { return 0; }
        mut v: u64 = value;
        mut i: u64 = width;
        while (i > 0) {
            i = i - 1;
            buffer[i] = digits_table[v & 0xF];
            v = v >> 4;
        }
        return width;
    }

    /// Base 8. `buffer` must hold at least `U64_MAX_OCT_DIGITS` bytes.
    to_oct_buf(&this, buffer: u8*) -> u64 {
        if (this == 0) {
            buffer[0] = 0x30;
            return 1;
        }
        mut scratch: u8[22];
        mut cursor: u64 = 22;
        mut v: u64 = this;
        while (v > 0) {
            cursor = cursor - 1;
            scratch[cursor] = ((v & 0x7) as u8) + 0x30;
            v = v >> 3;
        }
        const digits: u64 = 22 - cursor;
        intrinsics::memcpy(
            buffer as void*,
            (&scratch[0] + cursor) as void*,
            digits
        );
        return digits;
    }

    /// Base 2. `buffer` must hold at least `U64_MAX_BIN_DIGITS` bytes.
    to_bin_buf(&this, buffer: u8*) -> u64 {
        if (this == 0) {
            buffer[0] = 0x30;
            return 1;
        }
        mut scratch: u8[64];
        mut cursor: u64 = 64;
        mut v: u64 = this;
        while (v > 0) {
            cursor = cursor - 1;
            scratch[cursor] = ((v & 0x1) as u8) + 0x30;
            v = v >> 1;
        }
        const digits: u64 = 64 - cursor;
        intrinsics::memcpy(
            buffer as void*,
            (&scratch[0] + cursor) as void*,
            digits
        );
        return digits;
    }

    /// Zero-padded fixed-width decimal. Writes exactly `width` digits,
    /// truncating the high end if the value doesn't fit. Used for the
    /// fractional piece of a float where the digit count is known
    /// ahead of time.
    to_decimal_padded_buf(&this, buffer: u8*, width: u64) -> u64 {
        if (width == 0) { return 0; }
        mut v: u64 = this;
        mut i: u64 = width;
        while (i > 0) {
            i = i - 1;
            buffer[i] = ((v % 10) as u8) + 0x30;
            v = v / 10;
        }
        return width;
    }
}

implement i64 {
    /// Write signed `this` in base 10. Returns bytes written.
    /// `buffer` must hold at least `I64_MAX_DECIMAL_DIGITS` bytes.
    to_decimal_buf(&this, buffer: u8*) -> u64 {
        if (this < 0) {
            buffer[0] = 0x2D; // '-'
            // `-i64::MIN` overflows in i64 but wraps to the correct u64
            // magnitude.
            const magnitude: u64 = (0 - this) as u64;
            return 1 + magnitude.to_decimal_buf(buffer + 1);
        }
        const v: u64 = this as u64;
        return v.to_decimal_buf(buffer);
    }
}

// `f32` widens to `f64` for free (no precision loss going up). The
// formatting/numeric methods all delegate to the f64 implementation
// (which itself lives in `fmt::float` for `to_buf` / `to_buf_with`
// because that needs libm).
implement f32 {
    abs(&this) -> f32 {
        if (this < 0.0 as f32) { return -this; }
        return this;
    }

    is_nan(&this) -> boolean {
        return this != this;
    }
}

implement f64 {
    abs(&this) -> f64 {
        if (this < 0.0) { return -this; }
        return this;
    }

    /// `NaN != NaN`, so the cheapest portable check is self-comparison.
    is_nan(&this) -> boolean {
        return this != this;
    }
}

// ============================================================================
// Bridge methods on the raw `string` C-string view.
//
// New-stdlib code prefers `Str` and `String<A>` from `collections::str` /
// `collections::string`.  The methods below exist to keep the legacy-shaped
// self-hosted compiler building on the new stdlib without a parallel
// rewrite of every `text.length()` / `text.substring(...)` call site.
// ============================================================================

implement string {
    length(&this) -> u32 {
        if (this == null) { return 0; }
        mut len: u32 = 0;
        while (this[len] != 0) {
            len = len + 1;
        }
        return len;
    }

    is_empty(&this) -> boolean {
        return this.length() == 0;
    }

    /// `substring(start, len)` — extract `len` bytes starting at `start`,
    /// returning a freshly allocated NUL-terminated string.  Matches the
    /// legacy compiler's call convention (start, length), not (start, end).
    substring(&this, start: u32, len: u32) -> string {
        const total: u32 = this.length();
        if (start >= total || len == 0) { return ""; }
        mut take: u32 = len;
        if (start + take > total) {
            take = total - start;
        }
        mut buf: string = malloc((take + 1) as u64) as string;
        mut i: u32 = 0;
        while (i < take) {
            buf[i] = this[start + i];
            i = i + 1;
        }
        buf[take] = 0;
        return buf;
    }

    /// Concatenate `other` onto a fresh heap-allocated copy of `this`,
    /// returning the new NUL-terminated string. Caller owns the result.
    append(&this, other: string) -> string {
        const len1: u64 = strlen(this);
        const len2: u64 = strlen(other);
        const total: u64 = len1 + len2 + 1;
        mut buf: string = malloc(total) as string;
        memcpy(buf as void*, this as void*, len1);
        memcpy(ptr_add(buf as void*, len1) as void*, other as void*, len2);
        buf[len1 + len2] = 0;
        return buf;
    }
}
