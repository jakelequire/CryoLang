            scratch[cursor] = digits_table[(v & 0xF) as u64];
            v = v >> 4;
        }
        const digits: i64 =32 - cursor;
        libc::memcpy(
            buffer as void*,
            (&scratch[0] + cursor) as void*,
            digits as u64
        );
        return digits;
    }

    /// Base 8. `buffer` must hold at least `u128::MAX_OCT_DIGITS` bytes.
    to_oct_buf(&this, buffer: u8*) -> i64 {
        if (this == 0) {
            buffer[0] = 0x30;
            return 1;
        }
        mut scratch: [u8; 43];
        mut cursor: i64 = 43;
        mut v: u128 = this;
        while (v > 0) {
            cursor = cursor - 1;
            scratch[cursor] = ((v & 0x7) as u8) + 0x30;
            v = v >> 3;
        }
        const digits: i64 =43 - cursor;
        libc::memcpy(
            buffer as void*,
            (&scratch[0] + cursor) as void*,
            digits as u64
        );
        return digits;
    }

    /// Base 2. `buffer` must hold at least `u128::MAX_BIN_DIGITS` bytes.
    to_bin_buf(&this, buffer: u8*) -> i64 {
        if (this == 0) {
            buffer[0] = 0x30;
            return 1;
        }
        mut scratch: [u8; 128];
        mut cursor: i64 = 128;
        mut v: u128 = this;
        while (v > 0) {
            cursor = cursor - 1;
            scratch[cursor] = ((v & 0x1) as u8) + 0x30;
            v = v >> 1;
        }
        const digits: i64 =128 - cursor;
        libc::memcpy(
            buffer as void*,
            (&scratch[0] + cursor) as void*,
            digits as u64
        );
        return digits;
    }
