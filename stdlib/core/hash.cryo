///! Hashing.
///!
///! `Hash` types feed their bytes to a `Hasher`, which folds them into a
///! running state and eventually produces a `u64` digest. Implementations
///! decide how sophisticated their state update is, from a trivial
///! identity to a full cryptographic hash.
///!
///! `SipHasher` is keyed: without its key, which inputs collide cannot be
///! worked out, so it is what a `HashMap` hashes with unless told
///! otherwise. `FnvHasher` is FNV-1a: fast, simple and reproducible, for
///! digests and for maps whose keys are trusted.

namespace std::core::hash;

import std::core::default::{ Default };
import std::core::option::{ Option };
import std::core::slice::{ Slice };
import std::core::mem;

/// A running hash state that values feed their bytes into, one `write_*`
/// call at a time; `finish` reads the digest of everything fed so far.
![language("hasher")]
public type trait Hasher {
    /// Feed a single byte into the hash state.
    write_u8(mut &this, value: u8) -> void;

    /// Feed a byte slice. Implementations should override with a faster
    /// bulk path; the default falls back to `write_u8` per byte.
    write_bytes(mut &this, bytes: &Slice<u8>) -> void {
        mut i: i64 = 0;
        while (i < bytes.length()) {
            match (bytes.get(i)) {
                Option::Some(byte) => { this.write_u8(byte); }
                Option::None => { break; }
            }
            i++;
        }
    }

    /// Feed the low `byte_count` bytes of `value`, least-significant byte
    /// first (little-endian, platform-independent). The single entry point
    /// for hashing any fixed-width integer: `write_u8` is the 1-byte special
    /// case; this covers 2/4/8/16-byte values. The default loops `write_u8`;
    /// implementations may override with a faster path.
    write_uint(mut &this, value: u128, byte_count: u32) -> void {
        mut x: u128 = value;
        mut i: u32 = 0;
        while (i < byte_count) {
            this.write_u8((x & 0xFF) as u8);
            x = x >> 8;
            i++;
        }
    }

    /// Fold one delimited value into the running digest, dispatched at compile
    /// time via `static match (T)` (no runtime cost). Lets a digest be
    /// composed from heterogeneous typed parts (`h.fold(x); h.fold(y);
    /// h.finish()`) without a per-type helper name. Every `Primitive` type is
    /// accepted:
    ///   - integers (`u8`..`u128`, `i8`..`i128`, `usize`/`isize`) - their
    ///     two's-complement bytes at NATURAL width, low byte first (LE), so a
    ///     `u8` folds 1 byte, a `u32` 4, a `u64` 8, a `u128` 16.
    ///   - `f32`/`f64` - their IEEE-754 bit pattern (via `mem::transmute`), so
    ///     `0.0`/`-0.0`/NaN payloads fold distinctly (4 / 8 bytes).
    ///   - `char` - its 32-bit Unicode scalar (4 bytes, LE).
    ///   - `boolean` - one byte, `1` or `0`.
    ///   - `string` - its NUL-terminated bytes, then a separator NUL so
    ///                   adjacent concatenations can't collide ("ab"+"c" vs
    ///                   "a"+"bc").
    /// Fixed-width values need no separator; only the variable-length `string`
    /// arm appends one. Any other type is refused where it is given.
    ///
    /// Lives on the trait rather than on one hasher because it is pure
    /// composition over `write_u8` / `write_uint`: every implementation folds
    /// values identically, and a digest of the same parts differs only by the
    /// mixing function underneath.
    fold<T>(mut &this, value: T) -> void where T: Primitive {
        static match (T) {
            // 1-byte
            u8      => { this.write_u8(value); }
            i8      => { this.write_u8(value as u8); }
            boolean => { this.write_u8(if (value) { 1 as u8 } else { 0 as u8 }); }
            // 2-byte
            u16 => { this.write_uint(value as u128, 2); }
            i16 => { this.write_uint((value as u16) as u128, 2); }
            // 4-byte
            u32  => { this.write_uint(value as u128, 4); }
            i32  => { this.write_uint((value as u32) as u128, 4); }
            char => { this.write_uint((value as u32) as u128, 4); }
            f32  => { this.write_uint(mem::transmute::<f32, u32>(value) as u128, 4); }
            // 8-byte
            u64   => { this.write_uint(value as u128, 8); }
            i64   => { this.write_uint((value as u64) as u128, 8); }
            usize => { this.write_uint(value as u128, 8); }
            isize => { this.write_uint((value as u64) as u128, 8); }
            f64   => { this.write_uint(mem::transmute::<f64, u64>(value) as u128, 8); }
            // 16-byte
            u128 => { this.write_uint(value, 16); }
            i128 => { this.write_uint(value as u128, 16); }
            // variable-length + separator
            string => {
                const bytes: u8* = value as u8*;
                mut i: u64 = 0;
                while (bytes[i] != 0 as u8) {
                    this.write_u8(bytes[i]);
                    i = i + 1;
                }
                this.write_u8(0 as u8);
            }
        }
    }

    /// Finalize the hash and return the digest. After calling `finish`
    /// the hasher should not be written to again.
    finish(&this) -> u64;
}

/// A type whose values can be hashed, so they can key a `HashMap` or sit
/// in a `HashSet`. Values that are equal under `Eq` must feed the same
/// bytes. A type takes it with `with [Hash]` on its declaration, or by
/// implementing `hash` by hand.
![language("hash")]
public type trait Hash {
    /// Feed this value's bytes into `hasher`.
    hash<H>(&this, hasher: mut &H) -> void
    where H: Hasher;
}

/// 64-bit FNV-1a. Fast and simple, and fixed and reproducible across runs;
/// not DoS-resistant, so a `HashMap` names it only where its keys are trusted.
public type struct FnvHasher {
    private state: u64;

    /// A hasher at the offset basis, the start of every FNV-1a digest.
    public static new() -> FnvHasher {
        return FnvHasher { state: FNV_OFFSET_BASIS };
    }

    /// Resume hashing from a previously-`finish`ed `u64` state. Lets an
    /// incremental fold thread a running digest through several steps
    /// (e.g. build fingerprinting) without re-deriving the FNV-1a
    /// update inline.
    public static from_state(state: u64) -> FnvHasher {
        return FnvHasher { state: state };
    }

    /// The FNV-1a offset basis: the initial state of a fresh hasher.
    public static offset_basis() -> u64 {
        return FNV_OFFSET_BASIS;
    }

}

/// The 64-bit FNV prime each byte's state is multiplied by.
public const FNV_PRIME:        u64 = 1099511628211;
/// The 64-bit FNV offset basis: the state before any byte.
public const FNV_OFFSET_BASIS: u64 = 14695981039346656037;

/// A default `FnvHasher` starts from the offset basis, as `new` does.
implement trait Default for struct FnvHasher {
    static default() -> FnvHasher {
        return FnvHasher::new();
    }
}

implement trait Hasher for struct FnvHasher {
    write_u8(mut &this, value: u8) -> void {
        this.state = this.state ^ (value as u64);
        this.state = this.state * FNV_PRIME;
    }

    finish(&this) -> u64 {
        return this.state;
    }
}

/// The 128-bit FNV prime each byte's state is multiplied by.
public const FNV128_PRIME:        u128 = 309485009821345068724781371;
/// The 128-bit FNV offset basis: the state before any byte.
public const FNV128_OFFSET_BASIS: u128 = 144066263297769815596495629667062367629;

/// 128-bit FNV-1a. Same construction as `FnvHasher`, twice the width.
///
/// For digests where a collision is a CORRECTNESS failure rather than a
/// slow bucket - the build's incremental cache keys being the motivating
/// case, where two different inputs sharing a key means a stale object file
/// is served and the program silently miscompiles. At 64 bits that risk is
/// small but real and grows with the square of the number of keys; the extra
/// width removes it from consideration. Still FNV, so still not DoS-resistant:
/// this is width, not hardening.
public type struct Fnv128Hasher {
    private state: u128;

    /// A hasher at the 128-bit offset basis.
    public static new() -> Fnv128Hasher {
        return Fnv128Hasher { state: FNV128_OFFSET_BASIS };
    }

    /// Resume from a previously-`finish128`ed state, so a digest can be
    /// threaded through several steps without re-deriving the update.
    public static from_state(state: u128) -> Fnv128Hasher {
        return Fnv128Hasher { state: state };
    }

    /// The full 128-bit digest. `finish` narrows to 64 bits to satisfy
    /// `Hasher`; callers that want the width this type exists for use this.
    public finish128(&this) -> u128 {
        return this.state;
    }

    /// The digest's two halves, high first, for callers rendering it as text.
    /// Returned rather than formatted here so `core::hash` keeps depending on
    /// nothing but `core` - hex formatting lives on `u64`, and pulling
    /// `String` in for it would put the collections module underneath every
    /// HashMap that uses this file.
    public high64(&this) -> u64 {
        return (this.state >> 64) as u64;
    }

    /// The low 64 bits of the 128-bit state.
    public low64(&this) -> u64 {
        return this.state as u64;
    }
}

implement trait Hasher for struct Fnv128Hasher {
    write_u8(mut &this, value: u8) -> void {
        this.state = this.state ^ (value as u128);
        this.state = this.state * FNV128_PRIME;
    }

    /// The low half of the 128-bit state. Truncation is the right narrowing
    /// for FNV-1a: the mixing runs high-to-low, so the low bits carry the
    /// accumulated avalanche. Use `finish128` where the full width matters.
    finish(&this) -> u64 {
        return this.state as u64;
    }
}

/// SipHash, a keyed hash: without the 128-bit key, which inputs collide
/// cannot be worked out, so a table keyed this way keeps its buckets even
/// when its keys come from someone hostile (request headers, JSON object
/// keys). `with_keys_1_3` is SipHash-1-3: one compression round per eight
/// bytes and three to finish. `with_keys_2_4` is SipHash-2-4,
/// the form the algorithm's authors give as the standard one, at about half
/// the speed. Bytes are read in eight-byte little-endian words, and the
/// total length is folded into the last.
public type struct SipHasher {
    private v0: u64;
    private v1: u64;
    private v2: u64;
    private v3: u64;
    /// The bytes since the last full word, low byte first.
    private pending: u64;
    private pending_length: u64;
    private length: u64;
    private compression_rounds: u64;
    private finalization_rounds: u64;

    /// A SipHash-1-3 hasher keyed by the two halves of a 128-bit key.
    /// Keep the key secret, and draw it at random, for the hash to resist
    /// chosen collisions.
    public static with_keys_1_3(key0: u64, key1: u64) -> SipHasher {
        return SipHasher::keyed(key0, key1, 1, 3);
    }

    /// A SipHash-2-4 hasher keyed by the two halves of a 128-bit key: the
    /// standard form, about half the speed of `with_keys_1_3`.
    public static with_keys_2_4(key0: u64, key1: u64) -> SipHasher {
        return SipHasher::keyed(key0, key1, 2, 4);
    }

    private static keyed(key0: u64, key1: u64, compression_rounds: u64, finalization_rounds: u64) -> SipHasher {
        return SipHasher {
            v0: key0 ^ 0x736f6d6570736575,
            v1: key1 ^ 0x646f72616e646f6d,
            v2: key0 ^ 0x6c7967656e657261,
            v3: key1 ^ 0x7465646279746573,
            pending: 0,
            pending_length: 0,
            length: 0,
            compression_rounds: compression_rounds,
            finalization_rounds: finalization_rounds,
        };
    }

    /// One SipRound over the four state words.
    private round(mut &this) -> void {
        this.v0 = this.v0 + this.v1;
        this.v1 = this.v1.rotate_left(13);
        this.v1 = this.v1 ^ this.v0;
        this.v0 = this.v0.rotate_left(32);
        this.v2 = this.v2 + this.v3;
        this.v3 = this.v3.rotate_left(16);
        this.v3 = this.v3 ^ this.v2;
        this.v0 = this.v0 + this.v3;
        this.v3 = this.v3.rotate_left(21);
        this.v3 = this.v3 ^ this.v0;
        this.v2 = this.v2 + this.v1;
        this.v1 = this.v1.rotate_left(17);
        this.v1 = this.v1 ^ this.v2;
        this.v2 = this.v2.rotate_left(32);
    }

    /// Mix one eight-byte word into the state: the message word and the
    /// final length word go through the same step.
    private absorb(mut &this, word: u64) -> void {
        this.v3 = this.v3 ^ word;
        for (mut i: u64 = 0; i < this.compression_rounds; i++) {
            this.round();
        }
        this.v0 = this.v0 ^ word;
    }
}

implement trait Hasher for struct SipHasher {
    write_u8(mut &this, value: u8) -> void {
        const byte: u64 = value;
        this.pending = this.pending | (byte << (8 * this.pending_length));
        this.pending_length = this.pending_length + 1;
        this.length = this.length + 1;
        if (this.pending_length == 8) {
            this.absorb(this.pending);
            this.pending = 0;
            this.pending_length = 0;
        }
    }

    /// Up to eight bytes at a time join the pending bytes in one step; a word
    /// they complete is absorbed, and what is left over starts the next.
    write_uint(mut &this, value: u128, byte_count: u32) -> void {
        mut rest: u128 = value;
        mut remaining: u64 = byte_count;
        while (remaining > 0) {
            const room: u64 = 8 - this.pending_length;
            const taken: u64 = if (remaining < room) { remaining } else { room };
            const mask: u64 = if (taken == 8) { 0xFFFFFFFFFFFFFFFF } else { (1 << (8 * taken)) - 1 };
            const part: u64 = (rest as u64) & mask;
            this.pending = this.pending | (part << (8 * this.pending_length));
            this.pending_length = this.pending_length + taken;
            this.length = this.length + taken;
            rest = rest >> (8 * taken);
            remaining = remaining - taken;
            if (this.pending_length == 8) {
                this.absorb(this.pending);
                this.pending = 0;
                this.pending_length = 0;
            }
        }
    }

    /// Bytes up to a word boundary go one at a time, then whole eight-byte
    /// words, then the rest one at a time.
    write_bytes(mut &this, bytes: &Slice<u8>) -> void {
        const data: u8* = bytes.as_ptr();
        const count: i64 = bytes.length();
        mut at: i64 = 0;
        while (at < count && this.pending_length != 0) {
            this.write_u8(data[at]);
            at++;
        }
        while (count - at >= 8) {
            mut word: u64 = 0;
            for (mut k: i64 = 7; k >= 0; k--) {
                const byte: u64 = data[at + k];
                word = (word << 8) | byte;
            }
            this.length = this.length + 8;
            this.absorb(word);
            at += 8;
        }
        while (at < count) {
            this.write_u8(data[at]);
            at++;
        }
    }

    finish(&this) -> u64 {
        mut state: SipHasher = SipHasher {
            v0: this.v0,
            v1: this.v1,
            v2: this.v2,
            v3: this.v3,
            pending: this.pending,
            pending_length: this.pending_length,
            length: this.length,
            compression_rounds: this.compression_rounds,
            finalization_rounds: this.finalization_rounds,
        };
        state.absorb(((this.length & 0xFF) << 56) | this.pending);
        state.v2 = state.v2 ^ 0xFF;
        for (mut i: u64 = 0; i < state.finalization_rounds; i++) {
            state.round();
        }
        return state.v0 ^ state.v1 ^ state.v2 ^ state.v3;
    }
}

// One-shot digest
//
// The canonical single-value digest: fold a value's bytes through a fresh
// `FnvHasher` and return the `u64`. Works for ANY `Hash` type (strings,
// integers, chars, ...) via the `Hash` impls below, so callers that only need a
// `u64` digest (HashMap's precomputed-hash bridge, the LSP's diagnostic ids,
// the compiler's build-fingerprint atoms) don't re-derive the offset basis +
// prime inline, and there's no per-type entry point to keep in sync. For a
// running digest over several mixed values, drive a `FnvHasher` directly
// with `fold` / `finish`.
/// The 64-bit FNV-1a digest of `value`'s `Hash` bytes: the same for the
/// same value on every run and every machine. Not keyed, so not for
/// tables whose keys an adversary picks.
///
/// ```cryo
/// import std::core::hash;
///
/// const id: u64 = hash::digest(&Str::new("main.cryo"));
/// ```
public function digest<T>(value: &T) -> u64
where T: Hash {
    mut h: FnvHasher = FnvHasher::new();
    value.hash(&h);
    return h.finish();
}

// Primitive Hash impls

implement trait Hash for u8 {
    hash<H>(&this, hasher: mut &H) -> void 
    where H: Hasher {
        hasher.write_u8(this);
    }
}

implement trait Hash for u16 {
    hash<H>(&this, hasher: mut &H) -> void
    where H: Hasher {
        hasher.write_uint(this as u128, 2);
    }
}

implement trait Hash for u32 {
    hash<H>(&this, hasher: mut &H) -> void
    where H: Hasher {
        hasher.write_uint(this as u128, 4);
    }
}

implement trait Hash for u64 {
    hash<H>(&this, hasher: mut &H) -> void
    where H: Hasher {
        hasher.write_uint(this as u128, 8);
    }
}

implement trait Hash for i8 {
    hash<H>(&this, hasher: mut &H) -> void 
    where H: Hasher {
        hasher.write_u8(this as u8);
    }
}

implement trait Hash for i16 {
    hash<H>(&this, hasher: mut &H) -> void
    where H: Hasher {
        hasher.write_uint((this as u16) as u128, 2);
    }
}

implement trait Hash for i32 {
    hash<H>(&this, hasher: mut &H) -> void
    where H: Hasher {
        hasher.write_uint((this as u32) as u128, 4);
    }
}

implement trait Hash for i64 {
    hash<H>(&this, hasher: mut &H) -> void
    where H: Hasher {
        hasher.write_uint((this as u64) as u128, 8);
    }
}

implement trait Hash for u128 {
    hash<H>(&this, hasher: mut &H) -> void
    where H: Hasher {
        hasher.write_uint(this, 16);
    }
}

implement trait Hash for i128 {
    hash<H>(&this, hasher: mut &H) -> void
    where H: Hasher {
        hasher.write_uint(this as u128, 16);
    }
}

implement trait Hash for usize {
    hash<H>(&this, hasher: mut &H) -> void
    where H: Hasher {
        hasher.write_uint(this as u128, 8);
    }
}

implement trait Hash for isize {
    hash<H>(&this, hasher: mut &H) -> void
    where H: Hasher {
        hasher.write_uint((this as u64) as u128, 8);
    }
}

/// A float hashes as it compares under `Eq` (the IEEE `==`): `0.0` and
/// `-0.0` hash alike, and every NaN hashes as one value.  A NaN equals
/// nothing, so a NaN key is never found again in a hashed collection.
implement trait Hash for f32 {
    hash<H>(&this, hasher: mut &H) -> void
    where H: Hasher {
        mut bits: u32 = mem::transmute::<f32, u32>(this);
        if (this == 0.0) { bits = 0; }
        if (this != this) { bits = 0x7FC00000; }
        hasher.write_uint(bits as u128, 4);
    }
}

implement trait Hash for f64 {
    hash<H>(&this, hasher: mut &H) -> void
    where H: Hasher {
        mut bits: u64 = mem::transmute::<f64, u64>(this);
        if (this == 0.0) { bits = 0; }
        if (this != this) { bits = 0x7FF8000000000000; }
        hasher.write_uint(bits as u128, 8);
    }
}

implement trait Hash for boolean {
    hash<H>(&this, hasher: mut &H) -> void 
    where H: Hasher {
        if (this) {
            hasher.write_u8(1);
        } else {
            hasher.write_u8(0);
        }
    }
}

implement trait Hash for char {
    hash<H>(&this, hasher: mut &H) -> void
    where H: Hasher {
        // `char` is a 32-bit Unicode scalar; feed all four bytes. Hashing
        // only the low byte (`this as u8`) collapsed every char sharing a
        // low byte (e.g. 'A' 0x41 vs U+0141 vs U+1041) into one bucket,
        // degrading `HashMap<char, V>` / `HashSet<char>` to near-linear for
        // non-ASCII keys. Mirrors the `u32` impl.
        hasher.write_uint((this as u32) as u128, 4);
    }
}

/// Byte-mix a NUL-terminated `string` (Cryo's raw C-string view) into
/// the hasher.  Hashing stops at the first NUL byte, matching `string`'s
/// existing equality and length semantics.  Provided so `HashMap<string, V>`
/// and other Hash-keyed collections work with raw string keys without
/// forcing callers to wrap them in `Str` or `String<A>`.
implement trait Hash for string {
    hash<H>(&this, hasher: mut &H) -> void
    where H: Hasher {
        const bytes: u8* = this as u8*;
        mut i: u64 = 0;
        while (bytes[i] != 0 as u8) {
            hasher.write_u8(bytes[i]);
            i = i + 1;
        }
        // Separator NUL, mirroring `FnvHasher::fold`'s string arm, so
        // adjacent string fields can't collide ("ab"+"c" vs "a"+"bc") and
        // `digest(&s)` agrees with `h.fold(s); h.finish()`.
        hasher.write_u8(0 as u8);
    }
}
