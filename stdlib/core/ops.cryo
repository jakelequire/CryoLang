implement trait Neg<f64>   for f64   { neg(&this) -> f64   { return -this; } }

implement trait BitAnd<i8, i8>       for i8    { bitand(&this, rhs: &i8) -> i8       { return this & *rhs; } }
implement trait BitAnd<i16, i16>     for i16   { bitand(&this, rhs: &i16) -> i16     { return this & *rhs; } }
implement trait BitAnd<i32, i32>     for i32   { bitand(&this, rhs: &i32) -> i32     { return this & *rhs; } }
implement trait BitAnd<i64, i64>     for i64   { bitand(&this, rhs: &i64) -> i64     { return this & *rhs; } }
implement trait BitAnd<i128, i128>   for i128  { bitand(&this, rhs: &i128) -> i128   { return this & *rhs; } }
implement trait BitAnd<isize, isize> for isize { bitand(&this, rhs: &isize) -> isize { return this & *rhs; } }
implement trait BitAnd<u8, u8>       for u8    { bitand(&this, rhs: &u8) -> u8       { return this & *rhs; } }
implement trait BitAnd<u16, u16>     for u16   { bitand(&this, rhs: &u16) -> u16     { return this & *rhs; } }
implement trait BitAnd<u32, u32>     for u32   { bitand(&this, rhs: &u32) -> u32     { return this & *rhs; } }
implement trait BitAnd<u64, u64>     for u64   { bitand(&this, rhs: &u64) -> u64     { return this & *rhs; } }
implement trait BitAnd<u128, u128>   for u128  { bitand(&this, rhs: &u128) -> u128   { return this & *rhs; } }
implement trait BitAnd<usize, usize> for usize { bitand(&this, rhs: &usize) -> usize { return this & *rhs; } }

implement trait BitOr<i8, i8>       for i8    { bitor(&this, rhs: &i8) -> i8       { return this | *rhs; } }
implement trait BitOr<i16, i16>     for i16   { bitor(&this, rhs: &i16) -> i16     { return this | *rhs; } }
implement trait BitOr<i32, i32>     for i32   { bitor(&this, rhs: &i32) -> i32     { return this | *rhs; } }
implement trait BitOr<i64, i64>     for i64   { bitor(&this, rhs: &i64) -> i64     { return this | *rhs; } }
implement trait BitOr<i128, i128>   for i128  { bitor(&this, rhs: &i128) -> i128   { return this | *rhs; } }
implement trait BitOr<isize, isize> for isize { bitor(&this, rhs: &isize) -> isize { return this | *rhs; } }
implement trait BitOr<u8, u8>       for u8    { bitor(&this, rhs: &u8) -> u8       { return this | *rhs; } }
implement trait BitOr<u16, u16>     for u16   { bitor(&this, rhs: &u16) -> u16     { return this | *rhs; } }
implement trait BitOr<u32, u32>     for u32   { bitor(&this, rhs: &u32) -> u32     { return this | *rhs; } }
