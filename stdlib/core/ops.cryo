///! Ranges and the `Step` trait.
///!
///! `Step` abstracts "the successor of a value" so a single generic
///! `Range<T>` works across integer widths. Implementing `Step` requires
///! `Ord`: bounded iteration needs to know when we've passed `end`.

namespace std::core::ops;

import core::cmp;
import core::iter;
import core::option;

type trait Step : Ord {
    /// The next value after `this`. Wraps on overflow at the type's
    /// maximum; `Range` stops before reaching that case because the
    /// bound check uses `Ord`.
    successor(&this) -> This;
}

/// `Deref<Target>` exposes the value a smart pointer points at. The
/// returned `Target*` is mutable (Cryo pointers are not const-qualified),
/// so this one trait covers both shared and mutable access — there is no
/// separate `DerefMut`.
///
/// The compiler rewrites `*b` into `*(b.deref())`; because the deref of the
/// returned `Target*` is a place, the one impl serves reads (`v = *b`),
/// writes (`*b = x`), and compound assignment (`*b += x`). Member access
/// auto-derefs too: `b.field` / `b.method()` on a `Box<Foo>` coerce through
/// `.deref()` (transitively) when the receiver type lacks the member.
/// Type-directed and only fires when the primitive `*` / field rules do not
/// apply, so raw pointers and references keep their native behavior.
type trait Deref<Target> {
    deref(&this) -> Target*;
}

/// `Index<Idx, Output>` is the contract for `container[idx]`-style access,
/// returning a pointer to the element. The compiler rewrites `a[i]` into
/// `*(a.index(i))`; because the deref of the returned `Output*` is a place, the
/// one impl serves reads (`v = a[i]`), writes (`a[i] = v`), and compound
/// assignment (`a[i] += v`). Type-directed and only fires when the primitive
/// array/slice/string/pointer indexing rules do not apply, so built-in indexing
/// stays on the native path. A `&T` container overloads exactly like a value.
type trait Index<Idx, Output> {
    index(&this, idx: Idx) -> Output*;
}

/// Arithmetic operator traits. Implementing one lets the compiler rewrite
/// the corresponding operator on a user type (or a generic param bounded by
/// the trait) into the trait method: `a + b` => `a.add(&b)`, and likewise
/// `-` => `sub`, `*` => `mul`, `/` => `div`, `%` => `rem`. The rewrite is
/// type-directed and LHS-driven — `a OP b` dispatches on `a`'s type — and
/// only fires when the primitive rules do not apply, so `1 + 2` and pointer
/// stepping keep emitting raw instructions. Primitives deliberately do NOT
/// implement these traits: their arithmetic stays on the native fast path.
///
/// `Rhs` is the right operand's type and `Output` the result's; both are
/// type parameters (mirroring `Index<Idx, Output>`) so a type can, e.g.,
/// add a scalar to a vector and yield a vector. The right operand is taken
/// by reference to avoid moving an owned aggregate.
///
/// Compound assignment (`a += b`) routes through the same trait: it evaluates
/// `a.add(&b)` and stores the result back into `a`.
type trait Add<Rhs, Output> { add(&this, rhs: &Rhs) -> Output; }
type trait Sub<Rhs, Output> { sub(&this, rhs: &Rhs) -> Output; }
type trait Mul<Rhs, Output> { mul(&this, rhs: &Rhs) -> Output; }
type trait Div<Rhs, Output> { div(&this, rhs: &Rhs) -> Output; }
type trait Rem<Rhs, Output> { rem(&this, rhs: &Rhs) -> Output; }

/// Unary negation: `-x` => `x.neg()`. Same type-directed discipline as the
/// binary arithmetic traits; numeric negation stays on the native path.
type trait Neg<Output> { neg(&this) -> Output; }

/// Bitwise and shift operator traits, rewritten exactly like the arithmetic
/// ones: `a & b` => `a.bitand(&b)`, and likewise `|` => `bitor`, `^` => `bitxor`,
/// `<<` => `shl`, `>>` => `shr`. Type-directed and LHS-driven; only fires when
/// the primitive integer rules do not apply, so integer bit-twiddling keeps
/// emitting raw instructions. Compound assignment (`a &= b`, `a <<= b`, ...)
/// routes through the same trait. `Rhs`/`Output` are type parameters so a type
/// can, e.g., shift by a plain integer and yield itself.
type trait BitAnd<Rhs, Output> { bitand(&this, rhs: &Rhs) -> Output; }
type trait BitOr<Rhs, Output>  { bitor(&this, rhs: &Rhs) -> Output; }
type trait BitXor<Rhs, Output> { bitxor(&this, rhs: &Rhs) -> Output; }
type trait Shl<Rhs, Output>    { shl(&this, rhs: &Rhs) -> Output; }
type trait Shr<Rhs, Output>    { shr(&this, rhs: &Rhs) -> Output; }

/// Unary complement traits. `!x` => `x.not()` (logical, for a user "boolean-like"
/// type) and `~x` => `x.bitnot()` (bitwise). Same type-directed discipline as
/// `Neg`; the primitive `bool`/integer forms stay on the native path.
type trait Not<Output>    { not(&this) -> Output; }
type trait BitNot<Output> { bitnot(&this) -> Output; }

implement trait Step for i8   { successor(&this) -> i8   { return this + 1; } }
implement trait Step for i16  { successor(&this) -> i16  { return this + 1; } }
implement trait Step for i32  { successor(&this) -> i32  { return this + 1; } }
implement trait Step for i64  { successor(&this) -> i64  { return this + 1; } }
implement trait Step for u8   { successor(&this) -> u8   { return this + 1; } }
implement trait Step for u16  { successor(&this) -> u16  { return this + 1; } }
implement trait Step for u32  { successor(&this) -> u32  { return this + 1; } }
implement trait Step for u64  { successor(&this) -> u64  { return this + 1; } }
implement trait Step for char { successor(&this) -> char { return (this as i32 + 1) as char; } }

// Range<T>: half-open [start, end)

type struct Range<T> {
    start: T;
    end: T;

    static new(start: T, end: T) -> Range<T> {
        return Range<T> { start: start, end: end };
    }
}

implement<T> trait Iterator<T> for struct Range<T>
where T: Step {
    next(mut &this) -> Option<T> {
        match (this.start.compare(&this.end)) {
            Ordering::Less => {
                const value: T = this.start;
                this.start = this.start.successor();
                return Option::Some(value);
            }
            _ => { return Option::None; }
        }
    }
}

// RangeInclusive<T>: [start, end]

type struct RangeInclusive<T> {
    start: T;
    end: T;
    exhausted: boolean;

    static new(start: T, end: T) -> RangeInclusive<T> {
        return RangeInclusive<T> {
            start: start,
            end: end,
            exhausted: false
        };
    }
}

implement<T> trait Iterator<T> for struct RangeInclusive<T>
where T: Step {
    next(mut &this) -> Option<T> {
        if (this.exhausted) {
            return Option::None;
        }
        match (this.start.compare(&this.end)) {
            Ordering::Less => {
                const value: T = this.start;
                this.start = this.start.successor();
                return Option::Some(value);
            }
            Ordering::Equal => {
                // Yield the endpoint, then latch to exhausted so we
                // don't call `successor` past `end` (overflow risk at
                // the top of the type's range).
                const value: T = this.start;
                this.exhausted = true;
                return Option::Some(value);
            }
            Ordering::Greater => {
                this.exhausted = true;
                return Option::None;
            }
        }
    }
}
