///! Ranges and the `Step` trait.
///!
///! `Step` abstracts "the successor of a value" so a single generic
///! `Range<T>` works across integer widths. Implementing `Step` requires
///! `Ord`: bounded iteration needs to know when we've passed `end`.

namespace std::core::ops;

import std::core::cmp::{ Ord, Ordering };
import std::core::iter::{ DoubleEndedIterator, Iterator };
import std::core::option::{ Option };

public type trait Step : Ord {
    /// The next value after `this`. Wraps on overflow at the type's
    /// maximum; `Range` stops before reaching that case because the
    /// bound check uses `Ord`.
    successor(&this) -> This;

    /// The value before `this`. Wraps on underflow at the type's minimum;
    /// a range yielding from its back end stops before reaching that case
    /// as it does at the front.
    predecessor(&this) -> This;
}

/// Whether a computation goes on or stops early: `Continue` with the value
/// it goes on with, `Break` with the value it stops with.  `?` asks its
/// operand for one (`Try::branch`).
![language("control_flow")]
public type enum ControlFlow<Break, Continue> {
    Continue(Continue);
    Break(Break);
}

/// A value `?` applies to.  `branch` splits it into the value the
/// expression goes on with, its `Output`, or what the enclosing function
/// returns early with, its `Residual`; `from_output` makes one from an
/// output.  `x?` is `match (x.branch()) { Continue(v) => v, Break(r) =>
/// return R::from_residual(r) }`, `R` the enclosing function's return type.
![language("try")]
public type trait Try {
    type Output;
    type Residual;

    static from_output(output: This::Output) -> This;

    ![language("try_branch")]
    branch(this) -> ControlFlow<This::Residual, This::Output>;
}

/// A type a function returns that can be built from the residual `R` a `?`
/// stopped with: `Result<T, F>` from the `Result<(), E>` an error leaves,
/// converting the error through `From`.
![language("from_residual")]
public type trait FromResidual<R> {
    ![language("from_residual_from_residual")]
    static from_residual(residual: R) -> This;
}

/// `Deref` exposes, read-only, the value a smart pointer points at, its
/// `Target`.
///
/// The compiler rewrites `*b` into `*(b.deref())` where `*b` is read
/// (`v = *b`). Member access reads through it too: `b.field` / `b.method()`
/// on a `Box<Foo>` go through `.deref()` (transitively) when the receiver
/// type lacks the member. Type-directed and only fires when the primitive
/// `*` / field rules do not apply, so raw pointers and references keep their
/// native behavior. Writing through `*b` is `DerefMutable`'s.
![language("deref")]
public type trait Deref {
    type Target;
    ![language("deref_deref")]
    deref(&this) -> const This::Target*;
}

/// `DerefMutable` exposes, writable, the `Target` of its `Deref`. Where
/// `*b` is written - assigned (`*b = x`), given a compound assignment
/// (`*b += x`), or the receiver of a `mut &this` method, and likewise a
/// member reached through `*b` - the compiler rewrites it into
/// `*(b.deref_mutable())`, which needs `b` itself writable. A type that
/// implements only `Deref` is read-only through `*`.
![language("deref_mutable")]
public type trait DerefMutable : Deref {
    ![language("deref_mutable_deref_mutable")]
    deref_mutable(mut &this) -> mut This::Target*;
}

/// `Index<Idx>` is the contract for reading `container[idx]`, returning a
/// read-only pointer to the element, its `Output`. The compiler rewrites
/// `a[i]` into `*(a.index(i))` where `a[i]` is read (`v = a[i]`).
/// Type-directed and only fires when the primitive array/slice/string/pointer
/// indexing rules do not apply, so built-in indexing stays on the native
/// path. A `&T` container overloads exactly like a value. Writing `a[i]` is
/// `IndexMutable`'s.
![language("index")]
public type trait Index<Idx> {
    type Output;
    ![language("index_index")]
    index(&this, idx: Idx) -> const This::Output*;
}

/// `IndexMutable<Idx>` is the contract for writing `container[idx]`,
/// returning a writable pointer to the `Output` of its `Index<Idx>`. Where
/// `a[i]` is written - assigned (`a[i] = v`), given a compound assignment
/// (`a[i] += v`), or the receiver of a `mut &this` method, and likewise a
/// member of it - the compiler rewrites it into `*(a.index_mutable(i))`,
/// which needs `a` itself writable. A type that implements only `Index` is
/// read-only through `[]`.
![language("index_mutable")]
public type trait IndexMutable<Idx> : Index<Idx> {
    ![language("index_mutable_index_mutable")]
    index_mutable(mut &this, idx: Idx) -> mut This::Output*;
}

/// `Allocate` is where `new` gets its memory and `delete` returns it.
/// `new T { .. }` of a struct that implements it calls
/// `T::allocate(size, align)` for the storage, then stores the literal as
/// for any other `new`; `delete p` runs the pointee's `Drop`, then hands the
/// storage to `release(p, align)`.  A type with no implementation uses the
/// global allocator.
///
/// `release` does nothing unless an implementation writes it: an arena
/// reclaims its storage all at once, never per object.  An allocator that
/// does free one object at a time writes both methods.
![language("allocate")]
public type trait Allocate {
    ![language("allocate_allocate")]
    static allocate(size: u64, align: u64) -> mut void*;
    ![language("allocate_release")]
    static release(ptr: mut void*, align: u64) -> void { }
}

/// Arithmetic operator traits. Implementing one lets the compiler rewrite
/// the corresponding operator on a user type (or a generic param bounded by
/// the trait) into the trait method: `a + b` => `a.add(&b)`, and likewise
/// `-` => `sub`, `*` => `mul`, `/` => `div`, `%` => `rem`. The rewrite is
/// type-directed and LHS-driven - `a OP b` dispatches on `a`'s type - and
/// only fires when the primitive rules do not apply, so `1 + 2` and pointer
/// stepping keep emitting raw instructions. Every primitive type an
/// operator applies to implements its trait (the tables below), so a bound
/// such as `T: Add<T, T>` admits `i32`; the operator on a primitive, in a
/// generic body's copy as anywhere else, still emits the raw instruction.
///
/// `Rhs` is the right operand's type and `Output` the result's; both are
/// type parameters (mirroring `Index<Idx, Output>`) so a type can, e.g.,
/// add a scalar to a vector and yield a vector. The right operand is taken
/// by reference to avoid moving an owned aggregate.
///
/// Compound assignment (`a += b`) routes through the same trait: it evaluates
/// `a.add(&b)` and stores the result back into `a`.
![language("add")]
public type trait Add<Rhs, Output> { add(&this, rhs: &Rhs) -> Output; }
![language("sub")]
public type trait Sub<Rhs, Output> { sub(&this, rhs: &Rhs) -> Output; }
![language("mul")]
public type trait Mul<Rhs, Output> { mul(&this, rhs: &Rhs) -> Output; }
![language("div")]
public type trait Div<Rhs, Output> { div(&this, rhs: &Rhs) -> Output; }
![language("rem")]
public type trait Rem<Rhs, Output> { rem(&this, rhs: &Rhs) -> Output; }

/// Unary negation: `-x` => `x.neg()`. Same type-directed discipline as the
/// binary arithmetic traits; numeric negation stays on the native path.
![language("neg")]
public type trait Neg<Output> { neg(&this) -> Output; }

/// Bitwise and shift operator traits, rewritten exactly like the arithmetic
/// ones: `a & b` => `a.bitand(&b)`, and likewise `|` => `bitor`, `^` => `bitxor`,
/// `<<` => `shl`, `>>` => `shr`. Type-directed and LHS-driven; only fires when
/// the primitive integer rules do not apply, so integer bit-twiddling keeps
/// emitting raw instructions. Compound assignment (`a &= b`, `a <<= b`, ...)
/// routes through the same trait. `Rhs`/`Output` are type parameters so a type
/// can, e.g., shift by a plain integer and yield itself.
![language("bit_and")]
public type trait BitAnd<Rhs, Output> { bitand(&this, rhs: &Rhs) -> Output; }
![language("bit_or")]
public type trait BitOr<Rhs, Output>  { bitor(&this, rhs: &Rhs) -> Output; }
![language("bit_xor")]
public type trait BitXor<Rhs, Output> { bitxor(&this, rhs: &Rhs) -> Output; }
![language("shl")]
public type trait Shl<Rhs, Output>    { shl(&this, rhs: &Rhs) -> Output; }
![language("shr")]
public type trait Shr<Rhs, Output>    { shr(&this, rhs: &Rhs) -> Output; }

/// Unary complement traits. `!x` => `x.not()` (logical, for a user "boolean-like"
/// type) and `~x` => `x.bitnot()` (bitwise). Same type-directed discipline as
/// `Neg`; the primitive `bool`/integer forms stay on the native path.
![language("not")]
public type trait Not<Output>    { not(&this) -> Output; }
![language("bit_not")]
public type trait BitNot<Output> { bitnot(&this) -> Output; }

// Each primitive type implements the trait of every operator that applies
// to it natively, with itself as both operand and result: the arithmetic
// operators and `-` on every integer and floating-point type, the bitwise
// and shift operators and `~` on every integer type, and `!` on `boolean`.
// Each method applies the native operator.
implement trait Add<i8, i8>       for i8    { add(&this, rhs: &i8) -> i8       { return this + *rhs; } }
implement trait Add<i16, i16>     for i16   { add(&this, rhs: &i16) -> i16     { return this + *rhs; } }
implement trait Add<i32, i32>     for i32   { add(&this, rhs: &i32) -> i32     { return this + *rhs; } }
implement trait Add<i64, i64>     for i64   { add(&this, rhs: &i64) -> i64     { return this + *rhs; } }
implement trait Add<i128, i128>   for i128  { add(&this, rhs: &i128) -> i128   { return this + *rhs; } }
implement trait Add<isize, isize> for isize { add(&this, rhs: &isize) -> isize { return this + *rhs; } }
implement trait Add<u8, u8>       for u8    { add(&this, rhs: &u8) -> u8       { return this + *rhs; } }
implement trait Add<u16, u16>     for u16   { add(&this, rhs: &u16) -> u16     { return this + *rhs; } }
implement trait Add<u32, u32>     for u32   { add(&this, rhs: &u32) -> u32     { return this + *rhs; } }
implement trait Add<u64, u64>     for u64   { add(&this, rhs: &u64) -> u64     { return this + *rhs; } }
implement trait Add<u128, u128>   for u128  { add(&this, rhs: &u128) -> u128   { return this + *rhs; } }
implement trait Add<usize, usize> for usize { add(&this, rhs: &usize) -> usize { return this + *rhs; } }
implement trait Add<f32, f32>     for f32   { add(&this, rhs: &f32) -> f32     { return this + *rhs; } }
implement trait Add<f64, f64>     for f64   { add(&this, rhs: &f64) -> f64     { return this + *rhs; } }

implement trait Sub<i8, i8>       for i8    { sub(&this, rhs: &i8) -> i8       { return this - *rhs; } }
implement trait Sub<i16, i16>     for i16   { sub(&this, rhs: &i16) -> i16     { return this - *rhs; } }
implement trait Sub<i32, i32>     for i32   { sub(&this, rhs: &i32) -> i32     { return this - *rhs; } }
implement trait Sub<i64, i64>     for i64   { sub(&this, rhs: &i64) -> i64     { return this - *rhs; } }
implement trait Sub<i128, i128>   for i128  { sub(&this, rhs: &i128) -> i128   { return this - *rhs; } }
implement trait Sub<isize, isize> for isize { sub(&this, rhs: &isize) -> isize { return this - *rhs; } }
implement trait Sub<u8, u8>       for u8    { sub(&this, rhs: &u8) -> u8       { return this - *rhs; } }
implement trait Sub<u16, u16>     for u16   { sub(&this, rhs: &u16) -> u16     { return this - *rhs; } }
implement trait Sub<u32, u32>     for u32   { sub(&this, rhs: &u32) -> u32     { return this - *rhs; } }
implement trait Sub<u64, u64>     for u64   { sub(&this, rhs: &u64) -> u64     { return this - *rhs; } }
implement trait Sub<u128, u128>   for u128  { sub(&this, rhs: &u128) -> u128   { return this - *rhs; } }
implement trait Sub<usize, usize> for usize { sub(&this, rhs: &usize) -> usize { return this - *rhs; } }
implement trait Sub<f32, f32>     for f32   { sub(&this, rhs: &f32) -> f32     { return this - *rhs; } }
implement trait Sub<f64, f64>     for f64   { sub(&this, rhs: &f64) -> f64     { return this - *rhs; } }

implement trait Mul<i8, i8>       for i8    { mul(&this, rhs: &i8) -> i8       { return this * *rhs; } }
implement trait Mul<i16, i16>     for i16   { mul(&this, rhs: &i16) -> i16     { return this * *rhs; } }
implement trait Mul<i32, i32>     for i32   { mul(&this, rhs: &i32) -> i32     { return this * *rhs; } }
implement trait Mul<i64, i64>     for i64   { mul(&this, rhs: &i64) -> i64     { return this * *rhs; } }
implement trait Mul<i128, i128>   for i128  { mul(&this, rhs: &i128) -> i128   { return this * *rhs; } }
implement trait Mul<isize, isize> for isize { mul(&this, rhs: &isize) -> isize { return this * *rhs; } }
implement trait Mul<u8, u8>       for u8    { mul(&this, rhs: &u8) -> u8       { return this * *rhs; } }
implement trait Mul<u16, u16>     for u16   { mul(&this, rhs: &u16) -> u16     { return this * *rhs; } }
implement trait Mul<u32, u32>     for u32   { mul(&this, rhs: &u32) -> u32     { return this * *rhs; } }
implement trait Mul<u64, u64>     for u64   { mul(&this, rhs: &u64) -> u64     { return this * *rhs; } }
implement trait Mul<u128, u128>   for u128  { mul(&this, rhs: &u128) -> u128   { return this * *rhs; } }
implement trait Mul<usize, usize> for usize { mul(&this, rhs: &usize) -> usize { return this * *rhs; } }
implement trait Mul<f32, f32>     for f32   { mul(&this, rhs: &f32) -> f32     { return this * *rhs; } }
implement trait Mul<f64, f64>     for f64   { mul(&this, rhs: &f64) -> f64     { return this * *rhs; } }

implement trait Div<i8, i8>       for i8    { div(&this, rhs: &i8) -> i8       { return this / *rhs; } }
implement trait Div<i16, i16>     for i16   { div(&this, rhs: &i16) -> i16     { return this / *rhs; } }
implement trait Div<i32, i32>     for i32   { div(&this, rhs: &i32) -> i32     { return this / *rhs; } }
implement trait Div<i64, i64>     for i64   { div(&this, rhs: &i64) -> i64     { return this / *rhs; } }
implement trait Div<i128, i128>   for i128  { div(&this, rhs: &i128) -> i128   { return this / *rhs; } }
implement trait Div<isize, isize> for isize { div(&this, rhs: &isize) -> isize { return this / *rhs; } }
implement trait Div<u8, u8>       for u8    { div(&this, rhs: &u8) -> u8       { return this / *rhs; } }
implement trait Div<u16, u16>     for u16   { div(&this, rhs: &u16) -> u16     { return this / *rhs; } }
implement trait Div<u32, u32>     for u32   { div(&this, rhs: &u32) -> u32     { return this / *rhs; } }
implement trait Div<u64, u64>     for u64   { div(&this, rhs: &u64) -> u64     { return this / *rhs; } }
implement trait Div<u128, u128>   for u128  { div(&this, rhs: &u128) -> u128   { return this / *rhs; } }
implement trait Div<usize, usize> for usize { div(&this, rhs: &usize) -> usize { return this / *rhs; } }
implement trait Div<f32, f32>     for f32   { div(&this, rhs: &f32) -> f32     { return this / *rhs; } }
implement trait Div<f64, f64>     for f64   { div(&this, rhs: &f64) -> f64     { return this / *rhs; } }

implement trait Rem<i8, i8>       for i8    { rem(&this, rhs: &i8) -> i8       { return this % *rhs; } }
implement trait Rem<i16, i16>     for i16   { rem(&this, rhs: &i16) -> i16     { return this % *rhs; } }
implement trait Rem<i32, i32>     for i32   { rem(&this, rhs: &i32) -> i32     { return this % *rhs; } }
implement trait Rem<i64, i64>     for i64   { rem(&this, rhs: &i64) -> i64     { return this % *rhs; } }
implement trait Rem<i128, i128>   for i128  { rem(&this, rhs: &i128) -> i128   { return this % *rhs; } }
implement trait Rem<isize, isize> for isize { rem(&this, rhs: &isize) -> isize { return this % *rhs; } }
implement trait Rem<u8, u8>       for u8    { rem(&this, rhs: &u8) -> u8       { return this % *rhs; } }
implement trait Rem<u16, u16>     for u16   { rem(&this, rhs: &u16) -> u16     { return this % *rhs; } }
implement trait Rem<u32, u32>     for u32   { rem(&this, rhs: &u32) -> u32     { return this % *rhs; } }
implement trait Rem<u64, u64>     for u64   { rem(&this, rhs: &u64) -> u64     { return this % *rhs; } }
implement trait Rem<u128, u128>   for u128  { rem(&this, rhs: &u128) -> u128   { return this % *rhs; } }
implement trait Rem<usize, usize> for usize { rem(&this, rhs: &usize) -> usize { return this % *rhs; } }
implement trait Rem<f32, f32>     for f32   { rem(&this, rhs: &f32) -> f32     { return this % *rhs; } }
implement trait Rem<f64, f64>     for f64   { rem(&this, rhs: &f64) -> f64     { return this % *rhs; } }

implement trait Neg<i8>    for i8    { neg(&this) -> i8    { return -this; } }
implement trait Neg<i16>   for i16   { neg(&this) -> i16   { return -this; } }
implement trait Neg<i32>   for i32   { neg(&this) -> i32   { return -this; } }
implement trait Neg<i64>   for i64   { neg(&this) -> i64   { return -this; } }
implement trait Neg<i128>  for i128  { neg(&this) -> i128  { return -this; } }
implement trait Neg<isize> for isize { neg(&this) -> isize { return -this; } }
implement trait Neg<u8>    for u8    { neg(&this) -> u8    { return -this; } }
implement trait Neg<u16>   for u16   { neg(&this) -> u16   { return -this; } }
implement trait Neg<u32>   for u32   { neg(&this) -> u32   { return -this; } }
implement trait Neg<u64>   for u64   { neg(&this) -> u64   { return -this; } }
implement trait Neg<u128>  for u128  { neg(&this) -> u128  { return -this; } }
implement trait Neg<usize> for usize { neg(&this) -> usize { return -this; } }
