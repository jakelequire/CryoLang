implement trait Shl<i64, i64>     for i64   { shl(&this, rhs: &i64) -> i64     { return this << *rhs; } }
implement trait Shl<i128, i128>   for i128  { shl(&this, rhs: &i128) -> i128   { return this << *rhs; } }
implement trait Shl<isize, isize> for isize { shl(&this, rhs: &isize) -> isize { return this << *rhs; } }
implement trait Shl<u8, u8>       for u8    { shl(&this, rhs: &u8) -> u8       { return this << *rhs; } }
implement trait Shl<u16, u16>     for u16   { shl(&this, rhs: &u16) -> u16     { return this << *rhs; } }
implement trait Shl<u32, u32>     for u32   { shl(&this, rhs: &u32) -> u32     { return this << *rhs; } }
implement trait Shl<u64, u64>     for u64   { shl(&this, rhs: &u64) -> u64     { return this << *rhs; } }
implement trait Shl<u128, u128>   for u128  { shl(&this, rhs: &u128) -> u128   { return this << *rhs; } }
implement trait Shl<usize, usize> for usize { shl(&this, rhs: &usize) -> usize { return this << *rhs; } }

implement trait Shr<i8, i8>       for i8    { shr(&this, rhs: &i8) -> i8       { return this >> *rhs; } }
implement trait Shr<i16, i16>     for i16   { shr(&this, rhs: &i16) -> i16     { return this >> *rhs; } }
implement trait Shr<i32, i32>     for i32   { shr(&this, rhs: &i32) -> i32     { return this >> *rhs; } }
implement trait Shr<i64, i64>     for i64   { shr(&this, rhs: &i64) -> i64     { return this >> *rhs; } }
implement trait Shr<i128, i128>   for i128  { shr(&this, rhs: &i128) -> i128   { return this >> *rhs; } }
implement trait Shr<isize, isize> for isize { shr(&this, rhs: &isize) -> isize { return this >> *rhs; } }
implement trait Shr<u8, u8>       for u8    { shr(&this, rhs: &u8) -> u8       { return this >> *rhs; } }
implement trait Shr<u16, u16>     for u16   { shr(&this, rhs: &u16) -> u16     { return this >> *rhs; } }
implement trait Shr<u32, u32>     for u32   { shr(&this, rhs: &u32) -> u32     { return this >> *rhs; } }
implement trait Shr<u64, u64>     for u64   { shr(&this, rhs: &u64) -> u64     { return this >> *rhs; } }
implement trait Shr<u128, u128>   for u128  { shr(&this, rhs: &u128) -> u128   { return this >> *rhs; } }
implement trait Shr<usize, usize> for usize { shr(&this, rhs: &usize) -> usize { return this >> *rhs; } }

implement trait Not<boolean> for boolean { not(&this) -> boolean { return !this; } }

implement trait BitNot<i8>    for i8    { bitnot(&this) -> i8    { return ~this; } }
implement trait BitNot<i16>   for i16   { bitnot(&this) -> i16   { return ~this; } }
implement trait BitNot<i32>   for i32   { bitnot(&this) -> i32   { return ~this; } }
implement trait BitNot<i64>   for i64   { bitnot(&this) -> i64   { return ~this; } }
implement trait BitNot<i128>  for i128  { bitnot(&this) -> i128  { return ~this; } }
implement trait BitNot<isize> for isize { bitnot(&this) -> isize { return ~this; } }
implement trait BitNot<u8>    for u8    { bitnot(&this) -> u8    { return ~this; } }
implement trait BitNot<u16>   for u16   { bitnot(&this) -> u16   { return ~this; } }
implement trait BitNot<u32>   for u32   { bitnot(&this) -> u32   { return ~this; } }
implement trait BitNot<u64>   for u64   { bitnot(&this) -> u64   { return ~this; } }
implement trait BitNot<u128>  for u128  { bitnot(&this) -> u128  { return ~this; } }
implement trait BitNot<usize> for usize { bitnot(&this) -> usize { return ~this; } }

implement trait Step for i8   { successor(&this) -> i8   { return this + 1; } predecessor(&this) -> i8   { return this - 1; } }
implement trait Step for i16  { successor(&this) -> i16  { return this + 1; } predecessor(&this) -> i16  { return this - 1; } }
implement trait Step for i32  { successor(&this) -> i32  { return this + 1; } predecessor(&this) -> i32  { return this - 1; } }
implement trait Step for i64  { successor(&this) -> i64  { return this + 1; } predecessor(&this) -> i64  { return this - 1; } }
implement trait Step for u8   { successor(&this) -> u8   { return this + 1; } predecessor(&this) -> u8   { return this - 1; } }
implement trait Step for u16  { successor(&this) -> u16  { return this + 1; } predecessor(&this) -> u16  { return this - 1; } }
implement trait Step for u32  { successor(&this) -> u32  { return this + 1; } predecessor(&this) -> u32  { return this - 1; } }
implement trait Step for u64  { successor(&this) -> u64  { return this + 1; } predecessor(&this) -> u64  { return this - 1; } }
implement trait Step for char { successor(&this) -> char { return (this as i32 + 1) as char; } predecessor(&this) -> char { return (this as i32 - 1) as char; } }

// Range<T>: half-open [start, end)

![language("range")]
public type struct Range<T> {
    public start: T;
    public end: T;

    public static new(start: T, end: T) -> Range<T> {
        return Range::<T> { start: start, end: end };
    }
}

implement<T> trait Iterator<T> for struct Range<T>
where T: Step {
    next(mut &this) -> Option<T> {
        match (this.start.compare(&this.end)) {
            Ordering::Less => {
                const value: T = this.start;
                this.start = this.start.successor();
                return Option::Some(value);
            }
            _ => { return Option::None; }
        }
    }
}

/// From the back, the range yields `end`'s predecessor first, down to
/// `start`; the two ends meet when `start` reaches `end`.
implement<T> trait DoubleEndedIterator for struct Range<T>
where T: Step {
    next_back(mut &this) -> Option<T> {
        match (this.start.compare(&this.end)) {
            Ordering::Less => {
                this.end = this.end.predecessor();
                return Option::Some(this.end);
            }
            _ => { return Option::None; }
        }
    }
}

// RangeInclusive<T>: [start, end]

![language("range_inclusive")]
public type struct RangeInclusive<T> {
    public start: T;
    public end: T;
    private exhausted: boolean;

    public static new(start: T, end: T) -> RangeInclusive<T> {
        return RangeInclusive::<T> {
            start: start,
            end: end,
            exhausted: false
        };
    }
}

implement<T> trait Iterator<T> for struct RangeInclusive<T>
where T: Step {
    next(mut &this) -> Option<T> {
        if (this.exhausted) {
            return Option::None;
        }
        match (this.start.compare(&this.end)) {
            Ordering::Less => {
                const value: T = this.start;
                this.start = this.start.successor();
                return Option::Some(value);
            }
            Ordering::Equal => {
                // Yield the endpoint, then latch to exhausted so we
                // don't call `successor` past `end` (overflow risk at
                // the top of the type's range).
                const value: T = this.start;
                this.exhausted = true;
                return Option::Some(value);
            }
            Ordering::Greater => {
                this.exhausted = true;
                return Option::None;
            }
        }
    }
}

/// From the back, the range yields `end` first, down to `start`; the last
/// value either end yields latches the range exhausted, so `predecessor` is
/// never asked below the type's minimum.
implement<T> trait DoubleEndedIterator for struct RangeInclusive<T>
where T: Step {
    next_back(mut &this) -> Option<T> {
        if (this.exhausted) {
            return Option::None;
        }
        match (this.start.compare(&this.end)) {
            Ordering::Less => {
                const value: T = this.end;
                this.end = this.end.predecessor();
                return Option::Some(value);
            }
            Ordering::Equal => {
                this.exhausted = true;
                return Option::Some(this.end);
            }
            Ordering::Greater => {
                this.exhausted = true;
                return Option::None;
            }
        }
    }
}
