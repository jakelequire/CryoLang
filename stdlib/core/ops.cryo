implement trait BitOr<u128, u128>   for u128  { bitor(&this, rhs: &u128) -> u128   { return this | *rhs; } }
implement trait BitOr<usize, usize> for usize { bitor(&this, rhs: &usize) -> usize { return this | *rhs; } }

implement trait BitXor<i8, i8>       for i8    { bitxor(&this, rhs: &i8) -> i8       { return this ^ *rhs; } }
implement trait BitXor<i16, i16>     for i16   { bitxor(&this, rhs: &i16) -> i16     { return this ^ *rhs; } }
