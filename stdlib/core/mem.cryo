///! Memory utilities: typed wrappers over the memory intrinsics.
///!
///! Everything here operates on pointers the caller already has; this
///! module does not allocate. For heap management see `alloc/`.

namespace std::core::mem;

import core::intrinsics;

/// Copy `count` values of type `T` from `src` to `dest`. Regions must not
/// overlap.
function copy<T>(dest: T*, src: T*, count: u64) -> void {
    intrinsics::memcpy(dest, src, count * sizeof(T));
}

/// Copy `count` values from `src` to `dest`, correctly handling overlap.
function copy_overlapping<T>(dest: T*, src: T*, count: u64) -> void {
    intrinsics::memmove(dest, src, count * sizeof(T));
}

/// Zero `count` values of type `T` starting at `dest`.
function zero<T>(dest: T*, count: u64) -> void {
    intrinsics::memset(dest, 0, count * sizeof(T));
}

/// Destructively read the value at `src`.
///
/// The returned value becomes the SOLE owner of whatever `*src` held. The
/// caller must guarantee the storage at `src` is never dropped afterwards -
/// by overwriting it, by freeing its containing allocation without running
/// the pointee's destructor, or because it was leaked and nothing drops it.
/// Breaking that guarantee frees the same resource twice.
///
/// This is the explicit form of a move out of a pointer. Reading `*src` by
/// value directly is rejected (E0453) precisely because the compiler cannot
/// see which of those guarantees the caller is relying on; naming this
/// function is the caller stating that one of them holds.
///
/// The value is copied BYTEWISE into fresh storage rather than read through
/// the pointer, which is what keeps the source out of move-checked position.
function take_ptr<T>(src: T*) -> T {
    mut result: T;
    intrinsics::memcpy(&result, src, sizeof(T));
    return result;
}

/// Swap the values at `a` and `b`.
function swap<T>(a: T*, b: T*) -> void {
    // A permutation, not a duplication: `a`'s value is taken out before `a` is
    // overwritten, so no storage is ever owned twice.
    const temp: T = take_ptr(a);
    *a = *b;
    *b = temp;
}

/// Offset a typed pointer by `count` elements (not bytes). Negative
/// values walk backwards.
function offset<T>(ptr: T*, count: i64) -> T* {
    // `T* + count` is element-scaled (GEP over the pointee), so this walks
    // `count` elements. A negative `count` walks backwards via the signed
    // GEP index.
    return ptr + count;
}

/// Round `ptr` up to the next multiple of `alignment`. `alignment` must
/// be a power of two.
function align_up(ptr: void*, alignment: u64) -> void* {
    const address: u64 = ptr as u64;
    const mask: u64 = alignment - 1;
    return ((address + mask) & ~mask) as void*;
}

/// Round `ptr` down to the previous multiple of `alignment`.
function align_down(ptr: void*, alignment: u64) -> void* {
    const address: u64 = ptr as u64;
    const mask: u64 = alignment - 1;
    return (address & ~mask) as void*;
}

function is_aligned(ptr: void*, alignment: u64) -> boolean {
    const address: u64 = ptr as u64;
    return (address & (alignment - 1)) == 0;
}

/// Reinterpret the bytes of `value` as a `To`. Aborts if the two types
/// have different sizes. Bit-pattern validity is the caller's problem.
function transmute<From, To>(value: From) -> To {
    if (sizeof(From) != sizeof(To)) {
        core::panic("mem::transmute size mismatch", FILE, LINE);
    }
    mut result: To;
    intrinsics::memcpy(&result, &value, sizeof(From));
    return result;
}

/// Explicitly drop a value of type `T`. This is a no-op for types that do not
/// implement a destructor. The caller is responsible for ensuring that any
/// resources held by `_v` are properly released if necessary.
function drop<T>(_v: T) -> void { }
