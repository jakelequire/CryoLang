///! Memory utilities: typed wrappers over the memory intrinsics.
///!
///! Everything here operates on pointers the caller already has; this
///! module does not allocate. For heap management see `alloc/`.

namespace std::core::mem;

import std::core::intrinsics;
import std::ffi::libc;

/// Copy `count` values of type `T` from `src` to `dest`. Regions must not
/// overlap.
public function copy<T>(dest: mut T*, src: T*, count: u64) -> void {
    libc::memcpy(dest, src, count * sizeof(T));
}

/// Copy `count` values from `src` to `dest`, correctly handling overlap.
public function copy_overlapping<T>(dest: mut T*, src: T*, count: u64) -> void {
    libc::memmove(dest, src, count * sizeof(T));
}

/// Zero `count` values of type `T` starting at `dest`.
public function zero<T>(dest: mut T*, count: u64) -> void {
    libc::memset(dest, 0, count * sizeof(T));
}

/// Swap the values at `a` and `b`.
public function swap<T>(a: mut T*, b: mut T*) -> void {
    // A permutation, not a duplication: every value read out through a pointer
    // is replaced by the store that follows it, so no storage is ever owned
    // twice. That balance is the whole safety argument, which is why the
    // `unsafe` block spans all three statements rather than each read - a read
    // on its own would be a genuine double free.
    unsafe {
        const temp: T = *a;
        *a = *b;
        *b = temp;
    }
}

/// Offset a typed pointer by `count` elements (not bytes). Negative
/// values walk backwards.
public function offset<T>(ptr: mut T*, count: i64) -> mut T* {
    // `T* + count` is element-scaled (GEP over the pointee), so this walks
    // `count` elements. A negative `count` walks backwards via the signed
    // GEP index.
    return ptr + count;
}

/// Offset a read-only typed pointer by `count` elements (not bytes): the
/// read-only counterpart of `offset`. Negative values walk backwards.
public function const_offset<T>(ptr: const T*, count: i64) -> const T* {
    return ptr + count;
}

/// True when `ptr`'s address is a multiple of `alignment`, which must be
/// a power of two (any other value gives a meaningless answer).
public function is_aligned(ptr: void*, alignment: u64) -> boolean {
    const address: u64 = ptr as u64;
    return (address & (alignment - 1)) == 0;
}

/// Reinterpret the bytes of `value` as a `To`. Aborts if the two types
/// have different sizes. Bit-pattern validity is the caller's problem.
public function transmute<From, To>(value: From) -> To {
    if (sizeof(From) != sizeof(To)) {
        core::panic("mem::transmute size mismatch", intrinsics::location());
    }
    mut result: To;
    libc::memcpy(&result, &value, sizeof(From));
    return result;
}

/// Release a value now, before its scope ends. The argument is moved into
/// the call and released when the call returns: its `Drop` runs and what
/// it owns is freed, once. The local it was moved from is not released
/// again at its scope's end, and a later use of it is refused as a use of
/// a moved value (E0452). A value with nothing to release is simply
/// consumed.
///
/// ```cryo
/// import std::core::mem;
/// import std::collections::str::{ Str };
/// import std::collections::string::{ String };
///
/// const buffer: String = String::from_str(Str::new("scratch"));
/// mem::drop(buffer); // the text is freed here, not at the scope's end
/// ```
public function drop<T>(_v: T) -> void { }
