///! Compiler intrinsics.
///!
///! Operations the compiler lowers directly to LLVM IR rather than through a
///! normal call. Everything else that lives in libc (`printf`, `strlen`,
///! `fopen`) belongs in the `ffi` module as explicit C externs.

namespace std::core::intrinsics;

// Windows-only msvcrt aliases for the few CRT functions POSIX names
// differently.  Declared inline (rather than via `import ffi::libc`)
// because intrinsics is a leaf module - libc and syscall already
// import the prelude (which itself re-exports intrinsics), so a
// cross-import here would back-edge the module graph.  Multiple
// extern declarations of the same C symbol are equivalent at link
// time, so the duplication with `ffi::libc` is harmless.
![target(windows)]
extern "C" {
    function _popen(command: string, mode: string) -> void*;
    function _pclose(stream: void*) -> i32;
    // msvcrt's realpath equivalent: `_fullpath(absPath, relPath, maxLen)`.
    // Note the argument order is the reverse of POSIX `realpath(path,
    // resolved)`; the Windows `realpath` shim below swaps them.  Returns
    // `absPath` on success, null on failure (same contract as realpath).
    function _fullpath(absPath: i8*, relPath: string, maxLength: u64) -> i8*;
}

// Allocation.  These remain intrinsics because the self-hosted compiler
// (compiler/src) still calls `intrinsics::malloc` / `intrinsics::free`
// directly; new stdlib code calls the `ffi::libc` wrappers instead.
// Over-aligned allocation (`aligned_alloc` / `aligned_free`, with the
// Windows `_aligned_malloc` dispatch) now lives in `ffi::libc`.
intrinsic function malloc(size: u64) -> void*;
intrinsic function calloc(count: u64, size: u64) -> void*;
intrinsic function realloc(ptr: void*, new_size: u64) -> void*;
intrinsic function free(ptr: void*) -> void;

// Bulk memory.
intrinsic function memcpy(dest: void*, src: void*, count: u64) -> void*;
intrinsic function memmove(dest: void*, src: void*, count: u64) -> void*;
intrinsic function memset(dest: void*, value: i32, count: u64) -> void*;
intrinsic function memcmp(a: void*, b: void*, count: u64) -> i32;
intrinsic function memchr(ptr: void*, value: i32, count: u64) -> void*;

// Pointer distance in bytes. Pointer stepping is done with the `+`/`-`
// operators (element-scaled) or `mem::offset`; there is no `ptr_add`/`ptr_sub`.
intrinsic function ptr_diff(a: void*, b: void*) -> i64;

// Aborts the process after printing the message and source location.
// Typed `never` (the divergent/bottom type): callers structurally treat
// the call as non-returning, so no post-call `unreachable` special-casing
// on the panic symbol name is needed.
intrinsic function panic(message: string, file: string, line: u32) -> never;

// printf-style heap-allocated string formatter. Cryoc emits the body
// (`linkonce_odr ptr @format(ptr, ...)`) into every module via
// `emit_format_runtime`; this declaration is what sema/decl_index see.
intrinsic function format(fmt: string, args...) -> string;

// The catch_unwind primitive (see `core::panic_unwind`). Runs the opaque
// void-returning trampoline `body(data)` inside a catch-all landing pad and
// returns true iff a panic unwound out of it (false = normal return). Codegen
// special-lowers this by leaf name (`call_emitter.cryo::emit_catch_unwind`) to
// an `invoke` + catch pad + phi, so it takes erased `void*` operands and needs
// no generic-T knowledge. Requires `--panic=unwind`; a clear compile error off it.
intrinsic function try_catch(body: void*, data: void*) -> boolean;

// Atomic memory ordering: emits an LLVM `fence` instruction.  The order
// argument is currently always lowered as SequentiallyConsistent by the
// emitter but the parameter is preserved for API symmetry with the
// per-type atomic load/store/RMW operations.  Higher-level Ordering
// values live in `std::sync::atomic`; values defined to match LLVM's
// AtomicOrdering enum: Relaxed=2, Acquire=4, Release=5, AcqRel=6,
// SeqCst=7.
intrinsic function atomic_fence(order: u32) -> void;

// Machine-level runtime primitives.
//   trap()             aborts via an illegal instruction (`llvm.trap` ->
//                      `ud2`, SIGILL) with NO libc dependency - the divergent
//                      sink for a `no_runtime` check failure.  `never`.
//   debugtrap()        a breakpoint (`llvm.debugtrap`) that returns.
//   frame_address(n)   base pointer of the n-th caller frame (n=0 = current).
//   return_address(n)  return address of the n-th frame.  Both for the
//                      runtime backtrace; `n` MUST be a compile-time constant.
intrinsic function trap() -> never;
intrinsic function debugtrap() -> void;
intrinsic function frame_address(level: u32) -> void*;
intrinsic function return_address(level: u32) -> void*;

// Per-type atomic operations.  The `order` argument MUST be a
// compile-time constant Ordering value (the emitter extracts it at
// IR-construction time to populate LLVM's instruction-level ordering).
// `Atomic<i32>` / `Atomic<i64>` in std::sync::atomic wrap these by bitcasting
// the pointer (LLVM doesn't distinguish signed/unsigned for integer
// memory ops).  `Atomic<boolean>` wraps the u8 variants.

// --- atomic load ---
intrinsic function atomic_load_u8(ptr:  u8*,  order: u32) -> u8;
intrinsic function atomic_load_u32(ptr: u32*, order: u32) -> u32;
intrinsic function atomic_load_u64(ptr: u64*, order: u32) -> u64;

// --- atomic store ---
intrinsic function atomic_store_u8(ptr:  u8*,  value: u8,  order: u32) -> void;
intrinsic function atomic_store_u32(ptr: u32*, value: u32, order: u32) -> void;
intrinsic function atomic_store_u64(ptr: u64*, value: u64, order: u32) -> void;

// --- atomicrmw add (returns the previous value) ---
intrinsic function atomic_add_u8(ptr:  u8*,  value: u8,  order: u32) -> u8;
intrinsic function atomic_add_u32(ptr: u32*, value: u32, order: u32) -> u32;
intrinsic function atomic_add_u64(ptr: u64*, value: u64, order: u32) -> u64;

// --- atomicrmw sub ---
intrinsic function atomic_sub_u8(ptr:  u8*,  value: u8,  order: u32) -> u8;
intrinsic function atomic_sub_u32(ptr: u32*, value: u32, order: u32) -> u32;
intrinsic function atomic_sub_u64(ptr: u64*, value: u64, order: u32) -> u64;

// --- atomicrmw and ---
intrinsic function atomic_and_u8(ptr:  u8*,  value: u8,  order: u32) -> u8;
intrinsic function atomic_and_u32(ptr: u32*, value: u32, order: u32) -> u32;
intrinsic function atomic_and_u64(ptr: u64*, value: u64, order: u32) -> u64;

// --- atomicrmw or ---
intrinsic function atomic_or_u8(ptr:  u8*,  value: u8,  order: u32) -> u8;
intrinsic function atomic_or_u32(ptr: u32*, value: u32, order: u32) -> u32;
intrinsic function atomic_or_u64(ptr: u64*, value: u64, order: u32) -> u64;

// --- atomicrmw xor ---
intrinsic function atomic_xor_u8(ptr:  u8*,  value: u8,  order: u32) -> u8;
intrinsic function atomic_xor_u32(ptr: u32*, value: u32, order: u32) -> u32;
intrinsic function atomic_xor_u64(ptr: u64*, value: u64, order: u32) -> u64;

// --- atomicrmw xchg (swap; returns the previous value, stores new) ---
intrinsic function atomic_swap_u8(ptr:  u8*,  value: u8,  order: u32) -> u8;
intrinsic function atomic_swap_u32(ptr: u32*, value: u32, order: u32) -> u32;
intrinsic function atomic_swap_u64(ptr: u64*, value: u64, order: u32) -> u64;

// --- atomic compare-exchange: emits one cmpxchg, returns the loaded
//     value, and writes the success flag through `out_ok`.  Both
//     orderings MUST be compile-time constants. ---
intrinsic function atomic_cmpxchg_u8(
    ptr: u8*,  cmp: u8,  new: u8,  succ: u32, fail: u32, out_ok: boolean*
) -> u8;
intrinsic function atomic_cmpxchg_u32(
    ptr: u32*, cmp: u32, new: u32, succ: u32, fail: u32, out_ok: boolean*
) -> u32;
intrinsic function atomic_cmpxchg_u64(
    ptr: u64*, cmp: u64, new: u64, succ: u32, fail: u32, out_ok: boolean*
) -> u64;

// IEEE-754 classification.  `fpclass(x, test)` lowers to LLVM's
// `llvm.is.fpclass.f64(x, test)` and returns true when x's floating-point
// class is one of those selected by the `test` bitmask.  It is exception-
// free (raises no FP flags) and branchless - no libm, no syscalls - so the
// whole `is_nan` / `is_infinite` / `is_finite` / `classify` family in
// `std::math` (and `std::fmt::float`) is pure Cryo.
//
// `test` MUST be a compile-time constant (LLVM immarg); callers pass the
// documented mask literals rather than a runtime value.  The bits mirror
// LLVM's is.fpclass test enum:
//   0x001 SNaN       0x002 QNaN        0x004 -Inf       0x008 -Normal
//   0x010 -Subnormal 0x020 -Zero       0x040 +Zero      0x080 +Subnormal
//   0x100 +Normal    0x200 +Inf
intrinsic function fpclass(value: f64, test: i32) -> boolean;

// Cheap IEEE-754 math, lowered to the matching LLVM float intrinsic
// (`llvm.fabs.f64`, `llvm.floor.f64`, ...) rather than a libm extern: the
// backend picks a hardware instruction where one exists and otherwise
// expands the operation itself.  Names carry a width suffix (like `bswap64`)
// so common leaf names (`round`, `sqrt`, ...) stay available to user code;
// `ftrunc64` is float truncation toward zero (`llvm.trunc.f64`), named apart
// from the integer narrowing casts.  Semantics match the C functions of the
// same name: `round64` rounds halfway cases away from zero (C `round`, NOT
// `rint`/`nearbyint`), `copysign64`/`fabs64` are pure sign-bit ops (so they
// apply to NaNs and -0.0 too), `sqrt64(-x)` is NaN, and `fma64` performs a
// fused multiply-add with a single rounding.  Errno is never set.
intrinsic function fabs64(value: f64) -> f64;
intrinsic function fabs32(value: f32) -> f32;
intrinsic function floor64(value: f64) -> f64;
intrinsic function ceil64(value: f64) -> f64;
intrinsic function ftrunc64(value: f64) -> f64;
intrinsic function round64(value: f64) -> f64;
intrinsic function copysign64(magnitude: f64, sign: f64) -> f64;
intrinsic function sqrt64(value: f64) -> f64;
intrinsic function sqrt32(value: f32) -> f32;
intrinsic function fma64(x: f64, y: f64, z: f64) -> f64;

// Bridge intrinsics: libc declarations exposed bare to satisfy the
// legacy-shaped self-hosted compiler.
//
// These mirror the legacy stdlib's intrinsic surface so compiler/src/ keeps
// building without a sweep to `libc::printf` / `libc::fopen` / etc.  Each
// declaration emits an LLVM extern that the linker resolves through libc.
// New stdlib code should call the typed wrappers in `ffi::libc` instead.

// stdio: strings & streams
intrinsic function strlen(str: string) -> u64;
intrinsic function strcmp(s1: string, s2: string) -> i32;
intrinsic function strncmp(s1: string, s2: string, count: u64) -> i32;
intrinsic function strcpy(dest: i8*, src: string) -> i8*;
intrinsic function strncpy(dest: i8*, src: string, count: u64) -> i8*;
intrinsic function strcat(dest: i8*, src: string) -> i8*;
intrinsic function strchr(str: string, c: i32) -> i8*;
intrinsic function strrchr(str: string, c: i32) -> i8*;
intrinsic function strstr(haystack: string, needle: string) -> i8*;
intrinsic function strdup(str: string) -> i8*;
intrinsic function atoi(str: string) -> i32;

intrinsic function printf(format: string, args...) -> i32;
intrinsic function sprintf(buffer: i8*, format: string, args...) -> i32;
intrinsic function snprintf(buffer: i8*, size: u64, format: string, args...) -> i32;
intrinsic function fprintf(file: void*, format: string, args...) -> i32;
// va_list-taking variant of fprintf; `va` must be the `args` identifier of
// an enclosing variadic function (which Cryo lowers to a `va_list*` pointer).
// Used to write a printf-style debug wrapper on top of variadic forwarding.
intrinsic function vfprintf(file: void*, format: string, va: void*) -> i32;
// va_list-taking variant of printf (writes to stdout); `va` must be the
// `args` identifier of an enclosing variadic function.  Powers the
// printf-style `print` / `println` in `std::fmt`.
intrinsic function vprintf(format: string, va: void*) -> i32;
intrinsic function sscanf(str: string, format: string, args...) -> i32;
intrinsic function getchar() -> i32;
intrinsic function putchar(c: i32) -> i32;
intrinsic function puts(str: string) -> i32;

// FILE* I/O
intrinsic function fopen(path: string, mode: string) -> void*;
intrinsic function fdopen(fd: i32, mode: string) -> void*;
intrinsic function fclose(file: void*) -> i32;
intrinsic function fread(buffer: void*, size: u64, count: u64, file: void*) -> u64;
intrinsic function fwrite(buffer: void*, size: u64, count: u64, file: void*) -> u64;
intrinsic function fseek(file: void*, offset: i64, whence: i32) -> i32;
intrinsic function ftell(file: void*) -> i64;
intrinsic function fflush(file: void*) -> i32;
intrinsic function fgets(buffer: i8*, size: i32, file: void*) -> i8*;
intrinsic function fputs(str: string, file: void*) -> i32;
intrinsic function fgetc(file: void*) -> i32;
intrinsic function fputc(c: i32, file: void*) -> i32;
intrinsic function feof(file: void*) -> i32;
intrinsic function ferror(file: void*) -> i32;
intrinsic function fileno(file: void*) -> i32;
// Tempfile-backed FILE*: auto-deleted on `fclose`.  Available on both
// glibc and msvcrt, so no per-target gating needed.  Used by
// `render_to_string`'s Windows path as the buffer-the-output substitute
// for POSIX `open_memstream`.
intrinsic function tmpfile() -> void*;
// Pipe-backed subprocess.  POSIX `popen`/`pclose` are spelled
// `_popen`/`_pclose` on msvcrt.  The Windows shims forward through the
// gated extern decls in `ffi::libc`; the public surface
// (`intrinsics::popen`/`pclose`) stays the same.
![target(unix)]
intrinsic function popen(command: string, mode: string) -> void*;

![target(unix)]
intrinsic function pclose(pipe: void*) -> i32;

![target(windows)]
function popen(command: string, mode: string) -> void* {
    return _popen(command, mode);
}

![target(windows)]
function pclose(pipe: void*) -> i32 {
    return _pclose(pipe);
}

// In-memory output stream: open_memstream(char **bufp, size_t *sizep).
// fprintf into the returned FILE*, then fflush/fclose; *bufp then holds
// the accumulated bytes as a NUL-terminated buffer the caller must free.
// Backs the diagnostic renderer's "render to a string" path so the
// language server can ship a fully rendered report to the editor.
//
// POSIX-only.  Windows has no msvcrt equivalent; callers that need
// "render to a string" on Windows should branch via `![target(...)]`
// to a tmpfile-based path (see `compiler/src/compiler/diag/renderer.cryo
// ::render_to_string`).
![target(unix)]
intrinsic function open_memstream(bufp: i8**, sizep: u64*) -> void*;

// fd-level I/O
intrinsic function read(fd: i32, buffer: void*, count: u64) -> i64;
intrinsic function write(fd: i32, buffer: void*, count: u64) -> i64;
intrinsic function open(path: string, flags: i32, mode: i32) -> i32;
intrinsic function close(fd: i32) -> i32;
intrinsic function lseek(fd: i32, offset: i64, whence: i32) -> i64;
intrinsic function dup(fd: i32) -> i32;
intrinsic function dup2(oldfd: i32, newfd: i32) -> i32;
intrinsic function pipe(pipefd: i32*) -> i32;
intrinsic function fcntl(fd: i32, cmd: i32, arg: i32) -> i32;

// Filesystem
intrinsic function stat(path: string, buf: void*) -> i32;
intrinsic function fstat(fd: i32, buf: void*) -> i32;
intrinsic function lstat(path: string, buf: void*) -> i32;
intrinsic function access(path: string, mode: i32) -> i32;
intrinsic function mkdir(path: string, mode: i32) -> i32;
intrinsic function rmdir(path: string) -> i32;
intrinsic function unlink(path: string) -> i32;
intrinsic function rename(oldpath: string, newpath: string) -> i32;
intrinsic function symlink(target: string, linkpath: string) -> i32;
intrinsic function link(oldpath: string, newpath: string) -> i32;
// readlink / isatty moved to `ffi::libc` (OS-dispatched there).
// realpath: POSIX absolute-path canonicalizer.  msvcrt has no `realpath`,
// but `_fullpath` fills the same role (it lexically resolves to an absolute
// path; unlike POSIX realpath it does not resolve symlinks, which Windows
// largely doesn't use for the paths Cryo canonicalizes - stdlib roots and
// the compiler's own location).  Argument order is swapped vs `_fullpath`.
![target(unix)]
intrinsic function realpath(path: string, resolved: i8*) -> i8*;

![target(windows)]
function realpath(path: string, resolved: i8*) -> i8* {
    return _fullpath(resolved, path, 4096u64);
}
intrinsic function chmod(path: string, mode: i32) -> i32;
intrinsic function getcwd(buf: i8*, size: u64) -> i8*;
intrinsic function chdir(path: string) -> i32;
intrinsic function opendir(path: string) -> void*;
intrinsic function readdir(dirp: void*) -> void*;
intrinsic function closedir(dirp: void*) -> i32;
intrinsic function dirent_name(entry: void*) -> string;
intrinsic function dirent_type(entry: void*) -> i32;

// Process & environment
intrinsic function exit(status: i32) -> void;
intrinsic function abort() -> void;
intrinsic function fork() -> i32;
intrinsic function execvp(file: string, argv: void*) -> i32;
intrinsic function system(command: string) -> i32;
intrinsic function wait(status: i32*) -> i32;
intrinsic function waitpid(pid: i32, status: i32*, options: i32) -> i32;
intrinsic function getpid() -> i32;
intrinsic function kill(pid: i32, sig: i32) -> i32;
intrinsic function getenv(name: string) -> i8*;
intrinsic function setenv(name: string, value: string, overwrite: i32) -> i32;

// va_arg pluck helpers used by codegen for variadic dispatch.
intrinsic function va_arg_i32(args: void*) -> i32;
intrinsic function va_arg_u32(args: void*) -> u32;
intrinsic function va_arg_f64(args: void*) -> f64;
intrinsic function va_arg_i64(args: void*) -> i64;
intrinsic function va_arg_u64(args: void*) -> u64;
intrinsic function va_arg_ptr(args: void*) -> void*;
intrinsic function va_arg_string(args: void*) -> string;
