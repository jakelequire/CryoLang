///! Conversions between types.
///!
///! Cryo has no implicit conversions; every change of type goes through
///! either an `as` cast (for primitives, reinterpret-style) or a
///! conversion method. These traits are the convention for value-
///! preserving conversions that may or may not be fallible.
///!
///! - `From<T>` constructs `This` from a `T`. Always succeeds.
///! - `Into<T>` consumes `This` and produces a `T`. Always succeeds.
///! - `TryFrom<T>` / `TryInto<T>`: fallible counterparts; return
///!   `Result`.
///!
///! A type implements `From` when the conversion is always defined (for
///! example, `i32 -> i64`, where every `i32` fits). It implements `TryFrom`
///! when it might fail (for example, `i64 -> i32`, where values outside the
///! `i32` range don't fit).
///!
///! Implement both `From` and `Into` when both directions make sense.
namespace std::core::convert;

import core::primitives;
import core::result;

type trait From<T> {
    static from(value: T) -> This;
}

type trait Into<T> {
    into(&this) -> T;
}

type trait TryFrom<T> {
    static try_from(value: T) -> Result<This, ConversionError>;
}

type trait TryInto<T> {
    try_into(&this) -> Result<T, ConversionError>;
}

/// What went wrong in a `TryFrom` / `TryInto`. Carries a short static
/// message describing the failure; richer diagnostics are a caller
/// concern.
type struct ConversionError {
    reason: string;

    static new(reason: string) -> ConversionError {
        return ConversionError { reason: reason };
    }
}

// ============================================================================
// Numeric widening (always safe)
// ============================================================================

implement trait From<i8> for i16 {
    static from(value: i8) -> i16 { return value as i16; }
}
implement trait From<i8> for i32 {
    static from(value: i8) -> i32 { return value as i32; }
}
implement trait From<i8> for i64 {
    static from(value: i8) -> i64 { return value as i64; }
}
implement trait From<i16> for i32 {
    static from(value: i16) -> i32 { return value as i32; }
}
implement trait From<i16> for i64 {
    static from(value: i16) -> i64 { return value as i64; }
}
implement trait From<i32> for i64 {
    static from(value: i32) -> i64 { return value as i64; }
}

implement trait From<u8> for u16 {
    static from(value: u8) -> u16 { return value as u16; }
}
implement trait From<u8> for u32 {
    static from(value: u8) -> u32 { return value as u32; }
}
implement trait From<u8> for u64 {
    static from(value: u8) -> u64 { return value as u64; }
}
implement trait From<u16> for u32 {
    static from(value: u16) -> u32 { return value as u32; }
}
implement trait From<u16> for u64 {
    static from(value: u16) -> u64 { return value as u64; }
}
implement trait From<u32> for u64 {
    static from(value: u32) -> u64 { return value as u64; }
}

// `u8` into the signed widths it fits in.
implement trait From<u8> for i16 {
    static from(value: u8) -> i16 { return value as i16; }
}
implement trait From<u8> for i32 {
    static from(value: u8) -> i32 { return value as i32; }
}
implement trait From<u8> for i64 {
    static from(value: u8) -> i64 { return value as i64; }
}

implement trait From<f32> for f64 {
    static from(value: f32) -> f64 { return value as f64; }
}

// ============================================================================
// Narrowing (fallible)
// ============================================================================

implement trait TryFrom<i32> for i16 {
    static try_from(value: i32) -> Result<i16, ConversionError> {
        if (value < i16::min_value() as i32 || value > i16::max_value() as i32) {
            return Result::Err(ConversionError::new("i32 out of i16 range"));
        }
        return Result::Ok(value as i16);
    }
}

implement trait TryFrom<i64> for i32 {
    static try_from(value: i64) -> Result<i32, ConversionError> {
        if (value < i32::min_value() as i64 || value > i32::max_value() as i64) {
            return Result::Err(ConversionError::new("i64 out of i32 range"));
        }
        return Result::Ok(value as i32);
    }
}

implement trait TryFrom<u64> for u32 {
    static try_from(value: u64) -> Result<u32, ConversionError> {
        if (value > u32::max_value() as u64) {
            return Result::Err(ConversionError::new("u64 out of u32 range"));
        }
        return Result::Ok(value as u32);
    }
}

implement trait TryFrom<i64> for u64 {
    static try_from(value: i64) -> Result<u64, ConversionError> {
        if (value < 0) {
            return Result::Err(ConversionError::new("negative i64 cannot fit u64"));
        }
        return Result::Ok(value as u64);
    }
}

implement trait TryFrom<u64> for i64 {
    static try_from(value: u64) -> Result<i64, ConversionError> {
        if (value > i64::max_value() as u64) {
            return Result::Err(ConversionError::new("u64 out of i64 positive range"));
        }
        return Result::Ok(value as i64);
    }
}
