///! Result: a value that may be an error.
///!
///! Every fallible stdlib call returns `Result<T, E>` with a module-specific
///! `E`. Operations whose only failure mode is "not there" return `Option`.

namespace std::core::result;

import std::core::intrinsics;
import std::core::clone::{ Clone };
import std::core::cmp::{ Eq };
import std::core::option::{ Option };
import std::core::convert::{ From };
import std::core::ops::{ ControlFlow, FromResidual, Try };

![language("result")]
public type enum Result<T, E> {
    Ok(T);
    Err(E);
}

implement enum Result<T, E> {
    public is_ok(&this) -> boolean {
        match (&this) {
            Result::Ok(_) => { return true; }
            Result::Err(_) => { return false; }
        }
    }

    public is_err(&this) -> boolean {
        match (&this) {
            Result::Ok(_) => { return false; }
            Result::Err(_) => { return true; }
        }
    }

    /// Borrow both payloads in place, read-only: `Ok(v)` -> `Ok(&v)`,
    /// `Err(e)` -> `Err(&e)`. The pointers alias the receiver's payload
    /// (no copy), so unlike the consuming accessors this is NOT `![sink]`
    /// - the receiver stays live and keeps ownership of `T`/`E`. The
    /// pointers are valid only while the receiver outlives them.
    /// `as_mutable_ref` is the writable form.
    ///
    /// Returns `Result<const T*, const E*>`, a structurally larger `Result`
    /// than the receiver, so the compiler instantiates it lazily at call
    /// sites (see `Option::as_ref` for why eager monomorphization would not
    /// terminate).
    public as_ref(&this) -> Result<const T*, const E*> {
        match (&this) {
            Result::Ok(value) => { return Result::Ok(&value); }
            Result::Err(err) => { return Result::Err(&err); }
        }
    }

    /// Borrow both payloads in place, writable: `Ok(v)` -> `Ok(&v)`,
    /// `Err(e)` -> `Err(&e)`. A write through either pointer changes the
    /// receiver's payload. Lazily instantiated for the same reason as
    /// `as_ref`.
    public as_mutable_ref(mut &this) -> Result<T*, E*> {
        match (&this) {
            Result::Ok(value) => { return Result::Ok(&value); }
            Result::Err(err) => { return Result::Err(&err); }
        }
    }

    /// `![sink]`: the match-arm binding copies the payload out of
    /// the receiver, so the receiver must be treated as moved at the call
    /// site - otherwise both the returned value and the still-live receiver
    /// would be dropped, double-freeing an owning `T`/`E`.
    ![sink]
    public unwrap(&this) -> T {
        match (&this) {
            Result::Ok(value) => { return value; }
            Result::Err(_) => {
                core::panic("called Result::unwrap() on an Err value", intrinsics::location());
            }
        }
    }

    ![sink]
    public expect(&this, message: string) -> T {
        match (&this) {
            Result::Ok(value) => { return value; }
            Result::Err(_) => {
                core::panic(message, intrinsics::location());
            }
        }
    }

    /// Mirror of `unwrap` for error paths. Useful in tests that assert an
    /// operation fails.
    ![sink]
    public unwrap_err(&this) -> E {
        match (&this) {
            Result::Ok(_) => {
                core::panic("called Result::unwrap_err() on an Ok value", intrinsics::location());
            }
            Result::Err(err) => { return err; }
        }
    }

    ![sink]
    public unwrap_or(&this, default_value: T) -> T {
        match (&this) {
            Result::Ok(value) => { return value; }
            Result::Err(_) => { return default_value; }
        }
    }

    ![sink]
    public unwrap_or_else(&this, op: (E) -> T) -> T {
        match (&this) {
            Result::Ok(value) => { return value; }
            Result::Err(err) => { return op(err); }
        }
    }

    ![sink]
    public map<U>(&this, op: (T) -> U) -> Result<U, E> {
        match (&this) {
            Result::Ok(value) => { return Result::Ok(op(value)); }
            Result::Err(err) => { return Result::Err(err); }
        }
    }

    /// Adapt an inner error to a caller's outer error type.
    ![sink]
    public map_err<F>(&this, op: (E) -> F) -> Result<T, F> {
        match (&this) {
            Result::Ok(value) => { return Result::Ok(value); }
            Result::Err(err) => { return Result::Err(op(err)); }
        }
    }

    ![sink]
    public and_then<U>(&this, op: (T) -> Result<U, E>) -> Result<U, E> {
        match (&this) {
            Result::Ok(value) => { return op(value); }
            Result::Err(err) => { return Result::Err(err); }
        }
    }

    ![sink]
    public or_else<F>(&this, op: (E) -> Result<T, F>) -> Result<T, F> {
        match (&this) {
            Result::Ok(value) => { return Result::Ok(value); }
            Result::Err(err) => { return op(err); }
        }
    }

    /// Project the success side to an `Option`, discarding the error.
    ![sink]
    public ok(&this) -> Option<T> {
        match (&this) {
            Result::Ok(value) => { return Option::Some(value); }
            Result::Err(_) => { return Option::None; }
        }
    }

    /// Project the error side to an `Option`, discarding the success.
    ![sink]
    public err(&this) -> Option<E> {
        match (&this) {
            Result::Ok(_) => { return Option::None; }
            Result::Err(err) => { return Option::Some(err); }
        }
    }

    /// True if the result is `Ok(x)` where `x.equals(&value)`.
    public contains(&this, value: &T) -> boolean
    where T: Eq {
        match (&this) {
            Result::Ok(inner) => { return inner.equals(value); }
            Result::Err(_) => { return false; }
        }
    }

    /// True if the result is `Err(e)` where `e.equals(&error)`.
    public contains_err(&this, error: &E) -> boolean
    where E: Eq {
        match (&this) {
            Result::Ok(_) => { return false; }
            Result::Err(inner) => { return inner.equals(error); }
        }
    }
}

implement<T, E> trait Clone for enum Result<T, E>
where T: Clone, E: Clone {
    clone(&this) -> Result<T, E> {
        match (&this) {
            Result::Ok(value) => { return Result::Ok(value.clone()); }
            Result::Err(err) => { return Result::Err(err.clone()); }
        }
    }
}

implement<T, E> trait Eq for enum Result<T, E>
where T: Eq, E: Eq {
    equals(&this, other: &Result<T, E>) -> boolean {
        match (&this) {
            Result::Ok(a) => {
                match (other) {
                    Result::Ok(b) => { return a.equals(b); }
                    Result::Err(_) => { return false; }
                }
            }
            Result::Err(a) => {
                match (other) {
                    Result::Ok(_) => { return false; }
                    Result::Err(b) => { return a.equals(b); }
                }
            }
        }
    }
}

/// `?` on a `Result` goes on with the `Ok` value and stops with the error,
/// as a `Result<(), E>` holding it.
implement<T, E> trait Try for enum Result<T, E> {
    type Output = T;
    type Residual = Result<(), E>;

    static from_output(output: T) -> Result<T, E> {
        return Result::Ok(output);
    }

    branch(this) -> ControlFlow<Result<(), E>, T> {
        match (this) {
            Result::Ok(value) => { return ControlFlow::Continue(value); }
            Result::Err(error) => { return ControlFlow::Break(Result::Err(error)); }
        }
    }
}

/// A function returning `Result<T, F>` returns the error a `?` stopped with
/// converted through `F`'s `From<E>`: an `F` from itself is the error
/// unchanged (`From<T> for T`).
implement<T, E, F> trait FromResidual<Result<(), E>> for enum Result<T, F>
where F: From<E> {
    static from_residual(residual: Result<(), E>) -> Result<T, F> {
        match (residual) {
            Result::Err(error) => { return Result::Err(F::from(error)); }
            Result::Ok(_) => {
                core::panic("a Result residual holds an error", intrinsics::location());
            }
        }
    }
}
