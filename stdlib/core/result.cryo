///! Result: a value that may be an error.
///!
///! Every fallible stdlib call returns `Result<T, E>` with a module-specific
///! `E`. Operations whose only failure mode is "not there" return `Option`.

namespace std::core::result;

import std::core::intrinsics;
import std::core::clone::{ Clone };
import std::core::cmp::{ Eq };
import std::core::default::{ Default };
import std::core::mem;
import std::core::option::{ Option };
import std::core::convert::{ From };
import std::core::ops::{ ControlFlow, FromResidual, Try };
import std::fmt::display::{ Debug };

/// The outcome of an operation that can fail: `Ok(value)` on success,
/// `Err(error)` on failure.
///
/// In a function that itself returns a `Result`, `?` unwraps an `Ok` and
/// returns an `Err` early, converting the error through `From`:
///
/// ```cryo
/// import std::core::result::{ Result };
/// import std::fs::{ File, Path };
/// import std::io::error::{ IoError };
///
/// function text_length(path: Path) -> Result<i64, IoError> {
///     const text: String = File::read_text(path)?;
///     return Result::Ok(text.length());
/// }
/// ```
///
/// A statement that discards a `Result` warns (`W0017`): a failure dropped
/// that way is one nobody sees.
![must_use]
![language("result")]
public type enum Result<T, E> with [Eq, Clone, Debug] {
    Ok(T);
    Err(E);
}

implement enum Result<T, E> {
    /// True when the result is `Ok`.
    public is_ok(&this) -> boolean {
        match (&this) {
            Result::Ok(_) => { return true; }
            Result::Err(_) => { return false; }
        }
    }

    /// True when the result is `Err`.
    public is_err(&this) -> boolean {
        match (&this) {
            Result::Ok(_) => { return false; }
            Result::Err(_) => { return true; }
        }
    }

    /// Borrow both payloads in place, read-only: `Ok(v)` -> `Ok(&v)`,
    /// `Err(e)` -> `Err(&e)`. The pointers alias the receiver's payload
    /// (no copy), so unlike the consuming accessors this is NOT `![sink]`
    /// - the receiver stays live and keeps ownership of `T`/`E`. The
    /// pointers are valid only while the receiver outlives them.
    /// `as_mutable_ref` is the writable form.
    ///
    /// Returns `Result<const T*, const E*>`, a structurally larger `Result`
    /// than the receiver, so the compiler instantiates it lazily at call
    /// sites (see `Option::as_ref` for why eager monomorphization would not
    /// terminate).
    public as_ref(&this) -> Result<const T*, const E*> {
        match (&this) {
            Result::Ok(value) => { return Result::Ok(&value); }
            Result::Err(err) => { return Result::Err(&err); }
        }
    }

    /// Borrow both payloads in place, writable: `Ok(v)` -> `Ok(&v)`,
    /// `Err(e)` -> `Err(&e)`. A write through either pointer changes the
    /// receiver's payload. Lazily instantiated for the same reason as
    /// `as_ref`.
    public as_mutable_ref(mut &this) -> Result<mut T*, mut E*> {
        match (&this) {
            Result::Ok(value) => { return Result::Ok(&value); }
            Result::Err(err) => { return Result::Err(&err); }
        }
    }

    /// `![sink]`: the match-arm binding copies the payload out of
    /// the receiver, so the receiver must be treated as moved at the call
    /// site - otherwise both the returned value and the still-live receiver
    /// would be dropped, double-freeing an owning `T`/`E`.
    ![sink]
    public unwrap(&this) -> T {
        match (&this) {
            Result::Ok(value) => { return value; }
            Result::Err(_) => {
                core::panic("called Result::unwrap() on an Err value", intrinsics::location());
            }
        }
    }

    /// The `Ok` value. Panics with `message` when the result is `Err`, so
    /// write the message as the invariant the caller believed held:
    /// `config.expect("the defaults always parse")`. Consumes the result.
    ![sink]
    public expect(&this, message: string) -> T {
        match (&this) {
            Result::Ok(value) => { return value; }
            Result::Err(_) => {
                core::panic(message, intrinsics::location());
            }
        }
    }

    /// Mirror of `unwrap` for error paths. Useful in tests that assert an
    /// operation fails.
    ![sink]
    public unwrap_err(&this) -> E {
        match (&this) {
            Result::Ok(_) => {
                core::panic("called Result::unwrap_err() on an Ok value", intrinsics::location());
            }
            Result::Err(err) => { return err; }
        }
    }

    /// The `Ok` value, or `default_value` when the result is `Err`,
    /// releasing the error. Consumes the result.
    ![sink]
    public unwrap_or(&this, default_value: T) -> T {
        match (&this) {
            Result::Ok(value) => { return value; }
            Result::Err(error) => {
                mem::drop(error);
                return default_value;
            }
        }
    }

    /// The `Ok` value, or the value `op` computes from the error when the
    /// result is `Err`. `op` is called only for `Err`. Consumes the result.
    ![sink]
    public unwrap_or_else<O>(&this, op: O) -> T where O: (E) -> T {
        match (&this) {
            Result::Ok(value) => { return value; }
            Result::Err(err) => { return op(err); }
        }
    }

    /// `Ok(op(value))`, or the same error when the result is `Err` (`op`
    /// is not called). Consumes the result.
    ![sink]
    public map<U, O>(&this, op: O) -> Result<U, E> where O: (T) -> U {
        match (&this) {
            Result::Ok(value) => { return Result::Ok(op(value)); }
            Result::Err(err) => { return Result::Err(err); }
        }
    }

    /// Adapt an inner error to a caller's outer error type.
    ![sink]
    public map_err<F, O>(&this, op: O) -> Result<T, F> where O: (E) -> F {
        match (&this) {
            Result::Ok(value) => { return Result::Ok(value); }
            Result::Err(err) => { return Result::Err(op(err)); }
        }
    }

    /// The result `op` returns for the `Ok` value, or the same error when
    /// this result is `Err` (`op` is not called). Chains steps that can
    /// each fail with the same error type. Consumes the result.
    ![sink]
    public and_then<U, O>(&this, op: O) -> Result<U, E> where O: (T) -> Result<U, E> {
        match (&this) {
            Result::Ok(value) => { return op(value); }
            Result::Err(err) => { return Result::Err(err); }
        }
    }

    /// This result when it is `Ok`; otherwise the result `op` returns for
    /// the error, which may recover or fail with a different error type.
    /// `op` is called only for `Err`. Consumes the result.
    ![sink]
    public or_else<F, O>(&this, op: O) -> Result<T, F> where O: (E) -> Result<T, F> {
        match (&this) {
            Result::Ok(value) => { return Result::Ok(value); }
            Result::Err(err) => { return op(err); }
        }
    }

    /// Project the success side to an `Option`, releasing the error.
    ![sink]
    public ok(&this) -> Option<T> {
        match (&this) {
            Result::Ok(value) => { return Option::Some(value); }
            Result::Err(error) => {
                mem::drop(error);
                return Option::None;
            }
        }
    }

    /// Project the error side to an `Option`, releasing the value.
    ![sink]
    public err(&this) -> Option<E> {
        match (&this) {
            Result::Ok(value) => {
                mem::drop(value);
                return Option::None;
            }
            Result::Err(err) => { return Option::Some(err); }
        }
    }

    /// True if the result is `Ok(x)` where `x.equals(&value)`.
    public contains(&this, value: &T) -> boolean
    where T: Eq {
        match (&this) {
            Result::Ok(inner) => { return inner.equals(value); }
            Result::Err(_) => { return false; }
        }
    }

    /// True if the result is `Err(e)` where `e.equals(&error)`.
    public contains_err(&this, error: &E) -> boolean
    where E: Eq {
        match (&this) {
            Result::Ok(_) => { return false; }
            Result::Err(inner) => { return inner.equals(error); }
        }
    }

    /// True when the result is `Ok` and the predicate holds for the value.
    /// The value is lent to the predicate; the result keeps it.
    public is_ok_and<P>(&this, predicate: P) -> boolean where P: (&T) -> boolean {
        match (&this) {
            Result::Ok(value) => { return predicate(&value); }
            Result::Err(_) => { return false; }
        }
    }

    /// True when the result is `Err` and the predicate holds for the error.
    public is_err_and<P>(&this, predicate: P) -> boolean where P: (&E) -> boolean {
        match (&this) {
            Result::Ok(_) => { return false; }
            Result::Err(error) => { return predicate(&error); }
        }
    }

    /// The function applied to the value, or `default_value` for `Err`,
    /// releasing the error.
    ![sink]
    public map_or<U, O>(&this, default_value: U, op: O) -> U where O: (T) -> U {
        match (&this) {
            Result::Ok(value) => { return op(value); }
            Result::Err(error) => {
                mem::drop(error);
                return default_value;
            }
        }
    }

    /// The function applied to the value, or `default_op` applied to the
    /// error.
    ![sink]
    public map_or_else<U, D, O>(&this, default_op: D, op: O) -> U where D: (E) -> U, O: (T) -> U {
        match (&this) {
            Result::Ok(value) => { return op(value); }
            Result::Err(error) => { return default_op(error); }
        }
    }

    /// `other` when this result is `Ok`, releasing the value; this result's
    /// error otherwise, releasing `other`.
    ![sink]
    public and<U>(&this, other: Result<U, E>) -> Result<U, E> {
        match (&this) {
            Result::Ok(value) => {
                mem::drop(value);
                return other;
            }
            Result::Err(error) => { return Result::Err(error); }
        }
    }

    /// This result when it is `Ok`, releasing `other`; `other` otherwise,
    /// releasing this result's error.
    ![sink]
    public or<F>(&this, other: Result<T, F>) -> Result<T, F> {
        match (&this) {
            Result::Ok(value) => { return Result::Ok(value); }
            Result::Err(error) => {
                mem::drop(error);
                return other;
            }
        }
    }

    /// The value, or `T::default()` for `Err`, releasing the error.
    ![sink]
    public unwrap_or_default(&this) -> T where T: Default {
        match (&this) {
            Result::Ok(value) => { return value; }
            Result::Err(error) => {
                mem::drop(error);
                return T::default();
            }
        }
    }

    /// Like `unwrap_err`, with a caller-supplied message for the `Ok` case.
    ![sink]
    public expect_err(&this, message: string) -> E {
        match (&this) {
            Result::Ok(_) => {
                core::panic(message, intrinsics::location());
            }
            Result::Err(error) => { return error; }
        }
    }

    /// Lend the value to `f` when the result is `Ok`, then give the result
    /// back unchanged.
    ![sink]
    public inspect<F>(&this, f: F) -> Result<T, E> where F: (&T) -> void {
        match (&this) {
            Result::Ok(value) => { f(&value); }
            Result::Err(_) => { }
        }
        return this;
    }

    /// Lend the error to `f` when the result is `Err`, then give the result
    /// back unchanged.
    ![sink]
    public inspect_err<F>(&this, f: F) -> Result<T, E> where F: (&E) -> void {
        match (&this) {
            Result::Ok(_) => { }
            Result::Err(error) => { f(&error); }
        }
        return this;
    }
}

/// `?` on a `Result` goes on with the `Ok` value and stops with the error,
/// as a `Result<(), E>` holding it.
implement<T, E> trait Try for enum Result<T, E> {
    type Output = T;
    type Residual = Result<(), E>;

    static from_output(output: T) -> Result<T, E> {
        return Result::Ok(output);
    }

    branch(this) -> ControlFlow<Result<(), E>, T> {
        match (this) {
            Result::Ok(value) => { return ControlFlow::Continue(value); }
            Result::Err(error) => { return ControlFlow::Break(Result::Err(error)); }
        }
    }
}

/// A function returning `Result<T, F>` returns the error a `?` stopped with
/// converted through `F`'s `From<E>`: an `F` from itself is the error
/// unchanged (`From<T> for T`).
implement<T, E, F> trait FromResidual<Result<(), E>> for enum Result<T, F>
where F: From<E> {
    static from_residual(residual: Result<(), E>) -> Result<T, F> {
        match (residual) {
            Result::Err(error) => { return Result::Err(F::from(error)); }
            Result::Ok(_) => {
                core::panic("a Result residual holds an error", intrinsics::location());
            }
        }
    }
}
