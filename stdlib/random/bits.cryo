///! std::random::bits: internal little-endian byte helpers.
///!
///! Not part of the public surface - `Rng`, `SecureRng`, and the
///! `RandomSource` defaults share these to move `u64`s in and out of
///! byte buffers. Kept in their own module because `private` is
///! file-local and these are needed across the `random` submodules.

namespace std::random::bits;

/// Load 8 bytes at `p` as a little-endian `u64`.
function load_u64_le(p: u8*) -> u64 {
    mut v: u64 = 0;
    mut i: u64 = 0;
    while (i < 8) {
        v = v | ((p[i] as u64) << (i * 8));
        i = i + 1;
    }
    return v;
}

/// Store `v` as 8 little-endian bytes at `p`.
function store_u64_le(p: u8*, v: u64) -> void {
    mut x: u64 = v;
    mut i: u64 = 0;
    while (i < 8) {
        p[i] = (x & 0xFF) as u8;
        x = x >> 8;
        i = i + 1;
    }
}
