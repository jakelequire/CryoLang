///! std::random::bits: internal little-endian byte helper.
///!
///! Not part of the public surface - the `RandomSource` fill default
///! stores `u64`s into a caller's byte buffer through it. Kept in its
///! own module because `private` is file-local.

namespace std::random::bits;

/// Store `v` as 8 little-endian bytes at `p`.
function store_u64_le(p: u8*, v: u64) -> void {
    mut x: u64 = v;
    mut i: u64 = 0;
    while (i < 8) {
        p[i] = (x & 0xFF) as u8;
        x = x >> 8;
        i = i + 1;
    }
}
