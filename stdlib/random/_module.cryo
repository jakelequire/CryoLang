///! std::random: pseudo-random and OS-backed randomness.
///!
///! Everything is built on one trait, `RandomSource` - a type that can
///! produce 64 random bits. From that single primitive come integers,
///! booleans, floats, bounded ranges, byte fills, in-place shuffling,
///! and uniform choice, so generic code written against `R: RandomSource`
///! runs against any generator.
///!
///! Two generators ship:
///!
///!   - `Rng` - a fast, non-cryptographic PRNG (xoshiro256**), seeded
///!     reproducibly (`Rng::from_seed`) or from the OS (`Rng::from_os`).
///!     POD: copying an `Rng` forks the stream. NOT for security.
///!   - `SecureRng` - the kernel CSPRNG (`getrandom`), for keys, tokens,
///!     and nonces. `try_fill` reports entropy failure as a `Result`.
///!
///! `distribution` layers samplers over any source: `UniformU64` /
///! `UniformI64` / `UniformF64`, `Bernoulli`, `Normal`, `Exponential`,
///! and `WeightedIndex`, all reached through the `Distribution<T>` trait.
///!
///! The free functions here - `range`, `float`, `boolean`, `value`,
///! `choose`, `shuffle` - draw from the calling thread's own OS-seeded
///! `Rng` (`Rng::for_current_thread`), for a program that wants a random
///! number and no generator to carry. They are not for cryptography
///! either; a sequence that must repeat is drawn from an `Rng` made with
///! `Rng::from_seed`, which has every one of them as a method.

namespace std::random;

import std::core::option::{ Option };
import std::core::slice::{ Slice };
import std::random::rng::{ Rng };
import std::random::source::{ RandomSource };

module {
    random::error;
    random::source;
    random::rng;
    random::secure;
    random::distribution;
}

/// A uniform value in `[low, high)`, of any integer type or `f32`/`f64`:
/// `random::range(1, 7)` rolls a die. Unbiased; panics unless `low < high`.
public function range<T>(low: T, high: T) -> T {
    return Rng::for_current_thread().next_range(low, high);
}

/// A uniform `f64` in `[0.0, 1.0)`.
public function float() -> f64 {
    return Rng::for_current_thread().next::<f64>();
}

/// `true` or `false`, each with probability one half.
public function boolean() -> boolean {
    return Rng::for_current_thread().next::<boolean>();
}

/// A uniform value of type `T`: any integer width over its whole range,
/// `boolean`, `f32`/`f64` in `[0.0, 1.0)`, or a `char` that is any Unicode
/// scalar value.
public function value<T>() -> T {
    return Rng::for_current_thread().next::<T>();
}

/// A uniformly chosen element of `items`, borrowed in place, or `None`
/// when `items` is empty.
public function choose<T>(items: &Slice<T>) -> Option<T*> {
    return Rng::for_current_thread().choose(items);
}

/// Put `items` in a uniformly random order, in place.
public function shuffle<T>(items: mut &Slice<T>) -> void {
    Rng::for_current_thread().shuffle(items);
}
