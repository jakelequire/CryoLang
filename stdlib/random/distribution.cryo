///! std::random::distribution: samplers over any `RandomSource`.
///!
///! A `Distribution<T>` turns a source of random bits into draws from a
///! particular shape. `sample(rng)` is generic over `R: RandomSource`,
///! so every distribution works with `Rng`, `SecureRng`, or any custom
///! source.
///!
///!   - `UniformU64` / `UniformI64` - integers in `[lo, hi)`.
///!   - `UniformF64` - reals in `[lo, hi)`.
///!   - `Bernoulli` - a biased coin (`true` with probability `p`).
///!   - `Normal` - the Gaussian, by mean and standard deviation.
///!   - `Exponential` - waiting times at rate `lambda`.
///!   - `WeightedIndex` - an index chosen in proportion to weights.

namespace std::random::distribution;

import std::core::option;
import std::core::result;
import std::core::slice;
import std::collections::array;
import std::random::source;
import std::random::error;
import std::math;

const TWO_PI: f64 = 6.283185307179586;

/// A sampleable distribution producing values of type `T`.
type trait Distribution<T> {
    /// Draw one value, advancing `rng`.
    sample<R>(&this, rng: mut &R) -> T where R: RandomSource;
}

// Uniform integers ----------------------------------------------------

/// Uniform unsigned integers in `[lo, hi)`.
type struct UniformU64 {
    lo: u64;
    hi: u64;

    static new(lo: u64, hi: u64) -> UniformU64 {
        return UniformU64 { lo: lo, hi: hi };
    }
}

implement trait Distribution<u64> for struct UniformU64 {
    sample<R>(&this, rng: mut &R) -> u64 where R: RandomSource {
        return rng.next_range(this.lo, this.hi);
    }
}

/// Uniform signed integers in `[lo, hi)`.
type struct UniformI64 {
    lo: i64;
    hi: i64;

    static new(lo: i64, hi: i64) -> UniformI64 {
        return UniformI64 { lo: lo, hi: hi };
    }
}

implement trait Distribution<i64> for struct UniformI64 {
    sample<R>(&this, rng: mut &R) -> i64 where R: RandomSource {
        return rng.next_range(this.lo, this.hi);
    }
}

// Uniform reals -------------------------------------------------------

/// Uniform reals in `[lo, hi)`.
type struct UniformF64 {
    lo: f64;
    hi: f64;

    static new(lo: f64, hi: f64) -> UniformF64 {
        return UniformF64 { lo: lo, hi: hi };
    }
}

implement trait Distribution<f64> for struct UniformF64 {
    sample<R>(&this, rng: mut &R) -> f64 where R: RandomSource {
        return this.lo + (this.hi - this.lo) * rng.next<f64>();
    }
}

// Bernoulli -----------------------------------------------------------

/// A biased coin: `true` with probability `p`, clamped to `[0, 1]`.
type struct Bernoulli {
    p: f64;

    static new(p: f64) -> Bernoulli {
        mut prob: f64 = p;
        if (prob < 0.0) { prob = 0.0; }
        if (prob > 1.0) { prob = 1.0; }
        return Bernoulli { p: prob };
    }
}

implement trait Distribution<boolean> for struct Bernoulli {
    sample<R>(&this, rng: mut &R) -> boolean where R: RandomSource {
        return rng.next<f64>() < this.p;
    }
}

// Normal (Gaussian) ---------------------------------------------------

/// The normal distribution, parameterized by `mean` and `std_dev`.
type struct Normal {
    mean: f64;
    std_dev: f64;

    static new(mean: f64, std_dev: f64) -> Normal {
        return Normal { mean: mean, std_dev: std_dev };
    }
}

implement trait Distribution<f64> for struct Normal {
    sample<R>(&this, rng: mut &R) -> f64 where R: RandomSource {
        // Box-Muller. `1.0 - next<f64>()` lands in `(0, 1]`, so `ln` never
        // sees zero.
        const u1: f64 = 1.0 - rng.next<f64>();
        const u2: f64 = rng.next<f64>();
        const radius: f64 = math::sqrt(-2.0 * math::ln(u1));
        const z: f64 = radius * math::cos(TWO_PI * u2);
        return this.mean + this.std_dev * z;
    }
}

// Exponential ---------------------------------------------------------

/// The exponential distribution at rate `lambda` (mean `1 / lambda`).
type struct Exponential {
    lambda: f64;

    static new(lambda: f64) -> Exponential {
        return Exponential { lambda: lambda };
    }
}

implement trait Distribution<f64> for struct Exponential {
    sample<R>(&this, rng: mut &R) -> f64 where R: RandomSource {
        // Inverse-CDF: `1.0 - next<f64>()` is in `(0, 1]`.
        return -math::ln(1.0 - rng.next<f64>()) / this.lambda;
    }
}

// Weighted index ------------------------------------------------------

/// Chooses an index `0..n` with probability proportional to a weight.
/// Built once from a weight list, then sampled cheaply. Owns its
/// cumulative table, so it carries a `drop`.
type struct WeightedIndex {
    cumulative: Array<f64>;   // prefix sums; last entry == total
    total: f64;

    /// Build from `weights`. Fails with `InvalidWeights` if `weights` is
    /// empty, contains a negative entry, or sums to zero.
    static try_new(weights: Slice<f64>) -> Result<WeightedIndex, RandomError> {
        const n: u64 = weights.length();
        if (n == 0) {
            return Result::Err(RandomError::InvalidWeights);
        }
        mut cumulative: Array<f64> = Array::new();
        mut sum: f64 = 0.0;
        mut i: u64 = 0;
        while (i < n) {
            const w: f64 = match (weights.get(i)) {
                Option::Some(value) => { value }
                Option::None        => { 0.0 }
            };
            if (w < 0.0) {
                cumulative.drop();
                return Result::Err(RandomError::InvalidWeights);
            }
            sum = sum + w;
            cumulative.push(sum);
            i = i + 1;
        }
        if (sum <= 0.0) {
            cumulative.drop();
            return Result::Err(RandomError::InvalidWeights);
        }
        return Result::Ok(WeightedIndex { cumulative: cumulative, total: sum });
    }

    /// The number of weights this index spans.
    length(&this) -> u64 {
        return this.cumulative.length();
    }
}

implement trait Distribution<u64> for struct WeightedIndex {
    sample<R>(&this, rng: mut &R) -> u64 where R: RandomSource {
        const target: f64 = rng.next<f64>() * this.total;
        const n: u64 = this.cumulative.length();
        mut i: u64 = 0;
        while (i < n) {
            const c: f64 = match (this.cumulative.get(i)) {
                Option::Some(value) => { value }
                Option::None        => { this.total }
            };
            if (target < c) {
                return i;
            }
            i = i + 1;
        }
        return n - 1;   // floating-point edge: settle on the last index
    }
}

implement trait Drop for struct WeightedIndex {
    drop(mut &this) -> void {
        this.cumulative.drop();
    }
}
