///! std::random::distribution: samplers over any `RandomSource`.
///!
///! A `Distribution<T>` turns a source of random bits into draws from a
///! particular shape. `sample(rng)` is generic over `R: RandomSource`,
///! so every distribution works with `Rng`, `SecureRng`, or any custom
///! source.
///!
///!   - `UniformU64` / `UniformI64` - integers in `[lo, hi)`.
///!   - `UniformF64` - reals in `[lo, hi)`.
///!   - `Bernoulli` - a biased coin (`true` with probability `p`).
///!   - `Normal` - the Gaussian, by mean and standard deviation.
///!   - `Exponential` - waiting times at rate `lambda`.
///!   - `WeightedIndex` - an index chosen in proportion to weights.

namespace std::random::distribution;

import std::core::option::{ Option };
import std::core::result::{ Result };
import std::core::slice::{ Slice };
import std::collections::array::{ Array };
import std::random::source::{ RandomSource };
import std::random::error::{ RandomError };
import std::math;
import std::core::mem;

/// A sampleable distribution producing values of type `T`.
public type trait Distribution<T> {
    /// Draw one value, advancing `rng`.
    sample<R>(&this, rng: mut &R) -> T where R: RandomSource;
}

// Uniform integers ----------------------------------------------------

/// Uniform unsigned integers in `[lo, hi)`.
public type struct UniformU64 {
    public lo: u64;
    public hi: u64;

    /// Integers from `lo` up to but not including `hi`. The bounds are not
    /// checked here: `sample` panics unless `lo < hi`.
    ///
    /// ```cryo
    /// import std::random::rng::{ Rng };
    /// import std::random::distribution::{ Distribution, UniformU64 };
    ///
    /// mut rng: Rng = Rng::from_seed(42);
    /// const die: UniformU64 = UniformU64::new(1, 7);
    /// const roll: u64 = die.sample(&rng);        // 1 through 6
    /// ```
    public static new(lo: u64, hi: u64) -> UniformU64 {
        return UniformU64 { lo: lo, hi: hi };
    }
}

implement trait Distribution<u64> for struct UniformU64 {
    sample<R>(&this, rng: mut &R) -> u64 where R: RandomSource {
        return rng.next_range(this.lo, this.hi);
    }
}

/// Uniform signed integers in `[lo, hi)`.
public type struct UniformI64 {
    public lo: i64;
    public hi: i64;

    /// Integers from `lo` up to but not including `hi`; the span may exceed
    /// `i64::MAX`. The bounds are not checked here: `sample` panics unless
    /// `lo < hi`.
    public static new(lo: i64, hi: i64) -> UniformI64 {
        return UniformI64 { lo: lo, hi: hi };
    }
}

implement trait Distribution<i64> for struct UniformI64 {
    sample<R>(&this, rng: mut &R) -> i64 where R: RandomSource {
        return rng.next_range(this.lo, this.hi);
    }
}

// Uniform reals -------------------------------------------------------

/// Uniform reals in `[lo, hi)`.
public type struct UniformF64 {
    public lo: f64;
    public hi: f64;

    /// Reals between `lo` and `hi`, sampled as `lo + (hi - lo) * u` for a
    /// `u` drawn from `[0, 1)`. Nothing is checked, here or in `sample`:
    /// `lo == hi` always gives `lo`, `hi < lo` gives values in `(hi, lo]`,
    /// a non-finite bound gives non-finite samples, and rounding can carry a
    /// sample up to `hi` itself. `RandomSource.next_range` is the checked
    /// draw that never returns `hi`.
    public static new(lo: f64, hi: f64) -> UniformF64 {
        return UniformF64 { lo: lo, hi: hi };
    }
}

implement trait Distribution<f64> for struct UniformF64 {
    sample<R>(&this, rng: mut &R) -> f64 where R: RandomSource {
        return this.lo + (this.hi - this.lo) * rng.next::<f64>();
    }
}

// Bernoulli -----------------------------------------------------------

/// A biased coin: `true` with probability `p`, clamped to `[0, 1]`.
public type struct Bernoulli {
    private p: f64;

    /// A coin that comes up `true` with probability `p`. A `p` below 0.0 is
    /// taken as 0.0 (always `false`) and one above 1.0 as 1.0 (always
    /// `true`); a NaN `p` is kept and always gives `false`.
    public static new(p: f64) -> Bernoulli {
        mut prob: f64 = p;
        if (prob < 0.0) { prob = 0.0; }
        if (prob > 1.0) { prob = 1.0; }
        return Bernoulli { p: prob };
    }
}

implement trait Distribution<boolean> for struct Bernoulli {
    sample<R>(&this, rng: mut &R) -> boolean where R: RandomSource {
        return rng.next::<f64>() < this.p;
    }
}

// Normal (Gaussian) ---------------------------------------------------

/// The normal distribution, parameterized by `mean` and `std_dev`.
public type struct Normal {
    public mean: f64;
    public std_dev: f64;

    /// A normal distribution centred on `mean` with standard deviation
    /// `std_dev`, sampled by the Box-Muller transform (each sample consumes
    /// two uniform draws from the source). The parameters are not checked: a
    /// `std_dev` of 0.0 always gives `mean`, a negative one behaves as its
    /// magnitude, and a NaN parameter gives NaN samples.
    public static new(mean: f64, std_dev: f64) -> Normal {
        return Normal { mean: mean, std_dev: std_dev };
    }
}

implement trait Distribution<f64> for struct Normal {
    sample<R>(&this, rng: mut &R) -> f64 where R: RandomSource {
        // Box-Muller. `1.0 - next<f64>()` lands in `(0, 1]`, so `ln` never
        // sees zero.
        const u1: f64 = 1.0 - rng.next::<f64>();
        const u2: f64 = rng.next::<f64>();
        const radius: f64 = (-2.0 * math::ln(u1)).sqrt();
        const z: f64 = radius * math::cos(math::TAU * u2);
        return this.mean + this.std_dev * z;
    }
}

// Exponential ---------------------------------------------------------

/// The exponential distribution at rate `lambda` (mean `1 / lambda`).
public type struct Exponential {
    public lambda: f64;

    /// An exponential distribution with rate `lambda` (events per unit
    /// time), so samples average `1 / lambda`. Sampled by inverting the
    /// distribution function; samples are 0.0 or greater for a positive
    /// `lambda`. `lambda` is not checked: a negative one gives samples of 0.0
    /// or less, and 0.0 gives +infinity (or NaN when the uniform draw is
    /// exactly 0).
    public static new(lambda: f64) -> Exponential {
        return Exponential { lambda: lambda };
    }
}

implement trait Distribution<f64> for struct Exponential {
    sample<R>(&this, rng: mut &R) -> f64 where R: RandomSource {
        // Inverse-CDF: `1.0 - next<f64>()` is in `(0, 1]`.
        return -math::ln(1.0 - rng.next::<f64>()) / this.lambda;
    }
}

// Weighted index ------------------------------------------------------

/// Chooses an index `0..n` with probability proportional to a weight.
/// Built once from a weight list, then sampled cheaply. Owns its
/// cumulative table, so it carries a `drop`.
public type struct WeightedIndex {
    private cumulative: Array<f64>;   // prefix sums; last entry == total
    private total: f64;

    /// Build from `weights`. Fails with `InvalidWeights` if `weights` is
    /// empty, contains a negative entry, or sums to zero.
    public static try_new(weights: &Slice<f64>) -> Result<WeightedIndex, RandomError> {
        const n: i64 = weights.length();
        if (n == 0) {
            return Result::Err(RandomError::InvalidWeights);
        }
        mut cumulative: Array<f64> = Array::new();
        mut sum: f64 = 0.0;
        mut i: i64 = 0;
        while (i < n) {
            const w: f64 = match (weights.get(i)) {
                Option::Some(value) => { value }
                Option::None        => { 0.0 }
            };
            if (w < 0.0) {
                mem::drop(cumulative);
                return Result::Err(RandomError::InvalidWeights);
            }
            sum = sum + w;
            cumulative.push(sum);
            i = i + 1;
        }
        if (sum <= 0.0) {
            mem::drop(cumulative);
            return Result::Err(RandomError::InvalidWeights);
        }
        return Result::Ok(WeightedIndex { cumulative: cumulative, total: sum });
    }

    /// The number of weights this index spans.
    ![inline]
    public length(&this) -> i64 {
        return this.cumulative.length();
    }
}

implement trait Distribution<u64> for struct WeightedIndex {
    sample<R>(&this, rng: mut &R) -> u64 where R: RandomSource {
        const target: f64 = rng.next::<f64>() * this.total;
        const n: i64 = this.cumulative.length();
        mut i: i64 = 0;
        while (i < n) {
            const c: f64 = match (this.cumulative.get(i)) {
                Option::Some(value) => { value }
                Option::None        => { this.total }
            };
            if (target < c) {
                return i as u64;
            }
            i = i + 1;
        }
        return (n - 1) as u64;   // floating-point edge: settle on the last index
    }
}

implement trait Drop for struct WeightedIndex {
    drop(mut &this) -> void { }
}
