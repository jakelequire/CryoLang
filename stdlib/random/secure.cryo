///! std::random::secure: `SecureRng`, the kernel CSPRNG.
///!
///! `SecureRng` draws straight from the operating system's cryptographic
///! generator. It exposes no predictable algorithm and is the right
///! choice for keys, tokens, and nonces. It is stateless: a copy is the
///! same source, not a forked stream.
///!
///! It satisfies `RandomSource`, so the full draw surface (`next<T>`,
///! `next_below`, `shuffle`, ...) is available. Those defaults panic if
///! the kernel cannot supply entropy (a broken system invariant); when
///! that must be handled, use `try_fill`, which reports it as a `Result`.
///!
///! ## Backing kernel source per target
///!
///!   - UNIX:    `getrandom(buf, len, 0)`     - glibc wrapper over the
///!              Linux `getrandom(2)` syscall.  Blocks at most until
///!              the kernel pool is initialised; returns the number of
///!              bytes filled (negative on error).
///!   - Windows: `RtlGenRandom(buf, len)`     - advapi32 / SystemFunction036,
///!              the historical "secure" Windows API still recommended
///!              by Microsoft for non-elevated processes.  Returns
///!              non-zero on success (and fills the full buffer in one
///!              call), zero on failure.
///!
///! The OS divergence is hidden behind the private `fill_secure_bytes`
///! helper; the public `try_fill` / `RandomSource::next_64` /
///! `RandomSource::fill` bodies are platform-agnostic.

namespace std::random::secure;

import std::core::intrinsics;
import std::core::result;
import std::core::slice;
import std::core::mem;
import std::random::source;
import std::random::bits;
import std::random::error;
import std::ffi::libc;
import std::sys::syscall;

/// Fill `[buf, buf + len)` with cryptographically secure bytes from the
/// OS.  Returns the number of bytes written on success (`>= 1` and
/// `<= len`; partial fills are normal on UNIX), or `0` / a negative
/// value on error.  Callers loop on partial fills.
///
/// The two OS-gated bodies are picked by the ConfigGating pass before
/// name resolution, so name lookup only ever sees one definition.
![target(linux)]
function fill_secure_bytes(buf: u8*, len: u64) -> i64 {
    return getrandom(buf, len, 0);
}

![target(windows)]
function fill_secure_bytes(buf: u8*, len: u64) -> i64 {
    // RtlGenRandom takes a u32 length and a single i32 result
    // (non-zero on success).  Clamp the per-call length to u32::MAX so
    // a > 4 GiB request becomes multiple calls; the caller's loop
    // handles partial fills.
    mut req: u32 = 0xFFFFFFFF;
    if (len < (req as u64)) { req = len as u32; }
    const ok: i32 = syscall::SystemFunction036(buf, req);
    if (ok == 0) { return -1; }
    return req as i64;
}

/// Cryptographically secure source backed by the kernel CSPRNG. Slower
/// than `Rng`; use it only where unpredictability matters.
type struct SecureRng {
    /// A handle to the kernel CSPRNG. Holds no state.
    static new() -> SecureRng {
        return SecureRng { };
    }

    /// Fill `dst` with secure bytes, reporting `EntropyUnavailable` if
    /// the kernel source cannot satisfy the request. The careful
    /// counterpart to the `RandomSource::fill` default (which panics on
    /// failure). On `Ok` the whole view is written.
    try_fill(&this, dst: Slice<u8>) -> Result<(), RandomError> {
        const len: u64 = dst.length();
        const buf: u8* = dst.as_ptr();
        mut done: u64 = 0;
        while (done < len) {
            const n: i64 = fill_secure_bytes(
                mem::offset(buf, done as i64), len - done);
            if (n <= 0) {
                return Result::Err(RandomError::EntropyUnavailable);
            }
            done = done + (n as u64);
        }
        return Result::Ok(());
    }
}

implement trait RandomSource for struct SecureRng {
    next_64(mut &this) -> u64 {
        mut b: u8[8];
        mut done: u64 = 0;
        while (done < 8) {
            const n: i64 = fill_secure_bytes(
                mem::offset(&b[0], done as i64), 8 - done);
            if (n <= 0) {
                core::panic("SecureRng::next_64: kernel entropy unavailable", FILE, LINE as u32);
            }
            done = done + (n as u64);
        }
        return load_u64_le(&b[0]);
    }

    /// Override the byte-fill default to pull straight from the kernel in
    /// one pass rather than synthesizing bytes from `next_64`.
    fill(mut &this, dst: Slice<u8>) -> void {
        const len: u64 = dst.length();
        const buf: u8* = dst.as_ptr();
        mut done: u64 = 0;
        while (done < len) {
            const n: i64 = fill_secure_bytes(
                mem::offset(buf, done as i64), len - done);
            if (n <= 0) {
                core::panic("SecureRng::fill: kernel entropy unavailable", FILE, LINE as u32);
            }
            done = done + (n as u64);
        }
    }
}
