///! std::random::error: failures the random library can report.

namespace std::random::error;

import std::core::cmp::{ Eq };
import std::collections::str::{ Str };

/// What went wrong in a fallible random operation.
///
///   - `EntropyUnavailable` - the kernel CSPRNG could not supply bytes
///     (e.g. `getrandom` failed). Surfaced by `SecureRng::try_fill`.
///   - `EmptyRange` - a bounded draw was asked for an empty range.
///   - `InvalidWeights` - a weighted distribution was built from weights
///     that are empty, negative, or sum to zero.
public type enum RandomError with [Eq] {
    EntropyUnavailable;
    EmptyRange;
    InvalidWeights;
}

implement enum RandomError {
    /// A short, stable description of the failure, as a borrowed `Str`. The
    /// convergent accessor every stdlib error type exposes
    /// (`describe(&this) -> Str`); `Display`/`Debug` for `RandomError`
    /// delegate to it. Borrows a static string literal, so the view outlives
    /// any `RandomError`.
    public describe(&this) -> Str {
        return match (this) {
            RandomError::EntropyUnavailable => { Str::new("kernel entropy unavailable") }
            RandomError::EmptyRange         => { Str::new("empty range") }
            RandomError::InvalidWeights     => { Str::new("invalid weights") }
        };
    }
}
