///! std::random::source: the `RandomSource` trait.
///!
///! A `RandomSource` produces 64 random bits via the one required
///! method, `next_64`. Every other draw - integers of any width, booleans,
///! floats, chars, bounded ranges, byte fills, in-place shuffling, and
///! uniform choice - is a default method derived from it, so a generator
///! only implements `next_64`.
///!
///! Both shipped generators (`Rng`, `SecureRng`) satisfy this trait, so
///! code written against `R: RandomSource` runs against either.

namespace std::random::source;

import std::core::intrinsics;
import std::core::option::{ Option };
import std::core::slice::{ Slice };
import std::core::mem;
import std::io::bytes::{ ByteWriter };

type trait RandomSource {
    /// The single required primitive: the next 64 random bits.
    next_64(mut &this) -> u64;

    /// A uniform draw of type `T`, dispatched at compile time via
    /// `static match (T)` over the primitive `next_64`. Covers every fixed-width
    /// integer, the platform-width `usize`/`isize`, `boolean`, `f32`/`f64`, and
    /// `char`:
    ///   - integers - the required number of bits, taken from the top (best-mixed)
    ///     end for the sub-64-bit widths; `u128`/`i128` concatenate two draws.
    ///   - `boolean` - the top (highest-quality) bit.
    ///   - `f64`/`f32` - a uniform value in `[0.0, 1.0)`; `f64` uses the top 53
    ///     bits so every representable value in the interval is equally likely.
    ///   - `char` - a uniform Unicode scalar value (the surrogate range is skipped).
    /// Select the type with a turbofish (`rng.next<u32>()`) or from context.
    next<T>(mut &this) -> T {
        // Each arm draws directly from `next_64` - no `next<T>` -> `next<T>`
        // recursion (the sub-widths reinterpret the top, best-mixed bits).
        return static match (T) {
            u8    => { (this.next_64() >> 56) as u8 }
            u16   => { (this.next_64() >> 48) as u16 }
            u32   => { (this.next_64() >> 32) as u32 }
            u64   => { this.next_64() }
            u128  => { ((this.next_64() as u128) << 64) | (this.next_64() as u128) }
            usize => { this.next_64() as usize }
            i8    => { (this.next_64() >> 56) as i8 }
            i16   => { (this.next_64() >> 48) as i16 }
            i32   => { (this.next_64() >> 32) as i32 }
            i64   => { this.next_64() as i64 }
            i128  => { (((this.next_64() as u128) << 64) | (this.next_64() as u128)) as i128 }
            isize => { this.next_64() as isize }
            boolean => { (this.next_64() >> 63) == 1 }
            f64 => {
                const bits: u64 = this.next_64() >> 11;    // 53 bits
                (bits as f64) / 9007199254740992.0         // / 2^53
            }
            f32 => {
                const bits: u64 = this.next_64() >> 11;
                ((bits as f64) / 9007199254740992.0) as f32
            }
            char => {
                // Uniform Unicode scalar: draw over `[0, 0x110000)` minus the
                // 0x800-wide UTF-16 surrogate gap `[0xD800, 0xE000)`, then fold
                // the gap back in.
                const bound: i64 = 0x110000 - 0x800;
                mut c: u32 = this.next_below(bound) as u32;
                if (c >= 0xD800) { c = c + 0x800; }
                c as char
            }
        };
    }

    /// A uniform integer in `[0, bound)`. Unbiased: the top partial
    /// bucket is rejected so the modulo introduces no skew. Panics when
    /// `bound <= 0` - an empty range has no value to return.
    next_below(mut &this, bound: i64) -> i64 {
        if (bound <= 0) {
            core::panic("RandomSource::next_below: bound must be > 0", intrinsics::location());
        }
        const span: u64 = bound as u64;
        const threshold: u64 = (u64::MAX - span + 1) % span;   // 2^64 mod span
        loop {
            const x: u64 = this.next_64();
            if (x >= threshold) {
                return (x % span) as i64;
            }
        }
    }

    /// A uniform integer of type `T` in `[lo, hi)`. Requires `lo < hi`.
    /// `static match (T)` covers every integer width: a span of a
    /// 64-bit-and-narrower type is drawn unbiased through `next_below`,
    /// and through the 128-bit sampler `next_below_wide` when it is wider
    /// than `i64::MAX`; `u128`/`i128` always use the 128-bit sampler.
    next_range<T>(mut &this, lo: T, hi: T) -> T {
        return static match (T) {
            u8 | u16 | u32 | u64 | usize | i8 | i16 | i32 | i64 | isize => {
                if (lo >= hi) {
                    core::panic("RandomSource::next_range: lo must be < hi", intrinsics::location());
                }
                const span: u64 = (hi - lo) as u64;
                const offset: u64 = if (span <= i64::MAX as u64) {
                    this.next_below(span as i64) as u64
                } else {
                    this.next_below_wide(span as u128) as u64
                };
                lo + (offset as T)
            }
            u128 => {
                if (lo >= hi) {
                    core::panic("RandomSource::next_range: lo must be < hi", intrinsics::location());
                }
                lo + this.next_below_wide(hi - lo)
            }
            i128 => {
                if (lo >= hi) {
                    core::panic("RandomSource::next_range: lo must be < hi", intrinsics::location());
                }
                lo + (this.next_below_wide((hi - lo) as u128) as i128)
            }
        };
    }

    /// A uniform `u128` in `[0, bound)`, unbiased by the same top-bucket
    /// rejection as `next_below` but over the full 128-bit range. Backs the
    /// `u128`/`i128` arms of `next_range`.
    next_below_wide(mut &this, bound: u128) -> u128 {
        if (bound == 0) {
            core::panic("RandomSource::next_below_wide: bound must be > 0", intrinsics::location());
        }
        const wide_max: u128 = ~(0 as u128);
        const threshold: u128 = (wide_max - bound + 1) % bound;   // 2^128 mod bound
        loop {
            const x: u128 = ((this.next_64() as u128) << 64) | (this.next_64() as u128);
            if (x >= threshold) {
                return x % bound;
            }
        }
    }

    /// Fill `dst` with random bytes, writing through the view.
    fill(mut &this, dst: Slice<u8>) -> void {
        const len: i64 = dst.length();
        mut out: ByteWriter = ByteWriter::over(dst);
        while (out.position() + 8 <= len) {
            out.write_u64_little_endian(this.next_64());
        }
        if (out.position() < len) {
            mut last: u64 = this.next_64();
            while (out.position() < len) {
                out.write_u8(last as u8);
                last = last >> 8;
            }
        }
    }

    /// Shuffle `items` in place with a uniform Fisher-Yates pass. Works for
    /// any element type - elements are swapped, never copied out, so no
    /// `Copy` bound is needed.
    shuffle<T>(mut &this, items: &Slice<T>) -> void {
        const n: i64 = items.length();
        if (n < 2) { return; }
        const base: T* = items.as_ptr();
        mut i: i64 = n - 1;
        loop {
            const j: i64 = this.next_below(i + 1);
            if (i != j) {
                const a: T* = mem::offset(base, i);
                const b: T* = mem::offset(base, j);
                const tmp: T = *a;
                *a = *b;
                *b = tmp;
            }
            if (i == 0) { break; }
            i = i - 1;
        }
    }

    /// Borrow a uniformly chosen element of `items`, or `None` when `items`
    /// is empty. Returns a pointer in place, so no `Copy` is required and
    /// owning element types are fine.
    choose<T>(mut &this, items: &Slice<T>) -> Option<T*> {
        const n: i64 = items.length();
        if (n == 0) {
            return Option::None;
        }
        return items.get_ref(this.next_below(n));
    }
}
