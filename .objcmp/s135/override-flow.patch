+    /// A method that overrides a base class's answers a call made through
+    /// the base (`t.display_name()` on a `Type*`), whose callee is the
+    /// base's method: what the override answers goes on to the answer of
+    /// each method of the same name in every class it derives from.
+    static answer_overridden(ctx: CompilationContext*, state: SemaState*, func: FunctionDeclNode*) -> void {
+        const decl: ASTNode* = ctx.decl_index.entry_decl(func.overload_entry);
+        if (decl == null || decl.kind != NodeKind::MethodDeclaration) { return; }
+        if (!(decl as MethodNode*).is_override) { return; }
+        const own: FlowNode = FlowNode::returned(func.overload_entry.table_key());
+        mut cur: TypeRef = state.this_type;
+        for (mut depth: i32 = 0; depth < 32; depth++) {
+            const t: Type* = ctx.type_arena.lookup(cur);
+            if (t == null) { return; }
+            match (t.kind) {
+                TypeKind::Reference => { cur = (t as ReferenceType*).referent; }
+                TypeKind::Pointer   => { cur = (t as PointerType*).pointee; }
+                TypeKind::Class     => {
+                    cur = (t as ClassType*).base_class;
+                    if (!cur.is_valid()) { return; }
+                    const based: OverloadId[] = ctx.decl_index.lookup_family_entries(FamilyOwner::Type(cur), func.name);
+                    for (mut i: i64 = 0; i < based.length; i++) {
+                        ctx.identity_flow.flow(own, FlowNode::returned(based[i].table_key()));
+                    }
+                }
+                _ => { return; }
+            }
+        }
     }
 
